+def test_pxld_wire_is_byte_identical_to_avx512():
+    """Freeze the cross-backend PXLD-v2 wire identity against constant drift.
+
+    Both backends own a copy of the wire serializer, so this pins the shared
+    ``LayoutPlan`` descriptor bytes (and digest) for every op kind and dtype
+    the native plane covers.  Pure lowering + serialization: no compilation.
+    """
+
+    from pypto.backends.cpu.x86 import avx512 as avx512_runtime
+    from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+
+    avx512_target = TargetSpec(
+        "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+    )
+    cases = (
+        ("reshape", (3, 5), (5, 3), {"shape": [5, 3]}),
+        ("view", (2, 3, 4), (4, 6), {"shape": [4, 6]}),
+        ("contiguous", (2, 3), (2, 3), {}),
+        ("transpose", (2, 3, 5), (5, 2, 3), {"permutation": [2, 0, 1]}),
+        ("transpose", (2, 3, 4, 5), (4, 5, 2, 3), {"permutation": [2, 3, 0, 1]}),
+        ("slice", (5, 6), (3, 3), {"starts": [0, 1], "stops": [5, 6], "steps": [2, 2]}),
+        ("slice", (4, 5, 6), (4, 5, 3), {"starts": [1], "stops": [6], "steps": [2], "axes": [2]}),
+    )
+    compared = 0
+    for dtype in ("float32", "bf16", "int8"):
+        for name, input_shape, output_shape, attributes in cases:
+            program = _layout_program(name, input_shape, output_shape, attributes, dtype)
+            avx2_ir = Avx2Compiler().lower(program, AVX2_TARGET)
+            avx512_ir = Avx512Compiler().lower(program, avx512_target)
+            avx2_plan = avx2_ir.plans[0].layout_plan
+            avx512_plan = avx512_ir.plans[0].layout_plan
+            assert avx2_plan is not None and avx512_plan is not None
+            assert avx2_plan.descriptor_digest == avx512_plan.descriptor_digest
+            assert avx2_runtime._layout_descriptor_bytes(
+                avx2_plan
+            ) == avx512_runtime._layout_descriptor_bytes(avx512_plan)
+            compared += 1
+    assert compared == len(cases) * 3
+
+
