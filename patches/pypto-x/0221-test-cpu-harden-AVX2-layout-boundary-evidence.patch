-def test_every_single_byte_descriptor_mutation_is_rejected(tmp_path, monkeypatch):
-    """A 1-byte edit anywhere in the wire must be rejected (magic != enough)."""
+#: PXLD v2 header: ``<4s5I2Q`` = magic(0..3) / version(4..7) / input_rank(8..11)
+#: / output_rank(12..15) / kind(16..19) / reserved u32(20..23) /
+#: source_elements(24..31) / output_elements(32..39).  The C decoder never
+#: reads the reserved field, so a single-byte flip there is benign and must
+#: leave the output byte-identical; every other byte position must fail closed.
+_RESERVED_DESCRIPTOR_BYTES = frozenset(range(20, 24))
+
+
+def _descriptor_buffer(payload):
+    """8-byte aligned descriptor buffer (mirrors the runtime's own layout)."""
+
+    words = (len(payload) + 7) // 8
+    padded = payload + b"\x00" * (words * 8 - len(payload))
+    return (ctypes.c_uint64 * words).from_buffer_copy(padded)
+
+
+def test_all_descriptor_byte_mutations_are_rejected_except_reserved_bytes(tmp_path, monkeypatch):
+    """Exhaustive 1-byte mutation sweep over the whole PXLD v2 wire.
+
+    The runtime's own ``_layout_descriptor_bytes`` output is the baseline; each
+    of the ``len(payload)`` byte positions is XORed with 0xFF and the public
+    ``launch`` path is exercised.  Positions 20-23 (reserved u32) are ignored
+    by the decoder and must still produce the reference output; every other
+    position must be rejected and must leave the caller buffer untouched.
+    """
 
     runtime = _runtime()
     program = _layout_program("transpose", (2, 3, 4), (4, 3, 2), {"permutation": [2, 1, 0]}, "float32")
-    _target_ir, artifact = _compile(program, tmp_path, "byte-edit")
+    _target_ir, artifact = _compile(program, tmp_path, "byte-sweep")
     payload, _buffer = avx2_runtime._layout_descriptor_buffer(_target_ir.plans[0].layout_plan)
     source = _raw_array("float32", _pattern_bits("float32", 24))
-    observed = set()
-    for position in (0, 4, 8, 12, 16, 24, 32, len(payload) - 1):
+    sentinel = 0xDEADBEEF
+
+    reference = _raw_array("float32", [0] * 24)
+    _launch_raw(
+        artifact, [("float32", (2, 3, 4), source)], [("float32", (4, 3, 2), reference)], runtime
+    )
+    reference_sha256 = _buffer_sha256(reference)
+
+    avx2_runtime.reset_layout_native_stats()
+    rejected = []
+    benign = []
+    for position in range(len(payload)):
         mutated = bytearray(payload)
         mutated[position] ^= 0xFF
-        array = (ctypes.c_ubyte * len(mutated)).from_buffer_copy(bytes(mutated))
+        array = _descriptor_buffer(bytes(mutated))
         monkeypatch.setattr(
             avx2_runtime,
             "_layout_descriptor_buffer",
             lambda layout, array=array, payload=bytes(mutated): (payload, array),
         )
-        output = _raw_array("float32", [0] * 24)
+        output = _raw_array("float32", [sentinel] * 24)
+        if position in _RESERVED_DESCRIPTOR_BYTES:
+            _launch_raw(
+                artifact,
+                [("float32", (2, 3, 4), source)],
+                [("float32", (4, 3, 2), output)],
+                runtime,
+            )
+            assert _buffer_sha256(output) == reference_sha256, position
+            benign.append(position)
+            continue
         with pytest.raises(CpuAvx2ExecutionError, match="rejected the descriptor"):
             _launch_raw(
                 artifact,
@@ -1009,8 +1155,15 @@ def test_every_single_byte_descriptor_mutation_is_rejected(tmp_path, monkeypatch
                 [("float32", (4, 3, 2), output)],
                 runtime,
             )
-        observed.add(position)
-    assert observed
+        assert ctypes.string_at(ctypes.addressof(output), ctypes.sizeof(output)) == struct.pack(
+            "<%dI" % len(output), *[sentinel] * len(output)
+        ), position
+        rejected.append(position)
+    assert tuple(benign) == tuple(sorted(_RESERVED_DESCRIPTOR_BYTES))
+    assert rejected == [
+        position for position in range(len(payload)) if position not in _RESERVED_DESCRIPTOR_BYTES
+    ]
+    assert avx2_runtime.layout_native_stats()["descriptor_rejections"] == len(rejected)
 
 
