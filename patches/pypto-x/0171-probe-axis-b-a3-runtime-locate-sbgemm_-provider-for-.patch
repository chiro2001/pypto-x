From 40647d8e926adaa73a07dbb449f3cd432cdd3222 Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:55:09 +0800
Subject: [PATCH 171/235] probe(axis-b-a3-runtime): locate sbgemm_ provider for
 vllm _C dlopen

---
 scripts/a3_axis_b_runtime/02_a3_sbgemm_probe.sh | 74 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/scripts/a3_axis_b_runtime/02_a3_sbgemm_probe.sh b/scripts/a3_axis_b_runtime/02_a3_sbgemm_probe.sh
new file mode 100755
index 000000000..d983ffb7f
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/02_a3_sbgemm_probe.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# axis-b-a3-runtime 02: find a provider for the undefined `sbgemm_` symbol that
+# blocks dlopen of vllm/_C.abi3.so against the inherited torch 2.14.0+cu130.
+# Read-only; CPUs 600-639; NPU env cleared.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+LOGS="$RUN/logs"
+RAW="$RUN/raw"
+BASE_PY="$HOME/pypto-x-a3/envs/pypto-x-c8/bin/python"
+PY="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb/bin/python"
+SO="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb/lib/python3.12/site-packages/vllm/_C.abi3.so"
+CPUS="${AXISB_CPUS:-600-639}"
+
+mkdir -p "$LOGS" "$RAW"
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+
+echo "### 02_a3_sbgemm_probe A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+TORCH_DIR="$(taskset -c "$CPUS" "$BASE_PY" -c 'import torch, os; print(os.path.dirname(torch.__file__))' 2>/dev/null)"
+echo "torch_dir=$TORCH_DIR"
+TL="$TORCH_DIR/lib"
+echo "--- torch lib dir ---"
+ls -la "$TL" 2>/dev/null | grep -iE 'openblas|blas|lapack|libtorch_cpu|libc10|global_deps' | head -20
+echo "--- sbgemm_ in each torch lib ---"
+for f in "$TL"/*.so*; do
+    n=$(nm -D "$f" 2>/dev/null | grep -c 'sbgemm_' || true)
+    [[ "$n" != "0" ]] && echo "$f sbgemm_=$n"
+done
+echo "--- system BLAS ---"
+ldconfig -p 2>/dev/null | grep -iE 'openblas|blas|lapack' | head -10
+for f in /usr/lib64/libopenblas*.so* /usr/lib64/libblas*.so* /usr/lib64/liblapack*.so*; do
+    [[ -e "$f" ]] || continue
+    n=$(nm -D "$f" 2>/dev/null | grep -c 'sbgemm_' || true)
+    echo "$f sbgemm_=$n"
+done
+
+echo "--- does loading system openblas global resolve vllm._C? ---"
+SYS_BLAS="$(ldconfig -p 2>/dev/null | awk '/libopenblas\.so/{print $NF; exit}')"
+echo "sys_blas=$SYS_BLAS"
+if [[ -n "${SYS_BLAS:-}" ]]; then
+    LD_PRELOAD="$SYS_BLAS" taskset -c "$CPUS" timeout 300 "$PY" -c '
+import ctypes, sys
+try:
+    import vllm._C
+    print("IMPORT_VLLM_C_OK_WITH_LD_PRELOAD")
+except BaseException as e:
+    print("IMPORT_VLLM_C_FAIL_WITH_LD_PRELOAD", type(e).__name__, str(e)[:500])
+' 2>&1 | tail -8
+    taskset -c "$CPUS" timeout 300 "$PY" -c '
+import ctypes, sys
+blas = "'"$SYS_BLAS"'"
+ctypes.CDLL(blas, mode=ctypes.RTLD_GLOBAL)
+try:
+    import vllm._C
+    print("IMPORT_VLLM_C_OK_WITH_RTLD_GLOBAL", blas)
+except BaseException as e:
+    print("IMPORT_VLLM_C_FAIL_WITH_RTLD_GLOBAL", type(e).__name__, str(e)[:500])
+' 2>&1 | tail -8
+fi
+
+echo "--- exported sbgemm_-adjacent symbols in system blas (context) ---"
+if [[ -n "${SYS_BLAS:-}" ]]; then
+    nm -D "$SYS_BLAS" 2>/dev/null | grep -iE 'sb?gemm|bfloat|bf16' | head -20
+fi
+
+echo "--- which blas-ish libs export sbgemm_ anywhere in env/base ---"
+for d in "$HOME/pypto-x-a3/envs" /usr/lib64 "$TL"; do
+    find "$d" -maxdepth 7 \( -iname '*blas*' -o -iname '*torch_cpu*' -o -iname '*mkl*' \) -name '*.so*' 2>/dev/null | while read -r f; do
+        if nm -D "$f" 2>/dev/null | grep -q 'sbgemm_'; then echo "HAS_SBGEMM $f"; fi
+    done
+done | sort -u | head -20
+echo "### done A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
