     for index, cache_layer in enumerate(cache.layers):
         snap = snapshots.get(index, {})
         if hasattr(cache_layer, "conv_states"):
             if "conv" in snap:
-                tensor = torch.as_tensor(np.ascontiguousarray(snap["conv"]), dtype=dtype)
+                tensor = torch.as_tensor(np.ascontiguousarray(snap["conv"]),
+                                         dtype=dtype_by_kind["conv"])
                 cache_layer.conv_states[0] = tensor
                 cache_layer.is_conv_states_initialized[0] = True
                 cache_layer.conv_kernel_size[0] = int(tensor.shape[-1])
             if "recurrent" in snap:
                 cache_layer.recurrent_states[0] = torch.as_tensor(
-                    np.ascontiguousarray(snap["recurrent"]), dtype=dtype)
+                    np.ascontiguousarray(snap["recurrent"]), dtype=dtype_by_kind["recurrent"])
                 cache_layer.is_recurrent_states_initialized[0] = True
                 cache_layer.has_previous_state[0] = True
-            cache_layer.dtype = dtype
+            cache_layer.dtype = dtype_by_kind.get("conv", dtype_by_kind.get("recurrent"))
             cache_layer.device = torch.device("cpu")
         else:
             if "k" in snap and "v" in snap:
-                cache_layer.keys = torch.as_tensor(np.ascontiguousarray(snap["k"]), dtype=dtype)
-                cache_layer.values = torch.as_tensor(np.ascontiguousarray(snap["v"]), dtype=dtype)
+                cache_layer.keys = torch.as_tensor(np.ascontiguousarray(snap["k"]),
+                                                   dtype=dtype_by_kind["k"])
+                cache_layer.values = torch.as_tensor(np.ascontiguousarray(snap["v"]),
+                                                     dtype=dtype_by_kind["v"])
                 cache_layer.is_initialized = True
-                cache_layer.dtype = dtype
+                cache_layer.dtype = dtype_by_kind["k"]
                 cache_layer.device = torch.device("cpu")
 
 
