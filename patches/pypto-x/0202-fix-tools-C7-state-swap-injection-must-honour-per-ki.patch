+#!/usr/bin/env python3
+"""C7 诊断：汇总 compare_states.json（state 对比）成可引用的小 JSON。
+
+输入：compare_states.json（ours state vs gold HF state 的逐层/逐步对比）
+       decode_gap_analysis.json（logits 缺口，用来对齐 state 输入误差 → logits 误差）
+输出：state_compare_summary.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import statistics
+from pathlib import Path
+
+CONFIGS = ("default", "full")
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+KINDS = ("conv_state", "recurrent_state", "key_cache", "value_cache")
+TAGS = ("after_prefill", "step_0", "step_1", "step_2", "step_3", "step_4")
+
+
+def collect(prompt_data, kind, tag):
+    values = []
+    for layer, entry in prompt_data.get("layers", {}).items():
+        step = entry.get(kind, {}).get("steps", {}).get(tag)
+        if step and step.get("status") == "ok":
+            values.append((layer, step))
+    return values
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--compare", required=True)
+    parser.add_argument("--analysis", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    compare = json.loads(Path(args.compare).read_text(encoding="utf-8"))
+    analysis = json.loads(Path(args.analysis).read_text(encoding="utf-8"))
+    out = {"tool": "analyze_state_compare",
+           "source": {"compare": args.compare, "analysis": args.analysis},
+           "prompts": {}, "correlations": {}, "status_counts": {}}
+
+    status_counts = {}
+    for config in CONFIGS:
+        for prompt in PROMPTS:
+            prompt_data = compare.get("configs", {}).get(config, {}).get("prompts", {}).get(prompt, {})
+            if "layers" not in prompt_data:
+                out["prompts"]["{}|{}".format(config, prompt)] = {"status": prompt_data.get("status", "unknown")}
+                continue
+            entry = {"by_kind_tag": {}, "layers_prefill_range": {}, "logits_series": []}
+            for kind in KINDS:
+                for tag in TAGS:
+                    items = collect(prompt_data, kind, tag)
+                    if not items:
+                        continue
+                    rels = [item[1]["rel_l2"] for item in items]
+                    cosines = [item[1]["cosine"] for item in items]
+                    finite = all(item[1].get("finite_ours") and item[1].get("finite_gold") for item in items)
+                    bitwise = sum(1 for item in items if item[1].get("bitwise_equal_float32_cast"))
+                    key = "{}|{}".format(kind, tag)
+                    entry["by_kind_tag"][key] = {
+                        "layers": len(items),
+                        "rel_l2_median": statistics.median(rels),
+                        "rel_l2_min": min(rels),
+                        "rel_l2_max": max(rels),
+                        "cosine_median": statistics.median(cosines),
+                        "all_finite": finite,
+                        "bitwise_equal_count": bitwise,
+                    }
+                    status_counts["ok"] = status_counts.get("ok", 0) + len(items)
+                    if not finite:
+                        status_counts["nonfinite"] = status_counts.get("nonfinite", 0) + 1
+            # 最差输入步的逐层 top / bottom
+            for kind in KINDS:
+                items = collect(prompt_data, kind, "step_2")
+                if items:
+                    items.sort(key=lambda item: -item[1]["rel_l2"])
+                    entry.setdefault("step_2_top_layers", {})[kind] = [
+                        {"layer": item[0], "rel_l2": item[1]["rel_l2"],
+                         "cosine": item[1]["cosine"], "max_abs": item[1]["max_abs"]}
+                        for item in items[:5]]
+                    entry.setdefault("step_2_bottom_layers", {})[kind] = [
+                        {"layer": item[0], "rel_l2": item[1]["rel_l2"]} for item in items[-3:]]
+            # logits 序列
+            rows = analysis.get("configs", {}).get(config, {}).get("prompts", {}).get(prompt, {}).get("rows", [])
+            for row in rows:
+                if "ours" in row:
+                    entry["logits_series"].append({
+                        "row": row["row"],
+                        # ours-vs-gold 相对 L2（同空间），不是 band 比
+                        "rel_l2": (row["ours"]["delta_norm"] / row["ours"]["gold_norm"]
+                                   if row["ours"]["gold_norm"] else None),
+                        "band_norm_ratio": (row["ours"]["delta_norm"] / row["gold_vs_fp32"]["delta_norm"]
+                                            if row["gold_vs_fp32"]["delta_norm"] else None),
+                        "cosine": row["ours"]["cosine"],
+                    })
+            out["prompts"]["{}|{}".format(config, prompt)] = entry
+
+    # 相关性：state 输入误差（各 kind 中位） vs 同一步 logits rel_l2
+    points = []
+    for config in CONFIGS:
+        for prompt in PROMPTS:
+            key = "{}|{}".format(config, prompt)
+            if key not in out["prompts"]:
+                continue
+            entry = out["prompts"][key]
+            series = {item["row"]: item for item in entry.get("logits_series", [])}
+            for step_index, tag in enumerate(TAGS):
+                if step_index == 0:
+                    tag = "after_prefill"
+                else:
+                    tag = "step_{}".format(step_index - 1)
+                if tag not in ("after_prefill", "step_0", "step_1", "step_2", "step_3"):
+                    continue
+                logits = series.get(step_index)
+                if not logits or logits.get("rel_l2") is None:
+                    continue
+                state_medians = []
+                for kind in KINDS:
+                    item = entry["by_kind_tag"].get("{}|{}".format(kind, tag))
+                    if item:
+                        state_medians.append(item["rel_l2_median"])
+                if state_medians:
+                    x = statistics.median(state_medians)
+                    points.append({"config": config, "prompt": prompt, "step": step_index,
+                                   "state_input_median_rel_l2": x,
+                                   "logits_rel_l2": logits["rel_l2"]})
+    if len(points) >= 3:
+        xs = [p["state_input_median_rel_l2"] for p in points]
+        ys = [p["logits_rel_l2"] for p in points]
+        mx, my = statistics.mean(xs), statistics.mean(ys)
+        cov = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
+        sx = math.sqrt(sum((x - mx) ** 2 for x in xs))
+        sy = math.sqrt(sum((y - my) ** 2 for y in ys))
+        pearson = cov / (sx * sy) if sx and sy else None
+        out["correlations"] = {
+            "n_points": len(points),
+            "pearson_state_input_vs_logits": pearson,
+            "amplification_logits_over_state_median": statistics.median(
+                [p["logits_rel_l2"] / p["state_input_median_rel_l2"] for p in points]),
+            "points": points,
+        }
+    out["status_counts"] = status_counts
+    # row0（prefill_next）单独统计：state 输入 tag=after_prefill
+    out["prefill_state_vs_row0"] = []
+    for config in CONFIGS:
+        for prompt in PROMPTS:
+            key = "{}|{}".format(config, prompt)
+            entry = out["prompts"].get(key)
+            if not entry or "by_kind_tag" not in entry:
+                continue
+            state = [entry["by_kind_tag"].get("{}|after_prefill".format(kind)) for kind in KINDS]
+            state = [item for item in state if item]
+            logits = next((item for item in entry["logits_series"] if item["row"] == 0), None)
+            out["prefill_state_vs_row0"].append({
+                "config": config, "prompt": prompt,
+                "state_prefill_median_rel_l2": statistics.median([item["rel_l2_median"] for item in state]),
+                "row0_logits_rel_l2": logits["rel_l2"] if logits else None,
+            })
+    output = Path(args.output)
+    output.write_text(json.dumps(out, indent=1), encoding="utf-8")
+    print("[analyze_state_compare] wrote {}".format(output))
+    print("[analyze_state_compare] status_counts={}".format(status_counts))
+    if out["correlations"]:
+        print("[analyze_state_compare] pearson(state_input, logits)={:.3f} n={} median amplification={:.2f}".format(
+            out["correlations"]["pearson_state_input_vs_logits"] or float("nan"),
+            out["correlations"]["n_points"],
+            out["correlations"]["amplification_logits_over_state_median"]))
+
+
+if __name__ == "__main__":
+    main()
