+def gold_dtype_map(gold_dir):
+    """从 gold dump manifest 读 per-key 原始 dtype；按 kind 归并（要求同 kind 一致）。"""
+    import torch
+    manifest_path = Path(gold_dir) / "gold_states_manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    mapping = {}
+    name_map = {"conv_state": "conv", "recurrent_state": "recurrent",
+                "key_cache": "k", "value_cache": "v"}
+    for run in manifest.get("runs", []):
+        for key, dtype_name in run.get("state_dtypes", {}).items():
+            kind = name_map[key.split("__")[-1]]
+            dtype = getattr(torch, dtype_name.replace("torch.", ""))
+            if kind in mapping and mapping[kind] != dtype:
+                raise SystemExit("gold dtype 不一致: {} {} vs {}".format(kind, mapping[kind], dtype))
+            mapping[kind] = dtype
+    if not mapping:
+        raise SystemExit("gold manifest 无 state_dtypes: {}".format(manifest_path))
+    return mapping
+
+
 def make_cache(model):
