+++ b/scripts/perf/lac_analyze.py
@@ -100,6 +100,90 @@ def counter_table(rows: List[Dict[str, Any]], n4: Any) -> List[str]:
     return lines
 
 
+def _driver_outputs(driver: Dict[str, Any], step: int) -> Dict[str, Any]:
+    if step < 0:
+        return driver.get("outputs", {})
+    decode_steps = driver.get("decode_steps") or []
+    if step >= len(decode_steps):
+        return {}
+    return decode_steps[step].get("outputs", {})
+
+
+def _driver_artifact_digest(driver: Dict[str, Any], step: int) -> Any:
+    if step < 0:
+        return driver.get("compile", {}).get("artifact_content_digest")
+    decode_steps = driver.get("decode_steps") or []
+    if step >= len(decode_steps):
+        return None
+    return decode_steps[step].get("compile", {}).get("artifact_content_digest")
+
+
+def bit_check_all(rounds: Dict[str, Any]) -> Any:
+    """Cross-check every prefill buffer, every decode-step buffer and both artifact digests."""
+
+    tags = [tag for tag in ROUNDS if tag in rounds]
+    decode_steps = max(
+        (len(rounds[tag]["driver"].get("decode_steps") or []) for tag in tags), default=0
+    )
+    groups = [("prefill outputs", -1)]
+    groups.extend(("decode[{}] outputs".format(step), step) for step in range(decode_steps))
+
+    lines = [
+        "| group | buffers | unique sha256 sets | identical |",
+        "|---|---:|---:|---|",
+    ]
+    mismatches: List[str] = []
+    summary: Dict[str, Any] = {}
+    for label, step in groups:
+        names = sorted(
+            {
+                name
+                for tag in tags
+                for name in _driver_outputs(rounds[tag]["driver"], step)
+            }
+        )
+        unique_sets = 0
+        bad: List[str] = []
+        for name in names:
+            values = {
+                _driver_outputs(rounds[tag]["driver"], step)[name]["raw_sha256"]
+                for tag in tags
+                if name in _driver_outputs(rounds[tag]["driver"], step)
+            }
+            if len(values) != 1:
+                bad.append(name)
+            unique_sets = max(unique_sets, len(values))
+        if bad:
+            mismatches.extend("{}:{}".format(label, name) for name in bad)
+        identical = not bad
+        summary[label] = {
+            "buffers": len(names),
+            "identical": identical,
+            "mismatches": bad,
+        }
+        lines.append(
+            "| {} | {} | {} | {} |".format(label, len(names), unique_sets, identical)
+        )
+
+    digest_groups: Dict[str, List[Any]] = {}
+    digest_lines: List[str] = []
+    for label, step in groups:
+        digests = {_driver_artifact_digest(rounds[tag]["driver"], step) for tag in tags}
+        digest_groups[label] = sorted(str(value) for value in digests)
+        digest_lines.append(
+            "| {} artifact_content_digest | {} | {} |".format(
+                label, ", ".join(sorted(str(value) for value in digests)), len(digests) == 1
+            )
+        )
+    digest_ok = all(len(values) == 1 for values in digest_groups.values())
+    ok = not mismatches and digest_ok
+    lines.append("")
+    lines.append("| digest | unique values across rounds | identical |")
+    lines.append("|---|---|---|")
+    lines.extend(digest_lines)
+    return ok, lines, {"groups": summary, "artifact_digests": digest_groups, "mismatches": mismatches}
+
+
 def main() -> int:
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument("--evidence", required=True)
@@ -155,8 +239,12 @@ def main() -> int:
     sections.extend(counter_table(rows, n4))
     sections.append("")
 
-    ok, bit_lines = n4.bit_check(rounds)
+    ok, bit_lines, bit_summary = bit_check_all(rounds)
     sections.append("## Bit-level regression across every interleaved round")
