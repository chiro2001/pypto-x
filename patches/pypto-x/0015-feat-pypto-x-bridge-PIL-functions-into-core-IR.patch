+def export_with_tensor_parser(parsed_input: Any, parser: Any) -> CoreProgram:
+    """显式执行一次 Tensor parser，然后导出同一份 PIL/Core 输入。
+
+    该入口是 target-neutral 的：parser 的结果只在这里产生一次，后续
+    backend 应缓存并共享返回的 ``CoreProgram``，不能按 target 重新调用
+    ``parsed_callable`` 或 parser。
+    """
+
+    if not callable(parser):
+        raise CoreExportError("Tensor parser 必须是 callable")
+    return export_tensor_frontend(parser(parsed_input))
+
+
+def _export_pil_if_available(
+    export_input: Any,
+    *,
+    name: Optional[str],
+    metadata: Optional[Mapping[str, Any]],
+) -> Optional[CoreProgram]:
+    """Lazily route a parsed PIL Function without importing native PIL types."""
+
+    # Avoid importing pypto.pil.pir here: the actual package initializer can
+    # require CANN shared libraries.  The bridge's structural check handles
+    # the native class and pure-Python fakes alike.
+    try:
+        from .pil_core_bridge import export_pil_function, is_pil_function
+    except (ImportError, ModuleNotFoundError):
+        return None
+    if not is_pil_function(export_input):
+        return None
+    return export_pil_function(export_input, name=name, metadata=metadata)
+
+
 def native_parser_available() -> bool:
