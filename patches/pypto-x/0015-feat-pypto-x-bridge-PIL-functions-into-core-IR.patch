+def test_core_export_routes_pil_and_parser_is_called_once():
+    function = _function_with_add()
+    parsed = {"count": 0}
+
+    def parser(source):
+        assert source == "kernel"
+        parsed["count"] += 1
+        return function
+
+    saved_bridge = sys.modules.get("pypto.frontend.pil_core_bridge")
+    sys.modules["pypto.frontend.pil_core_bridge"] = BRIDGE
+    try:
+        program = CORE_EXPORT.export_tensor_frontend("kernel", parser=parser)
+        direct = CORE_EXPORT.export_tensor_frontend(function)
+    finally:
+        if saved_bridge is None:
+            sys.modules.pop("pypto.frontend.pil_core_bridge", None)
+        else:
+            sys.modules["pypto.frontend.pil_core_bridge"] = saved_bridge
+    assert parsed["count"] == 1
+    assert program.functions[0].name == "add"
+    assert direct == program
+
