+def test_effect_override_accepts_known_value_and_unknown_is_not_silent():
+    result = FakeValue(1)
+    call = FakeCall(result, "vendor.op", (), ())
+    call.effect = "write"
+    body = FakeBlock(id=0, args=(), calls=[call], result=result, jump="RETURN")
+    program = BRIDGE.export_pil_function(FakeFunction("effect", body))
+    assert program.functions[0].body.operations[0].effect is Effect.WRITE
+
+    call.effect = "future_effect"
+    program = BRIDGE.export_pil_function(FakeFunction("effect_unknown", body))
+    assert program.functions[0].body.operations[0].effect is Effect.READ_WRITE
+    assert any(item["kind"] == "unknown_effect" for item in program.metadata["diagnostics"])
+
