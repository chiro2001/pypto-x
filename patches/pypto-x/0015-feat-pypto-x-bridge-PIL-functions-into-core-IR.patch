+def test_unsupported_node_contains_structural_path():
+    body = FakeBlock(id=0, args=(), calls=[object()], result=None, jump="RETURN")
+    with pytest.raises(BRIDGE.UnsupportedPILNodeError, match=r"function\.body\.calls\[0\]"):
+        BRIDGE.export_pil_function(FakeFunction("bad", body, params=()))
