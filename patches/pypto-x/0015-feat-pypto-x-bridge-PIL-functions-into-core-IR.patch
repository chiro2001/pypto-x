@@ -0,0 +1,267 @@
+"""W2 Tensor/PIL -> Core IR bridge tests.
+
+These tests deliberately use a tiny fake of ``pypto.pil.pir``.  The bridge is
+duck-typed and must remain useful when the native PyPTO shared libraries are
+not installed, while still preserving the real PIL Function/Block/Call/Value
+shape and the one-pass parser boundary.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import importlib.util
+from pathlib import Path
+import operator
+import sys
+import types
+from typing import Optional
+
+import pytest
+
+
+def _load_modules():
+    repository_root = Path(__file__).resolve().parents[4]
+    package_root = repository_root / "python" / "pypto"
+    module_names = (
+        "pypto",
+        "pypto.core_ir",
+        "pypto.core_ir.model",
+        "pypto.frontend",
+        "pypto.frontend.core_export",
+        "pypto.frontend.pil_core_bridge",
+    )
+    saved = {name: sys.modules.get(name) for name in module_names}
+    isolated_pypto = types.ModuleType("pypto")
+    isolated_pypto.__path__ = [str(package_root)]
+    for name in module_names:
+        sys.modules.pop(name, None)
+    sys.modules["pypto"] = isolated_pypto
+    try:
+        core_spec = importlib.util.spec_from_file_location(
+            "pypto.core_ir",
+            package_root / "core_ir" / "__init__.py",
+            submodule_search_locations=[str(package_root / "core_ir")],
+        )
+        assert core_spec.loader is not None
+        core_ir = importlib.util.module_from_spec(core_spec)
+        sys.modules["pypto.core_ir"] = core_ir
+        core_spec.loader.exec_module(core_ir)
+
+        frontend = types.ModuleType("pypto.frontend")
+        frontend.__path__ = [str(package_root / "frontend")]
+        sys.modules["pypto.frontend"] = frontend
+
+        export_spec = importlib.util.spec_from_file_location(
+            "pypto.frontend.core_export", package_root / "frontend" / "core_export.py"
+        )
+        assert export_spec.loader is not None
+        core_export = importlib.util.module_from_spec(export_spec)
+        sys.modules["pypto.frontend.core_export"] = core_export
+        export_spec.loader.exec_module(core_export)
+
+        bridge_spec = importlib.util.spec_from_file_location(
+            "pypto.frontend.pil_core_bridge", package_root / "frontend" / "pil_core_bridge.py"
+        )
+        assert bridge_spec.loader is not None
+        bridge = importlib.util.module_from_spec(bridge_spec)
+        sys.modules["pypto.frontend.pil_core_bridge"] = bridge
+        bridge_spec.loader.exec_module(bridge)
+        return core_ir, core_export, bridge
+    finally:
+        for name, module in saved.items():
+            if module is None:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = module
+
+
+CORE_IR, CORE_EXPORT, BRIDGE = _load_modules()
+CoreType = CORE_IR.CoreType
+Effect = CORE_IR.Effect
+
+
+@dataclass(frozen=True)
+class FakeValue:
+    id: int
+    type: Optional[object] = None
+
+
+@dataclass
+class FakeCall:
+    result: Optional[FakeValue]
+    callee: object
+    args: tuple[object, ...] = ()
+    kwargs: object = ()
+    span: Optional[object] = None
+
+
+@dataclass
+class FakeBlock:
+    id: int
+    args: tuple[object, ...]
+    calls: list[object]
+    result: Optional[object] = None
+    jump: Optional[object] = None
+
+
+@dataclass
+class FakeFunction:
+    name: str
+    body: FakeBlock
+    params: tuple[str, ...] = ()
+    signature: Optional[object] = None
+
+
+def _function_with_add() -> FakeFunction:
+    x = FakeValue(1)
+    y = FakeValue(2)
+    loaded_x = FakeValue(10)
+    loaded_y = FakeValue(11)
+    result = FakeValue(12)
+    body = FakeBlock(
+        id=0,
+        args=(),
+        calls=[
+            FakeCall(loaded_x, "pil.load", ("x",)),
+            FakeCall(loaded_y, "pil.load", ("y",)),
+            FakeCall(result, operator.add, (loaded_x, loaded_y)),
+            FakeCall(None, "pil.store", ("$retval", result)),
+        ],
+        result=result,
+        jump="RETURN",
+    )
+    # The ids on parameters are optional in real pir.Function (which exposes
+    # names); keeping x/y alive here documents that the fake has real PIL
+    # values available if a future bridge version consumes them.
+    del x, y
+    return FakeFunction("add", body, params=("x", "y"))
+
+
+def test_fake_pil_function_maps_params_values_calls_and_return_deterministically():
+    function = _function_with_add()
+    program = BRIDGE.export_pil_function(function)
+    assert program.verify() is True
+    core_function = program.functions[0]
+    assert [parameter.name for parameter in core_function.parameters] == ["x", "y"]
+    assert core_function.returns[0].name == "%v12"
+    assert [operation.name for operation in core_function.body.operations] == [
+        "pil.load",
+        "pil.load",
+        "add",
+        "pil.store",
+        "return",
+    ]
+    assert core_function.body.operations[2].attributes["semantic_op"] == "add"
+    first = program.canonical_json()
+    assert first == program.canonical_json()
+    assert "0x" not in first
+
+
+def test_nested_blocks_and_value_id_are_preserved_as_regions():
+    condition = FakeValue(1)
+    then_result = FakeValue(2)
+    else_result = FakeValue(3)
+    branch_result = FakeValue(4)
+    then_block = FakeBlock(
+        id=7,
+        args=(),
+        calls=[FakeCall(then_result, "pil.const", (1,))],
+        result=then_result,
+        jump="END_BRANCH",
+    )
+    else_block = FakeBlock(
+        id=8,
+        args=(),
+        calls=[FakeCall(else_result, "pil.const", (2,))],
+        result=else_result,
+        jump="END_BRANCH",
+    )
+    body = FakeBlock(
+        id=0,
+        args=(),
+        calls=[FakeCall(branch_result, "pil.if_else", (condition, then_block, else_block))],
+        result=branch_result,
+        jump="RETURN",
+    )
+    program = BRIDGE.export_pil_function(FakeFunction("branch", body, params=()))
+    assert program.verify() is True
+    branch = next(operation for operation in program.functions[0].body.operations if operation.name == "pil.if_else")
+    assert branch.name == "pil.if_else"
+    assert len(branch.regions) == 2
+    assert [block.label for block in branch.regions[0].blocks] == ["block_7"]
+    assert [block.label for block in branch.regions[1].blocks] == ["block_8"]
+    assert branch.regions[0].blocks[0].operations[-1].name == "yield"
+
+
+def test_unknown_types_and_effects_are_explicit_and_conservative():
+    result = FakeValue(2)
+    body = FakeBlock(
+        id=0,
+        args=(),
+        calls=[FakeCall(result, "vendor.custom_op", (FakeValue(1),))],
+        result=result,
+        jump="RETURN",
+    )
+    program = BRIDGE.export_pil_function(FakeFunction("unknown", body, params=()))
+    diagnostics = program.metadata["diagnostics"]
+    assert any(item["kind"] == "unknown_type" for item in diagnostics)
+    assert any(item["kind"] == "unknown_effect" for item in diagnostics)
+    custom = next(operation for operation in program.functions[0].body.operations if operation.name == "vendor.custom_op")
+    assert custom.effect is Effect.READ_WRITE
+    assert custom.outputs[0].type.kind == "unknown"
+    assert custom.outputs[0].type.dtype == "unknown"
+
