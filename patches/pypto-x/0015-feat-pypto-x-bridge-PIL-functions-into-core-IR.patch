+def test_operation_inputs_deduplicate_repeated_value_without_losing_argument_order():
+    x = FakeValue(1)
+    result = FakeValue(2)
+    body = FakeBlock(id=0, args=(), calls=[FakeCall(result, operator.add, (x, x))], result=result, jump="RETURN")
+    program = BRIDGE.export_pil_function(FakeFunction("same", body))
+    assert program.verify() is True
+    operation = next(operation for operation in program.functions[0].body.operations if operation.name == "add")
+    assert [ref.name for ref in operation.inputs] == ["%v1"]
+    assert list(operation.attributes["args"]) == [{"value": "%v1"}, {"value": "%v1"}]
