index 000000000..38f96a5c6
--- /dev/null
+++ b/python/tests/ut/pypto_x/ascend_cann_hook_live_driver.py
@@ -0,0 +1,299 @@
+#!/usr/bin/env python3
+"""W8A-C live acceptance driver for the real CANN Ascend hook.
+
+Run this file **on the Ascend target** (A2/910B3) inside an environment where
+``source $ASCEND_HOME_PATH/set_env.sh`` (or the toolkit ``setenv.bash``) has
+been sourced and ``PYPTO_X_PTO_ISA_ROOT`` points at a PTO-ISA checkout:
+
+    export PYPTO_X_PTO_ISA_ROOT=/root/pto-isa-668248ec
+    PYTHONPATH=<repo>/python python3 ascend_cann_hook_live_driver.py --out report.json
+
+It exercises the real CANN path through the injected hook seam:
+
+* ``PYPTO_X_ASCEND_HOOKS`` environment injection through ``default_ascend_hooks``
+* real Bisheng/CCE compile -> private ``AscendArtifactPayload`` -> public ``Artifact``
+* ``load`` / ``workspace_size`` / ``launch`` on the device with output verification
+* the adapter validation paths (format, ABI, ordering, foreign-target artifact)
+
+The program description is deliberately a minimal mapping (float32 add with a
+fixed tile), not a Core-IR lowering; the Core IR -> PTO bridge is a separate
+future task (W8E/E4).  Nothing here may be read as a claim about general model
+lowering.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import os
+import sys
+import time
+import traceback
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+# Must be set before importing pypto so the upstream loader is not imported.
+os.environ.setdefault("PYPTO_X_PORTABLE_ONLY", "1")
+os.environ.setdefault("PYPTO_X_ASCEND_HOOKS", "ascend_cann_hook")
+
+import ascend_cann_hook as hook_module  # noqa: E402
+
+
+def _now():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def _json_default(value):
+    try:
+        return dict(value)
+    except (TypeError, ValueError):
+        return str(value)
+
+
+class Recorder:
+    def __init__(self):
+        self.checks = []
+        self.started_at = _now()
+
+    def check(self, name, function):
+        started = time.time()
+        entry = {"name": name, "status": "FAIL", "seconds": None, "detail": None}
+        try:
+            detail = function()
+            entry["status"] = "PASS"
+            entry["detail"] = detail
+            print("[check] {:<34} PASS".format(name))
+        except Exception as exc:  # noqa: BLE001 - the driver reports any failure
+            entry["detail"] = {
+                "exception": type(exc).__name__,
+                "message": str(exc),
+                "traceback_tail": traceback.format_exc().splitlines()[-6:],
+            }
+            print("[check] {:<34} FAIL: {}: {}".format(name, type(exc).__name__, exc))
+        entry["seconds"] = round(time.time() - started, 4)
+        self.checks.append(entry)
+        return entry["status"] == "PASS"
+
+    def finish(self, out_path=None):
+        passed = [c for c in self.checks if c["status"] == "PASS"]
+        payload = {
+            "driver": "ascend_cann_hook_live_driver",
+            "task": "qwen35-ascend-npu-acceptance",
+            "started_at": self.started_at,
+            "finished_at": _now(),
+            "status": "PASS" if len(passed) == len(self.checks) and self.checks else "FAIL",
+            "passed": len(passed),
+            "total": len(self.checks),
+            "checks": self.checks,
+        }
+        if out_path:
+            with open(out_path, "w", encoding="utf-8") as handle:
+                json.dump(payload, handle, indent=2, sort_keys=True, default=_json_default)
+        print("LIVE_DRIVER_RESULT={} ({}/{})".format(payload["status"], len(passed), len(self.checks)))
+        return payload
+
+
+def _expect_contract_error(label, function, match=None):
+    from pypto.target.errors import BackendContractError
+
+    try:
+        function()
+    except BackendContractError as exc:
+        text = str(exc)
+        if match is not None and match not in text:
+            raise AssertionError(
+                "{}: expected BackendContractError containing {!r}, got {!r}".format(label, match, text)
+            )
+        return {"raised": "BackendContractError", "message": text}
+    raise AssertionError("{}: expected BackendContractError, no error was raised".format(label))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", default=None, help="write the JSON report to this path")
+    parser.add_argument("--device", type=int, default=int(os.environ.get("PYPTO_X_ASCEND_DEVICE_ID", "0")))
+    args = parser.parse_args()
+
+    recorder = Recorder()
+
+    from pypto.abi import LaunchRequest, TensorDesc
+    from pypto.backends.ascend import AscendBackend, default_ascend_hooks
+    from pypto.compiler import CompileOptions, compile_program
+    from pypto.compiler.artifact import Artifact
+    from pypto.target.spec import TargetSpec
+
+    target = TargetSpec("ascend", "aarch64-linux-gnu", features=("aiv",))
+    format_name = hook_module.ARTIFACT_FORMAT
+    numel = hook_module.NUMEL
+
+    state = {}
+
+    def check_injection():
+        hooks = default_ascend_hooks()
+        assert isinstance(hooks, hook_module.CannHooks), "env injection returned {}".format(type(hooks).__name__)
+        status = hooks.availability()
+        assert status.available, "hook reports unavailable: {}".format(status.to_dict())
+        state["hooks"] = hooks
+        return {"hook_module": hooks.__class__.__module__, "availability": status.to_dict()}
+
+    def check_backend_availability():
+        backend = AscendBackend()
+        assert isinstance(backend.hooks, hook_module.CannHooks), "backend did not take the injected hook"
+        status = backend.availability()
+        assert status.available, status.to_dict()
+        state["backend"] = backend
+        return {"reason_code": status.reason_code, "details": status.details}
+
+    def check_compile():
+        artifact = compile_program(
+            state["backend"],
+            {"op": "add", "dtype": "float32", "rows": hook_module.TILE_ROWS, "cols": hook_module.TILE_COLS},
+            target,
+            CompileOptions(artifact_format=format_name, metadata={"origin": "live-driver"}),
+        )
+        assert isinstance(artifact, Artifact)
+        assert artifact.format == format_name, artifact.format
+        assert artifact.target == target
+        assert artifact.payload is None and artifact.path, "expected a path artifact"
+        assert artifact.metadata.get("artifact_sha256"), "missing compiled artifact digest"
+        assert artifact.metadata.get("compiler") == "bisheng"
+        state["artifact"] = artifact
+        return {
+            "artifact_format": artifact.format,
+            "entrypoint": artifact.entrypoint,
+            "abi_version": artifact.abi_version,
+            "path_bytes": os.path.getsize(artifact.path),
+            "artifact_sha256": artifact.metadata.get("artifact_sha256"),
+            "compiler_seconds": artifact.metadata.get("compiler_seconds"),
+            "kernel_source_sha256": artifact.metadata.get("kernel_source_sha256"),
+            "bisheng_log": artifact.metadata.get("bisheng_log"),
+        }
+
+    def check_compile_requires_lowered_wrapper():
+        return _expect_contract_error(
+            "raw compile", lambda: state["backend"].compile("raw-program"), match="AscendLoweredProgram"
+        )
+
+    def check_format_mismatch_rejected():
+        lowered = state["backend"].lower(
+            {"op": "add", "dtype": "float32", "rows": hook_module.TILE_ROWS, "cols": hook_module.TILE_COLS},
+            target,
+        )
+        return _expect_contract_error(
+            "wrong format",
+            lambda: state["backend"].compile(lowered, CompileOptions(artifact_format="not-our-format")),
+            match="format",
+        )
+
+    def check_abi_mismatch_rejected():
+        mismatched = hook_module.CannHooks(abi_version="99", device_id=args.device)
+        backend = AscendBackend(mismatched)
+        lowered = backend.lower(
+            {"op": "add", "dtype": "float32", "rows": hook_module.TILE_ROWS, "cols": hook_module.TILE_COLS},
+            target,
+        )
+        return _expect_contract_error(
+            "ABI mismatch",
+            lambda: backend.compile(lowered, CompileOptions(artifact_format=format_name, abi_version="1")),
+            match="ABI",
+        )
+
+    def check_load_before_workspace_or_launch():
+        artifact = state["artifact"]
+        buffers = _buffers(numel)
+        request = LaunchRequest(
+            artifact,
+            inputs=[
+                TensorDesc("float32", (numel,), address=buffers["lhs_addr"], device="npu", readonly=True),
+                TensorDesc("float32", (numel,), address=buffers["rhs_addr"], device="npu", readonly=True),
+            ],
+            outputs=[TensorDesc("float32", (numel,), address=buffers["out_addr"], device="npu")],
+        )
+        results = {}
+        results["workspace"] = _expect_contract_error(
+            "workspace before load", lambda: state["backend"].workspace_size(request), match="loaded artifact"
+        )
+        results["launch"] = _expect_contract_error(
+            "launch before load", lambda: state["backend"].launch(request), match="loaded artifact"
+        )
+        return results
+
+    def check_foreign_target_rejected():
+        foreign = Artifact(
+            format=format_name,
+            entrypoint=hook_module.ENTRYPOINT,
+            target=TargetSpec("cpu", "x86_64-linux-gnu"),
+            path=state["artifact"].path,
+        )
+        results = {}
+        results["load"] = _expect_contract_error(
+            "foreign load", lambda: state["backend"].load(foreign), match="another target"
+        )
+        return results
+
+    def check_load_launch_and_verify():
+        artifact = state["artifact"]
+        buffers = _buffers(numel)
+        lhs = buffers["lhs"]
+        rhs = buffers["rhs"]
+        out = buffers["out"]
+        for index in range(numel):
+            lhs[index] = index * 0.5
+            rhs[index] = 2.0
+            out[index] = 0.0
+        request = LaunchRequest(
+            artifact,
+            inputs=[
+                TensorDesc("float32", (numel,), address=buffers["lhs_addr"], device="npu", readonly=True),
+                TensorDesc("float32", (numel,), address=buffers["rhs_addr"], device="npu", readonly=True),
+            ],
+            outputs=[TensorDesc("float32", (numel,), address=buffers["out_addr"], device="npu")],
+        )
+        loaded = state["backend"].load(artifact)
+        workspace = state["backend"].workspace_size(request)
+        report = state["backend"].launch(request)
+        max_abs_err = max(abs(out[index] - (index * 0.5 + 2.0)) for index in range(numel))
+        assert max_abs_err < 1e-4, "device output mismatch max_abs_err={}".format(max_abs_err)
+        state["launch_report"] = report
+        return {
+            "workspace_bytes": workspace,
+            "max_abs_err": max_abs_err,
+            "sample": [round(out[0], 6), round(out[1], 6), round(out[numel - 1], 6)],
+            "report": dict(report),
+        }
+
+    def _buffers(count):
+        lhs = (ctypes.c_float * count)()
+        rhs = (ctypes.c_float * count)()
+        out = (ctypes.c_float * count)()
+        return {
+            "lhs": lhs,
+            "rhs": rhs,
+            "out": out,
+            "lhs_addr": ctypes.addressof(lhs),
+            "rhs_addr": ctypes.addressof(rhs),
+            "out_addr": ctypes.addressof(out),
+        }
+
+    if not recorder.check("env_hook_injection", check_injection):
+        return recorder.finish(args.out)
+    if not recorder.check("backend_availability", check_backend_availability):
+        return recorder.finish(args.out)
+    if not recorder.check("real_bisheng_compile", check_compile):
+        return recorder.finish(args.out)
+    recorder.check("compile_requires_lowered", check_compile_requires_lowered_wrapper)
+    recorder.check("format_mismatch_rejected", check_format_mismatch_rejected)
+    recorder.check("abi_mismatch_rejected", check_abi_mismatch_rejected)
+    recorder.check("order_load_before_run", check_load_before_workspace_or_launch)
+    recorder.check("foreign_target_rejected", check_foreign_target_rejected)
+    recorder.check("real_load_launch_verify", check_load_launch_and_verify)
+    payload = recorder.finish(args.out)
+    return payload
+
+
+if __name__ == "__main__":
+    result = main()
+    sys.exit(0 if result and result.get("status") == "PASS" else 1)
