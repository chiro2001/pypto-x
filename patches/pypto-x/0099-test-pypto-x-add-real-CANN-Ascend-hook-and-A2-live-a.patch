+"""Minimal real-CANN deployment hook for the W8A-C Ascend adapter acceptance.
+
+This module is **not** imported by :mod:`pypto` itself.  It is an explicit
+deployment bridge selected with ``PYPTO_X_ASCEND_HOOKS=ascend_cann_hook`` (the
+environment-variable seam owned by :mod:`pypto.backends.ascend`).  On a machine
+with a CANN toolkit, Bisheng/CCE compiler and an Ascend device it:
+
+* lowers one fixed float32 vector-add program description to a private IR
+  value (deliberately not a general Core-IR lowering; see W8E/E4),
+* compiles an original PTO-ISA kernel with the real Bisheng toolchain into a
+  fatobj shared object (the private artifact payload),
+* loads the compiled object through ``ctypes``/``dlopen``,
+* executes it through the CANN ACL runtime on the device and returns a small
+  result report.
+
+Only the PyPTO-X seam signatures are implemented; no vendor Python signature
+is inferred.  ``TensorDesc.address`` values are interpreted by this hook as
+**host buffer addresses** (integers such as ``ctypes.addressof(...)``) for the
+single supported program shape.  A general deployment would move buffer
+ownership into the runtime side instead.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import os
+import shutil
+import subprocess
+import time
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Optional, Tuple
+
+try:  # typing.Protocol on Python 3.8+; this module only needs the concrete hook.
+    from typing import Protocol  # noqa: F401
+except ImportError:  # pragma: no cover
+    Protocol = object  # type: ignore
+
+from pypto.abi.runtime import Availability
+from pypto.backends.ascend import AscendArtifactPayload
+from pypto.target.errors import BackendContractError
+from pypto.target.spec import TargetSpec
+
+HOOK_MODULE_NAME = "ascend_cann_hook"
+PTO_ISA_ROOT_ENV = "PYPTO_X_PTO_ISA_ROOT"
+BUILD_ROOT_ENV = "PYPTO_X_ASCEND_BUILD_DIR"
+DEVICE_ID_ENV = "PYPTO_X_ASCEND_DEVICE_ID"
+ARTIFACT_FORMAT_ENV = "PYPTO_X_ASCEND_ARTIFACT_FORMAT"
+
+ARTIFACT_FORMAT = "ascend-cce-fatobj"
+ENTRYPOINT = "pypto_x_add_launch"
+KERNEL_SYMBOL = "pypto_x_add_kernel"
+ARCH_FLAG = "dav-c220-vec"  # Ascend 910B (A2) vector core
+# 64x64 float32 tiles (16 KiB each) at UB offsets 0x0/0x10000/0x20000 stay
+# inside the 910B unified buffer and match the tile geometry exercised by the
+# PTO-ISA ST suite on the same device.
+TILE_ROWS = 64
+TILE_COLS = 64
+NUMEL = TILE_ROWS * TILE_COLS
+SUPPORTED_DTYPE = "float32"
+
+ACL_MEM_MALLOC_HUGE_FIRST = 0
+ACL_MEMCPY_HOST_TO_DEVICE = 1
+ACL_MEMCPY_DEVICE_TO_HOST = 2
+ACL_ERROR_REPEAT_INITIALIZE = 100002  # aclInit is not idempotent in one process
+
+# Original kernel source (Apache-2.0, PyPTO-X W8A-C acceptance).  It uses the
+# PTO-ISA public headers only as a library dependency; no upstream source file
+# is copied into this repository.
+KERNEL_SOURCE = r"""
+#include <pto/pto-inst.hpp>
+#include <pto/common/constants.hpp>
+#include "acl/acl.h"
+
+using namespace pto;
+
+namespace {
+constexpr int kRows = %(rows)d;
+constexpr int kCols = %(cols)d;
+constexpr int kElems = kRows * kCols;
+}  // namespace
+
+extern "C" __global__ AICORE void %(kernel)s(__gm__ float* out, __gm__ float* lhs, __gm__ float* rhs)
+{
+    using TileShape = Shape<1, 1, 1, kRows, kCols>;
+    using TileStride = Stride<1, 1, 1, kCols, 1>;
+    using GmTensor = GlobalTensor<float, TileShape, TileStride>;
+    using VecTile = Tile<TileType::Vec, float, kRows, kCols, BLayout::RowMajor, -1, -1>;
+
+    VecTile lhsTile(kRows, kCols);
+    VecTile rhsTile(kRows, kCols);
+    VecTile outTile(kRows, kCols);
+    TASSIGN(lhsTile, 0x0);
+    TASSIGN(rhsTile, 0x10000);
+    TASSIGN(outTile, 0x20000);
+
+    GmTensor lhsGlobal(lhs);
+    GmTensor rhsGlobal(rhs);
+    GmTensor outGlobal(out);
+
+    Event<Op::TLOAD, Op::TADD> loadDone;
+    Event<Op::TADD, Op::TSTORE_VEC> storeReady;
+    TLOAD(lhsTile, lhsGlobal);
+    loadDone = TLOAD(rhsTile, rhsGlobal);
+    storeReady = TADD(outTile, lhsTile, rhsTile, loadDone);
+    TSTORE(outGlobal, outTile, storeReady);
+}
+
+extern "C" void %(entrypoint)s(float* out, float* lhs, float* rhs, int32_t numel, void* stream)
+{
+    if (numel != kElems) {
+        return;
+    }
+    %(kernel)s<<<1, nullptr, stream>>>(out, lhs, rhs);
+}
+""" % {
+    "rows": TILE_ROWS,
+    "cols": TILE_COLS,
+    "kernel": KERNEL_SYMBOL,
+    "entrypoint": ENTRYPOINT,
+}
+
+
+@dataclass(frozen=True)
+class CannAddProgram:
+    """The single program description accepted by this minimal hook."""
+
+    dtype: str = SUPPORTED_DTYPE
+    rows: int = TILE_ROWS
+    cols: int = TILE_COLS
+
+    @classmethod
+    def from_value(cls, value: Any) -> "CannAddProgram":
+        if isinstance(value, CannAddProgram):
+            return value
+        if not isinstance(value, Mapping):
+            raise BackendContractError(
+                "ascend hook expects a mapping program description",
+                details={"actual": type(value).__name__},
+            )
+        op = value.get("op", "add")
+        if op != "add":
+            raise BackendContractError(
+                "ascend hook only implements the add program",
+                details={"op": repr(op)},
+            )
+        program = cls(
+            dtype=str(value.get("dtype", SUPPORTED_DTYPE)),
+            rows=int(value.get("rows", TILE_ROWS)),
+            cols=int(value.get("cols", TILE_COLS)),
+        )
+        program.validate()
+        return program
+
+    def validate(self) -> None:
+        if self.dtype != SUPPORTED_DTYPE:
+            raise BackendContractError(
+                "ascend hook only implements float32 add",
+                details={"dtype": self.dtype},
+            )
+        if self.rows != TILE_ROWS or self.cols != TILE_COLS:
+            raise BackendContractError(
+                "ascend hook only implements the fixed tile shape",
+                details={"rows": self.rows, "cols": self.cols, "expected": [TILE_ROWS, TILE_COLS]},
+            )
+
+    @property
+    def numel(self) -> int:
+        return self.rows * self.cols
+
+
+@dataclass(frozen=True)
+class CannLoweredProgram:
+    """Private lowered value produced by :meth:`CannHooks.lower`."""
+
+    program: CannAddProgram
+    target_key: Tuple[str, str, Tuple[str, ...]]
+
+
+@dataclass
+class LoadedCannKernel:
+    """Opaque loaded handle returned by :meth:`CannHooks.load`."""
+
+    library: ctypes.CDLL
+    function: Any
+    artifact_sha256: str
+    entrypoint: str
+    path: str
+
+
+class _AclRuntime:
+    """Small ctypes wrapper around the CANN ACL runtime C API."""
+
+    def __init__(self, device_id: int = 0, lib_path: Optional[str] = None) -> None:
+        self.device_id = device_id
+        self._lib_path = lib_path
+        self._acl = None
+        self._stream = ctypes.c_void_p()
+        self._initialized = False
+
+    def _library_path(self) -> str:
+        if self._lib_path and os.path.exists(self._lib_path):
+            return self._lib_path
+        ascend_home = os.environ.get("ASCEND_HOME_PATH", "").strip()
+        candidates = []
+        if ascend_home:
+            candidates.append(os.path.join(ascend_home, "lib64", "libascendcl.so"))
+        candidates.append("libascendcl.so")
+        for candidate in candidates:
+            if "/" not in candidate or os.path.exists(candidate):
+                return candidate
+        return "libascendcl.so"
+
+    @property
+    def acl(self):
+        if self._acl is None:
+            self._acl = ctypes.CDLL(self._library_path(), mode=ctypes.RTLD_GLOBAL)
+            self._bind()
+        return self._acl
+
+    def _bind(self) -> None:
+        acl = self._acl
+        acl.aclInit.argtypes = [ctypes.c_char_p]
+        acl.aclInit.restype = ctypes.c_int
+        acl.aclFinalize.argtypes = []
+        acl.aclFinalize.restype = ctypes.c_int
+        acl.aclrtSetDevice.argtypes = [ctypes.c_int32]
+        acl.aclrtSetDevice.restype = ctypes.c_int
+        acl.aclrtResetDevice.argtypes = [ctypes.c_int32]
+        acl.aclrtResetDevice.restype = ctypes.c_int
+        acl.aclrtCreateStream.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
+        acl.aclrtCreateStream.restype = ctypes.c_int
+        acl.aclrtDestroyStream.argtypes = [ctypes.c_void_p]
+        acl.aclrtDestroyStream.restype = ctypes.c_int
+        acl.aclrtMalloc.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_size_t, ctypes.c_int]
+        acl.aclrtMalloc.restype = ctypes.c_int
+        acl.aclrtFree.argtypes = [ctypes.c_void_p]
+        acl.aclrtFree.restype = ctypes.c_int
+        acl.aclrtMemcpy.argtypes = [
+            ctypes.c_void_p,
+            ctypes.c_size_t,
+            ctypes.c_void_p,
+            ctypes.c_size_t,
+            ctypes.c_int,
+        ]
+        acl.aclrtMemcpy.restype = ctypes.c_int
+        acl.aclrtSynchronizeStream.argtypes = [ctypes.c_void_p]
+        acl.aclrtSynchronizeStream.restype = ctypes.c_int
+
+    def ensure(self) -> None:
+        if self._initialized:
+            return
+        acl = self.acl
+        rc = acl.aclInit(None)
+        if rc != 0 and rc != ACL_ERROR_REPEAT_INITIALIZE:
+            raise RuntimeError("aclInit failed with rc={}".format(rc))
+        rc = acl.aclrtSetDevice(self.device_id)
+        if rc != 0:
+            raise RuntimeError(
+                "aclrtSetDevice({}) failed with rc={}".format(self.device_id, rc)
+            )
+        rc = acl.aclrtCreateStream(ctypes.byref(self._stream))
+        if rc != 0:
+            raise RuntimeError("aclrtCreateStream failed with rc={}".format(rc))
+        self._initialized = True
+
+    @property
+    def stream(self) -> ctypes.c_void_p:
+        self.ensure()
+        return self._stream
+
+    def probe(self) -> None:
+        """Raise RuntimeError if ACL/device is not usable."""
+
+        self.ensure()
+
+    def malloc(self, size: int) -> ctypes.c_void_p:
+        ptr = ctypes.c_void_p()
+        rc = self.acl.aclrtMalloc(ctypes.byref(ptr), ctypes.c_size_t(size), ACL_MEM_MALLOC_HUGE_FIRST)
+        if rc != 0:
+            raise RuntimeError("aclrtMalloc({}) failed with rc={}".format(size, rc))
+        return ptr
+
+    def free(self, ptr: ctypes.c_void_p) -> None:
+        if ptr:
+            self.acl.aclrtFree(ptr)
+
+    def copy_host_to_device(self, device_ptr: ctypes.c_void_p, host_ptr: int, size: int) -> None:
+        rc = self.acl.aclrtMemcpy(
+            device_ptr, ctypes.c_size_t(size), ctypes.c_void_p(host_ptr), ctypes.c_size_t(size),
+            ACL_MEMCPY_HOST_TO_DEVICE,
+        )
+        if rc != 0:
+            raise RuntimeError("aclrtMemcpy H2D failed with rc={}".format(rc))
+
+    def copy_device_to_host(self, host_ptr: int, device_ptr: ctypes.c_void_p, size: int) -> None:
+        rc = self.acl.aclrtMemcpy(
+            ctypes.c_void_p(host_ptr), ctypes.c_size_t(size), device_ptr, ctypes.c_size_t(size),
+            ACL_MEMCPY_DEVICE_TO_HOST,
+        )
+        if rc != 0:
+            raise RuntimeError("aclrtMemcpy D2H failed with rc={}".format(rc))
+
+    def synchronize(self) -> int:
+        return int(self.acl.aclrtSynchronizeStream(self.stream))
+
+
+def _bisheng_path(explicit: Optional[str]) -> Optional[str]:
+    if explicit:
+        return explicit if os.path.exists(explicit) else None
+    return shutil.which("bisheng")
+
+
+def _ascend_home() -> str:
+    home = os.environ.get("ASCEND_HOME_PATH", "").strip()
+    if home and os.path.isdir(home):
+        return home
+    fallback = "/usr/local/Ascend/ascend-toolkit/latest"
+    if os.path.isdir(fallback):
+        return os.path.realpath(fallback)
+    raise BackendContractError(
+        "ASCEND_HOME_PATH is not set; source the CANN set_env.sh before using the Ascend hook"
+    )
+
+
+def _pto_isa_root(explicit: Optional[str]) -> str:
+    root = explicit or os.environ.get(PTO_ISA_ROOT_ENV, "").strip()
+    if not root:
+        raise BackendContractError(
+            "PTO-ISA headers are required by this hook; set {} to a PTO-ISA checkout".format(
+                PTO_ISA_ROOT_ENV
+            )
+        )
+    header = os.path.join(root, "include", "pto", "pto-inst.hpp")
+    if not os.path.isfile(header):
+        raise BackendContractError(
+            "{} does not contain include/pto/pto-inst.hpp".format(root),
+            details={"root": root},
+        )
+    return os.path.realpath(root)
+
+
+def _run(command, cwd: Optional[str] = None, env: Optional[Mapping[str, str]] = None) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        command,
+        cwd=cwd,
+        env=dict(env) if env is not None else None,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+    )
+
+
+class CannHooks:
+    """Concrete implementation of the PyPTO-X Ascend hook protocols."""
+
+    def __init__(
+        self,
+        *,
+        artifact_format: str = ARTIFACT_FORMAT,
+        abi_version: Optional[str] = None,
+        build_root: Optional[str] = None,
+        pto_isa_root: Optional[str] = None,
+        bisheng: Optional[str] = None,
+        device_id: int = 0,
+        acl_lib: Optional[str] = None,
+    ) -> None:
+        self._artifact_format = artifact_format
+        self._abi_version = abi_version
+        self._build_root = build_root
+        self._pto_isa_root_override = pto_isa_root
+        self._bisheng_override = bisheng
+        self._acl = _AclRuntime(device_id=device_id, lib_path=acl_lib)
+        self._availability: Optional[Availability] = None
+        self._load_cache: dict = {}
+        self.last_compile_log: str = ""
+
+    # -- diagnostics -----------------------------------------------------
+    def availability(self) -> Availability:
+        if self._availability is not None:
+            return self._availability
+        details = {
+            "arch": ARCH_FLAG,
+            "artifact_format": self._artifact_format,
+            "entrypoint": ENTRYPOINT,
+            "seam": "pypto.backends.ascend",
+        }
+        bisheng = _bisheng_path(self._bisheng_override)
+        if not bisheng:
+            self._availability = Availability.no(
+                "ascend", "bisheng/CCE compiler was not found on PATH", "missing_compiler", details
+            )
+            return self._availability
+        try:
+            pto_root = _pto_isa_root(self._pto_isa_root_override)
+        except BackendContractError as exc:
+            details = dict(details, error=str(exc))
+            self._availability = Availability.no(
+                "ascend", "PTO-ISA headers were not found", "missing_program_build_inputs", details
+            )
+            return self._availability
+        try:
+            self._acl.probe()
+        except Exception as exc:  # pragma: no cover - device/environment dependent
+            details = dict(details, error="{}: {}".format(type(exc).__name__, exc))
+            self._availability = Availability.no(
+                "ascend", "CANN ACL runtime/device probe failed", "device_unavailable", details
+            )
+            return self._availability
+        details = dict(details, pto_isa_root=pto_root, compiler=bisheng)
+        self._availability = Availability(True, "ascend", details=details)
+        return self._availability
+
+    # -- compiler half ---------------------------------------------------
+    def lower(self, program: Any, target: TargetSpec) -> CannLoweredProgram:
+        if not isinstance(target, TargetSpec):
+            raise BackendContractError("ascend hook expects TargetSpec", details={"actual": type(target).__name__})
+        lowered = CannLoweredProgram(
+            program=CannAddProgram.from_value(program),
+            target_key=(target.kind, target.triple, tuple(target.features)),
+        )
+        return lowered
+
+    def _compiler_flags(self) -> list:
+        ascend = _ascend_home()
+        pto_root = _pto_isa_root(self._pto_isa_root_override)
+        return [
+            "-xcce",
+            "-Xhost-start",
+            "-Xhost-end",
+            "--cce-aicore-arch={}".format(ARCH_FLAG),
+            "-mllvm",
+            "-cce-aicore-stack-size=0x8000",
+            "-mllvm",
+            "-cce-aicore-function-stack-size=0x8000",
+            "-mllvm",
+            "-cce-aicore-record-overflow=true",
+            "-mllvm",
+            "-cce-aicore-addr-transform",
+            "-mllvm",
+            "-cce-aicore-dcci-insert-for-scalar=false",
+            "-fPIC",
+            "-O2",
+            "-std=c++17",
+            "-DMEMORY_BASE",
+            "-I{}".format(os.path.join(pto_root, "include")),
+            "-I{}".format(os.path.join(pto_root, "pkg_inc")),
+            "-I{}".format(os.path.join(ascend, "include")),
+            "-I{}".format(os.path.join(ascend, "pkg_inc")),
+            "-I{}".format(os.path.join(ascend, "pkg_inc", "profiling")),
+            "-I{}".format(os.path.join(ascend, "pkg_inc", "runtime")),
+        ]
+
+    def _link_flags(self) -> list:
+        ascend = _ascend_home()
+        return [
+            "--cce-fatobj-link",
+            "-fPIC",
+            "-shared",
+            "-Wl,-z,relro",
+            "-Wl,-z,now",
+            "-L{}".format(os.path.join(ascend, "lib64")),
+            "-lruntime",
+            "-lascendcl",
+            "-lstdc++",
+            "-lpthread",
+        ]
+
+    def compile(self, target_ir: Any, options: Any) -> AscendArtifactPayload:
+        if not isinstance(target_ir, CannLoweredProgram):
+            raise BackendContractError(
+                "ascend hook compile() expects the value returned by lower()",
+                details={"actual": type(target_ir).__name__},
+            )
+        artifact_format = getattr(options, "artifact_format", None)
+        if artifact_format != self._artifact_format:
+            raise BackendContractError(
+                "ascend hook could not satisfy the requested artifact format",
+                details={"requested": artifact_format, "supported": self._artifact_format},
+            )
+        target_ir.program.validate()
+        source = KERNEL_SOURCE
+        bisheng = _bisheng_path(self._bisheng_override)
+        if not bisheng:
+            raise BackendContractError("bisheng/CCE compiler was not found on PATH")
+
+        digest = hashlib.sha256(source.encode("utf-8")).hexdigest()[:16]
+        root = self._build_root or os.path.join(
+            os.environ.get("TMPDIR", "/tmp"), "pypto_x_ascend_hook"
+        )
+        build_dir = os.path.join(root, "add_{}x{}_{}".format(TILE_ROWS, TILE_COLS, digest))
+        os.makedirs(build_dir, exist_ok=True)
+        source_path = os.path.join(build_dir, "pypto_x_add_kernel.cpp")
+        with open(source_path, "w", encoding="utf-8") as handle:
+            handle.write(source)
+
+        started = time.time()
+        compile_cmd = [bisheng] + self._compiler_flags() + [
+            "-c", source_path, "-o", os.path.join(build_dir, "pypto_x_add_kernel.o"),
+        ]
+        compile_result = _run(compile_cmd, cwd=build_dir)
+        link_cmd = [bisheng] + self._link_flags() + [
+            "-o", os.path.join(build_dir, "libpypto_x_add.so"),
+            os.path.join(build_dir, "pypto_x_add_kernel.o"),
+        ]
+        link_result = _run(link_cmd, cwd=build_dir) if compile_result.returncode == 0 else None
+        elapsed = time.time() - started
+        self.last_compile_log = compile_result.stdout + (link_result.stdout if link_result else "")
+        with open(os.path.join(build_dir, "bisheng.log"), "w", encoding="utf-8") as handle:
+            handle.write("+ {}\n{}\n".format(" ".join(compile_cmd), compile_result.stdout))
+            if link_result is not None:
+                handle.write("+ {}\n{}\n".format(" ".join(link_cmd), link_result.stdout))
+
+        if compile_result.returncode != 0 or link_result is None or link_result.returncode != 0:
+            raise BackendContractError(
+                "bisheng CCE compilation failed",
+                details={
+                    "compile_returncode": compile_result.returncode,
+                    "link_returncode": None if link_result is None else link_result.returncode,
+                    "log_tail": self.last_compile_log[-2000:],
+                },
+            )
+
+        so_path = os.path.join(build_dir, "libpypto_x_add.so")
+        if not os.path.isfile(so_path):
+            raise BackendContractError("bisheng did not produce the expected shared object")
+        with open(so_path, "rb") as handle:
+            so_bytes = handle.read()
+        so_sha = hashlib.sha256(so_bytes).hexdigest()
+        source_sha = hashlib.sha256(source.encode("utf-8")).hexdigest()
+        return AscendArtifactPayload(
+            format=self._artifact_format,
+            entrypoint=ENTRYPOINT,
+            path=so_path,
+            abi_version=self._abi_version,
+            metadata={
+                "bridge": "ascend_cann_hook",
+                "arch": ARCH_FLAG,
+                "compiler": "bisheng",
+                "compiler_path": bisheng,
+                "compiler_seconds": round(elapsed, 3),
+                "kernel_source_sha256": source_sha,
+                "artifact_sha256": so_sha,
+                "artifact_bytes": len(so_bytes),
+                "tile": [TILE_ROWS, TILE_COLS],
+                "dtype": SUPPORTED_DTYPE,
+                "bisheng_log": os.path.join(build_dir, "bisheng.log"),
+            },
+        )
+
+    # -- runtime half ----------------------------------------------------
+    def load(self, artifact: AscendArtifactPayload) -> LoadedCannKernel:
+        if not isinstance(artifact, AscendArtifactPayload):
+            raise BackendContractError(
+                "ascend hook load() expects AscendArtifactPayload",
+                details={"actual": type(artifact).__name__},
+            )
+        if artifact.format != self._artifact_format:
+            raise BackendContractError(
+                "ascend hook cannot load this artifact format",
+                details={"format": artifact.format},
+            )
+        if artifact.entrypoint != ENTRYPOINT:
+            raise BackendContractError(
+                "ascend hook cannot load this entrypoint",
+                details={"entrypoint": artifact.entrypoint, "expected": ENTRYPOINT},
+            )
+        if not artifact.path or not os.path.isfile(artifact.path):
+            raise BackendContractError(
+                "ascend hook artifact path does not exist",
+                details={"path": artifact.path},
+            )
+        with open(artifact.path, "rb") as handle:
+            actual_sha = hashlib.sha256(handle.read()).hexdigest()
+        expected_sha = artifact.metadata.get("artifact_sha256")
+        if expected_sha is not None and actual_sha != expected_sha:
+            raise BackendContractError(
+                "ascend hook artifact digest changed after compile",
+                details={"expected": expected_sha, "actual": actual_sha},
+            )
+        cached = self._load_cache.get(actual_sha)
+        if cached is not None:
+            return cached
+        library = ctypes.CDLL(artifact.path, mode=ctypes.RTLD_GLOBAL)
+        function = getattr(library, ENTRYPOINT)
+        function.argtypes = [
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.c_int32,
+            ctypes.c_void_p,
+        ]
+        function.restype = None
+        loaded = LoadedCannKernel(
+            library=library,
+            function=function,
+            artifact_sha256=actual_sha,
+            entrypoint=ENTRYPOINT,
+            path=artifact.path,
+        )
+        self._load_cache[actual_sha] = loaded
+        return loaded
+
+    def workspace_size(self, request: Any, loaded: LoadedCannKernel) -> int:
+        if not isinstance(loaded, LoadedCannKernel):
+            raise BackendContractError("ascend hook workspace_size() needs a loaded handle")
+        return 0
+
+    def _address_of(self, descriptor: Any, role: str) -> int:
+        address = getattr(descriptor, "address", None)
+        if address is None or isinstance(address, bool) or not isinstance(address, int):
+            raise BackendContractError(
+                "ascend hook expects integer host buffer addresses in TensorDesc.address",
+                details={"role": role, "actual": type(address).__name__},
+            )
+        if address == 0:
+            raise BackendContractError("ascend hook refused a null host buffer address", details={"role": role})
+        if getattr(descriptor, "dtype", None) != SUPPORTED_DTYPE:
+            raise BackendContractError(
+                "ascend hook only implements float32 tensors",
+                details={"role": role, "dtype": getattr(descriptor, "dtype", None)},
+            )
+        shape = getattr(descriptor, "shape", ())
+        count = 1
+        for dim in shape:
+            count *= int(dim)
+        if count != NUMEL:
+            raise BackendContractError(
+                "ascend hook only implements the fixed element count",
+                details={"role": role, "count": count, "expected": NUMEL},
+            )
+        return address
+
+    def launch(self, request: Any, loaded: LoadedCannKernel) -> Mapping[str, Any]:
+        if not isinstance(loaded, LoadedCannKernel):
+            raise BackendContractError("ascend hook launch() needs a loaded handle")
+        inputs = tuple(getattr(request, "inputs", ()))
+        outputs = tuple(getattr(request, "outputs", ()))
+        if len(inputs) != 2 or len(outputs) != 1:
+            raise BackendContractError(
+                "ascend hook implements add with exactly two inputs and one output",
+                details={"inputs": len(inputs), "outputs": len(outputs)},
+            )
+        sizes = NUMEL * 4
+        lhs_host = self._address_of(inputs[0], "input0")
+        rhs_host = self._address_of(inputs[1], "input1")
+        out_host = self._address_of(outputs[0], "output")
+
+        acl = self._acl
+        acl.ensure()
+        lhs_dev = ctypes.c_void_p()
+        rhs_dev = ctypes.c_void_p()
+        out_dev = ctypes.c_void_p()
+        allocated = []
+        try:
+            lhs_dev = acl.malloc(sizes)
+            allocated.append(lhs_dev)
+            rhs_dev = acl.malloc(sizes)
+            allocated.append(rhs_dev)
+            out_dev = acl.malloc(sizes)
+            allocated.append(out_dev)
+            acl.copy_host_to_device(lhs_dev, lhs_host, sizes)
+            acl.copy_host_to_device(rhs_dev, rhs_host, sizes)
+            loaded.function(out_dev, lhs_dev, rhs_dev, ctypes.c_int32(NUMEL), acl.stream)
+            sync_rc = acl.synchronize()
+            if sync_rc != 0:
+                raise RuntimeError("aclrtSynchronizeStream failed with rc={}".format(sync_rc))
+            acl.copy_device_to_host(out_host, out_dev, sizes)
+        finally:
+            for pointer in allocated:
+                acl.free(pointer)
+        with open(loaded.path, "rb") as handle:
+            artifact_sha = hashlib.sha256(handle.read()).hexdigest()
+        return {
+            "status": "executed_on_device",
+            "entrypoint": loaded.entrypoint,
+            "device_id": acl.device_id,
+            "numel": NUMEL,
+            "dtype": SUPPORTED_DTYPE,
+            "workspace_bytes": 0,
+            "artifact_sha256": artifact_sha,
+        }
+
+
+def create_ascend_hooks() -> CannHooks:
+    """Factory used by ``PYPTO_X_ASCEND_HOOKS=ascend_cann_hook``."""
+
+    build_root = os.environ.get(BUILD_ROOT_ENV, "").strip() or None
+    pto_isa_root = os.environ.get(PTO_ISA_ROOT_ENV, "").strip() or None
+    device_id = int(os.environ.get(DEVICE_ID_ENV, "0"))
+    artifact_format = os.environ.get(ARTIFACT_FORMAT_ENV, "").strip() or ARTIFACT_FORMAT
+    return CannHooks(
+        artifact_format=artifact_format,
+        build_root=build_root,
+        pto_isa_root=pto_isa_root,
+        device_id=device_id,
+    )
+
+
+__all__ = [
+    "ARTIFACT_FORMAT",
+    "BUILD_ROOT_ENV",
+    "CannAddProgram",
+    "CannHooks",
+    "CannLoweredProgram",
+    "ENTRYPOINT",
+    "KERNEL_SOURCE",
+    "LoadedCannKernel",
+    "NUMEL",
+    "PTO_ISA_ROOT_ENV",
+    "TILE_COLS",
+    "TILE_ROWS",
+    "create_ascend_hooks",
+]
diff --git a/python/tests/ut/pypto_x/ascend_cann_hook_live_driver.py b/python/tests/ut/pypto_x/ascend_cann_hook_live_driver.py
