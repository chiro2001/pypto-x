index 000000000..937636e16
--- /dev/null
+++ b/python/pypto/backends/cpu/runtime.py
@@ -0,0 +1,528 @@
+"""Executable standard-library CPU scalar reference runtime."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, LaunchRequest, TensorDesc
+from pypto.compiler.artifact import Artifact
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, ValueRef
+from pypto.lowering.cpu import (
+    CPU_SCALAR_BACKEND,
+    CpuScalarProgram,
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    flatten_values,
+    lower_cpu_scalar,
+    reduced_shape,
+    static_shape,
+)
+from pypto.target import TargetSpec
+
+from .tensor import FlatBuffer, HostTensor, _cast_value
+
+
+class CpuScalarRuntimeError(RuntimeError):
+    """Base class for explicit CPU scalar runtime failures."""
+
+
+class CpuScalarArtifactError(CpuScalarRuntimeError):
+    """An artifact payload, digest, or version is invalid."""
+
+
+class CpuScalarExecutionError(CpuScalarRuntimeError):
+    """A valid scalar program cannot execute the supplied invocation."""
+
+
+@dataclass(frozen=True)
+class LoadedCpuScalarArtifact:
+    artifact: Artifact
+    target_ir: CpuScalarProgram
+
+
+@dataclass(frozen=True)
+class _RuntimeValue:
+    type: CoreType
+    data: Any
+
+
+class CpuScalarRuntime:
+    """Reference runtime implementing the common ``RuntimeBackend`` ABI."""
+
+    name = CPU_SCALAR_BACKEND
+
+    def availability(self) -> Availability:
+        return Availability.yes(self.name)
+
+    def is_available(self) -> bool:
+        return True
+
+    def load(self, artifact: Artifact) -> LoadedCpuScalarArtifact:
+        return _decode_artifact(artifact)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, LaunchRequest):
+            raise CpuScalarExecutionError("workspace_size requires LaunchRequest")
+        self.load(request.artifact)
+        return 0
+
+    def launch(self, request: LaunchRequest) -> Tuple[Any, ...]:
+        if not isinstance(request, LaunchRequest):
+            raise CpuScalarExecutionError("CPU scalar launch requires LaunchRequest")
+        try:
+            request.validate()
+        except Exception as exc:
+            raise CpuScalarExecutionError("invalid LaunchRequest: {}".format(exc)) from exc
+        loaded = self.load(request.artifact)
+        if request.entrypoint != loaded.target_ir.entrypoint:
+            raise CpuScalarExecutionError(
+                "launch entrypoint {!r} does not match loaded CPU scalar entrypoint {!r}".format(
+                    request.entrypoint, loaded.target_ir.entrypoint
+                )
+            )
+        function = _find_function(loaded.target_ir.program, request.entrypoint)
+        _validate_request_target(request, loaded.target_ir.target)
+        tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+        tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+        if len(request.inputs) != len(tensor_parameters):
+            raise CpuScalarExecutionError(
+                "function {!r} expects {} tensor inputs, got {}".format(
+                    function.name, len(tensor_parameters), len(request.inputs)
+                )
+            )
+        if len(request.outputs) != len(tensor_returns):
+            raise CpuScalarExecutionError(
+                "function {!r} expects {} tensor outputs, got {}".format(
+                    function.name, len(tensor_returns), len(request.outputs)
+                )
+            )
+
+        environment: Dict[str, _RuntimeValue] = {}
+        input_index = 0
+        for parameter in function.parameters:
+            if _is_tensor(parameter.type):
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _read_tensor(request.inputs[input_index], parameter.type, parameter.name),
+                )
+                input_index += 1
+            elif _is_scalar(parameter.type):
+                if parameter.name not in request.scalars:
+                    raise CpuScalarExecutionError(
+                        "missing scalar input {!r} in LaunchRequest.scalars".format(parameter.name)
+                    )
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _cast_value(request.scalars[parameter.name], canonical_dtype(parameter.type.dtype)),
+                )
+            else:  # Lowering already rejects this; retain a defensive error at the ABI edge.
+                raise CpuScalarExecutionError("unsupported parameter kind {!r}".format(parameter.type.kind))
+
+        for index, operation in enumerate(function.body.operations):
+            _execute_operation(operation, environment, "function {} operation {}".format(function.name, index))
+
+        results: List[Any] = []
+        output_index = 0
+        for result_ref in function.returns:
+            try:
+                result = environment[result_ref.name]
+            except KeyError as exc:
+                raise CpuScalarExecutionError("return value {!r} was not produced".format(result_ref.name)) from exc
+            if result.type != result_ref.type:
+                raise CpuScalarExecutionError("return value {!r} has the wrong type".format(result_ref.name))
+            if _is_tensor(result_ref.type):
+                descriptor = request.outputs[output_index]
+                _write_tensor(descriptor, result_ref.type, result.data, result_ref.name)
+                results.append(descriptor.storage)
+                output_index += 1
+            else:
+                results.append(result.data)
+        return tuple(results)
+
+
+CpuRuntime = CpuScalarRuntime
+CpuScalarBackend = CpuScalarRuntime
+CPUScalarRuntime = CpuScalarRuntime
+
+
+def launch(request: LaunchRequest) -> Tuple[Any, ...]:
+    """Run one request with a fresh always-available scalar runtime."""
+
+    return CpuScalarRuntime().launch(request)
+
+
+def _decode_artifact(artifact: Artifact) -> LoadedCpuScalarArtifact:
+    if not isinstance(artifact, Artifact):
+        raise CpuScalarArtifactError("CPU scalar runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CpuScalarArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.payload is None:
+        raise CpuScalarArtifactError("CPU scalar artifact requires an inline payload")
+    payload = bytes(artifact.payload)
+    metadata = artifact.metadata
+    if metadata.get("backend") != CPU_SCALAR_BACKEND:
+        raise CpuScalarArtifactError("artifact backend metadata is not CPU scalar")
+    actual_digest = hashlib.sha256(payload).hexdigest()
+    if actual_digest != artifact.content_digest:
+        raise CpuScalarArtifactError("artifact content digest does not match immutable Artifact payload")
+    if metadata.get("payload_digest") != actual_digest:
+        raise CpuScalarArtifactError("artifact metadata payload digest mismatch")
+    try:
+        decoded = json.loads(payload.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise CpuScalarArtifactError("CPU scalar artifact payload is not UTF-8 JSON") from exc
+    if not isinstance(decoded, dict):
+        raise CpuScalarArtifactError("CPU scalar artifact payload must be a JSON object")
+    canonical_payload = json.dumps(
+        decoded,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    if canonical_payload != payload:
+        raise CpuScalarArtifactError("CPU scalar artifact payload is not canonical JSON")
+    if decoded.get("artifact_payload_version") != 1:
+        raise CpuScalarArtifactError("unsupported CPU scalar artifact payload version")
+    if decoded.get("backend") != CPU_SCALAR_BACKEND:
+        raise CpuScalarArtifactError("CPU scalar artifact payload backend mismatch")
+    if decoded.get("target") != artifact.target.to_dict():
+        raise CpuScalarArtifactError("CPU scalar artifact target mismatch")
+    if decoded.get("entrypoint") != artifact.entrypoint:
+        raise CpuScalarArtifactError("CPU scalar artifact entrypoint mismatch")
+    program_data = decoded.get("program")
+    if not isinstance(program_data, dict):
+        raise CpuScalarArtifactError("CPU scalar artifact does not contain a CoreProgram")
+    try:
+        program = CoreProgram.from_dict(program_data)
+        program_json = program.canonical_json()
+        target_ir = lower_cpu_scalar(program, artifact.target, decoded["entrypoint"])
+    except Exception as exc:
+        raise CpuScalarArtifactError("CPU scalar artifact CoreProgram is invalid: {}".format(exc)) from exc
+    program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+    if decoded.get("program_digest") != program_digest or metadata.get("program_digest") != program_digest:
+        raise CpuScalarArtifactError("CPU scalar artifact program digest mismatch")
+    if metadata.get("entrypoint") != artifact.entrypoint:
+        raise CpuScalarArtifactError("CPU scalar artifact metadata entrypoint mismatch")
+    if metadata.get("artifact_payload_version") != 1 or metadata.get("lowering_version") != 1:
+        raise CpuScalarArtifactError("unsupported CPU scalar artifact metadata version")
+    target_digest = hashlib.sha256(
+        json.dumps(artifact.target.to_dict(), ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+    if metadata.get("target_digest") != target_digest:
+        raise CpuScalarArtifactError("CPU scalar artifact target digest mismatch")
+    return LoadedCpuScalarArtifact(artifact, target_ir)
+
+
+def _find_function(program: CoreProgram, entrypoint: str) -> CoreFunction:
+    for function in program.functions:
+        if function.name == entrypoint:
+            return function
+    raise CpuScalarExecutionError("entrypoint {!r} is not present in CoreProgram".format(entrypoint))
+
+
+def _validate_request_target(request: LaunchRequest, target: TargetSpec) -> None:
+    if target.kind != "cpu":
+        raise CpuScalarExecutionError("CPU scalar artifact target kind must be cpu")
+    for index, descriptor in enumerate(request.inputs + request.outputs):
+        if descriptor.device != "cpu":
+            raise CpuScalarExecutionError(
+                "CPU scalar tensor descriptor {} has device {!r}, expected 'cpu'".format(index, descriptor.device)
+            )
+        if descriptor.strides != _contiguous_strides(descriptor.shape):
+            raise CpuScalarExecutionError("CPU scalar requires contiguous tensor descriptors")
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _read_tensor(descriptor: TensorDesc, value_type: CoreType, context: str) -> List[Any]:
+    expected_dtype = canonical_dtype(value_type.dtype)
+    expected_shape = static_shape(value_type, context)
+    if descriptor.dtype != expected_dtype or descriptor.shape != expected_shape:
+        raise CpuScalarExecutionError(
+            "{} descriptor dtype/shape ({}, {}) does not match expected ({}, {})".format(
+                context, descriptor.dtype, descriptor.shape, expected_dtype, expected_shape
+            )
+        )
+    values = _storage_values(descriptor.storage, context)
+    expected_count = element_count(expected_shape)
+    if len(values) != expected_count:
+        raise CpuScalarExecutionError(
+            "{} storage has {} values but shape {} requires {}".format(context, len(values), expected_shape, expected_count)
+        )
+    try:
+        return [_cast_value(value, expected_dtype) for value in values]
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise CpuScalarExecutionError("{} contains an invalid {} value: {}".format(context, expected_dtype, exc)) from exc
+
+
+def _write_tensor(descriptor: TensorDesc, value_type: CoreType, values: Sequence[Any], context: str) -> None:
+    expected_dtype = canonical_dtype(value_type.dtype)
+    expected_shape = static_shape(value_type, context)
+    if descriptor.dtype != expected_dtype or descriptor.shape != expected_shape:
+        raise CpuScalarExecutionError(
+            "{} output descriptor dtype/shape ({}, {}) does not match expected ({}, {})".format(
+                context, descriptor.dtype, descriptor.shape, expected_dtype, expected_shape
+            )
+        )
+    storage = descriptor.storage
+    if isinstance(storage, HostTensor):
+        if storage.dtype != expected_dtype or storage.shape != expected_shape:
+            raise CpuScalarExecutionError("{} HostTensor metadata does not match output descriptor".format(context))
+        destination = storage.data
+    elif isinstance(storage, FlatBuffer):
+        destination = storage.data
+    elif isinstance(storage, list):
+        destination = storage
+    elif hasattr(storage, "data") and isinstance(storage.data, list):
+        destination = storage.data
+    else:
+        destination = None
+    try:
+        cast_values = [_cast_value(value, expected_dtype) for value in values]
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise CpuScalarExecutionError("{} produced an invalid {} value: {}".format(context, expected_dtype, exc)) from exc
+    if len(cast_values) != element_count(expected_shape):
+        raise CpuScalarExecutionError("{} result length does not match output shape".format(context))
+    if destination is not None:
+        if len(destination) != len(cast_values):
+            raise CpuScalarExecutionError("{} output storage length does not match output shape".format(context))
+        destination[:] = cast_values
+        return
+    if storage is None or not hasattr(storage, "__setitem__"):
+        raise CpuScalarExecutionError("{} output storage is not mutable".format(context))
+    try:
+        if len(storage) != len(cast_values):
+            raise CpuScalarExecutionError("{} output storage length does not match output shape".format(context))
+        for index, value in enumerate(cast_values):
+            storage[index] = value
+    except (TypeError, IndexError, AttributeError) as exc:
+        raise CpuScalarExecutionError("{} output storage is not mutable".format(context)) from exc
+
+
+def _storage_values(storage: Any, context: str) -> List[Any]:
+    if isinstance(storage, HostTensor):
+        return list(storage.data)
+    if isinstance(storage, FlatBuffer):
+        return list(storage.data)
+    if isinstance(storage, (str, bytes, bytearray, Mapping)) or storage is None:
+        raise CpuScalarExecutionError("{} storage must be a flat numeric sequence".format(context))
+    if isinstance(storage, (list, tuple)):
+        return list(flatten_values(storage))
+    if hasattr(storage, "data") and isinstance(storage.data, (list, tuple)):
+        return list(storage.data)
+    try:
+        return [storage[index] for index in range(len(storage))]
+    except (TypeError, IndexError, KeyError, AttributeError) as exc:
+        raise CpuScalarExecutionError("{} storage must support flat sequence access".format(context)) from exc
+
+
+def _execute_operation(operation: Operation, environment: Dict[str, _RuntimeValue], context: str) -> None:
+    name = canonical_operation_name(operation.name)
+    inputs = []
+    for ref in operation.inputs:
+        if ref.name not in environment:
+            raise CpuScalarExecutionError("{} input {!r} is unavailable".format(context, ref.name))
+        value = environment[ref.name]
+        if value.type != ref.type:
+            raise CpuScalarExecutionError("{} input {!r} has a type mismatch".format(context, ref.name))
+        inputs.append(value)
+    if len(operation.outputs) != 1:
+        raise CpuScalarExecutionError("{} must have one output".format(context))
+    output_ref = operation.outputs[0]
+    try:
+        if name == "constant":
+            raw = operation.attributes.get("value", operation.attributes.get("values"))
+            if _is_scalar(output_ref.type):
+                if isinstance(raw, (list, tuple)):
+                    raw = raw[0] if len(raw) == 1 else raw
+                result = _cast_value(raw, canonical_dtype(output_ref.type.dtype))
+            else:
+                result = [_cast_value(value, canonical_dtype(output_ref.type.dtype)) for value in flatten_values(raw)]
+        elif name == "identity":
+            result = _copy_value(inputs[0].data)
+        elif name in ("add", "sub", "mul", "div"):
+            result = _binary_value(name, inputs[0].data, inputs[1].data, output_ref.type)
+        elif name == "neg":
+            result = _unary_value(inputs[0].data, lambda value: -value, output_ref.type)
+        elif name in ("reduce_sum", "reduce_max"):
+            result = _reduce_value(name, inputs[0].data, inputs[0].type, output_ref.type, operation.attributes)
+        elif name == "matmul":
+            result = _matmul_value(
+                inputs[0].data,
+                inputs[0].type,
+                inputs[1].data,
+                inputs[1].type,
+                output_ref.type,
+            )
+        else:  # canonical_operation_name currently makes this unreachable.
+            raise CpuScalarExecutionError("{} operation {!r} is unsupported".format(context, operation.name))
+    except CpuScalarExecutionError:
+        raise
+    except (TypeError, ValueError, ZeroDivisionError, OverflowError) as exc:
+        raise CpuScalarExecutionError("{} failed: {}".format(context, exc)) from exc
+    environment[output_ref.name] = _RuntimeValue(output_ref.type, result)
+
+
+def _copy_value(value: Any) -> Any:
+    return list(value) if isinstance(value, list) else value
+
+
+def _binary_value(name: str, left: Any, right: Any, output_type: CoreType) -> Any:
+    output_dtype = canonical_dtype(output_type.dtype)
+    operation: Callable[[Any, Any], Any]
+    if name == "add":
+        operation = lambda a, b: a + b
+    elif name == "sub":
+        operation = lambda a, b: a - b
+    elif name == "mul":
+        operation = lambda a, b: a * b
+    else:
+        def operation(a, b):
+            if b == 0:
+                raise CpuScalarExecutionError("division by zero")
+            return a / b
+
+    if isinstance(left, list) and isinstance(right, list):
+        if len(left) != len(right):
+            raise CpuScalarExecutionError("elementwise operands have different lengths")
+        return [_cast_value(operation(a, b), output_dtype) for a, b in zip(left, right)]
+    if isinstance(left, list):
+        return [_cast_value(operation(value, right), output_dtype) for value in left]
+    if isinstance(right, list):
+        return [_cast_value(operation(left, value), output_dtype) for value in right]
+    return _cast_value(operation(left, right), output_dtype)
+
+
+def _unary_value(value: Any, operation: Callable[[Any], Any], output_type: CoreType) -> Any:
+    dtype = canonical_dtype(output_type.dtype)
+    if isinstance(value, list):
+        return [_cast_value(operation(item), dtype) for item in value]
+    return _cast_value(operation(value), dtype)
+
+
+def _reduce_value(
+    name: str,
+    values: Sequence[Any],
+    input_type: CoreType,
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+) -> List[Any]:
+    input_shape = static_shape(input_type, "reduction input")
+    output_shape = static_shape(output_type, "reduction output")
+    rank = len(input_shape)
+    raw_axes = attributes.get("axes", attributes.get("axis"))
+    if raw_axes is None:
+        axes = tuple(range(rank))
+    elif isinstance(raw_axes, int) and not isinstance(raw_axes, bool):
+        axes = (raw_axes + rank if raw_axes < 0 else raw_axes,)
+    else:
+        axes = tuple(raw_axes)
+        axes = tuple(axis + rank if axis < 0 else axis for axis in axes)
+    keepdims = attributes.get("keepdims", False)
+    input_count = element_count(input_shape)
+    output_count = element_count(output_shape)
+    if len(values) != input_count:
+        raise CpuScalarExecutionError("reduction input storage length mismatch")
+    result = []
+    for output_index in range(output_count):
+        output_coords = _unravel(output_index, output_shape)
+        candidates = []
+        for input_index, value in enumerate(values):
+            input_coords = _unravel(input_index, input_shape)
+            if keepdims:
+                projected = tuple(0 if axis in axes else input_coords[axis] for axis in range(rank))
+            else:
+                projected = tuple(input_coords[axis] for axis in range(rank) if axis not in axes)
+            if projected == output_coords:
+                candidates.append(value)
+        if name == "reduce_sum":
+            aggregate = 0
+            for value in candidates:
+                aggregate += value
+        else:
+            if not candidates:
+                raise CpuScalarExecutionError("reduce_max has an empty reduction group")
+            aggregate = candidates[0]
+            for value in candidates[1:]:
+                if value > aggregate:
+                    aggregate = value
+        result.append(_cast_value(aggregate, canonical_dtype(output_type.dtype)))
+    return result
+
+
+def _matmul_value(
+    left: Sequence[Any],
+    left_type: CoreType,
+    right: Sequence[Any],
+    right_type: CoreType,
+    output_type: CoreType,
+) -> List[Any]:
+    left_shape = static_shape(left_type, "matmul left")
+    right_shape = static_shape(right_type, "matmul right")
+    output_shape = static_shape(output_type, "matmul output")
+    m, k = left_shape
+    right_k, n = right_shape
+    if right_k != k or output_shape != (m, n):
+        raise CpuScalarExecutionError("matmul runtime shapes are inconsistent")
+    if len(left) != m * k or len(right) != right_k * n:
+        raise CpuScalarExecutionError("matmul input storage length mismatch")
+    dtype = canonical_dtype(output_type.dtype)
+    output = []
+    for row in range(m):
+        for column in range(n):
+            aggregate = 0
+            for inner in range(k):
+                aggregate += left[row * k + inner] * right[inner * n + column]
+            output.append(_cast_value(aggregate, dtype))
+    return output
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _unravel(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
+    if not shape:
+        return ()
+    coordinates = [0] * len(shape)
+    remainder = index
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension == 0:
+            return tuple(coordinates)
+        coordinates[axis] = remainder % dimension
+        remainder //= dimension
+    return tuple(coordinates)
+
+
+__all__ = [
+    "CPUScalarRuntime",
+    "CpuScalarBackend",
+    "CpuRuntime",
+    "CpuScalarArtifactError",
+    "CpuScalarExecutionError",
+    "CpuScalarRuntime",
+    "FlatBuffer",
+    "HostTensor",
+    "LoadedCpuScalarArtifact",
+    "launch",
+]
