index 000000000..f6b32da45
--- /dev/null
+++ b/python/pypto/lowering/cpu/__init__.py
@@ -0,0 +1,463 @@
+"""CPU scalar reference lowering for the PyPTO-X Core IR.
+
+The scalar target is intentionally small and boring.  It is the executable
+correctness reference for later vector and accelerator lowerings, so it does
+not silently reinterpret an operation, broadcast a shape, or delegate to a
+third-party numerical library.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional, Sequence, Tuple
+
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region
+from pypto.target import TargetSpec
+
+
+CPU_SCALAR_BACKEND = "cpu.scalar"
+LOWERING_VERSION = 1
+
+
+class CpuScalarError(ValueError):
+    """Base error for an invalid CPU scalar program or target."""
+
+
+class CpuScalarValidationError(CpuScalarError):
+    """The program is structurally valid Core IR but not scalar-lowerable."""
+
+
+class CpuScalarUnsupportedError(CpuScalarError):
+    """The scalar reference deliberately does not implement this feature."""
+
+
+SUPPORTED_DTYPES = frozenset(
+    {
+        "bool",
+        "int8",
+        "uint8",
+        "int16",
+        "uint16",
+        "int32",
+        "uint32",
+        "int64",
+        "uint64",
+        "float16",
+        "half",
+        "bf16",
+        "bfloat16",
+        "float32",
+        "float64",
+    }
+)
+
+
+# Aliases are explicit.  The executor never turns an arbitrary name into an
+# operation by stripping a prefix, which keeps unknown operations visible.
+OP_ALIASES = {
+    "identity": "identity",
+    "copy": "identity",
+    "tensor.identity": "identity",
+    "tensor.copy": "identity",
+    "core.identity": "identity",
+    "core.copy": "identity",
+    "constant": "constant",
+    "const": "constant",
+    "tensor.constant": "constant",
+    "core.constant": "constant",
+    "add": "add",
+    "tensor.add": "add",
+    "elementwise.add": "add",
+    "sub": "sub",
+    "subtract": "sub",
+    "tensor.sub": "sub",
+    "elementwise.sub": "sub",
+    "mul": "mul",
+    "multiply": "mul",
+    "tensor.mul": "mul",
+    "elementwise.mul": "mul",
+    "div": "div",
+    "divide": "div",
+    "tensor.div": "div",
+    "elementwise.div": "div",
+    "neg": "neg",
+    "negative": "neg",
+    "tensor.neg": "neg",
+    "elementwise.neg": "neg",
+    "reduce_sum": "reduce_sum",
+    "reduce.sum": "reduce_sum",
+    "tensor.reduce_sum": "reduce_sum",
+    "sum": "reduce_sum",
+    "reduce_max": "reduce_max",
+    "reduce.max": "reduce_max",
+    "tensor.reduce_max": "reduce_max",
+    "max": "reduce_max",
+    "matmul": "matmul",
+    "tensor.matmul": "matmul",
+    "linalg.matmul": "matmul",
+}
+SUPPORTED_OPERATIONS = frozenset(OP_ALIASES)
+
+
+def canonical_operation_name(name: str) -> str:
+    """Return one of the small scalar operation names.
+
+    Only the aliases listed in :data:`OP_ALIASES` are accepted.  This is
+    intentionally stricter than a generic ``split('.')[-1]`` conversion.
+    """
+
+    if not isinstance(name, str):
+        raise CpuScalarUnsupportedError("operation name must be a string")
+    key = name.strip().lower()
+    try:
+        return OP_ALIASES[key]
+    except KeyError as exc:
+        raise CpuScalarUnsupportedError("CPU scalar does not support operation {!r}".format(name)) from exc
+
+
+def canonical_dtype(dtype: Any) -> str:
+    """Normalize scalar-supported dtype spellings."""
+
+    if not isinstance(dtype, str):
+        raise CpuScalarValidationError("dtype must be a string")
+    value = dtype.strip().lower()
+    if value == "bfloat16":
+        value = "bf16"
+    elif value == "half":
+        value = "float16"
+    if value not in SUPPORTED_DTYPES:
+        raise CpuScalarUnsupportedError("CPU scalar does not support dtype {!r}".format(dtype))
+    return value
+
+
+def static_shape(value_type: CoreType, context: str) -> Tuple[int, ...]:
+    """Return a concrete shape; symbolic runtime specialization is W3+."""
+
+    if not isinstance(value_type, CoreType):
+        raise CpuScalarValidationError("{} must be CoreType".format(context))
+    result = []
+    for index, dimension in enumerate(value_type.shape):
+        if isinstance(dimension, bool) or not isinstance(dimension, int):
+            raise CpuScalarUnsupportedError(
+                "{} has symbolic dimension at axis {}; CPU scalar requires concrete shapes".format(context, index)
+            )
+        result.append(dimension)
+    return tuple(result)
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _validate_dtype(value_type: CoreType, context: str) -> None:
+    if value_type.dtype is None:
+        raise CpuScalarValidationError("{} has no dtype".format(context))
+    canonical_dtype(value_type.dtype)
+
+
+def _attrs(operation: Operation) -> Mapping[str, Any]:
+    return operation.attributes
+
+
+def _one_output(operation: Operation, opname: str) -> CoreType:
+    if len(operation.outputs) != 1:
+        raise CpuScalarValidationError(
+            "{} operation must have exactly one output, got {}".format(opname, len(operation.outputs))
+        )
+    return operation.outputs[0].type
+
+
+def _same_type(left: CoreType, right: CoreType, context: str) -> None:
+    if left != right:
+        raise CpuScalarValidationError("{} requires matching CoreType values".format(context))
+
+
+def _same_dtype(left: CoreType, right: CoreType, context: str) -> None:
+    if left.kind != right.kind or canonical_dtype(left.dtype) != canonical_dtype(right.dtype):
+        raise CpuScalarValidationError("{} requires matching value kinds and dtypes".format(context))
+
+
+def _normalize_axes(attributes: Mapping[str, Any], rank: int, context: str) -> Tuple[int, ...]:
+    raw = attributes.get("axes", attributes.get("axis"))
+    if raw is None:
+        axes = tuple(range(rank))
+    elif isinstance(raw, int) and not isinstance(raw, bool):
+        axes = (raw,)
+    else:
+        if isinstance(raw, (str, bytes)):
+            raise CpuScalarValidationError("{} axes must be an integer or sequence of integers".format(context))
+        try:
+            axes = tuple(raw)
+        except TypeError as exc:
+            raise CpuScalarValidationError("{} axes must be an integer or sequence of integers".format(context)) from exc
+    normalized = []
+    for axis in axes:
+        if isinstance(axis, bool) or not isinstance(axis, int):
+            raise CpuScalarValidationError("{} axes must contain integers".format(context))
+        axis = axis + rank if axis < 0 else axis
+        if axis < 0 or axis >= rank:
+            raise CpuScalarValidationError("{} axis {} is outside rank {}".format(context, axis, rank))
+        if axis in normalized:
+            raise CpuScalarValidationError("{} contains duplicate axis {}".format(context, axis))
+        normalized.append(axis)
+    return tuple(normalized)
+
+
+def reduced_shape(input_shape: Sequence[int], attributes: Mapping[str, Any], context: str) -> Tuple[int, ...]:
+    """Compute the exact shape required by a reduction operation."""
+
+    shape = tuple(input_shape)
+    axes = _normalize_axes(attributes, len(shape), context)
+    keepdims = attributes.get("keepdims", False)
+    if not isinstance(keepdims, bool):
+        raise CpuScalarValidationError("{} keepdims must be bool".format(context))
+    if keepdims:
+        return tuple(1 if axis in axes else dimension for axis, dimension in enumerate(shape))
+    return tuple(dimension for axis, dimension in enumerate(shape) if axis not in axes)
+
+
+def _constant_values(operation: Operation, output_type: CoreType) -> Any:
+    attributes = _attrs(operation)
+    has_value = "value" in attributes
+    has_values = "values" in attributes
+    if has_value == has_values:
+        raise CpuScalarValidationError("constant requires exactly one of attributes 'value' or 'values'")
+    value = attributes["value"] if has_value else attributes["values"]
+    if _is_scalar(output_type):
+        if isinstance(value, (list, tuple)):
+            if len(value) != 1:
+                raise CpuScalarValidationError("scalar constant value must not be an array")
+            return value[0]
+        return value
+    if not _is_tensor(output_type):
+        raise CpuScalarUnsupportedError("constant output kind {!r} is unsupported".format(output_type.kind))
+    shape = static_shape(output_type, "constant output")
+    flattened = flatten_values(value)
+    expected = element_count(shape)
+    if len(flattened) != expected:
+        raise CpuScalarValidationError(
+            "constant has {} values but output shape {} requires {}".format(len(flattened), shape, expected)
+        )
+    return flattened
+
+
+def flatten_values(value: Any) -> Tuple[Any, ...]:
+    """Flatten nested standard-library sequences, rejecting strings/mappings."""
+
+    if isinstance(value, (str, bytes, bytearray, Mapping)):
+        return (value,)
+    if isinstance(value, (list, tuple)):
+        result = []
+        for item in value:
+            result.extend(flatten_values(item))
+        return tuple(result)
+    return (value,)
+
+
+def element_count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+def _validate_operation(operation: Operation, context: str) -> None:
+    name = canonical_operation_name(operation.name)
+    if operation.regions:
+        raise CpuScalarUnsupportedError("{} contains regions; structured control flow is not in W2".format(context))
+    inputs = operation.inputs
+    outputs = operation.outputs
+    if name == "constant":
+        if inputs:
+            raise CpuScalarValidationError("{} constant must not have inputs".format(context))
+        output_type = _one_output(operation, name)
+        _validate_dtype(output_type, context + ".output")
+        _constant_values(operation, output_type)
+        return
+    if name == "identity":
+        if len(inputs) != 1:
+            raise CpuScalarValidationError("{} identity requires one input".format(context))
+        output_type = _one_output(operation, name)
+        _same_type(inputs[0].type, output_type, context + ".identity")
+        _validate_dtype(output_type, context + ".output")
+        if not (_is_tensor(output_type) or _is_scalar(output_type)):
+            raise CpuScalarUnsupportedError("{} identity kind {!r} is unsupported".format(context, output_type.kind))
+        if _is_tensor(output_type):
+            static_shape(output_type, context + ".output")
+        return
+    if name in ("add", "sub", "mul", "div"):
+        if len(inputs) != 2:
+            raise CpuScalarValidationError("{} {} requires two inputs".format(context, name))
+        output_type = _one_output(operation, name)
+        for input_ref in inputs:
+            _validate_dtype(input_ref.type, context + ".input")
+            if not (_is_tensor(input_ref.type) or _is_scalar(input_ref.type)):
+                raise CpuScalarUnsupportedError("{} input kind {!r} is unsupported".format(context, input_ref.type.kind))
+        _validate_dtype(output_type, context + ".output")
+        if _is_tensor(inputs[0].type) and _is_tensor(inputs[1].type):
+            _same_type(inputs[0].type, inputs[1].type, context + ".binary")
+            _same_type(inputs[0].type, output_type, context + ".binary output")
+            static_shape(output_type, context + ".output")
+        elif _is_tensor(inputs[0].type) and _is_scalar(inputs[1].type):
+            _same_type(inputs[0].type, output_type, context + ".tensor-scalar output")
+            static_shape(output_type, context + ".output")
+        elif _is_scalar(inputs[0].type) and _is_tensor(inputs[1].type):
+            _same_type(inputs[1].type, output_type, context + ".scalar-tensor output")
+            static_shape(output_type, context + ".output")
+        elif _is_scalar(inputs[0].type) and _is_scalar(inputs[1].type):
+            if not _is_scalar(output_type):
+                raise CpuScalarValidationError("{} scalar binary output must be scalar".format(context))
+        else:
+            raise CpuScalarUnsupportedError("{} binary input kinds are unsupported".format(context))
+        return
+    if name == "neg":
+        if len(inputs) != 1:
+            raise CpuScalarValidationError("{} neg requires one input".format(context))
+        output_type = _one_output(operation, name)
+        _same_type(inputs[0].type, output_type, context + ".neg")
+        _validate_dtype(output_type, context + ".output")
+        if not (_is_tensor(output_type) or _is_scalar(output_type)):
+            raise CpuScalarUnsupportedError("{} neg kind {!r} is unsupported".format(context, output_type.kind))
+        if _is_tensor(output_type):
+            static_shape(output_type, context + ".output")
+        return
+    if name in ("reduce_sum", "reduce_max"):
+        if len(inputs) != 1:
+            raise CpuScalarValidationError("{} {} requires one input".format(context, name))
+        input_type = inputs[0].type
+        output_type = _one_output(operation, name)
+        if not _is_tensor(input_type) or not _is_tensor(output_type):
+            raise CpuScalarUnsupportedError("{} reduction only supports tensor values".format(context))
+        _validate_dtype(input_type, context + ".input")
+        _validate_dtype(output_type, context + ".output")
+        _same_dtype(input_type, output_type, context + ".reduction dtype")
+        input_shape = static_shape(input_type, context + ".input")
+        output_shape = static_shape(output_type, context + ".output")
+        expected_shape = reduced_shape(input_shape, _attrs(operation), context + ".reduction")
+        if output_shape != expected_shape:
+            raise CpuScalarValidationError(
+                "{} reduction output shape {} does not match expected {}".format(context, output_shape, expected_shape)
+            )
+        return
+    if name == "matmul":
+        if len(inputs) != 2:
+            raise CpuScalarValidationError("{} matmul requires two inputs".format(context))
+        output_type = _one_output(operation, name)
+        if not all(_is_tensor(ref.type) for ref in inputs) or not _is_tensor(output_type):
+            raise CpuScalarUnsupportedError("{} matmul only supports tensor values".format(context))
+        for ref in inputs:
+            _validate_dtype(ref.type, context + ".input")
+            if len(ref.type.shape) != 2:
+                raise CpuScalarValidationError("{} matmul inputs must be rank 2".format(context))
+        _validate_dtype(output_type, context + ".output")
+        _same_dtype(inputs[0].type, inputs[1].type, context + ".matmul dtype")
+        _same_dtype(inputs[0].type, output_type, context + ".matmul output")
+        left_shape = static_shape(inputs[0].type, context + ".left")
+        right_shape = static_shape(inputs[1].type, context + ".right")
+        output_shape = static_shape(output_type, context + ".output")
+        if left_shape[1] != right_shape[0] or output_shape != (left_shape[0], right_shape[1]):
+            raise CpuScalarValidationError(
+                "{} matmul shapes {} x {} cannot produce {}".format(context, left_shape, right_shape, output_shape)
+            )
+        for key in ("transpose_a", "transpose_b"):
+            if key in _attrs(operation) and _attrs(operation)[key] is not False:
+                raise CpuScalarUnsupportedError("{} matmul {} is unsupported".format(context, key))
+        return
+    raise CpuScalarUnsupportedError("{} operation {!r} is unsupported".format(context, operation.name))
+
+
+def validate_program(program: CoreProgram) -> CoreProgram:
+    """Verify Core IR and the complete static scalar subset."""
+
+    if not isinstance(program, CoreProgram):
+        raise CpuScalarValidationError("CPU scalar lowering requires CoreProgram")
+    program.verify()
+    if not program.functions:
+        raise CpuScalarValidationError("CPU scalar program must contain at least one function")
+    for function in program.functions:
+        if function.body.blocks:
+            raise CpuScalarUnsupportedError(
+                "function {!r} uses block regions; CPU scalar W2 accepts direct operation bodies only".format(function.name)
+            )
+        for index, operation in enumerate(function.body.operations):
+            _validate_operation(operation, "function {}.body.operations[{}]".format(function.name, index))
+        for ref in function.parameters + function.returns:
+            if not (_is_tensor(ref.type) or _is_scalar(ref.type)):
+                raise CpuScalarUnsupportedError(
+                    "function {!r} value {!r} has unsupported kind {!r}".format(function.name, ref.name, ref.type.kind)
+                )
+            _validate_dtype(ref.type, "function {} value {}".format(function.name, ref.name))
+            if _is_tensor(ref.type):
+                static_shape(ref.type, "function {} value {}".format(function.name, ref.name))
+    return program
+
+
+@dataclass(frozen=True)
+class CpuScalarProgram:
+    """Validated target IR passed from the compiler to the artifact builder."""
+
+    program: CoreProgram
+    target: TargetSpec
+    entrypoint: str
+    lowering_version: int = LOWERING_VERSION
+
+    def __post_init__(self) -> None:
+        validate_program(self.program)
+        validate_cpu_target(self.target)
+        if not isinstance(self.entrypoint, str) or not self.entrypoint.strip():
+            raise CpuScalarValidationError("CPU scalar entrypoint must be non-empty")
+        if self.entrypoint not in {function.name for function in self.program.functions}:
+            raise CpuScalarValidationError("CPU scalar entrypoint {!r} is not a program function".format(self.entrypoint))
+        if self.lowering_version != LOWERING_VERSION:
+            raise CpuScalarValidationError("unsupported CPU scalar lowering version {!r}".format(self.lowering_version))
+
+
+def validate_cpu_target(target: TargetSpec) -> TargetSpec:
+    if not isinstance(target, TargetSpec):
+        raise CpuScalarValidationError("CPU scalar lowering requires TargetSpec")
+    if target.kind != "cpu":
+        raise CpuScalarValidationError("CPU scalar target requires kind='cpu', got {!r}".format(target.kind))
+    return target
+
+
+def lower_cpu_scalar(program: CoreProgram, target: TargetSpec, entrypoint: Optional[str] = None) -> CpuScalarProgram:
+    """Validate and lower one target-independent program to scalar target IR."""
+
+    validate_cpu_target(target)
+    validate_program(program)
+    selected = entrypoint
+    if selected is None:
+        selected = target.attributes.get("entrypoint", program.functions[0].name)
+    if not isinstance(selected, str):
+        raise CpuScalarValidationError("target entrypoint must be a string")
+    return CpuScalarProgram(program, target, selected)
+
+
+lower = lower_cpu_scalar
+
+
+__all__ = [
+    "CPU_SCALAR_BACKEND",
+    "LOWERING_VERSION",
+    "OP_ALIASES",
+    "SUPPORTED_DTYPES",
+    "SUPPORTED_OPERATIONS",
+    "CpuScalarError",
+    "CpuScalarProgram",
+    "CpuScalarUnsupportedError",
+    "CpuScalarValidationError",
+    "canonical_dtype",
+    "canonical_operation_name",
+    "element_count",
+    "flatten_values",
+    "lower",
+    "lower_cpu_scalar",
+    "reduced_shape",
+    "static_shape",
+    "validate_cpu_target",
+    "validate_program",
+]
