--- /dev/null
+++ b/python/pypto/backends/cpu/tensor.py
@@ -0,0 +1,180 @@
+"""Small host-side buffers used by the CPU scalar runtime tests and examples."""
+
+from __future__ import annotations
+
+import math
+import struct
+from typing import Any, Iterable, Optional, Sequence, Tuple
+
+from pypto.abi import TensorDesc
+from pypto.lowering.cpu import canonical_dtype, element_count, flatten_values
+
+
+class HostTensor:
+    """A mutable flat host tensor with a vendor-neutral ``TensorDesc`` handle.
+
+    The class deliberately stores ordinary Python values.  It is a convenience
+    for the reference runtime, not a replacement for a production device
+    allocation.  ``descriptor()`` puts this object in ``TensorDesc.handle``;
+    it never adds vendor fields to the ABI descriptor.
+    """
+
+    def __init__(
+        self,
+        dtype: str,
+        shape: Sequence[int],
+        values: Optional[Any] = None,
+        *,
+        fill: Any = 0,
+    ) -> None:
+        self.dtype = canonical_dtype(dtype)
+        self.shape = _shape(shape)
+        expected = element_count(self.shape)
+        if values is None:
+            raw_values = [fill] * expected
+        else:
+            raw_values = list(flatten_values(values))
+        if len(raw_values) != expected:
+            raise ValueError("HostTensor values length {} does not match shape {} ({} values)".format(
+                len(raw_values), self.shape, expected
+            ))
+        self.data = [_cast_value(value, self.dtype) for value in raw_values]
+
+    @classmethod
+    def zeros(cls, dtype: str, shape: Sequence[int]) -> "HostTensor":
+        return cls(dtype, shape)
+
+    @classmethod
+    def from_flat(cls, dtype: str, shape: Sequence[int], values: Iterable[Any]) -> "HostTensor":
+        return cls(dtype, shape, list(values))
+
+    def descriptor(self, *, readonly: bool = False) -> TensorDesc:
+        return TensorDesc(self.dtype, self.shape, device="cpu", handle=self, readonly=readonly)
+
+    def tolist(self) -> Any:
+        return _reshape(self.data, self.shape)
+
+    def flat(self) -> Tuple[Any, ...]:
+        return tuple(self.data)
+
+    def copy(self) -> "HostTensor":
+        return HostTensor(self.dtype, self.shape, self.data)
+
+    def __len__(self) -> int:
+        return len(self.data)
+
+    def __getitem__(self, index: int) -> Any:
+        return self.data[index]
+
+    def __setitem__(self, index: int, value: Any) -> None:
+        self.data[index] = _cast_value(value, self.dtype)
+
+    def __repr__(self) -> str:
+        return "HostTensor(dtype={!r}, shape={!r}, values={!r})".format(self.dtype, self.shape, self.tolist())
+
+
+class FlatBuffer:
+    """A dtype-neutral mutable flat buffer for callers using raw descriptors."""
+
+    def __init__(self, values: Iterable[Any]) -> None:
+        self.data = list(values)
+
+    @classmethod
+    def zeros(cls, size: int, fill: Any = 0) -> "FlatBuffer":
+        if isinstance(size, bool) or not isinstance(size, int) or size < 0:
+            raise ValueError("FlatBuffer size must be a non-negative integer")
+        return cls([fill] * size)
+
+    def __len__(self) -> int:
+        return len(self.data)
+
+    def __getitem__(self, index: int) -> Any:
+        return self.data[index]
+
+    def __setitem__(self, index: int, value: Any) -> None:
+        self.data[index] = value
+
+    def __iter__(self):
+        return iter(self.data)
+
+
+def _shape(shape: Sequence[int]) -> Tuple[int, ...]:
+    if isinstance(shape, (str, bytes)):
+        raise ValueError("shape must be a sequence of non-negative integers")
+    try:
+        values = tuple(shape)
+    except TypeError as exc:
+        raise ValueError("shape must be a sequence of non-negative integers") from exc
+    for index, value in enumerate(values):
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            raise ValueError("shape[{}] must be a non-negative integer".format(index))
+    return values
+
+
+def _reshape(values: Sequence[Any], shape: Tuple[int, ...]) -> Any:
+    if not shape:
+        return values[0] if values else None
+    if any(dimension == 0 for dimension in shape):
+        return _empty_nested(shape)
+    cursor = 0
+
+    def build(axis: int):
+        nonlocal cursor
+        if axis == len(shape) - 1:
+            result = list(values[cursor:cursor + shape[axis]])
+            cursor += shape[axis]
+            return result
+        return [build(axis + 1) for _ in range(shape[axis])]
+
+    return build(0)
+
+
+def _empty_nested(shape: Tuple[int, ...]) -> Any:
+    if not shape:
+        return None
+    if shape[0] == 0:
+        return []
+    return [_empty_nested(shape[1:]) for _ in range(shape[0])]
+
+
+def _cast_value(value: Any, dtype: str) -> Any:
+    dtype = canonical_dtype(dtype)
+    if dtype == "bool":
+        return bool(value)
+    if dtype.startswith("int") or dtype.startswith("uint"):
+        if isinstance(value, bool):
+            value = int(value)
+        if isinstance(value, float) and not math.isfinite(value):
+            raise ValueError("integer tensor value must be finite")
+        result = int(value)
+        bits = int(dtype[3:] if dtype.startswith("int") else dtype[4:])
+        lower = -(1 << (bits - 1)) if dtype.startswith("int") else 0
+        upper = (1 << (bits - 1)) - 1 if dtype.startswith("int") else (1 << bits) - 1
+        if result < lower or result > upper:
+            raise ValueError("{} value {} is out of range".format(dtype, result))
+        return result
+    result = float(value)
+    if dtype == "bf16":
+        return _round_bf16(result)
+    if dtype == "float16":
+        try:
+            return struct.unpack("<e", struct.pack("<e", result))[0]
+        except OverflowError as exc:
+            raise ValueError("float16 value {} is out of range".format(result)) from exc
+    return result
+
+
+def _round_bf16(value: float) -> float:
+    """Round a Python float to the nearest representable BF16 value."""
+
+    if not math.isfinite(value):
+        return value
+    bits = struct.unpack("<I", struct.pack("<f", value))[0]
+    lower = bits & 0xFFFF
+    upper = bits >> 16
+    if lower > 0x8000 or (lower == 0x8000 and (upper & 1)):
+        upper += 1
+    return struct.unpack("<f", struct.pack("<I", upper << 16))[0]
+
+
+__all__ = ["FlatBuffer", "HostTensor"]
