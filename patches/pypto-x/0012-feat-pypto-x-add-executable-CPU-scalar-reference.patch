@@ -0,0 +1,140 @@
+"""Deterministic compiler for the PyPTO-X CPU scalar reference target."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any, Mapping, Optional
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu import (
+    CPU_SCALAR_BACKEND,
+    LOWERING_VERSION,
+    CpuScalarProgram,
+    lower_cpu_scalar,
+)
+from pypto.target import TargetSpec
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+DEFAULT_ARTIFACT_FORMAT = "pypto-x.cpu.scalar"
+
+
+class CpuScalarCompiler:
+    """Lower and package a validated CoreProgram for the scalar runtime."""
+
+    name = CPU_SCALAR_BACKEND
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> CpuScalarProgram:
+        return lower_cpu_scalar(program, target)
+
+    def compile(self, target_ir: CpuScalarProgram, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, CpuScalarProgram):
+            raise TypeError("CPU scalar compile() requires CpuScalarProgram from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+
+        program_json = target_ir.program.canonical_json()
+        program_payload = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        target_data = dict(target_ir.target.to_dict())
+        envelope = {
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "backend": CPU_SCALAR_BACKEND,
+            "lowering_version": LOWERING_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "target": target_data,
+            "program": program_payload,
+            "program_digest": program_digest,
+        }
+        payload_text = json.dumps(
+            envelope,
+            ensure_ascii=False,
+            allow_nan=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        payload = payload_text.encode("utf-8")
+        payload_digest = hashlib.sha256(payload).hexdigest()
+        metadata = {
+            "backend": CPU_SCALAR_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "lowering_version": LOWERING_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "program_digest": program_digest,
+            "payload_digest": payload_digest,
+            "target_digest": hashlib.sha256(
+                json.dumps(target_data, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+            ).hexdigest(),
+        }
+        if options is not None:
+            option_metadata = _plain_mapping(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError("compile option metadata uses reserved CPU scalar keys: {}".format(
+                    ", ".join(sorted(reserved))
+                ))
+            metadata.update(option_metadata)
+            metadata["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "extra": _plain_mapping(options.extra),
+            }
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        return Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            payload=payload,
+            metadata=metadata,
+        )
+
+
+def _plain_mapping(value: Mapping[str, Any]) -> dict:
+    """Copy frozen ABI mappings before placing them in artifact metadata."""
+
+    if not isinstance(value, Mapping):
+        raise TypeError("metadata must be a mapping")
+    return {key: _plain_value(item) for key, item in value.items()}
+
+
+def _plain_value(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [_plain_value(item) for item in value]
+    if isinstance(value, list):
+        return [_plain_value(item) for item in value]
+    return value
+
+
+CPUCompiler = CpuScalarCompiler
+CPUScalarCompiler = CpuScalarCompiler
+
+
+def compile_cpu_scalar(
+    program: CoreProgram,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None,
+) -> Artifact:
+    """Convenience wrapper using the public compiler contract."""
+
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION",
+    "CPUCompiler",
+    "CPUScalarCompiler",
+    "DEFAULT_ARTIFACT_FORMAT",
+    "CpuScalarCompiler",
+    "compile_cpu_scalar",
+]
diff --git a/python/pypto/lowering/cpu/__init__.py b/python/pypto/lowering/cpu/__init__.py
