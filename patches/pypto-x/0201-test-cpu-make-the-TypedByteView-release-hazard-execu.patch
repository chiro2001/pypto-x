From 7e2aea514b7bd469d7b0ec2cb5a6dba275b83c7b Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 03:23:48 +0800
Subject: [PATCH 201/257] test(cpu): make the TypedByteView release hazard
 executable

The minimal reproduction shows the CPython buffer export really blocks
bytearray resizing, that releasing the environment's last reference
destroys the view and closes the export, and that a pinned parameter
keeps the view usable.
---
 python/tests/ut/pypto_x/test_cpu_sve256.py | 43 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/python/tests/ut/pypto_x/test_cpu_sve256.py b/python/tests/ut/pypto_x/test_cpu_sve256.py
index e0403d8df..3c3008348 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256.py
@@ -1760,3 +1760,46 @@ def test_sve256_release_never_drops_a_caller_owned_typed_view(tmp_path, monkeypa
     # The caller's buffer export survives the whole launch.
     assert memoryview(inputs[0]).tobytes() == inputs[0].tobytes()
     np.testing.assert_array_equal(output, expected)
+
+
+def test_sve256_typed_view_release_is_a_real_hazard_and_pinning_prevents_it():
+    """Minimal reproduction for the one SVE256-specific lifetime hazard.
+
+    A ``TypedByteView`` owns a live CPython buffer export of the caller's
+    storage.  If the environment released it while still in use, the export
+    would be closed and the value would become unusable.  The runtime never
+    releases a view because views are only ever created for parameters, and
+    ``ssa_liveness`` pins every parameter; this test makes both halves of that
+    argument executable.
+    """
+
+    import gc
+    import weakref
+
+    from pypto.backends.cpu.byte_view import TypedByteView
+    from pypto.backends.cpu.ssa_liveness import release_dead_values
+
+    payload = bytearray(struct.pack("<4f", 1.0, 2.0, 3.0, 4.0))
+    dead_view = TypedByteView(payload, "float32", (4,), readonly=False)
+    view_ref = weakref.ref(dead_view)
+    environment = {"view": (CoreType.tensor("float32", (4,)), dead_view)}
+    # The export is a real, observable resource: it blocks bytearray resizing.
+    with pytest.raises(BufferError):
+        payload.extend(b"\x00")
+    del dead_view  # the environment is now the only holder
+    assert view_ref() is not None
+    assert release_dead_values(environment, {"view": 0}, frozenset(), 0, ["view"], []) == ("view",)
+    gc.collect()
+    # Releasing the last holder destroyed the view and closed the export.
+    assert view_ref() is None
+    payload.extend(b"\x00")
+    assert len(payload) == 17
+
+    pinned_payload = bytearray(struct.pack("<4f", 1.0, 2.0, 3.0, 4.0))
+    pinned_view = TypedByteView(pinned_payload, "float32", (4,), readonly=False)
+    environment = {"param": (CoreType.tensor("float32", (4,)), pinned_view)}
+    assert (
+        release_dead_values(environment, {"param": 0}, frozenset(("param",)), 0, ["param"], []) == ()
+    )
+    assert "param" in environment
+    assert pinned_view.to_bytes() == bytes(pinned_payload)
