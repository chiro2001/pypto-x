+#: ``-128`` is the only in-range int8 value outside the frozen contract domain.
+_RESERVED_CODE_BYTE = b"\x80"
+
+
+def _check_codes(values: Sequence[Any], label: str) -> "array":
+    """Validate the s8 code domain in one bulk conversion; returns the buffer.
+
+    ``array('b', values)`` performs the per-element type/range work in C
+    (``__index__``; ``TypeError`` for floats/strings, ``OverflowError`` outside
+    [-128, 127]) and yields exactly the buffer the GEMM consumes, so callers do
+    not pay a second Python-level pass over M*K + K*N elements.  The only
+    in-range contract violation left is the reserved ``-128`` code, found with
+    a single ``memchr`` over the converted bytes (an ``array('b')`` can never
+    hold a value above 127).  ``bool`` is an ``int`` subclass, so ``True`` /
+    ``False`` are accepted as their numeric codes 1 / 0; non-integer container
+    elements fall back to the strict per-element validator for its structured
+    ``code_not_integer`` / ``code_out_of_range`` errors.
+    """
+
+    try:
+        codes = array("b", values)
+    except (TypeError, ValueError, OverflowError):
+        _check_codes_strict(values, label)
+        raise AssertionError("_check_codes_strict must raise")  # pragma: no cover
+    if codes:
+        index = codes.tobytes().find(_RESERVED_CODE_BYTE)
+        if index >= 0:
+            raise OpContractError(
+                "{}[{}]={} is outside the frozen s8 code range [{}, {}]".format(
+                    label, index, -128, AOCL_INT8_QUANT_MIN, AOCL_INT8_QUANT_MAX
+                ),
+                field="request." + label,
+                requested=-128,
+                available={
+                    "min": AOCL_INT8_QUANT_MIN,
+                    "max": AOCL_INT8_QUANT_MAX,
+                    "reserved": -128,
+                },
+                reason="reserved_code_point",
+            )
+    return codes
+
