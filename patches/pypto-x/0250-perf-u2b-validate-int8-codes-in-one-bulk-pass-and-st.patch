+def test_check_codes_bulk_validator_returns_the_gemm_buffer():
+    """The code-domain check is one bulk conversion, not a per-element loop."""
+
+    from array import array as _array
+
+    codes = _check_codes([0, 1, -127, 127] * 8, "left")
+    assert isinstance(codes, _array)
+    assert codes.typecode == "b"
+    assert list(codes) == [0, 1, -127, 127] * 8
+    assert list(_check_codes((5, -3), "right")) == [5, -3]
+    assert len(_check_codes([], "left")) == 0
+
+
+def test_check_codes_reserved_point_and_strict_fallbacks():
+    with pytest.raises(OpContractError) as excinfo:
+        _check_codes([1, 2, -128, 4], "left")
+    assert excinfo.value.reason == "reserved_code_point"
+    assert excinfo.value.requested == -128
+    assert excinfo.value.field == "request.left"
+    for bad, reason in (
+        ([200], "code_out_of_range"),
+        ([-129], "code_out_of_range"),
+        ([1.5], "code_not_integer"),
+        (["x"], "code_not_integer"),
+    ):
+        with pytest.raises(OpContractError) as excinfo:
+            _check_codes(bad, "right")
+        assert excinfo.value.reason == reason, (bad, excinfo.value.to_dict())
+        assert excinfo.value.field == "request.right"
+    # The per-element validator is the structured-error fallback.
+    with pytest.raises(OpContractError) as excinfo:
+        _check_codes_strict([1.5, 2], "left")
+    assert excinfo.value.reason == "code_not_integer"
+
+
+def test_check_codes_accepts_numpy_integer_scalars():
+    import numpy as np
+
+    values = [np.int8(3), np.int16(-5), np.int64(127)]
+    codes = _check_codes(values, "left")
+    assert list(codes) == [3, -5, 127]
+    with pytest.raises(OpContractError) as excinfo:
+        _check_codes([np.int8(-128)], "left")
+    assert excinfo.value.reason == "reserved_code_point"
+
+
+@requires_aocl
+@requires_int8_host
+def test_vendor_entry_overhead_tracks_the_bulk_marshalling_floor():
+    """Dispatch is O(marshalling), not the old per-element Python scan.
+
+    The reference floor is the same call the adapter must make anyway
+    (``array('b', data)`` for both operands); the pre-fix per-element validator
+    was ~19x the bulk conversion for the same 8.4M elements (2.48 s vs
+    0.13 s).  The bound is deliberately generous (6x the floor) so a loaded
+    host cannot fail it while a regression to a Python-level scan does.
+    """
+
+    from array import array as _array
+    import time as _time
+
+    left = _tensor((5, 1024), seed=611)
+    right = _tensor((1024, 1024), seed=612)
+    policy = _vendor_policy(max_threads=1)
+    started = _time.perf_counter()
+    _array("b", left.data)
+    _array("b", right.data)
+    floor = _time.perf_counter() - started
+    started = _time.perf_counter()
+    output, report = execute_qmatmul(left, right, policy)
+    dispatch = _time.perf_counter() - started
+    assert len(output.flat()) == 5 * 1024
+    assert report.to_dict()["guarantees"]["exactness_envelope"]["deviation_bound_kind"] == (
+        "measured_snapshot"
+    )
+    assert dispatch < max(1.0, 6.0 * floor), (dispatch, floor)
+
+
+@requires_aocl
+@requires_int8_host
+def test_vendor_execution_restores_the_process_blis_thread_count():
+    """api_pinned must not leak BLIS's process-global thread count."""
+
+    left = _tensor((2, 64), seed=701)
+    right = _tensor((64, 2), seed=702)
+    policy = _vendor_policy(max_threads=1)
+    lib = _get_library(AOCL_DEFAULT_LIBRARY)
+    before = int(lib.bli_thread_get_num_threads())
+    output, report = execute_qmatmul(left, right, policy)
+    after = int(lib.bli_thread_get_num_threads())
+    assert after == before, (
+        before,
+        after,
+        report.to_dict()["resolved"].get("provider"),
+    )
+    assert len(output.flat()) == 4
+
