+def _call_math(module: Any, name: str, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    """Invoke the AVX2 math entrypoint.
+
+    The compiler intentionally implements these transcendental operations as
+    scalar libm lanes in the native runner.  Keeping this call separate from
+    the ordinary vector unary path makes that limitation visible in artifact
+    metadata and prevents it from being mistaken for a fused approximation.
+    """
