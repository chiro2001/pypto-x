+            "descriptor_digest": plan.split_plan.descriptor_digest,
+        }
+        for plan in target_ir.plans
+        if plan.split_plan is not None
+    ]
+
+
+def _concat_metadata(target_ir: Avx2Program) -> list:
+    return [
+        {
+            "operation": plan.operation,
+            "input_shapes": [list(shape) for shape in plan.concat_plan.input_shapes],
+            "output_shape": list(plan.concat_plan.output_shape),
+            "axis": plan.concat_plan.axis,
+            "sizes": list(plan.concat_plan.sizes),
+            "output_elements": plan.concat_plan.output_elements,
+            "descriptor_digest": plan.concat_plan.descriptor_digest,
+        }
+        for plan in target_ir.plans
+        if plan.concat_plan is not None
+    ]
+
+
+def _execution_metadata(target_ir: Avx2Program) -> dict:
+    """Return the immutable AVX2 native/fallback boundary description."""
+
+    operations = []
+    native_operations = []
+    math_fallback = []
+    position_operations = []
+    host_operations = []
+    for plan in target_ir.plans:
+        name = plan.operation
+        dtype = plan.dtype
+        if name in ("exp", "rsqrt", "sigmoid", "silu", "softplus"):
+            mode = "native_scalar_math_lane"
+            if name not in math_fallback:
+                math_fallback.append(name)
+        elif name == "matmul" and plan.matmul is not None and plan.matmul.batch_shape:
+            mode = "host_batch_loop_rank2_native"
+        elif name in ("identity", "add", "sub", "mul", "div", "neg", "reduce_sum", "reduce_max", "reduce_mean", "matmul") and dtype in ("float32", "bf16"):
+            mode = "native_avx2"
+            native_operations.append(name)
+        elif name in ("compare", "iota"):
+            mode = "host_reference"
+            position_operations.append(name)
+        elif name in ("constant",):
+            mode = "host_materialize"
+        else:
+            mode = "host_reference"
+            host_operations.append(name)
+        operations.append({"operation_index": plan.operation_index, "operation": name, "mode": mode})
+    return {
+        "execution_modes": operations,
+        "native_operations": native_operations,
+        "scalar_math_lane_fallback": math_fallback,
+        "host_preexpanded_operations": [
+            name for name in ("broadcast", "where")
+            if any(plan.operation == name for plan in target_ir.plans)
+        ],
+        "position_control_operations": position_operations,
+        "position_control_fallback": "host_reference",
+        "host_reference_operations": host_operations,
+        "layout_plan_version": 2,
+        "layout_operations": _layout_metadata(target_ir),
+        "layout_descriptor_wire": "host-reference:v1",
+        "layout_scalar_lane_fallback": [],
+        "indexing_descriptor_wire": "host-reference:v1",
+        "indexing_scalar_lane_fallback": [],
+        "indexing_operations": _indexing_metadata(target_ir),
+        "split_operations": _split_metadata(target_ir),
+        "concat_operations": _concat_metadata(target_ir),
+        "logical_layout_copy_operations": [
+            plan.operation for plan in target_ir.plans
+            if plan.layout_plan is not None and plan.layout_plan.kind == "logical_layout_copy"
+        ],
+        "native_layout_reorder_operations": [],
+        "batched_matmul_fallback": "host_batch_loop_rank2_native",
+        "batched_matmul_operations": [
+            {
+                "operation": plan.operation,
+                "batch_shape": list(plan.matmul.batch_shape),
+                "m": plan.matmul.m,
+                "k": plan.matmul.k,
+                "n": plan.matmul.n,
+                "mode": "host_batch_loop_rank2_native",
+            }
+            for plan in target_ir.plans
+            if plan.matmul is not None and plan.matmul.batch_shape
+        ],
+    }
+
+
