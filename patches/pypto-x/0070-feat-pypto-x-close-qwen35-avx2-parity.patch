+static inline float ptx_avx2_math_scalar(int operation, float value) {
+    if (operation == 0) return expf(value);
+    if (operation == 1) {
+        if (isnan(value) || value < 0.0f) return NAN;
+        if (value == 0.0f) return INFINITY;
+        return 1.0f / sqrtf(value);
+    }
+    if (operation == 2) {
+        if (value >= 0.0f) return 1.0f / (1.0f + expf(-value));
+        {
+            float exponent = expf(value);
+            return exponent / (1.0f + exponent);
+        }
+    }
+    if (operation == 3) {
+        if (value == -INFINITY) return 0.0f;
+        if (value == INFINITY) return value;
+        return value * ptx_avx2_math_scalar(2, value);
+    }
+    if (operation == 4) return log1pf(expf(-fabsf(value))) + fmaxf(value, 0.0f);
+    return NAN;
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_math_f32(int operation, const float *input, float *output, size_t n) {
+    size_t i;
+    for (i = 0; i < n; ++i) output[i] = ptx_avx2_math_scalar(operation, input[i]);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_math_bf16(int operation, const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i;
+    for (i = 0; i < n; ++i) {
+        output[i] = ptx_f32_to_bf16(ptx_avx2_math_scalar(operation, ptx_bf16_to_f32(input[i])));
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_reduce_mean_f32(const float *input, float *output, size_t n) {
+    float total = 0.0f;
+    size_t i;
+    if (n == 0) return;
+    for (i = 0; i < n; ++i) total += input[i];
+    *output = total / (float)n;
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_reduce_mean_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    float total = 0.0f;
+    size_t i;
+    if (n == 0) return;
+    for (i = 0; i < n; ++i) total += ptx_bf16_to_f32(input[i]);
+    *output = ptx_f32_to_bf16(total / (float)n);
+}
