+    def _execute_batched_matmul(
+        self,
+        left: _RuntimeValue,
+        right: _RuntimeValue,
+        dtype: str,
+        matmul: Any,
+        module: Any,
+        context: str,
+    ) -> List[Any]:
+        """Run rank-2 native matmul once per batch on the host.
+
+        The AVX2 native ABI remains rank-2.  This is intentionally a host
+        batch loop over real AVX2 rank-2 kernels, and is recorded as such in
+        the artifact metadata; it is not advertised as fused batched SIMD.
+        """
+
+        batch_count = 1
+        for dimension in matmul.batch_shape:
+            batch_count *= dimension
+        left_matrix_elements = matmul.m * matmul.k
+        right_matrix_elements = matmul.k * matmul.n
+        left_values = _buffer_raw(left.buffer)
+        right_values = _buffer_raw(right.buffer)
+        if len(left_values) != batch_count * left_matrix_elements or len(right_values) != batch_count * right_matrix_elements:
+            raise CpuAvx2ExecutionError("{} batched matmul input length mismatch".format(context))
+        result: List[Any] = []
+        for batch_index in range(batch_count):
+            left_batch = _buffer_from_raw(
+                dtype,
+                left_values[batch_index * left_matrix_elements:(batch_index + 1) * left_matrix_elements],
+                context + ".left_batch",
+            )
+            right_batch = _buffer_from_raw(
+                dtype,
+                right_values[batch_index * right_matrix_elements:(batch_index + 1) * right_matrix_elements],
+                context + ".right_batch",
+            )
+            output_batch = _buffer_from_values(
+                dtype, [0] * (matmul.m * matmul.n), context + ".output_batch"
+            )
+            _call_matmul(module, dtype, left_batch, right_batch, output_batch, matmul.m, matmul.k, matmul.n)
+            result.extend(_buffer_values(output_batch))
+        return result
