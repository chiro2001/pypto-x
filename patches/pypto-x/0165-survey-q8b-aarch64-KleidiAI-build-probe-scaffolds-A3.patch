diff --git a/scripts/vendor/q8b/a3_build_kleidiai.sh b/scripts/vendor/q8b/a3_build_kleidiai.sh
new file mode 100755
index 000000000..a3e4a1d72
--- /dev/null
+++ b/scripts/vendor/q8b/a3_build_kleidiai.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# Q8b aarch64 leg: build KleidiAI (pinned commit) on A3 without root.
+# Rerunnable; logs into $Q8B_LOGS.
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=/dev/null
+source "$HERE/a3_env.sh"
+q8b_mkdirs
+
+cd "$Q8B_SRC"
+if [ ! -s "kleidiai-$Q8B_KLEIDIAI_SHA.tar.gz" ]; then
+    # github.com:443 is unreachable from A3; codeload.github.com works (verified 2026-09-11).
+    curl -sL -m 300 -o "kleidiai-$Q8B_KLEIDIAI_SHA.tar.gz" \
+        "https://codeload.github.com/ARM-software/kleidiai/tar.gz/$Q8B_KLEIDIAI_SHA"
+fi
+if [ ! -d "$Q8B_KLEIDIAI_DIR" ]; then
+    tar xzf "kleidiai-$Q8B_KLEIDIAI_SHA.tar.gz"
+fi
+cd "$Q8B_KLEIDIAI_DIR"
+
+cmake -S . -B "$Q8B_BUILD/kleidiai" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DKLEIDIAI_BUILD_TESTS=OFF \
+    -DKLEIDIAI_BUILD_BENCHMARK=OFF \
+    -DCMAKE_INSTALL_PREFIX="$Q8B_INSTALL/kleidiai" \
+    2>&1 | tee "$Q8B_LOGS/kleidiai-cmake.log"
+cmake --build "$Q8B_BUILD/kleidiai" -j "${Q8B_JOBS:-8}" 2>&1 | tee "$Q8B_LOGS/kleidiai-build.log"
+cmake --install "$Q8B_BUILD/kleidiai" 2>&1 | tee "$Q8B_LOGS/kleidiai-install.log"
+
+find "$Q8B_INSTALL/kleidiai" -type f | sort | tee "$Q8B_LOGS/kleidiai-install-files.txt"
diff --git a/scripts/vendor/q8b/a3_env.sh b/scripts/vendor/q8b/a3_env.sh
new file mode 100755
index 000000000..2c2eb45b3
--- /dev/null
+++ b/scripts/vendor/q8b/a3_env.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Q8b aarch64 leg: common environment for the A3 shared machine (self-owned container/home).
+# Usage: source this file.  Writes only under ~/pypto-x-a3.
+set -euo pipefail
+
+export Q8B_ROOT="${Q8B_ROOT:-$HOME/pypto-x-a3/vendor-gemm-survey-2}"
+export Q8B_SRC="$Q8B_ROOT/src"
+export Q8B_BUILD="$Q8B_ROOT/build"
+export Q8B_INSTALL="$Q8B_ROOT/install"
+export Q8B_LOGS="$Q8B_ROOT/logs"
+export Q8B_RAW="$Q8B_ROOT/raw"
+export Q8B_TMP="$Q8B_ROOT/tmp"
+export Q8B_ENVS="$Q8B_ROOT/envs"
+export Q8B_KLEIDIAI_SHA="c1c9e8767b9a345f447e5608253a7597de84aef1"
+export Q8B_KLEIDIAI_DIR="$Q8B_SRC/kleidiai-$Q8B_KLEIDIAI_SHA"
+export Q8B_CONDA_ENV="$Q8B_ENVS/onednn312"
+export Q8B_A3_PY="$HOME/pypto-x-a3/envs/pypto-x-c8/bin/python"
+
+q8b_mkdirs() {
+    mkdir -p "$Q8B_ROOT" "$Q8B_SRC" "$Q8B_BUILD" "$Q8B_INSTALL" "$Q8B_LOGS" "$Q8B_RAW" "$Q8B_TMP"
+}
+
+# Pick N logical CPUs inside the granted range (320-639) with distinct physical cores.
+q8b_pick_cpus() {
+    local n="${1:-8}"
+    lscpu -p=CPU,CORE,SOCKET,NODE 2>/dev/null | grep -v '^#' \
+        | awk -F, '$1>=320 && $1<=639 && !seen[$2]++ {print $1}' \
+        | head -n "$n" | paste -sd,
+}
diff --git a/scripts/vendor/q8b/a3_make_kai_probe_so.sh b/scripts/vendor/q8b/a3_make_kai_probe_so.sh
new file mode 100755
index 000000000..fa23cdf83
--- /dev/null
+++ b/scripts/vendor/q8b/a3_make_kai_probe_so.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# Q8b aarch64 leg: build a small shared object exposing only the KleidiAI ukernels
+# used by the probes (ctypes-friendly).  The full static library is built by
+# a3_build_kleidiai.sh; this .so is a convenience for the Python semantics probe.
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=/dev/null
+source "$HERE/a3_env.sh"
+q8b_mkdirs
+
+K="$Q8B_KLEIDIAI_DIR"
+MM="$K/kai/ukernels/matmul"
+OUT="$Q8B_INSTALL/kleidiai/libkai_probe.so"
+
+gcc -O3 -fPIC -shared -std=gnu99 \
+    -march=armv8.2-a+dotprod+i8mm -mtune=native \
+    -I"$K" \
+    "$MM/pack/kai_lhs_quant_pack_qai8dxp_f32.c" \
+    "$MM/pack/kai_rhs_pack_kxn_qsi8cxp_qsi8cx_neon.c" \
+    "$MM/matmul_clamp_f32_qai8dxp_qsi8cxp/kai_matmul_clamp_f32_qai8dxp4x8_qsi8cxp4x8_16x4_neon_i8mm.c" \
+    "$MM/matmul_clamp_f32_qai8dxp_qsi8cxp/kai_matmul_clamp_f32_qai8dxp4x8_qsi8cxp4x8_16x4_neon_i8mm_asm.S" \
+    "$MM/matmul_clamp_f32_qai8dxp_qsi8cxp/kai_matmul_clamp_f32_qai8dxp1x8_qsi8cxp4x8_1x4_neon_dotprod.c" \
+    "$MM/matmul_clamp_f32_qai8dxp_qsi8cxp/kai_matmul_clamp_f32_qai8dxp4x4_qsi8cxp4x4_16x4_neon_dotprod.c" \
+    -lm -o "$OUT"
+echo "built $OUT"
+sha256sum "$OUT"
+nm -D --defined-only "$OUT" | grep -c ' T kai_'
