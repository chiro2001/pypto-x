From d922b58faf8a3c9869b38c80ee8a87189bd06e5d Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Mon, 7 Sep 2026 02:21:11 +0800
Subject: [PATCH 016/256] fix(core-ir): allow repeated function returns

---
 python/pypto/core_ir/model.py           | 3 ---
 python/tests/ut/pypto_x/test_core_ir.py | 7 +++++++
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/python/pypto/core_ir/model.py b/python/pypto/core_ir/model.py
index 89c353eec..d561af38c 100644
--- a/python/pypto/core_ir/model.py
+++ b/python/pypto/core_ir/model.py
@@ -570,9 +570,6 @@ class CoreFunction:
         parameter_names = [ref.name for ref in self.parameters]
         if len(parameter_names) != len(set(parameter_names)):
             raise CoreIRValidationError("函数 %s 的 parameters 含重复 SSA 名称" % self.name)
-        return_names = [ref.name for ref in self.returns]
-        if len(return_names) != len(set(return_names)):
-            raise CoreIRValidationError("函数 %s 的 returns 含重复 SSA 名称" % self.name)
         available = {ref.name: ref.type for ref in self.parameters}
         self.body._verify(available, "function %s.body" % self.name)
         # Region 的 block 作用域不能简单泄漏到函数返回；允许返回值是参数，
diff --git a/python/tests/ut/pypto_x/test_core_ir.py b/python/tests/ut/pypto_x/test_core_ir.py
index b34eef8b2..6ac112431 100644
--- a/python/tests/ut/pypto_x/test_core_ir.py
+++ b/python/tests/ut/pypto_x/test_core_ir.py
@@ -176,6 +176,13 @@ def test_same_ssa_value_can_be_used_by_multiple_operand_positions():
     assert function.verify() is True
 
 
+def test_same_ssa_value_can_fill_multiple_return_positions():
+    tensor = CoreType.tensor("float32", (4,))
+    x = ValueRef("x", tensor)
+    function = CoreFunction("duplicate_return", parameters=(x,), returns=(x, x), body=Region())
+    assert function.verify() is True
+
+
 def test_tensor_frontend_explicit_export_and_native_bridge_seam():
     tensor = CoreType.tensor("bf16", (8,))
     x = ValueRef("x", tensor)
