+    manifest["threads"]["max_threads"] = manifest["threads"]["max_threads"] + 1
+    manifest["threads"]["default_threads"] = manifest["threads"]["default_threads"] + 1
+    manifest["library"]["default_threads"] = manifest["library"]["default_threads"] + 1
+    new_digest = expected_artifact_digest(AOCL_LPGEMM_F32_PROVIDER_ID, manifest["library"])
