+def _thread_fact_errors(
+    document: Mapping[str, Any], prefix: str
+) -> Tuple[Mapping[str, Any], ...]:
+    """Cross-check the probe-derived thread counts of a vendor manifest.
+
+    ``max_threads`` / ``threads.{max,default}_threads`` / the library
+    fingerprint's ``default_threads`` are all the same probe fact (the BLIS
+    load-time thread count, falling back to ``os.cpu_count()``); no code
+    constant pins the number itself.  Requiring the four copies to be equal
+    and positive refuses a partial coordinated rewrite (for example changing
+    only ``max_threads`` + ``threads.max_threads``); rewriting all four
+    together remains a registered residual boundary because there is no
+    external anchor for the count.
+    """
+
+    errors: list = []
+    threads = document.get("threads")
+    library = document.get("library")
+    max_threads = document.get("max_threads")
+    if not isinstance(threads, Mapping) or not isinstance(library, Mapping):
+        return ()
+    observed = (
+        ("max_threads", max_threads),
+        ("threads.max_threads", threads.get("max_threads")),
+        ("threads.default_threads", threads.get("default_threads")),
+        ("library.default_threads", library.get("default_threads")),
+    )
+    for name, value in observed:
+        if not _is_positive_int(value):
+            errors.append(
+                _error(
+                    "{}.{}".format(prefix, name),
+                    "report_provider_manifest_thread_facts_mismatch",
+                    requested=value,
+                    available="a positive integer thread count",
+                )
+            )
+    for name, value in observed[1:]:
+        if value != max_threads:
+            errors.append(
+                _error(
+                    "{}.{}".format(prefix, name),
+                    "report_provider_manifest_thread_facts_mismatch",
+                    requested=value,
+                    available=max_threads,
+                )
+            )
+    return tuple(errors)
+
+
 def embedded_manifest_errors(
     document: Any, opcode: str, prefix: str = "provider_manifest.document"
 ) -> Tuple[Mapping[str, Any], ...]:
-    """Check one embedded provider manifest against the registered identity."""
+    """Check one embedded provider manifest against the registered identity.
+
+    The single source of truth is the registered code/registry constants; the
+    only free inputs are the probe-derived facts explicitly taken from the
+    embedded document (library fingerprint and thread counts).  The library
+    identity fields are pinned in :func:`library_pin_errors`; the thread
+    counts are cross-checked for internal consistency by
+    :func:`_thread_fact_errors` (the count itself has no code anchor).
+    """
 
     if not isinstance(document, Mapping):
         return (
@@ -449,6 +507,7 @@ def embedded_manifest_errors(
         for path, actual, wanted in out
     ]
     errors.extend(library_pin_errors(provider_id, library, prefix + ".library"))
+    errors.extend(_thread_fact_errors(document, prefix))
     return tuple(errors)
 
 
