+def _runtime_fallback_document(
+    declared_provider_id: str = AOCL_LPGEMM_F32_PROVIDER_ID,
+    dtype: str = "float32",
+) -> Mapping[str, Any]:
+    """Execute a vendor plan whose provider is made unavailable at runtime."""
+
+    snapshot = CapabilitySnapshot.for_host(features=host_features())
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="declared", chain=("portable",)),
+        resources=ResourcePolicy(max_threads=2),
+    )
+    if dtype == "int8":
+        left = HostTensor("int8", (2, 8), list(range(1, 17)))
+        right = HostTensor("int8", (8, 2), [1, 0] * 8)
+        resolution = resolve_qmatmul(policy, snapshot, left.shape, right.shape)
+        execute_plan = execute_qmatmul_plan
+    else:
+        left = HostTensor(dtype, (4, 32), [float(index % 7 + 1) for index in range(128)])
+        right = HostTensor(dtype, (32, 8), [0.5] * 256)
+        resolution = plan_matmul(left.shape, right.shape, dtype, policy, capability=snapshot)
+        execute_plan = execute_matmul_plan
+    assert resolution.plan.selected_provider == declared_provider_id
+    original = providers_module.PROVIDERS[declared_provider_id]
+
+    class _UnavailableAtRuntime:
+        provider_id = original.provider_id
+        version = original.version
+
+        def execute(self, plan, left_, right_, output, capability):  # noqa: ANN001
+            raise ProviderUnavailableError(
+                "simulated runtime unavailability",
+                field="capability.providers",
+                requested=self.provider_id,
+                available=[],
+                reason="provider_capability_unavailable:library_not_found",
+            )
+
+    providers_module.PROVIDERS[declared_provider_id] = _UnavailableAtRuntime()
+    try:
+        _, report = execute_plan(resolution.plan, left, right, capability=snapshot)
+    finally:
+        providers_module.PROVIDERS[declared_provider_id] = original
+    document = json.loads(json.dumps(report.to_dict()))
+    assert document["dispatch"]["provider_invoked"] == "portable"
+    assert (
+        document["resolution_decision"]["document"]["selected_provider"]
+        == declared_provider_id
+    )
+    return document
