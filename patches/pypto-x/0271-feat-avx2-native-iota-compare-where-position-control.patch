+# --------------------------------------------------------------------------
+# Native position-control plane (payload 7: iota/compare/where).
+#
+# The descriptor comes from ``position_control_native_contract`` -- the same
+# predicate that produced the artifact metadata and the load-time execution
+# table -- so a declared kernel is exactly the kernel dispatched here.  The
+# scalar C kernel/descriptor loop is the accepted SVE256 v5 pattern; the f32
+# compare/where kernels additionally take an AVX2 fast path when every operand
+# is contiguous with the output shape.
+# --------------------------------------------------------------------------
+
+_POSITION_CONTROL_DESCRIPTOR_CACHE: Dict[str, Tuple[Any, ...]] = {}
+_POSITION_CONTROL_DESCRIPTOR_CACHE_LIMIT = 4096
+_POSITION_CONTROL_DESCRIPTOR_CACHE_LOCK = threading.RLock()
+_POSITION_CONTROL_NATIVE_STATS: Dict[str, int] = {
+    "kernel_calls": 0,
+    "iota_calls": 0,
+    "compare_calls": 0,
+    "where_calls": 0,
+    "descriptor_cache_hits": 0,
+    "descriptor_cache_misses": 0,
+    "descriptor_rejections": 0,
+    "explicit_host_fallbacks": 0,
+}
+
+
+def position_control_native_stats() -> Mapping[str, int]:
+    """Snapshot the native position-control plane counters (diagnostics)."""
+
+    return dict(_POSITION_CONTROL_NATIVE_STATS)
+
+
+def reset_position_control_native_stats() -> None:
+    """Zero the native position-control plane counters (tests only)."""
+
+    for key in _POSITION_CONTROL_NATIVE_STATS:
+        _POSITION_CONTROL_NATIVE_STATS[key] = 0
+
+
+def _position_control_arrays(contract: Mapping[str, Any]):
+    """Return the cached ctypes argument arrays for one descriptor digest."""
+
+    digest = contract.get("descriptor_digest")
+    if not isinstance(digest, str) or not digest:
+        raise CpuAvx2ArtifactError("AVX2 position-control descriptor digest is missing")
+    with _POSITION_CONTROL_DESCRIPTOR_CACHE_LOCK:
+        cached = _POSITION_CONTROL_DESCRIPTOR_CACHE.get(digest)
+        if cached is not None:
+            _POSITION_CONTROL_NATIVE_STATS["descriptor_cache_hits"] += 1
+            return cached
+        rank = int(contract["rank"])
+        if rank < 0 or rank > POSITION_CONTROL_MAX_RANK:
+            raise CpuAvx2ExecutionError(
+                "AVX2 position-control rank {} is outside the descriptor domain".format(rank)
+            )
+        kind = contract["kind"]
+        if kind == "iota":
+            arrays = ()
+        elif kind == "compare":
+            arrays = (
+                (ctypes.c_int64 * rank)(*[int(value) for value in contract["left_strides"]]),
+                (ctypes.c_int64 * rank)(*[int(value) for value in contract["right_strides"]]),
+                (ctypes.c_size_t * rank)(*[int(value) for value in contract["output_shape"]]),
+            )
+        elif kind == "where":
+            arrays = (
+                (ctypes.c_int64 * rank)(
+                    *[int(value) for value in contract["condition_strides"]]
+                ),
+                (ctypes.c_int64 * rank)(*[int(value) for value in contract["true_strides"]]),
+                (ctypes.c_int64 * rank)(*[int(value) for value in contract["false_strides"]]),
+                (ctypes.c_size_t * rank)(*[int(value) for value in contract["output_shape"]]),
+            )
+        else:
+            raise CpuAvx2ArtifactError(
+                "unsupported AVX2 position-control descriptor kind {!r}".format(kind)
+            )
+        if len(_POSITION_CONTROL_DESCRIPTOR_CACHE) >= _POSITION_CONTROL_DESCRIPTOR_CACHE_LIMIT:
+            _POSITION_CONTROL_DESCRIPTOR_CACHE.pop(
+                next(iter(_POSITION_CONTROL_DESCRIPTOR_CACHE))
+            )
+        _POSITION_CONTROL_DESCRIPTOR_CACHE[digest] = arrays
+        _POSITION_CONTROL_NATIVE_STATS["descriptor_cache_misses"] += 1
+        return arrays
+
+
+def _call_position_control(
+    module: Any,
+    contract: Mapping[str, Any],
+    inputs: Sequence[_NativeBuffer],
+    destination: _NativeBuffer,
+) -> int:
+    """Invoke the declared position-control kernel and return its status."""
+
+    kind = contract["kind"]
+    arrays = _position_control_arrays(contract)
+    if kind == "iota":
+        dtype = canonical_dtype(contract["dtype"])
+        function = _status_symbol(
+            module,
+            "ptx_avx2_{}".format(contract["kernel"]),
+            [
+                _pointer(dtype),
+                ctypes.c_int64,
+                ctypes.c_int64,
+                ctypes.c_size_t,
+                ctypes.c_size_t,
+                ctypes.c_size_t,
+            ],
+        )
+        return function(
+            destination.pointer,
+            int(contract["start"]),
+            int(contract["step"]),
+            destination.count,
+            int(contract["inner_stride"]),
+            int(contract["dimension"]),
+        )
+    if kind == "compare":
+        dtype = canonical_dtype(contract["dtype"])
+        left_strides, right_strides, output_shape = arrays
+        function = _status_symbol(
+            module,
+            "ptx_avx2_{}".format(contract["kernel"]),
+            [
+                _pointer(dtype),
+                _pointer(dtype),
+                _pointer("bool"),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.POINTER(ctypes.c_size_t),
+                ctypes.c_size_t,
+                ctypes.c_size_t,
+                ctypes.c_uint32,
+            ],
+        )
+        return function(
+            inputs[0].pointer,
+            inputs[1].pointer,
+            destination.pointer,
+            left_strides,
+            right_strides,
+            output_shape,
+            int(contract["rank"]),
+            destination.count,
+            int(contract["predicate_code"]),
+        )
+    if kind == "where":
+        dtype = canonical_dtype(contract["dtype"])
+        (
+            condition_strides,
+            true_strides,
+            false_strides,
+            output_shape,
+        ) = arrays
+        function = _status_symbol(
+            module,
+            "ptx_avx2_{}".format(contract["kernel"]),
+            [
+                _pointer("bool"),
+                _pointer(dtype),
+                _pointer(dtype),
+                _pointer(dtype),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.POINTER(ctypes.c_size_t),
+                ctypes.c_size_t,
+                ctypes.c_size_t,
+            ],
+        )
+        return function(
+            inputs[0].pointer,
+            inputs[1].pointer,
+            inputs[2].pointer,
+            destination.pointer,
+            condition_strides,
+            true_strides,
+            false_strides,
+            output_shape,
+            int(contract["rank"]),
+            destination.count,
+        )
+    raise CpuAvx2ArtifactError(
+        "unsupported AVX2 position-control kind {!r}".format(kind)
+    )
+
