+def test_single_byte_tampering_of_the_native_object_fails_closed(tmp_path):
+    program = _iota_program("int64", (3,), 0, 1, 2)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "tamper")
+    tampered_dir = tmp_path / "tampered"
+    tampered_dir.mkdir()
+    tampered_path = tampered_dir / Path(artifact.path).name
+    native_bytes = bytearray(Path(artifact.path).read_bytes())
+    # Flip one bit inside the executable body.
+    native_bytes[len(native_bytes) // 2] ^= 0x01
+    tampered_path.write_bytes(bytes(native_bytes))
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(tampered_path),
+        metadata=dict(artifact.metadata),
+    )
+    with pytest.raises(CpuAvx2ArtifactError, match="digest"):
+        _runtime().load(tampered)
+
+
+def test_descriptor_digest_and_fallback_list_are_self_verifying(tmp_path):
+    """A tampered descriptor digest is rejected at load (shared predicate)."""
+
+    runtime = _runtime()
+    program = _iota_program("int64", (3,), 0, 1, 2)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "digest-tamper")
+    metadata = _plain_json(artifact.metadata)
+    entries = [dict(entry) for entry in metadata["native_position_control_operations"]]
+    digest = entries[0]["descriptor_digest"]
+    entries[0]["descriptor_digest"] = digest[:-1] + ("0" if digest[-1] != "0" else "1")
+    metadata["native_position_control_operations"] = entries
+    object.__setattr__(artifact, "metadata", metadata)
+    with pytest.raises(CpuAvx2ArtifactError, match="native_position_control_operations"):
+        runtime.load(artifact)
+
+
+def test_payload_version_participates_in_the_artifact_cache_key(tmp_path):
+    program = _iota_program("int32", (2,), 0, 0, 1)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "cache-key")
+    current_key = artifact.cache_key
+    metadata = dict(artifact.metadata)
+    metadata["artifact_payload_version"] = 6
+    object.__setattr__(artifact, "metadata", metadata)
+    assert artifact.cache_key != current_key
+
