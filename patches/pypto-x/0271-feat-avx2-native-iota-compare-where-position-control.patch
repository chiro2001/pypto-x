+def test_where_simd_contiguous_path_and_scalar_operands(tmp_path):
+    """Equal-shape f32 where takes the AVX2 blend path; scalar branches work."""
+
+    bits = [
+        0x7F800001, 0xFF800001, 0x80000000, 0x00000000,
+        0x00000001, 0x7F7FFFFF, 0xBF800000, 0x3F800000,
+        0x7FC00001, 0x7F800000, 0xFF800000, 0x40000000,
