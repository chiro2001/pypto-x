+def test_declared_kernel_is_the_dispatched_kernel_spy(tmp_path, monkeypatch):
+    runtime = _runtime()
+    calls = []
+    original = avx2_runtime._call_position_control
+
+    def spy(module, contract, inputs, destination):
+        calls.append(
+            (
+                contract["kind"],
+                contract["kernel"],
+                int(contract["output_elements"]),
+                destination.count,
+            )
+        )
+        return original(module, contract, inputs, destination)
+
+    monkeypatch.setattr(avx2_runtime, "_call_position_control", spy)
+    program = _iota_program("int64", (2, 3), 1, 4, -1)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "spy-iota")
+    output = HostTensor.zeros("int64", (2, 3))
+    runtime.launch(LaunchRequest(artifact, inputs=[], outputs=[output.descriptor()]))
+    declared = [entry["kernel"] for entry in artifact.metadata["native_position_control_operations"]]
+    assert [call[1] for call in calls] == declared == ["iota_i64"]
+    assert calls[0][2] == calls[0][3] == 6
+
+    compare = _compare_matrix_program("f32".replace("f32", "float32"), 3, ("le",))
+    _target_ir, artifact = _compile_avx2(compare, tmp_path, "spy-compare")
+    left = HostTensor("float32", (3, 1), [0.0, 1.0, 2.0])
+    right = HostTensor("float32", (1, 3), [2.0, 1.0, 0.0])
+    output = HostTensor.zeros("bool", (3, 3))
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[left.descriptor(readonly=True), right.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+    )
+    declared = [entry["kernel"] for entry in artifact.metadata["native_position_control_operations"]]
+    assert [call[1] for call in calls[1:]] == declared == ["compare_f32"]
+    assert output.flat() == (True, True, True, True, True, False, True, False, False)
+
+    where = _where_program(
+        "bf16", _tensor("bool", (3,)), _tensor("bf16", (3,)), _tensor("bf16", (3,)), _tensor("bf16", (3,))
+    )
+    _target_ir, artifact = _compile_avx2(where, tmp_path, "spy-where")
+    condition = HostTensor("bool", (3,), [True, False, True])
+    true_value = HostTensor("bf16", (3,), [1.0, 2.0, 3.0])
+    false_value = HostTensor("bf16", (3,), [4.0, 5.0, 6.0])
+    output = HostTensor.zeros("bf16", (3,))
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[
+                condition.descriptor(readonly=True),
+                true_value.descriptor(readonly=True),
+                false_value.descriptor(readonly=True),
+            ],
+            outputs=[output.descriptor()],
+        )
+    )
+    declared = [entry["kernel"] for entry in artifact.metadata["native_position_control_operations"]]
+    assert [call[1] for call in calls[2:]] == declared == ["where_bf16"]
+    assert output.flat() == (1.0, 5.0, 3.0)
