+    def _execute_position_control(
+        self,
+        contract: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        inputs: Sequence[_RuntimeValue],
+        module: Any,
+    ) -> Mapping[str, _RuntimeValue]:
+        """Run one native AVX2 iota/compare/where descriptor.
+
+        The contract comes from :func:`position_control_native_contract`, the
+        same predicate that produced the artifact metadata, and the load path
+        re-validates the whole execution table.  A native position-control
+        artifact can therefore never silently fall back here, and a fallback
+        artifact never declares this mode.  The condition/selected buffers
+        stay raw: the kernel walks the descriptor and writes the destination
+        directly, so no per-element Python list is materialized.
+        """
+
+        if contract.get("mode") != POSITION_CONTROL_MODE:
+            raise CpuAvx2ArtifactError(
+                "unsupported AVX2 position-control mode {!r}".format(contract.get("mode"))
+            )
+        self_check = dict(contract)
+        advertised = self_check.pop("descriptor_digest", None)
+        if advertised != _position_control_descriptor_digest(self_check):
+            _POSITION_CONTROL_NATIVE_STATS["descriptor_rejections"] += 1
+            raise CpuAvx2ArtifactError("AVX2 position-control descriptor digest mismatch")
+        kind = contract.get("kind")
+        outputs = list(operation.outputs)
+        if len(outputs) != 1:
+            raise CpuAvx2ArtifactError(
+                "AVX2 native position control requires exactly one output"
+            )
+        output_ref = outputs[0]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        if kind == "iota":
+            if inputs:
+                raise CpuAvx2ArtifactError("AVX2 native iota takes no tensor inputs")
+            if dtype != contract.get("dtype"):
+                raise CpuAvx2ArtifactError(
+                    "AVX2 native iota output dtype disagrees with the contract"
+                )
+            count = int(contract["output_elements"])
+            if count != int(plan.element_count):
+                raise CpuAvx2ArtifactError(
+                    "AVX2 native iota output count disagrees with the plan"
+                )
+            destination = _buffer_alloc(dtype, count, output_ref.name)
+            status = _call_position_control(module, contract, (), destination)
+            if status != 0:
+                _POSITION_CONTROL_NATIVE_STATS["descriptor_rejections"] += 1
+                raise CpuAvx2ExecutionError(
+                    "AVX2 native iota kernel rejected the descriptor (status {})".format(status)
+                )
+            _POSITION_CONTROL_NATIVE_STATS["iota_calls"] += 1
+        elif kind == "compare":
+            if len(inputs) != 2:
+                raise CpuAvx2ArtifactError("AVX2 native compare requires two inputs")
+            for label, value, expected in (
+                ("left", inputs[0], int(contract["left_elements"])),
+                ("right", inputs[1], int(contract["right_elements"])),
+            ):
+                if (
+                    canonical_dtype(value.type.dtype) != contract.get("dtype")
+                    or value.buffer.dtype != contract.get("dtype")
+                ):
+                    raise CpuAvx2ArtifactError(
+                        "AVX2 native compare {} dtype disagrees with the contract".format(label)
+                    )
+                if value.buffer.count != expected:
+                    raise CpuAvx2ExecutionError(
+                        "AVX2 native compare {} element count does not match the descriptor".format(
+                            label
+                        )
+                    )
+            if dtype != "bool":
+                raise CpuAvx2ArtifactError("AVX2 native compare output must be bool")
+            count = int(contract["output_elements"])
+            if count != int(plan.element_count):
+                raise CpuAvx2ArtifactError(
+                    "AVX2 native compare output count disagrees with the plan"
+                )
+            destination = _buffer_alloc("bool", count, output_ref.name)
+            status = _call_position_control(
+                module, contract, (inputs[0].buffer, inputs[1].buffer), destination
+            )
+            if status != 0:
+                _POSITION_CONTROL_NATIVE_STATS["descriptor_rejections"] += 1
+                raise CpuAvx2ExecutionError(
+                    "AVX2 native compare kernel rejected the descriptor (status {})".format(status)
+                )
+            _POSITION_CONTROL_NATIVE_STATS["compare_calls"] += 1
+        elif kind == "where":
+            if len(inputs) != 3:
+                raise CpuAvx2ArtifactError("AVX2 native where requires three inputs")
+            if (
+                canonical_dtype(inputs[0].type.dtype) != "bool"
+                or inputs[0].buffer.dtype != "bool"
+            ):
+                raise CpuAvx2ArtifactError(
+                    "AVX2 native where condition must be a bool buffer"
+                )
+            if inputs[0].buffer.count != int(contract["condition_elements"]):
+                raise CpuAvx2ExecutionError(
+                    "AVX2 native where condition element count does not match the descriptor"
+                )
+            for label, value, expected in (
+                ("input", inputs[1], int(contract["true_elements"])),
+                ("other", inputs[2], int(contract["false_elements"])),
+            ):
+                if (
+                    canonical_dtype(value.type.dtype) != contract.get("dtype")
+                    or value.buffer.dtype != contract.get("dtype")
+                ):
+                    raise CpuAvx2ArtifactError(
+                        "AVX2 native where {} dtype disagrees with the contract".format(label)
+                    )
+                if value.buffer.count != expected:
+                    raise CpuAvx2ExecutionError(
+                        "AVX2 native where {} element count does not match the descriptor".format(
+                            label
+                        )
+                    )
+            if dtype != contract.get("dtype"):
+                raise CpuAvx2ArtifactError(
+                    "AVX2 native where output dtype disagrees with the contract"
+                )
+            count = int(contract["output_elements"])
+            if count != int(plan.element_count):
+                raise CpuAvx2ArtifactError(
+                    "AVX2 native where output count disagrees with the plan"
+                )
+            destination = _buffer_alloc(dtype, count, output_ref.name)
+            status = _call_position_control(
+                module,
+                contract,
+                (inputs[0].buffer, inputs[1].buffer, inputs[2].buffer),
+                destination,
+            )
+            if status != 0:
+                _POSITION_CONTROL_NATIVE_STATS["descriptor_rejections"] += 1
+                raise CpuAvx2ExecutionError(
+                    "AVX2 native where kernel rejected the descriptor (status {})".format(status)
+                )
+            _POSITION_CONTROL_NATIVE_STATS["where_calls"] += 1
+        else:
+            raise CpuAvx2ArtifactError(
+                "unsupported AVX2 position-control kind {!r}".format(kind)
+            )
+        _POSITION_CONTROL_NATIVE_STATS["kernel_calls"] += 1
+        return {output_ref.name: _RuntimeValue(output_ref.type, destination)}
+
