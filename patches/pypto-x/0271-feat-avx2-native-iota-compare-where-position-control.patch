+
+static int ptx_avx2_position_predicate(uint32_t predicate, int comparison) {
+    if (predicate == 0U) return comparison == 0; /* eq: false for NaN */
+    if (predicate == 1U) return comparison != 0; /* ne: true for NaN */
+    if (comparison > 1) return 0;                /* NaN fails ordered forms */
+    if (predicate == 2U) return comparison < 0;  /* lt */
+    if (predicate == 3U) return comparison <= 0; /* le */
+    if (predicate == 4U) return comparison > 0;  /* gt */
+    return comparison >= 0;                      /* ge */
