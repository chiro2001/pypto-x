+#!/usr/bin/env python3
+"""L0-style AVX2 position-control microbench (avx2-position-native).
+
+Protocol: ``docs/PERF_MEASUREMENT_PROTOCOL.zh-CN.md`` section 2 (L0).  The
+driver constructs Core IR programs directly (no graph traversal), compiles
+them with the tree's own ``Avx2Compiler`` and times ``Avx2Runtime.launch`` on
+caller-owned buffers.  Each case reports:
+
+* ``native_seconds``  -- median of ``R`` single-launch samples (the payload-7
+  native plane), plus min/p95/max/stdev/cv and the MAD outlier screen;
+* ``reference_seconds`` -- median of ``R`` runs of the same operation chain
+  through the vector-common host reference (``_reference_operation``), i.e.
+  the exact pre-payload-7 Python element path;
+* the runtime's native-plane counters (kernel calls vs explicit host
+  fallbacks) so "the Python per-element path was eliminated" is evidenced by
+  execution counts, not only by timings.
+
+This 12 vCPU KVM guest has no cpufreq control, so every absolute number is
+permanently **UNGATED**; the driver writes no thresholds and makes no speedup
+claims.  Heavy: run through ``scripts/resource/run_local_heavy.sh``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import math
+import os
+import statistics
+import struct
+import sys
+import time
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu.x86 import Avx2Runtime
+from pypto.backends.cpu.x86 import avx2 as avx2_runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35 import build_attention_subgraph, build_qwen35_position_control
+from pypto.target import TargetSpec
+
+
+AVX2_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    features=("avx", "avx2", "osxsave", "ymm"),
+    attributes={"lane_count": 8},
+)
+TASK = "avx2-position-native"
+EVIDENCE_KIND = "pypto-x.perf-evidence.avx2-position-native"
+
+
+def _tensor(dtype, shape):
+    return CoreType.tensor(dtype, tuple(shape))
+
+
+def _iota_program(dtype, shape, axis, start, step):
+    output = ValueRef("out", _tensor(dtype, shape))
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "iota",
+                (),
+                (output,),
+                Region((Operation("iota", (), (output,), {"axis": axis, "start": start, "step": step}),)),
+            ),
+        )
+    )
+
+
+def _compare_program(dtype, left_shape, right_shape, output_shape, predicate):
+    left = ValueRef("left", _tensor(dtype, left_shape))
+    right = ValueRef("right", _tensor(dtype, right_shape))
+    output = ValueRef("out", _tensor("bool", output_shape))
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "compare",
+                (left, right),
+                (output,),
+                Region((Operation(predicate, (left, right), (output,), {}),)),
+            ),
+        )
+    )
+
+
+def _where_program(dtype, condition_shape, true_shape, false_shape, output_shape):
+    condition = ValueRef("cond", _tensor("bool", condition_shape))
+    true_value = ValueRef("true", _tensor(dtype, true_shape))
+    false_value = ValueRef("false", _tensor(dtype, false_shape))
+    output = ValueRef("out", _tensor(dtype, output_shape))
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "where",
+                (condition, true_value, false_value),
+                (output,),
+                Region((Operation("where", (condition, true_value, false_value), (output,), {}),)),
+            ),
+        )
+    )
+
+
+def _pattern(dtype, count, seed=7):
+    if dtype == "bool":
+        return [1 if (index * 7 + seed) % 3 else 0 for index in range(count)]
+    if dtype.startswith("float"):
+        return [((index * 37 + seed) % 41 - 20) * 0.125 for index in range(count)]
+    # Integer inputs in this bench are gather/embedding indices (axis length 3).
+    return [(index * 7 + seed) % 3 for index in range(count)]
+
+
+def _cases():
+    cases = []
+    cases.append(
+        (
+            "iota_i64_2x1024",
+            _iota_program("int64", (2, 1024), 1, 4, 1),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "iota_i32_negstep_3x4064",
+            _iota_program("int32", (3, 4064), 1, 100000, -3),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "compare_f32_flat_4096",
+            _compare_program("float32", (4096,), (4096,), (4096,), "lt"),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "compare_f32_broadcast_128x128",
+            _compare_program("float32", (128, 1), (1, 128), (128, 128), "le"),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "compare_i8_broadcast_64x64",
+            _compare_program("int8", (64, 1), (1, 64), (64, 64), "eq"),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "where_f32_flat_4096",
+            _where_program("float32", (4096,), (4096,), (4096,), (4096,)),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "where_f32_broadcast_128x128",
+            _where_program("float32", (128, 1), (1, 128), (128, 1), (128, 128)),
+            [],
+        )
+    )
+    cases.append(
+        (
+            "where_bf16_broadcast_128x128",
+            _where_program("bf16", (128, 1), (1, 128), (128, 1), (128, 128)),
+            [],
+        )
+    )
+    for name, program in (
+        (
+            "qwen_position_decode_T1_past5",
+            build_qwen35_position_control(1, 1, past_length=5, index_dtype="int64"),
+        ),
+        (
+            "qwen_position_prefill_T5",
+            build_qwen35_position_control(1, 5, past_length=0, index_dtype="int64"),
+        ),
+        (
+            "qwen_attention_where_f32",
+            build_attention_subgraph((2, 10), (3, 9), (1, 3, 2, 5), 6, "float32", rotary_dim=6),
+        ),
+    ):
+        cases.append((name, program, []))
+    return cases
+
+
+_CTYPES = {
+    "float32": ctypes.c_float,
+    "bf16": ctypes.c_uint16,
+    "int8": ctypes.c_int8,
+    "uint8": ctypes.c_uint8,
+    "int16": ctypes.c_int16,
+    "int32": ctypes.c_int32,
+    "int64": ctypes.c_int64,
+    "bool": ctypes.c_bool,
+}
+
+
+def _raw_array(dtype, values):
+    ctype = _CTYPES[dtype]
+    if dtype == "float32":
+        array = (ctypes.c_uint32 * len(values))()
+        for index, value in enumerate(values):
+            ctypes.memmove(
+                ctypes.addressof(array) + 4 * index,
+                struct.pack("<I", int(value) & 0xFFFFFFFF),
+                4,
+            )
+        return array
+    if dtype == "bool":
+        return (ctypes.c_uint8 * len(values))(*[1 if value else 0 for value in values])
+    if dtype == "bf16":
+        def _bf16_bits(value):
+            bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+            if (bits & 0x7F800000) == 0x7F800000:
+                return (bits >> 16) & 0xFFFF
+            rounding = 0x7FFF + ((bits >> 16) & 1)
+            return ((bits + rounding) >> 16) & 0xFFFF
+
+        return (ctype * len(values))(*[_bf16_bits(value) for value in values])
+    return (ctype * len(values))(*[int(value) for value in values])
+
+
+def _descriptor(dtype, shape, array, readonly=False):
+    if ctypes.sizeof(array):
+        return TensorDesc(
+            dtype, shape, device="cpu", address=ctypes.addressof(array), readonly=readonly
+        )
+    return TensorDesc(dtype, shape, device="cpu", handle=array, readonly=readonly)
+
+
+def _build_inputs(program):
+    arrays = []
+    descriptors = []
+    scalars = {}
+    for parameter in program.functions[0].parameters:
+        if parameter.type.kind == "scalar":
+            scalars[parameter.name] = -10000.0
+            continue
+        shape = tuple(int(dimension) for dimension in parameter.type.shape)
+        count = math.prod(shape) if shape else 1
+        dtype = parameter.type.dtype
+        array = _raw_array(dtype, _pattern(dtype, count))
+        arrays.append(array)
+        descriptors.append(_descriptor(dtype, shape, array, readonly=True))
+    return arrays, descriptors, scalars
+
+
+def _outputs(program):
+    arrays = []
+    descriptors = []
+    for ref in program.functions[0].returns:
+        if ref.type.kind != "tensor":
+            continue
+        shape = tuple(int(dimension) for dimension in ref.type.shape)
+        count = math.prod(shape) if shape else 1
+        array = _raw_array(ref.type.dtype, [0] * count)
+        arrays.append(array)
+        descriptors.append(_descriptor(ref.type.dtype, shape, array))
+    return arrays, descriptors
+
+
+def _stats(samples, mad_floor_seconds=1.0e-6):
+    median = statistics.median(samples)
+    deviations = [abs(value - median) for value in samples]
+    mad = statistics.median(deviations)
+    threshold = max(3.0 * 1.4826 * mad, mad_floor_seconds, 0.02 * median)
+    outliers = [value for value in deviations if value > threshold]
+    ordered = sorted(samples)
+    p95_index = min(len(ordered) - 1, max(0, math.ceil(0.95 * len(ordered)) - 1))
+    mean = statistics.fmean(samples)
+    stdev = statistics.stdev(samples) if len(samples) > 1 else 0.0
+    return {
+        "samples": [round(value, 9) for value in samples],
+        "min": min(samples),
+        "median": median,
+        "p95": ordered[p95_index],
+        "max": max(samples),
+        "mean": mean,
+        "stdev": stdev,
+        "cv": (stdev / mean) if mean else 0.0,
+        "outlier_ratio": len(outliers) / len(samples),
+    }
+
+
+def _reference_seconds(program, target_ir, input_arrays, scalars, rounds):
+    """Median seconds of the vector-common host reference chain."""
+
+    function = program.functions[0]
+    buffers = {}
+    for parameter in function.parameters:
+        if parameter.type.kind == "scalar":
+            buffers[parameter.name] = avx2_runtime._buffer_from_values(
+                parameter.type.dtype, [scalars[parameter.name]], parameter.name
+            )
+    tensor_parameters = [ref for ref in function.parameters if ref.type.kind != "scalar"]
+    for parameter, array in zip(tensor_parameters, input_arrays):
+        shape = tuple(int(dimension) for dimension in parameter.type.shape)
+        count = math.prod(shape) if shape else 1
+        pointer = ctypes.cast(
+            ctypes.addressof(array), avx2_runtime._pointer(parameter.type.dtype)
+        )
+        buffers[parameter.name] = avx2_runtime._NativeBuffer(
+            parameter.type.dtype, count, pointer, array, True
+        )
+    samples = []
+    for _ in range(rounds):
+        environment = {
+            parameter.name: avx2_runtime._RuntimeValue(parameter.type, buffers[parameter.name])
+            for parameter in function.parameters
+        }
+        started = time.perf_counter()
+        for operation, plan in zip(function.body.operations, target_ir.plans):
+            values = [environment[ref.name] for ref in operation.inputs]
+            environment.update(
+                avx2_runtime._reference_operation(operation, plan, values, "perf-reference")
+            )
+        samples.append(time.perf_counter() - started)
+    return _stats(samples)
+
+
+def _replicate(program, count):
+    """Return a program with ``count`` identical copies of a one-op function."""
+
+    function = program.functions[0]
+    source = function.body.operations[0]
+    operations = []
+    returns = []
+    for index in range(count):
+        outputs = tuple(
+            ValueRef("{}_{}".format(ref.name, index), ref.type) for ref in source.outputs
+        )
+        returns.extend(outputs)
+        operations.append(
+            Operation(source.name, tuple(function.parameters), outputs, dict(source.attributes))
+        )
+    return CoreProgram(
+        functions=(
+            CoreFunction(function.name, tuple(function.parameters), tuple(returns), Region(tuple(operations))),
+        )
+    )
+
+
+def run_case(name, program, build_root, rounds, warmup):
+    compiler = Avx2Compiler()
+    target_ir = compiler.lower(program, AVX2_TARGET)
+    build_dir = os.path.join(build_root, name)
+    os.makedirs(build_dir, exist_ok=True)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2", extra={"build_dir": build_dir}
+        ),
+    )
+    input_arrays, input_descriptors, scalars = _build_inputs(program)
+    output_arrays, output_descriptors = _outputs(program)
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        raise RuntimeError("AVX2 is unavailable on this host")
+    request = LaunchRequest(
+        artifact,
+        inputs=input_descriptors,
+        outputs=output_descriptors,
+        scalars=scalars,
+    )
+    for _ in range(warmup):
+        runtime.launch(request)
+    avx2_runtime.reset_position_control_native_stats()
+    samples = []
+    for _ in range(rounds):
+        started = time.perf_counter()
+        runtime.launch(request)
+        samples.append(time.perf_counter() - started)
+    native_stats = dict(avx2_runtime.position_control_native_stats())
+    native = _stats(samples)
+    reference = _reference_seconds(program, target_ir, input_arrays, scalars, rounds)
+    load_samples = []
+    for _ in range(rounds):
+        started = time.perf_counter()
+        runtime.load(artifact)
+        load_samples.append(time.perf_counter() - started)
+    load_seconds = _stats(load_samples)
+
+    # L0 difference method (protocol section 2): a replicated R-op program
+    # amortizes the artifact decode/validation and dispatch overhead.
+    replicate = None
+    if len(target_ir.plans) == 1:
+        replicate_count = rounds
+        replicated = _replicate(program, replicate_count)
+        replicate_ir = compiler.lower(replicated, AVX2_TARGET)
+        replicate_dir = os.path.join(build_root, name + "__replicate")
+        os.makedirs(replicate_dir, exist_ok=True)
+        replicate_artifact = compiler.compile(
+            replicate_ir,
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx2", extra={"build_dir": replicate_dir}
+            ),
+        )
+        replicate_inputs, replicate_input_descriptors, replicate_scalars = _build_inputs(
+            replicated
+        )
+        _replicate_output_arrays, replicate_output_descriptors = _outputs(replicated)
+        replicate_request = LaunchRequest(
+            replicate_artifact,
+            inputs=replicate_input_descriptors,
+            outputs=replicate_output_descriptors,
+            scalars=replicate_scalars,
+        )
+        for _ in range(warmup):
+            runtime.launch(replicate_request)
+        replicate_samples = []
+        for _ in range(rounds):
+            started = time.perf_counter()
+            runtime.launch(replicate_request)
+            replicate_samples.append(time.perf_counter() - started)
+        replicate_stats = _stats(replicate_samples)
+        kernel_seconds = replicate_stats["median"] / replicate_count
+        dispatch_seconds = max(0.0, native["median"] - kernel_seconds)
+        replicate = {
+            "replicate_count": replicate_count,
+            "replicated_launch_seconds": replicate_stats,
+            "kernel_seconds": kernel_seconds,
+            "dispatch_seconds_estimate": dispatch_seconds,
+        }
+
+    metadata = dict(artifact.metadata)
+    return {
+        "name": name,
+        "operations": len(target_ir.plans),
+        "native_seconds": native,
+        "reference_seconds": reference,
+        "load_seconds": load_seconds,
+        "ratio_reference_over_native": (
+            reference["median"] / native["median"] if native["median"] else None
+        ),
+        "replicate": replicate,
+        "ratio_reference_over_kernel": (
+            reference["median"] / replicate["kernel_seconds"]
+            if replicate and replicate["kernel_seconds"]
+            else None
+        ),
+        "native_plane_stats": native_stats,
+        "position_control_fallback": metadata.get("position_control_fallback"),
+        "native_position_control_entries": len(
+            metadata.get("native_position_control_operations", ())
+        ),
+        "native_position_control_fallbacks": len(
+            metadata.get("native_position_control_fallback_operations", ())
+        ),
+        "artifact_native_digest": metadata.get("native_digest"),
+        "artifact_payload_version": metadata.get("artifact_payload_version"),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--work-dir", required=True)
+    parser.add_argument("--rounds", type=int, default=21)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--cases", default="")
+    args = parser.parse_args()
+    selected = {item for item in args.cases.split(",") if item}
+    results = []
+    for name, program, _ignored in _cases():
+        if selected and name not in selected:
+            continue
+        results.append(run_case(name, program, args.work_dir, args.rounds, args.warmup))
+    payload = {
+        "task": TASK,
+        "evidence_kind": EVIDENCE_KIND,
+        "gated": False,
+        "gating_note": "UNGATED: 12 vCPU KVM guest, no cpufreq control",
+        "python": sys.version.split()[0],
+        "rounds": args.rounds,
+        "warmup": args.warmup,
+        "host": {"online_cpus": os.cpu_count()},
+        "cases": results,
+    }
+    with open(args.out, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, indent=1, sort_keys=True)
+        handle.write("\n")
+    print("wrote {} cases to {}".format(len(results), args.out))
+
+
+if __name__ == "__main__":
+    main()
