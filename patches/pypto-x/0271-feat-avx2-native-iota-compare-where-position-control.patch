+# ---------------------------------------------------------------------------
+# Qwen3.5 corpus: native coverage and zero drift
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "steps,past_length,index_dtype",
+    ((1, 5, "int64"), (5, 0, "int64"), (1, 5, "int32"), (5, 0, "int32")),
+)
+def test_qwen35_position_control_graph_is_fully_native_and_bit_exact(
+    steps, past_length, index_dtype, tmp_path
+):
+    from pypto.portable.qwen35 import build_qwen35_position_control
+
+    program = build_qwen35_position_control(
+        1, steps, past_length=past_length, index_dtype=index_dtype
+    )
+    _target_ir, artifact = _compile_avx2(
+        program, tmp_path, "qwen-pos-{}-{}-{}".format(index_dtype, steps, past_length)
+    )
+    assert tuple(artifact.metadata["position_control_operations"]) == (
+        "iota",
+        "iota",
+        "iota",
+        "compare",
+    )
+    entries = _assert_native_metadata(artifact, ("iota", "compare"))
+    assert sorted(entry["kind"] for entry in entries) == ["compare", "iota", "iota", "iota"]
+    assert tuple(artifact.metadata["host_reference_operations"]) == ()
+
+    mask_shape = (1, 8, steps, past_length + steps)
+    position_shape = (1, steps)
+    scalar_artifact = _compile_scalar(program)
+    native_outputs = [
+        HostTensor.zeros(index_dtype, position_shape),
+        HostTensor.zeros("bool", mask_shape),
+    ]
+    scalar_outputs = [
+        HostTensor.zeros(index_dtype, position_shape),
+        HostTensor.zeros("bool", mask_shape),
+    ]
+    _runtime().launch(
+        LaunchRequest(artifact, inputs=[], outputs=[item.descriptor() for item in native_outputs])
+    )
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            scalar_artifact, inputs=[], outputs=[item.descriptor() for item in scalar_outputs]
+        )
+    )
+    assert native_outputs[0].flat() == scalar_outputs[0].flat()
+    assert native_outputs[1].flat() == scalar_outputs[1].flat()
+    # Independent reference on identical raw bits (the pre-payload-7 path).
+    target_ir, _artifact = _compile_avx2(
+        program, tmp_path, "qwen-pos-ref-{}-{}-{}".format(index_dtype, steps, past_length)
+    )
+    environment = _reference_environment(program, target_ir, [], "qwen-position")
+    reference = [
+        _buffer_bytes(environment[ref.name].buffer) for ref in program.functions[0].returns
+    ]
+    native_bytes = []
+    for ref, output in zip(program.functions[0].returns, native_outputs):
+        dtype = ref.type.dtype
+        bits = []
+        for value in output.flat():
+            if dtype == "bool":
+                bits.append(1 if value else 0)
+            else:
+                bits.append(int(value))
+        array, _pointer = _raw_array(dtype, bits)
+        native_bytes.append(_array_bytes(dtype, array))
+    _assert_bitwise(native_bytes, reference)
+
+
+def test_qwen35_attention_where_is_native_and_bit_exact(tmp_path):
+    from pypto.portable.qwen35 import build_attention_subgraph
+
+    program = build_attention_subgraph(
+        (2, 10), (3, 9), (1, 3, 2, 5), 6, "float32", rotary_dim=6
+    )
+    target_ir, artifact = _compile_avx2(program, tmp_path, "attention")
+    kinds = {
+        entry["kind"] for entry in artifact.metadata["native_position_control_operations"]
+    }
+    assert "where" in kinds
+    assert artifact.metadata["position_control_fallback"] == "native"
+    assert tuple(artifact.metadata["native_position_control_fallback_operations"]) == ()
+    assert tuple(artifact.metadata["host_preexpanded_operations"]) == ()
+
+    q = HostTensor("float32", (2, 10), [((index * 3) % 17 - 8) * 0.1 for index in range(20)])
+    cos = HostTensor("float32", (2, 6), [0.5] * 12)
+    sin = HostTensor("float32", (2, 6), [0.25] * 12)
+    logits = HostTensor("float32", (3, 9), [((index * 5) % 19 - 9) * 0.15 for index in range(27)])
+    mask = HostTensor("bool", (3, 9), [column <= row + 1 for row in range(3) for column in range(9)])
+    kv = HostTensor("float32", (1, 3, 2, 5), [index * 0.1 - 1.0 for index in range(30)])
+    indices = HostTensor("int64", (6,), [0, 0, 1, 1, 2, 2])
+    tensors = [q, cos, sin, logits, mask, kv, indices]
+    output_specs = [
+        ("float32", (2, 10)),
+        ("float32", (3, 9)),
+        ("float32", (1, 6, 2, 5)),
+    ]
+    outputs = []
+    for dtype, shape in output_specs:
+        array, _pointer = _raw_array(dtype, [0] * element_count(shape))
+        outputs.append((dtype, shape, array))
+    _runtime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in tensors],
+            outputs=[_descriptor(dtype, shape, array) for dtype, shape, array in outputs],
+            scalars={"fill_value": -10000.0},
+        )
+    )
+    native = [_array_bytes(dtype, array) for dtype, _shape, array in outputs]
+
+    # Zero-drift oracle: the same program on the same values through the AVX2
+    # vector-common host reference (the exact pre-payload-7 execution path).
+    by_name = {
+        "q": q,
+        "cos": cos,
+        "sin": sin,
+        "logits": logits,
+        "causal_mask": mask,
+        "kv": kv,
+        "head_indices": indices,
+    }
+    buffers = []
+    for parameter in program.functions[0].parameters:
+        if parameter.type.kind == "scalar":
+            buffers.append(
+                avx2_runtime._buffer_from_values(
+                    parameter.type.dtype, [-10000.0], parameter.name
+                )
+            )
+        else:
+            host = by_name[parameter.name]
+            buffers.append(
+                avx2_runtime._buffer_from_values(
+                    parameter.type.dtype, list(host.data), parameter.name
+                )
+            )
+    environment = _reference_environment(program, target_ir, buffers, "attention")
+    reference = [
+        _buffer_bytes(environment[ref.name].buffer) for ref in program.functions[0].returns
+    ]
+    _assert_bitwise(native, reference)
+    # The masked positions are filled with the scalar fill value and then
+    # exponentiated by the softmax, so they underflow to exactly 0.0.
+    softmax = struct.unpack("<{}f".format(27), native[1])
+    assert softmax[0] > 0.0
+    assert softmax[2] == 0.0
+    assert abs(sum(softmax[0:3]) - 1.0) < 1e-5
+
+
+def test_native_path_eliminates_the_host_per_element_fallback(tmp_path, monkeypatch):
+    """Counters + a reference spy prove the Python element path is not taken."""
+
+    avx2_runtime.reset_position_control_native_stats()
+    reference_calls = []
+    original_reference = avx2_runtime._reference_operation
+
+    def spy(operation, plan, inputs, context):
+        reference_calls.append(context)
+        return original_reference(operation, plan, inputs, context)
+
+    monkeypatch.setattr(avx2_runtime, "_reference_operation", spy)
+    program = _iota_program("int64", (2, 3), 0, 4, -1)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "stats-iota")
+    output = HostTensor.zeros("int64", (2, 3))
+    _runtime().launch(LaunchRequest(artifact, inputs=[], outputs=[output.descriptor()]))
+    stats = avx2_runtime.position_control_native_stats()
+    assert stats["kernel_calls"] == 1
+    assert stats["iota_calls"] == 1
+    assert stats["explicit_host_fallbacks"] == 0
+    assert reference_calls == []
+
+    rank = POSITION_CONTROL_MAX_RANK + 1
+    shape = (1,) * (rank - 1) + (2,)
+    left = ValueRef("left", CoreType.tensor("int32", shape))
+    right = ValueRef("right", CoreType.tensor("int32", shape))
+    high_output = ValueRef("out", CoreType.tensor("bool", shape))
+    high_program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "high_rank",
+                (left, right),
+                (high_output,),
+                Region((Operation("lt", (left, right), (high_output,), {}),)),
+            ),
+        )
+    )
+    _target_ir, artifact = _compile_avx2(high_program, tmp_path, "stats-fallback")
+    left_tensor = HostTensor("int32", shape, [0] * element_count(shape))
+    right_tensor = HostTensor("int32", shape, [1] * element_count(shape))
+    result = HostTensor.zeros("bool", shape)
+    _runtime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[left_tensor.descriptor(readonly=True), right_tensor.descriptor(readonly=True)],
+            outputs=[result.descriptor()],
+        )
+    )
+    stats = avx2_runtime.position_control_native_stats()
+    assert stats["kernel_calls"] == 1  # unchanged by the fallback launch
+    assert stats["explicit_host_fallbacks"] == 1
+    assert len(reference_calls) == 1
+    assert result.flat()[0:2] == (True, True)
+
+
+def test_descriptor_cache_is_bounded_and_reused(tmp_path):
+    runtime = _runtime()
+    program = _iota_program("int32", (4,), 0, 0, 1)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "cache")
+    output = HostTensor.zeros("int32", (4,))
+    with avx2_runtime._POSITION_CONTROL_DESCRIPTOR_CACHE_LOCK:
+        avx2_runtime._POSITION_CONTROL_DESCRIPTOR_CACHE.clear()
+    avx2_runtime.reset_position_control_native_stats()
+    for _ in range(3):
+        runtime.launch(LaunchRequest(artifact, inputs=[], outputs=[output.descriptor()]))
+    stats = avx2_runtime.position_control_native_stats()
+    assert stats["descriptor_cache_misses"] == 1
+    assert stats["descriptor_cache_hits"] == 2
+    assert stats["kernel_calls"] == 3
