+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_where_snan_quieting_and_signed_zero_are_bit_exact(dtype, tmp_path):
+    """Only the selected branch is round-tripped; sNaN is quieted, -0 kept."""
+
+    if dtype == "float32":
+        sNaN, qNaN, neg_zero, pos_zero, inf = 0x7F800001, 0x7FC00001, 0x80000000, 0x00000000, 0x7F800000
+    else:
+        sNaN, qNaN, neg_zero, pos_zero, inf = 0x7F81, 0x7FC1, 0x8000, 0x0000, 0x7F80
+    true_bits = [sNaN, sNaN, qNaN, neg_zero, pos_zero, inf]
+    false_bits = [qNaN, sNaN, sNaN, pos_zero, neg_zero, inf]
+    condition = [1, 0, 1, 1, 1, 0]
+    program = _where_program(
+        dtype, _tensor("bool", (6,)), _tensor(dtype, (6,)), _tensor(dtype, (6,)), _tensor(dtype, (6,))
+    )
+    _target_ir, _artifact, native, reference = _differential(
+        program,
+        [("bool", (6,), condition), (dtype, (6,), true_bits), (dtype, (6,), false_bits)],
+        [(dtype, (6,), 6)],
+        tmp_path,
+        "where-snan-{}".format(dtype),
+    )
+    _assert_bitwise(native, reference)
+    quiet_bit = 0x00400000 if dtype == "float32" else 0x0040
+    assert native[0] == reference[0]
+    # Selected sNaN must have the quiet bit set; the unselected sNaN must not
+    # leak into the output.
+    if dtype == "float32":
+        selected = [struct.unpack("<I", native[0][4 * i:4 * i + 4])[0] for i in range(6)]
+    else:
+        selected = list(struct.unpack("<6H", native[0]))
+    assert selected[0] & quiet_bit
+    assert selected[1] & quiet_bit  # false branch held an sNaN too
+    assert selected[2] & quiet_bit  # the unselected branch is never touched
+    assert selected[3] == neg_zero
+    assert selected[4] == pos_zero
+    assert selected[5] == inf
+
