+def test_old_reader_gate_rejects_the_new_payload_and_abi_marker(tmp_path):
+    """Freeze the payload-6 reader gates this slice must fail closed against.
+
+    The baseline (393d28e0f) decoder is
+    ``if metadata.get("artifact_payload_version") != 6: raise`` plus
+    ``if native_abi != "pypto-x.cpu.avx2:7": raise``.  Both constants are
+    frozen here so a future reader/writer drift is caught.
+    """
+
+    baseline_payload_version = 6
+    baseline_abi_marker = "pypto-x.cpu.avx2:7"
+    program = _iota_program("int32", (2,), 0, 0, 1)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "old-reader")
+    assert artifact.metadata["artifact_payload_version"] != baseline_payload_version
+    assert NATIVE_ABI_MARKER != baseline_abi_marker
+    native_bytes = Path(artifact.path).read_bytes()
+    assert baseline_abi_marker.encode("ascii") not in native_bytes
+    # The old reader's gate rejects both the new payload number and the new
+    # object because the metadata can never be rewritten to the old pair.
+    assert not (artifact.metadata["artifact_payload_version"] == baseline_payload_version)
+    assert NATIVE_ABI_MARKER.encode("ascii") in native_bytes
+
