+#: narrowed to int32/int64 by :func:`iota_spec`; ``compare`` admits every
+#: admitted operands dtype (ordered bool stays rejected by the shared
+#: validator); ``where`` requires a bool condition and one common value dtype.
+POSITION_CONTROL_VALUE_DTYPES = (
+    "float32",
+    "bf16",
+    "int8",
+    "uint8",
+    "int16",
+    "uint16",
+    "int32",
+    "uint32",
+    "int64",
+    "uint64",
+)
+POSITION_CONTROL_DTYPE_SUFFIX = {
+    "float32": "f32",
+    "bf16": "bf16",
+    "bool": "bool",
+    "int8": "i8",
+    "uint8": "u8",
+    "int16": "i16",
+    "uint16": "u16",
+    "int32": "i32",
+    "uint32": "u32",
+    "int64": "i64",
+    "uint64": "u64",
