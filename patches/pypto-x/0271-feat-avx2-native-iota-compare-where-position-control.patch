+@pytest.mark.parametrize("operation_name", ("iota", "compare", "where"))
+def test_rank_above_the_native_maximum_falls_back_with_an_explicit_reason(
+    operation_name, tmp_path
+):
+    rank = POSITION_CONTROL_MAX_RANK + 1
+    shape = (1,) * (rank - 1) + (2,)
+    if operation_name == "iota":
+        program = _iota_program("int32", shape, rank - 1, 0, 1)
+        inputs = []
+        outputs = [("int32", shape, element_count(shape))]
+    elif operation_name == "compare":
+        left = ValueRef("left", CoreType.tensor("int32", shape))
+        right = ValueRef("right", CoreType.tensor("int32", shape))
+        output = ValueRef("out", CoreType.tensor("bool", shape))
+        operation = Operation("lt", (left, right), (output,), {})
+        program = CoreProgram(
+            functions=(CoreFunction("c", (left, right), (output,), Region((operation,))),)
+        )
+        inputs = [("int32", shape, [0] * element_count(shape)), ("int32", shape, [1] * element_count(shape))]
+        outputs = [("bool", shape, element_count(shape))]
+    else:
+        condition = ValueRef("cond", CoreType.tensor("bool", shape))
+        true_value = ValueRef("true", CoreType.tensor("int32", shape))
+        false_value = ValueRef("false", CoreType.tensor("int32", shape))
+        output = ValueRef("out", CoreType.tensor("int32", shape))
+        operation = Operation("where", (condition, true_value, false_value), (output,), {})
+        program = CoreProgram(
+            functions=(
+                CoreFunction("w", (condition, true_value, false_value), (output,), Region((operation,))),
+            )
+        )
+        inputs = [
+            ("bool", shape, [1] * element_count(shape)),
+            ("int32", shape, [0] * element_count(shape)),
+            ("int32", shape, [1] * element_count(shape)),
+        ]
+        outputs = [("int32", shape, element_count(shape))]
+
+    _target_ir, artifact, native, reference = _differential(
+        program, inputs, outputs, tmp_path, "fallback-{}".format(operation_name)
+    )
+    _assert_bitwise(native, reference)
+    metadata = artifact.metadata
+    assert metadata["position_control_fallback"] == "host_reference"
+    fallbacks = metadata["native_position_control_fallback_operations"]
+    assert len(fallbacks) == 1
+    fallback = dict(fallbacks[0])
+    assert fallback["operation"] == operation_name
+    assert fallback["reason"] == (
+        "{} rank {} exceeds the native AVX2 position-control max rank {}".format(
+            operation_name, rank, POSITION_CONTROL_MAX_RANK
+        )
+    )
+    assert tuple(metadata["native_position_control_operations"]) == ()
+    assert metadata["execution_modes"][0]["mode"] == "host_reference"
+    assert operation_name in tuple(metadata["host_reference_operations"])
