+def test_new_reader_rejects_the_old_host_reference_payload_shape(tmp_path):
+    """A payload-7 reader must fail closed on payload-6 style metadata."""
+
+    runtime = _runtime()
+    program = _iota_program("int64", (3,), 0, 1, 2)
+    _target_ir, artifact = _compile_avx2(program, tmp_path, "old-shape")
+    original = dict(artifact.metadata)
+
+    def tamper(label, mutate, match):
+        metadata = _plain_json(original)
+        mutate(metadata)
+        object.__setattr__(artifact, "metadata", metadata)
+        try:
+            with pytest.raises(CpuAvx2ArtifactError, match=match):
+                runtime.load(artifact)
+        finally:
+            object.__setattr__(artifact, "metadata", original)
+
+    # Payload 6 declared iota as host_reference and had no position-control key.
+    tamper(
+        "payload6",
+        lambda m: m.__setitem__("artifact_payload_version", 6),
+        "payload version",
+    )
+    tamper(
+        "old fallback declaration",
+        lambda m: m.__setitem__("position_control_fallback", "host_reference"),
+        "position_control_fallback",
+    )
+    tamper(
+        "missing native entries",
+        lambda m: m.__setitem__("native_position_control_operations", []),
+        "native_position_control_operations",
+    )
+    tamper(
+        "old pre-expansion",
+        lambda m: m.__setitem__("host_preexpanded_operations", ["where"]),
+        "host_preexpanded_operations",
+    )
+    tamper(
+        "old wire",
+        lambda m: m.__setitem__("position_control_descriptor_wire", "v5:pxio-pxcp-pxbd-pxwh+fnv1a64"),
+        "position_control_descriptor_wire",
