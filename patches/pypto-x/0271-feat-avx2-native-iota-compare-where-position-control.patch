+def test_metadata_declares_every_covered_operation_native(tmp_path):
+    # One program with all three operations in dependency order.
+    mask = ValueRef("mask", CoreType.tensor("bool", (2, 3)))
+    true_value = ValueRef("true", CoreType.tensor("int64", (2, 3)))
+    false_value = ValueRef("false", CoreType.tensor("int64", (2, 3)))
+    selected = ValueRef("selected", CoreType.tensor("int64", (2, 3)))
+    positions = ValueRef("positions", CoreType.tensor("int64", (2, 3)))
+    compared = ValueRef("compared", CoreType.tensor("bool", (2, 3)))
+    operations = (
+        Operation("iota", (), (positions,), {"axis": 1, "start": 3, "step": 2}),
+        Operation("where", (mask, true_value, false_value), (selected,), {}),
+        Operation("ge", (positions, selected), (compared,), {}),
+    )
+    program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "position",
+                (mask, true_value, false_value),
+                (positions, selected, compared),
+                Region(operations),
+            ),
+        )
+    )
+    target_ir, artifact = _compile_avx2(program, tmp_path, "mixed")
+    assert [plan.operation for plan in target_ir.plans] == ["iota", "where", "compare"]
+    assert tuple(artifact.metadata["position_control_operations"]) == (
+        "iota",
+        "where",
+        "compare",
+    )
+    entries = _assert_native_metadata(artifact, ("iota", "where", "compare"))
+    assert sorted(entry["kind"] for entry in entries) == ["compare", "iota", "where"]
+    assert tuple(artifact.metadata["host_reference_operations"]) == ()
