+def test_predicate_never_claims_an_uncovered_dtype_or_shape():
+    """Defense in depth: the shared predicate itself fails closed."""
+
+    def fake_operation(name, input_dtypes, input_shapes=None):
+        if input_shapes is None:
+            input_shapes = tuple((4,) for _ in input_dtypes)
+        return types.SimpleNamespace(
+            name=name,
+            inputs=tuple(
+                types.SimpleNamespace(
+                    type=types.SimpleNamespace(kind="tensor", dtype=dtype, shape=shape)
+                )
+                for dtype, shape in zip(input_dtypes, input_shapes)
+            ),
+            outputs=(
+                types.SimpleNamespace(
+                    type=types.SimpleNamespace(kind="tensor", dtype="bool", shape=(4,))
+                ),
+            ),
+            attributes={"predicate": "lt"},
+        )
+
+    plan = types.SimpleNamespace(operation="compare", dtype="bool", shape=(4,), element_count=4)
+    operation = fake_operation("lt", ("float16", "float16"))
+    assert position_control_native_contract(operation, plan) is None
+    assert position_control_native_fallback_reason(operation, plan) == (
+        "dtype float16 is not in the native AVX2 compare dtype set"
+    )
+
+    mixed = fake_operation("lt", ("float32", "bf16"))
+    assert position_control_native_contract(mixed, plan) is None
+    assert position_control_native_fallback_reason(mixed, plan) == (
+        "compare operands must share one dtype (float32 vs bf16)"
+    )
+
+    # A scalar plan (rank 0) is covered; a rank above the maximum is not.
+    scalar_plan = types.SimpleNamespace(
+        operation="compare", dtype="bool", shape=(), element_count=1
+    )
+    scalar_operation = fake_operation("lt", ("int32", "int32"), ((), ()))
+    contract = position_control_native_contract(scalar_operation, scalar_plan)
+    assert contract is not None and contract["rank"] == 0
+    assert contract["left_strides"] == [] and contract["right_strides"] == []
+
+    rank = POSITION_CONTROL_MAX_RANK + 1
+    high_plan = types.SimpleNamespace(
+        operation="compare", dtype="bool", shape=(1,) * rank, element_count=1
+    )
+    high_operation = fake_operation("lt", ("int32", "int32"), ((1,) * rank, (1,) * rank))
+    assert position_control_native_contract(high_operation, high_plan) is None
+    assert position_control_native_fallback_reason(high_operation, high_plan) == (
+        "compare rank {} exceeds the native AVX2 position-control max rank {}".format(
+            rank, POSITION_CONTROL_MAX_RANK
+        )
+    )
