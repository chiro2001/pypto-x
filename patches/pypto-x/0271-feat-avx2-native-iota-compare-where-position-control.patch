+@pytest.mark.parametrize("dtype", tuple(_WHERE_VALUE_BITS))
+def test_where_broadcast_and_select_are_bit_exact(dtype, tmp_path):
+    bits = list(_WHERE_VALUE_BITS[dtype])
+    n = len(bits)
+    condition_bits = [0, 1, 2, 255] * (n // 4 + 1)
+    condition_bits = condition_bits[:n]
+    # cond (n,1) x input (1,n) x other (n,1) -> output (n,n)
+    program = _where_program(
+        dtype,
+        _tensor("bool", (n, 1)),
+        _tensor(dtype, (1, n)),
+        _tensor(dtype, (n, 1)),
+        _tensor(dtype, (n, n)),
+    )
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [
+            ("bool", (n, 1), condition_bits),
+            (dtype, (1, n), bits),
+            (dtype, (n, 1), list(reversed(bits))),
+        ],
+        [(dtype, (n, n), n * n)],
+        tmp_path,
+        "where-broadcast-{}".format(dtype),
+    )
+    _assert_bitwise(native, reference)
+    _assert_native_metadata(artifact, ("where",))
