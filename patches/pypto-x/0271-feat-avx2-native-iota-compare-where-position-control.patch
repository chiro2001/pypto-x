+_WHERE_VALUE_BITS = {
+    "float32": _F32_BITS,
+    "bf16": _BF16_BITS,
+    "int8": (-128, -1, 0, 1, 127),
+    "uint8": (0, 1, 128, 255),
+    "int16": (-(1 << 15), 0, 1, (1 << 15) - 1),
+    "uint16": (0, 1, (1 << 16) - 1),
+    "int32": (-(1 << 31), -1, 0, 1, (1 << 31) - 1),
+    "uint32": (0, 1, (1 << 32) - 1),
+    "int64": (-(1 << 63), -1, 0, 1, (1 << 63) - 1),
+    "uint64": (0, 1, (1 << 64) - 1),
+    "bool": (0, 1, 2, 255),
+}
