+def test_where_condition_must_be_bool_and_nan_truthiness_is_documented(tmp_path):
+    """The validator forbids non-bool conditions; raw bytes keep truthiness.
+
+    ``bool(float('nan')) is True`` in the host reference, but the frozen
+    contract rejects a non-bool condition before codegen, so a NaN condition
+    cannot reach either executor.  The reachable edge case is a non-0/1 bool
+    byte, which both paths treat as True (Python truthiness).
+    """
+
+    from pypto.lowering.cpu.vector import CpuVectorValidationError
+
+    program = _where_program(
+        "float32", _tensor("float32", (4,)), _tensor("float32", (4,)), _tensor("float32", (4,)), _tensor("float32", (4,))
+    )
+    with pytest.raises(CpuVectorValidationError, match="condition must have bool"):
+        Avx2Compiler().lower(program, AVX2_TARGET)
+
+    program = _where_program(
+        "float32", _tensor("bool", (4,)), _tensor("float32", (4,)), _tensor("float32", (4,)), _tensor("float32", (4,))
+    )
+    _target_ir, _artifact, native, reference = _differential(
+        program,
+        [
+            ("bool", (4,), [0, 1, 2, 255]),
+            ("float32", (4,), [0x3F800000] * 4),
+            ("float32", (4,), [0x40000000] * 4),
+        ],
+        [("float32", (4,), 4)],
+        tmp_path,
+        "where-truthiness",
+    )
+    _assert_bitwise(native, reference)
+    # 0 selects the false branch; any non-zero byte (1/2/255) selects true.
+    assert native[0][0:4] == _buffer_bytes(_native_buffer("float32", [0x40000000]))
+    assert native[0][4:8] == _buffer_bytes(_native_buffer("float32", [0x3F800000]))
+    assert native[0][8:12] == native[0][4:8]
+    assert native[0][12:16] == native[0][4:8]
+
