+            )
+            + _position_u64_bytes(contract["left_strides"])
+            + _position_u64_bytes(contract["right_strides"])
+            + _position_u64_bytes(contract["output_shape"])
+        )
+    if kind == "where":
+        header = struct.pack(
+            "<4sIIIII",
+            b"PXWH",
+            _POSITION_CONTROL_WIRE_VERSION,
+            int(contract["rank"]),
+            POSITION_CONTROL_DTYPE_CODES[contract["value_dtype"]],
+            POSITION_CONTROL_DTYPE_CODES["bool"],
+            0,
+        )
+        return (
+            header
+            + _position_u64_bytes(
+                (
+                    contract["condition_elements"],
+                    contract["true_elements"],
+                    contract["false_elements"],
+                    contract["output_elements"],
+                )
+            )
+            + _position_u64_bytes(contract["condition_strides"])
+            + _position_u64_bytes(contract["true_strides"])
+            + _position_u64_bytes(contract["false_strides"])
+            + _position_u64_bytes(contract["output_shape"])
+        )
+    raise ValueError("unknown position-control descriptor kind {!r}".format(kind))
+
+
+def _position_control_descriptor_digest(contract: Mapping[str, Any]) -> str:
+    return "fnv1a64:{:016x}".format(_fnv1a64(_position_control_descriptor_bytes(contract)))
+
+
+def _position_control_output_shape(plan: Any, operation: str):
+    try:
+        shape = tuple(int(dimension) for dimension in plan.shape)
+    except (TypeError, ValueError):
+        return None, "{} output shape is not statically known".format(operation)
+    if any(dimension < 0 for dimension in shape):
+        return None, "{} output shape contains a negative dimension".format(operation)
+    return shape, None
+
+
+def _position_control_source_layout(value_type: Any, output_shape, context: str):
+    """Return ``(element_strides, element_count, reason)`` for one source.
+
+    Scalars contribute one storage element and all-zero output strides.  Tensor
+    sources must broadcast with the standard trailing-singleton rule and are
+    addressed by output-rank element strides.
+    """
+
+    kind = getattr(value_type, "kind", None)
+    if kind == "scalar":
+        return tuple(0 for _ in output_shape), 1, None
+    if kind not in _PACKED_TENSOR_KINDS:
+        return (
+            None,
+            None,
+            "{} kind {!r} is not a native AVX2 position-control tensor/scalar".format(
+                context, kind
+            ),
+        )
+    try:
+        shape = tuple(int(dimension) for dimension in value_type.shape)
+    except (TypeError, ValueError):
+        return None, None, "{} shape is not statically known".format(context)
+    if any(dimension < 0 for dimension in shape):
+        return None, None, "{} shape contains a negative dimension".format(context)
+    rank_delta = len(output_shape) - len(shape)
+    if rank_delta < 0:
+        return (
+            None,
+            None,
+            "{} rank {} exceeds output rank {}".format(context, len(shape), len(output_shape)),
+        )
+    contiguous = _contiguous_element_strides(shape)
+    strides = [0] * rank_delta
+    for axis, dimension in enumerate(shape):
+        output_dimension = output_shape[rank_delta + axis]
+        if dimension == 1:
+            strides.append(0)
+        elif dimension == output_dimension:
+            strides.append(contiguous[axis])
+        else:
+            return (
+                None,
+                None,
+                "{} dimension {} on axis {} is neither 1 nor equal to output dimension {}".format(
+                    context, dimension, axis, output_dimension
+                ),
+            )
+    return tuple(strides), element_count(shape), None
+
+
+def _position_control_iota(operation: Any, plan: Any):
+    if len(operation.inputs) != 0 or len(operation.outputs) != 1:
+        return None, "iota requires exactly one output and no inputs"
+    output_type = operation.outputs[0].type
+    try:
+        axis, start, step = iota_spec(output_type, operation.attributes, "AVX2 iota")
+    except Exception as exc:  # noqa: BLE001 - the shared validator already ran
+        return None, "iota schedule is invalid: {}".format(exc)
+    try:
+        dtype = canonical_dtype(plan.dtype)
+    except (TypeError, ValueError) as exc:
+        return None, "iota output dtype is not statically known: {}".format(exc)
+    if dtype not in ("int32", "int64"):
+        return None, "dtype {} is not in the native AVX2 iota dtype set (int32/int64)".format(dtype)
+    shape, reason = _position_control_output_shape(plan, "iota")
+    if shape is None:
+        return None, reason
+    if len(shape) > POSITION_CONTROL_MAX_RANK:
+        return None, "iota rank {} exceeds the native AVX2 position-control max rank {}".format(
+            len(shape), POSITION_CONTROL_MAX_RANK
+        )
+    inner_stride = 1
+    for dimension in shape[axis + 1:]:
+        inner_stride *= dimension
+    return (
+        {
+            "kind": "iota",
+            "kernel": "iota_{}".format(POSITION_CONTROL_DTYPE_SUFFIX[dtype]),
+            "dtype": dtype,
+            "axis": int(axis),
+            "start": int(start),
+            "step": int(step),
+            "rank": len(shape),
+            "output_shape": list(shape),
+            "output_elements": element_count(shape),
+            "inner_stride": int(inner_stride),
+            "dimension": int(shape[axis]),
+        },
+        None,
+    )
+
+
+def _position_control_compare(operation: Any, plan: Any):
+    if len(operation.inputs) != 2 or len(operation.outputs) != 1:
+        return None, "compare requires exactly two inputs and one output"
+    output_type = operation.outputs[0].type
+    try:
+        output_dtype = canonical_dtype(output_type.dtype)
+    except (TypeError, ValueError) as exc:
+        return None, "compare output dtype is not statically known: {}".format(exc)
+    if output_dtype != "bool":
+        return None, "compare output dtype {} is not bool".format(output_dtype)
+    try:
+        predicate = comparison_predicate_for_operation(
+            operation.name, operation.attributes, "AVX2 compare"
+        )
+    except Exception as exc:  # noqa: BLE001 - the shared validator already ran
+        return None, "compare predicate is invalid: {}".format(exc)
+    left_type, right_type = operation.inputs[0].type, operation.inputs[1].type
+    try:
+        left_dtype = canonical_dtype(left_type.dtype)
+        right_dtype = canonical_dtype(right_type.dtype)
+    except (TypeError, ValueError) as exc:
+        return None, "compare operand dtype is not statically known: {}".format(exc)
+    if left_dtype != right_dtype:
+        return None, "compare operands must share one dtype ({} vs {})".format(
+            left_dtype, right_dtype
+        )
+    if left_dtype != "bool" and left_dtype not in POSITION_CONTROL_VALUE_DTYPES:
+        return None, "dtype {} is not in the native AVX2 compare dtype set".format(left_dtype)
+    if left_dtype == "bool" and predicate not in ("eq", "ne"):
+        return None, "ordered bool comparison is not a native AVX2 compare"
+    shape, reason = _position_control_output_shape(plan, "compare")
+    if shape is None:
+        return None, reason
+    if len(shape) > POSITION_CONTROL_MAX_RANK:
+        return None, "compare rank {} exceeds the native AVX2 position-control max rank {}".format(
+            len(shape), POSITION_CONTROL_MAX_RANK
+        )
+    left_strides, left_elements, reason = _position_control_source_layout(
+        left_type, shape, "compare left"
+    )
+    if left_strides is None:
+        return None, reason
+    right_strides, right_elements, reason = _position_control_source_layout(
+        right_type, shape, "compare right"
+    )
+    if right_strides is None:
+        return None, reason
+    return (
+        {
+            "kind": "compare",
+            "kernel": "compare_{}".format(POSITION_CONTROL_DTYPE_SUFFIX[left_dtype])
+            if left_dtype != "bool"
+            else "compare_bool",
+            "dtype": left_dtype,
+            "predicate": predicate,
+            "predicate_code": POSITION_CONTROL_PREDICATE_CODES[predicate],
+            "rank": len(shape),
+            "output_shape": list(shape),
+            "left_strides": list(left_strides),
+            "right_strides": list(right_strides),
+            "left_elements": int(left_elements),
+            "right_elements": int(right_elements),
+            "output_elements": element_count(shape),
+        },
+        None,
+    )
+
+
+def _position_control_where(operation: Any, plan: Any):
+    if len(operation.inputs) != 3 or len(operation.outputs) != 1:
+        return None, "where requires exactly three inputs and one output"
+    condition_type, true_type, false_type = (ref.type for ref in operation.inputs)
+    try:
+        condition_dtype = canonical_dtype(condition_type.dtype)
+        value_dtype = canonical_dtype(true_type.dtype)
+        false_dtype = canonical_dtype(false_type.dtype)
+        output_dtype = canonical_dtype(operation.outputs[0].type.dtype)
+    except (TypeError, ValueError) as exc:
+        return None, "where operand dtype is not statically known: {}".format(exc)
+    if condition_dtype != "bool":
+        return None, "where condition dtype {} is not bool".format(condition_dtype)
+    if false_dtype != value_dtype or output_dtype != value_dtype:
+        return None, "where selected values and output must share one dtype ({} vs {} vs {})".format(
+            value_dtype, false_dtype, output_dtype
+        )
+    if value_dtype != "bool" and value_dtype not in POSITION_CONTROL_VALUE_DTYPES:
+        return None, "dtype {} is not in the native AVX2 where dtype set".format(value_dtype)
+    shape, reason = _position_control_output_shape(plan, "where")
+    if shape is None:
+        return None, reason
+    if len(shape) > POSITION_CONTROL_MAX_RANK:
+        return None, "where rank {} exceeds the native AVX2 position-control max rank {}".format(
+            len(shape), POSITION_CONTROL_MAX_RANK
+        )
+    layout = []
+    for value_type, label in (
+        (condition_type, "where condition"),
+        (true_type, "where input"),
+        (false_type, "where other"),
+    ):
+        strides, elements, reason = _position_control_source_layout(value_type, shape, label)
+        if strides is None:
+            return None, reason
+        layout.append((tuple(strides), int(elements)))
+    (condition_strides, condition_elements), (true_strides, true_elements), (
+        false_strides,
+        false_elements,
+    ) = layout
+    return (
+        {
+            "kind": "where",
+            "kernel": "where_{}".format(POSITION_CONTROL_DTYPE_SUFFIX[value_dtype]),
+            "condition_dtype": "bool",
+            "value_dtype": value_dtype,
+            "dtype": value_dtype,
+            "rank": len(shape),
+            "output_shape": list(shape),
+            "condition_strides": list(condition_strides),
+            "true_strides": list(true_strides),
+            "false_strides": list(false_strides),
+            "condition_elements": condition_elements,
+            "true_elements": true_elements,
+            "false_elements": false_elements,
+            "output_elements": element_count(shape),
+        },
+        None,
+    )
+
+
+_POSITION_CONTROL_HANDLERS = {
+    "iota": _position_control_iota,
+    "compare": _position_control_compare,
+    "where": _position_control_where,
+}
+
+
+def _position_control_decision(operation: Any, plan: Any):
+    """Return ``(contract, fallback_reason)`` for one position-control plan.
+
+    Exactly one element of the pair is non-``None`` for an iota/compare/where
+    plan and both are ``None`` for every other operation.  ``contract`` always
+    carries ``mode`` and the fnv1a64 ``descriptor_digest``.
+    """
+
+    if operation is None or plan is None:
+        return None, None
+    name = canonical_operation_name(operation.name)
+    if name not in POSITION_CONTROL_OPERATIONS:
+        return None, None
+    if name != plan.operation:
+        return None, "plan operation {!r} does not match {!r}".format(plan.operation, name)
+    contract, reason = _POSITION_CONTROL_HANDLERS[name](operation, plan)
+    if contract is None:
+        return None, reason
+    contract = dict(contract)
+    contract["mode"] = POSITION_CONTROL_MODE
+    contract["descriptor_digest"] = _position_control_descriptor_digest(contract)
+    return contract, None
+
+
+def position_control_native_contract(operation: Any, plan: Any) -> Optional[dict]:
+    """Describe the native AVX2 position-control kernel for one plan, or ``None``."""
+
+    return _position_control_decision(operation, plan)[0]
+
+
+def position_control_native_fallback_reason(operation: Any, plan: Any) -> Optional[str]:
+    """Return why one iota/compare/where plan stays on the host reference, or ``None``."""
+
+    return _position_control_decision(operation, plan)[1]
+
