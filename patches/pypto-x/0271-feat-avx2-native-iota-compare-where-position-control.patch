+"""AVX2 native position-control plane (avx2-position-native).
+
+``iota``/``compare``/``where`` used to be declared ``host_reference`` (with
+``where`` additionally pre-expanded) in the AVX2 artifact.  Payload 7 executes
+all three inside the compiled AVX2 object through the PXIO/PXCP/PXWH
+descriptor wire.
+
+Semantic source of truth: the *vector-common host reference*, which is exactly
+what the previous AVX2 fallback ran.  Every native result is compared bitwise
+(full output buffer sha256) against ``avx2_runtime._reference_operation`` on the
+same raw bits, and the raw-bit corpora deliberately include signaling/quiet
+NaN, +/-0, infinities, subnormals and signed/unsigned integer extremes.  The
+oracle never imports the kernel under test.
+
+The plan predicate is shared by artifact metadata and runtime dispatch, so the
+fail-closed cases (rank above the native maximum, unsupported dtype, malformed
+schedules) are asserted at both the metadata and the execution level, and the
+metadata must never advertise ``native`` for a plan that fell back.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import types
+
+import pytest
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.x86 import (
+    Avx2Runtime,
+    CpuAvx2ArtifactError,
+)
+from pypto.backends.cpu.x86 import avx2 as avx2_runtime
+from pypto.compiler import Artifact, CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_avx2 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    NATIVE_ABI_MARKER,
+    POSITION_CONTROL_MAX_RANK,
+    POSITION_CONTROL_MODE,
+    POSITION_CONTROL_WIRE,
+    Avx2Compiler,
+    position_control_native_contract,
+    position_control_native_fallback_reason,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import element_count
+from pypto.target import TargetSpec
+
+
+AVX2_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx", "avx2", "osxsave", "ymm"), attributes={"lane_count": 8}
+)
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+
+_PREDICATES = ("eq", "ne", "lt", "le", "gt", "ge")
+_CTYPES = {
+    "float32": ctypes.c_float,
+    "bf16": ctypes.c_uint16,
+    "int8": ctypes.c_int8,
+    "uint8": ctypes.c_uint8,
+    "int16": ctypes.c_int16,
+    "uint16": ctypes.c_uint16,
+    "int32": ctypes.c_int32,
+    "uint32": ctypes.c_uint32,
+    "int64": ctypes.c_int64,
+    "uint64": ctypes.c_uint64,
+    "bool": ctypes.c_bool,
+}
+_ITEMSIZE = {
+    "float32": 4,
+    "bf16": 2,
+    "int8": 1,
+    "uint8": 1,
+    "int16": 2,
+    "uint16": 2,
+    "int32": 4,
+    "uint32": 4,
+    "int64": 8,
+    "uint64": 8,
+    "bool": 1,
+}
+
+#: Raw-bit corpora.  f32 sNaN payloads keep the quiet bit clear so the host
+#: reference's Python-float round trip (and the native kernel) must quiet them.
+_F32_BITS = (
+    0x7F800001,  # signaling NaN, positive payload
+    0xFF800001,  # signaling NaN, negative payload
+    0x7FC00001,  # quiet NaN with payload
+    0xFFC12345,
+    0x7F800000,  # +inf
+    0xFF800000,  # -inf
+    0x80000000,  # -0.0
+    0x00000000,  # +0.0
+    0x7F7FFFFF,  # max finite
+    0xFF7FFFFF,  # min finite
+    0x00000001,  # subnormal
+    0x80000001,
+    0x3F800000,  # 1.0
+    0xBF800000,  # -1.0
+)
+_BF16_BITS = (
+    0x7F81,
+    0xFF81,
+    0x7FC1,
+    0xFFC1,
+    0x7F80,
+    0xFF80,
+    0x8000,
+    0x0000,
+    0x7F7F,
+    0xFF7F,
+    0x0001,
+    0x8001,
+    0x3F80,
+    0xBF80,
+)
+_COMPARE_BITS = {
+    "float32": _F32_BITS,
+    "bf16": _BF16_BITS,
+    "int8": (-128, -127, -1, 0, 1, 127),
+    "uint8": (0, 1, 127, 128, 254, 255),
+    "int16": (-(1 << 15), -1, 0, 1, (1 << 15) - 1),
+    "uint16": (0, 1, (1 << 15), (1 << 16) - 1),
+    "int32": (-(1 << 31), -(1 << 30), -1, 0, 1, (1 << 31) - 1),
+    "uint32": (0, 1, (1 << 31), (1 << 32) - 1),
+    "int64": (-(1 << 63), -(1 << 62), -1, 0, 1, (1 << 63) - 1),
+    "uint64": (0, 1, (1 << 63), (1 << 64) - 1),
+    "bool": (0, 1, 2, 255),
+}
+
+
+# ---------------------------------------------------------------------------
+# raw buffer helpers
+# ---------------------------------------------------------------------------
+
+
+def _raw_array(dtype, bits):
+    if dtype == "float32":
+        array = (ctypes.c_uint32 * len(bits))()
+        for index, value in enumerate(bits):
+            ctypes.memmove(
+                ctypes.addressof(array) + 4 * index,
+                struct.pack("<I", int(value) & 0xFFFFFFFF),
+                4,
+            )
+        return array, ctypes.cast(array, ctypes.POINTER(ctypes.c_float))
+    if dtype == "bool":
+        # Keep the raw byte; c_bool would normalize 2/255 to 1 and hide the
+        # Python-truthiness contract under test.
+        array = (ctypes.c_uint8 * len(bits))(*[int(value) & 0xFF for value in bits])
+        return array, ctypes.cast(array, ctypes.POINTER(ctypes.c_uint8))
+    ctype = _CTYPES[dtype]
+    array = (ctype * len(bits))(*[int(value) for value in bits])
+    return array, ctypes.cast(array, ctypes.POINTER(ctype))
+
+
+def _array_bytes(dtype, array):
+    if not ctypes.sizeof(array):
+        return b""
+    return ctypes.string_at(ctypes.addressof(array), ctypes.sizeof(array))
+
+
+def _scalar_value(dtype, bit):
+    if dtype == "float32":
+        return struct.unpack("<f", struct.pack("<I", int(bit) & 0xFFFFFFFF))[0]
+    if dtype == "bf16":
+        return struct.unpack("<f", struct.pack("<I", (int(bit) & 0xFFFF) << 16))[0]
+    if dtype == "bool":
+        return bool(bit)
+    return int(bit)
+
+
+def _descriptor(dtype, shape, array, readonly=False):
+    if ctypes.sizeof(array):
+        return TensorDesc(
+            dtype,
+            shape,
+            device="cpu",
+            address=ctypes.addressof(array),
+            readonly=readonly,
+        )
+    # Zero-length buffers must not advertise a null address; pass the array as
+    # the descriptor handle instead.
+    return TensorDesc(dtype, shape, device="cpu", handle=array, readonly=readonly)
+
+
+def _native_buffer(dtype, bits):
+    array, pointer = _raw_array(dtype, bits)
+    return avx2_runtime._NativeBuffer(dtype, len(bits), pointer, array, True)
+
+
+def _buffer_bytes(buffer):
+    if not buffer.count:
+        return b""
+    return ctypes.string_at(
+        ctypes.cast(buffer.pointer, ctypes.c_void_p), buffer.count * _ITEMSIZE[buffer.dtype]
+    )
+
+
+def _runtime():
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2/YMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _compile_avx2(program, directory, name):
+    compiler = Avx2Compiler()
+    target_ir = compiler.lower(program, AVX2_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2",
+            extra={"build_dir": str(Path(directory) / name)},
+        ),
+    )
+    return target_ir, artifact
+
+
+def _compile_scalar(program):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _reference_environment(program, target_ir, input_buffers, context):
+    """Run every operation through the vector-common host reference."""
+
+    function = program.functions[0]
+    environment = {}
+    for parameter, buffer in zip(function.parameters, input_buffers):
+        environment[parameter.name] = avx2_runtime._RuntimeValue(parameter.type, buffer)
+    for operation, plan in zip(function.body.operations, target_ir.plans):
+        inputs = [environment[ref.name] for ref in operation.inputs]
+        environment.update(
+            avx2_runtime._reference_operation(operation, plan, inputs, context)
+        )
+    return environment
+
+
+def _differential(program, input_specs, output_specs, directory, name):
+    """Launch native and host-reference with identical raw bits.
+
+    ``input_specs``/``output_specs`` are ``(dtype, shape, bits_or_count)``
+    tuples; a ``()`` shape marks a scalar parameter and its single bit is
+    routed through ``LaunchRequest.scalars``.
+    """
+
+    target_ir, artifact = _compile_avx2(program, directory, name)
+    function = program.functions[0]
+    tensor_arrays = []
+    tensor_buffers = []
+    scalars = {}
+    for (dtype, shape, bits), parameter in zip(input_specs, function.parameters):
+        array, pointer = _raw_array(dtype, bits)
+        buffer = avx2_runtime._NativeBuffer(dtype, len(bits), pointer, array, True)
+        tensor_buffers.append(buffer)
+        if shape == ():
+            scalars[parameter.name] = _scalar_value(dtype, bits[0])
+        else:
+            tensor_arrays.append((dtype, shape, array))
+    outputs = []
+    output_arrays = []
+    for dtype, shape, count in output_specs:
+        array, _pointer = _raw_array(dtype, [0] * count)
+        outputs.append((dtype, shape, array))
+        output_arrays.append(array)
+    _runtime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[
+                _descriptor(dtype, shape, array, readonly=True)
+                for dtype, shape, array in tensor_arrays
+            ],
+            outputs=[
+                _descriptor(dtype, shape, array) for dtype, shape, array in outputs
+            ],
+            scalars=scalars,
+        )
+    )
+    native = [_array_bytes(dtype, array) for dtype, _shape, array in outputs]
+    environment = _reference_environment(program, target_ir, tensor_buffers, name)
+    reference = [
+        _buffer_bytes(environment[ref.name].buffer) for ref in function.returns
+    ]
+    return target_ir, artifact, native, reference
+
+
+def _assert_bitwise(native, reference):
+    assert len(native) == len(reference)
+    for index, (actual, expected) in enumerate(zip(native, reference)):
+        assert actual == expected, "output {} differs:\n  native {}\n  ref    {}".format(
+            index, actual.hex(), expected.hex()
+        )
+
+
+def _plain_json(value):
+    """Convert frozen metadata into plain JSON containers (no key iteration)."""
+
+    if isinstance(value, dict):
+        return {str(key): _plain_json(item) for key, item in value.items()}
+    if hasattr(value, "items"):
+        return {str(key): _plain_json(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain_json(item) for item in value]
+    return value
+
+
+def _assert_native_metadata(artifact, kinds):
+    metadata = artifact.metadata
+    assert metadata["artifact_payload_version"] == ARTIFACT_PAYLOAD_VERSION == 7
+    assert metadata["position_control_fallback"] == "native"
+    assert metadata["position_control_mode"] == POSITION_CONTROL_MODE
+    assert metadata["position_control_descriptor_wire"] == POSITION_CONTROL_WIRE
+    assert tuple(metadata["native_position_control_fallback_operations"]) == ()
+    assert tuple(metadata["host_preexpanded_operations"]) == ()
+    entries = metadata["native_position_control_operations"]
+    assert entries, "expected at least one native position-control entry"
+    for entry in entries:
+        assert entry["mode"] == POSITION_CONTROL_MODE
+        assert entry["kind"] in kinds
+        assert "ptx_avx2_{}".format(entry["kernel"]) in tuple(
+            metadata["native_helper_symbols"]
+        )
+        assert entry["descriptor_digest"].startswith("fnv1a64:")
+        mode = next(
+            item["mode"]
+            for item in metadata["execution_modes"]
+            if item["operation_index"] == entry["operation_index"]
+        )
+        assert mode == POSITION_CONTROL_MODE
+    return entries
+
+
+# ---------------------------------------------------------------------------
+# program builders
+# ---------------------------------------------------------------------------
+
+
+def _iota_program(dtype, shape, axis, start, step):
+    output = ValueRef("out", CoreType.tensor(dtype, tuple(shape)))
+    operation = Operation(
+        "iota", (), (output,), {"axis": axis, "start": start, "step": step}
+    )
+    return CoreProgram(
+        functions=(CoreFunction("iota", (), (output,), Region((operation,))),)
+    )
+
+
+def _compare_matrix_program(dtype, n, predicates=_PREDICATES):
+    left = ValueRef("left", CoreType.tensor(dtype, (n, 1)))
+    right = ValueRef("right", CoreType.tensor(dtype, (1, n)))
+    outputs = []
+    operations = []
+    for predicate in predicates:
+        output = ValueRef("out_{}".format(predicate), CoreType.tensor("bool", (n, n)))
+        outputs.append(output)
+        operations.append(Operation(predicate, (left, right), (output,), {}))
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "compare_matrix",
+                (left, right),
+                tuple(outputs),
+                Region(tuple(operations)),
+            ),
+        )
+    )
+
+
+def _compare_flat_program(dtype, n, predicate="le"):
+    left = ValueRef("left", CoreType.tensor(dtype, (n,)))
+    right = ValueRef("right", CoreType.tensor(dtype, (n,)))
+    output = ValueRef("out", CoreType.tensor("bool", (n,)))
+    operation = Operation(predicate, (left, right), (output,), {})
+    return CoreProgram(
+        functions=(CoreFunction("compare_flat", (left, right), (output,), Region((operation,))),)
+    )
+
+
+def _where_program(dtype, condition_type, true_type, false_type, output_type):
+    condition = ValueRef("cond", condition_type)
+    true_value = ValueRef("true", true_type)
+    false_value = ValueRef("false", false_type)
+    output = ValueRef("out", output_type)
+    operation = Operation("where", (condition, true_value, false_value), (output,), {})
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "where",
+                (condition, true_value, false_value),
+                (output,),
+                Region((operation,)),
+            ),
+        )
+    )
+
+
+def _tensor(dtype, shape):
+    return CoreType.tensor(dtype, tuple(shape))
+
+
+def _scalar(dtype):
+    return CoreType.scalar(dtype)
+
+
+# ---------------------------------------------------------------------------
+# iota
+# ---------------------------------------------------------------------------
+
+
+_IOTA_CASES = (
+    ("int32", (4,), 0, 0, 1),
+    ("int32", (3, 4), -1, -5, -2),
+    ("int32", (3, 4), 1, 7, 2),
+    ("int32", (2, 3, 4), 1, -20, 3),
+    ("int32", (0, 4), 1, 7, 3),
+    ("int32", (2, 0, 3), 1, -3, 1),
+    ("int32", (4,), 0, 2147483644, 1),
+    ("int32", (4,), 0, -2147483648, 1),
+    ("int64", (2, 3), 1, 5, -3),
+    ("int64", (2, 2, 3), 2, -(2**62), 2**60),
+    ("int64", (3,), 0, (1 << 63) - 4, 1),
+    ("int64", (3,), 0, -(1 << 63), 1),
+)
+
+
+@pytest.mark.parametrize("dtype,shape,axis,start,step", _IOTA_CASES)
+def test_iota_is_bit_exact_against_the_host_reference(
+    dtype, shape, axis, start, step, tmp_path
+):
+    program = _iota_program(dtype, shape, axis, start, step)
+    count = element_count(shape)
+    target_ir, artifact, native, reference = _differential(
+        program,
+        [],
+        [(dtype, shape, count)],
+        tmp_path,
+        "iota-{}-{}".format(dtype, "-".join(str(d) for d in shape)),
+    )
+    _assert_bitwise(native, reference)
+    entries = _assert_native_metadata(artifact, ("iota",))
+    assert entries[0]["kernel"] in ("iota_i32", "iota_i64")
+    contract = position_control_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None
+    assert contract["axis"] >= 0
+    assert contract["output_elements"] == count
+
+
+def test_iota_native_matches_the_scalar_runtime_on_normal_values(tmp_path):
+    for dtype, shape, axis, start, step in (
+        ("int32", (3, 4), -1, -5, -2),
+        ("int64", (2, 3), 1, 100, -7),
+    ):
+        program = _iota_program(dtype, shape, axis, start, step)
+        _target_ir, artifact = _compile_avx2(
+            program, tmp_path, "iota-scalar-{}-{}".format(dtype, axis)
+        )
+        scalar_artifact = _compile_scalar(program)
+        native_output = HostTensor.zeros(dtype, shape)
+        scalar_output = HostTensor.zeros(dtype, shape)
+        _runtime().launch(
+            LaunchRequest(artifact, inputs=[], outputs=[native_output.descriptor()])
+        )
+        CpuScalarRuntime().launch(
+            LaunchRequest(scalar_artifact, inputs=[], outputs=[scalar_output.descriptor()])
+        )
+        assert native_output.flat() == scalar_output.flat()
+
+
+def test_iota_sequence_outside_the_declared_dtype_is_rejected_before_codegen():
+    """The host contract rejects (never wraps) an out-of-range iota schedule."""
+
+    from pypto.lowering.cpu.vector import CpuVectorValidationError
+
+    program = _iota_program("int32", (4,), 0, 2147483646, 1)
+    with pytest.raises(CpuVectorValidationError):
+        Avx2Compiler().lower(program, AVX2_TARGET)
+    # The shared iota validator is the same object the host reference uses.
+    program64 = _iota_program("int64", (4,), 0, (1 << 63) - 3, 1)
+    with pytest.raises(CpuVectorValidationError):
+        Avx2Compiler().lower(program64, AVX2_TARGET)
+
+
+# ---------------------------------------------------------------------------
+# compare
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("dtype", tuple(_COMPARE_BITS))
+def test_compare_full_pair_matrix_is_bit_exact(dtype, tmp_path):
+    bits = list(_COMPARE_BITS[dtype])
+    n = len(bits)
+    predicates = ("eq", "ne") if dtype == "bool" else _PREDICATES
+    program = _compare_matrix_program(dtype, n, predicates)
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [(dtype, (n, 1), bits), (dtype, (1, n), bits)],
+        [("bool", (n, n), n * n) for _ in predicates],
+        tmp_path,
+        "compare-matrix-{}".format(dtype),
+    )
+    _assert_bitwise(native, reference)
+    _assert_native_metadata(artifact, ("compare",))
+
+
+def test_compare_flat_contiguous_bytes_are_bit_exact_for_f32_and_bf16(tmp_path):
+    """The f32 kernel's AVX2 fast path needs vector-, tail- and empty sizes."""
+
+    for dtype, bits in (("float32", _F32_BITS), ("bf16", _BF16_BITS)):
+        for predicate in _PREDICATES:
+            for n in (0, 1, 7, 8, 9, 32):
+                values = [bits[index % len(bits)] for index in range(n)]
+                program = _compare_flat_program(dtype, n, predicate)
+                _target_ir, _artifact, native, reference = _differential(
+                    program,
+                    [(dtype, (n,), values), (dtype, (n,), list(reversed(values)))],
+                    [("bool", (n,), n)],
+                    tmp_path,
+                    "compare-flat-{}-{}-{}".format(dtype, predicate, n),
+                )
+                _assert_bitwise(native, reference)
+
+
+def test_compare_scalar_and_bool_truthiness_contract(tmp_path):
+    """Scalar operands and non-0/1 bool bytes follow Python truthiness."""
+
+    # tensor <= scalar -> output shape is the tensor broadcast shape
+    left = ValueRef("left", CoreType.tensor("int32", (4, 1)))
+    right = ValueRef("right", CoreType.scalar("int32"))
+    output = ValueRef("out_le", CoreType.tensor("bool", (4, 1)))
+    operation = Operation("le", (left, right), (output,), {})
+    program = CoreProgram(
+        functions=(CoreFunction("compare_scalar", (left, right), (output,), Region((operation,))),)
+    )
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [("int32", (4, 1), [1, 2, 3, 4]), ("int32", (), [2])],
+        [("bool", (4, 1), 4)],
+        tmp_path,
+        "compare-scalar",
+    )
+    _assert_bitwise(native, reference)
+    _assert_native_metadata(artifact, ("compare",))
+
+    # bool raw bytes: 0x02/0xFF are True, so eq/ne must normalize them.
+    program = _compare_matrix_program("bool", 4, ("eq", "ne"))
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [("bool", (4, 1), [0, 1, 2, 255]), ("bool", (1, 4), [0, 1, 2, 255])],
+        [("bool", (4, 4), 16), ("bool", (4, 4), 16)],
+        tmp_path,
+        "compare-bool-bytes",
+    )
+    _assert_bitwise(native, reference)
+    assert native[0][6] == 1  # bool(1) == bool(2) -> both True
+    assert native[1][6] == 0  # bool(1) != bool(2) -> both True -> False
+
