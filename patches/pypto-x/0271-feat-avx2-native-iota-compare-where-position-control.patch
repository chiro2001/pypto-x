+#: Native position-control plane (artifact payload version 7).
+#:
+#: ``iota``/``compare``/``where`` are described by the same rank-sized
+#: broadcast schedules as the accepted SVE256 v5 control wire
+#: (PXIO/PXCP/PXWH) and executed by the compiled AVX2 object, so the host
+#: never materializes a per-element Python list.  The runtime dispatch and
+#: the artifact metadata share the two predicates below, so a declared kernel
+#: is exactly the kernel the executor runs and every uncovered plan carries an
+#: explicit host-reference reason.  ``compare``/``where`` reproduce the host
+#: reference verbatim: ordered comparisons are false for NaN, ``ne`` is true
+#: for NaN, bool operands are Python truthiness (any non-zero byte is True),
+#: only a zero condition byte selects the false branch, and f32/bf16 selections
+#: are bit-copied after the same Python-float round-trip quieting the host
+#: reference applies.
+POSITION_CONTROL_MODE = "native_avx2_position_control"
+POSITION_CONTROL_WIRE = "v1:pxio-pxcp-pxwh+fnv1a64"
+POSITION_CONTROL_KERNEL_VERSION = 1
+POSITION_CONTROL_MAX_RANK = 16
