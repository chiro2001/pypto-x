+#: Wire dtype codes mirror the SVE256 control wire (``PTX_DTYPE_*`` in
+#: cpu_sve256.py), so a PXCP/PXWH descriptor digest means the same dtype on
+#: both ISAs.
+POSITION_CONTROL_DTYPE_CODES = {
+    "float32": 0,
+    "bf16": 1,
+    "int32": 4,
+    "int64": 5,
+    "bool": 6,
+    "int8": 7,
+    "uint8": 8,
+    "int16": 9,
+    "uint16": 10,
+    "uint32": 11,
+    "uint64": 12,
