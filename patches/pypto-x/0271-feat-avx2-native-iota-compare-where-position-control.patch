+/* -------------------------------------------------------------------------
+ * Native position-control plane (artifact payload version 7).
+ *
+ * iota/compare/where are driven by the same rank-sized schedules as the
+ * accepted SVE256 v5 control wire (PXIO/PXCP/PXWH).  The descriptor loop is
+ * scalar (the accepted SVE256 reference plane is scalar as well); the fully
+ * contiguous f32 compare path and the contiguous f32 where select use AVX2
+ * intrinsics because those are the shapes that dominate Qwen mask/select
+ * traffic.  Semantics mirror the vector-common host reference exactly:
+ *   - compare: ordered predicates are false for NaN, != is true for NaN,
+ *     -0.0 == 0.0, and bool operands are Python truthiness (any non-zero
+ *     byte is True);
+ *   - where: only a zero condition byte selects the false branch, the chosen
+ *     f32/bf16 value gets the host reference's Python-float round-trip
+ *     quieting, and every other dtype is copied bit for bit.
+ * ---------------------------------------------------------------------- */
+#define PTX_AVX2_POSITION_MAX_RANK 16U
+
+static int ptx_avx2_position_u64_mul(uint64_t left, uint64_t right,
+                                     uint64_t *result) {
+    if (left != 0U && right > UINT64_MAX / left) return -1;
+    *result = left * right;
+    return 0;
+}
+
+/* 1 when ``strides`` is the row-major contiguous schedule of ``shape``. */
+static int ptx_avx2_position_contiguous(const int64_t *strides,
+                                        const size_t *shape, uint32_t rank) {
+    uint64_t expected = 1U;
+    uint32_t axis = rank;
+    while (axis > 0U) {
+        --axis;
+        if (strides[axis] != (int64_t)expected) return 0;
+        if (ptx_avx2_position_u64_mul(expected, (uint64_t)shape[axis],
+                                      &expected) != 0)
+            return 0;
+    }
+    return 1;
+}
+
+static uint64_t ptx_avx2_position_offset(const size_t *coordinates,
+                                         const int64_t *strides, uint32_t rank) {
+    uint64_t offset = 0U;
+    uint32_t axis;
+    for (axis = 0U; axis < rank; ++axis)
+        offset += (uint64_t)coordinates[axis] * (uint64_t)strides[axis];
+    return offset;
+}
+
+/* Advance the row-major odometer; returns 0 when the output domain is done. */
+static int ptx_avx2_position_advance(size_t *coordinates, const size_t *shape,
+                                     uint32_t rank) {
+    uint32_t axis = rank;
+    while (axis > 0U) {
+        --axis;
+        coordinates[axis] += 1U;
+        if (coordinates[axis] < shape[axis]) return 1;
+        coordinates[axis] = 0U;
