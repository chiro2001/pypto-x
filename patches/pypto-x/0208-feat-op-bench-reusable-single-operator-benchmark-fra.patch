+"""op-bench orchestration: probe -> measure -> compare -> report.
+
+The runner is provider-agnostic; each provider adapter supplies availability,
+prepare/run and its declared timing/thread/precision semantics.  Operator
+identity is verified against the U1 ``OpDefinition`` registry on every case.
+"""
+
+from __future__ import annotations
+
+import copy
+import datetime
+import hashlib
+import json
+import os
+import platform
+import statistics
+import subprocess
+import sys
+import tempfile
+import time
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+import numpy as np
+
+from . import precision as precision_module
+from .inputs import buffer_sha256, make_inputs, oracle_matmul
+from .object_model import CaseError, OpCase, format_cpu_list, parse_cpu_list
+from .protocol import (
+    GATE_REASON,
+    MEASURED_ROUNDS,
+    PROTOCOL_REVISION,
+    PROTOCOL_SOURCE,
+    UNGATED_STATUS,
+    dispersion,
+    environment_for_host,
+    warmup_verdict,
+)
+from .providers import (
+    PRECISION_BIT_EXACT,
+    PRECISION_BOUNDED,
+    ProviderContext,
+    ProviderLookupError,
+    get_provider,
+    get_provider_spec,
+    provider_ids,
+    provider_registry_state,
+)
+from .report import attach_q8_alignment, render_markdown, write_artifacts
+from .schema import (
+    REPORT_KIND,
+    SCHEMA_VERSION,
+    SchemaError,
+    validate_report,
+)
+from .suites import SUITE_NAMES, build_cases, suite_entries
+
+
+DEFAULT_SEED = 20260912
+DEFAULT_PORTABLE_SECONDS_PER_MAC = 1.0e-6  # conservative default; refined from observed cases
+
+
+class RunError(Exception):
+    """Fatal configuration/run error (never a silent skip)."""
+
+
+@dataclass
+class RunConfig:
+    suites: Tuple[str, ...] = ("model",)
+    providers: Tuple[str, ...] = ("portable", "vendor:aocl-lpgemm-bf16")
+    base_seed: int = DEFAULT_SEED
+    threads: int = 6
+    binding_cpus: Tuple[int, ...] = (0, 1, 2, 3, 4, 5)
+    rounds: Optional[int] = None
+    case_budget_seconds: float = 30.0
+    min_rounds: int = 3
+    iters: int = 100
+    warmup: int = 5
+    reference_provider: str = "portable"
+    reference_enabled: bool = True
+    force_expensive: bool = False
+    tag: str = "op-bench"
+    out_dir: str = ""
+    clock_source: str = "local_kvm_host_clock"
+    clock_offset_seconds: Optional[float] = None
+    q8_vendor_matrix: Optional[str] = None
+    q8_ratio_table: Optional[str] = None
+    inject_unavailable: Tuple[str, ...] = ()
+    case_filter: Tuple[str, ...] = ()
+    repeat: int = 1
+    repo_root: str = ""
+    aocl_library: Optional[str] = None
+
+    def validate(self) -> None:
+        for suite in self.suites:
+            if suite not in SUITE_NAMES and suite != "all":
+                raise RunError("unknown suite {!r}; available {}".format(suite, SUITE_NAMES))
+        for provider in self.providers:
+            if not provider:
+                raise RunError("provider ids must be non-empty")
+        if self.threads < 1:
+            raise RunError("threads must be >= 1")
+        if not self.binding_cpus:
+            raise RunError("binding cpus must not be empty")
+        if self.rounds is not None and self.rounds < 1:
+            raise RunError("rounds must be >= 1")
+        if self.min_rounds < 1:
+            raise RunError("min_rounds must be >= 1")
+        if self.iters < 1:
+            raise RunError("iters must be >= 1")
+        if self.repeat < 1:
+            raise RunError("repeat must be >= 1")
+
+
+@dataclass
+class _PortableCostModel:
+    seconds_per_mac: float = DEFAULT_PORTABLE_SECONDS_PER_MAC
+    samples: int = 0
+
+    def estimate(self, macs: int) -> float:
+        return max(float(macs), 1.0) * self.seconds_per_mac
+
+    def observe(self, macs: int, seconds: float) -> None:
+        if macs <= 0 or seconds <= 0:
+            return
+        observed = seconds / float(macs)
+        if self.samples == 0:
+            self.seconds_per_mac = observed
+        else:
+            self.seconds_per_mac = 0.5 * self.seconds_per_mac + 0.5 * observed
+        self.samples += 1
+
+
+@dataclass
+class _ReferenceCache:
+    adapter: Optional[Any]
+    enabled: bool
+    entries: Dict[Tuple[Any, ...], Mapping[str, Any]] = field(default_factory=dict)
+    seconds_total: float = 0.0
+
+    def get(self, case: OpCase, verified: Mapping[str, Any], inputs: Mapping[str, Any]) -> Mapping[str, Any]:
+        if not self.enabled or self.adapter is None:
+            return {"status": "disabled", "provider": None, "reason": "reference disabled by run config"}
+        key = (
+            tuple(verified["shape"]["left"]),
+            tuple(verified["shape"]["right"]),
+            verified["dtype"],
+            case.inputs_seed,
+        )
+        if key in self.entries:
+            return self.entries[key]
+        started = time.perf_counter()
+        try:
+            prepared = self.adapter.prepare(case, inputs)
+            result = self.adapter.run(prepared)
+        except Exception as exc:  # noqa: BLE001 - reference failure must be explicit
+            entry = {
+                "status": "error",
+                "provider": self.adapter.spec.provider_id,
+                "error": {"category": "reference_provider_error", "message": "{}: {}".format(type(exc).__name__, exc)},
+            }
+        else:
+            entry = {
+                "status": "ok",
+                "provider": self.adapter.spec.provider_id,
+                "output": result["output"],
+                "output_sha256": result.get("output_sha256"),
+                "wall_seconds": time.perf_counter() - started,
+                "precision_semantics": self.adapter.spec.precision.to_dict(),
+            }
+        self.seconds_total += time.perf_counter() - started
+        self.entries[key] = entry
+        return entry
+
+
+def run_report(config: RunConfig) -> Mapping[str, Any]:
+    """Execute one full op-bench run and return the (schema-validated) report."""
+
+    config.validate()
+    repo_root = config.repo_root or _find_repo_root()
+    if config.aocl_library:
+        os.environ["PYPTO_X_OP_BENCH_AOCL_LIB"] = config.aocl_library
+    os.environ.setdefault("OMP_NUM_THREADS", str(config.threads))
+    os.environ.setdefault("OMP_DYNAMIC", "FALSE")
+    if config.binding_cpus:
+        _set_affinity(config.binding_cpus)
+
+    environment = environment_for_host(_virtualization(), _cpufreq_available())
+    context = ProviderContext(threads=config.threads, binding_cpus=config.binding_cpus, environment=environment)
+    noise_start = _noise_sample()
+
+    registry_state = provider_registry_state(context)
+    probes = {item["provider_id"]: item["availability"] for item in registry_state}
+
+    specs = {}
+    for provider_id in config.providers:
+        try:
+            specs[provider_id] = get_provider_spec(provider_id)
+        except ProviderLookupError as exc:
+            raise RunError("unknown provider requested: {}".format(exc)) from exc
+
+    adapters: Dict[str, Optional[Any]] = {}
+    for provider_id in config.providers:
+        try:
+            adapters[provider_id] = get_provider(provider_id, context)
+        except Exception:  # noqa: BLE001 - probe already recorded the reason
+            adapters[provider_id] = None
+
+    reference_adapter = None
+    if config.reference_enabled:
+        try:
+            reference_adapter = get_provider(config.reference_provider, context)
+        except Exception:  # noqa: BLE001
+            reference_adapter = None
+    reference_cache = _ReferenceCache(adapter=reference_adapter, enabled=config.reference_enabled and reference_adapter is not None)
+
+    cost_model = _PortableCostModel()
+    cases: List[Mapping[str, Any]] = []
+    capability_filter: List[Mapping[str, Any]] = []
+
+    for provider_id in config.providers:
+        spec = specs[provider_id]
+        probe = probes[provider_id]
+        forced_unavailable = provider_id in config.inject_unavailable
+        adapter = adapters[provider_id]
+        for suite in config.suites:
+            entries = suite_entries(suite)
+            selected, filtered = _filter_entries(entries, spec)
+            capability_filter.append(
+                {
+                    "provider": provider_id,
+                    "suite": suite,
+                    "entries_total": len(entries),
+                    "entries_selected": len(selected),
+                    "filtered": filtered,
+                }
+            )
+            for case in build_cases(
+                selected,
+                provider=provider_id,
+                threads=_threads_for(spec, context),
+                binding=context.affinity_spec(),
+                base_seed=config.base_seed,
+            ):
+                if config.case_filter and not any(token in case.case_id for token in config.case_filter):
+                    cases.append(_case_skeleton_skipped(case, config))
+                    continue
+                cases.append(
+                    _measure_case(
+                        case=case,
+                        spec=spec,
+                        probe=probe,
+                        forced_unavailable=forced_unavailable,
+                        adapter=adapter,
+                        config=config,
+                        context=context,
+                        cost_model=cost_model,
+                        reference_cache=reference_cache,
+                    )
+                )
+
+    noise_end = _noise_sample()
+    report: Dict[str, Any] = {
+        "schema_version": SCHEMA_VERSION,
+        "report_kind": REPORT_KIND,
+        "generated_at_utc": _utc_now(),
+        "clock": _clock_block(config),
+        "commit": _git_provenance(repo_root),
+        "host_fingerprint": _host_fingerprint(environment),
+        "library_versions": [
+            {
+                "provider_id": item["provider_id"],
+                "declaration": {
+                    "library_name": item["declaration"]["library_name"],
+                    "version_pin": item["declaration"]["version_pin"],
+                    "build_options": item["declaration"]["build_options"],
+                    "sha256_pin": item["declaration"]["sha256_pin"],
+                },
+                "availability": item["availability"],
+                "fingerprint": item["availability"].get("fingerprint", {}),
+            }
+            for item in registry_state
+        ],
+        "provider_registry_state": registry_state,
+        "run_config": _run_config_dict(config),
+        "environment_noise": {"start": noise_start, "end": noise_end},
+        "capability_filter": capability_filter,
+        "comparability": _comparability(config.providers, specs),
+        "reference_cache": {
+            "enabled": reference_cache.enabled,
+            "provider": reference_adapter.spec.provider_id if reference_adapter is not None else None,
+            "unique_shapes": len(reference_cache.entries),
+            "seconds_total": reference_cache.seconds_total,
+        },
+        "cases": cases,
+        "status": "PASS",
+        "status_reason": "",
+        "protocol": {
+            "revision": PROTOCOL_REVISION,
+            "source": dict(PROTOCOL_SOURCE),
+            "ungated_status": UNGATED_STATUS,
+            "gate_reason": GATE_REASON,
+            "note": "op-bench introduces no threshold and no gate; numbers are raw observations",
+        },
+        "sha256": {},
+    }
+    report["status"], report["status_reason"] = _run_status(config, probes, cases)
+    report["error_injection"] = _error_injection(config, registry_state, report)
+    report["schema_validation"] = {"valid": True, "errors": []}
+
+    report["rounds_policy"] = (
+        "fixed: N={}".format(config.rounds)
+        if config.rounds is not None
+        else "auto: N = clamp(floor(case_budget / estimate), min_rounds, {})".format(MEASURED_ROUNDS)
+    )
+
+    if config.q8_vendor_matrix or config.q8_ratio_table:
+        attach_q8_alignment(
+            report,
+            vendor_matrix_path=config.q8_vendor_matrix,
+            ratio_table_path=config.q8_ratio_table,
+        )
+
+    errors = validate_report(report)
+    if errors:
+        report["schema_validation"] = {"valid": False, "errors": errors}
+        raise SchemaError(errors)
+    return report
+
+
+def run_selftest(config: Optional[RunConfig] = None, *, out_dir: Optional[str] = None) -> Mapping[str, Any]:
+    """Light self-test: schema validation + explicit error-injection results."""
+
+    active = config or RunConfig(
+        suites=("boundary",),
+        providers=("portable",),
+        threads=1,
+        binding_cpus=(0,),
+        case_budget_seconds=10.0,
+        min_rounds=3,
+        tag="op-bench-selftest",
+    )
+    report = run_report(active)
+    payload = {
+        "kind": "pypto-x.op-bench-selftest",
+        "generated_at_utc": _utc_now(),
+        "commit": report.get("commit"),
+        "host_fingerprint": report.get("host_fingerprint"),
+        "schema_validation": report.get("schema_validation"),
+        "error_injection": report.get("error_injection"),
+        "status": "PASS"
+        if report.get("schema_validation", {}).get("valid")
+        and all(item.get("verdict") == "PASS" for item in report.get("error_injection", []))
+        else "FAIL",
+    }
+    if out_dir:
+        os.makedirs(out_dir, exist_ok=True)
+        with open(os.path.join(out_dir, "op-bench-selftest.json"), "w", encoding="utf-8") as handle:
+            json.dump(payload, handle, indent=2, sort_keys=True, ensure_ascii=False)
+            handle.write("\n")
+    return payload
+
+
+def run_and_write(config: RunConfig) -> Mapping[str, Any]:
+    """Run, optionally repeat for reproducibility, validate and write artifacts."""
+
+    report = dict(run_report(config))
+    if config.repeat > 1:
+        repeats = [report]
+        for index in range(1, config.repeat):
+            repeated = dict(run_report(config))
+            repeats.append(repeated)
+        report["reproducibility"] = _reproducibility(repeats)
+    report["sha256"] = _framework_sha256(report.get("commit", {}).get("worktree") or config.repo_root or _find_repo_root())
+    if config.out_dir:
+        paths = write_artifacts(report, config.out_dir)
+        report["artifacts"] = paths
+        # re-validate after attaching artifact paths/reproducibility blocks
+        errors = validate_report(report)
+        report["schema_validation"] = {"valid": not errors, "errors": errors}
+        if errors:
+            raise SchemaError(errors)
+        write_artifacts(report, config.out_dir)
+    return report
+
+
+def _reproducibility(reports: Sequence[Mapping[str, Any]]) -> Mapping[str, Any]:
+    first = reports[0]
+    by_id_first = {case["case_id"]: case for case in first["cases"]}
+    structure_identical = True
+    rows = []
+    for report in reports[1:]:
+        by_id = {case["case_id"]: case for case in report["cases"]}
+        if set(by_id) != set(by_id_first):
+            structure_identical = False
+        for case_id in sorted(set(by_id) & set(by_id_first)):
+            a = by_id_first[case_id]
+            b = by_id[case_id]
+            if a["status"] != b["status"]:
+                structure_identical = False
+            if not a.get("seconds") or not b.get("seconds"):
+                rows.append(
+                    {
+                        "case_id": case_id,
+                        "status_a": a["status"],
+                        "status_b": b["status"],
+                        "median_delta": None,
+                        "within_dispersion": None,
+                    }
+                )
+                continue
+            median_a = float(a["seconds"]["median"])
+            median_b = float(b["seconds"]["median"])
+            disp_a = a["seconds"]["dispersion"]
+            disp_b = b["seconds"]["dispersion"]
+            limit = max(
+                float(disp_a.get("outlier_threshold") or 0.0),
+                float(disp_b.get("outlier_threshold") or 0.0),
+                1e-9,
+            )
+            rows.append(
+                {
+                    "case_id": case_id,
+                    "status_a": a["status"],
+                    "status_b": b["status"],
+                    "median_a": median_a,
+                    "median_b": median_b,
+                    "median_delta": abs(median_a - median_b),
+                    "dispersion_limit": limit,
+                    "within_dispersion": abs(median_a - median_b) <= limit,
+                    "dispersion_a_N": disp_a.get("N"),
+                    "dispersion_b_N": disp_b.get("N"),
+                }
+            )
+    return {
+        "repeats": len(reports),
+        "structure_identical": structure_identical,
+        "rule": "median delta <= max(ERR-0004 outlier threshold of either run); structure = same case ids/statuses",
+        "rows": rows,
+        "verdict": "PASS"
+        if structure_identical and all(row.get("within_dispersion") is not False for row in rows)
+        else "FAIL",
+    }
+
+
+# ---------------------------------------------------------------------------
+# one case
+# ---------------------------------------------------------------------------
+def _measure_case(
+    *,
+    case: OpCase,
+    spec: Any,
+    probe: Mapping[str, Any],
+    forced_unavailable: bool,
+    adapter: Optional[Any],
+    config: RunConfig,
+    context: ProviderContext,
+    cost_model: _PortableCostModel,
+    reference_cache: _ReferenceCache,
+) -> Mapping[str, Any]:
+    result = _case_skeleton(case)
+    try:
+        definition = case.contract_definition()
+        verified = case.validate(definition=definition)
+    except CaseError as exc:
+        result["status"] = "case_rejected"
+        result["error"] = exc.to_dict()
+        result["notes"] = "case rejected before measurement: {}".format(exc)
+        result["precision"] = _not_run_precision("case rejected: {}".format(exc))
+        return result
+    result["op_contract"] = dict(definition.contract_identity)
+    result["shape"] = dict(verified["shape"])
+    result["dtype"] = verified["dtype"]
+
+    if verified["dtype"] not in spec.supported_dtypes:
+        error = CaseError(
+            "dtype {!r} is outside provider {} dtype domain".format(verified["dtype"], spec.provider_id),
+            category="dtype_outside_provider_domain",
+            field="dtype",
+            requested=verified["dtype"],
+            available=list(spec.supported_dtypes),
+        )
+        result["status"] = "case_rejected"
+        result["error"] = error.to_dict()
+        result["precision"] = _not_run_precision(str(error))
+        return result
+
+    if spec.threads.supported and case.threads not in spec.threads.supported:
+        error = CaseError(
+            "provider {} supports threads {}, got {}".format(spec.provider_id, list(spec.threads.supported), case.threads),
+            category="illegal_knob",
+            field="threads",
+            requested=case.threads,
+            available=list(spec.threads.supported),
+        )
+        result["status"] = "case_rejected"
+        result["error"] = error.to_dict()
+        result["precision"] = _not_run_precision(str(error))
+        return result
+
+    if probe.get("state") != "available" or forced_unavailable:
+        reason = probe.get("reason") if not forced_unavailable else "injected_unavailable"
+        message = probe.get("message") if not forced_unavailable else "provider forced unavailable by --inject-unavailable"
+        result["status"] = "provider_unavailable"
+        result["error"] = {"category": "provider_unavailable", "reason": reason, "message": message}
+        result["precision"] = _not_run_precision("provider unavailable: {}".format(reason))
+        result["notes"] = "provider probe state {} ({}); case not measured".format(probe.get("state"), reason)
+        return result
+
+    if adapter is not None and hasattr(adapter, "check_case"):
+        try:
+            adapter.check_case(case, verified)
+        except Exception as exc:  # noqa: BLE001
+            result["status"] = "case_rejected"
+            result["error"] = {
+                "category": "provider_precondition",
+                "message": "{}: {}".format(type(exc).__name__, exc),
+            }
+            result["precision"] = _not_run_precision("provider precondition failed")
+            return result
+
+    _bind_case(case)
+    inputs = make_inputs(case, verified, base_seed=config.base_seed)
+    result["inputs"] = {"seed": inputs["seed"], "sha256": inputs["input_sha256"], "shape": inputs["shape"]}
+    macs = int(verified["shape"]["m"]) * int(verified["shape"]["k"]) * int(verified["shape"]["n"])
+    for dimension in verified["shape"]["batch_shape"]:
+        macs *= int(dimension)
+
+    if adapter is None:
+        result["status"] = "provider_error"
+        result["error"] = {"category": "adapter_missing", "message": "no adapter could be constructed"}
+        result["precision"] = _not_run_precision("adapter missing")
+        return result
+
+    estimate = cost_model.estimate(macs) if spec.kind == "portable" else None
+    if config.rounds is not None:
+        rounds = config.rounds
+        budget_decision = "fixed"
+    elif estimate is not None and not config.force_expensive and estimate * config.min_rounds > config.case_budget_seconds:
+        result["status"] = "not_run_budget"
+        result["notes"] = (
+            "estimated {:.3f} s/call ({} MACs at {:.3g} s/MAC) and min_rounds={} exceed the "
+            "{:.1f} s per-case budget; explicit not_run_budget, not a silent skip "
+            "(--force-expensive overrides)".format(
+                estimate, macs, cost_model.seconds_per_mac, config.min_rounds, config.case_budget_seconds
+            )
+        )
+        result["estimate"] = {
+            "macs": macs,
+            "estimated_seconds_per_call": estimate,
+            "case_budget_seconds": config.case_budget_seconds,
+            "min_rounds": config.min_rounds,
+        }
+        result["precision"] = _not_run_precision("not run: estimated cost exceeds per-case budget")
+        return result
+    elif estimate is None:
+        rounds = MEASURED_ROUNDS
+        budget_decision = "vendor_default_21"
+    else:
+        rounds = int(config.case_budget_seconds // max(estimate, 1e-9))
+        rounds = max(config.min_rounds, min(MEASURED_ROUNDS, rounds))
+        budget_decision = "auto"
+
+    iters = 1 if spec.kind == "portable" else int(config.iters)
+    warmup_rounds = int(config.warmup)
+    if estimate is not None and estimate * warmup_rounds > config.case_budget_seconds:
+        warmup_rounds = max(1, int(config.case_budget_seconds // max(estimate, 1e-9)))
+
+    samples: List[float] = []
+    op_samples: List[float] = []
+    call_wall_samples: List[float] = []
+    output_shas: List[str] = []
+    last_output: Optional[np.ndarray] = None
+    warmup_seconds: List[float] = []
+    reduced_rounds_reason = None
+    try:
+        prepared = adapter.prepare(case, inputs)
+        for _ in range(warmup_rounds):
+            per_call = []
+            for _ in range(iters):
+                last = adapter.run(prepared)
+                per_call.append(float(last["timing"]["wall_seconds"]))
+            warmup_seconds.append(statistics.fmean(per_call))
+            if "op_seconds" in last.get("timing", {}):
+                op_samples.append(float(last["timing"]["op_seconds"]))
+            if "call_wall_seconds" in last.get("timing", {}):
+                call_wall_samples.append(float(last["timing"]["call_wall_seconds"]))
+            last_output = last["output"]
+            output_shas.append(last.get("output_sha256") or buffer_sha256(verified["dtype"], last_output))
+        if estimate is not None and warmup_seconds:
+            cost_model.observe(macs, statistics.median(warmup_seconds))
+            refined = cost_model.estimate(macs)
+            if round(config.case_budget_seconds // max(refined, 1e-9)) < rounds:
+                rounds = max(1, int(config.case_budget_seconds // max(refined, 1e-9)))
+                reduced_rounds_reason = "actual warmup cost higher than estimate; rounds reduced to fit budget"
+        for _ in range(rounds):
+            per_call = []
+            for _ in range(iters):
+                last = adapter.run(prepared)
+                per_call.append(float(last["timing"]["wall_seconds"]))
+            samples.append(statistics.fmean(per_call))
+            if "op_seconds" in last.get("timing", {}):
+                op_samples.append(float(last["timing"]["op_seconds"]))
+            if "call_wall_seconds" in last.get("timing", {}):
+                call_wall_samples.append(float(last["timing"]["call_wall_seconds"]))
+            last_output = last["output"]
+            output_shas.append(last.get("output_sha256") or buffer_sha256(verified["dtype"], last_output))
+    except Exception as exc:  # noqa: BLE001 - provider failure must be explicit
+        result["status"] = "provider_error"
+        result["error"] = {"category": "provider_execution_error", "message": "{}: {}".format(type(exc).__name__, exc)}
+        result["precision"] = _not_run_precision("provider execution failed")
+        return result
+
+    stats = dispersion(samples, environment=context.environment)
+    warmup_last = statistics.median(warmup_seconds) if warmup_seconds else float("nan")
+    warm = warmup_verdict(samples, warmup_last)
+    result["status"] = "ok"
+    result["seconds"] = {
+        "median": stats.get("median"),
+        "dispersion": stats,
+        "N": stats.get("N", 0),
+        "samples_seconds": samples,
+        "iters_per_round": iters,
+        "rounds_policy": "{}:{}".format(budget_decision, rounds) if not reduced_rounds_reason else "auto_reduced",
+        "warmup_rounds": warmup_rounds,
+        "warmup_seconds": warmup_seconds,
+        "warmup_verdict": warm,
+        "op_median": statistics.median(op_samples) if op_samples else None,
+        "call_wall_median": statistics.median(call_wall_samples) if call_wall_samples else None,
+        "dispatch_median": (
+            statistics.median(call_wall_samples) - statistics.median(op_samples)
+            if op_samples and call_wall_samples
+            else None
+        ),
+        "gate_eligible": stats.get("N", 0) >= 11 and stats.get("verdict") == "VALID",
+        "ungated": True,
+        "note": "headline median is the provider call wall time; see provider timing_semantics",
+    }
+    if spec.kind == "portable":
+        result["seconds"]["portable_cost_model"] = {
+            "seconds_per_mac": cost_model.seconds_per_mac,
+            "macs": macs,
+            "estimate_seconds": estimate,
+        }
+    result["timing_semantics"] = spec.timing.to_dict()
+    if reduced_rounds_reason:
+        result["seconds"]["rounds_reduced_reason"] = reduced_rounds_reason
+
+    if spec.precision.precision_class == PRECISION_BIT_EXACT and spec.precision.reference_provider is None:
+        result["precision"] = _portable_self_precision(case, verified, inputs, last_output, output_shas, spec)
+    else:
+        reference = reference_cache.get(case, verified, inputs)
+        if reference.get("status") == "disabled":
+            result["precision"] = {
+                "class": spec.precision.precision_class,
+                "basis": spec.precision.basis,
+                "band_source": spec.precision.band_source,
+                "reduction_order_id": spec.precision.reduction_order_id,
+                "reference_provider": spec.precision.reference_provider,
+                "verdict": "NOT_EVALUATED",
+                "semantic_difference": {"is_different": None, "reasons": ["reference disabled by run config"]},
+                "bug_triage": {"verdict": "NOT_APPLICABLE", "reason": "correctness check disabled (--no-reference)"},
+            }
+        elif reference.get("status") != "ok":
+            result["status"] = "reference_unavailable"
+            result["precision"] = _not_run_precision(
+                "reference {}: {}".format(reference.get("status"), reference.get("error", reference.get("reason")))
+            )
+        else:
+            result["reference"] = {
+                "provider": reference.get("provider"),
+                "sha256": reference.get("output_sha256"),
+                "wall_seconds": reference.get("wall_seconds"),
+            }
+            result["precision"] = precision_module.compare_outputs(
+                dtype=verified["dtype"],
+                inputs=inputs,
+                reference=np.asarray(reference["output"]),
+                candidate=np.asarray(last_output),
+                provider_spec=spec.precision.to_dict(),
+                reference_meta={
+                    "provider_id": reference.get("provider"),
+                    "class": PRECISION_BIT_EXACT,
+                    "reduction_order_id": "portable_serial_k_ascending_v1",
+                },
+                reference_sha256=reference.get("output_sha256") or "",
+                candidate_sha256=output_shas[-1] if output_shas else "",
+            )
+    result["notes"] = _case_notes(spec)
+    return result
+
+
+def _portable_self_precision(
+    case: OpCase,
+    verified: Mapping[str, Any],
+    inputs: Mapping[str, Any],
+    candidate: np.ndarray,
+    output_shas: Sequence[str],
+    spec: Any,
+) -> Mapping[str, Any]:
+    """bit_exact verdict = byte-identical repeated outputs; oracle = secondary."""
+
+    identical = len(set(output_shas)) <= 1
+    oracle = oracle_matmul(inputs)
+    oracle_spec = {
+        "class": PRECISION_BOUNDED,
+        "basis": "independent numpy float64 oracle cast to the case output dtype",
+        "band_source": "derived: same band function as vendor cases",
+        "reduction_order_id": "numpy_float64_matmul_then_cast_v1",
+    }
+    oracle_block = precision_module.compare_outputs(
+        dtype=verified["dtype"],
+        inputs=inputs,
+        reference=oracle,
+        candidate=np.asarray(candidate),
+        provider_spec=oracle_spec,
+        reference_meta={
+            "provider_id": "numpy.float64.oracle",
+            "class": PRECISION_BOUNDED,
+            "reduction_order_id": "numpy_float64_matmul_then_cast_v1",
+        },
+        reference_sha256=buffer_sha256(verified["dtype"], oracle),
+        candidate_sha256=output_shas[-1] if output_shas else "",
+    )
+    return {
+        "class": PRECISION_BIT_EXACT,
+        "basis": spec.precision.basis,
+        "band_source": None,
+        "reduction_order_id": spec.precision.reduction_order_id,
+        "reference_provider": None,
+        "reference_sha256": output_shas[0] if output_shas else None,
+        "candidate_sha256": output_shas[-1] if output_shas else None,
+        "bitwise_equal": identical,
+        "determinism": {
+            "outputs_sha256": list(output_shas),
+            "identical": identical,
+            "note": "all measured/warmup portable outputs must be byte-identical for the bit_exact class",
+        },
+        "verdict": precision_module.VERDICT_EXACT if identical else precision_module.VERDICT_BITWISE_MISMATCH,
+        "semantic_difference": {"is_different": False, "reasons": ["reference path compared against itself"]},
+        "bug_triage": {
+            "verdict": precision_module.TRIAGE_NOT_APPLICABLE if identical else precision_module.TRIAGE_SUSPECTED_BUG,
+            "reason": "repeated portable outputs identical" if identical else "portable outputs differ between rounds",
+        },
+        "independent_oracle": oracle_block,
+    }
+
+
+# ---------------------------------------------------------------------------
+# report assembly helpers
+# ---------------------------------------------------------------------------
+def _case_skeleton(case: OpCase) -> Dict[str, Any]:
+    return {
+        "case_id": case.case_id,
+        "suite": case.suite,
+        "label": case.label,
+        "op": case.op,
+        "op_contract": {"opcode": case.op, "version": "unregistered", "digest": "unregistered"},
+        "shape": {name: list(dims) for name, dims in case.shape.items()},
+        "dtype": case.dtype,
+        "provider": case.provider,
+        "knobs": {
+            "threads": case.threads,
+            "binding": case.binding,
+            "layout_policy": case.layout_policy,
+            "inputs_seed": case.inputs_seed,
+        },
+        "status": "case_rejected",
+        "seconds": None,
+        "precision": _not_run_precision("not measured"),
+        "notes": "",
+    }
+
+
+def _case_skeleton_skipped(case: OpCase, config: RunConfig) -> Mapping[str, Any]:
+    result = _case_skeleton(case)
+    result["status"] = "skipped_user_request"
+    result["notes"] = "case does not match --case-filter {}".format(list(config.case_filter))
+    result["precision"] = _not_run_precision("skipped by --case-filter")
+    return result
+
+
+def _not_run_precision(reason: str) -> Mapping[str, Any]:
+    return {
+        "class": "not_applicable",
+        "basis": "no measurement",
+        "verdict": "NOT_RUN",
+        "band_source": None,
+        "reduction_order_id": None,
+        "semantic_difference": {"is_different": None, "reasons": [reason]},
+        "bug_triage": {"verdict": "NOT_APPLICABLE", "reason": reason},
+    }
+
+
+def _case_notes(spec: Any) -> str:
+    timing = spec.timing
+    return (
+        "timing_semantics: pack={} alloc={} first_jit={} compile={} dispatch={}; threads={} ({})".format(
+            timing.includes_pack, timing.includes_alloc, timing.includes_first_jit,
+            timing.includes_compile, timing.includes_dispatch, spec.threads.knob,
+            spec.threads.notes or "n/a",
+        )
+    )
+
+
+def _filter_entries(entries: Sequence[Mapping[str, Any]], spec: Any) -> Tuple[List[Mapping[str, Any]], List[Mapping[str, Any]]]:
+    selected: List[Mapping[str, Any]] = []
+    filtered: Dict[Tuple[str, str], int] = {}
+    for entry in entries:
+        if entry.get("expectation") == "must_reject":
+            # deliberate invalid cases stay in the report so the rejection is explicit
+            selected.append(entry)
+            continue
+        op = entry.get("op")
+        if op not in spec.supported_ops:
+            key = ("op_outside_provider_domain", str(op))
+            filtered[key] = filtered.get(key, 0) + 1
+            continue
+        if entry.get("dtype") not in spec.supported_dtypes:
+            key = ("dtype_outside_provider_domain", str(entry.get("dtype")))
+            filtered[key] = filtered.get(key, 0) + 1
+            continue
+        selected.append(entry)
+    return selected, [
+        {"reason": reason, "detail": detail, "count": count}
+        for (reason, detail), count in sorted(filtered.items())
+    ]
+
+
+def _threads_for(spec: Any, context: ProviderContext) -> int:
+    supported = spec.threads.supported
+    if supported:
+        return int(supported[0])
+    return int(context.threads)
+
+
+def _bind_case(case: OpCase) -> None:
+    if case.binding == "none":
+        return
+    if case.binding.startswith("affinity:"):
+        cpus = parse_cpu_list(case.binding[len("affinity:"):])
+        if cpus:
+            try:
+                os.sched_setaffinity(0, cpus)
+            except OSError:
+                pass
+
+
+def _set_affinity(cpus: Sequence[int]) -> None:
+    try:
+        os.sched_setaffinity(0, list(cpus))
+    except OSError:
+        pass
+
+
+def _comparability(providers: Sequence[str], specs: Mapping[str, Any]) -> Mapping[str, Any]:
+    pairs = []
+    for index, first in enumerate(providers):
+        for second in providers[index + 1:]:
+            a = specs[first].timing.to_dict()
+            b = specs[second].timing.to_dict()
+            differences = [
+                key for key in ("includes_pack", "includes_alloc", "includes_first_jit", "includes_compile", "includes_dispatch")
+                if a.get(key) != b.get(key)
+            ]
+            pairs.append(
+                {
+                    "a": first,
+                    "b": second,
+                    "directly_comparable": not differences,
+                    "differences": differences,
+                    "not_directly_comparable": bool(differences),
+                    "note": "timing semantics differ; do not read a raw ratio across this pair as a speedup"
+                    if differences
+                    else "same declared timing semantics",
+                }
+            )
+    return {"pairs": pairs, "rule": "directly comparable only if every timing-semantics boolean matches"}
+
+
+def _run_status(
+    config: RunConfig,
+    probes: Mapping[str, Mapping[str, Any]],
+    cases: Sequence[Mapping[str, Any]],
+) -> Tuple[str, str]:
+    reasons = []
+    hard = any(case["status"] in ("provider_error", "reference_unavailable") for case in cases)
+    if hard:
+        reasons.append("hard failures present")
+    for provider_id in config.providers:
+        if provider_id in config.inject_unavailable:
+            reasons.append("{}: injected unavailable".format(provider_id))
+            continue
+        if probes.get(provider_id, {}).get("state") != "available":
+            reasons.append("{}: unavailable ({})".format(provider_id, probes.get(provider_id, {}).get("reason")))
+    if any(case["status"] == "not_run_budget" for case in cases):
+        reasons.append("explicit not_run_budget cases present")
+    if hard:
+        return "FAIL", "; ".join(reasons)
+    if reasons:
+        return "PARTIAL", "; ".join(reasons)
+    return "PASS", "; ".join(reasons) or "all cases measured"
+
+
+def _run_config_dict(config: RunConfig) -> Mapping[str, Any]:
+    return {
+        "tag": config.tag,
+        "suites": list(config.suites),
+        "providers": list(config.providers),
+        "base_seed": config.base_seed,
+        "threads": config.threads,
+        "binding_cpus": list(config.binding_cpus),
+        "binding": "affinity:" + format_cpu_list(config.binding_cpus) if config.binding_cpus else "none",
+        "rounds": config.rounds,
+        "case_budget_seconds": config.case_budget_seconds,
+        "min_rounds": config.min_rounds,
+        "iters": config.iters,
+        "warmup": config.warmup,
+        "reference_provider": config.reference_provider,
+        "reference_enabled": config.reference_enabled,
+        "force_expensive": config.force_expensive,
+        "inject_unavailable": list(config.inject_unavailable),
+        "repeat": config.repeat,
+        "case_filter": list(config.case_filter),
+    }
+
+
+# ---------------------------------------------------------------------------
+# environment / provenance
+# ---------------------------------------------------------------------------
+def _utc_now() -> str:
+    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def _clock_block(config: RunConfig) -> Mapping[str, Any]:
+    return {
+        "source": config.clock_source,
+        "utc_offset_seconds_estimate": config.clock_offset_seconds,
+        "note": "timestamps use the host clock; platforms whose clock is offset from the controller "
+        "must pass --clock-source/--clock-offset-seconds (A3 is ~366 s slow, Q8b measurement)",
+    }
+
+
+def _framework_sha256(repo_root: str) -> Mapping[str, Any]:
+    """sha256 of the framework source files, so every report is reproducible."""
+
+    package_dir = os.path.dirname(os.path.abspath(__file__))
+    files = sorted(
+        os.path.join(package_dir, name)
+        for name in os.listdir(package_dir)
+        if name.endswith(".py")
+    )
+    entry = os.path.join(repo_root, "scripts", "perf", "op_bench.py")
+    if os.path.exists(entry):
+        files.append(entry)
+    digests = {}
+    for path in files:
+        try:
+            digest = hashlib.sha256(open(path, "rb").read()).hexdigest()
+        except OSError:
+            continue
+        digests[os.path.relpath(path, repo_root)] = digest
+    return {"files": digests, "file_count": len(digests)}
+
+
+def _git_provenance(repo_root: str) -> Mapping[str, Any]:
+    def run(args: Sequence[str]) -> str:
+        try:
+            return subprocess.run(
+                ["git", *args], cwd=repo_root, capture_output=True, text=True, timeout=10
+            ).stdout.strip()
+        except (OSError, subprocess.SubprocessError):
+            return ""
+
+    return {
+        "sha": run(["rev-parse", "HEAD"]) or "unknown",
+        "branch": run(["rev-parse", "--abbrev-ref", "HEAD"]) or "unknown",
+        "dirty": bool(run(["status", "--porcelain"])),
+        "worktree": repo_root,
+    }
+
+
+def _find_repo_root() -> str:
+    here = os.path.dirname(os.path.abspath(__file__))
+    for _ in range(8):
+        here = os.path.dirname(here)
+        if os.path.isdir(os.path.join(here, ".git")) or os.path.isfile(os.path.join(here, ".git")):
+            return here
+    return os.getcwd()
+
+
+def _cpu_model() -> str:
+    try:
+        with open("/proc/cpuinfo", "r", encoding="utf-8", errors="replace") as handle:
+            for line in handle:
+                if line.lower().startswith(("model name", "hardware", "cpu part")):
+                    return line.split(":", 1)[1].strip()
+    except OSError:
+        pass
+    return platform.processor() or "unknown"
+
+
+def _virtualization() -> str:
+    try:
+        result = subprocess.run(["systemd-detect-virt"], capture_output=True, text=True, timeout=5)
+        value = result.stdout.strip()
+        if value and value != "none":
+            return value
+    except (OSError, subprocess.SubprocessError):
+        pass
+    try:
+        with open("/proc/cpuinfo", "r", encoding="utf-8", errors="replace") as handle:
+            if "hypervisor" in handle.read():
+                return "hypervisor"
+    except OSError:
+        pass
+    return "none"
+
+
+def _cpufreq_available() -> bool:
+    return os.path.exists("/sys/devices/system/cpu/cpu0/cpufreq")
+
+
+def _meminfo(field: str) -> int:
+    try:
+        with open("/proc/meminfo", "r", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith(field + ":"):
+                    return int(line.split()[1])
+    except (OSError, ValueError):
+        pass
+    return 0
+
+
+def _host_fingerprint(environment: str) -> Mapping[str, Any]:
+    affinity = sorted(os.sched_getaffinity(0))
+    payload = {
+        "cpu_model": _cpu_model(),
+        "nproc_online": os.cpu_count(),
+        "cpu_affinity": affinity,
+        "virtualization": _virtualization(),
+        "cpufreq_available": _cpufreq_available(),
+        "mem_total_mib": round(_meminfo("MemTotal") / 1024.0, 1),
+        "uname": dict(platform.uname()._asdict()),
+        "python": sys.version.split()[0],
+        "protocol_environment": environment,
+    }
+    material = "|".join(
+        str(payload.get(key)) for key in ("cpu_model", "nproc_online", "cpu_affinity", "virtualization",
+                                          "cpufreq_available", "mem_total_mib")
+    )
+    payload["digest"] = hashlib.sha256(material.encode("utf-8")).hexdigest()
+    return payload
+
+
+def _noise_sample() -> Mapping[str, Any]:
+    sample: Dict[str, Any] = {}
+    try:
+        with open("/proc/loadavg", "r", encoding="utf-8") as handle:
+            fields = handle.read().split()
+        sample["load1"] = float(fields[0])
+        sample["runnable"] = int(fields[3].split("/")[0])
+    except (OSError, ValueError, IndexError):
+        pass
+    try:
+        with open("/proc/pressure/cpu", "r", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("some "):
+                    for token in line.split():
+                        if token.startswith("avg10="):
+                            sample["cpu_psi_avg10"] = float(token.split("=")[1])
+    except (OSError, ValueError):
+        pass
+    sample["available_mib"] = round(_meminfo("MemAvailable") / 1024.0, 1)
+    sample["cpufreq_available"] = _cpufreq_available()
+    return sample
+
+
+# ---------------------------------------------------------------------------
+# error injection
+# ---------------------------------------------------------------------------
+def _error_injection(
+    config: RunConfig,
+    registry_state: Sequence[Mapping[str, Any]],
+    report: Mapping[str, Any],
+) -> List[Mapping[str, Any]]:
+    from .object_model import OpCase
+    from .providers import get_provider_spec
+
+    checks: List[Mapping[str, Any]] = []
+
+    def record(check: str, expected: str, observed: Any, passed: bool, details: Any = None) -> None:
+        checks.append(
+            {
+                "check": check,
+                "expected": expected,
+                "observed": observed if isinstance(observed, str) else json.dumps(observed, ensure_ascii=False)[:400],
+                "verdict": "PASS" if passed else "FAIL",
+                "details": details,
+            }
+        )
+
+    # 1. unknown provider id -> explicit lookup error
+    try:
+        get_provider_spec("vendor:not-registered")
+        record("unknown_provider_rejected", "ProviderLookupError", "no error raised", False)
+    except ProviderLookupError as exc:
+        record("unknown_provider_rejected", "ProviderLookupError", "ProviderLookupError: {}".format(exc), True)
+
+    # 2. library version mismatch (sha256 pin) -> unavailable, not a skip
+    from .provider_aocl import AOCL_LIBRARY_ENV, AoclLpgemmBf16Adapter
+
+    previous = os.environ.get(AOCL_LIBRARY_ENV)
+    with tempfile.NamedTemporaryFile("w", suffix=".so", delete=False) as handle:
+        handle.write("not a real aocl library\n")
+        wrong_path = handle.name
+    try:
+        os.environ[AOCL_LIBRARY_ENV] = wrong_path
+        probe = AoclLpgemmBf16Adapter(ProviderContext(threads=config.threads, binding_cpus=config.binding_cpus)).probe()
+        record(
+            "library_sha256_mismatch_detected",
+            "state=unavailable reason=library_sha256_mismatch",
+            "state={} reason={}".format(probe.state, probe.reason),
+            probe.state == "unavailable" and probe.reason == "library_sha256_mismatch",
+        )
+    finally:
+        if previous is None:
+            os.environ.pop(AOCL_LIBRARY_ENV, None)
+        else:
+            os.environ[AOCL_LIBRARY_ENV] = previous
+        os.unlink(wrong_path)
+
+    # 3. illegal knob combinations -> explicit CaseError
+    def expect_case_error(label: str, error_category: str, **overrides: Any) -> None:
+        data = {
+            "op": "matmul",
+            "shape": {"left": [2, 4], "right": [4, 2], "output": [2, 2]},
+            "dtype": "float32",
+            "provider": "portable",
+            "threads": 1,
+            "binding": "none",
+            "layout_policy": "row_major",
+            "inputs_seed": 1,
+            "extra": {"case_id": label, "suite": "error-injection"},
+        }
+        data.update(overrides)
+        try:
+            OpCase(**data).validate()
+            record(label, error_category, "no error raised", False)
+        except CaseError as exc:
+            record(label, error_category, "{}: {}".format(exc.category, exc), exc.category == error_category)
+
+    expect_case_error("illegal_knob_threads_zero", "illegal_knob", threads=0)
+    expect_case_error("illegal_knob_layout_policy", "illegal_knob", layout_policy="non_unit_stride")
+    expect_case_error("forbidden_attribute_rejected", "attribute_not_supported", extra={"case_id": "attr", "suite": "error-injection", "attributes": {"transpose_b": True}})
+    expect_case_error("unregistered_opcode_rejected", "opcode_not_registered", op="reduce_sum")
+
+    # 4. schema validation: a report missing a required field must fail
+    mutated = json.loads(json.dumps(report, default=str))
+    try:
+        mutated["cases"][0].pop("seconds", None)
+    except (KeyError, TypeError, IndexError):
+        pass
+    errors = validate_report(mutated)
+    record(
+        "schema_missing_field_fails",
+        "missing cases[].seconds is detected",
+        "{} schema error(s)".format(len(errors)),
+        bool(errors),
+        details=errors[:3],
+    )
+
+    # 5. provider unavailable propagation (injected or real)
+    injected = [case for case in report.get("cases", []) if case.get("provider") in config.inject_unavailable]
+    if injected:
+        ok = all(case["status"] == "provider_unavailable" for case in injected)
+        record(
+            "injected_provider_unavailable_propagated",
+            "every case of the injected provider is provider_unavailable",
+            "{} cases".format(len(injected)),
+            ok,
+        )
+    else:
+        states = {item["provider_id"]: item["availability"]["state"] for item in registry_state}
+        ok = all(state in ("available", "unavailable") for state in states.values())
+        record("provider_availability_explicit", "every provider has an explicit availability state", states, ok)
+
+    # 6. declared timing semantics present for every provider
+    missing = [
+        item["provider_id"]
+        for item in registry_state
+        if not all(
+            key in item["declaration"]["timing_semantics"]
+            for key in ("includes_pack", "includes_alloc", "includes_first_jit", "timed_region")
+        )
+    ]
+    record("timing_semantics_declared", "all providers declare pack/alloc/JIT/region", missing or "all declared", not missing)
+    return checks
+
+
+__all__ = ["RunConfig", "RunError", "run_and_write", "run_report", "run_selftest"]
