+++ b/python/pypto/op_bench/schema.py
@@ -0,0 +1,370 @@
+"""Machine-readable report schema + a dependency-free validator.
+
+The schema follows planning doc 0007 section 6: top-level
+``host_fingerprint`` / ``library_versions`` / ``provider_registry_state`` and
+``cases`` entries with ``op, shape, dtype, provider, knobs, seconds
+{median, dispersion, N}, precision {class, basis, verdict}, notes``.  The
+runner validates every report before writing it; a missing field is a hard
+failure (``SchemaError``), never a warning.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any, List, Mapping, Sequence
+
+
+SCHEMA_VERSION = 1
+REPORT_KIND = "pypto-x.op-bench-report"
+
+_STRING = {"type": "string"}
+_NUMBER = {"type": "number"}
+_INTEGER = {"type": "integer"}
+
+_DISPERSION = {
+    "type": "object",
+    "required": ["N", "median", "cv", "verdict"],
+    "properties": {
+        "N": _INTEGER,
+        "median": _NUMBER,
+        "min": _NUMBER,
+        "p95": _NUMBER,
+        "max": _NUMBER,
+        "mean": _NUMBER,
+        "stdev": _NUMBER,
+        "cv": _NUMBER,
+        "p95_over_median": _NUMBER,
+        "mad": _NUMBER,
+        "outlier_threshold": _NUMBER,
+        "outlier_floor": _NUMBER,
+        "outliers_marked": _INTEGER,
+        "outlier_ratio": _NUMBER,
+        "verdict": _STRING,
+    },
+    "additionalProperties": True,
+}
+
+_SECONDS = {
+    "type": "object",
+    "required": ["median", "dispersion", "N"],
+    "properties": {
+        "median": {"oneOf": [_NUMBER, {"type": "null"}]},
+        "dispersion": {"oneOf": [_DISPERSION, {"type": "null"}]},
+        "N": _INTEGER,
+        "samples": {"type": "array", "items": _NUMBER},
+        "samples_seconds": {"type": "array", "items": _NUMBER},
+        "iters_per_round": _INTEGER,
+        "rounds_policy": _STRING,
+        "cache_state": _STRING,
+        "op_median": {"oneOf": [_NUMBER, {"type": "null"}]},
+        "dispatch_median": {"oneOf": [_NUMBER, {"type": "null"}]},
+    },
+    "additionalProperties": True,
+}
+
+_PRECISION = {
+    "type": "object",
+    "required": ["class", "basis", "verdict"],
+    "properties": {
+        "class": {"type": "string", "enum": ["bit_exact", "bounded_tolerance", "not_applicable"]},
+        "basis": _STRING,
+        "verdict": _STRING,
+        "band_source": {"oneOf": [_STRING, {"type": "null"}]},
+        "band_max": {"oneOf": [_NUMBER, {"type": "null"}]},
+        "max_abs_diff": {"oneOf": [_NUMBER, {"type": "null"}]},
+        "elements_over_band": {"oneOf": [_INTEGER, {"type": "null"}]},
+        "bitwise_equal": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
+        "semantic_difference": {"type": "object"},
+        "bug_triage": {"type": "object"},
+    },
+    "additionalProperties": True,
+}
+
+_CASE = {
+    "type": "object",
+    "required": [
+        "case_id",
+        "op",
+        "op_contract",
+        "shape",
+        "dtype",
+        "provider",
+        "knobs",
+        "status",
+        "seconds",
+        "precision",
+        "notes",
+    ],
+    "properties": {
+        "case_id": _STRING,
+        "op": _STRING,
+        "op_contract": {
+            "type": "object",
+            "required": ["opcode", "version", "digest"],
+            "properties": {"opcode": _STRING, "version": _STRING, "digest": _STRING},
+            "additionalProperties": True,
+        },
+        "shape": {"type": "object"},
+        "dtype": _STRING,
+        "provider": _STRING,
+        "knobs": {
+            "type": "object",
+            "required": ["threads", "binding", "layout_policy", "inputs_seed"],
+            "properties": {
+                "threads": _INTEGER,
+                "binding": _STRING,
+                "layout_policy": _STRING,
+                "inputs_seed": _INTEGER,
+            },
+            "additionalProperties": True,
+        },
+        "status": {
+            "type": "string",
+            "enum": [
+                "ok",
+                "provider_unavailable",
+                "case_rejected",
+                "provider_error",
+                "not_run_budget",
+                "reference_unavailable",
+                "skipped_user_request",
+            ],
+        },
+        "seconds": {"oneOf": [_SECONDS, {"type": "null"}]},
+        "precision": _PRECISION,
+        "notes": _STRING,
+    },
+    "additionalProperties": True,
+}
+
+REPORT_SCHEMA: Mapping[str, Any] = {
+    "$schema": "http://json-schema.org/draft-07/schema#",
+    "title": "pypto-x op-bench report",
+    "type": "object",
+    "required": [
+        "schema_version",
+        "report_kind",
+        "generated_at_utc",
+        "clock",
+        "commit",
+        "host_fingerprint",
+        "library_versions",
+        "provider_registry_state",
+        "run_config",
+        "cases",
+        "error_injection",
+        "protocol",
+        "sha256",
+    ],
+    "properties": {
+        "schema_version": {"type": "integer", "const": SCHEMA_VERSION},
+        "report_kind": {"type": "string", "const": REPORT_KIND},
+        "generated_at_utc": _STRING,
+        "clock": {
+            "type": "object",
+            "required": ["source", "utc_offset_seconds_estimate"],
+            "properties": {
+                "source": _STRING,
+                "utc_offset_seconds_estimate": {"oneOf": [_NUMBER, {"type": "null"}]},
+                "note": _STRING,
+            },
+            "additionalProperties": True,
+        },
+        "commit": {
+            "type": "object",
+            "required": ["sha", "branch", "dirty"],
+            "properties": {"sha": _STRING, "branch": _STRING, "dirty": {"type": "boolean"}},
+            "additionalProperties": True,
+        },
+        "host_fingerprint": {
+            "type": "object",
+            "required": ["digest", "cpu_model", "nproc_online", "cpu_affinity", "virtualization"],
+            "properties": {
+                "digest": _STRING,
+                "cpu_model": _STRING,
+                "nproc_online": _INTEGER,
+                "cpu_affinity": {"type": "array", "items": _INTEGER},
+                "virtualization": _STRING,
+            },
+            "additionalProperties": True,
+        },
+        "library_versions": {"type": "array", "items": {"type": "object"}},
+        "provider_registry_state": {
+            "type": "array",
+            "items": {
+                "type": "object",
+                "required": ["provider_id", "declaration", "availability"],
+                "properties": {
+                    "provider_id": _STRING,
+                    "declaration": {
+                        "type": "object",
+                        "required": [
+                            "provider_id",
+                            "kind",
+                            "timing_semantics",
+                            "thread_semantics",
+                            "precision_semantics",
+                        ],
+                        "properties": {
+                            "timing_semantics": {
+                                "type": "object",
+                                "required": [
+                                    "includes_pack",
+                                    "includes_alloc",
+                                    "includes_first_jit",
+                                    "timed_region",
+                                ],
+                            },
+                            "thread_semantics": {
+                                "type": "object",
+                                "required": ["knob", "supported_threads", "binding_knob"],
+                            },
+                            "precision_semantics": {
+                                "type": "object",
+                                "required": ["class", "basis", "reduction_order_id"],
+                            },
+                        },
+                        "additionalProperties": True,
+                    },
+                    "availability": {
+                        "type": "object",
+                        "required": ["state", "reason"],
+                        "properties": {
+                            "state": {"type": "string", "enum": ["available", "unavailable"]},
+                            "reason": _STRING,
+                        },
+                        "additionalProperties": True,
+                    },
+                },
+                "additionalProperties": True,
+            },
+        },
+        "run_config": {"type": "object"},
+        "cases": {"type": "array", "items": _CASE, "minItems": 1},
+        "error_injection": {"type": "array", "items": {"type": "object"}},
+        "protocol": {
+            "type": "object",
+            "required": ["revision", "source", "ungated_status", "gate_reason"],
+            "properties": {
+                "revision": _STRING,
+                "source": {"type": "object"},
+                "ungated_status": _STRING,
+                "gate_reason": _STRING,
+            },
+            "additionalProperties": True,
+        },
+        "sha256": {"type": "object"},
+    },
+    "additionalProperties": True,
+}
+
+
+class SchemaError(Exception):
+    """A report failed schema validation (missing/mistyped field)."""
+
+    def __init__(self, errors: Sequence[str]) -> None:
+        self.errors = list(errors)
+        super().__init__("op-bench report schema invalid: " + "; ".join(self.errors[:8]))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"category": "schema_invalid", "errors": list(self.errors)}
+
+
+def validate_report(report: Mapping[str, Any]) -> List[str]:
+    """Return a list of human-readable schema violations (empty means valid)."""
+
+    return _validate(report, REPORT_SCHEMA, "$")
+
+
+def assert_valid_report(report: Mapping[str, Any]) -> None:
+    errors = validate_report(report)
+    if errors:
+        raise SchemaError(errors)
+
+
+def schema_json() -> str:
+    return json.dumps(REPORT_SCHEMA, indent=2, sort_keys=True)
+
+
+# -- tiny draft-07 subset validator ------------------------------------------
+def _type_name(value: Any) -> str:
+    if value is None:
+        return "null"
+    if isinstance(value, bool):
+        return "boolean"
+    if isinstance(value, int):
+        return "integer"
+    if isinstance(value, float):
+        return "number"
+    if isinstance(value, str):
+        return "string"
+    if isinstance(value, list):
+        return "array"
+    if isinstance(value, dict):
+        return "object"
+    return type(value).__name__
+
+
+def _matches_type(value: Any, expected: str) -> bool:
+    actual = _type_name(value)
+    if expected == "number":
+        return actual in ("number", "integer")
+    if expected == "integer":
+        return actual == "integer"
+    return actual == expected
+
+
+def _validate(value: Any, schema: Mapping[str, Any], path: str) -> List[str]:
+    errors: List[str] = []
+
+    if "oneOf" in schema:
+        matches = [candidate for candidate in schema["oneOf"] if not _validate(value, candidate, path)]
+        if len(matches) != 1:
+            errors.append("{}: expected exactly one of {}".format(path, [c.get("type", "?") for c in schema["oneOf"]]))
+        return errors
+
+    if "const" in schema and value != schema["const"]:
+        errors.append("{}: expected const {!r}, got {!r}".format(path, schema["const"], value))
+
+    if "enum" in schema and value not in schema["enum"]:
+        errors.append("{}: value {!r} not in enum {}".format(path, value, schema["enum"]))
+
+    expected_type = schema.get("type")
+    if expected_type is not None and not _matches_type(value, expected_type):
+        errors.append("{}: expected type {}, got {}".format(path, expected_type, _type_name(value)))
+        return errors
+
+    if isinstance(value, dict):
+        for name in schema.get("required", []):
+            if name not in value:
+                errors.append("{}.{}: missing required field".format(path, name))
+        properties = schema.get("properties", {})
+        for name, child in properties.items():
+            if name in value:
+                errors.extend(_validate(value[name], child, "{}.{}".format(path, name)))
+        if schema.get("additionalProperties") is False:
+            extra = sorted(set(value) - set(properties))
+            if extra:
+                errors.append("{}: additional properties not allowed: {}".format(path, extra))
+    elif isinstance(value, list):
+        item_schema = schema.get("items")
+        if item_schema:
+            for index, item in enumerate(value):
+                errors.extend(_validate(item, item_schema, "{}[{}]".format(path, index)))
+        if "minItems" in schema and len(value) < schema["minItems"]:
+            errors.append("{}: expected at least {} items, got {}".format(path, schema["minItems"], len(value)))
+    elif isinstance(value, (int, float)) and not isinstance(value, bool):
+        if "minimum" in schema and value < schema["minimum"]:
+            errors.append("{}: {} < minimum {}".format(path, value, schema["minimum"]))
+    return errors
+
+
+__all__ = [
+    "REPORT_KIND",
+    "REPORT_SCHEMA",
+    "SCHEMA_VERSION",
+    "SchemaError",
+    "assert_valid_report",
+    "schema_json",
+    "validate_report",
+]
diff --git a/python/pypto/op_bench/suites.py b/python/pypto/op_bench/suites.py
new file mode 100644
index 000000000..bbf150c02
--- /dev/null
+++ b/python/pypto/op_bench/suites.py
@@ -0,0 +1,261 @@
+"""Three-layer shape suites: ``model`` / ``boundary`` / ``sweep``.
+
+``model`` is the Q8/W8J 12-shape set (m in {1,5} x six (k,n) pairs from
+Qwen3.5-0.8B linear layers), embedded here so the framework is reproducible on
+any host.  The embedded table is byte-compatible with the W8J evidence file
+
+    _meta/pypto-x/w8j-vllm-injection/raw/shape-ratio-table.json
+    (sha256 f66faf0660e6fe64a202c029cd4485b7de35e256ef84d6a7054c2ff29c1c12f9)
+
+``boundary`` covers the planning doc 0007 section 3 layer 2: m=1, n=32, K
+tails (7/17/65), rank 2-4, empty axes, and three deliberately invalid cases
+(non-unit stride layout, a forbidden attribute, an unregistered opcode) that
+must be explicitly rejected -- never silently skipped.
+
+``sweep`` is optional (layer 3) and off by default.
+
+Each entry is a JSON-safe prototype; :func:`build_cases` binds it to a
+provider/thread/binding/seed to produce :class:`OpCase` objects.
+"""
+
+from __future__ import annotations
+
+import zlib
+from typing import Any, Dict, List, Mapping, Sequence, Tuple
+
+from .object_model import OpCase
+
+
+W8J_TABLE_SHA256 = "f66faf0660e6fe64a202c029cd4485b7de35e256ef84d6a7054c2ff29c1c12f9"
+
+W8J_M_VALUES = (1, 5)
+W8J_KN_LABELS = (
+    (1024, 32, "gdn_in_proj_ba"),
+    (1024, 5120, "attn_qkv_proj"),
+    (1024, 7168, "mlp_gate_up_proj"),
+    (1024, 8192, "gdn_in_proj_qkvz"),
+    (2048, 1024, "gdn_out_proj/attn_o_proj"),
+    (3584, 1024, "mlp_down_proj"),
+)
+MODEL_DTYPE = "bf16"
+
+
+def _matmul_entry(
+    *,
+    suite: str,
+    label: str,
+    m: int,
+    k: int,
+    n: int,
+    dtype: str,
+    batch_shape: Sequence[int] = (),
+    layout_policy: str = "row_major",
+    attributes: Mapping[str, Any] = None,
+    op: str = "matmul",
+    expectation: str = "measured",
+) -> Mapping[str, Any]:
+    batch = tuple(int(dimension) for dimension in batch_shape)
+    entry = {
+        "op": op,
+        "shape": {
+            "left": list(batch) + [int(m), int(k)],
+            "right": list(batch) + [int(k), int(n)],
+            "output": list(batch) + [int(m), int(n)],
+        },
+        "dtype": dtype,
+        "layout_policy": layout_policy,
+        "attributes": dict(attributes or {}),
+        "label": label,
+        "suite": suite,
+        "m": int(m),
+        "k": int(k),
+        "n": int(n),
+        "batch_shape": list(batch),
+        "expectation": expectation,
+    }
+    return entry
+
+
+def model_suite() -> Tuple[Mapping[str, Any], ...]:
+    """W8J/Q8 12-shape set (rank-2, bf16)."""
+
+    entries: List[Mapping[str, Any]] = []
+    for m in W8J_M_VALUES:
+        for k, n, label in W8J_KN_LABELS:
+            entries.append(
+                _matmul_entry(
+                    suite="model",
+                    label=label,
+                    m=m,
+                    k=k,
+                    n=n,
+                    dtype=MODEL_DTYPE,
+                )
+            )
+    return tuple(entries)
+
+
+def boundary_suite() -> Tuple[Mapping[str, Any], ...]:
+    """Boundary and must-reject cases (planning doc 0007 section 3 layer 2)."""
+
+    entries: List[Mapping[str, Any]] = [
+        _matmul_entry(suite="boundary", label="m1_n32_k1024", m=1, k=1024, n=32, dtype="bf16"),
+        _matmul_entry(suite="boundary", label="m1_n1_k1", m=1, k=1, n=1, dtype="float32"),
+        _matmul_entry(suite="boundary", label="k_tail_7_m5_n17", m=5, k=7, n=17, dtype="float32"),
+        _matmul_entry(suite="boundary", label="k_tail_17_m3_n33", m=3, k=17, n=33, dtype="float32"),
+        _matmul_entry(suite="boundary", label="k_tail_65_m2_n16", m=2, k=65, n=16, dtype="bf16"),
+        _matmul_entry(
+            suite="boundary", label="rank3_batch2_m4_k64_n8", m=4, k=64, n=8, dtype="float32",
+            batch_shape=(2,),
+        ),
+        _matmul_entry(
+            suite="boundary", label="rank4_batch2x3_m4_k32_n8", m=4, k=32, n=8, dtype="bf16",
+            batch_shape=(2, 3),
+        ),
+        _matmul_entry(suite="boundary", label="empty_k0_m2_n4", m=2, k=0, n=4, dtype="float32"),
+        _matmul_entry(suite="boundary", label="empty_m0_k4_n4", m=0, k=4, n=4, dtype="float32"),
+        _matmul_entry(suite="boundary", label="empty_n0_m2_k4", m=2, k=4, n=0, dtype="float32"),
+        _matmul_entry(
+            suite="boundary",
+            label="reject_non_unit_stride",
+            m=8,
+            k=32,
+            n=8,
+            dtype="float32",
+            layout_policy="non_unit_stride",
+            expectation="must_reject",
+        ),
+        _matmul_entry(
+            suite="boundary",
+            label="reject_transpose_attribute",
+            m=8,
+            k=32,
+            n=8,
+            dtype="float32",
+            attributes={"transpose_b": True},
+            expectation="must_reject",
+        ),
+        {
+            "op": "reduce_sum",
+            "shape": {"left": [4, 4], "right": [4, 4]},
+            "dtype": "float32",
+            "layout_policy": "row_major",
+            "attributes": {},
+            "label": "reject_unregistered_opcode",
+            "suite": "boundary",
+            "m": 4,
+            "k": 4,
+            "n": 4,
+            "batch_shape": [],
+            "expectation": "must_reject",
+        },
+    ]
+    return tuple(entries)
+
+
+def sweep_suite(
+    *,
+    k_values: Sequence[int] = (64, 128, 256, 512, 1024, 2048, 3584),
+    m: int = 1,
+    n: int = 1024,
+    dtype: str = "bf16",
+) -> Tuple[Mapping[str, Any], ...]:
+    """Optional K sweep for curve-shaped comparisons (planning doc 0007 layer 3)."""
+
+    return tuple(
+        _matmul_entry(suite="sweep", label="k_sweep_k{}".format(k), m=m, k=k, n=n, dtype=dtype)
+        for k in k_values
+    )
+
+
+SUITE_BUILDERS = {
+    "model": model_suite,
+    "boundary": boundary_suite,
+}
+
+SUITE_NAMES = ("model", "boundary", "sweep")
+
+
+def suite_entries(name: str) -> Tuple[Mapping[str, Any], ...]:
+    if name == "model":
+        return model_suite()
+    if name == "boundary":
+        return boundary_suite()
+    if name == "sweep":
+        return sweep_suite()
+    if name == "all":
+        return model_suite() + boundary_suite()
+    raise ValueError("unknown suite {!r}; available: {}".format(name, ", ".join(sorted(SUITE_NAMES))))
+
+
+def build_cases(
+    entries: Sequence[Mapping[str, Any]],
+    *,
+    provider: str,
+    threads: int,
+    binding: str,
+    base_seed: int,
+) -> List[OpCase]:
+    """Turn suite prototypes into provider-bound :class:`OpCase` objects."""
+
+    cases: List[OpCase] = []
+    for entry in entries:
+        extra: Dict[str, Any] = {
+            "suite": entry.get("suite", "custom"),
+            "label": entry.get("label"),
+            "batch_shape": list(entry.get("batch_shape", [])),
+            "attributes": dict(entry.get("attributes", {})),
+            "expectation": entry.get("expectation", "measured"),
+            "m": entry.get("m"),
+            "k": entry.get("k"),
+            "n": entry.get("n"),
+        }
+        batch_text = "b{}_".format("x".join(str(d) for d in extra["batch_shape"])) if extra["batch_shape"] else ""
+        case_id = "{}:{}:{}:{}{}x{}x{}:{}:{}-t{}".format(
+            extra["suite"],
+            extra.get("label") or "case",
+            entry["op"],
+            batch_text,
+            entry["m"],
+            entry["k"],
+            entry["n"],
+            entry["dtype"],
+            provider.replace(":", "_"),
+            threads,
+        )
+        extra["case_id"] = case_id
+        # seed depends only on the suite entry (not on provider/order), so the
+        # same shape uses the same inputs across providers and is comparable.
+        seed_material = "{}|{}|{}|{}|{}".format(
+            entry.get("suite"), entry.get("label"), entry.get("op"), entry["shape"], entry["dtype"]
+        )
+        extra["inputs_seed"] = (int(base_seed) ^ zlib.crc32(seed_material.encode("utf-8"))) & 0x7FFFFFFF
+        cases.append(
+            OpCase(
+                op=entry["op"],
+                shape={name: tuple(dims) for name, dims in entry["shape"].items()},
+                dtype=entry["dtype"],
+                provider=provider,
+                threads=threads,
+                binding=binding,
+                layout_policy=entry.get("layout_policy", "row_major"),
+                inputs_seed=extra["inputs_seed"],
+                extra=extra,
+            )
+        )
+    return cases
+
+
+__all__ = [
+    "MODEL_DTYPE",
+    "SUITE_BUILDERS",
+    "SUITE_NAMES",
+    "W8J_KN_LABELS",
+    "W8J_M_VALUES",
+    "W8J_TABLE_SHA256",
+    "boundary_suite",
+    "build_cases",
+    "model_suite",
+    "suite_entries",
+    "sweep_suite",
+]
