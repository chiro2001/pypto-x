@@ -0,0 +1,67 @@
+"""PyPTO-X op-bench: reusable single-operator measurement framework (Q9).
+
+This package implements the framework specified by
+``docs/20-planning/0007-2026-09-11-operator-benchmark-framework.zh-CN.md``
+(controller repo ``pypto_x``).  It is a *consumer* of the frozen U1 execution
+layer: every case's operator identity is looked up in
+:mod:`pypto.execution.op_registry` (the single ``OpDefinition`` source of
+truth), and the ``portable`` provider executes through
+:func:`pypto.execution.execute_matmul` -- there is no second registry and no
+second execution path.
+
+The measurement protocol (warmup / K rounds / median / dispersion / ERR-0004
+outlier rule / ``UNGATED`` marking) is derived from
+``docs/PERF_MEASUREMENT_PROTOCOL.zh-CN.md`` and its ERR-0004 revision; see
+:mod:`pypto.op_bench.protocol` for the exact citations.
+
+Typical use::
+
+    PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=python python3 -m pypto.op_bench run \
+        --suite model --providers portable,vendor:aocl-lpgemm \
+        --threads 6 --bind 0-5 --out <evidence-dir>
+
+Only ``matmul`` is registered in the U1 slice; unregistered opcodes fail
+closed instead of being silently skipped.
+"""
+
+from __future__ import annotations
+
+from .object_model import CaseError, OpCase
+from .protocol import (
+    GATE_REASON,
+    PROTOCOL_REVISION,
+    PROTOCOL_SOURCE,
+    UNGATED_STATUS,
+    dispersion,
+    variance_verdict,
+)
+from .providers import (
+    PROVIDER_IDS,
+    ProviderLookupError,
+    get_provider,
+    get_provider_spec,
+    provider_registry_state,
+)
+from .runner import RunConfig, RunError, run_report, run_selftest
+
+__all__ = [
+    "CaseError",
+    "GATE_REASON",
+    "OpCase",
+    "PROTOCOL_REVISION",
+    "PROTOCOL_SOURCE",
+    "PROVIDER_IDS",
+    "ProviderLookupError",
+    "RunConfig",
+    "RunError",
+    "UNGATED_STATUS",
+    "dispersion",
+    "get_provider",
+    "get_provider_spec",
+    "provider_registry_state",
+    "run_report",
+    "run_selftest",
+    "variance_verdict",
+]
+
+__version__ = "1"
diff --git a/python/pypto/op_bench/cli.py b/python/pypto/op_bench/cli.py
new file mode 100644
index 000000000..48c6d6ce8
--- /dev/null
+++ b/python/pypto/op_bench/cli.py
@@ -0,0 +1,145 @@
+"""Command line interface for op-bench.
+
+The supported entry point is ``scripts/perf/op_bench.py`` (it sets
+``PYPTO_X_PORTABLE_ONLY=1`` and puts ``python/`` on ``sys.path`` before the
+``pypto`` package is imported).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from typing import Any, List, Optional, Sequence
+
+from .object_model import format_cpu_list, parse_cpu_list
+from .runner import RunConfig, RunError, run_and_write, run_selftest
+from .schema import schema_json
+
+
+def _cpu_list(value: str) -> tuple:
+    cpus = parse_cpu_list(value)
+    if not cpus:
+        raise argparse.ArgumentTypeError("invalid cpu list {!r}".format(value))
+    return cpus
+
+
+def _csv(value: str) -> tuple:
+    return tuple(item.strip() for item in value.split(",") if item.strip())
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="op-bench", description="PyPTO-X single-operator benchmark framework")
+    sub = parser.add_subparsers(dest="command")
+
+    run = sub.add_parser("run", help="run one benchmark report")
+    run.add_argument("--suite", action="append", default=None, choices=["model", "boundary", "sweep", "all"],
+                     help="shape suite (repeatable; default model)")
+    run.add_argument("--providers", type=_csv, default=("portable", "vendor:aocl-lpgemm-bf16"),
+                     help="comma-separated provider ids")
+    run.add_argument("--threads", type=int, default=6)
+    run.add_argument("--bind", type=_cpu_list, default=None, help="cpu list, e.g. 0-5")
+    run.add_argument("--rounds", type=int, default=None, help="fixed measured rounds (default auto)")
+    run.add_argument("--case-budget-seconds", type=float, default=30.0)
+    run.add_argument("--min-rounds", type=int, default=3)
+    run.add_argument("--iters", type=int, default=100, help="provider calls per round for non-portable providers")
+    run.add_argument("--warmup", type=int, default=5)
+    run.add_argument("--seed", type=int, default=20260912)
+    run.add_argument("--tag", default="op-bench")
+    run.add_argument("--out", default="")
+    run.add_argument("--reference-provider", default="portable")
+    run.add_argument("--no-reference", action="store_true", help="skip correctness reference execution")
+    run.add_argument("--force-expensive", action="store_true", help="run cases over the per-case budget")
+    run.add_argument("--inject-unavailable", type=_csv, default=(), help="force providers to report unavailable")
+    run.add_argument("--aocl-lib", default=None, help="AOCL shared library override (sha256 still verified)")
+    run.add_argument("--q8-vendor-matrix", default=None, help="Q8 vendor-gemm-matrix.json for alignment")
+    run.add_argument("--q8-ratio-table", default=None, help="W8J shape-ratio-table.json for oneDNN alignment")
+    run.add_argument("--clock-source", default="local_kvm_host_clock")
+    run.add_argument("--clock-offset-seconds", type=float, default=None)
+    run.add_argument("--repeat", type=int, default=1, help="repeat the whole run N times for reproducibility")
+    run.add_argument("--case-filter", type=_csv, action="append", default=None, help="only run cases whose case_id contains one of these substrings (repeatable)")
+    run.add_argument("--repo-root", default="")
+
+    self_test = sub.add_parser("selftest", help="run the light schema/error-injection self-test")
+    self_test.add_argument("--out", default="")
+    self_test.add_argument("--threads", type=int, default=1)
+    self_test.add_argument("--bind", type=_cpu_list, default=(0,))
+
+    sub.add_parser("dump-schema", help="print the report JSON schema")
+    return parser
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(list(argv) if argv is not None else None)
+    command = args.command or "run"
+    if command == "dump-schema":
+        print(schema_json())
+        return 0
+    if command == "selftest":
+        config = RunConfig(
+            suites=("boundary",),
+            providers=("portable",),
+            threads=args.threads,
+            binding_cpus=tuple(args.bind),
+            case_budget_seconds=10.0,
+            min_rounds=1,
+            case_filter=("m1_n1_k1",),
+            tag="op-bench-selftest",
+        )
+        payload = run_selftest(config, out_dir=args.out or None)
+        print(json.dumps(payload, indent=2, ensure_ascii=False))
+        return 0 if payload["status"] == "PASS" else 1
+
+    suites = tuple(args.suite) if args.suite else ("model",)
+    binding = tuple(args.bind) if args.bind else _default_cpus(args.threads)
+    if len(binding) < args.threads:
+        print(
+            "error: bound {} cpus but --threads {}; thread semantics require at least one cpu per thread".format(
+                len(binding), args.threads
+            ),
+            file=sys.stderr,
+        )
+        return 2
+    config = RunConfig(
+        suites=suites,
+        providers=tuple(args.providers),
+        base_seed=args.seed,
+        threads=args.threads,
+        binding_cpus=binding,
+        rounds=args.rounds,
+        case_budget_seconds=args.case_budget_seconds,
+        min_rounds=args.min_rounds,
+        iters=args.iters,
+        warmup=args.warmup,
+        reference_provider=args.reference_provider,
+        reference_enabled=not args.no_reference,
+        force_expensive=args.force_expensive,
+        tag=args.tag,
+        out_dir=args.out,
+        clock_source=args.clock_source,
+        clock_offset_seconds=args.clock_offset_seconds,
+        q8_vendor_matrix=args.q8_vendor_matrix,
+        q8_ratio_table=args.q8_ratio_table,
+        inject_unavailable=tuple(args.inject_unavailable),
+        case_filter=tuple(token for group in (args.case_filter or []) for token in group),
+        repeat=args.repeat,
+        repo_root=args.repo_root,
+        aocl_library=args.aocl_lib,
+    )
+    try:
+        report = run_and_write(config)
+    except RunError as exc:
+        print("error: {}".format(exc), file=sys.stderr)
+        return 2
+    print("status={} cases={} out={}".format(report.get("status"), len(report.get("cases", [])), args.out))
+    return 0 if report.get("status") != "FAIL" else 1
+
+
+def _default_cpus(threads: int) -> tuple:
+    online = sorted(os.sched_getaffinity(0))
+    return tuple(online[: max(1, min(int(threads), len(online)))])
+
+
+__all__ = ["build_parser", "main"]
diff --git a/python/pypto/op_bench/inputs.py b/python/pypto/op_bench/inputs.py
new file mode 100644
index 000000000..f59e8caa5
--- /dev/null
+++ b/python/pypto/op_bench/inputs.py
@@ -0,0 +1,157 @@
+"""Deterministic case inputs, bf16 bit helpers and the independent oracle.
+
+bf16 is not a numpy dtype on this stack, so op-bench represents bf16 operands
+as float32 arrays whose values are exactly bf16-representable, plus a uint16
+bit view for providers that consume bf16 wire bits (the AOCL path).  Both
+views are produced by a single round-to-nearest-even conversion, so a case has
+one canonical input bit pattern per seed.
+
+Determinism: :class:`numpy.random.Generator` (PCG64) with an explicit per-case
+seed; the same seed yields the same inputs on x86 and AArch64.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+import zlib
+from typing import Any, Mapping
+
+import numpy as np
+
+from .object_model import OpCase
+
+
+def case_seed(base_seed: int, case_id: str) -> int:
+    """Stable per-case seed derived from a run seed and the case id."""
+
+    return (int(base_seed) ^ int(zlib.crc32(case_id.encode("utf-8")))) & 0x7FFFFFFF
+
+
+def _round_bf16_bits_from_float32_bits(bits: np.ndarray) -> np.ndarray:
+    """Round float32 bit patterns to bf16 (RNE), returning uint16 patterns."""
+
+    bits = bits.astype(np.uint32, copy=True)
+    lower = bits & np.uint32(0xFFFF)
+    upper = bits >> np.uint32(16)
+    round_up = (lower > np.uint32(0x8000)) | ((lower == np.uint32(0x8000)) & ((upper & np.uint32(1)) != 0))
+    upper = upper + round_up.astype(np.uint32)
+    return upper.astype(np.uint16)
+
+
+def float32_to_bf16_bits(values: np.ndarray) -> np.ndarray:
+    """Convert a float32 array to bf16 wire bits (uint16)."""
+
+    arr = np.ascontiguousarray(values, dtype=np.float32)
+    return _round_bf16_bits_from_float32_bits(arr.view(np.uint32))
+
+
+def bf16_bits_to_float32(bits: np.ndarray) -> np.ndarray:
+    """Widen bf16 wire bits to the exactly-representable float32 values."""
+
+    arr = np.ascontiguousarray(bits, dtype=np.uint16)
+    return (arr.astype(np.uint32) << np.uint32(16)).view(np.float32)
+
+
+def float64_to_bf16(values: np.ndarray) -> np.ndarray:
+    """Round float64 values to bf16-representable float32 values (RNE)."""
+
+    arr = np.asarray(values, dtype=np.float64)
+    bits = arr.astype(np.float32).view(np.uint32)
+    rounded = _round_bf16_bits_from_float32_bits(bits)
+    return (rounded.astype(np.uint32) << np.uint32(16)).view(np.float32)
+
+
+def make_inputs(case: OpCase, verified: Mapping[str, Any], *, base_seed: int) -> Mapping[str, Any]:
+    """Generate the deterministic operands for a verified matmul case."""
+
+    dtype = verified["dtype"]
+    shape = verified["shape"]
+    seed = case_seed(base_seed, case.case_id)
+    m, k, n = shape["m"], shape["k"], shape["n"]
+    batch = tuple(shape["batch_shape"])
+    rng = np.random.default_rng(seed)
+    scale = 1.0 / np.sqrt(k) if k > 0 else 1.0
+    left_shape = batch + (m, k)
+    right_shape = batch + (k, n)
+    left64 = rng.standard_normal(size=left_shape) * scale
+    right64 = rng.standard_normal(size=right_shape) * scale
+
+    if dtype == "bf16":
+        left = float64_to_bf16(left64)
+        right = float64_to_bf16(right64)
+        left_bits = float32_to_bf16_bits(left)
+        right_bits = float32_to_bf16_bits(right)
+    elif dtype == "float32":
+        left = left64.astype(np.float32)
+        right = right64.astype(np.float32)
+        left_bits = None
+        right_bits = None
+    else:
+        raise ValueError("op-bench input generator does not support dtype {!r}".format(dtype))
+
+    digest = hashlib.sha256()
+    digest.update(np.ascontiguousarray(left).tobytes())
+    digest.update(np.ascontiguousarray(right).tobytes())
+    return {
+        "dtype": dtype,
+        "shape": shape,
+        "seed": seed,
+        "left": left,
+        "right": right,
+        "left_bits": left_bits,
+        "right_bits": right_bits,
+        "input_sha256": digest.hexdigest(),
+    }
+
+
+def oracle_matmul(inputs: Mapping[str, Any]) -> np.ndarray:
+    """Independent float64 oracle, cast back to the case output dtype.
+
+    This is the "independent third-party" reference of planning doc 0007
+    section 5; the primary reference stays the U1 ``portable`` provider.
+    """
+
+    left = np.asarray(inputs["left"], dtype=np.float64)
+    right = np.asarray(inputs["right"], dtype=np.float64)
+    result = np.matmul(left, right)
+    if inputs["dtype"] == "bf16":
+        return float64_to_bf16(result)
+    return result.astype(np.float32)
+
+
+def output_bits(dtype: str, values: np.ndarray) -> np.ndarray:
+    """Canonical wire representation used for bit-exact comparison."""
+
+    if dtype == "bf16":
+        return float32_to_bf16_bits(values.astype(np.float32))
+    return np.ascontiguousarray(values, dtype=np.float32)
+
+
+def buffer_sha256(dtype: str, values: np.ndarray) -> str:
+    bits = output_bits(dtype, values)
+    return hashlib.sha256(np.ascontiguousarray(bits).tobytes()).hexdigest()
+
+
+def ndarray_from_host_tensor(tensor: Any, dtype: str) -> np.ndarray:
+    """Convert a U1 ``HostTensor`` result to the canonical numpy view."""
+
+    flat = np.asarray(tensor.flat(), dtype=np.float64)
+    shape = tuple(int(dimension) for dimension in tensor.shape)
+    values = flat.reshape(shape)
+    if dtype == "bf16":
+        return values.astype(np.float32)
+    return values.astype(np.float32)
+
+
+__all__ = [
+    "bf16_bits_to_float32",
+    "buffer_sha256",
+    "case_seed",
+    "float32_to_bf16_bits",
+    "float64_to_bf16",
+    "make_inputs",
+    "ndarray_from_host_tensor",
+    "oracle_matmul",
+    "output_bits",
+]
diff --git a/python/pypto/op_bench/object_model.py b/python/pypto/op_bench/object_model.py
new file mode 100644
index 000000000..b2e48d22c
--- /dev/null
+++ b/python/pypto/op_bench/object_model.py
@@ -0,0 +1,373 @@
+"""``OpCase`` object model and its link to the U1 ``OpDefinition`` registry.
+
+Frozen shape of a case (planning doc 0007 section 3)::
+
+    OpCase = (op, shape, dtype, provider, threads, binding, layout_policy,
+              inputs_seed, extra)
+
+``op`` is a canonical U1 opcode; :meth:`OpCase.validate` resolves it through
+:func:`pypto.execution.op_registry.get_op_definition` and verifies the shape
+with the registry's own ``verify_signature`` predicate -- op-bench never
+re-declares an operator contract.  Unknown opcodes fail closed with an
+explicit :class:`CaseError` (category ``opcode_not_registered``); they are
+never silently skipped.
+
+``shape`` is a JSON-safe mapping ``operand name -> dimensions`` (for matmul:
+``{"left": [...], "right": [...], "output": [...]}``); batch dimensions are
+part of the operand dimensions, matching the U1 rank 2-4 contract.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.core_ir import CoreType
+from pypto.execution.op_registry import OpContractError, OpDefinition, get_op_definition
+from pypto.lowering.cpu import CpuScalarUnsupportedError, canonical_dtype
+from pypto.target._utils import mapping_copy
+
+
+LAYOUT_POLICY_ROW_MAJOR = "row_major"
+BINDING_NONE = "none"
+
+
+class CaseError(Exception):
+    """A case that cannot be measured, with a machine-readable category."""
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        category: str,
+        field: Optional[str] = None,
+        requested: Any = None,
+        available: Any = None,
+    ) -> None:
+        super().__init__(message)
+        self.category = category
+        self.field = field
+        self.requested = requested
+        self.available = available
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "category": self.category,
+            "message": str(self),
+            "field": self.field,
+            "requested": self.requested,
+            "available": self.available,
+        }
+
+
+@dataclass(frozen=True)
+class OpCase:
+    """One operator/shape/dtype/provider measurement request."""
+
+    op: str
+    shape: Mapping[str, Sequence[int]]
+    dtype: str
+    provider: str
+    threads: int
+    binding: str
+    layout_policy: str
+    inputs_seed: int
+    extra: Mapping[str, Any] = field(default_factory=dict)
+
+    # -- identity ---------------------------------------------------------
+    @property
+    def case_id(self) -> str:
+        value = self.extra.get("case_id")
+        if value:
+            return str(value)
+        dims = "-".join(
+            "x".join(str(dimension) for dimension in self.shape.get(name, ()))
+            for name in sorted(self.shape)
+        )
+        return "{}:{}:{}:{}".format(self.extra.get("suite", "case"), self.op, dims, self.dtype)
+
+    @property
+    def suite(self) -> str:
+        return str(self.extra.get("suite", "custom"))
+
+    @property
+    def label(self) -> Optional[str]:
+        value = self.extra.get("label")
+        return str(value) if value else None
+
+    def contract_definition(self) -> OpDefinition:
+        try:
+            return get_op_definition(self.op)
+        except OpContractError as exc:
+            raise CaseError(
+                "opcode {!r} is not registered in the U1 registry: {}".format(self.op, exc),
+                category="opcode_not_registered",
+                field="op",
+                requested=self.op,
+                available=[name for name in _u1_opcodes()],
+            ) from exc
+        except CpuScalarUnsupportedError as exc:  # pragma: no cover - defensive
+            raise CaseError(
+                "opcode {!r} is unknown to the lowering alias table".format(self.op),
+                category="opcode_not_registered",
+                field="op",
+                requested=self.op,
+            ) from exc
+
+    def contract_identity(self) -> Mapping[str, Any]:
+        return dict(self.contract_definition().contract_identity)
+
+    # -- validation -------------------------------------------------------
+    def validate(self, definition: Optional[OpDefinition] = None) -> Mapping[str, Any]:
+        """Validate the case against the U1 registry and local knob rules.
+
+        Returns the verified contract view (dtype/shapes + contract identity).
+        """
+
+        if not isinstance(self.op, str) or not self.op.strip():
+            raise CaseError("op must be a non-empty string", category="illegal_knob", field="op", requested=self.op)
+        active = definition if definition is not None else self.contract_definition()
+        dtype = self._canonical_dtype()
+        knobs = self._validate_knobs()
+        shape_view = self._validate_shape(active, dtype)
+        return {
+            "op": active.canonical_opcode,
+            "contract": dict(active.contract_identity),
+            "dtype": dtype,
+            "shape": shape_view,
+            "knobs": knobs,
+        }
+
+    def _canonical_dtype(self) -> str:
+        try:
+            return canonical_dtype(self.dtype)
+        except (CpuScalarUnsupportedError, Exception) as exc:  # noqa: BLE001 - normalize error surface
+            if isinstance(exc, CaseError):
+                raise
+            raise CaseError(
+                "dtype {!r} is outside the CPU scalar dtype domain".format(self.dtype),
+                category="dtype_outside_domain",
+                field="dtype",
+                requested=self.dtype,
+            ) from exc
+
+    def _validate_shape(self, definition: OpDefinition, dtype: str) -> Mapping[str, Any]:
+        if definition.canonical_opcode != "matmul":
+            raise CaseError(
+                "op-bench has no shape validator for registered opcode {!r}".format(definition.canonical_opcode),
+                category="unsupported_op",
+                field="op",
+                requested=definition.canonical_opcode,
+            )
+        if not isinstance(self.shape, Mapping):
+            raise CaseError("shape must be a mapping of operand name -> dims", category="shape_contract_violation", field="shape")
+        missing = [name for name in ("left", "right", "output") if name not in self.shape]
+        unknown = sorted(set(self.shape) - {"left", "right", "output"})
+        if missing or unknown:
+            raise CaseError(
+                "matmul shape must have exactly left/right/output operands",
+                category="shape_contract_violation",
+                field="shape",
+                requested={"missing": missing, "unknown": unknown},
+                available=["left", "right", "output"],
+            )
+
+        def tensor(name: str) -> CoreType:
+            dims = tuple(self.shape[name])
+            for index, dimension in enumerate(dims):
+                if isinstance(dimension, bool) or not isinstance(dimension, int):
+                    raise CaseError(
+                        "shape.{}.{} must be a static integer".format(name, index),
+                        category="shape_contract_violation",
+                        field="shape.{}.{}".format(name, index),
+                        requested=dims[index],
+                    )
+            return CoreType.tensor(dtype, dims)
+
+        try:
+            view = definition.verify_signature(tensor("left"), tensor("right"), tensor("output"))
+        except OpContractError as exc:
+            field = str(getattr(exc, "field", "") or "")
+            category = "dtype_outside_domain" if field.startswith("dtype") else "shape_contract_violation"
+            raise CaseError(
+                "shape {} violates the U1 matmul contract: {}".format(dict(self.shape), exc),
+                category=category,
+                field=field or "shape",
+                requested=dict(self.shape),
+            ) from exc
+        return {
+            "left": list(view["left_shape"]),
+            "right": list(view["right_shape"]),
+            "output": list(view["output_shape"]),
+            "m": view["m"],
+            "k": view["k"],
+            "n": view["n"],
+            "batch_shape": list(view["batch_shape"]),
+            "flops": matmul_flops(view),
+        }
+
+    def _validate_knobs(self) -> Mapping[str, Any]:
+        if isinstance(self.threads, bool) or not isinstance(self.threads, int) or self.threads < 1:
+            raise CaseError(
+                "threads must be a positive integer",
+                category="illegal_knob",
+                field="threads",
+                requested=self.threads,
+                available=">=1",
+            )
+        if self.layout_policy != LAYOUT_POLICY_ROW_MAJOR:
+            raise CaseError(
+                "layout_policy {!r} is not supported by the U1 contiguous-only matmul contract".format(self.layout_policy),
+                category="illegal_knob",
+                field="layout_policy",
+                requested=self.layout_policy,
+                available=[LAYOUT_POLICY_ROW_MAJOR],
+            )
+        binding = self.binding
+        if not isinstance(binding, str) or not binding.strip():
+            raise CaseError("binding must be a non-empty string", category="illegal_knob", field="binding", requested=binding)
+        if binding != BINDING_NONE and not binding.startswith("affinity:"):
+            raise CaseError(
+                "binding must be 'none' or 'affinity:<cpu,cpu,...>'",
+                category="illegal_knob",
+                field="binding",
+                requested=binding,
+                available=["none", "affinity:0-5 style cpu list"],
+            )
+        if binding.startswith("affinity:") and not parse_cpu_list(binding[len("affinity:"):]):
+            raise CaseError(
+                "binding cpu list is empty or malformed",
+                category="illegal_knob",
+                field="binding",
+                requested=binding,
+            )
+        if isinstance(self.inputs_seed, bool) or not isinstance(self.inputs_seed, int):
+            raise CaseError(
+                "inputs_seed must be an integer",
+                category="illegal_knob",
+                field="inputs_seed",
+                requested=self.inputs_seed,
+            )
+        attributes = dict(self.extra.get("attributes") or {})
+        illegal = {
+            key: value
+            for key, value in attributes.items()
+            if value not in (None, False)
+        }
+        if illegal:
+            raise CaseError(
+                "matmul attributes {} are outside the U1 contract".format(illegal),
+                category="attribute_not_supported",
+                field="extra.attributes",
+                requested=illegal,
+                available=["unset", False],
+            )
+        return {
+            "threads": self.threads,
+            "binding": binding,
+            "layout_policy": self.layout_policy,
+            "inputs_seed": self.inputs_seed,
+            "attributes": mapping_copy(attributes),
+        }
+
+    # -- serialization ----------------------------------------------------
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "case_id": self.case_id,
+            "suite": self.suite,
+            "op": self.op,
+            "shape": {name: list(dims) for name, dims in self.shape.items()},
+            "dtype": self.dtype,
+            "provider": self.provider,
+            "threads": self.threads,
+            "binding": self.binding,
+            "layout_policy": self.layout_policy,
+            "inputs_seed": self.inputs_seed,
+            "extra": mapping_copy(self.extra),
+        }
+
+    @classmethod
+    def from_dict(cls, data: Mapping[str, Any]) -> "OpCase":
+        return cls(
+            op=data["op"],
+            shape={name: tuple(int(v) for v in dims) for name, dims in data["shape"].items()},
+            dtype=data["dtype"],
+            provider=data["provider"],
+            threads=int(data["threads"]),
+            binding=str(data["binding"]),
+            layout_policy=str(data["layout_policy"]),
+            inputs_seed=int(data["inputs_seed"]),
+            extra=dict(data.get("extra", {})),
+        )
+
+
+def matmul_flops(view: Mapping[str, Any]) -> int:
+    """Protocol section 3.2: matmul = 2 * B * M * N * K (bf16 and fp32 alike)."""
+
+    batch = 1
+    for dimension in view["batch_shape"]:
+        batch *= dimension
+    return 2 * batch * view["m"] * view["n"] * view["k"]
+
+
+def parse_cpu_list(spec: str) -> Tuple[int, ...]:
+    """Parse ``0-5,8`` into a sorted unique CPU tuple."""
+
+    if spec is None:
+        return ()
+    cpus = set()
+    for chunk in str(spec).split(","):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        if "-" in chunk:
+            start_text, _, end_text = chunk.partition("-")
+            try:
+                start, end = int(start_text), int(end_text)
+            except ValueError:
+                return ()
+            if start < 0 or end < start:
+                return ()
+            cpus.update(range(start, end + 1))
+        else:
+            try:
+                value = int(chunk)
+            except ValueError:
+                return ()
+            if value < 0:
+                return ()
+            cpus.add(value)
+    return tuple(sorted(cpus))
+
+
+def format_cpu_list(cpus: Sequence[int]) -> str:
+    values = sorted(set(int(cpu) for cpu in cpus))
+    if not values:
+        return ""
+    ranges = []
+    start = previous = values[0]
+    for value in values[1:]:
+        if value == previous + 1:
+            previous = value
+            continue
+        ranges.append(str(start) if start == previous else "{}-{}".format(start, previous))
+        start = previous = value
+    ranges.append(str(start) if start == previous else "{}-{}".format(start, previous))
+    return ",".join(ranges)
+
+
+def _u1_opcodes() -> Tuple[str, ...]:
+    from pypto.execution.op_registry import registered_opcodes
+
+    return registered_opcodes()
+
+
+__all__ = [
+    "BINDING_NONE",
+    "CaseError",
+    "LAYOUT_POLICY_ROW_MAJOR",
+    "OpCase",
+    "format_cpu_list",
+    "matmul_flops",
+    "parse_cpu_list",
+]
