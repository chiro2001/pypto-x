+#!/usr/bin/env bash
+# Q9 op-bench: A3 (aarch64 Kunpeng) cross-platform leg.
+#
+# Deployed under ~/pypto-x-a3/op-bench-framework (scripts committed before landing).
+# Usage (on A3, from the deployed worktree, via setsid nohup):
+#   setsid nohup bash scripts/perf/op_bench_a3_run.sh > logs/a3-outer.log 2>&1 &
+#
+# Discipline: host cpus 320-639 only, one process x 8 threads pinned to 8
+# non-overlapping physical cores, <=20 concurrency, never touch chip7/NPU.
+# The portable provider is single-threaded; --threads 8 only sets the process
+# affinity/env so the run matches the A3 recipe.  AOCL is requested so the
+# report carries an explicit `unavailable` provider entry (its x86-only
+# artifact is absent here) instead of a silent omission.
+set -euo pipefail
+
+WORKTREE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+EVIDENCE="${OP_BENCH_EVIDENCE:-$HOME/pypto-x-a3/op-bench-framework}"
+RAW="$EVIDENCE/raw/a3"
+LOGS="$EVIDENCE/logs/a3"
+mkdir -p "$RAW" "$LOGS"
+cd "$WORKTREE"
+
+# pick 8 logical CPUs in 320-639 with distinct physical cores (same recipe as Q8b a3_env.sh)
+CPUS="$(lscpu -p=CPU,CORE 2>/dev/null | grep -v '^#' | awk -F, '$1>=320 && $1<=639 && !seen[$2]++ {print $1}' | head -n 8 | paste -sd,)"
+if [ -z "$CPUS" ]; then
+    echo "[op-bench-a3] could not select cpus in 320-639" >&2
+    exit 1
+fi
+echo "[op-bench-a3] cpus=$CPUS threads=8 start=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+OP_BENCH_THREADS=8 OP_BENCH_BIND="$CPUS" \
+python3 scripts/perf/op_bench.py run \
+    --suite boundary --case-filter m1_n32_k1024 --case-filter m1_n1_k1 \
+    --providers portable,vendor:aocl-lpgemm-bf16 \
+    --threads 8 --bind "$CPUS" \
+    --rounds 21 --warmup 5 --iters 1 \
+    --clock-source a3_host_clock --clock-offset-seconds -366 \
+    --tag q9-a3-portable \
+    --out "$RAW/main" 2>&1 | tee "$LOGS/a3-run.log"
+
+echo "[op-bench-a3] done=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
