index 000000000..c818734f1
--- /dev/null
+++ b/python/pypto/op_bench/precision.py
@@ -0,0 +1,225 @@
+"""Correctness verdicts and the derived accumulation band.
+
+The planning doc 0007 section 5 requires every case to carry a precision
+class, and requires that a mismatch be *first* classified as a semantic
+difference and *only then* triaged as a possible bug -- the two conclusions
+are reported separately.
+
+Band derivation (one formula for bf16 and fp32 cases)::
+
+    sum_abs_ij = sum_k |a_ik * b_kj|
+    accumulation = (K + 2) * 2^-24 * sum_abs_ij          # fp32 rounding reorder
+    output_round = 2^-9 * (|ref_ij| + |cand_ij|)          # bf16 output only
+    band_ij = accumulation + output_round + 1e-12
+
+``2^-24`` is the fp32 unit roundoff and ``2^-9`` covers one bf16 ulp; the
+``(K+2)`` factor bounds K rounded multiply-add accumulations plus the two
+"order changed at both ends" cases.  The formula is derived from, not
+invented outside, the accumulation contract of 0006 section 13.2 (P3) and the
+U1 numeric contract (``k_ascending_serial_per_output_element``); the vendor
+kernels declare a different ``reduction_order_id``, which is the recorded
+semantic difference.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Sequence
+
+import numpy as np
+
+from .providers import PRECISION_BIT_EXACT, PRECISION_BOUNDED
+
+
+U_FP32 = 2.0 ** -24
+BF16_OUTPUT_ROUND = 2.0 ** -9
+ABSOLUTE_EPSILON = 1.0e-12
+
+VERDICT_EXACT = "EXACT_MATCH"
+VERDICT_BITWISE_MISMATCH = "BITWISE_MISMATCH"
+VERDICT_WITHIN_BAND = "WITHIN_DECLARED_BAND"
+VERDICT_BEYOND_BAND = "BEYOND_DECLARED_BAND"
+
+TRIAGE_NOT_APPLICABLE = "NOT_APPLICABLE"
+TRIAGE_SEMANTIC_EXPLAINED = "SEMANTIC_DIFFERENCE_DECLARED"
+TRIAGE_SUSPECTED_BUG = "SUSPECTED_BUG_NEEDS_TRIAGE"
+
+
+def derived_band(
+    inputs: Mapping[str, Any],
+    reference: np.ndarray,
+    candidate: np.ndarray,
+) -> np.ndarray:
+    """Per-element derived band for one matmul output."""
+
+    left = np.asarray(inputs["left"], dtype=np.float64)
+    right = np.asarray(inputs["right"], dtype=np.float64)
+    k = int(inputs["shape"]["k"])
+    sum_abs = np.matmul(np.abs(left), np.abs(right))
+    band = (float(k) + 2.0) * U_FP32 * sum_abs
+    if inputs["dtype"] == "bf16":
+        band = band + BF16_OUTPUT_ROUND * (np.abs(reference) + np.abs(candidate))
+    return band + ABSOLUTE_EPSILON
+
+
+def semantic_difference(
+    provider_spec: Mapping[str, Any],
+    reference_spec: Mapping[str, Any],
+) -> Mapping[str, Any]:
+    """Declared (not observed) semantic differences between two providers."""
+
+    reasons = []
+    if provider_spec.get("reduction_order_id") != reference_spec.get("reduction_order_id"):
+        reasons.append(
+            "reduction_order_id {} != {}".format(
+                provider_spec.get("reduction_order_id"), reference_spec.get("reduction_order_id")
+            )
+        )
+    precision_class = provider_spec.get("class")
+    if precision_class == PRECISION_BOUNDED:
+        reasons.append("provider declares bounded_tolerance, not bit_exact")
+    if not reasons:
+        reasons.append("no declared semantic difference (providers claim the same contract)")
+    return {"is_different": bool(reasons), "reasons": reasons}
+
+
+def _reference_view(reference: Mapping[str, Any]) -> Mapping[str, Any]:
+    return {
+        "class": reference.get("class"),
+        "reduction_order_id": reference.get("reduction_order_id"),
+        "provider_id": reference.get("provider_id"),
+    }
+
+
+def compare_outputs(
+    *,
+    dtype: str,
+    inputs: Mapping[str, Any],
+    reference: np.ndarray,
+    candidate: np.ndarray,
+    provider_spec: Mapping[str, Any],
+    reference_meta: Mapping[str, Any],
+    reference_sha256: str,
+    candidate_sha256: str,
+) -> Mapping[str, Any]:
+    """Compare one provider output against the reference output.
+
+    Returns the machine-readable precision block required by planning doc 0007
+    section 6, with semantic-difference and bug-triage conclusions kept apart.
+    """
+
+    reference = np.asarray(reference)
+    candidate = np.asarray(candidate)
+    if reference.shape != candidate.shape:
+        return {
+            "class": provider_spec.get("class"),
+            "basis": provider_spec.get("basis"),
+            "band_source": provider_spec.get("band_source"),
+            "verdict": "SHAPE_MISMATCH",
+            "reference_sha256": reference_sha256,
+            "candidate_sha256": candidate_sha256,
+            "semantic_difference": semantic_difference(provider_spec, _reference_view(reference_meta)),
+            "bug_triage": {
+                "verdict": TRIAGE_SUSPECTED_BUG,
+                "reason": "reference shape {} != candidate shape {}".format(reference.shape, candidate.shape),
+            },
+            "notes": "shape mismatch is never a numeric-tolerance question",
+        }
+
+    class_ = provider_spec.get("class")
+    bitwise = bool(np.array_equal(reference.view(np.uint8), candidate.view(np.uint8)))
+    block: dict = {
+        "class": class_,
+        "basis": provider_spec.get("basis"),
+        "band_source": provider_spec.get("band_source"),
+        "reduction_order_id": provider_spec.get("reduction_order_id"),
+        "reference_provider": reference_meta.get("provider_id"),
+        "reference_sha256": reference_sha256,
+        "candidate_sha256": candidate_sha256,
+        "bitwise_equal": bitwise,
+    }
+
+    if reference.size == 0:
+        block.update(
+            {
+                "verdict": VERDICT_EXACT if bitwise else VERDICT_BITWISE_MISMATCH,
+                "max_abs_diff": 0.0,
+                "elements_over_band": 0,
+                "band_max": 0.0,
+                "semantic_difference": semantic_difference(provider_spec, _reference_view(reference_meta)),
+                "bug_triage": {"verdict": TRIAGE_NOT_APPLICABLE, "reason": "empty output; nothing to compare"},
+            }
+        )
+        return block
+
+    diff = np.abs(candidate.astype(np.float64) - reference.astype(np.float64))
+    block["max_abs_diff"] = float(diff.max())
+    denom = np.maximum(np.abs(reference.astype(np.float64)), 1.0e-300)
+    block["max_rel_diff"] = float((diff / denom).max())
+
+    if class_ == PRECISION_BIT_EXACT:
+        block["verdict"] = VERDICT_EXACT if bitwise else VERDICT_BITWISE_MISMATCH
+        block["band_max"] = None
+        block["elements_over_band"] = None
+        semantic = semantic_difference(provider_spec, _reference_view(reference_meta))
+        block["semantic_difference"] = semantic
+        if bitwise:
+            block["bug_triage"] = {
+                "verdict": TRIAGE_NOT_APPLICABLE,
+                "reason": "byte-identical to the reference",
+            }
+        else:
+            block["bug_triage"] = {
+                "verdict": TRIAGE_SUSPECTED_BUG,
+                "reason": "provider declares bit_exact but buffers differ; "
+                "semantic difference declared: {}".format(semantic["is_different"]),
+            }
+        return block
+
+    band = derived_band(inputs, reference, candidate)
+    excess = diff - band
+    over = int(np.count_nonzero(excess > 0.0))
+    block.update(
+        {
+            "band_max": float(band.max()) if band.size else 0.0,
+            "band_mean": float(band.mean()) if band.size else 0.0,
+            "max_band_excess": float(excess.max()),
+            "elements_over_band": over,
+            "elements_total": int(reference.size),
+            "verdict": VERDICT_WITHIN_BAND if over == 0 else VERDICT_BEYOND_BAND,
+        }
+    )
+    semantic = semantic_difference(provider_spec, _reference_view(reference_meta))
+    block["semantic_difference"] = semantic
+    if over == 0:
+        block["bug_triage"] = {
+            "verdict": TRIAGE_SEMANTIC_EXPLAINED,
+            "reason": "all {} elements inside the derived band; difference is explained by the declared "
+            "semantic difference".format(reference.size),
+        }
+    else:
+        worst = np.unravel_index(int(np.argmax(excess)), excess.shape)
+        block["bug_triage"] = {
+            "verdict": TRIAGE_SUSPECTED_BUG,
+            "reason": "{} of {} elements exceed the derived band; worst index {} excess {:.6g}; "
+            "declared semantic difference exists but does not bound the observation -- needs triage".format(
+                over, reference.size, list(worst), float(excess[worst])
+            ),
+        }
+    return block
+
+
+__all__ = [
+    "ABSOLUTE_EPSILON",
+    "BF16_OUTPUT_ROUND",
+    "TRIAGE_NOT_APPLICABLE",
+    "TRIAGE_SEMANTIC_EXPLAINED",
+    "TRIAGE_SUSPECTED_BUG",
+    "U_FP32",
+    "VERDICT_BEYOND_BAND",
+    "VERDICT_BITWISE_MISMATCH",
+    "VERDICT_EXACT",
+    "VERDICT_WITHIN_BAND",
+    "compare_outputs",
+    "derived_band",
+    "semantic_difference",
+]
