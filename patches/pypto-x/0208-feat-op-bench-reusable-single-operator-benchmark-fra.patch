+"""Focused tests for the Q9 op-bench framework.
+
+Covered acceptance points from ``docs/20-planning/0007-...`` section 8:
+
+* U1 registry reuse (contract digest / fail-closed opcode);
+* provider registry declarations (availability/version/timing/threads/precision);
+* explicit error injection (unknown provider, sha256 version mismatch, illegal
+  knobs, forbidden attributes, unregistered opcodes);
+* schema validation (missing field => hard failure);
+* ERR-0004 protocol reproduction (floor + UNSTABLE threshold) and parity with
+  the B3c ``local_l0_microbench.dispersion`` implementation;
+* reproducibility of a repeated run (structure + median within dispersion);
+* precision classification: semantic difference vs suspected bug.
+
+The suite is deliberately light: no model-suite shapes, no heavy lock needed.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import sys
+import types
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+
+REPO_ROOT = Path(__file__).parents[3].parent
+B3C_PATH = REPO_ROOT / "scripts" / "perf" / "local_l0_microbench.py"
+Q8_MATRIX_PATH = Path(
+    "/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey/raw/vendor-gemm-matrix.json"
+)
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    for name in [name for name in sys.modules if name == "pypto" or name.startswith("pypto.")]:
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    import pypto.op_bench as op_bench
+    from pypto.execution.op_registry import get_op_definition
+    from pypto.op_bench import precision, protocol, providers, runner, schema, suites
+    from pypto.op_bench.inputs import make_inputs
+    from pypto.op_bench.object_model import CaseError, OpCase
+    from pypto.op_bench.provider_aocl import AOCL_DEFAULT_LIBRARY, AOCL_LIBRARY_ENV, AoclLpgemmBf16Adapter
+    from pypto.op_bench.providers import ProviderContext
+
+    return types.SimpleNamespace(
+        op_bench=op_bench,
+        get_op_definition=get_op_definition,
+        precision=precision,
+        protocol=protocol,
+        providers=providers,
+        runner=runner,
+        schema=schema,
+        suites=suites,
+        make_inputs=make_inputs,
+        CaseError=CaseError,
+        OpCase=OpCase,
+        AOCL_DEFAULT_LIBRARY=AOCL_DEFAULT_LIBRARY,
+        AOCL_LIBRARY_ENV=AOCL_LIBRARY_ENV,
+        AoclLpgemmBf16Adapter=AoclLpgemmBf16Adapter,
+        ProviderContext=ProviderContext,
+    )
+
+
+_C = _imports()
+
+
+def _case(**overrides):
+    data = {
+        "op": "matmul",
+        "shape": {"left": (2, 4), "right": (4, 2), "output": (2, 2)},
+        "dtype": "float32",
+        "provider": "portable",
+        "threads": 1,
+        "binding": "none",
+        "layout_policy": "row_major",
+        "inputs_seed": 7,
+        "extra": {"case_id": "test:case", "suite": "test"},
+    }
+    data.update(overrides)
+    return _C.OpCase(**data)
+
+
+def _tiny_config(**overrides):
+    config = dict(
+        suites=("boundary",),
+        providers=("portable",),
+        threads=1,
+        binding_cpus=(0,),
+        rounds=3,
+        min_rounds=1,
+        iters=1,
+        warmup=1,
+        case_budget_seconds=5.0,
+        reference_enabled=False,
+        case_filter=("m1_n32_k1024",),
+        tag="pytest-tiny",
+        repo_root=str(REPO_ROOT),
+    )
+    config.update(overrides)
+    return _C.runner.RunConfig(**config)
+
+
+@pytest.fixture(scope="module")
+def tiny_report():
+    return dict(_C.runner.run_report(_tiny_config()))
+
+
+# ---------------------------------------------------------------------------
+# 1. U1 registry is the only contract source
+# ---------------------------------------------------------------------------
+def test_u1_registry_contract_identity_is_reused():
+    definition = _C.get_op_definition("matmul")
+    verified = _case().validate()
+    assert verified["op"] == definition.canonical_opcode
+    assert verified["contract"]["digest"] == definition.contract_digest
+    assert verified["contract"]["version"] == definition.contract_version
+    assert verified["shape"]["flops"] == 2 * 2 * 4 * 2
+
+
+def test_unregistered_opcode_fails_closed():
+    with pytest.raises(_C.CaseError) as info:
+        _case(op="reduce_sum", shape={"left": (4, 4)}).validate()
+    assert info.value.category == "opcode_not_registered"
+
+
+def test_shape_violation_uses_u1_verifier():
+    with pytest.raises(_C.CaseError) as info:
+        _case(shape={"left": (2, 4), "right": (3, 2), "output": (2, 2)}).validate()
+    assert info.value.category == "shape_contract_violation"
+
+
+@pytest.mark.parametrize(
+    "overrides,category",
+    [
+        ({"threads": 0}, "illegal_knob"),
+        ({"layout_policy": "column_major"}, "illegal_knob"),
+        ({"dtype": "bool"}, "dtype_outside_domain"),
+        ({"extra": {"case_id": "x", "suite": "test", "attributes": {"transpose_b": True}}}, "attribute_not_supported"),
+    ],
+)
+def test_illegal_knobs_fail_closed(overrides, category):
+    with pytest.raises(_C.CaseError) as info:
+        _case(**overrides).validate()
+    assert info.value.category == category
+
+
+# ---------------------------------------------------------------------------
+# 2. provider registry declarations
+# ---------------------------------------------------------------------------
+def test_every_provider_declares_availability_timing_threads_precision():
+    for provider_id in _C.providers.PROVIDER_IDS:
+        spec = _C.providers.get_provider_spec(provider_id)
+        declaration = spec.to_dict()
+        assert declaration["availability_probe"]
+        assert declaration["library_name"]
+        assert declaration["version_pin"]
+        assert declaration["failure_modes"]
+        timing = declaration["timing_semantics"]
+        for key in ("includes_pack", "includes_alloc", "includes_first_jit", "includes_compile",
+                    "includes_dispatch", "timed_region"):
+            assert key in timing
+        assert declaration["thread_semantics"]["knob"]
+        assert declaration["thread_semantics"]["binding_knob"]
+        assert declaration["precision_semantics"]["class"] in ("bit_exact", "bounded_tolerance")
+        assert declaration["precision_semantics"]["basis"]
+        if declaration["precision_semantics"]["class"] == "bounded_tolerance":
+            assert declaration["precision_semantics"]["band_source"]
+
+
+def test_portable_provider_is_single_thread_and_bit_exact():
+    spec = _C.providers.get_provider_spec("portable")
+    assert spec.threads.supported == (1,)
+    assert spec.precision.precision_class == "bit_exact"
+    assert spec.precision.reference_provider is None
+
+
+@pytest.mark.skipif(not os.path.exists(_C.AOCL_DEFAULT_LIBRARY), reason="Q8 AOCL artifact not on this host")
+def test_aocl_fingerprint_and_semantics():
+    spec = _C.providers.get_provider_spec("vendor:aocl-lpgemm-bf16")
+    assert spec.sha256_pin and len(spec.sha256_pin) == 64
+    assert spec.timing.includes_pack is False  # packed B is prepared outside the timed region
+    assert spec.timing.includes_alloc is False
+    assert spec.timing.includes_first_jit is False
+    assert spec.precision.precision_class == "bounded_tolerance"
+    assert spec.precision.reference_provider == "portable"
+    f32 = _C.providers.get_provider_spec("vendor:aocl-lpgemm-f32")
+    assert f32.timing.includes_pack is True  # BLIS packs A/B inside cblas_sgemm
+
+
+def test_unknown_provider_rejected():
+    with pytest.raises(_C.providers.ProviderLookupError):
+        _C.providers.get_provider_spec("vendor:not-registered")
+
+
+@pytest.mark.skipif(not os.path.exists(_C.AOCL_DEFAULT_LIBRARY), reason="Q8 AOCL artifact not on this host")
+def test_sha256_version_mismatch_is_explicit_unavailable(tmp_path):
+    wrong = tmp_path / "wrong.so"
+    wrong.write_text("not the pinned library")
+    previous = os.environ.get(_C.AOCL_LIBRARY_ENV)
+    os.environ[_C.AOCL_LIBRARY_ENV] = str(wrong)
+    try:
+        probe = _C.AoclLpgemmBf16Adapter(_C.ProviderContext(threads=1, binding_cpus=(0,))).probe()
+    finally:
+        if previous is None:
+            os.environ.pop(_C.AOCL_LIBRARY_ENV, None)
+        else:
+            os.environ[_C.AOCL_LIBRARY_ENV] = previous
+    assert probe.state == "unavailable"
+    assert probe.reason == "library_sha256_mismatch"
+
+
+# ---------------------------------------------------------------------------
+# 3. protocol: ERR-0004 and B3c parity
+# ---------------------------------------------------------------------------
+def test_err_0004_floor_accepts_two_small_outliers_and_flags_three():
+    stable = [1.0] * 19 + [1.03, 1.03]
+    block = _C.protocol.dispersion(stable)
+    assert block["outliers_marked"] == 2
+    assert block["outlier_threshold"] == pytest.approx(0.02)
+    assert block["verdict"] == _C.protocol.VERDICT_VALID
+
+    unstable = [1.0] * 18 + [1.03] * 3
+    block = _C.protocol.dispersion(unstable)
+    assert block["outliers_marked"] == 3
+    assert block["outlier_ratio"] > 0.10
+    assert block["verdict"] == _C.protocol.VERDICT_UNSTABLE
+
+
+def test_sub_microsecond_noise_is_not_an_outlier():
+    series = [1.0] * 20 + [1.0 + 5e-7]  # 0.5 us on a 1 s median -> below the 1 us floor
+    block = _C.protocol.dispersion(series)
+    assert block["outliers_marked"] == 0
+
+
+@pytest.mark.skipif(not B3C_PATH.exists(), reason="B3c microbench script not in this worktree")
+def test_dispersion_matches_b3c_implementation():
+    spec = importlib.util.spec_from_file_location("b3c_microbench", B3C_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    series = [1.0, 1.0, 1.0, 1.02, 1.0, 0.998, 1.001, 1.0, 1.0, 1.0, 1.0]
+    theirs = module.dispersion(series)
+    ours = _C.protocol.dispersion(series)
+    for key in ("median", "min", "p95", "max", "mean", "stdev", "cv", "p95_over_median",
+                "mad", "outlier_threshold", "outliers_marked", "outlier_ratio"):
+        assert ours[key] == pytest.approx(theirs[key]), key
+    assert ours["N"] == theirs["n"]
+
+
+# ---------------------------------------------------------------------------
+# 4. precision: semantic difference vs suspected bug
+# ---------------------------------------------------------------------------
+def _fake_inputs():
+    left = np.eye(2, dtype=np.float32)
+    right = np.eye(2, dtype=np.float32)
+    return {"left": left, "right": right, "dtype": "float32", "shape": {"k": 2}}
+
+
+def test_within_band_is_semantically_explained():
+    inputs = _fake_inputs()
+    reference = np.eye(2, dtype=np.float32) * np.float32(2.0)
+    candidate = reference * np.float32(1.0 + 5e-8)
+    block = _C.precision.compare_outputs(
+        dtype="float32",
+        inputs=inputs,
+        reference=reference,
+        candidate=candidate,
+        provider_spec={
+            "class": "bounded_tolerance",
+            "basis": "vendor blocked order",
+            "band_source": "derived",
+            "reduction_order_id": "vendor_v1",
+        },
+        reference_meta={"provider_id": "portable", "class": "bit_exact", "reduction_order_id": "portable_serial_k_ascending_v1"},
+        reference_sha256="ref",
+        candidate_sha256="cand",
+    )
+    assert block["verdict"] == _C.precision.VERDICT_WITHIN_BAND
+    assert block["bug_triage"]["verdict"] == _C.precision.TRIAGE_SEMANTIC_EXPLAINED
+    assert block["semantic_difference"]["is_different"] is True
+
+
+def test_beyond_band_is_flagged_as_suspected_bug():
+    inputs = _fake_inputs()
+    reference = np.eye(2, dtype=np.float32) * np.float32(2.0)
+    candidate = reference * np.float32(1.0 + 1e-3)
+    block = _C.precision.compare_outputs(
+        dtype="float32",
+        inputs=inputs,
+        reference=reference,
+        candidate=candidate,
+        provider_spec={
+            "class": "bounded_tolerance",
+            "basis": "vendor blocked order",
+            "band_source": "derived",
+            "reduction_order_id": "vendor_v1",
+        },
+        reference_meta={"provider_id": "portable", "class": "bit_exact", "reduction_order_id": "portable_serial_k_ascending_v1"},
+        reference_sha256="ref",
+        candidate_sha256="cand",
+    )
+    assert block["verdict"] == _C.precision.VERDICT_BEYOND_BAND
+    assert block["elements_over_band"] > 0
+    assert block["bug_triage"]["verdict"] == _C.precision.TRIAGE_SUSPECTED_BUG
+
+
+def test_bit_exact_mismatch_is_a_bug_candidate():
+    inputs = _fake_inputs()
+    reference = np.eye(2, dtype=np.float32)
+    candidate = reference + np.float32(1e-7)
+    block = _C.precision.compare_outputs(
+        dtype="float32",
+        inputs=inputs,
+        reference=reference,
+        candidate=candidate,
+        provider_spec={"class": "bit_exact", "basis": "bit exact", "band_source": None, "reduction_order_id": "x"},
+        reference_meta={"provider_id": "portable", "class": "bit_exact", "reduction_order_id": "x"},
+        reference_sha256="ref",
+        candidate_sha256="cand",
+    )
+    assert block["verdict"] == _C.precision.VERDICT_BITWISE_MISMATCH
+    assert block["bug_triage"]["verdict"] == _C.precision.TRIAGE_SUSPECTED_BUG
+
+
+# ---------------------------------------------------------------------------
+# 5. schema + report structure
+# ---------------------------------------------------------------------------
+def test_report_passes_schema_and_has_required_paths(tiny_report):
+    assert _C.schema.validate_report(tiny_report) == []
+    case = tiny_report["cases"][0]
+    for path in (["host_fingerprint"], ["library_versions"], ["provider_registry_state"], ["cases"]):
+        assert path[0] in tiny_report
+    for key in ("op", "shape", "dtype", "provider", "knobs", "seconds", "precision", "notes"):
+        assert key in case
+    assert set(["median", "dispersion", "N"]).issubset(case["seconds"])
+    assert set(["class", "basis", "verdict"]).issubset(case["precision"])
+    assert case["op_contract"]["digest"] == _C.get_op_definition("matmul").contract_digest
+
+
+def test_missing_required_field_fails_schema(tiny_report):
+    mutated = json.loads(json.dumps(tiny_report))
+    mutated["cases"][0].pop("seconds")
+    assert _C.schema.validate_report(mutated)
+    mutated = json.loads(json.dumps(tiny_report))
+    mutated.pop("host_fingerprint")
+    assert _C.schema.validate_report(mutated)
+
+
+def test_case_filter_marks_skipped_cases_explicitly(tiny_report):
+    statuses = {case["status"] for case in tiny_report["cases"]}
+    assert "skipped_user_request" in statuses
+    skipped = [case for case in tiny_report["cases"] if case["status"] == "skipped_user_request"]
+    assert all("case-filter" in case["notes"] for case in skipped)
+    assert all(case["seconds"] is None for case in skipped)
+
+
+# ---------------------------------------------------------------------------
+# 6. reproducibility + self-test
+# ---------------------------------------------------------------------------
+def test_repeat_run_structure_and_median_within_dispersion(tiny_report):
+    second = dict(_C.runner.run_report(_tiny_config()))
+    block = _C.runner._reproducibility([tiny_report, second])
+    assert block["structure_identical"] is True
+    assert block["verdict"] == "PASS", json.dumps(block, indent=2)
+
+
+def test_selftest_all_error_injections_pass():
+    config = _tiny_config(tag="pytest-selftest")
+    payload = _C.runner.run_selftest(config)
+    assert payload["status"] == "PASS"
+    assert payload["schema_validation"]["valid"] is True
+    assert payload["error_injection"]
+    assert all(check["verdict"] == "PASS" for check in payload["error_injection"])
+
+
+@pytest.mark.skipif(not Q8_MATRIX_PATH.exists(), reason="Q8 evidence matrix not on this host")
+def test_q8_alignment_maps_provider_shapes(tiny_report):
+    report = json.loads(json.dumps(tiny_report))
+    from pypto.op_bench.report import attach_q8_alignment
+
+    report["cases"][0]["provider"] = "vendor:aocl-lpgemm-bf16"
+    report["cases"][0]["shape"] = {"left": [1, 1024], "right": [1024, 32], "output": [1, 32]}
+    report["cases"][0]["seconds"]["median"] = 3.0e-6
+    result = attach_q8_alignment(report, vendor_matrix_path=str(Q8_MATRIX_PATH))
+    assert result is not None
+    assert result["rows"][0]["within_factor_2"] in (True, False)
