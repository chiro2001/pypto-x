+#!/usr/bin/env python3
+"""op-bench CLI wrapper (Q9).
+
+Sets ``PYPTO_X_PORTABLE_ONLY=1`` and puts this worktree's ``python/`` on
+``sys.path`` before importing :mod:`pypto`, then delegates to
+:func:`pypto.op_bench.cli.main`.
+
+Examples::
+
+    # light self-test (schema + error injection, no heavy lock needed)
+    python3 scripts/perf/op_bench.py selftest --out /tmp/op-bench-selftest
+
+    # heavy run through the local resource lock
+    scripts/resource/run_local_heavy.sh --task op-bench-framework --agent op-bench-framework -- \
+        env PYTHONPATH=python python3 scripts/perf/op_bench.py run \
+            --suite model --providers portable,vendor:aocl-lpgemm-bf16 \
+            --threads 6 --bind 0-5 --out <evidence-dir>
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+WORKTREE = os.path.abspath(os.path.join(HERE, "..", ".."))
+
+os.environ.setdefault("PYPTO_X_PORTABLE_ONLY", "1")
+if os.path.join(WORKTREE, "python") not in sys.path:
+    sys.path.insert(0, os.path.join(WORKTREE, "python"))
+
+from pypto.op_bench.cli import main  # noqa: E402
+
+if __name__ == "__main__":
+    raise SystemExit(main())
