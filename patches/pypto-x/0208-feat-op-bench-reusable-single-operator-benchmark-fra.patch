+#!/usr/bin/env bash
+# Q9 op-bench: x86 local run (model + boundary suites, three providers).
+#
+# Heavy: must be launched through scripts/resource/run_local_heavy.sh:
+#   scripts/resource/run_local_heavy.sh --task op-bench-framework --agent op-bench-framework -- \
+#       bash scripts/perf/op_bench_x86_run.sh
+#
+# Writes under _meta/pypto-x/op-bench-framework/{raw,logs}/x86/.
+set -euo pipefail
+
+WORKTREE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+EVIDENCE_DEFAULT="/home/chiro/projects/pypto/worktrees/_meta/pypto-x/op-bench-framework"
+EVIDENCE="${OP_BENCH_EVIDENCE:-$EVIDENCE_DEFAULT}"
+RAW="$EVIDENCE/raw/x86"
+LOGS="$EVIDENCE/logs/x86"
+Q8_MATRIX="$EVIDENCE/../../vendor-gemm-survey/raw/vendor-gemm-matrix.json"
+Q8_TABLE="$EVIDENCE/../../w8j-vllm-injection/raw/shape-ratio-table.json"
+THREADS="${OP_BENCH_THREADS:-6}"
+BIND="${OP_BENCH_BIND:-0-5}"
+export OMP_NUM_THREADS="$THREADS"
+export OMP_DYNAMIC=FALSE
+
+mkdir -p "$RAW" "$LOGS"
+cd "$WORKTREE"
+
+run_phase() {
+    local name="$1"; shift
+    echo "[op-bench-x86] phase=$name start=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+    set +e
+    "$@" >"$LOGS/$name.stdout.log" 2>"$LOGS/$name.stderr.log"
+    local code=$?
+    set -e
+    echo "[op-bench-x86] phase=$name exit=$code end=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+    return $code
+}
+
+# 1. main report: model (Q8 12 shapes, bf16) + boundary (rank2-4/K tail/empty/must-reject)
+run_phase main \
+    python3 scripts/perf/op_bench.py run \
+        --suite all \
+        --providers portable,vendor:aocl-lpgemm-bf16,vendor:aocl-lpgemm-f32 \
+        --threads "$THREADS" --bind "$BIND" \
+        --rounds auto --case-budget-seconds 20 --min-rounds 3 --iters 100 --warmup 5 \
+        --q8-vendor-matrix "$Q8_MATRIX" --q8-ratio-table "$Q8_TABLE" \
+        --tag q9-x86-model-boundary \
+        --out "$RAW/main"
+
+# 2. reproducibility: one cheap case, two runs (repeat=2), 21 rounds each
+run_phase repro \
+    python3 scripts/perf/op_bench.py run \
+        --suite boundary --case-filter m1_n32_k1024 \
+        --providers portable,vendor:aocl-lpgemm-bf16 \
+        --threads "$THREADS" --bind "$BIND" \
+        --rounds 21 --warmup 5 --iters 100 \
+        --repeat 2 \
+        --tag q9-x86-repro \
+        --out "$RAW/repro"
+
+# 3. light self-test: schema + error injection (also exercises the AOCL probe paths)
+run_phase selftest \
+    python3 scripts/perf/op_bench.py selftest --out "$RAW/selftest"
+
+echo "[op-bench-x86] done"
