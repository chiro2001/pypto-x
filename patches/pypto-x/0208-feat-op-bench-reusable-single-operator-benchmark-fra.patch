index 000000000..8c08b3c8e
--- /dev/null
+++ b/python/pypto/op_bench/protocol.py
@@ -0,0 +1,201 @@
+"""Measurement protocol constants and statistics for op-bench.
+
+**Single source of truth**: the constants in this module are copied from the
+frozen project protocol, not invented here:
+
+* ``docs/PERF_MEASUREMENT_PROTOCOL.zh-CN.md`` (controller repo ``pypto_x``)
+  sections 3.3 ("统计流程") and 3.4 ("方差上限");
+* the ERR-0004 revision in ``docs/00-handoffs/ERRATA.zh-CN.md`` (2026-09-11)
+  that added the floor to the MAD outlier gate;
+* ``scripts/perf/local_l0_microbench.py`` (B3c, integration branch) implements
+  the same rules; :func:`dispersion` / :func:`variance_verdict` below are a
+  line-faithful extraction of that file's ``dispersion`` (lines 495-531) and
+  ``variance_verdict`` (lines 533-542) so op-bench cannot drift from B3c.
+
+Rules (protocol 3.3, ERR-0004):
+
+* warmup W = 5, acceptance ``|last_warmup - min(first 5 measured)| / min < 0.05``
+  with at most 3 warmup rounds;
+* measured R rounds, no outlier removal;
+* outlier: ``|x - median| > max(3 * 1.4826 * MAD, floor)`` with
+  ``floor = max(1 us, 0.02 * median)``;
+* ``outlier_ratio > 0.10 -> UNSTABLE``;
+* R < 11 is not gate eligible (protocol 3.3);
+* local KVM without cpufreq: ``cv <= 0.05`` and ``p95/median <= 1.25``;
+  every number is permanently ``UNGATED`` (protocol 4.1 + 0006 section 13.7).
+"""
+
+from __future__ import annotations
+
+import math
+import statistics
+from typing import Any, Mapping, Sequence
+
+PROTOCOL_REVISION = "perf-protocol-2026-09-10+ERR-0004"
+
+PROTOCOL_SOURCE = {
+    "document": "docs/PERF_MEASUREMENT_PROTOCOL.zh-CN.md",
+    "revision": "ERR-0004 (docs/00-handoffs/ERRATA.zh-CN.md, 2026-09-11)",
+    "sections": ["3.3 统计流程", "3.4 方差上限", "4.1 本机（local）"],
+    "extraction_of": "scripts/perf/local_l0_microbench.py:489-542 (B3c)",
+    "err_0004_rule": "|x - median| > max(3 * 1.4826 * MAD, floor); "
+    "floor = max(1 us, 0.02 * median); outlier_ratio > 0.10 -> UNSTABLE",
+}
+
+# protocol 3.3 steps 2-4
+WARMUP_ROUNDS = 5
+WARMUP_ACCEPTANCE = 0.05
+WARMUP_MAX_ATTEMPTS = 3
+MEASURED_ROUNDS = 21
+L0_MEASURED_ROUNDS = 51
+GATE_ELIGIBLE_MIN_ROUNDS = 11
+
+# protocol 3.3 step 6 + ERR-0004
+OUTLIER_RATIO_MAX = 0.10
+OUTLIER_FLOOR_MIN_SECONDS = 1.0e-6
+OUTLIER_FLOOR_MEDIAN_FRACTION = 0.02
+MAD_SCALE = 1.4826
+MAD_MULTIPLIER = 3.0
+
+# protocol 3.4
+VARIANCE_LIMITS = {
+    "local_kvm_no_cpufreq": {"cv": 0.05, "p95_over_median": 1.25},
+    "rtx5080_clock_locked": {"cv": 0.03, "p95_over_median": 1.15},
+    "rtx5080_clock_unlocked": {"cv": 0.05, "p95_over_median": 1.25},
+    "ungated_reference": None,  # 鲲鹏 920B/A3 style: no variance gate, report only
+}
+
+# protocol 4.1 / U1 entry.GATE_REASON: host is a 12 vCPU KVM guest without
+# cpufreq control on a non-quiet window -> raw observations only.
+GATE_REASON = "host_kvm_no_cpufreq_non_quiet_window"
+UNGATED_STATUS = "UNGATED"
+
+VERDICT_VALID = "VALID"
+VERDICT_INSUFFICIENT = "INSUFFICIENT_SAMPLES"
+VERDICT_UNSTABLE = "UNSTABLE"
+VERDICT_INVALID_VARIANCE = "INVALID_VARIANCE"
+
+
+def percentile_nearest_rank(values: Sequence[float], fraction: float) -> float:
+    """Nearest-rank percentile, no interpolation (protocol 3.3 step 5)."""
+
+    ordered = sorted(values)
+    index = max(0, math.ceil(fraction * len(ordered)) - 1)
+    return ordered[index]
+
+
+def dispersion(values: Sequence[float], *, environment: str = "local_kvm_no_cpufreq") -> Mapping[str, Any]:
+    """Full dispersion block for one measured series.
+
+    Mirrors ``scripts/perf/local_l0_microbench.py:dispersion`` so op-bench and
+    B3c report identical statistics for identical samples.
+    """
+
+    if not values:
+        return {"N": 0}
+    ordered = sorted(values)
+    median = statistics.median(ordered)
+    stdev = statistics.stdev(ordered) if len(ordered) > 1 else 0.0
+    p95 = percentile_nearest_rank(ordered, 0.95)
+    mad = statistics.median([abs(value - median) for value in ordered]) if len(ordered) > 1 else 0.0
+    floor = max(OUTLIER_FLOOR_MIN_SECONDS, OUTLIER_FLOOR_MEDIAN_FRACTION * median)
+    mad_component = MAD_MULTIPLIER * MAD_SCALE * mad
+    threshold = max(mad_component, floor)
+    outliers = sum(1 for value in ordered if abs(value - median) > threshold)
+    block = {
+        "N": len(ordered),
+        "min": ordered[0],
+        "median": median,
+        "p95": p95,
+        "p95_method": "nearest_rank",
+        "max": ordered[-1],
+        "mean": statistics.fmean(ordered),
+        "stdev": stdev,
+        "stdev_method": "sample_n_minus_1",
+        "cv": (stdev / median) if median else 0.0,
+        "p95_over_median": (p95 / median) if median else 0.0,
+        "mad": mad,
+        "outlier_rule": PROTOCOL_SOURCE["err_0004_rule"],
+        "outlier_threshold": threshold,
+        "outlier_threshold_mad_component": mad_component,
+        "outlier_floor": floor,
+        "outliers_marked": outliers,
+        "outlier_ratio": outliers / len(ordered),
+        "gate_eligible_min_rounds": GATE_ELIGIBLE_MIN_ROUNDS,
+    }
+    block["verdict"] = variance_verdict(block, environment=environment)
+    return block
+
+
+def variance_verdict(stats: Mapping[str, Any], *, environment: str = "local_kvm_no_cpufreq") -> str:
+    """Protocol 3.3 step 7 + 3.4 verdict for one series."""
+
+    if stats.get("N", stats.get("n", 0)) < GATE_ELIGIBLE_MIN_ROUNDS:
+        return VERDICT_INSUFFICIENT
+    if stats.get("outlier_ratio", 0.0) > OUTLIER_RATIO_MAX:
+        return VERDICT_UNSTABLE
+    limits = VARIANCE_LIMITS.get(environment)
+    if limits is None:
+        return VERDICT_VALID
+    if stats["cv"] > limits["cv"] or stats["p95_over_median"] > limits["p95_over_median"]:
+        return VERDICT_INVALID_VARIANCE
+    return VERDICT_VALID
+
+
+def warmup_verdict(
+    measured: Sequence[float],
+    last_warmup: float,
+    *,
+    acceptance: float = WARMUP_ACCEPTANCE,
+) -> Mapping[str, Any]:
+    """Protocol 3.3 step 3: |last_warmup - min(measured)| / min(measured) < 0.05."""
+
+    if not measured:
+        return {"accepted": False, "reason": "no_measured_samples"}
+    baseline = min(measured)
+    if baseline <= 0.0:
+        return {"accepted": True, "reason": "non_positive_baseline_not_comparable", "relative": None}
+    relative = abs(last_warmup - baseline) / baseline
+    return {
+        "accepted": relative < acceptance,
+        "relative": relative,
+        "acceptance": acceptance,
+        "reason": "within_acceptance" if relative < acceptance else "warmup_not_converged",
+    }
+
+
+def environment_for_host(virtualization: str, cpufreq_available: bool) -> str:
+    """Map host facts to the protocol 3.4 row."""
+
+    if virtualization in ("kvm", "wsl") or not cpufreq_available:
+        return "local_kvm_no_cpufreq"
+    return "ungated_reference"
+
+
+__all__ = [
+    "GATE_ELIGIBLE_MIN_ROUNDS",
+    "GATE_REASON",
+    "L0_MEASURED_ROUNDS",
+    "MAD_MULTIPLIER",
+    "MAD_SCALE",
+    "MEASURED_ROUNDS",
+    "OUTLIER_FLOOR_MEDIAN_FRACTION",
+    "OUTLIER_FLOOR_MIN_SECONDS",
+    "OUTLIER_RATIO_MAX",
+    "PROTOCOL_REVISION",
+    "PROTOCOL_SOURCE",
+    "UNGATED_STATUS",
+    "VARIANCE_LIMITS",
+    "VERDICT_INSUFFICIENT",
+    "VERDICT_INVALID_VARIANCE",
+    "VERDICT_UNSTABLE",
+    "VERDICT_VALID",
+    "WARMUP_ACCEPTANCE",
+    "WARMUP_MAX_ATTEMPTS",
+    "WARMUP_ROUNDS",
+    "dispersion",
+    "environment_for_host",
+    "percentile_nearest_rank",
+    "variance_verdict",
+    "warmup_verdict",
+]
