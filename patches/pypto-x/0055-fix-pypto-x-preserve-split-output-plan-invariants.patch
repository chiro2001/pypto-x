From 31a5c46b010a621e54b8dedaa81c97a98dfc4e3e Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Tue, 8 Sep 2026 23:26:10 +0800
Subject: [PATCH 055/235] fix(pypto-x): preserve split output plan invariants

---
 python/pypto/lowering/cpu/vector/plan.py            | 24 +++++++++++++++++++-----
 python/tests/ut/pypto_x/test_cpu_sve256_indexing.py |  4 ++++
 2 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/python/pypto/lowering/cpu/vector/plan.py b/python/pypto/lowering/cpu/vector/plan.py
index 4f7400cf4..9617af3e3 100644
--- a/python/pypto/lowering/cpu/vector/plan.py
+++ b/python/pypto/lowering/cpu/vector/plan.py
@@ -1441,6 +1441,13 @@ class VectorPlan:
             raise CpuVectorValidationError("concat plan carries conflicting details")
         if plan_kind == "indexing" and details != (None, None, indexing_plan):
             raise CpuVectorValidationError("indexing plan carries conflicting details")
+        if plan_kind == "split" and (
+            normalized_shape != split_plan.output_shapes[0]
+            or normalized_output_shapes != split_plan.output_shapes
+        ):
+            raise CpuVectorValidationError(
+                "split primary/output shapes do not match split details"
+            )
 
     @property
     def vector_blocks(self) -> Tuple[VectorChunk, ...]:
@@ -1638,8 +1645,15 @@ def _make_plan_for_operation(
         input_shape = static_shape(operation.inputs[0].type, "vector split input")
         _check_layout(program, operation, (operation.inputs[0],), "function operation {}".format(operation_index))
         split = _split_descriptor(operation, input_shape)
-        axis = split.axis
-        iteration = make_iteration_plan(split.source_elements, lane_count, len(input_shape) - 1, tail_policy, compact=True)
+        # Preserve the legacy single-output fields as aliases for the first
+        # output.  The complete multi-output/source domain lives in
+        # SplitPlan, so output_name/output_shape never describe the input.
+        primary_shape = split.output_shapes[0]
+        primary_elements = _bounded_product(primary_shape, "split.primary_output_shape")
+        primary_axis = len(primary_shape) - 1 if primary_shape else None
+        iteration = make_iteration_plan(
+            primary_elements, lane_count, primary_axis, tail_policy, compact=True
+        )
         return VectorPlan(
             VECTOR_PLAN_VERSION,
             name,
@@ -1648,10 +1662,10 @@ def _make_plan_for_operation(
             tuple(ref.name for ref in operation.inputs),
             operation.outputs[0].name,
             canonical_dtype(operation.inputs[0].type.dtype),
-            input_shape,
+            primary_shape,
             "row_major_contiguous",
-            len(input_shape) - 1 if input_shape else None,
-            split.source_elements,
+            primary_axis,
+            primary_elements,
             lane_count,
             iteration,
             required_features,
diff --git a/python/tests/ut/pypto_x/test_cpu_sve256_indexing.py b/python/tests/ut/pypto_x/test_cpu_sve256_indexing.py
index e778911db..3104b3ee3 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256_indexing.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256_indexing.py
@@ -104,6 +104,10 @@ def test_indexing_plans_are_compact_and_vector_reference_matches_scalar(tmp_path
     split_plan = lower_cpu_vector(split_program, VECTOR_TARGET).plans[0]
     assert split_plan.output_names == ("left", "right")
     assert split_plan.output_shapes == ((2, 2), (2, 4))
+    assert split_plan.output_name == "left"
+    assert split_plan.output_shape == split_plan.shape == (2, 2)
+    assert split_plan.element_count == 4
+    assert split_plan.split_plan.source_elements == 12
     assert split_plan.iteration.compact and split_plan.split_plan is not None
 
 
