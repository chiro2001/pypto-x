+def _validate_compare(operation: Operation, context: str) -> None:
+    if len(operation.inputs) != 2:
+        raise CpuScalarValidationError("{} compare requires two inputs".format(context))
+    output_type = _one_output(operation, "compare")
+    left_type, right_type = (ref.type for ref in operation.inputs)
+    for value_type, label in ((left_type, "left"), (right_type, "right")):
+        if not (_is_tensor(value_type) or _is_scalar(value_type)):
+            raise CpuScalarUnsupportedError(
+                "{} compare {} kind {!r} is unsupported".format(context, label, value_type.kind)
+            )
+        _validate_dtype(value_type, context + "." + label)
+        if _is_tensor(value_type):
+            static_shape(value_type, context + "." + label)
+    if not (_is_tensor(output_type) or _is_scalar(output_type)):
+        raise CpuScalarUnsupportedError("{} compare output kind {!r} is unsupported".format(context, output_type.kind))
+    _validate_dtype(output_type, context + ".output")
+    if canonical_dtype(output_type.dtype) != "bool":
+        raise CpuScalarValidationError("{} compare output must have bool dtype".format(context))
+    left_dtype = canonical_dtype(left_type.dtype)
+    right_dtype = canonical_dtype(right_type.dtype)
+    if left_dtype != right_dtype:
+        raise CpuScalarValidationError("{} compare inputs must have matching dtypes".format(context))
+    predicate = comparison_predicate(_attrs(operation), context + ".compare")
+    if left_dtype == "bool" and predicate not in ("eq", "ne"):
+        raise CpuScalarUnsupportedError("{} ordered bool comparison is unsupported".format(context))
+    tensor_types = [value_type for value_type in (left_type, right_type) if _is_tensor(value_type)]
+    if not tensor_types:
+        if not _is_scalar(output_type):
+            raise CpuScalarValidationError("{} scalar compare output must be scalar".format(context))
+        return
+    if not _is_tensor(output_type):
+        raise CpuScalarValidationError("{} tensor compare output must be tensor".format(context))
+    expected_shape = _broadcast_shape(
+        [static_shape(value_type, context + ".shape") for value_type in tensor_types],
+        context + ".compare",
+    )
+    if static_shape(output_type, context + ".output") != expected_shape:
+        raise CpuScalarValidationError(
+            "{} output shape {} does not match broadcast shape {}".format(
+                context, output_type.shape, expected_shape
+            )
+        )
+
+
+def _validate_iota(operation: Operation, context: str) -> None:
+    if operation.inputs:
+        raise CpuScalarValidationError("{} iota must not have inputs".format(context))
+    _one_output(operation, "iota")
+    iota_spec(operation.outputs[0].type, _attrs(operation), context + ".iota")
+
