+def comparison_predicate(attributes: Mapping[str, Any], context: str = "compare") -> str:
+    """Return the explicit M1H comparison predicate.
+
+    ``predicate`` is the canonical spelling.  A few audited aliases are
+    accepted for adapters, but conflicting spellings are rejected instead of
+    letting different lowerings silently choose different relations.
+    """
+
+    present = [key for key in ("predicate", "comparison", "relation", "op") if key in attributes]
+    if not present:
+        raise CpuScalarValidationError("{} requires predicate".format(context))
+    raw = attributes[present[0]]
+    if not isinstance(raw, str):
+        raise CpuScalarValidationError("{} predicate must be a string".format(context))
+    predicate = raw.strip().lower()
+    aliases = {
+        "equal": "eq",
+        "==": "eq",
+        "not_equal": "ne",
+        "!=": "ne",
+        "less": "lt",
+        "<": "lt",
+        "less_equal": "le",
+        "<=": "le",
+        "greater": "gt",
+        ">": "gt",
+        "greater_equal": "ge",
+        ">=": "ge",
+    }
+    predicate = aliases.get(predicate, predicate)
+    if predicate not in COMPARISON_PREDICATES:
+        raise CpuScalarValidationError(
+            "{} predicate must be one of {}".format(context, ", ".join(sorted(COMPARISON_PREDICATES)))
+        )
+    for key in present[1:]:
+        other = attributes[key]
+        if not isinstance(other, str):
+            raise CpuScalarValidationError("{} predicate must be a string".format(context))
+        other = aliases.get(other.strip().lower(), other.strip().lower())
+        if other != predicate:
+            raise CpuScalarValidationError("{} contains conflicting predicate attributes".format(context))
+    return predicate
+
+
+def _signed_i64(value: Any, context: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise CpuScalarValidationError("{} must be an integer".format(context))
+    if value < -(1 << 63) or value > (1 << 63) - 1:
+        raise CpuScalarValidationError("{} must fit signed int64".format(context))
+    return value
+
+
+def iota_spec(output_type: CoreType, attributes: Mapping[str, Any], context: str = "iota") -> Tuple[int, int, int]:
+    """Validate an integer iota domain and return ``(axis, start, step)``.
+
+    The operation is static-shape specialized.  Bounds are checked in signed
+    int64 before narrowing to the declared int32/int64 output dtype, including
+    negative starts/steps and an empty axis.
+    """
+
+    if not _is_tensor(output_type):
+        raise CpuScalarUnsupportedError("{} output must be a tensor".format(context))
+    dtype = canonical_dtype(output_type.dtype)
+    if dtype not in ("int32", "int64"):
+        raise CpuScalarUnsupportedError("{} output dtype must be int32 or int64".format(context))
+    shape = static_shape(output_type, context + ".output")
+    if not shape:
+        raise CpuScalarValidationError("{} output rank must be at least one".format(context))
+    raw_axis = attributes.get("axis", 0)
+    if isinstance(raw_axis, bool) or not isinstance(raw_axis, int):
+        raise CpuScalarValidationError("{} axis must be an integer".format(context))
+    axis = raw_axis + len(shape) if raw_axis < 0 else raw_axis
+    if axis < 0 or axis >= len(shape):
+        raise CpuScalarValidationError("{} axis {} is outside rank {}".format(context, raw_axis, len(shape)))
+    start = _signed_i64(attributes.get("start", 0), context + ".start")
+    step = _signed_i64(attributes.get("step", 1), context + ".step")
+    dimension = shape[axis]
+    if dimension:
+        delta = (dimension - 1) * step
+        endpoint = start + delta
+        if endpoint < -(1 << 63) or endpoint > (1 << 63) - 1:
+            raise CpuScalarValidationError("{} sequence overflows signed int64".format(context))
+        low, high = sorted((start, endpoint))
+        if dtype == "int32" and (low < -(1 << 31) or high > (1 << 31) - 1):
+            raise CpuScalarValidationError("{} sequence does not fit int32".format(context))
+    return axis, start, step
+
+
+def iota_values(output_type: CoreType, attributes: Mapping[str, Any], context: str = "iota") -> list:
+    """Materialize the validated logical iota for reference runtimes."""
+
+    axis, start, step = iota_spec(output_type, attributes, context)
+    shape = static_shape(output_type, context + ".output")
+    dtype = canonical_dtype(output_type.dtype)
+    result = []
+    for output_index in range(element_count(shape)):
+        coordinates = _unravel_index(output_index, shape)
+        result.append(_cast_integer(start + coordinates[axis] * step, dtype, context))
+    return result
+
+
+def _cast_integer(value: int, dtype: str, context: str) -> int:
+    limits = SIGNED_INTEGER_LIMITS.get(dtype) or UNSIGNED_INTEGER_LIMITS.get(dtype)
+    if limits is None or value < limits[0] or value > limits[1]:
+        raise CpuScalarValidationError("{} value {} is outside {} range".format(context, value, dtype))
+    return int(value)
+
+
+def _unravel_index(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
+    coordinates = [0] * len(shape)
+    remainder = index
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension:
+            coordinates[axis] = remainder % dimension
+            remainder //= dimension
+    return tuple(coordinates)
+
+
+def compare_values(
+    left: Any,
+    left_type: CoreType,
+    right: Any,
+    right_type: CoreType,
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+    context: str = "compare",
+) -> Any:
+    """Evaluate a broadcasted compare for scalar/vector reference runtimes."""
+
+    predicate = comparison_predicate(attributes, context)
+    output_shape = static_shape(output_type, context + ".output") if _is_tensor(output_type) else ()
+    output_count = element_count(output_shape) if _is_tensor(output_type) else 1
+    sources = ((left, left_type, "left"), (right, right_type, "right"))
+    prepared = []
+    for value, value_type, label in sources:
+        if _is_scalar(value_type):
+            prepared.append((value, None))
+            continue
+        shape = static_shape(value_type, context + "." + label)
+        expected = element_count(shape)
+        if not isinstance(value, list) or len(value) != expected:
+            raise CpuScalarError("{} {} storage length mismatch".format(context, label))
+        prepared.append((value, shape))
+
+    def source_at(item: Tuple[Any, Optional[Tuple[int, ...]]], coordinates: Tuple[int, ...]) -> Any:
+        value, shape = item
+        if shape is None:
+            return value
+        rank_delta = len(output_shape) - len(shape)
+        source_coordinates = [
+            0 if dimension == 1 else coordinates[axis + rank_delta]
+            for axis, dimension in enumerate(shape)
+        ]
+        return value[_ravel_index(source_coordinates, shape)]
+
+    def relation(a: Any, b: Any) -> bool:
+        if predicate == "eq":
+            return a == b
+        if predicate == "ne":
+            return a != b
+        if predicate == "lt":
+            return a < b
+        if predicate == "le":
+            return a <= b
+        if predicate == "gt":
+            return a > b
+        return a >= b
+
+    result = []
+    for output_index in range(output_count):
+        coordinates = _unravel_index(output_index, output_shape)
+        result.append(relation(source_at(prepared[0], coordinates), source_at(prepared[1], coordinates)))
+    return result[0] if _is_scalar(output_type) else result
+
+
+def _ravel_index(coordinates: Sequence[int], shape: Sequence[int]) -> int:
+    index = 0
+    for coordinate, dimension in zip(coordinates, shape):
+        if coordinate < 0 or coordinate >= dimension:
+            raise CpuScalarError("compare coordinate is outside tensor shape")
+        index = index * dimension + coordinate
+    return index
+
+
 def static_shape(value_type: CoreType, context: str) -> Tuple[int, ...]:
     """Return a concrete shape; symbolic runtime specialization is W3+."""
 
@@ -759,6 +997,57 @@ def _validate_where(operation: Operation, context: str) -> None:
