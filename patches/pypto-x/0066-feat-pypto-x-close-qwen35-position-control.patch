diff --git a/python/tests/ut/pypto_x/test_qwen35_position_control.py b/python/tests/ut/pypto_x/test_qwen35_position_control.py
new file mode 100644
index 000000000..987e552ad
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_qwen35_position_control.py
@@ -0,0 +1,178 @@
+"""M1H position/control closure for Qwen3.5-0.8B.
+
+The tests use only synthetic integer/boolean tensors and no checkpoint data.
+SVE position/control execution is deliberately checked as the explicit
+host-reference fallback carried by an SVE256 artifact; AVX remains a clear
+unsupported lowering until the later parity wave.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.aarch64.sve256 import Sve256Runtime
+from pypto.backends.cpu.vector import CpuVectorRuntime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu.x86.avx2.lowering import Avx2UnsupportedError, lower_avx2
+from pypto.portable.qwen35 import (
+    QWEN35_08B_SHAPE_METADATA,
+    build_qwen35_position_control,
+    build_qwen35_position_ids,
+    build_qwen35_text_decoder_graph,
+    qwen35_text_decoder_manifest,
+)
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+VECTOR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu", attributes={"lane_count": 4})
+SVE_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2"),
+    attributes={"vl_bytes": 32},
+)
+
+
+def _compile_scalar(program):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _compile_vector(program):
+    compiler = CpuVectorCompiler()
+    return compiler.compile(compiler.lower(program, VECTOR_TARGET))
+
+
+def _compile_sve(program, tmp_path: Path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+    return target_ir, artifact
+
+
+def _launch(artifact, inputs, outputs, runtime):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+        )
+    )
+
+
+def test_iota_compare_scalar_vector_and_edge_contracts():
+    program = build_qwen35_position_control(1, 3, past_length=2, index_dtype="int32")
+    scalar_outputs = [HostTensor("int32", (1, 3)), HostTensor("bool", (1, 8, 3, 5))]
+    vector_outputs = [HostTensor("int32", (1, 3)), HostTensor("bool", (1, 8, 3, 5))]
+    _launch(_compile_scalar(program), [], scalar_outputs, CpuScalarRuntime())
+    _launch(_compile_vector(program), [], vector_outputs, CpuVectorRuntime())
+    assert scalar_outputs[0].tolist() == [[2, 3, 4]]
+    assert vector_outputs[0].flat() == scalar_outputs[0].flat()
+    assert vector_outputs[1].flat() == scalar_outputs[1].flat()
+    assert scalar_outputs[1].tolist()[0][0][0] == [True, True, True, False, False]
+    assert scalar_outputs[1].tolist()[0][0][1] == [True, True, True, True, False]
+
+    # Generic Core iota retains signed starts/steps even though model position
+    # ids reject a negative cache offset.
+    iota_result = ValueRef("result", CoreType.tensor("int32", (4,)))
+    iota_program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "negative_iota",
+                (),
+                (iota_result,),
+                Region((Operation("iota", (), (iota_result,), {"start": -2, "step": -1}),)),
+            ),
+        )
+    )
+    iota_output = HostTensor.zeros("int32", (4,))
+    _launch(_compile_scalar(iota_program), [], [iota_output], CpuScalarRuntime())
+    assert iota_output.flat() == (-2, -3, -4, -5)
+
+    zero = build_qwen35_position_control(1, 0, past_length=2, index_dtype="int64")
+    zero_outputs = [HostTensor("int64", (1, 0)), HostTensor("bool", (1, 8, 0, 2))]
+    _launch(_compile_scalar(zero), [], zero_outputs, CpuScalarRuntime())
+    assert zero_outputs[0].flat() == ()
+    assert zero_outputs[1].flat() == ()
+
+    with pytest.raises(ValueError, match="non-negative"):
+        build_qwen35_position_ids(1, 1, past_length=-1)
+    with pytest.raises(ValueError, match="signed int64"):
+        build_qwen35_position_ids(1, 1, past_length=1 << 63)
+    with pytest.raises(ValueError, match="int32"):
+        build_qwen35_position_ids(1, 1, past_length=1 << 31, index_dtype="int32")
+
+
+def test_sve_qemu_position_control_differential_and_metadata(tmp_path):
+    program = build_qwen35_position_control(1, 2, past_length=3, index_dtype="int64")
+    target_ir, artifact = _compile_sve(program, tmp_path)
+    assert target_ir.vector_program.plan_version == 3
+    assert target_ir.lowering_version == 6
+    assert artifact.metadata["plan_version"] == 3
+    assert artifact.metadata["lowering_version"] == 6
+    assert [plan.operation for plan in target_ir.plans] == ["iota", "iota", "iota", "compare"]
+    assert tuple(artifact.metadata["position_control_operations"]) == ("iota", "iota", "iota", "compare")
+    assert artifact.metadata["position_control_fallback"] == "host_reference"
+    assert "index_map" not in json.dumps(target_ir.to_dict(), sort_keys=True)
+    scalar_outputs = [HostTensor("int64", (1, 2)), HostTensor("bool", (1, 8, 2, 5))]
+    sve_outputs = [HostTensor("int64", (1, 2)), HostTensor("bool", (1, 8, 2, 5))]
+    _launch(_compile_scalar(program), [], scalar_outputs, CpuScalarRuntime())
+    _launch(artifact, [], sve_outputs, Sve256Runtime(execution_mode="qemu"))
+    assert sve_outputs[0].flat() == scalar_outputs[0].flat() == (3, 4)
+    assert sve_outputs[1].flat() == scalar_outputs[1].flat()
+
+
+def test_avx2_position_control_is_explicitly_rejected():
+    program = build_qwen35_position_ids(1, 1, past_length=0)
+    target = TargetSpec("cpu", "x86_64-linux-gnu", features=("avx", "avx2", "osxsave", "ymm"))
+    with pytest.raises(Avx2UnsupportedError, match="iota"):
+        lower_avx2(program, target)
+
+
+def test_text_decoder_manifest_has_fixed_routes_and_no_weight_execution():
+    manifest = qwen35_text_decoder_manifest(1, 2, past_length=4)
+    assert manifest["graph_kind"] == "text_decoder_structural_no_weight"
+    assert manifest["weights_embedded"] is False
+    assert manifest["weight_execution"] is False
+    assert len(manifest["layers"]) == 24
+    assert len(manifest["gdr_layer_indices"]) == 18
+    assert manifest["full_attention_layer_indices"] == [3, 7, 11, 15, 19, 23]
+    assert manifest["causal_mask_shape"] == [1, 8, 2, 6]
+    assert manifest["hidden_output_shape"] == [1, 2, QWEN35_08B_SHAPE_METADATA["hidden_size"]]
+    program = build_qwen35_text_decoder_graph(1, 2, past_length=4)
+    assert program.metadata["whole_model_execution"] == "not_claimed"
+    assert tuple(program.metadata["executable_operations"]) == ("identity",)
+    assert [item.name for item in program.functions[0].parameters] == [
+        "hidden_states", "position_ids", "causal_mask"
+    ]
+
+
+def test_generic_compare_requires_bool_output_and_supports_broadcast():
+    left = ValueRef("left", CoreType.tensor("int64", (1, 3, 1)))
+    right = ValueRef("right", CoreType.tensor("int64", (1, 1, 4)))
+    output = ValueRef("output", CoreType.tensor("bool", (1, 3, 4)))
+    operation = Operation("compare", (left, right), (output,), {"predicate": "le"})
+    program = CoreProgram(
+        functions=(CoreFunction("compare", (left, right), (output,), Region((operation,))),)
+    )
+    destination = HostTensor.zeros("bool", (1, 3, 4))
+    _launch(_compile_scalar(program), [HostTensor("int64", (1, 3, 1), [0, 1, 2]), HostTensor("int64", (1, 1, 4), [0, 1, 2, 3])], [destination], CpuScalarRuntime())
+    assert destination.tolist() == [
+        [[True, True, True, True], [False, True, True, True], [False, False, True, True]]
+    ]
