+    index_dtype: str = "int64",
+) -> CoreProgram:
+    """Build a full-attention bool mask from absolute query/key positions.
+
+    The returned shape is ``[B, query_heads, T, P+T]`` and the logical rule is
+    ``key_position <= query_position``.  Query positions start at ``P`` and
+    key positions start at zero, so both prefill (``P=0``) and decode/chunk
+    (``P>0``) use the same graph.  The two iota inputs are singleton-expanded
+    through compare broadcasting; the mask is not supplied by the host.
+    """
+
+    batch = _positive_or_zero_int(batch, "batch", allow_zero=False)
+    steps = _positive_or_zero_int(steps, "steps", allow_zero=True)
+    past_length = _positive_or_zero_int(past_length, "past_length", allow_zero=True)
+    query_heads = _positive_or_zero_int(query_heads, "query_heads", allow_zero=False)
+    index_dtype = _qwen35_index_dtype(index_dtype)
+    _validate_position_range(index_dtype, past_length, steps)
+    total = past_length + steps
+    if total > (1 << 63) - 1:
+        raise ValueError("past_length + steps overflows signed int64")
+    mask_shape = (batch, query_heads, steps, total)
+    # Materialize batch/head singleton semantics in the logical iota shapes
+    # so the Core compare follows ordinary broadcast rules and its declared
+    # result is exactly [B,H,T,P+T].
+    query_shape = (batch, query_heads, steps, 1)
+    key_shape = (batch, query_heads, 1, total)
+    builder = _Builder("qwen35_causal_mask_from_positions", "causal_mask_from_positions", mask_shape)
+    query_positions = builder.op(
