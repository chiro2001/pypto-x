+def _positive_or_zero_int(value: Any, field: str, *, allow_zero: bool = True) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError("{} must be an integer".format(field))
+    if value < 0 or (not allow_zero and value == 0):
+        qualifier = "non-negative" if allow_zero else "positive"
+        raise ValueError("{} must be {}".format(field, qualifier))
+    return value
+
+
+def _qwen35_index_dtype(value: Any) -> str:
+    return _index_dtype(value)
+
+
+def _validate_position_range(index_dtype: str, past_length: int, steps: int) -> None:
+    total = past_length + steps
+    if total > (1 << 63) - 1:
+        raise ValueError("past_length + steps overflows signed int64")
+    if index_dtype == "int32" and total > (1 << 31):
+        raise ValueError("position ids do not fit int32")
+
+
+def build_qwen35_position_ids(
+    batch: int,
+    steps: int,
+    past_length: int = 0,
+    index_dtype: str = "int64",
+) -> CoreProgram:
+    """Build text position ids as a static-shape ``iota`` specialization.
+
+    The graph represents the text-only Transformers rule
+    ``arange(steps) + past_length``.  ``past_length`` is deliberately a
+    compile-time cache specialization in this first closure, matching the
+    existing static KV/GDR shape contracts; no host mutation or hidden cache
+    state is introduced.  Negative ``past_length`` is rejected for model
+    positions, while the generic Core ``iota`` operation still supports
+    negative starts for standalone arithmetic tests.
+    """
+
+    batch = _positive_or_zero_int(batch, "batch", allow_zero=False)
+    steps = _positive_or_zero_int(steps, "steps", allow_zero=True)
+    past_length = _positive_or_zero_int(past_length, "past_length", allow_zero=True)
+    index_dtype = _qwen35_index_dtype(index_dtype)
+    _validate_position_range(index_dtype, past_length, steps)
+    shape = (batch, steps)
+    builder = _Builder("qwen35_position_ids", "position_ids", shape)
+    positions = builder.op(
+        "iota",
+        (),
+        (("position_ids", _tensor(index_dtype, shape)),),
+        {"axis": 1, "start": past_length, "step": 1},
+    )[0]
+    return builder.finish(
+        (positions,),
+        {
+            "formula": "iota(axis=1,start=past_length,step=1)",
+            "position_ids_shape": list(shape),
+            "position_dtype": index_dtype,
+            "past_length": past_length,
+            "past_length_semantics": "static_cache_offset_specialization",
+            "negative_past_length": "rejected_for_model_positions",
+            "zero_length_steps": steps == 0,
+            "host_mutation": False,
+        },
+    )
