+    def event_synchronize(self, event: Any) -> None:
+        self._require_event_api("cuEventSynchronize")
+        self._check("cuEventSynchronize", self._cuEventSynchronize(_as_ptr(self._event_handle(event))))
+
+    def event_elapsed_time_ms(self, start: Any, end: Any) -> float:
+        """Return the device elapsed milliseconds between two recorded events."""
+
+        self._require_event_api("cuEventElapsedTime")
+        value = ctypes.c_float()
+        self._check(
+            "cuEventElapsedTime",
+            self._cuEventElapsedTime(
+                ctypes.byref(value),
+                _as_ptr(self._event_handle(start)),
+                _as_ptr(self._event_handle(end)),
+            ),
+        )
+        return float(value.value)
+
+    def event_elapsed_time_seconds(self, start: Any, end: Any) -> float:
+        return self.event_elapsed_time_ms(start, end) / 1000.0
+
+    def event_destroy(self, event: Any) -> None:
+        self._require_event_api("cuEventDestroy")
+        self._check("cuEventDestroy", self._cuEventDestroy(_as_ptr(self._event_handle(event))))
