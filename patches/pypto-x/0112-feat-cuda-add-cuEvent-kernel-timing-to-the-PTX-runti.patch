+        ),
+        outputs=(TensorDesc("float32", (5,), device="gpu", handle=output),),
+        stream_handle=stream,
+    )
+    return request, output
+
+
+def test_runtime_launch_timed_reports_event_wall_and_dispatch_seconds():
+    driver = _FakeEventDriver(elapsed_ms=2.5)
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, output = _timing_request(target_ir, artifact, stream=0x99)
+    runtime = CudaRuntime(driver=driver)
+    results, timing = runtime.launch_timed(request)
+    assert results == (output,)
+    assert timing.device_event_timing is True
+    assert timing.kernel_seconds == pytest.approx(0.0025)
+    assert timing.wall_seconds > 0
+    assert timing.dispatch_seconds is not None and timing.dispatch_seconds >= 0
+    assert timing.timed_region_wall_seconds is not None and timing.timed_region_wall_seconds > 0
+    assert timing.timing_error is None
+    assert runtime.last_timing is timing
+    payload = timing.to_dict()
+    assert set(payload) == {
+        "kernel_seconds", "dispatch_seconds", "wall_seconds",
+        "timed_region_wall_seconds", "device_event_timing", "timing_error",
+    }
+    assert payload["kernel_seconds"] == pytest.approx(0.0025)
+    assert payload["device_event_timing"] is True
+    assert payload["timing_error"] is None
+    assert [stream for _event, stream in driver.recorded_events] == [0x99, 0x99]
+    assert len(driver.created_events) == 2
+    assert all(event.closed for event in driver.created_events)
+    assert len(driver.destroyed_events) == 2
+
+
+def test_runtime_launch_keeps_tuple_contract_and_updates_last_timing():
+    driver = _FakeEventDriver(elapsed_ms=1.0)
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, _ = _timing_request(target_ir, artifact)
+    runtime = CudaRuntime(driver=driver)
+    results = runtime.launch(request)
+    assert isinstance(results, tuple) and len(results) == 1
+    assert runtime.last_timing.kernel_seconds == pytest.approx(0.001)
+    assert runtime.last_timing.device_event_timing is True
+
+
+def test_runtime_without_event_api_still_reports_wall_seconds_only():
+    driver = _FakeDriver()
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, _ = _timing_request(target_ir, artifact)
+    runtime = CudaRuntime(driver=driver)
+    runtime.launch(request)
+    timing = runtime.last_timing
+    assert timing.kernel_seconds is None
+    assert timing.dispatch_seconds is None
+    assert timing.device_event_timing is False
+    assert timing.timing_error is None
+    assert timing.wall_seconds is not None and timing.wall_seconds >= 0
+
+
+def test_runtime_destroys_timing_events_when_launch_fails():
+    driver = _FakeEventDriver(fail_launch=True)
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, _ = _timing_request(target_ir, artifact)
+    runtime = CudaRuntime(driver=driver)
+    with pytest.raises(CudaExecutionError, match="CUDA launch failed"):
+        runtime.launch_timed(request)
+    assert len(driver.created_events) == 2
+    assert all(event.closed for event in driver.created_events)
+    assert len(driver.destroyed_events) == 2
+    assert runtime.last_timing is None
+
+
+def test_runtime_degrades_when_event_creation_or_record_fails():
+    driver = _FakeEventDriver(fail_create=True)
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, _ = _timing_request(target_ir, artifact)
+    runtime = CudaRuntime(driver=driver)
+    _, timing = runtime.launch_timed(request)
+    assert timing.kernel_seconds is None
+    assert "CUDA event creation failed" in timing.timing_error
+
+    driver = _FakeEventDriver(fail_record=True)
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, _ = _timing_request(target_ir, artifact)
+    runtime = CudaRuntime(driver=driver)
+    _, timing = runtime.launch_timed(request)
+    assert timing.kernel_seconds is None
+    assert "cuEventRecord(start) failed" in timing.timing_error
+    assert len(driver.created_events) == 2
+    assert all(event.closed for event in driver.created_events)
+
+
+def test_runtime_event_timing_can_be_disabled():
+    driver = _FakeEventDriver()
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    request, _ = _timing_request(target_ir, artifact)
+    runtime = CudaRuntime(driver=driver, timing=False)
+    runtime.launch(request)
+    assert runtime.last_timing.kernel_seconds is None
+    assert driver.created_events == []
