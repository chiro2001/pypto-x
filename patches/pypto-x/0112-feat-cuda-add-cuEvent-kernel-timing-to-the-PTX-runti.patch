+    def _create_event_pair(self) -> Tuple[Any, Any, Optional[str]]:
+        """Create a start/stop event pair, returning ``None`` events on failure.
+
+        Timing is an observability layer; a driver that cannot create events
+        degrades to ``kernel_seconds=None`` with ``timing_error`` recorded
+        instead of changing the result of a correctness-critical launch.
+        """
