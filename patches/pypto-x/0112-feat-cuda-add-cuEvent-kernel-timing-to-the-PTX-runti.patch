+@dataclass(frozen=True)
+class CudaLaunchTiming:
+    """Timing decomposition of one :meth:`CudaRuntime.launch` call.
+
+    ``kernel_seconds`` is measured with CUDA events recorded on the launch
+    stream, so it covers the kernels plus any stream-ordered work the runtime
+    enqueues between them (for example the scalar-result synchronization in
+    the explicit orchestrator fallback).  ``wall_seconds`` is the full host
+    wall time of the call and ``dispatch_seconds`` is ``wall_seconds`` minus
+    ``kernel_seconds`` floored at zero, i.e. everything that is not device
+    execution (module JIT, allocations, host/device copies, Python dispatch).
+    ``timed_region_wall_seconds`` is a host-clock measurement anchored just
+    after the start event is armed and closed out after the stop event has
+    been synchronized; it exists so the event timer can be cross-checked
+    against the host clock on exactly the same device interval.
+    ``timing_error`` is only set when the driver event API failed and the
+    launch was allowed to continue without a ``kernel_seconds`` value.
+    """
+
+    kernel_seconds: Optional[float] = None
+    dispatch_seconds: Optional[float] = None
+    wall_seconds: Optional[float] = None
+    timed_region_wall_seconds: Optional[float] = None
+    device_event_timing: bool = False
+    timing_error: Optional[str] = None
