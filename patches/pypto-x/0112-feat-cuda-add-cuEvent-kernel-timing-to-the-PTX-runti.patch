+class CudaEvent:
+    """A Driver API event used for stream-ordered device timing.
+
+    Events are owned by the :class:`CudaDriver` that created them and must be
+    released with :meth:`close` (or by using the object as a context manager).
+    ``close`` is idempotent, and an exception raised while the event is in use
+    inside a ``with`` block still destroys the underlying handle.
+    """
+
+    def __init__(self, driver: "CudaDriver", handle: Any, flags: int = 0) -> None:
+        self.driver = driver
+        self.handle = handle
+        self.flags = int(flags)
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def _ensure_open(self, operation: str) -> None:
+        if self._closed:
+            raise CudaDriverError(operation, 400, "CUDA_ERROR_INVALID_HANDLE", "event is closed")
+
+    def record(self, stream: Any = None) -> "CudaEvent":
+        """Record this event on ``stream`` (``None`` means the default stream)."""
+        self._ensure_open("cuEventRecord")
+        self.driver.event_record(self.handle, stream)
+        return self
+
+    def synchronize(self) -> "CudaEvent":
+        self._ensure_open("cuEventSynchronize")
+        self.driver.event_synchronize(self.handle)
+        return self
+
+    def elapsed_time_ms(self, end: Any) -> float:
+        """Return the elapsed milliseconds between this (start) and ``end``."""
+        self._ensure_open("cuEventElapsedTime")
+        if isinstance(end, CudaEvent):
+            end._ensure_open("cuEventElapsedTime")
+        return self.driver.event_elapsed_time_ms(self.handle, end)
+
+    def elapsed_time_seconds(self, end: Any) -> float:
+        return self.elapsed_time_ms(end) / 1000.0
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        try:
+            self.driver.event_destroy(self.handle)
+        finally:
+            self._closed = True
+
+    def __enter__(self) -> "CudaEvent":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+
