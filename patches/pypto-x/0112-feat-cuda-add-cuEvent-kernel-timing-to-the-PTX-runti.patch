index 000000000..f1ecc38f8
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_cuda_event_timing.py
@@ -0,0 +1,177 @@
+"""Driver-level CUDA event timing tests; no CUDA toolkit or GPU required.
+
+The tests fake the ``libcuda`` surface with plain Python callables, which is
+enough to exercise symbol binding, the ctypes argument marshalling and the
+event lifecycle.  Runtime-level wiring is covered next to the existing fake
+driver in ``test_cuda_driver_ptx.py``.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import types
+
+import pytest
+
+from pypto.backends.cuda.driver import (
+    CudaDriver,
+    CudaDriverError,
+    CudaDriverUnavailable,
+    CudaEvent,
+)
+
+
+_BASE_SYMBOLS = (
+    "cuInit",
+    "cuDeviceGet",
+    "cuDeviceGetName",
+    "cuDeviceComputeCapability",
+    "cuDeviceTotalMem_v2",
+    "cuCtxCreate_v2",
+    "cuCtxDestroy_v2",
+    "cuCtxSynchronize",
+    "cuStreamSynchronize",
+    "cuModuleLoadDataEx",
+    "cuModuleUnload",
+    "cuModuleGetFunction",
+    "cuMemAlloc_v2",
+    "cuMemFree_v2",
+    "cuMemcpyHtoD_v2",
+    "cuMemcpyDtoH_v2",
+    "cuLaunchKernel",
+    "cuGetErrorName",
+    "cuGetErrorString",
+)
+
+_EVENT_SYMBOLS = (
+    "cuEventCreate",
+    "cuEventRecord",
+    "cuEventSynchronize",
+    "cuEventElapsedTime",
+    "cuEventDestroy_v2",
+)
+
+
+class _FakeFunction:
+    """Callable with settable ``restype``/``argtypes`` like a CDLL symbol."""
+
+    def __init__(self, name, result=0, handler=None):
+        self.name = name
+        self.result = result
+        self.handler = handler
+        self.calls = []
+        self.restype = None
+        self.argtypes = None
+
+    def __call__(self, *args):
+        self.calls.append(args)
+        if self.handler is not None:
+            return self.handler(*args)
+        return self.result
+
+
+def _write_pointer(value, address):
+    ctypes.c_void_p.from_address(ctypes.cast(value, ctypes.c_void_p).value).value = address
+
+
+def _write_float(value, number):
+    ctypes.c_float.from_address(ctypes.cast(value, ctypes.c_void_p).value).value = number
+
+
+def _event_create(out, flags):
+    _write_pointer(out, 0xE1)
+    return 0
+
+
+def _fake_library(*, with_events=True, **overrides):
+    library = types.SimpleNamespace()
+    for name in _BASE_SYMBOLS + (_EVENT_SYMBOLS if with_events else ()):
+        setattr(library, name, _FakeFunction(name))
+    for name, function in overrides.items():
+        setattr(library, name, function)
+    return library
+
+
+def _pointer_value(value):
+    assert isinstance(value, ctypes.c_void_p)
+    return value.value
+
+
+def test_event_create_record_elapsed_and_destroy_are_bound():
+    library = _fake_library(
+        cuEventCreate=_FakeFunction("cuEventCreate", handler=_event_create),
+        cuEventElapsedTime=_FakeFunction(
+            "cuEventElapsedTime",
+            handler=lambda out, start, end: (_write_float(out, 2.5), 0)[1],
+        ),
+    )
+    driver = CudaDriver(library=library)
+    assert driver.events_available() is True
+    assert library.cuEventCreate.argtypes == [ctypes.POINTER(ctypes.c_void_p), ctypes.c_uint]
+
+    with driver.event_create() as start, driver.event_create() as stop:
+        start.record(stream=0x55)
+        stop.record()
+        start.synchronize()
+        assert start.elapsed_time_seconds(stop) == pytest.approx(0.0025)
+
+    record_args = library.cuEventRecord.calls[0]
+    assert _pointer_value(record_args[0]) == 0xE1
+    assert _pointer_value(record_args[1]) == 0x55
+    assert _pointer_value(library.cuEventRecord.calls[1][1]) is None
+    assert len(library.cuEventSynchronize.calls) == 1
+    assert _pointer_value(library.cuEventElapsedTime.calls[0][1]) == 0xE1
+
+    assert len(library.cuEventDestroy_v2.calls) == 2
+    start.close()
+    assert len(library.cuEventDestroy_v2.calls) == 2
+
+
+def test_event_destroys_handle_when_context_block_raises():
+    library = _fake_library(cuEventCreate=_FakeFunction("cuEventCreate", handler=_event_create))
+    driver = CudaDriver(library=library)
+    with pytest.raises(RuntimeError, match="boom"):
+        with driver.event_create() as event:
+            assert isinstance(event, CudaEvent)
+            raise RuntimeError("boom")
+    assert len(library.cuEventDestroy_v2.calls) == 1
+
+
+def test_closed_event_is_rejected_and_elapsed_requires_open_pair():
+    library = _fake_library(
+        cuEventCreate=_FakeFunction("cuEventCreate", handler=_event_create),
+        cuEventElapsedTime=_FakeFunction(
+            "cuEventElapsedTime",
+            handler=lambda out, start, end: (_write_float(out, 1.0), 0)[1],
+        ),
+    )
+    driver = CudaDriver(library=library)
+    start = driver.event_create()
+    stop = driver.event_create()
+    start.close()
+    with pytest.raises(CudaDriverError) as info:
+        start.record()
+    assert info.value.code == 400 and info.value.operation == "cuEventRecord"
+    with pytest.raises(CudaDriverError):
+        start.elapsed_time_ms(stop)
+    stop.close()
+    stop.close()
+    assert len(library.cuEventDestroy_v2.calls) == 2
+
+
+def test_event_creation_failure_raises_driver_error():
+    library = _fake_library(cuEventCreate=_FakeFunction("cuEventCreate", result=1))
+    driver = CudaDriver(library=library)
+    with pytest.raises(CudaDriverError) as info:
+        driver.event_create()
+    assert (info.value.operation, info.value.code) == ("cuEventCreate", 1)
+    assert info.value.name == "CUDA_ERROR_INVALID_VALUE"
+
+
+def test_driver_without_event_symbols_degrades_to_unavailable():
+    library = _fake_library(with_events=False)
+    driver = CudaDriver(library=library)
+    assert driver.events_available() is False
+    for method in (driver.event_create, lambda: driver.event_record(None)):
+        with pytest.raises(CudaDriverUnavailable, match="cuEvent"):
+            method()
diff --git a/scripts/smoke/cuda_event_timing_smoke.py b/scripts/smoke/cuda_event_timing_smoke.py
new file mode 100644
index 000000000..5b73953df
--- /dev/null
+++ b/scripts/smoke/cuda_event_timing_smoke.py
@@ -0,0 +1,504 @@
+#!/usr/bin/env python3
+"""CUDA cuEvent kernel-timing smoke for the PyPTO-X RTX 5080 (no model/toolkit).
+
+The probe compiles one PTX matmul artifact, times repeated launches with the
+runtime's cuEvent-based ``launch_timed`` path, records nvidia-smi fingerprints
+before/after the measurement, samples ``clocks.sm`` while the GPU is under
+load, and writes a protocol-shaped evidence JSON.
+
+Run on GamePC WSL2:
+    PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=python python3 \
+        scripts/smoke/cuda_event_timing_smoke.py --json-out /tmp/evidence.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import math
+import platform
+import statistics
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "python"))
+
+from pypto.abi import GpuLaunchRequest, TensorDesc  # noqa: E402
+from pypto.backends.cpu import HostTensor  # noqa: E402
+from pypto.backends.cuda import CudaRuntime  # noqa: E402
+from pypto.compiler.targets.cuda import CudaPtxCompiler  # noqa: E402
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef  # noqa: E402
+from pypto.target import TargetSpec  # noqa: E402
+
+
+GPU_QUERY = (
+    "name,driver_version,clocks.sm,clocks.max.sm,clocks.mem,clocks.max.memory,"
+    "power.draw,power.limit,temperature.gpu,utilization.gpu,memory.used,memory.total,"
+    "persistence_mode,compute_mode"
+)
+CLOCK_QUERY = "clocks.sm,clocks.max.sm"
+
+
+def _matmul_program(m, n, k, dtype):
+    left_type = CoreType.tensor(dtype, (m, k))
+    right_type = CoreType.tensor(dtype, (k, n))
+    output_type = CoreType.tensor(dtype, (m, n))
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("out", output_type)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "matmul",
+                (left, right),
+                (output,),
+                Region((Operation("matmul", (left, right), (output,)),)),
+            ),
+        )
+    )
+
+
+def _run(command, timeout=30):
+    completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
+    return completed.stdout.strip(), completed.stderr.strip(), completed.returncode
+
+
+def _gpu_fingerprint():
+    raw, _err, code = _run(["nvidia-smi", "--query-gpu=" + GPU_QUERY, "--format=csv,noheader"])
+    apps, _err, _code = _run(
+        ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader"]
+    )
+    perf, _err, _code = _run(["nvidia-smi", "-q", "-d", "PERFORMANCE"])
+    version, _err, _code = _run(["nvidia-smi", "-q"])
+    kmd = cuda_umd = None
+    for line in version.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("KMD Version"):
+            kmd = stripped.split(":", 1)[1].strip()
+        elif stripped.startswith("CUDA UMD Version"):
+            cuda_umd = stripped.split(":", 1)[1].strip()
+    return {
+        "query_command": "nvidia-smi --query-gpu={} --format=csv,noheader".format(GPU_QUERY),
+        "raw_csv": raw,
+        "query_returncode": code,
+        "compute_apps_command": "nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader",
+        "compute_apps_raw": apps,
+        "performance_head": "\n".join(perf.splitlines()[:25]),
+        "driver_kmd": kmd,
+        "cuda_umd": cuda_umd,
+    }
+
+
+def _clock_sample():
+    raw, _err, code = _run(["nvidia-smi", "--query-gpu=" + CLOCK_QUERY, "--format=csv,noheader,nounits"])
+    if code != 0:
+        return None
+    parts = [part.strip() for part in raw.split(",")]
+    try:
+        return {"clocks_sm_mhz": int(float(parts[0])), "clocks_max_sm_mhz": int(float(parts[1]))}
+    except (IndexError, ValueError):
+        return None
+
+
+class _ClockSampler(threading.Thread):
+    """Poll nvidia-smi clocks while the main thread keeps the GPU loaded."""
+
+    def __init__(self, interval=0.4):
+        super().__init__(daemon=True)
+        self.interval = float(interval)
+        self.samples = []
+        self._stop_event = threading.Event()
+
+    def run(self):
+        while not self._stop_event.is_set():
+            sample = _clock_sample()
+            if sample is not None:
+                self.samples.append(sample)
+            self._stop_event.wait(self.interval)
+
+    def stop(self):
+        self._stop_event.set()
+        self.join(timeout=10)
+
+
+def _percentile(values, fraction):
+    ordered = sorted(values)
+    if not ordered:
+        return None
+    if len(ordered) == 1:
+        return ordered[0]
+    rank = fraction * (len(ordered) - 1)
+    lower = int(math.floor(rank))
+    upper = int(math.ceil(rank))
+    if lower == upper:
+        return ordered[lower]
+    return ordered[lower] + (ordered[upper] - ordered[lower]) * (rank - lower)
+
+
+def _dispersion(values):
+    if not values:
+        return {"n": 0}
+    mean = statistics.fmean(values)
+    return {
+        "n": len(values),
+        "min": min(values),
+        "p50": _percentile(values, 0.50),
+        "p95": _percentile(values, 0.95),
+        "max": max(values),
+        "mean": mean,
+        "stdev": statistics.stdev(values) if len(values) > 1 else 0.0,
+        "cv": (statistics.stdev(values) / mean) if len(values) > 1 and mean else 0.0,
+    }
+
+
+def _round(value, digits=9):
+    return None if value is None else round(float(value), digits)
+
+
+def _correctness_check():
+    """Small canonical matmul so the timed workload is known to be correct."""
+
+    program = _matmul_program(4, 6, 5, "float32")
+    target = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (128,)})
+    compiler = CudaPtxCompiler()
+    target_ir = compiler.lower(program, target)
+    artifact = compiler.compile(target_ir)
+    left = HostTensor("float32", (4, 5), [2.0] * 20)
+    right = HostTensor("float32", (5, 6), [3.0] * 30)
+    output = HostTensor.zeros("float32", (4, 6))
+    request = GpuLaunchRequest(
+        artifact,
+        geometries=(target_ir.gpu_program.plans[0].geometry,),
+        inputs=(
+            TensorDesc("float32", (4, 5), device="gpu", handle=left, readonly=True),
+            TensorDesc("float32", (5, 6), device="gpu", handle=right, readonly=True),
+        ),
+        outputs=(TensorDesc("float32", (4, 6), device="gpu", handle=output),),
+    )
+    runtime = CudaRuntime()
+    results, timing = runtime.launch_timed(request)
+    observed = output.flat()
+    expected = (30.0,) * 24
+    if observed != expected:
+        raise SystemExit("correctness check failed: {}".format(observed))
+    runtime.close()
+    return {"status": "PASS", "expected": 30.0, "kernel_seconds": timing.kernel_seconds, "results": len(results)}
+
+
+def _batch_self_proof(runtime, target_ir, plan, pointers, repeats):
+    """Time ``repeats`` back-to-back launches with one event pair and a host clock.
+
+    Per-launch event timing pays a fixed host driver-call latency around every
+    launch.  Wrapping all repeats in a single event pair amortizes that
+    latency over ``repeats * kernel`` seconds, so the device event span and the
+    host wall clock must agree to well under 5% for the timer to be trusted.
+    """
+
+    driver = runtime.driver
+    module = driver.module_load_data(target_ir.ptx)
+    try:
+        function = module.get_function("px_op0")
+        parameters = [ctypes.c_uint64(int(pointer)) for pointer in pointers]
+        grid = plan.geometry.grid.dims
+        block = plan.geometry.workgroup.dims
+        shared = plan.geometry.dynamic_workgroup_memory_bytes
+        start_event = driver.event_create()
+        stop_event = driver.event_create()
+        try:
+            start_event.record(None)
+            wall_started = time.perf_counter()
+            for _ in range(repeats):
+                driver.launch_kernel(function, grid, block, parameters, None, shared)
+            stop_event.record(None)
+            driver.context_synchronize()
+            wall_seconds = time.perf_counter() - wall_started
+            driver.event_synchronize(stop_event)
+            event_seconds = start_event.elapsed_time_seconds(stop_event)
+        finally:
+            for event in (start_event, stop_event):
+                try:
+                    event.close()
+                except Exception:
+                    pass
+    finally:
+        module.close()
+    diff_pct = abs(event_seconds - wall_seconds) / event_seconds * 100.0 if event_seconds else None
+    return {
+        "repeats": repeats,
+        "event_seconds": event_seconds,
+        "wall_seconds": wall_seconds,
+        "diff_pct": diff_pct,
+        "verdict": "PASS" if diff_pct is not None and diff_pct <= 5.0 else "FAIL",
+    }
+
+
+def _parse_args(argv):
+    parser = argparse.ArgumentParser(description="CUDA cuEvent kernel timing smoke")
+    parser.add_argument("--m", type=int, default=1024)
+    parser.add_argument("--n", type=int, default=1024)
+    parser.add_argument("--k", type=int, default=1024)
+    parser.add_argument("--dtype", default="bf16", choices=("bf16", "float32"))
+    parser.add_argument("--workgroup", type=int, default=256)
+    parser.add_argument("--warmup", type=int, default=3)
+    parser.add_argument("--repeats", type=int, default=15)
+    parser.add_argument("--clock-warmup-seconds", type=float, default=2.0)
+    parser.add_argument("--clock-tail-seconds", type=float, default=1.6)
+    parser.add_argument("--clock-interval", type=float, default=0.4)
+    parser.add_argument("--max-clock-launches", type=int, default=200)
+    parser.add_argument("--min-clock-ratio", type=float, default=0.9)
+    parser.add_argument("--json-out", default="")
+    parser.add_argument("--git-head", default="unknown")
+    parser.add_argument("--git-branch", default="work/cuda-kernel-timing")
+    parser.add_argument("--agent", default="cuda-kernel-timing")
+    return parser.parse_args(argv)
+
+
+def main(argv=None):
+    args = _parse_args(argv)
+    if args.repeats < 10:
+        raise SystemExit("--repeats must be >= 10 for a dispersion report")
+    started_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+    correctness = _correctness_check()
+
+    program = _matmul_program(args.m, args.n, args.k, args.dtype)
+    target = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (args.workgroup,)})
+    compiler = CudaPtxCompiler()
+    target_ir = compiler.lower(program, target)
+    artifact = compiler.compile(target_ir)
+    plan = target_ir.gpu_program.plans[0]
+
+    fingerprint_before = _gpu_fingerprint()
+
+    runtime = CudaRuntime()
+    if not runtime.is_available():
+        raise SystemExit("CUDA device unavailable: {}".format(runtime.availability().to_dict()))
+    runtime._ensure_context()
+    itemsize = 2 if args.dtype == "bf16" else 4
+    left_ptr = runtime.driver.mem_alloc(args.m * args.k * itemsize)
+    right_ptr = runtime.driver.mem_alloc(args.k * args.n * itemsize)
+    output_ptr = runtime.driver.mem_alloc(args.m * args.n * itemsize)
+    request = GpuLaunchRequest(
+        artifact,
+        geometries=(plan.geometry,),
+        inputs=(
+            TensorDesc(args.dtype, (args.m, args.k), device="gpu", address=left_ptr, readonly=True),
+            TensorDesc(args.dtype, (args.k, args.n), device="gpu", address=right_ptr, readonly=True),
+        ),
+        outputs=(TensorDesc(args.dtype, (args.m, args.n), device="gpu", address=output_ptr),),
+    )
+    jit_started = time.perf_counter()
+    probe_module = runtime.driver.module_load_data(target_ir.ptx)
+    jit_probe_seconds = time.perf_counter() - jit_started
+    probe_module.close()
+    warm_load_seconds = []
+    for _ in range(3):
+        started = time.perf_counter()
+        warm_module = runtime.driver.module_load_data(target_ir.ptx)
+        warm_load_seconds.append(time.perf_counter() - started)
+        warm_module.close()
+    module_load_warm_seconds_p50 = _percentile(warm_load_seconds, 0.5)
+
+    try:
+        for _ in range(max(0, args.warmup)):
+            runtime.launch(request)
+        # Clock warmup: keep the GPU busy for the protocol's 2 s before any
+        # clock sample is taken, so the samples reflect a boosted device.
+        clock_deadline = time.perf_counter() + max(0.0, args.clock_warmup_seconds)
+        clock_launches = 0
+        while time.perf_counter() < clock_deadline and clock_launches < max(1, args.max_clock_launches):
+            runtime.launch(request)
+            clock_launches += 1
+        sampler = _ClockSampler(interval=args.clock_interval)
+        sampler.start()
+        samples = []
+        for _ in range(args.repeats):
+            _results, timing = runtime.launch_timed(request)
+            samples.append(timing)
+        batch_proof = _batch_self_proof(
+            runtime, target_ir, plan, (left_ptr, right_ptr, output_ptr), args.repeats
+        )
+        # Keep the device loaded while the sampler polls, without perturbing
+        # the measured repeats above.
+        tail_deadline = time.perf_counter() + max(0.0, args.clock_tail_seconds)
+        while time.perf_counter() < tail_deadline:
+            runtime.launch(request)
+        sampler.stop()
+    finally:
+        for pointer in (left_ptr, right_ptr, output_ptr):
+            try:
+                runtime.driver.mem_free(pointer)
+            except Exception:
+                pass
+        runtime.close()
+
+    fingerprint_after = _gpu_fingerprint()
+    kernel = [sample.kernel_seconds for sample in samples]
+    wall = [sample.wall_seconds for sample in samples]
+    dispatch = [sample.dispatch_seconds for sample in samples if sample.dispatch_seconds is not None]
+    region_wall = [sample.timed_region_wall_seconds for sample in samples if sample.timed_region_wall_seconds is not None]
+    if any(value is None for value in kernel):
+        raise SystemExit("event timing did not produce kernel_seconds for every repeat")
+
+    kernel_disp = _dispersion(kernel)
+    wall_disp = _dispersion(wall)
+    dispatch_disp = _dispersion(dispatch)
+    region_disp = _dispersion(region_wall)
+    kernel_p50 = kernel_disp["p50"]
+    wall_p50 = wall_disp["p50"]
+    region_p50 = region_disp.get("p50")
+    kernel_vs_region_pct = (
+        abs(kernel_p50 - region_p50) / kernel_p50 * 100.0 if region_p50 and kernel_p50 else None
+    )
+    kernel_vs_wall_pct = abs(kernel_p50 - wall_p50) / kernel_p50 * 100.0 if kernel_p50 else None
+
+    clock_values = [sample["clocks_sm_mhz"] for sample in sampler.samples]
+    clock_max = max(
+        [sample["clocks_max_sm_mhz"] for sample in sampler.samples] or [0]
+    )
+    clock_sm = _percentile(clock_values, 0.50) if clock_values else None
+    clock_ratio = (clock_sm / clock_max) if clock_sm and clock_max else None
+    clock_verdict = "VALID" if clock_ratio is not None and clock_ratio >= args.min_clock_ratio else "INVALID_CLOCK"
+
+    flops = 2.0 * args.m * args.n * args.k
+    timing_self_proof = "PASS" if kernel_vs_region_pct is not None and kernel_vs_region_pct <= 5.0 else "FAIL"
+    wall_gap = None
+    if kernel_p50 is not None and wall_p50 is not None:
+        wall_gap = {
+            "kernel_vs_wall_diff_pct": kernel_vs_wall_pct,
+            "same_span_timed_region_wall_seconds_p50": region_p50,
+            "same_span_diff_pct": kernel_vs_region_pct,
+            "explanation": (
+                "wall_seconds covers the full runtime.launch call: each repeat re-loads the PTX module "
+                "(driver JIT cache) and pays host dispatch, which kernel_seconds excludes. "
+                "dispatch_seconds (= wall - kernel) is therefore the host overhead, with a warm module "
+                "load of ~{:.3f} ms per call measured separately. The same-span comparison "
+                "(kernel vs timed_region_wall_seconds, anchored after the start event was armed) "
+                "cross-checks the event timer on the identical device interval.".format(
+                    (module_load_warm_seconds_p50 or 0.0) * 1000.0
+                )
+            ),
+        }
+
