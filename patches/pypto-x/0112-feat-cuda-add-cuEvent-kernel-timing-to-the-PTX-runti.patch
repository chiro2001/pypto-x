+                "clocks_sm_mhz_min_under_load": (min(clock_values) if clock_values else None),
+                "clocks_max_sm_mhz": clock_max,
+                "clock_ratio": clock_ratio,
+                "clock_verdict": clock_verdict,
+                "compute_processes_before_empty": not fingerprint_before.get("compute_apps_raw", "").strip(),
+                "compute_processes_after_empty": not fingerprint_after.get("compute_apps_raw", "").strip(),
+            },
+        },
+        "measurement": {
+            "level": "L0_op",
+            "execution_model": "op_by_op_dispatch",
+            "case": "matmul",
