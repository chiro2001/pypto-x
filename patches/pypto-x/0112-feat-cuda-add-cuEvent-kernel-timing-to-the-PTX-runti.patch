+        self.init()
+        handle = ctypes.c_void_p()
+        self._check("cuEventCreate", self._cuEventCreate(ctypes.byref(handle), ctypes.c_uint(int(flags))))
+        return CudaEvent(self, handle, flags)
+
+    def event_record(self, event: Any, stream: Any = None) -> None:
+        """Record ``event`` on ``stream`` (``None`` means the default stream)."""
+
+        self._require_event_api("cuEventRecord")
+        self._check(
+            "cuEventRecord",
+            self._cuEventRecord(_as_ptr(self._event_handle(event)), _as_ptr(stream)),
+        )
