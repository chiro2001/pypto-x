+#!/usr/bin/env bash
+# 在 A3 容器内执行：把 emitter 生成物装进 pto-isa ST testcase 目录，注册 TEST_CASE，
+# 用上游 pto_vec_st 目标模式（bisheng -xcce + --cce-fatobj-link + GTest host main + ACL）
+# 构建 ir_to_pto_bridge。只写 ~/pypto-x-a3/，make 限制 -j6。
+set -euo pipefail
+
+export HOME="${HOME:-/home/l00886679}"
+BUNDLE="${BUNDLE:-$HOME/pypto-x-a3/bundles/ir-to-pto-minimal-bridge}"
+PTO="$HOME/pypto-x-a3/src/pto-isa"
+ST="$PTO/tests/npu/a2a3/src/st"
+CASE="ir_to_pto_bridge"
+TCASE_DIR="$ST/testcase/$CASE"
+BUILD="$ST/build-bridge"
+GTEST="$HOME/pypto-x-a3/deps/gtest-install"
+SOC="${SOC_OVERRIDE:-Ascend910_9391}"
+
+echo "== environment =="
+echo "HOME=$HOME"
+echo "ASCEND_HOME_PATH=${ASCEND_HOME_PATH:-<unset>}"
+echo "BUNDLE=$BUNDLE"
+echo "PTO=$PTO"
+which bisheng cmake make python3
+bisheng --version 2>&1 | head -1
+python3 --version
+echo "== pto-isa pin =="
+git -c safe.directory="$PTO" -C "$PTO" rev-parse HEAD
+git -c safe.directory="$PTO" -C "$PTO" status --porcelain | head -10
+echo "== gtest prefix =="
+ls -l "$GTEST/lib/libgtest.a" "$GTEST/lib/libgtest_main.a"
+echo "ABI=1 symbol count in libgtest.a: $(nm -C "$GTEST/lib/libgtest.a" 2>/dev/null | grep -c 'abi:cxx11' || true)"
+
+echo "== install generated testcase =="
+mkdir -p "$TCASE_DIR"
+cp "$BUNDLE/generated/ir_to_pto_bridge_kernel.cpp" "$BUNDLE/generated/main.cpp" "$BUNDLE/generated/CMakeLists.txt" "$TCASE_DIR/"
+ls -l "$TCASE_DIR"
+
+echo "== register TEST_CASE (idempotent, 只加一行) =="
+python3 - "$ST/testcase/CMakeLists.txt" "$CASE" <<'PY'
+import sys
+
+path, case = sys.argv[1], sys.argv[2]
+text = open(path, "r", encoding="utf-8").read()
+if "\n%s\n" % case in text:
+    print("already registered:", case)
+else:
+    marker = "set(ALL_TESTCASES\n"
+    if marker not in text:
+        raise SystemExit("找不到 ALL_TESTCASES 标记，拒绝修改")
+    text = text.replace(marker, marker + case + "\n", 1)
+    open(path, "w", encoding="utf-8").write(text)
+    print("registered:", case)
+PY
+grep -n "^$CASE$" "$ST/testcase/CMakeLists.txt"
+git -c safe.directory="$PTO" -C "$PTO" diff --stat -- tests/npu/a2a3/src/st/testcase/CMakeLists.txt || true
+
+echo "== configure (RUN_MODE=npu, SOC=$SOC, TEST_CASE=$CASE) =="
+rm -rf "$BUILD"
+cmake -S "$ST" -B "$BUILD" \
+    -DRUN_MODE=npu -DSOC_VERSION="$SOC" -DTEST_CASE="$CASE" \
+    -DCMAKE_PREFIX_PATH="$GTEST" -DCMAKE_BUILD_TYPE=Release 2>&1 | tail -25
+
+echo "== cache check =="
+grep -E '^(RUN_MODE|SOC_VERSION|TEST_CASE|PTO_GLIBCXX_USE_CXX11_ABI|CMAKE_CXX_COMPILER|CMAKE_C_COMPILER):' "$BUILD/CMakeCache.txt" || true
+
+echo "== build (-j6) =="
+timeout 700 make -C "$BUILD" -j6 2>&1 | tail -40
+
+echo "== artifacts =="
+ls -l "$BUILD/bin/" "$BUILD/lib/"
+sha256sum "$BUILD/bin/$CASE" "$BUILD/lib/lib${CASE}_kernel.so"
+
+echo "== evidence: 上游 testcase/CMakeLists.txt 的 diff（只加一行） =="
+git -c safe.directory="$PTO" -C "$PTO" diff -- tests/npu/a2a3/src/st/testcase/CMakeLists.txt || true
+
+echo "== evidence: kernel flags.make（bisheng -xcce ...） =="
+cat "$BUILD/testcase/$CASE/CMakeFiles/${CASE}_kernel.dir/flags.make" 2>/dev/null || true
+echo "== evidence: kernel link.txt（--cce-fatobj-link） =="
+cat "$BUILD/testcase/$CASE/CMakeFiles/${CASE}_kernel.dir/link.txt" 2>/dev/null || true
+echo "== evidence: host link.txt（GTest + ACL runtime） =="
+cat "$BUILD/testcase/$CASE/CMakeFiles/${CASE}.dir/link.txt" 2>/dev/null || true
+
+# 保持 1004:1004 归属（容器内约定用户），避免 root 产物留给后续任务。
+chown -R 1004:1004 "$TCASE_DIR" "$BUILD" 2>/dev/null || true
+chown 1004:1004 "$ST/testcase/CMakeLists.txt" 2>/dev/null || true
+echo INSTALL_BUILD_DONE
