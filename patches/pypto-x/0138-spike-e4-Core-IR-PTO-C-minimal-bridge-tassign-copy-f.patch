+#!/usr/bin/env bash
+# chip7 设备证据 A/B + 正对照（沿用 a3-pto-isa-bringup 的 16_device_evidence_ab.sh 方法）：
+#   phase 0  无负载基线（chip7 HBM 行）
+#   phase A  ir_to_pto_bridge 正常运行（无额外 sentinel）+ 高频采样
+#   phase B  ir_to_pto_bridge + 512 MiB sentinel + 12 s hold，proc-mem 应显示本进程
+#   phase C  正对照：root python3 torch_npu 512 MiB（证明 npu-smi 采样链路有效）
+# 只使用 chip7（ASCEND_RT_VISIBLE_DEVICES=7）。
+set -u
+
+export HOME="${HOME:-/home/l00886679}"
+export ASCEND_RT_VISIBLE_DEVICES=7
+LOG="$HOME/pypto-x-a3/logs/ir-to-pto-minimal-bridge"
+WORK="$LOG/device_evidence_ab"
+BUNDLE="${BUNDLE:-$HOME/pypto-x-a3/bundles/ir-to-pto-minimal-bridge}"
+rm -rf "$WORK"
+mkdir -p "$WORK"
+
+chip7_row() { timeout 30 npu-smi info 2>&1 | grep -E '0000:93:00.0' || true; }
+chip7_hbm() { timeout 30 npu-smi info 2>&1 | grep -A2 -E '^\| 3 +[0-9]+ +[0-9]+' | head -3 || true; }
+
+echo "=== phase 0: no-load baseline (3 samples, 6 s) ===" | tee "$WORK/ab.log"
+for i in 1 2 3; do
+    echo "t=$(date -u +%FT%T.%3NZ)" | tee -a "$WORK/ab.log"
+    chip7_row | tee -a "$WORK/ab.log"
+    sleep 2
+done
+
+echo "=== phase A: ir_to_pto_bridge (no sentinel) + sampler ===" | tee -a "$WORK/ab.log"
+(
+    for i in $(seq 1 200); do
+        echo "--- $(date -u +%FT%T.%3NZ) ---"
+        timeout 10 npu-smi info -t proc-mem -i 3 -c 1 2>&1
+        chip7_row
+        sleep 0.05
+    done
+) > "$WORK/sampler_A.log" 2>&1 &
+SAMP_A=$!
+PHA="$WORK/phaseA"; mkdir -p "$PHA"
+WORK="$PHA" EVIDENCE_MIB=0 EVIDENCE_HOLD=0 bash "$BUNDLE/scripts/run_chip7.sh" > "$PHA/runner.log" 2>&1
+RC_A=$?
+echo "PHASE_A_EXIT=$RC_A" | tee -a "$WORK/ab.log"
+kill "$SAMP_A" 2>/dev/null; wait "$SAMP_A" 2>/dev/null
+echo "-- phase A sampler hits (Process id/No process) --" | tee -a "$WORK/ab.log"
+grep -n -E 'Process id|No process|ir_to_pto_bridge' "$WORK/sampler_A.log" | head -12 | tee -a "$WORK/ab.log" || true
+sed -n '1,8p' "$PHA/runner.log" >> "$WORK/ab.log"
+
+echo "=== phase B: ir_to_pto_bridge + 512 MiB sentinel + 12 s hold ===" | tee -a "$WORK/ab.log"
+PHB="$WORK/phaseB"; mkdir -p "$PHB"
+WORK="$PHB" EVIDENCE_MIB=512 EVIDENCE_HOLD=12 bash "$BUNDLE/scripts/run_chip7.sh" > "$PHB/runner.log" 2>&1
+RC_B=$?
+echo "PHASE_B_EXIT=$RC_B" | tee -a "$WORK/ab.log"
+grep -n -E 'Process id|ir_to_pto_bridge|No process' "$PHB/during_hold.log" 2>/dev/null | head -12 | tee -a "$WORK/ab.log" || true
+grep -n -E 'IR_BRIDGE_EXIT|PASSED|FAILED' "$PHB/post.log" 2>/dev/null | tee -a "$WORK/ab.log" || true
+
+TORCH_PYTHON="${TORCH_PYTHON:-/usr/local/python3.12.13/bin/python3}"
+echo "=== phase C: positive control torch_npu 512 MiB ($TORCH_PYTHON) ===" | tee -a "$WORK/ab.log"
+cat > "$WORK/alloc512.py" <<'PY'
+import time
+import torch
+import torch_npu
+
+x = torch.zeros(128 * 1024 * 1024, dtype=torch.float32, device="npu")
+torch.npu.synchronize()
+print("ALLOC_MiB", x.numel() * x.element_size() // 1024 // 1024, flush=True)
+print("DEVICE_NAME", torch.npu.get_device_name(0), flush=True)
+time.sleep(15)
+print("DONE", flush=True)
+PY
+(
+    for i in $(seq 1 200); do
+        echo "--- $(date -u +%FT%T.%3NZ) ---"
+        timeout 10 npu-smi info -t proc-mem -i 3 -c 1 2>&1
+        chip7_row
+        sleep 0.05
+    done
+) > "$WORK/sampler_C.log" 2>&1 &
+SAMP_C=$!
+"$TORCH_PYTHON" "$WORK/alloc512.py" > "$WORK/alloc512_PY.log" 2>&1 &
+PY_PID=$!
+sleep 8
+{
+    echo "-- during C: proc-mem --"
+    timeout 10 npu-smi info -t proc-mem -i 3 -c 1 2>&1
+    echo "-- during C: full process section --"
+    timeout 40 npu-smi info 2>&1 | sed -n '/Process id/,$p' | head -30
+    echo "-- during C: chip7 row --"
+    chip7_row
+} | tee -a "$WORK/ab.log"
+wait "$PY_PID"; RC_C=$?
+echo "PHASE_C_PY_EXIT=$RC_C" | tee -a "$WORK/ab.log"
+kill "$SAMP_C" 2>/dev/null; wait "$SAMP_C" 2>/dev/null
+cat "$WORK/alloc512_PY.log" | tee -a "$WORK/ab.log"
+echo "-- phase C sampler hits --" | tee -a "$WORK/ab.log"
+grep -n -E 'Process id|python3' "$WORK/sampler_C.log" | head -8 | tee -a "$WORK/ab.log" || true
+
+echo "=== after all: chip7 ===" | tee -a "$WORK/ab.log"
+chip7_row | tee -a "$WORK/ab.log"
+timeout 10 npu-smi info -t proc-mem -i 3 -c 1 2>&1 | tee -a "$WORK/ab.log"
+echo "AB_DONE"
+exit $(( RC_A != 0 || RC_B != 0 || RC_C != 0 ))
