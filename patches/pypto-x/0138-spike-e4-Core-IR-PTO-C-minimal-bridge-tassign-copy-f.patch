@@ -0,0 +1,102 @@
+"""组装发往 A3 的最小 bundle（生成源码 + A3 脚本 + 清单），并可选打 tar.gz。
+
+用法：
+    python3 spike/ir_to_pto_minimal_bridge/build_bundle.py            # 写到 spike/.../dist/
+    python3 spike/ir_to_pto_minimal_bridge/build_bundle.py --tar      # 额外打 tar.gz
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import shutil
+import tarfile
+import time
+from pathlib import Path
+from typing import Dict
+
+from . import emitter, programs
+
+HERE = Path(__file__).resolve().parent
+REPO_EXCLUDED = {".DS_Store"}
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def build_bundle(dist_dir: Path, make_tar: bool) -> Dict[str, object]:
+    generated_dir = HERE / "generated"
+    emitted = emitter.emit(programs.build_program(), generated_dir)
+
+    bundle_root = dist_dir / "ir-to-pto-minimal-bridge"
+    if bundle_root.exists():
+        shutil.rmtree(bundle_root)
+    (bundle_root / "generated").mkdir(parents=True)
+    (bundle_root / "scripts").mkdir(parents=True)
+
+    files = []
+    for name in sorted(emitted):
+        source = emitted[name]
+        relative = Path("generated") / name
+        target = bundle_root / relative
+        shutil.copy2(source, target)
+        files.append(relative)
+    for script in sorted((HERE / "a3_scripts").glob("*.sh")):
+        relative = Path("scripts") / script.name
+        shutil.copy2(script, bundle_root / relative)
+        files.append(relative)
+
+    compare_relative = Path("compare_bins.py")
+    shutil.copy2(HERE / "compare_bins.py", bundle_root / compare_relative)
+    files.append(compare_relative)
+
+    manifest = {
+        "bundle": "ir-to-pto-minimal-bridge",
+        "built_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "ir_sha256": _sha256(emitted[emitter.IR_JSON_FILENAME]),
+        "files": {
+            str(relative): {
+                "sha256": _sha256(bundle_root / relative),
+                "bytes": (bundle_root / relative).stat().st_size,
+            }
+            for relative in files
+        },
+    }
+    (bundle_root / "bundle_manifest.json").write_text(
+        json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+
+    tar_path = None
+    if make_tar:
+        tar_path = dist_dir / "ir-to-pto-minimal-bridge-bundle.tar.gz"
+        with tarfile.open(tar_path, "w:gz") as archive:
+            archive.add(bundle_root, arcname=bundle_root.name)
+    return {"bundle_root": bundle_root, "tar": tar_path, "manifest": manifest}
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description="assemble A3 bundle for the IR->PTO bridge spike")
+    parser.add_argument("--dist", default=str(HERE / "dist"), help="输出目录")
+    parser.add_argument("--tar", action="store_true", help="额外生成 tar.gz")
+    args = parser.parse_args(argv)
+
+    dist_dir = Path(args.dist)
+    dist_dir.mkdir(parents=True, exist_ok=True)
+    result = build_bundle(dist_dir, args.tar)
+    print("BUNDLE_ROOT=%s" % result["bundle_root"])
+    if result["tar"] is not None:
+        print("BUNDLE_TAR=%s" % result["tar"])
+    print("IR_SHA256=%s" % result["manifest"]["ir_sha256"])
+    for name, info in sorted(result["manifest"]["files"].items()):
+        print("%s  %s  %d" % (info["sha256"], name, info["bytes"]))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/spike/ir_to_pto_minimal_bridge/compare_bins.py b/spike/ir_to_pto_minimal_bridge/compare_bins.py
new file mode 100644
index 000000000..026e8e69d
--- /dev/null
+++ b/spike/ir_to_pto_minimal_bridge/compare_bins.py
@@ -0,0 +1,157 @@
+"""用 numpy 复算 CPU 参考，与 A3/chip7 kernel dump 的 f32 bin 逐元素对账。
+
+判据（与 ``emitter.py`` 生成的 C++ 断言一致）：
+
+* ``copy`` / ``fill``：**逐位相等**（float32 bit pattern，mismatch 必须为 0）；
+* ``add``：目标也是逐位相等；若出现不一致，允许 ``max_abs <= 1e-5 且
+  max_rel <= 1e-6`` 作为容差兜底，并如实输出 mismatch 数。
+
+另外会先把 dump 的输入 bin 与公式复算结果对账，防止读到陈旧/错配文件。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Any, Dict, List
+
+import numpy as np
+
+MULTIPLIER = 2654435761
+MODULUS = 1009
+OFFSET = 504
+SCALE = np.float32(0.125)
+ADD_MAX_ABS = 1e-5
+ADD_MAX_REL = 1e-6
+
+
+def reference_input(elems: int, seed: int) -> np.ndarray:
+    index = np.arange(elems, dtype=np.int64)
+    raw = ((index * MULTIPLIER + seed * 97) % MODULUS) - OFFSET
+    return raw.astype(np.float32) * SCALE
+
+
+def _bits_equal(a: np.ndarray, b: np.ndarray) -> np.ndarray:
+    return a.view(np.uint32) == b.view(np.uint32)
+
+
+def _read_f32(path: Path) -> np.ndarray:
+    data = np.fromfile(path, dtype="<f4")
+    if data.size == 0:
+        raise ValueError("空文件或不存在：%s" % path)
+    return data
+
+
+def compare_case(case: Dict[str, Any], bins_dir: Path) -> Dict[str, Any]:
+    elems = int(case["elems"])
+    output = _read_f32(bins_dir / case["output"])
+    result: Dict[str, Any] = {
+        "function": case["function"],
+        "kind": case["kind"],
+        "shape": case["shape"],
+        "elems": elems,
+        "output_file": case["output"],
+        "input_consistency": {},
+        "check": {},
+    }
+    if output.size != elems:
+        result["verdict"] = "FAIL"
+        result["check"]["error"] = "output elems %d != expected %d" % (output.size, elems)
+        return result
+
+    inputs = []
+    for index, name in enumerate(case["inputs"]):
+        arr = _read_f32(bins_dir / name)
+        expected = reference_input(elems, int(case["input_seeds"][index]))
+        if arr.size != elems:
+            result["verdict"] = "FAIL"
+            result["check"]["error"] = "%s elems %d != expected %d" % (name, arr.size, elems)
+            return result
+        mismatch = int(np.count_nonzero(~_bits_equal(arr, expected)))
+        result["input_consistency"][name] = {"mismatch": mismatch, "expected_seed": int(case["input_seeds"][index])}
+        inputs.append(arr)
+
+    if case["kind"] == "copy":
+        mismatch = int(np.count_nonzero(~_bits_equal(output, inputs[0])))
+        max_abs = float(np.max(np.abs(output.astype(np.float64) - inputs[0].astype(np.float64)), initial=0.0))
+        result["check"] = {
+            "metric": "bitwise vs in0",
+            "mismatch": mismatch,
+            "max_abs_err": max_abs,
+            "exact": mismatch == 0,
+        }
+        result["verdict"] = "PASS" if mismatch == 0 else "FAIL"
+    elif case["kind"] == "add":
+        expected = (inputs[0] + inputs[1]).astype(np.float32)
+        mismatch_mask = ~_bits_equal(output, expected)
+        mismatch = int(np.count_nonzero(mismatch_mask))
+        abs_err = np.abs(output.astype(np.float64) - expected.astype(np.float64))
+        max_abs = float(np.max(abs_err, initial=0.0))
+        denom = np.maximum(np.abs(expected.astype(np.float64)), 1e-30)
+        max_rel = float(np.max(abs_err / denom, initial=0.0))
+        tolerance_ok = bool(max_abs <= ADD_MAX_ABS and max_rel <= ADD_MAX_REL)
+        result["check"] = {
+            "metric": "float32 add vs numpy",
+            "mismatch": mismatch,
+            "max_abs_err": max_abs,
+            "max_rel_err": max_rel,
+            "exact": mismatch == 0,
+            "tolerance": {"max_abs": ADD_MAX_ABS, "max_rel": ADD_MAX_REL, "ok": tolerance_ok},
+        }
+        result["verdict"] = "PASS" if (mismatch == 0 or tolerance_ok) else "FAIL"
+    elif case["kind"] == "fill":
+        expected = np.full(elems, np.float32(case["fill_value_f32"]), dtype=np.float32)
+        mismatch = int(np.count_nonzero(~_bits_equal(output, expected)))
+        max_abs = float(np.max(np.abs(output.astype(np.float64) - expected.astype(np.float64)), initial=0.0))
+        result["check"] = {
+            "metric": "bitwise vs fill_value",
+            "mismatch": mismatch,
+            "max_abs_err": max_abs,
+            "exact": mismatch == 0,
+        }
+        result["verdict"] = "PASS" if mismatch == 0 else "FAIL"
+    else:  # pragma: no cover
+        result["verdict"] = "FAIL"
+        result["check"]["error"] = "unknown kind %r" % case["kind"]
+    return result
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description="numpy reconciliation for IR->PTO bridge bins")
+    parser.add_argument("--cases", required=True, help="ir_bridge_cases.json")
+    parser.add_argument("--bins", required=True, help="dump 目录")
+    parser.add_argument("--out", required=True, help="compare_result.json 输出路径")
+    parser.add_argument("--dump-raw", action="store_true", help="把逐元素差异前若干项也写到输出里")
+    args = parser.parse_args(argv)
+
+    case_doc = json.loads(Path(args.cases).read_text(encoding="utf-8"))
+    bins_dir = Path(args.bins)
+    results: List[Dict[str, Any]] = [compare_case(case, bins_dir) for case in case_doc["cases"]]
+    overall = "PASS" if all(item["verdict"] == "PASS" for item in results) else "FAIL"
+    doc = {
+        "overall": overall,
+        "reference": "numpy float32 CPU",
+        "input_formula": case_doc["input_formula"],
+        "cases": results,
+    }
+    Path(args.out).write_text(json.dumps(doc, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    for item in results:
+        check = item["check"]
+        print(
+            "%-32s %-5s kind=%-5s mismatch=%-6s max_abs=%s"
+            % (
+                item["function"],
+                item["verdict"],
+                item["kind"],
+                check.get("mismatch", "n/a"),
+                check.get("max_abs_err", "n/a"),
+            )
+        )
+    print("OVERALL=%s" % overall)
+    return 0 if overall == "PASS" else 1
+
+
+if __name__ == "__main__":  # pragma: no cover
+    sys.exit(main())
diff --git a/spike/ir_to_pto_minimal_bridge/core_ir_loader.py b/spike/ir_to_pto_minimal_bridge/core_ir_loader.py
new file mode 100644
index 000000000..739405956
--- /dev/null
+++ b/spike/ir_to_pto_minimal_bridge/core_ir_loader.py
@@ -0,0 +1,59 @@
+"""以隔离方式加载 ``python/pypto/core_ir``。
+
+``pypto/__init__.py`` 带有历史 online-build 逻辑，直接 ``import pypto`` 需要
+已安装的 wheel 元数据；E4 spike 只关心纯标准库的 Core IR 数据模型，因此这里
+沿用 ``python/tests/ut/pypto_x/test_core_ir.py`` 的隔离加载方式：用一个只有
+``__path__`` 的 stub ``pypto`` 包承载 ``pypto.core_ir``，不执行真实
+``pypto/__init__.py``。
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+import types
+from pathlib import Path
+
+
+def repository_root() -> Path:
+    """spike/ir_to_pto_minimal_bridge/core_ir_loader.py -> <repo root>。"""
+
+    return Path(__file__).resolve().parents[2]
+
+
+def core_ir_source_dir() -> Path:
+    return repository_root() / "python" / "pypto" / "core_ir"
+
+
+def load_core_ir():
+    """返回已加载的 ``pypto.core_ir`` 模块（同一进程内幂等）。"""
+
+    loaded = sys.modules.get("pypto.core_ir")
+    if loaded is not None:
+        return loaded
+
+    package_root = repository_root() / "python" / "pypto"
+    core_ir_dir = package_root / "core_ir"
+    init_file = core_ir_dir / "__init__.py"
+    if not init_file.is_file():
+        raise RuntimeError("找不到 Core IR 源码：%s" % init_file)
+
+    parent = sys.modules.get("pypto")
+    if parent is None:
+        parent = types.ModuleType("pypto")
+        parent.__path__ = [str(package_root)]
+        sys.modules["pypto"] = parent
+    elif not hasattr(parent, "__path__"):
+        raise RuntimeError("已导入的 pypto 模块不是包，无法承载 pypto.core_ir")
+
+    spec = importlib.util.spec_from_file_location(
+        "pypto.core_ir",
+        init_file,
+        submodule_search_locations=[str(core_ir_dir)],
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError("无法为 Core IR 构造 import spec")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["pypto.core_ir"] = module
+    spec.loader.exec_module(module)
+    return module
diff --git a/spike/ir_to_pto_minimal_bridge/emitter.py b/spike/ir_to_pto_minimal_bridge/emitter.py
new file mode 100644
index 000000000..be3bb73b8
--- /dev/null
+++ b/spike/ir_to_pto_minimal_bridge/emitter.py
@@ -0,0 +1,723 @@
+"""Core IR -> PTO C++ 最小 emitter（E4 step1，故意只支持 3 种情况）。
+
+输入是 ``programs.build_program()`` 产出的 ``CoreProgram``；输出是：
+
+* ``ir_to_pto_bridge_kernel.cpp``：``pto_vec_st`` 目标模式需要的 kernel 源；
+* ``main.cpp``：gtest + ACL host main（生成确定性输入、跑 kernel、做 C++ 侧
+  断言、并把输入/输出 dump 成 f32 bin 供 numpy 对账）；
+* ``CMakeLists.txt``：一行 ``pto_vec_st(ir_to_pto_bridge)``，放进 pto-isa ST 的
+  ``testcase/`` 目录即可复用上游 target 模式；
+* ``ir_bridge_cases.json``：给 ``compare_bins.py`` 的纯数据描述；
+* ``emit_report.json``：IR op 与生成源码行锚点的对照清单。
+
+emitter 对未知 op/dtype/shape 全部 fail-closed（``UnsupportedBridgeOp``）。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import struct
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from . import programs
+
+KERNEL_FILENAME = "ir_to_pto_bridge_kernel.cpp"
+HOST_FILENAME = "main.cpp"
+CASES_FILENAME = "ir_bridge_cases.json"
+CMAKE_FILENAME = "CMakeLists.txt"
+IR_JSON_FILENAME = "ir_bridge_program.json"
+REPORT_FILENAME = "emit_report.json"
+
+SUPPORTED_DTYPES = {"f32": "float"}
+
+
+class UnsupportedBridgeOp(Exception):
+    """Core IR 超出本 spike 的最小桥能力（fail-closed）。"""
+
+
+@dataclass(frozen=True)
+class LoweredOp:
+    function_name: str
+    cpp_name: str
+    kind: str  # copy | add | fill
+    dtype: str
+    rows: int
+    cols: int
+    input_names: Tuple[str, ...]
+    output_name: str
+    op_name: str
+    semantics: str
+    fill_value_f32: Optional[float]
+
+    @property
+    def elems(self) -> int:
+        return self.rows * self.cols
+
+    @property
+    def tile_bytes(self) -> int:
+        raw = self.elems * 4
+        return (raw + 31) // 32 * 32
+
+    @property
+    def cpp_type(self) -> str:
+        return SUPPORTED_DTYPES[self.dtype]
+
+    @property
+    def test_name(self) -> str:
+        return "IRBridgeTest.%s" % self.function_name
+
+
+def _cpp_identifier(name: str) -> str:
+    ident = re.sub(r"[^0-9A-Za-z_]", "_", name)
+    if not ident or ident[0].isdigit():
+        ident = "op_" + ident
+    return ident
+
+
+def _quantize_f32(value: float) -> float:
+    return struct.unpack("<f", struct.pack("<f", float(value)))[0]
+
+
+def _f32_literal(value: float) -> str:
+    quantized = _quantize_f32(value)
+    return "%s.0f" % format(quantized, ".9g") if quantized == int(quantized) else "%sf" % format(quantized, ".9g")
+
+
+def _shape_of(dtype_obj, context: str) -> Tuple[int, int]:
+    if dtype_obj.kind != "tensor":
+        raise UnsupportedBridgeOp("%s: 只支持 tensor 值，收到 kind=%r" % (context, dtype_obj.kind))
+    if dtype_obj.dtype not in SUPPORTED_DTYPES:
+        raise UnsupportedBridgeOp("%s: 不支持的 dtype=%r（当前仅 %s）" % (context, dtype_obj.dtype, sorted(SUPPORTED_DTYPES)))
+    shape = tuple(dtype_obj.shape)
+    if len(shape) != 2:
+        raise UnsupportedBridgeOp("%s: 只支持 rank-2 静态 shape，收到 %r" % (context, shape))
+    for dim in shape:
+        if not isinstance(dim, int) or isinstance(dim, bool) or dim <= 0:
+            raise UnsupportedBridgeOp("%s: 只支持静态正整数维度，收到 %r" % (context, shape))
+    return int(shape[0]), int(shape[1])
+
+
+def lower(program) -> List[LoweredOp]:
+    """把 CoreProgram 校验、归一化成可生成的 LoweredOp 列表。"""
+
+    program.verify()
+    lowered: List[LoweredOp] = []
+    for function in program.functions:
+        body = function.body
+        if body.blocks:
+            raise UnsupportedBridgeOp("function %s: 不支持 block region" % function.name)
+        if len(body.operations) != 1:
+            raise UnsupportedBridgeOp(
+                "function %s: 最小桥只支持单 op 函数，收到 %d 个 op" % (function.name, len(body.operations))
+            )
+        op = body.operations[0]
+        if len(op.regions) != 0:
+            raise UnsupportedBridgeOp("function %s: 不支持嵌套 region" % function.name)
+        if op.effect.value not in ("pure", "write"):
+            raise UnsupportedBridgeOp("function %s: 只支持 pure/write effect，收到 %s" % (function.name, op.effect.value))
+        if len(op.outputs) != 1:
+            raise UnsupportedBridgeOp("function %s: 只支持单输出 op" % function.name)
+        output = op.outputs[0]
+        rows, cols = _shape_of(output.type, "function %s output" % function.name)
+        if len(function.returns) != 1 or function.returns[0].name != output.name:
+            raise UnsupportedBridgeOp("function %s: returns 必须恰好是 op 的输出 %s" % (function.name, output.name))
+
+        semantics = op.attributes.get("semantics", "")
+        if op.name == "tassign":
+            if semantics == "copy":
+                if len(op.inputs) != 1:
+                    raise UnsupportedBridgeOp("function %s: tassign.copy 需要 1 个输入" % function.name)
+                kind = "copy"
+                for ref in op.inputs:
+                    in_rows, in_cols = _shape_of(ref.type, "function %s input" % function.name)
+                    if (in_rows, in_cols) != (rows, cols) or ref.type.dtype != output.type.dtype:
+                        raise UnsupportedBridgeOp("function %s: copy 的输入/输出类型必须一致" % function.name)
+                fill_value = None
+            elif semantics == "fill":
+                if len(op.inputs) != 0:
+                    raise UnsupportedBridgeOp("function %s: tassign.fill 不接受输入" % function.name)
+                if "fill_value" not in op.attributes:
+                    raise UnsupportedBridgeOp("function %s: tassign.fill 缺少 fill_value 属性" % function.name)
+                raw = op.attributes["fill_value"]
+                if isinstance(raw, bool) or not isinstance(raw, (int, float)):
+                    raise UnsupportedBridgeOp("function %s: fill_value 必须是数字" % function.name)
+                kind = "fill"
+                fill_value = _quantize_f32(float(raw))
+            else:
+                raise UnsupportedBridgeOp(
+                    "function %s: tassign 只支持 semantics=copy|fill，收到 %r" % (function.name, semantics)
+                )
+        elif op.name == "tadd":
+            if semantics not in ("", "elementwise_add"):
+                raise UnsupportedBridgeOp("function %s: tadd 的 semantics=%r 未支持" % (function.name, semantics))
+            if len(op.inputs) != 2:
+                raise UnsupportedBridgeOp("function %s: tadd 需要 2 个输入" % function.name)
+            for ref in op.inputs:
+                in_rows, in_cols = _shape_of(ref.type, "function %s input" % function.name)
+                if (in_rows, in_cols) != (rows, cols) or ref.type.dtype != output.type.dtype:
+                    raise UnsupportedBridgeOp("function %s: tadd 的输入/输出类型必须一致" % function.name)
+            kind = "add"
+            fill_value = None
+        else:
+            raise UnsupportedBridgeOp("function %s: 不支持的 op %r（最小桥只有 tassign/tadd）" % (function.name, op.name))
+
+        lowered.append(
+            LoweredOp(
+                function_name=function.name,
+                cpp_name=_cpp_identifier(function.name),
+                kind=kind,
+                dtype=output.type.dtype,
+                rows=rows,
+                cols=cols,
+                input_names=tuple(ref.name for ref in op.inputs),
+                output_name=output.name,
+                op_name=op.name,
+                semantics=semantics or kind,
+                fill_value_f32=fill_value,
+            )
+        )
+    if not lowered:
+        raise UnsupportedBridgeOp("CoreProgram 不含任何函数")
+    return lowered
+
+
+_KERNEL_HEADER = """/* PTO C++ kernel generated by spike/ir_to_pto_minimal_bridge/emitter.py
+ *
+ * 输入 Core IR（canonical JSON 见 @@IR_JSON@@）：
+@@IR_SUMMARY@@
+ *
+ * 说明：这是 E4 step1 的“最小桥”生成物，只覆盖静态 rank-2 f32 的
+ * tassign.copy / tassign.fill / tadd。UB tile 偏移按 32B 对齐顺序分配。
+ */
+#include <pto/pto-inst.hpp>
+#include <pto/common/constants.hpp>
+#include "acl/acl.h"
+
+using namespace pto;
+"""
+
+_COPY_FUNC = """
+// [@@INDEX@@] Core IR `%@@OUT@@ = tassign(%@@IN0@@) {semantics=copy}` : tensor<f32>[@@ROWS@@,@@COLS@@]
+//     lower -> 1 个 UB tile：TLOAD(GM->UB) + TSTORE(UB->GM)，事件链 TLOAD->TSTORE_VEC。
+template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>
+__global__ AICORE void run_@@CPP@@(__gm__ T __out__* out, __gm__ T __in__* in0)
+{
+    using DynShapeDim5 = Shape<1, 1, 1, vRows, vCols>;
+    using DynStridDim5 = Stride<1, 1, 1, kTCols_, 1>;
+    using GlobalData = GlobalTensor<T, DynShapeDim5, DynStridDim5>;
+    using TileData = Tile<TileType::Vec, T, kTRows_, kTCols_, BLayout::RowMajor, -1, -1>;
+    TileData copyTile(vRows, vCols);
+    TASSIGN(copyTile, @@OFF0@@);
+    GlobalData srcGlobal(in0);
+    GlobalData dstGlobal(out);
+    Event<Op::TLOAD, Op::TSTORE_VEC> event0;
+    event0 = TLOAD(copyTile, srcGlobal);
+    TSTORE(dstGlobal, copyTile, event0);
+}
+"""
+
+_ADD_FUNC = """
+// [@@INDEX@@] Core IR `%@@OUT@@ = tadd(%@@IN0@@, %@@IN1@@) {semantics=elementwise_add}` : tensor<f32>[@@ROWS@@,@@COLS@@]
+//     lower -> TLOAD x2 + TADD + TSTORE，事件链 TLOAD->TADD->TSTORE_VEC。
+template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>
+__global__ AICORE void run_@@CPP@@(__gm__ T __out__* out, __gm__ T __in__* in0, __gm__ T __in__* in1)
+{
+    using DynShapeDim5 = Shape<1, 1, 1, vRows, vCols>;
+    using DynStridDim5 = Stride<1, 1, 1, kTCols_, 1>;
+    using GlobalData = GlobalTensor<T, DynShapeDim5, DynStridDim5>;
+    using TileData = Tile<TileType::Vec, T, kTRows_, kTCols_, BLayout::RowMajor, -1, -1>;
+    TileData lhsTile(vRows, vCols);
+    TileData rhsTile(vRows, vCols);
+    TileData dstTile(vRows, vCols);
+    TASSIGN(lhsTile, @@OFF0@@);
+    TASSIGN(rhsTile, @@OFF1@@);
+    TASSIGN(dstTile, @@OFF2@@);
+    GlobalData lhsGlobal(in0);
+    GlobalData rhsGlobal(in1);
+    GlobalData dstGlobal(out);
+    Event<Op::TLOAD, Op::TADD> event0;
+    Event<Op::TADD, Op::TSTORE_VEC> event1;
+    TLOAD(lhsTile, lhsGlobal);
+    event0 = TLOAD(rhsTile, rhsGlobal);
+    event1 = TADD(dstTile, lhsTile, rhsTile, event0);
+    TSTORE(dstGlobal, dstTile, event1);
+}
+"""
+
+_FILL_FUNC = """
+// [@@INDEX@@] Core IR `%@@OUT@@ = tassign() {semantics=fill, fill_value=@@FILL@@}` : tensor<f32>[@@ROWS@@,@@COLS@@]
+//     lower -> TEXPANDS(标量->UB tile) + PIPE_V/PIPE_MTE3 同步 + TSTORE。
+template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>
+__global__ AICORE void run_@@CPP@@(__gm__ T __out__* out)
+{
+    using DynShapeDim5 = Shape<1, 1, 1, vRows, vCols>;
+    using DynStridDim5 = Stride<1, 1, 1, kTCols_, 1>;
+    using GlobalData = GlobalTensor<T, DynShapeDim5, DynStridDim5>;
+    using TileData = Tile<TileType::Vec, T, kTRows_, kTCols_, BLayout::RowMajor, -1, -1>;
+    TileData dstTile(vRows, vCols);
+    TASSIGN(dstTile, @@OFF0@@);
+    GlobalData dstGlobal(out);
+    TEXPANDS(dstTile, @@FILL@@);
+#ifndef __PTO_AUTO__
+    set_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
+    wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
+#endif
+    TSTORE(dstGlobal, dstTile);
+}
+"""
+
+_COPY_LAUNCHER = """
+template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>
+void LaunchIRBridge_@@CPP@@(T* out, T* in0, void* stream)
+{
+    run_@@CPP@@<T, kTRows_, kTCols_, vRows, vCols><<<1, nullptr, stream>>>(out, in0);
+}
+template void LaunchIRBridge_@@CPP@@<float, @@ROWS@@, @@COLS@@, @@ROWS@@, @@COLS@@>(float* out, float* in0, void* stream);
+"""
+
+_ADD_LAUNCHER = """
+template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>
+void LaunchIRBridge_@@CPP@@(T* out, T* in0, T* in1, void* stream)
+{
+    run_@@CPP@@<T, kTRows_, kTCols_, vRows, vCols><<<1, nullptr, stream>>>(out, in0, in1);
+}
+template void LaunchIRBridge_@@CPP@@<float, @@ROWS@@, @@COLS@@, @@ROWS@@, @@COLS@@>(
+    float* out, float* in0, float* in1, void* stream);
+"""
+
+_FILL_LAUNCHER = """
+template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>
+void LaunchIRBridge_@@CPP@@(T* out, void* stream)
+{
+    run_@@CPP@@<T, kTRows_, kTCols_, vRows, vCols><<<1, nullptr, stream>>>(out);
+}
+template void LaunchIRBridge_@@CPP@@<float, @@ROWS@@, @@COLS@@, @@ROWS@@, @@COLS@@>(float* out, void* stream);
+"""
+
+
+def _kernel_text(program, lowered: Sequence[LoweredOp], ir_json_name: str) -> str:
+    ir_summary = "\n".join(
+        " *   %d. %s(%s) -> %s"
+        % (
+            index,
+            item.op_name,
+            ", ".join("%" + name for name in item.input_names) or "<none>",
+            "%" + item.output_name,
+        )
+        for index, item in enumerate(lowered, start=1)
+    )
+    parts = [
+        _KERNEL_HEADER.replace("@@IR_JSON@@", ir_json_name).replace("@@IR_SUMMARY@@", ir_summary)
+    ]
+    for index, item in enumerate(lowered, start=1):
+        if item.kind == "copy":
+            body = (
+                _COPY_FUNC.replace("@@IN0@@", item.input_names[0])
+                .replace("@@INDEX@@", str(index))
+                .replace("@@OUT@@", item.output_name)
+                .replace("@@OFF0@@", hex(0))
+                .replace("@@OFF1@@", hex(item.tile_bytes))
+            )
+        elif item.kind == "add":
+            body = (
+                _ADD_FUNC.replace("@@IN0@@", item.input_names[0])
+                .replace("@@IN1@@", item.input_names[1])
+                .replace("@@INDEX@@", str(index))
+                .replace("@@OUT@@", item.output_name)
+                .replace("@@OFF0@@", hex(0))
+                .replace("@@OFF1@@", hex(item.tile_bytes))
+                .replace("@@OFF2@@", hex(2 * item.tile_bytes))
+            )
+        elif item.kind == "fill":
+            body = (
+                _FILL_FUNC.replace("@@FILL@@", _f32_literal(item.fill_value_f32))
+                .replace("@@INDEX@@", str(index))
+                .replace("@@OUT@@", item.output_name)
+                .replace("@@OFF0@@", hex(0))
+            )
+        else:  # pragma: no cover - lower() 已收口
+            raise UnsupportedBridgeOp("未知 kind %r" % item.kind)
+        parts.append(
+            body.replace("@@CPP@@", item.cpp_name)
+            .replace("@@ROWS@@", str(item.rows))
+            .replace("@@COLS@@", str(item.cols))
+        )
+
+    for item in lowered:
+        if item.kind == "copy":
+            launcher = _COPY_LAUNCHER
+        elif item.kind == "add":
+            launcher = _ADD_LAUNCHER
+        else:
+            launcher = _FILL_LAUNCHER
+        parts.append(
+            launcher.replace("@@CPP@@", item.cpp_name)
+            .replace("@@ROWS@@", str(item.rows))
+            .replace("@@COLS@@", str(item.cols))
+        )
+    return "".join(parts)
+
+
+_HOST_COMMON = r"""/* gtest + ACL host main generated by spike/ir_to_pto_minimal_bridge/emitter.py
+ *
+ * 每个 Core IR 函数对应一个 gtest case：确定性输入 -> H2D -> kernel -> D2H ->
+ * C++ 侧断言 -> dump f32 bin（供 numpy CPU 对账）。输入公式与
+ * spike/ir_to_pto_minimal_bridge/compare_bins.py 必须逐位一致。
+ *
+ * 环境变量：
+ *   IR_BRIDGE_OUT_DIR           bin 输出目录（默认 ./ir_bridge_out）
+ *   IR_BRIDGE_EVIDENCE_MIB      额外设备 sentinel 分配（MiB，默认 0；用于 npu-smi 证据）
+ *   IR_BRIDGE_EVIDENCE_HOLD_SEC 分配后持有秒数并打印 IR_BRIDGE_EVIDENCE_PID（默认 0）
+ */
+#include "acl/acl.h"
+#include <gtest/gtest.h>
+#include <unistd.h>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+
+std::string OutDir() {
+    const char* dir = std::getenv("IR_BRIDGE_OUT_DIR");
+    return (dir != nullptr && *dir != '\0') ? std::string(dir) : std::string("ir_bridge_out");
+}
+
+void DumpBin(const std::string& name, const void* data, size_t bytes) {
+    const std::string path = OutDir() + "/" + name;
+    std::FILE* file = std::fopen(path.c_str(), "wb");
+    if (file == nullptr) {
+        std::fprintf(stderr, "IR_BRIDGE_ERROR: cannot open %s\n", path.c_str());
+        return;
+    }
+    const size_t written = std::fwrite(data, 1, bytes, file);
+    std::fclose(file);
+    if (written != bytes) {
+        std::fprintf(stderr, "IR_BRIDGE_ERROR: short write %s\n", path.c_str());
+    }
+}
+
+// 与 compare_bins.py 共用的输入公式：整数格点 * 0.125f，保证 f32 精确。
+void FillInput(std::vector<float>& buffer, uint64_t seed) {
+    for (size_t i = 0; i < buffer.size(); ++i) {
+        const uint64_t x = (static_cast<uint64_t>(i) * 2654435761ull + seed * 97ull) % 1009ull;
+        buffer[i] = static_cast<float>(static_cast<int64_t>(x) - 504) * 0.125f;
+    }
+}
+
+bool BitsEqual(float a, float b) { return std::memcmp(&a, &b, sizeof(float)) == 0; }
+
+}  // namespace
+
+@@LAUNCHER_DECLS@@
+
+class IRBridgeTest : public ::testing::Test {
+protected:
+    static void SetUpTestSuite() {
+        ASSERT_EQ(aclInit(nullptr), 0);
+        ASSERT_EQ(aclrtSetDevice(0), 0);
+        const char* mib_env = std::getenv("IR_BRIDGE_EVIDENCE_MIB");
+        const long mib = (mib_env != nullptr) ? std::atol(mib_env) : 0;
+        if (mib > 0) {
+            const size_t bytes = static_cast<size_t>(mib) * 1024ull * 1024ull;
+            if (aclrtMalloc(&evidence_buffer_, bytes, ACL_MEM_MALLOC_HUGE_FIRST) == 0) {
+                (void)aclrtMemset(evidence_buffer_, bytes, 0, bytes);
+                evidence_bytes_ = bytes;
+            } else {
+                std::fprintf(stderr, "IR_BRIDGE_WARN: evidence malloc %ld MiB failed\n", mib);
+            }
+        }
+        const char* hold_env = std::getenv("IR_BRIDGE_EVIDENCE_HOLD_SEC");
+        const long hold = (hold_env != nullptr) ? std::atol(hold_env) : 0;
+        if (hold > 0) {
+            std::fprintf(stderr, "IR_BRIDGE_EVIDENCE_PID=%d READY evidence_bytes=%zu\n",
+                         static_cast<int>(::getpid()), evidence_bytes_);
+            std::fflush(stderr);
+            ::sleep(static_cast<unsigned int>(hold));
+        }
+    }
+
+    static void TearDownTestSuite() {
+        if (evidence_buffer_ != nullptr) {
+            (void)aclrtFree(evidence_buffer_);
+            evidence_buffer_ = nullptr;
+        }
+        (void)aclrtResetDevice(0);
+        (void)aclFinalize();
+    }
+
+    void SetUp() override { ASSERT_EQ(aclrtCreateStream(&stream_), 0); }
+
+    void TearDown() override {
+        if (stream_ != nullptr) {
+            (void)aclrtDestroyStream(stream_);
+            stream_ = nullptr;
+        }
+    }
+
+    static void* evidence_buffer_;
+    static size_t evidence_bytes_;
+    aclrtStream stream_ = nullptr;
+};
+
+void* IRBridgeTest::evidence_buffer_ = nullptr;
+size_t IRBridgeTest::evidence_bytes_ = 0;
+
+@@CASE_BLOCKS@@
+"""
+
+
+_CASE_SHELL = """// Core IR function `@@FUNC@@` -> @@KIND@@ lowering
+TEST_F(IRBridgeTest, @@FUNC@@) {
+    constexpr size_t kElems = @@ELEMS@@ull;
+    constexpr size_t kBytes = kElems * sizeof(float);
+    std::vector<float> out(kElems, 0.0f);
+@@INPUTS@@    void* d_out = nullptr;
+    ASSERT_EQ(aclrtMalloc(&d_out, kBytes, ACL_MEM_MALLOC_HUGE_FIRST), 0);
+    ASSERT_EQ(aclrtMemset(d_out, kBytes, 0, kBytes), 0);
+@@LAUNCH@@    ASSERT_EQ(aclrtSynchronizeStream(stream_), 0);
+    ASSERT_EQ(aclrtMemcpy(out.data(), kBytes, d_out, kBytes, ACL_MEMCPY_DEVICE_TO_HOST), 0);
+@@VERIFY@@    ASSERT_EQ(aclrtFree(d_out), 0);
+@@FREE_EXTRA@@}
+"""
+
+
+def _host_case_block(item: LoweredOp) -> str:
+    if item.kind == "copy":
+        inputs = """    std::vector<float> in0(kElems, 0.0f);
+    FillInput(in0, 1);
+    void* d_in0 = nullptr;
+    ASSERT_EQ(aclrtMalloc(&d_in0, kBytes, ACL_MEM_MALLOC_HUGE_FIRST), 0);
+    ASSERT_EQ(aclrtMemcpy(d_in0, kBytes, in0.data(), kBytes, ACL_MEMCPY_HOST_TO_DEVICE), 0);
+"""
+        launch = """    LaunchIRBridge_%s<float, %d, %d, %d, %d>(
+        static_cast<float*>(d_out), static_cast<float*>(d_in0), stream_);
+""" % (item.cpp_name, item.rows, item.cols, item.rows, item.cols)
+        verify = """    int mismatch = 0;
+    float max_abs = 0.0f;
+    for (size_t i = 0; i < kElems; ++i) {
+        if (!BitsEqual(out[i], in0[i])) {
+            ++mismatch;
+            max_abs = std::fmax(max_abs, std::fabs(out[i] - in0[i]));
+        }
+    }
+    DumpBin("%s_in0.bin", in0.data(), kBytes);
+    DumpBin("%s_out.bin", out.data(), kBytes);
+    EXPECT_EQ(mismatch, 0) << "copy bitwise mismatches=" << mismatch << " max_abs=" << max_abs;
+""" % (item.function_name, item.function_name)
+        free_extra = "    ASSERT_EQ(aclrtFree(d_in0), 0);\n"
+    elif item.kind == "add":
+        inputs = """    std::vector<float> in0(kElems, 0.0f);
+    std::vector<float> in1(kElems, 0.0f);
+    FillInput(in0, 1);
+    FillInput(in1, 2);
+    void* d_in0 = nullptr;
+    void* d_in1 = nullptr;
+    ASSERT_EQ(aclrtMalloc(&d_in0, kBytes, ACL_MEM_MALLOC_HUGE_FIRST), 0);
+    ASSERT_EQ(aclrtMalloc(&d_in1, kBytes, ACL_MEM_MALLOC_HUGE_FIRST), 0);
+    ASSERT_EQ(aclrtMemcpy(d_in0, kBytes, in0.data(), kBytes, ACL_MEMCPY_HOST_TO_DEVICE), 0);
+    ASSERT_EQ(aclrtMemcpy(d_in1, kBytes, in1.data(), kBytes, ACL_MEMCPY_HOST_TO_DEVICE), 0);
+"""
+        launch = """    LaunchIRBridge_%s<float, %d, %d, %d, %d>(
+        static_cast<float*>(d_out), static_cast<float*>(d_in0), static_cast<float*>(d_in1), stream_);
+""" % (item.cpp_name, item.rows, item.cols, item.rows, item.cols)
+        verify = """    int mismatch = 0;
+    float max_abs = 0.0f;
+    float max_rel = 0.0f;
+    for (size_t i = 0; i < kElems; ++i) {
+        const float ref = in0[i] + in1[i];
+        if (!BitsEqual(out[i], ref)) {
+            ++mismatch;
+            const float err = std::fabs(out[i] - ref);
+            max_abs = std::fmax(max_abs, err);
+            max_rel = std::fmax(max_rel, err / std::fmax(std::fabs(ref), 1e-30f));
+        }
+    }
+    DumpBin("%s_in0.bin", in0.data(), kBytes);
+    DumpBin("%s_in1.bin", in1.data(), kBytes);
+    DumpBin("%s_out.bin", out.data(), kBytes);
+    EXPECT_TRUE(mismatch == 0 || (max_abs <= 1e-5f && max_rel <= 1e-6f))
+        << "add bitwise mismatches=" << mismatch << " max_abs=" << max_abs << " max_rel=" << max_rel;
+""" % (item.function_name, item.function_name, item.function_name)
+        free_extra = "    ASSERT_EQ(aclrtFree(d_in0), 0);\n    ASSERT_EQ(aclrtFree(d_in1), 0);\n"
+    else:  # fill
+        inputs = ""
+        launch = """    LaunchIRBridge_%s<float, %d, %d, %d, %d>(static_cast<float*>(d_out), stream_);
+""" % (item.cpp_name, item.rows, item.cols, item.rows, item.cols)
+        verify = """    constexpr float kFill = %s;
+    int mismatch = 0;
+    float max_abs = 0.0f;
+    for (size_t i = 0; i < kElems; ++i) {
+        if (!BitsEqual(out[i], kFill)) {
+            ++mismatch;
+            max_abs = std::fmax(max_abs, std::fabs(out[i] - kFill));
+        }
+    }
+    DumpBin("%s_out.bin", out.data(), kBytes);
+    EXPECT_EQ(mismatch, 0) << "fill bitwise mismatches=" << mismatch << " max_abs=" << max_abs;
+""" % (_f32_literal(item.fill_value_f32), item.function_name)
+        free_extra = ""
+
+    return (
+        _CASE_SHELL.replace("@@FUNC@@", item.function_name)
+        .replace("@@KIND@@", item.kind)
+        .replace("@@ELEMS@@", str(item.elems))
+        .replace("@@INPUTS@@", inputs)
+        .replace("@@LAUNCH@@", launch)
+        .replace("@@VERIFY@@", verify)
+        .replace("@@FREE_EXTRA@@", free_extra)
+    )
+
+
+def _launcher_decls(lowered: Sequence[LoweredOp]) -> str:
+    decls = []
+    for item in lowered:
+        if item.kind == "add":
+            args = "T* out, T* in0, T* in1, void* stream"
+        elif item.kind == "copy":
+            args = "T* out, T* in0, void* stream"
+        else:
+            args = "T* out, void* stream"
+        decls.append(
+            "template <typename T, int kTRows_, int kTCols_, int vRows, int vCols>\nvoid LaunchIRBridge_%s(%s);"
+            % (item.cpp_name, args)
+        )
+    return "\n".join(decls)
+
+
+def _host_text(lowered: Sequence[LoweredOp]) -> str:
+    blocks = "\n".join(_host_case_block(item) for item in lowered)
+    return (
+        _HOST_COMMON.replace("@@LAUNCHER_DECLS@@", _launcher_decls(lowered))
+        .replace("@@CASE_BLOCKS@@", blocks)
+    )
+
+
+def _cases_document(lowered: Sequence[LoweredOp]) -> Dict:
+    cases = []
+    for item in lowered:
+        case = {
+            "function": item.function_name,
+            "kind": item.kind,
+            "dtype": item.dtype,
+            "shape": [item.rows, item.cols],
+            "elems": item.elems,
+            "output": "%s_out.bin" % item.function_name,
+            "inputs": ["%s_in%d.bin" % (item.function_name, i) for i in range(len(item.input_names))],
+            "input_seeds": [1 + i for i in range(len(item.input_names))],
+            "fill_value_f32": item.fill_value_f32,
+        }
+        cases.append(case)
+    return {
+        "bridge_version": 1,
+        "input_formula": "buf[i] = float(((i*2654435761 + seed*97) % 1009) - 504) * 0.125f",
+        "input_seeds": {"copy/add": "seed=1 为 in0，seed=2 为 in1"},
+        "tolerance": {"add": {"max_abs": 1e-5, "max_rel": 1e-6, "exact_expected": True}},
+        "cases": cases,
+    }
+
+
+def _sha256_text(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _ir_summary(program) -> str:
+    lines = []
+    for function in program.functions:
+        op = function.body.operations[0]
+        lines.append("function %s: %s" % (function.name, json.dumps(op.to_dict(), sort_keys=True)))
+    return "\n".join(lines)
+
+
+def emit(program, out_dir: Path) -> Dict[str, Path]:
+    """生成 kernel/main/CMake/cases/report，返回文件路径映射。"""
+
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    lowered = lower(program)
+
+    ir_text = program.canonical_json()
+    kernel_text = _kernel_text(program, lowered, IR_JSON_FILENAME)
+    host_text = _host_text(lowered)
+    cases_doc = _cases_document(lowered)
+    cases_text = json.dumps(cases_doc, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
+    cmake_text = "# generated by E4 spike; 放在 testcase/ 下复用上游 pto_vec_st 目标模式\npto_vec_st(ir_to_pto_bridge)\n"
+
+    report = {
+        "generator": "spike/ir_to_pto_minimal_bridge/emitter.py",
+        "bridge_version": 1,
+        "schema_version": program.schema_version,
+        "ir_sha256": _sha256_text(ir_text),
+        "files": {
+            KERNEL_FILENAME: {"sha256": _sha256_text(kernel_text), "bytes": len(kernel_text.encode())},
+            HOST_FILENAME: {"sha256": _sha256_text(host_text), "bytes": len(host_text.encode())},
+            CASES_FILENAME: {"sha256": _sha256_text(cases_text), "bytes": len(cases_text.encode())},
+            CMAKE_FILENAME: {"sha256": _sha256_text(cmake_text), "bytes": len(cmake_text.encode())},
+        },
+        "mappings": [],
+    }
+    kernel_lines = kernel_text.splitlines()
+    for index, item in enumerate(lowered, start=1):
+        anchor = "run_%s" % item.cpp_name
+        line_no = next((n for n, line in enumerate(kernel_lines, start=1) if anchor in line), None)
+        report["mappings"].append(
+            {
+                "index": index,
+                "core_ir_function": item.function_name,
+                "core_ir_op": item.op_name,
+                "semantics": item.semantics,
+                "lowered": {
+                    "kernel_symbol": anchor,
+                    "kind": item.kind,
+                    "ub_tile_bytes": item.tile_bytes,
+                    "ub_offsets": [hex(i * item.tile_bytes) for i in range(max(1, len(item.input_names) + 1))],
+                    "host_test": item.test_name,
+                },
+                "kernel_line": line_no,
+            }
+        )
+
+    paths = {
+        IR_JSON_FILENAME: out_dir / IR_JSON_FILENAME,
+        KERNEL_FILENAME: out_dir / KERNEL_FILENAME,
+        HOST_FILENAME: out_dir / HOST_FILENAME,
+        CASES_FILENAME: out_dir / CASES_FILENAME,
+        CMAKE_FILENAME: out_dir / CMAKE_FILENAME,
+        REPORT_FILENAME: out_dir / REPORT_FILENAME,
+    }
+    paths[IR_JSON_FILENAME].write_text(ir_text + "\n", encoding="utf-8")
+    paths[KERNEL_FILENAME].write_text(kernel_text, encoding="utf-8")
+    paths[HOST_FILENAME].write_text(host_text, encoding="utf-8")
+    paths[CASES_FILENAME].write_text(cases_text, encoding="utf-8")
+    paths[CMAKE_FILENAME].write_text(cmake_text, encoding="utf-8")
+    paths[REPORT_FILENAME].write_text(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return paths
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    import argparse
+
+    parser = argparse.ArgumentParser(description="Core IR -> PTO C++ minimal emitter")
+    parser.add_argument("--out", default=str(Path(__file__).resolve().parent / "generated"), help="输出目录")
+    parser.add_argument("--print-ir", action="store_true", help="同时把 canonical IR 打到 stdout")
+    args = parser.parse_args(argv)
+
+    program = programs.build_program()
+    paths = emit(program, Path(args.out))
+    if args.print_ir:
+        print(program.canonical_json())
+    for name, path in sorted(paths.items()):
+        print("%s\t%s" % (path, name))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
