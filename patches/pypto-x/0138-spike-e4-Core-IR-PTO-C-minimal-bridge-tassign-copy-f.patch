new file mode 100644
index 000000000..0720c469e
--- /dev/null
+++ b/spike/ir_to_pto_minimal_bridge/programs.py
@@ -0,0 +1,128 @@
+"""E4 第一步的 Core IR 输入：两条（+1 条属性扩展）最小程序。
+
+用 ``python/pypto/core_ir`` 的真实数据模型手工构造：
+
+* ``tassign`` + ``semantics=copy``  ：``%dst = tassign(%src)``（64x64 f32 拷贝）
+* ``tadd``                          ：``%dst = tadd(%lhs, %rhs)``（64x64 f32 逐元素加）
+* ``tassign`` + ``semantics=fill``  ：``%dst = tassign() {fill_value=-1.75}``
+
+这些 op 名不是从后端库里抄来的，而是本 spike 为“最小桥”冻结的桥接词汇；
+emitter 只认识这三种组合，遇到别的 op 一律 fail-closed。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Tuple
+
+from .core_ir_loader import load_core_ir
+
+_ir = load_core_ir()
+
+#: 桥接最小 dtype/形状（E4 step1 只支持静态 rank-2 f32）。
+DTYPE = "f32"
+ROWS = 64
+COLS = 64
+SHAPE: Tuple[int, int] = (ROWS, COLS)
+
+#: 填充语义的标量；真实值会在 emitter 里量化到 f32 bit pattern。
+FILL_VALUE = -1.75
+
+_CoreFunction = _ir.CoreFunction
+_CoreProgram = _ir.CoreProgram
+_CoreType = _ir.CoreType
+_Effect = _ir.Effect
+_Operation = _ir.Operation
+_Region = _ir.Region
+_ValueRef = _ir.ValueRef
+
+
+@dataclass(frozen=True)
+class Case:
+    """一个 Core IR 函数与其桥接语义的配对（供 emitter / 测试使用）。"""
+
+    function_name: str
+    op_name: str
+    semantics: str
+    inputs: Tuple[str, ...]
+    output: str
+    shape: Tuple[int, int] = SHAPE
+    dtype: str = DTYPE
+    fill_value: float = 0.0
+
+
+CASES: Tuple[Case, ...] = (
+    Case("tassign_copy_64x64_f32", "tassign", "copy", ("src",), "dst"),
+    Case("tadd_64x64_f32", "tadd", "elementwise_add", ("lhs", "rhs"), "dst"),
+    Case("tassign_fill_64x64_f32", "tassign", "fill", (), "dst", fill_value=FILL_VALUE),
+)
+
+
+def _tensor_type() -> "_ir.CoreType":
+    return _CoreType.tensor(DTYPE, SHAPE)
+
+
+def tassign_copy_function() -> "_ir.CoreFunction":
+    tensor = _tensor_type()
+    src = _ValueRef("src", tensor)
+    dst = _ValueRef("dst", tensor)
+    op = _Operation(
+        "tassign",
+        inputs=(src,),
+        outputs=(dst,),
+        attributes={"semantics": "copy"},
+        effect=_Effect.PURE,
+    )
+    return _CoreFunction("tassign_copy_64x64_f32", parameters=(src,), returns=(dst,), body=_Region((op,)))
+
+
+def tadd_function() -> "_ir.CoreFunction":
+    tensor = _tensor_type()
+    lhs = _ValueRef("lhs", tensor)
+    rhs = _ValueRef("rhs", tensor)
+    dst = _ValueRef("dst", tensor)
+    op = _Operation(
+        "tadd",
+        inputs=(lhs, rhs),
+        outputs=(dst,),
+        attributes={"semantics": "elementwise_add"},
+        effect=_Effect.PURE,
+    )
+    return _CoreFunction("tadd_64x64_f32", parameters=(lhs, rhs), returns=(dst,), body=_Region((op,)))
+
+
+def tassign_fill_function(fill_value: float = FILL_VALUE) -> "_ir.CoreFunction":
+    tensor = _tensor_type()
+    dst = _ValueRef("dst", tensor)
+    op = _Operation(
+        "tassign",
+        inputs=(),
+        outputs=(dst,),
+        attributes={"semantics": "fill", "fill_value": float(fill_value)},
+        effect=_Effect.PURE,
+    )
+    return _CoreFunction("tassign_fill_64x64_f32", parameters=(), returns=(dst,), body=_Region((op,)))
+
+
+def build_program() -> "_ir.CoreProgram":
+    """返回一个 schema v1、可验证、可稳定序列化的 CoreProgram。"""
+
+    program = _CoreProgram(
+        functions=[tassign_copy_function(), tadd_function(), tassign_fill_function()],
+        metadata={
+            "source": "E4 spike ir-to-pto-minimal-bridge",
+            "bridge_version": 1,
+            "op_vocabulary": {
+                "tassign": "copy (semantics=copy) / fill (semantics=fill, attribute fill_value)",
+                "tadd": "elementwise add, two inputs",
+            },
+            "supported": {"dtype": [DTYPE], "rank": [2], "static_shape_only": True},
+            "target_hint": "pto-isa @ 668248ec / npu a2a3 (dav-c220-vec)",
+        },
+    )
+    program.verify()
+    return program
+
+
+def canonical_ir_text(program=None) -> str:
+    return (program or build_program()).canonical_json()
diff --git a/spike/ir_to_pto_minimal_bridge/tests/test_emitter.py b/spike/ir_to_pto_minimal_bridge/tests/test_emitter.py
new file mode 100644
index 000000000..299fdd284
--- /dev/null
+++ b/spike/ir_to_pto_minimal_bridge/tests/test_emitter.py
@@ -0,0 +1,93 @@
+"""emitter 的最小单测：验证、确定性、关键 lowering、fail-closed。"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+SPIKE_ROOT = Path(__file__).resolve().parents[2]
+if str(SPIKE_ROOT) not in sys.path:
+    sys.path.insert(0, str(SPIKE_ROOT))
+
+from ir_to_pto_minimal_bridge import emitter, programs  # noqa: E402
+from ir_to_pto_minimal_bridge.core_ir_loader import load_core_ir  # noqa: E402
+
+_ir = load_core_ir()
+
+
+def test_program_verifies_and_round_trips():
+    program = programs.build_program()
+    assert program.verify() is True
+    restored = _ir.CoreProgram.from_json(program.canonical_json())
+    assert restored == program
+    assert [f.name for f in program.functions] == [
+        "tassign_copy_64x64_f32",
+        "tadd_64x64_f32",
+        "tassign_fill_64x64_f32",
+    ]
+
+
+def test_emit_is_deterministic(tmp_path):
+    program = programs.build_program()
+    first = emitter.emit(program, tmp_path / "a")
+    second = emitter.emit(program, tmp_path / "b")
+    for name in first:
+        assert first[name].read_text(encoding="utf-8") == second[name].read_text(encoding="utf-8"), name
+
+
+def test_kernel_carries_expected_lowering(tmp_path):
+    paths = emitter.emit(programs.build_program(), tmp_path / "gen")
+    kernel = paths[emitter.KERNEL_FILENAME].read_text(encoding="utf-8")
+    assert "run_tassign_copy_64x64_f32" in kernel
+    assert "run_tadd_64x64_f32" in kernel
+    assert "run_tassign_fill_64x64_f32" in kernel
+    assert "TLOAD(copyTile, srcGlobal)" in kernel
+    assert "TADD(dstTile, lhsTile, rhsTile, event0)" in kernel
+    assert "TEXPANDS(dstTile, -1.75f)" in kernel
+    assert "--cce" not in kernel  # 编译选项属于 CMake target，不在源码里
+
+
+def test_cases_document(tmp_path):
+    paths = emitter.emit(programs.build_program(), tmp_path / "gen")
+    doc = json.loads(paths[emitter.CASES_FILENAME].read_text(encoding="utf-8"))
+    kinds = {case["function"]: case["kind"] for case in doc["cases"]}
+    assert kinds == {
+        "tassign_copy_64x64_f32": "copy",
+        "tadd_64x64_f32": "add",
+        "tassign_fill_64x64_f32": "fill",
+    }
+    report = json.loads(paths[emitter.REPORT_FILENAME].read_text(encoding="utf-8"))
+    assert len(report["mappings"]) == 3
+    assert report["ir_sha256"]
+
+
+def _program_with_op(name, dtype="f32", shape=(64, 64), attributes=None, n_inputs=1):
+    tensor = _ir.CoreType.tensor(dtype, shape)
+    inputs = tuple(_ir.ValueRef("in%d" % index, tensor) for index in range(n_inputs))
+    output = _ir.ValueRef("out", tensor)
+    op = _ir.Operation(name, inputs=inputs, outputs=(output,), attributes=attributes or {})
+    function = _ir.CoreFunction("f", parameters=inputs, returns=(output,), body=_ir.Region((op,)))
+    return _ir.CoreProgram(functions=(function,))
+
+
+def test_fail_closed_unknown_op(tmp_path):
+    with pytest.raises(emitter.UnsupportedBridgeOp):
+        emitter.emit(_program_with_op("tmatmul"), tmp_path / "gen")
+
+
+def test_fail_closed_unsupported_dtype(tmp_path):
+    with pytest.raises(emitter.UnsupportedBridgeOp):
+        emitter.emit(_program_with_op("tadd", dtype="bf16", n_inputs=2), tmp_path / "gen")
+
+
+def test_fail_closed_rank3(tmp_path):
+    with pytest.raises(emitter.UnsupportedBridgeOp):
+        emitter.emit(_program_with_op("tadd", shape=(2, 4, 4), n_inputs=2), tmp_path / "gen")
+
+
+def test_fail_closed_missing_semantics(tmp_path):
+    with pytest.raises(emitter.UnsupportedBridgeOp):
+        emitter.emit(_program_with_op("tassign"), tmp_path / "gen")
