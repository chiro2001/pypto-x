@@ -0,0 +1,85 @@
+#!/usr/bin/env bash
+# 在 A3 容器内、chip7（ASCEND_RT_VISIBLE_DEVICES=7）上运行生成的 ir_to_pto_bridge。
+# 采集：npu-smi chip7 行、proc-mem、二进制 stdout（gtest）、exit code、dump bins。
+# 环境变量（可选）：
+#   EVIDENCE_MIB   额外 sentinel 设备分配 MiB（默认 0）
+#   EVIDENCE_HOLD  持有秒数（默认 0；>0 时打印 IR_BRIDGE_EVIDENCE_PID）
+#   GTEST_FILTER   gtest filter（默认全部 3 个 case）
+set -u
+
+export HOME="${HOME:-/home/l00886679}"
+export ASCEND_RT_VISIBLE_DEVICES=7
+LOG="$HOME/pypto-x-a3/logs/ir-to-pto-minimal-bridge"
+WORK="${WORK:-$LOG/run_chip7}"
+BINS="$WORK/bins"
+BIN="$HOME/pypto-x-a3/src/pto-isa/tests/npu/a2a3/src/st/build-bridge/bin/ir_to_pto_bridge"
+FILTER="${GTEST_FILTER:-IRBridgeTest.*}"
+EVIDENCE_MIB="${EVIDENCE_MIB:-0}"
+EVIDENCE_HOLD="${EVIDENCE_HOLD:-0}"
+
+mkdir -p "$BINS"
+rm -rf "$BINS"/*
+
+chip7_row() { timeout 30 npu-smi info 2>&1 | grep -E '0000:93:00.0' || true; }
+
+{
+    echo "== env =="
+    echo "ASCEND_RT_VISIBLE_DEVICES=$ASCEND_RT_VISIBLE_DEVICES"
+    echo "BIN=$BIN"
+    echo "GTEST_FILTER=$FILTER"
+    echo "IR_BRIDGE_EVIDENCE_MIB=$EVIDENCE_MIB IR_BRIDGE_EVIDENCE_HOLD_SEC=$EVIDENCE_HOLD"
+    echo "date_utc=$(date -u +%FT%T.%3NZ)"
+    ls -l "$BIN"
+    echo "== chip7 mapping =="
+    timeout 30 npu-smi info -m 2>&1 | grep -E '^\| (3|7) ' | head -5 || true
+    echo "== chip7 before: proc-mem / npu row =="
+    timeout 30 npu-smi info -t proc-mem -i 3 -c 1 2>&1
+    chip7_row
+    echo "== launch (timeout 700) =="
+} | tee "$WORK/env_and_pre.log"
+
+export IR_BRIDGE_OUT_DIR="$BINS"
+export IR_BRIDGE_EVIDENCE_MIB="$EVIDENCE_MIB"
+export IR_BRIDGE_EVIDENCE_HOLD_SEC="$EVIDENCE_HOLD"
+
+start=$(date +%s.%N)
+timeout 700 "$BIN" --gtest_color=no --gtest_filter="$FILTER" > "$WORK/stdout.log" 2>&1 &
+TEST_PID=$!
+echo "BINARY_PID=$TEST_PID" | tee -a "$WORK/env_and_pre.log"
+
+# 若配置了 evidence hold，等 READY 标记后采样（在持有设备内存的窗口内）。
+if [ "$EVIDENCE_HOLD" -gt 0 ] 2>/dev/null; then
+    for _ in $(seq 1 60); do
+        grep -q 'IR_BRIDGE_EVIDENCE_PID=' "$WORK/stdout.log" 2>/dev/null && break
+        sleep 0.5
+    done
+    {
+        echo "== during hold: READY marker =="
+        grep 'IR_BRIDGE_EVIDENCE_PID=' "$WORK/stdout.log" || echo "NO_READY_MARKER"
+        echo "== during hold: chip7 proc-mem =="
+        timeout 10 npu-smi info -t proc-mem -i 3 -c 1 2>&1
+        echo "== during hold: npu-smi full process section =="
+        timeout 40 npu-smi info 2>&1 | sed -n '/Process id/,$p' | head -30
+        echo "== during hold: chip7 row =="
+        chip7_row
+        echo "date_utc=$(date -u +%FT%T.%3NZ)"
+    } | tee "$WORK/during_hold.log"
+fi
+
+wait "$TEST_PID"
+RC=$?
+end=$(date +%s.%N)
+{
+    echo "IR_BRIDGE_EXIT=$RC"
+    awk -v s="$start" -v e="$end" 'BEGIN { printf "IR_BRIDGE_WALL_SECONDS=%.3f\n", e - s }'
+    echo "== stdio =="
+    cat "$WORK/stdout.log"
+    echo "== chip7 after: proc-mem / npu row =="
+    timeout 30 npu-smi info -t proc-mem -i 3 -c 1 2>&1
+    chip7_row
+    echo "== dumped bins =="
+    ls -l "$BINS"
+    echo "date_utc=$(date -u +%FT%T.%3NZ)"
+} | tee "$WORK/post.log"
+
+exit "$RC"
