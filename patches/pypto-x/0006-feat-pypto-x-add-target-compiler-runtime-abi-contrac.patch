diff --git a/python/pypto/abi/descriptors.py b/python/pypto/abi/descriptors.py
new file mode 100644
index 000000000..7864df4f0
--- /dev/null
+++ b/python/pypto/abi/descriptors.py
@@ -0,0 +1,284 @@
+"""Vendor-neutral tensor and launch descriptors."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.target._utils import frozen_mapping, mapping_copy
+from pypto.target.errors import ABIValidationError, VersionMismatchError
+
+from pypto.compiler.artifact import ARTIFACT_FORMAT_VERSION, Artifact
+
+
+_DTYPE_BYTES = {
+    "bool": 1,
+    "int8": 1,
+    "uint8": 1,
+    "int16": 2,
+    "uint16": 2,
+    "int32": 4,
+    "uint32": 4,
+    "int64": 8,
+    "uint64": 8,
+    "float16": 2,
+    "half": 2,
+    "bf16": 2,
+    "bfloat16": 2,
+    "float32": 4,
+    "float64": 8,
+    "fp8": 1,
+    "int4": 1,
+}
+
+ABI_SCHEMA_VERSION = 1
+
+
+def _normalize_dtype(dtype: Any) -> str:
+    if isinstance(dtype, str):
+        result = dtype.strip().lower()
+    else:
+        name = getattr(dtype, "name", None)
+        result = str(name if isinstance(name, str) else dtype).strip().lower()
+    if not result:
+        raise ABIValidationError("tensor dtype must be non-empty", field="dtype")
+    return result
+
+
+def _normalize_shape(shape: Sequence[int], field: str) -> Tuple[int, ...]:
+    if isinstance(shape, (str, bytes)):
+        raise ABIValidationError("{} must be a sequence of integer dimensions".format(field), field=field)
+    try:
+        result = tuple(shape)
+    except TypeError as exc:
+        raise ABIValidationError("{} must be a sequence of integer dimensions".format(field), field=field) from exc
+    for index, value in enumerate(result):
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            raise ABIValidationError(
+                "{}[{}] must be a non-negative integer".format(field, index),
+                field=field,
+            )
+    return result
+
+
+def _contiguous_strides(shape: Tuple[int, ...]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+@dataclass(frozen=True, init=False)
+class TensorDesc:
+    """Runtime tensor metadata without vendor-specific descriptors."""
+
+    dtype: str
+    shape: Tuple[int, ...]
+    strides: Tuple[int, ...]
+    device: str
+    address: Any
+    handle: Any
+    readonly: bool
+    schema_version: int
+
+    def __init__(
+        self,
+        dtype: Any,
+        shape: Sequence[int],
+        strides: Optional[Sequence[int]] = None,
+        device: str = "cpu",
+        address: Any = None,
+        handle: Any = None,
+        readonly: bool = False,
+        *,
+        read_only: Optional[bool] = None,
+        schema_version: int = ABI_SCHEMA_VERSION
+    ):
+        if address is not None and handle is not None:
+            raise ABIValidationError("tensor descriptor accepts address or handle, not both", field="address/handle")
+        if read_only is not None:
+            if readonly is not False and bool(readonly) != bool(read_only):
+                raise ValueError("readonly and read_only are aliases; pass only one")
+            readonly = bool(read_only)
+        if not isinstance(device, str) or not device.strip():
+            raise ABIValidationError("tensor device must be a non-empty string", field="device")
+        if isinstance(schema_version, bool) or not isinstance(schema_version, int) or schema_version <= 0:
+            raise ABIValidationError("tensor ABI schema version must be a positive integer", field="schema_version")
+        normalized_shape = _normalize_shape(shape, "shape")
+        if strides is None:
+            normalized_strides = _contiguous_strides(normalized_shape)
+        else:
+            normalized_strides = _normalize_shape(strides, "strides")
+            if len(normalized_strides) != len(normalized_shape):
+                raise ABIValidationError("shape and strides must have the same rank", field="strides")
+        object.__setattr__(self, "dtype", _normalize_dtype(dtype))
+        object.__setattr__(self, "shape", normalized_shape)
+        object.__setattr__(self, "strides", normalized_strides)
+        object.__setattr__(self, "device", device.strip().lower())
+        object.__setattr__(self, "address", address)
+        object.__setattr__(self, "handle", handle)
+        object.__setattr__(self, "readonly", bool(readonly))
+        object.__setattr__(self, "schema_version", schema_version)
+
+    @property
+    def read_only(self) -> bool:
+        return self.readonly
+
+    @property
+    def rank(self) -> int:
+        return len(self.shape)
+
+    @property
+    def element_count(self) -> int:
+        result = 1
+        for dimension in self.shape:
+            result *= dimension
+        return result
+
+    @property
+    def nbytes(self) -> Optional[int]:
+        itemsize = _DTYPE_BYTES.get(self.dtype)
+        return None if itemsize is None else self.element_count * itemsize
+
+    @property
+    def storage(self) -> Any:
+        return self.address if self.address is not None else self.handle
+
+    def validate(self, require_storage: bool = False) -> None:
+        if self.schema_version > ABI_SCHEMA_VERSION:
+            raise VersionMismatchError("tensor ABI schema", ABI_SCHEMA_VERSION, self.schema_version)
+        if self.address is not None and self.handle is not None:
+            raise ABIValidationError("tensor descriptor accepts address or handle, not both", field="address/handle")
+        if require_storage and self.address is None and self.handle is None:
+            raise ABIValidationError("tensor descriptor needs address or handle for launch", field="address/handle")
+        if require_storage and self.address == 0 and self.handle is None:
+            raise ABIValidationError("tensor address must not be null", field="address")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate()
+        return {
+            "dtype": self.dtype,
+            "shape": list(self.shape),
+            "strides": list(self.strides),
+            "device": self.device,
+            "readonly": self.readonly,
+            "schema_version": self.schema_version,
+            "has_address": self.address is not None,
+            "has_handle": self.handle is not None,
+        }
+
+
+def _normalize_tensor_sequence(values: Optional[Sequence[TensorDesc]], field: str) -> Tuple[TensorDesc, ...]:
+    if values is None:
+        return ()
+    if isinstance(values, TensorDesc):
+        values = (values,)
+    result = tuple(values)
+    for index, value in enumerate(result):
+        if not isinstance(value, TensorDesc):
+            raise ABIValidationError("{}[{}] must be TensorDesc".format(field, index), field=field)
+    return result
+
+
+@dataclass(frozen=True, init=False)
+class LaunchRequest:
+    """Complete, vendor-neutral invocation request."""
+
+    artifact: Artifact
+    entrypoint: str
+    inputs: Tuple[TensorDesc, ...]
+    outputs: Tuple[TensorDesc, ...]
+    scalars: Any
+    workspace: Any
+    stream_handle: Any
+    schema_version: int
+
+    def __init__(
+        self,
+        artifact: Artifact,
+        entrypoint: Optional[str] = None,
+        inputs: Optional[Sequence[TensorDesc]] = None,
+        outputs: Optional[Sequence[TensorDesc]] = None,
+        scalars: Optional[Mapping[str, Any]] = None,
+        workspace: Any = None,
+        stream_handle: Any = None,
+        *,
+        input_tensors: Optional[Sequence[TensorDesc]] = None,
+        output_tensors: Optional[Sequence[TensorDesc]] = None,
+        stream: Any = None,
+        schema_version: int = ABI_SCHEMA_VERSION
+    ):
+        if not isinstance(artifact, Artifact):
+            raise ABIValidationError("launch artifact must be Artifact", field="artifact")
+        if inputs is not None and input_tensors is not None:
+            raise ValueError("inputs and input_tensors are aliases; pass only one")
+        if outputs is not None and output_tensors is not None:
+            raise ValueError("outputs and output_tensors are aliases; pass only one")
+        if stream_handle is not None and stream is not None:
+            raise ValueError("stream_handle and stream are aliases; pass only one")
+        entrypoint = artifact.entrypoint if entrypoint is None else entrypoint
+        if not isinstance(entrypoint, str) or not entrypoint.strip():
+            raise ABIValidationError("launch entrypoint must be a non-empty string", field="entrypoint")
+        if isinstance(schema_version, bool) or not isinstance(schema_version, int) or schema_version <= 0:
+            raise ABIValidationError("launch ABI schema version must be a positive integer", field="schema_version")
+        if scalars is not None and not isinstance(scalars, Mapping):
+            raise ABIValidationError("launch scalars must be a mapping", field="scalars")
+        object.__setattr__(self, "artifact", artifact)
+        object.__setattr__(self, "entrypoint", entrypoint.strip())
+        object.__setattr__(
+            self,
+            "inputs",
+            _normalize_tensor_sequence(inputs if inputs is not None else input_tensors, "inputs"),
+        )
+        object.__setattr__(
+            self,
+            "outputs",
+            _normalize_tensor_sequence(outputs if outputs is not None else output_tensors, "outputs"),
+        )
+        object.__setattr__(self, "scalars", frozen_mapping(scalars))
+        object.__setattr__(self, "workspace", workspace)
+        object.__setattr__(self, "stream_handle", stream_handle if stream_handle is not None else stream)
+        object.__setattr__(self, "schema_version", schema_version)
+
+    @property
+    def input_tensors(self) -> Tuple[TensorDesc, ...]:
+        return self.inputs
+
+    @property
+    def output_tensors(self) -> Tuple[TensorDesc, ...]:
+        return self.outputs
+
+    @property
+    def stream(self) -> Any:
+        return self.stream_handle
+
+    def validate(self, require_storage: bool = True) -> None:
+        if self.schema_version > ABI_SCHEMA_VERSION:
+            raise VersionMismatchError("launch ABI schema", ABI_SCHEMA_VERSION, self.schema_version)
+        self.artifact.validate(ARTIFACT_FORMAT_VERSION)
+        if self.entrypoint != self.artifact.entrypoint:
+            raise ABIValidationError(
+                "launch entrypoint does not match artifact entrypoint",
+                field="entrypoint",
+                details={"artifact": self.artifact.entrypoint, "request": self.entrypoint},
+            )
+        for descriptor in self.inputs + self.outputs:
+            descriptor.validate(require_storage=require_storage)
+        for index, descriptor in enumerate(self.outputs):
+            if descriptor.readonly:
+                raise ABIValidationError("output tensor {} is marked readonly".format(index), field="outputs")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate(require_storage=False)
+        return {
+            "artifact": self.artifact.cache_key,
+            "entrypoint": self.entrypoint,
+            "schema_version": self.schema_version,
+            "inputs": [descriptor.to_dict() for descriptor in self.inputs],
+            "outputs": [descriptor.to_dict() for descriptor in self.outputs],
+            "scalars": mapping_copy(self.scalars),
+            "workspace_present": self.workspace is not None,
+            "stream_present": self.stream_handle is not None,
+        }
diff --git a/python/pypto/abi/runtime.py b/python/pypto/abi/runtime.py
new file mode 100644
index 000000000..5b2ff3866
--- /dev/null
+++ b/python/pypto/abi/runtime.py
@@ -0,0 +1,179 @@
+"""Runtime backend protocol and structured availability status."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+try:  # Protocol was added to typing in Python 3.8.
+    from typing import Protocol, runtime_checkable
+except ImportError:  # pragma: no cover - exercised only on Python 3.7.
+    class Protocol(object):
+        pass
+
+    def runtime_checkable(cls):
+        return cls
+
+from pypto.target._utils import frozen_mapping, mapping_copy
+from pypto.target.errors import BackendContractError, BackendUnavailableError
+
+from pypto.compiler.artifact import Artifact
+
+from .descriptors import LaunchRequest
+
+
+@dataclass(frozen=True, init=False)
+class Availability:
+    """Structured result explaining why a runtime backend is unavailable."""
+
+    available: bool
+    backend: str
+    reason_code: Optional[str]
+    reason: Optional[str]
+    details: Any
+
+    def __init__(
+        self,
+        available: bool,
+        backend: str,
+        reason_code: Optional[str] = None,
+        reason: Optional[str] = None,
+        details: Optional[Mapping[str, Any]] = None
+    ):
+        if not isinstance(backend, str) or not backend.strip():
+            raise ValueError("availability backend must be a non-empty string")
+        if available and (reason_code is not None or reason is not None):
+            raise ValueError("available backend must not carry an unavailable reason")
+        if not available and not reason:
+            reason = "required runtime resource is unavailable"
+        object.__setattr__(self, "available", bool(available))
+        object.__setattr__(self, "backend", backend.strip())
+        object.__setattr__(self, "reason_code", reason_code)
+        object.__setattr__(self, "reason", reason)
+        object.__setattr__(self, "details", frozen_mapping(details))
+
+    @classmethod
+    def yes(cls, backend: str) -> "Availability":
+        return cls(True, backend)
+
+    @classmethod
+    def no(
+        cls,
+        backend: str,
+        reason: str,
+        reason_code: str = "backend_unavailable",
+        details: Optional[Mapping[str, Any]] = None
+    ) -> "Availability":
+        return cls(False, backend, reason_code, reason, details)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "available": self.available,
+            "backend": self.backend,
+            "reason_code": self.reason_code,
+            "reason": self.reason,
+            "details": mapping_copy(self.details),
+        }
+
+
+@runtime_checkable
+class RuntimeBackend(Protocol):
+    """Minimal runtime ABI shared by CPU/GPU/Ascend adapters."""
+
+    def is_available(self) -> bool:
+        """Return whether the required runtime/device is accessible."""
+
+    def load(self, artifact: Artifact) -> Any:
+        """Load an artifact and return a backend-owned module handle."""
+
+    def workspace_size(self, request: Any) -> int:
+        """Return required workspace bytes for an artifact/request."""
+
+    def launch(self, request: LaunchRequest) -> Any:
+        """Launch a validated request."""
+
+
+def backend_availability(backend: Any) -> Availability:
+    """Obtain structured availability from old and new backend implementations."""
+
+    status = getattr(backend, "availability", None)
+    if callable(status):
+        status = status()
+    if isinstance(status, Availability):
+        return status
+    available = getattr(backend, "is_available", None)
+    if callable(available):
+        available = available()
+    if isinstance(available, bool):
+        name = getattr(backend, "name", backend.__class__.__name__)
+        if available:
+            return Availability.yes(str(name))
+        return Availability.no(str(name), "runtime backend is unavailable")
+    raise BackendContractError("runtime backend must expose is_available() or availability()")
+
+
+def validate_runtime_backend(backend: Any) -> None:
+    availability = getattr(backend, "is_available", None)
+    missing = [
+        name
+        for name in ("is_available", "load", "workspace_size", "launch")
+        if name != "is_available"
+        and not callable(getattr(backend, name, None))
+    ]
+    if not callable(availability) and not isinstance(availability, bool):
+        missing.insert(0, "is_available")
+    if missing:
+        raise BackendContractError("runtime backend is missing required methods: {}".format(", ".join(missing)))
+
+
+def ensure_available(backend: RuntimeBackend) -> Availability:
+    status = backend_availability(backend)
+    if not status.available:
+        raise BackendUnavailableError(
+            status.backend,
+            status.reason or "runtime backend is unavailable",
+            status.reason_code or "backend_unavailable",
+            mapping_copy(status.details),
+        )
+    return status
+
+
+def load_artifact(backend: RuntimeBackend, artifact: Artifact) -> Any:
+    validate_runtime_backend(backend)
+    ensure_available(backend)
+    if not isinstance(artifact, Artifact):
+        raise TypeError("artifact must be an Artifact")
+    artifact.validate()
+    return backend.load(artifact)
+
+
+def launch(backend: RuntimeBackend, request: LaunchRequest) -> Any:
+    validate_runtime_backend(backend)
+    ensure_available(backend)
+    if not isinstance(request, LaunchRequest):
+        raise TypeError("request must be a LaunchRequest")
+    request.validate()
+    return backend.launch(request)
+
+
+class UnavailableRuntimeBackend:
+    """Useful adapter base for hosts without a vendor runtime installed."""
+
+    def __init__(self, name: str, reason: str, reason_code: str = "backend_unavailable", **details):
+        self.name = name
+        self._status = Availability.no(name, reason, reason_code, details)
+
+    def availability(self) -> Availability:
+        return self._status
+
+    def is_available(self) -> bool:
+        return False
+
+    def load(self, artifact: Artifact):
+        ensure_available(self)
+
+    def workspace_size(self, request: Any) -> int:
+        ensure_available(self)
+
+    def launch(self, request: LaunchRequest):
+        ensure_available(self)
