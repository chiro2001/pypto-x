+"""Small in-memory artifact cache used by pure-Python tests and adapters."""
+
+from __future__ import annotations
+
+from typing import Dict, Optional
+
+from pypto.target.cache_key import CacheKey
+
+from .artifact import Artifact
+
+
+def artifact_cache_key(artifact: Artifact) -> CacheKey:
+    return artifact.cache_key
+
+
+class ArtifactCache:
+    """Minimal cache facade; persistent cache policies remain backend-specific."""
+
+    def __init__(self):
+        self._items: Dict[str, Artifact] = {}
+
+    def get(self, key) -> Optional[Artifact]:
+        return self._items.get(str(key))
+
+    def put(self, artifact: Artifact) -> CacheKey:
+        key = artifact.cache_key
+        self._items[str(key)] = artifact
+        return key
+
+    def clear(self) -> None:
+        self._items.clear()
+
+    def __len__(self) -> int:
+        return len(self._items)
