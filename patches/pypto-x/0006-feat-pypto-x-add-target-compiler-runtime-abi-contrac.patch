index 000000000..7013b3182
--- /dev/null
+++ b/python/pypto/target/cache_key.py
@@ -0,0 +1,51 @@
+"""Stable target/cache key helpers."""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+from ._utils import canonical_json, sha256_bytes
+from .spec import TargetSpec
+
+
+class CacheKey(str):
+    """String cache key that can also be called for old method-style users."""
+
+    def __call__(self) -> str:
+        return str(self)
+
+
+def target_cache_key(
+    target: TargetSpec,
+    *,
+    abi_version: str = "1",
+    shape_specialization: Optional[Mapping[str, Any]] = None,
+    extra: Optional[Mapping[str, Any]] = None
+) -> CacheKey:
+    if not isinstance(target, TargetSpec):
+        raise TypeError("target must be a TargetSpec")
+    data = {
+        "kind": "target",
+        "abi_version": str(abi_version),
+        "target": target.to_dict(),
+        "shape_specialization": dict(shape_specialization or {}),
+        "extra": dict(extra or {}),
+    }
+    return CacheKey(hashlib.sha256(canonical_json(data).encode("utf-8")).hexdigest())
+
+
+def content_digest(payload: Optional[bytes] = None, path: Optional[Any] = None) -> str:
+    """Digest payload bytes, or file contents when a path is supplied."""
+
+    if (payload is None) == (path is None):
+        raise ValueError("exactly one of payload and path is required")
+    if payload is not None:
+        if not isinstance(payload, bytes):
+            payload = bytes(payload)
+        return sha256_bytes(payload)
+    file_path = Path(path)
+    if file_path.is_file():
+        return sha256_bytes(file_path.read_bytes())
+    return hashlib.sha256(str(file_path).encode("utf-8")).hexdigest()
diff --git a/python/pypto/target/capabilities.py b/python/pypto/target/capabilities.py
new file mode 100644
index 000000000..f68a53bf5
--- /dev/null
+++ b/python/pypto/target/capabilities.py
@@ -0,0 +1,146 @@
+"""Capability declarations independent of a particular vendor backend."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Tuple
+
+from ._utils import canonical_json, normalize_ints, normalize_names, sha256_text
+from .errors import UnsupportedCapabilityError
+
+
+@dataclass(frozen=True, init=False)
+class CapabilitySet:
+    """Immutable capability set used for feature gating and diagnostics."""
+
+    dtypes: Tuple[str, ...]
+    op_classes: Tuple[str, ...]
+    vector_widths: Tuple[int, ...]
+    matrix_capabilities: Tuple[str, ...]
+    async_copy: Tuple[str, ...]
+
+    def __init__(
+        self,
+        dtypes: Any = (),
+        op_classes: Any = (),
+        vector_widths: Any = (),
+        matrix_capabilities: Any = (),
+        async_copy: Any = (),
+        *,
+        vector: Any = None,
+        matrix: Any = None,
+        async_copy_capabilities: Any = None,
+        op_capabilities: Any = None,
+        vectors: Any = None,
+        async_copies: Any = None
+    ):
+        if op_capabilities is not None and op_classes:
+            raise ValueError("op_capabilities and op_classes are aliases; pass only one")
+        if vectors is not None and vector is not None:
+            raise ValueError("vectors and vector are aliases; pass only one")
+        if async_copies is not None and async_copy_capabilities is not None:
+            raise ValueError("async_copies and async_copy_capabilities are aliases; pass only one")
+        if vector is not None and vector_widths:
+            raise ValueError("vector and vector_widths are aliases; pass only one")
+        if matrix is not None and matrix_capabilities:
+            raise ValueError("matrix and matrix_capabilities are aliases; pass only one")
+        if async_copy_capabilities is not None and async_copy:
+            raise ValueError("async_copy and async_copy_capabilities are aliases; pass only one")
+        object.__setattr__(self, "dtypes", normalize_names(dtypes))
+        object.__setattr__(
+            self,
+            "op_classes",
+            normalize_names(op_capabilities if op_capabilities is not None else op_classes),
+        )
+        object.__setattr__(self, "vector_widths", normalize_ints(
+            vector if vector is not None else (vectors if vectors is not None else vector_widths)
+        ))
+        object.__setattr__(
+            self,
+            "matrix_capabilities",
+            normalize_names(matrix if matrix is not None else matrix_capabilities),
+        )
+        object.__setattr__(
+            self,
+            "async_copy",
+            normalize_names(
+                async_copy_capabilities
+                if async_copy_capabilities is not None
+                else (async_copies if async_copies is not None else async_copy)
+            ),
+        )
+
+    @property
+    def vector(self) -> Tuple[int, ...]:
+        return self.vector_widths
+
+    @property
+    def op_capabilities(self) -> Tuple[str, ...]:
+        return self.op_classes
+
+    @property
+    def matrix(self) -> Tuple[str, ...]:
+        return self.matrix_capabilities
+
+    @property
+    def async_copy_capabilities(self) -> Tuple[str, ...]:
+        return self.async_copy
+
+    @property
+    def async_copies(self) -> Tuple[str, ...]:
+        return self.async_copy
+
+    def supports_dtype(self, dtype: Any) -> bool:
+        return isinstance(dtype, str) and dtype.strip().lower() in self.dtypes
+
+    def supports_op(self, op_class: Any) -> bool:
+        return isinstance(op_class, str) and op_class.strip().lower() in self.op_classes
+
+    def supports_op_class(self, op_class: Any) -> bool:
+        return self.supports_op(op_class)
+
+    def supports_vector(self, width: Any) -> bool:
+        return isinstance(width, int) and not isinstance(width, bool) and width in self.vector_widths
+
+    def supports_vector_width(self, width: Any) -> bool:
+        return self.supports_vector(width)
+
+    def supports_matrix(self, matrix_kind: Any) -> bool:
+        return isinstance(matrix_kind, str) and matrix_kind.strip().lower() in self.matrix_capabilities
+
+    def supports_async_copy(self, mode: Any) -> bool:
+        return isinstance(mode, str) and mode.strip().lower() in self.async_copy
+
+    def supports(self, category: str, value: Any) -> bool:
+        category = category.strip().lower() if isinstance(category, str) else ""
+        if category in ("dtype", "dtypes"):
+            return self.supports_dtype(value)
+        if category in ("op", "op_class", "op_classes"):
+            return self.supports_op(value)
+        if category in ("vector", "vector_width", "vector_widths"):
+            return self.supports_vector(value)
+        if category in ("matrix", "matrix_capability", "matrix_capabilities"):
+            return self.supports_matrix(value)
+        if category in ("async_copy", "async-copy"):
+            return self.supports_async_copy(value)
+        return False
+
+    def require(self, category: str, value: Any, target: Any = None) -> None:
+        if not self.supports(category, value):
+            raise UnsupportedCapabilityError(category, value, target)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "dtypes": list(self.dtypes),
+            "op_classes": list(self.op_classes),
+            "vector_widths": list(self.vector_widths),
+            "matrix_capabilities": list(self.matrix_capabilities),
+            "async_copy": list(self.async_copy),
+        }
+
+    @property
+    def fingerprint(self) -> str:
+        return sha256_text(self.to_dict())
+
+    def __hash__(self) -> int:
+        return hash(canonical_json(self.to_dict()))
diff --git a/python/pypto/target/errors.py b/python/pypto/target/errors.py
new file mode 100644
index 000000000..425f288c1
--- /dev/null
+++ b/python/pypto/target/errors.py
@@ -0,0 +1,81 @@
+"""Structured errors shared by the target and runtime contracts."""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+
+class PyPTOXError(Exception):
+    """Base class for errors raised by the dependency-free ABI layer."""
+
+
+class ValidationError(PyPTOXError, ValueError):
+    """An input does not satisfy a public contract."""
+
+
+class ABIValidationError(ValidationError):
+    """A Tensor/launch/artifact value violates the ABI schema."""
+
+    def __init__(self, message: str, field: Optional[str] = None, details: Optional[Mapping[str, Any]] = None):
+        super().__init__(message)
+        self.field = field
+        self.details = dict(details or {})
+
+
+class VersionMismatchError(ValidationError):
+    """A future or otherwise incompatible ABI/schema version was supplied."""
+
+    def __init__(self, name: str, expected: Any, actual: Any):
+        self.name = name
+        self.expected = expected
+        self.actual = actual
+        super().__init__("{} version {!r} is not supported (expected {!r})".format(name, actual, expected))
+
+
+class RegistryError(PyPTOXError):
+    """Base class for target registry failures."""
+
+
+class DuplicateTargetError(RegistryError):
+    def __init__(self, key: str):
+        self.key = key
+        super().__init__("target key {!r} is already registered".format(key))
+
+
+class TargetNotFoundError(RegistryError, KeyError):
+    def __init__(self, key: str):
+        self.key = key
+        super().__init__("target key {!r} is not registered".format(key))
+
+
+class UnsupportedCapabilityError(PyPTOXError):
+    """The selected target does not advertise a requested capability."""
+
+    def __init__(self, capability: str, value: Any = None, target: Any = None):
+        self.capability = capability
+        self.value = value
+        self.target = target
+        suffix = "" if value is None else "={!r}".format(value)
+        target_suffix = "" if target is None else " for target {!r}".format(target)
+        super().__init__("unsupported capability {}{}{}".format(capability, suffix, target_suffix))
+
+
+class BackendUnavailableError(PyPTOXError, RuntimeError):
+    """A runtime/compiler backend cannot access its required resource."""
+
+    def __init__(
+        self,
+        backend: str,
+        reason: str,
+        code: str = "backend_unavailable",
+        details: Optional[Mapping[str, Any]] = None,
+    ):
+        self.backend = backend
+        self.reason = reason
+        self.code = code
+        self.details = dict(details or {})
+        super().__init__("{}: {} ({})".format(backend, reason, code))
+
+
+class BackendContractError(PyPTOXError, TypeError):
+    """An implementation does not provide the required backend methods."""
