--- /dev/null
+++ b/python/pypto/target/registry.py
@@ -0,0 +1,95 @@
+"""Target factory registry with explicit collision semantics."""
+
+from __future__ import annotations
+
+from typing import Any, Callable, Dict, Optional, Union
+
+from .errors import DuplicateTargetError, TargetNotFoundError
+from .spec import TargetSpec, normalize_target_key
+
+
+TargetFactory = Callable[..., Any]
+
+
+class TargetRegistry:
+    """A small registry that is safe to share between compiler frontends."""
+
+    def __init__(self):
+        self._factories: Dict[str, TargetFactory] = {}
+
+    def register(
+        self,
+        target: Union[str, TargetSpec],
+        factory: Optional[TargetFactory] = None,
+        *,
+        replace: bool = False
+    ):
+        key = normalize_target_key(target)
+
+        def add(item: TargetFactory) -> TargetFactory:
+            if not callable(item):
+                raise TypeError("target factory must be callable")
+            if key in self._factories and not replace:
+                raise DuplicateTargetError(key)
+            self._factories[key] = item
+            return item
+
+        if factory is None:
+            return add
+        return add(factory)
+
+    def unregister(self, target: Union[str, TargetSpec]) -> TargetFactory:
+        key = normalize_target_key(target)
+        try:
+            return self._factories.pop(key)
+        except KeyError:
+            raise TargetNotFoundError(key)
+
+    def get_factory(self, target: Union[str, TargetSpec]) -> TargetFactory:
+        key = normalize_target_key(target)
+        try:
+            return self._factories[key]
+        except KeyError:
+            raise TargetNotFoundError(key)
+
+    def resolve(self, target: Union[str, TargetSpec]) -> TargetFactory:
+        return self.get_factory(target)
+
+    def get(self, target: Union[str, TargetSpec], default: Optional[TargetFactory] = None):
+        try:
+            return self.get_factory(target)
+        except TargetNotFoundError:
+            return default
+
+    def create(self, target: Union[str, TargetSpec], *args, **kwargs):
+        factory = self.get_factory(target)
+        if isinstance(target, TargetSpec):
+            return factory(target, *args, **kwargs)
+        return factory(*args, **kwargs)
+
+    def contains(self, target: Union[str, TargetSpec]) -> bool:
+        return normalize_target_key(target) in self._factories
+
+    def __contains__(self, target: Union[str, TargetSpec]) -> bool:
+        return self.contains(target)
+
+    def __len__(self) -> int:
+        return len(self._factories)
+
+    def keys(self):
+        return tuple(self._factories.keys())
+
+    def clear(self) -> None:
+        self._factories.clear()
+
+
+target_registry = TargetRegistry()
+registry = target_registry
+
+
+def register_target(target: Union[str, TargetSpec], factory: Optional[TargetFactory] = None, *, replace: bool = False):
+    return target_registry.register(target, factory, replace=replace)
+
+
+def get_target_factory(target: Union[str, TargetSpec]) -> TargetFactory:
+    return target_registry.get_factory(target)
diff --git a/python/pypto/target/spec.py b/python/pypto/target/spec.py
new file mode 100644
index 000000000..3bf7cd9ef
--- /dev/null
+++ b/python/pypto/target/spec.py
@@ -0,0 +1,137 @@
+"""Target description for the PyPTO-X public compiler boundary."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Tuple
+
+from ._utils import canonical_json, frozen_mapping, mapping_copy, normalize_names, sha256_text
+
+
+def _coerce_attrs(value: Any, field: str) -> Mapping[str, Any]:
+    if value is None:
+        return frozen_mapping(None)
+    if not isinstance(value, Mapping):
+        raise TypeError("{} must be a mapping".format(field))
+    return frozen_mapping(value)
+
+
+@dataclass(frozen=True, init=False)
+class TargetSpec:
+    """Immutable, normalized description of one compilation target.
+
+    ``kind`` and ``triple`` identify the target family and ABI.  ``features``
+    is normalized case-insensitively but retains declaration order, which
+    makes diagnostics pleasant while still yielding a stable key.
+    """
+
+    kind: str
+    triple: str
+    features: Tuple[str, ...]
+    device: Mapping[str, Any]
+    abi: Mapping[str, Any]
+    attributes: Mapping[str, Any]
+
+    def __init__(
+        self,
+        kind: Optional[str] = None,
+        triple: Optional[str] = None,
+        features: Any = (),
+        device: Optional[Mapping[str, Any]] = None,
+        abi: Optional[Mapping[str, Any]] = None,
+        attributes: Optional[Mapping[str, Any]] = None,
+        *,
+        device_kind: Optional[str] = None,
+        device_attributes: Optional[Mapping[str, Any]] = None,
+        abi_attributes: Optional[Mapping[str, Any]] = None,
+        device_attrs: Optional[Mapping[str, Any]] = None,
+        abi_attrs: Optional[Mapping[str, Any]] = None
+    ):
+        if kind is None:
+            kind = device_kind
+        if not isinstance(kind, str) or not kind.strip():
+            raise ValueError("target kind/device_kind must be a non-empty string")
+        if not isinstance(triple, str) or not triple.strip():
+            raise ValueError("target triple must be a non-empty string")
+        device_aliases = [value for value in (device_attributes, device_attrs) if value is not None]
+        abi_aliases = [value for value in (abi_attributes, abi_attrs) if value is not None]
+        if device is not None and device_aliases:
+            raise ValueError("device and device attribute aliases; pass only one")
+        if len(device_aliases) > 1:
+            raise ValueError("device_attributes and device_attrs are aliases; pass only one")
+        if abi is not None and abi_aliases:
+            raise ValueError("abi and abi attribute aliases; pass only one")
+        if len(abi_aliases) > 1:
+            raise ValueError("abi_attributes and abi_attrs are aliases; pass only one")
+        object.__setattr__(self, "kind", kind.strip().lower())
+        object.__setattr__(self, "triple", triple.strip().lower())
+        object.__setattr__(self, "features", normalize_names(features))
+        object.__setattr__(
+            self,
+            "device",
+            _coerce_attrs(device if device is not None else (device_aliases[0] if device_aliases else None), "device"),
+        )
+        object.__setattr__(
+            self,
+            "abi",
+            _coerce_attrs(abi if abi is not None else (abi_aliases[0] if abi_aliases else None), "abi"),
+        )
+        object.__setattr__(self, "attributes", _coerce_attrs(attributes, "attributes"))
+
+    @property
+    def device_kind(self) -> str:
+        """Compatibility spelling used by the architecture design notes."""
+
+        return self.kind
+
+    @property
+    def key(self) -> str:
+        feature_suffix = "" if not self.features else "+" + "+".join(self.features)
+        return "{}:{}{}".format(self.kind, self.triple, feature_suffix)
+
+    @property
+    def target_key(self) -> str:
+        return self.key
+
+    @property
+    def fingerprint(self) -> str:
+        return sha256_text(self.to_dict())
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "kind": self.kind,
+            "triple": self.triple,
+            "features": list(self.features),
+            "device": mapping_copy(self.device),
+            "abi": mapping_copy(self.abi),
+            "attributes": mapping_copy(self.attributes),
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "TargetSpec":
+        if not isinstance(value, Mapping):
+            raise TypeError("target spec must be a mapping")
+        return cls(
+            kind=value.get("kind", value.get("device_kind")),
+            triple=value.get("triple"),
+            features=value.get("features", ()),
+            device=value.get("device"),
+            abi=value.get("abi"),
+            attributes=value.get("attributes"),
+        )
+
+    def __hash__(self) -> int:
+        return hash(canonical_json(self.to_dict()))
+
+
+def normalize_target_key(value: Any) -> str:
+    """Normalize a registry key without losing target feature information."""
+
+    if isinstance(value, TargetSpec):
+        return value.key
+    if not isinstance(value, str):
+        raise TypeError("target registry keys must be strings or TargetSpec values")
+    key = value.strip().lower()
+    if not key:
+        raise ValueError("target registry key must not be empty")
+    return key
