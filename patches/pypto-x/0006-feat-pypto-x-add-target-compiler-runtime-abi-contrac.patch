diff --git a/python/pypto/target/_utils.py b/python/pypto/target/_utils.py
new file mode 100644
index 000000000..1b4d4abd9
--- /dev/null
+++ b/python/pypto/target/_utils.py
@@ -0,0 +1,194 @@
+"""Small, dependency-free helpers shared by the PyPTO-X target contracts.
+
+The target ABI is deliberately usable before the native PyPTO extension is
+installed.  This module therefore only depends on the Python standard
+library.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import math
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any, Dict, Tuple
+
+
+class FrozenMapping(Mapping):
+    """Small immutable mapping with deterministic insertion order."""
+
+    __slots__ = ("_items", "_values")
+
+    def __init__(self, items=()):
+        normalized = tuple(items)
+        self._items = normalized
+        self._values = dict(normalized)
+
+    def __getitem__(self, key):
+        return self._values[key]
+
+    def __iter__(self):
+        return (key for key, _ in self._items)
+
+    def __len__(self):
+        return len(self._items)
+
+    def __hash__(self):
+        return hash(self._items)
+
+    def __repr__(self):
+        return "FrozenMapping({!r})".format(dict(self._items))
+
+
+def normalize_names(values: Any) -> Tuple[str, ...]:
+    """Return stable, case-insensitive, insertion-order-preserving names."""
+
+    if values is None:
+        return ()
+    if isinstance(values, str):
+        values = (values,)
+    result = []
+    seen = set()
+    for value in values:
+        if not isinstance(value, str):
+            raise TypeError("feature and capability names must be strings")
+        name = value.strip().lower()
+        if not name:
+            raise ValueError("feature and capability names must not be empty")
+        if name not in seen:
+            seen.add(name)
+            result.append(name)
+    return tuple(result)
+
+
+def normalize_ints(values: Any) -> Tuple[int, ...]:
+    """Normalize integer capability values while retaining first-seen order."""
+
+    if values is None:
+        return ()
+    if isinstance(values, int) and not isinstance(values, bool):
+        values = (values,)
+    result = []
+    seen = set()
+    for value in values:
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError("vector widths and subgroup sizes must be integers")
+        if value <= 0:
+            raise ValueError("vector widths and subgroup sizes must be positive")
+        if value not in seen:
+            seen.add(value)
+            result.append(value)
+    return tuple(result)
+
+
+def _stable_sort_key(value: Any) -> str:
+    return canonical_json(value)
+
+
+def freeze_value(value: Any) -> Any:
+    """Recursively turn common containers into immutable containers.
+
+    MappingProxyType is intentionally avoided here: it is not available as a
+    useful JSON value on every supported Python version and nested mapping
+    equality is less convenient for callers.  The public objects expose
+    normal ``to_dict`` copies, while their internal metadata is represented
+    by tuples.
+    """
+
+    if isinstance(value, Mapping):
+        items = []
+        for key, item in value.items():
+            if not isinstance(key, str):
+                raise TypeError("metadata and attributes must use string keys")
+            items.append((key, freeze_value(item)))
+        items.sort(key=lambda pair: pair[0])
+        return FrozenMapping(items)
+    if isinstance(value, (tuple, list)):
+        return tuple(freeze_value(item) for item in value)
+    if isinstance(value, (set, frozenset)):
+        items = [freeze_value(item) for item in value]
+        return tuple(sorted(items, key=_stable_sort_key))
+    if isinstance(value, Path):
+        return str(value)
+    if isinstance(value, (str, int, bool)) or value is None:
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("metadata and attributes must not contain NaN or infinity")
+        return value
+    if isinstance(value, bytes):
+        return value
+    raise TypeError("value of type {!r} is not stable ABI metadata".format(type(value).__name__))
+
+
+def thaw_value(value: Any) -> Any:
+    """Convert the internal immutable representation to JSON-like values."""
+
+    if isinstance(value, FrozenMapping):
+        return {key: thaw_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [thaw_value(item) for item in value]
+    if isinstance(value, bytes):
+        return {"__bytes__": base64.b64encode(value).decode("ascii")}
+    return value
+
+
+def canonical_data(value: Any) -> Any:
+    """Build JSON-compatible data with deterministic map/set ordering."""
+
+    if isinstance(value, Mapping):
+        return {str(key): canonical_data(item) for key, item in sorted(value.items(), key=lambda pair: str(pair[0]))}
+    if isinstance(value, FrozenMapping):
+        return {key: canonical_data(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [canonical_data(item) for item in value]
+    if isinstance(value, list):
+        return [canonical_data(item) for item in value]
+    if isinstance(value, (str, int, bool)) or value is None:
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("canonical data must not contain NaN or infinity")
+        return value
+    if isinstance(value, bytes):
+        return {"__bytes__": base64.b64encode(value).decode("ascii")}
+    if isinstance(value, Path):
+        return str(value)
+    raise TypeError("value of type {!r} is not canonical JSON data".format(type(value).__name__))
+
+
+def canonical_json(value: Any) -> str:
+    """Serialize a value in the canonical JSON form used by cache keys."""
+
+    return json.dumps(
+        canonical_data(value),
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+
+
+def sha256_text(value: Any) -> str:
+    return hashlib.sha256(canonical_json(value).encode("utf-8")).hexdigest()
+
+
+def sha256_bytes(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def frozen_mapping(value: Any) -> FrozenMapping:
+    if value is None:
+        return FrozenMapping()
+    if not isinstance(value, Mapping):
+        raise TypeError("attributes and metadata must be mappings")
+    frozen = freeze_value(value)
+    if not isinstance(frozen, FrozenMapping):
+        raise TypeError("attributes and metadata must be mappings")
+    return frozen
+
+
+def mapping_copy(value: FrozenMapping) -> Dict[str, Any]:
+    return {key: thaw_value(item) for key, item in value.items()}
