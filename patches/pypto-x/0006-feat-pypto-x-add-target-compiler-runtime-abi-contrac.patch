new file mode 100644
index 000000000..f7245ad7d
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_target_abi.py
@@ -0,0 +1,177 @@
+"""Unit tests for the W1 target/compiler/runtime contracts.
+
+The fallback import path is only for a source checkout without the native
+PyPTO package metadata.  It deliberately loads the new modules as a normal
+``pypto`` package and never imports CANN, CUDA, ROCm, or model code.
+"""
+
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+
+def _import_contracts():
+    try:
+        from pypto.abi import (  # type: ignore
+            LaunchRequest,
+            TensorDesc,
+            UnavailableRuntimeBackend,
+            ensure_available,
+        )
+        from pypto.compiler import Artifact, CompilerBackend, compile_program
+        from pypto.target import (
+            ABIValidationError,
+            BackendUnavailableError,
+            CapabilitySet,
+            DuplicateTargetError,
+            TargetRegistry,
+            TargetSpec,
+            VersionMismatchError,
+        )
+        return locals()
+    except (ImportError, LookupError, RuntimeError):
+        # ``pypto.__init__`` needs native package metadata in the upstream
+        # source checkout.  The W1 modules themselves have no such dependency.
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        package = types.ModuleType("pypto")
+        package.__path__ = [str(Path(__file__).parents[3] / "pypto")]
+        sys.modules["pypto"] = package
+        from pypto.abi import LaunchRequest, TensorDesc, UnavailableRuntimeBackend, ensure_available
+        from pypto.compiler import Artifact, CompilerBackend, compile_program
+        from pypto.target import (
+            ABIValidationError,
+            BackendUnavailableError,
+            CapabilitySet,
+            DuplicateTargetError,
+            TargetRegistry,
+            TargetSpec,
+            VersionMismatchError,
+        )
+        return locals()
+
+
+_C = _import_contracts()
+Artifact = _C["Artifact"]
+CompilerBackend = _C["CompilerBackend"]
+compile_program = _C["compile_program"]
+LaunchRequest = _C["LaunchRequest"]
+TensorDesc = _C["TensorDesc"]
+UnavailableRuntimeBackend = _C["UnavailableRuntimeBackend"]
+ensure_available = _C["ensure_available"]
+ABIValidationError = _C["ABIValidationError"]
+BackendUnavailableError = _C["BackendUnavailableError"]
+CapabilitySet = _C["CapabilitySet"]
+DuplicateTargetError = _C["DuplicateTargetError"]
+TargetRegistry = _C["TargetRegistry"]
+TargetSpec = _C["TargetSpec"]
+VersionMismatchError = _C["VersionMismatchError"]
+
+
+def _target():
+    return TargetSpec("CPU", "x86_64-linux-gnu", ["AVX2", "avx2"], device={"id": 0})
+
+
+def test_target_and_capabilities_are_normalized_and_immutable():
+    target = _target()
+    assert target.kind == "cpu"
+    assert target.features == ("avx2",)
+    assert target.device == {"id": 0}
+    assert target.to_dict()["device"] == {"id": 0}
+    with pytest.raises((AttributeError, TypeError)):
+        target.features += ("avx512",)
+
+    capabilities = CapabilitySet(
+        dtypes=["BF16", "bf16"],
+        op_classes=["matmul"],
+        vector_widths=[256, 256],
+    )
+    assert capabilities.supports_dtype("bf16")
+    assert capabilities.supports_op("MATMUL")
+    assert capabilities.supports_vector(256)
+    assert not capabilities.supports_dtype("fp8")
+    assert not capabilities.supports("unknown", "anything")
+
+
+def test_registry_rejects_collision_and_allows_explicit_replace():
+    registry = TargetRegistry()
+    first = object()
+    second = object()
+    registry.register("CPU:X86", lambda: first)
+    with pytest.raises(DuplicateTargetError):
+        registry.register("cpu:x86", lambda: second)
+    registry.register("cpu:x86", lambda: second, replace=True)
+    assert registry.create("CPU:X86") is second
+
+
+def test_artifact_cache_key_is_content_and_target_sensitive():
+    target = _target()
+    artifact = Artifact(format="python", entrypoint="main", target=target, payload=b"one")
+    same = Artifact(format="python", entrypoint="main", target=target, payload=b"one")
+    changed = Artifact(format="python", entrypoint="main", target=target, payload=b"two")
+    assert artifact.cache_key == same.cache_key
+    assert artifact.cache_key() == artifact.cache_key
+    assert artifact.cache_key != changed.cache_key
+    future = Artifact(format="python", entrypoint="main", target=target, payload=b"one", format_version=2)
+    with pytest.raises(VersionMismatchError):
+        future.validate()
+    future_abi = Artifact(format="python", entrypoint="main", target=target, payload=b"one", abi_version="2")
+    with pytest.raises(VersionMismatchError):
+        future_abi.validate()
+    with pytest.raises(ABIValidationError):
+        Artifact(format="python", entrypoint="main", target=target)
+    with pytest.raises(ABIValidationError):
+        Artifact(format="python", entrypoint="main", target=target, payload=b"x", path="kernel.bin")
+
+
+def test_compiler_protocol_runs_lower_then_compile():
+    target = _target()
+
+    class Backend:
+        def lower(self, program, target_spec):
+            return (program, target_spec.key)
+
+        def compile(self, target_ir, options=None):
+            return Artifact(format="python", entrypoint="main", target=target, payload=repr(target_ir).encode())
+
+    artifact = compile_program(Backend(), "program", target)
+    assert artifact.entrypoint == "main"
+    assert isinstance(Backend(), CompilerBackend)
+
+
+def test_launch_request_validates_storage_and_readonly_outputs():
+    artifact = Artifact(format="python", entrypoint="main", target=_target(), payload=b"kernel")
+    with pytest.raises(ABIValidationError):
+        LaunchRequest(artifact, inputs=[TensorDesc("bf16", (2, 2))], outputs=[]).validate()
+
+    inputs = [TensorDesc("bf16", (2, 2), address=11, readonly=True)]
+    outputs = [TensorDesc("bf16", (2, 2), handle="out")]
+    request = LaunchRequest(artifact, inputs=inputs, outputs=outputs)
+    request.validate()
+    assert request.to_dict()["inputs"][0]["has_address"]
+
+    readonly_output = LaunchRequest(
+        artifact,
+        outputs=[TensorDesc("bf16", (2, 2), address=12, readonly=True)],
+    )
+    with pytest.raises(ABIValidationError):
+        readonly_output.validate()
+
+    future_schema = LaunchRequest(artifact, schema_version=2)
+    with pytest.raises(VersionMismatchError):
+        future_schema.validate(require_storage=False)
+
+
+def test_unavailable_runtime_has_structured_reason():
+    backend = UnavailableRuntimeBackend("cuda", "CUDA runtime is not installed", "missing_runtime")
+    status = backend.availability()
+    assert not status.available
+    assert status.reason_code == "missing_runtime"
+    with pytest.raises(BackendUnavailableError) as error:
+        ensure_available(backend)
+    assert error.value.code == "missing_runtime"
