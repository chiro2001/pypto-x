diff --git a/python/pypto/compiler/api.py b/python/pypto/compiler/api.py
new file mode 100644
index 000000000..0ccf4dfb7
--- /dev/null
+++ b/python/pypto/compiler/api.py
@@ -0,0 +1,95 @@
+"""Compiler backend protocol for the target-independent Core IR boundary."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+try:  # Protocol was added to typing in Python 3.8.
+    from typing import Protocol, runtime_checkable
+except ImportError:  # pragma: no cover - exercised only on Python 3.7.
+    class Protocol(object):
+        pass
+
+    def runtime_checkable(cls):
+        return cls
+
+from pypto.target._utils import frozen_mapping, mapping_copy
+from pypto.target.errors import BackendContractError
+from pypto.target.spec import TargetSpec
+
+from .artifact import ABI_VERSION, Artifact
+
+
+@dataclass(frozen=True, init=False)
+class CompileOptions:
+    """Stable compiler options passed to a target backend.
+
+    Options are intentionally opaque to the common ABI.  Backends may add
+    target-specific data under ``extra`` without exposing vendor descriptors
+    through the public Tensor/Runtime ABI.
+    """
+
+    artifact_format: str
+    abi_version: str
+    metadata: Any
+    extra: Any
+
+    def __init__(
+        self,
+        artifact_format: str = "python",
+        abi_version: str = ABI_VERSION,
+        metadata: Optional[Mapping[str, Any]] = None,
+        extra: Optional[Mapping[str, Any]] = None
+    ):
+        if not isinstance(artifact_format, str) or not artifact_format.strip():
+            raise ValueError("artifact_format must be a non-empty string")
+        if not isinstance(abi_version, str) or not abi_version.strip():
+            raise ValueError("abi_version must be a non-empty string")
+        object.__setattr__(self, "artifact_format", artifact_format.strip().lower())
+        object.__setattr__(self, "abi_version", abi_version.strip())
+        object.__setattr__(self, "metadata", frozen_mapping(metadata))
+        object.__setattr__(self, "extra", frozen_mapping(extra))
+
+    def to_dict(self):
+        return {
+            "artifact_format": self.artifact_format,
+            "abi_version": self.abi_version,
+            "metadata": mapping_copy(self.metadata),
+            "extra": mapping_copy(self.extra),
+        }
+
+
+@runtime_checkable
+class CompilerBackend(Protocol):
+    """Minimal compiler contract shared by CPU/GPU/Ascend adapters."""
+
+    def lower(self, program: Any, target: TargetSpec) -> Any:
+        """Lower one target-independent program to target IR."""
+
+    def compile(self, target_ir: Any, options: Optional[CompileOptions] = None) -> Artifact:
+        """Compile target IR into an immutable artifact."""
+
+
+def validate_compiler_backend(backend: Any) -> None:
+    missing = [name for name in ("lower", "compile") if not callable(getattr(backend, name, None))]
+    if missing:
+        raise BackendContractError("compiler backend is missing required methods: {}".format(", ".join(missing)))
+
+
+def compile_program(
+    backend: CompilerBackend,
+    program: Any,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None
+) -> Artifact:
+    """Run the two-stage compiler contract with basic result validation."""
+
+    validate_compiler_backend(backend)
+    if not isinstance(target, TargetSpec):
+        raise TypeError("target must be a TargetSpec")
+    target_ir = backend.lower(program, target)
+    artifact = backend.compile(target_ir, options)
+    if not isinstance(artifact, Artifact):
+        raise BackendContractError("compiler backend compile() must return Artifact")
+    return artifact
diff --git a/python/pypto/compiler/artifact.py b/python/pypto/compiler/artifact.py
new file mode 100644
index 000000000..994a0fe7a
--- /dev/null
+++ b/python/pypto/compiler/artifact.py
@@ -0,0 +1,142 @@
+"""Compiled artifact value object and stable cache identity."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Optional
+
+from pypto.target._utils import frozen_mapping, mapping_copy, sha256_bytes, sha256_text
+from pypto.target.cache_key import CacheKey
+from pypto.target.errors import ABIValidationError, VersionMismatchError
+from pypto.target.spec import TargetSpec
+
+
+ARTIFACT_FORMAT_VERSION = 1
+ABI_VERSION = "1"
+
+
+@dataclass(frozen=True, init=False)
+class Artifact:
+    """A target-specific compiled payload or an on-disk compiled artifact.
+
+    Exactly one of ``payload`` and ``path`` is retained.  The object is
+    immutable so it can safely be used as a cache value and passed to a
+    runtime backend without the compiler changing its identity underneath it.
+    """
+
+    format: str
+    entrypoint: str
+    payload: Optional[bytes]
+    path: Optional[str]
+    target: TargetSpec
+    abi_version: str
+    metadata: Any
+    format_version: int
+
+    def __init__(
+        self,
+        format: Optional[str] = None,
+        entrypoint: Optional[str] = None,
+        target: Optional[TargetSpec] = None,
+        abi_version: str = ABI_VERSION,
+        payload: Optional[bytes] = None,
+        path: Optional[Any] = None,
+        metadata: Optional[Mapping[str, Any]] = None,
+        format_version: int = ARTIFACT_FORMAT_VERSION,
+        *,
+        artifact_format: Optional[str] = None
+    ):
+        if format is not None and artifact_format is not None:
+            raise ValueError("format and artifact_format are aliases; pass only one")
+        format = format if format is not None else artifact_format
+        if not isinstance(format, str) or not format.strip():
+            raise ABIValidationError("artifact format must be a non-empty string", field="format")
+        if not isinstance(entrypoint, str) or not entrypoint.strip():
+            raise ABIValidationError("artifact entrypoint must be a non-empty string", field="entrypoint")
+        if not isinstance(target, TargetSpec):
+            raise ABIValidationError("artifact target must be a TargetSpec", field="target")
+        if not isinstance(abi_version, str) or not abi_version.strip():
+            raise ABIValidationError("artifact ABI version must be a non-empty string", field="abi_version")
+        if isinstance(format_version, bool) or not isinstance(format_version, int) or format_version <= 0:
+            raise ABIValidationError("artifact format version must be a positive integer", field="format_version")
+        if (payload is None) == (path is None):
+            raise ABIValidationError(
+                "exactly one of artifact payload and path must be supplied",
+                field="payload/path",
+            )
+        if payload is not None:
+            if not isinstance(payload, (bytes, bytearray, memoryview)):
+                raise ABIValidationError("artifact payload must be bytes-like", field="payload")
+            payload = bytes(payload)
+        else:
+            try:
+                path = str(Path(path))
+            except (TypeError, ValueError) as exc:
+                raise ABIValidationError("artifact path must be path-like", field="path") from exc
+            if not path:
+                raise ABIValidationError("artifact path must not be empty", field="path")
+        object.__setattr__(self, "format", format.strip().lower())
+        object.__setattr__(self, "entrypoint", entrypoint.strip())
+        object.__setattr__(self, "target", target)
+        object.__setattr__(self, "abi_version", abi_version.strip())
+        object.__setattr__(self, "payload", payload)
+        object.__setattr__(self, "path", path)
+        object.__setattr__(self, "metadata", frozen_mapping(metadata))
+        object.__setattr__(self, "format_version", format_version)
+
+    @property
+    def artifact_format(self) -> str:
+        return self.format
+
+    @property
+    def content_digest(self) -> str:
+        if self.payload is not None:
+            return sha256_bytes(self.payload)
+        artifact_path = Path(self.path)
+        if artifact_path.is_file():
+            return sha256_bytes(artifact_path.read_bytes())
+        # A missing path remains a useful diagnostic artifact, but its cache
+        # identity is based on the path string until the compiler materializes it.
+        return sha256_text({"missing_path": self.path})
+
+    @property
+    def cache_key(self) -> CacheKey:
+        data = {
+            "artifact_format": self.format,
+            "format_version": self.format_version,
+            "entrypoint": self.entrypoint,
+            "target": self.target.to_dict(),
+            "abi_version": self.abi_version,
+            "metadata": mapping_copy(self.metadata),
+            "content_digest": self.content_digest,
+        }
+        return CacheKey(sha256_text(data))
+
+    @property
+    def key(self) -> CacheKey:
+        return self.cache_key
+
+    def validate(
+        self,
+        supported_format_version: int = ARTIFACT_FORMAT_VERSION,
+        supported_abi_version: str = ABI_VERSION
+    ) -> None:
+        if self.format_version > supported_format_version:
+            raise VersionMismatchError("artifact format", supported_format_version, self.format_version)
+        if self.abi_version != supported_abi_version:
+            raise VersionMismatchError("artifact ABI", supported_abi_version, self.abi_version)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate()
+        return {
+            "format": self.format,
+            "format_version": self.format_version,
+            "entrypoint": self.entrypoint,
+            "target": self.target.to_dict(),
+            "abi_version": self.abi_version,
+            "metadata": mapping_copy(self.metadata),
+            "content_digest": self.content_digest,
+            "payload_present": self.payload is not None,
+            "path": self.path,
+        }
