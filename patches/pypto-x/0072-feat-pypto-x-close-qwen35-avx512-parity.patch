+__attribute__((visibility("default")))
+void ptx_avx512_reduce_mean_f32(const float *input, float *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16];
+    __m512 accumulator = _mm512_setzero_ps();
+    if (n == 0) return;
+    for (; i + 16 <= n; i += 16)
+        accumulator = _mm512_add_ps(accumulator, _mm512_loadu_ps(input + i));
+    if (i < n) {
+        __mmask16 mask = (__mmask16)((1U << (n - i)) - 1U);
+        accumulator = _mm512_add_ps(accumulator, _mm512_maskz_loadu_ps(mask, input + i));
+    }
+    _mm512_storeu_ps(values, accumulator);
+    *output = 0.0f;
+    for (lane = 0; lane < 16; ++lane) *output += values[lane];
+    *output /= (float)n;
+}
