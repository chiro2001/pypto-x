+/* These are intentionally scalar libm lanes.  They are a correctness
+ * fallback for transcendental Core ops, and are recorded as such in the
+ * artifact metadata; they must not be mistaken for a fused ZMM math path. */
+__attribute__((visibility("default")))
+void ptx_avx512_math_f32(int operation, const float *input, float *output, size_t n) {
+    size_t i;
+    for (i = 0; i < n; ++i) output[i] = ptx_avx512_math_scalar(operation, input[i]);
+}
+
+__attribute__((visibility("default")))
