+def _reference_operation(
+    operation: Operation,
+    plan: Any,
+    inputs: Sequence[_RuntimeValue],
+    context: str,
+) -> Dict[str, _RuntimeValue]:
+    """Execute one portable operation through the shared vector reference.
+
+    AVX-512 keeps native ZMM/opmask execution for the FP32/BF16 hot core, but
+    layout/indexing/control and mixed-dtype operations deliberately use the
+    exact vector-common semantic reference until a target-owned emitting ABI
+    exists.  The fallback is reflected in artifact metadata and never invokes
+    an AVX2 object implicitly.
+    """
+
+    environment: Dict[str, Any] = {}
+    for ref, value in zip(operation.inputs, inputs):
+        raw = _buffer_values(value.buffer)
+        data = raw[0] if _is_scalar(ref.type) else raw
+        environment[ref.name] = _vector_runtime._RuntimeValue(ref.type, data)
+    try:
+        _vector_runtime._execute_operation(operation, plan, environment, context)
+    except Exception as exc:
+        if isinstance(exc, CpuAvx512ExecutionError):
+            raise
+        raise CpuAvx512ExecutionError("{} reference fallback failed: {}".format(context, exc)) from exc
+    results: Dict[str, _RuntimeValue] = {}
+    for output_ref in operation.outputs:
+        if output_ref.name not in environment:
+            raise CpuAvx512ExecutionError(
+                "{} reference fallback did not produce {!r}".format(context, output_ref.name)
+            )
+        value = environment[output_ref.name]
+        data = value.data if isinstance(value.data, list) else [value.data]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        results[output_ref.name] = _RuntimeValue(
+            output_ref.type,
+            _buffer_from_values(dtype, data, "{}.{}".format(context, output_ref.name)),
+        )
+    return results
+
