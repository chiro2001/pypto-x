+static inline float ptx_avx512_math_scalar(int operation, float value) {
+    if (operation == 0) return expf(value);
+    if (operation == 1) {
+        if (isnan(value) || value < 0.0f) return NAN;
+        if (value == 0.0f) return INFINITY;
+        return 1.0f / sqrtf(value);
+    }
+    if (operation == 2) {
+        if (value >= 0.0f) return 1.0f / (1.0f + expf(-value));
+        {
+            float exponent = expf(value);
+            return exponent / (1.0f + exponent);
+        }
+    }
+    if (operation == 3) {
+        if (value == -INFINITY) return 0.0f;
+        if (value == INFINITY) return value;
+        return value * ptx_avx512_math_scalar(2, value);
+    }
+    if (operation == 4) return log1pf(expf(-fabsf(value))) + fmaxf(value, 0.0f);
+    return NAN;
+}
