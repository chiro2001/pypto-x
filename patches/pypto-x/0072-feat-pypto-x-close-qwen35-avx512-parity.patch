+"""Qwen3.5 portable-subset parity for the AVX-512 backend.
+
+All tensors in this file are synthetic; no checkpoint or model loader is used.
+The test intentionally checks both the native ZMM core and the explicit
+host-reference/scalar-lane boundary recorded in the artifact.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.x86 import Avx512Runtime, CpuAvx512ExecutionError
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35 import (
+    build_attention_subgraph,
+    build_batched_matmul,
+    build_causal_conv1d_state,
+    build_decoder_subgraph,
+    build_qwen35_gdr_recurrent_state,
+    build_qwen35_position_control,
+    build_rms_norm,
+    build_stable_softmax,
+    build_swiglu,
+)
+from pypto.target import TargetSpec
+
+
+AVX512_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    features=("avx512f",),
+    attributes={"lane_count": 16},
+)
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+
+
+def _runtime():
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _compile_avx512(program: CoreProgram, tmp_path: Path):
+    compiler = Avx512Compiler()
+    return compiler.compile(
+        compiler.lower(program, AVX512_TARGET),
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx512",
+            extra={"build_dir": str(tmp_path / "avx512")},
+        ),
+    )
+
+
+def _compile_scalar(program: CoreProgram):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _launch(artifact, inputs, outputs, *, runtime, scalars=None):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+            scalars=scalars or {},
+        )
+    )
+
+
+def _assert_close(left, right, tolerance=3.0e-5):
+    assert len(left) == len(right)
+    for actual, expected in zip(left, right):
+        assert abs(float(actual) - float(expected)) <= tolerance + tolerance * abs(float(expected))
+
+
+def test_avx512_position_softmax_and_batched_matmul_parity(tmp_path):
+    runtime = _runtime()
+    position = build_qwen35_position_control(1, 3, past_length=2, index_dtype="int32")
+    avx_position = _compile_avx512(position, tmp_path / "position")
+    scalar_position = _compile_scalar(position)
+    avx_outputs = [HostTensor("int32", (1, 3)), HostTensor("bool", (1, 8, 3, 5))]
+    scalar_outputs = [HostTensor("int32", (1, 3)), HostTensor("bool", (1, 8, 3, 5))]
+    _launch(avx_position, [], avx_outputs, runtime=runtime)
+    _launch(scalar_position, [], scalar_outputs, runtime=CpuScalarRuntime())
+    assert avx_outputs[0].flat() == scalar_outputs[0].flat() == (2, 3, 4)
+    assert avx_outputs[1].flat() == scalar_outputs[1].flat()
+    assert all(plan.iteration.compact for plan in Avx512Compiler().lower(position, AVX512_TARGET).plans)
+    assert avx_position.metadata["position_control_fallback"] == "host_reference"
+    assert avx_position.metadata["native_operations"] == ()
+
+    softmax = build_stable_softmax((2, 17), "float32")
+    avx_softmax = _compile_avx512(softmax, tmp_path / "softmax")
+    scalar_softmax = _compile_scalar(softmax)
