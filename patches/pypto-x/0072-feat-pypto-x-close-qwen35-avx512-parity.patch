+        elif name == "matmul" and plan.matmul is not None and plan.matmul.batch_shape:
+            mode = "host_batch_loop_rank2_native"
+        elif name in (
+            "identity", "add", "sub", "mul", "div", "neg",
+            "reduce_sum", "reduce_max", "reduce_mean", "matmul",
