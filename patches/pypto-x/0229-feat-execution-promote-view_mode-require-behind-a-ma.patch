+def test_adversarial_output_input_alias_is_rejected_not_silently_written():
+    left = HostTensor("float32", (2, 4), [float(index + 1) for index in range(8)])
+    right = HostTensor("float32", (4, 4), [0.5] * 16)
+    before = list(left.data)
+    # The output shape matches the left operand, so the shape validation passes
+    # and the runtime alias check is the gate that must reject it.
+    with pytest.raises(Exception) as excinfo:
+        execute_matmul(left, right, output=left)
+    error = excinfo.value
+    assert error.code == OP_CONTRACT_INVALID
+    assert error.reason == "output_input_alias"
+    # The input bytes were not overwritten by a partially executed kernel.
+    assert list(left.data) == before
+
