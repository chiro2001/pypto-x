+def test_u1_report_carries_the_recomputable_alias_decision():
+    left = HostTensor("float32", (2, 4), [float(index + 1) for index in range(8)])
+    right = HostTensor("float32", (4, 4), [0.5] * 16)
+    output, report = execute_matmul(
+        left,
+        right,
+        policy=ExecutionPolicy(layout=LayoutPolicy(view_mode="prefer")),
+    )
+    document = report.to_dict()
+    layout = document["layout_decision"]
+    assert layout["requested_view_mode"] == "prefer"
+    assert layout["resolved_view_mode"] == "not_applicable"
+    assert layout["view_obligation"] == "must_not_alias"
+    assert layout["alias_check"] == "verified_distinct"
+    assert layout["alias_proof"]["status"] == "not_applicable"
+    assert layout["alias_proof_digest"] == layout["alias_proof"]["digest"]
+    assert layout["layout_copy_bytes"] == 0
+    # Rebuilding the policy from its own report reproduces the same plan.
+    requested = policy_from_dict(document["requested_policy"])
+    assert requested.layout.view_mode == "prefer"
+    assert plan_matmul((2, 4), (4, 4), "float32", policy=requested).plan.digest == report.plan_digest
+
