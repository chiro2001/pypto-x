+    if condition not in PROOF_CONDITIONS:
+        raise ValueError("unknown proof condition {!r}".format(condition))
+    conditions = tuple(
+        proof_condition(
+            name,
+            "failed" if name == condition else "not_applicable",
+            code if name == condition else NO_VIEW_OBLIGATION,
+            reason if name == condition else "not evaluated: {} failed first".format(condition),
+            evidence if name == condition else None,
+        )
+        for name in PROOF_CONDITIONS
+    )
+    payload = {
+        "schema_version": ALIAS_PROOF_SCHEMA_VERSION,
+        "opcode": contract.opcode,
+        "contract": contract.to_dict(),
+        "capability": capability.to_dict(),
+        "status": "rejected",
+        "reason": code,
+        "conditions": [item.to_dict() for item in conditions],
+    }
