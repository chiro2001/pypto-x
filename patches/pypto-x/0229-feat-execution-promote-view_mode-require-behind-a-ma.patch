+def test_sve256_capability_declaration_is_honest_and_user_visible():
+    from pypto.backends.cpu.aarch64 import sve256 as sve256_backend
+    from pypto.compiler.targets.cpu_sve256 import (
+        SVE256_ALIAS_PROOF_MODE,
+        SVE256_LAYOUT_VIEW_ALIAS_MODE,
+        SVE256_LAYOUT_VIEW_ALIAS_REASON,
+        SVE256_SUPPORTED_VIEW_MODES,
+    )
+
+    # The artifact declaration and the backend capability object are the same
+    # fact, not two independently drifting claims.
+    assert SVE256_LAYOUT_VIEW_ALIAS_MODE == "unsupported"
+    assert SVE256_ALIAS_PROOF_MODE == "unsupported"
+    assert SVE256_SUPPORTED_VIEW_MODES == ("forbid", "prefer")
+    assert "require" not in SVE256_SUPPORTED_VIEW_MODES
+    assert "TypedByteView" in SVE256_LAYOUT_VIEW_ALIAS_REASON
+
+    capability = sve256_backend.view_alias_capability()
+    assert capability.alias_proof == "unsupported"
+    assert capability.stride_class == "none"
+    assert capability.supported_view_modes == ("forbid", "prefer")
+    assert capability.reason == SVE256_LAYOUT_VIEW_ALIAS_REASON
+
+    # require fails closed with the capability reason; prefer/forbid
+    # explicitly materialize instead of pretending to view.
+    with pytest.raises(ViewResolutionError) as excinfo:
+        _resolve("require", capability=capability)
+    error = excinfo.value
+    assert error.code == ALIAS_PROOF_UNAVAILABLE
+    assert error.reason == "backend_does_not_support_view_mode"
+    assert error.available["supported_view_modes"] == ["forbid", "prefer"]
+    assert SVE256_LAYOUT_VIEW_ALIAS_REASON in error.to_dict()["available"]["capability_reason"]
+    for mode in ("forbid", "prefer"):
+        result = _resolve(mode, capability=capability)
+        assert result.resolved_view_mode == "materialized"
+        assert result.layout_copy_bytes == 64
