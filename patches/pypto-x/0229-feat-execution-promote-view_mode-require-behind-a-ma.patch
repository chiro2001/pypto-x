+                field="layout.view_mode",
+                reason=CONTRACT_REQUIRES_ALIAS,
+                available={"view_obligation": contract.view_obligation, "view_mode": "prefer|require"},
+                requested_view_mode=requested,
+                proof=proof,
+                suggested_policy={"layout.view_mode": "prefer"},
+            )
