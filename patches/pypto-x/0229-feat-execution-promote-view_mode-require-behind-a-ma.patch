+def test_alias_proof_status_domain_is_closed():
+    assert ALIAS_PROOF_STATUSES == ("proven", "rejected", "not_applicable", "unsupported")
+    assert VIEW_MODES == ("forbid", "prefer", "require")
+    proof = _prove()
+    document = proof.to_dict()
+    assert document["status"] in ALIAS_PROOF_STATUSES
+    assert isinstance(document["conditions"], list)
