diff --git a/python/pypto/alias/proof.py b/python/pypto/alias/proof.py
new file mode 100644
index 000000000..c11697b20
--- /dev/null
+++ b/python/pypto/alias/proof.py
@@ -0,0 +1,1299 @@
+"""Machine-checkable zero-copy view (alias) proof chain.
+
+This module is the single implementation of the ``0006`` section 7.1
+obligations:
+
+1. ``contract_view_obligation`` -- the operator contract permits a view
+   (``must_alias`` / ``may_alias``); ``must_not_alias`` never becomes a view;
+2. ``stride_shape_expressible`` -- the view offset/stride/shape is inside the
+   target backend's declared ``stride_class`` precondition;
+3. ``write_after_read`` -- the source storage is not written while the view is
+   live (in-place/effectful update or a proven output alias);
+4. ``owner_lifetime`` -- the view's lifetime is inside the source storage
+   lifetime; a caller-owned export that cannot be retained is never viewed;
+5. ``multi_view_overlap`` -- multiple views of one source either do not
+   overlap while both live, or are all read-only.
+
+The module is deliberately dependency-light: it only uses the standard
+library plus :mod:`pypto.target._utils`, so both the U1 execution layer and
+the native CPU backends can import it without an import cycle.  A proof is a
+pure function of explicit facts; the digest makes the decision reproducible
+and the ``conditions`` list makes the failure explainable per condition.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.target._utils import canonical_json, mapping_copy, sha256_text
+
+
+ALIAS_PROOF_SCHEMA_VERSION = 1
+
+VIEW_MODES = ("forbid", "prefer", "require")
+VIEW_OBLIGATIONS = ("must_alias", "may_alias", "must_not_alias")
+ALIAS_PROOF_STATUSES = ("proven", "rejected", "not_applicable", "unsupported")
+RESOLVED_VIEW_MODES = ("view", "materialized", "not_applicable")
+PROOF_CONDITION_STATUSES = ("passed", "failed", "not_applicable", "unsupported")
+PROOF_CONDITIONS = (
+    "contract_view_obligation",
+    "stride_shape_expressible",
+    "write_after_read",
+    "owner_lifetime",
+    "multi_view_overlap",
+)
+
+# Machine-readable rejection codes.  They are stable enough for tests and
+# reports to assert on, and readable enough to print to a user.
+NO_VIEW_OBLIGATION = "op_contract_has_no_view_obligation"
+CONTRACT_FORBIDS_VIEW = "contract_requires_distinct_storage"
+CONTRACT_REQUIRES_ALIAS = "contract_requires_storage_alias"
+BACKEND_PROOF_UNSUPPORTED = "backend_alias_proof_unsupported"
+VIEW_MODE_NOT_SUPPORTED = "backend_does_not_support_view_mode"
+STRIDE_CLASS_UNSUPPORTED = "stride_class_not_supported"
+STRIDE_NOT_REPRESENTABLE = "view_stride_not_representable"
+OFFSET_NOT_REPRESENTABLE = "view_offset_not_representable"
+STEP_NOT_REPRESENTABLE = "view_step_not_representable"
+RANK_EXCEEDS_CAPABILITY = "view_rank_exceeds_capability"
+ELEMENT_COUNT_MISMATCH = "view_element_count_mismatch"
+DTYPE_MISMATCH = "view_dtype_mismatch"
+SHAPE_INVALID = "view_geometry_invalid"
+SOURCE_WRITTEN_WHILE_VIEW_LIVE = "source_written_while_view_live"
+WRITE_COVERAGE_UNKNOWN = "write_coverage_unknown"
+SOURCE_RELEASED_WHILE_VIEW_LIVE = "source_released_while_view_live"
+CALLER_OWNED_NOT_RETAINABLE = "caller_owned_storage_not_retainable"
+VIEW_OUTLIVES_SOURCE = "view_outlives_source"
+VIEW_OVERLAP_WRITABLE = "view_overlap_writable"
+VIEW_OVERLAP_COVERAGE_UNKNOWN = "view_overlap_coverage_unknown"
+MATERIALIZE_FORBIDDEN = "contract_forbids_materialize_copy"
+MATERIALIZE_DISABLED = "allow_materialize_copy_false"
+MATERIALIZE_BUDGET_EXCEEDED = "max_copy_bytes_exceeded"
+PROOF_REJECTED = "alias_proof_rejected"
+
+
+def _normalize_view_mode(value: Any, field_name: str = "layout.view_mode") -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ViewResolutionError(
+            "{} must be a non-empty string".format(field_name),
+            code="POLICY_INVALID_VALUE",
+            field=field_name,
+            reason="not_a_string",
+            available=list(VIEW_MODES),
+        )
+    normalized = value.strip().lower()
+    if normalized not in VIEW_MODES:
+        raise ViewResolutionError(
+            "{}={!r} is not a recognized view mode".format(field_name, value),
+            code="POLICY_INVALID_VALUE",
+            field=field_name,
+            reason="value_out_of_domain",
+            available=list(VIEW_MODES),
+        )
+    return normalized
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    if not shape:
+        return ()
+    strides = [1]
+    for dimension in reversed(tuple(shape)[1:]):
+        strides.append(strides[-1] * int(dimension))
+    strides.reverse()
+    return tuple(strides)
+
+
+def _element_count(shape: Sequence[int]) -> int:
+    total = 1
+    for dimension in shape:
+        total *= int(dimension)
+    return total
+
+
+def _byte_ranges_overlap(left: Tuple[int, int], right: Tuple[int, int]) -> bool:
+    return left[0] < right[1] and right[0] < left[1]
+
+
+@dataclass(frozen=True)
+class ViewContract:
+    """Operator-contract facts that bound whether a view is even legal."""
+
+    opcode: str
+    view_obligation: str = "must_not_alias"
+    allows_materialize_copy: bool = False
+    copy_bytes: int = 0
+    max_copy_bytes: Optional[int] = None
+    effects: str = "pure"
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.opcode, str) or not self.opcode.strip():
+            raise ValueError("view contract opcode must be a non-empty string")
+        if self.view_obligation not in VIEW_OBLIGATIONS:
+            raise ValueError(
+                "view contract view_obligation must be one of {}".format(list(VIEW_OBLIGATIONS))
+            )
+        if not isinstance(self.allows_materialize_copy, bool):
+            raise ValueError("view contract allows_materialize_copy must be a bool")
+        if isinstance(self.copy_bytes, bool) or not isinstance(self.copy_bytes, int) or self.copy_bytes < 0:
+            raise ValueError("view contract copy_bytes must be a non-negative integer")
+        if self.max_copy_bytes is not None and (
+            isinstance(self.max_copy_bytes, bool)
+            or not isinstance(self.max_copy_bytes, int)
+            or self.max_copy_bytes < 0
+        ):
+            raise ValueError("view contract max_copy_bytes must be None or a non-negative integer")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "opcode": self.opcode,
+            "view_obligation": self.view_obligation,
+            "allows_materialize_copy": self.allows_materialize_copy,
+            "copy_bytes": self.copy_bytes,
+            "max_copy_bytes": self.max_copy_bytes,
+            "effects": self.effects,
+        }
+
+
+@dataclass(frozen=True)
+class ViewCapability:
+    """Backend capability preconditions for expressing a view.
+
+    ``stride_class`` is the descriptor precondition from ``0006`` section
+    13.2 / 13.9 answer 1.  Two classes are implemented:
+
+    * ``contiguous_identity`` -- the view keeps the source element order, the
+      output is row-major contiguous, and there is no offset/step/permutation;
+      this is the only class the AVX-512 native plane advertises today;
+    * ``explicit_strides`` -- the descriptor can represent arbitrary
+      non-overlapping, non-negative element strides (subject to
+      ``supports_offset`` / ``supports_step``); no backend in this change
+      claims it, but the decision path is implemented and tested.
+    """
+
+    backend: str
+    alias_proof: str = "supported"
+    stride_class: str = "contiguous_identity"
+    supported_view_modes: Tuple[str, ...] = VIEW_MODES
+    max_rank: int = 64
+    supports_offset: bool = False
+    supports_step: bool = False
+    reason: str = ""
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.backend, str) or not self.backend.strip():
+            raise ValueError("view capability backend must be a non-empty string")
+        if self.alias_proof not in ("supported", "unsupported"):
+            raise ValueError("view capability alias_proof must be 'supported' or 'unsupported'")
+        if self.stride_class not in ("contiguous_identity", "explicit_strides", "none"):
+            raise ValueError(
+                "view capability stride_class must be contiguous_identity | explicit_strides | none"
+            )
+        modes = tuple(str(item).strip().lower() for item in self.supported_view_modes)
+        for mode in modes:
+            if mode not in VIEW_MODES:
+                raise ValueError("view capability supported_view_modes contains {!r}".format(mode))
+        if isinstance(self.max_rank, bool) or not isinstance(self.max_rank, int) or self.max_rank <= 0:
+            raise ValueError("view capability max_rank must be a positive integer")
+        object.__setattr__(self, "supported_view_modes", modes)
+
+    @classmethod
+    def unsupported(cls, backend: str, reason: str, **extra: Any) -> "ViewCapability":
+        return cls(
+            backend=backend,
+            alias_proof="unsupported",
+            stride_class="none",
+            supported_view_modes=("forbid", "prefer"),
+            reason=reason,
+            **extra,
+        )
+
+    def supports_view_mode(self, mode: str) -> bool:
+        return mode in self.supported_view_modes
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "backend": self.backend,
+            "alias_proof": self.alias_proof,
+            "stride_class": self.stride_class,
+            "supported_view_modes": list(self.supported_view_modes),
+            "max_rank": self.max_rank,
+            "supports_offset": self.supports_offset,
+            "supports_step": self.supports_step,
+            "reason": self.reason,
+        }
+
+
+@dataclass(frozen=True)
+class ViewGeometry:
+    """Static shape/stride/offset facts of one candidate view."""
+
+    source_shape: Tuple[int, ...]
+    view_shape: Tuple[int, ...]
+    source_strides: Tuple[int, ...]
+    view_strides: Tuple[int, ...]
+    offset_elements: int = 0
+    itemsize: int = 1
+    view_steps: Tuple[int, ...] = ()
+
+    def __post_init__(self) -> None:
+        for name in ("source_shape", "view_shape", "source_strides", "view_strides", "view_steps"):
+            value = tuple(getattr(self, name))
+            for dimension in value:
+                if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+                    raise ValueError("view geometry {} must be non-negative integers".format(name))
+            object.__setattr__(self, name, value)
+        if isinstance(self.offset_elements, bool) or not isinstance(self.offset_elements, int):
+            raise ValueError("view geometry offset_elements must be an integer")
+        if self.offset_elements < 0:
+            raise ValueError("view geometry offset_elements must be non-negative")
+        if isinstance(self.itemsize, bool) or not isinstance(self.itemsize, int) or self.itemsize <= 0:
+            raise ValueError("view geometry itemsize must be a positive integer")
+
+    @property
+    def source_elements(self) -> int:
+        return _element_count(self.source_shape)
+
+    @property
+    def view_elements(self) -> int:
+        return _element_count(self.view_shape)
+
+    @property
+    def byte_offset(self) -> int:
+        return self.offset_elements * self.itemsize
+
+    @property
+    def view_bytes(self) -> int:
+        return self.view_elements * self.itemsize
+
+    @property
+    def view_byte_range(self) -> Tuple[int, int]:
+        return (self.byte_offset, self.byte_offset + self.view_bytes)
+
+    @property
+    def is_contiguous_identity(self) -> bool:
+        if tuple(self.source_strides) != _contiguous_strides(self.source_shape):
+            return False
+        if tuple(self.view_strides) != _contiguous_strides(self.view_shape):
+            return False
+        if self.offset_elements != 0:
+            return False
+        if tuple(self.view_steps) and any(step != 1 for step in self.view_steps):
+            return False
+        return True
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "source_shape": list(self.source_shape),
+            "view_shape": list(self.view_shape),
+            "source_strides": list(self.source_strides),
+            "view_strides": list(self.view_strides),
+            "offset_elements": self.offset_elements,
+            "itemsize": self.itemsize,
+            "view_steps": list(self.view_steps),
+        }
+
+
+@dataclass(frozen=True)
+class WriteAccess:
+    """One proven or declared write to the source/view byte range."""
+
+    index: int
+    byte_start: int
+    byte_end: int
+    kind: str = "inplace"
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "index": self.index,
+            "byte_start": self.byte_start,
+            "byte_end": self.byte_end,
+            "kind": self.kind,
+        }
+
+
+@dataclass(frozen=True)
+class ViewLifetime:
+    """Liveness/owner facts for the source buffer and the candidate view."""
+
+    view_start: int
+    view_last_use: Optional[int] = None
+    source_last_use: Optional[int] = None
+    source_is_caller_owned: bool = False
+    source_owner_retained: bool = True
+    release_while_view_live: bool = False
+    writes: Tuple[WriteAccess, ...] = ()
+    writes_known: bool = True
+    source_effects: str = "pure"
+
+    def __post_init__(self) -> None:
+        if isinstance(self.view_start, bool) or not isinstance(self.view_start, int) or self.view_start < 0:
+            raise ValueError("view lifetime view_start must be a non-negative integer")
+        for name in ("view_last_use", "source_last_use"):
+            value = getattr(self, name)
+            if value is not None and (isinstance(value, bool) or not isinstance(value, int) or value < 0):
+                raise ValueError("view lifetime {} must be None or a non-negative integer".format(name))
+        if not isinstance(self.source_owner_retained, bool):
+            raise ValueError("view lifetime source_owner_retained must be a bool")
+        object.__setattr__(self, "writes", tuple(self.writes))
+
+    def view_live_through(self) -> int:
+        """Return the last operation that may still reference the view.
+
+        ``None`` means the view escapes the launch and stays live to the end.
+        """
+
+        if self.view_last_use is None:
+            return 1 << 62
+        return self.view_last_use
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "view_start": self.view_start,
+            "view_last_use": self.view_last_use,
+            "source_last_use": self.source_last_use,
+            "source_is_caller_owned": self.source_is_caller_owned,
+            "source_owner_retained": self.source_owner_retained,
+            "release_while_view_live": self.release_while_view_live,
+            "writes": [item.to_dict() for item in self.writes],
+            "writes_known": self.writes_known,
+            "source_effects": self.source_effects,
+        }
+
+
+@dataclass(frozen=True)
+class ViewRange:
+    """One live view range used for multi-view overlap checks."""
+
+    name: str
+    byte_start: int
+    byte_end: int
+    writable: bool = False
+    live_start: int = 0
+    live_end: Optional[int] = None
+
+    @property
+    def byte_range(self) -> Tuple[int, int]:
+        return (self.byte_start, self.byte_end)
+
+    def live_through(self) -> int:
+        return 1 << 62 if self.live_end is None else self.live_end
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "name": self.name,
+            "byte_start": self.byte_start,
+            "byte_end": self.byte_end,
+            "writable": self.writable,
+            "live_start": self.live_start,
+            "live_end": self.live_end,
+        }
+
+
+@dataclass(frozen=True)
+class ViewOverlap:
+    """Facts about already-live views derived from the same owner."""
+
+    new_view: ViewRange
+    existing_views: Tuple[ViewRange, ...] = ()
+    coverage_known: bool = True
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "new_view": self.new_view.to_dict(),
+            "existing_views": [item.to_dict() for item in self.existing_views],
+            "coverage_known": self.coverage_known,
+        }
+
+
+@dataclass(frozen=True)
+class ProofCondition:
+    """One condition of the proof chain, with a readable rejection reason."""
+
+    name: str
+    status: str
+    code: str
+    reason: str
+    evidence: Mapping[str, Any] = field(default_factory=dict)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "name": self.name,
+            "status": self.status,
+            "code": self.code,
+            "reason": self.reason,
+            "evidence": mapping_copy(self.evidence),
+        }
+
+
+@dataclass(frozen=True)
+class AliasProof:
+    """The complete, digestible alias-proof result."""
+
+    opcode: str
+    status: str
+    conditions: Tuple[ProofCondition, ...]
+    reason: str
+    digest: str
+    schema_version: int = ALIAS_PROOF_SCHEMA_VERSION
+
+    @property
+    def failed_conditions(self) -> Tuple[str, ...]:
+        return tuple(item.name for item in self.conditions if item.status == "failed")
+
+    @property
+    def rejected(self) -> bool:
+        return self.status in ("rejected", "unsupported")
+
+    def condition(self, name: str) -> Optional[ProofCondition]:
+        for item in self.conditions:
+            if item.name == name:
+                return item
+        return None
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "schema_version": self.schema_version,
+            "opcode": self.opcode,
+            "status": self.status,
+            "reason": self.reason,
+            "failed_conditions": list(self.failed_conditions),
+            "conditions": [item.to_dict() for item in self.conditions],
+            "digest": self.digest,
+        }
+
+
+@dataclass(frozen=True)
+class ViewIntent:
+    """The layout policy slice that drives view resolution."""
+
+    view_mode: str = "forbid"
+    allow_materialize_copy: bool = True
+    max_copy_bytes: Optional[int] = None
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "view_mode", _normalize_view_mode(self.view_mode))
+        if not isinstance(self.allow_materialize_copy, bool):
+            raise ViewResolutionError(
+                "layout.allow_materialize_copy must be a bool",
+                code="POLICY_INVALID_VALUE",
+                field="layout.allow_materialize_copy",
+                reason="not_a_bool",
+            )
+        if self.max_copy_bytes is not None and (
+            isinstance(self.max_copy_bytes, bool)
+            or not isinstance(self.max_copy_bytes, int)
+            or self.max_copy_bytes < 0
+        ):
+            raise ViewResolutionError(
+                "layout.max_copy_bytes must be None or a non-negative integer",
+                code="POLICY_INVALID_VALUE",
+                field="layout.max_copy_bytes",
+                reason="not_a_non_negative_integer",
+            )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "view_mode": self.view_mode,
+            "allow_materialize_copy": self.allow_materialize_copy,
+            "max_copy_bytes": self.max_copy_bytes,
+        }
+
+
+@dataclass(frozen=True)
+class ViewResolution:
+    """Resolved three-state decision: view / materialized / not applicable."""
+
+    requested_view_mode: str
+    resolved_view_mode: str
+    layout_copy_bytes: int
+    alias_proof: AliasProof
+    reason: str
+    materialize_allowed: bool
+    materialize_reason: str
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "requested_view_mode": self.requested_view_mode,
+            "resolved_view_mode": self.resolved_view_mode,
+            "layout_copy_bytes": self.layout_copy_bytes,
+            "reason": self.reason,
+            "materialize_allowed": self.materialize_allowed,
+            "materialize_reason": self.materialize_reason,
+            "alias_proof": self.alias_proof.to_dict(),
+            "alias_proof_digest": self.alias_proof.digest,
+        }
+
+
+class ViewResolutionError(RuntimeError):
+    """Structured refusal from the alias-proof resolver.
+
+    Callers in :mod:`pypto.execution` map this onto the frozen
+    ``ALIAS_PROOF_UNAVAILABLE`` / ``POLICY_CONFLICT`` error codes.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        code: str,
+        field: str = "layout.view_mode",
+        reason: Optional[str] = None,
+        available: Any = None,
+        failed_conditions: Sequence[str] = (),
+        conditions: Sequence[ProofCondition] = (),
+        requested_view_mode: Optional[str] = None,
+        materialize_reason: Optional[str] = None,
+        proof: Optional[AliasProof] = None,
+        suggested_policy: Any = None
+    ) -> None:
+        super().__init__(message)
+        self.code = code
+        self.field = field
+        self.reason = reason
+        self.available = available
+        self.failed_conditions = tuple(failed_conditions)
+        self.conditions = tuple(conditions)
+        self.requested_view_mode = requested_view_mode
+        self.materialize_reason = materialize_reason
+        self.proof = proof
+        self.suggested_policy = suggested_policy
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "code": self.code,
+            "field": self.field,
+            "reason": self.reason,
+            "available": self.available,
+            "failed_conditions": list(self.failed_conditions),
+            "conditions": [item.to_dict() for item in self.conditions],
+            "requested_view_mode": self.requested_view_mode,
+            "materialize_reason": self.materialize_reason,
+            "suggested_policy": self.suggested_policy,
+            "alias_proof": self.proof.to_dict() if self.proof is not None else None,
+            "message": str(self),
+        }
+
+
+def proof_condition(
+    name: str,
+    status: str,
+    code: str,
+    reason: str,
+    evidence: Optional[Mapping[str, Any]] = None
+) -> ProofCondition:
+    if status not in PROOF_CONDITION_STATUSES:
+        raise ValueError("proof condition status must be one of {}".format(list(PROOF_CONDITION_STATUSES)))
+    return ProofCondition(name=name, status=status, code=code, reason=reason, evidence=evidence or {})
+
+
+def _condition_not_applicable(name: str, reason: str, code: str = NO_VIEW_OBLIGATION) -> ProofCondition:
+    return proof_condition(name, "not_applicable", code, reason)
+
+
+def _unsupported_conditions(capability: ViewCapability) -> Tuple[ProofCondition, ...]:
+    reason = capability.reason or "the backend does not implement the alias proof chain"
+    return tuple(
+        proof_condition(name, "unsupported", BACKEND_PROOF_UNSUPPORTED, reason)
+        for name in PROOF_CONDITIONS
+    )
+
+
+def _contract_condition(contract: ViewContract) -> ProofCondition:
+    if contract.view_obligation == "must_not_alias":
+        return proof_condition(
+            "contract_view_obligation",
+            "not_applicable",
+            CONTRACT_FORBIDS_VIEW,
+            "contract view_obligation=must_not_alias; zero-copy view is never a candidate",
+            {"view_obligation": contract.view_obligation, "effects": contract.effects},
+        )
+    return proof_condition(
+        "contract_view_obligation",
+        "passed",
+        "contract_permits_view",
+        "contract view_obligation={} permits a view".format(contract.view_obligation),
+        {"view_obligation": contract.view_obligation, "effects": contract.effects},
+    )
+
+
+def _stride_condition(
+    capability: ViewCapability, geometry: Optional[ViewGeometry]
+) -> ProofCondition:
+    if geometry is None:
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            SHAPE_INVALID,
+            "view geometry facts are missing",
+        )
+    if capability.stride_class == "none":
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            STRIDE_CLASS_UNSUPPORTED,
+            "backend declares stride_class=none; it cannot express a view descriptor",
+        )
+    if capability.stride_class not in ("contiguous_identity", "explicit_strides"):
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            STRIDE_CLASS_UNSUPPORTED,
+            "backend stride_class {!r} is not supported by the proof".format(capability.stride_class),
+        )
+    if not isinstance(geometry.itemsize, int) or geometry.itemsize <= 0:
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            DTYPE_MISMATCH,
+            "view geometry has an invalid dtype itemsize",
+        )
+    if max(len(geometry.source_shape), len(geometry.view_shape)) > capability.max_rank:
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            RANK_EXCEEDS_CAPABILITY,
+            "view rank exceeds the backend capability max_rank={}".format(capability.max_rank),
+            {"max_rank": capability.max_rank},
+        )
+    if geometry.source_elements != geometry.view_elements:
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            ELEMENT_COUNT_MISMATCH,
+            "view element count {} does not match source element count {}".format(
+                geometry.view_elements, geometry.source_elements
+            ),
+        )
+    if geometry.view_steps and any(step != 1 for step in geometry.view_steps) and not capability.supports_step:
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            STEP_NOT_REPRESENTABLE,
+            "backend does not support non-unit view steps",
+            {"view_steps": list(geometry.view_steps)},
+        )
+    if geometry.offset_elements != 0 and not capability.supports_offset:
+        return proof_condition(
+            "stride_shape_expressible",
+            "failed",
+            OFFSET_NOT_REPRESENTABLE,
+            "backend does not support a non-zero view element offset",
+            {"offset_elements": geometry.offset_elements},
+        )
+    if capability.stride_class == "contiguous_identity":
+        if not geometry.is_contiguous_identity:
+            return proof_condition(
+                "stride_shape_expressible",
+                "failed",
+                STRIDE_NOT_REPRESENTABLE,
+                "view is not a contiguous identity view (permutation/offset/step or "
+                "non-contiguous strides)",
+                {
+                    "source_strides": list(geometry.source_strides),
+                    "view_strides": list(geometry.view_strides),
+                    "offset_elements": geometry.offset_elements,
+                    "view_steps": list(geometry.view_steps),
+                },
+            )
+    else:  # explicit_strides
+        if tuple(geometry.source_strides) != _contiguous_strides(geometry.source_shape):
+            return proof_condition(
+                "stride_shape_expressible",
+                "failed",
+                STRIDE_NOT_REPRESENTABLE,
+                "explicit_stride views require the source to be row-major contiguous",
+            )
+        if len(geometry.view_strides) != len(geometry.view_shape):
+            return proof_condition(
+                "stride_shape_expressible",
+                "failed",
+                STRIDE_NOT_REPRESENTABLE,
+                "explicit_stride view rank does not match the view shape",
+            )
+        if any(stride < 0 for stride in geometry.view_strides):
+            return proof_condition(
+                "stride_shape_expressible",
+                "failed",
+                STRIDE_NOT_REPRESENTABLE,
+                "explicit_stride views do not support negative strides",
+            )
+        # A valid descriptor must not make two view elements share storage.
+        running = 1
+        for stride, dimension in sorted(zip(geometry.view_strides, geometry.view_shape)):
+            if stride < running and dimension > 1:
+                return proof_condition(
+                    "stride_shape_expressible",
+                    "failed",
+                    STRIDE_NOT_REPRESENTABLE,
+                    "explicit_stride view descriptor overlaps itself",
+                    {"view_strides": list(geometry.view_strides), "view_shape": list(geometry.view_shape)},
+                )
+            running *= int(dimension)
+        last_element = geometry.offset_elements + sum(
+            (int(dimension) - 1) * int(stride)
+            for dimension, stride in zip(geometry.view_shape, geometry.view_strides)
+        )
+        if last_element >= geometry.source_elements:
+            return proof_condition(
+                "stride_shape_expressible",
+                "failed",
+                STRIDE_NOT_REPRESENTABLE,
+                "explicit_stride view descriptor overruns the source storage",
+                {
+                    "last_element": last_element,
+                    "source_elements": geometry.source_elements,
+                },
+            )
+    return proof_condition(
+        "stride_shape_expressible",
+        "passed",
+        "stride_class_supported",
+        "view is expressible with stride_class={}".format(capability.stride_class),
+        {
+            "stride_class": capability.stride_class,
+            "source_shape": list(geometry.source_shape),
+            "view_shape": list(geometry.view_shape),
+            "offset_elements": geometry.offset_elements,
+        },
+    )
+
+
+def _write_after_read_condition(
+    lifetime: Optional[ViewLifetime], geometry: Optional[ViewGeometry]
+) -> ProofCondition:
+    if lifetime is None:
+        return proof_condition(
+            "write_after_read",
+            "failed",
+            WRITE_COVERAGE_UNKNOWN,
+            "view liveness/write facts are missing",
+        )
+    if not lifetime.writes_known:
+        return proof_condition(
+            "write_after_read",
+            "failed",
+            WRITE_COVERAGE_UNKNOWN,
+            "the caller declared that the write set is unknown; fail-closed",
+        )
+    live_end = lifetime.view_live_through()
+    view_range = geometry.view_byte_range if geometry is not None else None
+    for write in lifetime.writes:
+        if write.byte_end <= write.byte_start:
+            continue
+        if not (lifetime.view_start <= write.index <= live_end):
+            continue
+        if view_range is not None and not _byte_ranges_overlap(
+            (write.byte_start, write.byte_end), view_range
+        ):
+            # A write to a disjoint byte range of the same allocation while
+            # the view is live is safe; the overlap has been proven.
+            continue
+        return proof_condition(
+            "write_after_read",
+            "failed",
+            SOURCE_WRITTEN_WHILE_VIEW_LIVE,
+            "operation {} writes bytes [{}, {}) while the view bytes {} are live".format(
+                write.index, write.byte_start, write.byte_end,
+                list(view_range) if view_range is not None else "unknown",
+            ),
+            {
+                "write": write.to_dict(),
+                "view_start": lifetime.view_start,
+                "view_live_end": None if lifetime.view_last_use is None else lifetime.view_last_use,
+                "view_byte_range": list(view_range) if view_range is not None else None,
+            },
+        )
+    return proof_condition(
+        "write_after_read",
+        "passed",
+        "no_write_after_view",
+        "no write touches the source/view storage while the view is live",
+        {"writes_checked": [item.to_dict() for item in lifetime.writes]},
+    )
+
+
+def _owner_lifetime_condition(lifetime: Optional[ViewLifetime]) -> ProofCondition:
+    if lifetime is None:
+        return proof_condition(
+            "owner_lifetime",
+            "failed",
+            SOURCE_RELEASED_WHILE_VIEW_LIVE,
+            "view lifetime/owner facts are missing",
+        )
+    if lifetime.source_is_caller_owned and not lifetime.source_owner_retained:
+        return proof_condition(
+            "owner_lifetime",
+            "failed",
+            CALLER_OWNED_NOT_RETAINABLE,
+            "source is caller-owned and the view cannot retain the export; "
+            "zero-copy would outlive the caller's buffer export",
+        )
+    if lifetime.release_while_view_live:
+        return proof_condition(
+            "owner_lifetime",
+            "failed",
+            SOURCE_RELEASED_WHILE_VIEW_LIVE,
+            "source storage is released while the view is still live",
+        )
+    if (
+        lifetime.view_last_use is not None
+        and lifetime.source_last_use is not None
+        and lifetime.view_last_use > lifetime.source_last_use
+        and not lifetime.source_owner_retained
+    ):
+        return proof_condition(
+            "owner_lifetime",
+            "failed",
+            VIEW_OUTLIVES_SOURCE,
+            "view last use {} outlives source last use {} and the view does not "
+            "retain the source owner".format(lifetime.view_last_use, lifetime.source_last_use),
+        )
+    return proof_condition(
+        "owner_lifetime",
+        "passed",
+        "lifetime_contained",
+        "view lifetime is contained in the source storage lifetime "
+        "(owner retained or source live past the view)",
+        {
+            "source_last_use": lifetime.source_last_use,
+            "view_last_use": lifetime.view_last_use,
+            "source_owner_retained": lifetime.source_owner_retained,
+        },
+    )
+
+
+def _overlap_condition(overlap: Optional[ViewOverlap]) -> ProofCondition:
+    if overlap is None:
+        return proof_condition(
+            "multi_view_overlap",
+            "failed",
+            VIEW_OVERLAP_COVERAGE_UNKNOWN,
+            "multi-view overlap facts are missing",
+        )
+    if not overlap.coverage_known:
+        return proof_condition(
+            "multi_view_overlap",
+            "failed",
+            VIEW_OVERLAP_COVERAGE_UNKNOWN,
+            "the existing-view set is unknown; fail-closed",
+        )
+    new_view = overlap.new_view
+    for existing in overlap.existing_views:
+        if existing.name == new_view.name:
+            continue
+        if existing.live_through() < new_view.live_start:
+            continue
+        if new_view.live_through() < existing.live_start:
+            continue
+        if not _byte_ranges_overlap(existing.byte_range, new_view.byte_range):
+            continue
+        if existing.writable or new_view.writable:
+            return proof_condition(
+                "multi_view_overlap",
+                "failed",
+                VIEW_OVERLAP_WRITABLE,
+                "view {!r} overlaps writable view {!r}".format(new_view.name, existing.name),
+                {"new_view": new_view.to_dict(), "existing_view": existing.to_dict()},
+            )
+    return proof_condition(
+        "multi_view_overlap",
+        "passed",
+        "overlap_readonly_or_disjoint",
+        "all overlapping live views are read-only and disjoint at write granularity",
+        {
+            "new_view": new_view.to_dict(),
+            "existing_views": [item.to_dict() for item in overlap.existing_views],
+        },
+    )
+
+
+def prove_view(
+    contract: ViewContract,
+    capability: ViewCapability,
+    geometry: Optional[ViewGeometry] = None,
+    lifetime: Optional[ViewLifetime] = None,
+    overlap: Optional[ViewOverlap] = None
+) -> AliasProof:
+    """Evaluate the five 0006 section 7.1 obligations and return a proof.
+
+    The result is a pure function of ``(contract, capability, geometry,
+    lifetime, overlap)``; the same facts always produce the same digest.
+    """
+
+    if not isinstance(contract, ViewContract):
+        raise TypeError("prove_view requires a ViewContract")
+    if not isinstance(capability, ViewCapability):
+        raise TypeError("prove_view requires a ViewCapability")
+
+    if capability.alias_proof == "unsupported":
+        conditions = _unsupported_conditions(capability)
+        reason = capability.reason or BACKEND_PROOF_UNSUPPORTED
+    elif contract.view_obligation == "must_not_alias":
+        conditions = (
+            _contract_condition(contract),
+            _condition_not_applicable(
+                "stride_shape_expressible", "no view candidate exists (must_not_alias)"
+            ),
+            _condition_not_applicable(
+                "write_after_read", "no view candidate exists (must_not_alias)"
+            ),
+            _condition_not_applicable(
+                "owner_lifetime", "no view candidate exists (must_not_alias)"
+            ),
+            _condition_not_applicable(
+                "multi_view_overlap", "no view candidate exists (must_not_alias)"
+            ),
+        )
+        reason = CONTRACT_FORBIDS_VIEW
+    else:
+        conditions = (
+            _contract_condition(contract),
+            _stride_condition(capability, geometry),
+            _write_after_read_condition(lifetime, geometry),
+            _owner_lifetime_condition(lifetime),
+            _overlap_condition(overlap),
+        )
+        failed = [item for item in conditions if item.status == "failed"]
+        if failed:
+            reason = failed[0].code
+        else:
+            reason = "all_alias_proof_conditions_passed"
+
+    status = "proven"
+    if capability.alias_proof == "unsupported":
+        status = "unsupported"
+    elif contract.view_obligation == "must_not_alias":
+        status = "not_applicable"
+    elif any(item.status == "failed" for item in conditions):
+        status = "rejected"
+
+    payload = {
+        "schema_version": ALIAS_PROOF_SCHEMA_VERSION,
+        "opcode": contract.opcode,
+        "contract": contract.to_dict(),
+        "capability": capability.to_dict(),
+        "geometry": geometry.to_dict() if geometry is not None else None,
+        "lifetime": lifetime.to_dict() if lifetime is not None else None,
+        "overlap": overlap.to_dict() if overlap is not None else None,
+        "status": status,
+        "reason": reason,
+        "conditions": [item.to_dict() for item in conditions],
+    }
+    digest = "sha256:" + sha256_text(payload)
+    return AliasProof(
+        opcode=contract.opcode,
+        status=status,
+        conditions=tuple(conditions),
+        reason=reason,
+        digest=digest,
+    )
+
+
+def _materialize_allowed(
+    contract: ViewContract, intent: ViewIntent
+) -> Tuple[bool, str]:
+    """Return whether an explicit materialize/copy candidate is allowed."""
+
+    if contract.view_obligation == "must_alias":
+        # The contract itself requires storage alias; a materialize copy can
+        # never satisfy it (only view_mode=forbid conflicts even harder).
+        return False, CONTRACT_REQUIRES_ALIAS
+    if not contract.allows_materialize_copy:
+        return False, MATERIALIZE_FORBIDDEN
+    if not intent.allow_materialize_copy:
+        return False, MATERIALIZE_DISABLED
+    limit = contract.max_copy_bytes
+    if intent.max_copy_bytes is not None:
+        limit = intent.max_copy_bytes if limit is None else min(limit, intent.max_copy_bytes)
+    if limit is not None and contract.copy_bytes > limit:
+        return False, MATERIALIZE_BUDGET_EXCEEDED
+    return True, "materialize_copy_allowed"
+
+
+def _alias_failure(
+    message: str,
+    contract: ViewContract,
+    capability: ViewCapability,
+    proof: AliasProof,
+    intent: ViewIntent,
+    materialize_allowed: bool,
+    materialize_reason: str,
+    reason: str
+) -> ViewResolutionError:
+    failed = proof.failed_conditions or ("contract_view_obligation",)
+    return ViewResolutionError(
+        message,
+        code="ALIAS_PROOF_UNAVAILABLE",
+        field="layout.view_mode",
+        reason=reason,
+        available={
+            "view_mode": intent.view_mode,
+            "materialize_allowed": materialize_allowed,
+            "materialize_reason": materialize_reason,
+            "backend": capability.backend,
+        },
+        failed_conditions=failed,
+        conditions=proof.conditions,
+        requested_view_mode=intent.view_mode,
+        materialize_reason=materialize_reason,
+        proof=proof,
+        suggested_policy=(
+            {"layout.view_mode": "prefer"}
+            if intent.view_mode == "require"
+            else {"layout.allow_materialize_copy": True}
+        ),
+    )
+
+
+def resolve_view(
+    contract: ViewContract,
+    capability: ViewCapability,
+    intent: ViewIntent,
+    geometry: Optional[ViewGeometry] = None,
+    lifetime: Optional[ViewLifetime] = None,
+    overlap: Optional[ViewOverlap] = None
+) -> ViewResolution:
+    """Resolve ``forbid | prefer | require`` against the alias proof.
+
+    * ``require`` + proven -> ``view`` with zero copy bytes;
+    * ``require`` + not proven -> structured ``ALIAS_PROOF_UNAVAILABLE``
+      (never a silent copy);
+    * ``prefer`` + proven -> ``view``; otherwise an explicit materialize when
+      the contract, ``allow_materialize_copy`` and ``max_copy_bytes`` allow
+      it, else ``ALIAS_PROOF_UNAVAILABLE``;
+    * ``forbid`` -> an explicit independent destination (materialized); a
+      ``must_alias`` contract makes ``forbid`` contradictory and it fails.
+    """
+
+    if not isinstance(contract, ViewContract):
+        raise TypeError("resolve_view requires a ViewContract")
+    if not isinstance(capability, ViewCapability):
+        raise TypeError("resolve_view requires a ViewCapability")
+    if not isinstance(intent, ViewIntent):
+        raise TypeError("resolve_view requires a ViewIntent")
+
+    requested = intent.view_mode
+    if not capability.supports_view_mode(requested):
+        proof = prove_view(contract, capability, geometry, lifetime, overlap)
+        raise ViewResolutionError(
+            "backend {!r} does not support layout.view_mode={!r}".format(
+                capability.backend, requested
+            ),
+            code="ALIAS_PROOF_UNAVAILABLE",
+            field="layout.view_mode",
+            reason=VIEW_MODE_NOT_SUPPORTED,
+            available={
+                "supported_view_modes": list(capability.supported_view_modes),
+                "backend": capability.backend,
+                "alias_proof": capability.alias_proof,
+                "capability_reason": capability.reason,
+            },
+            failed_conditions=("contract_view_obligation",),
+            conditions=proof.conditions,
+            requested_view_mode=requested,
+            proof=proof,
+            suggested_policy={"layout.view_mode": "prefer"},
+        )
+
+    proof = prove_view(contract, capability, geometry, lifetime, overlap)
+    materialize_allowed, materialize_reason = _materialize_allowed(contract, intent)
+
+    if contract.view_obligation == "must_not_alias":
+        if requested == "require":
+            raise _alias_failure(
+                "layout.view_mode=require cannot be satisfied: contract "
+                "view_obligation=must_not_alias",
+                contract,
+                capability,
+                proof,
+                intent,
+                materialize_allowed,
+                materialize_reason,
+                CONTRACT_FORBIDS_VIEW,
