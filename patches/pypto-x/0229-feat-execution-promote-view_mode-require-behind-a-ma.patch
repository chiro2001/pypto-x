@@ -0,0 +1,704 @@
+"""U1 view_mode / alias-proof evidence: proof conditions, three-state
+semantics and adversarial lifetime/overlap cases.
+
+The proof chain lives in :mod:`pypto.alias` and is consumed by both the U1
+matmul resolver and the native AVX-512 layout executor.  These tests pin:
+
+* each of the five 0006 section 7.1 conditions individually (what fails, with
+  which machine-readable rejection code);
+* ``forbid | prefer | require`` resolution, including the fail-closed
+  ``ALIAS_PROOF_UNAVAILABLE`` path (never a silent copy);
+* the U1 matmul integration (``must_not_alias`` -> not applicable, ``require``
+  fails closed) and the report/plan fields;
+* the adversarial family: write-after-read, release-while-live, output alias,
+  overlapping views, view interleaved with an effectful op, caller-owned
+  export held while the SSA value is released.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from pypto.alias import (
+    ALIAS_PROOF_STATUSES,
+    VIEW_MODES,
+    AliasProof,
+    ViewCapability,
+    ViewContract,
+    ViewGeometry,
+    ViewIntent,
+    ViewLifetime,
+    ViewOverlap,
+    ViewRange,
+    ViewResolutionError,
+    WriteAccess,
+    prove_view,
+    resolve_view,
+)
+from pypto.execution import (
+    ALIAS_PROOF_UNAVAILABLE,
+    OP_CONTRACT_INVALID,
+    POLICY_CONFLICT,
+    POLICY_INVALID_VALUE,
+    AliasProofUnavailableError,
+    CapabilitySnapshot,
+    ExecutionPolicy,
+    LayoutPolicy,
+    execute_matmul,
+    plan_matmul,
+    policy_from_dict,
+)
+from pypto.backends.cpu import HostTensor
+
+
+# ---------------------------------------------------------------------------
+# shared facts
+# ---------------------------------------------------------------------------
+def _capability(**overrides):
+    base = {
+        "backend": "test.avx512",
+        "alias_proof": "supported",
+        "stride_class": "contiguous_identity",
+        "supported_view_modes": VIEW_MODES,
+        "max_rank": 4,
+        "supports_offset": False,
+        "supports_step": False,
+    }
+    base.update(overrides)
+    return ViewCapability(**base)
+
+
+def _contract(**overrides):
+    base = {
+        "opcode": "reshape",
+        "view_obligation": "may_alias",
+        "allows_materialize_copy": True,
+        "copy_bytes": 64,
+        "max_copy_bytes": None,
+    }
+    base.update(overrides)
+    return ViewContract(**base)
+
+
+def _geometry(**overrides):
+    base = {
+        "source_shape": (4, 4),
+        "view_shape": (2, 8),
+        "source_strides": (4, 1),
+        "view_strides": (8, 1),
+        "offset_elements": 0,
+        "itemsize": 4,
+        "view_steps": (),
+    }
+    base.update(overrides)
+    return ViewGeometry(**base)
+
+
+def _lifetime(**overrides):
+    base = {
+        "view_start": 1,
+        "view_last_use": 3,
+        "source_last_use": 1,
+        "source_is_caller_owned": False,
+        "source_owner_retained": True,
+        "release_while_view_live": False,
+        "writes": (),
+        "writes_known": True,
+    }
+    base.update(overrides)
+    return ViewLifetime(**base)
+
+
+def _overlap(**overrides):
+    base = {
+        "new_view": ViewRange("view", 0, 64, writable=False, live_start=1, live_end=3),
+        "existing_views": (),
+        "coverage_known": True,
+    }
+    base.update(overrides)
+    return ViewOverlap(**base)
+
+
+def _prove(contract=None, capability=None, geometry=None, lifetime=None, overlap=None):
+    return prove_view(
+        contract or _contract(),
+        capability or _capability(),
+        geometry or _geometry(),
+        lifetime or _lifetime(),
+        overlap or _overlap(),
+    )
+
+
+def _resolve(view_mode, contract=None, capability=None, geometry=None, lifetime=None,
+             overlap=None, allow_materialize_copy=True, max_copy_bytes=None):
+    return resolve_view(
+        contract or _contract(),
+        capability or _capability(),
+        ViewIntent(
+            view_mode=view_mode,
+            allow_materialize_copy=allow_materialize_copy,
+            max_copy_bytes=max_copy_bytes,
+        ),
+        geometry or _geometry(),
+        lifetime or _lifetime(),
+        overlap or _overlap(),
+    )
+
+
+def _failed(proof):
+    return list(proof.failed_conditions)
+
+
+# ---------------------------------------------------------------------------
+# proof conditions
+# ---------------------------------------------------------------------------
+def test_proven_proof_records_all_five_conditions_and_is_deterministic():
+    first = _prove()
+    second = _prove()
+    assert first.status == "proven"
+    assert [item.name for item in first.conditions] == [
+        "contract_view_obligation",
+        "stride_shape_expressible",
+        "write_after_read",
+        "owner_lifetime",
+        "multi_view_overlap",
+    ]
+    assert all(item.status == "passed" for item in first.conditions)
+    assert first.failed_conditions == ()
+    assert first.digest == second.digest
+    assert first.digest.startswith("sha256:")
+
+
+def test_contract_condition_must_not_alias_is_not_a_view_candidate():
+    proof = _prove(contract=_contract(view_obligation="must_not_alias"))
+    assert proof.status == "not_applicable"
+    assert proof.reason == "contract_requires_distinct_storage"
+    assert proof.conditions[0].code == "contract_requires_distinct_storage"
+    assert proof.failed_conditions == ()
+
+
+@pytest.mark.parametrize(
+    "geometry, expected_code",
+    (
+        # non-contiguous output strides for the contiguous_identity class
+        (dict(view_strides=(16, 1)), "view_stride_not_representable"),
+        # non-zero offset without backend offset support
+        (dict(offset_elements=1), "view_offset_not_representable"),
+        # non-unit step without backend step support
+        (dict(view_steps=(2, 1)), "view_step_not_representable"),
+        # element count mismatch
+        (dict(view_shape=(2, 7)), "view_element_count_mismatch"),
+    ),
+)
+def test_stride_shape_condition_rejections(geometry, expected_code):
+    proof = _prove(geometry=_geometry(**geometry))
+    assert proof.status == "rejected"
+    assert _failed(proof) == ["stride_shape_expressible"]
+    assert proof.conditions[1].code == expected_code
+
+
+def test_stride_shape_rank_and_capability_class_rejections():
+    proof = _prove(capability=_capability(max_rank=1))
+    assert _failed(proof) == ["stride_shape_expressible"]
+    assert proof.conditions[1].code == "view_rank_exceeds_capability"
+
+    unsupported_class = _prove(capability=_capability(stride_class="none"))
+    assert unsupported_class.conditions[1].code == "stride_class_not_supported"
+
+    # An explicit-stride backend can represent a non-contiguous but
+    # self-non-overlapping view that the contiguous_identity class rejects;
+    # the proof is capability-driven.
+    explicit = _prove(
+        capability=_capability(stride_class="explicit_strides", supports_step=True),
+        geometry=_geometry(
+            source_shape=(4, 4),
+            view_shape=(4, 4),
+            source_strides=(4, 1),
+            view_strides=(1, 4),
+        ),
+    )
+    assert explicit.status == "proven"
+
+
+def test_write_after_read_rejects_writes_inside_the_live_view_range():
+    overlapping = _lifetime(writes=(WriteAccess(2, 0, 64, "inplace_update"),))
+    proof = _prove(lifetime=overlapping)
+    assert proof.status == "rejected"
+    assert _failed(proof) == ["write_after_read"]
+    assert proof.conditions[2].code == "source_written_while_view_live"
+
+    # A write to a proven-disjoint byte range while the view is live is safe.
+    disjoint = _lifetime(writes=(WriteAccess(2, 64, 128, "inplace_update"),))
+    assert _prove(lifetime=disjoint).status == "proven"
+
+    # A write after the view's last use is safe even if it overlaps.
+    after = _lifetime(view_last_use=2, writes=(WriteAccess(3, 0, 64, "inplace_update"),))
+    assert _prove(lifetime=after).status == "proven"
+
+
+def test_write_after_read_unknown_coverage_fails_closed():
+    proof = _prove(lifetime=_lifetime(writes_known=False))
+    assert proof.status == "rejected"
+    assert _failed(proof) == ["write_after_read"]
+    assert proof.conditions[2].code == "write_coverage_unknown"
+
+
+def test_owner_lifetime_condition_rejects_each_lifetime_hazard():
+    released = _prove(lifetime=_lifetime(release_while_view_live=True))
+    assert _failed(released) == ["owner_lifetime"]
+    assert released.conditions[3].code == "source_released_while_view_live"
+
+    caller_owned = _prove(
+        lifetime=_lifetime(source_is_caller_owned=True, source_owner_retained=False)
+    )
+    assert _failed(caller_owned) == ["owner_lifetime"]
+    assert caller_owned.conditions[3].code == "caller_owned_storage_not_retainable"
+
+    outlives = _prove(
+        lifetime=_lifetime(
+            view_start=1,
+            view_last_use=5,
+            source_last_use=1,
+            source_owner_retained=False,
+        )
+    )
+    assert _failed(outlives) == ["owner_lifetime"]
+    assert outlives.conditions[3].code == "view_outlives_source"
+
+    # Retaining the source owner object fixes the release-while-live case:
+    # view_last_use > source_last_use but the view keeps the storage alive.
+    retained = _prove(
+        lifetime=_lifetime(
+            view_start=1,
+            view_last_use=5,
+            source_last_use=1,
+            source_owner_retained=True,
+        )
+    )
+    assert retained.status == "proven"
+
+    # A caller-owned view is safe when the view explicitly retains the export.
+    caller_retained = _prove(
+        lifetime=_lifetime(source_is_caller_owned=True, source_owner_retained=True)
+    )
+    assert caller_retained.status == "proven"
+
+
+def test_multi_view_overlap_rejects_writable_overlap_and_proves_readonly_overlap():
+    writable = _prove(
+        overlap=_overlap(
+            new_view=ViewRange("view", 0, 64, writable=True, live_start=1, live_end=3),
+            existing_views=(ViewRange("other", 32, 96, writable=True, live_start=0, live_end=4),),
+        )
+    )
+    assert _failed(writable) == ["multi_view_overlap"]
+    assert writable.conditions[4].code == "view_overlap_writable"
+
+    readonly = _prove(
+        overlap=_overlap(
+            new_view=ViewRange("view", 0, 64, writable=False, live_start=1, live_end=3),
+            existing_views=(ViewRange("other", 32, 96, writable=False, live_start=0, live_end=4),),
+        )
+    )
+    assert readonly.status == "proven"
+
+    disjoint = _prove(
+        overlap=_overlap(
+            new_view=ViewRange("view", 0, 64, writable=True, live_start=1, live_end=3),
+            existing_views=(ViewRange("other", 64, 128, writable=True, live_start=1, live_end=3),),
+        )
+    )
+    assert disjoint.status == "proven"
+
+    # Views that never coexist can share bytes.
+    serial = _prove(
+        overlap=_overlap(
+            new_view=ViewRange("view", 0, 64, writable=True, live_start=5, live_end=6),
+            existing_views=(ViewRange("other", 0, 64, writable=True, live_start=1, live_end=3),),
+        )
+    )
+    assert serial.status == "proven"
+
+    unknown = _prove(overlap=_overlap(coverage_known=False))
+    assert _failed(unknown) == ["multi_view_overlap"]
+    assert unknown.conditions[4].code == "view_overlap_coverage_unknown"
+
+
+def test_unsupported_backend_proof_is_explicit():
+    capability = ViewCapability.unsupported("cpu.sve256.layout", "SVE256 never exports a view")
+    proof = _prove(capability=capability)
+    assert proof.status == "unsupported"
+    assert all(item.status == "unsupported" for item in proof.conditions)
+    assert proof.conditions[0].code == "backend_alias_proof_unsupported"
+
+
+# ---------------------------------------------------------------------------
+# three-state semantics
+# ---------------------------------------------------------------------------
+def test_forbid_always_materializes_a_distinct_destination():
+    result = _resolve("forbid")
+    assert result.resolved_view_mode == "materialized"
+    assert result.layout_copy_bytes == 64
+    assert result.materialize_allowed is True
+    assert result.alias_proof.status == "proven"  # preference did not affect the proof
+
+
+def test_prefer_uses_view_when_proven_and_materializes_when_not():
+    proven = _resolve("prefer")
+    assert proven.resolved_view_mode == "view"
+    assert proven.layout_copy_bytes == 0
+
+    rejected = _resolve("prefer", lifetime=_lifetime(writes=(WriteAccess(2, 0, 64),)))
+    assert rejected.resolved_view_mode == "materialized"
+    assert rejected.layout_copy_bytes == 64
+    assert rejected.alias_proof.status == "rejected"
+
+
+def test_require_uses_view_when_proven():
+    result = _resolve("require")
+    assert result.requested_view_mode == "require"
+    assert result.resolved_view_mode == "view"
+    assert result.layout_copy_bytes == 0
+
+
+@pytest.mark.parametrize(
+    "facts, expected_condition, expected_code",
+    (
+        (
+            {"geometry": _geometry(view_strides=(16, 1))},
+            "stride_shape_expressible",
+            "view_stride_not_representable",
+        ),
+        (
+            {"lifetime": _lifetime(writes=(WriteAccess(2, 0, 64),))},
+            "write_after_read",
+            "source_written_while_view_live",
+        ),
+        (
+            {"lifetime": _lifetime(writes_known=False)},
+            "write_after_read",
+            "write_coverage_unknown",
+        ),
+        (
+            {"lifetime": _lifetime(release_while_view_live=True)},
+            "owner_lifetime",
+            "source_released_while_view_live",
+        ),
+        (
+            {"lifetime": _lifetime(source_is_caller_owned=True, source_owner_retained=False)},
+            "owner_lifetime",
+            "caller_owned_storage_not_retainable",
+        ),
+        (
+            {
+                "overlap": _overlap(
+                    new_view=ViewRange("view", 0, 64, writable=True, live_start=1, live_end=3),
+                    existing_views=(
+                        ViewRange("other", 0, 64, writable=True, live_start=0, live_end=4),
+                    ),
+                )
+            },
+            "multi_view_overlap",
+            "view_overlap_writable",
+        ),
+    ),
+)
+def test_require_without_proof_fails_closed_naming_the_condition(facts, expected_condition, expected_code):
+    with pytest.raises(ViewResolutionError) as excinfo:
+        _resolve("require", **facts)
+    error = excinfo.value
+    assert error.code == ALIAS_PROOF_UNAVAILABLE
+    assert expected_condition in error.failed_conditions
+    assert expected_code in {item.code for item in error.conditions if item.status == "failed"}
+    # The structured payload never turns the failure into a materialized copy.
+    assert error.requested_view_mode == "require"
+
+
+def test_require_on_a_must_not_alias_contract_fails_closed():
+    with pytest.raises(ViewResolutionError) as excinfo:
+        _resolve("require", contract=_contract(view_obligation="must_not_alias"))
+    error = excinfo.value
+    assert error.code == ALIAS_PROOF_UNAVAILABLE
+    assert error.failed_conditions == ("contract_view_obligation",)
+    assert error.reason == "contract_requires_distinct_storage"
+
+
+def test_prefer_on_a_must_not_alias_contract_is_not_applicable():
+    for mode in ("forbid", "prefer"):
+        result = _resolve(mode, contract=_contract(view_obligation="must_not_alias"))
+        assert result.resolved_view_mode == "not_applicable"
+        assert result.layout_copy_bytes == 0
+
+
+def test_forbid_on_a_must_alias_contract_is_a_policy_conflict():
+    with pytest.raises(ViewResolutionError) as excinfo:
+        _resolve("forbid", contract=_contract(view_obligation="must_alias"))
+    assert excinfo.value.code == POLICY_CONFLICT
+    assert excinfo.value.reason == "contract_requires_storage_alias"
+
+
+def test_prefer_materialize_permission_and_budget_are_enforced():
+    rejected = {"lifetime": _lifetime(writes=(WriteAccess(2, 0, 64),))}
+    with pytest.raises(ViewResolutionError) as no_permission:
+        _resolve("prefer", allow_materialize_copy=False, **rejected)
+    assert no_permission.value.materialize_reason == "allow_materialize_copy_false"
+
+    with pytest.raises(ViewResolutionError) as contract_forbids:
+        _resolve("prefer", contract=_contract(allows_materialize_copy=False), **rejected)
+    assert contract_forbids.value.materialize_reason == "contract_forbids_materialize_copy"
+
+    with pytest.raises(ViewResolutionError) as budget:
