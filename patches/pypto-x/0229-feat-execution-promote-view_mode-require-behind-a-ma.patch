+def test_u1_layout_policy_is_digestible_and_validated():
+    policy = ExecutionPolicy(layout=LayoutPolicy(view_mode="prefer", max_copy_bytes=1024))
+    assert policy_from_dict(policy.to_dict()).digest == policy.digest
+    assert policy.to_dict()["layout"]["view_mode"] == "prefer"
+    for builder in (
+        lambda: LayoutPolicy(view_mode="allow_view"),
+        lambda: LayoutPolicy(allow_materialize_copy="yes"),
+        lambda: LayoutPolicy(max_copy_bytes=-1),
+    ):
+        with pytest.raises(Exception) as excinfo:
+            builder()
+        assert getattr(excinfo.value, "code", None) == POLICY_INVALID_VALUE
+
+    # The stable spelling is layout.view_mode; the old top-level kwarg stays
+    # fail-closed with a hint instead of silently becoming an alias.
+    with pytest.raises(Exception) as direct:
+        ExecutionPolicy(view_mode="prefer")
+    assert getattr(direct.value, "code", None) == "POLICY_FIELD_NOT_APPLICABLE"
+
