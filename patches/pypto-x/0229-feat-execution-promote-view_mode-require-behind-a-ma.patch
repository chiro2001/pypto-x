+        functions=(CoreFunction("two_views", (source,), (output,), Region(operations)),)
+    )
+    _target_ir, artifact = _compile(program, tmp_path, "two-views")
+    tensor = HostTensor("float32", (3, 5), [float(index + 1) for index in range(15)])
+    native = _raw_array("float32", [0] * 15)
+    reference = _raw_array("float32", [0] * 15)
+    avx512_runtime.reset_layout_native_stats()
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[tensor.descriptor(readonly=True)],
+            outputs=[_descriptor("float32", (15,), native)],
+        )
+    )
+    _HostReferenceAvx512().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[tensor.descriptor(readonly=True)],
+            outputs=[_descriptor("float32", (15,), reference)],
+        )
+    )
+    stats = avx512_runtime.layout_native_stats()
+    # Two overlapping read-only views of the same owner are proven safe and
+    # both zero-copy; no layout kernel runs.
+    assert stats["view_alias_enabled"] == 2
+    assert stats["view_alias_rejections"] == 0
+    assert stats["kernel_calls"] == 0
+    assert _buffer_sha256(native) == _buffer_sha256(reference)
+    decisions = avx512_runtime.layout_view_alias_decisions()
+    assert [item["resolved_view_mode"] for item in decisions] == ["view", "view"]
+    for item in decisions:
+        assert item["alias_proof"]["conditions"][4]["status"] == "passed"
+
+
+def test_layout_view_holder_keeps_source_storage_alive_after_ssa_release(tmp_path, monkeypatch):
+    runtime = _runtime()
+    parameter = ValueRef("parameter", CoreType.tensor("float32", (3, 5)))
+    source = ValueRef("source", CoreType.tensor("float32", (3, 5)))
+    middle = ValueRef("middle", CoreType.tensor("float32", (5, 3)))
+    output = ValueRef("output", CoreType.tensor("float32", (5, 3)))
+    operations = (
+        Operation("neg", (parameter,), (source,)),
+        Operation("reshape", (source,), (middle,), {"shape": [5, 3]}),
+        Operation("neg", (middle,), (output,)),
+    )
+    program = CoreProgram(
+        functions=(CoreFunction("view_lifetime", (parameter,), (output,), Region(operations)),)
+    )
+    _target_ir, artifact = _compile(program, tmp_path, "alias-lifetime")
+    released = []
+    original = avx512_runtime.release_dead_values
+
+    def spy_release(environment, last_use, pinned, index, used_names, produced_names):
+        result = original(environment, last_use, pinned, index, used_names, produced_names)
+        released.append(result)
+        return result
+
+    monkeypatch.setattr(avx512_runtime, "release_dead_values", spy_release)
+    avx512_runtime.reset_layout_native_stats()
+    tensor = HostTensor("float32", (3, 5), [float(index + 1) for index in range(15)])
+    native = _raw_array("float32", [0] * 15)
+    reference = _raw_array("float32", [0] * 15)
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[tensor.descriptor(readonly=True)],
+            outputs=[_descriptor("float32", (5, 3), native)],
+        )
+    )
+    _HostReferenceAvx512().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[tensor.descriptor(readonly=True)],
+            outputs=[_descriptor("float32", (5, 3), reference)],
+        )
+    )
+    # The source SSA name is released right after the view is produced, yet
+    # the view still reads valid storage because the view buffer retains the
+    # source owner object.
+    assert ("source",) in released
+    assert avx512_runtime.layout_native_stats()["view_alias_enabled"] == 1
+    assert _buffer_sha256(native) == _buffer_sha256(reference)
+
+
