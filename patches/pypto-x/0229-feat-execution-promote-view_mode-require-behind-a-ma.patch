+# U1 matmul integration and report/plan fields
+# ---------------------------------------------------------------------------
+def _plan(mode="prefer", **policy_kwargs):
+    policy = ExecutionPolicy(layout=LayoutPolicy(view_mode=mode, **policy_kwargs))
+    return plan_matmul((2, 3), (3, 4), "float32", policy=policy)
+
+
+def test_u1_matmul_records_requested_view_mode_and_contract_proof():
+    result = _plan("prefer")
+    decision = result.plan.payload["layout_decision"]
+    assert decision["requested_view_mode"] == "prefer"
+    assert decision["resolved_view_mode"] == "not_applicable"
+    assert decision["view_obligation"] == "must_not_alias"
+    assert decision["alias_check"] == "contract_requires_distinct_storage"
+    assert decision["layout_copy_bytes"] == 0
+    assert decision["alias_proof"]["status"] == "not_applicable"
+    assert decision["alias_proof"]["failed_conditions"] == []
+    assert decision["alias_proof_digest"] == decision["alias_proof"]["digest"]
+    # The requested intent is also visible in the resolved policy block.
+    assert result.resolved_policy["layout"]["view_mode"] == "prefer"
+    assert result.plan.payload["policy"]["requested"]["layout"]["view_mode"] == "prefer"
+    # Same policy -> same plan digest (deterministic, recomputable).
+    assert _plan("prefer").plan.digest == result.plan.digest
+
+
+def test_u1_matmul_require_fails_closed_with_the_failed_condition():
+    with pytest.raises(AliasProofUnavailableError) as excinfo:
+        _plan("require")
+    error = excinfo.value
+    assert error.code == ALIAS_PROOF_UNAVAILABLE
+    assert error.reason == "contract_requires_distinct_storage"
+    details = error.to_dict()
+    assert details["details"]["failed_conditions"] == ["contract_view_obligation"]
+    assert details["details"]["conditions"][0]["code"] == "contract_requires_distinct_storage"
+
