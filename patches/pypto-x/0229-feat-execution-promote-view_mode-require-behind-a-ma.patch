+def test_adversarial_view_interleaved_with_effectful_update_is_rejected():
+    # A view is created at op 1; an effectful update consumes the source at op 2
+    # while the view is still live at op 3.  The write-after-read condition must
+    # reject the zero-copy candidate.
+    lifetime = _lifetime(
+        view_start=1,
+        view_last_use=3,
+        source_last_use=3,
+        writes=(WriteAccess(2, 0, 32, "effectful_update"),),
+    )
+    proof = _prove(lifetime=lifetime)
+    assert proof.status == "rejected"
+    assert _failed(proof) == ["write_after_read"]
+
+    # Interleaving a pure op is safe (no write fact).
+    pure = _prove(lifetime=_lifetime(view_start=1, view_last_use=3, writes=()))
+    assert pure.status == "proven"
+
+
+def test_adversarial_overlapping_views_are_rejected_unless_readonly():
+    writable_pair = _prove(
+        overlap=_overlap(
+            new_view=ViewRange("view-a", 0, 64, writable=True, live_start=1, live_end=3),
+            existing_views=(
+                ViewRange("view-b", 16, 48, writable=False, live_start=1, live_end=3),
+            ),
+        )
+    )
+    assert writable_pair.status == "rejected"
+    assert writable_pair.conditions[4].code == "view_overlap_writable"
+
+    readonly_pair = _prove(
+        overlap=_overlap(
+            new_view=ViewRange("view-a", 0, 64, writable=False, live_start=1, live_end=3),
+            existing_views=(
+                ViewRange("view-b", 16, 48, writable=False, live_start=1, live_end=3),
+            ),
+        )
+    )
+    assert readonly_pair.status == "proven"
+
+
+def test_adversarial_caller_owned_view_released_with_ssa_value_is_rejected():
+    # The source is a caller-owned export that the executor cannot retain: if
+    # the SSA value is released while the view is still read, data would dangle.
+    proof = _prove(
+        lifetime=_lifetime(
+            view_start=1,
+            view_last_use=4,
+            source_last_use=1,
+            source_is_caller_owned=True,
+            source_owner_retained=False,
+            release_while_view_live=True,
+        )
+    )
+    assert proof.status == "rejected"
+    assert "owner_lifetime" in _failed(proof)
+    codes = {item.code for item in proof.conditions if item.status == "failed"}
+    # The caller-owned export failure is reported first; a plain
+    # release-while-live case without caller ownership is covered in the
+    # owner_lifetime parametrized test above.
+    assert "caller_owned_storage_not_retainable" in codes
+
+    # Retaining the caller export (the AVX-512 view holds ``source.owner``)
+    # makes the same lifetime safe.
+    retained = _prove(
+        lifetime=_lifetime(
+            view_start=1,
+            view_last_use=4,
+            source_last_use=1,
+            source_is_caller_owned=True,
+            source_owner_retained=True,
+            release_while_view_live=False,
+        )
+    )
+    assert retained.status == "proven"
+
