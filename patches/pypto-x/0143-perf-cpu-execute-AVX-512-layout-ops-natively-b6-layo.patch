+        "slice", (3, 5), (2, 5), {"starts": [1], "stops": [3], "steps": [1], "axes": [0]}, "float32"
+    )
+    _slice_ir, _slice_artifact = _compile(slice_plan, tmp_path, "alias-slice")
+    ineligible, ineligible_reason = avx512_runtime._layout_view_alias_prefix(
+        _slice_ir.plans[0].layout_plan,
+        avx512_runtime._buffer_from_values("float32", [0.0] * 15, "alias"),
