+# --------------------------------------------------------------------------
+# concat
+# --------------------------------------------------------------------------
+
+
+def _concat_program(input_shapes, axis, dtype):
+    references = [
+        ValueRef("in{}".format(index), CoreType.tensor(dtype, shape))
+        for index, shape in enumerate(input_shapes)
+    ]
+    output_shape = list(input_shapes[0])
+    output_shape[axis] = sum(shape[axis] for shape in input_shapes)
+    output = ValueRef("output", CoreType.tensor(dtype, tuple(output_shape)))
+    operation = Operation("concat", tuple(references), (output,), {"axis": axis})
+    return CoreProgram(
+        functions=(
+            CoreFunction("concat", tuple(references), (output,), Region((operation,))),
+        )
+    )
+
+
+def _concat_cases():
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append((dtype, [(6,)], 0))
+        cases.append((dtype, [(2, 2, 3), (2, 3, 3)], 1))
+        cases.append((dtype, [(2, 4), (3, 4)], 0))
+        cases.append((dtype, [(2, 3, 2), (2, 3, 4)], 2))
+        cases.append((dtype, [(0, 4), (2, 4)], 0))
+    return cases
+
+
+@pytest.mark.parametrize("dtype,input_shapes,axis", _concat_cases(), ids=lambda value: str(value))
+def test_concat_native_matches_host_reference_bitwise(dtype, input_shapes, axis, tmp_path):
+    runtime = _runtime()
+    program = _concat_program(input_shapes, axis, dtype)
+    _target_ir, artifact = _compile(program, tmp_path, "concat-{}-{}".format(dtype, axis))
+    assert artifact.metadata["execution_modes"][0]["mode"] == NATIVE_CONCAT_MODE
+    entry = dict(artifact.metadata["layout_native_operations"][0])
+    assert entry["kernel"] == "concat_{}".format(
+        {"float32": "f32", "bf16": "bf16", "int8": "i8"}[dtype]
+    )
+    inputs = []
+    for index, shape in enumerate(input_shapes):
+        bits = _pattern_bits(dtype, element_count(shape), seed=7 + index)
+        inputs.append((dtype, shape, _raw_array(dtype, bits)))
+    output_shape = list(input_shapes[0])
+    output_shape[axis] = sum(shape[axis] for shape in input_shapes)
+    avx512_runtime.reset_layout_native_stats()
+    _assert_native_matches_reference(
+        artifact, inputs, [tuple(output_shape)], [dtype], runtime
+    )
+    assert avx512_runtime.layout_native_stats()["concat_calls"] == len(input_shapes)
+
+
+# --------------------------------------------------------------------------
+# fail-closed boundaries
+# --------------------------------------------------------------------------
+
+
+class _FakeLayout(object):
+    def __init__(self, kind, input_shape, output_shape):
+        self.kind = kind
+        self.input_shape = input_shape
+        self.output_shape = output_shape
+        self.source_elements = element_count(input_shape)
+        self.output_elements = element_count(output_shape)
+        self.source_strides = ()
+        self.permutation = tuple(range(len(input_shape)))
+        self.slice_starts = (0,) * len(input_shape)
+        self.slice_steps = (1,) * len(input_shape)
+        self.descriptor_digest = "0" * 64
+
+
+def test_unknown_layout_kind_is_rejected_before_native_execution():
+    with pytest.raises(CpuAvx512ExecutionError, match="unknown AVX-512 layout descriptor kind"):
+        avx512_runtime._layout_descriptor_bytes(_FakeLayout("bogus", (2, 3), (6,)))
+    with pytest.raises(CpuAvx512ExecutionError, match="rank exceeds"):
+        avx512_runtime._layout_descriptor_bytes(
+            _FakeLayout("logical_layout_copy", (1,) * 65, (1,) * 65)
+        )
+
+
+def test_corrupted_descriptor_is_rejected_and_counted(tmp_path, monkeypatch):
+    runtime = _runtime()
+    program = _layout_program("transpose", (2, 3, 4), (4, 3, 2), {"permutation": [2, 1, 0]}, "float32")
+    _target_ir, artifact = _compile(program, tmp_path, "corrupt")
+    payload, buffer = avx512_runtime._layout_descriptor_buffer(_target_ir.plans[0].layout_plan)
+    corrupted = (ctypes.c_ubyte * len(payload)).from_buffer_copy(payload)
+    corrupted[0] = 0x00  # break the "PXLD" magic
+    monkeypatch.setattr(
+        avx512_runtime,
+        "_layout_descriptor_buffer",
+        lambda layout: (bytes(payload), corrupted),
+    )
+    avx512_runtime.reset_layout_native_stats()
+    source = _raw_array("float32", _pattern_bits("float32", 24))
+    output = _raw_array("float32", [0] * 24)
+    with pytest.raises(CpuAvx512ExecutionError, match="rejected the descriptor"):
+        _launch_raw(
+            artifact, [("float32", (2, 3, 4), source)], [("float32", (4, 3, 2), output)], runtime
+        )
+    assert avx512_runtime.layout_native_stats()["descriptor_rejections"] == 1
+    assert output[0] == 0.0  # fail-closed: no partial result is returned
+
+
+def test_descriptor_digest_tampering_fails_closed(tmp_path):
+    runtime = _runtime()
+    program = _layout_program("reshape", (3, 5), (5, 3), {"shape": [5, 3]}, "float32")
+    _target_ir, artifact = _compile(program, tmp_path, "digest")
+    metadata = dict(artifact.metadata)
+    layout_operations = [dict(entry) for entry in metadata["layout_operations"]]
+    layout_operations[0]["descriptor_digest"] = "f" * 64
+    metadata["layout_operations"] = layout_operations
+    object.__setattr__(artifact, "metadata", metadata)
+    with pytest.raises(CpuAvx512ArtifactError, match="layout_operations"):
+        runtime.load(artifact)
+
+
+def test_declared_mode_tampering_fails_closed(tmp_path):
+    runtime = _runtime()
+    program = _layout_program("reshape", (3, 5), (5, 3), {"shape": [5, 3]}, "float32")
+    _target_ir, artifact = _compile(program, tmp_path, "mode")
+    metadata = dict(artifact.metadata)
+    modes = [dict(entry) for entry in metadata["execution_modes"]]
+    modes[0]["mode"] = "host_reference"
+    metadata["execution_modes"] = modes
+    object.__setattr__(artifact, "metadata", metadata)
+    with pytest.raises(CpuAvx512ArtifactError, match="execution_modes"):
+        runtime.load(artifact)
+
+
+def test_unsupported_dtype_is_an_explicit_host_fallback(tmp_path):
+    runtime = _runtime()
+    program = _layout_program("transpose", (2, 3, 4), (4, 3, 2), {"permutation": [2, 1, 0]}, "int32")
+    target_ir, artifact = _compile(program, tmp_path, "int32")
+    assert artifact.metadata["execution_modes"][0]["mode"] == "host_reference"
+    fallbacks = artifact.metadata["layout_native_fallback_operations"]
+    assert len(fallbacks) == 1
+    assert fallbacks[0]["operation"] == "transpose"
+    assert "dtype int32" in fallbacks[0]["reason"]
+    assert layout_native_fallback_reason(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    ) == fallbacks[0]["reason"]
+    contract = layout_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is None
+    avx512_runtime.reset_layout_native_stats()
+    source = _raw_array("int32", _pattern_bits("int32", 24))
+    output = _raw_array("int32", [0] * 24)
+    _launch_raw(
+        artifact, [("int32", (2, 3, 4), source)], [("int32", (4, 3, 2), output)], runtime
+    )
+    assert avx512_runtime.layout_native_stats()["explicit_host_fallbacks"] == 1
+    assert output[0] == source[0]
