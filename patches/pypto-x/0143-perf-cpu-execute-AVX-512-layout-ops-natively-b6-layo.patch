+"""B6: native AVX-512 layout / split / concat execution plane.
+
+Every native execution is compared *bitwise* (full output buffer sha256) against
+the same artifact forced through the AVX-512 host reference, using raw ctypes
+buffers so NaN payloads are compared too.  The declaration/execution invariant
+is checked through artifact metadata: the mode and kernel a program declares
+are the ones the runtime dispatches, and everything outside the plane stays
+explicitly on ``host_reference`` (never a silent fallback).
+
+The layout / split / concat sections are independent: ``-k layout``,
+``-k split`` and ``-k concat`` each run on their own.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import struct
+
+import pytest
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cpu.x86 import Avx512Runtime, CpuAvx512ArtifactError, CpuAvx512ExecutionError
+from pypto.backends.cpu.x86 import avx512 as avx512_runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu_avx512 import (
+    NATIVE_CONCAT_MODE,
+    NATIVE_LAYOUT_MODE,
+    NATIVE_SPLIT_MODE,
+    Avx512Compiler,
+    layout_native_contract,
+    layout_native_fallback_reason,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import element_count
+from pypto.target import TargetSpec
+
+
+AVX512_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+)
+_CTYPES = {"float32": ctypes.c_float, "bf16": ctypes.c_uint16, "int8": ctypes.c_int8, "int32": ctypes.c_int32}
+_F32_SPECIAL = (
+    0x7F800001,  # signaling NaN, positive payload 1
+    0xFF800001,  # signaling NaN, negative payload 1
+    0x7F812345,
+    0xFF812345,
+    0x7FC00001,  # quiet NaN with payload
+    0xFFC12345,
+    0x7F800000,  # +inf
+    0xFF800000,  # -inf
+    0x00000001,  # subnormal
+    0x80000001,
+    0x7F7FFFFF,  # max finite
+    0x3F800000,
+    0xBF800000,
+    0x41200000,
+    0x00000000,
+)
+_BF16_SPECIAL = (
+    0x7F81,  # signaling NaN
+    0xFF81,
+    0x7FA1,
+    0xFFA1,
+    0x7FC1,  # quiet NaN
+    0xFFC1,
+    0x7F80,  # +inf
+    0xFF80,
+    0x0001,  # subnormal
+    0x8001,
+    0x7F7F,
+    0x3F80,
+    0xBF80,
+    0x4120,
+    0x0000,
+)
+
+
+def _runtime():
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+class _HostReferenceAvx512(Avx512Runtime):
+    """Force every layout/split/concat decision onto the AVX-512 host reference.
+
+    The artifact metadata keeps declaring the real (native) plane because it is
+    validated against the shared predicate; only the runtime decision is
+    overridden here, which is exactly the baseline this file diffs against.
+    """
+
+    def plan_execution(self, operation, plan, environment):
+        decision = dict(super().plan_execution(operation, plan, environment))
+        if decision.get("layout") is not None:
+            decision["mode"] = "host_reference"
+            decision["kernel"] = None
+            decision["layout"] = None
+        return decision
+
+
+def _compile(program, tmp_path, name):
+    compiler = Avx512Compiler()
+    target_ir = compiler.lower(program, AVX512_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx512", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+    return target_ir, artifact
+
+
+def _raw_array(dtype, bits):
+    array = (_CTYPES[dtype] * len(bits))()
+    for index, value in enumerate(bits):
+        if dtype == "float32":
+            ctypes.memmove(
+                ctypes.addressof(array) + 4 * index,
+                struct.pack("<I", int(value) & 0xFFFFFFFF),
+                4,
+            )
+        else:
+            array[index] = value
+    return array
+
+
+def _descriptor(dtype, shape, array, readonly=False):
+    return TensorDesc(
+        dtype, shape, device="cpu", address=ctypes.addressof(array), readonly=readonly
+    )
+
+
+def _launch_raw(artifact, inputs, outputs, runtime):
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_descriptor(dtype, shape, array, True) for dtype, shape, array in inputs],
+            outputs=[_descriptor(dtype, shape, array) for dtype, shape, array in outputs],
+        )
+    )
+
+
+def _buffer_sha256(array):
+    return hashlib.sha256(
+        ctypes.string_at(ctypes.addressof(array), ctypes.sizeof(array))
+    ).hexdigest()
+
+
+def _pattern_bits(dtype, count, seed=1):
+    if dtype == "float32":
+        special = _F32_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 2654435761 + index * 2246822519) & 0xFFFFFFFF)
+            for index in range(count)
+        ]
+    if dtype == "bf16":
+        special = _BF16_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 40503 + index * 16411) & 0xFFFF)
+            for index in range(count)
+        ]
+    return [((seed * 37 + index * 91) % 255) - 127 for index in range(count)]
+
+
+def _assert_native_matches_reference(artifact, inputs, output_shapes, dtypes, runtime):
+    native = [
+        _raw_array(dtype, [0] * element_count(shape))
+        for dtype, shape in zip(dtypes, output_shapes)
+    ]
+    reference = [
+        _raw_array(dtype, [0] * element_count(shape))
+        for dtype, shape in zip(dtypes, output_shapes)
+    ]
+    _launch_raw(
+        artifact,
+        inputs,
+        [(dtype, shape, array) for dtype, shape, array in zip(dtypes, output_shapes, native)],
+        runtime,
+    )
+    _launch_raw(
+        artifact,
+        inputs,
+        [(dtype, shape, array) for dtype, shape, array in zip(dtypes, output_shapes, reference)],
+        _HostReferenceAvx512(),
+    )
+    for left, right in zip(native, reference):
+        assert _buffer_sha256(left) == _buffer_sha256(right)
+
+
+# --------------------------------------------------------------------------
+# layout
+# --------------------------------------------------------------------------
+
+
+def _layout_program(name, input_shape, output_shape, attributes, dtype):
+    source = ValueRef("source", CoreType.tensor(dtype, input_shape))
+    output = ValueRef("output", CoreType.tensor(dtype, output_shape))
+    operation = Operation(name, (source,), (output,), dict(attributes))
+    return CoreProgram(
+        functions=(CoreFunction(name, (source,), (output,), Region((operation,))),)
+    )
+
+
+def _layout_cases():
+    """One entry per independent native-layout case: dtype/name/shapes/attrs."""
+
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append((dtype, "reshape", (3, 5), (5, 3), {"shape": [5, 3]}))
+        cases.append((dtype, "view", (2, 3, 4), (4, 6), {"shape": [4, 6]}))
+        cases.append((dtype, "contiguous", (2, 3), (2, 3), {}))
+        # Empty axes and odd (non 8/16-multiple) sizes.
+        cases.append((dtype, "reshape", (2, 0, 3), (0, 6), {"shape": [0, 6]}))
+        cases.append((dtype, "reshape", (7,), (7,), {"shape": [7]}))
+        # Rank-2 transpose keeps the existing packed plane; rank 3/4 use the
+        # generic descriptor kernel, including a non-trivial permutation.
+        cases.append((dtype, "transpose", (5, 7), (7, 5), {"permutation": [1, 0]}))
+        cases.append((dtype, "transpose", (2, 3, 5), (5, 2, 3), {"permutation": [2, 0, 1]}))
+        cases.append((dtype, "transpose", (2, 3, 5), (3, 2, 5), {"permutation": [1, 0, 2]}))
+        cases.append((dtype, "transpose", (2, 3, 4, 5), (4, 5, 2, 3), {"permutation": [2, 3, 0, 1]}))
+        cases.append((dtype, "transpose", (1, 3, 2, 5), (5, 2, 3, 1), {"permutation": [3, 2, 1, 0]}))
+        # Unit and non-unit step slices, a batch prefix, and an empty slice.
+        cases.append((dtype, "slice", (4, 7), (2, 7), {"starts": [1, 0], "stops": [4, 7], "steps": [2, 1]}))
+        cases.append((dtype, "slice", (5, 7), (3, 2), {"starts": [0, 1], "stops": [5, 7], "steps": [2, 3]}))
+        cases.append(
+            (
+                dtype,
+                "slice",
+                (2, 4, 6),
+                (2, 2, 3),
+                {"starts": [0, 1, 0], "stops": [2, 4, 6], "steps": [1, 2, 2], "axes": [0, 1, 2]},
+            )
+        )
+        cases.append((dtype, "slice", (3, 5), (0, 5), {"starts": [2], "stops": [2], "steps": [1], "axes": [0]}))
+    return cases
+
+
+def test_layout_native_metadata_declares_the_executed_kernel(tmp_path):
+    program = _layout_program("reshape", (2, 6), (3, 4), {"shape": [3, 4]}, "float32")
+    target_ir, artifact = _compile(program, tmp_path, "declared")
+    metadata = artifact.metadata
+    assert metadata["layout_native_kernel_version"] == 1
+    assert metadata["layout_descriptor_wire"] == "native:v1:pxld-v2"
+    assert metadata["execution_modes"][0]["mode"] == NATIVE_LAYOUT_MODE
+    entry = dict(metadata["layout_native_operations"][0])
+    assert entry["kernel"] == "layout_f32"
+    assert entry["kind"] == "logical_layout_copy"
+    assert entry["dtype"] == "float32"
+    contract = layout_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None
+    assert contract["mode"] == entry["mode"] == NATIVE_LAYOUT_MODE
+    assert contract["kernel"] == entry["kernel"]
+    assert "ptx_avx512_layout_f32" in tuple(metadata["native_helper_symbols"])
+    assert metadata["host_reference_operations"] == ()
+    assert metadata["layout_native_fallback_operations"] == ()
+
+
+@pytest.mark.parametrize(
+    "dtype,name,input_shape,output_shape,attributes",
+    _layout_cases(),
+    ids=lambda value: str(value) if not isinstance(value, (tuple, dict)) else "",
+)
+def test_layout_native_matches_host_reference_bitwise(
+    dtype, name, input_shape, output_shape, attributes, tmp_path
+):
+    runtime = _runtime()
+    program = _layout_program(name, input_shape, output_shape, attributes, dtype)
+    _target_ir, artifact = _compile(program, tmp_path, "{}-{}".format(dtype, name))
+    mode = artifact.metadata["execution_modes"][0]["mode"]
+    assert mode in (NATIVE_LAYOUT_MODE, "native_avx512_packed_transpose")
+    source = _raw_array(dtype, _pattern_bits(dtype, element_count(input_shape), seed=3))
+    _assert_native_matches_reference(
+        artifact, [(dtype, input_shape, source)], [output_shape], [dtype], runtime
+    )
+
+
+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_layout_special_nan_payloads_are_bit_identical(dtype, tmp_path):
+    runtime = _runtime()
+    specials = _F32_SPECIAL if dtype == "float32" else _BF16_SPECIAL
+    bits = [specials[index % len(specials)] for index in range(30)]
+    cases = (
+        ("reshape", (30,), (5, 6), {"shape": [5, 6]}),
+        ("transpose", (2, 3, 5), (5, 3, 2), {"permutation": [2, 1, 0]}),
+        ("slice", (5, 6), (4, 3), {"starts": [1, 0], "stops": [5, 6], "steps": [1, 2]}),
+    )
+    for index, (name, input_shape, output_shape, attributes) in enumerate(cases):
+        program = _layout_program(name, input_shape, output_shape, attributes, dtype)
+        _target_ir, artifact = _compile(program, tmp_path, "{}-{}".format(dtype, index))
+        source = _raw_array(dtype, bits)
+        _assert_native_matches_reference(
+            artifact, [(dtype, input_shape, source)], [output_shape], [dtype], runtime
+        )
+
+
+def test_rank2_packed_transpose_mode_is_unchanged(tmp_path):
