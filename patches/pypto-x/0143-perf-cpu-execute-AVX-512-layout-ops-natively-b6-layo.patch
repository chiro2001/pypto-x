+    # -- native layout / split / concat --------------------------------
+    def _execute_layout(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+    ) -> Mapping[str, _RuntimeValue]:
+        """Run one ``LayoutPlan`` descriptor in the compiled AVX-512 object."""
+
+        layout = decision["layout"]
+        inputs = list(decision["inputs"])
+        outputs = list(operation.outputs)
+        plan_layout = plan.layout_plan
+        if plan_layout is None or plan_layout.operation != decision["operation"]:
+            raise CpuAvx512ArtifactError("AVX-512 native layout plan is missing or mismatched")
+        if len(inputs) != 1 or len(outputs) != 1:
+            raise CpuAvx512ArtifactError("AVX-512 native layout requires exactly one input and output")
+        target_dtype = canonical_dtype(outputs[0].type.dtype)
+        if target_dtype != layout.get("dtype"):
+            raise CpuAvx512ArtifactError("AVX-512 native layout dtype disagrees with the contract")
+        if layout.get("descriptor_digest") != plan_layout.descriptor_digest:
+            _LAYOUT_NATIVE_STATS["descriptor_rejections"] += 1
+            raise CpuAvx512ArtifactError("AVX-512 native layout descriptor digest mismatch")
+        source = inputs[0].buffer
+        if source.dtype != target_dtype or source.count != plan_layout.source_elements:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 native layout source buffer does not match the descriptor"
+            )
+        count = plan_layout.output_elements
+        if count != int(plan.element_count):
+            raise CpuAvx512ArtifactError("AVX-512 native layout output count disagrees with the plan")
+        prefix_ok, _prefix_reason = _layout_view_alias_prefix(
+            plan_layout, source, target_dtype, count
+        )
+        if prefix_ok:
+            _LAYOUT_NATIVE_STATS["view_alias_candidates"] += 1
+        try:
+            payload, descriptor = _layout_descriptor_buffer(plan_layout)
+        except CpuAvx512RuntimeError:
+            _LAYOUT_NATIVE_STATS["descriptor_rejections"] += 1
+            raise
+        destination = _buffer_alloc(target_dtype, count, outputs[0].name)
+        status = _call_layout_kernel(
+            module, layout["kernel"], payload, descriptor, source, destination
+        )
+        if status != 0:
+            _LAYOUT_NATIVE_STATS["descriptor_rejections"] += 1
+            raise CpuAvx512ExecutionError(
+                "AVX-512 native layout kernel rejected the descriptor (status {})".format(status)
+            )
+        _LAYOUT_NATIVE_STATS["kernel_calls"] += 1
+        return {outputs[0].name: _RuntimeValue(outputs[0].type, destination)}
+
+    def _split_geometry(self, split: Any, output_index: int) -> Tuple[int, int, int, int, int]:
+        axis = int(split.axis)
+        outer = 1
+        for dimension in split.input_shape[:axis]:
+            outer *= int(dimension)
+        inner = 1
+        for dimension in split.input_shape[axis + 1:]:
+            inner *= int(dimension)
+        source_axis = int(split.input_shape[axis])
+        axis_size = int(split.sizes[output_index])
+        axis_offset = sum(int(size) for size in split.sizes[:output_index])
+        if outer * source_axis * inner != int(split.source_elements):
+            raise CpuAvx512ArtifactError("AVX-512 split geometry does not match the source elements")
+        if axis_offset < 0 or axis_offset + axis_size > source_axis:
+            raise CpuAvx512ArtifactError("AVX-512 split output offset is outside the axis")
+        return outer, inner, source_axis, axis_offset, axis_size
+
+    def _execute_split(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+    ) -> Mapping[str, _RuntimeValue]:
+        """Copy every split output segment natively (one kernel call per output)."""
+
+        layout = decision["layout"]
+        split = plan.split_plan
+        inputs = list(decision["inputs"])
+        outputs = list(operation.outputs)
+        if split is None or plan.operation != "split":
+            raise CpuAvx512ArtifactError("AVX-512 native split plan is missing or mismatched")
+        if len(inputs) != 1 or len(outputs) != len(split.sizes):
+            raise CpuAvx512ArtifactError("AVX-512 native split operand count does not match the plan")
+        dtype = canonical_dtype(inputs[0].type.dtype)
+        if dtype != layout.get("dtype") or layout.get("kind") != "split":
+            raise CpuAvx512ArtifactError("AVX-512 native split dtype disagrees with the contract")
+        if layout.get("descriptor_digest") != split.descriptor_digest:
+            raise CpuAvx512ArtifactError("AVX-512 native split descriptor digest mismatch")
+        source = inputs[0].buffer
+        if source.dtype != dtype or source.count != int(split.source_elements):
+            raise CpuAvx512ExecutionError("AVX-512 native split source buffer does not match the plan")
+        results: Dict[str, _RuntimeValue] = {}
+        for output_index, output_ref in enumerate(outputs):
+            if canonical_dtype(output_ref.type.dtype) != dtype:
+                raise CpuAvx512ArtifactError("AVX-512 native split output dtype disagrees")
+            outer, inner, source_axis, axis_offset, axis_size = self._split_geometry(
+                split, output_index
+            )
+            count = element_count(split.output_shapes[output_index])
+            if outer * axis_size * inner != count:
+                raise CpuAvx512ArtifactError("AVX-512 native split output count is inconsistent")
+            destination = _buffer_alloc(dtype, count, output_ref.name)
+            status = _call_split_kernel(
+                module,
+                layout["kernel"],
+                source,
+                destination,
+                outer,
+                inner,
+                source_axis,
+                axis_offset,
+                axis_size,
+            )
+            if status != 0:
+                _LAYOUT_NATIVE_STATS["descriptor_rejections"] += 1
+                raise CpuAvx512ExecutionError(
+                    "AVX-512 native split kernel rejected the geometry (status {})".format(status)
+                )
+            _LAYOUT_NATIVE_STATS["split_calls"] += 1
+            results[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+        return results
+
+    def _execute_concat(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+    ) -> Mapping[str, _RuntimeValue]:
+        """Copy every concat input segment into the output axis column natively."""
+
+        layout = decision["layout"]
+        concat = plan.concat_plan
+        inputs = list(decision["inputs"])
+        outputs = list(operation.outputs)
+        if concat is None or plan.operation != "concat":
+            raise CpuAvx512ArtifactError("AVX-512 native concat plan is missing or mismatched")
+        if len(outputs) != 1 or len(inputs) != len(concat.input_shapes):
+            raise CpuAvx512ArtifactError("AVX-512 native concat operand count does not match the plan")
+        dtype = canonical_dtype(outputs[0].type.dtype)
+        if dtype != layout.get("dtype") or layout.get("kind") != "concat":
+            raise CpuAvx512ArtifactError("AVX-512 native concat dtype disagrees with the contract")
+        if layout.get("descriptor_digest") != concat.descriptor_digest:
+            raise CpuAvx512ArtifactError("AVX-512 native concat descriptor digest mismatch")
+        axis = int(concat.axis)
+        output_shape = concat.output_shape
+        output_axis = int(output_shape[axis])
+        outer = 1
+        for dimension in output_shape[:axis]:
+            outer *= int(dimension)
+        inner = 1
+        for dimension in output_shape[axis + 1:]:
+            inner *= int(dimension)
+        destination = _buffer_alloc(dtype, int(concat.output_elements), outputs[0].name)
+        axis_offset = 0
+        for input_index, (value, shape) in enumerate(zip(inputs, concat.input_shapes)):
+            axis_size = int(concat.sizes[input_index])
+            input_count = element_count(shape)
+            if canonical_dtype(value.type.dtype) != dtype or value.buffer.dtype != dtype:
+                raise CpuAvx512ArtifactError("AVX-512 native concat input dtype disagrees")
+            if value.buffer.count != input_count or outer * axis_size * inner != input_count:
+                raise CpuAvx512ArtifactError("AVX-512 native concat input count is inconsistent")
+            status = _call_concat_kernel(
+                module,
+                layout["kernel"],
+                value.buffer,
+                destination,
+                outer,
+                inner,
+                output_axis,
+                axis_offset,
+                axis_size,
+            )
+            if status != 0:
+                _LAYOUT_NATIVE_STATS["descriptor_rejections"] += 1
+                raise CpuAvx512ExecutionError(
+                    "AVX-512 native concat kernel rejected the geometry (status {})".format(status)
+                )
+            _LAYOUT_NATIVE_STATS["concat_calls"] += 1
+            axis_offset += axis_size
+        if axis_offset != output_axis:
+            raise CpuAvx512ArtifactError("AVX-512 native concat axis segments do not cover the output")
+        return {outputs[0].name: _RuntimeValue(outputs[0].type, destination)}
+
