+def _rebuild_artifact(artifact, payload_updates=None, metadata_updates=None):
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    payload.update(payload_updates or {})
+    rebuilt_payload = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    metadata = dict(artifact.metadata)
+    metadata.update(metadata_updates or {})
+    metadata["payload_digest"] = hashlib.sha256(rebuilt_payload).hexdigest()
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=rebuilt_payload,
+        metadata=metadata,
+    )
+
+
+def _reduction_program(operation_name, input_shape, output_shape, axis):
+    input_type = CoreType.tensor("float32", input_shape)
+    output_type = CoreType.tensor("float32", output_shape)
+    x = ValueRef("x", input_type)
+    z = ValueRef("z", output_type)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                operation_name,
+                (x,),
+                (z,),
+                Region((Operation(operation_name, (x,), (z,), attributes={"axis": axis}),)),
+            ),
+        )
+    )
+
+
+def _matmul_program(m, k, n, dtype="float32"):
+    left_type = CoreType.tensor(dtype, (m, k))
+    right_type = CoreType.tensor(dtype, (k, n))
+    output_type = CoreType.tensor(dtype, (m, n))
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("out", output_type)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "matmul",
+                (left, right),
+                (output,),
+                Region((Operation("matmul", (left, right), (output,)),)),
+            ),
+        )
+    )
+
