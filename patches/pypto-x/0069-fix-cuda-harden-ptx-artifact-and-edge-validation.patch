+def _validate_ptx_version(value: Any) -> str:
+    """Validate the exact PTX version grammar and supported emitter range."""
+
+    if not isinstance(value, str) or not _PTX_VERSION_RE.fullmatch(value):
+        raise CudaPtxError("PTX version must be a plain N.N token")
+    if value not in _SUPPORTED_PTX_VERSIONS:
+        raise CudaPtxError(
+            "unsupported PTX version {!r}; supported versions: {}".format(
+                value, ", ".join(sorted(_SUPPORTED_PTX_VERSIONS))
+            )
+        )
+    return value
+
