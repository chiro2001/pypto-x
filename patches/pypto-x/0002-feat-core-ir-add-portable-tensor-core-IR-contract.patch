+"""PyPTO-X 目标无关 Core IR。
+
+该实验接口不会通过 ``pypto.__init__`` 顶层重导出；请显式使用
+``pypto.core_ir``。它只包含标准库实现，因此在没有 CANN/CUDA/ROCm 的环境
+中也可以构造、验证和序列化 CoreProgram。
+"""
+
+from .model import (
+    SCHEMA_VERSION,
+    Block,
+    CoreFunction,
+    CoreIRError,
+    CoreIRSerializationError,
+    CoreIRValidationError,
+    CoreProgram,
+    CoreType,
+    Effect,
+    Operation,
+    Region,
+    UnsupportedSchemaVersionError,
+    ValueRef,
+)
+
+__all__ = [
+    "SCHEMA_VERSION",
+    "Block",
+    "CoreFunction",
+    "CoreIRError",
+    "CoreIRSerializationError",
+    "CoreIRValidationError",
+    "CoreProgram",
+    "CoreType",
+    "Effect",
+    "Operation",
+    "Region",
+    "UnsupportedSchemaVersionError",
+    "ValueRef",
+]
