+"""Core IR model 的明确模块入口。
+
+保留此薄模块是为了让 adapter 可以选择 ``pypto.core_ir.ir``，同时让
+``pypto.core_ir`` 根包继续提供最常用的短导入路径。
+"""
+
+from .model import *  # noqa: F401,F403
diff --git a/python/pypto/core_ir/model.py b/python/pypto/core_ir/model.py
new file mode 100644
index 000000000..a62d41456
--- /dev/null
+++ b/python/pypto/core_ir/model.py
@@ -0,0 +1,698 @@
+"""目标无关 Core IR 的最小数据模型。
+
+这个模块刻意只依赖 Python 标准库。它描述 Tensor/Scalar/Shape/View/Tile
+等可移植语义，不导入 CANN、CUDA、ROCm 或 ``pypto_pro``。后端可以把这里的
+``CoreProgram`` 当作一次导出的、可验证的 SSA 程序输入。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+import json
+import math
+import os
+import re
+from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple, Union
+
+
+SCHEMA_VERSION = 1
+ShapeDim = Union[int, str]
+_MISSING = object()
+_NAME_RE = re.compile(r"^(?:%[A-Za-z0-9_.$-]+|[A-Za-z_][A-Za-z0-9_.$-]*)$")
+_SYMBOL_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_.$-]*$")
+
+
+class CoreIRError(ValueError):
+    """Core IR 输入或序列化格式无效。"""
+
+
+class CoreIRValidationError(CoreIRError):
+    """Core IR 的结构或 SSA 引用验证失败。"""
+
+
+class CoreIRSerializationError(CoreIRError):
+    """Core IR 的 JSON 表示无效。"""
+
+
+class UnsupportedSchemaVersionError(CoreIRSerializationError):
+    """输入使用当前实现不认识的 schema version。"""
+
+
+def _ensure_mapping(value: Any, context: str) -> Mapping[str, Any]:
+    if not isinstance(value, Mapping):
+        raise CoreIRSerializationError("%s 必须是 JSON object" % context)
+    return value
+
+
+def _ensure_keys(value: Mapping[str, Any], required: Sequence[str], context: str) -> None:
+    missing = [key for key in required if key not in value]
+    if missing:
+        raise CoreIRSerializationError("%s 缺少字段: %s" % (context, ", ".join(missing)))
+
+
+def _ensure_name(value: Any, context: str) -> str:
+    if not isinstance(value, str) or not value or not _NAME_RE.fullmatch(value):
+        raise CoreIRValidationError("%s 必须是稳定的 SSA 名称" % context)
+    return value
+
+
+def _ensure_symbol(value: Any, context: str) -> str:
+    if not isinstance(value, str) or not value or not _SYMBOL_RE.fullmatch(value):
+        raise CoreIRValidationError("%s 必须是稳定的 shape 符号名" % context)
+    return value
+
+
+def _canonical_sort_key(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _canonicalize(value: Any, context: str = "value") -> Any:
+    """复制并规范化可放入 attributes/metadata 的 JSON 值。
+
+    ``set`` 不是 JSON 类型，但在 Python 端作为 capability 或标签集合很常见。
+    它在这里被明确变成按 canonical JSON key 排序的数组，避免进程级哈希随机化
+    影响 IR dump。
+    """
+
+    if isinstance(value, Enum):
+        return _canonicalize(value.value, context)
+    if value is None or isinstance(value, (str, bool, int)):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise CoreIRError("%s 不能包含 NaN 或无穷大" % context)
+        return value
+    if isinstance(value, Mapping):
+        normalized: Dict[str, Any] = {}
+        for key, item in value.items():
+            if not isinstance(key, str):
+                raise CoreIRError("%s 的 object key 必须是字符串" % context)
+            normalized[key] = _canonicalize(item, "%s.%s" % (context, key))
+        return normalized
+    if isinstance(value, (set, frozenset)):
+        values = [_canonicalize(item, "%s[]" % context) for item in value]
+        return sorted(values, key=_canonical_sort_key)
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize(item, "%s[]" % context) for item in value]
+    raise CoreIRError("%s 含有不支持的值类型 %s" % (context, type(value).__name__))
+
+
+def _as_tuple(value: Optional[Iterable[Any]], context: str) -> Tuple[Any, ...]:
+    if value is None:
+        return ()
+    if isinstance(value, (str, bytes)):
+        raise CoreIRError("%s 必须是序列而不是字符串" % context)
+    try:
+        return tuple(value)
+    except TypeError as exc:
+        raise CoreIRError("%s 必须是可迭代序列" % context) from exc
+
+
+class Effect(str, Enum):
+    """操作对外部状态的可移植 effect 分类。"""
+
+    PURE = "pure"
+    READ = "read"
+    WRITE = "write"
+    READ_WRITE = "read_write"
+    BARRIER = "barrier"
+
+    # lowercase aliases make ``Effect.pure`` convenient without creating额外值。
+    pure = PURE
+    read = READ
+    write = WRITE
+    read_write = READ_WRITE
+    barrier = BARRIER
+
+
+@dataclass(frozen=True)
+class CoreType:
+    """目标无关值类型。
+
+    ``kind`` 由前端约定为 ``tensor``、``scalar``、``shape``、``view`` 或
+    ``tile`` 等目标无关类别；这里不封死未来可移植类别。shape 维度只能是
+    非负整数或稳定符号名。
+    """
+
+    kind: str
+    dtype: Optional[str] = None
+    shape: Tuple[ShapeDim, ...] = field(default_factory=tuple)
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.kind, str) or not self.kind or any(ch.isspace() for ch in self.kind):
+            raise CoreIRValidationError("CoreType.kind 必须是非空字符串")
+        dtype = self.dtype
+        if dtype is not None and not isinstance(dtype, str):
+            # 上游 DataType 在不同构建中可能是 enum；只接受其稳定 value/name，
+            # 不把 enum 对象本身带进 canonical JSON。
+            candidate = getattr(dtype, "value", _MISSING)
+            if isinstance(candidate, str):
+                dtype = candidate
+            else:
+                raise CoreIRValidationError("CoreType.dtype 必须是字符串或带字符串 value 的 enum")
+            object.__setattr__(self, "dtype", dtype)
+        if dtype is not None and (not dtype or any(ch.isspace() for ch in dtype)):
+            raise CoreIRValidationError("CoreType.dtype 必须是非空、无空白字符串")
+        dimensions = _as_tuple(self.shape, "CoreType.shape")
+        normalized: List[ShapeDim] = []
+        for index, dimension in enumerate(dimensions):
+            if isinstance(dimension, bool):
+                raise CoreIRValidationError("CoreType.shape[%d] 不能是 bool" % index)
+            if isinstance(dimension, int):
+                if dimension < 0:
+                    raise CoreIRValidationError("CoreType.shape[%d] 不能为负数" % index)
+                normalized.append(dimension)
+            elif isinstance(dimension, str):
+                normalized.append(_ensure_symbol(dimension, "CoreType.shape[%d]" % index))
+            else:
+                raise CoreIRValidationError("CoreType.shape[%d] 必须是整数或字符串" % index)
+        object.__setattr__(self, "shape", tuple(normalized))
+
+    @classmethod
+    def tensor(cls, dtype: str, shape: Sequence[ShapeDim]) -> "CoreType":
+        return cls("tensor", dtype, tuple(shape))
+
+    @classmethod
+    def scalar(cls, dtype: str) -> "CoreType":
+        return cls("scalar", dtype, ())
+
+    @classmethod
+    def shape_value(cls, shape: Sequence[ShapeDim], dtype: str = "index") -> "CoreType":
+        return cls("shape", dtype, tuple(shape))
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {"kind": self.kind, "dtype": self.dtype, "shape": list(self.shape)}
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "CoreType":
+        data = _ensure_mapping(value, "CoreType")
+        _ensure_keys(data, ("kind", "dtype", "shape"), "CoreType")
+        shape = data["shape"]
+        if not isinstance(shape, (list, tuple)):
+            raise CoreIRSerializationError("CoreType.shape 必须是数组")
+        return cls(data["kind"], data["dtype"], tuple(shape))
+
+
+@dataclass(frozen=True, init=False)
+class ValueRef:
+    """函数内稳定的 SSA value 引用。"""
+
+    name: str
+    type: CoreType
+
+    def __init__(
+        self,
+        name: str,
+        type: Optional[CoreType] = None,
+        value_type: Optional[CoreType] = None,
+        type_: Optional[CoreType] = None,
+    ) -> None:
+        candidates = [candidate for candidate in (type, value_type, type_) if candidate is not None]
+        if len(candidates) != 1 or not isinstance(candidates[0], CoreType):
+            raise CoreIRValidationError("ValueRef 需要且只能需要一个 CoreType")
+        object.__setattr__(self, "name", _ensure_name(name, "ValueRef.name"))
+        object.__setattr__(self, "type", candidates[0])
+
+    @property
+    def value_type(self) -> CoreType:
+        """兼容使用 ``value_type`` 命名的 adapter。"""
+
+        return self.type
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {"name": self.name, "type": self.type.to_dict()}
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "ValueRef":
+        data = _ensure_mapping(value, "ValueRef")
+        _ensure_keys(data, ("name", "type"), "ValueRef")
+        return cls(data["name"], CoreType.from_dict(data["type"]))
+
+
+@dataclass(frozen=True, init=False)
+class Operation:
+    """一个目标无关 SSA 操作。"""
+
+    name: str
+    inputs: Tuple[ValueRef, ...]
+    outputs: Tuple[ValueRef, ...]
+    attributes: Mapping[str, Any]
+    effect: Effect
+    regions: Tuple["Region", ...]
+
+    def __init__(
+        self,
+        name: str,
+        inputs: Any = _MISSING,
+        outputs: Any = _MISSING,
+        attributes: Optional[Mapping[str, Any]] = None,
+        effect: Union[Effect, str] = Effect.PURE,
+        regions: Optional[Iterable["Region"]] = None,
+        *,
+        operands: Any = _MISSING,
+        results: Any = _MISSING,
+        attrs: Any = _MISSING,
+    ) -> None:
+        if inputs is _MISSING:
+            inputs = () if operands is _MISSING else operands
+        elif operands is not _MISSING:
+            raise CoreIRValidationError("Operation 不能同时指定 inputs 和 operands")
+        if outputs is _MISSING:
+            outputs = () if results is _MISSING else results
+        elif results is not _MISSING:
+            raise CoreIRValidationError("Operation 不能同时指定 outputs 和 results")
+        if attributes is None:
+            attributes = {} if attrs is _MISSING else attrs
+        elif attrs is not _MISSING:
+            raise CoreIRValidationError("Operation 不能同时指定 attributes 和 attrs")
+        if not isinstance(name, str) or not name or any(ch.isspace() for ch in name):
+            raise CoreIRValidationError("Operation.name 必须是非空、无空白字符串")
+        input_refs = _as_tuple(inputs, "Operation.inputs")
+        output_refs = _as_tuple(outputs, "Operation.outputs")
+        for index, ref in enumerate(input_refs):
+            if not isinstance(ref, ValueRef):
+                raise CoreIRValidationError("Operation.inputs[%d] 必须是 ValueRef" % index)
+        for index, ref in enumerate(output_refs):
+            if not isinstance(ref, ValueRef):
+                raise CoreIRValidationError("Operation.outputs[%d] 必须是 ValueRef" % index)
+        if not isinstance(attributes, Mapping):
+            raise CoreIRValidationError("Operation.attributes 必须是 mapping")
+        try:
+            normalized_effect = effect if isinstance(effect, Effect) else Effect(effect)
+        except (TypeError, ValueError) as exc:
+            raise CoreIRValidationError("未知 operation effect: %r" % (effect,)) from exc
+        child_regions = _as_tuple(regions, "Operation.regions")
+        for index, region in enumerate(child_regions):
+            if not isinstance(region, Region):
+                raise CoreIRValidationError("Operation.regions[%d] 必须是 Region" % index)
+        object.__setattr__(self, "name", name)
+        object.__setattr__(self, "inputs", tuple(input_refs))
+        object.__setattr__(self, "outputs", tuple(output_refs))
+        object.__setattr__(self, "attributes", _canonicalize(dict(attributes), "Operation.attributes"))
+        object.__setattr__(self, "effect", normalized_effect)
+        object.__setattr__(self, "regions", tuple(child_regions))
+
+    @property
+    def operands(self) -> Tuple[ValueRef, ...]:
+        return self.inputs
+
+    @property
+    def results(self) -> Tuple[ValueRef, ...]:
+        return self.outputs
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "name": self.name,
+            "inputs": [ref.to_dict() for ref in self.inputs],
+            "outputs": [ref.to_dict() for ref in self.outputs],
+            "attributes": _canonicalize(self.attributes, "Operation.attributes"),
+            "effect": self.effect.value,
+            "regions": [region.to_dict() for region in self.regions],
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "Operation":
+        data = _ensure_mapping(value, "Operation")
+        _ensure_keys(data, ("name",), "Operation")
+        inputs = data.get("inputs", data.get("operands", ()))
+        outputs = data.get("outputs", data.get("results", ()))
+        attributes = data.get("attributes", data.get("attrs", {}))
+        regions_data = data.get("regions", ())
+        if not isinstance(inputs, (list, tuple)) or not isinstance(outputs, (list, tuple)):
+            raise CoreIRSerializationError("Operation inputs/outputs 必须是数组")
+        if not isinstance(regions_data, (list, tuple)):
+            raise CoreIRSerializationError("Operation.regions 必须是数组")
+        return cls(
+            data["name"],
+            tuple(ValueRef.from_dict(item) for item in inputs),
+            tuple(ValueRef.from_dict(item) for item in outputs),
+            attributes,
+            data.get("effect", Effect.PURE.value),
+            tuple(Region.from_dict(item) for item in regions_data),
+        )
+
+    def _verify(self, available: Mapping[str, CoreType], context: str) -> Dict[str, CoreType]:
+        if len({ref.name for ref in self.inputs}) != len(self.inputs):
+            raise CoreIRValidationError("%s.inputs 含重复 SSA 引用" % context)
+        for index, ref in enumerate(self.inputs):
+            if ref.name not in available:
+                raise CoreIRValidationError("%s.inputs[%d] 引用了未定义值 %s" % (context, index, ref.name))
+            if available[ref.name] != ref.type:
+                raise CoreIRValidationError("%s.inputs[%d] 的类型与定义不一致" % (context, index))
+        output_names = [ref.name for ref in self.outputs]
+        if len(set(output_names)) != len(output_names):
+            raise CoreIRValidationError("%s.outputs 含重复 SSA 名称" % context)
+        for ref in self.outputs:
+            if ref.name in available:
+                raise CoreIRValidationError("%s.outputs 重定义了 SSA 值 %s" % (context, ref.name))
+        for index, region in enumerate(self.regions):
+            region._verify(available, "%s.regions[%d]" % (context, index))
+        updated = dict(available)
+        updated.update({ref.name: ref.type for ref in self.outputs})
+        return updated
+
+
+@dataclass(frozen=True, init=False)
+class Block:
+    """结构化 Region 中的一个有序 block。"""
+
+    arguments: Tuple[ValueRef, ...]
+    operations: Tuple[Operation, ...]
+    label: Optional[str]
+
+    def __init__(
+        self,
+        arguments: Optional[Iterable[ValueRef]] = None,
+        operations: Optional[Iterable[Operation]] = None,
+        label: Optional[str] = None,
+    ) -> None:
+        args = _as_tuple(arguments, "Block.arguments")
+        ops = _as_tuple(operations, "Block.operations")
+        for index, ref in enumerate(args):
+            if not isinstance(ref, ValueRef):
+                raise CoreIRValidationError("Block.arguments[%d] 必须是 ValueRef" % index)
+        for index, operation in enumerate(ops):
+            if not isinstance(operation, Operation):
+                raise CoreIRValidationError("Block.operations[%d] 必须是 Operation" % index)
+        if label is not None and (not isinstance(label, str) or not label or any(ch.isspace() for ch in label)):
+            raise CoreIRValidationError("Block.label 必须是非空、无空白字符串")
+        object.__setattr__(self, "arguments", tuple(args))
+        object.__setattr__(self, "operations", tuple(ops))
+        object.__setattr__(self, "label", label)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "label": self.label,
+            "arguments": [ref.to_dict() for ref in self.arguments],
+            "operations": [operation.to_dict() for operation in self.operations],
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "Block":
+        data = _ensure_mapping(value, "Block")
+        _ensure_keys(data, ("arguments", "operations"), "Block")
+        arguments = data["arguments"]
+        operations = data["operations"]
+        if not isinstance(arguments, (list, tuple)) or not isinstance(operations, (list, tuple)):
+            raise CoreIRSerializationError("Block.arguments/operations 必须是数组")
+        return cls(
+            tuple(ValueRef.from_dict(item) for item in arguments),
+            tuple(Operation.from_dict(item) for item in operations),
+            data.get("label"),
+        )
+
+
+@dataclass(frozen=True, init=False)
+class Region:
+    """有序 operation 或有序 block 的容器。"""
+
+    operations: Tuple[Operation, ...]
+    blocks: Tuple[Block, ...]
+
+    def __init__(
+        self,
+        operations: Optional[Iterable[Operation]] = None,
+        blocks: Optional[Iterable[Block]] = None,
+    ) -> None:
+        ops = _as_tuple(operations, "Region.operations")
+        block_values = _as_tuple(blocks, "Region.blocks")
+        for index, operation in enumerate(ops):
+            if not isinstance(operation, Operation):
+                raise CoreIRValidationError("Region.operations[%d] 必须是 Operation" % index)
+        for index, block in enumerate(block_values):
+            if not isinstance(block, Block):
+                raise CoreIRValidationError("Region.blocks[%d] 必须是 Block" % index)
+        if ops and block_values:
+            raise CoreIRValidationError("Region 不能同时使用直接 operations 和 blocks")
+        object.__setattr__(self, "operations", tuple(ops))
+        object.__setattr__(self, "blocks", tuple(block_values))
+
+    @property
+    def is_block_region(self) -> bool:
+        return bool(self.blocks)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "operations": [operation.to_dict() for operation in self.operations],
+            "blocks": [block.to_dict() for block in self.blocks],
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "Region":
+        data = _ensure_mapping(value, "Region")
+        operations = data.get("operations", ())
+        blocks = data.get("blocks", ())
+        if not isinstance(operations, (list, tuple)) or not isinstance(blocks, (list, tuple)):
+            raise CoreIRSerializationError("Region.operations/blocks 必须是数组")
+        return cls(
+            tuple(Operation.from_dict(item) for item in operations),
+            tuple(Block.from_dict(item) for item in blocks),
+        )
+
+    def _verify(self, available: Mapping[str, CoreType], context: str) -> bool:
+        if self.operations:
+            current = dict(available)
+            for index, operation in enumerate(self.operations):
+                current = operation._verify(current, "%s.operations[%d]" % (context, index))
+            return True
+        labels = set()
+        for index, block in enumerate(self.blocks):
+            if block.label is not None:
+                if block.label in labels:
+                    raise CoreIRValidationError("%s.blocks 含重复 label %s" % (context, block.label))
+                labels.add(block.label)
+            block_available = dict(available)
+            argument_names = [ref.name for ref in block.arguments]
+            if len(argument_names) != len(set(argument_names)):
+                raise CoreIRValidationError("%s.blocks[%d].arguments 含重复 SSA 名称" % (context, index))
+            block_available.update({ref.name: ref.type for ref in block.arguments})
+            for op_index, operation in enumerate(block.operations):
+                block_available = operation._verify(
+                    block_available,
+                    "%s.blocks[%d].operations[%d]" % (context, index, op_index),
+                )
+        return True
+
+
+@dataclass(frozen=True, init=False)
+class CoreFunction:
+    """一个 Core IR 函数及其参数、返回引用和 body。"""
+
+    name: str
+    parameters: Tuple[ValueRef, ...]
+    returns: Tuple[ValueRef, ...]
+    body: Region
+
+    def __init__(
+        self,
+        name: str,
+        parameters: Optional[Iterable[ValueRef]] = None,
+        returns: Optional[Iterable[ValueRef]] = None,
+        body: Optional[Region] = None,
+        *,
+        args: Optional[Iterable[ValueRef]] = None,
+        return_values: Optional[Iterable[ValueRef]] = None,
+        region: Optional[Region] = None,
+    ) -> None:
+        if parameters is not None and args is not None:
+            raise CoreIRValidationError("CoreFunction 不能同时指定 parameters 和 args")
+        if returns is not None and return_values is not None:
+            raise CoreIRValidationError("CoreFunction 不能同时指定 returns 和 return_values")
+        if body is not None and region is not None:
+            raise CoreIRValidationError("CoreFunction 不能同时指定 body 和 region")
+        parameters = parameters if parameters is not None else (args if args is not None else ())
+        returns = returns if returns is not None else (return_values if return_values is not None else ())
+        body = body if body is not None else (region if region is not None else Region())
+        if not isinstance(name, str) or not name or any(ch.isspace() for ch in name):
+            raise CoreIRValidationError("CoreFunction.name 必须是非空、无空白字符串")
+        params = _as_tuple(parameters, "CoreFunction.parameters")
+        result_refs = _as_tuple(returns, "CoreFunction.returns")
+        for index, ref in enumerate(params):
+            if not isinstance(ref, ValueRef):
+                raise CoreIRValidationError("CoreFunction.parameters[%d] 必须是 ValueRef" % index)
+        for index, ref in enumerate(result_refs):
+            if not isinstance(ref, ValueRef):
+                raise CoreIRValidationError("CoreFunction.returns[%d] 必须是 ValueRef" % index)
+        if not isinstance(body, Region):
+            raise CoreIRValidationError("CoreFunction.body 必须是 Region")
+        object.__setattr__(self, "name", name)
+        object.__setattr__(self, "parameters", tuple(params))
+        object.__setattr__(self, "returns", tuple(result_refs))
+        object.__setattr__(self, "body", body)
+
+    @property
+    def args(self) -> Tuple[ValueRef, ...]:
+        return self.parameters
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "name": self.name,
+            "parameters": [ref.to_dict() for ref in self.parameters],
+            "returns": [ref.to_dict() for ref in self.returns],
+            "body": self.body.to_dict(),
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "CoreFunction":
+        data = _ensure_mapping(value, "CoreFunction")
+        _ensure_keys(data, ("name", "parameters", "returns", "body"), "CoreFunction")
+        parameters = data["parameters"]
+        returns = data["returns"]
+        if not isinstance(parameters, (list, tuple)) or not isinstance(returns, (list, tuple)):
+            raise CoreIRSerializationError("CoreFunction.parameters/returns 必须是数组")
+        return cls(
+            data["name"],
+            tuple(ValueRef.from_dict(item) for item in parameters),
+            tuple(ValueRef.from_dict(item) for item in returns),
+            Region.from_dict(data["body"]),
+        )
+
+    def verify(self) -> bool:
+        parameter_names = [ref.name for ref in self.parameters]
+        if len(parameter_names) != len(set(parameter_names)):
+            raise CoreIRValidationError("函数 %s 的 parameters 含重复 SSA 名称" % self.name)
+        return_names = [ref.name for ref in self.returns]
+        if len(return_names) != len(set(return_names)):
+            raise CoreIRValidationError("函数 %s 的 returns 含重复 SSA 名称" % self.name)
+        available = {ref.name: ref.type for ref in self.parameters}
+        self.body._verify(available, "function %s.body" % self.name)
+        # Region 的 block 作用域不能简单泄漏到函数返回；允许返回值是参数，
+        # 或直接 body operations 产生的值。对 block-only region，返回 block
+        # 结果由后续结构化 op 负责显式传出，故这里只验证参数返回。
+        body_values = dict(available)
+        for operation in self.body.operations:
+            body_values = operation._verify(body_values, "function %s.body" % self.name)
+        for index, ref in enumerate(self.returns):
+            if ref.name not in body_values:
+                raise CoreIRValidationError("函数 %s.returns[%d] 引用了未定义值 %s" % (self.name, index, ref.name))
+            if body_values[ref.name] != ref.type:
+                raise CoreIRValidationError("函数 %s.returns[%d] 的类型与定义不一致" % (self.name, index))
+        return True
+
+
+@dataclass(frozen=True, init=False)
+class CoreProgram:
+    """可验证、可稳定序列化的 Core IR 程序。"""
+
+    schema_version: int
+    functions: Tuple[CoreFunction, ...]
+    metadata: Mapping[str, Any]
+
+    def __init__(
+        self,
+        schema_version: Any = SCHEMA_VERSION,
+        functions: Optional[Iterable[CoreFunction]] = None,
+        metadata: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        # 允许最自然的 CoreProgram([function]) 写法，同时保留 RFC 字段顺序
+        # CoreProgram(schema_version, functions, metadata)。
+        if not isinstance(schema_version, int) or isinstance(schema_version, bool):
+            if functions is None:
+                functions = schema_version
+                schema_version = SCHEMA_VERSION
+            else:
+                schema_version, functions = functions, schema_version
+        function_values = _as_tuple(functions, "CoreProgram.functions")
+        for index, function in enumerate(function_values):
+            if not isinstance(function, CoreFunction):
+                raise CoreIRValidationError("CoreProgram.functions[%d] 必须是 CoreFunction" % index)
+        if metadata is None:
+            metadata = {}
+        if not isinstance(metadata, Mapping):
+            raise CoreIRValidationError("CoreProgram.metadata 必须是 mapping")
+        object.__setattr__(self, "schema_version", schema_version)
+        object.__setattr__(self, "functions", tuple(function_values))
+        object.__setattr__(self, "metadata", _canonicalize(dict(metadata), "CoreProgram.metadata"))
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "schema_version": self.schema_version,
+            "functions": [function.to_dict() for function in self.functions],
+            "metadata": _canonicalize(self.metadata, "CoreProgram.metadata"),
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "CoreProgram":
+        data = _ensure_mapping(value, "CoreProgram")
+        _ensure_keys(data, ("schema_version", "functions", "metadata"), "CoreProgram")
+        version = data["schema_version"]
+        if not isinstance(version, int) or isinstance(version, bool):
+            raise CoreIRSerializationError("CoreProgram.schema_version 必须是整数")
+        if version != SCHEMA_VERSION:
+            raise UnsupportedSchemaVersionError(
+                "不支持 Core IR schema_version=%r，当前只支持 %d" % (version, SCHEMA_VERSION)
+            )
+        functions = data["functions"]
+        if not isinstance(functions, (list, tuple)):
+            raise CoreIRSerializationError("CoreProgram.functions 必须是数组")
+        return cls(
+            version,
+            tuple(CoreFunction.from_dict(item) for item in functions),
+            data["metadata"],
+        )
+
+    def verify(self) -> bool:
+        if self.schema_version != SCHEMA_VERSION:
+            raise UnsupportedSchemaVersionError(
+                "不支持 Core IR schema_version=%r，当前只支持 %d" % (self.schema_version, SCHEMA_VERSION)
+            )
+        function_names = [function.name for function in self.functions]
+        if len(function_names) != len(set(function_names)):
+            raise CoreIRValidationError("CoreProgram.functions 含重复函数名")
+        for function in self.functions:
+            function.verify()
+        return True
+
+    def canonical_json(self) -> str:
+        self.verify()
+        return json.dumps(
+            self.to_dict(),
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        )
+
+    # 常见命名的别名，均指向同一个 canonical UTF-8 JSON 文本。
+    dumps = canonical_json
+    to_json = canonical_json
+
+    @classmethod
+    def from_json(cls, value: Union[str, bytes, bytearray]) -> "CoreProgram":
+        try:
+            decoded = json.loads(value)
+        except (TypeError, ValueError) as exc:
+            raise CoreIRSerializationError("CoreProgram JSON 无法解析") from exc
+        return cls.from_dict(decoded)
+
+    loads = from_json
+
+    def dump(self, path: Optional[Union[str, os.PathLike]] = None) -> str:
+        text = self.canonical_json()
+        if path is not None:
+            with open(path, "w", encoding="utf-8", newline="\n") as stream:
+                stream.write(text)
+        return text
+
+    @classmethod
+    def load(cls, path: Union[str, os.PathLike]) -> "CoreProgram":
+        with open(path, "r", encoding="utf-8") as stream:
+            return cls.from_json(stream.read())
+
+
+__all__ = [
+    "SCHEMA_VERSION",
+    "Block",
+    "CoreFunction",
+    "CoreIRError",
+    "CoreIRSerializationError",
+    "CoreIRValidationError",
+    "CoreProgram",
+    "CoreType",
+    "Effect",
+    "Operation",
+    "Region",
+    "UnsupportedSchemaVersionError",
+    "ValueRef",
+]
diff --git a/python/pypto/frontend/core_export.py b/python/pypto/frontend/core_export.py
new file mode 100644
index 000000000..f0590d661
--- /dev/null
+++ b/python/pypto/frontend/core_export.py
@@ -0,0 +1,263 @@
+"""Tensor frontend 到 PyPTO-X Core IR 的一次性导出 adapter。
+
+本模块只接受一个已经解析好的、显式的数据输入；它不会重新执行用户
+Python kernel，也不会为了导出而隐式导入 CANN/native parser。在没有 CANN
+的开发环境中，``TensorExportInput`` 和同形状 mapping 是可测试的纯 Python
+入口。未来接入 Tensor frontend native parser 时，应通过
+``NativeTensorParserBridge`` 显式传入 bridge，再把 bridge 的结果映射成同一
+个 ``CoreProgram``。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Iterable, Mapping, Optional, Protocol, Sequence, Tuple, Union, runtime_checkable
+
+from pypto.core_ir import (
+    CoreFunction,
+    CoreIRError,
+    CoreProgram,
+    CoreType,
+    Operation,
+    Region,
+    ValueRef,
+)
+
+
+class CoreExportError(CoreIRError):
+    """Tensor export 输入或 bridge 结果不符合 Core IR 契约。"""
+
+
+class NativeParserUnavailableError(CoreExportError):
+    """没有显式 native bridge 时，明确报告 native parser 尚未接通。"""
+
+
+@dataclass(frozen=True)
+class TensorExportInput:
+    """不依赖 native parser 的显式 Tensor frontend 导出结果。
+
+    用户/测试可以直接构造它；``body`` 可传 ``Region`` 或按顺序排列的
+    ``Operation``。这里的输入表示的是前端已经完成的一次解析结果，而不是
+    Python kernel 本身。
+    """
+
+    name: str
+    parameters: Tuple[ValueRef, ...] = field(default_factory=tuple)
+    returns: Tuple[ValueRef, ...] = field(default_factory=tuple)
+    body: Region = field(default_factory=Region)
+    metadata: Mapping[str, Any] = field(default_factory=dict)
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.name, str) or not self.name:
+            raise CoreExportError("TensorExportInput.name 必须是非空字符串")
+        parameters = _coerce_refs(self.parameters, "TensorExportInput.parameters")
+        returns = _coerce_refs(self.returns, "TensorExportInput.returns")
+        body = _coerce_region(self.body, "TensorExportInput.body")
+        if not isinstance(self.metadata, Mapping):
+            raise CoreExportError("TensorExportInput.metadata 必须是 mapping")
+        object.__setattr__(self, "parameters", parameters)
+        object.__setattr__(self, "returns", returns)
+        object.__setattr__(self, "body", body)
+        object.__setattr__(self, "metadata", dict(self.metadata))
+
+
+@runtime_checkable
+class NativeTensorParserBridge(Protocol):
+    """未来 native Tensor parser 需要实现的最小 bridge。
+
+    ``parsed`` 是 native parser 的结果；bridge 必须返回
+    ``CoreProgram``、``CoreFunction``、``TensorExportInput`` 或本模块支持的
+    显式 mapping。bridge 的生命周期、CANN context 和 parser 选项不进入公共
+    Core IR。
+    """
+
+    def export(self, parsed: Any) -> Any:
+        """将 native parser 的一次解析结果导出为 Core IR 输入。"""
+
+
+def _coerce_ref(value: Any, context: str) -> ValueRef:
+    if isinstance(value, ValueRef):
+        return value
+    if isinstance(value, Mapping):
+        try:
+            return ValueRef.from_dict(value)
+        except CoreIRError as exc:
+            raise CoreExportError("%s 不是有效 ValueRef: %s" % (context, exc)) from exc
+    # 方便纯 Python export input 用 (name, CoreType) 描述引用；仍然要求类型
+    # 显式给出，不把无法验证的裸字符串伪装成 SSA value。
+    if isinstance(value, (tuple, list)) and len(value) == 2:
+        name, value_type = value
+        if isinstance(value_type, Mapping):
+            value_type = CoreType.from_dict(value_type)
+        if isinstance(value_type, CoreType):
+            return ValueRef(name, value_type)
+    raise CoreExportError("%s 必须是 ValueRef、ValueRef JSON 或 (name, CoreType)" % context)
+
+
+def _coerce_refs(values: Optional[Iterable[Any]], context: str) -> Tuple[ValueRef, ...]:
+    if values is None:
+        return ()
+    if isinstance(values, (str, bytes)):
+        raise CoreExportError("%s 必须是引用序列" % context)
+    try:
+        return tuple(_coerce_ref(value, "%s[%d]" % (context, index)) for index, value in enumerate(values))
+    except TypeError as exc:
+        raise CoreExportError("%s 必须是可迭代序列" % context) from exc
+
+
+def _coerce_operation(value: Any, context: str) -> Operation:
+    if isinstance(value, Operation):
+        return value
+    if isinstance(value, Mapping):
+        try:
+            return Operation.from_dict(value)
+        except CoreIRError as exc:
+            raise CoreExportError("%s 不是有效 Operation: %s" % (context, exc)) from exc
+    raise CoreExportError("%s 必须是 Operation 或 Operation JSON" % context)
+
+
+def _coerce_region(value: Any, context: str) -> Region:
+    if isinstance(value, Region):
+        return value
+    if isinstance(value, Mapping):
+        try:
+            return Region.from_dict(value)
+        except CoreIRError as exc:
+            raise CoreExportError("%s 不是有效 Region: %s" % (context, exc)) from exc
+    if isinstance(value, (list, tuple)):
+        return Region(tuple(_coerce_operation(item, "%s[%d]" % (context, index)) for index, item in enumerate(value)))
+    raise CoreExportError("%s 必须是 Region、Region JSON 或 Operation 序列" % context)
+
+
+def _coerce_function(value: Any) -> CoreFunction:
+    if isinstance(value, CoreFunction):
+        return value
+    if isinstance(value, TensorExportInput):
+        return CoreFunction(value.name, value.parameters, value.returns, value.body)
+    if not isinstance(value, Mapping):
+        raise CoreExportError("function export input 必须是 CoreFunction 或 mapping")
+    name = value.get("name", value.get("function_name"))
+    if name is None:
+        raise CoreExportError("function export input 缺少 name/function_name")
+    parameters = value.get("parameters", value.get("inputs", ()))
+    returns = value.get("returns", value.get("outputs", ()))
+    body = value.get("body", value.get("region", value.get("operations", ())))
+    try:
+        return CoreFunction(
+            name,
+            _coerce_refs(parameters, "function.parameters"),
+            _coerce_refs(returns, "function.returns"),
+            _coerce_region(body, "function.body"),
+        )
+    except CoreIRError as exc:
+        raise CoreExportError("function export input 无效: %s" % exc) from exc
+
+
+def export_tensor_frontend(
+    export_input: Any,
+    *,
+    name: Optional[str] = None,
+    metadata: Optional[Mapping[str, Any]] = None,
+) -> CoreProgram:
+    """把一次 Tensor frontend 解析结果导出为 ``CoreProgram``。
+
+    支持的纯 Python 输入只有：
+
+    * ``CoreProgram`` / ``CoreFunction`` / ``TensorExportInput``；
+    * 一个显式 function mapping（``name``, ``parameters``, ``returns``,
+      ``body``）；
+    * 一个带 ``functions`` 的 CoreProgram mapping。
+
+    callable（包括 ``@pypto.frontend.jit`` 函数）会被拒绝，因为导出阶段
+    禁止按 target 再执行用户 kernel。要连接 native parser，请调用
+    ``export_with_native_bridge`` 并显式提供 bridge。
+    """
+
+    if isinstance(export_input, CoreProgram):
+        program = export_input
+        if name is not None or metadata is not None:
+            merged = dict(program.metadata)
+            if metadata:
+                merged.update(metadata)
+            program = CoreProgram(program.schema_version, program.functions, merged)
+    elif isinstance(export_input, CoreFunction):
+        function = export_input
+        program = CoreProgram(functions=(function,), metadata=metadata or {})
+    elif isinstance(export_input, TensorExportInput):
+        merged = dict(export_input.metadata)
+        if metadata:
+            merged.update(metadata)
+        function_name = name or export_input.name
+        function = CoreFunction(function_name, export_input.parameters, export_input.returns, export_input.body)
+        program = CoreProgram(functions=(function,), metadata=merged)
+    elif isinstance(export_input, Mapping):
+        if "functions" in export_input:
+            if "schema_version" in export_input:
+                try:
+                    program = CoreProgram.from_dict(export_input)
+                except CoreIRError as exc:
+                    raise CoreExportError("CoreProgram export input 无效: %s" % exc) from exc
+                if metadata:
+                    merged = dict(program.metadata)
+                    merged.update(metadata)
+                    program = CoreProgram(program.schema_version, program.functions, merged)
+            else:
+                functions = export_input["functions"]
+                if not isinstance(functions, (list, tuple)):
+                    raise CoreExportError("export_input.functions 必须是数组")
+                function_values = tuple(_coerce_function(item) for item in functions)
+                merged = dict(export_input.get("metadata", {}))
+                if metadata:
+                    merged.update(metadata)
+                program = CoreProgram(functions=function_values, metadata=merged)
+        else:
+            function = _coerce_function(export_input)
+            if name is not None:
+                function = CoreFunction(name, function.parameters, function.returns, function.body)
+            program = CoreProgram(functions=(function,), metadata=metadata or {})
+    elif callable(export_input):
+        raise NativeParserUnavailableError(
+            "不能直接执行 callable 导出 Tensor frontend；请传入显式 TensorExportInput，"
+            "或通过 export_with_native_bridge 提供 native parser bridge"
+        )
+    else:
+        raise CoreExportError("不支持的 Tensor frontend export input 类型: %s" % type(export_input).__name__)
+    program.verify()
+    return program
+
+
+def export_with_native_bridge(parsed: Any, bridge: Optional[NativeTensorParserBridge]) -> CoreProgram:
+    """通过显式 bridge 接入 native parser；没有 bridge 时诚实失败。"""
+
+    if bridge is None:
+        raise NativeParserUnavailableError(
+            "Tensor frontend native parser bridge 尚未接入；当前只支持显式纯 Python export input"
+        )
+    exporter = getattr(bridge, "export", None)
+    if not callable(exporter):
+        raise CoreExportError("native parser bridge 必须提供 callable export(parsed) 方法")
+    return export_tensor_frontend(exporter(parsed))
+
+
+def native_parser_available() -> bool:
+    """当前 W1 不主动导入 CANN，因此 native parser 默认不可用。"""
+
+    return False
+
+
+# 名称别名：adapter 的调用方可以按项目文档使用任一明确名字。
+export_core_program = export_tensor_frontend
+from_tensor_frontend = export_tensor_frontend
+
+
+__all__ = [
+    "CoreExportError",
+    "NativeParserUnavailableError",
+    "NativeTensorParserBridge",
+    "TensorExportInput",
+    "export_core_program",
+    "export_tensor_frontend",
+    "export_with_native_bridge",
+    "from_tensor_frontend",
+    "native_parser_available",
+]
diff --git a/python/tests/ut/pypto_x/test_core_ir.py b/python/tests/ut/pypto_x/test_core_ir.py
new file mode 100644
index 000000000..86a8c8f15
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_core_ir.py
@@ -0,0 +1,113 @@
+"""W1 Core IR 最小契约测试。"""
+
+import json
+
+import pytest
+
+from pypto.core_ir import (
+    CoreFunction,
+    CoreIRValidationError,
+    CoreProgram,
+    CoreType,
+    Effect,
+    Operation,
+    Region,
+    UnsupportedSchemaVersionError,
+    ValueRef,
+)
+from pypto.frontend.core_export import (
+    NativeParserUnavailableError,
+    TensorExportInput,
+    export_tensor_frontend,
+    export_with_native_bridge,
+    native_parser_available,
+)
+
+
+def _program():
+    tensor = CoreType.tensor("bf16", ("batch", 16))
+    x = ValueRef("x", tensor)
+    y = ValueRef("y", tensor)
+    z = ValueRef("z", tensor)
+    add = Operation(
+        "tensor.add",
+        inputs=(x, y),
+        outputs=(z,),
+        attributes={"tags": {"elementwise", "portable"}, "axis": [1]},
+        effect=Effect.PURE,
+    )
+    function = CoreFunction("add", parameters=(x, y), returns=(z,), body=Region((add,)))
+    return CoreProgram(functions=(function,), metadata={"frontends": {"tensor", "classic"}})
+
+
+def test_verify_and_canonical_json_are_deterministic():
+    program = _program()
+    assert program.verify() is True
+    first = program.canonical_json()
+    second = program.canonical_json()
+    assert first == second
+    assert json.loads(first)["schema_version"] == 1
+    assert '"tags":["elementwise","portable"]' in first
+
+
+def test_round_trip_preserves_program():
+    program = _program()
+    restored = CoreProgram.from_json(program.canonical_json())
+    assert restored == program
+    assert restored.verify() is True
+
+
+def test_unknown_schema_version_fails_explicitly():
+    payload = _program().to_dict()
+    payload["schema_version"] = 99
+    with pytest.raises(UnsupportedSchemaVersionError):
+        CoreProgram.from_dict(payload)
+
+
+def test_ssa_reference_verification_rejects_undefined_input():
+    tensor = CoreType.tensor("bf16", (4,))
+    x = ValueRef("x", tensor)
+    missing = ValueRef("missing", tensor)
+    out = ValueRef("out", tensor)
+    function = CoreFunction(
+        "bad",
+        parameters=(x,),
+        returns=(out,),
+        body=Region((Operation("copy", inputs=(missing,), outputs=(out,)),)),
+    )
+    with pytest.raises(CoreIRValidationError, match="未定义值"):
+        function.verify()
+
+
+def test_tensor_frontend_explicit_export_and_native_bridge_seam():
+    tensor = CoreType.tensor("bf16", (8,))
+    x = ValueRef("x", tensor)
+    out = ValueRef("out", tensor)
+    exported = export_tensor_frontend(
+        TensorExportInput(
+            "copy",
+            parameters=(x,),
+            returns=(out,),
+            body=(Operation("identity", inputs=(x,), outputs=(out,)),),
+        )
+    )
+    assert exported.functions[0].name == "copy"
+    assert native_parser_available() is False
+
+    with pytest.raises(NativeParserUnavailableError):
+        export_with_native_bridge({}, None)
+
+    class Bridge:
+        def export(self, parsed):
+            assert parsed == "parsed-once"
+            return exported
+
+    assert export_with_native_bridge("parsed-once", Bridge()) == exported
+
+
+def test_export_rejects_callable_instead_of_executing_kernel():
+    def kernel(_x):
+        raise AssertionError("must not execute")
+
