From 0d96a6d76846cafe0dc10188da8512711523da8f Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Mon, 7 Sep 2026 03:17:27 +0800
Subject: [PATCH 023/144] fix(pypto-x): preserve target CPU feature
 requirements

---
 python/pypto/lowering/cpu/vector/plan.py          | 22 +++++++++++++++++-----
 python/tests/ut/pypto_x/test_cpu_vector_common.py | 24 ++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 5 deletions(-)

diff --git a/python/pypto/lowering/cpu/vector/plan.py b/python/pypto/lowering/cpu/vector/plan.py
index 63f2ce511..84269a2c2 100644
--- a/python/pypto/lowering/cpu/vector/plan.py
+++ b/python/pypto/lowering/cpu/vector/plan.py
@@ -626,12 +626,24 @@ def _target_lane_count(target: TargetSpec, requested: Optional[int]) -> int:
 
 
 def _target_required_features(target: TargetSpec, required: Any) -> CpuFeatureSet:
-    if required is not None:
-        return required if isinstance(required, CpuFeatureSet) else CpuFeatureSet(required, source="compiler")
     attributes = target.attributes
-    if "required_features" in attributes:
-        return CpuFeatureSet(attributes["required_features"], source="target")
-    return CpuFeatureSet(target.features, source="target")
+    target_features = tuple(target.features)
+    attribute_features = CpuFeatureSet(
+        attributes.get("required_features", ()), source="target"
+    ).features
+    if required is None:
+        explicit_features = ()
+        source = "target"
+    elif isinstance(required, CpuFeatureSet):
+        explicit_features = required.features
+        source = required.source
+    else:
+        explicit_features = CpuFeatureSet(required, source="compiler").features
+        source = "compiler"
+    combined = target_features + attribute_features + explicit_features
+    if explicit_features and source != "target":
+        source = source + "+target"
+    return CpuFeatureSet(combined, source=source)
 
 
 def _target_specialization(target: TargetSpec, specialization: Optional[Mapping[str, Any]]) -> Mapping[str, Any]:
diff --git a/python/tests/ut/pypto_x/test_cpu_vector_common.py b/python/tests/ut/pypto_x/test_cpu_vector_common.py
index e24c68b15..1add22f9c 100644
--- a/python/tests/ut/pypto_x/test_cpu_vector_common.py
+++ b/python/tests/ut/pypto_x/test_cpu_vector_common.py
@@ -26,6 +26,7 @@ from pypto.lowering.cpu.vector import (
     CpuVectorValidationError,
     TailPlan,
     TailPolicy,
+    lower_cpu_vector,
     make_iteration_plan,
 )
 from pypto.target import TargetSpec
@@ -232,6 +233,29 @@ def test_feature_contract_is_injected_and_missing_features_are_structured():
     assert loaded.feature_contract.compatible
 
 
+def test_target_features_cannot_be_weakened_by_lowering_requirements():
+    program = _add_program()
+    weakened_target = TargetSpec(
+        "cpu",
+        "x86_64-linux-gnu",
+        features=("avx2",),
+        attributes={"lane_count": 4, "required_features": ()},
+    )
+    compiler = CpuVectorCompiler()
+    artifact = compiler.compile(compiler.lower(program, weakened_target))
+    assert artifact.metadata["required_features"] == ("avx2",)
+    with pytest.raises(CpuVectorFeatureMismatchError) as error:
+        CpuVectorRuntime().load(artifact)
+    assert error.value.mismatch.missing == ("avx2",)
+
+    explicit = lower_cpu_vector(
+        program,
+        weakened_target,
+        required_features=("fma",),
+    )
+    assert explicit.required_features.features == ("avx2", "fma")
+
+
 def test_artifact_is_deterministic_and_metadata_carries_plan_identity():
     program = _add_program()
     compiler = CpuVectorCompiler()
