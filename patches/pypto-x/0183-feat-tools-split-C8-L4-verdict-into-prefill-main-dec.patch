From 48154ac82e68043417a5a14b70fd790b08e33d7f Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 01:10:04 +0800
Subject: [PATCH 183/235] feat(tools): split C8 L4 verdict into prefill main +
 decode extension (Q3)

---
 tools/c8_l4_compare.py | 69 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 61 insertions(+), 8 deletions(-)

diff --git a/tools/c8_l4_compare.py b/tools/c8_l4_compare.py
index 6adaeab0c..1ede46d41 100755
--- a/tools/c8_l4_compare.py
+++ b/tools/c8_l4_compare.py
@@ -230,6 +230,10 @@ def compare_block(ours: np.ndarray, gold: np.ndarray, key: str, band: dict,
         "ours_absmax": ours_absmax,
         "gold_absmax": float(np.max(np.abs(gold_rows))) if gold_rows.size else 0.0,
         "counts": counts,
+        "gold_near_tie_rows": sum(
+            1 for row in rows
+            if row["comparable"] and row["gold_margin"] <= near_tie_threshold
+        ),
         "gates": gates,
         "row_details": rows,
         "near_tie_details": [
@@ -416,6 +420,7 @@ def run_prompt(manifest: dict, prompt: str, gold_dir: Path, variant: str,
                       "cosine_gate": None, "cosine_floor": band["cosine_floor"]},
             "counts": {"strict_match": 0, "near_tie_flip": 0, "argmax_fail": 0,
                        "not_comparable": 0},
+            "gold_near_tie_rows": 0,
             "gated_rows": 0,
         }
 
@@ -452,10 +457,35 @@ def run_prompt(manifest: dict, prompt: str, gold_dir: Path, variant: str,
     near_tie = sum(item["counts"]["near_tie_flip"] for item in primary)
     failed = sum(item["counts"]["argmax_fail"] for item in primary)
     gated_rows = sum(item["gated_rows"] for item in primary)
+    primary_rows = [
+        row for item in primary for row in item.get("row_details", []) if row["comparable"]
+    ]
+    gold_near_tie_rows = sum(
+        1 for row in primary_rows if row["gold_margin"] <= band["near_tie_threshold"]
+    )
     argmax_gate = all(item["gates"]["argmax_gate"] for item in primary)
     max_abs_gate = all(item["gates"]["max_abs_gate"] for item in primary)
     cosine_gate = all(item["gates"]["cosine_gate"] for item in primary)
-    verdict = "PASS" if (argmax_gate and max_abs_gate and cosine_gate) else "FAIL"
+    verdict_union = "PASS" if (argmax_gate and max_abs_gate and cosine_gate) else "FAIL"
+
+    # band.json 的 band 标量 source_key = prefill_logits；0005 的 near-tie 行数
+    # （2/5、7/8、9/18）也是 prefill 行。因此把 prefill_logits key 作为“主判定”，
+    # 把同一标量下限外推到 decode block 作为“扩展判定”单列（其口径未经用户裁定）。
+    prefill_block = keys["prefill_logits"]
+
+    def _passes(block):
+        return bool(block["gates"].get("argmax_gate")
+                    and block["gates"].get("max_abs_gate")
+                    and block["gates"].get("cosine_gate"))
+
+    verdict_prefill = "PASS" if _passes(prefill_block) else "FAIL"
+    decode_block = keys.get("decode_logits") or {}
+    if decode_block.get("gates", {}).get("argmax_gate") is None:
+        verdict_decode_extension = "N/A"
+    else:
+        verdict_decode_extension = "PASS" if _passes(decode_block) else "FAIL"
+
+    verdict = verdict_union
     if diagnostic:
         verdict = "DIAGNOSTIC_" + verdict
 
@@ -472,7 +502,11 @@ def run_prompt(manifest: dict, prompt: str, gold_dir: Path, variant: str,
         "prompt": prompt,
         "steps": steps,
         "verdict": verdict,
+        "verdict_prefill_logits": verdict_prefill,
+        "verdict_decode_extension": verdict_decode_extension,
+        "verdict_union_all_logits_keys": verdict_union,
         "strict_argmax_match_rows": strict,
+        "gold_near_tie_rows": gold_near_tie_rows,
         "near_tie_flip_rows": near_tie,
         "argmax_fail_rows": failed,
         "gated_rows": gated_rows,
@@ -567,10 +601,14 @@ def main(argv=None) -> int:
         result = run_prompt(manifest, prompt, gold_dir, args.variant, band_json,
                             band_path, band_sha, diagnostic, steps_defaults)
         results[prompt] = result
-        print("{prompt}: {verdict}  strict_argmax={strict}/{gated}  near_tie_flip={near}  "
+        print("{prompt}: union={verdict} prefill_main={prefill} decode_extension={decode}  "
+              "strict_argmax={strict}/{gated}  gold_near_tie_rows={ntie}  near_tie_flip={near}  "
               "argmax_fail={fail}  chain_prefix_match={chain}".format(
                   prompt=prompt, verdict=result["verdict"],
+                  prefill=result["verdict_prefill_logits"],
+                  decode=result["verdict_decode_extension"],
                   strict=result["strict_argmax_match_rows"], gated=result["gated_rows"],
+                  ntie=result["gold_near_tie_rows"],
                   near=result["near_tie_flip_rows"], fail=result["argmax_fail_rows"],
                   chain=result["token_chain"]["common_prefix_match"]))
         for name, item in result["keys"].items():
@@ -584,11 +622,12 @@ def main(argv=None) -> int:
                     marker, name, item["max_abs"], item["cosine"], role))
             else:
                 print("    {}{:<27} max_abs={:.6f}(<={:.6f}) cos={:.8f}(>={:.8f}) "
-                      "strict={}/{} near_tie={} fail={} [{}]".format(
+                      "strict={}/{} near_tie_flip={}/{} fail={} [{}]".format(
                           marker, name, item["max_abs"], item["gates"]["max_abs_limit_2x_band"],
                           item["cosine"], item["gates"]["cosine_floor"],
                           item["counts"]["strict_match"], item["gated_rows"],
-                          item["counts"]["near_tie_flip"], item["counts"]["argmax_fail"], role))
+                          item["counts"]["near_tie_flip"], item.get("gold_near_tie_rows", "?"),
+                          item["counts"]["argmax_fail"], role))
             ref = item.get("reference_self_check_vs_fp32")
             if ref and "cosine" in ref:
                 below = ref.get("rows_below_cosine_floor") or []
@@ -598,8 +637,17 @@ def main(argv=None) -> int:
     if diagnostic:
         overall = "DIAGNOSTIC_PASS" if all(
             item["verdict"] == "DIAGNOSTIC_PASS" for item in results.values()) else "DIAGNOSTIC_FAIL"
+        overall_prefill = "N/A"
+        overall_decode_extension = "N/A"
     else:
         overall = "PASS" if all(item["verdict"] == "PASS" for item in results.values()) else "FAIL"
+        overall_prefill = "PASS" if all(
+            item["verdict_prefill_logits"] == "PASS" for item in results.values()) else "FAIL"
+        extension = [item["verdict_decode_extension"] for item in results.values()]
+        overall_decode_extension = (
+            "PASS" if all(value == "PASS" for value in extension)
+            else ("N/A" if all(value == "N/A" for value in extension) else "FAIL")
+        )
 
     payload = {
         "tool": TOOL,
@@ -614,10 +662,12 @@ def main(argv=None) -> int:
             "max_abs": "max|Δ| <= 2 * band",
             "cosine": "cosine >= band_cosine - 1e-4",
             "band_source": "band.json variants.<variant>.per_prompt.<prompt>.band",
-            "gate_units": ("prefill_logits / prefill_next_logits / decode_logits(rows 1..k)；"
-                           "decode 单 step 为 breakdown、完整 key 为 cross-check，均只报数不重复计数"),
+            "gate_units": ("判据字面口径（band source_key = prefill_logits、near-tie 行计数 2/5、7/8、9/18 均为 "
+                           "prefill 行）以 prefill_logits key 为主判定；prefill_next_logits 与 decode block 另列，"
+                           "decode 单 step 与完整 key 只报数"),
             "coverage_note": ("每个 prompt 的同一 band（source_key=prefill_logits）套用到该 prompt 的 "
-                              "primary 单元；band.json 内 per-key 数字只作交叉参考。"),
+                              "各 primary 单元；band.json 内 per-key 数字只作交叉参考。"
+                              "decode block 的同一标量外推口径未经用户裁定，单列为扩展判定。"),
         },
         "band_source": {
             "path": str(band_path),
@@ -627,12 +677,15 @@ def main(argv=None) -> int:
         "ours_manifest": {"path": str(manifest_path), "sha256": sha256_file(manifest_path)},
         "prompts": results,
         "overall": overall,
+        "overall_prefill_logits_main": overall_prefill,
+        "overall_decode_extension": overall_decode_extension,
     }
     output = Path(args.output)
     output.parent.mkdir(parents=True, exist_ok=True)
     output.write_text(json.dumps(payload, ensure_ascii=False, sort_keys=True, indent=2) + "\n",
                       encoding="utf-8")
-    print("overall: {} ({} config={}) -> {}".format(overall, args.variant, args.config, output))
+    print("overall: union={} prefill_main={} decode_extension={} ({} config={}) -> {}".format(
+        overall, overall_prefill, overall_decode_extension, args.variant, args.config, output))
     if diagnostic:
         return 0
     return 0 if overall == "PASS" else 1
