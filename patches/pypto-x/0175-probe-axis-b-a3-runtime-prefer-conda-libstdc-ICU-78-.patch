From fba8c714ba97a0bb0af6ed9bf0473ba4f483a628 Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 02:13:53 +0800
Subject: [PATCH 175/257] probe(axis-b-a3-runtime): prefer conda libstdc++ (ICU
 78 needs CXXABI_1.3.15) in run drivers

---
 scripts/a3_axis_b_runtime/05_run_forward.sh | 3 +++
 scripts/a3_axis_b_runtime/06_run_int8.sh    | 1 +
 2 files changed, 4 insertions(+)

diff --git a/scripts/a3_axis_b_runtime/05_run_forward.sh b/scripts/a3_axis_b_runtime/05_run_forward.sh
index a931b5d76..8ae57a282 100755
--- a/scripts/a3_axis_b_runtime/05_run_forward.sh
+++ b/scripts/a3_axis_b_runtime/05_run_forward.sh
@@ -16,6 +16,9 @@ export HF_HUB_OFFLINE=1
 export TRANSFORMERS_OFFLINE=1
 export OMP_NUM_THREADS=8
 export VLLM_CPU_KVCACHE_SPACE=1
+# A3 base conda env ships ICU 78 which needs CXXABI_1.3.15; the system libstdc++
+# is too old, conda's own libstdc++ (GCC 15.3) has it.  Prefer the conda lib dir.
+export LD_LIBRARY_PATH="$HOME/pypto-x-a3/envs/pypto-x-c8/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
 
 mkdir -p "$RUN/logs" "$RUN/raw" "$RUN/artifact"
 echo "### 05_run_forward A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ) cpus=$CPUS"
diff --git a/scripts/a3_axis_b_runtime/06_run_int8.sh b/scripts/a3_axis_b_runtime/06_run_int8.sh
index 1264e83e6..a0d95e30a 100755
--- a/scripts/a3_axis_b_runtime/06_run_int8.sh
+++ b/scripts/a3_axis_b_runtime/06_run_int8.sh
@@ -13,6 +13,7 @@ CPUS="${AXISB_CPUS:-600-639}"
 export ASCEND_RT_VISIBLE_DEVICES=
 export CUDA_VISIBLE_DEVICES=
 export OMP_NUM_THREADS=8
+export LD_LIBRARY_PATH="$HOME/pypto-x-a3/envs/pypto-x-c8/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
 
 mkdir -p "$RUN/logs" "$RUN/raw"
 echo "### 06_run_int8 A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
