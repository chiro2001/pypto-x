From f62eee33fa87ab8b776b8b6b2b0302b0fd777cfc Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 02:08:45 +0800
Subject: [PATCH 174/258] probe(axis-b-a3-runtime): use NJU-only resolution
 (drop slow pytorch extra index), reuse venv

---
 scripts/a3_axis_b_runtime/03_build_env.sh | 35 ++++++++++++++++++++++-------------
 1 file changed, 22 insertions(+), 13 deletions(-)

diff --git a/scripts/a3_axis_b_runtime/03_build_env.sh b/scripts/a3_axis_b_runtime/03_build_env.sh
index 0b156647f..292c515f5 100755
--- a/scripts/a3_axis_b_runtime/03_build_env.sh
+++ b/scripts/a3_axis_b_runtime/03_build_env.sh
@@ -39,21 +39,30 @@ echo "$VENV" > "$RAW/03_env_path.txt"
 
 if [[ ! -f "$WHEEL" ]]; then log "FATAL wheel missing $WHEEL"; exit 1; fi
 
-log "--- recreate venv (no system-site-packages) ---"
-rm -rf "$VENV"
-"$BASE_PY" -m venv "$VENV" || { log "FATAL venv create failed"; exit 1; }
+log "--- ensure venv (no system-site-packages) ---"
+if [[ ! -x "$VENV/bin/python" ]]; then
+    log "creating venv $VENV"
+    "$BASE_PY" -m venv "$VENV" || { log "FATAL venv create failed"; exit 1; }
+else
+    log "reusing existing venv $VENV"
+fi
 PY="$VENV/bin/python"
 PIP="$VENV/bin/pip"
 log "python=$("$PY" -VV 2>&1)"
 
-log "--- [1/4] install torch==2.13.0+cpu (aarch64 cp312) from pytorch cpu index ---"
-t0=$(date +%s)
-timeout 2700 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check --no-deps \
-    --index-url "$PT_CPU" "torch==2.13.0+cpu" 2>&1 | tail -6
-rc_torch=${PIPESTATUS[0]}
-t1=$(date +%s)
-log "torch_install_rc=$rc_torch elapsed_s=$((t1-t0))"
-[[ $rc_torch -eq 0 ]] || { log "FATAL torch install failed"; exit 1; }
+HAVE_TORCH="$("$PY" -c 'import torch; print(torch.__version__)' 2>/dev/null || echo none)"
+if [[ "$HAVE_TORCH" != "2.13.0+cpu" ]]; then
+    log "--- [1/4] install torch==2.13.0+cpu (aarch64 cp312) from pytorch cpu index (have=$HAVE_TORCH) ---"
+    t0=$(date +%s)
+    timeout 2700 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check --no-deps \
+        --index-url "$PT_CPU" "torch==2.13.0+cpu" 2>&1 | tail -6
+    rc_torch=${PIPESTATUS[0]}
+    t1=$(date +%s)
+    log "torch_install_rc=$rc_torch elapsed_s=$((t1-t0))"
+    [[ $rc_torch -eq 0 ]] || { log "FATAL torch install failed"; exit 1; }
+else
+    log "--- [1/4] torch already 2.13.0+cpu, skip ---"
+fi
 
 log "--- [2/4] install vllm_cpu-0.29.0 wheel (--no-deps) ---"
 timeout 600 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check --no-deps "$WHEEL" 2>&1 | tail -4
@@ -106,7 +115,7 @@ log "--- [4/4] single-transaction resolution (dry-run first) ---"
 t0=$(date +%s)
 timeout 1800 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check \
     --dry-run --report "$RAW/03_dryrun_report.json" \
-    --index-url "$MIRROR" --extra-index-url "$PT_CPU" \
+    --index-url "$MIRROR" --prefer-binary --timeout 60 --retries 3 \
     -r "$RUN/requirements.install.txt" > "$RAW/03_dryrun.log" 2>&1
 rc_dry=$?
 t1=$(date +%s)
@@ -120,7 +129,7 @@ fi
 log "--- real install (single pip resolve) ---"
 t0=$(date +%s)
 timeout 3600 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check \
-    --index-url "$MIRROR" --extra-index-url "$PT_CPU" \
+    --index-url "$MIRROR" --prefer-binary --timeout 60 --retries 3 \
     -r "$RUN/requirements.install.txt" > "$RAW/03_pip_install.log" 2>&1
 rc_inst=$?
 t1=$(date +%s)
