From 202b045fba9b02b4982453eac42c648ecb49dbc9 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Tue, 8 Sep 2026 22:02:15 +0800
Subject: [PATCH 052/252] fix(pypto-x): reject oversized compact layout
 dimensions

---
 python/pypto/lowering/cpu/vector/plan.py          | 2 ++
 python/tests/ut/pypto_x/test_cpu_sve256_layout.py | 4 ++--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/python/pypto/lowering/cpu/vector/plan.py b/python/pypto/lowering/cpu/vector/plan.py
index df68c0604..b7459f769 100644
--- a/python/pypto/lowering/cpu/vector/plan.py
+++ b/python/pypto/lowering/cpu/vector/plan.py
@@ -139,6 +139,8 @@ def _bounded_product(values: Sequence[int], field: str) -> int:
             raise CpuVectorValidationError(
                 "{}[{}] must be a non-negative integer".format(field, index)
             )
+        if value > _UINT64_MAX:
+            raise CpuVectorValidationError("{}[{}] exceeds uint64".format(field, index))
         if value and result > _UINT64_MAX // value:
             raise CpuVectorValidationError("{} element count overflows uint64".format(field))
         result *= value
diff --git a/python/tests/ut/pypto_x/test_cpu_sve256_layout.py b/python/tests/ut/pypto_x/test_cpu_sve256_layout.py
index 32619af79..86789da39 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256_layout.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256_layout.py
@@ -274,7 +274,7 @@ def test_layout_descriptor_metadata_is_rank_bounded_for_qwen_sized_shapes(tmp_pa
     compiler = Sve256Compiler()
     target = _target()
     cases = (
-        ((1024, 1024), (1024, 1024), {"permutation": [1, 0]}),
+        ((32768, 2048), (2048, 32768), {"permutation": [1, 0]}),
         ((32768,), (16384, 2), {"shape": [16384, 2]}),
     )
     for index, (input_shape, output_shape, attributes) in enumerate(cases):
@@ -318,7 +318,7 @@ def test_layout_descriptor_metadata_is_rank_bounded_for_qwen_sized_shapes(tmp_pa
     (
         ("transpose", (2, 3), (3, 2), {"permutation": [0, 0]}, "permutation"),
         ("slice", (2, 3), (2, 2), {"starts": [0], "stops": [2], "axes": [1], "steps": [0]}, "step"),
-        ("reshape", (1 << 64,), (1 << 64,), {"shape": [1 << 64]}, "overflows uint64"),
+        ("reshape", (0, 1 << 64), (0, 1 << 64), {"shape": [0, 1 << 64]}, "exceeds uint64"),
     ),
 )
 def test_layout_descriptor_rank_permutation_slice_and_overflow_gates(
