+    def thawed_metadata(self, artifact: Artifact) -> Optional[Any]:
+        """Return the thawed metadata validated this launch, if still current."""
+
+        cached = self.primary.get(id(artifact))
+        if cached is not None and cached[0] is artifact.metadata:
+            return cached[1]
+        return None
