+class _ArtifactSemanticsEntry:
+    """One verified CoreProgram -> AVX-512 target IR lowering (N4.1).
+
+    ``program_digest`` is the digest that ``_program_digest_from_metadata``
+    verified against the program metadata; ``target_ir`` is the result of
+    ``lower_avx512`` for that same program, together with the required-feature
+    contract and target digest the artifact declared.  A digest-only entry
+    (``target_ir is None``) records that the declared program digest was
+    checked while the semantic comparison is still pending.
+
+    The entry deliberately does not copy the bulky ``_execution_metadata``
+    tables: what makes them reusable is the frozen-metadata identity check at
+    lookup time, not a per-field replay.
+    """
+
+    __slots__ = (
+        "metadata",
+        "program_digest",
+        "plan_digest",
+        "target_ir",
+        "required_features",
+        "required_feature_source",
+        "target_digest",
+    )
+
+    def __init__(
+        self,
+        metadata: Any,
+        program_digest: str,
+        plan_digest: Optional[str] = None,
+        target_ir: Any = None,
+        required_features: Tuple[str, ...] = (),
+        required_feature_source: Optional[str] = None,
+        target_digest: Optional[str] = None,
+    ) -> None:
+        self.metadata = metadata
+        self.program_digest = program_digest
+        #: ``CpuVectorProgram.plan_digest`` is a property that re-serializes
+        #: every plan on access; the verified value is pinned here so a cache
+        #: hit never recomputes it.
+        self.plan_digest = plan_digest
+        self.target_ir = target_ir
+        self.required_features = required_features
+        self.required_feature_source = required_feature_source
+        self.target_digest = target_digest
+
+
+#: Bounded process-level reuse of one verified lowering per immutable artifact.
+#: ``launch()`` lowers the program in ``_validate_primary_semantics`` and then
+#: lowers it again inside ``_decode_artifact``; the N4.0 per-launch memo only
+#: dedups the validation entry points, not that second lowering + full plan
+#: deep comparison.  Entries are keyed by the artifact content digest, the
+#: artifact ABI identity and the fingerprint of the deeply-frozen metadata
+#: mapping, and a hit additionally requires the *exact* frozen metadata object
+#: (held strongly) to still be attached to the artifact.  Replacing metadata
+#: therefore yields a different key/identity and re-runs the full validation;
+#: version, declared digest, native byte, safety-marker and host capability
+#: checks stay per launch and are never served from this cache.
+_ARTIFACT_SEMANTICS_CACHE_MAX = 8
+_ARTIFACT_SEMANTICS_CACHE_LOCK = threading.RLock()
+_ARTIFACT_SEMANTICS_CACHE: "OrderedDict[Tuple[Any, ...], _ArtifactSemanticsEntry]" = OrderedDict()
+_ARTIFACT_SEMANTICS_STATS: Dict[str, int] = {
+    "hits": 0,
+    "misses": 0,
+    "stores": 0,
+    "evictions": 0,
+    "disabled": 0,
+}
+
+
+def _artifact_semantics_key(artifact: Artifact) -> Optional[Tuple[Any, ...]]:
+    """Return the immutable identity key, or ``None`` when it cannot be built.
+
+    The metadata mapping is a ``FrozenMapping``: a deeply immutable value whose
+    ``hash`` is a content fingerprint stable for the lifetime of the process.
+    A plain mutable mapping (which cannot be hashed) disables the process
+    cache for that artifact, so the caller falls back to per-launch work.
+    """
+
+    try:
+        metadata_fingerprint = hash(artifact.metadata)
+    except TypeError:
+        return None
+    try:
+        target_digest = sha256_text(artifact.target.to_dict())
+    except Exception:
+        return None
+    return (
+        artifact.content_digest,
+        artifact.format,
+        artifact.format_version,
+        artifact.entrypoint,
+        artifact.abi_version,
+        target_digest,
+        metadata_fingerprint,
+    )
+
+
+def _artifact_semantics_get(
+    artifact: Artifact,
+) -> Tuple[Optional[Tuple[Any, ...]], Optional[_ArtifactSemanticsEntry]]:
+    """Look up one entry; a hit requires the exact frozen metadata object."""
+
+    key = _artifact_semantics_key(artifact)
+    if key is None:
+        with _ARTIFACT_SEMANTICS_CACHE_LOCK:
+            _ARTIFACT_SEMANTICS_STATS["disabled"] += 1
+        return None, None
+    with _ARTIFACT_SEMANTICS_CACHE_LOCK:
+        entry = _ARTIFACT_SEMANTICS_CACHE.get(key)
+        if entry is not None and entry.metadata is artifact.metadata:
+            _ARTIFACT_SEMANTICS_CACHE.move_to_end(key)
+            _ARTIFACT_SEMANTICS_STATS["hits"] += 1
+        else:
+            entry = None
+            _ARTIFACT_SEMANTICS_STATS["misses"] += 1
+    return key, entry
+
+
+def _artifact_semantics_put(key: Tuple[Any, ...], entry: _ArtifactSemanticsEntry) -> None:
+    with _ARTIFACT_SEMANTICS_CACHE_LOCK:
+        if key not in _ARTIFACT_SEMANTICS_CACHE and len(_ARTIFACT_SEMANTICS_CACHE) >= _ARTIFACT_SEMANTICS_CACHE_MAX:
+            _ARTIFACT_SEMANTICS_CACHE.popitem(last=False)
+            _ARTIFACT_SEMANTICS_STATS["evictions"] += 1
+        _ARTIFACT_SEMANTICS_CACHE[key] = entry
+        _ARTIFACT_SEMANTICS_CACHE.move_to_end(key)
+        _ARTIFACT_SEMANTICS_STATS["stores"] += 1
+
+
+def _artifact_semantics_note_digest(key: Tuple[Any, ...], artifact: Artifact, digest: str) -> None:
+    """Record a verified program digest before the plan comparison runs."""
+
+    with _ARTIFACT_SEMANTICS_CACHE_LOCK:
+        entry = _ARTIFACT_SEMANTICS_CACHE.get(key)
+        if entry is not None and entry.metadata is artifact.metadata:
+            entry.program_digest = digest
+            return
+        if entry is None and len(_ARTIFACT_SEMANTICS_CACHE) >= _ARTIFACT_SEMANTICS_CACHE_MAX:
+            _ARTIFACT_SEMANTICS_CACHE.popitem(last=False)
+            _ARTIFACT_SEMANTICS_STATS["evictions"] += 1
+        if entry is None:
+            _ARTIFACT_SEMANTICS_CACHE[key] = _ArtifactSemanticsEntry(artifact.metadata, digest)
+            _ARTIFACT_SEMANTICS_STATS["stores"] += 1
+
+
+def _artifact_semantics_store(
+    key: Tuple[Any, ...],
+    artifact: Artifact,
+    program_digest: str,
+    plan_digest: str,
+    target_ir: Any,
+    required: CpuFeatureSet,
+    target_digest: Optional[str],
+) -> None:
+    entry = _ArtifactSemanticsEntry(
+        artifact.metadata,
+        program_digest,
+        plan_digest=plan_digest,
+        target_ir=target_ir,
+        required_features=tuple(required.features),
+        required_feature_source=required.source,
+        target_digest=target_digest,
+    )
+    _artifact_semantics_put(key, entry)
+
+
+def _semantics_entry_matches_metadata(
+    artifact: Artifact, metadata: Mapping[str, Any], entry: _ArtifactSemanticsEntry
+) -> bool:
+    """Re-check every cheap fail-closed fact before reusing a lowering.
+
+    The expensive proof (program digest, full plan deep comparison, execution
+    metadata) is inherited from the entry, but the declared digests, versions,
+    variants and required-feature boundary are compared again on every launch.
+    A failure means the metadata changed underneath the key (or the entry is
+    incomplete), so the caller falls through to the full validation, which
+    rejects it.
+    """
+
+    target_ir = entry.target_ir
+    if target_ir is None or entry.metadata is not artifact.metadata:
+        return False
+    if entry.plan_digest is None:
+        return False
+    if metadata.get("program_digest") != entry.program_digest:
+        return False
+    if metadata.get("plan_digest") != entry.plan_digest:
+        return False
+    if metadata.get("entrypoint") != artifact.entrypoint or target_ir.entrypoint != artifact.entrypoint:
+        return False
+    if metadata.get("native_variant") != target_ir.native_variant:
+        return False
+    if metadata.get("target_digest") != entry.target_digest:
+        return False
+    plan_data = metadata.get("vector_plan")
+    if not isinstance(plan_data, Mapping) or plan_data.get("plan_version") != VECTOR_PLAN_VERSION:
+        return False
+    if tuple(metadata.get("required_features", ())) != entry.required_features:
+        return False
+    if metadata.get("required_feature_source") != entry.required_feature_source:
+        return False
+    return True
+
+
+def _semantics_target_ir_matches_metadata(
+    metadata: Mapping[str, Any], entry: _ArtifactSemanticsEntry
+) -> bool:
+    """Decode-side cross-check for a cached lowering (cheaper than re-lowering)."""
+
+    target_ir = entry.target_ir
+    if target_ir is None or entry.plan_digest is None:
+        return False
+    if metadata.get("program_digest") != entry.program_digest:
+        return False
+    if metadata.get("plan_digest") != entry.plan_digest:
+        return False
+    if metadata.get("entrypoint") != target_ir.entrypoint:
+        return False
+    if metadata.get("native_variant") != target_ir.native_variant:
+        return False
+    plan_data = metadata.get("vector_plan")
+    if not isinstance(plan_data, Mapping) or plan_data.get("plan_version") != VECTOR_PLAN_VERSION:
+        return False
+    if tuple(metadata.get("required_features", ())) != entry.required_features:
+        return False
+    if metadata.get("required_feature_source") != entry.required_feature_source:
+        return False
+    return True
+
+
+def artifact_semantics_cache_stats() -> Mapping[str, int]:
+    with _ARTIFACT_SEMANTICS_CACHE_LOCK:
+        stats = dict(_ARTIFACT_SEMANTICS_STATS)
+        stats["entries"] = len(_ARTIFACT_SEMANTICS_CACHE)
+        return stats
+
+
+def clear_artifact_semantics_cache() -> int:
+    with _ARTIFACT_SEMANTICS_CACHE_LOCK:
+        count = len(_ARTIFACT_SEMANTICS_CACHE)
+        _ARTIFACT_SEMANTICS_CACHE.clear()
+        return count
 
 
