@@ -0,0 +1,382 @@
+"""N4.1: process-level AVX-512 artifact -> target_ir cache must stay fail-closed.
+
+``launch()`` lowers the CoreProgram in ``_validate_primary_semantics`` and then
+lowers it again inside ``_decode_artifact``.  N4.1 reuses the verified lowering
+through a process-level cache keyed by the immutable artifact identity
+(content digest + frozen metadata fingerprint + ABI/entrypoint/target).
+
+These tests pin the properties the cache must not weaken:
+
+* one launch performs a single ``lower_avx512`` (the second one is reused);
+* a repeated launch of the same frozen artifact reuses digest + lowering but
+  still runs the cheap validation and the output stays bit-identical;
+* every metadata tamper (program/digest/version/plan/required features/
+  variant/target digest) is rejected on two consecutive launches, including
+  after a successful launch has warmed the cache;
+* replacing ``artifact.metadata`` after a successful launch is rejected;
+* a lost host capability is rejected on every launch even with a warm cache;
+* the fallback-artifact path still validates the fallback itself;
+* native bytes changed on disk are rejected even when metadata is cached;
+* artifacts with different targets/flags never share an entry.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cpu.x86 import (
+    Avx2Runtime,
+    Avx512Runtime,
+    CpuAvx512ArtifactError,
+    CpuAvx512FeatureMismatchError,
+    CpuAvx512UnavailableError,
+)
+from pypto.backends.cpu.x86 import avx512 as runtime_module
+from pypto.compiler import Artifact, CompileOptions
+from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu.x86.avx512 import Avx512Capability
+from pypto.lowering.cpu.x86.avx512 import capabilities as capabilities_module
+from pypto.target import TargetSpec
+from pypto.target._utils import frozen_mapping, mapping_copy
+
+
+AVX512_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+)
+AVX2_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx2",), attributes={"lane_count": 8}
+)
+SHAPE = (17,)
+
+
+@pytest.fixture(autouse=True)
+def _fresh_process_cache():
+    runtime_module.clear_artifact_semantics_cache()
+    yield
+    runtime_module.clear_artifact_semantics_cache()
+
+
+def _program(operation="add", shape=SHAPE):
+    value_type = CoreType.tensor("float32", shape)
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    inputs = (left,) if operation == "neg" else (left, right)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                operation,
+                inputs,
+                (output,),
+                Region((Operation(operation, inputs, (output,)),)),
+            ),
+        )
+    )
+
+
+def _compile_avx512(program, tmp_path, name="native", features=("avx512f",)):
+    target = TargetSpec(
+        "cpu", "x86_64-linux-gnu", features=features, attributes={"lane_count": 16}
+    )
+    compiler = Avx512Compiler()
+    target_ir = compiler.lower(program, target)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx512", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+    return target_ir, artifact
+
+
+def _compile_avx2(program, tmp_path, name="fallback-avx2"):
+    compiler = Avx2Compiler()
+    return compiler.compile(
+        compiler.lower(program, AVX2_TARGET),
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+
+
+def _runtime():
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _left(shape=SHAPE):
+    return HostTensor("float32", shape, [float(index) for index in range(shape[0])])
+
+
+def _launch(runtime, artifact, shape=SHAPE, fallback=None):
+    output = HostTensor.zeros("float32", shape)
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_left(shape).descriptor(readonly=True), _left(shape).descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        ),
+        fallback_artifact=fallback,
+    )
+    return output
+
+
+def _output_bytes(tensor):
+    return struct.pack("<%df" % len(tensor.data), *tensor.data)
+
+
+def _rebuilt_artifact(artifact, mutate):
+    metadata = mapping_copy(artifact.metadata)
+    mutate(metadata)
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=metadata,
+    )
+
+
+@pytest.fixture
+def lower_calls(monkeypatch):
+    calls = []
+    original = runtime_module.lower_avx512
+
+    def counting(*args, **kwargs):
+        calls.append(args)
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(runtime_module, "lower_avx512", counting)
+    return calls
+
+
+@pytest.fixture
+def core_program_builds(monkeypatch):
+    calls = {"count": 0}
+    original = runtime_module.CoreProgram
+
+    class CountingCoreProgram:
+        @staticmethod
+        def from_dict(payload):
+            calls["count"] += 1
+            return original.from_dict(payload)
+
+    monkeypatch.setattr(runtime_module, "CoreProgram", CountingCoreProgram)
+    return calls
+
+
+def test_second_lowering_within_one_launch_is_reused(tmp_path, lower_calls):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    output = _launch(runtime, artifact)
+    assert _output_bytes(output)
+    assert len(lower_calls) == 1, "one launch must lower the program exactly once"
+    assert runtime_module.artifact_semantics_cache_stats()["entries"] == 1
+
+
+def test_repeated_launch_reuses_cache_and_stays_bit_identical(tmp_path, lower_calls, core_program_builds):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    first = _output_bytes(_launch(runtime, artifact))
+    lowered_once = len(lower_calls)
+    rebuilt_once = core_program_builds["count"]
+    assert lowered_once == 1
+    assert rebuilt_once == 2  # digest + semantics; the decode body is reused
+
+    for _ in range(3):
+        assert _output_bytes(_launch(runtime, artifact)) == first
+    assert len(lower_calls) == lowered_once, "cached lowering must not be recomputed"
+    assert core_program_builds["count"] == rebuilt_once, "cached digest + semantics must not rebuild"
+    stats = runtime_module.artifact_semantics_cache_stats()
+    assert stats["hits"] >= 6 and stats["entries"] == 1
+
+
+def test_metadata_replacement_after_successful_launch_is_rejected(tmp_path):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    assert _output_bytes(_launch(runtime, artifact))
+
+    metadata = mapping_copy(artifact.metadata)
+    metadata["plan_version"] = 2
+    object.__setattr__(artifact, "metadata", frozen_mapping(metadata))
+    for _ in range(2):
+        with pytest.raises(CpuAvx512ArtifactError, match="unsupported CPU vector plan version"):
+            _launch(runtime, artifact)
+
+
+def test_plain_mutable_metadata_replacement_is_rejected(tmp_path):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    assert _output_bytes(_launch(runtime, artifact))
+
+    metadata = mapping_copy(artifact.metadata)
+    metadata["plan_version"] = 2
+    object.__setattr__(artifact, "metadata", metadata)
+    for _ in range(2):
+        with pytest.raises(CpuAvx512ArtifactError, match="unsupported CPU vector plan version"):
+            _launch(runtime, artifact)
+
+
+def _tamper_program(metadata, tmp_path):
+    _, other = _compile_avx512(_program(operation="neg"), tmp_path, name="other-program")
+    metadata["program"] = mapping_copy(other.metadata)["program"]
+
+
+def _tamper_required_features(metadata):
+    plan_data = dict(metadata["vector_plan"])
+    required = dict(plan_data["required_features"])
+    required["features"] = tuple(
+        feature for feature in required["features"] if feature != "avx512f"
+    )
+    plan_data["required_features"] = required
+    metadata["vector_plan"] = plan_data
+    metadata["required_features"] = required["features"]
+
+
+@pytest.mark.parametrize(
+    "tamper, message",
+    [
+        ("program_digest", "CoreProgram digest is inconsistent"),
+        ("program", "CoreProgram digest is inconsistent"),
+        ("lowering_version", "unsupported AVX-512 lowering version"),
+        ("artifact_payload_version", "unsupported AVX-512 artifact payload version"),
+        ("plan_version", "unsupported CPU vector plan version"),
+        ("required_features", "required_features omit AVX/ZMM safety fields"),
+        ("native_variant", "primary artifact native variant metadata is inconsistent"),
+        ("target_digest", "primary artifact target digest mismatch"),
+    ],
+)
+def test_tampered_metadata_is_rejected_on_every_launch_after_warm_cache(
+    tmp_path, tamper, message
+):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    assert _output_bytes(_launch(runtime, artifact))
+
+    def mutate(metadata):
+        if tamper == "program_digest":
+            metadata["program_digest"] = "f" * 64
+        elif tamper == "program":
+            _tamper_program(metadata, tmp_path)
+        elif tamper == "required_features":
+            _tamper_required_features(metadata)
+        elif tamper == "native_variant":
+            metadata["native_variant"] = "avx512-tampered"
+        elif tamper == "target_digest":
+            metadata["target_digest"] = "0" * 64
+        else:
+            metadata[tamper] = int(metadata[tamper]) + 1
+
+    tampered = _rebuilt_artifact(artifact, mutate)
+    for _ in range(2):
+        with pytest.raises(CpuAvx512ArtifactError, match=message):
+            _launch(runtime, tampered)
+
+
+def test_lost_capability_is_rejected_every_launch_with_warm_cache(tmp_path, monkeypatch):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    assert _output_bytes(_launch(runtime, artifact))
+
+    missing = Avx512Capability.injected_capability(("avx", "osxsave", "ymm"))
+    monkeypatch.setattr(
+        capabilities_module, "probe_avx512_capabilities", lambda **kwargs: missing
+    )
+    # load() re-checks the host feature contract without the launch-level probe.
+    for _ in range(2):
+        with pytest.raises(CpuAvx512FeatureMismatchError):
+            runtime.load(artifact, available_features=("avx", "osxsave", "ymm"))
+    # launch() re-probes the real capability of a freshly built runtime.
+    for _ in range(2):
+        with pytest.raises(CpuAvx512UnavailableError):
+            _launch(Avx512Runtime(), artifact)
+
+
+def test_avx2_fallback_path_still_validates_the_fallback(tmp_path, monkeypatch):
+    if not Avx2Runtime().is_available():
+        pytest.skip("host lacks AVX2 capability for real fallback execution")
+    _, primary = _compile_avx512(_program(), tmp_path)
+    fallback = _compile_avx2(_program(), tmp_path)
+    wrong_program_fallback = _compile_avx2(
+        _program(shape=(19,)), tmp_path, name="other-shape-avx2"
+    )
+
+    missing = Avx512Capability.injected_capability(())
+    monkeypatch.setattr(
+        capabilities_module, "probe_avx512_capabilities", lambda **kwargs: missing
+    )
+    runtime = Avx512Runtime(capability=missing)
+    outputs = set()
+    for _ in range(2):
+        outputs.add(_output_bytes(_launch(runtime, primary, fallback=fallback)))
+    assert len(outputs) == 1
+    assert runtime_module.artifact_semantics_cache_stats()["entries"] >= 1
+
+    for _ in range(2):
+        with pytest.raises(
+            CpuAvx512ArtifactError,
+            match="fallback CoreProgram digest does not match primary artifact",
+        ):
+            _launch(runtime, primary, fallback=wrong_program_fallback)
+
+
+def test_different_target_variants_do_not_share_an_entry(tmp_path, lower_calls):
+    _, base = _compile_avx512(_program(), tmp_path, name="base")
+    _, fma = _compile_avx512(_program(), tmp_path, name="fma", features=("avx512f", "fma"))
+    runtime = _runtime()
+    if not runtime.capability.fma:
+        pytest.skip("host lacks AVX-512 FMA")
+    assert base.content_digest != fma.content_digest
+
+    assert _output_bytes(_launch(runtime, base))
+    assert len(lower_calls) == 1
+    fma_output = _output_bytes(_launch(runtime, fma))
+    assert fma_output
+    assert len(lower_calls) == 2, "a different target/flags must not reuse the lowering"
+    assert runtime_module.artifact_semantics_cache_stats()["entries"] == 2
+
+
+def test_native_bytes_change_is_rejected_with_warm_cache(tmp_path):
+    from pathlib import Path
+
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    assert _output_bytes(_launch(runtime, artifact))
+
+    # A copy with appended bytes: the artifact's own captured digest matches
+    # the copy, so only the per-launch native read + declared native_digest
+    # comparison can reject it.  (Rewriting the loaded .so in place would be
+    # rejected earlier and makes dlclose crash the interpreter on exit.)
+    tampered_path = tmp_path / "tampered.so"
+    tampered_path.write_bytes(Path(artifact.path).read_bytes() + b"tamper")
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(tampered_path),
+        metadata=artifact.metadata,
+    )
+    for _ in range(2):
+        with pytest.raises(CpuAvx512ArtifactError, match="native artifact content digest mismatch"):
+            _launch(runtime, tampered)
+
+
+def test_clear_cache_forces_full_revalidation(tmp_path, lower_calls):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    assert _output_bytes(_launch(runtime, artifact))
+    assert len(lower_calls) == 1
+    assert runtime_module.clear_artifact_semantics_cache() == 1
+    assert _output_bytes(_launch(runtime, artifact))
+    assert len(lower_calls) == 2
