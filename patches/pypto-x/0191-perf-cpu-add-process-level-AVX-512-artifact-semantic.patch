+
+    ok, bit_lines = n4.bit_check(rounds)
+    sections.append("## Bit-level regression across every interleaved round")
+    sections.extend(bit_lines)
+    sections.append("")
+    sections.append("bit_identical={}".format(ok))
+
+    report = "\n".join(sections) + "\n"
+    table_path = Path(args.table) if args.table else evidence / "raw" / "decomposition-table.md"
+    table_path.parent.mkdir(parents=True, exist_ok=True)
+    table_path.write_text(report, encoding="utf-8")
+    print(report)
+
+    output_path = Path(args.output) if args.output else evidence / "raw" / "analysis.json"
+    payload = {
+        "harness": "lac_analyze",
+        "base": "acece0a9264d5b4ed1496363d93ba01222d7c7c1",
+        "tags": sorted(rounds),
+        "launch_counts": {tag: len(item["launches"]) for tag, item in sorted(rounds.items())},
+        "bit_identical": ok,
+        "outputs_compared": sorted(
+            {
+                name
+                for item in rounds.values()
+                for name in item["driver"].get("outputs", {})
+            }
+        ),
+        "artifact_content_digests": sorted(
+            {
+                item["driver"].get("compile", {}).get("artifact_content_digest")
+                for item in rounds.values()
+            }
+        ),
+        "per_launch": rows,
+    }
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    with output_path.open("w", encoding="utf-8") as stream:
