+#!/usr/bin/env python3
+"""N4.1 validation-path probe: the `launch()` prove-out bracket, cold vs warm.
+
+Builds the weighted Qwen3.5 T=5 CoreProgram (graph only, no weights), lowers
+and compiles a real AVX-512 artifact, then times the exact primary-artifact
+validation + `_decode_artifact` bracket that `launch()` runs, with the same
+per-launch memo `launch()` creates:
+
+    launch() -> _validate_primary_artifact(artifact, memo)
+             -> _decode_artifact(artifact, available, capability, memo)
+
+Two launches are measured for the same immutable artifact: a cold one (fills
+the process-level lowering cache) and a repeated one (may reuse it).  This is
+a design/orientation probe for the heavy locked A/B; absolute numbers are
+UNGATED (12 vCPU KVM guest, no cpufreq).
+
+Usage:
+
+    python3 scripts/perf/lac_validation_probe.py \
+        --tree /path/to/tree --steps 5 --output /path/to/probe.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import time
+from typing import Any, Dict, Optional
+
+
+def load_driver(tree: Path, driver: Optional[Path] = None) -> Any:
+    path = driver or tree / "python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py"
+    spec = importlib.util.spec_from_file_location("qwen35_weighted_execution_driver", str(path))
+    if spec is None or spec.loader is None:
+        raise SystemExit("cannot load driver from {}".format(path))
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+class LowerCounter:
+    """Count `runtime_module.lower_avx512` calls without changing behaviour."""
+
+    def __init__(self, module: Any) -> None:
+        self.module = module
+        self.original = getattr(module, "lower_avx512")
+        self.calls = 0
+
+    def install(self) -> None:
+        counter = self
+
+        def counting(*args: Any, **kwargs: Any) -> Any:
+            counter.calls += 1
+            return counter.original(*args, **kwargs)
+
+        self.module.lower_avx512 = counting
+
+
+def timed(function: Any) -> Any:
+    started = time.perf_counter()
+    result = function()
+    return result, time.perf_counter() - started
+
+
+def main(argv: Optional[list] = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tree", required=True)
+    parser.add_argument("--steps", type=int, default=5)
+    parser.add_argument("--past-length", type=int, default=0)
+    parser.add_argument("--driver", default=None)
+    parser.add_argument("--build-dir", default=None)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--repeats", type=int, default=2)
+    args = parser.parse_args(argv)
+
+    tree = Path(args.tree).resolve()
+    for entry in (
+        tree / "python",
+        tree / "python/tests/ut",
+        tree / "python/tests/ut/pypto_x",
+    ):
+        sys.path.insert(0, str(entry))
+
+    driver = load_driver(tree, Path(args.driver) if args.driver else None)
+    from pypto.backends.cpu.x86 import Avx512Runtime
+    from pypto.backends.cpu.x86 import avx512 as runtime_module
+    from pypto.compiler import CompileOptions
+
+    capabilities = getattr(runtime_module, "_capabilities")
+    capability = capabilities.probe_avx512_capabilities()
+    if not capability.available:
+        raise SystemExit("host lacks AVX-512: {}".format(capability.reason))
+
+    program, _schema, _layout = driver.build_graph(args.steps, args.past_length)
+    backend = driver.make_backend("avx512")
+    compiler = backend["compiler"]
+    if args.build_dir:
+        build_dir = Path(args.build_dir)
+    else:
+        build_dir = Path(args.output).resolve().parent / "probe-build"
+    build_dir.mkdir(parents=True, exist_ok=True)
+
+    lower_counter = LowerCounter(runtime_module)
+    lower_counter.install()
+
+    compiled_started = time.perf_counter()
+    target_ir = compiler.lower(program, backend["target"])
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(artifact_format="pypto-x.cpu.avx512", extra={"build_dir": str(build_dir)}),
+    )
+    compile_seconds = time.perf_counter() - compiled_started
+
+    runtime = Avx512Runtime()
+    available = runtime.available_features
+    launches = []
+    lowers_before = lower_counter.calls
+    for index in range(args.repeats):
+        memo = runtime_module._LaunchValidationMemo()
+        validate_result, validate_seconds = timed(
+            lambda memo=memo: runtime_module._validate_primary_artifact(artifact, memo=memo)
+        )
+        loaded, decode_seconds = timed(
+            lambda memo=memo: runtime_module._decode_artifact(
+                artifact, available, runtime.capability, memo=memo
+            )
+        )
+        launches.append(
+            {
+                "index": index,
+                "cold": index == 0,
+                "validate_seconds": round(validate_seconds, 6),
+                "decode_seconds": round(decode_seconds, 6),
+                "total_seconds": round(validate_seconds + decode_seconds, 6),
+                "lower_calls": lower_counter.calls - lowers_before,
+                "loaded_entrypoint": loaded.target_ir.entrypoint,
+                "loaded_native_variant": loaded.target_ir.native_variant,
+            }
+        )
+        lowers_before = lower_counter.calls
+        assert validate_result is not None
+
+    stats = None
+    if hasattr(runtime_module, "artifact_semantics_cache_stats"):
+        stats = dict(runtime_module.artifact_semantics_cache_stats())
+
+    payload: Dict[str, Any] = {
+        "harness": "lac_validation_probe",
+        "tree": str(tree),
+        "steps": args.steps,
+        "past_length": args.past_length,
+        "operation_count": len(program.functions[0].body.operations),
+        "artifact_content_digest": artifact.content_digest,
+        "compile_seconds": round(compile_seconds, 3),
+        "launches": launches,
+        "cache_stats": stats,
+        "notes": [
+            "UNGATED: 12 vCPU KVM guest, no cpufreq",
+            "timed bracket is the launch() prove-out + _decode_artifact call only",
+            "no weight ingest, no op execution; graph construction and compile excluded",
+        ],
+    }
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("w", encoding="utf-8") as stream:
+        json.dump(payload, stream, ensure_ascii=False, sort_keys=True, indent=2)
+        stream.write("\n")
+    print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
