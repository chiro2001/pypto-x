@@ -0,0 +1,200 @@
+#!/usr/bin/env python3
+"""N4.1 analysis: N4.0 base vs process-level artifact semantics cache.
+
+Reuses the N4.0 decomposition reader (``n4_analyze_decomposition``) but reports
+the N4.1 A/B labels and adds the per-launch cache counters that prove the
+duplicate lowering is gone:
+
+* ``lower_avx512`` call/seconds per launch;
+* ``_validate_primary_semantics`` call/seconds per launch;
+* the four driver-side tiers (setup / loop / teardown / launch) for T=5
+  prefill and T=1 decode, plus the setup segment table;
+* the output-buffer and ``artifact_content_digest`` sha256 cross-check over
+  every interleaved round.
+
+All absolute numbers are UNGATED (12 vCPU KVM guest, no cpufreq).
+
+Usage:
+
+    python3 scripts/perf/lac_analyze.py --evidence <evidence-dir>
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import sys
+from typing import Any, Dict, List
+
+HERE = Path(__file__).resolve().parent
+N4_ANALYZER = HERE / "n4_analyze_decomposition.py"
+ROUNDS = ("base_r1", "base_r2", "base_r3", "after_r1", "after_r2", "after_r3")
+
+
+def load_n4() -> Any:
+    spec = importlib.util.spec_from_file_location("n4_analyze_decomposition", str(N4_ANALYZER))
+    if spec is None or spec.loader is None:
+        raise SystemExit("cannot load {}".format(N4_ANALYZER))
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def per_launch_rows(rounds: Dict[str, Any], n4: Any) -> List[Dict[str, Any]]:
+    rows: List[Dict[str, Any]] = []
+    for tag in ROUNDS:
+        payload = rounds.get(tag)
+        if payload is None:
+            continue
+        for launch in payload["launches"]:
+            rows.append(
+                {
+                    "round": tag,
+                    "label": launch["label"],
+                    "launch_seconds": launch["launch_seconds"],
+                    "setup_seconds": launch["setup_seconds"],
+                    "loop_seconds": launch["loop_seconds"],
+                    "teardown_seconds": launch["teardown_seconds"],
+                    "op_count": launch["op_count"],
+                    "lower_calls": launch["calls_lower_avx512"],
+                    "lower_seconds": launch["seconds_lower_avx512"],
+                    "semantics_calls": launch["calls__validate_primary_semantics"],
+                    "semantics_seconds": launch["seconds__validate_primary_semantics"],
+                    "digest_calls": launch["calls__program_digest_from_metadata"],
+                    "digest_seconds": launch["seconds__program_digest_from_metadata"],
+                    "decode_calls": launch["calls__decode_artifact"],
+                    "decode_seconds": launch["seconds__decode_artifact"],
+                    "top_validate_seconds": launch["top_validate_seconds"],
+                }
+            )
+    return rows
+
+
+def counter_table(rows: List[Dict[str, Any]], n4: Any) -> List[str]:
+    lines = [
+        "| segment (per launch, all calls) | base prefill | after prefill | base decode | after decode |",
+        "|---|---:|---:|---:|---:|",
+    ]
+    for field in (
+        "lower_calls",
+        "lower_seconds",
+        "semantics_calls",
+        "semantics_seconds",
+        "digest_calls",
+        "digest_seconds",
+        "decode_seconds",
+        "top_validate_seconds",
+    ):
+        cells = []
+        for prefix, label in (("base", "prefill"), ("after", "prefill"),
+                              ("base", "decode"), ("after", "decode")):
+            values = [
+                row[field] for row in rows
+                if row["round"].startswith(prefix) and row["label"] == label
+            ]
+            cells.append(n4.fmt(n4.median(values), 4))
+        lines.append("| {} | {} | {} | {} | {} |".format(field, *cells))
+    return lines
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", required=True)
+    parser.add_argument("--table", default=None)
+    parser.add_argument("--output", default=None)
+    args = parser.parse_args()
+
+    n4 = load_n4()
+    n4.TAGS = ROUNDS
+    evidence = Path(args.evidence)
+    rounds = n4.collect(evidence)
+    if not rounds:
+        raise SystemExit("no rounds found under {}".format(evidence / "raw"))
+
+    rows = per_launch_rows(rounds, n4)
+    sections: List[str] = [
+        "<!-- generated by scripts/perf/lac_analyze.py -->",
+        "# N4.1 process-level artifact semantics cache — A/B (UNGATED)",
+        "",
+        "base = `port/pypto-x-integration @ acece0a92` (N4.0 per-launch memo), "
+        "after = N4.1 process cache.  Rounds are interleaved base_r1 / after_r1 / ... "
+        "(T=5 prefill + T=1 decode, real weights, s3, `--no-op-recorder`).",
+        "",
+    ]
+    for prefix, name in (("base", "base acece0a92 (N4.0 per-launch memo)"),
+                         ("after", "after (N4.1 process-level cache)")):
+        sections.append("## {} — four tiers (UNGATED)".format(name))
+        for label in ("prefill", "decode"):
+            selected = n4.select(rounds, prefix, label)
+            ops = n4.median([row["op_count"] for row in selected])
+            steps = 5 if label == "prefill" else 1
+            sections.append(
+                "### T={} {} ({} rounds, ops median {})".format(
+                    steps, label, len(selected), n4.fmt(ops, 0)
+                )
+            )
+            sections.extend(n4.tier_table(rounds, prefix, label))
+            sections.append("")
+        sections.append("### setup / teardown segments ({})".format(name))
+        for label in ("prefill", "decode"):
+            steps = 5 if label == "prefill" else 1
+            sections.append("#### T={} {}".format(steps, label))
+            sections.extend(n4.segment_table(rounds, prefix, label))
+            sections.append("")
+
+    sections.append("## A/B: N4.0 base vs N4.1 process cache (UNGATED)")
+    for label in ("prefill", "decode"):
+        steps = 5 if label == "prefill" else 1
+        sections.append("### T={} {}".format(steps, label))
