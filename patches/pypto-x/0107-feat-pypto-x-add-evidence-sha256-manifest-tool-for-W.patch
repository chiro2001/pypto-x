@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: 为证据目录生成 sha256/字节清单（本地运行，不联网）。
+
+用法::
+
+    python evidence_manifest.py --root <evidence_dir> --out <evidence_dir>/evidence_manifest.json
+
+* 递归登记文件（相对 root 的路径、bytes、sha256、mtime_utc）；
+* 汇总 total_bytes / file_count；
+* 忽略目录本身与 `evidence_manifest.json`（自引用）。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+
+
+def sha256_file(path, chunk_size=1 << 22):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", required=True)
+    parser.add_argument("--out", default="")
+    parser.add_argument("--max-hash-mib", type=float, default=1024.0)
+    args = parser.parse_args(argv)
+
+    root = os.path.abspath(args.root)
+    out_path = os.path.abspath(args.out) if args.out else os.path.join(root, "evidence_manifest.json")
+    limit = int(args.max_hash_mib * 1024 * 1024)
+    entries = []
+    for current_root, _dirs, files in os.walk(root):
+        for name in sorted(files):
+            path = os.path.join(current_root, name)
+            relative = os.path.relpath(path, root)
+            if relative == os.path.relpath(out_path, root):
+                continue
+            size = os.path.getsize(path)
+            entry = {
+                "path": relative,
+                "bytes": size,
+                "mtime_utc": time.strftime(
+                    "%Y-%m-%dT%H:%M:%SZ", time.gmtime(os.path.getmtime(path))
+                ),
+            }
+            if size <= limit:
+                entry["sha256"] = sha256_file(path)
+            else:
+                entry["sha256"] = None
+                entry["sha256_skipped"] = True
+            entries.append(entry)
+
+    manifest = {
+        "schema": "pypto-x.a2-vllm-ascend.profiling.evidence-manifest.v1",
+        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "root": root,
+        "file_count": len(entries),
+        "total_bytes": sum(item["bytes"] for item in entries),
+        "files": entries,
+    }
+    with open(out_path, "w", encoding="utf-8") as handle:
+        handle.write(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
+    print("written %s (%d files, %.1f MiB)" % (out_path, len(entries), manifest["total_bytes"] / 1048576.0))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
