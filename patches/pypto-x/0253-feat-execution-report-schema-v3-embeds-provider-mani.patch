+
+# Version constants whose registered value is pinned per provider identity.
+_ARTIFACT_VERSION_KEYS = ("lowering_version", "runner_version", "wire_version", "abi_version")
+
+
+def _manifest_embedding_errors(
+    report: Mapping[str, Any], definition: Any = None
+) -> Tuple[Mapping[str, Any], ...]:
+    """Reconcile schema-v3 manifest-backed declarations with the embedded docs.
+
+    The embedded ``provider_manifest`` is the invoked provider's
+    ``ProviderCapability.to_dict()``; ``resolution_decision`` is the declared
+    (resolved) selection as frozen in the plan.  Both are checked three ways:
+
+    * the stored digest is recomputed from the embedded body;
+    * the embedded document is anchored to the *registered* provider identity
+      (schema-v3 external anchor, see ``provider_identity``) so a coordinated
+      rewrite of every report copy -- including the embedded manifest and its
+      digest -- is still refused for version/implementation/numeric-class/
+      determinism/order/pack/artifact-kind/version/library-pin facts;
+    * every report copy of a manifest-backed field is compared with the
+      embedded ground truth.
+
+    ``resolution.plan_digest`` is only cross-checked against the embedded
+    decision copy: the plan payload is not embedded, so its digest cannot be
+    re-derived from the decision digest (registered boundary).
+    """
+
+    # Local import: provider_identity imports the provider implementations,
+    # which import plan -> binding_verify at module load.
+    from .provider_identity import (
+        embedded_manifest_errors,
+        expected_artifact_digest,
+        library_pin_errors,
+        registered_identity,
+    )
+
+    errors: list = []
+
+    def fail(field: str, reason: str, requested: Any = None, available: Any = None) -> None:
+        errors.append(_error(field, reason, requested=requested, available=available))
+
+    manifest_block = _mapped(report.get("provider_manifest"))
+    decision_block = _mapped(report.get("resolution_decision"))
+    resolution = _mapped(report.get("resolution"))
+    resolved = _mapped(report.get("resolved"))
+    resolved_policy = _mapped(report.get("resolved_policy"))
+    resolved_contract = _mapped(resolved.get("contract"))
+    resolved_provider = _mapped(resolved_policy.get("provider"))
+    resolved_numeric = _mapped(resolved_policy.get("numeric"))
+    artifact = _mapped(report.get("artifact"))
+    guarantees = _mapped(report.get("guarantees"))
+    timing_basis = _mapped(_mapped(report.get("timing")).get("timing_basis"))
+    dispatch = _mapped(report.get("dispatch"))
+    capability_block = _mapped(report.get("capability"))
+    opcode = str(resolved_contract.get("opcode"))
+    invoked = dispatch.get("provider_invoked")
+
+    # -- digest self-consistency -------------------------------------------
+    typed_blocks = (
+        (manifest_block, "provider_manifest", "report_provider_manifest_digest_mismatch"),
+        (decision_block, "resolution_decision", "report_resolution_decision_digest_mismatch"),
+    )
+    for block, label, reason in typed_blocks:
+        document = block.get("document")
+        digest = block.get("digest")
+        if not isinstance(document, Mapping) or not isinstance(digest, str):
+            fail(label, "report_manifest_embedding_malformed", requested=block,
+                 available="a {document, digest} mapping block")
+            continue
+        expected = "sha256:" + sha256_text(document)
+        if digest != expected:
+            fail(label + ".digest", reason, requested=digest, available=expected)
+
+    manifest_document = _mapped(manifest_block.get("document"))
+    decision_document = _mapped(decision_block.get("document"))
+
+    # -- registered-identity anchor for the invoked manifest ----------------
+    if manifest_document:
+        errors.extend(
+            embedded_manifest_errors(
+                manifest_document, opcode, prefix="provider_manifest.document"
+            )
+        )
+
+    # -- document links ------------------------------------------------------
+    manifest_provider = manifest_document.get("provider_id")
+    if manifest_block.get("provider_id") != manifest_provider or manifest_provider != invoked:
+        fail(
+            "provider_manifest.provider_id",
+            "report_provider_manifest_provider_mismatch",
+            requested={
+                "block": manifest_block.get("provider_id"),
+                "document": manifest_provider,
+                "invoked": invoked,
+            },
+            available="provider_manifest.provider_id == document.provider_id == dispatched invoked provider",
+        )
+    if resolved.get("provider") != manifest_provider:
+        fail(
+            "resolved.provider",
+            "report_provider_manifest_provider_mismatch",
+            requested=resolved.get("provider"),
+            available=manifest_provider,
+        )
+    snapshot_digest = manifest_block.get("snapshot_digest")
+    if snapshot_digest != capability_block.get("snapshot_digest") or snapshot_digest != resolution.get(
+        "capability_digest"
+    ):
+        fail(
+            "provider_manifest.snapshot_digest",
+            "report_provider_manifest_snapshot_digest_mismatch",
+            requested=snapshot_digest,
+            available={
+                "capability.snapshot_digest": capability_block.get("snapshot_digest"),
+                "resolution.capability_digest": resolution.get("capability_digest"),
+            },
+        )
+
+    # -- invoked-manifest-backed report fields ------------------------------
+    if manifest_document:
+        if resolved.get("provider_version") != manifest_document.get("version"):
+            fail(
+                "resolved.provider_version",
+                "report_artifact_provider_version_mismatch",
+                requested=resolved.get("provider_version"),
+                available=manifest_document.get("version"),
+            )
+        if invoked == PORTABLE_PROVIDER_ID:
+            expected_implementation = portable_implementation(opcode)
+        else:
+            expected_implementation = manifest_document.get("implementation")
+        if resolved.get("implementation") != expected_implementation:
+            fail(
+                "resolved.implementation",
+                "report_implementation_not_reconciled",
+                requested=resolved.get("implementation"),
+                available=expected_implementation,
+            )
+        manifest_library = manifest_document.get("library")
+        for holder, holder_path in ((resolved, "resolved.library"), (artifact, "artifact.library")):
+            if _mapping_copy(holder.get("library")) != _mapping_copy(manifest_library):
+                fail(
+                    holder_path,
+                    "report_artifact_library_not_reconciled",
+                    requested=_mapping_copy(holder.get("library")),
+                    available=_mapping_copy(manifest_library),
+                )
+        for field, value in (
+            ("resolved.numeric_class", resolved.get("numeric_class")),
+            ("guarantees.numeric_class", guarantees.get("numeric_class")),
+            ("guarantees.precision_class", guarantees.get("precision_class")),
+        ):
+            if value != manifest_document.get("numeric_class"):
+                fail(
+                    field,
+                    "report_numeric_class_not_reconciled",
+                    requested=value,
+                    available=manifest_document.get("numeric_class"),
+                )
+        if guarantees.get("deterministic") != manifest_document.get("deterministic"):
+            fail(
+                "guarantees.deterministic",
+                "report_determinism_not_reconciled",
+                requested=guarantees.get("deterministic"),
+                available=manifest_document.get("deterministic"),
+            )
+        contract_default_order = None
+        if definition is not None:
+            contract_default_order = _mapped(
+                getattr(definition, "numeric_contract", {})
+            ).get("reduction_order_id")
+        expected_order = manifest_document.get("reduction_order_id") or contract_default_order
+        for leaf in ("reduction_order", "reduction_order_id"):
+            if guarantees.get(leaf) != expected_order:
+                fail(
+                    "guarantees." + leaf,
+                    "report_reduction_order_not_reconciled",
+                    requested=guarantees.get(leaf),
+                    available=expected_order,
+                )
+        if artifact.get("kind") != manifest_document.get("artifact_kind"):
+            fail(
+                "artifact.kind",
+                "report_artifact_kind_not_reconciled",
+                requested=artifact.get("kind"),
+                available=manifest_document.get("artifact_kind"),
+            )
+        if artifact.get("provider_version") != manifest_document.get("version"):
+            fail(
+                "artifact.provider_version",
+                "report_artifact_provider_version_mismatch",
+                requested=artifact.get("provider_version"),
+                available=manifest_document.get("version"),
+            )
+        manifest_pack = _mapped(manifest_document.get("pack"))
+        artifact_pack = _mapped(artifact.get("pack"))
+        if artifact_pack.get("strategy") != manifest_pack.get("strategy"):
+            fail(
+                "artifact.pack.strategy",
+                "report_manifest_pack_strategy_not_reconciled",
+                requested=artifact_pack.get("strategy"),
+                available=manifest_pack.get("strategy"),
+            )
+        if artifact_pack.get("included_in_timing") != manifest_pack.get("included_in_timing"):
+            fail(
+                "artifact.pack.included_in_timing",
+                "report_pack_included_in_timing_not_reconciled",
+                requested=artifact_pack.get("included_in_timing"),
+                available=manifest_pack.get("included_in_timing"),
+            )
+        if timing_basis.get("pack_semantics") != manifest_pack.get("strategy"):
+            fail(
+                "timing.timing_basis.pack_semantics",
+                "report_pack_semantics_mismatch",
+                requested=timing_basis.get("pack_semantics"),
+                available=manifest_pack.get("strategy"),
+            )
+        if artifact.get("provider_artifact_digest") != manifest_document.get(
+            "provider_artifact_digest"
+        ):
+            fail(
+                "artifact.provider_artifact_digest",
+                "report_provider_artifact_digest_not_reconciled",
+                requested=artifact.get("provider_artifact_digest"),
+                available=manifest_document.get("provider_artifact_digest"),
+            )
+        manifest_contracts = _mapped(manifest_document.get("contracts"))
+        if manifest_contracts.get(opcode) != resolution.get("contract_digest"):
+            fail(
+                "provider_manifest.document.contracts." + opcode,
+                "report_manifest_contract_digest_mismatch",
+                requested=manifest_contracts.get(opcode),
+                available=resolution.get("contract_digest"),
+            )
+
+    # -- registered artifact version constants ------------------------------
+    invoked_identity = registered_identity(invoked, opcode) if invoked in KNOWN_PROVIDER_IDS else None
+    if invoked_identity is None:
+        fail(
+            "resolved.provider",
+            "report_provider_not_registered",
+            requested=invoked,
+            available=list(KNOWN_PROVIDER_IDS),
+        )
+    else:
+        for field in _ARTIFACT_VERSION_KEYS:
+            if artifact.get(field) != invoked_identity[field]:
+                fail(
+                    "artifact." + field,
+                    "report_artifact_version_constant_mismatch",
+                    requested=artifact.get(field),
+                    available=invoked_identity[field],
+                )
+
+    # -- resolution-decision anchor -----------------------------------------
+    if decision_document:
+        for key, actual in (
+            ("plan_digest", resolution.get("plan_digest")),
+            ("policy_digest", resolution.get("policy_digest")),
+            ("capability_digest", resolution.get("capability_digest")),
+            ("contract_digest", resolution.get("contract_digest")),
+        ):
+            if decision_document.get(key) != actual:
+                fail(
+                    "resolution_decision.document." + key,
+                    "report_resolution_decision_not_reconciled",
+                    requested=decision_document.get(key),
+                    available=actual,
+                )
+        selected_provider = decision_document.get("selected_provider")
+        if selected_provider != resolved_provider.get("resolved"):
+            fail(
+                "resolution_decision.document.selected_provider",
+                "report_resolution_decision_not_reconciled",
+                requested=selected_provider,
+                available=resolved_provider.get("resolved"),
+            )
+        declared_identity = (
+            registered_identity(selected_provider, opcode)
+            if selected_provider in KNOWN_PROVIDER_IDS
+            else None
+        )
+        if declared_identity is None:
+            fail(
+                "resolution_decision.document.selected_provider",
+                "report_provider_not_registered",
+                requested=selected_provider,
+                available=list(KNOWN_PROVIDER_IDS),
+            )
+        else:
+            for document_key, identity_key in (
+                ("selected_provider_version", "version"),
+                ("selected_implementation", "implementation"),
+                ("selected_numeric_class", "numeric_class"),
+                ("selected_deterministic", "deterministic"),
+                ("selected_reduction_order", "reduction_order_id"),
+                ("selected_reduction_order_id", "reduction_order_id"),
+                ("artifact_kind", "artifact_kind"),
+                ("artifact_provider_version", "version"),
+                ("artifact_pack", "pack"),
+            ):
+                if decision_document.get(document_key) != declared_identity[identity_key]:
+                    fail(
+                        "resolution_decision.document." + document_key,
+                        "report_resolution_decision_not_reconciled",
+                        requested=decision_document.get(document_key),
+                        available=declared_identity[identity_key],
+                    )
+            for document_key, identity_key in (
+                ("artifact_lowering_version", "lowering_version"),
