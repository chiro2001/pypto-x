--- /dev/null
+++ b/python/pypto/execution/provider_identity.py
@@ -0,0 +1,460 @@
+"""Registered provider identity anchors for report schema v3.
+
+A schema-v3 report embeds the declared and invoked providers' manifests
+(``ProviderCapability.to_dict()`` documents) together with a digest
+recomputed from the embedded body.  That digest only makes the embedded copy
+self-consistent; the *external* anchor is the registered provider identity in
+this module, which rebuilds the expected manifest from code constants and the
+operator registry.  An embedded manifest whose version, implementation,
+numeric class, determinism, reduction order, pack semantics, artifact kind,
+versions or library pin disagree with the registered identity is refused even
+when its own digest was recomputed.
+
+The only probe-dependent inputs are taken from the embedded document itself
+(the library fingerprint and the thread counts), so this module never touches
+the filesystem, never re-runs the capability probe and never re-runs the
+resolver.  The AOCL identity is pinned by the registered sha256 / BLIS
+tag/commit / arch / ABI-width / pack constants, so a report produced on a host
+with the AOCL artifact validates on a host without it.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional, Tuple
+
+from pypto.compiler.artifact import ABI_VERSION
+from pypto.compiler.targets.cpu import ARTIFACT_PAYLOAD_VERSION
+from pypto.lowering.cpu import LOWERING_VERSION
+
+from .capability import (
+    PORTABLE_PROVIDER_VERSION,
+    portable_provider_capability,
+)
+from .op_registry import get_op_definition
+from .provider_aocl import (
+    AOCL_ABI_VERSION,
+    AOCL_ARCH_ID,
+    AOCL_ARCH_STRING,
+    AOCL_ARTIFACT_KIND,
+    AOCL_BF16_IMPLEMENTATION,
+    AOCL_BF16_REDUCTION_ORDER,
+    AOCL_BLAS_INT_TYPE_SIZE,
+    AOCL_BLIS_COMMIT,
+    AOCL_BLIS_TAG,
+    AOCL_BUILD_OPTIONS,
+    AOCL_F32_IMPLEMENTATION,
+    AOCL_F32_REDUCTION_ORDER,
+    AOCL_INT_TYPE_SIZE,
+    AOCL_LOWERING_VERSION,
+    AOCL_NUMERIC_CLASS,
+    AOCL_PROVIDER_VERSION,
+    AOCL_RUNNER_VERSION,
+    AOCL_SHA256_PIN,
+    AOCL_WIRE_VERSION,
+    _BF16_SYMBOLS,
+    _COMMON_SYMBOLS,
+    _F32_SYMBOLS,
+    _pack_spec,
+    aocl_capability_entry,
+    provider_artifact_digest,
+)
+from .provider_aocl_int8 import (
+    AOCL_INT8_ABI_VERSION,
+    AOCL_INT8_IMPLEMENTATION,
+    AOCL_INT8_KC_BLOCK,
+    AOCL_INT8_LOWERING_VERSION,
+    AOCL_INT8_NUMERIC_CLASS,
+    AOCL_INT8_PROVIDER_VERSION,
+    AOCL_INT8_QUANT_MAX,
+    AOCL_INT8_QUANT_MIN,
+    AOCL_INT8_REDUCTION_ORDER,
+    AOCL_INT8_RUNNER_VERSION,
+    AOCL_INT8_WIRE_VERSION,
+    _INT8_FUSED_SYMBOLS,
+    _INT8_SYMBOLS,
+    _int8_pack_spec,
+    _provider_artifact_digest,
+    aocl_int8_capability_entry,
+)
+from .provider_ids import (
+    AOCL_LPGEMM_BF16_PROVIDER_ID,
+    AOCL_LPGEMM_F32_PROVIDER_ID,
+    AOCL_LPGEMM_INT8_PROVIDER_ID,
+    KNOWN_PROVIDER_IDS,
+    PORTABLE_PROVIDER_ID,
+    portable_implementation,
+)
+from .providers import PORTABLE_NUMERIC_CLASS, PORTABLE_RUNNER_VERSION
+
+_AOCL_LIBRARY_PINS = (
+    ("sha256_expected", AOCL_SHA256_PIN),
+    ("sha256", AOCL_SHA256_PIN),
+    ("blis_tag", AOCL_BLIS_TAG),
+    ("blis_commit", AOCL_BLIS_COMMIT),
+    ("arch_id_expected", AOCL_ARCH_ID),
+    ("arch_string_expected", AOCL_ARCH_STRING),
+    ("int_type_size_expected", AOCL_INT_TYPE_SIZE),
+    ("blas_int_type_size_expected", AOCL_BLAS_INT_TYPE_SIZE),
+    ("arch_id", AOCL_ARCH_ID),
+    ("arch_string", AOCL_ARCH_STRING),
+    ("int_type_size", AOCL_INT_TYPE_SIZE),
+    ("blas_int_type_size", AOCL_BLAS_INT_TYPE_SIZE),
+    ("thread_knob", "bli_thread_set_num_threads"),
+)
+
+_AOCL_SYMBOL_PINS = (
+    ("common", list(_COMMON_SYMBOLS)),
+    ("bf16", list(_BF16_SYMBOLS)),
+    ("f32", list(_F32_SYMBOLS)),
+)
+
+_INT8_API = {
+    "gemm": "aocl_gemm_s8s8s32os32",
+    "fused": "aocl_gemm_s8s8s32obf16_sym_quant",
+    "reorder": "aocl_reorder_s8s8s32os32_sym_quant",
+    "axis_contract": "s8s8_s32; zero_point=0; codes in [{}, {}]".format(
+        AOCL_INT8_QUANT_MIN, AOCL_INT8_QUANT_MAX
+    ),
+    "kc_block": AOCL_INT8_KC_BLOCK,
+}
+
+
+def _error(
+    field: str, reason: str, requested: Any = None, available: Any = None
+) -> Mapping[str, Any]:
+    return {
+        "field": field,
+        "reason": reason,
+        "requested": requested,
+        "available": available,
+    }
+
+
+def _is_positive_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool) and value > 0
+
+
+def _diff(
+    actual: Any,
+    expected: Any,
+    path: str,
+    out: list,
+    limit: int = 12,
+) -> None:
+    """Collect structural differences between the embedded and expected doc."""
+
+    if len(out) >= limit:
+        return
+    if isinstance(expected, Mapping) and isinstance(actual, Mapping):
+        for key in sorted(set(expected) | set(actual)):
+            if len(out) >= limit:
+                return
+            child = "{}.{}".format(path, key) if path else str(key)
+            if key not in actual:
+                out.append((child, None, expected[key]))
+            elif key not in expected:
+                out.append((child, actual[key], None))
+            else:
+                _diff(actual[key], expected[key], child, out, limit)
+        return
+    if isinstance(expected, (list, tuple)) and isinstance(actual, (list, tuple)):
+        if len(expected) != len(actual):
+            out.append((path, list(actual), list(expected)))
+            return
+        for index, (left, right) in enumerate(zip(actual, expected)):
+            if len(out) >= limit:
+                return
+            _diff(left, right, "{}[{}]".format(path, index), out, limit)
+        return
+    if type(actual) is not type(expected) or actual != expected:
+        out.append((path, actual, expected))
+
+
+def _variant(provider_id: str) -> str:
+    if provider_id == AOCL_LPGEMM_BF16_PROVIDER_ID:
+        return "bf16"
+    if provider_id == AOCL_LPGEMM_F32_PROVIDER_ID:
+        return "f32"
+    if provider_id == AOCL_LPGEMM_INT8_PROVIDER_ID:
+        return "int8"
+    raise KeyError(provider_id)
+
+
+def registered_identity(provider_id: str, opcode: str) -> Optional[Mapping[str, Any]]:
+    """Return the registered identity facts for one provider id + opcode.
+
+    The values are code/registry constants only.  ``artifact_digest_kind``
+    marks providers whose ``provider_artifact_digest`` can be recomputed from
+    the embedded library fingerprint via :func:`expected_artifact_digest`.
+    """
+
+    if provider_id == PORTABLE_PROVIDER_ID:
+        get_op_definition(opcode)
+        portable = portable_provider_capability()
+        return {
+            "version": PORTABLE_PROVIDER_VERSION,
+            "implementation": portable_implementation(opcode),
+            "numeric_class": PORTABLE_NUMERIC_CLASS,
+            "deterministic": True,
+            # The portable manifest is built once, from the matmul definition;
+            # the per-opcode implementation is the only opcode-dependent fact.
+            "reduction_order_id": portable.reduction_order_id,
+            "artifact_kind": "core_ir_artifact",
+            "pack": {"strategy": "none", "included_in_timing": True},
+            "library": {},
+            "provider_artifact_digest": None,
+            "lowering_version": LOWERING_VERSION,
+            "runner_version": PORTABLE_RUNNER_VERSION,
+            "wire_version": ARTIFACT_PAYLOAD_VERSION,
+            "abi_version": ABI_VERSION,
+            "artifact_digest_kind": None,
+        }
+    if provider_id == AOCL_LPGEMM_BF16_PROVIDER_ID:
+        return {
+            "version": AOCL_PROVIDER_VERSION,
+            "implementation": AOCL_BF16_IMPLEMENTATION,
+            "numeric_class": AOCL_NUMERIC_CLASS,
+            "deterministic": True,
+            "reduction_order_id": AOCL_BF16_REDUCTION_ORDER,
+            "artifact_kind": AOCL_ARTIFACT_KIND,
+            "pack": _pack_spec("bf16"),
+            "library": None,
+            "provider_artifact_digest": None,
+            "lowering_version": AOCL_LOWERING_VERSION,
+            "runner_version": AOCL_RUNNER_VERSION,
+            "wire_version": AOCL_WIRE_VERSION,
+            "abi_version": AOCL_ABI_VERSION,
+            "artifact_digest_kind": "bf16",
+        }
+    if provider_id == AOCL_LPGEMM_F32_PROVIDER_ID:
+        return {
+            "version": AOCL_PROVIDER_VERSION,
+            "implementation": AOCL_F32_IMPLEMENTATION,
+            "numeric_class": AOCL_NUMERIC_CLASS,
+            "deterministic": True,
+            "reduction_order_id": AOCL_F32_REDUCTION_ORDER,
+            "artifact_kind": AOCL_ARTIFACT_KIND,
+            "pack": _pack_spec("f32"),
+            "library": None,
+            "provider_artifact_digest": None,
+            "lowering_version": AOCL_LOWERING_VERSION,
+            "runner_version": AOCL_RUNNER_VERSION,
+            "wire_version": AOCL_WIRE_VERSION,
+            "abi_version": AOCL_ABI_VERSION,
+            "artifact_digest_kind": "f32",
+        }
+    if provider_id == AOCL_LPGEMM_INT8_PROVIDER_ID:
+        return {
+            "version": AOCL_INT8_PROVIDER_VERSION,
+            "implementation": AOCL_INT8_IMPLEMENTATION,
+            "numeric_class": AOCL_INT8_NUMERIC_CLASS,
+            "deterministic": True,
+            "reduction_order_id": AOCL_INT8_REDUCTION_ORDER,
+            "artifact_kind": AOCL_ARTIFACT_KIND,
+            "pack": _int8_pack_spec("int32"),
+            "library": None,
+            "provider_artifact_digest": None,
+            "lowering_version": AOCL_INT8_LOWERING_VERSION,
+            "runner_version": AOCL_INT8_RUNNER_VERSION,
+            "wire_version": AOCL_INT8_WIRE_VERSION,
+            "abi_version": AOCL_INT8_ABI_VERSION,
+            "artifact_digest_kind": "int8",
+        }
+    return None
+
+
+def expected_artifact_digest(provider_id: str, library: Mapping[str, Any]) -> Optional[str]:
+    """Recompute the registered provider-artifact digest from the library facts."""
+
+    if provider_id == AOCL_LPGEMM_BF16_PROVIDER_ID:
+        return provider_artifact_digest(library, AOCL_BF16_IMPLEMENTATION, "bf16")
+    if provider_id == AOCL_LPGEMM_F32_PROVIDER_ID:
+        return provider_artifact_digest(library, AOCL_F32_IMPLEMENTATION, "f32")
+    if provider_id == AOCL_LPGEMM_INT8_PROVIDER_ID:
+        return _provider_artifact_digest(library, AOCL_INT8_IMPLEMENTATION, "int32")
+    return None
+
+
+def library_pin_errors(
+    provider_id: str, library: Any, prefix: str
+) -> Tuple[Mapping[str, Any], ...]:
+    """Check the probe-dependent library facts of a vendor manifest."""
+
+    if provider_id not in (AOCL_LPGEMM_BF16_PROVIDER_ID, AOCL_LPGEMM_F32_PROVIDER_ID,
+                           AOCL_LPGEMM_INT8_PROVIDER_ID):
+        return ()
+    if not isinstance(library, Mapping):
+        return (
+            _error(prefix, "report_provider_manifest_library_pin_mismatch", requested=library,
+                   available="the registered AOCL library fingerprint"),
+        )
+    errors = []
+    for key, expected in _AOCL_LIBRARY_PINS:
+        if library.get(key) != expected:
+            errors.append(
+                _error(
+                    "{}.{}".format(prefix, key),
+                    "report_provider_manifest_library_pin_mismatch",
+                    requested=library.get(key),
+                    available=expected,
+                )
+            )
+    if list(library.get("build_options") or ()) != list(AOCL_BUILD_OPTIONS):
+        errors.append(
+            _error(
+                prefix + ".build_options",
+                "report_provider_manifest_library_pin_mismatch",
+                requested=library.get("build_options"),
+                available=list(AOCL_BUILD_OPTIONS),
+            )
+        )
+    if list(library.get("env_thread_knobs") or ()) != ["OMP_NUM_THREADS", "BLIS_NUM_THREADS"]:
+        errors.append(
+            _error(
+                prefix + ".env_thread_knobs",
+                "report_provider_manifest_library_pin_mismatch",
+                requested=library.get("env_thread_knobs"),
+                available=["OMP_NUM_THREADS", "BLIS_NUM_THREADS"],
+            )
+        )
+    version = library.get("blis_version")
+    if not isinstance(version, str) or AOCL_BLIS_TAG not in version:
+        errors.append(
+            _error(
+                prefix + ".blis_version",
+                "report_provider_manifest_library_pin_mismatch",
+                requested=version,
+                available="a BLIS version string containing {!r}".format(AOCL_BLIS_TAG),
+            )
+        )
+    default_threads = library.get("default_threads")
+    if not _is_positive_int(default_threads):
+        errors.append(
+            _error(
+                prefix + ".default_threads",
+                "report_provider_manifest_library_pin_mismatch",
+                requested=default_threads,
+                available="a positive integer",
+            )
+        )
+    symbols = library.get("symbols")
+    if not isinstance(symbols, Mapping):
+        errors.append(
+            _error(prefix + ".symbols", "report_provider_manifest_library_pin_mismatch",
+                   requested=symbols, available="the registered AOCL symbol lists")
+        )
+    else:
+        expected_symbols = list(_AOCL_SYMBOL_PINS)
+        if provider_id == AOCL_LPGEMM_INT8_PROVIDER_ID:
+            expected_symbols = expected_symbols + [
+                ("int8", list(_INT8_SYMBOLS)),
+                ("int8_fused", list(_INT8_FUSED_SYMBOLS)),
+            ]
+        for key, expected in expected_symbols:
+            if list(symbols.get(key) or ()) != expected:
+                errors.append(
+                    _error(
+                        "{}.symbols.{}".format(prefix, key),
+                        "report_provider_manifest_library_pin_mismatch",
+                        requested=symbols.get(key),
+                        available=expected,
+                    )
+                )
+        if provider_id == AOCL_LPGEMM_INT8_PROVIDER_ID and dict(
+            library.get("int8_api") or {}
+        ) != _INT8_API:
+            errors.append(
+                _error(
+                    prefix + ".int8_api",
+                    "report_provider_manifest_library_pin_mismatch",
+                    requested=library.get("int8_api"),
+                    available=_INT8_API,
+                )
+            )
+    return tuple(errors)
+
+
+def embedded_manifest_errors(
+    document: Any, opcode: str, prefix: str = "provider_manifest.document"
+) -> Tuple[Mapping[str, Any], ...]:
+    """Check one embedded provider manifest against the registered identity."""
+
+    if not isinstance(document, Mapping):
+        return (
+            _error(prefix, "report_provider_manifest_malformed", requested=document,
+                   available="a ProviderCapability document"),
+        )
+    provider_id = document.get("provider_id")
+    if not isinstance(provider_id, str) or provider_id not in KNOWN_PROVIDER_IDS:
+        return (
+            _error(
+                prefix + ".provider_id",
+                "report_provider_manifest_not_registered",
+                requested=provider_id,
+                available=list(KNOWN_PROVIDER_IDS),
+            ),
+        )
+    if provider_id == PORTABLE_PROVIDER_ID:
+        expected = portable_provider_capability().to_dict()
+        out: list = []
+        _diff(document, expected, "", out)
+        return tuple(
+            _error(
+                prefix + ("." + path if path else ""),
+                "report_provider_manifest_identity_mismatch",
+                requested=actual,
+                available=wanted,
+            )
+            for path, actual, wanted in out
+        )
+    library = document.get("library")
+    max_threads = document.get("max_threads")
+    threads = document.get("threads")
+    default_threads = threads.get("default_threads") if isinstance(threads, Mapping) else None
+    if (
+        not isinstance(library, Mapping)
+        or not _is_positive_int(max_threads)
+        or not _is_positive_int(default_threads)
+    ):
+        return (
+            _error(
+                prefix,
+                "report_provider_manifest_malformed",
+                requested={
+                    "library": type(library).__name__,
+                    "max_threads": max_threads,
+                    "default_threads": default_threads,
+                },
+                available="a vendor manifest with a library mapping and positive thread counts",
+            ),
+        )
+    variant = _variant(provider_id)
+    if variant == "int8":
+        expected = aocl_int8_capability_entry(
+            library, max_threads, default_threads, available=True, reason=None
+        ).to_dict()
+    else:
+        expected = aocl_capability_entry(
+            variant, library, max_threads, default_threads, available=True, reason=None
+        ).to_dict()
+    out = []
+    _diff(document, expected, "", out)
+    errors = [
+        _error(
+            prefix + ("." + path if path else ""),
+            "report_provider_manifest_identity_mismatch",
+            requested=actual,
+            available=wanted,
+        )
+        for path, actual, wanted in out
+    ]
+    errors.extend(library_pin_errors(provider_id, library, prefix + ".library"))
+    return tuple(errors)
+
+
+__all__ = [
+    "embedded_manifest_errors",
+    "expected_artifact_digest",
+    "library_pin_errors",
+    "registered_identity",
+]
