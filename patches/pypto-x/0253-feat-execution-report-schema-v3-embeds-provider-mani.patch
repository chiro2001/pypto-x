--- /dev/null
+++ b/python/tests/ut/pypto_x/test_execution_report_manifest_v3.py
@@ -0,0 +1,679 @@
+"""Report schema v3: embedded manifest/decision self-certification.
+
+Schema v2 accepted a report whose manifest-only facts (library fingerprint,
+pack strategy/inclusion, numeric class, determinism, reduction order,
+implementation, provider/artifact version constants, provider artifact
+digest) were rewritten in *every* report copy.  Schema v3 embeds the invoked
+provider's ``ProviderCapability`` document plus the canonical resolution
+decision, recomputes both digests from the embedded bodies, and reconciles
+every report copy against the embedded ground truth.
+
+These tests cover:
+
+* the genuine portable / AOCL bf16 / AOCL f32 / declared- and runtime-
+  fallback / AOCL int8 reports still validate;
+* every newly-reconciled field is refused for a single-copy tamper and for a
+  coordinated rewrite of every report copy (including the embedded manifest
+  and its recomputed digest) -- the registered provider identity is the
+  external anchor for the latter;
+* a schema-v2 report is rejected as legacy, and a self-inconsistent embedded
+  digest is refused;
+* the honest residual: ``resolution.plan_digest`` is cross-checked against
+  the embedded decision copy but the plan payload is not embedded, so a
+  coordinated rewrite of the digest + decision body + decision digest is a
+  documented boundary (the decision digest is not the plan-digest preimage).
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+from typing import Any, Mapping
+
+import pytest
+
+import pypto.execution.providers as providers_module
+
+from pypto.backends.cpu import HostTensor
+from pypto.execution import (
+    AOCL_DEFAULT_LIBRARY,
+    AOCL_LPGEMM_BF16_PROVIDER_ID,
+    AOCL_LPGEMM_F32_PROVIDER_ID,
+    AOCL_LPGEMM_INT8_PROVIDER_ID,
+    AOCL_SHA256_PIN,
+    CapabilitySnapshot,
+    ExecutionPolicy,
+    FallbackPolicy,
+    NumericPolicy,
+    ProviderCapability,
+    ProviderPolicy,
+    ProviderUnavailableError,
+    REPORT_SCHEMA_VERSION,
+    ResourcePolicy,
+    aocl_provider_capabilities,
+    aocl_int8_provider_capabilities,
+    execute_matmul,
+    execute_matmul_plan,
+    execute_qmatmul,
+    execute_qmatmul_plan,
+    host_features,
+    plan_matmul,
+    portable_provider_capability,
+    resolve_qmatmul,
+    validate_report_schema,
+)
+from pypto.execution.errors import ReportSchemaError
+from pypto.target._utils import sha256_text
+
+AOCL_PRESENT = os.path.isfile(AOCL_DEFAULT_LIBRARY)
+requires_aocl = pytest.mark.skipif(not AOCL_PRESENT, reason="Q8 AOCL artifact is not present on this host")
+_HOST_FEATURES = frozenset(host_features())
+requires_avx512_bf16 = pytest.mark.skipif(
+    not {"avx512f", "avx512_bf16"} <= _HOST_FEATURES,
+    reason="host lacks avx512f/avx512_bf16",
+)
+requires_int8 = pytest.mark.skipif(
+    not {"avx512f", "avx512_vnni"} <= _HOST_FEATURES,
+    reason="host lacks avx512f/avx512_vnni",
+)
+
+
+def _digest(document: Any) -> str:
+    return "sha256:" + sha256_text(document)
+
+
+def _portable_report() -> Mapping[str, Any]:
+    left = HostTensor("float32", (2, 4), [float(index + 1) for index in range(8)])
+    right = HostTensor("float32", (4, 4), [0.5] * 16)
+    _, report = execute_matmul(left, right, ExecutionPolicy())
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def _vendor_policy(dtype: str) -> ExecutionPolicy:
+    del dtype
+    # Pin the thread count: an env_default plan depends on the BLIS library's
+    # load-time thread count, which is process-global and earlier vendor tests
+    # legitimately change.
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=2),
+    )
+
+
+def _vendor_report(dtype: str) -> Mapping[str, Any]:
+    left = HostTensor(dtype, (4, 32), [float(index % 7 + 1) for index in range(128)])
+    right = HostTensor(dtype, (32, 8), [0.5] * 256)
+    _, report = execute_matmul(left, right, _vendor_policy(dtype))
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def _int8_report() -> Mapping[str, Any]:
+    left = HostTensor("int8", (2, 8), list(range(1, 17)))
+    right = HostTensor("int8", (8, 2), [1, 0] * 8)
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=1),
+    )
+    _, report = execute_qmatmul(left, right, policy)
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def _unavailable_entry(provider_id: str):
+    entries = {entry.provider_id: entry for entry in aocl_provider_capabilities()}
+    base = dict(entries[provider_id].to_dict())
+    base["available"] = False
+    base["reason"] = "unit_test_unavailable"
+    return ProviderCapability.from_dict(base)
+
+
+def _repair_manifest_digest(document: Mapping[str, Any]) -> None:
+    block = document["provider_manifest"]
+    block["digest"] = _digest(block["document"])
+
+
+def _repair_decision_digest(document: Mapping[str, Any]) -> None:
+    block = document["resolution_decision"]
+    block["digest"] = _digest(block["document"])
+
+
+def _expect_refused(document: Mapping[str, Any], reason: str = None):
+    with pytest.raises(ReportSchemaError) as excinfo:
+        validate_report_schema(document)
+    error = excinfo.value
+    assert error.code == "REPORT_SCHEMA_INVALID"
+    if reason is not None:
+        assert error.reason == reason, error.to_dict()
+    return error
+
+
+def _expect_refused_with(document: Mapping[str, Any], reason: str):
+    """Refused, and the given reason appears in the aggregated error list.
+
+    A coordinated rewrite may trip an earlier in-document echo check; the
+    aggregated ``details.errors`` still carries the registered-identity
+    refusal this test is about.
+    """
+
+    error = _expect_refused(document)
+    reasons = [item.get("reason") for item in error.details.get("errors", [])]
+    assert reason in reasons, error.to_dict()
+    return error
+
