+def test_plan_digest_coordinated_rewrite_is_the_documented_boundary():
+    """The plan payload is not embedded, so plan_digest has no external anchor.
+
+    ``resolution.plan_digest`` is cross-checked against the embedded decision
+    document copy, but a forger who rewrites both plus the recomputed decision
+    digest is accepted: the decision digest is not the plan-digest preimage.
+    This is registered as a residual boundary in 0006 section 7.1 and the
+    schema-v3 brief.  If the plan payload is ever embedded, this test must be
+    inverted to expect a refusal.
+    """
+
+    document = _portable_report()
+    forged = "sha256:" + "5" * 64
+    document["resolution"]["plan_digest"] = forged
+    document["resolution_decision"]["document"]["plan_digest"] = forged
+    _repair_decision_digest(document)
+    validate_report_schema(document)
+    assert document["resolution"]["plan_digest"] == forged
