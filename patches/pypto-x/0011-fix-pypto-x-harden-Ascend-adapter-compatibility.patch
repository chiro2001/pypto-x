+    # A real bridge may report the ABI selected by its compiler.  ``None``
+    # means that the hook delegates ABI selection to CompileOptions.
+    abi_version: Optional[str] = field(default=None, compare=True)
 
     def __post_init__(self) -> None:
         if not isinstance(self.format, str) or not self.format.strip():
             raise BackendContractError("Ascend compiler artifact format must be non-empty")
         if not isinstance(self.entrypoint, str) or not self.entrypoint.strip():
             raise BackendContractError("Ascend compiler artifact entrypoint must be non-empty")
+        if self.abi_version is not None and (
+            not isinstance(self.abi_version, str) or not self.abi_version.strip()
+        ):
+            raise BackendContractError("Ascend compiler artifact ABI version must be non-empty")
         if self.payload is None and self.path is None:
             raise BackendContractError("Ascend compiler artifact needs payload or path")
         if self.payload is not None and self.path is not None:
@@ -93,11 +109,19 @@ class AscendArtifactPayload:
             raise BackendContractError("Ascend compiler artifact metadata is not stable ABI data") from exc
         object.__setattr__(self, "format", self.format.strip().lower())
