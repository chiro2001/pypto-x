+        if self.abi_version is not None:
+            object.__setattr__(self, "abi_version", self.abi_version.strip())
         object.__setattr__(self, "metadata", normalized_metadata)
 
     def to_public_artifact(self, target: TargetSpec, abi_version: str = ABI_VERSION) -> Artifact:
         """Convert the private result into the W1 public artifact value."""
 
+        if self.abi_version is not None and self.abi_version != abi_version:
+            raise BackendContractError(
+                "Ascend compiler artifact ABI does not match requested ABI",
+                details={"payload_abi_version": self.abi_version, "requested_abi_version": abi_version},
+            )
+
         return Artifact(
             format=self.format,
             entrypoint=self.entrypoint,
@@ -118,6 +142,7 @@ class AscendArtifactPayload:
             payload=artifact.payload,
             path=artifact.path,
             metadata=mapping_copy(artifact.metadata),
+            abi_version=artifact.abi_version,
         )
 
 
@@ -387,6 +412,22 @@ class AscendCompilerBackend:
                 "Ascend compile hook must return AscendArtifactPayload",
