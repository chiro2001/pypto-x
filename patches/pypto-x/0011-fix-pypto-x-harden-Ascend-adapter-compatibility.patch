@@ -74,6 +74,7 @@ def _target():
 class FakeHooks:
     def __init__(self):
         self.calls = []
+        self.artifact_abi_version = None
 
     def availability(self):
         return Availability.yes("fake-ascend")
@@ -90,6 +91,7 @@ class FakeHooks:
             payload=b"fake-binary",
             metadata={"source": "fake-hook"},
             opaque={"vendor_handle": "private"},
+            abi_version=self.artifact_abi_version,
         )
 
     def load(self, artifact):
@@ -151,6 +153,24 @@ def test_compiler_requires_its_private_lowered_wrapper():
         backend.compile("raw-ir")
 
 
+def test_compile_rejects_format_or_abi_mismatch_before_caching():
+    hooks = FakeHooks()
+    backend = AscendBackend(hooks)
+    lowered = backend.lower("core-program", _target())
+
+    with pytest.raises(BackendContractError, match="format"):
+        backend.compile(lowered, CompileOptions(artifact_format="wrong-format"))
+    assert backend._artifact_payloads == {}
+
+    hooks.artifact_abi_version = "2"
+    with pytest.raises(BackendContractError, match="ABI"):
+        backend.compile(
+            lowered,
+            CompileOptions(artifact_format="fake-ascend-binary", abi_version="1"),
+        )
+    assert backend._artifact_payloads == {}
+
+
 def test_runtime_requires_load_before_workspace_or_launch():
     hooks = FakeHooks()
     backend = AscendBackend(hooks)
@@ -171,6 +191,31 @@ def test_runtime_requires_load_before_workspace_or_launch():
         backend.launch(request)
 
 
+def test_runtime_rejects_non_ascend_artifacts_before_calling_hooks():
+    hooks = FakeHooks()
+    backend = AscendBackend(hooks)
+    cpu_artifact = Artifact(
+        format="fake-ascend-binary",
+        entrypoint="qwen_kernel",
+        target=TargetSpec("cpu", "x86_64-linux-gnu"),
+        payload=b"not-for-ascend",
+    )
+    request = LaunchRequest(
+        cpu_artifact,
+        inputs=[TensorDesc("bf16", (1,), address=1)],
+        outputs=[TensorDesc("bf16", (1,), address=2)],
+    )
+
+    for operation in (
+        lambda: backend.load(cpu_artifact),
+        lambda: backend.workspace_size(request),
+        lambda: backend.launch(request),
+    ):
+        with pytest.raises(BackendContractError, match="another target"):
+            operation()
+    assert [call[0] for call in hooks.calls] == []
+
+
 def test_default_backend_is_structurally_unavailable_without_explicit_hook():
     backend = create_ascend_backend()
     status = backend.availability()
