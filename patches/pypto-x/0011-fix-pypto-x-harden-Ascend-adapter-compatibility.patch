@@ -445,10 +502,19 @@ class AscendRuntimeBackend:
             raise TypeError("Ascend runtime expects a LaunchRequest")
         return str(request.artifact.cache_key)
 
-    def load(self, artifact: Artifact) -> Any:
-        self._require_available()
+    @staticmethod
+    def _validate_artifact_target(artifact: Artifact) -> None:
         if not isinstance(artifact, Artifact):
             raise TypeError("Ascend runtime expects an Artifact")
+        if artifact.target.kind != ASCEND_BACKEND_NAME:
+            raise BackendContractError(
+                "Ascend runtime cannot consume an artifact for another target",
+                details={"expected_target_kind": ASCEND_BACKEND_NAME, "actual_target_kind": artifact.target.kind},
+            )
+
+    def load(self, artifact: Artifact) -> Any:
+        self._validate_artifact_target(artifact)
+        self._require_available()
         artifact.validate()
         key = str(artifact.cache_key)
         payload = self._artifact_payloads.get(key)
@@ -459,9 +525,10 @@ class AscendRuntimeBackend:
