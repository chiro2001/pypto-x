diff --git a/python/pypto/compiler/api.py b/python/pypto/compiler/api.py
index 0ccf4dfb7..a53d59a22 100644
--- a/python/pypto/compiler/api.py
+++ b/python/pypto/compiler/api.py
@@ -15,7 +15,7 @@ except ImportError:  # pragma: no cover - exercised only on Python 3.7.
         return cls
 
 from pypto.target._utils import frozen_mapping, mapping_copy
-from pypto.target.errors import BackendContractError
+from pypto.target.errors import ABIValidationError, BackendContractError, VersionMismatchError
 from pypto.target.spec import TargetSpec
 
 from .artifact import ABI_VERSION, Artifact
@@ -92,4 +92,26 @@ def compile_program(
     artifact = backend.compile(target_ir, options)
     if not isinstance(artifact, Artifact):
         raise BackendContractError("compiler backend compile() must return Artifact")
+    try:
+        artifact.validate()
+    except (ABIValidationError, VersionMismatchError) as exc:
+        raise BackendContractError("compiler backend returned an invalid Artifact: {}".format(exc)) from exc
+    if artifact.target != target:
+        raise BackendContractError(
+            "compiler backend returned an Artifact for a different target",
+            details={"requested_target": target.key, "artifact_target": artifact.target.key},
+        )
+    if options is not None:
+        if not isinstance(options, CompileOptions):
+            raise BackendContractError("compile options must be CompileOptions")
+        if artifact.format != options.artifact_format:
+            raise BackendContractError(
+                "compiler backend returned an Artifact with a different format",
+                details={"requested_format": options.artifact_format, "artifact_format": artifact.format},
+            )
+        if artifact.abi_version != options.abi_version:
+            raise BackendContractError(
+                "compiler backend returned an Artifact with a different ABI version",
+                details={"requested_abi_version": options.abi_version, "artifact_abi_version": artifact.abi_version},
+            )
     return artifact
