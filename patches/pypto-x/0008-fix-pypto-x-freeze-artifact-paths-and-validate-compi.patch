+def test_path_artifact_freezes_absolute_path_and_digest(monkeypatch):
+    target = _target()
+    with tempfile.TemporaryDirectory() as directory:
+        artifact_path = Path(directory) / "kernel.bin"
+        artifact_path.write_bytes(b"original")
+        monkeypatch.chdir(directory)
+        artifact = Artifact(format="python", entrypoint="main", target=target, path="kernel.bin")
+        key = artifact.cache_key
+        digest = artifact.content_digest
+        assert Path(artifact.path).is_absolute()
+        assert artifact.validate() is None
+
+        monkeypatch.chdir(Path(directory).parent)
+        assert artifact.cache_key == key
+        assert artifact.content_digest == digest
+        artifact_path.write_bytes(b"changed")
+        assert artifact.cache_key == key
+        with pytest.raises(ABIValidationError) as changed_error:
+            artifact.validate()
+        assert changed_error.value.details["reason"] == "content_changed"
+
+        artifact_path.unlink()
+        with pytest.raises(ABIValidationError) as missing_error:
+            artifact.validate()
+        assert missing_error.value.details["reason"] == "missing"
+
+    with pytest.raises(ABIValidationError):
+        Artifact(format="python", entrypoint="main", target=target, path="")
+
+
