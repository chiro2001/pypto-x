+def _render_host_bf16_storage_ir(name):
+    emitters = {
+        "exp": _emit_exp_f32,
+        "rsqrt": _emit_rsqrt_f32,
+        "sigmoid": _emit_sigmoid_f32,
+        "silu": _emit_silu_f32,
+        "softplus": _emit_softplus_f32,
+    }
+    builder = _IRBuilder()
+    builder.line('target triple = "x86_64-pc-linux-gnu"')
+    builder.line(
+        "define void @pypto_x_host_bf16_{}(ptr addrspace(1) %input, ptr addrspace(1) %output) {{".format(name)
+    )
+    builder.line("entry:")
+    value = _emit_load_f32(builder, "%input", "0", "bf16")
+    result = emitters[name](builder, value)
+    _emit_store_f32(builder, "%output", "0", "bf16", result)
+    builder.line("  ret void")
+    builder.line("}")
+    return "\n".join(builder.lines) + "\n"
+
+
+@contextmanager
+def _host_bf16_storage_library():
+    """Compile production BF16 load/math/store paths to host executables."""
+
+    directory = tempfile.TemporaryDirectory(prefix="pypto-x-c3-host-bf16-")
+    root = Path(directory.name)
+    libraries = {}
+    try:
+        for name in ("exp", "rsqrt", "sigmoid", "silu", "softplus"):
+            ir_path = root / (name + ".ll")
+            bitcode_path = root / (name + ".bc")
+            object_path = root / (name + ".o")
+            shared_path = root / (name + ".so")
+            ir_path.write_text(_render_host_bf16_storage_ir(name), encoding="utf-8")
+            subprocess.run(["llvm-as", str(ir_path), "-o", str(bitcode_path)], check=True, capture_output=True, text=True)
+            subprocess.run(
+                ["llc", "-mtriple=x86_64-pc-linux-gnu", "-filetype=obj", str(bitcode_path), "-o", str(object_path)],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+            subprocess.run(
+                ["clang", "-shared", "-fPIC", str(object_path), "-o", str(shared_path)],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+            library = ctypes.CDLL(str(shared_path))
+            function = getattr(library, "pypto_x_host_bf16_{}".format(name))
+            uint16_pointer = ctypes.POINTER(ctypes.c_uint16)
+            function.argtypes = (uint16_pointer, uint16_pointer)
+            function.restype = None
+            libraries[name] = function
+        yield libraries
+    finally:
+        directory.cleanup()
+
+
+def _host_bf16_storage_call(function, input_raw):
+    input_cell = (ctypes.c_uint16 * 1)(int(input_raw) & 0xFFFF)
+    output_cell = (ctypes.c_uint16 * 1)(0xA5A5)
+    function(input_cell, output_cell)
+    return int(output_cell[0])
+
