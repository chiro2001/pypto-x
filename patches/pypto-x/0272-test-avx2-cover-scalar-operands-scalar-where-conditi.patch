From 3c2756c0eb088f4bf577618f2c7612e859436db0 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sun, 13 Sep 2026 16:34:02 +0800
Subject: [PATCH 272/275] test(avx2): cover scalar operands, scalar where
 conditions and empty outputs

Add execution-level differential coverage for the remaining position-control
descriptor shapes: two scalar compare operands with a scalar bool return,
scalar-left compare against a tensor, a scalar bool where condition, and a
rank-1 zero-length where output.  All match the vector-common host reference
bit for bit.

(cherry picked from commit b64a59f9955cc33609704fab8b1d9ba57132dc09)
---
 python/tests/ut/pypto_x/test_cpu_avx2_position_native.py | 87 ++++++++++++++++++++++++++++++++++++
 1 file changed, 87 insertions(+)

diff --git a/python/tests/ut/pypto_x/test_cpu_avx2_position_native.py b/python/tests/ut/pypto_x/test_cpu_avx2_position_native.py
index 45d117717..8d8e48c4f 100644
--- a/python/tests/ut/pypto_x/test_cpu_avx2_position_native.py
+++ b/python/tests/ut/pypto_x/test_cpu_avx2_position_native.py
@@ -1366,3 +1366,90 @@ def test_descriptor_cache_is_bounded_and_reused(tmp_path):
     assert stats["descriptor_cache_misses"] == 1
     assert stats["descriptor_cache_hits"] == 2
     assert stats["kernel_calls"] == 3
+
+
+def test_scalar_operands_scalar_conditions_and_empty_outputs(tmp_path):
+    """Scalar/zero-length descriptors are native and match the host reference."""
+
+    # compare with two scalar operands -> scalar bool return
+    left = ValueRef("left", CoreType.scalar("int32"))
+    right = ValueRef("right", CoreType.scalar("int32"))
+    output = ValueRef("out", CoreType.scalar("bool"))
+    operation = Operation("gt", (left, right), (output,), {})
+    program = CoreProgram(
+        functions=(CoreFunction("scalar_compare", (left, right), (output,), Region((operation,))),)
+    )
+    target_ir, artifact = _compile_avx2(program, tmp_path, "scalar-output")
+    contract = position_control_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None and contract["rank"] == 0
+    result = _runtime().launch(
+        LaunchRequest(artifact, inputs=[], outputs=[], scalars={"left": 5, "right": 3})
+    )
+    environment = _reference_environment(
+        program,
+        target_ir,
+        [
+            avx2_runtime._buffer_from_values("int32", [5], "left"),
+            avx2_runtime._buffer_from_values("int32", [3], "right"),
+        ],
+        "scalar-compare",
+    )
+    assert result == (True,)
+    assert avx2_runtime._buffer_values(environment["out"].buffer) == [True]
+
+    # scalar left operand with a tensor right operand
+    left = ValueRef("left", CoreType.scalar("int32"))
+    right = ValueRef("right", CoreType.tensor("int32", (4, 1)))
+    output = ValueRef("out", CoreType.tensor("bool", (4, 1)))
+    operation = Operation("le", (left, right), (output,), {})
+    program = CoreProgram(
+        functions=(CoreFunction("scalar_left", (left, right), (output,), Region((operation,))),)
+    )
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [("int32", (), [2]), ("int32", (4, 1), [1, 2, 3, 4])],
+        [("bool", (4, 1), 4)],
+        tmp_path,
+        "compare-scalar-left",
+    )
+    _assert_bitwise(native, reference)
+    assert native[0] == bytes([0, 1, 1, 1])
+
+    # scalar bool condition selects the whole then branch
+    program = _where_program(
+        "float32",
+        _scalar("bool"),
+        _tensor("float32", (3,)),
+        _tensor("float32", (3,)),
+        _tensor("float32", (3,)),
+    )
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [
+            ("bool", (), [1]),
+            ("float32", (3,), [0x3F800000] * 3),
+            ("float32", (3,), [0x40000000] * 3),
+        ],
+        [("float32", (3,), 3)],
+        tmp_path,
+        "where-scalar-condition",
+    )
+    _assert_bitwise(native, reference)
+    assert native[0] == _buffer_bytes(_native_buffer("float32", [0x3F800000] * 3))
+
+    # zero-length where output: both executors must produce empty bytes
+    program = _where_program(
+        "float32", _tensor("bool", (0,)), _tensor("float32", (0,)), _tensor("float32", (0,)), _tensor("float32", (0,))
+    )
+    _target_ir, artifact, native, reference = _differential(
+        program,
+        [("bool", (0,), []), ("float32", (0,), []), ("float32", (0,), [])],
+        [("float32", (0,), 0)],
+        tmp_path,
+        "where-empty",
+    )
+    _assert_bitwise(native, reference)
+    assert native == [b""]
+    assert artifact.metadata["position_control_fallback"] == "native"
