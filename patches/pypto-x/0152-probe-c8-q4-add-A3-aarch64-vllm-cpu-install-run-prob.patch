+#!/usr/bin/env bash
+# A3 follow-up (light): do aarch64 wheels exist for vllm-cpu / vllm on the
+# NJU mirror?  Metadata only: fetch the simple-index HTML and list filenames.
+set -uo pipefail
+ENV_PY="$HOME/pypto-x-a3/envs/pypto-x-c8/bin/python"
+MIRROR="${MIRROR:-https://mirror.nju.edu.cn/pypi/web/simple}"
+echo "### wheel availability check $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "mirror=$MIRROR"
+for pkg in vllm-cpu vllm; do
+    echo "--- $pkg ---"
+    html="$(curl -s --max-time 40 "$MIRROR/$pkg/" || true)"
+    echo "html_bytes=${#html}"
+    echo "$html" | tr '>' '\n' | grep -oE '[A-Za-z0-9_.+-]+\.whl' | sort -u > /tmp/c8q4_${pkg}_wheels.txt
+    echo "total_unique_wheels=$(wc -l < /tmp/c8q4_${pkg}_wheels.txt)"
+    echo "aarch64_wheels:"
+    grep -E 'aarch64|arm64' /tmp/c8q4_${pkg}_wheels.txt | head -10 || echo "  (none)"
+    echo "0.29.0_wheels:"
+    grep -E '0\.29\.0(-|\.)' /tmp/c8q4_${pkg}_wheels.txt | head -10 || echo "  (none)"
+    echo "aarch64_0.29.0_wheels:"
+    grep -E '0\.29\.0(-|\.)' /tmp/c8q4_${pkg}_wheels.txt | grep -E 'aarch64|arm64' | head -5 || echo "  (none)"
+done
+echo "### done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
