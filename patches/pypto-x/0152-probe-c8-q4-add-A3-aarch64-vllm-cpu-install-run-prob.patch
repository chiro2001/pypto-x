+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""A3 follow-up: run the SAME single-layer artifact probe on aarch64
+(vLLM-CPU 0.29.0 aarch64 wheel) and compare with the x86 results bitwise.
+
+Inputs:
+  --artifact-npz   our frozen int8 codes + fp32 scales (from 01)
+  --x86-outputs    x86 probe outputs (contains the exact activation inputs
+                   under ``<name>.bf16.x`` plus vLLM/contract outputs)
+
+This test does not import pypto: it feeds the exact x86 activation tensors so
+the comparison is an apples-to-apples cross-architecture check.
+
+Output: JSON with per-tensor results; every failure is captured, not raised.
+"""
+
+import argparse
+import json
+import sys
+import traceback
+
+import numpy as np
+import torch
+
+CONFIG = {
+    "config_groups": {"group_0": {
+        "targets": ["Linear"],
+        "weights": {"num_bits": 8, "type": "int", "symmetric": True,
+                    "strategy": "channel", "dynamic": False},
+        "input_activations": {"num_bits": 8, "type": "int", "symmetric": True,
+                              "strategy": "token", "dynamic": True},
+    }},
+    "quant_method": "compressed-tensors",
+    "format": "int-quantized",
+    "ignore": [],
+}
+
+
+def bf16_bits(t):
+    return t.contiguous().view(torch.int16).cpu().numpy().astype(np.int32)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--artifact-npz", required=True)
+    parser.add_argument("--x86-outputs", required=True)
+    parser.add_argument("--out-json", required=True)
+    args = parser.parse_args(argv if argv is not None else sys.argv[1:])
+
+    report = {
+        "schema": "pypto-x.c8-axis-b-probe.a3-layer.v1",
+        "machine": __import__("platform").machine(),
+        "torch_version": torch.__version__,
+        "vllm_version": None,
+        "platform_class": None,
+        "cpu_int8_op_probe": None,
+        "tensors": [],
+    }
+
+    try:
+        import vllm
+        import vllm.distributed.parallel_state as ps
+
+        report["vllm_version"] = vllm.__version__
+        ps.init_distributed_environment(
+            world_size=1, rank=0,
+            distributed_init_method="tcp://127.0.0.1:29551",
+            local_rank=0, backend="gloo",
+        )
+        ps._TP = ps._WORLD
+        from vllm.platforms import current_platform
+
+        report["platform_class"] = type(current_platform).__name__
+    except Exception:
+        report["setup_error"] = traceback.format_exc()
+        with open(args.out_json, "w", encoding="utf-8") as handle:
+            json.dump(report, handle, indent=1, sort_keys=True)
+        print(json.dumps(report, indent=1, sort_keys=True))
+        return
+
+    # raw op presence
+    try:
+        from vllm import _custom_ops as ops
+
+        x = torch.randn(2, 8, dtype=torch.bfloat16)
+        out, s, _ = ops.onednn_scaled_int8_quant(x, None, None, True)
+        report["cpu_int8_op_probe"] = {
+            "ok": True, "codes_dtype": str(out.dtype), "scale_dtype": str(s.dtype)
+        }
+    except Exception as exc:
+        report["cpu_int8_op_probe"] = "ERROR %s: %s" % (type(exc).__name__, exc)
+
+    art = np.load(args.artifact_npz)
+    x86 = np.load(args.x86_outputs)
+    names = sorted({k[: -len("__codes")] for k in art.files if k.endswith("__codes")})
+    for name in names:
+        entry = {"name": name}
+        try:
+            codes = art[name + "__codes"].astype(np.int8)
+            scales = art[name + "__scales"].astype(np.float32)
+            n, k = codes.shape
+            x = torch.from_numpy(x86["%s.bf16.x" % name].astype(np.float32)).to(torch.bfloat16)
+
+            from vllm.model_executor.layers.linear import ReplicatedLinear
+            from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (
+                CompressedTensorsConfig,
+            )
+
+            qc = CompressedTensorsConfig.from_config(json.loads(json.dumps(CONFIG)))
+            layer = ReplicatedLinear(k, n, bias=False, params_dtype=torch.bfloat16,
+                                     quant_config=qc, prefix="probe." + name, disable_tp=True)
+            entry["scheme"] = type(layer.scheme).__name__
+            entry["kernel"] = type(layer.scheme.kernel).__name__
+            layer.weight.data.copy_(torch.from_numpy(codes.copy()))
+            layer.weight_scale.data.copy_(torch.from_numpy(scales.reshape(n, 1).copy()))
+            layer.quant_method.process_weights_after_loading(layer)
+            y = layer.forward(x)
+            y = y[0] if isinstance(y, tuple) else y
+            x86_vllm = torch.from_numpy(
+                x86["%s.bf16.vllm" % name].astype(np.float32)
+            ).to(torch.bfloat16)
+            x86_contract = torch.from_numpy(
+                x86["%s.bf16.contract" % name].astype(np.float32)
+            ).to(torch.bfloat16)
+            yb, vb = bf16_bits(y).reshape(-1), bf16_bits(x86_vllm).reshape(-1)
+            cb = bf16_bits(x86_contract).reshape(-1)
+            entry.update({
+                "output_dtype": str(y.dtype),
+                "vs_x86_vllm_n_diff_bf16": int((yb != vb).sum()),
+                "vs_x86_vllm_n_total": int(yb.size),
+                "vs_x86_vllm_max_abs": float(
+                    (y.float() - x86_vllm.float()).abs().max()
+                ),
+                "vs_x86_contract_n_diff_bf16": int((yb != cb).sum()),
+                "vs_x86_contract_max_abs": float(
+                    (y.float() - x86_contract.float()).abs().max()
+                ),
+                "status": "ok",
+            })
+        except Exception:
+            entry["status"] = "ERROR"
+            entry["error"] = traceback.format_exc()
+        report["tensors"].append(entry)
+        print("[a3] %s %s" % (name, entry.get("status")), flush=True)
+
+    with open(args.out_json, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=1, sort_keys=True)
+    print(json.dumps(report, indent=1, sort_keys=True)[:4000])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/c8_axis_b_probe/20_cublaslt_int8_probe.cu b/scripts/c8_axis_b_probe/20_cublaslt_int8_probe.cu
