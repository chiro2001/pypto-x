+#!/usr/bin/env bash
+# A3 follow-up: create a NEW, removable aarch64 venv with system-site-packages
+# (reusing the Q1 pypto-x-c8 torch/transformers) and install the aarch64
+# vllm-cpu 0.29.0 wheel with --no-deps, then reproduce the x86 single-layer
+# results with OUR artifact.
+#
+# Writes only under ~/pypto-x-a3/** (PIP_CACHE_DIR / TMPDIR / venv / wheel).
+set -uo pipefail
+
+BASE="$HOME/pypto-x-a3"
+RUN="$BASE/c8axisb"
+ENV_BASE="$BASE/envs/pypto-x-c8"
+VENV="$BASE/envs/pypto-x-c8-axisb"
+PY_BASE="$ENV_BASE/bin/python"
+MIRROR="${MIRROR:-https://mirror.nju.edu.cn/pypi/web/simple}"
+WHEEL_DIR="$RUN/wheel"
+LOG="$RUN/logs/13_a3_install.log"
+
+export PIP_CACHE_DIR="$RUN/pip-cache"
+export TMPDIR="$RUN/tmp"
+mkdir -p "$PIP_CACHE_DIR" "$TMPDIR" "$WHEEL_DIR" "$RUN/logs"
+
+echo "### A3 vllm-cpu aarch64 install probe $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "base_python=$($PY_BASE -VV 2>&1)"
+
+echo "--- locate aarch64 wheel ---"
+RAW_HREF="$(curl -s --max-time 60 "$MIRROR/vllm-cpu/" | tr '>' '\n' \
+    | grep -oE 'href="[^"]*vllm_cpu-0\.29\.0[^"]*aarch64\.whl[^"]*"' | head -1 \
+    | sed 's/^href="//; s/"$//')"
+echo "raw_href=$RAW_HREF"
+WHEEL_URL="$("$PY_BASE" - "$MIRROR/vllm-cpu/" "$RAW_HREF" <<'PY'
+import sys
+from urllib.parse import urljoin
+base, href = sys.argv[1], sys.argv[2]
+print(urljoin(base, href.split('#')[0]))
+PY
+)"
+echo "wheel_url=$WHEEL_URL"
+echo -n "content_length_bytes="
+curl -sIL --max-time 60 "$WHEEL_URL" | grep -i '^content-length' | tail -1 | tr -d '\r' || echo unknown
+
+echo "--- venv (system-site-packages => reuse Q1 torch 2.14.0+cu130, transformers 5.17.0) ---"
+rm -rf "$VENV"
+"$PY_BASE" -m venv --system-site-packages "$VENV" || { echo "venv_failed"; exit 1; }
+"$VENV/bin/python" -c "import torch, transformers; print('inherited torch', torch.__version__, 'transformers', transformers.__version__)"
+
+echo "--- download + install vllm-cpu wheel (--no-deps) ---"
+timeout 900 "$VENV/bin/pip" download --no-deps -d "$WHEEL_DIR" "$WHEEL_URL" 2>&1 | tail -3
+WHEEL="$(ls "$WHEEL_DIR"/vllm_cpu-0.29.0*aarch64*.whl 2>/dev/null | head -1)"
+if [[ -z "$WHEEL" ]]; then echo "wheel_download_FAILED"; exit 1; fi
+ls -la "$WHEEL"
+"$VENV/bin/pip" install --no-deps --no-index "$WHEEL" 2>&1 | tail -3
+
+echo "--- install remaining dist requirements (skip torch; reuse inherited) ---"
+"$VENV/bin/python" - "$WHEEL" <<'PY' > "$RUN/logs/13_requirements.txt"
+import sys, zipfile, re
+wheel = sys.argv[1]
+with zipfile.ZipFile(wheel) as z:
+    meta = [n for n in z.namelist() if n.endswith('.dist-info/METADATA')][0]
+    text = z.read(meta).decode('utf-8', 'replace')
+for line in text.splitlines():
+    if line.startswith('Requires-Dist:'):
+        req = line.split(':', 1)[1].strip()
+        # keep environment markers (e.g. `; extra == "image"`) so pip skips
+        # optional extras instead of installing the whole closure
+        print(req)
+PY
+grep -viE '^torch([=<> ]|$)|^nvidia|^triton' "$RUN/logs/13_requirements.txt" > "$RUN/logs/13_requirements_filtered.txt" || true
+wc -l "$RUN/logs/13_requirements_filtered.txt"
+mapfile -t DEPS < "$RUN/logs/13_requirements_filtered.txt"
+timeout 900 "$VENV/bin/pip" install --no-input "${DEPS[@]}" 2>&1 | tail -5
+echo "pip_install_rc=$?"
+
+echo "--- run the cross-architecture single-layer probe ---"
+timeout 900 "$VENV/bin/python" "$RUN/scripts/14_a3_cpu_probe.py" \
+    --artifact-npz "$RUN/artifact/our_artifact_subset.npz" \
+    --x86-outputs "$RUN/artifact/vllm_cpu_layer_probe_outputs.npz" \
+    --out-json "$RUN/logs/14_a3_cpu_probe.json" \
+    > "$RUN/logs/14_a3_cpu_probe.stdout.log" 2>&1
+echo "probe_rc=$?"
+tail -30 "$RUN/logs/14_a3_cpu_probe.stdout.log"
+echo "### done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
