diff --git a/scripts/c8_axis_b_probe/04_torchao_consume_probe.py b/scripts/c8_axis_b_probe/04_torchao_consume_probe.py
new file mode 100644
index 000000000..8b6f217f8
--- /dev/null
+++ b/scripts/c8_axis_b_probe/04_torchao_consume_probe.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""C8 Q4 axis-B alternative-stack probe: torchao 0.18.0.
+
+Question: can torchao build an int8-dynamic-activation / int8-weight linear
+from OUR pre-quantized int8 codes + OUR fp32 per-channel scales WITHOUT
+re-quantizing the weights, and does it agree with the x86 vLLM/contract
+results?
+
+torchao is imported from an unpacked wheel via PYTHONPATH (no install).
+Its public scheme entry point is Int8DynamicActivationInt8WeightConfig, whose
+transform calls ``Int8Tensor.from_hp`` (re-quantizes from fp).  The low-level
+``Int8Tensor(qdata, scale, block_size, dtype, act_quant_kwargs=...)``
+constructor is what we exercise here to inject our artifact directly.
+"""
+
+import argparse
+import json
+import sys
+import traceback
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from torchao.quantization.granularity import PerRow
+from torchao.quantization.quant_primitives import MappingType
+from torchao.quantization.quantize_.workflows.int8.int8_tensor import (
+    Int8Tensor,
+    QuantizeTensorToInt8Kwargs,
+)
+
+
+def bf16_bits(t):
+    return t.contiguous().view(torch.int16).cpu().numpy().astype(np.int32)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--artifact-npz", required=True)
+    parser.add_argument("--x86-outputs", required=True)
+    parser.add_argument("--out-json", required=True)
+    parser.add_argument("--mapping-type", default="SYMMETRIC",
+                        choices=["SYMMETRIC", "SYMMETRIC_NO_CLIPPING_ERR", "ASYMMETRIC"])
+    args = parser.parse_args(argv if argv is not None else sys.argv[1:])
+
+    import torchao
+
+    art = np.load(args.artifact_npz)
+    x86 = np.load(args.x86_outputs)
+    names = sorted({k[: -len("__codes")] for k in art.files if k.endswith("__codes")})
+    report = {
+        "schema": "pypto-x.c8-axis-b-probe.torchao.v1",
+        "torchao_version": torchao.__version__,
+        "torch_version": torch.__version__,
+        "mapping_type": args.mapping_type,
+        "entry_point_note": "Int8DynamicActivationInt8WeightConfig -> Int8Tensor.from_hp "
+                            "(re-quantizes); low-level Int8Tensor ctor used here to inject "
+                            "our pre-quantized codes+scales",
+        "tensors": [],
+    }
+    for name in names:
+        entry = {"name": name}
+        try:
+            codes = torch.from_numpy(art[name + "__codes"].astype(np.int8))
+            scales = torch.from_numpy(art[name + "__scales"].astype(np.float32).reshape(-1, 1))
+            n, k = codes.shape
+            x = torch.from_numpy(x86["%s.bf16.x" % name].astype(np.float32)).to(torch.bfloat16)
+            wt = Int8Tensor(
+                qdata=codes,
+                scale=scales,
+                block_size=[1, k],
+                dtype=torch.bfloat16,
+                zero_point=None,
+                act_quant_kwargs=QuantizeTensorToInt8Kwargs(
+                    granularity=PerRow(),
+                    mapping_type=getattr(MappingType, args.mapping_type),
+                ),
+            )
+            y = F.linear(x, wt)
+            y = y if isinstance(y, torch.Tensor) else y[0]
+            x86_vllm = torch.from_numpy(x86["%s.bf16.vllm" % name].astype(np.float32)).to(torch.bfloat16)
+            x86_contract = torch.from_numpy(x86["%s.bf16.contract" % name].astype(np.float32)).to(torch.bfloat16)
+            yb = bf16_bits(y.to(torch.bfloat16)).reshape(-1)
+            vb = bf16_bits(x86_vllm).reshape(-1)
+            cb = bf16_bits(x86_contract).reshape(-1)
+            entry.update({
+                "status": "ok",
+                "shape": [int(n), int(k)],
+                "output_dtype": str(y.dtype),
+                "vs_x86_vllm_n_diff_bf16": int((yb != vb).sum()),
+                "vs_x86_vllm_n_total": int(yb.size),
+                "vs_x86_vllm_max_abs": float((y.float() - x86_vllm.float()).abs().max()),
+                "vs_x86_contract_n_diff_bf16": int((yb != cb).sum()),
+                "vs_x86_contract_max_abs": float((y.float() - x86_contract.float()).abs().max()),
+            })
+        except Exception:
+            entry["status"] = "ERROR"
+            entry["error"] = traceback.format_exc()
+        report["tensors"].append(entry)
+        print("[torchao] %s %s" % (name, entry.get("status")), flush=True)
+
+    with open(args.out_json, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=1, sort_keys=True)
+    print(json.dumps(report, indent=1, sort_keys=True)[:4000])
+
+
+if __name__ == "__main__":
+    main()
