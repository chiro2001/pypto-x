index 000000000..471d07d30
--- /dev/null
+++ b/scripts/c8_axis_b_probe/20_cublaslt_int8_probe.cu
@@ -0,0 +1,216 @@
+// C8 Q4 axis-B existence probe on GamePC RTX 5080 (sm_120):
+// does cuBLASLt / cuBLAS support INT8 GEMM, and specifically INT8 + scale
+// (the fused A_SCALE/B_SCALE path) which is what a W8A8 deployment needs?
+//
+// This is an existence probe only: every call is attempted and its status is
+// printed; nothing aborts.  GPU-only, short, no model, no downloads.
+//
+// Compile (inside GamePC WSL2):
+//   nvcc -O2 -arch=sm_120 20_cublaslt_int8_probe.cu -lcublas -lcublasLt \
+//        -o /tmp/cublaslt_int8_probe
+
+#include <cstdint>
+#include <cstdio>
+#include <cuda_runtime.h>
+#include <cublasLt.h>
+#include <cublas_v2.h>
+
+static const char* cl_status(cublasStatus_t s) {
+    switch (s) {
+        case CUBLAS_STATUS_SUCCESS: return "SUCCESS";
+        case CUBLAS_STATUS_NOT_INITIALIZED: return "NOT_INITIALIZED";
+        case CUBLAS_STATUS_ALLOC_FAILED: return "ALLOC_FAILED";
+        case CUBLAS_STATUS_INVALID_VALUE: return "INVALID_VALUE";
+        case CUBLAS_STATUS_ARCH_MISMATCH: return "ARCH_MISMATCH";
+        case CUBLAS_STATUS_MAPPING_ERROR: return "MAPPING_ERROR";
+        case CUBLAS_STATUS_EXECUTION_FAILED: return "EXECUTION_FAILED";
+        case CUBLAS_STATUS_INTERNAL_ERROR: return "INTERNAL_ERROR";
+        case CUBLAS_STATUS_NOT_SUPPORTED: return "NOT_SUPPORTED";
+        case CUBLAS_STATUS_LICENSE_ERROR: return "LICENSE_ERROR";
+        default: return "UNKNOWN";
+    }
+}
+
+#define PRINT_STATUS(label, call)                                              \
+    do {                                                                       \
+        cublasStatus_t _s = (call);                                            \
+        std::printf("%-58s : %-16s (%d)\n", (label), cl_status(_s), (int)_s);  \
+    } while (0)
+
+#define CK_CUDA(label, call)                                                   \
+    do {                                                                       \
+        cudaError_t _e = (call);                                               \
+        std::printf("%-58s : %s (%d)\n", (label), cudaGetErrorString(_e),      \
+                    (int)_e);                                                  \
+    } while (0)
+
+static cublasLtMatmulDesc_t make_desc(cublasComputeType_t compute,
+                                      cudaDataType_t scale_type) {
+    cublasLtMatmulDesc_t op = nullptr;
+    cublasStatus_t s = cublasLtMatmulDescCreate(&op, compute, scale_type);
+    if (s != CUBLAS_STATUS_SUCCESS) return nullptr;
+    cublasOperation_t ta = CUBLAS_OP_N, tb = CUBLAS_OP_N;
+    cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSA, &ta, sizeof(ta));
+    cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSB, &tb, sizeof(tb));
+    return op;
+}
+
+static void try_lt_case(const char* tag, int m, int n, int k,
+                        cudaDataType_t c_type, cublasComputeType_t compute,
+                        cudaDataType_t scale_type, bool with_scale,
+                        bool with_bias_epilogue) {
+    std::printf("--- LT case [%s] m=%d n=%d k=%d C=%d compute=%d scaleType=%d "
+                "scalePtrs=%d biasEpilogue=%d ---\n",
+                tag, m, n, k, (int)c_type, (int)compute, (int)scale_type,
+                (int)with_scale, (int)with_bias_epilogue);
+
+    cublasLtHandle_t lt = nullptr;
+    PRINT_STATUS("  cublasLtCreate", cublasLtCreate(&lt));
+    if (!lt) return;
+
+    cublasLtMatmulDesc_t op = make_desc(compute, scale_type);
+    if (!op) {
+        std::printf("  MatmulDescCreate FAILED\n");
+        cublasLtDestroy(lt);
+        return;
+    }
+
+    cublasLtMatrixLayout_t A = nullptr, B = nullptr, C = nullptr;
+    PRINT_STATUS("  MatrixLayoutCreate A(CUDA_R_8I)",
+                 cublasLtMatrixLayoutCreate(&A, CUDA_R_8I, m, k, m));
+    PRINT_STATUS("  MatrixLayoutCreate B(CUDA_R_8I)",
+                 cublasLtMatrixLayoutCreate(&B, CUDA_R_8I, k, n, k));
+    PRINT_STATUS("  MatrixLayoutCreate C",
+                 cublasLtMatrixLayoutCreate(&C, c_type, m, n, m));
+
+    int8_t *dA = nullptr, *dB = nullptr;
+    void *dC = nullptr, *dD = nullptr;
+    float* d_scale_a = nullptr;
+    float* d_scale_b = nullptr;
+    void* dBias = nullptr;
+    CK_CUDA("  cudaMalloc A", cudaMalloc(&dA, (size_t)m * k));
+    CK_CUDA("  cudaMalloc B", cudaMalloc(&dB, (size_t)k * n));
+    size_t c_bytes = (size_t)m * n * (c_type == CUDA_R_32I ? 4 : 2);
+    CK_CUDA("  cudaMalloc C", cudaMalloc(&dC, c_bytes));
+    CK_CUDA("  cudaMalloc D", cudaMalloc(&dD, c_bytes));
+    if (with_scale) {
+        CK_CUDA("  cudaMalloc scale_a", cudaMalloc(&d_scale_a, 4));
+        CK_CUDA("  cudaMalloc scale_b", cudaMalloc(&d_scale_b, 4));
+        float one = 1.0f;
+        CK_CUDA("  cudaMemcpy scale_a", cudaMemcpy(d_scale_a, &one, 4, cudaMemcpyHostToDevice));
+        CK_CUDA("  cudaMemcpy scale_b", cudaMemcpy(d_scale_b, &one, 4, cudaMemcpyHostToDevice));
+        PRINT_STATUS("  SetAttribute A_SCALE_POINTER",
+                     cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_A_SCALE_POINTER,
+                                                    &d_scale_a, sizeof(d_scale_a)));
+        PRINT_STATUS("  SetAttribute B_SCALE_POINTER",
+                     cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_B_SCALE_POINTER,
+                                                    &d_scale_b, sizeof(d_scale_b)));
+    }
+    if (with_bias_epilogue) {
+        CK_CUDA("  cudaMalloc bias", cudaMalloc(&dBias, (size_t)n * (c_type == CUDA_R_32I ? 4 : 2)));
+        cublasLtEpilogue_t epilogue = CUBLASLT_EPILOGUE_BIAS;
+        PRINT_STATUS("  SetAttribute EPILOGUE=BIAS",
+                     cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_EPILOGUE,
+                                                    &epilogue, sizeof(epilogue)));
+        PRINT_STATUS("  SetAttribute BIAS_POINTER",
+                     cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_BIAS_POINTER,
+                                                    &dBias, sizeof(dBias)));
+    }
+
+    cublasLtMatmulPreference_t pref = nullptr;
+    PRINT_STATUS("  PreferenceCreate", cublasLtMatmulPreferenceCreate(&pref));
+    if (pref) {
+        size_t ws = 1u << 22;
+        cublasLtMatmulPreferenceSetAttribute(pref, CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES,
+                                             &ws, sizeof(ws));
+    }
+
+    cublasLtMatmulHeuristicResult_t heur{};
+    int returned = 0;
+    PRINT_STATUS("  AlgoGetHeuristic",
+                 cublasLtMatmulAlgoGetHeuristic(lt, op, A, B, C, C, pref, 1, &heur, &returned));
+    std::printf("  heuristic_returned=%d\n", returned);
+
+    if (returned > 0) {
+        int32_t alpha_i = 1, beta_i = 0;
+        float alpha_f = 1.0f, beta_f = 0.0f;
+        void* alpha = (compute == CUBLAS_COMPUTE_32I) ? (void*)&alpha_i : (void*)&alpha_f;
+        void* beta = (compute == CUBLAS_COMPUTE_32I) ? (void*)&beta_i : (void*)&beta_f;
+        PRINT_STATUS("  Matmul",
+                     cublasLtMatmul(lt, op, alpha, dA, A, dB, B, beta, dC, C, dD, C,
+                                    &heur.algo, nullptr, 0, 0));
+        CK_CUDA("  cudaDeviceSynchronize", cudaDeviceSynchronize());
+    }
+
+    if (pref) cublasLtMatmulPreferenceDestroy(pref);
+    if (A) cublasLtMatrixLayoutDestroy(A);
+    if (B) cublasLtMatrixLayoutDestroy(B);
+    if (C) cublasLtMatrixLayoutDestroy(C);
+    cublasLtMatmulDescDestroy(op);
+    if (dA) cudaFree(dA);
+    if (dB) cudaFree(dB);
+    if (dC) cudaFree(dC);
+    if (dD) cudaFree(dD);
+    if (d_scale_a) cudaFree(d_scale_a);
+    if (d_scale_b) cudaFree(d_scale_b);
+    if (dBias) cudaFree(dBias);
+    cublasLtDestroy(lt);
+}
+
+static void try_gemmex(int m, int n, int k) {
+    std::printf("--- cublasGemmEx INT8 -> INT32 (CUBLAS_COMPUTE_32I) m=%d n=%d k=%d ---\n", m, n, k);
+    cublasHandle_t h = nullptr;
+    PRINT_STATUS("  cublasCreate", cublasCreate(&h));
+    PRINT_STATUS("  cublasSetMathMode(TENSOR_OP)",
+                 cublasSetMathMode(h, CUBLAS_TENSOR_OP_MATH));
+    int8_t *dA = nullptr, *dB = nullptr;
+    int32_t* dC = nullptr;
+    CK_CUDA("  cudaMalloc A", cudaMalloc(&dA, (size_t)m * k));
+    CK_CUDA("  cudaMalloc B", cudaMalloc(&dB, (size_t)k * n));
+    CK_CUDA("  cudaMalloc C", cudaMalloc(&dC, (size_t)m * n * 4));
+    int32_t alpha = 1, beta = 0;
+    PRINT_STATUS("  cublasGemmEx",
+                 cublasGemmEx(h, CUBLAS_OP_N, CUBLAS_OP_N, m, n, k, &alpha, dA, CUDA_R_8I, m,
+                              dB, CUDA_R_8I, k, &beta, dC, CUDA_R_32I, m,
+                              CUBLAS_COMPUTE_32I, CUBLAS_GEMM_DEFAULT_TENSOR_OP));
+    CK_CUDA("  cudaDeviceSynchronize", cudaDeviceSynchronize());
+    cublasDestroy(h);
+    if (dA) cudaFree(dA);
+    if (dB) cudaFree(dB);
+    if (dC) cudaFree(dC);
+}
+
+int main() {
+    int dev = 0;
+    cudaGetDevice(&dev);
+    cudaDeviceProp prop{};
+    cudaGetDeviceProperties(&prop, dev);
+    int driver_version = 0;
+    cudaDriverGetVersion(&driver_version);
+    std::printf("device=%s sm=%d.%d runtime=%d driver=%d\n", prop.name, prop.major,
+                prop.minor, CUDART_VERSION, driver_version);
+
+    size_t free_mem = 0, total_mem = 0;
+    cudaMemGetInfo(&free_mem, &total_mem);
+    std::printf("memory free=%zu MiB total=%zu MiB\n", free_mem >> 20, total_mem >> 20);
+
+    try_gemmex(64, 64, 64);
+    try_gemmex(256, 256, 256);
+
+    // plain INT8 -> INT32 through cuBLASLt
+    try_lt_case("plain-int8-32i", 64, 64, 64, CUDA_R_32I, CUBLAS_COMPUTE_32I,
+                CUDA_R_32I, false, false);
+    // INT8 + A/B scale pointers, int32 accumulation, int32 output
+    try_lt_case("int8-scale-32i-out32i", 64, 64, 64, CUDA_R_32I,
+                CUBLAS_COMPUTE_32I, CUDA_R_32I, true, false);
+    // INT8 + A/B scale pointers with fp32 scale type (what most APIs use)
+    try_lt_case("int8-scale-f32scale-out32i", 64, 64, 64, CUDA_R_32I,
+                CUBLAS_COMPUTE_32I, CUDA_R_32F, true, false);
+    // INT8 + scale -> bf16 output (the W8A8 deployment shape)
+    try_lt_case("int8-scale-outbf16", 64, 64, 64, CUDA_R_16BF, CUBLAS_COMPUTE_32F,
+                CUDA_R_32F, true, false);
+    // INT8 + bias epilogue
+    try_lt_case("int8-scale-bias-epilogue-outbf16", 64, 64, 64, CUDA_R_16BF,
+                CUBLAS_COMPUTE_32F, CUDA_R_32F, true, true);
+    return 0;
+}
diff --git a/scripts/c8_axis_b_probe/20_gamepc_probe_local.sh b/scripts/c8_axis_b_probe/20_gamepc_probe_local.sh
new file mode 100644
index 000000000..b54bcf14b
--- /dev/null
+++ b/scripts/c8_axis_b_probe/20_gamepc_probe_local.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# C8 Q4 axis-B probe driver (local side): push the cuBLASLt INT8 existence
+# probe to GamePC's WSL2 guest and capture the raw output.
+#
+# GPU-only short probe (no gamepc resource lock per project policy: GPU-only
+# short probes do not take the lock; no host-heavy work, no model download).
+#
+# usage: bash 20_gamepc_probe_local.sh <out-log>
+set -uo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+CU="$SCRIPT_DIR/20_cublaslt_int8_probe.cu"
+OUT="${1:-/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-axis-b-probe/logs/20_gamepc_cublaslt.log}"
+B64="$(base64 -w0 "$CU")"
+
+PAYLOAD="$(mktemp /tmp/gamepc_payload.XXXXXX.sh)"
+trap 'rm -f "$PAYLOAD"' EXIT
+{
+    echo 'set -uo pipefail'
+    echo 'export PATH=/usr/local/cuda/bin:$PATH'
+    echo 'echo "### GamePC WSL2 cublasLt INT8 probe $(date -u +%Y-%m-%dT%H:%M:%SZ)"'
+    echo 'hostname; uname -r'
+    echo "nvidia-smi --query-gpu=name,compute_cap,driver_version,memory.total --format=csv,noheader 2>&1 | head -3"
+    echo 'which nvcc; nvcc --version 2>&1 | tail -3'
+    echo "ldconfig -p 2>/dev/null | grep -E 'libcublas(Lt)?\\.so' | head -4"
+    echo "echo '$B64' | base64 -d > /tmp/c8q4_cublaslt_int8_probe.cu"
+    echo 'cd /tmp'
+    echo 'nvcc -O2 -arch=sm_120 c8q4_cublaslt_int8_probe.cu -lcublas -lcublasLt -o c8q4_cublaslt_int8_probe 2> /tmp/c8q4_compile.err'
+    echo 'echo "compile_rc=$?"'
+    echo "tail -60 /tmp/c8q4_compile.err"
+    echo './c8q4_cublaslt_int8_probe'
+    echo 'echo "run_rc=$?"'
+    echo 'rm -f /tmp/c8q4_cublaslt_int8_probe /tmp/c8q4_cublaslt_int8_probe.cu /tmp/c8q4_compile.err'
+} > "$PAYLOAD"
+
+mkdir -p "$(dirname "$OUT")"
+echo "[local] payload=$(wc -l < "$PAYLOAD") lines -> GamePC WSL2, log=$OUT"
+timeout 600 ssh -o BatchMode=yes -o ConnectTimeout=20 192.168.101.5 'wsl.exe -e bash -s' \
+    < "$PAYLOAD" > "$OUT" 2>&1
+echo "[local] ssh_rc=$?"
