+#!/usr/bin/env bash
+# C6 W8A8 timing evidence: ship the harness to GamePC (RTX 5080 / WSL2),
+# run it, fetch the raw JSON, and remove every remote file.
+#
+# GPU-only work: no `gamepc` resource lock is taken (PERF protocol 4.2 and
+# LOCAL_RESOURCE_POLICY).  Nothing persistent is changed; the remote directory
+# ~/c6-timing is deleted by `clean` (also on `run` success/failure).
+#
+# Usage (from the worktree root):
+#   bash scripts/perf/c6_timing_gamepc.sh sync      # copy python/pypto + scripts
+#   bash scripts/perf/c6_timing_gamepc.sh smoke     # remote build-only preflight
+#   bash scripts/perf/c6_timing_gamepc.sh run       # full measurement + fetch
+#   bash scripts/perf/c6_timing_gamepc.sh fetch     # copy raw JSON back
+#   bash scripts/perf/c6_timing_gamepc.sh clean     # delete remote dir
+#
+# Env: C6_GAMEPC_HOST, C6_EVIDENCE_DIR, C6_RAW_NAME, C6_HARNESS_ARGS
+set -euo pipefail
+
+HOST="${C6_GAMEPC_HOST:-chiro@192.168.101.5}"
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+TREE="$(cd "${HERE}/../.." && pwd)"
+EVIDENCE="${C6_EVIDENCE_DIR:-/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c6-timing-evidence}"
+RAW_NAME="${C6_RAW_NAME:-c6-timing-raw-r1.json}"
+GIT_HEAD="$(git -C "${TREE}" rev-parse HEAD)"
+GIT_BRANCH="$(git -C "${TREE}" rev-parse --abbrev-ref HEAD)"
+REMOTE='$HOME/c6-timing'
+
+ssh_wsl() { ssh -o BatchMode=yes "${HOST}" "wsl.exe -e bash -lc \"$1\""; }
+
+sync_tree() {
+    mkdir -p "${EVIDENCE}/raw" "${EVIDENCE}/logs"
+    tar czf - -C "${TREE}" python/pypto \
+        scripts/perf/c6_timing_harness.py \
+        scripts/perf/c6_timing_analyze.py \
+        scripts/perf/c6_timing_selftest.py \
+        scripts/perf/c6_vendor_shim.c \
+        | ssh -o BatchMode=yes "${HOST}" \
+            "wsl.exe -e bash -lc \"rm -rf ${REMOTE} && mkdir -p ${REMOTE}/out && tar xzf - -C ${REMOTE}\""
+    echo "synced ${TREE} -> GamePC:${REMOTE}"
+}
+
+build_shim() {
+    ssh_wsl "cd ${REMOTE} && gcc -O2 -shared -fPIC -o ${REMOTE}/out/libc6vendor.so scripts/perf/c6_vendor_shim.c -I/usr/local/cuda/include -L/usr/local/cuda/lib64 -lcublas -Wl,-rpath,/usr/local/cuda/lib64" \
+        | tee "${EVIDENCE}/logs/gamepc-shim-build.stdout"
+    echo "remote vendor shim built"
+}
+
+smoke() {
+    ssh_wsl "cd ${REMOTE} && PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=${REMOTE}/python python3 scripts/perf/c6_timing_harness.py --build-only --output ${REMOTE}/out/build-only.json" \
+        | tee "${EVIDENCE}/logs/gamepc-build-only.stdout"
+    echo "remote build-only OK"
+}
+
+run() {
+    local extra="${C6_HARNESS_ARGS:-}"
+    ssh_wsl "cd ${REMOTE} && C6_GIT_HEAD=${GIT_HEAD} C6_GIT_BRANCH=${GIT_BRANCH} C6_WORKTREE=${TREE} \
+        PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=${REMOTE}/python \
+        python3 scripts/perf/c6_timing_harness.py --output ${REMOTE}/out/${RAW_NAME} ${extra} \
+        > ${REMOTE}/out/run.log 2>&1; echo REMOTE_EXIT=\$?" \
+        | tee "${EVIDENCE}/logs/gamepc-run.stdout"
+    ssh_wsl "tail -60 ${REMOTE}/out/run.log" | tee "${EVIDENCE}/logs/gamepc-run.tail"
+}
+
+fetch() {
+    mkdir -p "${EVIDENCE}/raw"
+    ssh -o BatchMode=yes "${HOST}" "wsl.exe -e bash -lc \"cat ${REMOTE}/out/${RAW_NAME}\"" \
+        | tr -d '\r' > "${EVIDENCE}/raw/${RAW_NAME}"
+    ssh_wsl "cat ${REMOTE}/out/run.log" | tr -d '\r' > "${EVIDENCE}/logs/gamepc-run.log" || true
+    echo "fetched ${EVIDENCE}/raw/${RAW_NAME} ($(wc -c < "${EVIDENCE}/raw/${RAW_NAME}") bytes)"
+}
+
+clean() {
+    ssh_wsl "rm -rf ${REMOTE} && test ! -e ${REMOTE} && echo REMOTE_CLEAN_OK"
+}
+
+case "${1:-}" in
+    sync) sync_tree ;;
+    shim) build_shim ;;
+    smoke) smoke ;;
+    run)
+        sync_tree
+        build_shim
+        smoke
+        run || true
+        fetch || true
+        clean || true
+        ;;
+    fetch) fetch ;;
+    clean) clean ;;
+    *)
+        echo "usage: $0 {sync|shim|smoke|run|fetch|clean}" >&2
+        exit 2
+        ;;
+esac
