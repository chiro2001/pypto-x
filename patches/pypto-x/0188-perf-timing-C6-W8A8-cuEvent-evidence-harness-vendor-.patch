+#!/usr/bin/env python3
+"""Analyzer for ``c6_timing_harness.py`` raw evidence (ERR-0004 verdicts).
+
+Reads one raw JSON from the harness and writes:
+
+    <output>/analysis.json          full structured analysis
+    <output>/tables.zh-CN.md        the tables quoted in the brief
+
+Everything is UNGATED: the analyzer computes protocol verdicts (round
+stability, ERR-0004 outlier marking, B3a rate-calibration gate) but never
+promotes any number to a cross-platform threshold.
+
+Usage:
+
+    python3 scripts/perf/c6_timing_analyze.py \
+        --raw <raw.json> --output <analysis-dir>
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import statistics
+from pathlib import Path
+
+CV_LIMIT_CLOCK_VALID = 0.03
+P95_LIMIT_CLOCK_VALID = 1.15
+CV_LIMIT_CLOCK_UNLOCKED = 0.05
+P95_LIMIT_CLOCK_UNLOCKED = 1.25
+OUTLIER_RATIO_LIMIT = 0.10
+RATE_SPREAD_LIMIT_PCT = 3.0
+LINEARITY_LIMIT_PCT = 3.0
+CORRECTED_AGREEMENT_LIMIT_PCT = 5.0
+
+
+def percentile_nearest_rank(values, fraction):
+    ordered = sorted(values)
+    rank = max(1, int(math.ceil(fraction * len(ordered))))
+    return ordered[min(rank, len(ordered)) - 1]
+
+
+def round_sig(value, digits=9):
+    if value is None:
+        return None
+    return round(float(value), digits)
+
+
+def stats_block(values):
+    samples = [float(value) for value in values]
+    median = statistics.median(samples)
+    stdev = statistics.stdev(samples) if len(samples) > 1 else 0.0
+    centre = statistics.median(samples)
+    median_mad = statistics.median([abs(value - centre) for value in samples])
+    floor = max(1e-6, 0.02 * median)
+    threshold = max(3.0 * 1.4826 * median_mad, floor)
+    outliers = [index for index, value in enumerate(samples) if abs(value - median) > threshold]
+    p95 = percentile_nearest_rank(samples, 0.95)
+    return {
+        "n": len(samples),
+        "min": round_sig(min(samples)),
+        "median": round_sig(median),
+        "p95_nearest_rank": round_sig(p95),
+        "max": round_sig(max(samples)),
+        "stdev": round_sig(stdev),
+        "cv": round_sig(stdev / median if median else None),
+        "p95_over_median": round_sig(p95 / median if median else None),
+        "mad": round_sig(median_mad),
+        "outlier_floor_seconds": round_sig(floor, 12),
+        "outlier_threshold_seconds": round_sig(threshold, 12),
+        "outlier_indices": outliers,
+        "outlier_ratio": round_sig(len(outliers) / len(samples)),
+    }
+
+
+def case_verdict(stats, clock_valid):
+    cv_limit = CV_LIMIT_CLOCK_VALID if clock_valid else CV_LIMIT_CLOCK_UNLOCKED
+    p95_limit = P95_LIMIT_CLOCK_VALID if clock_valid else P95_LIMIT_CLOCK_UNLOCKED
+    reasons = []
+    if stats["outlier_ratio"] > OUTLIER_RATIO_LIMIT:
+        reasons.append("UNSTABLE(outlier_ratio>0.10)")
+    if stats["cv"] is not None and stats["cv"] > cv_limit:
+        reasons.append("INVALID_VARIANCE(cv>{}%)".format(cv_limit * 100))
+    if stats["p95_over_median"] is not None and stats["p95_over_median"] > p95_limit:
+        reasons.append("INVALID_VARIANCE(p95/median>{})".format(p95_limit))
+    return {
+        "cv_limit": cv_limit,
+        "p95_limit": p95_limit,
+        "verdict": "PASS" if not reasons else "; ".join(reasons),
+        "gate_eligible": not reasons,
+    }
+
+
+def analyse(raw):
+    window = raw.get("rate_calibration_window") or {}
+    rate = window.get("window_rate_median")
+    clock_valid = (raw.get("clock_warmup") or {}).get("clock_verdict") == "VALID"
+
+    wall = raw.get("wall_agreement") or {}
+    wall_batches = wall.get("batches") or []
+    wall_full = wall_batches[-1] if wall_batches else {}
+    corrected_wall_pct = None
+    if wall_full.get("event_seconds") and wall_full.get("host_wall_seconds") and rate:
+        corrected = wall_full["event_seconds"] * rate
+        corrected_wall_pct = (
+            abs(corrected - wall_full["host_wall_seconds"]) / wall_full["host_wall_seconds"] * 100.0
+        )
+    wall_linearity_pct = wall.get("linearity_pct")
+    wall_source = "dedicated_largest_qmatmul_batch"
+    if corrected_wall_pct is None:
+        # fall back to the per-case back-to-back batches (tiny kernels make this
+        # comparison enqueue-dominated; only used when the dedicated run is absent)
+        agreements = []
+        for record in raw.get("cases", []):
+            batch = record.get("batch") or {}
+            if batch.get("span_seconds") and batch.get("host_wall_seconds") and rate:
+                corrected = batch["span_seconds"] * rate
+                agreements.append(
+                    abs(corrected - batch["host_wall_seconds"]) / batch["host_wall_seconds"] * 100.0
+                )
+        corrected_wall_pct = statistics.median(agreements) if agreements else None
+        wall_source = "per_case_batch_fallback"
+
+    rate_gate = {
+        "window_rate_median": rate,
+        "rate_offset_pct": window.get("rate_offset_pct"),
+        "rate_spread_pct": window.get("rate_spread_pct"),
+        "rate_spread_limit_pct": RATE_SPREAD_LIMIT_PCT,
+        "linearity_pct": wall_linearity_pct if wall_linearity_pct is not None else window.get("linearity_pct"),
+        "linearity_limit_pct": LINEARITY_LIMIT_PCT,
+        "corrected_wall_agreement_pct": round_sig(corrected_wall_pct) if corrected_wall_pct is not None else None,
+        "corrected_wall_agreement_pct_max": window.get("corrected_wall_agreement_pct_max"),
+        "corrected_wall_agreement_limit_pct": CORRECTED_AGREEMENT_LIMIT_PCT,
+        "wall_agreement_source": wall_source,
+        "wall_agreement_batches": wall_batches,
+    }
+    rate_gate["rate_stable"] = (
+        rate_gate["rate_spread_pct"] is not None
+        and rate_gate["rate_spread_pct"] <= RATE_SPREAD_LIMIT_PCT
+    )
+    rate_gate["linear_pass"] = (
+        rate_gate["linearity_pct"] is not None
+        and rate_gate["linearity_pct"] <= LINEARITY_LIMIT_PCT
+    )
+    rate_gate["corrected_pass"] = (
+        rate_gate["corrected_wall_agreement_pct"] is not None
+        and rate_gate["corrected_wall_agreement_pct"] <= CORRECTED_AGREEMENT_LIMIT_PCT
+    )
+    rate_gate["verdict"] = (
+        "PASS"
+        if rate_gate["rate_stable"] and rate_gate["linear_pass"] and rate_gate["corrected_pass"]
+        else "FAIL"
+    )
+    rate_gate["platform_flags"] = (
+        ["wsl2_cuevent_rate_offset"]
+        if rate is not None and abs(rate - 1.0) * 100.0 > CORRECTED_AGREEMENT_LIMIT_PCT
+        else []
+    )
+
+    cases = []
+    for record in raw.get("cases", []):
+        raw_samples = record.get("measured_kernel_seconds") or []
+        stats = stats_block(raw_samples)
+        corrected_samples = [value * rate for value in raw_samples] if rate else None
+        corrected = stats_block(corrected_samples) if corrected_samples else None
+        batch = record.get("batch") or {}
+        cases.append(
+            {
+                "case_id": record["case_id"],
+                "opcode": record["opcode"],
+                "m": record["m"],
+                "k": record["k"],
+                "n": record["n"],
+                "w8j_row_name": record["w8j_row_name"],
+                "correctness": record.get("correctness"),
+                "grid": record.get("grid"),
+                "block": record.get("block"),
+                "raw": stats,
+                "raw_median_seconds": stats["median"],
+                "corrected": corrected,
+                "corrected_median_seconds": corrected["median"] if corrected else None,
+                "verdict": case_verdict(stats, clock_valid),
+                "batch": {
+                    "repeats": batch.get("repeats"),
+                    "per_launch_seconds": batch.get("per_launch_seconds"),
+                    "per_launch_corrected_seconds": (
+                        batch.get("per_launch_seconds") * rate
+                        if batch.get("per_launch_seconds") and rate
+                        else None
+                    ),
+                    "host_wall_per_launch_seconds": batch.get("host_wall_per_launch_seconds"),
+                    "raw_wall_agreement_pct": batch.get("raw_wall_agreement_pct"),
+                },
+                "gop_per_s_raw_median": record.get("gop_per_s"),
+                "gop_per_s_corrected_median": (
+                    record["gop_per_s"] / rate if record.get("gop_per_s") and rate else None
+                ),
+            }
+        )
+
+    vendor = raw.get("vendor_two_pass") or {}
+    vendor_shapes = []
+    for entry in vendor.get("shapes", []):
+        def median(section):
+            return (section or {}).get("median_seconds")
+
+        gemm = median(entry.get("gemm_vendor_int8"))
+        ours = median(entry.get("gemm_ours_dp4a"))
+        epilogue = median(entry.get("epilogue_ours"))
+        two_pass = median(entry.get("two_pass_combined"))
+        fused = median(entry.get("fused_path_combined"))
+        bf16 = median(entry.get("bf16_gemm"))
+        paired_vendor = entry.get("paired_vendor_vs_ours_gemm") or {}
+        paired_paths = entry.get("paired_two_pass_vs_fused") or {}
+        paired_bf16 = entry.get("paired_bf16_vs_ours_gemm") or {}
+        vendor_shapes.append(
+            {
+                "m": entry["m"],
+                "k": entry["k"],
+                "n": entry["n"],
+                "gemm_status": entry.get("gemm_status"),
+                "bf16_status": entry.get("bf16_status"),
+                "int32_mismatches_vs_c6": entry.get("int32_mismatches_vs_c6"),
+                "two_pass_bf16_mismatches_vs_fused": entry.get("two_pass_bf16_mismatches_vs_fused"),
+                "gemm_vendor_int8_median_seconds": gemm,
+                "gemm_vendor_int8_corrected_seconds": gemm * rate if gemm and rate else None,
+                "gemm_ours_dp4a_median_seconds": ours,
+                "gemm_ours_dp4a_corrected_seconds": ours * rate if ours and rate else None,
+                "epilogue_ours_median_seconds": epilogue,
+                "two_pass_combined_median_seconds": two_pass,
+                "fused_path_combined_median_seconds": fused,
+                "bf16_gemm_median_seconds": bf16,
+                "fused_over_two_pass_ratio": (fused / two_pass) if fused and two_pass else None,
+                "ours_over_vendor_gemm_ratio": (ours / gemm) if ours and gemm else None,
+                "paired_vendor_vs_ours_median_ratio": (
+                    (paired_vendor.get("paired_ratio_vendor_int8_over_ours_dp4a") or {}).get(
+                        "median_ratio"
+                    )
+                ),
+                "paired_two_pass_vs_fused_median_ratio": (
+                    (paired_paths.get("paired_ratio_two_pass_over_fused_path") or {}).get(
+                        "median_ratio"
+                    )
+                ),
+                "paired_bf16_vs_ours_median_ratio": (
+                    (paired_bf16.get("paired_ratio_bf16_gemm_over_ours_dp4a") or {}).get(
+                        "median_ratio"
+                    )
+                ),
+                "gemm_host_call_median_seconds": median(entry.get("gemm_host_call_seconds")),
+                "bf16_host_call_median_seconds": median(entry.get("bf16_host_call_seconds")),
+                "error": entry.get("error"),
+            }
+        )
+
+    verdicts = {
+        "rate_gate": rate_gate["verdict"],
+        "clock_verdict": (raw.get("clock_warmup") or {}).get("clock_verdict"),
+        "case_verdicts": {},
+        "cases_total": len(cases),
+    }
+    counts = {}
+    for case in cases:
+        key = case["verdict"]["verdict"]
+        counts[key] = counts.get(key, 0) + 1
+    verdicts["case_verdicts"] = counts
+    verdicts["all_cases_pass"] = counts.get("PASS", 0) == len(cases)
+    verdicts["gate_eligible"] = bool(rate_gate["verdict"] == "PASS" and verdicts["all_cases_pass"])
+    verdicts["gated"] = False
+    verdicts["shared_window"] = bool((raw.get("window_contamination") or {}).get("shared_window"))
+    verdicts["note"] = (
+        "UNGATED by construction (WSL2 guest, no cpufreq control, shared window); "
+        "case PASS only means the round distribution passed ERR-0004/variance; "
+        "no absolute or cross-platform threshold is claimed"
+    )
+    dispatch_rows = []
+    by_id = {case["case_id"]: case for case in cases}
+    for item in raw.get("dispatch_overhead") or []:
+        row = {
+            "case_id": item.get("case_id") or (item.get("shape") or {}).get("case_id"),
+            "error": item.get("error"),
+        }
+        case = by_id.get(row["case_id"])
+        if case and item.get("kernel_median_seconds") is not None:
+            row["public_entry_kernel_median_seconds"] = item["kernel_median_seconds"]
+            row["direct_launch_median_seconds"] = case["raw_median_seconds"]
+            row["ratio_public_over_direct"] = (
+                item["kernel_median_seconds"] / case["raw_median_seconds"]
+                if case["raw_median_seconds"]
+                else None
+            )
+            row["entry_wall_median_seconds"] = item.get("entry_wall_median_seconds")
+            row["dispatch_median_seconds"] = item.get("dispatch_median_seconds")
+        dispatch_rows.append(row)
+
+    return {
+        "artifact_kind": "pypto-x.c6-w8a8-timing-analysis",
+        "schema_version": 1,
+        "source_raw": raw.get("artifact_kind"),
+        "task": raw.get("task"),
+        "status": raw.get("status"),
+        "git": raw.get("git"),
+        "git_branch": raw.get("git_branch"),
+        "protocol": raw.get("protocol"),
+        "shape_set": raw.get("shape_set"),
+        "clock_warmup": raw.get("clock_warmup"),
+        "window_contamination": raw.get("window_contamination"),
+        "rate_gate": rate_gate,
+        "verdicts": verdicts,
+        "cases": cases,
+        "vendor_two_pass": {
+            "status": vendor.get("status"),
+            "lib_path": vendor.get("lib_path"),
+            "version": vendor.get("version"),
+            "error": vendor.get("error"),
+            "shapes": vendor_shapes,
+        },
+        "bf16_baseline_present": all(
+            shape.get("bf16_status") == 0 for shape in vendor_shapes
+        ) if vendor_shapes else False,
+        "dispatch_overhead": dispatch_rows,
+    }
+
+
+def markdown(analysis):
+    lines = []
+    lines.append("# C6 W8A8 CUDA cuEvent timing tables (UNGATED)")
+    lines.append("")
+    lines.append("- raw: `{}` branch `{}` head `{}`".format(
+        analysis.get("source_raw"), analysis.get("git_branch"), analysis.get("git")))
+    lines.append("- rate: `window_rate_median={}` ({:+.3f}%), spread={}%, linearity={}%, corrected wall agreement={}% -> `{}`".format(
+        analysis["rate_gate"]["window_rate_median"],
+        analysis["rate_gate"]["rate_offset_pct"] or 0.0,
+        analysis["rate_gate"]["rate_spread_pct"],
+        analysis["rate_gate"]["linearity_pct"],
+        analysis["rate_gate"]["corrected_wall_agreement_pct"],
+        analysis["rate_gate"]["verdict"],
+    ))
+    lines.append("- clock: `{}` (median ratio {})".format(
+        analysis.get("clock_warmup", {}).get("clock_verdict"),
+        analysis.get("clock_warmup", {}).get("clock_ratio_median"),
+    ))
+    contamination = analysis.get("window_contamination") or {}
+    lines.append(
+        "- window: shared={} median GPU util={}% max={}% memory.used min={} MiB".format(
+            contamination.get("shared_window"),
+            contamination.get("utilization_gpu_pct_median"),
+            contamination.get("utilization_gpu_pct_max"),
+            contamination.get("memory_used_mib_min"),
+        )
+    )
+    lines.append("")
+    for opcode in (
+        "qmatmul_s8s8_s32",
+        "quantize_per_token_s8",
+        "dequantize_s8",
+        "dequantize_epilogue_bf16",
+    ):
+        rows = [case for case in analysis["cases"] if case["opcode"] == opcode]
+        if not rows:
+            continue
+        lines.append("## {}".format(opcode))
+        lines.append("")
+        lines.append("| m | k | n | grid | raw median (us) | corrected median (us) | cv | p95/median | outlier_ratio | GOP/s (corrected) | verdict |")
+        lines.append("|---:|---:|---:|---|---:|---:|---:|---:|---:|---:|---|")
+        for case in rows:
+            lines.append(
+                "| {} | {} | {} | {}x{} | {:.3f} | {:.3f} | {:.4f} | {:.4f} | {:.3f} | {} | {} |".format(
+                    case["m"],
+                    case["k"],
+                    case["n"],
+                    case["grid"][0] if case["grid"] else "?",
+                    case["block"][0] if case["block"] else "?",
+                    (case["raw_median_seconds"] or 0.0) * 1e6,
+                    (case["corrected_median_seconds"] or 0.0) * 1e6,
+                    case["raw"]["cv"] or 0.0,
+                    case["raw"]["p95_over_median"] or 0.0,
+                    case["raw"]["outlier_ratio"] or 0.0,
+                    "{:.1f}".format(case["gop_per_s_corrected_median"])
+                    if case["gop_per_s_corrected_median"]
+                    else "-",
+                    case["verdict"]["verdict"],
+                )
+            )
+        lines.append("")
+    vendor = analysis["vendor_two_pass"]
+    if vendor.get("shapes"):
+        lines.append("## two-pass vendor int8 + our epilogue vs fused C6 dp4a path")
+        lines.append("")
+        lines.append("| m | k | n | vendor gemm us | our dp4a us | epilogue us | two-pass us | fused us | fused/two-pass | vendor int32 mismatch | bf16 us |")
+        lines.append("|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|")
+        for shape in vendor["shapes"]:
+            def us(key):
+                value = shape.get(key)
+                return "{:.3f}".format(value * 1e6) if value else "-"
+
+            lines.append(
+                "| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
+                    shape["m"],
+                    shape["k"],
+                    shape["n"],
+                    us("gemm_vendor_int8_corrected_seconds"),
+                    us("gemm_ours_dp4a_corrected_seconds"),
+                    us("epilogue_ours_median_seconds"),
+                    us("two_pass_combined_median_seconds"),
+                    us("fused_path_combined_median_seconds"),
+                    "{:.3f}".format(shape["fused_over_two_pass_ratio"])
+                    if shape["fused_over_two_pass_ratio"]
+                    else "-",
+                    shape["int32_mismatches_vs_c6"],
+                    us("bf16_gemm_median_seconds"),
+                )
+            )
+        lines.append("")
+        lines.append("| m | k | n | vendor/ours gemm ratio (paired) | two-pass/fused ratio (paired) | bf16/ours ratio (paired) | gemm host-call us |")
+        lines.append("|---:|---:|---:|---:|---:|---:|---:|")
+        for shape in vendor["shapes"]:
+            def ratio(key):
+                value = shape.get(key)
+                return "{:.3f}".format(value) if value else "-"
+
+            host = shape.get("gemm_host_call_median_seconds")
+            lines.append(
+                "| {} | {} | {} | {} | {} | {} | {} |".format(
+                    shape["m"],
+                    shape["k"],
+                    shape["n"],
+                    ratio("paired_vendor_vs_ours_median_ratio"),
+                    ratio("paired_two_pass_vs_fused_median_ratio"),
+                    ratio("paired_bf16_vs_ours_median_ratio"),
+                    "{:.2f}".format(host * 1e6) if host else "-",
+                )
+            )
+        lines.append("")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--raw", required=True)
+    parser.add_argument("--output", required=True, help="analysis output directory")
+    args = parser.parse_args(argv)
+
+    raw = json.loads(Path(args.raw).read_text(encoding="utf-8"))
+    analysis = analyse(raw)
+    output = Path(args.output)
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "analysis.json").write_text(
+        json.dumps(analysis, indent=2, ensure_ascii=False), encoding="utf-8"
+    )
+    (output / "tables.zh-CN.md").write_text(markdown(analysis), encoding="utf-8")
+    summary = analysis["verdicts"]
+    print(
+        "rate_gate={} cases={} all_case_pass={} gate_eligible={}".format(
+            summary["rate_gate"],
+            summary["cases_total"],
+            summary["all_cases_pass"],
+            summary["gate_eligible"],
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
