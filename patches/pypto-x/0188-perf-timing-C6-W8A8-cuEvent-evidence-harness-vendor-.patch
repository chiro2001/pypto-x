diff --git a/scripts/perf/c6_timing_selftest.py b/scripts/perf/c6_timing_selftest.py
new file mode 100644
index 000000000..2421daff0
--- /dev/null
+++ b/scripts/perf/c6_timing_selftest.py
@@ -0,0 +1,277 @@
+#!/usr/bin/env python3
+"""Local self-test for ``c6_timing_harness.py`` (no GPU, no CUDA driver).
+
+Verifies the harness plumbing that a real GamePC run depends on:
+
+  * the per-opcode (grid, block, parameter order, buffer size) mapping mirrors
+    ``CudaRuntime._w8a8_launch`` / ``run_w8a8_*``;
+  * ``correctness_check`` accepts the closed-form expected device outputs and
+    rejects a wrong one;
+  * the analyzer's ERR-0004 / variance / rate-gate logic on synthetic rounds.
+
+Run:
+
+    python3 scripts/perf/c6_timing_selftest.py
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import struct
+import sys
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parents[1] / "python"))
+
+
+def _load(name, path):
+    spec = importlib.util.spec_from_file_location(name, str(path))
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+harness = _load("c6_timing_harness", HERE / "c6_timing_harness.py")
+analyzer = _load("c6_timing_analyze", HERE / "c6_timing_analyze.py")
+
+
+class MockDriver:
+    def __init__(self):
+        self.next_pointer = 1000
+        self.uploads = {}
+        self.freed = []
+
+    def mem_alloc(self, size):
+        pointer = self.next_pointer
+        self.next_pointer += 1
+        self.allocated_size = size
+        return pointer
+
+    def mem_free(self, pointer):
+        self.freed.append(pointer)
+
+    def memcpy_htod(self, pointer, data):
+        self.uploads[pointer] = bytes(data)
+
+    def memcpy_dtoh(self, pointer, size):
+        return self.downloads.get(pointer, b"\0" * size)
+
+
+def plan_for(opcode, m, k, n):
+    fields = {
+        "qmatmul_s8s8_s32": SimpleNamespace(
+            kernel="px_q", m=m, k=k, n=n, batch_shape=(), left_shape=(m, k), right_shape=(k, n)
+        ),
+        "quantize_per_token_s8": SimpleNamespace(
+            kernel="px_z", rows=m, k=k, input_shape=(m, k)
+        ),
+        "dequantize_s8": SimpleNamespace(kernel="px_d", rows=m, k=n, codes_shape=(m, n)),
+        "dequantize_epilogue_bf16": SimpleNamespace(
+            kernel="px_e", rows=m, columns=n, accumulator_shape=(m, n)
+        ),
+    }
+    return fields[opcode]
+
+
+def test_launch_plan_mapping():
+    runtime = SimpleNamespace()
+    m, k, n = 5, 1024, 8192
+    for opcode in harness.OPCODES:
+        case = {
+            "opcode": opcode,
+            "m": m,
+            "k": k,
+            "n": n,
+            "case_id": "x",
+        }
+        pointers = {
+            name: 1000 + index
+            for index, name in enumerate(
+                (
+                    "left",
+                    "right",
+                    "values",
+                    "codes",
+                    "scales",
+                    "accumulator",
+                    "row_scales",
+                    "column_scales",
+                    "output",
+                    "saturation",
+                    "status",
+                )
+            )
+        }
+        kernel, grid, block, parameters, count = harness.launch_plan_for_case(
+            runtime, plan_for(opcode, m, k, n), case, pointers
+        )
+        assert block == (128, 1, 1), block
+        if opcode == "qmatmul_s8s8_s32":
+            assert count == m * n and grid == ((m * n + 127) // 128, 1, 1)
+            assert parameters == [pointers["left"], pointers["right"], pointers["output"]]
+        elif opcode == "dequantize_s8":
+            assert count == m * n
+            assert parameters == [pointers["codes"], pointers["scales"], pointers["output"]]
+        elif opcode == "quantize_per_token_s8":
+            assert count == m and grid == ((m + 127) // 128, 1, 1)
+            assert parameters == [
+                pointers["values"],
+                pointers["codes"],
+                pointers["scales"],
+                pointers["saturation"],
+                pointers["status"],
+            ]
+        else:
+            assert count == m * n
+            assert parameters == [
+                pointers["accumulator"],
+                pointers["row_scales"],
+                pointers["column_scales"],
+                pointers["output"],
+                pointers["status"],
+            ]
+    print("test_launch_plan_mapping: OK")
+
+
+def test_allocation_sizes():
+    driver = MockDriver()
+    runtime = SimpleNamespace()
+    m, k, n = 5, 3584, 1024
+    expected = {
+        "qmatmul_s8s8_s32": [m * k, k * n, m * n * 4],
+        "quantize_per_token_s8": [m * k * 4, m * k, m * 4, m * 4, m * 4],
+        "dequantize_s8": [m * n, m * 4, m * n * 4],
+        "dequantize_epilogue_bf16": [m * n * 4, m * 4, n * 4, m * n * 2, 4],
+    }
+    for opcode in harness.OPCODES:
+        case = {"opcode": opcode, "m": m, "k": k, "n": n}
+        driver.next_pointer = 1000
+        driver.allocated_sizes = []
+        driver.freed = []
+
+        def recording_alloc(size, _driver=driver):
+            _driver.allocated_sizes.append(size)
+            return MockDriver.mem_alloc(_driver, size)
+
+        driver.mem_alloc = recording_alloc
+        buffers, _pointers = harness.allocate_case_buffers(
+            driver, runtime, plan_for(opcode, m, k, n), case
+        )
+        assert driver.allocated_sizes == expected[opcode], (opcode, driver.allocated_sizes)
+        buffers.free()
+        assert len(driver.freed) == len(expected[opcode])
+    print("test_allocation_sizes: OK")
+
+
+def test_correctness_checks():
+    m, k, n = 2, 8, 4
+    for opcode in harness.OPCODES:
+        driver = MockDriver()
+        runtime = SimpleNamespace()
+        case = {"opcode": opcode, "m": m, "k": k, "n": n}
+        pointers = {name: index for index, name in enumerate(("values", "codes", "scales", "saturation", "status", "output", "accumulator", "row_scales", "column_scales"))}
+        driver.downloads = {}
+        if opcode == "qmatmul_s8s8_s32":
+            driver.downloads[pointers["output"]] = struct.pack("<{}i".format(m * n), *([k] * (m * n)))
+        elif opcode == "dequantize_s8":
+            driver.downloads[pointers["output"]] = struct.pack("<{}f".format(m * n), *([1.0] * (m * n)))
+        elif opcode == "quantize_per_token_s8":
+            driver.downloads[pointers["codes"]] = bytes([127]) * (m * k)
+            driver.downloads[pointers["scales"]] = struct.pack("<{}f".format(m), *([1.0 / 127.0] * m))
+            driver.downloads[pointers["status"]] = b"\0" * (m * 4)
+        else:
+            driver.downloads[pointers["output"]] = struct.pack("<{}H".format(m * n), *([0x42FA] * (m * n)))
+            driver.downloads[pointers["status"]] = b"\0\0\0\0"
+        result = harness.correctness_check(runtime, driver, None, case, pointers, None)
+        assert result["status"] == "PASS", (opcode, result)
+    # negative control: wrong qmatmul output must be rejected
+    driver = MockDriver()
+    case = {"opcode": "qmatmul_s8s8_s32", "m": m, "k": k, "n": n}
+    driver.downloads = {0: struct.pack("<{}i".format(m * n), *([k - 1] * (m * n)))}
+    result = harness.correctness_check(SimpleNamespace(), driver, None, case, {"output": 0}, None)
+    assert result["status"] == "FAIL"
+    print("test_correctness_checks: OK")
+
+
+def test_analyzer_verdicts():
+    stable = [1e-5 * (1 + 0.001 * ((index % 5) - 2) / 5) for index in range(21)]
+    unstable = [1e-5] * 17 + [1e-3] * 4
+    raw = {
+        "artifact_kind": "pypto-x.c6-w8a8-timing-raw",
+        "status": "OK",
+        "task": "c6-timing-evidence",
+        "git_branch": "x",
+        "git": "y",
+        "protocol": {},
+        "shape_set": {},
+        "clock_warmup": {"clock_verdict": "VALID", "clock_ratio_median": 0.95},
+        "rate_calibration_window": {
+            "window_rate_median": 1.06,
+            "rate_offset_pct": 6.0,
+            "rate_spread_pct": 0.5,
+            "linearity_pct": 0.4,
+            "corrected_wall_agreement_pct": 1.2,
+            "corrected_wall_agreement_pct_max": 2.0,
+        },
+        "wall_agreement": {
+            "batches": [
+                {"repeats": 128, "event_seconds": 0.02, "host_wall_seconds": 0.0206},
+                {"repeats": 256, "event_seconds": 0.04, "host_wall_seconds": 0.0412},
+            ],
+            "linearity_pct": 0.2,
+        },
+        "cases": [
+            {
+                "case_id": "a",
+                "opcode": "qmatmul_s8s8_s32",
+                "m": 1,
+                "k": 1024,
+                "n": 32,
+                "w8j_row_name": "x",
+                "measured_kernel_seconds": stable,
+                "grid": [1, 1, 1],
+                "block": [128, 1, 1],
+                "gop_per_s": 10.0,
+                "batch": {},
+            },
+            {
+                "case_id": "b",
+                "opcode": "qmatmul_s8s8_s32",
+                "m": 1,
+                "k": 1024,
+                "n": 32,
+                "w8j_row_name": "x",
+                "measured_kernel_seconds": unstable,
+                "grid": [1, 1, 1],
+                "block": [128, 1, 1],
+                "gop_per_s": 10.0,
+                "batch": {},
+            },
+        ],
+    }
+    analysis = analyzer.analyse(raw)
+    assert analysis["cases"][0]["verdict"]["verdict"] == "PASS"
+    assert "UNSTABLE" in analysis["cases"][1]["verdict"]["verdict"]
+    assert analysis["rate_gate"]["verdict"] == "PASS"
+    corrected = analysis["cases"][0]["corrected_median_seconds"]
+    expected = analysis["cases"][0]["raw_median_seconds"] * 1.06
+    assert abs(corrected - expected) <= abs(expected) * 1e-6, (corrected, expected)
+    print("test_analyzer_verdicts: OK")
+
+
+def main():
+    test_launch_plan_mapping()
+    test_allocation_sizes()
+    test_correctness_checks()
+    test_analyzer_verdicts()
+    print("selftest: PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/perf/c6_vendor_shim.c b/scripts/perf/c6_vendor_shim.c
new file mode 100644
index 000000000..a6aa989c5
--- /dev/null
+++ b/scripts/perf/c6_vendor_shim.c
@@ -0,0 +1,76 @@
+/* C6 timing evidence: tiny C shim around classic cuBLAS GEMM (vendor comparison leg).
+ *
+ * Why a shim: the Python harness is header-free (no CUDA toolkit dependency), and
+ * a direct ctypes `cublasGemmEx` call with the header-documented 19-argument
+ * signature was rejected on the GamePC CUDA 13.3 stack (`status=7`, "GEMM_EX
+ * parameter number 12 had an illegal value") while the identical call compiled
+ * from <cublas_api.h> returns status 0.  Calling through this C-boundary shim
+ * removes the ctypes/enum marshalling difference and keeps the argument layout
+ * compiler-checked against the installed headers.
+ *
+ * Build (GamePC WSL2):
+ *   gcc -O2 -shared -fPIC -o libc6vendor.so c6_vendor_shim.c \
+ *       -I/usr/local/cuda/include -L/usr/local/cuda/lib64 -lcublas \
+ *       -Wl,-rpath,/usr/local/cuda/lib64
+ *
+ * The GEMM layout mapping is the standard row-major -> column-major swap:
+ *   C_rm(m x n) = A_rm(m x k) @ B_rm(k x n)
+ * <=> C_cm(n x m) = B_cm(n x k) @ A_cm(k x m)   with lda=k, ldb=n, ldc=n.
+ */
+
+#include <cublas_api.h>
+
+static cublasHandle_t g_handle = NULL;
+static int g_version = 0;
+
+int c6_shim_init(void) {
+    cublasStatus_t status = cublasCreate_v2(&g_handle);
+    if (status != CUBLAS_STATUS_SUCCESS) {
+        return (int)status;
+    }
+    cublasGetVersion_v2(g_handle, &g_version);
+    return 0;
+}
+
+int c6_shim_shutdown(void) {
+    if (g_handle == NULL) {
+        return 0;
+    }
+    cublasStatus_t status = cublasDestroy_v2(g_handle);
+    g_handle = NULL;
+    return (int)status;
+}
+
+int c6_shim_version(void) {
+    return g_version;
+}
+
+int c6_shim_gemm_int8_s32(int m, int k, int n, void *a, void *b, void *c) {
+    if (g_handle == NULL) {
+        return -1;
+    }
+    int alpha = 1;
+    int beta = 0;
+    return (int)cublasGemmEx(
+        g_handle, CUBLAS_OP_N, CUBLAS_OP_N, n, m, k,
+        &alpha, b, CUDA_R_8I, n, a, CUDA_R_8I, k,
+        &beta, c, CUDA_R_32I, n,
+        CUBLAS_COMPUTE_32I, CUBLAS_GEMM_DEFAULT);
+}
+
+int c6_shim_gemm_bf16(int m, int k, int n, void *a, void *b, void *c) {
+    if (g_handle == NULL) {
+        return -1;
+    }
+    float alpha = 1.0f;
+    float beta = 0.0f;
+    return (int)cublasGemmEx(
+        g_handle, CUBLAS_OP_N, CUBLAS_OP_N, n, m, k,
+        &alpha, b, CUDA_R_16BF, n, a, CUDA_R_16BF, k,
+        &beta, c, CUDA_R_16BF, n,
+        CUBLAS_COMPUTE_32F, CUBLAS_GEMM_DEFAULT);
+}
+
