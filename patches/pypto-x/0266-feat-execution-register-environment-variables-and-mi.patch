+        "categories": list(ENV_CATEGORIES),
+        "deprecation_statuses": list(DEPRECATION_STATUSES),
+        "digest_statuses": list(DIGEST_STATUSES),
+        "migration_var_count": len(MIGRATION_ENV_VARS),
+        "extra_var_count": len(EXTRA_ENV_VARS),
+        "runtime_var_count": len(RUNTIME_ENV_VARS),
+        "control_var_count": len(CONTROL_ENV_VARS),
+        "variables": [spec.to_dict() for spec in ALL_ENV_VARS],
+    }
