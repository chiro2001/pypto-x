+            "PYPTO_X_TORCH_CACHE_DIR": str(tmp_path / "cache"),
+            ENV_DEPRECATION_WARNINGS: "0",
+        },
+        cwd=tmp_path,
+    )
+    assert silenced.returncode == 0
+    assert "deprecated" not in silenced.stderr
