+def lookup_env_var(name: str) -> EnvVarSpec:
+    """Return the registry row for ``name`` or raise a structured error."""
+
+    if not isinstance(name, str) or not name.strip():
+        raise ValueError("environment variable name must be a non-empty string")
+    spec = _BY_NAME.get(name.strip())
+    if spec is None:
+        raise KeyError(name.strip())
+    return spec
+
+
+def is_registered(name: str) -> bool:
+    return isinstance(name, str) and name.strip() in _BY_NAME
+
+
+def warnings_enabled(environ: Optional[Mapping[str, str]] = None) -> bool:
+    environment = os.environ if environ is None else environ
+    value = environment.get(ENV_DEPRECATION_WARNINGS)
+    if value is None:
+        return True
+    return str(value).strip().lower() not in ("0", "off", "false", "no")
+
+
+def _value_kind(spec: EnvVarSpec, raw: str) -> Tuple[Optional[str], Any]:
+    if raw is None:
+        return None, None
+    domain = spec.legal_domain.lower()
+    if "0|1" in domain or "flag" in domain:
+        return "flag", raw.strip() == "1"
+    if "integer" in domain:
+        try:
+            return "integer", int(raw)
+        except (TypeError, ValueError):
+            return "non_integer", None
+    if "directory" in domain or "path" in domain or "file" in domain or "root" in domain:
+        return "path", None
+    return "string", None
+
+
+def environment_rows(environ: Optional[Mapping[str, str]] = None) -> Tuple[Mapping[str, Any], ...]:
+    """Doctor-facing rows; raw values are never included."""
+
+    environment = os.environ if environ is None else environ
+    rows = []
+    for spec in ALL_ENV_VARS:
+        raw = environment.get(spec.name)
+        value_kind, interpreted = _value_kind(spec, raw)
+        rows.append(
+            {
+                "name": spec.name,
+                "category": spec.category,
+                "scope": spec.scope,
+                "consumer_kind": spec.consumer_kind,
+                "status": "set" if raw is not None else "unset",
+                "deprecation_status": spec.deprecation_status,
+                "replacement": spec.replacement,
+                "affects_artifact_semantics": spec.affects_artifact_semantics,
+                "semantic_scope": spec.semantic_scope,
+                "digest_status": spec.digest_status,
+                "effect_unproven": spec.effect_unproven,
+                "value_kind": value_kind,
+                "interpreted_value": interpreted,
+            }
+        )
+    return tuple(rows)
+
+
+_SENSITIVE_NAME_PARTS = ("secret", "token", "password", "passwd", "credential", "api_key", "apikey")
+
+
+def _safe_unregistered_name(name: str) -> str:
+    lowered = name.lower()
+    if any(part in lowered for part in _SENSITIVE_NAME_PARTS):
+        return "<redacted-unregistered-name>"
+    return name
+
+
+def _unregistered_risk(name: str) -> str:
+    upper = name.upper()
+    if any(suffix in upper for suffix in ("_HOOKS", "_MODE", "_FORMAT", "_THREADS", "_DEVICE_ID", "_ENABLE")):
+        return "behavior_or_numeric_risk"
+    if any(suffix in upper for suffix in ("_DIR", "_PATH", "_ROOT", "_HOME", "_LOG", "_CACHE")):
+        return "path_or_cache_risk"
+    return "unknown_risk"
+
+
+def unregistered_env_rows(environ: Optional[Mapping[str, str]] = None) -> Tuple[Mapping[str, Any], ...]:
+    """Rows for unregistered ``PYPTO_X_*`` variables (names only, no values)."""
+
+    environment = os.environ if environ is None else environ
+    rows = []
+    for name in sorted(environment):
+        if not name.startswith("PYPTO_X_"):
+            continue
+        if is_registered(name):
+            continue
+        rows.append(
+            {
+                "name": _safe_unregistered_name(name),
+                "risk": _unregistered_risk(name),
+                "status": "unregistered",
+                "policy": "not honored by the execution layer; register or remove it",
+            }
+        )
+    return tuple(rows)
+
+
+def unregistered_env_names(environ: Optional[Mapping[str, str]] = None) -> Tuple[str, ...]:
+    environment = os.environ if environ is None else environ
+    return tuple(
+        sorted(name for name in environment if name.startswith("PYPTO_X_") and not is_registered(name))
+    )
+
+
+def _emit_once(name: str, message: str, category: type) -> bool:
+    if name in _WARNED:
+        return False
+    _WARNED[name] = message
+    warnings.warn(message, category, stacklevel=3)
+    return True
+
+
+def reset_warnings() -> None:
+    """Forget the one-time warning state (used by tests and long-lived tools)."""
+
+    _WARNED.clear()
+
+
+def warn_deprecations(environ: Optional[Mapping[str, str]] = None) -> Tuple[str, ...]:
+    """Emit one warning per set deprecated/unregistered variable.
+
+    Returns the names that produced a warning this call.  Warnings can be
+    silenced with ``PYPTO_X_ENV_DEPRECATION_WARNINGS=0``.
+    """
+
+    environment = os.environ if environ is None else environ
+    if not warnings_enabled(environment):
+        return ()
+    emitted = []
+    for spec in ALL_ENV_VARS:
+        if spec.deprecation_status != "deprecated" or environment.get(spec.name) is None:
+            continue
+        message = (
+            "environment variable {} is deprecated; use {} instead "
+            "(0006 section 9; registry status={})".format(
+                spec.name, spec.replacement, spec.deprecation_status
+            )
+        )
+        if _emit_once("deprecated:" + spec.name, message, EnvDeprecationWarning):
+            emitted.append(spec.name)
+    for name in unregistered_env_names(environment):
+        message = (
+            "unregistered PYPTO_X_* environment variable {} is set; the execution "
+            "layer does not honor it. Register it in pypto.execution.env_registry "
+            "or remove it (0006 section 9: new features must not add env vars).".format(
+                _safe_unregistered_name(name)
+            )
+        )
+        if _emit_once("unregistered:" + name, message, UnregisteredEnvWarning):
+            emitted.append(name)
+    return tuple(emitted)
+
+
+def read_env(
+    name: str,
+    default: Optional[str] = None,
+    environ: Optional[Mapping[str, str]] = None
+) -> Optional[str]:
+    """Compatibility reader for registered variables.
+
+    The returned value is exactly ``environ[name]`` (old behavior unchanged).
+    Deprecated variables emit a one-time deprecation warning; unknown
+    ``PYPTO_X_*`` names are warned about as unregistered.  Non-project names
+    (for example ``OMP_NUM_THREADS``) are read without warnings.
+    """
+
+    environment = os.environ if environ is None else environ
+    raw = environment.get(name, default)
+    if not warnings_enabled(environment):
+        return raw
+    spec = _BY_NAME.get(name)
+    if spec is not None:
+        if spec.deprecation_status == "deprecated" and environment.get(name) is not None:
+            _emit_once(
+                "deprecated:" + name,
+                "environment variable {} is deprecated; use {} instead "
+                "(0006 section 9; registry status={})".format(
+                    name, spec.replacement, spec.deprecation_status
+                ),
+                EnvDeprecationWarning,
+            )
+        return raw
+    if isinstance(name, str) and name.startswith("PYPTO_X_"):
+        _emit_once(
+            "unregistered:" + name,
+            "unregistered PYPTO_X_* environment variable {} is set; the execution "
+            "layer does not honor it. Register it in pypto.execution.env_registry "
+            "or remove it.".format(_safe_unregistered_name(name)),
+            UnregisteredEnvWarning,
+        )
+    return raw
+
+
+def policy_hints_from_env(environ: Optional[Mapping[str, str]] = None) -> Mapping[str, Any]:
+    """Declarative policy fragments equivalent to the registered compat aliases.
+
+    This only *suggests* the declaration; it never applies it implicitly, so a
+    process environment cannot silently override an explicit ``ExecutionPolicy``.
+    """
+
+    environment = os.environ if environ is None else environ
+    hints = {}
+    portable = environment.get("PYPTO_X_PORTABLE_ONLY")
+    if portable is not None:
+        hints["profile"] = "portable"
+        hints["provider"] = {"mode": "portable"}
+        hints["compat_source"] = {"PYPTO_X_PORTABLE_ONLY": portable == "1"}
+    max_threads = None
+    for name in ("PYPTO_X_AVX512_GEMM_THREADS", "PYPTO_X_VLLM_GEMM_THREADS"):
+        raw = environment.get(name)
+        if raw is None:
+            continue
+        try:
+            parsed = int(raw)
+        except (TypeError, ValueError):
+            continue
+        if parsed >= 1:
+            max_threads = parsed if max_threads is None else min(max_threads, parsed)
+    if max_threads is not None:
+        hints.setdefault("resources", {})["max_threads"] = max_threads
+    device = environment.get("PYPTO_X_ASCEND_DEVICE_ID")
+    if device is not None:
+        try:
+            hints.setdefault("placement", {})["device"] = int(device)
+        except (TypeError, ValueError):
+            pass
+    return hints
+
