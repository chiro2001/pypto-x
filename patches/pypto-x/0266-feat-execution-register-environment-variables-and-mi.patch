+"""U4 environment-variable registry (P0) and compatibility layer (P1).
+
+This module is the single source of truth for the environment variables that
+the PyPTO-X project has measured and registered (the 35 variables frozen in
+``docs/10-architecture/0005-...`` section 3.2, plus the provider thread
+environment consumed by the pinned AOCL artifact and one registry control
+switch).
+
+Design rules (0006 section 9 / P5):
+
+* every registered variable has a category, meaning, default, legal domain,
+  scope, replacement target, deprecation status and an effect verdict;
+* **new features must not add environment variables** - unknown ``PYPTO_X_*``
+  names are reported (and warned about) instead of being silently honoured;
+* registered variables keep their old behavior (P1 compatibility); deprecated
+  ones emit a one-time deprecation warning through :func:`read_env` /
+  :func:`warn_deprecations`, suppressible via
+  ``PYPTO_X_ENV_DEPRECATION_WARNINGS=0``;
+* an environment variable that changes artifact bytes/semantics must be
+  captured by a policy/plan/capability digest; the registry records the
+  measured verdict per variable and the U4 audit found no execution-layer
+  semantic variable outside the digest (see ``raw/`` evidence).
+
+The module itself is standard-library only and dependency-free so it can be
+imported from lightweight contexts (for example the compiler-target path
+overrides) without importing the execution package.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import os
+import warnings
+from dataclasses import dataclass
+from typing import Any, Dict, Mapping, Optional, Tuple
+
+
+ENV_REGISTRY_SCHEMA_VERSION = 1
+
+ENV_CATEGORIES = (
+    "build_artifact_dir",
+    "toolchain_path",
+    "performance",
+    "runtime_device",
+    "model_asset",
+    "vllm_integration",
+    "dev_resource",
+    "provider_thread_env",
+    "registry_control",
+)
+
+#: Deprecation-warning switch.  ``0``/``off``/``false`` silence the one-time
+#: warnings; any other value (or unset) keeps them enabled.
+ENV_DEPRECATION_WARNINGS = "PYPTO_X_ENV_DEPRECATION_WARNINGS"
+
+DEPRECATION_STATUSES = ("deprecated", "internal", "active")
+
+DIGEST_STATUSES = (
+    "not_an_artifact_input",
+    "outside_registered_execution_providers",
+    "captured_in_capability_or_policy_digest",
+    "effect_unproven",
+)
+
+
+class EnvDeprecationWarning(UserWarning):
+    """One-time warning for a deprecated registered environment variable."""
+
+
+class UnregisteredEnvWarning(UserWarning):
+    """Warning for a ``PYPTO_X_*`` variable that is not registered."""
+
+
+@dataclass(frozen=True)
+class EnvVarSpec:
+    """One registered environment variable (registry row)."""
+
+    name: str
+    category: str
+    meaning: str
+    default: Any
+    legal_domain: str
+    scope: str
+    consumer_kind: str
+    affects_artifact_semantics: bool
+    semantic_scope: str
+    digest_status: str
+    replacement: str
+    deprecation_status: str
+    effect_evidence: str
+    effect_unproven: bool = False
+
+    def to_dict(self) -> Mapping[str, Any]:
+        document = dataclasses.asdict(self)
+        document["deprecated"] = self.deprecation_status == "deprecated"
+        return document
+
+
+def _spec(
+    name: str,
+    category: str,
+    meaning: str,
+    default: Any,
+    legal_domain: str,
+    scope: str,
+    consumer_kind: str,
+    affects_artifact_semantics: bool,
+    semantic_scope: str,
+    digest_status: str,
+    replacement: str,
+    deprecation_status: str,
+    effect_evidence: str,
+    effect_unproven: bool = False
+) -> EnvVarSpec:
+    return EnvVarSpec(
+        name=name,
+        category=category,
+        meaning=meaning,
+        default=default,
+        legal_domain=legal_domain,
+        scope=scope,
+        consumer_kind=consumer_kind,
+        affects_artifact_semantics=bool(affects_artifact_semantics),
+        semantic_scope=semantic_scope,
+        digest_status=digest_status,
+        replacement=replacement,
+        deprecation_status=deprecation_status,
+        effect_evidence=effect_evidence,
+        effect_unproven=bool(effect_unproven),
+    )
+
+
