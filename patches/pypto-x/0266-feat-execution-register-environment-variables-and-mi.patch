+#: Backwards-compatible discovery view over
+#: :mod:`pypto.execution.env_registry`.  The registry is the single source of
+#: truth; this tuple only keeps the pre-U4 discovery field names available to
+#: existing callers and tests.
+def _legacy_env_registry_view():
+    rows = []
+    for spec in env_registry.ALL_ENV_VARS:
+        domain = spec.legal_domain.lower()
+        if "0|1" in domain:
+            value_kind = "flag"
+        elif "integer" in domain:
+            value_kind = "integer"
+        else:
+            value_kind = "opaque"
+        rows.append(
+            {
+                "name": spec.name,
+                "class": spec.category,
+                "policy_field": spec.replacement,
+                "consumed_by_execution": spec.digest_status
+                == "captured_in_capability_or_policy_digest"
+                or spec.scope == "execution",
+                "value_kind": value_kind,
+                "source": spec.effect_evidence,
+            }
+        )
+    return tuple(rows)
+
+
+ENV_VAR_REGISTRY = _legacy_env_registry_view()
 
