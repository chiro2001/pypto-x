@@ -7,6 +7,7 @@ import json
 import os
 from pathlib import Path
 import shutil
+import stat
 import subprocess
 import tempfile
 from typing import Any, Mapping, Optional
@@ -340,6 +341,36 @@ def _artifact_directory(options: Optional[CompileOptions], build_dir: Path) -> P
     return path
 
 
+def _read_and_lock_existing_artifact(path: Path) -> Optional[bytes]:
+    """Read and lock an existing digest path without following symlinks."""
+
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(str(path), os.O_RDONLY | nofollow)
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise Avx2CompileError(
+            "content-addressed artifact path is not a safe regular file: {} ({})".format(path, exc)
+        ) from exc
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
+            raise Avx2CompileError(
+                "content-addressed artifact path must be a single-link regular file: {}".format(path)
+            )
+        chunks = []
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        os.fchmod(descriptor, 0o444)
+        return b"".join(chunks)
+    finally:
+        os.close(descriptor)
+
+
 def _native_source(target_ir: Avx2Program) -> tuple:
     feature_mask = 1 | 2 | 4 | 8 | (16 if target_ir.use_fma else 0)
