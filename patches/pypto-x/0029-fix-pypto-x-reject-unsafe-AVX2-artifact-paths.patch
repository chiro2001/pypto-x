+def test_content_addressed_symlink_is_rejected_without_chmod_external_target(tmp_path):
+    program = _add_program()
+    target = _target("avx2")
+    _, _, seed = _compile(program, target, tmp_path / "seed")
+    external = tmp_path / "external.so"
+    shutil.copyfile(seed.path, external)
+    os.chmod(str(external), 0o600)
+    external_mode = external.stat().st_mode
+    artifact_dir = tmp_path / "symlink-artifacts"
+    artifact_dir.mkdir()
+    symlink_path = artifact_dir / Path(seed.path).name
+    symlink_path.symlink_to(external)
+    compiler = Avx2Compiler()
+    target_ir = compiler.lower(program, target)
+    with pytest.raises(Avx2CompileError, match="safe regular file"):
+        compiler.compile(
+            target_ir,
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx2",
+                extra={
+                    "build_dir": str(tmp_path / "symlink-build"),
+                    "artifact_dir": str(artifact_dir),
+                },
+            ),
+        )
+    assert symlink_path.is_symlink()
+    assert external.stat().st_mode == external_mode
+
+
 def test_cache_key_isolated_by_fma_and_target(tmp_path):
