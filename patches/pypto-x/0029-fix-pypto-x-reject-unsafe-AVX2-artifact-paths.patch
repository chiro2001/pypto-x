+    if existing_bytes is not None:
+        if existing_bytes != native_bytes:
             raise Avx2CompileError("content-addressed AVX2 artifact path contains different bytes")
-        os.chmod(str(output_path), 0o444)
     else:
         descriptor, publication_name = tempfile.mkstemp(
             prefix=output_path.name + ".tmp.", dir=str(artifact_dir)
@@ -449,12 +480,12 @@ def _compile_native(target_ir: Avx2Program, options: Optional[CompileOptions]) -
         try:
             publication_path.write_bytes(native_bytes)
             os.chmod(str(publication_path), 0o444)
-            if output_path.exists():
