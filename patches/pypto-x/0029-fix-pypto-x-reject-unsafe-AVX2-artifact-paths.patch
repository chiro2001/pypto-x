@@ -436,10 +467,10 @@ def _compile_native(target_ir: Avx2Program, options: Optional[CompileOptions]) -
         shutil.rmtree(str(invocation_dir), ignore_errors=True)
     native_digest = sha256_bytes(native_bytes)
