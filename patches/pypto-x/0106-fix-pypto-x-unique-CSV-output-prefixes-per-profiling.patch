+def safe_prefix(path, input_root):
+    """由 input_root 名 + 相对目录 + 短哈希生成唯一前缀，避免多 run 覆盖。"""
+    import re as _re
+
+    absolute_root = os.path.abspath(input_root)
+    root_label = os.path.basename(absolute_root) or "input"
+    relative = os.path.relpath(os.path.dirname(path), absolute_root)
+    parts = [root_label]
+    if relative not in (".", ""):
+        parts.extend(part for part in relative.split(os.sep) if part not in (".", ""))
+    joined = "/".join(parts)
+    cleaned = _re.sub(r"[^A-Za-z0-9._-]+", "_", joined).strip("_")[:70]
+    digest = hashlib.sha1(("%s|%s" % (absolute_root, relative)).encode("utf-8")).hexdigest()[:6]
+    return "%s_%s" % (cleaned, digest) if cleaned else digest
+
+
+def process_file(path, outdir, max_rows, max_bytes, prefix):
     lower = path.lower()
     name = os.path.basename(path)
     if lower.endswith(".csv"):
-        return process_ascend_csv(path, outdir, max_rows, max_bytes, name[: -len(".csv")])
+        return process_ascend_csv(
