index 000000000..a6d21dded
--- /dev/null
+++ b/tools/a2_vllm_ascend/prompts.py
@@ -0,0 +1,67 @@
+# -*- coding: utf-8 -*-
+"""Qwen3.5-0.8B 冻结 prompt 集合。
+
+与 gold harness（``qwen35-bf16-reference/tools/qwen35_reference/run_reference.py``）
+中的 ``PROMPTS`` 逐字段一致；本模块只做纯文本，不触碰视觉编码器。
+
+硬判据（前 4 个生成 token）来自任务书与 gold ``decode_token_ids``，
+在此作为显式锚点记录，真正的判定仍以 gold npz/ids.json 为准
+（``compare_gold.py`` 会两者交叉核对）。
+"""
+
+PROMPTS = (
+    {
+        "id": "en_continuation",
+        "kind": "raw_text",
+        "text": "The capital of France is",
+    },
+    {
+        "id": "zh_continuation",
+        "kind": "raw_text",
+        "text": "请用一句话解释什么是张量并行。",
+    },
+    {
+        "id": "chat_zh_user",
+        "kind": "chat_template",
+        "messages": ({"role": "user", "content": "你好，请介绍一下你自己。"},),
+        "add_generation_prompt": True,
+        "enable_thinking": False,
+    },
+)
+
+# 任务书给出的硬判据锚点（前 4 个生成 token）。
+EXPECTED_DECODE_IDS = {
+    "en_continuation": [11751, 13, 198, 760],
+    "zh_continuation": [271, 248068, 271, 248069],
+    "chat_zh_user": [109266, 6115, 103724, 1167],
+}
+
+# 只做纯文本 decode 时的生成上限（记录全部生成 token）。
+DEFAULT_MAX_TOKENS = 16
+
+
+def prompt_ids(prompt):
+    """返回 (kind, prompt_id) 便于选择分支。"""
+    return prompt["id"], prompt.get("kind", "raw_text")
+
+
+def render_prompt(tokenizer, spec):
+    """按 gold 口径构造 prompt 文本与 token id 序列。
+
+    * raw_text：直接 tokenizer(text, add_special_tokens=False)
+    * chat_template：apply_chat_template(tokenize=False, add_generation_prompt,
+      enable_thinking) 后同样 add_special_tokens=False
+
+    返回 ``(rendered_text, token_ids)``。
+    """
+    if spec["kind"] == "raw_text":
+        rendered = spec["text"]
+    else:
+        rendered = tokenizer.apply_chat_template(
+            list(spec["messages"]),
+            tokenize=False,
+            add_generation_prompt=spec["add_generation_prompt"],
+            enable_thinking=spec["enable_thinking"],
+        )
+    encoded = tokenizer(rendered, add_special_tokens=False)
+    return rendered, [int(token) for token in encoded["input_ids"]]
diff --git a/tools/a2_vllm_ascend/run_a2_baseline.sh b/tools/a2_vllm_ascend/run_a2_baseline.sh
new file mode 100644
index 000000000..d546e48e0
--- /dev/null
+++ b/tools/a2_vllm_ascend/run_a2_baseline.sh
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+# W8H: 在 A2(910B3) 上执行 Qwen3.5-0.8B 的 vllm-ascend E2E 精度 + 性能基线采集。
+#
+# 前置（A2 容器内已有）：
+#   /usr/local/Ascend/ascend-toolkit/set_env.sh   CANN 环境
+#   /usr/local/python3.12.13/bin/python3.12       vllm/vllm-ascend/torch_npu/tokenizers
+#   $MODEL_DIR                                    模型目录（见下方默认值）
+#   $MANIFEST                                     冻结 _manifest.json
+#
+# 用法（A2 上，harness 目录内）：
+#   MODEL_DIR=/root/models/Qwen3.5-0.8B \
+#   MANIFEST=/root/a2_vllm_qwen35/model_manifest/_manifest.json \
+#   OUT_DIR=/root/a2_vllm_qwen35/evidence \
+#   bash run_a2_baseline.sh
+#
+# 环境变量：
+#   PYTHON         默认 /usr/local/python3.12.13/bin/python3.12
+#   RUN_DEFAULT_MODE=1  额外跑一遍不带 --enforce-eager 的性能采集（ACL graph 路径）
+#   SKIP_WEIGHTS_CHECK=1 跳过 sha256 校验（不建议）
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PYTHON="${PYTHON:-/usr/local/python3.12.13/bin/python3.12}"
+MODEL_DIR="${MODEL_DIR:-/root/models/Qwen3.5-0.8B}"
+MANIFEST="${MANIFEST:?需要 MANIFEST=/abs/path/_manifest.json}"
+OUT_DIR="${OUT_DIR:-/root/a2_vllm_qwen35/evidence}"
+MAX_TOKENS="${MAX_TOKENS:-16}"
+TOPK="${TOPK:-5}"
+WARMUP="${WARMUP:-5}"
+REPEATS="${REPEATS:-21}"
+ROUNDS="${ROUNDS:-3}"
+MAX_MODEL_LEN="${MAX_MODEL_LEN:-512}"
+GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.35}"
+
+mkdir -p "$OUT_DIR" "$OUT_DIR/logs"
+
+# CANN 环境（torch_npu 需要）
+# shellcheck disable=SC1091
+source /usr/local/Ascend/ascend-toolkit/set_env.sh
+
+# ATB(nnal) 环境：vllm-ascend 的 worker 会加载 libop_plugin_atb.so -> libatb.so。
+# atb/set_env.sh 通过 `python3 -c "import torch"` 自动选择 cxx_abi，因此必须先把
+# vllm 所在解释器放进 PATH，否则会错误地选到 cxx_abi_0。
+export PATH="/usr/local/python3.12.13/bin:${PATH}"
+# shellcheck disable=SC1091
+source /usr/local/Ascend/nnal/atb/set_env.sh
+
+# torch_npu 在父进程初始化过后不能在被 fork 的 EngineCore 里重新初始化，
+# vLLM v1 默认 fork 会报 "Cannot re-initialize NPU in forked subprocess"。
+export VLLM_WORKER_MULTIPROC_METHOD=spawn
+
+# 不联网（模型与 tokenizer 全部来自本地目录）
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+
+npu_smi() {
+    export LD_LIBRARY_PATH="/usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/common:/usr/local/Ascend/driver/lib64/driver:${LD_LIBRARY_PATH:-}"
+    npu-smi info
+}
+
+echo ">> [1/7] npu-smi before" | tee "$OUT_DIR/logs/driver.log"
+npu_smi > "$OUT_DIR/npu_smi_before.txt" 2>&1 || true
+
+echo ">> [2/7] environment fingerprint" | tee -a "$OUT_DIR/logs/driver.log"
+"$PYTHON" "$HERE/collect_env.py" --out "$OUT_DIR/env_fingerprint.json" \
+    > "$OUT_DIR/logs/collect_env.log" 2>&1
+
+if [[ "${SKIP_WEIGHTS_CHECK:-0}" != "1" ]]; then
+    echo ">> [3/7] weights sha256 check" | tee -a "$OUT_DIR/logs/driver.log"
+    "$PYTHON" "$HERE/sha256_manifest_check.py" --dir "$MODEL_DIR" --manifest "$MANIFEST" \
+        --out "$OUT_DIR/weights_check.json" > "$OUT_DIR/logs/weights_check.log" 2>&1
+else
+    echo ">> [3/7] weights check SKIPPED" | tee -a "$OUT_DIR/logs/driver.log"
+fi
+
+echo ">> [4/7] accuracy (eager)" | tee -a "$OUT_DIR/logs/driver.log"
+"$PYTHON" "$HERE/run_vllm_ascend_e2e.py" --mode accuracy \
+    --model-dir "$MODEL_DIR" --out "$OUT_DIR/accuracy.json" \
+    --max-tokens "$MAX_TOKENS" --topk "$TOPK" \
+    --max-model-len "$MAX_MODEL_LEN" \
+    --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION" --enforce-eager \
+    > "$OUT_DIR/logs/accuracy.log" 2>&1
+npu_smi > "$OUT_DIR/npu_smi_after_accuracy.txt" 2>&1 || true
+
+echo ">> [5/7] perf (eager)" | tee -a "$OUT_DIR/logs/driver.log"
+"$PYTHON" "$HERE/run_vllm_ascend_e2e.py" --mode perf \
+    --model-dir "$MODEL_DIR" --out "$OUT_DIR/perf_eager.json" \
+    --max-tokens "$MAX_TOKENS" --warmup "$WARMUP" --repeats "$REPEATS" --rounds "$ROUNDS" \
+    --max-model-len "$MAX_MODEL_LEN" \
+    --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION" --enforce-eager \
+    > "$OUT_DIR/logs/perf_eager.log" 2>&1
+npu_smi > "$OUT_DIR/npu_smi_after_perf_eager.txt" 2>&1 || true
+
+if [[ "${RUN_DEFAULT_MODE:-0}" == "1" ]]; then
+    echo ">> [6/7] perf (default / ACL graph)" | tee -a "$OUT_DIR/logs/driver.log"
+    "$PYTHON" "$HERE/run_vllm_ascend_e2e.py" --mode perf \
+        --model-dir "$MODEL_DIR" --out "$OUT_DIR/perf_default.json" \
+        --max-tokens "$MAX_TOKENS" --warmup "$WARMUP" --repeats "$REPEATS" --rounds "$ROUNDS" \
+        --max-model-len "$MAX_MODEL_LEN" \
+        --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION" \
+        > "$OUT_DIR/logs/perf_default.log" 2>&1
+else
+    echo ">> [6/7] perf (default) skipped (RUN_DEFAULT_MODE!=1)" | tee -a "$OUT_DIR/logs/driver.log"
+fi
+
+echo ">> [7/7] npu-smi after" | tee -a "$OUT_DIR/logs/driver.log"
+npu_smi > "$OUT_DIR/npu_smi_after.txt" 2>&1 || true
+
+echo ">> done; evidence in $OUT_DIR" | tee -a "$OUT_DIR/logs/driver.log"
diff --git a/tools/a2_vllm_ascend/run_vllm_ascend_e2e.py b/tools/a2_vllm_ascend/run_vllm_ascend_e2e.py
new file mode 100644
index 000000000..258097c5f
--- /dev/null
+++ b/tools/a2_vllm_ascend/run_vllm_ascend_e2e.py
@@ -0,0 +1,486 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8H: 在 A2(910B3) 上用 vllm-ascend 跑 Qwen3.5-0.8B 的 E2E 精度 / 性能基线。
+
+精度（--mode accuracy）
+    * 与 gold 完全一致的三个 prompt（raw_text x2 + 官方 chat template）；
+    * greedy（temperature=0, top_p=1），max_tokens 默认 16，记录全部生成 token；
+    * SamplingParams(logprobs=K, prompt_logprobs=K) 取 top-k，用于与 gold
+      ``prefill_logits`` / ``prefill_next_logits`` / ``decode_logits`` 做
+      argmax / top-k 一致性核对（vLLM 不暴露完整 logits，证据中如实标注）。
+
+性能（--mode perf）
+    * 走 AsyncLLM 流式接口，自采每个 token 的 wall 时间戳：
+      TTFT、逐 token ITL/TPOT、decode 吞吐、端到端吞吐；
+    * warmup 默认 5，测量 R 默认 21，batch=1 / concurrency=1（串行发请求）；
+    * 原始样本与 p50/p95/CV 全部落盘，波动门槛按 PERF 协议精神标注
+      （CV<=0.05、p95/median<=1.25），但该协议仍是提案，数字是原始事实。
+
+用法（A2 内）::
+
+    source /usr/local/Ascend/ascend-toolkit/set_env.sh
+    python run_vllm_ascend_e2e.py --mode accuracy --model-dir <dir> --out <accuracy.json>
+    python run_vllm_ascend_e2e.py --mode perf     --model-dir <dir> --out <perf.json> [--enforce-eager]
+
+本脚本不写任何端点/凭据；model-dir 只读。
+"""
+
+import argparse
+import gc
+import json
+import os
+import platform
+import statistics
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from prompts import DEFAULT_MAX_TOKENS, PROMPTS, render_prompt  # noqa: E402
+
+
+def now_iso():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def percentile(values, q):
+    """线性插值分位数（numpy 默认口径）。"""
+    ordered = sorted(values)
+    if not ordered:
+        return None
+    if len(ordered) == 1:
+        return float(ordered[0])
+    position = (len(ordered) - 1) * q
+    lower = int(position)
+    upper = min(lower + 1, len(ordered) - 1)
+    fraction = position - lower
+    return float(ordered[lower] * (1.0 - fraction) + ordered[upper] * fraction)
+
+
+def describe(values):
+    if not values:
+        return None
+    mean = statistics.fmean(values)
+    stdev = statistics.stdev(values) if len(values) > 1 else 0.0
+    p50 = percentile(values, 0.5)
+    p95 = percentile(values, 0.95)
+    return {
+        "n": len(values),
+        "mean": mean,
+        "min": min(values),
+        "max": max(values),
+        "p50": p50,
+        "p95": p95,
+        "stdev": stdev,
+        "cv": (stdev / mean) if mean else None,
+        "p95_over_median": (p95 / p50) if p50 else None,
+    }
+
+
+def stability_flags(stats):
+    """PERF 协议（提案）的精神：CV<=0.05 且 p95/median<=1.25 记为稳定。"""
+    if not stats:
+        return None
+    cv = stats.get("cv")
+    ratio = stats.get("p95_over_median")
+    cv_ok = cv is not None and cv <= 0.05
+    ratio_ok = ratio is not None and ratio <= 1.25
+    return {"cv_le_0.05": cv_ok, "p95_over_median_le_1.25": ratio_ok,
+            "stable": bool(cv_ok and ratio_ok)}
+
+
+def load_tokenizer(model_dir):
+    from transformers import AutoTokenizer
+    return AutoTokenizer.from_pretrained(model_dir, local_files_only=True)
+
+
+def select_prompts(ids_arg):
+    if not ids_arg:
+        return list(PROMPTS)
+    wanted = [item.strip() for item in ids_arg.split(",") if item.strip()]
+    return [prompt for prompt in PROMPTS if prompt["id"] in wanted]
+
+
+def engine_args_dict(args):
+    return {
+        "model": args.model_dir,
+        "dtype": args.dtype,
+        "tensor_parallel_size": args.tp,
+        "max_model_len": args.max_model_len,
+        "gpu_memory_utilization": args.gpu_memory_utilization,
+        "enforce_eager": bool(args.enforce_eager),
+        "seed": args.seed,
+        "trust_remote_code": False,
+        "max_num_seqs": 1,
+        "disable_log_stats": True,
+    }
+
+
+def versions():
+    info = {"python": platform.python_version(), "platform": platform.platform()}
+    for module in ("torch", "torch_npu", "vllm", "vllm_ascend", "transformers", "numpy"):
+        try:
+            imported = __import__(module)
+            info[module] = getattr(imported, "__version__", "unknown")
+        except Exception as error:  # pragma: no cover - 诊断路径
+            info[module] = "import-failed: %s" % error
+    return info
+
+
+def summarize_prompt_logprobs(prompt_logprobs, prompt_token_ids, topk):
+    """把 vLLM 的 prompt_logprobs 转成可比较的 JSON 结构。
+
+    vLLM 语义：``prompt_logprobs[0] is None``；位置 i 给出"给定 <i 的 token，
+    下一个 token 是 prompt_token_ids[i]"的分布。gold ``prefill_logits[i-1]``
+    正是同一分布。
+    """
+    rows = []
+    for index, entry in enumerate(prompt_logprobs):
+        if entry is None:
+            rows.append({"pos": index, "topk": None, "chosen": None})
+            continue
+        items = sorted(entry.items(), key=lambda kv: kv[1].logprob, reverse=True)
+        chosen_id = int(prompt_token_ids[index]) if index < len(prompt_token_ids) else None
+        chosen = entry.get(chosen_id)
+        rows.append({
+            "pos": index,
+            "n_returned": len(entry),
+            "topk": [[int(token), float(value.logprob), int(value.rank)]
+                     for token, value in items[:topk]],
+            "chosen_token_id": chosen_id,
+            "chosen_logprob": float(chosen.logprob) if chosen is not None else None,
+            "chosen_rank": int(chosen.rank) if chosen is not None else None,
+        })
+    return rows
+
+
+def summarize_decode_logprobs(decode_logprobs, generated_ids, topk):
+    rows = []
+    for index, entry in enumerate(decode_logprobs or []):
+        if entry is None:
+            rows.append({"step": index, "topk": None, "chosen": None})
+            continue
+        items = sorted(entry.items(), key=lambda kv: kv[1].logprob, reverse=True)
+        chosen_id = int(generated_ids[index]) if index < len(generated_ids) else None
+        chosen = entry.get(chosen_id)
+        rows.append({
+            "step": index,
+            "n_returned": len(entry),
+            "topk": [[int(token), float(value.logprob), int(value.rank)]
+                     for token, value in items[:topk]],
+            "chosen_token_id": chosen_id,
+            "chosen_logprob": float(chosen.logprob) if chosen is not None else None,
+            "chosen_rank": int(chosen.rank) if chosen is not None else None,
+        })
+    return rows
+
+
+def run_accuracy(args):
+    from vllm import LLM, SamplingParams
+
+    tokenizer = load_tokenizer(args.model_dir)
+    prompts = select_prompts(args.prompts)
+    prepared = []
+    for spec in prompts:
+        rendered, ids = render_prompt(tokenizer, spec)
+        prepared.append((spec["id"], rendered, ids))
+        print("[accuracy] prompt=%s seq_len=%d ids=%s" % (spec["id"], len(ids), ids), flush=True)
+
+    load_started = time.monotonic()
+    llm = LLM(**engine_args_dict(args))
+    load_seconds = time.monotonic() - load_started
+    print("[accuracy] engine loaded in %.2fs" % load_seconds, flush=True)
+
+    sampling = SamplingParams(
+        temperature=0.0,
+        top_p=1.0,
+        max_tokens=args.max_tokens,
+        logprobs=args.topk,
+        prompt_logprobs=args.topk,
+        seed=args.seed,
+    )
+    results = []
+    for prompt_id, rendered, ids in prepared:
+        started = time.monotonic()
+        outputs = llm.generate([{"prompt_token_ids": list(ids)}], sampling, use_tqdm=False)
+        elapsed = time.monotonic() - started
+        output = outputs[0]
+        completion = output.outputs[0]
+        generated_ids = [int(token) for token in completion.token_ids]
+        record = {
+            "id": prompt_id,
+            "rendered_text": rendered,
+            "prompt_token_ids": [int(token) for token in output.prompt_token_ids],
+            "requested_prompt_token_ids": [int(token) for token in ids],
+            "max_tokens": args.max_tokens,
+            "generated_token_ids": generated_ids,
+            "n_generated": len(generated_ids),
+            "finish_reason": completion.finish_reason,
+            "generate_seconds": elapsed,
+            "prompt_logprobs": summarize_prompt_logprobs(
+                output.prompt_logprobs, output.prompt_token_ids, args.topk),
+            "decode_step_logprobs": summarize_decode_logprobs(
+                completion.logprobs, generated_ids, args.topk),
+        }
+        results.append(record)
+        print("[accuracy] %s -> %s (%s, %.2fs)" % (
+            prompt_id, generated_ids, completion.finish_reason, elapsed), flush=True)
+
+    del llm
+    gc.collect()
+    return {
+        "schema": "pypto-x.a2-vllm-ascend.accuracy.v1",
+        "generated_at": now_iso(),
+        "mode": "accuracy",
+        "engine": engine_args_dict(args),
+        "topk": args.topk,
+        "model_load_seconds": load_seconds,
+        "versions": versions(),
+        "prompts": results,
+        "api_limits": [
+            "vLLM 不暴露完整 logits / log_softmax 全向量；本证据只有 top-%d logprobs。" % args.topk,
+            "prompt_logprobs[k] 在 vLLM 中对首个 prompt token 为 None，其余位置语义与 gold prefill_logits[i-1] 对齐。",
+            "logprob 数值受 vLLM 采样参数处理影响，故一致性判定只依赖 token id 的 argmax/top-k 集合与 chosen rank。",
+        ],
+    }
+
+
+async def _async_one_request(engine, prompt_ids, sampling, request_id):
+    """流式跑一个请求，返回 token 序列与逐 token 到达时间（monotonic）。"""
+    started = time.monotonic()
+    tokens = []
+    arrivals = []
+    chunk_sizes = []
+    finish_reason = None
+    async for output in engine.generate({"prompt_token_ids": list(prompt_ids)},
+                                        sampling, request_id=request_id):
+        current = [int(token) for token in output.outputs[0].token_ids]
+        now = time.monotonic()
+        if not current:
+            continue
+        if len(current) > len(tokens) and current[:len(tokens)] == tokens:
+            new_tokens = current[len(tokens):]
+            tokens = current
+        else:
+            new_tokens = current
+            tokens = tokens + current
+        for _ in new_tokens:
+            arrivals.append(now)
+        chunk_sizes.append(len(new_tokens))
+        if output.outputs[0].finish_reason is not None:
+            finish_reason = output.outputs[0].finish_reason
+    ended = time.monotonic()
+    return {
+        "tokens": tokens,
+        "arrivals": arrivals,
+        "chunk_sizes": chunk_sizes,
+        "finish_reason": finish_reason,
+        "started": started,
+        "ended": ended,
+    }
+
+
+async def _perf_async(args):
+    from vllm import SamplingParams
+    from vllm.engine.arg_utils import AsyncEngineArgs
+    from vllm.usage.usage_lib import UsageContext
+    from vllm.v1.engine.async_llm import AsyncLLM
+
+    tokenizer = load_tokenizer(args.model_dir)
+    prompts = select_prompts(args.prompts)
+    prepared = []
+    for spec in prompts:
+        rendered, ids = render_prompt(tokenizer, spec)
+        prepared.append((spec["id"], rendered, ids))
+
+    engine_args = AsyncEngineArgs(**engine_args_dict(args))
+    load_started = time.monotonic()
+    engine = AsyncLLM.from_engine_args(engine_args, usage_context=UsageContext.ENGINE_CONTEXT)
+    load_seconds = time.monotonic() - load_started
+    print("[perf] AsyncLLM loaded in %.2fs" % load_seconds, flush=True)
+
+    sampling = SamplingParams(temperature=0.0, top_p=1.0,
+                              max_tokens=args.max_tokens, seed=args.seed)
+    results = []
+    try:
+        for prompt_id, rendered, ids in prepared:
+            for warmup_index in range(args.warmup):
+                outcome = await _async_one_request(
+                    engine, ids, sampling, "warmup-%s-%d" % (prompt_id, warmup_index))
+                if warmup_index == args.warmup - 1:
+                    print("[perf] %s warmup done: n=%d" % (prompt_id, len(outcome["tokens"])), flush=True)
+            samples = []
+            for round_index in range(args.rounds):
+                for repeat in range(args.repeats):
+                    outcome = await _async_one_request(
+                        engine, ids, sampling,
+                        "measure-%s-r%d-%d" % (prompt_id, round_index, repeat))
+                    arrivals = outcome["arrivals"]
+                    tokens = outcome["tokens"]
+                    if len(arrivals) >= 2:
+                        itls = [arrivals[i] - arrivals[i - 1] for i in range(1, len(arrivals))]
+                        decode_seconds = arrivals[-1] - arrivals[0]
+                    elif arrivals:
+                        itls = []
+                        decode_seconds = arrivals[-1] - outcome["started"]
+                    else:
+                        itls = []
+                        decode_seconds = None
+                    e2e_seconds = outcome["ended"] - outcome["started"]
+                    sample = {
+                        "round": round_index,
+                        "repeat": repeat,
+                        "ttft_seconds": (arrivals[0] - outcome["started"]) if arrivals else None,
+                        "itl_seconds": itls,
+                        "n_generated": len(tokens),
+                        "decode_seconds": decode_seconds,
+                        "e2e_seconds": e2e_seconds,
+                        "tpot_avg_seconds": (
+                            decode_seconds / (len(tokens) - 1)
+                            if decode_seconds and len(tokens) > 1 else None),
+                        "decode_tokens_per_second": (
+                            (len(tokens) - 1) / decode_seconds if decode_seconds else None),
+                        "e2e_tokens_per_second": (
+                            len(tokens) / e2e_seconds if e2e_seconds > 0 else None),
+                        "finish_reason": outcome["finish_reason"],
+                        "chunk_sizes": outcome["chunk_sizes"],
+                        "generated_token_ids": tokens,
+                    }
+                    samples.append(sample)
+                    if round_index == 0 and repeat == 0:
+                        print("[perf] %s first sample: ttft=%.4fs n=%d itls=%s" % (
+                            prompt_id, sample["ttft_seconds"] or -1, len(tokens),
+                            ["%.4f" % value for value in itls[:3]]), flush=True)
+
+            def collect(key):
+                return [s[key] for s in samples if s[key] is not None]
+
+            all_itl = []
+            for sample in samples:
+                all_itl.extend(sample["itl_seconds"])
+            # vLLM 最后一个 decode step 的 token 交付常与前一 token 几乎同时到达（~1ms），
+            # 会显著放大逐 token ITL 的 CV；单独记录伪影数量与剔除后的统计。
+            threshold = args.itl_artifact_threshold
+            itl_artifacts = [value for value in all_itl if value < threshold]
+            itl_clean = [value for value in all_itl if value >= threshold]
+            round_medians = {}
+            for key in ("ttft_seconds", "tpot_avg_seconds",
+                        "decode_tokens_per_second", "e2e_tokens_per_second"):
+                medians = []
+                for round_index in range(args.rounds):
+                    values = [s[key] for s in samples
+                              if s["round"] == round_index and s[key] is not None]
+                    if values:
+                        medians.append(percentile(values, 0.5))
+                round_medians[key] = medians
+            discreteness = {}
+            for key, values in round_medians.items():
+                middle = percentile(values, 0.5) if values else None
+                discreteness[key] = ((max(values) - min(values)) / middle
+                                     if len(values) > 1 and middle else None)
+            entry = {
+                "id": prompt_id,
+                "seq_len": len(ids),
+                "prompt_token_ids": ids,
+                "rendered_text": rendered,
+                "max_tokens": args.max_tokens,
+                "generated_token_ids": samples[-1]["generated_token_ids"] if samples else None,
+                "samples": samples,
+                "stats": {
+                    "ttft_seconds": describe(collect("ttft_seconds")),
+                    "tpot_avg_seconds": describe(collect("tpot_avg_seconds")),
+                    "tpot_itl_seconds": describe(all_itl),
+                    "tpot_itl_trimmed_seconds": describe(itl_clean),
+                    "decode_tokens_per_second": describe(collect("decode_tokens_per_second")),
+                    "e2e_tokens_per_second": describe(collect("e2e_tokens_per_second")),
+                    "e2e_seconds": describe(collect("e2e_seconds")),
+                },
+                "itl_artifacts": {
+                    "threshold_seconds": threshold,
+                    "count": len(itl_artifacts),
+                    "total": len(all_itl),
+                    "note": ("末 token 交付伪影：低于阈值的 ITL 不参与 trimmed 统计；"
+                             "per-request 平均 TPOT（tpot_avg_seconds）不受其影响。"),
+                },
+                "round_medians": round_medians,
+                "round_median_discreteness": discreteness,
+            }
+            entry["stability"] = {
+                key: stability_flags(entry["stats"][key])
+                for key in ("ttft_seconds", "tpot_avg_seconds", "tpot_itl_seconds",
+                            "tpot_itl_trimmed_seconds",
+                            "decode_tokens_per_second", "e2e_tokens_per_second")
+            }
+            results.append(entry)
+            print("[perf] %s: ttft p50=%.4fs p95=%.4fs cv=%.3f | tpot_avg p50=%.4fs cv=%.3f "
+                  "| itl_raw cv=%.3f (artifacts %d) itl_trimmed cv=%.3f | decode tps p50=%.2f "
+                  "| round discreteness=%s" % (
+                      prompt_id,
+                      entry["stats"]["ttft_seconds"]["p50"], entry["stats"]["ttft_seconds"]["p95"],
+                      entry["stats"]["ttft_seconds"]["cv"],
+                      entry["stats"]["tpot_avg_seconds"]["p50"], entry["stats"]["tpot_avg_seconds"]["cv"],
+                      entry["stats"]["tpot_itl_seconds"]["cv"], len(itl_artifacts),
+                      entry["stats"]["tpot_itl_trimmed_seconds"]["cv"],
+                      entry["stats"]["decode_tokens_per_second"]["p50"],
+                      {k: (round(v, 4) if v is not None else None)
+                       for k, v in discreteness.items()}), flush=True)
+    finally:
+        engine.shutdown()
+
+    return {
+        "schema": "pypto-x.a2-vllm-ascend.perf.v1",
+        "generated_at": now_iso(),
+        "mode": "perf",
+        "engine": engine_args_dict(args),
+        "warmup": args.warmup,
+        "repeats": args.repeats,
+        "rounds": args.rounds,
+        "concurrency": 1,
+        "model_load_seconds": load_seconds,
+        "versions": versions(),
+        "protocol_note": (
+            "docs/PERF_MEASUREMENT_PROTOCOL.zh-CN.md 仍是提案；本文件是原始事实，"
+            "不是绝对门槛结论。TTFT/ITL 由 AsyncLLM 流式输出的 wall 时间戳给出；"
+            "若 chunk 含多 token，则该 chunk 的间隔均分给新增 token（chunk_sizes 已记录）。"
+            "测量为 batch=1/concurrency=1（串行发请求），故队列与调度开销已包含在 TTFT 内。"
+        ),
+        "prompts": results,
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--mode", choices=("accuracy", "perf"), required=True)
+    parser.add_argument("--model-dir", required=True)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--prompts", default="",
+                        help="逗号分隔的 prompt id；默认全部三个")
+    parser.add_argument("--max-tokens", type=int, default=DEFAULT_MAX_TOKENS)
+    parser.add_argument("--topk", type=int, default=5)
+    parser.add_argument("--dtype", default="bfloat16")
+    parser.add_argument("--tp", type=int, default=1)
+    parser.add_argument("--max-model-len", type=int, default=512)
+    parser.add_argument("--gpu-memory-utilization", type=float, default=0.35)
+    parser.add_argument("--enforce-eager", action="store_true", default=False)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--repeats", type=int, default=21)
+    parser.add_argument("--rounds", type=int, default=1,
+                        help="测量轮数（rounds x repeats；roadmap G2 建议 3 轮）")
+    parser.add_argument("--itl-artifact-threshold", type=float, default=0.005,
+                        help="低于该值的逐 token ITL 视为末 token 交付伪影（默认 5ms）")
+    args = parser.parse_args(argv)
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    if args.mode == "accuracy":
+        payload = run_accuracy(args)
+    else:
+        import asyncio
+        payload = asyncio.run(_perf_async(args))
+    with open(args.out, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, ensure_ascii=False, indent=1)
+    print("[done] wrote %s" % args.out, flush=True)
+
+
+if __name__ == "__main__":
+    main()
