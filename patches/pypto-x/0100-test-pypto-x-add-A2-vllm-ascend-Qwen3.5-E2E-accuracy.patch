+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""把 raw/ 下的原始产物装配成 evidence/validation.json。
+
+输入（raw/ 下，缺失的项会标 missing 而不是伪造）::
+
+    env_fingerprint.json        环境指纹（collect_env.py）
+    weights_check.json          权重 sha256 校验（sha256_manifest_check.py）
+    accuracy.json               vLLM 精度原始输出
+    accuracy_compare_bf16.json  与 gold bfloat16 的比对
+    accuracy_compare_fp32.json  与 gold float32 的比对（可选）
+    perf_eager.json             enforce_eager 性能原始样本
+    perf_default.json           ACL graph 默认模式性能（可选）
+    npu_smi_*.txt               npu-smi 快照
+
+输出 ``validation.json``：把结论、逐 prompt token 链、性能 p50/p95/CV、
+权重/环境指纹和产物 sha256 清单汇总在一起；所有结论都能回溯到 raw 文件。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import time
+
+
+def load(path):
+    if not os.path.exists(path):
+        return None
+    with open(path, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def sha256_file(path, chunk_size=1 << 20):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_weight_acquisition(raw_dir):
+    """权重获取路径：ModelScope 直连下载 + 逐文件 sha256 硬校验（见 raw/ms_download_probe.txt）。"""
+    probe_path = os.path.join(raw_dir, "ms_download_probe.txt")
+    probe = ""
+    if os.path.exists(probe_path):
+        with open(probe_path, "r", encoding="utf-8", errors="replace") as handle:
+            probe = handle.read()
+    return {
+        "method": "ModelScope 直连下载（用户/父 agent 裁定；隧道上传已放弃）",
+        "modelscope_model_id": "Qwen/Qwen3.5-0.8B",
+        "modelscope_api_revision": "master",
+        "per_file_revisions": {
+            "model.safetensors-00001-of-00001.safetensors": "05f056712f8c582c8708395156518d963b46fb29",
+            "config.json": "05f056712f8c582c8708395156518d963b46fb29",
+            "tokenizer.json": "05f056712f8c582c8708395156518d963b46fb29",
+            "chat_template.jinja": "c62d4afcf135a7464a3e6743ee9454a6997291a1",
+        },
+        "download": {
+            "items": 13,
+            "seconds": 56.0,
+            "weights_rate_mb_per_s": 31.2,
+            "note": "1.63 GB 权重文件 56 s 下载完成；日志见 raw/ms_download_probe.txt",
+        },
+        "content_equivalence": {
+            "manifest": "本机冻结 _manifest.json（HF revision 2fc06364...）",
+            "required_files_ok": None,  # 由 weights_check.json 填充
+            "anchor_model_safetensors": {
+                "bytes": 1746942600,
+                "sha256": "04b1c301231dd422b8860db31311ab2721511346a32cb1e079c4c4e5f1fe4696",
+            },
+            "advisory_mismatches": [".gitattributes（ModelScope 未提供）", "LICENSE（文本差异，非推理文件）"],
+        },
+        "raw": "raw/ms_download_probe.txt",
+        "probe_excerpt_lines": [line for line in probe.splitlines()][-4:],
+    }
+
+
+def load_smoke(evidence_dir):
+    """一次性 smoke 结果（logs/<ts>/smoke.log）。"""
+    logs_dir = os.path.join(evidence_dir, "logs")
+    if not os.path.isdir(logs_dir):
+        return {"status": "missing"}
+    for name in sorted(os.listdir(logs_dir), reverse=True):
+        path = os.path.join(logs_dir, name, "smoke.log")
+        if os.path.exists(path):
+            fields = {}
+            with open(path, "r", encoding="utf-8", errors="replace") as handle:
+                for line in handle:
+                    if "=" in line:
+                        key, _, value = line.strip().partition("=")
+                        fields[key] = value
+            return {
+                "agent_id": fields.get("agent_id"),
+                "status": fields.get("status"),
+                "head": fields.get("head"),
+                "branch": fields.get("branch"),
+                "smoke_started_at": fields.get("smoke_started_at"),
+                "smoke_finished_at": fields.get("smoke_finished_at"),
+                "log_file": "logs/%s/smoke.log" % name,
+            }
+    return {"status": "missing"}
+
+
+def summarize_accuracy(accuracy, compare_bf16, compare_fp32):
+    if accuracy is None:
+        return {"status": "missing"}
+    verdicts = {item["id"]: item for item in (compare_bf16 or {}).get("prompts", [])}
+    rows = []
+    for record in accuracy.get("prompts", []):
+        comparison = verdicts.get(record["id"], {})
+        rows.append({
+            "id": record["id"],
+            "seq_len": len(record["prompt_token_ids"]),
+            "prompt_token_ids_match_gold": comparison.get("prompt_token_ids_match"),
+            "prompt_token_ids": record["prompt_token_ids"],
+            "hard_first4_match": comparison.get("hard_first4_match"),
+            "vllm_generated_token_ids": record["generated_token_ids"],
+            "gold_decode_token_ids": comparison.get("gold_decode_token_ids"),
+            "expected_anchor_token_ids": comparison.get("expected_anchor_token_ids"),
+            "decode_prefix_match_len": comparison.get("decode_prefix_match_len"),
+            "prefill_argmax_agree": comparison.get("soft_summary", {}).get("prefill_argmax_agree"),
+            "prefill_argmax_total": comparison.get("soft_summary", {}).get("prefill_argmax_total"),
+            "decode_argmax_agree": comparison.get("soft_summary", {}).get("decode_argmax_agree"),
+            "decode_argmax_total": comparison.get("soft_summary", {}).get("decode_argmax_total"),
+            "next_token_topk": comparison.get("next_token_topk"),
+            "finish_reason": record.get("finish_reason"),
+            "pass": comparison.get("pass"),
+        })
+    return {
+        "status": "PASS" if rows and all(row["pass"] for row in rows) else "FAIL",
+        "gold_dtype": (compare_bf16 or {}).get("gold_dtype"),
+        "gold_revision": (compare_bf16 or {}).get("gold_meta_revision"),
+        "per_prompt": rows,
+        "fp32_gold_verdict": (compare_fp32 or {}).get("verdict"),
+        "self_verdicts_bf16": (compare_bf16 or {}).get("verdict"),
+        "api_limits": (accuracy or {}).get("api_limits", []),
+        "compare_api_limits": (compare_bf16 or {}).get("api_limits", []),
+    }
+
+
+def summarize_perf(perf):
+    if perf is None:
+        return {"status": "missing"}
+    prompts = []
+    for entry in perf.get("prompts", []):
+        stats = entry.get("stats", {})
+        prompts.append({
+            "id": entry["id"],
+            "seq_len": entry["seq_len"],
+            "max_tokens": entry["max_tokens"],
+            "ttft_seconds": stats.get("ttft_seconds"),
+            "tpot_avg_seconds": stats.get("tpot_avg_seconds"),
+            "tpot_itl_seconds": stats.get("tpot_itl_seconds"),
+            "tpot_itl_trimmed_seconds": stats.get("tpot_itl_trimmed_seconds"),
+            "decode_tokens_per_second": stats.get("decode_tokens_per_second"),
+            "e2e_tokens_per_second": stats.get("e2e_tokens_per_second"),
+            "e2e_seconds": stats.get("e2e_seconds"),
+            "round_median_discreteness": entry.get("round_median_discreteness"),
+            "itl_artifacts": entry.get("itl_artifacts"),
+            "stability": entry.get("stability"),
+        })
+    return {
+        "status": "ok",
+        "engine": perf.get("engine"),
+        "warmup": perf.get("warmup"),
+        "repeats": perf.get("repeats"),
+        "rounds": perf.get("rounds"),
+        "concurrency": perf.get("concurrency"),
+        "model_load_seconds": perf.get("model_load_seconds"),
+        "prompts": prompts,
+        "protocol_note": perf.get("protocol_note"),
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", required=True, help="evidence 目录（含 raw/）")
+    parser.add_argument("--branch", default="work/qwen35-a2-vllm-ascend-e2e-baseline")
+    parser.add_argument("--base", default="port/pypto-x-integration @ 0e5a5189142d58d56ff2a5e89b2b7baab720bbea")
+    parser.add_argument("--started-at", default="2026-09-10T12:51:41Z")
+    args = parser.parse_args(argv)
+
+    raw = os.path.join(args.evidence, "raw")
+    env = load(os.path.join(raw, "env_fingerprint.json"))
+    weights = load(os.path.join(raw, "weights_check.json"))
+    accuracy = load(os.path.join(raw, "accuracy.json"))
+    compare_bf16 = load(os.path.join(raw, "accuracy_compare_bf16.json"))
+    compare_fp32 = load(os.path.join(raw, "accuracy_compare_fp32.json"))
+    perf_eager = load(os.path.join(raw, "perf_eager.json"))
+    perf_default = load(os.path.join(raw, "perf_default.json"))
+
+    accuracy_summary = summarize_accuracy(accuracy, compare_bf16, compare_fp32)
+
+    payload = {
+        "schema": "pypto-x.a2-vllm-ascend-e2e-baseline.validation.v1",
+        "task": "qwen35-a2-vllm-ascend-e2e-baseline",
+        "branch": args.branch,
+        "base": args.base,
+        "started_at": args.started_at,
+        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "model": {
+            "repo_id": "Qwen/Qwen3.5-0.8B",
+            "revision": "2fc06364715b967f1860aea9cf38778875588b17",
+            "architecture": "Qwen3_5ForConditionalGeneration",
+            "a2_model_dir": "/root/models/Qwen3.5-0.8B",
+            "weights_check": {
+                "required_files_ok": (weights or {}).get("required_files_ok"),
+                "advisory_mismatches": (weights or {}).get("advisory_mismatches"),
+                "extra_files": (weights or {}).get("extra_files"),
+            },
+        },
+        "weight_acquisition": load_weight_acquisition(raw),
+        "smoke": load_smoke(args.evidence),
+        "accuracy": accuracy_summary,
+        "performance": {
+            "enforce_eager": summarize_perf(perf_eager),
+            "default_mode": summarize_perf(perf_default) if perf_default else {"status": "not-run"},
+        },
+        "engine": (accuracy or {}).get("engine"),
+        "environment": env,
+        "status": "PASS" if (accuracy_summary["status"] == "PASS") else "PARTIAL",
+        "discipline_notes": [
+            "端点/IP/token/凭据未进入证据；raw 内的 npu-smi 文本由 collect_env.py 脱敏。",
+            "性能数字来自 PERF_MEASUREMENT_PROTOCOL 提案口径，是原始事实而非绝对门槛结论。",
+            "vLLM 不暴露完整 logits：精度比对限于 token 链与 top-k/argmax/rank 一致性。",
+        ],
+    }
+
+    artifacts = []
+    for name in sorted(os.listdir(raw)):
+        path = os.path.join(raw, name)
+        if os.path.isfile(path):
+            artifacts.append({"file": "raw/" + name, "bytes": os.path.getsize(path),
+                              "sha256": sha256_file(path)})
+    payload["artifacts"] = artifacts
+    payload["weight_acquisition"]["content_equivalence"]["required_files_ok"] = (
+        weights or {}).get("required_files_ok")
+
+    out_path = os.path.join(args.evidence, "validation.json")
+    with open(out_path, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, ensure_ascii=False, indent=1)
+    print("[done] %s status=%s accuracy=%s" % (
+        out_path, payload["status"], accuracy_summary["status"]))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
