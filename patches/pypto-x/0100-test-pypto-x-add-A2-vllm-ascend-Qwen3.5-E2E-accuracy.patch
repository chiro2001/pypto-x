+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""采集 A2(910B3) 环境指纹，供性能基线证据引用。
+
+采集内容：python/torch/torch_npu/vllm/vllm_ascend/transformers/numpy 版本、
+CANN 与 driver 版本文件、npu-smi 快照、torch.npu 设备信息、CPU/内存。
+输出做了脱敏：IP 一律替换为 <redacted-ip>，不写任何凭据/端口。
+"""
+
+import argparse
+import glob
+import json
+import os
+import platform
+import re
+import subprocess
+import sys
+
+IP_PATTERN = re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}\b")
+
+
+def sanitize(text):
+    return IP_PATTERN.sub("<redacted-ip>", text)
+
+
+def run(command, timeout=60):
+    try:
+        completed = subprocess.run(command, shell=True, capture_output=True,
+                                   text=True, timeout=timeout)
+        return {
+            "command": command,
+            "returncode": completed.returncode,
+            "stdout": sanitize(completed.stdout.strip()),
+            "stderr": sanitize(completed.stderr.strip()),
+        }
+    except Exception as error:  # pragma: no cover - 诊断路径
+        return {"command": command, "returncode": None, "error": str(error)}
+
+
+def read_file(path, limit=80):
+    try:
+        with open(path, "r", encoding="utf-8", errors="replace") as handle:
+            lines = [next(handle) for _ in range(limit)]
+        return sanitize("".join(lines).strip())
+    except Exception:
+        return None
+
+
+def collect_versions():
+    info = {"python": sys.version, "platform": platform.platform()}
+    for module in ("torch", "torch_npu", "vllm", "vllm_ascend", "transformers",
+                   "numpy", "triton", "triton_ascend"):
+        try:
+            imported = __import__(module)
+            info[module] = getattr(imported, "__version__", "unknown")
+        except Exception as error:
+            info[module] = "import-failed: %s" % error
+    return info
+
+
+def collect_cann():
+    candidates = [
+        "/usr/local/Ascend/ascend-toolkit/latest/version.cfg",
+        "/usr/local/Ascend/ascend-toolkit/latest/ascend_toolkit_install.info",
+        "/usr/local/Ascend/latest/version.cfg",
+        "/usr/local/Ascend/driver/version.info",
+        "/etc/ascend_install.info",
+    ]
+    candidates.extend(sorted(glob.glob("/usr/local/Ascend/*/version.info")))
+    found = {}
+    for path in candidates:
+        content = read_file(path)
+        if content:
+            found[path] = content
+    return {
+        "toolkit_env": os.environ.get("ASCEND_TOOLKIT_HOME", ""),
+        "version_files": found,
+        "set_env_present": os.path.exists("/usr/local/Ascend/ascend-toolkit/set_env.sh"),
+    }
+
+
+def collect_device():
+    info = {}
+    try:
+        import torch
+        import torch_npu  # noqa: F401
+        info["npu_is_available"] = bool(torch.npu.is_available())
+        info["npu_device_count"] = int(torch.npu.device_count())
+        if torch.npu.is_available():
+            info["npu_device_name"] = torch.npu.get_device_name(0)
+    except Exception as error:
+        info["error"] = str(error)
+    info["npu_smi"] = run("npu-smi info", timeout=60)
+    return info
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args(argv)
+
+    payload = {
+        "schema": "pypto-x.a2-vllm-ascend.env-fingerprint.v1",
+        "generated_at": __import__("time").strftime("%Y-%m-%dT%H:%M:%SZ", __import__("time").gmtime()),
+        "hostname": platform.node(),
+        "versions": collect_versions(),
+        "cann": collect_cann(),
+        "device": collect_device(),
+        "cpu": {
+            "nproc": os.cpu_count(),
+            "loadavg": list(os.getloadavg()),
+        },
+        "memory": run("free -m", timeout=30),
+        "os_release": read_file("/etc/os-release"),
+        "relevant_env": {key: value for key, value in sorted(os.environ.items())
+                         if key.startswith(("ASCEND", "CANN", "VLLM", "TORCH", "HF_", "LD_LIBRARY"))},
+    }
+    text = json.dumps(payload, ensure_ascii=False, indent=1)
+    with open(args.out, "w", encoding="utf-8") as handle:
+        handle.write(text)
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/a2_vllm_ascend/compare_gold.py b/tools/a2_vllm_ascend/compare_gold.py
