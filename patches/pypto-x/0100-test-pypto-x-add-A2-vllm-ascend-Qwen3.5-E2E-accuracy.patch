index 000000000..bce0b2782
--- /dev/null
+++ b/tools/a2_vllm_ascend/sanitize_evidence.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""证据脱敏：把 raw/ 下文本里的端点 IP 换成 <redacted-ip>，保持 JSON 合法。
+
+规则：
+1. 删除 ssh 客户端噪声行（包含 "Permanently added"）；
+2. 保留 OS 内核版本串（如 Linux-5.10.0-216.0.0.115.oe2203sp4）——不是端点；
+3. 其余 IPv4 字面量一律替换为 <redacted-ip>；
+4. 只处理 .json/.txt/.log/.md，原地写回并打印替换统计。
+
+用法::
+
+    python sanitize_evidence.py --dir <evidence>/raw
+"""
+
+import argparse
+import json
+import os
+import re
+
+IP_PATTERN = re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}\b")
+# 形如 5.10.0-216.0.0.115.oe2203sp4 的内核版本串，整体保护
+KERNEL_PATTERN = re.compile(r"\b\d+\.\d+\.\d+-\d+(?:\.\d+){2,}\.[A-Za-z0-9._-]+\b")
+TEXT_SUFFIXES = (".json", ".txt", ".log", ".md")
+
+
+def sanitize_text(text):
+    removed = 0
+    kept_lines = []
+    for line in text.splitlines(keepends=True):
+        if "Permanently added" in line:
+            removed += 1
+            continue
+        kept_lines.append(line)
+    text = "".join(kept_lines)
+
+    protected = []
+
+    def stash(match):
+        protected.append(match.group(0))
+        return "@@KERNEL%d@@" % (len(protected) - 1)
+
+    text = KERNEL_PATTERN.sub(stash, text)
+    replacements = len(IP_PATTERN.findall(text))
+    text = IP_PATTERN.sub("<redacted-ip>", text)
+    for index, original in enumerate(protected):
+        text = text.replace("@@KERNEL%d@@" % index, original)
+    return text, replacements, removed
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dir", required=True)
+    args = parser.parse_args(argv)
+
+    total_files = 0
+    total_ips = 0
+    total_lines = 0
+    for name in sorted(os.listdir(args.dir)):
+        path = os.path.join(args.dir, name)
+        if not os.path.isfile(path) or not name.endswith(TEXT_SUFFIXES):
+            continue
+        with open(path, "r", encoding="utf-8", errors="replace") as handle:
+            text = handle.read()
+        cleaned, ips, lines = sanitize_text(text)
+        if cleaned != text:
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write(cleaned)
+        total_files += 1
+        total_ips += ips
+        total_lines += lines
+        if ips or lines:
+            print("[sanitize] %s ip>=%d lines_removed=%d" % (name, ips, lines))
+        if name.endswith(".json"):
+            try:
+                json.loads(cleaned)
+            except Exception as error:  # pragma: no cover - 保护性检查
+                raise SystemExit("sanitize 破坏了 JSON: %s: %s" % (name, error))
+    print("[done] files=%d redacted_ips=%d removed_lines=%d" % (
+        total_files, total_ips, total_lines))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/a2_vllm_ascend/sha256_manifest_check.py b/tools/a2_vllm_ascend/sha256_manifest_check.py
new file mode 100644
index 000000000..8ae42c88a
--- /dev/null
+++ b/tools/a2_vllm_ascend/sha256_manifest_check.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""按冻结 _manifest.json 校验 A2 上的模型目录（sha256 与字节数逐文件比对）。
+
+用法::
+
+    python sha256_manifest_check.py --dir /root/models/Qwen3.5-0.8B \
+        --manifest .../2fc06.../_manifest.json --out check.json
+
+必需文件（推理直接依赖）任一不符 → 退出码 1。非必需文件（README/LICENSE/
+.gitattributes）单独标注为 advisory 差异，不阻断推理但必须如实报告。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+REQUIRED_FILES = (
+    "config.json",
+    "tokenizer.json",
+    "tokenizer_config.json",
+    "vocab.json",
+    "merges.txt",
+    "chat_template.jinja",
+    "model.safetensors-00001-of-00001.safetensors",
+    "model.safetensors.index.json",
+    "preprocessor_config.json",
+    "video_preprocessor_config.json",
+)
+
+
+def sha256_file(path, chunk_size=1 << 22):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dir", required=True)
+    parser.add_argument("--manifest", required=True)
+    parser.add_argument("--out", default="")
+    args = parser.parse_args(argv)
+
+    with open(args.manifest, "r", encoding="utf-8") as handle:
+        manifest = json.load(handle)
+
+    entries = []
+    required_ok = True
+    for name, expected in sorted(manifest["files"].items()):
+        path = os.path.join(args.dir, name)
+        required = name in REQUIRED_FILES
+        if not os.path.exists(path):
+            entries.append({"file": name, "required": required, "status": "missing"})
+            if required:
+                required_ok = False
+            continue
+        actual_bytes = os.path.getsize(path)
+        actual_sha = sha256_file(path)
+        matches = (actual_bytes == expected["bytes"]) and (actual_sha == expected["sha256"])
+        entries.append({
+            "file": name,
+            "required": required,
+            "status": "match" if matches else "mismatch",
+            "expected_bytes": expected["bytes"],
+            "actual_bytes": actual_bytes,
+            "expected_sha256": expected["sha256"],
+            "actual_sha256": actual_sha,
+        })
+        if required and not matches:
+            required_ok = False
+        print("[%s] %s bytes=%d sha=%s" % (
+            "OK " if matches else "BAD", name, actual_bytes, actual_sha[:16]), flush=True)
+
+    extra = []
+    known = set(manifest["files"])
+    for name in sorted(os.listdir(args.dir)):
+        if name not in known:
+            extra.append(name)
+
+    payload = {
+        "schema": "pypto-x.a2-vllm-ascend.weights-check.v1",
+        "dir": os.path.abspath(args.dir),
+        "manifest": os.path.abspath(args.manifest),
+        "manifest_revision": manifest.get("revision"),
+        "manifest_repo_id": manifest.get("repo_id"),
+        "entries": entries,
+        "extra_files": extra,
+        "required_files_ok": required_ok,
+        "advisory_mismatches": [item["file"] for item in entries
+                                if item["status"] != "match" and not item["required"]],
+    }
+    text = json.dumps(payload, ensure_ascii=False, indent=1)
+    if args.out:
+        with open(args.out, "w", encoding="utf-8") as handle:
+            handle.write(text)
+    print(text)
+    return 0 if required_ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
