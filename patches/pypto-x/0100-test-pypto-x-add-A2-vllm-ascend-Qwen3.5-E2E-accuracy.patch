index 000000000..aae0a13cb
--- /dev/null
+++ b/tools/a2_vllm_ascend/compare_gold.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""把 vllm-ascend 的 accuracy.json 与冻结 gold 参考逐项比对。
+
+gold 参考目录布局（``_meta/pypto-x/qwen35-bf16-reference/reference/``）::
+
+    ids.json                 prompt 文本与 forward_ids
+    meta.json                生成环境与逐 prompt decode_token_ids
+    bfloat16/<id>.npz        input_ids / prefill_logits / prefill_next_logits
+                             / decode_logits / decode_token_ids
+    float32/<id>.npz         同上（用于噪声底对照）
+
+对齐口径（与 docs/00-handoffs/ERRATA、roadmap §6 一致）：
+
+* prompt token 序列必须与 gold ``forward_ids`` / npz ``input_ids`` 完全一致；
+* vLLM ``decode_step_logprobs[k]`` ↔ gold ``decode_logits[k]``（同一"预测第 k 个生成 token"分布）；
+* vLLM ``prompt_logprobs[i]`` ↔ gold ``prefill_logits[i-1]``（i>=1）；
+* 最后一个 prompt 位置的分布 ↔ gold ``prefill_next_logits``（== decode_logits[0]）。
+
+vLLM 只给 top-k logprobs，没有完整 logits，所以这里只能做
+argmax / top-k token 集合 / chosen rank 一致性，不能算 cosine 与 max_abs——
+证据里必须如实标注这一点，不得伪造 logits 对比。
+
+硬判据（任务书）：前 4 个生成 token 与 gold ``decode_token_ids`` 一致。
+"""
+
+import argparse
+import json
+import os
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from prompts import EXPECTED_DECODE_IDS, PROMPTS  # noqa: E402
+
+
+def load_json(path):
+    with open(path, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def topk_ids(row, k):
+    order = np.argsort(-np.asarray(row, dtype=np.float64))
+    return [int(token) for token in order[:k]]
+
+
+def rank_of(row, token):
+    array = np.asarray(row, dtype=np.float64)
+    order = np.argsort(-array)
+    positions = np.nonzero(order == int(token))[0]
+    return int(positions[0]) + 1 if len(positions) else None
+
+
+def compare_one(record, gold, topk):
+    prompt_id = record["id"]
+    result = {"id": prompt_id}
+
+    gold_input_ids = [int(token) for token in gold["input_ids"].tolist()]
+    vllm_prompt_ids = [int(token) for token in record["prompt_token_ids"]]
+    result["prompt_token_ids_match"] = vllm_prompt_ids == gold_input_ids
+    result["prompt_token_ids"] = vllm_prompt_ids
+    result["gold_prompt_token_ids"] = gold_input_ids
+
+    gold_decode = [int(token) for token in gold["decode_token_ids"].tolist()]
+    generated = [int(token) for token in record["generated_token_ids"]]
+    prefix = 0
+    for index, token in enumerate(gold_decode):
+        if index < len(generated) and generated[index] == token:
+            prefix += 1
+        else:
+            break
+    hard_first4 = generated[:4] == gold_decode[:4] == EXPECTED_DECODE_IDS.get(prompt_id)
+    result["gold_decode_token_ids"] = gold_decode
+    result["vllm_generated_token_ids"] = generated
+    result["expected_anchor_token_ids"] = EXPECTED_DECODE_IDS.get(prompt_id)
+    result["decode_prefix_match_len"] = prefix
+    result["hard_first4_match"] = bool(hard_first4)
+    result["anchor_matches_gold"] = bool(
+        EXPECTED_DECODE_IDS.get(prompt_id) == gold_decode[:4])
+
+    # 逐个 decode step：vLLM top-1 vs gold argmax，chosen rank 对照
+    decode_rows = []
+    vllm_decode = record.get("decode_step_logprobs") or []
+    n_steps = min(len(gold_decode), len(vllm_decode))
+    for step in range(n_steps):
+        row = gold["decode_logits"][step]
+        gold_argmax = int(np.argmax(row))
+        entry = vllm_decode[step]
+        vllm_top1 = entry["topk"][0][0] if entry.get("topk") else None
+        decode_rows.append({
+            "step": step,
+            "gold_argmax": gold_argmax,
+            "vllm_top1": vllm_top1,
+            "argmax_match": gold_argmax == vllm_top1,
+            "gold_chosen_rank": rank_of(row, gold_decode[step]),
+            "vllm_chosen_rank": entry.get("chosen_rank"),
+            "vllm_topk_ids": [item[0] for item in (entry.get("topk") or [])],
+            "gold_topk_ids": topk_ids(row, topk),
+        })
+    result["decode_argmax_rows"] = decode_rows
+    result["decode_argmax_agree"] = sum(1 for row in decode_rows if row["argmax_match"])
+
+    # prefill：位置 i 的分布 ↔ gold prefill_logits[i-1]
+    prefill_rows = []
+    vllm_prefill = record.get("prompt_logprobs") or []
+    for index in range(1, min(len(gold_input_ids), len(vllm_prefill))):
+        if index - 1 >= gold["prefill_logits"].shape[0]:
+            break
+        row = gold["prefill_logits"][index - 1]
+        entry = vllm_prefill[index]
+        vllm_top1 = entry["topk"][0][0] if entry.get("topk") else None
+        prefill_rows.append({
+            "pos": index,
+            "gold_argmax": int(np.argmax(row)),
+            "vllm_top1": vllm_top1,
+            "argmax_match": int(np.argmax(row)) == vllm_top1,
+            "gold_chosen_rank": rank_of(row, gold_input_ids[index]),
+            "vllm_chosen_rank": entry.get("chosen_rank"),
+        })
+    result["prefill_argmax_rows"] = prefill_rows
+    result["prefill_argmax_agree"] = sum(1 for row in prefill_rows if row["argmax_match"])
+
+    # 下一 token（prefill 末行）的分布：vLLM 的 prompt_logprobs 只有 len(prompt)
+    # 项、且第 i 项是 "给定 <i 预测 token i" 的概率，不含末行之后的分布；
+    # 该分布由第 0 步 decode logprobs 给出（与 gold decode_logits[0] 同源）。
+    if record.get("decode_step_logprobs"):
+        first_step = record["decode_step_logprobs"][0]
+        next_row = gold["prefill_next_logits"]
+        gold_top = topk_ids(next_row, topk)
+        vllm_top = [item[0] for item in (first_step.get("topk") or [])]
+        result["next_token_topk"] = {
+            "k": topk,
+            "source": "vllm decode_step_logprobs[0] (prefill 末行的下一 token 分布)",
+            "gold_topk_ids": gold_top,
+            "vllm_topk_ids": vllm_top,
+            "argmax_match": gold_top[0] == (vllm_top[0] if vllm_top else None),
+            "topk_set_equal_as_sets": set(gold_top) == set(vllm_top),
+            "gold_next_argmax": gold_top[0],
+            "vllm_next_argmax": vllm_top[0] if vllm_top else None,
+            "gold_first_decode_token": gold_decode[0] if gold_decode else None,
+            "gold_rank_of_first_decode": rank_of(next_row, gold_decode[0]) if gold_decode else None,
+            "vllm_chosen_rank": first_step.get("chosen_rank"),
+        }
+    result["gold_prefill_next_equals_decode0"] = bool(
+        np.allclose(gold["prefill_next_logits"], gold["decode_logits"][0]))
+
+    result["pass"] = bool(result["prompt_token_ids_match"] and result["hard_first4_match"])
+    result["soft_summary"] = {
+        "decode_argmax_agree": result["decode_argmax_agree"],
+        "decode_argmax_total": len(decode_rows),
+        "prefill_argmax_agree": result["prefill_argmax_agree"],
+        "prefill_argmax_total": len(prefill_rows),
+    }
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--accuracy", required=True, help="accuracy.json 路径")
+    parser.add_argument("--gold-dir", required=True, help="reference/ 目录")
+    parser.add_argument("--dtype", default="bfloat16", choices=("bfloat16", "float32"))
+    parser.add_argument("--topk", type=int, default=5)
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args(argv)
+
+    accuracy = load_json(args.accuracy)
+    ids_meta = load_json(os.path.join(args.gold_dir, "ids.json"))
+    meta = load_json(os.path.join(args.gold_dir, "meta.json"))
+    by_id = {item["id"]: item for item in ids_meta["prompts"]}
+
+    comparisons = []
+    for record in accuracy["prompts"]:
+        prompt_id = record["id"]
+        npz_path = os.path.join(args.gold_dir, args.dtype, prompt_id + ".npz")
+        gold = np.load(npz_path)
+        comparison = compare_one(record, gold, args.topk)
+        expected = by_id.get(prompt_id)
+        if expected is not None:
+            comparison["gold_ids_json_forward_ids"] = expected["forward_ids"]
+            comparison["forward_ids_match"] = (
+                record["prompt_token_ids"] == expected["forward_ids"])
+        comparisons.append(comparison)
+        print("[compare] %s hard_first4=%s prompt_ids=%s prefill_argmax=%d/%d decode_argmax=%d/%d" % (
+            prompt_id, comparison["hard_first4_match"], comparison["prompt_token_ids_match"],
+            comparison["soft_summary"]["prefill_argmax_agree"],
+            comparison["soft_summary"]["prefill_argmax_total"],
+            comparison["soft_summary"]["decode_argmax_agree"],
+            comparison["soft_summary"]["decode_argmax_total"]), flush=True)
+
+    payload = {
+        "schema": "pypto-x.a2-vllm-ascend.accuracy-compare.v1",
+        "accuracy_json": os.path.abspath(args.accuracy),
+        "gold_dir": os.path.abspath(args.gold_dir),
+        "gold_dtype": args.dtype,
+        "gold_meta_revision": meta.get("revision"),
+        "gold_meta_generated_at": meta.get("generated_at"),
+        "topk": args.topk,
+        "prompts": comparisons,
+        "verdict": "PASS" if all(item["pass"] for item in comparisons) else "FAIL",
+        "api_limits": [
+            "vLLM 只能给 top-%d logprobs（无完整 logits / log_softmax），" % args.topk,
+            "因此 prefill/decode 只能按 argmax/top-k token id 集合与 chosen rank 比对，",
+            "不能计算 cosine 或 max_abs；完整 logits 对齐由 gold 侧与 PyPTO-X 任务覆盖。",
+        ],
+    }
+    with open(args.out, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, ensure_ascii=False, indent=1)
+    print("[done] verdict=%s wrote %s" % (payload["verdict"], args.out), flush=True)
+
+
+if __name__ == "__main__":
+    main()
