+def resolved_protocol() -> Dict[str, Any]:
+    """返回按环境变量覆盖路径字段后的 protocol 记录。
+
+    可覆盖项：
+    * ``PYPTO_X_QWEN35_WEIGHTED_WORKTREE`` -> ``worktree``
+    * ``PYPTO_X_RESOURCE_LOCK_ROOT`` -> ``resource_lock_root``
+    * ``PYPTO_X_LOCAL_HEAVY_RUNNER`` -> ``local_heavy_runner``
+
+    未设置环境变量时返回值与 ``PROTOCOL`` 完全一致（向后兼容）。
+    """
+    protocol = dict(PROTOCOL)
+    protocol["worktree"] = os.environ.get(
+        "PYPTO_X_QWEN35_WEIGHTED_WORKTREE", protocol["worktree"]
+    )
+    protocol["resource_lock_root"] = os.environ.get(
+        "PYPTO_X_RESOURCE_LOCK_ROOT", protocol["resource_lock_root"]
+    )
+    protocol["local_heavy_runner"] = os.environ.get(
+        "PYPTO_X_LOCAL_HEAVY_RUNNER", protocol["local_heavy_runner"]
+    )
+    return protocol
