+"""W8G qwen35 可移植性清理的聚焦回归测试（不依赖 torch / NPU / 资源锁）。
+
+覆盖本任务三项范围：
+
+* ``tools/qwen35_reference``：``--assets-dir`` / ``PYPTO_X_QWEN35_ASSETS_DIR``
+  覆盖生效，且脚本内只保留带标记的 fallback 常量（默认行为不变）；
+* ``python/tests/ut/pypto_x/qwen35_weighted_execution_evidence.py``：
+  protocol 路径字段与 resource-usage 日志源可经环境变量 / ``--resource-usage-dir``
+  覆盖；
+* ``tools/cann/install_cann_toolkit_local.sh``：``--meta-root`` /
+  ``--heavy-runner`` / ``--hwhiaiuser-home`` 与环境变量覆盖生效
+  （``--stage shim`` 轻量阶段真跑，不用 sudo、不下载、不装包）。
+
+同时执行「范围内文件不得出现未标记 home 绝对路径」的静态守卫。
+"""
+
+from __future__ import annotations
+
+import ast
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import types
+
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[4]
+REFERENCE_DIR = REPOSITORY_ROOT / "tools" / "qwen35_reference"
+EVIDENCE_MODULE = (
+    REPOSITORY_ROOT / "python" / "tests" / "ut" / "pypto_x"
+    / "qwen35_weighted_execution_evidence.py"
+)
+CANN_SCRIPT = REPOSITORY_ROOT / "tools" / "cann" / "install_cann_toolkit_local.sh"
+
+ASSETS_ENV = "PYPTO_X_QWEN35_ASSETS_DIR"
+WORKTREE_ENV = "PYPTO_X_QWEN35_WEIGHTED_WORKTREE"
+LOCK_ROOT_ENV = "PYPTO_X_RESOURCE_LOCK_ROOT"
+HEAVY_RUNNER_ENV = "PYPTO_X_LOCAL_HEAVY_RUNNER"
+RESOURCE_USAGE_ENV = "PYPTO_X_RESOURCE_USAGE_DIR"
+
+#: 静态守卫用；拼接构造以免本测试文件自身触发 home 路径守卫。
+_HOME_NEEDLE = "/" + "home/"
+
+SCOPE_FILES = (
+    REFERENCE_DIR / "run_reference.py",
+    REFERENCE_DIR / "inspect_loading.py",
+    REFERENCE_DIR / "setup_venv.sh",
+    REFERENCE_DIR / "README.zh-CN.md",
+    EVIDENCE_MODULE,
+    CANN_SCRIPT,
+    Path(__file__),
+)
+
+
+def _load_module(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _load_reference_module(script_name: str):
+    """加载 tools/qwen35_reference 下的脚本；无 torch 时注入空 stub（只读常量）。"""
+    inserted = False
+    if importlib.util.find_spec("torch") is None:
+        sys.modules["torch"] = types.ModuleType("torch")
+        inserted = True
+    try:
+        return _load_module(
+            REFERENCE_DIR / script_name,
+            "portability_" + script_name.replace(".", "_"),
+        )
+    finally:
+        if inserted:
+            sys.modules.pop("torch", None)
+
+
+def _load_evidence_module():
+    return _load_module(EVIDENCE_MODULE, "portability_qwen35_weighted_execution_evidence")
+
+
+def _run_cann(*args: str, env=None):
+    return subprocess.run(
+        ["bash", str(CANN_SCRIPT), *args],
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        check=False,
+    )
+
+
+def _clean_env_without_pypto_x() -> dict:
+    return {key: value for key, value in os.environ.items()
+            if not key.startswith("PYPTO_X_")}
+
+
+def test_scope_files_have_no_bare_home_paths():
+    """范围内文件里的 home 绝对路径只允许出现在显式标记的 fallback 行。"""
+    offenders = []
+    fallback_continuation = 0
+    for path in SCOPE_FILES:
+        fallback_continuation = 0
+        text = path.read_text(encoding="utf-8")
+        for lineno, line in enumerate(text.splitlines(), 1):
+            if "_FALLBACK_" in line:
+                # fallback 常量允许跨行字符串：赋值行 + 后续 2 行续行。
+                fallback_continuation = 2
+            if _HOME_NEEDLE in line and not (
+                "PYPTO_X_" in line
+                or "_FALLBACK_" in line
+                or fallback_continuation > 0
+            ):
+                offenders.append("%s:%d: %s" % (path.relative_to(REPOSITORY_ROOT),
+                                                lineno, line.strip()))
+            if fallback_continuation > 0:
+                fallback_continuation -= 1
+    assert not offenders, "未标记的 home 绝对路径硬编码：\n" + "\n".join(offenders)
+
+    for path in (REFERENCE_DIR / "README.zh-CN.md", REFERENCE_DIR / "setup_venv.sh"):
+        assert _HOME_NEEDLE not in path.read_text(encoding="utf-8")
+
+
+def test_reference_scripts_parse_under_python37():
+    for name in ("run_reference.py", "inspect_loading.py"):
+        source = (REFERENCE_DIR / name).read_text(encoding="utf-8")
+        ast.parse(source, filename=name, feature_version=(3, 7))
+
+
+def test_run_reference_assets_dir_env_and_cli_override(monkeypatch):
+    monkeypatch.delenv(ASSETS_ENV, raising=False)
+    module = _load_reference_module("run_reference.py")
+    fallback = module._FALLBACK_ASSETS_DIR
+    assert fallback.startswith("/")
+    assert module.DEFAULT_ASSETS_DIR == fallback
+    assert module.parse_args(["--out-dir", "/tmp/out"]).assets_dir == fallback
+    assert module.parse_args(
+        ["--out-dir", "/tmp/out", "--assets-dir", "/tmp/cli-assets"]
+    ).assets_dir == "/tmp/cli-assets"
+
+    monkeypatch.setenv(ASSETS_ENV, "/tmp/env-assets")
+    module = _load_reference_module("run_reference.py")
+    assert module.DEFAULT_ASSETS_DIR == "/tmp/env-assets"
+    assert module.parse_args(["--out-dir", "/tmp/out"]).assets_dir == "/tmp/env-assets"
+
+
+def test_inspect_loading_assets_dir_env_override(monkeypatch):
+    monkeypatch.delenv(ASSETS_ENV, raising=False)
+    module = _load_reference_module("inspect_loading.py")
+    assert module.DEFAULT_ASSETS_DIR == module._FALLBACK_ASSETS_DIR
+
+    monkeypatch.setenv(ASSETS_ENV, "/tmp/env-assets")
+    module = _load_reference_module("inspect_loading.py")
+    assert module.DEFAULT_ASSETS_DIR == "/tmp/env-assets"
+
+
+def test_evidence_protocol_env_override_and_defaults(monkeypatch):
+    for name in (WORKTREE_ENV, LOCK_ROOT_ENV, HEAVY_RUNNER_ENV):
+        monkeypatch.delenv(name, raising=False)
+    module = _load_evidence_module()
+    assert module.resolved_protocol() == module.PROTOCOL
+    assert module.PROTOCOL["worktree"] == module._FALLBACK_WORKTREE
+
+    monkeypatch.setenv(WORKTREE_ENV, "/tmp/weighted-worktree")
+    monkeypatch.setenv(LOCK_ROOT_ENV, "/tmp/resource-locks")
+    monkeypatch.setenv(HEAVY_RUNNER_ENV, "/tmp/run_local_heavy.sh")
+    protocol = module.resolved_protocol()
+    assert protocol["worktree"] == "/tmp/weighted-worktree"
+    assert protocol["resource_lock_root"] == "/tmp/resource-locks"
+    assert protocol["local_heavy_runner"] == "/tmp/run_local_heavy.sh"
+    assert protocol["task_name"] == module.PROTOCOL["task_name"]
+
+
+def test_evidence_build_resource_usage_override(tmp_path, monkeypatch):
+    for name in (WORKTREE_ENV, LOCK_ROOT_ENV, HEAVY_RUNNER_ENV, RESOURCE_USAGE_ENV):
+        monkeypatch.delenv(name, raising=False)
+    module = _load_evidence_module()
+    evidence = tmp_path / "evidence"
+    evidence.mkdir()
+    resource_usage = tmp_path / "resource-usage"
+    resource_usage.mkdir()
+    (resource_usage / "a.log").write_text("abc\n", encoding="utf-8")
+
+    payload = module.build(evidence, "deadbeef", resource_usage_dir=resource_usage)
+
+    assert payload["commit"] == "deadbeef"
+    assert payload["resource_logs_copied"] == [{"file": "a.log", "nbytes": 4}]
+    assert (evidence / "resource-logs" / "a.log").read_text(encoding="utf-8") == "abc\n"
+    assert payload["protocol"] == module.PROTOCOL
+
+
+def test_evidence_cli_resource_usage_precedence(tmp_path):
+    evidence = tmp_path / "evidence"
+    evidence.mkdir()
+    output = tmp_path / "validation.json"
+    env_resource_usage = tmp_path / "env-resource-usage"
+    env_resource_usage.mkdir()
+    cli_resource_usage = tmp_path / "cli-resource-usage"
+    cli_resource_usage.mkdir()
+    (cli_resource_usage / "cli.log").write_text("cli\n", encoding="utf-8")
+
+    env = os.environ.copy()
+    env[RESOURCE_USAGE_ENV] = str(env_resource_usage)
+    env[WORKTREE_ENV] = "/tmp/cli-worktree"
+    completed = subprocess.run(
+        [sys.executable, str(EVIDENCE_MODULE),
+         "--evidence-dir", str(evidence),
+         "--commit", "cafebabe",
+         "--output", str(output),
+         "--resource-usage-dir", str(cli_resource_usage)],
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        check=False,
+    )
+    assert completed.returncode == 0, completed.stderr
+    payload = json.loads(output.read_text(encoding="utf-8"))
+    assert payload["commit"] == "cafebabe"
+    assert payload["protocol"]["worktree"] == "/tmp/cli-worktree"
+    assert [item["file"] for item in payload["resource_logs_copied"]] == ["cli.log"]
+
+
+def test_cann_script_syntax_help_and_cli_config():
+    syntax = subprocess.run(["bash", "-n", str(CANN_SCRIPT)],
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            text=True, check=False)
+    assert syntax.returncode == 0, syntax.stderr
+
+    help_result = _run_cann("--help")
+    assert help_result.returncode == 64
+    for token in ("--meta-root", "--heavy-runner", "--hwhiaiuser-home", "--print-config"):
+        assert token in help_result.stdout
+
+    result = _run_cann("--print-config",
+                       "--meta-root", "/tmp/cli-meta",
+                       "--heavy-runner", "/tmp/cli-heavy",
+                       "--hwhiaiuser-home", "/tmp/cli-home")
+    assert result.returncode == 0, result.stderr
+    assert "meta_root=/tmp/cli-meta" in result.stdout
+    assert "heavy_runner=/tmp/cli-heavy" in result.stdout
+    assert "hwhiaiuser_home=/tmp/cli-home" in result.stdout
+
+
+def test_cann_script_env_config_overrides():
+    env = _clean_env_without_pypto_x()
+    env.update({
+        "PYPTO_X_CANN_META_ROOT": "/tmp/env-meta",
+        "PYPTO_X_LOCAL_HEAVY_RUNNER": "/tmp/env-heavy",
+        "PYPTO_X_HWHIAIUSER_HOME": "/tmp/env-home",
+        "PYPTO_X_CANN_INSTALL_PATH": "/tmp/env-install",
+    })
+    result = _run_cann("--print-config", env=env)
+    assert result.returncode == 0, result.stderr
+    assert "meta_root=/tmp/env-meta" in result.stdout
+    assert "heavy_runner=/tmp/env-heavy" in result.stdout
+    assert "hwhiaiuser_home=/tmp/env-home" in result.stdout
+    assert "install_path=/tmp/env-install" in result.stdout
+
+
+def test_cann_script_stage_shim_honors_overridden_meta_root(tmp_path):
+    meta_root = tmp_path / "cli-meta-root"
+    result = _run_cann("--stage", "shim", "--meta-root", str(meta_root))
+    assert result.returncode == 0, result.stderr
+    shim = meta_root / "shim" / "arch"
+    assert shim.is_file()
+    assert os.access(shim, os.X_OK)
+    arch = subprocess.run([str(shim)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                          text=True, check=False)
+    assert arch.returncode == 0
+    assert arch.stdout.strip()
+
+    env = _clean_env_without_pypto_x()
+    env["PYPTO_X_CANN_META_ROOT"] = str(tmp_path / "env-meta-root")
+    result = _run_cann("--stage", "shim", env=env)
+    assert result.returncode == 0, result.stderr
+    assert (tmp_path / "env-meta-root" / "shim" / "arch").is_file()
