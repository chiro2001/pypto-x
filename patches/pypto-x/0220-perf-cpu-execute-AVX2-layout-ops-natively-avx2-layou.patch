+typedef struct {
+    uint32_t input_rank;
+    uint32_t output_rank;
+    uint32_t kind;
+    uint64_t source_elements;
+    uint64_t output_elements;
+    const uint64_t *input_shape;
+    const uint64_t *output_shape;
+    const uint64_t *source_strides;
+    const uint64_t *permutation;
+    const uint64_t *slice_starts;
+    const uint64_t *slice_steps;
+} PtxAvx2LayoutDescriptor;
+
+static inline uint32_t ptx_avx2_layout_quiet_nan_f32(uint32_t bits) {
+    if ((bits & 0x7f800000U) == 0x7f800000U &&
+        (bits & 0x007fffffU) != 0U &&
+        (bits & 0x00400000U) == 0U)
+        bits |= 0x00400000U;
+    return bits;
+}
+
+static inline uint16_t ptx_avx2_layout_quiet_nan_bf16(uint16_t bits) {
+    if ((bits & 0x7f80U) == 0x7f80U &&
+        (bits & 0x007fU) != 0U &&
+        (bits & 0x0040U) == 0U)
+        bits |= 0x0040U;
