+/* Contiguous copy lanes: reshape/view/contiguous and split/concat segments.
+ * The quieting is done with integer bit tests so the lane results are
+ * byte-identical to the host reference's Python-float round trip. */
+static void ptx_avx2_layout_copy_f32(const float *input, float *output, uint64_t count) {
+    const __m256i exponent = _mm256_set1_epi32(0x7f800000);
+    const __m256i mantissa_mask = _mm256_set1_epi32(0x007fffff);
+    const __m256i quiet = _mm256_set1_epi32(0x00400000);
+    const __m256i zero = _mm256_setzero_si256();
+    uint64_t index = 0U;
+    for (; index + 8U <= count; index += 8U) {
+        __m256i bits = _mm256_loadu_si256((const __m256i *)(const void *)(input + index));
+        __m256i nan = _mm256_and_si256(
+            _mm256_cmpeq_epi32(_mm256_and_si256(bits, exponent), exponent),
+            _mm256_cmpgt_epi32(_mm256_and_si256(bits, mantissa_mask), zero));
+        bits = _mm256_or_si256(bits, _mm256_and_si256(nan, quiet));
+        _mm256_storeu_si256((__m256i *)(void *)(output + index), bits);
+    }
+    for (; index < count; ++index) {
+        uint32_t bits;
+        memcpy(&bits, input + index, sizeof(bits));
+        bits = ptx_avx2_layout_quiet_nan_f32(bits);
+        memcpy(output + index, &bits, sizeof(bits));
+    }
