+#define PTX_AVX2_LAYOUT_REORDER(SUFFIX, TYPE, COPY, QUIET_EXPR)                        \
+static int ptx_avx2_layout_reorder_##SUFFIX(                                           \
+    const PtxAvx2LayoutDescriptor *descriptor, const TYPE *input, TYPE *output)        \
+{                                                                                      \
