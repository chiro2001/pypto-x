+def test_corrupted_descriptor_is_rejected_and_writes_nothing(tmp_path, monkeypatch):
+    runtime = _runtime()
+    program = _layout_program("transpose", (2, 3, 4), (4, 3, 2), {"permutation": [2, 1, 0]}, "float32")
+    _target_ir, artifact = _compile(program, tmp_path, "corrupt")
+    payload, buffer = avx2_runtime._layout_descriptor_buffer(_target_ir.plans[0].layout_plan)
+    corrupted = (ctypes.c_ubyte * len(payload)).from_buffer_copy(payload)
+    corrupted[0] = 0x00  # break the "PXLD" magic with a single-byte edit
+    monkeypatch.setattr(
+        avx2_runtime,
+        "_layout_descriptor_buffer",
+        lambda layout: (bytes(payload), corrupted),
+    )
+    avx2_runtime.reset_layout_native_stats()
+    source = _raw_array("float32", _pattern_bits("float32", 24))
+    sentinel = 0xDEADBEEF
+    output = _raw_array("float32", [sentinel] * 24)
+    with pytest.raises(CpuAvx2ExecutionError, match="rejected the descriptor"):
+        _launch_raw(
+            artifact, [("float32", (2, 3, 4), source)], [("float32", (4, 3, 2), output)], runtime
+        )
+    assert avx2_runtime.layout_native_stats()["descriptor_rejections"] == 1
+    # fail-closed: the caller output buffer is untouched (raw bytes).
+    assert ctypes.string_at(ctypes.addressof(output), ctypes.sizeof(output)) == struct.pack(
+        "<%dI" % len(output), *[sentinel] * len(output)
+    )
+
