+# --------------------------------------------------------------------------
+# Native layout/split/concat plane (artifact payload version 5).
+#
+# The descriptor wire mirrors the verified SVE256/AVX-512 ``PXLD`` v2 payload:
+# a 40-byte header plus rank-sized uint64 arrays.  Per-descriptor bytes are
+# cached by plan digest; the compiled kernel decodes and re-validates them, so
+# a malformed or oversized descriptor fails closed instead of reading the
+# wrong buffer.
+# --------------------------------------------------------------------------
+
+_LAYOUT_KIND_CODES = {"logical_layout_copy": 0, "transpose": 1, "slice": 2}
+_LAYOUT_DESC_VERSION = 2
+_LAYOUT_DESC_HEADER = struct.Struct("<4s5I2Q")
+_LAYOUT_MAX_RANK = 64
+_LAYOUT_DESCRIPTOR_CACHE: Dict[str, Tuple[bytes, Any]] = {}
+_LAYOUT_DESCRIPTOR_CACHE_LIMIT = 4096
+_LAYOUT_DESCRIPTOR_CACHE_LOCK = threading.RLock()
+_LAYOUT_NATIVE_STATS: Dict[str, int] = {
+    "kernel_calls": 0,
+    "split_calls": 0,
+    "concat_calls": 0,
+    "descriptor_hits": 0,
+    "descriptor_misses": 0,
+    "descriptor_rejections": 0,
+    "view_alias_candidates": 0,
+    "view_alias_enabled": 0,
+    "explicit_host_fallbacks": 0,
+}
+
+
+def layout_native_stats() -> Mapping[str, int]:
+    """Snapshot the native layout plane counters (diagnostics, not a gate)."""
+
+    return dict(_LAYOUT_NATIVE_STATS)
+
+
+def reset_layout_native_stats() -> None:
+    """Zero the native layout plane counters (tests only)."""
+
+    for key in _LAYOUT_NATIVE_STATS:
+        _LAYOUT_NATIVE_STATS[key] = 0
+
+
+def _layout_descriptor_bytes(layout: Any) -> bytes:
+    """Serialize a ``LayoutPlan`` descriptor without any per-element map.
+
+    The wire matches the SVE256/AVX-512 ``PXLD`` v2 payload byte for byte, so
+    every backend describes the same rank-sized schedule.
+    """
+
+    kind = _LAYOUT_KIND_CODES.get(layout.kind)
+    if kind is None:
+        raise CpuAvx2ExecutionError(
+            "unknown AVX2 layout descriptor kind {!r}".format(layout.kind)
+        )
+    input_rank = len(layout.input_shape)
+    output_rank = len(layout.output_shape)
+    if input_rank > _LAYOUT_MAX_RANK or output_rank > _LAYOUT_MAX_RANK:
+        raise CpuAvx2ExecutionError(
+            "AVX2 layout descriptor rank exceeds {}".format(_LAYOUT_MAX_RANK)
+        )
+    descriptor = _LAYOUT_DESC_HEADER.pack(
+        b"PXLD",
+        _LAYOUT_DESC_VERSION,
+        input_rank,
+        output_rank,
+        kind,
+        0,
+        int(layout.source_elements),
+        int(layout.output_elements),
+    )
+    for values in (
+        layout.input_shape,
+        layout.output_shape,
+        layout.source_strides,
+        layout.permutation,
+        layout.slice_starts,
+        layout.slice_steps,
+    ):
+        descriptor += struct.pack("<{}Q".format(len(values)), *[int(value) for value in values])
+    return descriptor
+
+
+def _layout_descriptor_buffer(layout: Any) -> Tuple[bytes, Any]:
+    """Return the cached ``(payload, aligned ctypes buffer)`` for one plan."""
+
+    digest = layout.descriptor_digest
+    with _LAYOUT_DESCRIPTOR_CACHE_LOCK:
+        cached = _LAYOUT_DESCRIPTOR_CACHE.get(digest)
+        if cached is not None:
+            _LAYOUT_NATIVE_STATS["descriptor_hits"] += 1
+            return cached
+        payload = _layout_descriptor_bytes(layout)
+        words = (len(payload) + 7) // 8
+        padded = payload + b"\x00" * (words * 8 - len(payload))
+        array = (ctypes.c_uint64 * words).from_buffer_copy(padded)
+        if len(_LAYOUT_DESCRIPTOR_CACHE) >= _LAYOUT_DESCRIPTOR_CACHE_LIMIT:
+            _LAYOUT_DESCRIPTOR_CACHE.pop(next(iter(_LAYOUT_DESCRIPTOR_CACHE)))
+        _LAYOUT_DESCRIPTOR_CACHE[digest] = (payload, array)
+        _LAYOUT_NATIVE_STATS["descriptor_misses"] += 1
+        return payload, array
+
+
+def _call_layout_kernel(
+    module: Any,
+    kernel: str,
+    descriptor_bytes: bytes,
+    descriptor_buffer: Any,
+    source: _NativeBuffer,
+    destination: _NativeBuffer,
+) -> int:
+    function = _status_symbol(
+        module,
+        "ptx_avx2_{}".format(kernel),
+        [
+            ctypes.c_void_p,
+            ctypes.c_size_t,
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+        ],
+    )
+    return int(
+        function(
+            ctypes.cast(descriptor_buffer, ctypes.c_void_p),
+            len(descriptor_bytes),
+            source.pointer,
+            destination.pointer,
+        )
+    )
+
+
+def _call_split_kernel(
+    module: Any,
+    kernel: str,
+    source: _NativeBuffer,
+    destination: _NativeBuffer,
+    outer: int,
+    inner: int,
+    source_axis: int,
+    axis_offset: int,
+    axis_size: int,
+) -> int:
+    function = _status_symbol(
+        module,
+        "ptx_avx2_{}".format(kernel),
+        [
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    return int(
+        function(
+            source.pointer,
+            destination.pointer,
+            outer,
+            inner,
+            source_axis,
+            axis_offset,
+            axis_size,
+        )
+    )
+
+
+def _call_concat_kernel(
+    module: Any,
+    kernel: str,
+    source: _NativeBuffer,
+    destination: _NativeBuffer,
+    outer: int,
+    inner: int,
+    output_axis: int,
+    axis_offset: int,
+    axis_size: int,
+) -> int:
+    function = _status_symbol(
+        module,
+        "ptx_avx2_{}".format(kernel),
+        [
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    return int(
+        function(
+            source.pointer,
+            destination.pointer,
+            outer,
+            inner,
+            output_axis,
+            axis_offset,
+            axis_size,
+        )
+    )
+
+
+def _layout_view_alias_prefix(
+    layout: Any,
+    source: _NativeBuffer,
+    target_dtype: str,
+    count: int,
+) -> Tuple[bool, str]:
+    """Static prefix of the zero-copy view gate; never sufficient on its own.
+
+    Returns ``(prefix_ok, reason)``.  Even when the prefix passes, the executor
+    keeps the copying path until an SSA liveness proof is wired in: the
+    returned reason records that second, still-unmet condition.
+    """
+
+    if layout.kind != "logical_layout_copy":
+        return False, "layout kind {!r} is not a logical copy".format(layout.kind)
+    if tuple(layout.permutation) != tuple(range(len(layout.input_shape))):
+        return False, "layout permutation is not the identity"
+    if any(layout.slice_starts) or any(step != 1 for step in layout.slice_steps):
+        return False, "layout descriptor is not offset/step free"
+    if layout.source_elements != count or layout.output_elements != count:
+        return False, "source and output element counts do not match"
+    if source.count != count:
+        return False, "source buffer element count does not match the descriptor"
+    if source.dtype != target_dtype:
+        return False, "source and output dtype do not match"
+    if source.direct or source.owner is None:
+        return False, "source buffer is caller-owned storage, not an internal allocation"
+    return (
+        True,
+        "static prefix satisfied; SSA liveness alias proof is not wired into the executor",
+    )
+
+
 def _reference_operation(
     operation: Operation,
     plan: Any,
@@ -894,11 +1138,14 @@ def _reference_operation(
 ) -> Dict[str, _RuntimeValue]:
     """Execute one operation through the shared semantic reference.
 
-    AVX2 keeps the native ABI and runner for the hot floating-point core, but
-    layout/indexing/control and mixed-dtype operations have deliberately
-    explicit host-reference implementations until their own emitting ABI is
-    introduced.  This adapter shares the exact vector-common semantics rather
-    than duplicating a subtly different fallback here.
+    AVX2 keeps the native ABI and runner for the hot floating-point core and a
+    native PXLD-v2 descriptor plane for layout/split/concat (f32/bf16/int8);
+    indexing, position control, non-native layout dtypes and other
+    mixed-dtype operations deliberately use the exact vector-common semantic
+    reference.  The fallback is reflected in artifact metadata and never
+    invokes another backend implicitly.  This adapter shares the exact
+    vector-common semantics rather than duplicating a subtly different
+    fallback here.
     """
 
     environment: Dict[str, Any] = {}
