+def test_rank2_packed_transpose_preserves_snan_payloads(tmp_path):
+    """Documented pre-existing boundary of the B1 packed rank-2 plane.
+
+    The packed rank-2 transpose is a raw element permutation, so it preserves
+    signaling-NaN payloads; the generic PXLD layout plane (this batch) and the
+    vector-common host reference both quiet them.  The packed kernel is kept
+    byte-for-byte unchanged (payload 2 / B1), so this divergence is recorded
+    here instead of being silently blessed by a quieting oracle.
+    """
+
+    runtime = _runtime()
+    program = _layout_program("transpose", (3, 5), (5, 3), {"permutation": [1, 0]}, "float32")
+    _target_ir, artifact = _compile(program, tmp_path, "packed-snan")
+    assert artifact.metadata["execution_modes"][0]["mode"] == "native_avx2_packed_transpose"
+    bits = [
+        0x7F800001, 0xFF812345, 0x7FC00001, 0xFFC12345,
+        0x3F800000, 0xBF800000, 0x00000001, 0x80000001,
+    ] + [0x41200000] * 7
+    source = _raw_array("float32", bits)
+    native = _raw_array("float32", [0] * 15)
+    _launch_raw(
+        artifact, [("float32", (3, 5), source)], [("float32", (5, 3), native)], runtime
+    )
+    expected = _oracle_layout(
+        "transpose", (3, 5), (5, 3), {"permutation": [1, 0]}, "float32", bits, quiet=False
+    )
+    assert _buffer_sha256(native) == _oracle_sha256("float32", expected)
+    first_bits = struct.unpack("<I", ctypes.string_at(ctypes.addressof(native), 4))[0]
+    assert first_bits == 0x7F800001  # sNaN payload preserved, not quieted
