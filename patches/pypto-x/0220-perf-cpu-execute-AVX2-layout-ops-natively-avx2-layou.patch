+"""AVX2 native layout / split / concat execution plane (avx2-layout-native).
+
+Every native execution is compared *bitwise* (full output buffer sha256)
+against an independent pure-stdlib oracle implemented in this file.  The
+oracle derives each output element from the Core IR operation contract
+(shape/permutation/slice bounds/dtype round trip) by explicit coordinate
+enumeration; it never imports or calls the implementation under test.
+
+The dtype round trip is part of the frozen CPU semantic contract: the shared
+vector-common host reference round-trips every f32/bf16 element through a
+Python float, which is the identity for finite/subnormal/quiet-NaN values and
+quiets a signaling NaN.  The oracle models exactly that, so the native plane
+and the host_reference baseline stay byte-identical (a plain bit-copy model
+would differ on sNaN payloads by design).  ``test_native_matches_the_vector_common_reference``
+is a secondary cross-check that pins the same contract against the real
+host-reference path for representative cases.
+
+The layout / split / concat sections are independent: ``-k layout``,
+``-k split`` and ``-k concat`` each run on their own.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import struct
+
+import pytest
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cpu.x86 import (
+    Avx2Runtime,
+    CpuAvx2ArtifactError,
+    CpuAvx2ExecutionError,
+)
+from pypto.backends.cpu.x86 import avx2 as avx2_runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu_avx2 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    NATIVE_ABI_MARKER,
+    NATIVE_CONCAT_MODE,
+    NATIVE_LAYOUT_KERNEL_VERSION,
+    NATIVE_LAYOUT_MODE,
+    NATIVE_SPLIT_MODE,
+    Avx2Compiler,
+    layout_native_contract,
+    layout_native_fallback_reason,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import element_count
+from pypto.lowering.cpu.vector import CpuVectorUnsupportedError, CpuVectorValidationError
+from pypto.target import TargetSpec
+
+
+AVX2_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx2",), attributes={"lane_count": 8}
+)
+_CTYPES = {"float32": ctypes.c_float, "bf16": ctypes.c_uint16, "int8": ctypes.c_int8, "int32": ctypes.c_int32}
+_F32_SPECIAL = (
+    0x7F800001,  # signaling NaN, positive payload 1
+    0xFF800001,  # signaling NaN, negative payload 1
+    0x7F812345,
+    0xFF812345,
+    0x7FC00001,  # quiet NaN with payload
+    0xFFC12345,
+    0x7F800000,  # +inf
+    0xFF800000,  # -inf
+    0x00000001,  # subnormal
+    0x80000001,
+    0x7F7FFFFF,  # max finite
+    0x3F800000,
+    0xBF800000,
+    0x41200000,
+    0x00000000,
+)
+_BF16_SPECIAL = (
+    0x7F81,  # signaling NaN
+    0xFF81,
+    0x7FA1,
+    0xFFA1,
+    0x7FC1,  # quiet NaN
+    0xFFC1,
+    0x7F80,  # +inf
+    0xFF80,
+    0x0001,  # subnormal
+    0x8001,
+    0x7F7F,
+    0x3F80,
+    0xBF80,
+    0x4120,
+    0x0000,
+)
+_KERNEL_SUFFIX = {"float32": "f32", "bf16": "bf16", "int8": "i8"}
+
+
+def _runtime():
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2/YMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _compile(program, tmp_path, name):
+    compiler = Avx2Compiler()
+    target_ir = compiler.lower(program, AVX2_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+    return target_ir, artifact
+
+
+def _raw_array(dtype, bits):
+    array = (_CTYPES[dtype] * len(bits))()
+    for index, value in enumerate(bits):
+        if dtype == "float32":
+            ctypes.memmove(
+                ctypes.addressof(array) + 4 * index,
+                struct.pack("<I", int(value) & 0xFFFFFFFF),
+                4,
+            )
+        else:
+            array[index] = value
+    return array
+
+
+def _descriptor(dtype, shape, array, readonly=False):
+    return TensorDesc(
+        dtype, shape, device="cpu", address=ctypes.addressof(array), readonly=readonly
+    )
+
+
+def _launch_raw(artifact, inputs, outputs, runtime):
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_descriptor(dtype, shape, array, True) for dtype, shape, array in inputs],
+            outputs=[_descriptor(dtype, shape, array) for dtype, shape, array in outputs],
+        )
+    )
+
+
+def _buffer_sha256(array):
+    return hashlib.sha256(
+        ctypes.string_at(ctypes.addressof(array), ctypes.sizeof(array))
+    ).hexdigest()
+
+
+def _oracle_sha256(dtype, bits):
+    width = {"float32": 4, "bf16": 2, "int8": 1, "int32": 4}[dtype]
+    signed = dtype in ("int8", "int32")
+    payload = b"".join(
+        int(bits[index]).to_bytes(width, "little", signed=signed)
+        for index in range(len(bits))
+    )
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _pattern_bits(dtype, count, seed=1):
+    if dtype == "float32":
+        special = _F32_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 2654435761 + index * 2246822519) & 0xFFFFFFFF)
+            for index in range(count)
+        ]
+    if dtype == "bf16":
+        special = _BF16_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 40503 + index * 16411) & 0xFFFF)
+            for index in range(count)
+        ]
+    return [((seed * 37 + index * 91) % 255) - 127 for index in range(count)]
+
+
+def _assert_native_matches_oracle(artifact, inputs, output_shapes, dtypes, expected_bits, runtime):
+    native = [
+        _raw_array(dtype, [0] * element_count(shape))
+        for dtype, shape in zip(dtypes, output_shapes)
+    ]
+    _launch_raw(
+        artifact,
+        inputs,
+        [(dtype, shape, array) for dtype, shape, array in zip(dtypes, output_shapes, native)],
+        runtime,
+    )
+    assert len(native) == len(expected_bits)
+    for array, bits, dtype in zip(native, expected_bits, dtypes):
+        assert _buffer_sha256(array) == _oracle_sha256(dtype, bits)
+
+
+# --------------------------------------------------------------------------
+# pure-stdlib oracle (independent of the implementation under test)
+# --------------------------------------------------------------------------
+
+
+def _count(shape):
+    total = 1
+    for dimension in shape:
+        total *= int(dimension)
+    return total
+
+
+def _unravel(index, shape):
+    coords = [0] * len(shape)
+    for axis in range(len(shape) - 1, -1, -1):
+        if shape[axis] == 0:
+            return tuple(coords)
+        coords[axis] = index % shape[axis]
+        index //= shape[axis]
+    return tuple(coords)
+
+
+def _linear(shape, coords):
+    index = 0
+    for axis, coordinate in enumerate(coords):
+        index = index * shape[axis] + coordinate
+    return index
+
+
+def _quiet(bits, dtype):
+    """Model the vector-common Python-float round trip (sNaN quieting only)."""
+
+    if dtype == "float32":
+        bits &= 0xFFFFFFFF
+        if (bits & 0x7F800000) == 0x7F800000 and (bits & 0x007FFFFF) != 0 and (bits & 0x00400000) == 0:
+            bits |= 0x00400000
+        return bits
+    if dtype == "bf16":
+        bits &= 0xFFFF
+        if (bits & 0x7F80) == 0x7F80 and (bits & 0x007F) != 0 and (bits & 0x0040) == 0:
+            bits |= 0x0040
+        return bits
+    return int(bits)
+
+
+def _oracle_layout(name, input_shape, output_shape, attributes, dtype, source_bits, quiet=True):
+    """Expected output bits for one layout op, by coordinate enumeration.
+
+    ``quiet=False`` models the pre-existing packed rank-2 transpose kernel,
+    which is a raw element permutation (see
+    ``test_rank2_packed_transpose_preserves_snan_payloads``); the generic
+    PXLD layout plane uses ``quiet=True`` to reproduce the vector-common
+    Python-float round trip.
+    """
+
+    round_trip = (lambda bits: _quiet(bits, dtype)) if quiet else (lambda bits: bits)
+    if name in ("reshape", "view", "contiguous"):
+        assert _count(input_shape) == _count(output_shape)
+        return [round_trip(source_bits[index]) for index in range(_count(output_shape))]
+    output_count = _count(output_shape)
+    expected = []
+    if name == "transpose":
+        permutation = tuple(int(axis) for axis in attributes["permutation"])
+        assert len(permutation) == len(input_shape)
+        for index in range(output_count):
+            out_coords = _unravel(index, output_shape)
+            in_coords = [0] * len(input_shape)
+            for output_axis, input_axis in enumerate(permutation):
+                in_coords[input_axis] = out_coords[output_axis]
+            expected.append(round_trip(source_bits[_linear(input_shape, in_coords)]))
+        return expected
+    if name == "slice":
+        starts = attributes["starts"]
+        stops = attributes["stops"]
+        axes = attributes.get("axes", list(range(len(starts))))
+        steps = attributes.get("steps", [1] * len(starts))
+        mapping = {}
+        for position, axis in enumerate(axes):
+            dimension = input_shape[axis]
+            start = starts[position]
+            start = start + dimension if start < 0 else start
+            mapping[axis] = (start, steps[position])
+        for index in range(output_count):
+            out_coords = _unravel(index, output_shape)
+            in_coords = list(out_coords)
+            for axis, (start, step) in mapping.items():
+                in_coords[axis] = start + out_coords[axis] * step
+            expected.append(round_trip(source_bits[_linear(input_shape, in_coords)]))
+        return expected
+    raise AssertionError("unknown layout oracle operation {!r}".format(name))
+
+
+def _oracle_split(input_shape, axis, sizes, dtype, source_bits):
+    outputs = []
+    offset = 0
+    for size in sizes:
+        shape = list(input_shape)
+        shape[axis] = size
+        shape = tuple(shape)
+        chunk = []
+        for index in range(_count(shape)):
+            coords = list(_unravel(index, shape))
+            coords[axis] += offset
+            chunk.append(_quiet(source_bits[_linear(input_shape, coords)], dtype))
+        outputs.append(chunk)
+        offset += size
+    return outputs
+
+
+def _oracle_concat(input_shapes, axis, dtype, sources):
+    output_shape = list(input_shapes[0])
+    output_shape[axis] = sum(shape[axis] for shape in input_shapes)
+    output_shape = tuple(output_shape)
+    offsets = []
+    running = 0
+    for shape in input_shapes:
+        offsets.append(running)
+        running += shape[axis]
+    expected = []
+    for index in range(_count(output_shape)):
+        coords = list(_unravel(index, output_shape))
+        coordinate = coords[axis]
+        selected = None
+        for position, shape in enumerate(input_shapes):
+            if offsets[position] <= coordinate < offsets[position] + shape[axis]:
+                selected = position
+                break
+        assert selected is not None
+        in_coords = list(coords)
+        in_coords[axis] = coordinate - offsets[selected]
+        expected.append(
+            _quiet(sources[selected][_linear(input_shapes[selected], in_coords)], dtype)
+        )
+    return expected
+
+
+# --------------------------------------------------------------------------
+# layout
+# --------------------------------------------------------------------------
+
+
+def _layout_program(name, input_shape, output_shape, attributes, dtype):
+    source = ValueRef("source", CoreType.tensor(dtype, input_shape))
+    output = ValueRef("output", CoreType.tensor(dtype, output_shape))
+    operation = Operation(name, (source,), (output,), dict(attributes))
+    return CoreProgram(
+        functions=(CoreFunction(name, (source,), (output,), Region((operation,))),)
+    )
+
+
+def _layout_cases():
+    """One entry per independent native-layout case: dtype/name/shapes/attrs."""
+
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append((dtype, "reshape", (3, 5), (5, 3), {"shape": [5, 3]}))
+        # Empty axis / degenerate shapes.
+        cases.append((dtype, "reshape", (2, 0, 3), (0, 6), {"shape": [0, 6]}))
+        cases.append((dtype, "view", (1, 1, 1), (1,), {"shape": [1]}))
+        cases.append((dtype, "contiguous", (0, 4), (0, 4), {}))
+        # Non-multiples of the vector width.
+        cases.append((dtype, "reshape", (7,), (7,), {"shape": [7]}))
+        cases.append((dtype, "view", (13,), (1, 13), {"shape": [1, 13]}))
+        # Batch prefix stays outermost.
+        cases.append((dtype, "reshape", (2, 3, 4, 5), (2, 60), {"shape": [2, 60]}))
+        cases.append((dtype, "view", (2, 3, 4), (4, 6), {"shape": [4, 6]}))
+        cases.append((dtype, "contiguous", (2, 3), (2, 3), {}))
+        # Rank-2 transpose keeps the existing packed plane.
+        cases.append((dtype, "transpose", (5, 7), (7, 5), {"permutation": [1, 0]}))
+        # Rank 3/4 generic permutations, including non-trivial cycles.
+        cases.append((dtype, "transpose", (2, 3, 5), (5, 2, 3), {"permutation": [2, 0, 1]}))
+        cases.append((dtype, "transpose", (2, 3, 5), (3, 2, 5), {"permutation": [1, 0, 2]}))
+        cases.append((dtype, "transpose", (2, 3, 4, 5), (4, 5, 2, 3), {"permutation": [2, 3, 0, 1]}))
+        cases.append((dtype, "transpose", (1, 3, 2, 5), (5, 2, 3, 1), {"permutation": [3, 2, 1, 0]}))
+        # Unit / non-unit step slices, batch prefix, empty result.
+        cases.append(
+            (dtype, "slice", (4, 7), (2, 7), {"starts": [1, 0], "stops": [4, 7], "steps": [2, 1]})
+        )
+        cases.append(
+            (dtype, "slice", (5, 7), (3, 2), {"starts": [0, 1], "stops": [5, 7], "steps": [2, 3]})
+        )
+        cases.append(
+            (
+                dtype,
+                "slice",
+                (2, 4, 6),
+                (2, 2, 3),
+                {"starts": [0, 1, 0], "stops": [2, 4, 6], "steps": [1, 2, 2], "axes": [0, 1, 2]},
+            )
+        )
+        cases.append(
+            (
+                dtype,
+                "slice",
+                (4, 5, 6),
+                (4, 5, 3),
+                {"starts": [1], "stops": [6], "steps": [2], "axes": [2]},
+            )
+        )
+        cases.append(
+            (dtype, "slice", (3, 5), (0, 5), {"starts": [2], "stops": [2], "steps": [1], "axes": [0]})
+        )
+        # Empty slice on a zero-length axis.
+        cases.append(
+            (dtype, "slice", (0, 5), (0, 5), {"starts": [0], "stops": [0], "steps": [1], "axes": [0]})
+        )
+    return cases
+
+
+@pytest.mark.parametrize(
+    "dtype,name,input_shape,output_shape,attributes",
+    _layout_cases(),
+    ids=lambda value: str(value) if not isinstance(value, (tuple, dict)) else "",
