+        uint32_t source_axis = (uint32_t)descriptor->permutation[axis];
+        if (ptx_avx2_layout_u64_mul(descriptor->slice_steps[source_axis],
+                                    descriptor->source_strides[source_axis],
+                                    &deltas[axis]) != 0)
+            return -1;
+        if (ptx_avx2_layout_u64_mul(descriptor->slice_starts[source_axis],
+                                    descriptor->source_strides[source_axis],
