+    descriptor->output_elements = ptx_avx2_layout_read_u64(bytes + 32);
+    descriptor->input_shape = arrays;
+    descriptor->output_shape = arrays + input_rank;
+    descriptor->source_strides = descriptor->output_shape + output_rank;
+    descriptor->permutation = descriptor->source_strides + input_rank;
+    descriptor->slice_starts = descriptor->permutation + input_rank;
