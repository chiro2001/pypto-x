+def test_declared_kernel_is_the_dispatched_kernel_spy(tmp_path, monkeypatch):
+    """Spy on the module-level C-call helpers: declared == executed, per family."""
+
+    runtime = _runtime()
+    source = ValueRef("source", CoreType.tensor("float32", (2, 3, 4)))
+    transposed = ValueRef("transposed", CoreType.tensor("float32", (3, 2, 4)))
+    left = ValueRef("left", CoreType.tensor("float32", (1, 2, 4)))
+    right = ValueRef("right", CoreType.tensor("float32", (2, 2, 4)))
+    joined = ValueRef("joined", CoreType.tensor("float32", (3, 2, 4)))
+    operations = (
+        Operation("transpose", (source,), (transposed,), {"permutation": [1, 0, 2]}),
+        Operation("split", (transposed,), (left, right), {"axis": 0, "sizes": [1, 2]}),
+        Operation("concat", (left, right), (joined,), {"axis": 0}),
+    )
+    program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "chain", (source,), (joined,), Region(operations)
+            ),
+        )
+    )
+    _target_ir, artifact = _compile(program, tmp_path, "spy")
+    metadata = artifact.metadata
+    declared = {
+        entry["mode"]: entry["kernel"]
+        for entry in metadata["layout_native_operations"]
+    }
+    assert declared == {
+        NATIVE_LAYOUT_MODE: "layout_f32",
+        NATIVE_SPLIT_MODE: "split_f32",
+        NATIVE_CONCAT_MODE: "concat_f32",
+    }
+    calls = []
+    originals = {
+        "_call_layout_kernel": avx2_runtime._call_layout_kernel,
+        "_call_split_kernel": avx2_runtime._call_split_kernel,
+        "_call_concat_kernel": avx2_runtime._call_concat_kernel,
+    }
+
+    def spy(family, original):
+        def wrapper(module, kernel, *args, **kwargs):
+            calls.append((family, kernel))
+            return original(module, kernel, *args, **kwargs)
+
+        return wrapper
+
+    for name, original in originals.items():
+        monkeypatch.setattr(avx2_runtime, name, spy(name, original))
+    source_bits = _pattern_bits("float32", element_count((2, 3, 4)), seed=9)
+    source_array = _raw_array("float32", source_bits)
+    output = _raw_array("float32", [0] * element_count((3, 2, 4)))
+    _launch_raw(
+        artifact,
+        [("float32", (2, 3, 4), source_array)],
+        [("float32", (3, 2, 4), output)],
+        runtime,
+    )
+    families = [family for family, _kernel in calls]
+    assert families == [
+        "_call_layout_kernel",
+        "_call_split_kernel",
+        "_call_split_kernel",
+        "_call_concat_kernel",
+        "_call_concat_kernel",
+    ]
+    for family, kernel in calls:
+        expected = (
+            declared[NATIVE_LAYOUT_MODE]
+            if family == "_call_layout_kernel"
+            else declared[NATIVE_SPLIT_MODE]
+            if family == "_call_split_kernel"
+            else declared[NATIVE_CONCAT_MODE]
+        )
+        assert kernel == expected
+    # Every declared entry was actually dispatched exactly as declared.
+    assert [entry["kernel"] for entry in metadata["layout_native_operations"]] == [
+        "layout_f32", "split_f32", "concat_f32"
+    ]
