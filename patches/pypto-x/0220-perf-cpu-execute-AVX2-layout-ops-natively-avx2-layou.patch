+static uint32_t ptx_avx2_layout_read_u32(const unsigned char *bytes) {
+    uint32_t value;
+    memcpy(&value, bytes, sizeof(value));
+    return value;
+}
+
+static uint64_t ptx_avx2_layout_read_u64(const unsigned char *bytes) {
+    uint64_t value;
+    memcpy(&value, bytes, sizeof(value));
+    return value;
+}
+
+static int ptx_avx2_layout_u64_mul(uint64_t left, uint64_t right, uint64_t *result) {
+    if (left != 0U && right > UINT64_MAX / left) return -1;
+    *result = left * right;
+    return 0;
+}
+
+static int ptx_avx2_layout_u64_add(uint64_t left, uint64_t right, uint64_t *result) {
+    if (right > UINT64_MAX - left) return -1;
+    *result = left + right;
+    return 0;
