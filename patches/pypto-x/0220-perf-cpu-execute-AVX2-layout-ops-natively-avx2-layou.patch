+    const __m256i mantissa_mask = _mm256_set1_epi16(0x007f);
+    const __m256i quiet = _mm256_set1_epi16(0x0040);
+    const __m256i zero = _mm256_setzero_si256();
+    uint64_t index = 0U;
+    for (; index + 16U <= count; index += 16U) {
+        __m256i bits = _mm256_loadu_si256((const __m256i *)(const void *)(input + index));
+        __m256i nan = _mm256_and_si256(
+            _mm256_cmpeq_epi16(_mm256_and_si256(bits, exponent), exponent),
+            _mm256_cmpgt_epi16(_mm256_and_si256(bits, mantissa_mask), zero));
+        bits = _mm256_or_si256(bits, _mm256_and_si256(nan, quiet));
+        _mm256_storeu_si256((__m256i *)(void *)(output + index), bits);
+    }
+    for (; index < count; ++index)
+        output[index] = ptx_avx2_layout_quiet_nan_bf16(input[index]);
