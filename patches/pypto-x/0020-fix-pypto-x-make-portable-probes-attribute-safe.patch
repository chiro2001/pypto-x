From 3cb7061c2592247c3c5fbb3fbfb6bc264485cdc7 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Mon, 7 Sep 2026 02:43:02 +0800
Subject: [PATCH 020/257] fix(pypto-x): make portable probes attribute-safe

---
 python/pypto/__init__.py                           |  2 +-
 python/pypto/frontend/__init__.py                  |  2 +-
 python/tests/ut/pypto_x/test_portable_bootstrap.py | 11 +++++++++++
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/python/pypto/__init__.py b/python/pypto/__init__.py
index 8a6e829f3..fcbac508e 100644
--- a/python/pypto/__init__.py
+++ b/python/pypto/__init__.py
@@ -40,7 +40,7 @@ if _os.environ.get("PYPTO_X_PORTABLE_ONLY") == "1":
             "DT_FP32",
             "DT_BF16",
         }:
-            raise RuntimeError(_PORTABLE_ONLY_ERROR)
+            raise AttributeError(_PORTABLE_ONLY_ERROR)
         raise AttributeError("module 'pypto' has no attribute {!r}".format(name))
 
     __all__ = []
diff --git a/python/pypto/frontend/__init__.py b/python/pypto/frontend/__init__.py
index b4466986a..ec048b160 100644
--- a/python/pypto/frontend/__init__.py
+++ b/python/pypto/frontend/__init__.py
@@ -83,7 +83,7 @@ if _PORTABLE_ONLY:
 
     def __getattr__(name):
         if name in {"jit", "function", "dynamic", "parser"}:
-            raise RuntimeError(_PORTABLE_ONLY_ERROR)
+            raise AttributeError(_PORTABLE_ONLY_ERROR)
         raise AttributeError("module 'pypto.frontend' has no attribute {!r}".format(name))
 
     __all__ = []
diff --git a/python/tests/ut/pypto_x/test_portable_bootstrap.py b/python/tests/ut/pypto_x/test_portable_bootstrap.py
index 2818fb576..4d524b611 100644
--- a/python/tests/ut/pypto_x/test_portable_bootstrap.py
+++ b/python/tests/ut/pypto_x/test_portable_bootstrap.py
@@ -98,6 +98,12 @@ try:
         except (AttributeError, RuntimeError) as exc:
             errors["pypto." + name] = str(exc)
     result["classic_errors"] = errors
+    frontend = importlib.import_module("pypto.frontend")
+    result["hasattr_results"] = {
+        "pypto.Tensor": hasattr(pypto, "Tensor"),
+        "pypto.DT_FP32": hasattr(pypto, "DT_FP32"),
+        "pypto.frontend.jit": hasattr(frontend, "jit"),
+    }
 
     from pypto.abi import LaunchRequest
     from pypto.backends.cpu import CpuScalarRuntime, HostTensor
@@ -234,6 +240,11 @@ def test_portable_subprocess_bootstraps_public_modules_without_native_dependenci
     for message in result["classic_errors"].values():
         assert "PYPTO_X_PORTABLE_ONLY" in message
         assert "complete PyPTO wheel" in message
+    assert result["hasattr_results"] == {
+        "pypto.Tensor": False,
+        "pypto.DT_FP32": False,
+        "pypto.frontend.jit": False,
+    }
     assert result["program_verified"] is True
     assert result["output"] == [11.0, 22.0]
     assert result["differential_passed"] is True
