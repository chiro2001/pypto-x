From 2f4ad2a6fc4716cc8bba9c22d0ffec31bbdbd0d0 Mon Sep 17 00:00:00 2001
From: op-bench-framework <op-bench-framework@pypto-x.local>
Date: Sat, 12 Sep 2026 03:52:25 +0800
Subject: [PATCH 210/258] test(op-bench): injected provider-unavailable must
 stay explicit in the report

---
 python/tests/ut/pypto_x/test_op_bench_framework.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/python/tests/ut/pypto_x/test_op_bench_framework.py b/python/tests/ut/pypto_x/test_op_bench_framework.py
index cb8e93d60..e458a9560 100644
--- a/python/tests/ut/pypto_x/test_op_bench_framework.py
+++ b/python/tests/ut/pypto_x/test_op_bench_framework.py
@@ -387,6 +387,21 @@ def test_repeat_run_structure_and_median_within_dispersion(tiny_report):
     assert block["verdict"] == "PASS", json.dumps(block, indent=2)
 
 
+def test_injected_provider_unavailable_is_explicit():
+    report = dict(_C.runner.run_report(_tiny_config(providers=("portable",), inject_unavailable=("portable",))))
+    cases = [
+        case
+        for case in report["cases"]
+        if case["provider"] == "portable" and case["status"] != "skipped_user_request"
+    ]
+    assert cases
+    assert all(case["status"] == "provider_unavailable" for case in cases)
+    assert all(case["error"]["category"] == "provider_unavailable" for case in cases)
+    assert all(case["seconds"] is None for case in cases)
+    assert report["status"] == "PARTIAL"
+    assert "injected unavailable" in report["status_reason"]
+
+
 def test_selftest_all_error_injections_pass():
     config = _tiny_config(tag="pytest-selftest")
     payload = _C.runner.run_selftest(config)
