+# ---------------------------------------------------------------------------
+# PyPTO-X native AVX-512 W8A8 kernels
+# ---------------------------------------------------------------------------
+
+
+class OurW8A8:
+    """Compiles/loads the repo's AVX-512 W8A8 artifact and exposes raw kernels."""
+
+    def __init__(self, worktree: str, artifact_dir: str):
+        self.worktree = worktree
+        self.artifact_dir = artifact_dir
+        self._kernels = {}
+
+    def kernels(self, m, k, n):
+        key = (m, k, n)
+        if key in self._kernels:
+            return self._kernels[key]
+
+        from pypto.backends.cpu.x86 import Avx512Runtime
+        from pypto.compiler import CompileOptions
+        from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+        from pypto.core_ir import (
+            CoreFunction,
+            CoreProgram,
+            CoreType,
+            Operation,
+            Region,
+            ValueRef,
+        )
+        from pypto.lowering.cpu import W8A8_QMATMUL_OPCODE
+        from pypto.target import TargetSpec
+
+        left = ValueRef("left", CoreType.tensor("int8", (m, k)))
+        right = ValueRef("right", CoreType.tensor("int8", (k, n)))
+        output = ValueRef("output", CoreType.tensor("int32", (m, n)))
+        operation = Operation(W8A8_QMATMUL_OPCODE, (left, right), (output,), {})
+        program = CoreProgram(
+            functions=(CoreFunction("qmatmul", (left, right), (output,), Region((operation,))),)
+        )
+        target = TargetSpec(
+            "cpu", "x86_64-linux-gnu",
+            features=("avx512f", "avx512vnni"),
+            attributes={"lane_count": 16},
+        )
+        compiler = Avx512Compiler()
+        artifact = compiler.compile(
+            compiler.lower(program, target),
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx512",
+                extra={
+                    "build_dir": os.path.join(
+                        self.artifact_dir, "w8a8-{}-{}-{}".format(m, k, n)
+                    )
+                },
+            ),
+        )
+        _, loaded = Avx512Runtime()._load_w8a8(artifact)
+        qmatmul = getattr(loaded.module, "ptx_avx512_qmatmul_s8s8_s32")
+        qmatmul.argtypes = [
+            ctypes.POINTER(ctypes.c_int8), ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_int32),
+            ctypes.c_size_t, ctypes.c_size_t, ctypes.c_size_t,
+        ]
+        qmatmul.restype = ctypes.c_int
+        epilogue = getattr(loaded.module, "ptx_avx512_dequantize_epilogue_bf16")
+        epilogue.argtypes = [
+            ctypes.POINTER(ctypes.c_int32), ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_float), ctypes.POINTER(ctypes.c_uint16),
+            ctypes.c_size_t, ctypes.c_size_t,
+        ]
+        epilogue.restype = ctypes.c_int
+        self._kernels[key] = (qmatmul, epilogue, artifact.path)
+        return self._kernels[key]
+
+    def prepare_qmatmul(self, a, b, m, k, n):
+        qmatmul, _epilogue, _path = self.kernels(m, k, n)
+        a_buf = np.ascontiguousarray(a, dtype=np.int8)
+        b_buf = np.ascontiguousarray(b, dtype=np.int8)
+        c_buf = np.zeros((m, n), dtype=np.int32)
+        a_ptr, b_ptr, c_ptr = _i8p(a_buf), _i8p(b_buf), _i32p(c_buf)
+
+        def call():
+            status = qmatmul(a_ptr, b_ptr, c_ptr, m, k, n)
+            if status != 0:
+                raise RuntimeError("our AVX-512 qmatmul returned {}".format(status))
+
+        return call, c_buf
+
+    def prepare_epilogue(self, acc, row_scales, col_scales, m, n, k):
+        _qmatmul, epilogue, _path = self.kernels(m, k, n)
+        acc_buf = np.ascontiguousarray(acc, dtype=np.int32)
+        row = np.ascontiguousarray(np.asarray(row_scales, dtype=np.float32))
+        col = np.ascontiguousarray(np.asarray(col_scales, dtype=np.float32))
+        out = np.zeros((m, n), dtype=np.uint16)
+        acc_ptr = _i32p(acc_buf)
+        row_ptr = row.ctypes.data_as(ctypes.POINTER(ctypes.c_float))
+        col_ptr = col.ctypes.data_as(ctypes.POINTER(ctypes.c_float))
+        out_ptr = _u16p(out)
+
+        def call():
+            status = epilogue(acc_ptr, row_ptr, col_ptr, out_ptr, m, n)
+            if status != 0:
+                raise RuntimeError("our AVX-512 epilogue returned {}".format(status))
+
+        return call, out
+
+
+def probe_libxsmm():
+    explicit = os.environ.get("PYPTO_X_LIBXSMM_LIB")
+    if explicit and os.path.exists(explicit):
+        try:
+            ctypes.CDLL(explicit)
+            return {"available": True, "library": explicit, "note": "loaded"}
+        except OSError as exc:
+            return {"available": False, "library": explicit, "note": str(exc)}
+    return {
+        "available": False,
+        "library": None,
+        "note": "no usable libxsmm on this host (absent from PyPI/conda/system); "
+                "column is reported unavailable, not substituted",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--worktree", default=None)
+    parser.add_argument("--threads", type=int, default=6)
+    parser.add_argument("--rounds", type=int, default=5)
+    parser.add_argument("--iters-decode", type=int, default=200)
+    parser.add_argument("--iters-prefill", type=int, default=100)
+    parser.add_argument("--lib", default=None)
+    parser.add_argument("--artifact-dir", default=None)
+    parser.add_argument("--tag", default="q8-vendor-gemm-matrix")
+    parser.add_argument("--skip-onednn", action="store_true")
+    parser.add_argument("--skip-ours-bf16", action="store_true")
+    parser.add_argument(
+        "--only-int8",
+        action="store_true",
+        help="skip every bf16 column (used for the 1-thread like-for-like int8 pass)",
+    )
+    args = parser.parse_args()
+
+    worktree = args.worktree or os.environ.get("PYPTO_X_WORKTREE", DEFAULT_WORKTREE)
+    evidence = os.environ.get("PYPTO_X_VENDOR_EVIDENCE", DEFAULT_EVIDENCE)
+    artifact_dir = args.artifact_dir or os.path.join(evidence, "raw", "avx512-artifacts")
+
+    try:
+        os.sched_setaffinity(0, set(range(args.threads)))
+    except OSError:
+        pass
+    os.environ.setdefault("OMP_NUM_THREADS", str(args.threads))
+    os.environ.setdefault("MKL_NUM_THREADS", str(args.threads))
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
+
+    import torch
+    import torch.nn.functional as F
+
+    torch.set_num_threads(args.threads)
+
+    sys.path.insert(0, os.path.join(worktree, "python"))
+    import types
+
+    if "pypto" not in sys.modules:
+        package = types.ModuleType("pypto")
+        package.__path__ = [os.path.join(worktree, "python", "pypto")]
+        sys.modules["pypto"] = package
+    import pypto.framework as framework
+
+    framework.register_torch_ops()
+    from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache
+    from pypto.portable.qwen35_w8a8_weight import quantize_weight_per_output_channel
+
+    aocl_lib = args.lib or os.environ.get("PYPTO_X_AOCL_LIB")
+    if not aocl_lib:
+        for dirpath, _dirs, files in os.walk(
+            os.path.join(evidence, "install", "aocl-blis-5.3.2-zen4")
+        ):
+            for name in sorted(files):
+                if name.startswith("libblis-mt.so"):
+                    aocl_lib = os.path.join(dirpath, name)
+    if not aocl_lib:
+        raise SystemExit("AOCL library not found (pass --lib / PYPTO_X_AOCL_LIB)")
+
+    aocl = Aocl(aocl_lib)
+    scheme = _portable()
+    our = OurW8A8(worktree, artifact_dir)
+
+    report = OrderedDict(
+        tag=args.tag,
+        started_at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        argv=sys.argv,
+        host={
+            "platform": platform.platform(),
+            "cpu_count": os.cpu_count(),
+            "affinity": sorted(os.sched_getaffinity(0)),
+            "torch_threads": torch.get_num_threads(),
+            "torch": torch.__version__,
+            "numpy": np.__version__,
+            "python": sys.version.split()[0],
+        },
+        env={
+            "OMP_NUM_THREADS": os.environ.get("OMP_NUM_THREADS"),
+            "threads_requested": args.threads,
+        },
+        methodology={
+            "shapes": "W8J J2 12-shape set: m in {1,5} x six (k,n) pairs, identical labels",
+            "inputs": "randn/sqrt(k) -> bf16, torch generator seed {}".format(INPUT_SEED),
+            "rounds": args.rounds,
+            "iters_decode_m1": args.iters_decode,
+            "iters_prefill_m5": args.iters_prefill,
+            "warmup": "one untimed call per round, then `iters` calls; median across rounds",
+            "onednn_path": "vllm dispatch_cpu_unquantized_gemm -> oneDNN on this host",
+            "our_path": "pypto.framework packed AVX-512 bridge / native AVX-512 W8A8 artifacts",
+            "gate": "UNGATED (12 vCPU KVM, no cpufreq control, non-quiet window)",
+            "measurement_level": "L0 op, per-call wall including python/ctypes dispatch "
+                                 "(same level as the W8J J2 shape gate)",
+            "noise_indicators": "sampled before/after the run; see env_noise_start/end",
+        },
+        aocl={"library": aocl_lib, "dim_t_source": DIM_SOURCE},
+        libxsmm=probe_libxsmm(),
+        env_noise_start=_env_noise(),
+        int8_quantizer="pypto.portable.qwen35_w8a8_weight.quantize_weight_per_output_channel "
+                       "+ qwen35_w8a8_scheme.quantize_per_token_s8 (contract-exact)",
+        shapes=[],
+        status="FAIL",
+    )
+
+    generator = torch.Generator().manual_seed(INPUT_SEED)
+    prepared = []
+    for m in M_VALUES:
+        for k, n, label in SHAPES:
+            x = (torch.randn(m, k, generator=generator) / (k ** 0.5)).to(torch.bfloat16)
+            weight = (torch.randn(n, k, generator=generator) / (k ** 0.5)).to(torch.bfloat16)
+            prepared.append((m, k, n, label, x, weight))
+
+    report["input_digest"] = {
+        "sha256": hashlib.sha256(
