+#!/usr/bin/env python3
+"""Q8 / vendor-gemm-survey: pre-flight for *our* AVX-512 W8A8 path.
+
+Compiles one small AVX-512 VNNI artifact from the repository's embedded C
+source and checks, before any vendor benchmarking window is spent:
+
+  * ``ptx_avx512_qmatmul_s8s8_s32`` reproduces the portable int32 accumulator
+    bit for bit;
+  * ``ptx_avx512_dequantize_epilogue_bf16`` reproduces the portable
+    single-rounding bf16 epilogue bit for bit;
+  * the reserved code point ``-128`` is rejected (status -1), i.e. our own
+    kernel is fail-closed on the scheme violation.
+
+Writes ``raw/ours-w8a8-prefight.json`` and exits non-zero on any mismatch.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+WORKTREE = os.path.abspath(os.path.join(HERE, "..", ".."))
+DEFAULT_EVIDENCE = "/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey"
+
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(WORKTREE, "python"))
+
+import types  # noqa: E402
+
+if "pypto" not in sys.modules:
+    package = types.ModuleType("pypto")
+    package.__path__ = [os.path.join(WORKTREE, "python", "pypto")]
+    sys.modules["pypto"] = package
+
+import vendor_gemm_matrix as vgm  # noqa: E402
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", default=None)
+    parser.add_argument("--worktree", default=None)
+    parser.add_argument("--seed", type=int, default=20260912)
+    args = parser.parse_args()
+
+    evidence = args.evidence or os.environ.get("PYPTO_X_VENDOR_EVIDENCE", DEFAULT_EVIDENCE)
+    worktree = args.worktree or WORKTREE
+    os.environ.setdefault("PYPTO_X_VENDOR_EVIDENCE", evidence)
+
+    scheme = vgm._portable()
+    our = vgm.OurW8A8(worktree, os.path.join(evidence, "raw", "avx512-artifacts-prefight"))
+    rng = np.random.default_rng(args.seed)
+    m, k, n = 2, 8, 3
+    a = rng.integers(-127, 128, size=(m, k), dtype=np.int16).astype(np.int8)
+    b = rng.integers(-127, 128, size=(k, n), dtype=np.int16).astype(np.int8)
+
+    call, acc = our.prepare_qmatmul(a, b, m, k, n)
+    call()
+    golden = np.array(
+        scheme.qmatmul_s8s8_s32(
+            a.reshape(-1).tolist(), b.reshape(-1).tolist(),
+            left_shape=(m, k), right_shape=(k, n),
+        ).values,
+        dtype=np.int32,
+    ).reshape(m, n)
+
+    rows = np.array([0.5, 1.25], dtype=np.float32)
+    cols = np.array([0.25, 1.0, 2.0], dtype=np.float32)
+    epilogue_call, bits = our.prepare_epilogue(acc, rows, cols, m, n, k)
+    epilogue_call()
+    golden_bits = np.array(
+        scheme.dequantize_epilogue_bf16(
+            golden.reshape(-1).tolist(), rows.tolist(), cols.tolist(), shape=(m, n)
+        ).bf16_bits,
+        dtype=np.uint16,
+    ).reshape(m, n)
+
+    rejected = False
+    rejection_error = None
+    bad = a.copy()
+    bad[0, 0] = -128
+    try:
+        bad_call, _ = our.prepare_qmatmul(bad, b, m, k, n)
+        bad_call()
+    except Exception as exc:  # noqa: BLE001 - the rejection is the expected result
+        rejected = True
+        rejection_error = "{}: {}".format(type(exc).__name__, exc)
+
+    report = {
+        "tag": "q8-ours-w8a8-prefight",
+        "started_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "shape": [m, k, n],
+        "seed": args.seed,
+        "int32_ours": acc.tolist(),
+        "int32_golden": golden.tolist(),
+        "int32_bitwise_equal": bool(np.array_equal(acc, golden)),
+        "epilogue_bits_equal": bool(np.array_equal(bits, golden_bits)),
+        "reserved_code_rejected": bool(rejected),
+        "reserved_code_error": rejection_error,
+        "verdict": (
+            "PASS"
+            if np.array_equal(acc, golden) and np.array_equal(bits, golden_bits) and rejected
+            else "FAIL"
+        ),
+    }
+    out = os.path.join(evidence, "raw", "ours-w8a8-prefight.json")
+    with open(out, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, ensure_ascii=False)
+        handle.write("\n")
+    print(json.dumps({key: report[key] for key in report if key != "reserved_code_error"}, ensure_ascii=False))
+    print("report:", out)
+    return 0 if report["verdict"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
