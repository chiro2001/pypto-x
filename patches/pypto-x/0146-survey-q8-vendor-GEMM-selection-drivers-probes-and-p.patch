+#!/usr/bin/env python3
+"""Q8 / vendor-gemm-survey: AOCL/LPGEMM API semantics + saturation probe.
+
+This is the *runtime* half of the §3 evidence for the x86 AOCL leg.  It talks
+to the locally built AOCL-BLIS 5.3.2 LPGEMM shared library through ctypes and
+answers, with measurements rather than documentation quotes:
+
+  E1  minimal runnable case: s8x s8 -> s32 equals the portable C1 golden
+  E2  accumulation width: exact big-integer comparison over K=4096 (f32
+      accumulation would already lose bits here)
+  E3  int32 overflow: no saturation, wraps modulo 2**32 (and the portable
+      golden refuses K > MAX_ACCUMULATOR_K)
+  E4  reserved code point: LPGEMM accepts -128 while our scheme reserves it
+  E5  SCALE post-op granularity: per-tensor (len 1) and per-column (len n)
+      are accepted and bitwise-equal to the portable epilogue; per-row
+      (len m) is rejected by the parser
+  E6  fused bf16 output uses round-to-nearest-even (a deliberate tie case)
+  E7  s8s8s32obf16_sym_quant single-group mode carries a per-row A scale and
+      a per-column B scale (our per-token x per-channel epilogue shape) --
+      how close is it to the portable single-rounding epilogue?
+  E8  runtime arch selection: which BLIS arch id/name is live, and does an
+      env override move it away from the compiled Zen4 config?
+
+Run with the locally built library:
+
+  PYPTO_X_AOCL_LIB=<install>/lib/libblis-mt.so python3 aocl_semantics_probe.py \
+      --output <evidence>/raw/aocl-semantics-probe.json
+
+The probe never assumes a result: every experiment records raw arrays,
+verdicts and the observed error text where a call is rejected.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import os
+import platform
+import subprocess
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DEFAULT_WORKTREE = os.path.abspath(os.path.join(HERE, "..", ".."))
+DEFAULT_EVIDENCE = "/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey"
+
+# --------------------------------------------------------------------------
+# portable golden (the contract baseline we compare against)
+# --------------------------------------------------------------------------
+
+
+def _portable():
+    """Import the frozen contract golden from the source tree.
+
+    ``pypto/__init__.py`` is the online-build bootstrap (it requires installed
+    package metadata), so the documented source-tree seam is a stub package
+    whose ``__path__`` points at ``python/pypto`` -- the same trick the W8J
+    shape gate uses.
+    """
+    worktree = os.environ.get("PYPTO_X_WORKTREE", DEFAULT_WORKTREE)
+    if "pypto" not in sys.modules:
+        import types
+
+        package = types.ModuleType("pypto")
+        package.__path__ = [os.path.join(worktree, "python", "pypto")]
+        sys.modules["pypto"] = package
+    from pypto.portable import qwen35_w8a8_scheme as scheme
+
+    return scheme
+
+
+# --------------------------------------------------------------------------
+# ctypes bindings for the LPGEMM public C API
+# --------------------------------------------------------------------------
+
+#: BLIS ``dim_t``/``gint_t`` width.  A wrong width silently corrupts every
+#: argument list, so resolve it from the build that produced the library
+#: instead of guessing: the CMake cache ``INT_SIZE`` entry and the generated
+#: ``bli_config.h`` both record it.
+def _resolve_dim_type():
+    import glob
+    import re
+
+    explicit = os.environ.get("PYPTO_X_AOCL_LIB")
+    evidence = os.environ.get("PYPTO_X_VENDOR_EVIDENCE", DEFAULT_EVIDENCE)
+    roots = []
+    if explicit:
+        roots.append(os.path.dirname(os.path.dirname(os.path.abspath(explicit))))
+    roots.append(os.path.join(evidence, "install", "aocl-blis-5.3.2-zen4"))
+    roots.append(os.path.join(evidence, "build", "aocl-blis-5.3.2-zen4"))
+    for root in roots:
+        for path in glob.glob(os.path.join(root, "**", "CMakeCache.txt"), recursive=True):
+            try:
+                text = open(path, "r", encoding="utf-8", errors="replace").read()
+            except OSError:
+                continue
+            match = re.search(r"^INT_SIZE:STRING=(\d+)", text, re.MULTILINE)
+            if match:
+                bits = int(match.group(1))
+                return (
+                    ctypes.c_int64 if bits == 64 else ctypes.c_int32,
+                    "{}:INT_SIZE={}".format(path, bits),
+                )
+        for path in glob.glob(os.path.join(root, "**", "bli_config.h"), recursive=True):
+            try:
+                text = open(path, "r", encoding="utf-8", errors="replace").read()
+            except OSError:
+                continue
+            match = re.search(r"#if\s+(\d+)\s*==\s*64\s*\n\s*#define\s+BLIS_INT_TYPE_SIZE\s+64", text)
+            if match:
+                bits = int(match.group(1))
+                return (
+                    ctypes.c_int64 if bits == 64 else ctypes.c_int32,
+                    "{}:BLIS_INT_TYPE_SIZE={}".format(path, bits),
+                )
+    return ctypes.c_int64, "fallback-assumed-64bit (no build metadata found)"
+
+
+DIM_T, DIM_SOURCE = _resolve_dim_type()
+
+MAX_POST_OPS = 8
+MAX_PRE_OPS = 1
+
+AOCL_GEMM_F32 = 0
+AOCL_GEMM_BF16 = 1
+AOCL_GEMM_INT8 = 2
+AOCL_GEMM_UINT8 = 3
+AOCL_GEMM_INT4 = 4
+AOCL_GEMM_INT32 = 5
+NULLTYPE = 6
+
+SUM = 1
+ELTWISE = 2
+BIAS = 3
+SCALE = 4
+MATRIX_ADD = 5
+MATRIX_MUL = 6
+
+RELU = 0
+
+
+class AoclEltwiseAlgo(ctypes.Structure):
+    _fields_ = [("alpha", ctypes.c_void_p), ("beta", ctypes.c_void_p), ("algo_type", ctypes.c_int)]
+
+
+class AoclPostOpSum(ctypes.Structure):
+    _fields_ = [
+        ("is_power_of_2", ctypes.c_bool),
+        ("scale_factor", ctypes.c_void_p),
+        ("buff", ctypes.c_void_p),
+        ("zero_point", ctypes.c_void_p),
+        ("scale_factor_len", DIM_T),
+        ("zero_point_len", DIM_T),
+        ("zp_stor_type", ctypes.c_int),
+        ("sf_stor_type", ctypes.c_int),
+    ]
+
+
+class AoclPostOpEltwise(ctypes.Structure):
+    _fields_ = [
+        ("is_power_of_2", ctypes.c_bool),
+        ("scale_factor", ctypes.c_void_p),
+        ("scale_factor_len", DIM_T),
+        ("algo", AoclEltwiseAlgo),
+    ]
+
+
+class AoclPostOpBias(ctypes.Structure):
+    _fields_ = [("bias", ctypes.c_void_p), ("stor_type", ctypes.c_int)]
+
+
+class AoclPostOpMatrixAdd(ctypes.Structure):
+    _fields_ = [
+        ("matrix", ctypes.c_void_p),
+        ("scale_factor", ctypes.c_void_p),
+        ("scale_factor_len", DIM_T),
+        ("ldm", DIM_T),
+        ("stor_type", ctypes.c_int),
+    ]
+
+
+class AoclPostOpMatrixMul(ctypes.Structure):
+    _fields_ = [
+        ("matrix", ctypes.c_void_p),
+        ("scale_factor", ctypes.c_void_p),
+        ("scale_factor_len", DIM_T),
+        ("ldm", DIM_T),
+        ("stor_type", ctypes.c_int),
+    ]
+
+
+class AoclPreOpZp(ctypes.Structure):
+    _fields_ = [
+        ("zero_point", ctypes.c_void_p),
+        ("zero_point_len", DIM_T),
+        ("zero_point_type", ctypes.c_int),
+    ]
+
+
+class AoclPreOpSf(ctypes.Structure):
+    _fields_ = [
+        ("scale_factor", ctypes.c_void_p),
+        ("scale_factor_len", DIM_T),
+        ("scale_factor_type", ctypes.c_int),
+    ]
+
+
+class AoclPreOp(ctypes.Structure):
+    _fields_ = [
+        ("b_zp", ctypes.c_void_p),
+        ("b_scl", ctypes.c_void_p),
+        ("seq_length", DIM_T),
+        ("group_size", DIM_T),
+    ]
+
+
+class AoclGroupPostOp(ctypes.Structure):
+    _fields_ = [
+        ("group_size", DIM_T),
+        ("seq_length", DIM_T),
+        ("a_scl", ctypes.c_void_p),
+        ("b_scl", ctypes.c_void_p),
+        ("a_zp", ctypes.c_void_p),
+        ("b_zp", ctypes.c_void_p),
+    ]
+
+
+class AoclSymmStatQuant(ctypes.Structure):
+    _fields_ = [("group_size", DIM_T)]
+
+
+class AoclPostOp(ctypes.Structure):
+    _fields_ = [
+        ("sum", ctypes.POINTER(AoclPostOpSum)),
+        ("eltwise", ctypes.POINTER(AoclPostOpEltwise)),
+        ("bias", ctypes.POINTER(AoclPostOpBias)),
+        ("matrix_add", ctypes.POINTER(AoclPostOpMatrixAdd)),
+        ("matrix_mul", ctypes.POINTER(AoclPostOpMatrixMul)),
+        ("seq_length", DIM_T),
+        ("seq_vector", ctypes.POINTER(ctypes.c_int)),
+        ("pre_ops", ctypes.c_void_p),
+        ("post_op_grp", ctypes.c_void_p),
+        ("num_eltwise", DIM_T),
+    ]
+
+
+def _addr(np_array) -> ctypes.c_void_p:
+    return ctypes.c_void_p(np_array.ctypes.data)
+
+
+class Lpgemm:
+    """Thin, explicit ctypes wrapper: every call passes raw buffers."""
+
+    def __init__(self, lib_path: str):
+        self.lib_path = lib_path
+        self.lib = ctypes.CDLL(lib_path)
+        self._bind()
+
+    def _bind(self) -> None:
+        lib = self.lib
+        i8p = ctypes.POINTER(ctypes.c_int8)
+        bf16p = ctypes.POINTER(ctypes.c_uint16)
+
+        lib.aocl_gemm_s8s8s32os32.argtypes = [
+            ctypes.c_char, ctypes.c_char, ctypes.c_char,
+            DIM_T, DIM_T, DIM_T,
+            ctypes.c_int32, i8p, DIM_T, ctypes.c_char,
+            i8p, DIM_T, ctypes.c_char,
+            ctypes.c_int32, ctypes.POINTER(ctypes.c_int32), DIM_T,
+            ctypes.POINTER(AoclPostOp),
+        ]
+        lib.aocl_gemm_s8s8s32os32.restype = None
+
+        lib.aocl_gemm_s8s8s32obf16.argtypes = [
+            ctypes.c_char, ctypes.c_char, ctypes.c_char,
+            DIM_T, DIM_T, DIM_T,
+            ctypes.c_int32, i8p, DIM_T, ctypes.c_char,
+            i8p, DIM_T, ctypes.c_char,
+            ctypes.c_int32, bf16p, DIM_T,
+            ctypes.POINTER(AoclPostOp),
+        ]
+        lib.aocl_gemm_s8s8s32obf16.restype = None
+
+        lib.aocl_gemm_s8s8s32obf16_sym_quant.argtypes = list(
+            lib.aocl_gemm_s8s8s32obf16.argtypes
+        )
+        lib.aocl_gemm_s8s8s32obf16_sym_quant.restype = None
+
+        lib.aocl_gemm_bf16bf16f32obf16.argtypes = [
+            ctypes.c_char, ctypes.c_char, ctypes.c_char,
+            DIM_T, DIM_T, DIM_T,
+            ctypes.c_float, ctypes.POINTER(ctypes.c_uint16), DIM_T, ctypes.c_char,
+            ctypes.POINTER(ctypes.c_uint16), DIM_T, ctypes.c_char,
+            ctypes.c_float, bf16p, DIM_T,
+            ctypes.POINTER(AoclPostOp),
+        ]
+        lib.aocl_gemm_bf16bf16f32obf16.restype = None
+
+        lib.aocl_get_reorder_buf_size_s8s8s32os32_sym_quant.argtypes = [
+            ctypes.c_char, ctypes.c_char, ctypes.c_char,
+            DIM_T, DIM_T, ctypes.POINTER(AoclSymmStatQuant),
+        ]
+        # siz_t is uint64_t in a 64-bit-int build (bli_type_defs.h); with
+        # INT_SIZE=64 (our explicit config) that is the case.
+        lib.aocl_get_reorder_buf_size_s8s8s32os32_sym_quant.restype = ctypes.c_uint64
+
+        lib.aocl_reorder_s8s8s32os32_sym_quant.argtypes = [
+            ctypes.c_char, ctypes.c_char, ctypes.c_char,
+            i8p, i8p, DIM_T, DIM_T, DIM_T,
+            ctypes.POINTER(AoclSymmStatQuant),
+        ]
+        lib.aocl_reorder_s8s8s32os32_sym_quant.restype = None
+
+        # BLIS runtime arch query (public symbols) for the "zen4 really selected"
+        # check.
+        try:
+            lib.bli_arch_query_id.restype = ctypes.c_int
+            lib.bli_arch_query_id.argtypes = []
+            self.has_arch_query = True
+        except AttributeError:
+            self.has_arch_query = False
+        try:
+            lib.bli_arch_string.argtypes = [ctypes.c_int]
+            lib.bli_arch_string.restype = ctypes.c_char_p
+            self.has_arch_string = True
+        except AttributeError:
+            self.has_arch_string = False
+
+    # -- low level calls ---------------------------------------------------
+    def s8s8s32os32(self, a, b, m, k, n, post_op=None, alpha=1, beta=0, c=None):
+        if c is None:
+            c = np.zeros((m, n), dtype=np.int32)
+        self.lib.aocl_gemm_s8s8s32os32(
+            b"r", b"n", b"n", m, n, k, alpha,
+            a.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)), k, b"n",
+            b.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)), n, b"n",
+            beta, c.ctypes.data_as(ctypes.POINTER(ctypes.c_int32)), n,
+            post_op,
+        )
+        return c
+
+    def s8s8s32obf16(self, a, b, m, k, n, post_op=None, alpha=1, beta=0, c=None):
+        if c is None:
+            c = np.zeros((m, n), dtype=np.uint16)
+        self.lib.aocl_gemm_s8s8s32obf16(
+            b"r", b"n", b"n", m, n, k, alpha,
+            a.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)), k, b"n",
+            b.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)), n, b"n",
+            beta, c.ctypes.data_as(ctypes.POINTER(ctypes.c_uint16)), n,
+            post_op,
+        )
+        return c
+
+    def s8s8s32obf16_sym_quant(self, a, b_reordered, m, k, n, post_op, alpha=1, beta=0, c=None):
+        if c is None:
+            c = np.zeros((m, n), dtype=np.uint16)
+        self.lib.aocl_gemm_s8s8s32obf16_sym_quant(
+            b"r", b"n", b"n", m, n, k, alpha,
+            a.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)), k, b"n",
+            b_reordered.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)), n, b"r",
+            beta, c.ctypes.data_as(ctypes.POINTER(ctypes.c_uint16)), n,
+            post_op,
+        )
+        return c
+
+    # -- post-op builders --------------------------------------------------
+    @staticmethod
+    def _alloc_sum(entries):
+        """entries: list of dicts with keys scale_factor(np.float32 array) etc."""
+        buf = (AoclPostOpSum * max(1, len(entries)))()
+        keep = []
+        for index, entry in enumerate(entries):
+            node = buf[index]
+            node.is_power_of_2 = False
+            sf = entry.get("scale_factor")
+            if sf is not None:
+                sf = np.ascontiguousarray(sf, dtype=np.float32)
+                keep.append(sf)
+                node.scale_factor = _addr(sf)
+                node.scale_factor_len = int(sf.size)
+                node.sf_stor_type = AOCL_GEMM_F32
+            zp = entry.get("zero_point")
+            if zp is not None:
+                zp = np.ascontiguousarray(zp, dtype=np.float32)
+                keep.append(zp)
+                node.zero_point = _addr(zp)
+                node.zero_point_len = int(zp.size)
+                node.zp_stor_type = AOCL_GEMM_F32
+            node.buff = None
+        return buf, keep
+
+    @staticmethod
+    def make_scale_post_op(scales, zero_points=None):
+        """One SCALE post-op; scales is a 1-D fp32 array (len 1 or len n)."""
+        entries = [{"scale_factor": scales}]
+        if zero_points is not None:
+            entries[0]["zero_point"] = zero_points
+        sum_buf, keep = Lpgemm._alloc_sum(entries)
+        seq = (ctypes.c_int * 1)(SCALE)
+        post = AoclPostOp()
+        post.sum = ctypes.cast(sum_buf, ctypes.POINTER(AoclPostOpSum))
+        post.seq_length = 1
+        post.seq_vector = ctypes.cast(seq, ctypes.POINTER(ctypes.c_int))
+        post.eltwise = None
+        post.bias = None
+        post.matrix_add = None
+        post.matrix_mul = None
+        post.pre_ops = None
+        post.post_op_grp = None
+        post.num_eltwise = 0
+        return post, [sum_buf, seq, keep]
+
+    @staticmethod
+    def make_group_post_op(a_scale, b_scale, group_size, k):
+        """Single group entry: a_scale is [m, groups] fp32 (groups=1 for the
+        single-group case), b_scale is [groups, n] fp32."""
+        a_scale = np.ascontiguousarray(a_scale, dtype=np.float32)
+        b_scale = np.ascontiguousarray(b_scale, dtype=np.float32)
+        grp = AoclGroupPostOp()
+        grp.group_size = int(group_size)
+        grp.seq_length = 1
+        grp.a_scl = ctypes.cast(_addr(a_scale), ctypes.c_void_p)
+        grp.b_scl = ctypes.cast(_addr(b_scale), ctypes.c_void_p)
+        grp.a_zp = None
+        grp.b_zp = None
+        post = AoclPostOp()
+        post.sum = None
+        post.eltwise = None
+        post.bias = None
+        post.matrix_add = None
+        post.matrix_mul = None
+        post.seq_length = 0
+        post.seq_vector = None
+        post.pre_ops = None
+        post.post_op_grp = ctypes.cast(ctypes.pointer(grp), ctypes.c_void_p)
+        post.num_eltwise = 0
+        return post, [grp, a_scale, b_scale]
+
+
+# --------------------------------------------------------------------------
+# helpers
+# --------------------------------------------------------------------------
+
+
+def exact_int32_matmul(a, b):
+    """Exact integer reference via int64 accumulation (safe for our K range)."""
+    products = a.astype(np.int64) @ b.astype(np.int64)
+    return products
+
+
+def portable_qmatmul(a, b):
+    scheme = _portable()
+    result = scheme.qmatmul_s8s8_s32(
+        a.reshape(-1).tolist(), b.reshape(-1).tolist(),
+        left_shape=(a.shape[0], a.shape[1]), right_shape=(b.shape[0], b.shape[1]),
+    )
+    return np.array(result.values, dtype=np.int64).reshape(a.shape[0], b.shape[1])
+
+
+def bf16_bits_of(values) -> np.ndarray:
+    """RNE fp32 -> bf16 bit pattern, straight from the portable golden."""
+    scheme = _portable()
+    flat = np.asarray(values, dtype=np.float64).reshape(-1)
+    return np.array([scheme.bf16_rne_bits(float(v)) for v in flat], dtype=np.uint16)
+
+
+def bf16_bits_to_f32(bits: np.ndarray) -> np.ndarray:
+    bits = np.asarray(bits, dtype=np.uint32) & 0xFFFF
+    return (bits << 16).astype(np.uint32).view(np.float32)
+
+
+def portable_epilogue_bits(acc_i64, row_scales, col_scales):
+    scheme = _portable()
+    result = scheme.dequantize_epilogue_bf16(
+        acc_i64.reshape(-1).tolist(),
+        [float(s) for s in row_scales],
+        [float(s) for s in col_scales],
+        shape=(acc_i64.shape[0], acc_i64.shape[1]),
+    )
+    return np.array(result.bf16_bits, dtype=np.uint16).reshape(acc_i64.shape)
+
+
+def capture_stderr(fn, *args, **kwargs):
+    """LPGEMM prints rejection reasons to stderr via bli_print_msg; capture it."""
+    import contextlib
+    import io
+
+    buffer = io.StringIO()
+    with contextlib.redirect_stderr(buffer):
+        fn(*args, **kwargs)
+    return buffer.getvalue()
+
+
+def _small_random(rng, shape, low=-127, high=128, dtype=np.int8):
+    return rng.integers(low, high, size=shape, dtype=np.int16).astype(dtype)
+
+
+# --------------------------------------------------------------------------
+# experiments
+# --------------------------------------------------------------------------
+
+
+def e1_minimal_runnable(lpg: Lpgemm, rng) -> dict:
+    m, k, n = 2, 8, 3
+    a = _small_random(rng, (m, k))
+    b = _small_random(rng, (k, n))
+    out = lpg.s8s8s32os32(a, b, m, k, n)
+    exact = exact_int32_matmul(a, b)
+    portable = portable_qmatmul(a, b)
+    return {
+        "shape": [m, k, n],
+        "a": a.tolist(),
+        "b": b.tolist(),
+        "lpgemm_int32": out.tolist(),
+        "exact_int64": exact.tolist(),
+        "portable_golden_int32": portable.tolist(),
+        "equals_exact": bool(np.array_equal(out.astype(np.int64), exact)),
+        "equals_portable": bool(np.array_equal(out.astype(np.int64), portable)),
+        "verdict": "PASS" if np.array_equal(out.astype(np.int64), exact) else "FAIL",
+    }
+
+
+def e2_accum_width(lpg: Lpgemm, rng) -> dict:
+    """K=4096 makes the exact sum exceed 2**24 for many outputs, so an f32
+    accumulator would be inexact; an int32 one is exact."""
+    m, k, n = 4, 4096, 8
+    a = _small_random(rng, (m, k))
+    b = _small_random(rng, (k, n))
+    out = lpg.s8s8s32os32(a, b, m, k, n)
+    exact = exact_int32_matmul(a, b)
+    portable = portable_qmatmul(a, b)
+    deltas = np.abs(out.astype(np.int64) - exact)
+    return {
+        "shape": [m, k, n],
+        "max_exact_abs": int(np.abs(exact).max()),
+        "exceeds_f32_integer_range": bool(np.abs(exact).max() > 2 ** 24),
+        "max_abs_delta_vs_exact": int(deltas.max()),
+        "equals_exact": bool(deltas.max() == 0),
+        "equals_portable": bool(np.array_equal(out.astype(np.int64), portable)),
+        "verdict": "PASS_int32_exact" if deltas.max() == 0 else "FAIL",
+    }
+
+
+def e3_int32_overflow(lpg: Lpgemm, rng) -> dict:
+    """K beyond MAX_ACCUMULATOR_K with extreme codes: the portable golden
+    refuses; LPGEMM has no guard -- measure what it actually produces."""
+    scheme = _portable()
+    limit = scheme.MAX_ACCUMULATOR_K
+    k = 140000  # > 133143
+    n = 2
+    m = 1
+    a = np.full((m, k), 127, dtype=np.int8)
+    b = np.full((k, n), 127, dtype=np.int8)
+    out = lpg.s8s8s32os32(a, b, m, k, n)
+    exact = 127 * 127 * k
+    wrapped = ((exact + 2 ** 31) % 2 ** 32) - 2 ** 31
+    portable_refused = None
+    try:
+        scheme.qmatmul_s8s8_s32(
+            a.reshape(-1).tolist(), b.reshape(-1).tolist(),
+            left_shape=(m, k), right_shape=(k, n),
+        )
+        portable_refused = False
+    except Exception as exc:  # noqa: BLE001 - the point is the refusal
+        portable_refused = "{}: {}".format(type(exc).__name__, exc)
+    return {
+        "k": k,
+        "portable_max_accumulator_k": int(limit),
+        "k_exceeds_portable_limit": bool(k > limit),
+        "exact_dot": int(exact),
+        "exact_mod_2_32_signed": int(wrapped),
+        "lpgemm_int32": out[0].tolist(),
+        "lpgemm_matches_wraparound": bool(int(out[0, 0]) == wrapped == int(out[0, 1])),
+        "lpgemm_saturates_to_int32_max": bool(int(out[0, 0]) == 2 ** 31 - 1),
+        "portable_refused": portable_refused,
+        "verdict": "LPGEMM_WRAPS_NO_SATURATION"
+        if int(out[0, 0]) == wrapped
+        else "UNEXPECTED",
+    }
+
+
+def e4_reserved_code(lpg: Lpgemm) -> dict:
+    """-128 is a legal int8 for LPGEMM but reserved (fail-closed) in our
+    scheme; check whether LPGEMM silently computes with it."""
+    m, k, n = 1, 4, 1
+    a = np.full((m, k), -128, dtype=np.int8)
+    b = np.ones((k, n), dtype=np.int8)
+    out = lpg.s8s8s32os32(a, b, m, k, n)
+    exact = -128 * k
+    return {
+        "a_codes": a.reshape(-1).tolist(),
+        "b_codes": b.reshape(-1).tolist(),
+        "lpgemm_int32": out[0].tolist(),
+        "exact_int64": int(exact),
+        "accepted_reserved_code": bool(int(out[0, 0]) == exact),
+        "verdict": "LPGEMM_ACCEPTS_-128" if int(out[0, 0]) == exact else "LPGEMM_REJECTS_-128",
+    }
+
+
+def e5_scale_post_op_granularity(lpg: Lpgemm, rng) -> dict:
+    m, k, n = 3, 64, 32
+    a = _small_random(rng, (m, k))
+    b = _small_random(rng, (k, n))
+    acc = exact_int32_matmul(a, b)
+
+    col_scales = (rng.random(n).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+    tensor_scale = np.ones(1, dtype=np.float32) * 0.75
+
+    result = {"shape": [m, k, n]}
+
+    # (a) per-tensor SCALE (len 1)
+    post, keep = Lpgemm.make_scale_post_op(tensor_scale)
+    out_tensor = lpg.s8s8s32obf16(a, b, m, k, n, post_op=post)
+    ref_tensor = portable_epilogue_bits(
+        acc, [1.0] * m, [float(tensor_scale[0])] * n
+    )
+    result["per_tensor_len1"] = {
+        "scale": float(tensor_scale[0]),
+        "accepted": True,
+        "bitwise_equal_portable": bool(np.array_equal(out_tensor, ref_tensor)),
+        "mismatch_count": int((out_tensor != ref_tensor).sum()),
+    }
+
+    # (b) per-column SCALE (len n)
+    post, keep = Lpgemm.make_scale_post_op(col_scales)
+    out_col = lpg.s8s8s32obf16(a, b, m, k, n, post_op=post)
+    ref_col = portable_epilogue_bits(acc, [1.0] * m, col_scales.tolist())
+    result["per_column_len_n"] = {
+        "accepted": True,
+        "bitwise_equal_portable": bool(np.array_equal(out_col, ref_col)),
+        "mismatch_count": int((out_col != ref_col).sum()),
+        "elements": int(out_col.size),
+    }
+
+    # (c) per-row SCALE (len m) -- expected rejection by the post-op parser
+    row_scales = (rng.random(m).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+    post, keep = Lpgemm.make_scale_post_op(row_scales)
+    sentinel = np.full((m, n), 0xBEEF, dtype=np.uint16)
+    err = capture_stderr(lpg.s8s8s32obf16, a, b, m, k, n, post_op=post, c=sentinel)
+    result["per_row_len_m"] = {
+        "scale_len": int(row_scales.size),
+        "stderr": err.strip(),
+        "output_untouched": bool(np.all(sentinel == 0xBEEF)),
+        "rejected": bool(np.all(sentinel == 0xBEEF) or "scale factor length is < n" in err),
+    }
+
+    # (d) combine: per-column scale + bf16 output rounding for a tie case is E6
+    return result
+
+
+def e6_bf16_rounding(lpg: Lpgemm) -> dict:
+    """Deliberate tie case.
+
+    For values in [2**20, 2**21) the bf16 ulp is 2**13 = 8192 (bf16 stores 7
+    explicit mantissa bits), so the tie value 2**20 + 8192 + 4096 = 1060864
+    sits exactly between 1056768 (k=1, odd multiple of the ulp) and 1064960
+    (k=2, even multiple).  RNE must pick the even one, 1064960; truncation
+    toward zero would keep 1056768 -- one integer accumulator therefore
+    distinguishes the two policies without involving any scale.
+    """
+    base, ulp = 2 ** 20, 2 ** 13
+    lower, target, upper = base + ulp, base + ulp + ulp // 2, base + 2 * ulp
+    m, n = 1, 1
+    full, remainder = divmod(target, 127)
+    codes = [127] * full + ([remainder] if remainder else [])
+    k = len(codes)
+    a = np.ones((m, k), dtype=np.int8)
+    b = np.array(codes, dtype=np.int8).reshape(k, n)
+    exact = int(a.astype(np.int64) @ b.astype(np.int64))
+    out = lpg.s8s8s32obf16(a, b, m, k, n)
+    bits = int(out[0, 0])
+    value = float(bf16_bits_to_f32(np.array([bits], dtype=np.uint16))[0])
+    scheme = _portable()
+    rne_bits = int(scheme.bf16_rne_bits(float(target)))
+    return {
+        "target_exact": target,
+        "constructed_exact": exact,
+        "construction_ok": bool(exact == target),
+        "k": k,
+        "tie_lower_odd_multiple": lower,
+        "tie_upper_even_multiple": upper,
+        "lpgemm_bf16_bits": bits,
+        "lpgemm_bf16_value": value,
+        "rne_expected_bits": rne_bits,
+        "portable_matches": bool(bits == rne_bits),
+        "verdict": (
+            "RNE"
+            if bits == rne_bits and value == upper
+            else ("TRUNCATE" if value == lower else "OTHER")
+        ),
+    }
+
+
+def e7_sym_quant_single_group(lpg: Lpgemm, rng, m=3, k=64, n=32) -> dict:
+    """Single group (group_size=k) sym_quant: per-row A scale (m x 1) and
+    per-column B scale (1 x n), i.e. our per-token x per-channel epilogue."""
+    a = _small_random(rng, (m, k))
+    b = _small_random(rng, (k, n))
+    acc = exact_int32_matmul(a, b)
+    row_scales = (rng.random(m).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+    col_scales = (rng.random(n).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+
+    meta = AoclSymmStatQuant(group_size=k)
+    size = int(lpg.lib.aocl_get_reorder_buf_size_s8s8s32os32_sym_quant(
+        b"r", b"n", b"b", k, n, ctypes.pointer(meta)))
+    reordered = np.zeros(max(size, 1), dtype=np.int8)
+    with_bits = b.tobytes()
+    lpg.lib.aocl_reorder_s8s8s32os32_sym_quant(
+        b"r", b"n", b"b",
+        np.frombuffer(with_bits, dtype=np.int8).ctypes.data_as(ctypes.POINTER(ctypes.c_int8)),
+        reordered.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)),
+        k, n, n, ctypes.pointer(meta),
+    )
+
+    # A scale layout is [m][groups] row-major, B scale layout is [groups][n].
+    a_scale = row_scales.reshape(m, 1).astype(np.float32)
+    b_scale = col_scales.reshape(1, n).astype(np.float32)
+    post, keep = Lpgemm.make_group_post_op(a_scale, b_scale, k, k)
+
+    sentinel = np.full((m, n), 0xBEEF, dtype=np.uint16)
+    err = capture_stderr(
+        lpg.s8s8s32obf16_sym_quant, a, reordered, m, k, n, post, 1, 0, sentinel
+    )
+    produced = not np.all(sentinel == 0xBEEF)
+    reference = portable_epilogue_bits(acc, row_scales.tolist(), col_scales.tolist())
+    result = {
+        "shape": [m, k, n],
+        "reorder_buf_size_bytes": size,
+        "stderr": err.strip(),
+        "call_produced_output": bool(produced),
+        "portable_reference_bits_head": reference.reshape(-1)[:8].tolist(),
+    }
+    if produced:
+        mismatch = sentinel != reference
+        diff = np.abs(
+            bf16_bits_to_f32(sentinel).astype(np.float64)
+            - bf16_bits_to_f32(reference).astype(np.float64)
+        )
+        result.update(
+            {
+                "bitwise_equal_portable": bool(not mismatch.any()),
+                "mismatch_count": int(mismatch.sum()),
+                "elements": int(sentinel.size),
+                "max_abs_diff_bf16": float(diff.max()),
+            }
+        )
+    else:
+        result["failure"] = "sym_quant call did not write the output buffer"
+    return result
+
+
+def e7b_sym_quant_multi_group(lpg: Lpgemm, rng, m=3, k=128, n=32, group_size=32) -> dict:
+    """Multi-group sym_quant layout + arithmetic proof.
+
+    Source reading says A scales are laid out ``[m][num_groups]`` and B scales
+    ``[groups][n]``, and that the per-group partial from int32 is scaled as
+    ``acc += (f32(partial) * b_scl) * a_scl`` in binary32 with one rounding per
+    multiply and per add.  This experiment builds *distinct* per-group scales,
+    models that exact arithmetic in Python from the exact integer partials, and
+    compares the emitted bf16 bits.  A full bit match pins both the layout and
+    the arithmetic order.
+    """
+    scheme = _portable()
+    f32 = scheme.float32_round
+    num_groups = k // group_size
+    a = _small_random(rng, (m, k))
+    b = _small_random(rng, (k, n))
+    a_scale = (rng.random((m, num_groups)).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+    b_scale = (rng.random((num_groups, n)).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+
+    partials = np.zeros((num_groups, m, n), dtype=np.int64)
+    for group in range(num_groups):
+        partials[group] = exact_int32_matmul(
+            a[:, group * group_size:(group + 1) * group_size],
+            b[group * group_size:(group + 1) * group_size, :],
+        )
+
+    modelled = np.zeros((m, n), dtype=np.uint16)
+    for i in range(m):
+        for j in range(n):
+            acc = 0.0
+            for group in range(num_groups):
+                step = f32(f32(float(partials[group, i, j])) * float(b_scale[group, j]))
+                step = f32(step * float(a_scale[i, group]))
+                acc = f32(acc + step)
+            modelled[i, j] = scheme.bf16_rne_bits(acc)
+
+    meta = AoclSymmStatQuant(group_size=group_size)
+    size = int(
+        lpg.lib.aocl_get_reorder_buf_size_s8s8s32os32_sym_quant(
+            b"r", b"n", b"b", k, n, ctypes.pointer(meta)
+        )
+    )
+    reordered = np.zeros(max(size, 1), dtype=np.int8)
+    lpg.lib.aocl_reorder_s8s8s32os32_sym_quant(
+        b"r", b"n", b"b",
+        np.ascontiguousarray(b).ctypes.data_as(ctypes.POINTER(ctypes.c_int8)),
+        reordered.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)),
+        k, n, n, ctypes.pointer(meta),
+    )
+    post, keep = Lpgemm.make_group_post_op(a_scale, b_scale, group_size, k)
+    sentinel = np.full((m, n), 0xBEEF, dtype=np.uint16)
+    err = capture_stderr(
+        lpg.s8s8s32obf16_sym_quant, np.ascontiguousarray(a), reordered, m, k, n, post, 1, 0,
+        sentinel,
+    )
+    produced = not np.all(sentinel == 0xBEEF)
+    result = {
+        "shape": [m, k, n],
+        "group_size": group_size,
+        "num_groups": num_groups,
+        "stderr": err.strip(),
+        "produced_output": bool(produced),
+    }
+    if produced:
+        mismatch = sentinel != modelled
+        result.update(
+            {
+                "bitwise_equal_modelled": bool(not mismatch.any()),
+                "mismatch_count": int(mismatch.sum()),
+                "elements": int(sentinel.size),
+            }
+        )
+    return result
+
+
+def e8_runtime_arch(lpg: Lpgemm) -> dict:
+    result = {"library": lpg.lib_path}
+    if lpg.has_arch_query:
+        arch_id = int(lpg.lib.bli_arch_query_id())
+        result["bli_arch_query_id"] = arch_id
+        if lpg.has_arch_string:
+            name = lpg.lib.bli_arch_string(arch_id)
+            result["bli_arch_string"] = name.decode() if name else None
+    else:
+        result["error"] = "bli_arch_query_id not exported"
+    result["env"] = {
+        key: os.environ.get(key)
+        for key in ("BLIS_ARCH_TYPE", "AOCL_ENABLE_INSTRUCTIONS", "BLIS_MODEL_TYPE")
+        if os.environ.get(key) is not None
+    }
+    return result
+
+
+def e9_imported_symbols(lib_path: str) -> dict:
+    nm = subprocess.run(
+        ["nm", "--defined-only", "-D", lib_path], capture_output=True, text=True, check=False
+    )
+    symbols = nm.stdout.splitlines()
+    aocl = [line.split()[-1] for line in symbols if "aocl_gemm_" in line]
+    return {
+        "aocl_gemm_export_count": len(aocl),
+        "symbols_head": sorted(aocl)[:20],
+        "has_sym_quant_bf16": "aocl_gemm_s8s8s32obf16_sym_quant" in aocl,
+        "has_bf16bf16f32obf16": "aocl_gemm_bf16bf16f32obf16" in aocl,
+        "has_reorder_sym_quant": "aocl_reorder_s8s8s32os32_sym_quant" in aocl,
+    }
+
+
+def find_default_lib() -> str:
+    configured = os.environ.get("PYPTO_X_AOCL_LIB")
+    if configured:
+        return configured
+    evidence = os.environ.get("PYPTO_X_VENDOR_EVIDENCE", DEFAULT_EVIDENCE)
+    install = os.path.join(evidence, "install", "aocl-blis-5.3.2-zen4")
+    for root, _dirs, files in os.walk(install):
+        for name in sorted(files):
+            if name.startswith("libblis-mt.so"):
+                return os.path.join(root, name)
+    raise SystemExit("AOCL library not found; pass PYPTO_X_AOCL_LIB")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--lib", default=None)
+    parser.add_argument("--seed", type=int, default=20260911)
+    args = parser.parse_args()
+
+    lib_path = args.lib or find_default_lib()
+    rng = np.random.default_rng(args.seed)
+    lpg = Lpgemm(lib_path)
+
+    report = {
+        "tag": "q8-aocl-semantics-probe",
+        "started_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "host": {
+            "platform": platform.platform(),
+            "python": sys.version.split()[0],
+            "numpy": np.__version__,
+        },
+        "library": lib_path,
+        "seed": args.seed,
+        "experiments": {},
+    }
+
+    for name, fn in (
+        ("E1_minimal_runnable", lambda: e1_minimal_runnable(lpg, rng)),
+        ("E2_accum_width", lambda: e2_accum_width(lpg, rng)),
+        ("E3_int32_overflow", lambda: e3_int32_overflow(lpg, rng)),
+        ("E4_reserved_code", lambda: e4_reserved_code(lpg)),
+        ("E5_scale_post_op_granularity", lambda: e5_scale_post_op_granularity(lpg, rng)),
+        ("E6_bf16_rounding", lambda: e6_bf16_rounding(lpg)),
+        ("E7_sym_quant_single_group", lambda: e7_sym_quant_single_group(lpg, rng)),
+        ("E7b_sym_quant_multi_group_layout", lambda: e7b_sym_quant_multi_group(lpg, rng)),
+        ("E8_runtime_arch", lambda: e8_runtime_arch(lpg)),
+        ("E9_imported_symbols", lambda: e9_imported_symbols(lib_path)),
+    ):
+        started = time.time()
+        try:
+            value = fn()
+        except Exception as exc:  # noqa: BLE001 - each experiment is independent
+            value = {"error": "{}: {}".format(type(exc).__name__, exc)}
+        value["_seconds"] = round(time.time() - started, 4)
+        report["experiments"][name] = value
+        print("[{}] {}".format(name, json.dumps(value, ensure_ascii=False)[:240]))
+
+    with open(args.output, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, ensure_ascii=False)
+        handle.write("\n")
+    print("report: {}".format(args.output))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
