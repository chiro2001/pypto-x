+                layers[(m, k, n)] = layer
+            providers["onednn_bf16"] = {"available": True}
+        except Exception as exc:  # noqa: BLE001
+            providers["onednn_bf16"] = {"unavailable": "{}: {}".format(type(exc).__name__, exc)}
+
+    packed_handles = {}
+    if not args.skip_ours_bf16:
+        try:
+            if args.skip_onednn or "unavailable" in providers.get("onednn_bf16", {}):
+                # the W8J bridge is independent of vLLM; import only what it needs
+                pass
