+#!/usr/bin/env bash
+# Q8 / vendor-gemm-survey: run one heavy command through run_local_heavy.sh,
+# retrying while the global `local` lock is busy (75) or admission is denied (69).
+#
+# The local lock is shared with other pypto-x tasks (b6-layout-native,
+# c8-w8a8-reference-gold, ...), so this wrapper must be launched detached from
+# the agent session and must never busy-spin in the foreground:
+#
+#   setsid nohup scripts/vendor/run_heavy_with_retry.sh \
+#       --task vendor-gemm-survey --agent <agent> --log <log> -- <command...>
+#
+# Exit code is the wrapped command's code (0 on success); look at the log for
+# per-attempt timestamps and the runner exit codes.
+set -u
+
+usage() {
+    printf '%s\n' \
+        'usage: run_heavy_with_retry.sh --task <task> --agent <agent> --log <path> [--sleep <s>] -- <command> [args...]' >&2
+    exit 64
+}
+
+TASK=
+AGENT=
+LOG=
+SLEEP=60
+while [[ $# -gt 0 && $1 != -- ]]; do
+    case $1 in
+        --task) [[ $# -ge 2 ]] || usage; TASK=$2; shift 2 ;;
+        --agent) [[ $# -ge 2 ]] || usage; AGENT=$2; shift 2 ;;
+        --log) [[ $# -ge 2 ]] || usage; LOG=$2; shift 2 ;;
+        --sleep) [[ $# -ge 2 ]] || usage; SLEEP=$2; shift 2 ;;
+        *) usage ;;
+    esac
+done
+[[ $# -gt 1 && $1 == -- ]] || usage
+shift
+[[ -n "${TASK}" && -n "${AGENT}" && -n "${LOG}" ]] || usage
+
+RUNNER=${PYPTO_X_LOCAL_HEAVY_RUNNER:-/home/chiro/projects/pypto/pypto_x/scripts/resource/run_local_heavy.sh}
+[[ -x ${RUNNER} ]] || { printf 'heavy runner not executable: %s\n' "${RUNNER}" >&2; exit 69; }
+mkdir -p -- "$(dirname -- "${LOG}")"
+
+attempt=0
+while true; do
+    attempt=$((attempt + 1))
+    printf '=== attempt=%d utc=%s ===\n' "${attempt}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"${LOG}"
+    "${RUNNER}" --task "${TASK}" --agent "${AGENT}" -- "$@" >>"${LOG}" 2>&1
+    rc=$?
+    printf '=== runner_exit=%d attempt=%d utc=%s ===\n' "${rc}" "${attempt}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"${LOG}"
+    if [ "${rc}" -ne 75 ] && [ "${rc}" -ne 69 ]; then
+        exit "${rc}"
+    fi
+    sleep "${SLEEP}"
+done
