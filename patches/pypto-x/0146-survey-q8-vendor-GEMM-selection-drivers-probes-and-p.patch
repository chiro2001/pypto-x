+                x.contiguous().view(torch.uint16).numpy().tobytes()
+                + w.contiguous().view(torch.uint16).numpy().tobytes()
+                for _m, _k, _n, _label, x, w in prepared
+            )
+        ).hexdigest(),
+        "note": "sha256 over concatenated bf16 operand bytes of all 12 shapes",
+    }
+
+    # -- int8 codes from the frozen contract quantizers ---------------------
+    int8_inputs = {}
+    for m, k, n, label, x, weight in prepared:
