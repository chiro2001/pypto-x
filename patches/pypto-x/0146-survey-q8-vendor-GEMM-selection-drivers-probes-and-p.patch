@@ -0,0 +1,257 @@
+#!/usr/bin/env bash
+# Q8 / vendor-gemm-survey: build the AOCL-BLIS LPGEMM addon from source with an
+# *explicit* Zen4 configuration (no runtime arch autodetection, no generic fallback).
+#
+# Why explicit: the local x86 host is a Zen4 engineering sample (family 25 model
+# 116).  The user decision (configs/development_lock.yaml
+# waves.W8.vendor_gemm_decision_2026_09_11.aocl_probe_2026_09_11.build_decision)
+# forbids letting runtime detection guess Zen5 or fall back to `generic`.
+#
+# Build path: BLIS's classic `./configure` + `make` (not CMake).  The CMake
+# project() declares Fortran unconditionally (CMakeLists.txt:39) and no native
+# x86 Fortran compiler exists on this host; the classic path only uses FC
+# optionally (for --complex-return detection) and its Makefile has first-class
+# `aocl_gemm` addon handling, including the `-DBLIS_ADDON_LPGEMM` kernel wiring
+# through the generated `bli_addon.h`.
+#
+# Heavy: this script must only be run through scripts/resource/run_local_heavy.sh
+# (scripts/vendor/run_heavy_with_retry.sh does exactly that, retrying on
+# resource-lock exit codes 75 BUSY / 69 admission-denied).
+#
+# Reproducibility contract (all recorded into raw/aocl-build-report.json):
+#   * source: https://github.com/amd/blis, tag 5.3.2, commit recorded at fetch time
+#   * full configure + make command lines, compiler versions, host cpu flags
+#   * wall-clock durations for configure / build / install
+#   * sha256 of every shipped file in the install tree
+#   * symbol evidence: exported aocl_gemm_* surface and the linked zen4 kernels
+set -euo pipefail
+
+EVIDENCE_ROOT=${PYPTO_X_VENDOR_EVIDENCE:-/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey}
+SRC=${PYPTO_X_AOCL_SRC:-"${EVIDENCE_ROOT}/src/blis-5.3.2"}
+INSTALL_DIR=${PYPTO_X_AOCL_INSTALL:-"${EVIDENCE_ROOT}/install/aocl-blis-5.3.2-zen4"}
+JOBS=${PYPTO_X_AOCL_JOBS:-6}
+REPO_URL=${PYPTO_X_AOCL_REPO:-https://github.com/amd/blis}
+REPO_TAG=${PYPTO_X_AOCL_TAG:-5.3.2}
+BLIS_CONFIG=${PYPTO_X_AOCL_CONFIG:-zen4}
+
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+mkdir -p "${EVIDENCE_ROOT}/logs" "${EVIDENCE_ROOT}/raw"
+BUILD_LOG="${EVIDENCE_ROOT}/logs/aocl-build-${STAMP}.log"
+REPORT_JSON="${EVIDENCE_ROOT}/raw/aocl-build-report.json"
+
+exec > >(tee -a "${BUILD_LOG}") 2>&1
+log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
+
+log "=== Q8 AOCL/LPGEMM Zen4 build start stamp=${STAMP} ==="
+log "repo=${REPO_URL} tag=${REPO_TAG} config=${BLIS_CONFIG}"
+log "src=${SRC}"
+log "install_dir=${INSTALL_DIR}"
+log "jobs=${JOBS}"
+
+# ---------------------------------------------------------------- fetch (light)
+if [ ! -d "${SRC}/.git" ]; then
+    log "source tree missing; shallow-cloning ${REPO_URL} at tag ${REPO_TAG}"
+    rm -rf "${SRC}"
+    mkdir -p "$(dirname -- "${SRC}")"
+    git clone --depth 1 --branch "${REPO_TAG}" "${REPO_URL}" "${SRC}"
+else
+    log "source tree already present at ${SRC}; reusing (commit pinned by report)"
+fi
+
+SRC_COMMIT=$(git -C "${SRC}" rev-parse HEAD)
+SRC_DESCRIBE=$(git -C "${SRC}" describe --tags --always 2>/dev/null || true)
+SRC_COMMIT_DATE=$(git -C "${SRC}" log -1 --format=%cI)
+SRC_DIRTY=$(git -C "${SRC}" status --porcelain | head -5 || true)
+log "source commit=${SRC_COMMIT} describe=${SRC_DESCRIBE} commit_date=${SRC_COMMIT_DATE}"
+if [ -n "${SRC_DIRTY}" ]; then
+    log "note: source tree has build residue (configure output), first lines:"
+    printf '%s\n' "${SRC_DIRTY}" | sed 's/^/  /'
+fi
+
+# ------------------------------------------------------------- toolchain facts
+GCC_VERSION=$(gcc --version | head -1)
+GXX_VERSION=$(g++ --version | head -1)
+MAKE_VERSION=$(make --version | head -1)
+NPROC=$(nproc)
+CPU_MODEL=$(awk -F': ' '/^model name/ {print $2; exit}' /proc/cpuinfo)
+CPU_FAMILY=$(awk -F': ' '/^cpu family/ {print $2; exit}' /proc/cpuinfo)
+CPU_MODEL_ID=$(awk -F': ' '/^model[[:space:]]*:/ {print $2; exit}' /proc/cpuinfo)
+CPU_FLAGS=$(awk -F': ' '/^flags/ {print $2; exit}' /proc/cpuinfo)
+log "gcc=${GCC_VERSION}"
+log "make=${MAKE_VERSION}"
+log "cpu model=${CPU_MODEL} family=${CPU_FAMILY} model_id=${CPU_MODEL_ID}"
+for flag in avx512_bf16 avx512_vnni avx512f avx512bw avx512vl avx512fp16 amx_int8; do
+    if grep -qw -- "${flag}" <<<"${CPU_FLAGS}"; then
+        log "cpu flag ${flag}=present"
+    else
+        log "cpu flag ${flag}=absent"
+    fi
+done
+
+# ------------------------------------------------------------------- configure
+CONFIGURE_ARGS=(
+    "--prefix=${INSTALL_DIR}"
+    --enable-cblas
+    --enable-threading=openmp
+    --enable-addon=aocl_gemm
+    # dim_t (BLIS gint_t) = 64 bit: the width the LPGEMM addon API is documented
+    # against (int64_t dims in aocl_gemm_interface_apis.h) and the AOCL default.
+    # BLAS ints stay 32 so CBLAS keeps the LP64 convention used by every other
+    # library on this host (torch, oneDNN, system BLAS).
+    --int-size=64
+    --blas-int-size=32
+    # Explicit single-config build: forbid BLIS_ARCH_TYPE / AOCL_ENABLE_INSTRUCTIONS
+    # / BLIS_MODEL_TYPE from steering the runtime code path.
+    --disable-blis-arch-type
+    "${BLIS_CONFIG}"
+)
+cd "${SRC}"
+log "configure: CC=gcc CXX=g++ ./configure ${CONFIGURE_ARGS[*]}"
+t0=$(date +%s)
+CC=gcc CXX=g++ ./configure "${CONFIGURE_ARGS[@]}"
+t_configure=$(( $(date +%s) - t0 ))
+log "configure done in ${t_configure}s"
+
+# Machine-readable proof of the *explicit* configuration choices baked into the
+# build: generated bli_config.h (single config + kernel set + dim_t width) and
+# bli_addon.h (addon enabled + which addon header is included).
+CONFIG_HEADER="${SRC}/bli_config.h"
+ADDON_HEADER="${SRC}/bli_addon.h"
+CONFIG_EVIDENCE=$(
+    grep -E '^#define (BLIS_CONFIG_|BLIS_KERNELS_)' "${CONFIG_HEADER}" | tr '\n' ' ' || true
+)
+INT_TYPE_EVIDENCE=$(
+    sed -n '/BLIS_INT_TYPE_SIZE/p; /BLIS_BLAS_INT_TYPE_SIZE/p' "${CONFIG_HEADER}" | tr '\n' ' ' || true
+)
+ACTIVE_INT_LINE=$(grep -n -A2 -m1 'if 64 == 64' "${CONFIG_HEADER}" | tr '\n' ' ' || true)
+ADDON_EVIDENCE=$(grep -E '^#define BLIS_(EN|DIS)ABLE_ADDONS|^#include' "${ADDON_HEADER}" | tr '\n' ' ' || true)
+log "bli_config.h: ${CONFIG_EVIDENCE}"
+log "bli_config.h guard: ${ACTIVE_INT_LINE}"
+log "bli_addon.h: ${ADDON_EVIDENCE}"
+
+# ----------------------------------------------------------------------- build
+log "build: make -j${JOBS}"
+t0=$(date +%s)
+make -j"${JOBS}"
+t_build=$(( $(date +%s) - t0 ))
+log "build done in ${t_build}s"
+
+# --------------------------------------------------------------------- install
+log "install: make install"
+t0=$(date +%s)
+make install
+t_install=$(( $(date +%s) - t0 ))
+log "install done in ${t_install}s"
+
+# ------------------------------------------------------------------- evidence
+ARTIFACT_JSON=$(python3 - "${INSTALL_DIR}" <<'PY'
+import hashlib, json, os, sys
+root = sys.argv[1]
+out = []
+for dirpath, _dirnames, filenames in os.walk(root):
+    for name in sorted(filenames):
+        path = os.path.join(dirpath, name)
+        if os.path.islink(path):
+            out.append({"path": os.path.relpath(path, root), "symlink": os.readlink(path)})
+            continue
+        h = hashlib.sha256()
+        with open(path, "rb") as fh:
+            for chunk in iter(lambda: fh.read(1 << 20), b""):
+                h.update(chunk)
+        out.append({
+            "path": os.path.relpath(path, root),
+            "bytes": os.path.getsize(path),
+            "sha256": h.hexdigest(),
+        })
+print(json.dumps(out))
+PY
+)
+
+LIB_CANDIDATES=$(find "${INSTALL_DIR}" \( -type f -o -type l \) -name 'libblis*.so*' 2>/dev/null | sort | tr '\n' ' ' || true)
+log "shared libraries: ${LIB_CANDIDATES}"
+MAIN_LIB=$(find "${INSTALL_DIR}" -type f -name 'libblis-mt.so.*' | sort | head -1 || true)
+[ -n "${MAIN_LIB}" ] || MAIN_LIB=$(find "${INSTALL_DIR}" -type f -name 'libblis.so.*' | sort | head -1 || true)
+[ -n "${MAIN_LIB}" ] || MAIN_LIB=$(find "${INSTALL_DIR}" \( -type f -o -type l \) -name 'libblis-mt.so*' | sort | head -1 || true)
+log "main library: ${MAIN_LIB}"
+MAIN_LIB_SHA=$(sha256sum "${MAIN_LIB}" | awk '{print $1}' || true)
+MAIN_LIB_BYTES=$(stat -c %s "${MAIN_LIB}" || true)
+log "main library sha256=${MAIN_LIB_SHA} bytes=${MAIN_LIB_BYTES}"
+
+AOCL_SYMBOL_COUNT=0
+AOCL_MATMUL_SYMBOLS=""
+ZEN4_KERNEL_SYMBOLS=""
+if [ -n "${MAIN_LIB}" ]; then
+    AOCL_SYMBOL_COUNT=$(nm -D --defined-only "${MAIN_LIB}" | grep -c 'aocl_gemm_' || true)
+    AOCL_MATMUL_SYMBOLS=$(nm -D --defined-only "${MAIN_LIB}" | grep 'AOCL_GEMM_MATMUL' | head -20 || true)
+    ZEN4_KERNEL_SYMBOLS=$(nm --defined-only "${MAIN_LIB}" 2>/dev/null | grep -i 'zen4' | head -20 || true)
+    log "exported aocl_gemm_* symbols: ${AOCL_SYMBOL_COUNT}"
+    log "AOCL_GEMM_MATMUL* symbols (first 20):"
+    printf '%s\n' "${AOCL_MATMUL_SYMBOLS}" | sed 's/^/  /'
+    log "zen4-named defined symbols (first 20):"
+    printf '%s\n' "${ZEN4_KERNEL_SYMBOLS}" | sed 's/^/  /'
+    log "vpdpbusd occurrences in disassembly (VNNI evidence):"
+    objdump -d "${MAIN_LIB}" 2>/dev/null | grep -c 'vpdpbusd' | sed 's/^/  count=/'
+    log "lpgemm s8 kernel object evidence in build tree:"
+    find "${SRC}/obj" -path '*zen4*s8s8s32*' -name '*.o' 2>/dev/null | head -8 | sed 's/^/  /'
+fi
+
+python3 - "${REPORT_JSON}" <<PY
+import json
+report = {
+    "tag": "q8-aocl-lpgemm-zen4-build",
+    "stamp_utc": "${STAMP}",
+    "repo_url": "${REPO_URL}",
+    "repo_tag": "${REPO_TAG}",
+    "blis_config": "${BLIS_CONFIG}",
+    "src_commit": "${SRC_COMMIT}",
+    "src_describe": "${SRC_DESCRIBE}",
+    "src_commit_date": "${SRC_COMMIT_DATE}",
+    "src_path": "${SRC}",
+    "install_dir": "${INSTALL_DIR}",
+    "configure_command": "CC=gcc CXX=g++ ./configure ${CONFIGURE_ARGS[*]}",
+    "build_command": "make -j${JOBS}",
+    "install_command": "make install",
+    "jobs": int("${JOBS}"),
+    "toolchain": {
+        "gcc": "${GCC_VERSION}",
+        "gxx": "${GXX_VERSION}",
+        "make": "${MAKE_VERSION}",
+        "nproc": int("${NPROC}"),
+    },
+    "host_cpu": {
+        "model": "${CPU_MODEL}",
+        "family": "${CPU_FAMILY}",
+        "model_id": "${CPU_MODEL_ID}",
+        "flags": "${CPU_FLAGS}".split(),
+    },
+    "durations_s": {
+        "configure": ${t_configure},
+        "build": ${t_build},
+        "install": ${t_install},
+    },
+    "generated_config_evidence": {
+        "config_header": "${CONFIG_HEADER}",
+        "addon_header": "${ADDON_HEADER}",
+        "config_defines": "${CONFIG_EVIDENCE}",
+        "int_type_defines": "${INT_TYPE_EVIDENCE}",
+        "int_guard_line": "${ACTIVE_INT_LINE}",
+        "addon_defines": "${ADDON_EVIDENCE}",
+    },
+    "main_library": {
+        "path": "${MAIN_LIB}",
+        "sha256": "${MAIN_LIB_SHA}",
+        "bytes": "${MAIN_LIB_BYTES}",
+    },
+    "artifacts": json.loads(r'''${ARTIFACT_JSON}'''),
+    "aocl_gemm_export_count": int("${AOCL_SYMBOL_COUNT}" or 0),
+    "aocl_gemm_matmul_symbols": [s for s in r'''${AOCL_MATMUL_SYMBOLS}'''.splitlines() if s.strip()],
+    "zen4_named_symbols": [s for s in r'''${ZEN4_KERNEL_SYMBOLS}'''.splitlines() if s.strip()],
+    "build_log": "${BUILD_LOG}",
+}
+with open("${REPORT_JSON}", "w", encoding="utf-8") as fh:
+    json.dump(report, fh, indent=2, ensure_ascii=False)
+    fh.write("\n")
+print("report written to ${REPORT_JSON}")
+PY
+
+log "=== Q8 AOCL/LPGEMM Zen4 build done (configure=${t_configure}s build=${t_build}s install=${t_install}s) ==="
diff --git a/scripts/vendor/q8_perf_matrix_heavy.sh b/scripts/vendor/q8_perf_matrix_heavy.sh
