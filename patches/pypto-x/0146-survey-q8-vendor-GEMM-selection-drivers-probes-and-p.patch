+#!/usr/bin/env bash
+# Q8 / vendor-gemm-survey stage 2: run the four-way GEMM matrix and the
+# W8A8 semantics/parity probes inside the local heavy lock.
+#
+#   scripts/resource/run_local_heavy.sh --task vendor-gemm-survey --agent ... -- \
+#       scripts/vendor/q8_perf_matrix_heavy.sh --rounds 5
+#
+# The probes run first (cheap, they only need the built library) so their JSON
+# is on disk even if the long benchmark later fails.
+set -euo pipefail
+
+WT=${PYPTO_X_VENDOR_WORKTREE:-/home/chiro/projects/pypto/worktrees/pypto-x/vendor-gemm-survey}
+EV=${PYPTO_X_VENDOR_EVIDENCE:-/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey}
+PY=${PYPTO_X_W8J_PYTHON:-/home/chiro/miniforge3/envs/pypto-x-w8j/bin/python}
+PY_SYS=${PYPTO_X_SYS_PYTHON:-python3}
+
+export PYPTO_X_VENDOR_EVIDENCE="${EV}"
+export PYPTO_X_WORKTREE="${WT}"
+mkdir -p "${EV}/raw" "${EV}/logs"
+
+LIB=$(find "${EV}/install/aocl-blis-5.3.2-zen4" -name 'libblis-mt.so*' -type f 2>/dev/null | head -1 || true)
+[[ -n "${LIB}" ]] || { echo "AOCL library not found under ${EV}/install" >&2; exit 66; }
