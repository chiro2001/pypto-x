+        with open("/proc/loadavg", "r", encoding="utf-8") as handle:
+            fields = handle.read().split()
+        noise["load1"] = float(fields[0])
+        noise["runnable"] = int(fields[3].split("/")[0])
+    except (OSError, ValueError, IndexError):
+        pass
+    try:
+        with open("/proc/pressure/cpu", "r", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("some "):
+                    for token in line.split():
+                        if token.startswith("avg10="):
+                            noise["cpu_psi_avg10"] = float(token.split("=")[1])
+    except (OSError, ValueError):
+        pass
+    try:
+        with open("/proc/meminfo", "r", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("MemAvailable:"):
+                    noise["available_mib"] = int(line.split()[1]) // 1024
+                    break
+    except (OSError, ValueError, IndexError):
+        pass
+    try:
+        noise["cpufreq_available"] = os.path.exists("/sys/devices/system/cpu/cpu0/cpufreq")
