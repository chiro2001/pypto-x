+#!/usr/bin/env python3
+"""Q8 / vendor-gemm-survey: W8A8 bit-level parity probe (AOCL vs our contract).
+
+Answers the survey's §4.5 question directly: *with the same int8 codes, is the
+vendor int8 GEMM bit-identical to our portable golden, and where does it stop
+being identical?*
+
+Cases (all codes inside our legal [-127, 127] range unless stated):
+
+  tails        K = 1, 3, 7, 31, 33, 127, 128, 1024 with non-multiple-of-NR M/N
+  signs        all-negative, all-positive, mixed-sign, one worst-case magnitude row
+  boundary     K = accum_k_limit (133143, the largest K our golden allows)
+  overflow     K = accum_k_limit + 1: our golden refuses, AOCL must be measured
+  reserved     int8 code -128 (legal for AOCL, reserved by our scheme)
+
+Per case we record raw bit-level comparisons:
+
+  * ``aocl_int32 == portable_int32``  (the contract-relevant equality)
+  * fused ``s8s8s32obf16_sym_quant`` single-group bf16 vs the portable
+    single-rounding epilogue (mismatch count + max abs difference)
+  * the vendor-GEMM + *our* epilogue composition, which reduces to the int32
+    equality above because our epilogue is a pure elementwise function of the
+    int32 accumulator (the end-to-end AVX-512 kernel check lives in
+    ``vendor_gemm_matrix.py``)
+
+The epilogue itself is reused from ``aocl_semantics_probe`` (same ctypes
+bindings, no third copy).
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import aocl_semantics_probe as asp  # noqa: E402  (sibling module by design)
+
+DEFAULT_EVIDENCE = asp.DEFAULT_EVIDENCE
+
+
+def _codes(rng, shape, low=-127, high=127, dtype=np.int8):
+    return rng.integers(low, high + 1, size=shape, dtype=np.int16).astype(dtype)
+
+
+def _case_shapes():
+    cases = []
+    for k in (1, 3, 7, 31, 33, 127, 128, 1024):
+        cases.append({"name": "tail_k{}".format(k), "m": 6, "k": k, "n": 70})
+    cases.append({"name": "m1_n1", "m": 1, "k": 8, "n": 1})
+    cases.append({"name": "m5_n32_k1024", "m": 5, "k": 1024, "n": 32})
+    cases.append({"name": "m1_n8192_k1024", "m": 1, "k": 1024, "n": 8192})
+    return cases
+
+
+def _fill(rng, case):
+    m, k, n = case["m"], case["k"], case["n"]
+    kind = case.get("kind", "mixed")
+    if kind == "all_negative":
+        a = np.full((m, k), -127, dtype=np.int8)
+        b = np.full((k, n), -127, dtype=np.int8)
+    elif kind == "all_positive":
+        a = np.full((m, k), 127, dtype=np.int8)
+        b = np.full((k, n), 127, dtype=np.int8)
+    elif kind == "worst_case":
+        a = np.full((m, k), 127, dtype=np.int8)
+        b = np.full((k, n), 127, dtype=np.int8)
+        b[0, :] = -127
+    elif kind == "reserved_code":
+        a = np.full((m, k), -128, dtype=np.int8)
+        b = np.ones((k, n), dtype=np.int8)
+    else:
+        a = _codes(rng, (m, k))
+        b = _codes(rng, (k, n))
+    return a, b
+
+
+def run_case(lpg, rng, case, rounds_fused=True):
+    scheme = asp._portable()
+    m, k, n = case["m"], case["k"], case["n"]
+    a, b = _fill(rng, case)
+    record = {
+        "name": case["name"],
+        "m": m, "k": k, "n": n,
+        "kind": case.get("kind", "mixed"),
+        "legal_codes": bool(a.min() >= -127 and a.max() <= 127 and b.min() >= -127 and b.max() <= 127),
+    }
+
+    # exact big-integer reference and the portable golden
+    exact = asp.exact_int32_matmul(a, b)
+    portable = None
+    portable_error = None
+    try:
+        portable = asp.portable_qmatmul(a, b)
+    except Exception as exc:  # noqa: BLE001 - the refusal is a result
+        portable_error = "{}: {}".format(type(exc).__name__, exc)
+    record["portable_error"] = portable_error
+    record["exact_max_abs"] = int(np.abs(exact).max())
+    record["exact_fits_int32"] = bool(np.all(np.abs(exact) <= 2 ** 31 - 1))
+
+    aocl_out = lpg.s8s8s32os32(a, b, m, k, n)
+    record["aocl_equals_exact"] = bool(np.array_equal(aocl_out.astype(np.int64), exact))
+    if portable is not None:
+        record["aocl_int32_bitwise_portable"] = bool(
+            np.array_equal(aocl_out.astype(np.int64), portable)
+        )
+        record["aocl_int32_mismatch_count"] = int(
+            (aocl_out.astype(np.int64) != portable).sum()
+        )
+    else:
+        record["aocl_int32_bitwise_portable"] = None
+
+    # fused sym_quant (single group) vs the portable single-rounding epilogue
+    if rounds_fused and portable is not None:
+        row_scales = (rng.random(m).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+        col_scales = (rng.random(n).astype(np.float32) * 0.5 + 0.25).astype(np.float32)
+        reference = asp.portable_epilogue_bits(portable, row_scales.tolist(), col_scales.tolist())
+        meta = asp.AoclSymmStatQuant(group_size=asp.DIM_T(k).value)
+        size = int(
+            lpg.lib.aocl_get_reorder_buf_size_s8s8s32os32_sym_quant(
+                b"r", b"n", b"b", k, n, ctypes.byref(meta)
+            )
+        )
+        reordered = np.zeros(max(size, 1), dtype=np.int8)
+        b_contig = np.ascontiguousarray(b)
+        lpg.lib.aocl_reorder_s8s8s32os32_sym_quant(
+            b"r", b"n", b"b",
+            b_contig.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)),
+            reordered.ctypes.data_as(ctypes.POINTER(ctypes.c_int8)),
+            k, n, n, ctypes.byref(meta),
+        )
+        post, keep = asp.Lpgemm.make_group_post_op(
+            row_scales.reshape(m, 1), col_scales.reshape(1, n), k, k
+        )
+        fused = np.zeros((m, n), dtype=np.uint16)
+        errtext = asp.capture_stderr(
+            lpg.s8s8s32obf16_sym_quant, a, reordered, m, k, n, post, 1, 0, fused
+        )
+        produced = not np.all(fused == 0)
+        record["fused_sym_quant"] = {
+            "produced_output": bool(produced),
+            "stderr": errtext.strip(),
+        }
+        if produced:
+            mismatch = fused != reference
+            diff = np.abs(
+                asp.bf16_bits_to_f32(fused).astype(np.float64)
+                - asp.bf16_bits_to_f32(reference).astype(np.float64)
+            )
+            record["fused_sym_quant"].update(
+                {
+                    "bitwise_equal_portable": bool(not mismatch.any()),
+                    "mismatch_count": int(mismatch.sum()),
+                    "elements": int(fused.size),
+                    "max_abs_diff_bf16": float(diff.max()),
+                    "relative_max_abs_diff": float(
+                        diff.max() / max(1e-30, np.abs(asp.bf16_bits_to_f32(reference)).max())
+                    ),
+                }
+            )
+    return record
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--lib", default=None)
+    parser.add_argument("--seed", type=int, default=20260912)
+    args = parser.parse_args()
+
+    lib_path = args.lib or asp.find_default_lib()
+    lpg = asp.Lpgemm(lib_path)
+    rng = np.random.default_rng(args.seed)
+    scheme = asp._portable()
+
+    cases = _case_shapes()
+    # negative / worst-case / boundary variants of a single mid-size shape
+    for kind in ("all_negative", "all_positive", "worst_case"):
+        cases.append({"name": "{}_k1024".format(kind), "m": 6, "k": 1024, "n": 70, "kind": kind})
+    cases.append(
+        {
+            "name": "boundary_k{}".format(scheme.MAX_ACCUMULATOR_K),
+            "m": 1, "k": int(scheme.MAX_ACCUMULATOR_K), "n": 2, "kind": "worst_case",
+        }
+    )
+    cases.append(
+        {
+            "name": "overflow_k{}".format(int(scheme.MAX_ACCUMULATOR_K) + 1),
+            "m": 1, "k": int(scheme.MAX_ACCUMULATOR_K) + 1, "n": 2, "kind": "worst_case",
+        }
+    )
+    cases.append({"name": "reserved_minus128", "m": 1, "k": 4, "n": 2, "kind": "reserved_code"})
+
+    results = []
+    for case in cases:
+        started = time.time()
+        try:
+            record = run_case(lpg, rng, case)
+        except Exception as exc:  # noqa: BLE001
+            record = {
+                "name": case["name"], "m": case["m"], "k": case["k"], "n": case["n"],
+                "error": "{}: {}".format(type(exc).__name__, exc),
+            }
+        record["_seconds"] = round(time.time() - started, 4)
+        results.append(record)
+        print(json.dumps(record, ensure_ascii=False)[:220], flush=True)
+
+    summary = {
+        "cases": len(results),
+        "int32_bitwise_matches": sum(
+            1 for r in results if r.get("aocl_int32_bitwise_portable") is True
+        ),
+        "int32_bitwise_mismatches": [
+            r["name"] for r in results if r.get("aocl_int32_bitwise_portable") is False
+        ],
+        "portable_refusals": [
+            {"name": r["name"], "error": r.get("portable_error")}
+            for r in results
+            if r.get("portable_error")
+        ],
+        "fused_sym_quant_mismatch_cases": [
+            {
+                "name": r["name"],
+                "mismatch_count": r["fused_sym_quant"].get("mismatch_count"),
+                "elements": r["fused_sym_quant"].get("elements"),
+                "max_abs_diff_bf16": r["fused_sym_quant"].get("max_abs_diff_bf16"),
+            }
+            for r in results
+            if r.get("fused_sym_quant", {}).get("produced_output")
+            and not r["fused_sym_quant"].get("bitwise_equal_portable", False)
+        ],
+    }
+
+    report = {
+        "tag": "q8-w8a8-parity-probe",
+        "started_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "library": lib_path,
+        "seed": args.seed,
+        "portable_limit_k": int(scheme.MAX_ACCUMULATOR_K),
+        "summary": summary,
+        "results": results,
+    }
+    with open(args.output, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, ensure_ascii=False)
+        handle.write("\n")
+    print("summary:", json.dumps(summary, ensure_ascii=False))
+    print("report: {}".format(args.output))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
