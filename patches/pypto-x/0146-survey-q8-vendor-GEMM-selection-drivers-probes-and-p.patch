+    def prepare_sym_quant(self, a, b_reordered, m, k, n, row_scales, col_scales):
+        a_buf = np.ascontiguousarray(a, dtype=np.int8)
+        b_buf = np.ascontiguousarray(b_reordered, dtype=np.int8)
+        c_buf = np.zeros((m, n), dtype=np.uint16)
+        a_scl = np.ascontiguousarray(np.asarray(row_scales, dtype=np.float32).reshape(m, 1))
+        b_scl = np.ascontiguousarray(np.asarray(col_scales, dtype=np.float32).reshape(1, n))
+        a_sf = AoclPreOpSf(
+            scale_factor=ctypes.c_void_p(a_scl.ctypes.data),
+            scale_factor_len=DIM_T(1).value,
+            type=AOCL_GEMM_F32,
+        )
+        b_sf = AoclPreOpSf(
+            scale_factor=ctypes.c_void_p(b_scl.ctypes.data),
+            scale_factor_len=DIM_T(n).value,
+            type=AOCL_GEMM_F32,
+        )
+        grp = AoclGroupPostOp(
+            group_size=DIM_T(k).value,
+            seq_length=DIM_T(1).value,
+            a_scl=ctypes.pointer(a_sf),
+            b_scl=ctypes.pointer(b_sf),
+            a_zp=None,
