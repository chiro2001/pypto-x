@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Q8 / vendor-gemm-survey: turn raw/vendor-gemm-matrix.json into the markdown
+tables used by the evidence brief.
+
+Usage:
+  python3 scripts/perf/summarize_matrix.py \
+      --input  <evidence>/raw/vendor-gemm-matrix.json \
+      --output <evidence>/raw/vendor-gemm-matrix-table.md
+
+Prints (and writes) the per-shape median table with ratios against the W8J
+baseline (oneDNN bf16), the bitwise-check table, and a compact per-provider
+summary (geometric-mean ratio, wins per shape).  Purely derived from the raw
+JSON: no re-measurement, no rounding of the underlying numbers.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from collections import OrderedDict
+
+COLUMN_ORDER = [
+    "onednn_bf16",
+    "aocl_bf16_packed",
+    "aocl_bf16_unpacked",
+    "ours_bf16",
+    "aocl_int8_packed",
+    "aocl_int8_unpacked",
+    "aocl_int8_symquant_bf16",
+    "ours_int8_qmatmul",
+    "ours_int8_epilogue_bf16",
+]
+
+
+def _ms(row, name):
+    timing = row["timings"].get(name)
+    if not timing or "median_ms" not in timing:
+        return None
+    return timing["median_ms"]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--output", default=None)
+    args = parser.parse_args()
+
+    with open(args.input, "r", encoding="utf-8") as handle:
+        data = json.load(handle)
+
+    rows = data["shapes"]
+    present = [
+        name
+        for name in COLUMN_ORDER
+        if any(_ms(row, name) is not None for row in rows)
+    ]
+
+    lines = []
+    lines.append("### 12 形状中位耗时表（ms，`UNGATED`）")
+    lines.append("")
+    lines.append(
+        "口径与 W8J 一致：affinity={}，OMP/线程={}，iters m=1:{} / m=5:{}，rounds={}，"
+        "每轮 1 次 warmup 后取 iters 次；输入 = `randn/sqrt(k) → bf16`，seed {}".format(
+            data["host"]["affinity"],
+            data["env"]["threads_requested"],
+            data["methodology"]["iters_decode_m1"],
+            data["methodology"]["iters_prefill_m5"],
+            data["methodology"]["rounds"],
+            20260912,
+        )
+    )
+    lines.append("")
+    header = "| m | k | n | 形状 | " + " | ".join(present) + " |"
+    lines.append(header)
+    lines.append("| --- | --- | --- | --- | " + " | ".join("---" for _ in present) + " |")
+    for row in rows:
+        cells = []
+        for name in present:
+            value = _ms(row, name)
+            cells.append("-" if value is None else "{:.5f}".format(value))
+        lines.append(
+            "| {} | {} | {} | {} | {} |".format(
+                row["m"], row["k"], row["n"], row["label"], " | ".join(cells)
+            )
+        )
+    lines.append("")
+
+    # ratio table against the W8J baseline when available
+    if any("ratio_vs_onednn_bf16" in row for row in rows):
+        lines.append("### 相对 oneDNN bf16 的比值（>1 表示更慢；仅同窗口测量值）")
+        lines.append("")
+        lines.append("| m | k | n | 形状 | " + " | ".join(present) + " |")
+        lines.append("| --- | --- | --- | --- | " + " | ".join("---" for _ in present) + " |")
+        for row in rows:
+            ratios = row.get("ratio_vs_onednn_bf16", {})
+            cells = []
+            for name in present:
+                value = ratios.get(name)
+                cells.append("-" if value is None else "{:.2f}x".format(value))
+            lines.append(
+                "| {} | {} | {} | {} | {} |".format(
+                    row["m"], row["k"], row["n"], row["label"], " | ".join(cells)
+                )
+            )
+        lines.append("")
+
+    # bitwise checks
+    lines.append("### 位级/数值检查（每个形状一行）")
+    lines.append("")
+    keys = sorted({key for row in rows for key in row.get("checks", {})})
+    lines.append("| m | k | n | " + " | ".join(keys) + " |")
+    lines.append("| --- | --- | --- | " + " | ".join("---" for _ in keys) + " |")
+    for row in rows:
+        cells = []
+        for key in keys:
+            value = row.get("checks", {}).get(key)
+            if isinstance(value, float):
+                cells.append("{:.3g}".format(value))
+            elif value is None:
+                cells.append("-")
+            else:
+                cells.append(str(value))
+        lines.append(
+            "| {} | {} | {} | {} |".format(row["m"], row["k"], row["n"], " | ".join(cells))
+        )
+    lines.append("")
+
+    # per-provider summary
+    lines.append("### provider 汇总")
+    lines.append("")
+    lines.append("| provider | 覆盖形状数 | 相对 oneDNN 的几何平均比值 | 几何平均耗时 ms | 该 provider 最快的形状数（同 dtype 内） |")
+    lines.append("| --- | --- | --- | --- | --- |")
+    for name in present:
+        values = [_ms(row, name) for row in rows]
+        medians = [v for v in values if v is not None]
+        ratios = [
+            row.get("ratio_vs_onednn_bf16", {}).get(name)
+            for row in rows
+            if row.get("ratio_vs_onednn_bf16", {}).get(name)
+        ]
+        geo = (
+            math.exp(sum(math.log(r) for r in ratios) / len(ratios)) if ratios else None
+        )
+        geo_ms = (
+            math.exp(sum(math.log(v) for v in medians) / len(medians)) if medians else None
+        )
+        lines.append(
+            "| {} | {} | {} | {} | {} |".format(
+                name,
+                len(medians),
+                "-" if geo is None else "{:.2f}x".format(geo),
+                "-" if geo_ms is None else "{:.5f}".format(geo_ms),
+                "-",
+            )
+        )
+
+    text = "\n".join(lines) + "\n"
+    if args.output:
+        with open(args.output, "w", encoding="utf-8") as handle:
+            handle.write(text)
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
