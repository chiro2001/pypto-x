+        )
+        w_codes = np.frombuffer(quantized_weight.codes, dtype=np.int8).reshape(n, k).T.copy()
+        col_scales = np.frombuffer(quantized_weight.scales, dtype=np.float32).copy()
+        int8_inputs[(m, k, n)] = (
+            a_codes,
+            np.ascontiguousarray(w_codes),
+            np.array(activation.scales, dtype=np.float32),
+            col_scales,
+            int(activation.saturation_count),
+            int(quantized_weight.saturation_count),
+        )
+
+    bf16_views = {}
+    for m, k, n, label, x, weight in prepared:
+        bf16_views[(m, k, n)] = (
+            x.contiguous().view(torch.uint16).numpy().reshape(m, k),
+            np.ascontiguousarray(weight.contiguous().view(torch.uint16).numpy().reshape(n, k).T),
+        )
+
+    # -- providers that need torch-level setup ------------------------------
+    layers = {}
+    providers = OrderedDict()
+    if not args.skip_onednn:
+        try:
+            from vllm.model_executor.layers.utils import dispatch_cpu_unquantized_gemm
+
+            class _DummyLayer(torch.nn.Module):
+                def __init__(self, weight):
+                    super().__init__()
+                    self.weight = torch.nn.Parameter(weight.detach(), requires_grad=False)
+
+            for m, k, n, _label, _x, weight in prepared:
+                layer = _DummyLayer(weight)
