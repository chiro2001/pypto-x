+            scheme.dequantize_epilogue_bf16(
+                portable_acc.reshape(-1).tolist(), row_scales.tolist(), col_scales.tolist(),
+                shape=(m, n),
+            ).bf16_bits,
+            dtype=np.uint16,
+        ).reshape(m, n)
+
+        # ---- AOCL int8 int32-out, packed and runtime-packed ----------------
+        for variant, b_arg in (
+            ("packed", lambda: aocl.reorder_s8(w_codes, k, n)),
+            ("unpacked", lambda: w_codes),
