+#!/usr/bin/env python3
+"""N4.0 decomposition analysis: medians over the locked base/after rounds.
+
+Reads the raw harness JSONs produced by scripts/wait_and_run.sh ->
+heavy_inner.sh and reports, for base (c2ec98f3c) and after (per-launch
+validation memo):
+
+* the three-tier decomposition (setup / loop / teardown) for T=5 prefill and
+  T=1 decode, with split share and per-op glue;
+* the setup segment table (exclusive seconds per wrapped call);
+* the A/B delta for the de-dup change;
+* the bit-level output sha256 cross-check across every round.
+
+All absolute numbers are UNGATED (12 vCPU KVM guest, no cpufreq, window is
+not quiet).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import statistics
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+TAGS = ("base_r1", "base_r2", "base_r3", "after_r1", "after_r2", "after_r3")
+SEGMENTS = (
+    "_validate_primary_artifact",
+    "_program_digest_from_metadata",
+    "_validate_primary_semantics",
+    "lower_avx512",
+    "_decode_artifact",
+    "_read_native_bytes",
+    "plan_release",
+    "_packed_dispatch_for",
+    "_buffer_from_descriptor",
+    "_buffer_from_values",
+    "_find_function",
+    "LaunchRequest.validate",
+    "_write_descriptor",
+    "_buffer_values",
+)
+
+
+def load(path: Path) -> Optional[Dict[str, Any]]:
+    try:
+        with path.open(encoding="utf-8") as stream:
+            return json.load(stream)
+    except OSError:
+        return None
+
+
+def median(values: Sequence[float]) -> Optional[float]:
+    clean = [float(value) for value in values if value is not None]
+    return statistics.median(clean) if clean else None
+
+
+def spread(values: Sequence[float]) -> Optional[Tuple[float, float]]:
+    clean = [float(value) for value in values if value is not None]
+    if len(clean) < 2:
+        return None
+    return min(clean), max(clean)
+
+
+def fmt(value: Optional[float], digits: int = 3) -> str:
+    return "n/a" if value is None else "{:.{d}f}".format(value, d=digits)
+
+
+def walk(events: Sequence[Dict[str, Any]], path: Tuple[str, ...] = ()):
+    for event in events:
+        yield path + (event["name"],), event
+        yield from walk(event.get("children", ()), path + (event["name"],))
+
+
+def launch_derived(launch: Dict[str, Any]) -> Dict[str, Any]:
+    top = {event["name"]: event for event in launch["event_tree"]}
+    flattened = list(walk(launch["event_tree"]))
+    result: Dict[str, Any] = {
+        "top": top,
+        "all": flattened,
+        "top_validate_seconds": top.get("_validate_primary_artifact", {}).get("seconds"),
+        "decode_seconds": top.get("_decode_artifact", {}).get("seconds"),
+    }
+    for name in ("_program_digest_from_metadata", "_validate_primary_semantics", "lower_avx512",
+                 "_validate_primary_artifact", "_read_native_bytes", "plan_release",
+                 "_packed_dispatch_for", "_buffer_from_descriptor", "_buffer_from_values",
+                 "_find_function", "LaunchRequest.validate", "_write_descriptor", "_buffer_values"):
+        matches = [event for path, event in flattened if path[-1] == name]
+        result["calls_" + name] = len(matches)
+        result["seconds_" + name] = sum(float(event["seconds"]) for event in matches)
+        result["exclusive_" + name] = sum(float(event["exclusive_seconds"]) for event in matches)
+    nested_in_decode = [event for path, event in flattened
+                        if len(path) >= 2 and path[-1] == "_validate_primary_artifact"
+                        and path[-2] == "_decode_artifact"]
+    result["nested_validate_in_decode_calls"] = len(nested_in_decode)
+    result["nested_validate_in_decode_seconds"] = sum(float(e["seconds"]) for e in nested_in_decode)
+    return result
+
+
+def collect(evidence: Path) -> Dict[str, Any]:
+    rounds: Dict[str, Any] = {}
+    for tag in TAGS:
+        decomp = load(evidence / "raw" / "{}.decomp.json".format(tag))
+        driver = load(evidence / "raw" / "{}.json".format(tag))
+        if decomp is None or driver is None:
+            continue
+        launches = []
+        for launch in decomp["launches"]:
+            derived = launch_derived(launch)
+            derived.update({key: launch.get(key) for key in (
+                "index", "label", "launch_seconds", "setup_seconds", "loop_seconds",
+                "teardown_seconds", "op_seconds", "op_count", "release_seconds",
+                "release_count", "loop_glue_seconds",
+            )})
+            derived["glue_per_op_ms"] = (
+                1000.0 * float(launch["loop_glue_seconds"]) / max(int(launch["op_count"]), 1)
+                if launch.get("loop_glue_seconds") is not None and launch.get("op_count") else None
+            )
+            launches.append(derived)
+        rounds[tag] = {"decomp": decomp, "driver": driver, "launches": launches}
+    return rounds
+
+
+def select(rounds: Dict[str, Any], prefix: str, label: str) -> List[Dict[str, Any]]:
+    selected = []
+    for tag, payload in sorted(rounds.items()):
+        if not tag.startswith(prefix):
+            continue
+        for launch in payload["launches"]:
+            if launch["label"] == label:
+                selected.append(launch)
+    return selected
+
+
+def tier_table(rounds: Dict[str, Any], prefix: str, label: str) -> List[str]:
+    rows = select(rounds, prefix, label)
+    lines = [
+        "| tier | median s | min–max | share of launch |",
+        "|---|---:|---|---:|",
+    ]
+    if not rows:
+        return lines + ["| n/a | n/a | n/a | n/a |"]
+    launch_median = median([row["launch_seconds"] for row in rows])
+    for key, name in (("setup_seconds", "setup (per launch)"),
+                      ("loop_seconds", "loop (per op)"),
+                      ("teardown_seconds", "teardown (per launch)"),
+                      ("launch_seconds", "**launch total**")):
+        value = median([row[key] for row in rows])
+        band = spread([row[key] for row in rows])
+        share = "100%" if key == "launch_seconds" else (
+            "n/a" if (value is None or not launch_median) else "{:.1f}%".format(100.0 * value / launch_median)
+        )
+        lines.append("| {} | {} | {} | {} |".format(
+            name, fmt(value), "n/a" if band is None else "{}-{}".format(fmt(band[0]), fmt(band[1])), share))
+    for key, name in (("op_seconds", "loop: op_internal (Σ _execute_operation)"),
+                      ("release_seconds", "loop: release_dead_values"),
+                      ("loop_glue_seconds", "loop: glue (list comps + loop)")):
+        value = median([row[key] for row in rows])
+        band = spread([row[key] for row in rows])
+        share = "n/a" if (value is None or not launch_median) else "{:.1f}%".format(100.0 * value / launch_median)
+        lines.append("| {} | {} | {} | {} |".format(
+            name, fmt(value), "n/a" if band is None else "{}-{}".format(fmt(band[0]), fmt(band[1])), share))
+    glue_per_op = median([row["glue_per_op_ms"] for row in rows])
+    op_count = median([row["op_count"] for row in rows])
+    lines.append("| glue per op | {} ms/op | ops median {} | |".format(fmt(glue_per_op, 3), fmt(op_count, 0)))
+    return lines
+
+
+def segment_table(rounds: Dict[str, Any], prefix: str, label: str) -> List[str]:
+    rows = select(rounds, prefix, label)
+    lines = [
+        "| segment (exclusive s/launch) | calls | median s | min–max |",
+        "|---|---:|---:|---|",
+    ]
+    for name in SEGMENTS:
+        values = [row.get("exclusive_" + name) for row in rows]
+        calls = [row.get("calls_" + name) for row in rows]
+        if not any(value for value in values):
+            continue
+        band = spread(values)
+        lines.append("| {} | {} | {} | {} |".format(
+            name,
+            fmt(median(calls), 0),
+            fmt(median(values), 4),
+            "n/a" if band is None else "{}-{}".format(fmt(band[0], 4), fmt(band[1], 4)),
+        ))
+    lines.append("| top-level `_validate_primary_artifact` (inclusive) | 1 | {} | {} |".format(
+        fmt(median([row["top_validate_seconds"] for row in rows]), 4),
+        "n/a" if spread([row["top_validate_seconds"] for row in rows]) is None
+        else "{}-{}".format(fmt(spread([row["top_validate_seconds"] for row in rows])[0], 4),
+                            fmt(spread([row["top_validate_seconds"] for row in rows])[1], 4)),
+    ))
+    lines.append("| nested `_validate_primary_artifact` under `_decode_artifact` (inclusive) | 1 | {} | |".format(
+        fmt(median([row["nested_validate_in_decode_seconds"] for row in rows]), 4)))
+    return lines
+
+
+def ab_table(rounds: Dict[str, Any], label: str) -> List[str]:
+    base = select(rounds, "base", label)
+    after = select(rounds, "after", label)
+    keys = ("launch_seconds", "setup_seconds", "loop_seconds", "teardown_seconds",
+            "op_seconds", "release_seconds", "loop_glue_seconds")
+    lines = [
+        "| metric | base median s | after median s | Δ s | Δ% |",
+        "|---|---:|---:|---:|---:|",
+    ]
+    for key in keys:
+        b = median([row[key] for row in base])
+        a = median([row[key] for row in after])
+        delta = "n/a" if (b is None or a is None) else "{:+.3f}".format(a - b)
+        pct = "n/a" if (not b or a is None) else "{:+.1f}%".format(100.0 * (a - b) / b)
+        lines.append("| {} | {} | {} | {} | {} |".format(key, fmt(b), fmt(a), delta, pct))
+    for name in ("_validate_primary_semantics", "lower_avx512", "_program_digest_from_metadata"):
+        b = median([row.get("seconds_" + name) for row in base])
+        a = median([row.get("seconds_" + name) for row in after])
+        bc = median([row.get("calls_" + name) for row in base])
+        ac = median([row.get("calls_" + name) for row in after])
+        delta = "n/a" if (b is None or a is None) else "{:+.3f}".format(a - b)
+        lines.append("| {} (s, calls {}→{}) | {} | {} | {} | n/a |".format(
+            name, fmt(bc, 0), fmt(ac, 0), fmt(b, 4), fmt(a, 4), delta))
+    return lines
+
+
+def bit_check(rounds: Dict[str, Any]) -> Tuple[bool, List[str]]:
+    lines = ["| output | unique sha256 (6 rounds) | identical |", "|---|---|---|"]
+    ok = True
+    output_names: List[str] = []
+    for payload in rounds.values():
+        output_names = sorted(payload["driver"].get("outputs", {}).keys()) or output_names
+    for name in output_names:
+        digests = set()
+        for payload in rounds.values():
+            entry = payload["driver"].get("outputs", {}).get(name)
+            if entry:
+                digests.add(entry["raw_sha256"])
+        identical = len(digests) == 1
+        ok = ok and identical
+        lines.append("| {} | {} | {} |".format(name, ", ".join(sorted(digests))[:32] + ("…" if digests else ""), identical))
+    lines.append("| artifact_content_digest | {} | {} |".format(
+        ", ".join(sorted({payload["driver"].get("compile", {}).get("artifact_content_digest", "n/a")
+                          for payload in rounds.values()}))[:32] + "…",
+        len({payload["driver"].get("compile", {}).get("artifact_content_digest")
+             for payload in rounds.values()}) <= 1,
+    ))
+    return ok, lines
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", required=True)
+    parser.add_argument("--output", default=None, help="analysis.json path (default: <evidence>/raw/analysis.json)")
+    args = parser.parse_args()
+    evidence = Path(args.evidence)
+    rounds = collect(evidence)
+    if not rounds:
+        raise SystemExit("no rounds found under {}".format(evidence / "raw"))
+
+    sections: List[str] = ["<!-- generated by scripts/perf/n4_analyze_decomposition.py -->"]
+    for prefix, prefix_name in (("base", "base c2ec98f3c (pre-change)"),
+                                ("after", "after (per-launch validation memo)")):
+        sections.append("## {} — three tiers (UNGATED)".format(prefix_name))
+        for label in ("prefill", "decode"):
+            rows = select(rounds, prefix, label)
+            ops = median([row["op_count"] for row in rows])
+            sections.append("### T={} {} ({} rounds, ops median {})".format(
+                5 if label == "prefill" else 1, label, len(rows), fmt(ops, 0)))
+            sections.extend(tier_table(rounds, prefix, label))
+            sections.append("")
+        sections.append("### setup / teardown segments ({})".format(prefix_name))
+        for label in ("prefill", "decode"):
+            sections.append("#### T={} {}".format(5 if label == "prefill" else 1, label))
+            sections.extend(segment_table(rounds, prefix, label))
+            sections.append("")
+    sections.append("## A/B: pre-change vs per-launch validation memo (UNGATED)")
+    for label in ("prefill", "decode"):
+        sections.append("### T={} {}".format(5 if label == "prefill" else 1, label))
+        sections.extend(ab_table(rounds, label))
+        sections.append("")
+    ok, bit_lines = bit_check(rounds)
+    sections.append("## Bit-level regression across all rounds")
+    sections.extend(bit_lines)
+    sections.append("")
+    sections.append("bit_identical={}".format(ok))
+
+    report = "\n".join(sections)
+    print(report)
+
+    output_path = Path(args.output) if args.output else evidence / "raw" / "analysis.json"
+    payload = {
+        "tags": sorted(rounds),
+        "launch_counts": {tag: len(item["launches"]) for tag, item in sorted(rounds.items())},
+        "bit_identical": ok,
+    }
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    with output_path.open("w", encoding="utf-8") as stream:
+        json.dump(payload, stream, ensure_ascii=False, sort_keys=True, indent=2)
+        stream.write("\n")
+
+
+if __name__ == "__main__":
+    main()
