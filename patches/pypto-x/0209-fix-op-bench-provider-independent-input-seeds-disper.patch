From 00e88b5a42230259d45bad909e0769b3b2a7c245 Mon Sep 17 00:00:00 2001
From: op-bench-framework <op-bench-framework@pypto-x.local>
Date: Sat, 12 Sep 2026 03:47:53 +0800
Subject: [PATCH 209/256] fix(op-bench): provider-independent input seeds,
 dispersion-based repro rule

- make_inputs now uses OpCase.inputs_seed (suite-entry derived, provider
  independent) so the same shape uses byte-identical operands across
  providers; focused test asserts the cross-provider digest equality;
- reproducibility limit now also accepts half of each run's observed range,
  so a repeated run is judged against within-run dispersion as required by
  0007 section 8.1;
- A3 driver picks the Q8b conda python (numpy) and distinct (socket,core)
  pairs inside cpus 320-639.
---
 python/pypto/op_bench/inputs.py                    |  4 +++-
 python/pypto/op_bench/runner.py                    |  7 ++++++-
 python/tests/ut/pypto_x/test_op_bench_framework.py | 16 ++++++++++++++++
 scripts/perf/op_bench_a3_run.sh                    | 23 ++++++++++++++++++++---
 4 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/python/pypto/op_bench/inputs.py b/python/pypto/op_bench/inputs.py
index f59e8caa5..4dc3f1202 100644
--- a/python/pypto/op_bench/inputs.py
+++ b/python/pypto/op_bench/inputs.py
@@ -67,7 +67,9 @@ def make_inputs(case: OpCase, verified: Mapping[str, Any], *, base_seed: int) ->
 
     dtype = verified["dtype"]
     shape = verified["shape"]
-    seed = case_seed(base_seed, case.case_id)
+    # ``case.inputs_seed`` is derived from the suite entry only (not from the
+    # provider), so the same shape uses identical operands across providers.
+    seed = int(case.inputs_seed)
     m, k, n = shape["m"], shape["k"], shape["n"]
     batch = tuple(shape["batch_shape"])
     rng = np.random.default_rng(seed)
diff --git a/python/pypto/op_bench/runner.py b/python/pypto/op_bench/runner.py
index 7599eae3e..847ca4243 100644
--- a/python/pypto/op_bench/runner.py
+++ b/python/pypto/op_bench/runner.py
@@ -413,9 +413,13 @@ def _reproducibility(reports: Sequence[Mapping[str, Any]]) -> Mapping[str, Any]:
             median_b = float(b["seconds"]["median"])
             disp_a = a["seconds"]["dispersion"]
             disp_b = b["seconds"]["dispersion"]
+            range_a = float(disp_a.get("max", median_a)) - float(disp_a.get("min", median_a))
+            range_b = float(disp_b.get("max", median_b)) - float(disp_b.get("min", median_b))
             limit = max(
                 float(disp_a.get("outlier_threshold") or 0.0),
                 float(disp_b.get("outlier_threshold") or 0.0),
+                0.5 * range_a,
+                0.5 * range_b,
                 1e-9,
             )
             rows.append(
@@ -435,7 +439,8 @@ def _reproducibility(reports: Sequence[Mapping[str, Any]]) -> Mapping[str, Any]:
     return {
         "repeats": len(reports),
         "structure_identical": structure_identical,
-        "rule": "median delta <= max(ERR-0004 outlier threshold of either run); structure = same case ids/statuses",
+        "rule": "median delta <= max(ERR-0004 outlier threshold, half of each run's observed range); "
+        "structure = same case ids/statuses",
         "rows": rows,
         "verdict": "PASS"
         if structure_identical and all(row.get("within_dispersion") is not False for row in rows)
diff --git a/python/tests/ut/pypto_x/test_op_bench_framework.py b/python/tests/ut/pypto_x/test_op_bench_framework.py
index dff61ac98..cb8e93d60 100644
--- a/python/tests/ut/pypto_x/test_op_bench_framework.py
+++ b/python/tests/ut/pypto_x/test_op_bench_framework.py
@@ -125,6 +125,22 @@ def test_u1_registry_contract_identity_is_reused():
     assert verified["shape"]["flops"] == 2 * 2 * 4 * 2
 
 
+def test_same_shape_same_inputs_across_providers():
+    entries = [entry for entry in _C.suites.model_suite() if entry["m"] == 1 and entry["k"] == 1024 and entry["n"] == 32]
+    cases = []
+    for provider in ("portable", "vendor:aocl-lpgemm-bf16"):
+        cases.append(
+            _C.suites.build_cases(
+                entries, provider=provider, threads=1, binding="none", base_seed=123
+            )[0]
+        )
+    assert cases[0].inputs_seed == cases[1].inputs_seed
+    verified = cases[0].validate()
+    first = _C.make_inputs(cases[0], verified, base_seed=123)
+    second = _C.make_inputs(cases[1], verified, base_seed=123)
+    assert first["input_sha256"] == second["input_sha256"]
+
+
 def test_unregistered_opcode_fails_closed():
     with pytest.raises(_C.CaseError) as info:
         _case(op="reduce_sum", shape={"left": (4, 4)}).validate()
diff --git a/scripts/perf/op_bench_a3_run.sh b/scripts/perf/op_bench_a3_run.sh
index f593d6d52..20be65986 100755
--- a/scripts/perf/op_bench_a3_run.sh
+++ b/scripts/perf/op_bench_a3_run.sh
@@ -20,16 +20,33 @@ LOGS="$EVIDENCE/logs/a3"
 mkdir -p "$RAW" "$LOGS"
 cd "$WORKTREE"
 
-# pick 8 logical CPUs in 320-639 with distinct physical cores (same recipe as Q8b a3_env.sh)
-CPUS="$(lscpu -p=CPU,CORE 2>/dev/null | grep -v '^#' | awk -F, '$1>=320 && $1<=639 && !seen[$2]++ {print $1}' | head -n 8 | paste -sd,)"
+# pick 8 logical CPUs in 320-639 with distinct (socket,core) pairs (Q8b a3_env.sh recipe,
+# extended to distinguish cores across sockets)
+CPUS="$(lscpu -p=CPU,CORE,SOCKET 2>/dev/null | grep -v '^#' | awk -F, '$1>=320 && $1<=639 && !seen[$2","$3]++ {print $1}' | head -n 8 | paste -sd,)"
 if [ -z "$CPUS" ]; then
     echo "[op-bench-a3] could not select cpus in 320-639" >&2
     exit 1
 fi
 echo "[op-bench-a3] cpus=$CPUS threads=8 start=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
 
+# prefer the Q8b A3 conda python (numpy present); fall back to system python3
+PY="${OP_BENCH_PYTHON:-}"
+if [ -z "$PY" ]; then
+    if [ -x "$HOME/miniforge3/envs/pypto-x-c8/bin/python" ]; then
+        PY="$HOME/miniforge3/envs/pypto-x-c8/bin/python"
+    elif [ -x "$HOME/miniforge3/envs/pypto-x-c8/bin/python3" ]; then
+        PY="$HOME/miniforge3/envs/pypto-x-c8/bin/python3"
+    else
+        PY=python3
+    fi
+fi
+if ! "$PY" -c "import numpy" >/dev/null 2>&1; then
+    echo "[op-bench-a3] $PY has no numpy; set OP_BENCH_PYTHON to an env with numpy" >&2
+    exit 1
+fi
+echo "[op-bench-a3] python=$PY"
 OP_BENCH_THREADS=8 OP_BENCH_BIND="$CPUS" \
-python3 scripts/perf/op_bench.py run \
+"$PY" scripts/perf/op_bench.py run \
     --suite boundary --case-filter m1_n32_k1024 --case-filter m1_n1_k1 \
     --providers portable,vendor:aocl-lpgemm-bf16 \
     --threads 8 --bind "$CPUS" \
