index 000000000..fa03d45e9
--- /dev/null
+++ b/python/pypto/target/amd.py
@@ -0,0 +1,139 @@
+"""AMD ``gfx1036`` target profile used by the static AMDGPU adapter.
+
+This module is deliberately target-specific.  The vendor-neutral GPU common
+lowering must never receive one of these values; the AMD adapter projects the
+profile onto a neutral ``gpu-neutral`` target before calling that lowering.
+The profile records what is known about the Windows probe and, importantly,
+does not invent wavefront or matrix capabilities that have not been observed
+through a Linux HIP runtime.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+from .spec import TargetSpec
+
+
+AMDGCN_TRIPLE = "amdgcn-amd-amdhsa"
+AMDGCN_PROCESSOR = "gfx1036"
+AMD_IGPU_GFX1036_NAME = "amd-igpu-gfx1036"
+AMD_STATIC_ABI_VERSION = "pypto-x.amdgpu.abi.v1"
+
+_REQUIRED_ABI = {
+    "runtime": "hip",
+    "version": AMD_STATIC_ABI_VERSION,
+    "global_address_space": 1,
+    "static_only": True,
+}
+
+_UNKNOWN_CAPABILITIES = {
+    "wavefront_size": "unknown",
+    "xnack": "unknown",
+    "bf16": "unknown",
+    "int8": "unknown",
+    "mfma": "unknown",
+    "wmma": "unknown",
+}
+
+
+def make_amd_igpu_gfx1036_target(
+    attributes: Optional[Mapping[str, Any]] = None,
+) -> TargetSpec:
+    """Return the exact GamePC integrated-GPU static target profile.
+
+    ``attributes`` is limited to common GPU scheduling knobs by validation;
+    it exists so a caller can specialize workgroup/tile/entrypoint without
+    rebuilding the target identity.  Processor, ABI and capability facts are
+    always supplied by this constructor and cannot be replaced by a caller.
+    """
+
+    merged = {
+        "profile": AMD_IGPU_GFX1036_NAME,
+        "processor": AMDGCN_PROCESSOR,
+        "static_only": True,
+        "runtime_unverified": True,
+    }
+    merged.update(_UNKNOWN_CAPABILITIES)
+    if attributes is not None:
+        if not isinstance(attributes, Mapping):
+            raise TypeError("AMD target attributes must be a mapping")
+        for key, value in attributes.items():
+            if key in merged:
+                raise ValueError("AMD target identity attribute {!r} is not overrideable".format(key))
+            merged[key] = value
+    target = TargetSpec(
+        kind="gpu",
+        triple=AMDGCN_TRIPLE,
+        features=("static", AMDGCN_PROCESSOR),
+        device={
+            "name": AMD_IGPU_GFX1036_NAME,
+            "processor": AMDGCN_PROCESSOR,
+            "runtime": "hip",
+        },
+        abi=dict(_REQUIRED_ABI),
+        attributes=merged,
+    )
+    return validate_amd_igpu_gfx1036_target(target)
+
+
+def validate_amd_igpu_gfx1036_target(target: TargetSpec) -> TargetSpec:
+    """Fail closed unless *target* is the exact static ``gfx1036`` profile."""
+
+    if not isinstance(target, TargetSpec):
+        raise TypeError("AMD target must be a TargetSpec")
+    if target.kind != "gpu":
+        raise ValueError("AMD gfx1036 target requires kind='gpu'")
+    if target.triple != AMDGCN_TRIPLE:
+        raise ValueError(
+            "AMD gfx1036 target requires triple {!r}, got {!r}".format(
+                AMDGCN_TRIPLE, target.triple
+            )
+        )
+    processor = target.attributes.get("processor")
+    device_processor = target.device.get("processor")
+    if processor != AMDGCN_PROCESSOR or device_processor != AMDGCN_PROCESSOR:
+        raise ValueError(
+            "AMD target processor must be exact {!r}; gfx1031/6750GRE aliases are not accepted".format(
+                AMDGCN_PROCESSOR
+            )
+        )
+    if target.attributes.get("profile") != AMD_IGPU_GFX1036_NAME:
+        raise ValueError("AMD target profile name mismatch")
+    if target.device.get("name") != AMD_IGPU_GFX1036_NAME:
+        raise ValueError("AMD target device name mismatch")
+    if target.device.get("runtime") != "hip":
+        raise ValueError("AMD target device runtime must be 'hip'")
+    for key, expected in _REQUIRED_ABI.items():
+        if target.abi.get(key) != expected:
+            raise ValueError("AMD target ABI field {!r} must be {!r}".format(key, expected))
+    if target.attributes.get("static_only") is not True:
+        raise ValueError("AMD gfx1036 target must be static_only")
+    if target.attributes.get("runtime_unverified") is not True:
+        raise ValueError("AMD gfx1036 runtime must remain marked runtime_unverified")
+    for key, expected in _UNKNOWN_CAPABILITIES.items():
+        if target.attributes.get(key) != expected:
+            raise ValueError("AMD target capability {!r} must remain 'unknown'".format(key))
+    if target.features != ("static", AMDGCN_PROCESSOR):
+        raise ValueError("AMD gfx1036 target features must be exactly ('static', 'gfx1036')")
+    return target
+
+
+AMD_IGPU_GFX1036 = make_amd_igpu_gfx1036_target()
+AMD_IGPU_GFX1036_TARGET = AMD_IGPU_GFX1036
+AMD_TARGET_GFX1036 = AMD_IGPU_GFX1036
+amd_igpu_gfx1036_target = make_amd_igpu_gfx1036_target
+
+
+__all__ = [
+    "AMDGCN_PROCESSOR",
+    "AMDGCN_TRIPLE",
+    "AMD_IGPU_GFX1036",
+    "AMD_IGPU_GFX1036_TARGET",
+    "AMD_IGPU_GFX1036_NAME",
+    "AMD_TARGET_GFX1036",
+    "AMD_STATIC_ABI_VERSION",
+    "amd_igpu_gfx1036_target",
+    "make_amd_igpu_gfx1036_target",
+    "validate_amd_igpu_gfx1036_target",
+]
diff --git a/python/tests/ut/pypto_x/amd_gfx1036_qwen_capability_gap_driver.py b/python/tests/ut/pypto_x/amd_gfx1036_qwen_capability_gap_driver.py
new file mode 100644
index 000000000..a88067da9
--- /dev/null
+++ b/python/tests/ut/pypto_x/amd_gfx1036_qwen_capability_gap_driver.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Metadata-only Qwen3.5 -> AMD gfx1036 capability-gap audit.
+
+This driver deliberately stops after Core operation counting.  It does not
+lower the 24-layer model graph, allocate/map checkpoint bytes, or claim that
+the complete graph has native AMDGPU kernels.  Run it under
+``run_local_heavy.sh --memory-max-mib 4096 --max-cpus 4`` when using the real
+model profile.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+
+from pypto.backends.hip import probe_amd_hip_runtime
+from pypto.lowering.cpu import canonical_operation_name
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.target import AMD_IGPU_GFX1036, AMDGCN_PROCESSOR, AMDGCN_TRIPLE
+
+
+SUPPORTED_STATIC_OPERATIONS = ("identity", "add", "mul", "reduce_sum", "matmul")
+
+
+def _plain(value):
+    if isinstance(value, dict):
+        return {key: _plain(item) for key, item in value.items()}
+    if hasattr(value, "items"):
+        return {key: _plain(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def build_report(batch=1, steps=1, past_length=4096):
+    program = build_qwen35_text_decoder_graph(batch, steps, past_length=past_length)
+    function = program.functions[0]
+    counts = Counter()
+    canonical_counts = Counter()
+    unsupported = Counter()
+    for operation in function.body.operations:
+        counts[operation.name] += 1
+        try:
+            canonical = canonical_operation_name(operation.name)
+        except Exception:
+            canonical = "<unknown>"
+        canonical_counts[canonical] += 1
+        if canonical not in SUPPORTED_STATIC_OPERATIONS:
+            unsupported[canonical] += 1
+    total = sum(counts.values())
+    status = probe_amd_hip_runtime()
+    return {
+        "audit": "qwen35-text-decoder-amd-gfx1036-capability-gap",
+        "metadata_only": True,
+        "weights_loaded": False,
+        "native_kernels_generated": False,
+        "native_execution_claim": False,
+        "profile": {"batch": batch, "steps": steps, "past_length": past_length},
+        "target": {
+            "name": "amd-igpu-gfx1036",
+            "processor": AMDGCN_PROCESSOR,
+            "triple": AMDGCN_TRIPLE,
+            "target_key": AMD_IGPU_GFX1036.key,
+        },
+        "gpu_common_operations": list(SUPPORTED_STATIC_OPERATIONS),
+        "operation_total": total,
+        "operation_counts": dict(sorted(counts.items())),
+        "canonical_operation_counts": dict(sorted(canonical_counts.items())),
+        "static_subset_operation_total": sum(
+            count for name, count in canonical_counts.items() if name in SUPPORTED_STATIC_OPERATIONS
+        ),
+        "unsupported_operation_counts": dict(sorted(unsupported.items())),
+        "runtime": status.to_dict(),
+        "graph_metadata": _plain(program.metadata),
+        "notes": [
+            "This audit counts Core operations only.",
+            "Unsupported operations are a capability gap, not a native-code failure.",
+            "Do not interpret the static subset count as whole-model AMDGPU coverage.",
+        ],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--batch", type=int, default=1)
+    parser.add_argument("--steps", type=int, default=1)
+    parser.add_argument("--past-length", type=int, default=4096)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    report = build_report(args.batch, args.steps, args.past_length)
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({key: report[key] for key in ("operation_total", "static_subset_operation_total", "unsupported_operation_counts", "metadata_only", "native_kernels_generated")}, ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
