+"""Static AMDGPU gfx1036 target, LLVM codegen and fail-closed runtime tests."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+
+import pytest
+
+from pypto.backends.hip import AmdgpuRuntimeUnavailable, AmdgpuStaticRuntime
+from pypto.compiler import Artifact
+from pypto.compiler.targets.gpu import GpuCommonCompiler
+from pypto.compiler.targets.hip import (
+    AmdgpuArtifactError,
+    AmdgpuStaticCompiler,
+    AmdgpuUnsupportedError,
+    decode_amdgpu_artifact,
+    render_amdgcn_llvm,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.gpu import lower_gpu_common
+from pypto.target import (
+    AMDGCN_PROCESSOR,
+    AMDGCN_TRIPLE,
+    AMD_IGPU_GFX1036,
+    TargetSpec,
+    make_amd_igpu_gfx1036_target,
+    target_cache_key,
+    validate_amd_igpu_gfx1036_target,
+)
+
+
+def _program(operation_name="add", dtype="float32", shape=(5,)):
+    value_type = CoreType.tensor(dtype, shape)
+    if operation_name in ("add", "mul"):
+        left = ValueRef("left", value_type)
+        right = ValueRef("right", value_type)
+        inputs = (left, right)
+    else:
+        left = ValueRef("left", value_type)
+        inputs = (left,)
+    if operation_name == "reduce_sum":
+        output_type = CoreType.tensor(dtype, ())
+        attributes = {"axis": 0}
+    elif operation_name == "matmul":
+        left_type = CoreType.tensor(dtype, (2, 3))
+        right_type = CoreType.tensor(dtype, (3, 4))
+        left = ValueRef("left", left_type)
+        right = ValueRef("right", right_type)
+        inputs = (left, right)
+        output_type = CoreType.tensor(dtype, (2, 4))
+        attributes = {}
+    else:
+        output_type = value_type
+        attributes = {}
+    output = ValueRef("output", output_type)
+    operation = Operation(operation_name, inputs, (output,), attributes=attributes)
+    return CoreProgram(
+        functions=(CoreFunction("main", inputs, (output,), Region((operation,))),)
+    )
+
+
+def _rebuild(artifact, payload_updates=None, metadata_updates=None):
+    payload_data = json.loads(artifact.payload.decode("utf-8"))
+    payload_data.update(payload_updates or {})
+    payload = json.dumps(payload_data, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    metadata = dict(artifact.metadata)
+    metadata.update(metadata_updates or {})
+    metadata["payload_digest"] = hashlib.sha256(payload).hexdigest()
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=payload,
+        metadata=metadata,
+    )
+
+
+def test_gfx1036_profile_is_exact_and_keeps_unverified_capabilities_unknown():
+    target = make_amd_igpu_gfx1036_target({"workgroup": (64,)})
+    assert target.kind == "gpu"
+    assert target.triple == AMDGCN_TRIPLE
+    assert target.attributes["processor"] == AMDGCN_PROCESSOR
+    assert target.attributes["wavefront_size"] == "unknown"
+    assert target.attributes["bf16"] == "unknown"
+    assert target.attributes["int8"] == "unknown"
+    assert target.attributes["mfma"] == "unknown"
+    assert target.attributes["wmma"] == "unknown"
+    assert target.attributes["xnack"] == "unknown"
+    assert target.attributes["static_only"] is True
+    assert target.attributes["runtime_unverified"] is True
+    validate_amd_igpu_gfx1036_target(target)
+    assert target_cache_key(target) != target_cache_key(make_amd_igpu_gfx1036_target({"workgroup": (128,)}))
+
+    wrong = TargetSpec(
+        "gpu",
+        AMDGCN_TRIPLE,
+        features=("static", AMDGCN_PROCESSOR),
+        device={"name": "amd-igpu-gfx1036", "processor": "gfx1031", "runtime": "hip"},
+        abi=target.abi,
+        attributes=dict(target.attributes, processor="gfx1031"),
+    )
+    with pytest.raises(ValueError, match="gfx1036"):
+        validate_amd_igpu_gfx1036_target(wrong)
+
+
+def test_amd_adapter_projects_clean_target_to_gpu_common_without_vendor_terms():
+    program = _program("add")
+    common_target = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+    common = lower_gpu_common(program, common_target)
+    common_artifact = GpuCommonCompiler().compile(common)
+    payload = common_artifact.payload.decode("utf-8").lower()
+    for forbidden in ("cuda", "hip", "amdgpu", "rocdl", "mfma", "wmma"):
+        assert forbidden not in payload
+
+    target_ir = AmdgpuStaticCompiler().lower(program, AMD_IGPU_GFX1036)
+    assert target_ir.gpu_program.target.triple == "gpu-neutral"
+    assert target_ir.target.triple == AMDGCN_TRIPLE
+    assert "addrspace(1)" in target_ir.llvm_ir
+    assert "llvm.amdgcn.workitem.id.x" in target_ir.llvm_ir
+
+
+@pytest.mark.parametrize("operation_name,dtype", (("identity", "float32"), ("add", "float32"), ("mul", "bf16"), ("reduce_sum", "float32"), ("matmul", "bf16")))
+def test_static_llvm_artifact_is_deterministic_and_has_real_code(operation_name, dtype):
+    compiler = AmdgpuStaticCompiler()
+    first = compiler.compile(compiler.lower(_program(operation_name, dtype), AMD_IGPU_GFX1036))
+    second = compiler.compile(compiler.lower(_program(operation_name, dtype), AMD_IGPU_GFX1036))
+    assert first.payload == second.payload
+    assert first.cache_key == second.cache_key
+    assert first.metadata["processor"] == AMDGCN_PROCESSOR
+    assert first.metadata["triple"] == AMDGCN_TRIPLE
+    assert first.metadata["ir_dialect"] == "llvm.amdgcn"
+    assert first.metadata["mlir_rocdl"] is False
+    assert first.metadata["static_only"] is True
+    assert first.metadata["runtime_unverified"] is True
+    envelope = json.loads(first.payload.decode("utf-8"))
+    assert "load " in envelope["llvm_ir"]
+    assert "store " in envelope["llvm_ir"]
+    assert "gfx1036" in envelope["assembly"].lower()
+    assert len(envelope["object_b64"]) > 80
+    decoded = decode_amdgpu_artifact(first)
+    assert decoded.llvm_ir == envelope["llvm_ir"]
+
+
+def test_unsupported_static_operation_is_explicitly_rejected():
+    with pytest.raises(AmdgpuUnsupportedError, match="explicitly rejects|supported operations"):
+        AmdgpuStaticCompiler().lower(_program("compare"), AMD_IGPU_GFX1036)
+
+
+def test_llvm_ir_and_target_tamper_fail_closed():
+    compiler = AmdgpuStaticCompiler()
+    artifact = compiler.compile(compiler.lower(_program("add"), AMD_IGPU_GFX1036))
+    tampered_ir = _rebuild(
+        artifact,
+        {"llvm_ir": json.loads(artifact.payload.decode("utf-8"))["llvm_ir"].replace("fadd", "fmul", 1)},
+    )
+    with pytest.raises(AmdgpuArtifactError, match="LLVM IR|canonical"):
+        decode_amdgpu_artifact(tampered_ir)
+
+    changed_target = TargetSpec(
+        "gpu",
+        AMDGCN_TRIPLE,
+        features=("static", AMDGCN_PROCESSOR),
+        device=AMD_IGPU_GFX1036.device,
+        abi=AMD_IGPU_GFX1036.abi,
+        attributes=dict(AMD_IGPU_GFX1036.attributes, processor="gfx1031"),
+    )
+    changed_artifact = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=changed_target,
+        abi_version=artifact.abi_version,
+        payload=artifact.payload,
+        metadata=artifact.metadata,
+    )
+    with pytest.raises(AmdgpuArtifactError):
+        decode_amdgpu_artifact(changed_artifact)
+
+
+def test_runtime_reports_blocked_device_and_never_fakes_execution():
+    status = AmdgpuStaticRuntime().availability()
+    assert status.available is False
+    assert status.reason_code == "BLOCKED_DEVICE"
+    assert status.details["processor"] == AMDGCN_PROCESSOR
+    assert status.details["dev_kfd"] is False or status.details["runtime_verified"] is False
+    compiler = AmdgpuStaticCompiler()
+    artifact = compiler.compile(compiler.lower(_program("identity"), AMD_IGPU_GFX1036))
+    with pytest.raises(AmdgpuRuntimeUnavailable):
+        AmdgpuStaticRuntime().load(artifact)
