diff --git a/python/pypto/compiler/targets/hip.py b/python/pypto/compiler/targets/hip.py
new file mode 100644
index 000000000..48aa96244
--- /dev/null
+++ b/python/pypto/compiler/targets/hip.py
@@ -0,0 +1,974 @@
+"""Static AMDGPU LLVM backend for the ``amd-igpu-gfx1036`` profile.
+
+The backend consumes only :class:`~pypto.lowering.gpu.GpuProgram`, which is
+the already-frozen vendor-neutral GPU common IR.  It emits ordinary LLVM IR
+for the AMDGCN target and asks the installed ``llvm-as``/``llc`` tools to
+assemble and code-generate it.  This is intentionally *not* an MLIR ROCDL
+backend: no ROCDL dialect, MFMA instruction, wavefront width, or runtime
+library is assumed here.
+
+The resulting artifact is static-only and carries an explicit
+``runtime_unverified`` marker.  The corresponding runtime refuses to load or
+launch it until a real HIP/HSA device is exposed by the host.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram, CoreType, Operation, ValueRef
+from pypto.lowering.cpu import canonical_dtype, canonical_operation_name, static_shape
+from pypto.lowering.gpu import (
+    GPU_COMMON_BACKEND,
+    GPU_IR_VERSION,
+    GPU_LOWERING_VERSION,
+    GPU_PLAN_VERSION,
+    GpuProgram,
+    lower_gpu_common,
+)
+from pypto.target import (
+    AMDGCN_PROCESSOR,
+    AMDGCN_TRIPLE,
+    AMD_IGPU_GFX1036,
+    AMD_IGPU_GFX1036_NAME,
+    validate_amd_igpu_gfx1036_target,
+)
+from pypto.target._utils import frozen_mapping, mapping_copy, sha256_bytes, sha256_text
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+AMDGPU_ARTIFACT_FORMAT = "pypto-x.amdgpu.llvm"
+DEFAULT_ARTIFACT_FORMAT = AMDGPU_ARTIFACT_FORMAT
+AMDGPU_BACKEND = "amdgpu.llvm.static"
+HIP_BACKEND = "hip.amdgpu.static"
+AMDGPU_LLVM_IR_VERSION = "llvm.amdgcn.v1"
+AMDGPU_LOWERING_VERSION = 1
+AMDGPU_ABI_VERSION = ABI_VERSION
+_GFX_RE = re.compile(r"^gfx[0-9]{4}$\Z")
+_SUPPORTED_OPS = frozenset(("identity", "add", "mul", "reduce_sum", "matmul"))
+_SUPPORTED_DTYPES = frozenset(("float32", "bf16"))
+
+
+class AmdgpuStaticError(ValueError):
+    """Base error for static AMDGPU target lowering and artifact validation."""
+
+
+class AmdgpuUnsupportedError(AmdgpuStaticError):
+    """A valid common GPU operation outside the C1 static subset."""
+
+
+class AmdgpuArtifactError(AmdgpuStaticError):
+    """Malformed, tampered, or target-incompatible AMDGPU artifact."""
+
+
+class AmdgpuToolchainError(AmdgpuStaticError):
+    """The local LLVM AMDGCN assembler/code generator is unavailable."""
+
+
+def _plain(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def _safe_identifier(value: str) -> str:
+    result = re.sub(r"[^A-Za-z0-9_$.-]", "_", str(value))
+    if not result or result[0].isdigit():
+        result = "f_" + result
+    return result
+
+
+def _common_target(target: Any):
+    """Project the AMD profile onto a clean GPU-common target."""
+
+    validate_amd_igpu_gfx1036_target(target)
+    common_keys = (
+        "workgroup",
+        "workgroup_size",
+        "block_dim",
+        "supported_subgroup_sizes",
+        "subgroup_sizes",
+        "subgroup_size",
+        "dynamic_workgroup_memory_bytes",
+        "tile",
+        "entrypoint",
+        "required_capabilities",
+        "capabilities",
+        "specialization",
+    )
+    attributes = {
+        key: target.attributes[key]
+        for key in common_keys
+        if key in target.attributes
+    }
+    return type(target)(kind="gpu", triple="gpu-neutral", attributes=attributes)
+
+
+def _item_type(dtype: str) -> str:
+    dtype = canonical_dtype(dtype)
+    if dtype == "float32":
+        return "float"
+    if dtype == "bf16":
+        # BF16 is storage-only in C1.  Arithmetic is performed in f32 and
+        # rounded back to the two-byte storage representation explicitly.
+        return "i16"
+    raise AmdgpuUnsupportedError("AMDGPU static backend supports only FP32/BF16 storage, got {!r}".format(dtype))
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _element_count(shape: Sequence[int]) -> int:
+    result = 1
+    for value in shape:
+        result *= int(value)
+    return result
+
+
+class _IRBuilder:
+    def __init__(self) -> None:
+        self.lines = []
+        self.counter = 0
+
+    def line(self, value: str = "") -> None:
+        self.lines.append(value)
+
+    def temp(self, prefix: str = "v") -> str:
+        result = "%{}{}".format(prefix, self.counter)
+        self.counter += 1
+        return result
+
+    def label(self, prefix: str) -> str:
+        result = "{}.{}".format(prefix, self.counter)
+        self.counter += 1
+        return result
+
+
+def _emit_index(builder: _IRBuilder, plan: Any) -> str:
+    """Compute a 64-bit flattened global index from explicit AMDGCN IDs."""
+
+    grid = plan.geometry.grid
+    workgroup = plan.geometry.workgroup
+    wgx = builder.temp("wgx")
+    wgy = builder.temp("wgy")
+    wgz = builder.temp("wgz")
+    tidx = builder.temp("tidx")
+    tidy = builder.temp("tidy")
+    tidz = builder.temp("tidz")
+    builder.line("  {} = call i32 @llvm.amdgcn.workgroup.id.x()".format(wgx))
+    builder.line("  {} = call i32 @llvm.amdgcn.workgroup.id.y()".format(wgy))
+    builder.line("  {} = call i32 @llvm.amdgcn.workgroup.id.z()".format(wgz))
+    builder.line("  {} = call i32 @llvm.amdgcn.workitem.id.x()".format(tidx))
+    builder.line("  {} = call i32 @llvm.amdgcn.workitem.id.y()".format(tidy))
+    builder.line("  {} = call i32 @llvm.amdgcn.workitem.id.z()".format(tidz))
+    ids = []
+    for name in (wgx, wgy, wgz, tidx, tidy, tidz):
+        widened = builder.temp("id64")
+        builder.line("  {} = zext i32 {} to i64".format(widened, name))
+        ids.append(widened)
+    wgx64, wgy64, wgz64, tidx64, tidy64, tidz64 = ids
+    group_y = builder.temp("group_y")
+    group_yx = builder.temp("group_yx")
+    group_flat_base = builder.temp("group_flat_base")
+    group_flat = builder.temp("group_flat")
+    builder.line("  {} = mul i64 {}, {}".format(group_y, wgz64, int(grid.y)))
+    builder.line("  {} = add i64 {}, {}".format(group_yx, group_y, wgy64))
+    builder.line("  {} = mul i64 {}, {}".format(group_flat_base, group_yx, int(grid.x)))
+    builder.line("  {} = add i64 {}, {}".format(group_flat, group_flat_base, wgx64))
+    thread_y = builder.temp("thread_y")
+    thread_yz = builder.temp("thread_yz")
+    thread_flat_base = builder.temp("thread_flat_base")
+    thread_flat = builder.temp("thread_flat")
+    builder.line("  {} = mul i64 {}, {}".format(thread_y, tidy64, int(workgroup.x)))
+    builder.line("  {} = mul i64 {}, {}".format(thread_yz, tidz64, int(workgroup.x * workgroup.y)))
+    builder.line("  {} = add i64 {}, {}".format(thread_flat_base, thread_y, thread_yz))
+    builder.line("  {} = add i64 {}, {}".format(thread_flat, thread_flat_base, tidx64))
+    threads = builder.temp("threads")
+    result = builder.temp("index")
+    builder.line("  {} = mul i64 {}, {}".format(threads, group_flat, int(workgroup.count)))
+    builder.line("  {} = add i64 {}, {}".format(result, threads, thread_flat))
+    return result
+
+
+def _emit_pointer(builder: _IRBuilder, pointer: str, index: str, dtype: str) -> str:
+    item_type = _item_type(dtype)
+    result = builder.temp("ptr")
+    builder.line(
+        "  {} = getelementptr {}, ptr addrspace(1) {}, i64 {}".format(
+            result, item_type, pointer, index
+        )
+    )
+    return result
+
+
+def _emit_load(builder: _IRBuilder, pointer: str, index: str, dtype: str) -> str:
+    dtype = canonical_dtype(dtype)
+    item_type = _item_type(dtype)
+    address = _emit_pointer(builder, pointer, index, dtype)
+    loaded = builder.temp("load")
+    alignment = 4 if dtype == "float32" else 2
+    builder.line("  {} = load {}, ptr addrspace(1) {}, align {}".format(loaded, item_type, address, alignment))
+    if dtype == "float32":
+        return loaded
+    widened = builder.temp("bf16wide")
+    shifted = builder.temp("bf16bits")
+    result = builder.temp("bf16f32")
+    builder.line("  {} = zext i16 {} to i32".format(widened, loaded))
+    builder.line("  {} = shl i32 {}, 16".format(shifted, widened))
+    builder.line("  {} = bitcast i32 {} to float".format(result, shifted))
+    return result
+
+
+def _emit_store(builder: _IRBuilder, pointer: str, index: str, dtype: str, value: str) -> None:
+    dtype = canonical_dtype(dtype)
+    item_type = _item_type(dtype)
+    address = _emit_pointer(builder, pointer, index, dtype)
+    if dtype == "float32":
+        builder.line("  store float {}, ptr addrspace(1) {}, align 4".format(value, address))
+        return
+    bits = builder.temp("outbits")
+    rounded = builder.temp("rounded")
+    lsb = builder.temp("lsb")
+    rounded_lsb = builder.temp("rounded_lsb")
+    upper = builder.temp("upper")
+    rounded_upper = builder.temp("rounded_upper")
+    result = builder.temp("bf16out")
+    builder.line("  {} = bitcast float {} to i32".format(bits, value))
+    builder.line("  {} = lshr i32 {}, 16".format(upper, bits))
+    builder.line("  {} = and i32 {}, 1".format(lsb, upper))
+    builder.line("  {} = add i32 {}, 32767".format(rounded, bits))
+    builder.line("  {} = add i32 {}, {}".format(rounded_lsb, rounded, lsb))
+    builder.line("  {} = lshr i32 {}, 16".format(rounded_upper, rounded_lsb))
+    builder.line("  {} = trunc i32 {} to i16".format(result, rounded_upper))
+    builder.line("  store i16 {}, ptr addrspace(1) {}, align 2".format(result, address))
+
+
+def _validate_tensor_pair(operation: Operation, name: str) -> Tuple[str, Tuple[int, ...]]:
+    if len(operation.outputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires exactly one output".format(name))
+    output = operation.outputs[0]
+    if not _is_tensor(output.type):
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires tensor output".format(name))
+    dtype = canonical_dtype(output.type.dtype)
+    if dtype not in _SUPPORTED_DTYPES:
+        raise AmdgpuUnsupportedError("static AMDGPU {} does not support dtype {!r}".format(name, dtype))
+    output_shape = static_shape(output.type, "AMDGPU {} output".format(name))
+    if any(int(dimension) == 0 for dimension in output_shape):
+        raise AmdgpuUnsupportedError("static AMDGPU {} does not emit zero-sized kernels".format(name))
+    for ref in operation.inputs:
+        if not _is_tensor(ref.type):
+            raise AmdgpuUnsupportedError("static AMDGPU {} supports tensor operands only".format(name))
+        if canonical_dtype(ref.type.dtype) != dtype:
+            raise AmdgpuUnsupportedError("static AMDGPU {} requires matching storage dtypes".format(name))
+        if any(int(dimension) == 0 for dimension in static_shape(ref.type, "AMDGPU {} input".format(name))):
+            raise AmdgpuUnsupportedError("static AMDGPU {} does not emit zero-sized kernels".format(name))
+    return dtype, output_shape
+
+
+def _emit_elementwise(builder: _IRBuilder, operation: Operation, plan: Any, kernel_index: int) -> None:
+    name = canonical_operation_name(operation.name)
+    dtype, output_shape = _validate_tensor_pair(operation, name)
+    expected_inputs = 1 if name == "identity" else 2
+    if len(operation.inputs) != expected_inputs:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires {} input tensors".format(name, expected_inputs))
+    index = _emit_index(builder, plan)
+    body = builder.label("body")
+    exit_label = builder.label("exit")
+    count = _element_count(output_shape)
+    predicate = builder.temp("in_bounds")
+    builder.line("  {} = icmp ult i64 {}, {}".format(predicate, index, count))
+    builder.line("  br i1 {}, label %{}, label %{}".format(predicate, body, exit_label))
+    builder.line("{}:".format(body))
+    values = []
+    for operand_index, _ref in enumerate(operation.inputs):
+        values.append(_emit_load(builder, "%arg{}".format(operand_index), index, dtype))
+    if name == "identity":
+        result = values[0]
+    else:
+        result = builder.temp("result")
+        opcode = "fadd" if name == "add" else "fmul"
+        builder.line("  {} = {} float {}, {}".format(result, opcode, values[0], values[1]))
+    _emit_store(builder, "%arg{}".format(len(operation.inputs)), index, dtype, result)
+    builder.line("  br label %{}".format(exit_label))
+    builder.line("{}:".format(exit_label))
+    builder.line("  ret void")
+
+
+def _emit_reduce_sum(builder: _IRBuilder, operation: Operation, plan: Any) -> None:
+    dtype, output_shape = _validate_tensor_pair(operation, "reduce_sum")
+    if len(operation.inputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU reduce_sum requires one input tensor")
+    reduction = plan.reduction
+    if reduction is None or tuple(reduction.axes) != tuple(range(len(reduction.input_shape))) or _element_count(output_shape) != 1:
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU reduce_sum C1 supports only reduction over all axes into one element"
+        )
+    index = _emit_index(builder, plan)
+    body = builder.label("body")
+    exit_label = builder.label("exit")
+    predicate = builder.temp("in_bounds")
+    builder.line("  {} = icmp ult i64 {}, 1".format(predicate, index))
+    builder.line("  br i1 {}, label %{}, label %{}".format(predicate, body, exit_label))
+    builder.line("{}:".format(body))
+    condition = builder.label("reduce_cond")
+    reduce_body = builder.label("reduce_body")
+    done = builder.label("reduce_done")
+    builder.line("  br label %{}".format(condition))
+    builder.line("{}:".format(condition))
+    counter = builder.temp("r")
+    accumulator = builder.temp("acc")
+    next_counter = builder.temp("next_r")
+    next_accumulator = builder.temp("next_acc")
+    builder.line("  {} = phi i64 [ 0, %{} ], [ {}, %{} ]".format(counter, body, next_counter, reduce_body))
+    builder.line("  {} = phi float [ 0.000000e+00, %{} ], [ {}, %{} ]".format(accumulator, body, next_accumulator, reduce_body))
+    input_count = _element_count(reduction.input_shape)
+    more = builder.temp("more")
+    builder.line("  {} = icmp ult i64 {}, {}".format(more, counter, input_count))
+    builder.line("  br i1 {}, label %{}, label %{}".format(more, reduce_body, done))
+    builder.line("{}:".format(reduce_body))
+    value = _emit_load(builder, "%arg0", counter, dtype)
+    builder.line("  {} = fadd float {}, {}".format(next_accumulator, accumulator, value))
+    builder.line("  {} = add i64 {}, 1".format(next_counter, counter))
+    builder.line("  br label %{}".format(condition))
+    builder.line("{}:".format(done))
+    _emit_store(builder, "%arg1", "0", dtype, accumulator)
+    builder.line("  br label %{}".format(exit_label))
+    builder.line("{}:".format(exit_label))
+    builder.line("  ret void")
+
+
+def _emit_matmul(builder: _IRBuilder, operation: Operation, plan: Any) -> None:
+    dtype, output_shape = _validate_tensor_pair(operation, "matmul")
+    if len(operation.inputs) != 2:
+        raise AmdgpuUnsupportedError("static AMDGPU matmul requires two input tensors")
+    matmul = plan.matmul
+    if matmul is None or len(output_shape) != 2:
+        raise AmdgpuUnsupportedError("static AMDGPU matmul C1 supports rank-2 matrices only")
+    m, k, n = int(matmul.m), int(matmul.k), int(matmul.n)
+    index = _emit_index(builder, plan)
+    body = builder.label("body")
+    exit_label = builder.label("exit")
+    predicate = builder.temp("in_bounds")
+    builder.line("  {} = icmp ult i64 {}, {}".format(predicate, index, _element_count(output_shape)))
+    builder.line("  br i1 {}, label %{}, label %{}".format(predicate, body, exit_label))
+    builder.line("{}:".format(body))
+    row = builder.temp("row")
+    col = builder.temp("col")
+    builder.line("  {} = udiv i64 {}, {}".format(row, index, n))
+    builder.line("  {} = urem i64 {}, {}".format(col, index, n))
+    condition = builder.label("matmul_cond")
+    matmul_body = builder.label("matmul_body")
+    done = builder.label("matmul_done")
+    builder.line("  br label %{}".format(condition))
+    builder.line("{}:".format(condition))
+    counter = builder.temp("k")
+    accumulator = builder.temp("acc")
+    next_counter = builder.temp("next_k")
+    next_accumulator = builder.temp("next_acc")
+    builder.line("  {} = phi i64 [ 0, %{} ], [ {}, %{} ]".format(counter, body, next_counter, matmul_body))
+    builder.line("  {} = phi float [ 0.000000e+00, %{} ], [ {}, %{} ]".format(accumulator, body, next_accumulator, matmul_body))
+    more = builder.temp("more")
+    builder.line("  {} = icmp ult i64 {}, {}".format(more, counter, k))
+    builder.line("  br i1 {}, label %{}, label %{}".format(more, matmul_body, done))
+    builder.line("{}:".format(matmul_body))
+    left_row = builder.temp("left_row")
+    left_index = builder.temp("left_index")
+    right_row = builder.temp("right_row")
+    right_index = builder.temp("right_index")
+    builder.line("  {} = mul i64 {}, {}".format(left_row, row, k))
+    builder.line("  {} = add i64 {}, {}".format(left_index, left_row, counter))
+    builder.line("  {} = mul i64 {}, {}".format(right_row, counter, n))
+    builder.line("  {} = add i64 {}, {}".format(right_index, right_row, col))
+    left = _emit_load(builder, "%arg0", left_index, dtype)
+    right = _emit_load(builder, "%arg1", right_index, dtype)
+    product = builder.temp("product")
+    builder.line("  {} = fmul float {}, {}".format(product, left, right))
+    builder.line("  {} = fadd float {}, {}".format(next_accumulator, accumulator, product))
+    builder.line("  {} = add i64 {}, 1".format(next_counter, counter))
+    builder.line("  br label %{}".format(condition))
+    builder.line("{}:".format(done))
+    _emit_store(builder, "%arg2", index, dtype, accumulator)
+    builder.line("  br label %{}".format(exit_label))
+    builder.line("{}:".format(exit_label))
+    builder.line("  ret void")
+
+
+def _render_kernel(operation: Operation, plan: Any, index: int, entrypoint: str) -> Tuple[str, Mapping[str, Any]]:
+    name = canonical_operation_name(operation.name)
+    if name not in _SUPPORTED_OPS:
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU backend explicitly rejects operation {!r}; supported operations are {}".format(
+                name, ", ".join(sorted(_SUPPORTED_OPS))
+            )
+        )
+    kernel_name = "pypto_x_{}_op{}".format(_safe_identifier(entrypoint), index)
+    builder = _IRBuilder()
+    args = []
+    for arg_index, ref in enumerate(operation.inputs + operation.outputs):
+        if not _is_tensor(ref.type):
+            raise AmdgpuUnsupportedError("static AMDGPU supports tensor pointer bindings only")
+        args.append("ptr addrspace(1) %arg{}".format(arg_index))
+    builder.line("define amdgpu_kernel void @{}({}) {{".format(kernel_name, ", ".join(args)))
+    builder.line("entry:")
+    if name in ("identity", "add", "mul"):
+        _emit_elementwise(builder, operation, plan, index)
+    elif name == "reduce_sum":
+        _emit_reduce_sum(builder, operation, plan)
+    elif name == "matmul":
+        _emit_matmul(builder, operation, plan)
+    builder.line("}")
+    bindings = {
+        "kernel": kernel_name,
+        "operation": name,
+        "operation_index": index,
+        "entrypoint": entrypoint,
+        "inputs": [
+            {"name": ref.name, "dtype": canonical_dtype(ref.type.dtype), "address_space": 1}
+            for ref in operation.inputs
+        ],
+        "outputs": [
+            {"name": ref.name, "dtype": canonical_dtype(ref.type.dtype), "address_space": 1}
+            for ref in operation.outputs
+        ],
+        "geometry": plan.geometry.to_dict(),
+    }
+    return "\n".join(builder.lines), bindings
+
+
+def render_amdgcn_llvm(gpu_program: GpuProgram, target: Any) -> Tuple[str, Tuple[Mapping[str, Any], ...]]:
+    """Render deterministic AMDGCN LLVM IR and its pointer-binding manifest."""
+
+    validate_amd_igpu_gfx1036_target(target)
+    if not isinstance(gpu_program, GpuProgram):
+        raise TypeError("AMDGPU LLVM rendering requires GpuProgram")
+    gpu_program.validate()
+    function = next(function for function in gpu_program.program.functions if function.name == gpu_program.entrypoint)
+    kernels = []
+    bindings = []
+    for index, operation in enumerate(function.body.operations):
+        kernel, manifest = _render_kernel(operation, gpu_program.plans[index], index, gpu_program.entrypoint)
+        kernels.append(kernel)
+        bindings.append(manifest)
+    header = [
+        "; PyPTO-X static AMDGCN LLVM IR; dialect=llvm.amdgcn; runtime=unverified",
+        "; target processor={} triple={}".format(AMDGCN_PROCESSOR, AMDGCN_TRIPLE),
+        'target triple = "{}"'.format(AMDGCN_TRIPLE),
+        "",
+        "declare i32 @llvm.amdgcn.workitem.id.x()",
+        "declare i32 @llvm.amdgcn.workitem.id.y()",
+        "declare i32 @llvm.amdgcn.workitem.id.z()",
+        "declare i32 @llvm.amdgcn.workgroup.id.x()",
+        "declare i32 @llvm.amdgcn.workgroup.id.y()",
+        "declare i32 @llvm.amdgcn.workgroup.id.z()",
+        "",
+    ]
+    return "\n".join(header + kernels) + "\n", tuple(bindings)
+
+
+def _validate_static_operation_names(program: CoreProgram) -> None:
+    for function in program.functions:
+        for operation in function.body.operations:
+            try:
+                name = canonical_operation_name(operation.name)
+            except Exception as exc:
+                raise AmdgpuUnsupportedError(
+                    "static AMDGPU backend explicitly rejects operation {!r}; supported operations are {}".format(
+                        operation.name, ", ".join(sorted(_SUPPORTED_OPS))
+                    )
+                ) from exc
+            if name not in _SUPPORTED_OPS:
+                raise AmdgpuUnsupportedError(
+                    "static AMDGPU backend explicitly rejects operation {!r}; supported operations are {}".format(
+                        name, ", ".join(sorted(_SUPPORTED_OPS))
+                    )
+                )
+
+
+@dataclass(frozen=True, init=False)
+class AmdgpuProgram:
+    """Static AMDGCN target IR paired with the vendor-neutral GPU program."""
+
+    gpu_program: GpuProgram
+    target: Any
+    llvm_ir: str
+    bindings: Tuple[Mapping[str, Any], ...]
+
+    def __init__(self, gpu_program: GpuProgram, target: Any, llvm_ir: str, bindings: Sequence[Mapping[str, Any]]):
+        validate_amd_igpu_gfx1036_target(target)
+        if not isinstance(gpu_program, GpuProgram):
+            raise AmdgpuStaticError("AMDGPU program requires a vendor-neutral GpuProgram")
+        if gpu_program.target.kind != "gpu" or gpu_program.target.triple != "gpu-neutral":
+            raise AmdgpuStaticError("AMDGPU program requires the gpu-neutral common target")
+        if not isinstance(llvm_ir, str) or not llvm_ir.strip():
+            raise AmdgpuStaticError("AMDGPU LLVM IR must be non-empty")
+        normalized_bindings = tuple(frozen_mapping(item) for item in bindings)
+        if len(normalized_bindings) != len(gpu_program.plans):
+            raise AmdgpuStaticError("AMDGPU binding count must match GPU common plan count")
+        object.__setattr__(self, "gpu_program", gpu_program)
+        object.__setattr__(self, "target", target)
+        object.__setattr__(self, "llvm_ir", llvm_ir)
+        object.__setattr__(self, "bindings", normalized_bindings)
+
+    @property
+    def program(self) -> GpuProgram:
+        return self.gpu_program
+
+    @property
+    def entrypoint(self) -> str:
+        return self.gpu_program.entrypoint
+
+    @property
+    def llvm_ir_digest(self) -> str:
+        return hashlib.sha256(self.llvm_ir.encode("utf-8")).hexdigest()
+
+    def validate(self) -> "AmdgpuProgram":
+        validate_amd_igpu_gfx1036_target(self.target)
+        if self.gpu_program.target.kind != "gpu" or self.gpu_program.target.triple != "gpu-neutral":
+            raise AmdgpuArtifactError("AMDGPU program common target is not gpu-neutral")
+        self.gpu_program.validate()
+        expected_ir, expected_bindings = render_amdgcn_llvm(self.gpu_program, self.target)
+        if self.llvm_ir != expected_ir:
+            raise AmdgpuArtifactError("AMDGPU LLVM IR does not match the canonical GPU common plan")
+        if tuple(mapping_copy(item) for item in self.bindings) != tuple(expected_bindings):
+            raise AmdgpuArtifactError("AMDGPU binding manifest does not match the canonical plan")
+        return self
+
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate()
+        return {
+            "backend": AMDGPU_BACKEND,
+            "llvm_ir_version": AMDGPU_LLVM_IR_VERSION,
+            "target": self.target.to_dict(),
+            "gpu_program": self.gpu_program.to_dict(),
+            "llvm_ir": self.llvm_ir,
+            "llvm_ir_digest": self.llvm_ir_digest,
+            "bindings": [mapping_copy(item) for item in self.bindings],
+            "static_only": True,
+            "runtime_unverified": True,
+        }
+
+
+def _resolve_tool(name: Any, label: str) -> str:
+    requested = str(name or label)
+    path = shutil.which(requested)
+    if path is None and Path(requested).is_file():
+        path = str(Path(requested))
+    if path is None:
+        raise AmdgpuToolchainError("{} executable {!r} was not found".format(label, requested))
+    return path
+
+
+def _tool_version(path: str) -> str:
+    try:
+        result = subprocess.run([path, "--version"], check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    except (OSError, subprocess.CalledProcessError) as exc:
+        raise AmdgpuToolchainError("unable to query LLVM tool {!r}".format(path)) from exc
+    return (result.stdout.splitlines() or [Path(path).name])[0].strip()
+
+
+def _run_static_toolchain(llvm_ir: str, options: Optional[CompileOptions]) -> Tuple[bytes, str, Mapping[str, Any]]:
+    extra = mapping_copy(options.extra) if options is not None else {}
+    llvm_as = _resolve_tool(extra.get("llvm_as"), "llvm-as")
+    llc = _resolve_tool(extra.get("llc"), "llc")
+    with tempfile.TemporaryDirectory(prefix="pypto-x-amdgpu-") as directory:
+        root = Path(directory)
+        ir_path = root / "kernel.ll"
+        bc_path = root / "kernel.bc"
+        asm_path = root / "kernel.s"
+        obj_path = root / "kernel.o"
+        ir_path.write_text(llvm_ir, encoding="utf-8")
+        try:
+            subprocess.run([llvm_as, str(ir_path), "-o", str(bc_path)], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            subprocess.run([llc, "-march=amdgcn", "-mcpu={}".format(AMDGCN_PROCESSOR), "-filetype=asm", str(bc_path), "-o", str(asm_path)], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            subprocess.run([llc, "-march=amdgcn", "-mcpu={}".format(AMDGCN_PROCESSOR), "-filetype=obj", str(bc_path), "-o", str(obj_path)], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        except subprocess.CalledProcessError as exc:
+            detail = (exc.stderr or exc.stdout or "").strip()
+            raise AmdgpuToolchainError("LLVM AMDGCN static codegen failed: {}".format(detail)) from exc
+        except OSError as exc:
+            raise AmdgpuToolchainError("LLVM AMDGCN static codegen could not start") from exc
+        assembly = asm_path.read_text(encoding="utf-8")
+        object_bytes = obj_path.read_bytes()
+    _validate_static_outputs(llvm_ir, assembly, object_bytes)
+    toolchain = {
+        "llvm_as": Path(llvm_as).name,
+        "llvm_as_version": _tool_version(llvm_as),
+        "llc": Path(llc).name,
+        "llc_version": _tool_version(llc),
+        "march": "amdgcn",
+        "mcpu": AMDGCN_PROCESSOR,
+        "filetypes": ["asm", "obj"],
+    }
+    return object_bytes, assembly, toolchain
+
+
+def _validate_static_outputs(llvm_ir: str, assembly: str, object_bytes: bytes) -> None:
+    ir_lower = llvm_ir.lower()
+    asm_lower = assembly.lower()
+    if 'target triple = "{}"'.format(AMDGCN_TRIPLE) not in llvm_ir:
+        raise AmdgpuToolchainError("AMDGPU LLVM IR target triple is not exact")
+    if "ptr addrspace(1)" not in llvm_ir or "llvm.amdgcn.workitem.id.x" not in llvm_ir:
+        raise AmdgpuToolchainError("AMDGPU LLVM IR lacks explicit global pointers or workitem bounds")
+    if " load " not in ir_lower or " store " not in ir_lower:
+        raise AmdgpuToolchainError("AMDGPU LLVM IR lacks a real load/ALU/store path")
+    if "gfx1036" not in asm_lower or "amdgpu" not in asm_lower:
+        raise AmdgpuToolchainError("llc output is not tagged as gfx1036 AMDGPU assembly")
+    load_tokens = ("global_load", "flat_load", "buffer_load", "s_load", "ds_read")
+    store_tokens = ("global_store", "flat_store", "buffer_store")
+    alu_tokens = ("v_add", "v_mul", "v_lshl", "s_add", "s_mul")
+    if not any(token in asm_lower for token in load_tokens):
+        raise AmdgpuToolchainError("AMDGPU assembly lacks a global load")
+    if not any(token in asm_lower for token in store_tokens):
+        raise AmdgpuToolchainError("AMDGPU assembly lacks a global store")
+    if not any(token in asm_lower for token in alu_tokens):
+        raise AmdgpuToolchainError("AMDGPU assembly lacks an ALU instruction")
+    if len(object_bytes) < 64 or not object_bytes.startswith(b"\x7fELF"):
+        raise AmdgpuToolchainError("AMDGPU object is unexpectedly empty")
+
+
+class AmdgpuStaticCompiler:
+    """Compiler facade for static ``gfx1036`` AMDGCN LLVM artifacts."""
+
+    name = AMDGPU_BACKEND
+
+    def lower(self, program: CoreProgram, target: Any = AMD_IGPU_GFX1036) -> AmdgpuProgram:
+        validate_amd_igpu_gfx1036_target(target)
+        if not isinstance(program, CoreProgram):
+            raise TypeError("AMDGPU static lowering requires CoreProgram")
+        _validate_static_operation_names(program)
+        common = lower_gpu_common(program, _common_target(target))
+        llvm_ir, bindings = render_amdgcn_llvm(common, target)
+        return AmdgpuProgram(common, target, llvm_ir, bindings)
+
+    def compile(self, target_ir: AmdgpuProgram, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, AmdgpuProgram):
+            raise TypeError("AMDGPU static compile() requires AmdgpuProgram from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        target_ir.validate()
+        object_bytes, assembly, toolchain = _run_static_toolchain(target_ir.llvm_ir, options)
+        program_json = target_ir.gpu_program.program.canonical_json()
+        program_data = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        target_data = target_ir.target.to_dict()
+        llvm_digest = sha256_bytes(target_ir.llvm_ir.encode("utf-8"))
+        assembly_digest = sha256_bytes(assembly.encode("utf-8"))
+        object_digest = sha256_bytes(object_bytes)
+        envelope = {
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "backend": AMDGPU_BACKEND,
+            "hip_backend": HIP_BACKEND,
+            "llvm_ir_version": AMDGPU_LLVM_IR_VERSION,
+            "amdgpu_lowering_version": AMDGPU_LOWERING_VERSION,
+            "gpu_common_backend": GPU_COMMON_BACKEND,
+            "gpu_ir_version": GPU_IR_VERSION,
+            "lowering_version": GPU_LOWERING_VERSION,
+            "plan_version": GPU_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "target": target_data,
+            "program": program_data,
+            "program_digest": program_digest,
+            "gpu_program": target_ir.gpu_program.to_dict(),
+            "plan_digest": target_ir.gpu_program.plan_digest,
+            "llvm_ir": target_ir.llvm_ir,
+            "llvm_ir_digest": llvm_digest,
+            "source_digest": llvm_digest,
+            "source_kind": "llvm_ir",
+            "assembly": assembly,
+            "assembly_target": "amdgcn:{}".format(AMDGCN_PROCESSOR),
+            "assembly_digest": assembly_digest,
+            "object_b64": base64.b64encode(object_bytes).decode("ascii"),
+            "object_format": "elf64-amdgpu",
+            "object_digest": object_digest,
+            "bindings": _plain(target_ir.bindings),
+            "toolchain": _plain(toolchain),
+            "static_only": True,
+            "runtime_unverified": True,
+            "ir_dialect": "llvm.amdgcn",
+            "mlir_rocdl": False,
+        }
+        if options is not None:
+            envelope["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "metadata": _plain(options.metadata),
+                "extra": _plain(options.extra),
+            }
+        payload = json.dumps(envelope, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        payload_digest = sha256_bytes(payload)
+        metadata = {
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "backend": AMDGPU_BACKEND,
+            "hip_backend": HIP_BACKEND,
+            "llvm_ir_version": AMDGPU_LLVM_IR_VERSION,
+            "amdgpu_lowering_version": AMDGPU_LOWERING_VERSION,
+            "gpu_common_backend": GPU_COMMON_BACKEND,
+            "gpu_ir_version": GPU_IR_VERSION,
+            "lowering_version": GPU_LOWERING_VERSION,
+            "plan_version": GPU_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "program_digest": program_digest,
+            "plan_digest": target_ir.gpu_program.plan_digest,
+            "llvm_ir_digest": llvm_digest,
+            "source_digest": llvm_digest,
+            "source_kind": "llvm_ir",
+            "assembly_target": "amdgcn:{}".format(AMDGCN_PROCESSOR),
+            "assembly_digest": assembly_digest,
+            "object_format": "elf64-amdgpu",
+            "object_digest": object_digest,
+            "payload_digest": payload_digest,
+            "target_digest": sha256_text(target_data),
+            "processor": AMDGCN_PROCESSOR,
+            "triple": AMDGCN_TRIPLE,
+            "geometry": [plan.geometry.to_dict() for plan in target_ir.gpu_program.plans],
+            "bindings": _plain(target_ir.bindings),
+            "dtypes": sorted(set(plan.dtype for plan in target_ir.gpu_program.plans)),
+            "operations": sorted(set(plan.operation for plan in target_ir.gpu_program.plans)),
+            "toolchain": _plain(toolchain),
+            "static_only": True,
+            "runtime_unverified": True,
+            "ir_dialect": "llvm.amdgcn",
+            "mlir_rocdl": False,
+        }
+        if options is not None:
+            option_metadata = _plain(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError("compile option metadata uses reserved AMDGPU keys: {}".format(", ".join(sorted(reserved))))
+            metadata.update(option_metadata)
+            metadata["compile_options"] = envelope["compile_options"]
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = AMDGPU_ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            payload=payload,
+            metadata=metadata,
+        )
+        artifact.validate()
+        return artifact
+
+
+HipCompiler = AmdgpuStaticCompiler
+HipAmdgpuCompiler = AmdgpuStaticCompiler
+HipStaticCompiler = AmdgpuStaticCompiler
+AmdgpuCompiler = AmdgpuStaticCompiler
+AMDGPULlvmCompiler = AmdgpuStaticCompiler
+AMDGPUCompiler = AmdgpuStaticCompiler
+HipProgram = AmdgpuProgram
+HipError = AmdgpuStaticError
+HipUnsupportedError = AmdgpuUnsupportedError
+HipArtifactError = AmdgpuArtifactError
+HipToolchainError = AmdgpuToolchainError
+
+
+def compile_amdgpu_llvm(program: CoreProgram, target: Any = AMD_IGPU_GFX1036, options: Optional[CompileOptions] = None) -> Artifact:
+    compiler = AmdgpuStaticCompiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+def compile_hip_static(program: CoreProgram, target: Any = AMD_IGPU_GFX1036, options: Optional[CompileOptions] = None) -> Artifact:
+    return compile_amdgpu_llvm(program, target, options)
+
+
+compile_hip = compile_hip_static
+
+
+def _required_envelope() -> set:
+    return {
+        "artifact_payload_version", "backend", "hip_backend", "llvm_ir_version",
+        "amdgpu_lowering_version", "gpu_common_backend", "gpu_ir_version",
+        "lowering_version", "plan_version", "entrypoint", "target", "program",
+        "program_digest", "gpu_program", "plan_digest", "llvm_ir", "llvm_ir_digest",
+        "source_digest", "source_kind", "assembly", "assembly_target", "assembly_digest", "object_b64", "object_format", "object_digest", "bindings",
+        "toolchain", "static_only", "runtime_unverified", "ir_dialect", "mlir_rocdl",
+    }
+
+
+def decode_amdgpu_artifact(artifact: Artifact) -> AmdgpuProgram:
+    """Strictly decode and re-derive static artifact fields."""
+
+    if not isinstance(artifact, Artifact):
+        raise AmdgpuArtifactError("AMDGPU runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise AmdgpuArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.payload is None:
+        raise AmdgpuArtifactError("AMDGPU static artifact requires inline payload")
+    try:
+        decoded = json.loads(bytes(artifact.payload).decode("utf-8"))
+    except Exception as exc:
+        raise AmdgpuArtifactError("AMDGPU artifact payload is not UTF-8 JSON") from exc
+    if not isinstance(decoded, dict) or set(decoded) - (_required_envelope() | {"compile_options"}) or not _required_envelope().issubset(decoded):
+        raise AmdgpuArtifactError("AMDGPU artifact payload has unknown or missing fields")
+    canonical = json.dumps(decoded, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    if canonical != bytes(artifact.payload):
+        raise AmdgpuArtifactError("AMDGPU artifact payload is not canonical JSON")
+    metadata = mapping_copy(artifact.metadata)
+    required_metadata = {
+        "artifact_payload_version", "backend", "hip_backend", "llvm_ir_version",
+        "amdgpu_lowering_version", "gpu_common_backend", "gpu_ir_version",
+        "lowering_version", "plan_version", "entrypoint", "program_digest",
+        "plan_digest", "llvm_ir_digest", "source_digest", "source_kind", "assembly_target", "assembly_digest", "object_format", "object_digest",
+        "payload_digest", "target_digest", "processor", "triple", "geometry",
+        "bindings", "dtypes", "operations", "toolchain", "static_only",
+        "runtime_unverified", "ir_dialect", "mlir_rocdl",
+    }
+    if not required_metadata.issubset(metadata):
+        raise AmdgpuArtifactError("AMDGPU artifact metadata has unknown or missing fields")
+    option_metadata = {}
+    if "compile_options" in decoded:
+        options = decoded["compile_options"]
+        if not isinstance(options, dict) or set(options) != {"artifact_format", "abi_version", "metadata", "extra"}:
+            raise AmdgpuArtifactError("AMDGPU compile options are malformed")
+        if not isinstance(options["metadata"], dict) or not isinstance(options["extra"], dict):
+            raise AmdgpuArtifactError("AMDGPU compile option metadata/extra must be objects")
+        option_metadata = options["metadata"]
+    allowed_metadata = required_metadata | {"compile_options"} | set(option_metadata)
+    if set(metadata) - allowed_metadata:
+        raise AmdgpuArtifactError("AMDGPU artifact metadata has unknown fields")
+    for key, value in option_metadata.items():
+        if metadata.get(key) != value:
+            raise AmdgpuArtifactError("AMDGPU option metadata does not match payload")
+    validate_target = artifact.target
+    try:
+        validate_amd_igpu_gfx1036_target(validate_target)
+    except Exception as exc:
+        raise AmdgpuArtifactError("AMDGPU artifact target is invalid: {}".format(exc)) from exc
+    if decoded["target"] != validate_target.to_dict() or decoded["backend"] != AMDGPU_BACKEND or decoded["hip_backend"] != HIP_BACKEND:
+        raise AmdgpuArtifactError("AMDGPU artifact target/backend mismatch")
+    for field, expected in (
+        ("artifact_payload_version", ARTIFACT_PAYLOAD_VERSION),
+        ("llvm_ir_version", AMDGPU_LLVM_IR_VERSION),
+        ("amdgpu_lowering_version", AMDGPU_LOWERING_VERSION),
+        ("gpu_common_backend", GPU_COMMON_BACKEND),
+        ("gpu_ir_version", GPU_IR_VERSION),
+        ("lowering_version", GPU_LOWERING_VERSION),
+        ("plan_version", GPU_PLAN_VERSION),
+    ):
+        if decoded[field] != expected:
+            raise AmdgpuArtifactError("AMDGPU artifact version field {!r} mismatch".format(field))
+    if decoded["static_only"] is not True or decoded["runtime_unverified"] is not True or decoded["mlir_rocdl"] is not False or decoded["ir_dialect"] != "llvm.amdgcn":
+        raise AmdgpuArtifactError("AMDGPU artifact static/runtime/dialect markers are invalid")
+    if decoded["source_kind"] != "llvm_ir" or decoded["source_digest"] != decoded["llvm_ir_digest"]:
+        raise AmdgpuArtifactError("AMDGPU source digest/kind mismatch")
+    if decoded["assembly_target"] != "amdgcn:{}".format(AMDGCN_PROCESSOR) or decoded["object_format"] != "elf64-amdgpu":
+        raise AmdgpuArtifactError("AMDGPU static output target/format mismatch")
+    payload_digest = sha256_bytes(bytes(artifact.payload))
+    if artifact.content_digest != payload_digest or artifact.metadata.get("payload_digest") != payload_digest:
+        raise AmdgpuArtifactError("AMDGPU payload digest mismatch")
+    program = CoreProgram.from_dict(decoded["program"])
+    program_json = program.canonical_json()
+    program_digest = sha256_bytes(program_json.encode("utf-8"))
+    if decoded["program"] != program.to_dict() or decoded["program_digest"] != program_digest:
+        raise AmdgpuArtifactError("AMDGPU program digest mismatch")
+    try:
+        gpu_program = lower_gpu_common(
+            program,
+            _common_target(validate_target),
+            decoded["gpu_program"]["entrypoint"],
+            required_capabilities=decoded["gpu_program"].get("required_capabilities", ()),
+            specialization=decoded["gpu_program"].get("specialization", {}),
+        )
+    except Exception as exc:
+        raise AmdgpuArtifactError("GPU common plan is invalid: {}".format(exc)) from exc
+    if decoded["gpu_program"] != gpu_program.to_dict() or decoded["plan_digest"] != gpu_program.plan_digest:
+        raise AmdgpuArtifactError("AMDGPU GPU common plan digest mismatch")
+    llvm_ir, bindings = render_amdgcn_llvm(gpu_program, validate_target)
+    if decoded["llvm_ir"] != llvm_ir or decoded["llvm_ir_digest"] != sha256_bytes(llvm_ir.encode("utf-8")):
+        raise AmdgpuArtifactError("AMDGPU LLVM IR digest/canonical mismatch")
+    assembly = decoded["assembly"]
+    if not isinstance(assembly, str) or not isinstance(decoded["object_b64"], str):
+        raise AmdgpuArtifactError("AMDGPU assembly/object payload types are invalid")
+    try:
+        object_bytes = base64.b64decode(decoded["object_b64"].encode("ascii"), validate=True)
+    except Exception as exc:
+        raise AmdgpuArtifactError("AMDGPU object payload is not valid base64") from exc
+    if decoded["assembly_digest"] != sha256_bytes(assembly.encode("utf-8")) or decoded["object_digest"] != sha256_bytes(object_bytes):
+        raise AmdgpuArtifactError("AMDGPU assembly/object digest mismatch")
+    _validate_static_outputs(llvm_ir, assembly, object_bytes)
+    if tuple(decoded["bindings"]) != tuple(bindings):
+        raise AmdgpuArtifactError("AMDGPU binding manifest mismatch")
+    expected_metadata = {
+        "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+        "backend": AMDGPU_BACKEND,
+        "hip_backend": HIP_BACKEND,
+        "llvm_ir_version": AMDGPU_LLVM_IR_VERSION,
+        "amdgpu_lowering_version": AMDGPU_LOWERING_VERSION,
+        "gpu_common_backend": GPU_COMMON_BACKEND,
+        "gpu_ir_version": GPU_IR_VERSION,
+        "lowering_version": GPU_LOWERING_VERSION,
+        "plan_version": GPU_PLAN_VERSION,
+        "entrypoint": decoded["entrypoint"],
+        "program_digest": program_digest,
+        "plan_digest": gpu_program.plan_digest,
+        "llvm_ir_digest": decoded["llvm_ir_digest"],
+        "source_digest": decoded["source_digest"],
+        "source_kind": "llvm_ir",
+        "assembly_target": "amdgcn:{}".format(AMDGCN_PROCESSOR),
+        "assembly_digest": decoded["assembly_digest"],
+        "object_format": "elf64-amdgpu",
+        "object_digest": decoded["object_digest"],
+        "payload_digest": payload_digest,
+        "target_digest": sha256_text(validate_target.to_dict()),
+        "processor": AMDGCN_PROCESSOR,
+        "triple": AMDGCN_TRIPLE,
+        "geometry": [plan.geometry.to_dict() for plan in gpu_program.plans],
+        "bindings": _plain(bindings),
+        "dtypes": sorted(set(plan.dtype for plan in gpu_program.plans)),
+        "operations": sorted(set(plan.operation for plan in gpu_program.plans)),
+        "toolchain": decoded["toolchain"],
+        "static_only": True,
+        "runtime_unverified": True,
+        "ir_dialect": "llvm.amdgcn",
+        "mlir_rocdl": False,
+    }
+    for key, expected in expected_metadata.items():
+        if metadata.get(key) != expected:
+            raise AmdgpuArtifactError("AMDGPU metadata field {!r} mismatch".format(key))
+    if decoded["entrypoint"] != artifact.entrypoint:
+        raise AmdgpuArtifactError("AMDGPU artifact entrypoint mismatch")
+    if "compile_options" in decoded:
+        options = decoded["compile_options"]
+        if metadata.get("compile_options") != options or artifact.format != options["artifact_format"] or artifact.abi_version != options["abi_version"]:
+            raise AmdgpuArtifactError("AMDGPU compile options mismatch")
+    elif artifact.format != DEFAULT_ARTIFACT_FORMAT or artifact.abi_version != AMDGPU_ABI_VERSION:
+        raise AmdgpuArtifactError("AMDGPU artifact format/ABI mismatch")
+    result = AmdgpuProgram(gpu_program, validate_target, llvm_ir, bindings)
+    result.validate()
+    return result
+
+
+decode_hip_artifact = decode_amdgpu_artifact
+
+
+__all__ = [
+    "AMDGPU_ABI_VERSION", "AMDGPU_ARTIFACT_FORMAT", "AMDGPU_BACKEND", "AMDGPUCompiler",
+    "AMDGPU_LLVM_IR_VERSION", "AMDGPU_LOWERING_VERSION", "AMDGPULlvmCompiler",
+    "AmdgpuArtifactError", "AmdgpuProgram", "AmdgpuStaticCompiler", "AmdgpuStaticError",
+    "AmdgpuToolchainError", "AmdgpuUnsupportedError", "DEFAULT_ARTIFACT_FORMAT", "HIP_BACKEND",
+    "AmdgpuCompiler", "HipAmdgpuCompiler", "HipCompiler", "HipStaticCompiler", "HipProgram",
+    "HipError", "HipUnsupportedError", "HipArtifactError", "HipToolchainError",
+    "compile_amdgpu_llvm", "compile_hip", "compile_hip_static", "decode_amdgpu_artifact", "decode_hip_artifact",
+    "render_amdgcn_llvm",
+]
