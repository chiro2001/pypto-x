@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Auditable LLVM assemble/codegen/disassembly probe for gfx1036."""
+
+from __future__ import annotations
+
+import base64
+import json
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+from pypto.compiler.targets.hip import AmdgpuStaticCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import AMDGCN_PROCESSOR, AMDGCN_TRIPLE, AMD_IGPU_GFX1036
+
+
+def _program(name, dtype="float32"):
+    if name == "matmul":
+        left_type = CoreType.tensor(dtype, (2, 3))
+        right_type = CoreType.tensor(dtype, (3, 4))
+        output_type = CoreType.tensor(dtype, (2, 4))
+        left = ValueRef("left", left_type)
+        right = ValueRef("right", right_type)
+        output = ValueRef("output", output_type)
+        operation = Operation(name, (left, right), (output,))
+        parameters = (left, right)
+    elif name == "reduce_sum":
+        input_type = CoreType.tensor(dtype, (8,))
+        output_type = CoreType.tensor(dtype, ())
+        left = ValueRef("left", input_type)
+        output = ValueRef("output", output_type)
+        operation = Operation(name, (left,), (output,), attributes={"axis": 0})
+        parameters = (left,)
+    else:
+        value_type = CoreType.tensor(dtype, (7,))
+        left = ValueRef("left", value_type)
+        if name in ("add", "mul"):
+            right = ValueRef("right", value_type)
+            inputs = (left, right)
+        else:
+            inputs = (left,)
+        output = ValueRef("output", value_type)
+        operation = Operation(name, inputs, (output,))
+        parameters = inputs
+    return CoreProgram(
+        functions=(CoreFunction("main", parameters, (output,), Region((operation,))),)
+    )
+
+
+def _disassemble(object_bytes):
+    objdump = shutil.which("llvm-objdump")
+    if objdump is None:
+        raise RuntimeError("llvm-objdump is required for the static validation probe")
+    with tempfile.TemporaryDirectory(prefix="pypto-x-amdgpu-disasm-") as directory:
+        path = Path(directory) / "kernel.o"
+        path.write_bytes(object_bytes)
+        result = subprocess.run(
+            [objdump, "-d", str(path)],
+            check=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        return result.stdout
+
+
+def build_report():
+    compiler = AmdgpuStaticCompiler()
+    entries = []
+    for operation, dtype in (("identity", "float32"), ("add", "float32"), ("mul", "bf16"), ("reduce_sum", "float32"), ("matmul", "bf16")):
+        artifact = compiler.compile(compiler.lower(_program(operation, dtype), AMD_IGPU_GFX1036))
+        envelope = json.loads(artifact.payload.decode("utf-8"))
+        object_bytes = base64.b64decode(envelope["object_b64"].encode("ascii"), validate=True)
+        disassembly = _disassemble(object_bytes)
+        entries.append(
+            {
+                "operation": operation,
+                "dtype": dtype,
+                "program_digest": artifact.metadata["program_digest"],
+                "plan_digest": artifact.metadata["plan_digest"],
+                "source_digest": artifact.metadata["source_digest"],
+                "target_digest": artifact.metadata["target_digest"],
+                "llvm_ir_digest": artifact.metadata["llvm_ir_digest"],
+                "assembly_digest": artifact.metadata["assembly_digest"],
+                "object_digest": artifact.metadata["object_digest"],
+                "llvm_ir_has_global_address_space": "addrspace(1)" in envelope["llvm_ir"],
+                "llvm_ir_has_bounds": "icmp ult i64" in envelope["llvm_ir"],
+                "assembly_has_load": any(token in envelope["assembly"].lower() for token in ("global_load", "flat_load", "s_load")),
+                "assembly_has_store": any(token in envelope["assembly"].lower() for token in ("global_store", "flat_store")),
+                "assembly_has_alu": any(token in envelope["assembly"].lower() for token in ("v_add", "v_mul", "s_add", "s_mul")),
+                "object_format": envelope["object_format"],
+                "object_bytes": len(object_bytes),
+                "disassembly_format": "elf64-amdgpu" in disassembly,
+                "disassembly_has_load": any(token in disassembly.lower() for token in ("global_load", "flat_load", "s_load")),
+                "disassembly_has_store": any(token in disassembly.lower() for token in ("global_store", "flat_store")),
+                "disassembly_has_alu": any(token in disassembly.lower() for token in ("v_add", "v_mul", "s_add", "s_mul")),
+            }
+        )
+    return {
+        "target": {"name": "amd-igpu-gfx1036", "processor": AMDGCN_PROCESSOR, "triple": AMDGCN_TRIPLE},
+        "static_only": True,
+        "runtime_unverified": True,
+        "mlir_rocdl": False,
+        "toolchain": {"llvm_as": shutil.which("llvm-as"), "llc": shutil.which("llc"), "llvm_objdump": shutil.which("llvm-objdump")},
+        "artifacts": entries,
+        "notes": ["LLVM IR is ordinary llvm.amdgcn text, not MLIR ROCDL dialect.", "No HIP runtime or model weights were used."],
+    }
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    report = build_report()
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print("validated {} gfx1036 static LLVM artifacts".format(len(report["artifacts"])))
+
+
+if __name__ == "__main__":
+    main()
