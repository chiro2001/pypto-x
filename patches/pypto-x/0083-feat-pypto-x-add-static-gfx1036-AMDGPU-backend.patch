diff --git a/python/pypto/backends/hip/runtime.py b/python/pypto/backends/hip/runtime.py
new file mode 100644
index 000000000..30886b233
--- /dev/null
+++ b/python/pypto/backends/hip/runtime.py
@@ -0,0 +1,170 @@
+"""Runtime seam for the static AMDGPU ``gfx1036`` backend.
+
+The current GamePC WSL environment exposes a DirectX bridge but no Linux HSA
+device.  Consequently this runtime reports a structured ``BLOCKED_DEVICE``
+status and refuses every load/launch operation.  It intentionally contains no
+Python reference executor: a static LLVM artifact must never be mistaken for
+proof of HIP device execution.
+"""
+
+from __future__ import annotations
+
+import ctypes.util
+import os
+import shutil
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from pypto.abi import Availability, GpuLaunchRequest, LaunchRequest
+from pypto.compiler.artifact import Artifact
+from pypto.compiler.targets.hip import (
+    HIP_BACKEND,
+    AmdgpuArtifactError,
+    AmdgpuProgram,
+    decode_amdgpu_artifact,
+)
+
+
+class AmdgpuRuntimeError(RuntimeError):
+    """Base AMDGPU runtime error."""
+
+
+class AmdgpuArtifactRuntimeError(AmdgpuRuntimeError):
+    """Artifact validation failed before device access."""
+
+
+class AmdgpuRuntimeUnavailable(AmdgpuRuntimeError):
+    """The host has no verified Linux HIP/HSA device runtime."""
+
+    def __init__(self, status: Availability):
+        self.status = status
+        super().__init__(
+            "{}: {} ({})".format(
+                status.reason_code or "backend_unavailable",
+                status.reason or "runtime unavailable",
+                dict(status.details),
+            )
+        )
+
+
+@dataclass(frozen=True)
+class LoadedAmdgpuArtifact:
+    artifact: Artifact
+    target_ir: AmdgpuProgram
+
+    @property
+    def program(self) -> AmdgpuProgram:
+        return self.target_ir
+
+
+def _library_available(*names: str) -> bool:
+    return any(ctypes.util.find_library(name) for name in names)
+
+
+def probe_amd_hip_runtime() -> Availability:
+    """Inspect the Linux HIP/HSA prerequisites without changing the host."""
+
+    kfd = os.path.exists("/dev/kfd")
+    dri = os.path.exists("/dev/dri")
+    hip = _library_available("amdhip64", "amdhip64.so", "amdhip64.so.6")
+    hsa = _library_available("hsa-runtime64", "hsa-runtime64.so", "hsa-runtime64.so.1")
+    hipcc = shutil.which("hipcc") is not None
+    rocminfo = shutil.which("rocminfo") is not None
+    details = {
+        "device": "amd-igpu-gfx1036",
+        "processor": "gfx1036",
+        "triple": "amdgcn-amd-amdhsa",
+        "dev_kfd": kfd,
+        "dev_dri": dri,
+        "libamdhip64": hip,
+        "libhsa_runtime64": hsa,
+        "hipcc": hipcc,
+        "rocminfo": rocminfo,
+        "runtime_verified": False,
+    }
+    if not (kfd and hip and hsa and hipcc):
+        return Availability.no(
+            HIP_BACKEND,
+            "Linux HIP/HSA device runtime is not exposed; static artifact only",
+            reason_code="BLOCKED_DEVICE",
+            details=details,
+        )
+    # Even if the basic libraries are present, no exact gfx/wave capability is
+    # inferred until rocminfo and an actual launch have been observed.
+    return Availability.no(
+        HIP_BACKEND,
+        "HIP/HSA libraries are present but gfx1036 runtime verification is pending",
+        reason_code="BLOCKED_DEVICE",
+        details=details,
+    )
+
+
+class AmdgpuStaticRuntime:
+    """Fail-closed future runtime ABI for static AMDGCN artifacts."""
+
+    name = HIP_BACKEND
+
+    def availability(self) -> Availability:
+        return probe_amd_hip_runtime()
+
+    def is_available(self) -> bool:
+        return self.availability().available
+
+    def _decode(self, artifact: Artifact) -> LoadedAmdgpuArtifact:
+        try:
+            target_ir = decode_amdgpu_artifact(artifact)
+        except (AmdgpuArtifactError, TypeError, ValueError) as exc:
+            raise AmdgpuArtifactRuntimeError(str(exc)) from exc
+        return LoadedAmdgpuArtifact(artifact, target_ir)
+
+    def _require_device(self) -> Availability:
+        status = self.availability()
+        if not status.available:
+            raise AmdgpuRuntimeUnavailable(status)
+        return status
+
+    def load(self, artifact: Artifact) -> LoadedAmdgpuArtifact:
+        loaded = self._decode(artifact)
+        self._require_device()
+        return loaded
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, (LaunchRequest, GpuLaunchRequest)):
+            raise AmdgpuRuntimeError("AMDGPU workspace_size requires LaunchRequest or GpuLaunchRequest")
+        self._decode(request.artifact)
+        self._require_device()
+        return 0
+
+    def launch(self, request: Any):
+        if not isinstance(request, (LaunchRequest, GpuLaunchRequest)):
+            raise AmdgpuRuntimeError("AMDGPU launch requires LaunchRequest or GpuLaunchRequest")
+        self._decode(request.artifact)
+        self._require_device()
+        raise AmdgpuRuntimeError("AMDGPU launch path is intentionally unavailable until HIP/HSA verification")
+
+
+AmdgpuRuntime = AmdgpuStaticRuntime
+HipRuntime = AmdgpuStaticRuntime
+AMDGPUBackend = AmdgpuStaticRuntime
+HipBackend = AmdgpuStaticRuntime
+AmdgpuBackend = AmdgpuStaticRuntime
+
+
+def launch(request: Any):
+    return AmdgpuStaticRuntime().launch(request)
+
+
+__all__ = [
+    "AMDGPUBackend",
+    "AmdgpuBackend",
+    "AmdgpuArtifactRuntimeError",
+    "AmdgpuRuntime",
+    "AmdgpuRuntimeError",
+    "AmdgpuRuntimeUnavailable",
+    "AmdgpuStaticRuntime",
+    "HipRuntime",
+    "HipBackend",
+    "LoadedAmdgpuArtifact",
+    "launch",
+    "probe_amd_hip_runtime",
+]
