From 7ba9816cb62a3ea58be8d73f3ae14f028ad6f019 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 10:01:49 +0800
Subject: [PATCH 232/257] test(cpu-avx512): extend view bit-identity evidence
 across dtypes and shapes

---
 python/tests/ut/pypto_x/test_cpu_avx512_layout.py | 45 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/python/tests/ut/pypto_x/test_cpu_avx512_layout.py b/python/tests/ut/pypto_x/test_cpu_avx512_layout.py
index 61ce8aaa8..d150185c1 100644
--- a/python/tests/ut/pypto_x/test_cpu_avx512_layout.py
+++ b/python/tests/ut/pypto_x/test_cpu_avx512_layout.py
@@ -372,6 +372,51 @@ def test_layout_view_alias_is_proof_gated_and_bit_identical(tmp_path):
     assert ineligible is False and "not a logical copy" in ineligible_reason
 
 
+@pytest.mark.parametrize(
+    "dtype,input_shape,output_shape",
+    (
+        ("float32", (3, 5), (5, 3)),
+        ("bf16", (4, 6), (2, 12)),
+        ("int8", (7, 3), (21,)),
+        ("float32", (2, 3, 4), (6, 4)),
+    ),
+)
+def test_layout_view_alias_bit_identity_across_dtypes_and_shapes(
+    dtype, input_shape, output_shape, tmp_path
+):
+    runtime = _runtime()
+    program = _layout_program(
+        "reshape", input_shape, output_shape, {"shape": list(output_shape)}, dtype
+    )
+    _target_ir, artifact = _compile(program, tmp_path, "view-{}".format(dtype))
+    count = element_count(output_shape)
+    source = HostTensor(dtype, input_shape, _pattern_bits(dtype, element_count(input_shape), seed=7))
+    native = _raw_array(dtype, [0] * count)
+    reference = _raw_array(dtype, [0] * count)
+    avx512_runtime.reset_layout_native_stats()
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[source.descriptor(readonly=True)],
+            outputs=[_descriptor(dtype, output_shape, native)],
+        )
+    )
+    _HostReferenceAvx512().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[source.descriptor(readonly=True)],
+            outputs=[_descriptor(dtype, output_shape, reference)],
+        )
+    )
+    stats = avx512_runtime.layout_native_stats()
+    assert stats["view_alias_enabled"] == 1
+    assert stats["kernel_calls"] == 0
+    assert _buffer_sha256(native) == _buffer_sha256(reference)
+    decision = avx512_runtime.layout_view_alias_decisions()[-1]
+    assert decision["alias_proof"]["status"] == "proven"
+    assert decision["alias_proof"]["facts"]["geometry"]["view_shape"] == list(output_shape)
+
+
 def test_layout_view_alias_rejects_caller_owned_source_and_still_copies(tmp_path):
     runtime = _runtime()
     program = _layout_program("reshape", (3, 5), (5, 3), {"shape": [5, 3]}, "float32")
