From 962f422e18ee25fd37679687710edbd496b9f6ce Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Wed, 9 Sep 2026 04:18:46 +0800
Subject: [PATCH 065/217] fix(pypto-x): align qwen gdr beta dtype contract

---
 python/pypto/portable/qwen35.py                         | 27 +++++++++++++++++++--------
 python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py | 24 +++++++++++++++++++-----
 2 files changed, 38 insertions(+), 13 deletions(-)

diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
index 554c89298..aa4ab807f 100644
--- a/python/pypto/portable/qwen35.py
+++ b/python/pypto/portable/qwen35.py
@@ -1401,8 +1401,8 @@ def _gdr_step(
     * ``q[1,K] @ new_state[K,V]`` emits the updated-state output.
 
     All operands entering these operations are FP32, while the public q/k/v
-    contract remains BF16.  ``state`` is never mutated; each operation
-    creates the next SSA value.
+    and beta contract remains BF16.  ``state`` is never mutated; each
+    operation creates the next SSA value.
     """
 
     row_q_shape = (batch, heads, 1, key_dim)
@@ -1457,13 +1457,14 @@ def _gdr_step(
     beta_t = builder.op(
         "transpose",
         (beta_t,),
-        ((prefix + "_beta", _tensor("float32", gate_shape)),),
+        ((prefix + "_beta", _tensor("bf16", gate_shape)),),
         {"permutation": [0, 2, 1]},
     )[0]
 
     q_f32 = _as_f32(builder, q_t, "bf16", prefix + "_q")
     k_f32 = _as_f32(builder, k_t, "bf16", prefix + "_k")
     v_f32 = _as_f32(builder, v_t, "bf16", prefix + "_v")
+    beta_f32 = _as_f32(builder, beta_t, "bf16", prefix + "_beta")
     decay = builder.op(
         "exp",
         (g_t,),
@@ -1499,7 +1500,7 @@ def _gdr_step(
     )[0]
     beta_4d = builder.op(
         "reshape",
-        (beta_t,),
+        (beta_f32,),
         ((prefix + "_beta_4d", _tensor("float32", gate_4d_shape)),),
         {"shape": list(gate_4d_shape)},
     )[0]
@@ -1575,7 +1576,7 @@ def _build_gdr_recurrent_state(
     key = builder.parameter("key", _tensor("bf16", input_shape))
     value = builder.parameter("value", _tensor("bf16", (batch, steps, heads, value_dim)))
     gate = builder.parameter("gate", _tensor("float32", gate_shape))
-    beta = builder.parameter("beta", _tensor("float32", gate_shape))
+    beta = builder.parameter("beta", _tensor("bf16", gate_shape))
     prior_state = builder.parameter("prior_state", _tensor("float32", state_shape))
     scale = builder.parameter("scale", _scalar("float32"))
 
@@ -1629,10 +1630,16 @@ def _build_gdr_recurrent_state(
             "state_output_dtype": "float32",
             "qkv_input_dtype": "bf16",
             "gate_dtype": "float32",
-            "beta_dtype": "float32",
+            "beta_dtype": "bf16",
+            "beta_accumulation_dtype": "float32",
             "gate_semantics": "log_space_increment; exp applied once per token",
             "beta_semantics": "post_sigmoid_delta_scale",
             "qk_contract": "q_and_k_are_l2_normalized_by_upstream",
+            "qwen_gdr_contract_source": "upstream/pypto-gym/src/pypto_gym/ops/pypto_tensor/qwen3_5/gdr_fwd/gdr_fwd_impl.py",
+            "qwen_gdr_contract_evidence": {
+                "wrapper": "chunk_gated_delta_rule_wrapper documents beta [B,T,HV] bf16 in post-sigmoid space and initial/final state [N,HV,K,V] fp32",
+                "host_prep": "beta.reshape(b*t,hv).to(torch.bfloat16); g.reshape(b*t,hv).to(torch.float32); initial_state.to(torch.float32)",
+            },
             "scale_semantics": "runtime_float32_scalar_applied_after_updated_state_matmul",
             "state_semantics": "functional_pure_ssa_output",
             "prefill_decode_shared_graph": True,
@@ -1669,8 +1676,12 @@ def build_qwen35_gdr_recurrent_state(
     """Build Qwen3.5-0.8B's fixed BF16 GDR recurrent matrix transition.
 
     Public shapes are intentionally fixed to the Qwen linear-attention
-    contract: q/k/v ``[B,T,16,128]``, gate/beta ``[B,T,16]``, and state
-    ``[B,16,128,128]``.  ``scale`` is an explicit FP32 scalar LaunchRequest
+    contract: q/k/v/beta ``[B,T,16,128]``/``[B,T,16]`` in BF16, g in FP32,
+    and state ``[B,16,128,128]`` in FP32.  This follows the Qwen-specific
+    wrapper and host preparation in
+    ``upstream/pypto-gym/src/pypto_gym/ops/pypto_tensor/qwen3_5/gdr_fwd/gdr_fwd_impl.py``;
+    beta must not inherit the FP32 beta convention of a different Ling KDA
+    implementation.  ``scale`` is an explicit FP32 scalar LaunchRequest
     input (the model normally supplies ``128**-0.5``).  Both ``T=1`` decode
     and ``T>1`` prefill/chunk use the same static sequential SSA graph.
     """
diff --git a/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py b/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py
index ed3823728..235fc428a 100644
--- a/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py
+++ b/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py
@@ -124,7 +124,7 @@ def _small_inputs(steps: int = 2):
         [-0.10, -0.20, -0.30, -0.40][: steps * 2],
     )
     beta = HostTensor(
-        "float32",
+        "bf16",
         (1, steps, 2),
         [0.50, 0.60, 0.70, 0.80][: steps * 2],
     )
@@ -234,8 +234,14 @@ def test_gdr_contract_is_fixed_and_functional_ssa():
     assert [ref.name for ref in function.returns] == ["output", "new_state"]
     assert [ref.type.shape for ref in function.returns] == [(1, 1, 16, 128), (1, 16, 128, 128)]
     assert [ref.type.dtype for ref in function.returns] == ["bf16", "float32"]
+    assert [ref.type.dtype for ref in function.parameters] == [
+        "bf16", "bf16", "bf16", "float32", "bf16", "float32", "float32"
+    ]
     assert program.metadata["state_layout"] == "[B,H,K,V] with K before V"
     assert program.metadata["state_semantics"] == "functional_pure_ssa_output"
+    assert program.metadata["beta_dtype"] == "bf16"
+    assert program.metadata["beta_accumulation_dtype"] == "float32"
+    assert program.metadata["qwen_gdr_contract_source"].endswith("qwen3_5/gdr_fwd/gdr_fwd_impl.py")
     assert program.metadata["prefill_decode_shared_graph"] is True
     assert program.metadata["chunk_mode"].startswith("sequential_correctness_reference")
     assert program.metadata["avx2_avx512_batched_matmul"] == "explicit_rejection"
@@ -295,7 +301,7 @@ def test_gdr_prefill_decode_state_carry_scalar_vector_sve(tmp_path):
             HostTensor("bf16", (1, 1, 2, 3), list(inputs[1].flat()[time_index * 6 : (time_index + 1) * 6])),
             HostTensor("bf16", (1, 1, 2, 2), list(inputs[2].flat()[time_index * 4 : (time_index + 1) * 4])),
             HostTensor("float32", (1, 1, 2), list(inputs[3].flat()[time_index * 2 : (time_index + 1) * 2])),
-            HostTensor("float32", (1, 1, 2), list(inputs[4].flat()[time_index * 2 : (time_index + 1) * 2])),
+            HostTensor("bf16", (1, 1, 2), list(inputs[4].flat()[time_index * 2 : (time_index + 1) * 2])),
             decode_state,
         ]
         one_output = HostTensor.zeros("bf16", (1, 1, 2, 2))
@@ -313,7 +319,7 @@ def test_gdr_zero_decay_and_zero_beta_are_identity_state_update():
     # Keep state nonzero while exp(g)=1 and beta=0: state must be carried
     # exactly and output must be q @ prior_state times scale.
     inputs[3] = HostTensor("float32", (1, 1, 2), [0.0, 0.0])
-    inputs[4] = HostTensor("float32", (1, 1, 2), [0.0, 0.0])
+    inputs[4] = HostTensor("bf16", (1, 1, 2), [0.0, 0.0])
     output = HostTensor.zeros("bf16", (1, 1, 2, 2))
     state = HostTensor.zeros("float32", (1, 2, 3, 2))
     _launch(_compile_scalar(program), inputs, [output, state], CpuScalarRuntime(), scale=1.0)
@@ -337,7 +343,7 @@ def test_gdr_fixed_qwen_decode_executes_and_chunk_compiles_sve(tmp_path):
     assert decode.functions[0].parameters[5].type.shape == (1, 16, 128, 128)
     zero_qkv = [HostTensor.zeros("bf16", (1, 1, 16, 128)) for _ in range(3)]
     gate = HostTensor.zeros("float32", (1, 1, 16))
-    beta = HostTensor.zeros("float32", (1, 1, 16))
+    beta = HostTensor.zeros("bf16", (1, 1, 16))
     prior = HostTensor.zeros("float32", (1, 16, 128, 128))
     output = HostTensor.zeros("bf16", (1, 1, 16, 128))
     state = HostTensor.zeros("float32", (1, 16, 128, 128))
@@ -370,9 +376,17 @@ def test_gdr_runtime_rejects_state_shape_and_dtype():
     with pytest.raises(Exception, match="descriptor dtype/shape"):
         _launch(artifact, inputs[:-1] + [bad_dtype], [output, HostTensor.zeros("float32", (1, 2, 3, 2))], CpuScalarRuntime())
 
+    bad_beta = HostTensor.zeros("float32", (1, 1, 2))
+    with pytest.raises(Exception, match="descriptor dtype/shape"):
+        _launch(
+            artifact,
+            inputs[:4] + [bad_beta, inputs[-1]],
+            [output, HostTensor.zeros("float32", (1, 2, 3, 2))],
+            CpuScalarRuntime(),
+        )
+
 
 def test_gdr_contract_points_to_fixed_qwen_dimensions():
     assert QWEN35_08B_SHAPE_METADATA["linear_num_value_heads"] == 16
     assert QWEN35_08B_SHAPE_METADATA["linear_key_head_dim"] == 128
     assert QWEN35_08B_SHAPE_METADATA["linear_value_head_dim"] == 128
