+#!/usr/bin/env bash
+# C7 drilldown heavy inner（在 local 锁内运行）：
+#   1) ours driver（avx512, w8a8-linear, default scope, zh_continuation, steps=8, decode=3），
+#      在 past=10（decode step 2）注入 gold 输入 state，并 dump 逐层/逐算子中间张量；
+#      若完整 extra-returns（~1000 tensor）失败，自动降级到 minimal（~312 tensor）重试一次；
+#   2) HF w8a8 gold 在同一输入 state/token 下跑一步，抓同名中间张量；
+#   3) 逐层/逐算子对比 -> compute_drilldown_step2.json
+#
+# usage: run_drilldown_heavy.sh <evidence-dir> <worktree>
+set -uo pipefail
+
+EV=${1:?evidence dir required}
+WT=${2:-/home/chiro/projects/pypto/worktrees/pypto-x/c7-decode-gap-localization}
+OUT="${EV}/raw/drilldown_step2"
+LOGS="${EV}/logs"
+ASSETS=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/assets/qwen35-0.8b/2fc06364715b967f1860aea9cf38778875588b17
+GOLD_REF=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+ROPE=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/qwen35-bf16-weighted-execution/reference_rope
+VENV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/qwen35-bf16-reference/venv
+GOLD_STATES="${EV}/raw/gold_states_w8a8/zh_continuation.npz"
+mkdir -p "${OUT}/gold" "${LOGS}"
+
+if [[ ! -f ${GOLD_STATES} ]]; then
+  echo "[drilldown] missing gold states: ${GOLD_STATES}" >&2
+  exit 66
+fi
+
+DRIVER_ARGS=(
+  --stage s3 --backend avx512 --precision w8a8-linear
+  --quantized-linear-scope default
+  --prompt zh_continuation --steps 8 --decode-steps 3
+  --asset-dir "${ASSETS}" --reference-dir "${GOLD_REF}" --rope-dir "${ROPE}"
+  --debug-dump "${OUT}/dumps" --abort-op-mib 512
+  --output "${OUT}/s3_default_zh_continuation.json"
+  --progress "${OUT}/s3_default_zh_continuation.progress.log"
+  --work-dir "${OUT}/work"
+)
+
+run_ours() {
+  local mode=$1
+  echo "[drilldown] ours driver extra-returns=${mode} $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH="${WT}/python" python3 "${WT}/tools/diag_c7/run_drilldown_ours.py" \
+    --worktree "${WT}" \
+    --gold-states "${GOLD_STATES}" \
+    --gold-tag step_1 \
+    --target-past 10 \
+    --extra-returns "${mode}" \
+    -- "${DRIVER_ARGS[@]}" \
+    2>&1 | tee "${LOGS}/drilldown_ours_${mode}.log"
+  return ${PIPESTATUS[0]}
+}
+
+run_ours auto || {
+  echo "[drilldown] full extra-returns failed; retry with minimal set" | tee -a "${LOGS}/drilldown_ours_auto.log"
+  run_ours minimal || exit $?
+}
+OURS_NPZ="${OUT}/dumps.s3-decode.past10.npz"
+[[ -f ${OURS_NPZ} ]] || { echo "[drilldown] missing ${OURS_NPZ}" >&2; exit 67; }
+
+echo "[drilldown] step 2/3 HF gold-side intermediates $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+"${VENV}/bin/python" "${WT}/tools/diag_c7/dump_gold_step_intermediates.py" \
+  --harness "${WT}/tools/qwen35_reference/run_reference.py" \
+  --assets-dir "${ASSETS}" \
+  --gold-states-dir "${EV}/raw/gold_states_w8a8" \
+  --gold-reference-dir "${GOLD_REF}" \
+  --gold-tag step_1 --prompt zh_continuation --token-index 2 \
+  --out-dir "${OUT}/gold" --threads 6 --seed 0 --variant w8a8 \
+  2>&1 | tee "${LOGS}/drilldown_gold.log"
+rc=${PIPESTATUS[0]}
+if [[ ${rc} -ne 0 ]]; then
+  echo "[drilldown] HF gold capture failed rc=${rc}"
+  exit ${rc}
+fi
+
+echo "[drilldown] step 3/3 compare $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+python3 "${WT}/tools/diag_c7/compare_step_intermediates.py" \
+  --ours-npz "${OURS_NPZ}" \
+  --gold-npz "${OUT}/gold/gold_step_intermediates.npz" \
+  --gold-manifest "${OUT}/gold/gold_step_intermediates_manifest.json" \
+  --output "${EV}/raw/compute_drilldown_step2.json" \
+  2>&1 | tee "${LOGS}/drilldown_compare.log"
+rc=${PIPESTATUS[0]}
+echo "[drilldown] done rc=${rc} $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+exit ${rc}
