+#!/usr/bin/env python3
+"""C7 drilldown（gold 侧）：在 HF w8a8 gold 上注入 gold 输入 state，跑目标 decode step 的
+一次前向，抓取与 ours SSA 同名的逐层/逐算子中间张量。
+
+映射（ours SSA -> 本脚本 key）：
+  layer_XX_input_norm_scaled      -> layer_XX__input_norm        (HF RMSNorm 输出 bf16)
+  layer_XX_branch_output          -> layer_XX__branch_output     (self_attn / linear_attn 输出)
+  layer_XX_attention_residual     -> layer_XX__attention_residual（HF 由 input+branch 重算）
+  layer_XX_post_attention_norm_scaled -> layer_XX__post_attention_norm
+  layer_XX_mlp_*_output           -> layer_XX__mlp_{gate,up,down}
+  layer_XX_output                 -> layer_XX__output
+  attention: q/k/v_projection_output, q/k_norm_scaled, q/k_rope_full_result,
+             probabilities, context, merged, o_projection_output, new_k/new_v
+  gdr: in_proj_*_output, causal_conv_output, conv_time, q/k/v_raw, q/k,
+       beta, gate_log_decay, recurrent_step_0_output, gated_norm_scaled_bf16,
+       merged, out_projection_output
+  final_norm_scaled / final_hidden -> final_norm / final_hidden; logits -> logits
+
+只读资产（local_files_only=True），输出一个 npz + mapping JSON。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--harness", required=True)
+    parser.add_argument("--assets-dir", required=True)
+    parser.add_argument("--gold-states-dir", required=True)
+    parser.add_argument("--gold-reference-dir", required=True)
+    parser.add_argument("--gold-tag", default="step_1")
+    parser.add_argument("--prompt", default="zh_continuation")
+    parser.add_argument("--token-index", type=int, default=2,
+                        help="该步消费的 gold token 下标（zh step2 为 2）")
+    parser.add_argument("--out-dir", required=True)
+    parser.add_argument("--threads", type=int, default=6)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--variant", default="w8a8")
+    parser.add_argument("--dry-run", action="store_true")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    harness = load_module("c7_run_reference", os.path.abspath(args.harness))
+    import w8a8_reference  # noqa: F401
+    import torch
+
+    torch.set_num_threads(args.threads)
+    np.random.seed(args.seed)
+    torch.manual_seed(args.seed)
+
+    gold_states_path = Path(args.gold_states_dir) / "{}.npz".format(args.prompt)
+    gold = dict(np.load(gold_states_path, allow_pickle=False))
+    chain = [int(v) for v in gold["decode_token_ids"]]
+    token = chain[args.token_index]
+    if args.dry_run:
+        print("[hf-drill] dry-run: token={} tag={} prompt={}".format(token, args.gold_tag, args.prompt))
+        return 0
+
+    from transformers import AutoTokenizer
+    tokenizer = AutoTokenizer.from_pretrained(args.assets_dir, local_files_only=True)
+    prompts = harness.encode_prompts(tokenizer, [args.prompt])
+    item = prompts[0]
+
+    variant = harness.W8A8_VARIANTS[args.variant]
+    model = harness.load_model(args.assets_dir, variant["base_dtype"], "eager")
+    audit = w8a8_reference.apply_fake_quant(model, args.variant)
+    layers = model.model.language_model.layers
+    text_model = model.model.language_model
+
+    # ---- state dtype map / cache injection (复用 C7 已修的两点：按 kind dtype、torch.tensor 拷贝) ----
+    kind_map = {"conv_state": "conv", "recurrent_state": "recurrent",
+                "key_cache": "k", "value_cache": "v"}
+    manifest = json.loads((Path(args.gold_states_dir) / "gold_states_manifest.json").read_text(encoding="utf-8"))
+    dtype_by_kind = {}
+    for run in manifest.get("runs", []):
+        for key, dtype_name in run.get("state_dtypes", {}).items():
+            kind = kind_map[key.split("__")[-1]]
+            dtype = getattr(torch, dtype_name.replace("torch.", ""))
+            dtype_by_kind[kind] = dtype
+
+    from transformers import DynamicCache
+    cache = DynamicCache(config=text_model.config)
+    for index, layer in enumerate(layers):
+        snap = {kind: gold.get("{}__layer_{:02d}__{}".format(
+            args.gold_tag, index, {"conv": "conv_state", "recurrent": "recurrent_state",
+                                   "k": "key_cache", "v": "value_cache"}[kind]))
+            for kind in ("conv", "recurrent", "k", "v")}
+        cache_layer = cache.layers[index]
+        if hasattr(cache_layer, "conv_states"):
+            if snap["conv"] is not None:
+                tensor = torch.tensor(np.ascontiguousarray(snap["conv"]), dtype=dtype_by_kind["conv"])
+                cache_layer.conv_states[0] = tensor
+                cache_layer.is_conv_states_initialized[0] = True
+                cache_layer.conv_kernel_size[0] = int(tensor.shape[-1])
+            if snap["recurrent"] is not None:
+                cache_layer.recurrent_states[0] = torch.tensor(
+                    np.ascontiguousarray(snap["recurrent"]), dtype=dtype_by_kind["recurrent"])
+                cache_layer.is_recurrent_states_initialized[0] = True
+                cache_layer.has_previous_state[0] = True
+            cache_layer.dtype = dtype_by_kind.get("conv")
+            cache_layer.device = torch.device("cpu")
+        else:
+            cache_layer.keys = torch.tensor(np.ascontiguousarray(snap["k"]), dtype=dtype_by_kind["k"])
+            cache_layer.values = torch.tensor(np.ascontiguousarray(snap["v"]), dtype=dtype_by_kind["v"])
+            cache_layer.is_initialized = True
+            cache_layer.dtype = dtype_by_kind["k"]
+            cache_layer.device = torch.device("cpu")
+
+    # ---- capture helpers ----
+    captured = {}
+    shapes = {}
+    dtypes = {}
+
+    def store(key, tensor):
+        if tensor is None:
+            return
+        array = tensor.detach().to(torch.float32).cpu().numpy().copy()
+        captured[key] = array
+        shapes[key] = list(array.shape)
+        dtypes[key] = str(tensor.dtype)
+
+    def hook_output(module, key):
+        def _hook(_module, _inputs, output):
+            value = output[0] if isinstance(output, tuple) else output
+            store(key, value)
+        module.register_forward_hook(_hook)
+
+    def hook_input(module, key):
+        def _hook(_module, inputs, _output):
+            if inputs:
+                store(key, inputs[0])
+        module.register_forward_hook(_hook)
+
+    import transformers.models.qwen3_5.modeling_qwen3_5 as modeling
+
+    # id maps for patched functions
+    conv_state_ids = {}
+    recurrent_state_ids = {}
+    for index, layer in enumerate(layers):
+        cache_layer = cache.layers[index]
+        if hasattr(cache_layer, "conv_states") and cache_layer.conv_states.get(0) is not None:
+            conv_state_ids[id(cache_layer.conv_states[0])] = index
+        if hasattr(cache_layer, "recurrent_states") and cache_layer.recurrent_states.get(0) is not None:
+            recurrent_state_ids[id(cache_layer.recurrent_states[0])] = index
+
+    # ---- register hooks ----
+    for index, layer in enumerate(layers):
+        prefix = "layer_{:02d}".format(index)
+        layer.register_forward_pre_hook(
+            lambda _m, inputs, _idx=index: store("layer_{:02d}__input_hidden".format(_idx), inputs[0]))
+        hook_output(layer, prefix + "__output")
+        hook_output(layer.input_layernorm, prefix + "__input_norm")
+        hook_output(layer.post_attention_layernorm, prefix + "__post_attention_norm")
+        hook_output(layer.mlp, prefix + "__mlp_down")
+        hook_output(layer.mlp.gate_proj, prefix + "__mlp_gate")
+        hook_output(layer.mlp.up_proj, prefix + "__mlp_up")
+        hook_output(layer.mlp.down_proj, prefix + "__mlp_down_proj")
+        if hasattr(layer, "self_attn"):
+            attn = layer.self_attn
+            hook_output(attn, prefix + "__branch_output")
+            hook_output(attn.q_proj, prefix + "__q_projection")
+            hook_output(attn.k_proj, prefix + "__k_projection")
+            hook_output(attn.v_proj, prefix + "__v_projection")
+            hook_output(attn.q_norm, prefix + "__q_norm")
+            hook_output(attn.k_norm, prefix + "__k_norm")
+            hook_output(attn.o_proj, prefix + "__o_projection")
+            hook_input(attn.o_proj, prefix + "__merged")
+        else:
+            gdn = layer.linear_attn
+            hook_output(gdn, prefix + "__branch_output")
+            hook_output(gdn.in_proj_qkv, prefix + "__in_proj_qkv")
+            hook_output(gdn.in_proj_z, prefix + "__in_proj_z")
+            hook_output(gdn.in_proj_b, prefix + "__in_proj_b")
+            hook_output(gdn.in_proj_a, prefix + "__in_proj_a")
+            hook_output(gdn.norm, prefix + "__gated_norm")
+            hook_output(gdn.out_proj, prefix + "__out_projection")
+    hook_output(text_model.norm, "final_norm")
+
+    # ---- patch module-level functions ----
+    original_conv_update = modeling.causal_conv1d_update
+
+    def patched_conv_update(hidden_states, conv_state, weight, bias, activation, **kwargs):
+        output = original_conv_update(hidden_states, conv_state, weight, bias, activation, **kwargs)
+        index = conv_state_ids.get(id(conv_state))
+        if index is not None:
+            store("layer_{:02d}__causal_conv_output".format(index), output)
+        return output
+
+    modeling.causal_conv1d_update = patched_conv_update
+
+    original_recurrent = modeling.torch_recurrent_gated_delta_rule
+
+    def patched_recurrent(query, key, value, g, beta, initial_state=None,
+                          output_final_state=False, use_qk_l2norm_in_kernel=False, **kwargs):
+        output, final_state = original_recurrent(
+            query, key, value, g, beta, initial_state=initial_state,
+            output_final_state=output_final_state,
+            use_qk_l2norm_in_kernel=use_qk_l2norm_in_kernel, **kwargs)
+        index = recurrent_state_ids.get(id(initial_state))
+        if index is not None:
+            prefix = "layer_{:02d}".format(index)
+            store(prefix + "__recurrent_step_0_output", output)
+            store(prefix + "__recurrent_q_input", query)
+            store(prefix + "__recurrent_k_input", key)
+            store(prefix + "__recurrent_v_input", value)
+            store(prefix + "__gate_log_decay", g)
+            store(prefix + "__beta", beta)
+        return output, final_state
+
+    modeling.torch_recurrent_gated_delta_rule = patched_recurrent
+
+    rope_calls = {"index": 0}
+    attention_indices = [i for i, layer in enumerate(layers) if hasattr(layer, "self_attn")]
+    original_rope = modeling.apply_rotary_pos_emb
+
+    def patched_rope(query, key, cos, sin, unsqueeze_dim=1, **kwargs):
+        q_out, k_out = original_rope(query, key, cos, sin, unsqueeze_dim=unsqueeze_dim, **kwargs)
+        call = rope_calls["index"]
+        rope_calls["index"] += 1
+        if call < len(attention_indices):
+            prefix = "layer_{:02d}".format(attention_indices[call])
+            store(prefix + "__q_rope", q_out)
+            store(prefix + "__k_rope", k_out)
+        return q_out, k_out
+
+    modeling.apply_rotary_pos_emb = patched_rope
+
+    original_eager = modeling.eager_attention_forward
+
+    def patched_eager(module, query, key, value, attention_mask, dropout=0.0, scaling=None, **kwargs):
+        output, weights = original_eager(module, query, key, value, attention_mask,
+                                         dropout=dropout, scaling=scaling, **kwargs)
+        prefix = "layer_{:02d}".format(module.layer_idx)
+        store(prefix + "__context", output)
+        store(prefix + "__probabilities", weights)
+        return output, weights
+
+    modeling.eager_attention_forward = patched_eager
+
+    # ---- forward ----
+    with torch.no_grad():
+        outputs = model(
+            input_ids=torch.tensor([[int(token)]], dtype=torch.long),
+            past_key_values=cache,
+            use_cache=True,
+            return_dict=True,
+        )
+    store("logits", outputs.logits[0, -1])
+    # lm_head 的输入就是 final norm 输出；ours 的 final_hidden 是同一个值 cast bf16
+    if "final_norm" in captured:
+        captured["final_hidden"] = captured["final_norm"].copy()
+        shapes["final_hidden"] = shapes["final_norm"]
+        dtypes["final_hidden"] = dtypes["final_norm"]
+
+    # attention KV cache after the step（与 ours new_k/new_v 对应）
+    for index, layer in enumerate(layers):
+        cache_layer = cache.layers[index]
+        keys = getattr(cache_layer, "keys", None)
+        values = getattr(cache_layer, "values", None)
+        if keys is not None and keys.numel():
+            store("layer_{:02d}__new_k".format(index), keys)
+            store("layer_{:02d}__new_v".format(index), values)
+
+    out_dir = Path(args.out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    npz_path = out_dir / "gold_step_intermediates.npz"
+    np.savez_compressed(str(npz_path), **captured)
+
+    # validation: our injected-gold forward must equal the reference gold decode row
+    gold_ref_path = Path(args.gold_reference_dir) / "w8a8" / "{}.npz".format(args.prompt)
+    validation = None
+    if gold_ref_path.is_file():
+        with np.load(str(gold_ref_path), allow_pickle=False) as ref:
+            ref_row = np.asarray(ref["decode_logits"][args.token_index + 1], dtype=np.float32)
+        logits = np.asarray(captured["logits"], dtype=np.float32)
+        validation = {
+            "gold_ref_npz": str(gold_ref_path),
+            "row": args.token_index + 1,
+            "bitwise_equal": bool(np.array_equal(logits, ref_row)),
+            "max_abs_diff": float(np.max(np.abs(logits.astype(np.float64) - ref_row.astype(np.float64)))),
+            "cosine": float(np.dot(logits, ref_row) / (np.linalg.norm(logits) * np.linalg.norm(ref_row))),
+        }
+
+    mapping = {
+        "tool": "dump_gold_step_intermediates",
+        "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "variant": args.variant,
+        "fake_quant_scope": audit.get("scope"),
+        "prompt": args.prompt,
+        "gold_tag": args.gold_tag,
+        "token_index": args.token_index,
+        "token": int(token),
+        "gold_states": str(gold_states_path),
+        "gold_states_sha256": sha256_file(gold_states_path),
+        "npz": str(npz_path),
+        "npz_sha256": sha256_file(npz_path),
+        "npz_bytes": npz_path.stat().st_size,
+        "state_dtypes": {key: str(value) for key, value in dtype_by_kind.items()},
+        "keys": sorted(captured.keys()),
+        "shapes": shapes,
+        "dtypes": dtypes,
+        "validation_vs_gold_logits": validation,
+    }
+    (out_dir / "gold_step_intermediates_manifest.json").write_text(
+        json.dumps(mapping, indent=1), encoding="utf-8")
+    print("[hf-drill] wrote {} keys={} validation={}".format(npz_path, len(captured), validation), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
