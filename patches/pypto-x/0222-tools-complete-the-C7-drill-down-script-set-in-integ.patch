+#!/usr/bin/env python3
+"""C7 drilldown（ours 侧）：跑 driver s3，但在目标 decode step 注入 gold 输入 state，
+并额外 dump 逐层/逐算子中间张量。
+
+用法::
+
+    python3 run_drilldown_ours.py \
+        --worktree <worktree> \
+        --gold-states <raw/gold_states_w8a8/zh_continuation.npz> \
+        --gold-tag step_1 \
+        --target-past 10 \
+        -- <driver 原有参数...>
+        # e.g. --stage s3 --backend avx512 --precision w8a8-linear --prompt zh_continuation
+        #      --steps 8 --decode-steps 3 --asset-dir ... --reference-dir ... --rope-dir ...
+        #      --debug-dump <out>/dumps --abort-op-mib 512 --output <out>/run.json ...
+
+原理：monkey-patch driver 的 ``_run_once``，当 (stage, past_length) == (s3-decode, target)
+时，用 gold state dump 构造 ``previous_states``（按 state input 名 + schema dtype 编码为
+bytes；bf16 用 RNE float32->bfloat16），其余步骤不变。这样该步的输入 state 与 gold 完全
+一致，可以单独比较"单步计算"。
+
+同时自动把逐层/逐算子中间 SSA 名字追加进 ``--debug-extra-returns``（先 build 一次
+graph 扫描可用名字，避免拼错），并加上 ``--debug-hidden-states``。
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+
+import numpy as np
+
+#: 逐层/逐算子中间张量的 SSA 名字模式（对 build_graph 的真实名字做 regex 匹配；
+#: 只选 operation 输出且 dtype ∈ {bf16,float32}，绝不把参数/权重拷进 dump）。
+LAYER_PATTERNS = (
+    # layer / norm / mlp 边界
+    r"layer_\d+_input_norm_(scaled|normalized)$",
+    r"layer_\d+_branch_output$",
+    r"layer_\d+_attention_residual$",
+    r"layer_\d+_post_attention_norm_(scaled|normalized)$",
+    r"layer_\d+_mlp_(gate_output|up_output|gate_silu|product|down_output)$",
+    r"layer_\d+_output$",
+    # full attention 内部
+    r"layer_\d+_(q|k|v)_projection_output$",
+    r"layer_\d+_(query_raw|output_gate_raw|output_gate_sigmoid|gated_context|merged_heads|merged)$",
+    r"layer_\d+_(q|k)_norm_(scaled|normalized)$",
+    r"layer_\d+_(q|k)_rope_(result|full_result)$",
+    r"layer_\d+_(probabilities|masked_logits|context|new_k|new_v|o_projection_output)$",
+    # GDR 内部
+    r"layer_\d+_in_proj_(qkv|z|b|a)_output$",
+    r"layer_\d+_causal_conv_(output|silu)$",
+    r"layer_\d+_(conv_time|q_raw|k_raw|v_raw|q|k|v)$",
+    r"layer_\d+_(q|k)_l2_normalized$",
+    r"layer_\d+_(beta_f32|beta|a_plus_dt|positive_dt|a_log_exp|negative_a_log|gate_log_decay)$",
+    r"layer_\d+_(q|k)_norm_bf16$",
+    r"layer_\d+_recurrent_step_0_output$",
+    r"layer_\d+_gated_norm_(scaled_bf16|normalized|normalized_bf16)$",
+    r"layer_\d+_(z_gate|gated_core)$",
+    r"layer_\d+_out_projection_output$",
+    # 全局
+    r"final_norm_(scaled|normalized)$",
+    r"final_hidden$",
+    r"final_hidden_flat$",
+    r"logits$",
+)
+DTYPES = ("bf16", "float32")
+
+
+def f32_to_bf16_bytes(array: np.ndarray) -> bytes:
+    """float32 -> bfloat16 (round-to-nearest-even) little-endian bytes."""
+    values = np.ascontiguousarray(array, dtype=np.float32)
+    bits = values.view(np.uint32)
+    lsb = (bits >> 16) & np.uint32(1)
+    rounded = bits + np.uint32(0x7FFF) + lsb
+    return (rounded >> np.uint32(16)).astype(np.uint16).tobytes()
+
+
+def encode_state(array: np.ndarray, dtype: str) -> bytes:
+    array = np.ascontiguousarray(array)
+    if dtype == "float32":
+        return array.astype(np.float32).tobytes()
+    if dtype == "bf16":
+        return f32_to_bf16_bytes(array)
+    if dtype == "int64":
+        return array.astype(np.int64).tobytes()
+    raise SystemExit("unsupported state dtype for injection: {}".format(dtype))
+
+
+def build_gold_payloads(schema, gold: dict, tag: str) -> dict:
+    """按 state input 名构造 bytes payload（与 driver 的 state schema 对齐）。"""
+    payloads = {}
+    patterns = (
+        (re.compile(r"^layer_(\d+)_conv_state_in$"), "__conv_state"),
+        (re.compile(r"^layer_(\d+)_recurrent_state_in$"), "__recurrent_state"),
+        (re.compile(r"^layer_(\d+)_prior_k$"), "__key_cache"),
+        (re.compile(r"^layer_(\d+)_prior_v$"), "__value_cache"),
+    )
+    for entry in schema.states:
+        source = None
+        for pattern, suffix in patterns:
+            match = pattern.match(entry.name)
+            if match:
+                key = "{}__layer_{:02d}{}".format(tag, int(match.group(1)), suffix)
+                source = gold.get(key)
+                if source is None:
+                    raise SystemExit("gold dump missing key {}".format(key))
+                break
+        if source is None:
+            raise SystemExit("cannot map state input {}".format(entry.name))
+        if tuple(source.shape) != tuple(entry.shape):
+            raise SystemExit("state {} shape mismatch: gold {} vs schema {}".format(
+                entry.name, source.shape, entry.shape))
+        payload = encode_state(source, entry.dtype)
+        if len(payload) != entry.nbytes:
+            raise SystemExit("state {} bytes {} != schema nbytes {}".format(
+                entry.name, len(payload), entry.nbytes))
+        payloads[entry.name] = payload
+    return payloads
+
+
+def graph_names(program) -> set:
+    names = {ref.name for ref in program.functions[0].parameters}
+    for operation in program.functions[0].body.operations:
+        for ref in operation.outputs:
+            names.add(ref.name)
+    return names
+
+
+def minimal_extra_returns(drv, target_past: int):
+    """降级清单：只保留层边界与少数关键算子（约 130 个 tensor）。"""
+    import re as _re
+    program, _schema, _layout = drv.build_graph(
+        1, target_past, debug_hidden_states=True, precision="w8a8-linear",
+        quantized_linear_scope="default", quantize_lm_head=False,
+    )
+    patterns = [_re.compile(pattern) for pattern in (
+        r"layer_\d+_(input_norm_scaled|branch_output|attention_residual|post_attention_norm_scaled|mlp_down_output)$",
+        r"layer_\d+_(q|k|v)_projection_output$",
+        r"layer_\d+_(in_proj_qkv|in_proj_z|in_proj_a|in_proj_b)_output$",
+        r"layer_\d+_causal_conv_output$",
+        r"layer_\d+_(probabilities|context|new_k|new_v|recurrent_step_0_output|gated_core|out_projection_output|o_projection_output)$",
+    )]
+    parameter_names = {ref.name for ref in program.functions[0].parameters}
+    selected = []
+    for operation in program.functions[0].body.operations:
+        for ref in operation.outputs:
+            if ref.name in parameter_names or str(ref.type.dtype) not in DTYPES:
+                continue
+            if any(pattern.match(ref.name) for pattern in patterns):
+                selected.append(ref.name)
+    return sorted(set(selected))
+
+
+def auto_extra_returns(drv, target_past: int):
+    """build 一次 graph，按 LAYER_PATTERNS + dtype 选可 dump 的中间 SSA 名字。"""
+    import re as _re
+    program, _schema, _layout = drv.build_graph(
+        1, target_past, debug_hidden_states=True, precision="w8a8-linear",
+        quantized_linear_scope="default", quantize_lm_head=False,
+    )
+    patterns = [_re.compile(pattern) for pattern in LAYER_PATTERNS]
+    parameter_names = {ref.name for ref in program.functions[0].parameters}
+    selected = []
+    for operation in program.functions[0].body.operations:
+        for ref in operation.outputs:
+            if ref.name in parameter_names:
+                continue
+            if str(ref.type.dtype) not in DTYPES:
+                continue
+            if any(pattern.match(ref.name) for pattern in patterns):
+                selected.append(ref.name)
+    return sorted(set(selected)), len(parameter_names)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--worktree", required=True)
+    parser.add_argument("--gold-states", required=True)
+    parser.add_argument("--gold-tag", required=True)
+    parser.add_argument("--target-past", type=int, required=True)
+    parser.add_argument("--extra-returns", default="auto", choices=("auto", "minimal", "none"))
+    args, driver_argv = parser.parse_known_args()
+    if driver_argv and driver_argv[0] == "--":
+        driver_argv = driver_argv[1:]
+
+    driver_dir = Path(args.worktree).resolve() / "python" / "tests" / "ut" / "pypto_x"
+    sys.path.insert(0, str(driver_dir))
+    import qwen35_weighted_execution_driver as drv  # noqa: E402
+
+    gold = dict(np.load(args.gold_states, allow_pickle=False))
+    if args.extra_returns in ("auto", "minimal"):
+        if args.extra_returns == "minimal":
+            selected, parameter_count = minimal_extra_returns(drv, args.target_past), 0
+        else:
+            selected, parameter_count = auto_extra_returns(drv, args.target_past)
+        print("[drilldown] extra returns: {} intermediate tensors (graph parameters={})".format(
+            len(selected), parameter_count), flush=True)
+        if not any(item.startswith("--debug-extra-returns") for item in driver_argv):
+            driver_argv += ["--debug-extra-returns", ",".join(selected)]
+    if not any(item == "--debug-hidden-states" for item in driver_argv):
+        driver_argv.append("--debug-hidden-states")
+
+    # --debug-extra-returns 是全局静态列表，而 prefill(steps=8) 与 decode(steps=1) 的
+    # 中间 SSA 名字集合不同（例如 GDN chunk vs recurrent）。patch extend_returns，
+    # 对每个 graph 只追加该 graph 真实存在的名字，避免 prefill 阶段因缺名报错。
+    original_extend_returns = drv.extend_returns
+
+    def patched_extend_returns(program, names):
+        available = {ref.name for ref in program.functions[0].parameters}
+        for operation in program.functions[0].body.operations:
+            for ref in operation.outputs:
+                available.add(ref.name)
+        filtered = [name for name in names if name in available]
+        return original_extend_returns(program, filtered)
+
+    drv.extend_returns = patched_extend_returns
+
+    injected = {"done": False}
+    original_run_once = drv._run_once
+
+    def patched_run_once(run_args, stage, steps, past_length, reader, previous_states,
+                         input_ids, cos_bits, sin_bits, build_dir):
+        if stage == "s3-decode" and past_length == args.target_past:
+            program, schema, _layout = drv.build_graph(
+                steps, past_length,
+                debug_hidden_states=bool(getattr(run_args, "debug_hidden_states", False)),
+                debug_extra_returns=drv._debug_extra_return_names(run_args),
+                debug_decay_exp_a_log=bool(getattr(run_args, "debug_decay_exp_a_log", False)),
+                precision=getattr(run_args, "precision", "bf16"),
+                quantized_linear_scope=getattr(run_args, "quantized_linear_scope", "default"),
+                quantize_lm_head=bool(getattr(run_args, "quantize_lm_head", False)),
+            )
+            payloads = build_gold_payloads(schema, gold, args.gold_tag)
+            injected["done"] = True
+            print("[drilldown] INJECT gold states tag={} into stage={} past={} ({} tensors)".format(
+                args.gold_tag, stage, past_length, len(payloads)), flush=True)
+            previous_states = payloads
+        return original_run_once(run_args, stage, steps, past_length, reader, previous_states,
+                                 input_ids, cos_bits, sin_bits, build_dir)
+
+    drv._run_once = patched_run_once
+    sys.argv = ["qwen35_weighted_execution_driver"] + driver_argv
+    status = drv.main()
+    if not injected["done"]:
+        print("[drilldown] ERROR: target step past={} never reached".format(args.target_past))
+        return 2
+    return status
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
