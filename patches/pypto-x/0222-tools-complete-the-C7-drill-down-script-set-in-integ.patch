+#!/usr/bin/env bash
+# C7 drilldown：按 300s 节奏抢 local 锁，锁定窗口的门槛时间（UTC epoch）之前不抢。
+# usage: wait_and_run_drilldown.sh <evidence-dir> [worktree] [not_before_epoch]
+set -uo pipefail
+
+EV=${1:?evidence dir required}
+WT=${2:-/home/chiro/projects/pypto/worktrees/pypto-x/c7-decode-gap-localization}
+NOT_BEFORE=${3:-0}
+RUNNER=/home/chiro/projects/pypto/pypto_x/scripts/resource/run_local_heavy.sh
+mkdir -p "${EV}/logs"
+OUT="${EV}/logs/heavy_drilldown.out"
+echo "[c7-drill-waiter] start $(date -u +%Y-%m-%dT%H:%M:%SZ) pid=$$ not_before=${NOT_BEFORE}" | tee -a "${OUT}"
+
+now=$(date +%s)
+if (( NOT_BEFORE > now )); then
+  wait_s=$(( NOT_BEFORE - now ))
+  echo "[c7-drill-waiter] gating ${wait_s}s until $(date -u -d @${NOT_BEFORE} +%Y-%m-%dT%H:%M:%SZ)" | tee -a "${OUT}"
+  sleep "${wait_s}"
+fi
+
+for attempt in $(seq 1 60); do
+  echo "[c7-drill-waiter] attempt ${attempt} $(date -u +%Y-%m-%dT%H:%M:%SZ)" | tee -a "${OUT}"
+  "${RUNNER}" \
+    --task c7-drilldown-step2 --agent c7-decode-gap-localization \
+    --min-available-mib 8192 --safety-floor-mib 4096 --max-cpus 6 \
+    --log-file "${EV}/logs/heavy_drilldown_resource.log" \
+    -- bash "${WT}/tools/diag_c7/run_drilldown_heavy.sh" "${EV}" "${WT}" \
+    >> "${OUT}" 2>&1
+  rc=$?
+  echo "[c7-drill-waiter] attempt ${attempt} rc=${rc} $(date -u +%Y-%m-%dT%H:%M:%SZ)" | tee -a "${OUT}"
+  if [[ ${rc} -eq 0 ]]; then
+    echo "[c7-drill-waiter] SUCCESS" | tee -a "${OUT}"
+    exit 0
+  fi
+  if [[ ${rc} -ne 75 && ${rc} -ne 69 ]]; then
+    echo "[c7-drill-waiter] non-retryable rc=${rc}" | tee -a "${OUT}"
+    exit ${rc}
+  fi
+  sleep 300
+done
+echo "[c7-drill-waiter] gave up" | tee -a "${OUT}"
+exit 1
