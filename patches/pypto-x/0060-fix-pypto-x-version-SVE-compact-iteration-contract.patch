+++ b/python/tests/ut/pypto_x/test_cpu_vector_common.py
@@ -64,6 +64,23 @@ def _run(artifact, inputs, output, runtime=None):
     )
 
 
+def _compile_with_iteration_mode(program, compact, tail_policy="masked"):
+    attributes = {
+        "lane_count": 4,
+        "specialization": {"compact_iteration": bool(compact)},
+    }
+    if tail_policy is not None:
+        attributes["tail_policy"] = tail_policy
+    target = TargetSpec(
+        "cpu",
+        "x86_64-linux-gnu",
+        attributes=attributes,
+    )
+    compiler = CpuVectorCompiler()
+    target_ir = compiler.lower(program, target)
+    return compiler.compile(target_ir), target_ir
+
+
