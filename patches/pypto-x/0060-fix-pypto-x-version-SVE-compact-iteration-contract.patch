diff --git a/python/pypto/backends/cpu/vector/runtime.py b/python/pypto/backends/cpu/vector/runtime.py
index 5f24b344a..6c843d9fc 100644
--- a/python/pypto/backends/cpu/vector/runtime.py
+++ b/python/pypto/backends/cpu/vector/runtime.py
@@ -591,16 +591,10 @@ def _vector_map(plan: Any, values: Sequence[Any], operation: Callable[[Any], Any
             )
         )
     result = [None] * plan.element_count
-    if plan.iteration.compact:
-        for index in range(plan.element_count):
-            result[index] = operation(values[index])
-        return result
-    for chunk in plan.iteration.chunks:
-        for offset in range(chunk.length):
-            index = chunk.start + offset
-            if index >= plan.element_count:
-                raise CpuVectorExecutionError("{} vector chunk exceeds element domain".format(context))
-            result[index] = operation(values[index])
+    for index in _iteration_indices(plan.iteration):
+        if index >= plan.element_count:
+            raise CpuVectorExecutionError("{} vector iteration exceeds element domain".format(context))
+        result[index] = operation(values[index])
     return result
 
 
@@ -962,6 +956,7 @@ def _execute_matmul(
     if len(left_values) != matmul.m * matmul.k or len(right_values) != matmul.k * matmul.n:
         raise CpuVectorExecutionError("{} matmul input length mismatch".format(context))
     result = [None] * matmul.output_elements
+    fp32_accumulation = canonical_dtype(output_type.dtype) in ("float32", "bf16")
     for output_index in _iteration_indices(matmul.output_iteration):
         row = output_index // matmul.n if matmul.n else 0
         column = output_index % matmul.n if matmul.n else 0
@@ -969,7 +964,8 @@ def _execute_matmul(
         for inner in _iteration_indices(matmul.reduction_iteration):
             if inner >= matmul.k:
                 raise CpuVectorExecutionError("{} matmul reduction chunk exceeds k".format(context))
-            aggregate += left_values[row * matmul.k + inner] * right_values[inner * matmul.n + column]
+            value = aggregate + left_values[row * matmul.k + inner] * right_values[inner * matmul.n + column]
+            aggregate = _float32(value) if fp32_accumulation else value
         result[output_index] = _cast_value(aggregate, canonical_dtype(output_type.dtype))
     return result
 
