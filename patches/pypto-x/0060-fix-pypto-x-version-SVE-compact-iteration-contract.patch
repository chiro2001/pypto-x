+        path=artifact.path,
+        metadata=old_metadata,
+    )
+    assert old_artifact.cache_key != artifact.cache_key
+    with pytest.raises(CpuSve256ArtifactError, match="unsupported SVE256 lowering version"):
+        Sve256Runtime(execution_mode="qemu").load(old_artifact)
