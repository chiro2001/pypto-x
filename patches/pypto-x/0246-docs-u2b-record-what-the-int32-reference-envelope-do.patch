From 6a20e703d0d370496506f8d7c6e2e87cc605b3de Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 18:16:13 +0800
Subject: [PATCH 246/257] docs(u2b): record what the int32-reference envelope
 does and does not cover

---
 python/pypto/execution/provider_aocl_int8.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/python/pypto/execution/provider_aocl_int8.py b/python/pypto/execution/provider_aocl_int8.py
index 0337facb3..f7f0ce390 100644
--- a/python/pypto/execution/provider_aocl_int8.py
+++ b/python/pypto/execution/provider_aocl_int8.py
@@ -263,6 +263,13 @@ def _exactness_envelope() -> Mapping[str, Any]:
         },
         "upper_bound": dict(AOCL_INT8_UPPER_BOUND_STATUS),
         "deviation_metric": "max_abs_delta_vs_contract_int32_reference_worst_case_codes",
+        "not_covered": [
+            "error after dequantization/epilogue scaling: this envelope bounds "
+            "|AOCL_int32 - exact_int32| only, not the final bf16/quantized output error",
+            "inputs outside codes [-127,127] (the adapter rejects -128 before the kernel)",
+            "K > 133144 (the adapter rejects before any kernel call)",
+            "other AOCL builds/architectures or shapes/threads outside measurement_scope",
+        ],
         "wrap_behavior": "k>=133145 is refused by the adapter before the kernel call; "
                          "LPGEMM wraps silently and is never allowed to run",
         "code_range": [AOCL_INT8_QUANT_MIN, AOCL_INT8_QUANT_MAX],
