From 901040cec9ae76041a9d5473f935f890a7e613f7 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Fri, 11 Sep 2026 10:04:12 +0800
Subject: [PATCH 133/252] fix(perf): require one batch size across aggregate
 rounds

Enforce that all selected rounds use the same launches_per_sample (same
measurement method); mixing K=5 and K=10 sample means would make the ratio
and dispersion incomparable. Adds gate.measurement_method and marks the keys
ineligible when inconsistent.
---
 scripts/smoke/cuda_gemm_baseline_smoke.py | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/scripts/smoke/cuda_gemm_baseline_smoke.py b/scripts/smoke/cuda_gemm_baseline_smoke.py
index fc333f278..e3fe74479 100644
--- a/scripts/smoke/cuda_gemm_baseline_smoke.py
+++ b/scripts/smoke/cuda_gemm_baseline_smoke.py
@@ -1813,7 +1813,17 @@ def aggregate(args) -> dict:
         )
         == 1
     )
-    if not (all_rounds_valid and host_consistent and head_consistent and affinity_consistent):
+    launches_per_sample_values = {
+        entry["launches_per_sample"] for name in names for entry in per_round_lookup[name]
+    }
+    launches_per_sample_consistent = len(launches_per_sample_values) == 1
+    if not (
+        all_rounds_valid
+        and host_consistent
+        and head_consistent
+        and affinity_consistent
+        and launches_per_sample_consistent
+    ):
         for entry in ratios_out:
             entry["gate_eligible"] = False
     eligible = [entry for entry in ratios_out if entry["gate_eligible"]]
@@ -1916,6 +1926,7 @@ def aggregate(args) -> dict:
                 "host_fingerprint_consistent": host_consistent,
                 "git_head_consistent": head_consistent,
                 "cpu_affinity_consistent": affinity_consistent,
+                "launches_per_sample_consistent": launches_per_sample_consistent,
             },
             "dispatch_dominated_keys": [
                 {
@@ -1948,6 +1959,11 @@ def aggregate(args) -> dict:
                         + ([] if host_consistent else ["HOST_FINGERPRINT_INCONSISTENT"])
                         + ([] if head_consistent else ["GIT_HEAD_INCONSISTENT"])
                         + ([] if affinity_consistent else ["AFFINITY_INCONSISTENT"])
+                        + (
+                            []
+                            if launches_per_sample_consistent
+                            else ["LAUNCHES_PER_SAMPLE_INCONSISTENT"]
+                        )
                     )
                 )
                 for entry in ratios_out
@@ -1956,6 +1972,13 @@ def aggregate(args) -> dict:
                 "rule": "protocol §3.3 step 6: outlier_ratio > 0.10 -> UNSTABLE, round void",
                 "outlier_ratio_max": OUTLIER_RATIO_MAX,
             },
+            "measurement_method": {
+                "launches_per_sample_consistent": launches_per_sample_consistent,
+                "launches_per_sample_values": sorted(
+                    value for value in launches_per_sample_values if value is not None
+                ),
+                "note": "all selected rounds must use the same batch size (same measurement method)",
+            },
             "threshold_note": "candidate_ratio only; frozen_ratio/approval belongs to B4 and requires user approval",
         },
         "raw_round_files": [str(path) for path in args.rounds],
