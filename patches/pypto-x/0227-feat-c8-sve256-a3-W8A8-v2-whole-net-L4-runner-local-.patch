+#!/usr/bin/env bash
+# M2b item 6: local prefill-main + decode-extension L4 judgments for the A3
+# SVE256 W8A8 run.  Light (numpy over logits only), no heavy lock required.
+set -uo pipefail
+
+EVID=${1:?usage: m2b_run_judgments.sh <evidence-root>}
+WT=${2:?usage: m2b_run_judgments.sh <evidence-root> <worktree>}
+A3DIR="${EVID}/a3"
+RAW="${A3DIR}/raw"
+GOLD=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+TOOL="${WT}/tools/c8_l4_compare.py"
+MAKEMAN="${WT}/tools/c8_sve256_a3/m2b_make_manifest.py"
+export PATH=/home/chiro/miniforge3/bin:$PATH
+export PYTHONDONTWRITEBYTECODE=1
+
+failures=0
+for config in default full; do
+  manifest="${RAW}/ours_manifest_${config}.json"
+  if ! python3 "${MAKEMAN}" --raw-dir "${RAW}" --config "${config}" --output "${manifest}"; then
+    echo "[warn] manifest ${config} failed"
+    failures=$((failures + 1))
+    continue
+  fi
+  for variant in w8a8 w8a8_f32ref; do
+    if [[ ${variant} == w8a8 ]]; then
+      out="${RAW}/judgment_${config}.json"
+    else
+      out="${RAW}/judgment_f32ref_${config}.json"
+    fi
+    echo "[tool] ${variant} ${config} $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+    python3 "${TOOL}" --gold-dir "${GOLD}" --variant "${variant}" \
+      --config "${config}" --ours-manifest "${manifest}" --output "${out}" \
+      > "${RAW}/judgment_${variant}_${config}.stdout.log" 2>&1
+    tool_status=$?
+    # exit 1 is a real FAIL verdict, not a tool crash; it stays in the JSON.
+    echo "[tool] ${variant} ${config} exit=${tool_status} -> ${out}"
+  done
+done
+
+python3 "${WT}/tools/c8_sve256_a3/m2b_summarize_a3_results.py" \
+  --a3-dir "${A3DIR}" --output "${RAW}/m2b_a3_summary.json" || failures=$((failures + 1))
+echo "[judgments] failures=${failures} end $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+exit "${failures}"
