@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Summarize the M2b A3 SVE256 W8A8 L4 window.
+
+Reports, per config (default/full) and prompt:
+  * driver status / graph_digest / operation_total / wall_seconds
+  * **executed** int8 transpose count from the --progress op stream (must be 0)
+  * executed native qmatmul count
+  * packed logits npz sha256 (prefill + 4 decode rows)
+  * L4 prefill main verdict + decode-extension verdicts (reported separately)
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _progress_counts(path: Path) -> dict:
+    launches = 0
+    ops = 0
+    int8_transposes = 0
+    qmatmul_native = 0
+    qmatmul_any = 0
+    boundaries = {}
+    if not path.is_file():
+        return {"error": "missing progress log"}
+    last_index = None
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            item = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if item.get("kind") != "op":
+            continue
+        index = int(item.get("index") or 0)
+        if ops and index == 0:
+            launches += 1
+        elif ops == 0:
+            launches = 1
+        ops += 1
+        name = str(item.get("operation"))
+        dtype = str(item.get("dtype"))
+        mode = str(item.get("mode"))
+        boundary = "native" if mode.startswith("native") else (
+            "host_reference" if mode in ("host_reference", "host_materialize")
+            else ("host_boundary" if mode.startswith("host") else "unclassified")
+        )
+        boundaries[boundary] = boundaries.get(boundary, 0) + 1
+        if name == "transpose" and dtype == "int8":
+            int8_transposes += 1
+        if name == "qmatmul_s8s8_s32":
+            qmatmul_any += 1
+            if boundary == "native":
+                qmatmul_native += 1
+    return {
+        "launches": launches,
+        "executed_ops": ops,
+        "executed_int8_transposes": int8_transposes,
+        "executed_qmatmul_s8s8_s32": qmatmul_any,
+        "executed_qmatmul_native": qmatmul_native,
+        "boundaries": boundaries,
+    }
+
+
+def _judgment_verdict(judgment: dict) -> dict:
+    return {
+        "overall": judgment.get("overall"),
+        "prefill_main": judgment.get("overall_prefill_logits_main"),
+        "decode_extension_decode_band": judgment.get("overall_decode_extension_decode_band"),
+        "decode_extension_prefill_band": judgment.get("overall_decode_extension_prefill_band"),
+        "union_all_logits_keys": judgment.get("overall_union_all_logits_keys"),
+        "band_sha256": (judgment.get("band_source") or {}).get("sha256"),
+        "per_prompt": {
+            prompt: {
+                key: data.get(key)
+                for key in (
+                    "verdict", "verdict_prefill_logits", "verdict_decode_extension_decode_band",
+                    "verdict_decode_extension_prefill_band", "verdict_union_all_logits_keys",
+                    "argmax_gate", "cosine_gate", "max_abs_gate", "gated_rows",
+                    "strict_argmax_match_rows", "argmax_fail_rows", "near_tie_flip_rows",
+                    "gold_near_tie_rows", "token_chain",
+                )
+            }
+            for prompt, data in sorted(judgment.get("prompts", {}).items())
+        },
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--a3-dir", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    a3 = Path(args.a3_dir).resolve()
+    raw = a3 / "raw"
+
+    summary = {
+        "status": "PASS",
+        "window": "m2b_a3_sve256_w8a8_l4",
+        "criteria_note": (
+            "prefill main = band.json source_key=prefill_logits gate; decode extension uses "
+            "the same methodology re-measured on decode rows (reported separately, never mixed)"
+        ),
+        "matrix_status": json.loads((raw / "matrix_status.json").read_text(encoding="utf-8")),
+        "configs": {},
+    }
+    failures = 0
+    for config in ("default", "full"):
+        config_entry = {"prompts": {}}
+        for prompt in PROMPTS:
+            driver = raw / config / "{}.json".format(prompt)
+            progress = raw / config / "{}.progress.log".format(prompt)
+            entry = {"prompt": prompt}
+            if not driver.is_file():
+                entry["error"] = "missing driver JSON"
+                failures += 1
+                config_entry["prompts"][prompt] = entry
+                continue
+            payload = json.loads(driver.read_text(encoding="utf-8"))
+            census = payload.get("census") or {}
+            entry.update(
+                {
+                    "driver_status": payload.get("status"),
+                    "graph_digest": census.get("graph_digest"),
+                    "operation_total": census.get("operation_total"),
+                    "wall_seconds": payload.get("wall_seconds"),
+                    "shape_profile": payload.get("shape_profile"),
+                }
+            )
+            entry["executed"] = _progress_counts(progress)
+            # packed logits sha256
+            steps = {"en_continuation": 5, "zh_continuation": 8, "chat_zh_user": 18}[prompt]
+            dumps = raw / "dumps" / config
+            prefill = dumps / "{}.s3-prefill.past0.npz".format(prompt)
+            entry["prefill_npz_sha256"] = _sha256(prefill) if prefill.is_file() else None
+            entry["decode_npz_sha256"] = {
+                str(steps + step): (
+                    _sha256(dumps / "{}.s3-decode.past{}.npz".format(prompt, steps + step))
+                    if (dumps / "{}.s3-decode.past{}.npz".format(prompt, steps + step)).is_file()
+                    else None
+                )
+                for step in range(4)
+            }
+            if payload.get("status") != "PASS":
+                failures += 1
+            if entry["executed"].get("executed_int8_transposes") != 0:
+                failures += 1
+            config_entry["prompts"][prompt] = entry
+        for variant, name in (("w8a8", "judgment_{}.json"), ("w8a8_f32ref", "judgment_f32ref_{}.json")):
+            path = raw / name.format(config)
+            if path.is_file():
+                config_entry[variant + "_judgment"] = _judgment_verdict(
+                    json.loads(path.read_text(encoding="utf-8"))
+                )
+            else:
+                config_entry[variant + "_judgment"] = {"error": "missing {}".format(path)}
+                failures += 1
+        summary["configs"][config] = config_entry
+
+    summary["failures"] = failures
+    summary["status"] = "PASS" if failures == 0 else "PARTIAL"
+    Path(args.output).write_text(
+        json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps({k: summary[k] for k in ("status", "failures")}, sort_keys=True))
+    for config in ("default", "full"):
+        j = summary["configs"][config].get("w8a8_judgment", {})
+        print("[{}] prefill_main={} decode_extension(decode_band)={} decode_extension(prefill_band)={}".format(
+            config, j.get("prefill_main"), j.get("decode_extension_decode_band"),
+            j.get("decode_extension_prefill_band")))
+    return 0 if failures == 0 else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
