+#!/usr/bin/env bash
+# M2b item 6: ship the A3 bundle to a3-21 and verify it by sha256 manifest.
+# Runs on the LOCAL machine.  Called only after m2b_make_bundle.sh.
+set -euo pipefail
+
+EVID=${1:?usage: m2b_sync_to_a3.sh <evidence-root>}
+TAR="${EVID}/a3/a3_bundle.tar"
+A3=a3-21
+A3_HOME=/home/l00886679
+A3_ROOT=pypto-x-a3/w8a8-v2-m2b
+
+[[ -f "${TAR}" ]] || { echo "missing ${TAR}; run m2b_make_bundle.sh first" >&2; exit 2; }
+
+echo "[sync] local tar bytes=$(stat -c %s "${TAR}") sha256=$(cut -d' ' -f1 "${EVID}/a3/a3_bundle.tar.sha256")"
+ssh -o BatchMode=yes "${A3}" "mkdir -p ${A3_HOME}/${A3_ROOT} && rm -rf ${A3_HOME}/${A3_ROOT}/src ${A3_HOME}/${A3_ROOT}/tools ${A3_HOME}/${A3_ROOT}/refmin ${A3_HOME}/${A3_ROOT}/rope"
+scp -q -o BatchMode=yes "${TAR}" "${A3}:${A3_HOME}/${A3_ROOT}/a3_bundle.tar"
+ssh -o BatchMode=yes "${A3}" "cd ${A3_HOME}/${A3_ROOT} && tar -xf a3_bundle.tar && rm -rf src tools refmin rope && mv a3_bundle/src . && mv a3_bundle/tools . && mv a3_bundle/refmin . && mv a3_bundle/rope . && mv a3_bundle/run_a3_w8a8_l4.sh . && mv a3_bundle/MANIFEST.sha256 . && rm -rf a3_bundle && sha256sum -c MANIFEST.sha256 >/dev/null && echo '[sync] remote manifest OK'"
+ssh -o BatchMode=yes "${A3}" "du -sh ${A3_HOME}/${A3_ROOT}; date -u '+[sync] a3_utc=%Y-%m-%dT%H:%M:%SZ'"
+date -u '+[sync] local_utc=%Y-%m-%dT%H:%M:%SZ'
