+#!/usr/bin/env bash
+# M2b item 6: SVE256 W8A8 whole-network L4 execution on A3 (a3-21).
+# Runs ON the A3 host as l00886679 (NOT in the container).
+#
+# Scope: 3 prompts x {default(518), full(556)} whole-net runs, native SVE256,
+# driver stage s3 (prefill + 4 greedy decode steps in one process), W8A8-linear,
+# --skip-gold-alignment (gold logits stay on the local machine), --debug-dump
+# then pack_ours_logits to keep only logits arrays for the return trip.
+#
+# Discipline: only writes under ~/pypto-x-a3/w8a8-v2-m2b/**; only taskset CPUs
+# 320-639 (two disjoint 8-physical-core sets per batch); never touches
+# chip7/NPU; no machine config changes; no weights leave the host.
+#
+# Batches: default (3 prompts parallel) then full (3 prompts parallel).  Each
+# prompt gets 8 physical cores; batch wall is bounded by the longest prompt.
+set -u
+
+ROOT="${HOME}/pypto-x-a3/w8a8-v2-m2b"
+PY="${HOME}/pypto-x-a3/envs/pypto-x-c8/bin/python"
+SRC="${ROOT}/src"
+DRIVER="${SRC}/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py"
+ASSET="${HOME}/models/Qwen3.5-0.8B"
+PACK="${ROOT}/tools/c8_sve256_a3/pack_ours_logits.py"
+RAW="${ROOT}/raw"
+LOGS="${ROOT}/logs"
+WORK="${ROOT}/work"
+TMP="${ROOT}/tmp"
+mkdir -p "${RAW}" "${LOGS}" "${WORK}" "${TMP}"
+
+export PYTHONPATH="${SRC}/python"
+export PYPTO_X_PORTABLE_ONLY=1
+export TMPDIR="${TMP}"
+export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8
+export OMP_PROC_BIND=close OMP_PLACES=cores
+export PYPTO_X_SVE_TEST_MODE=native
+
+CLOCK_START=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
+
+# --- environment evidence (capability must show emulated=false/vl_bytes=32) --
+{
+  echo "== a3_w8a8_v2_m2b_l4_window =="
+  date -u '+started_utc=%Y-%m-%dT%H:%M:%SZ'
+  date '+started_local=%Y-%m-%dT%H:%M:%S%z'
+  echo "hostname=$(hostname) user=$(whoami) home=${HOME}"
+  echo "cpuset_self=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  echo "nproc=$(nproc) mem_available_kib=$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
+  echo "uname=$(uname -m) kernel=$(uname -r)"
+  echo "python=$(${PY} --version 2>&1) cc=$(cc --version | head -1)"
+  echo "env_numpy=$(${PY} -c 'import numpy; print(numpy.__version__)' 2>&1)"
+  echo "checkpoint_bytes=$(stat -c %s "${ASSET}/model.safetensors-00001-of-00001.safetensors" 2>/dev/null)"
+  ${PY} - <<'PY'
+from pypto.lowering.cpu.aarch64.sve import probe_sve256_capabilities
+import json
+capability = probe_sve256_capabilities(execution_mode="native")
+print("sve256_capability=" + json.dumps(capability.to_dict(), sort_keys=True))
+assert capability.available and not capability.emulated and capability.vl_bytes == 32, capability
+PY
+} > "${LOGS}/env_evidence.log" 2>&1
+ENV_STATUS=$?
+echo "[env] log=${LOGS}/env_evidence.log status=${ENV_STATUS}"
+
+# --- prompt/CPU map (same physical-core map as the Q5/Q10 windows) ----------
+PROMPTS=(en_continuation zh_continuation chat_zh_user)
+STEPS=(5 8 18)
+declare -A CPUS
+CPUS[en_continuation]="320,322,324,326,328,330,332,334"
+CPUS[zh_continuation]="336,338,340,342,344,346,348,350"
+CPUS[chat_zh_user]="352,354,356,358,360,362,364,366"
+
+declare -A BATCH_EXIT
+declare -A BATCH_ELAPSED
+
+run_batch() {
+  local config=$1
+  local -a extra=()
+  if [[ ${config} == full ]]; then
+    extra=(--quantized-linear-scope all --quantize-lm-head)
+  fi
+  mkdir -p "${RAW}/${config}" "${RAW}/dumps_raw/${config}" "${RAW}/dumps_packed/${config}"
+  echo "[batch ${config}] start $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  local batch_start
+  batch_start=$(date +%s)
+  local -a pids=()
+  local -a starts=()
+  local index prompt steps cpu log out progress dump
+  for index in 0 1 2; do
+    prompt="${PROMPTS[$index]}"
+    steps="${STEPS[$index]}"
+    cpu="${CPUS[$prompt]}"
+    out="${RAW}/${config}/${prompt}.json"
+    progress="${RAW}/${config}/${prompt}.progress.log"
+    dump="${RAW}/dumps_raw/${config}/${prompt}"
+    log="${LOGS}/${config}_${prompt}.log"
+    starts[$index]=$(date +%s)
+    echo "[run ] ${config}/${prompt} steps=${steps} cpus=${cpu} start=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+    setsid --wait timeout 5400 taskset -c "${cpu}" \
+      env OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 \
+          OMP_PROC_BIND=close OMP_PLACES=cores \
+      "${PY}" "${DRIVER}" \
+        --stage s3 --backend sve256 --precision w8a8-linear --sve-execution-mode native \
+        --prompt "${prompt}" --steps "${steps}" --decode-steps 4 \
+        --asset-dir "${ASSET}" --reference-dir "${ROOT}/refmin" --rope-dir "${ROOT}/rope" \
+        --skip-gold-alignment --debug-dump "${dump}" \
+        --output "${out}" --progress "${progress}" \
+        --work-dir "${WORK}/${config}/${prompt}" --no-watchdog \
+        "${extra[@]}" \
+      > "${log}" 2>&1 &
+    pids+=("$!")
+  done
+  local failures=0
+  for index in 0 1 2; do
+    local status=0
+    wait "${pids[$index]}" || status=$?
+    local elapsed=$(( $(date +%s) - starts[$index] ))
+    echo "[done] ${config}/${PROMPTS[$index]} exit=${status} elapsed_s=${elapsed}"
+    [[ ${status} -eq 0 ]] || failures=$((failures + 1))
+  done
+  BATCH_ELAPSED[$config]=$(( $(date +%s) - batch_start ))
+
+  # Keep only the logits rows needed by c8_l4_compare (never ship raw dumps).
+  echo "[pack] ${config} -> ${RAW}/dumps_packed/${config}"
+  "${PY}" "${PACK}" \
+    --ours-dir "${RAW}/dumps_raw/${config}" \
+    --output-dir "${RAW}/dumps_packed/${config}" \
+    >> "${LOGS}/${config}_pack.log" 2>&1
+  local pack_status=$?
+  echo "[pack] ${config} exit=${pack_status}"
+
+  # Per-artifact sha256 (driver JSON, progress, packed npz).
+  (
+    cd "${ROOT}"
+    find "raw/${config}" "raw/dumps_packed/${config}" -type f \( -name '*.json' -o -name '*.log' -o -name '*.npz' \) -print0 \
+      | sort -z | xargs -0 sha256sum > "${RAW}/${config}/sha256sums.txt"
+  )
+
+  BATCH_EXIT[$config]=$(( failures + (pack_status != 0 ? 1 : 0) ))
+  echo "[batch ${config}] failures=${failures} pack_exit=${pack_status} elapsed_s=${BATCH_ELAPSED[$config]} end=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+}
+
+run_batch default
+run_batch full
+
+# --- discipline self-check --------------------------------------------------
+{
+  echo "cpuset_self=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  echo "written_root=${ROOT}"
+  echo "default_exit=${BATCH_EXIT[default]} full_exit=${BATCH_EXIT[full]}"
+  echo "residue_processes=$(pgrep -u "$(whoami)" -f 'qwen35_weighted_execution_driver' | wc -l)"
+  echo "npu_calls=none"
+  date -u '+finished_utc=%Y-%m-%dT%H:%M:%SZ'
+} > "${LOGS}/discipline_check.txt" 2>&1
+
+{
+  echo "{"
+  echo "  \"window\": \"m2b_a3_sve256_w8a8_l4\","
+  echo "  \"default_exit\": ${BATCH_EXIT[default]},"
+  echo "  \"full_exit\": ${BATCH_EXIT[full]},"
+  echo "  \"default_wall_s\": ${BATCH_ELAPSED[default]},"
+  echo "  \"full_wall_s\": ${BATCH_ELAPSED[full]},"
+  echo "  \"env_status\": ${ENV_STATUS},"
+  echo "  \"started_utc\": \"${CLOCK_START}\","
+  echo "  \"a3_utc\": \"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\""
+  echo "}"
+} > "${RAW}/matrix_status.json"
+
+# One combined manifest for the return trip (packed + JSON + logs).
+(
+  cd "${ROOT}"
+  find raw -type f \( -name '*.json' -o -name '*.log' -o -name '*.npz' -o -name 'sha256sums.txt' \) -print0 \
+    | sort -z | xargs -0 sha256sum > "${RAW}/A3_SHA256SUMS.txt"
+)
+
+echo "[done] default_exit=${BATCH_EXIT[default]} full_exit=${BATCH_EXIT[full]} wall_s=$(( ${BATCH_ELAPSED[default]} + ${BATCH_ELAPSED[full]} ))"
+exit $(( BATCH_EXIT[default] + BATCH_EXIT[full] + (ENV_STATUS != 0 ? 1 : 0) ))
