+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Build the ours-manifest consumed by tools/c8_l4_compare.py for the M2b A3 flow.
+
+Local layout after ``m2b_fetch_results.sh``::
+
+    <raw>/<config>/<prompt>.json                 driver stage-s3 result
+    <raw>/<config>/<prompt>.progress.log         executed op stream
+    <raw>/dumps/<config>/<prompt>.s3-*.npz       packed logits (logits only)
+
+The fetched per-artifact ``sha256sums.txt`` (A3-relative paths) is verified
+against the local bytes before the manifest is written, so a corrupted fetch
+cannot silently feed the L4 judgment.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+PROMPTS = (("en_continuation", 5), ("zh_continuation", 8), ("chat_zh_user", 18))
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _verify_fetch(raw: Path, config: str) -> dict:
+    sums = raw / config / "sha256sums.txt"
+    if not sums.is_file():
+        raise SystemExit("missing {}".format(sums))
+    verified = 0
+    for line in sums.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        digest, remote = line.split(None, 1)
+        remote = remote.lstrip("*")
+        local_rel = remote[len("raw/"):] if remote.startswith("raw/") else remote
+        local_rel = local_rel.replace("dumps_packed/", "dumps/")
+        local = raw / local_rel
+        if not local.is_file():
+            raise SystemExit("fetched artifact missing: {}".format(local))
+        actual = sha256(local)
+        if actual != digest:
+            raise SystemExit("sha256 mismatch for {}: {} != {}".format(local, actual, digest))
+        verified += 1
+    return {"sha256_verified_files": verified, "sha256sums": str(sums)}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--raw-dir", required=True)
+    parser.add_argument("--config", required=True, choices=("default", "full"))
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+
+    raw = Path(args.raw_dir).resolve()
+    verify = _verify_fetch(raw, args.config)
+    manifest_prompts = {}
+    artifacts = {}
+    for prompt, steps in PROMPTS:
+        driver = raw / args.config / "{}.json".format(prompt)
+        prefill = raw / "dumps" / args.config / "{}.s3-prefill.past0.npz".format(prompt)
+        decode = {
+            str(steps + step): str(
+                raw / "dumps" / args.config / "{}.s3-decode.past{}.npz".format(prompt, steps + step)
+            )
+            for step in range(4)
+        }
+        for path in [driver, prefill] + [Path(item) for item in decode.values()]:
+            if not path.is_file():
+                raise SystemExit("missing required artifact: {}".format(path))
+        artifacts[prompt] = {
+            "driver_json_sha256": sha256(driver),
+            "prefill_npz_sha256": sha256(prefill),
+            "decode_npz_sha256": {
+                key: sha256(Path(item)) for key, item in sorted(decode.items())
+            },
+        }
+        manifest_prompts[prompt] = {
+            "steps": steps,
+            "driver_json": str(driver),
+            "prefill_npz": str(prefill),
+            "decode_npz": decode,
+        }
+    payload = {
+        "config": args.config,
+        "generated_by": "tools/c8_sve256_a3/m2b_make_manifest.py",
+        "fetch_verification": verify,
+        "artifacts": artifacts,
+        "prompts": manifest_prompts,
+    }
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(
+        json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    print("manifest: {} ({} prompts, {} files verified)".format(
+        output, len(manifest_prompts), verify["sha256_verified_files"]))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
