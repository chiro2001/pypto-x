+#!/usr/bin/env bash
+# M2b item 6: fetch the packed SVE256 W8A8 L4 artifacts back to the local
+# evidence dir.  Only packed logits + JSON/progress/sha256 files travel back;
+# the raw debug dumps stay on A3.
+set -euo pipefail
+
+EVID=${1:?usage: m2b_fetch_results.sh <evidence-root>}
+A3=a3-21
+A3_HOME=/home/l00886679
+A3_ROOT=pypto-x-a3/w8a8-v2-m2b
+LOCAL="${EVID}/a3"
+LOCAL_RAW="${LOCAL}/raw"
+LOCAL_LOGS="${LOCAL}/logs"
+mkdir -p "${LOCAL_RAW}" "${LOCAL_LOGS}"
+
+echo "[fetch] remote inventory"
+ssh -o BatchMode=yes "${A3}" "cd ${A3_HOME}/${A3_ROOT} && du -sb raw logs 2>/dev/null; find raw -name '*.npz' -type f | sort | xargs -r sha256sum" \
+  > "${LOCAL}/a3_dump_inventory.txt"
+
+for config in default full; do
+  mkdir -p "${LOCAL_RAW}/${config}" "${LOCAL_RAW}/dumps/${config}"
+  scp -q -o BatchMode=yes \
+    "${A3}:${A3_HOME}/${A3_ROOT}/raw/${config}/*.json" \
+    "${A3}:${A3_HOME}/${A3_ROOT}/raw/${config}/*.progress.log" \
+    "${A3}:${A3_HOME}/${A3_ROOT}/raw/${config}/sha256sums.txt" \
+    "${LOCAL_RAW}/${config}/"
+  scp -q -o BatchMode=yes \
+    "${A3}:${A3_HOME}/${A3_ROOT}/raw/dumps_packed/${config}/*.npz" \
+    "${LOCAL_RAW}/dumps/${config}/"
+done
+scp -q -o BatchMode=yes \
+  "${A3}:${A3_HOME}/${A3_ROOT}/raw/matrix_status.json" \
+  "${A3}:${A3_HOME}/${A3_ROOT}/raw/A3_SHA256SUMS.txt" \
+  "${LOCAL_RAW}/"
+scp -q -o BatchMode=yes \
+  "${A3}:${A3_HOME}/${A3_ROOT}/logs/*.log" \
+  "${A3}:${A3_HOME}/${A3_ROOT}/logs/*.txt" \
+  "${LOCAL_LOGS}/" || true
+ssh -o BatchMode=yes "${A3}" "date -u '+[fetch] a3_utc=%Y-%m-%dT%H:%M:%SZ'" | tee "${LOCAL}/clock_offset.txt"
+date -u '+[fetch] local_utc=%Y-%m-%dT%H:%M:%SZ' | tee -a "${LOCAL}/clock_offset.txt"
+
+( cd "${LOCAL_RAW}" && find . -type f ! -name 'LOCAL_SHA256SUMS.txt' -print0 \
+    | sort -z | xargs -0 sha256sum > LOCAL_SHA256SUMS.txt )
+echo "[fetch] local bytes:"
+du -sb "${LOCAL_RAW}" "${LOCAL_LOGS}"
