+    reserved2 = ptx_position_read_u32(descriptor + 28);
+    left_elements = ptx_position_read_u64(descriptor + 32);
+    right_elements = ptx_position_read_u64(descriptor + 40);
+    output_elements = ptx_position_read_u64(descriptor + 48);
