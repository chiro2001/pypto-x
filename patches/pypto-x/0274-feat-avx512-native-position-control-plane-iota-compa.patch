+/* Quiet signaling NaNs exactly like a Python float round trip: only lanes
+ * that are NaN, carry a non-zero payload and have the quiet bit clear are
+ * changed.  The payload and sign are preserved. */
+static __m512 ptx_position_quiet_nan(__m512 value) {
+    __m512i bits = _mm512_castps_si512(value);
+    const __m512i exponent = _mm512_set1_epi32((int)0x7f800000U);
+    const __m512i mantissa = _mm512_set1_epi32((int)0x007fffffU);
+    const __m512i quiet = _mm512_set1_epi32((int)0x00400000U);
+    const __m512i zero = _mm512_setzero_si512();
+    __mmask16 exp_all = _mm512_cmpeq_epi32_mask(_mm512_and_si512(bits, exponent), exponent);
+    __mmask16 mant_nonzero = _mm512_cmpneq_epi32_mask(_mm512_and_si512(bits, mantissa), zero);
+    __mmask16 already_quiet = _mm512_cmpneq_epi32_mask(_mm512_and_si512(bits, quiet), zero);
+    __mmask16 needs_quiet = (__mmask16)(exp_all & mant_nonzero & (__mmask16)(~already_quiet));
+    bits = _mm512_mask_or_epi32(bits, needs_quiet, bits, quiet);
+    return _mm512_castsi512_ps(bits);
+}
