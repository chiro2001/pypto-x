+def test_where_non_bool_condition_truthiness_matches_python(tmp_path):
+    """Core IR validation rejects non-bool conditions, but the host reference
+    truth value is defined for every dtype; the native kernel must implement
+    the same mapping (NaN true, +-0 false, non-zero true)."""
+
+    runtime = _runtime()
+    condition = ValueRef("condition", CoreType.tensor("bool", (4,)))
+    true_ref = ValueRef("true", CoreType.tensor("float32", (4,)))
+    false_ref = ValueRef("false", CoreType.tensor("float32", (4,)))
+    output_ref = ValueRef("output", CoreType.tensor("float32", (4,)))
+    program = _program(
+        "where_condition_truth",
+        (condition, true_ref, false_ref),
+        (output_ref,),
+        (Operation("where", (condition, true_ref, false_ref), (output_ref,)),),
+    )
+    artifact = _compile_avx512(program, tmp_path / "condition_truth")
+    loaded = runtime.load(artifact)
+    module = loaded.module
+
+    true_payload = _f32_bytes((0x7F800001, 0x3F800000, 0x00000000, 0xFF800007))
+    false_payload = _f32_bytes((0x7FC00001, 0x80000000, 0x00000001, 0x40000000))
+    cases = (
+        ("float32", _f32_bytes((0x7FC00001, 0x80000000, 0x3F800000, 0x00000001)), lambda b: list(struct.unpack("<4f", b))),
+        ("bf16", _bf16_bytes((0x7F81, 0x8000, 0xBF80, 0x0001)), lambda b: [_bf16_to_float(v) for v in struct.unpack("<4H", b)]),
+        ("int8", _i8_bytes((0, -1, 127, 0)), lambda b: list(struct.unpack("<4b", b))),
+        ("int32", _i32_bytes((0, -(2 ** 31), 2 ** 31 - 1, 1)), lambda b: list(struct.unpack("<4i", b))),
+    )
+    for condition_dtype, condition_payload, decode in cases:
+        condition_type = CoreType.tensor(condition_dtype, (4,))
+        true_type = CoreType.tensor("float32", (4,))
+        false_type = CoreType.tensor("float32", (4,))
+        output_type = CoreType.tensor("float32", (4,))
+        operation = Operation(
+            "where",
+            (ValueRef("c", condition_type), ValueRef("t", true_type), ValueRef("f", false_type)),
+            (ValueRef("o", output_type),),
+        )
+        plan = SimpleNamespace(operation="where", shape=(4,), dtype="float32", operation_index=0)
+        contract = position_native_contract(operation, plan)
+        assert contract is not None, condition_dtype
+        assert contract["sources"][0]["dtype"] == condition_dtype
+        assert contract["sources"][0]["strides"] == (1,)
+
+        def raw_value(dtype, payload, count):
+            array = (ctypes.c_ubyte * len(payload)).from_buffer_copy(payload)
+            pointer = ctypes.cast(array, avx512_runtime._pointer(dtype))
+            return avx512_runtime._RuntimeValue(
+                CoreType.tensor(dtype, (count,)),
+                avx512_runtime._NativeBuffer(dtype, count, pointer, array, False),
+            )
+
+        decision = {
+            "position": contract,
+            "output_ref": operation.outputs[0],
+            "inputs": (
+                raw_value(condition_dtype, condition_payload, 4),
+                raw_value("float32", true_payload, 4),
+                raw_value("float32", false_payload, 4),
+            ),
+        }
+        native_result = runtime._execute_position(decision, operation, plan, module)
+        native_bytes = ctypes.string_at(native_result["o"].buffer.pointer, 16)
+        condition_values = decode(condition_payload)
+        expected = vector_runtime._where_values(
+            condition_values,
+            condition_type,
+            list(struct.unpack("<4f", true_payload)),
+            true_type,
+            list(struct.unpack("<4f", false_payload)),
+            false_type,
+            output_type,
+            "synthetic",
+        )
+        assert native_bytes == _float_bytes(expected), condition_dtype
+        if condition_dtype in ("float32", "bf16"):
+            # NaN selects the true operand (element 0), -0.0 selects the other
+            # operand (element 1); the selected sNaN is quieted exactly like
+            # the host Python-float round trip.
+            assert native_bytes[:4] == _f32_bytes((0x7FC00001,))[:4], condition_dtype
+            assert native_bytes[4:8] == _f32_bytes((0x80000000,))[:4], condition_dtype
+
+    # A scalar condition must describe stride 0 and select the same branch.
+    scalar_condition_type = CoreType.scalar("float32")
+    scalar_true_type = CoreType.tensor("float32", (4,))
+    scalar_false_type = CoreType.tensor("float32", (4,))
+    scalar_output_type = CoreType.tensor("float32", (4,))
+    scalar_operation = Operation(
+        "where",
+        (
+            ValueRef("c", scalar_condition_type),
+            ValueRef("t", scalar_true_type),
+            ValueRef("f", scalar_false_type),
+        ),
+        (ValueRef("o", scalar_output_type),),
+    )
+    scalar_contract = position_native_contract(scalar_operation, plan)
+    assert scalar_contract is not None
+    assert scalar_contract["sources"][0]["shape"] == ()
+    assert scalar_contract["sources"][0]["strides"] == (0,)
+    scalar_payload = _f32_bytes((0x7F800001,))
+    scalar_array = (ctypes.c_ubyte * len(scalar_payload)).from_buffer_copy(scalar_payload)
+    scalar_condition = avx512_runtime._RuntimeValue(
+        scalar_condition_type,
+        avx512_runtime._NativeBuffer(
+            "float32",
+            1,
+            ctypes.cast(scalar_array, avx512_runtime._pointer("float32")),
+            scalar_array,
+            False,
+        ),
+    )
+    scalar_decision = {
+        "position": scalar_contract,
+        "output_ref": scalar_operation.outputs[0],
+        "inputs": (
+            scalar_condition,
+            avx512_runtime._RuntimeValue(
+                scalar_true_type,
+                avx512_runtime._buffer_from_values("float32", list(struct.unpack("<4f", true_payload)), "true"),
+            ),
+            avx512_runtime._RuntimeValue(
+                scalar_false_type,
+                avx512_runtime._buffer_from_values("float32", list(struct.unpack("<4f", false_payload)), "false"),
+            ),
+        ),
+    }
+    scalar_result = runtime._execute_position(scalar_decision, scalar_operation, plan, module)
+    scalar_native_bytes = ctypes.string_at(scalar_result["o"].buffer.pointer, 16)
+    scalar_expected = vector_runtime._where_values(
+        struct.unpack("<f", scalar_payload)[0],
+        scalar_condition_type,
+        list(struct.unpack("<4f", true_payload)),
+        scalar_true_type,
+        list(struct.unpack("<4f", false_payload)),
+        scalar_false_type,
+        scalar_output_type,
+        "synthetic",
+    )
+    assert scalar_native_bytes == _float_bytes(scalar_expected)
+    assert scalar_native_bytes[:4] == _f32_bytes((0x7FC00001,))[:4]
+
