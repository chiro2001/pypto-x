+/* FNV-1a 64, matching the SVE256 control-wire descriptor tag. */
+static uint64_t ptx_position_wire_hash(const unsigned char *bytes, size_t length) {
+    uint64_t hash = UINT64_C(1469598103934665603);
+    size_t index;
