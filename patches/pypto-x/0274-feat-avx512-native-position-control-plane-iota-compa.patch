+def _assert_position_boundary_is_auditable(metadata) -> None:
+    native_entries = metadata["position_control_native_operations"]
+    fallback_entries = metadata["position_control_fallback_operations"]
+    assert tuple(metadata["position_control_operations"]) == tuple(
+        entry["operation"] for entry in native_entries
+    )
+    native_indices = {entry["operation_index"] for entry in native_entries}
+    fallback_indices = {entry["operation_index"] for entry in fallback_entries}
+    assert not native_indices.intersection(fallback_indices)
+    for entry in native_entries:
+        assert entry["mode"] == POSITION_NATIVE_MODES[entry["kind"]]
+        assert entry["kernel"] == "{}_control".format(entry["kind"])
+    for entry in fallback_entries:
+        assert entry["mode"] == POSITION_FALLBACK_MODE
+        assert entry["reason"]
+    for item in metadata["execution_modes"]:
+        if item["operation"] not in POSITION_OPERATIONS:
+            continue
+        index = item["operation_index"]
+        assert index in native_indices or index in fallback_indices
+        expected = (
+            POSITION_NATIVE_MODES[item["operation"]]
+            if index in native_indices
+            else POSITION_FALLBACK_MODE
+        )
+        assert item["mode"] == expected
+    if not native_entries and not fallback_entries:
+        assert metadata["position_control_fallback"] == "not_applicable"
+    elif not fallback_entries:
+        assert metadata["position_control_fallback"] == "native"
+    elif not native_entries:
+        assert metadata["position_control_fallback"] == "host_reference"
+    else:
+        assert metadata["position_control_fallback"] == "mixed"
+
