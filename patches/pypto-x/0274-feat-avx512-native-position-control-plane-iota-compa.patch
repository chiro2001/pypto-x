+        ValueRef("where_out", CoreType.tensor("int64", (4,))),
+    )
+    program = _program(
+        "plan_positions",
+        (left, right, condition),
+        outputs,
+        (
+            Operation("iota", (), (outputs[0],), {"axis": 0, "start": 1, "step": 2}),
+            Operation("compare", (left, right), (outputs[1],), {"predicate": "le"}),
+            Operation("where", (condition, left, right), (outputs[2],)),
+        ),
+    )
+    target_ir = Avx512Compiler().lower(program, AVX512_TARGET)
+    function = next(item for item in target_ir.program.functions if item.name == target_ir.entrypoint)
+    operations = function.body.operations
+    for plan in target_ir.plans:
+        environment = {}
+        for ref in operations[plan.operation_index].inputs:
+            dtype = canonical_dtype(ref.type.dtype)
+            count = element_count(static_shape(ref.type, ref.name))
+            environment[ref.name] = avx512_runtime._RuntimeValue(
+                ref.type,
+                avx512_runtime._buffer_from_values(dtype, [0] * count, ref.name),
+            )
+        decision = runtime.plan_execution(operations[plan.operation_index], plan, environment)
+        assert decision["mode"] == POSITION_NATIVE_MODES[plan.operation], plan.operation
+        assert decision["python_list_elements"] == 0, plan.operation
