+    def _execute_position(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+    ) -> Dict[str, _RuntimeValue]:
+        """Run one native iota/compare/where descriptor kernel.
+
+        The PXIO/PXCP/PXWH descriptor is built from the exact contract that
+        produced the artifact metadata; the C decoder validates magic,
+        version, reserved fields, rank, shape/stride bounds and the FNV-1a
+        tag before touching an element.  No Python element list is created.
+        """
+
+        contract = decision["position"]
+        output_ref = decision["output_ref"]
+        kind = contract["kind"]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        count = int(contract["output_elements"])
+        if count != element_count(tuple(contract["output_shape"])):
+            raise CpuAvx512ArtifactError("AVX-512 {} position element count changed".format(kind))
+        values = list(decision["inputs"])
+        sources = tuple(contract["sources"])
+        if len(values) != len(sources):
+            raise CpuAvx512ArtifactError(
+                "AVX-512 {} position operand count changed".format(kind)
+            )
+        for value, source in zip(values, sources):
+            if (
+                canonical_dtype(value.buffer.dtype) != canonical_dtype(source["dtype"])
+                or value.buffer.count != int(source["elements"])
+            ):
+                raise CpuAvx512ArtifactError(
+                    "AVX-512 {} position operand {!r} does not match its descriptor".format(
+                        kind, source["label"]
+                    )
+                )
+        destination = _buffer_alloc(dtype, count, output_ref.name)
+        if kind == "iota":
+            descriptor = _position_iota_descriptor_bytes(contract)
+            function = _status_symbol(
