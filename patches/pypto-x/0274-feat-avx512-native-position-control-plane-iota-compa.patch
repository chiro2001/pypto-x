+
+static uint32_t ptx_position_item_bytes(uint32_t dtype) {
+    switch (dtype) {
+    case PTX_POS_DTYPE_F32: return 4U;
+    case PTX_POS_DTYPE_BF16: return 2U;
+    case PTX_POS_DTYPE_I32: return 4U;
+    case PTX_POS_DTYPE_I64: return 8U;
+    case PTX_POS_DTYPE_BOOL: return 1U;
+    case PTX_POS_DTYPE_I8: return 1U;
+    case PTX_POS_DTYPE_U8: return 1U;
+    case PTX_POS_DTYPE_I16: return 2U;
+    case PTX_POS_DTYPE_U16: return 2U;
+    case PTX_POS_DTYPE_U32: return 4U;
+    case PTX_POS_DTYPE_U64: return 8U;
+    default: return 0U;
