+static int ptx_position_is_signed_dtype(uint32_t dtype) {
+    return dtype == PTX_POS_DTYPE_I8 || dtype == PTX_POS_DTYPE_I16 ||
+           dtype == PTX_POS_DTYPE_I32 || dtype == PTX_POS_DTYPE_I64;
