+static int ptx_position_shape_product(const uint64_t *shape, uint32_t rank,
+                                      uint64_t expected) {
+    uint64_t product = 1U;
+    uint32_t axis;
+    for (axis = 0; axis < rank; ++axis) {
+        if (shape[axis] != 0U && product > UINT64_MAX / shape[axis]) return 0;
+        product *= shape[axis];
