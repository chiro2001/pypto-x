+
+static void ptx_position_advance(uint64_t *coordinates, const uint64_t *shape,
+                                 uint32_t rank) {
+    uint32_t axis = rank;
+    while (axis > 0U) {
+        --axis;
+        coordinates[axis] += 1U;
+        if (coordinates[axis] < shape[axis]) return;
+        coordinates[axis] = 0U;
+    }
+}
+
+static uint64_t ptx_position_offset(const uint64_t *coordinates, const uint64_t *strides,
+                                    uint32_t rank) {
+    uint64_t offset = 0U;
+    uint32_t axis;
+    for (axis = 0; axis < rank; ++axis)
+        offset += coordinates[axis] * strides[axis];
+    return offset;
+}
+
+static __mmask16 ptx_position_cmp_f32(uint32_t predicate, __m512 left, __m512 right) {
+    switch (predicate) {
+    case 0U: return _mm512_cmp_ps_mask(left, right, _CMP_EQ_OQ);
+    case 1U: return _mm512_cmp_ps_mask(left, right, _CMP_NEQ_UQ);
+    case 2U: return _mm512_cmp_ps_mask(left, right, _CMP_LT_OQ);
+    case 3U: return _mm512_cmp_ps_mask(left, right, _CMP_LE_OQ);
+    case 4U: return _mm512_cmp_ps_mask(left, right, _CMP_GT_OQ);
+    default: return _mm512_cmp_ps_mask(left, right, _CMP_GE_OQ);
+    }
+}
+
+static __mmask8 ptx_position_cmp_i64(uint32_t predicate, __m512i left, __m512i right) {
+    switch (predicate) {
+    case 0U: return _mm512_cmp_epi64_mask(left, right, 0);
+    case 1U: return _mm512_cmp_epi64_mask(left, right, 4);
+    case 2U: return _mm512_cmp_epi64_mask(left, right, 1);
+    case 3U: return _mm512_cmp_epi64_mask(left, right, 2);
+    case 4U: return _mm512_cmp_epi64_mask(left, right, 6);
+    default: return _mm512_cmp_epi64_mask(left, right, 5);
+    }
+}
+
+static __mmask8 ptx_position_cmp_u64(uint32_t predicate, __m512i left, __m512i right) {
+    switch (predicate) {
+    case 0U: return _mm512_cmp_epu64_mask(left, right, 0);
+    case 1U: return _mm512_cmp_epu64_mask(left, right, 4);
+    case 2U: return _mm512_cmp_epu64_mask(left, right, 1);
+    case 3U: return _mm512_cmp_epu64_mask(left, right, 2);
+    case 4U: return _mm512_cmp_epu64_mask(left, right, 6);
+    default: return _mm512_cmp_epu64_mask(left, right, 5);
+    }
+}
