+# ---------------------------------------------------------------------------
+# Strict payload / descriptor decoding
+# ---------------------------------------------------------------------------
+
+def _artifact_with_metadata(artifact: Artifact, metadata) -> Artifact:
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=metadata,
+    )
+
+
+def _thawed_metadata(artifact: Artifact):
+    return json.loads(json.dumps(artifact.to_dict()["metadata"]))
+
+
+def test_payload_and_position_metadata_are_strictly_decoded(tmp_path):
+    runtime = _runtime()
+    output = ValueRef("output", CoreType.tensor("int32", (4,)))
+    program = _program(
+        "iota", (), (output,), (Operation("iota", (), (output,), {"axis": 0}),)
+    )
+    artifact = _compile_avx512(program, tmp_path / "strict")
+    runtime.load(artifact)
+
+    metadata = _thawed_metadata(artifact)
+    metadata["artifact_payload_version"] = 7
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="payload version"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    metadata = _thawed_metadata(artifact)
+    metadata["artifact_payload_version"] = 9
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="payload version"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    metadata = _thawed_metadata(artifact)
+    metadata.pop("control_descriptor_wire")
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="no control_descriptor_wire"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    metadata = _thawed_metadata(artifact)
+    metadata["control_descriptor_wire"] = "v0:pxio"
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="descriptor wire"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    metadata = _thawed_metadata(artifact)
+    metadata["position_control_native_operations"][0]["kernel"] = "bogus_control"
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="native kernel"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    metadata = _thawed_metadata(artifact)
+    metadata["position_control_fallback"] = "host_reference"
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="position_control_fallback"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    metadata = _thawed_metadata(artifact)
+    for item in metadata["execution_modes"]:
+        if item["operation"] == "iota":
+            item["mode"] = "host_reference"
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="execution mode"):
+        runtime.load(_artifact_with_metadata(artifact, metadata))
+
+    # A payload-8 header that still declares the payload-7 host_reference
+    # boundary (no versioned wire marker) is a legacy payload, not a native one.
+    legacy = _thawed_metadata(artifact)
+    legacy.pop("control_descriptor_wire")
+    legacy["position_control_native_operations"] = []
+    legacy["position_control_fallback_operations"] = []
+    legacy["position_control_operations"] = []
+    legacy["position_control_fallback"] = "host_reference"
+    with pytest.raises(avx512_runtime.CpuAvx512ArtifactError, match="legacy host_reference"):
+        runtime.load(_artifact_with_metadata(artifact, legacy))
+
