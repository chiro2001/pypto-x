+    int64_t start, step;
+    if (descriptor == NULL || descriptor_length != PTX_POS_IOTA_BYTES)
+        return PTX_POS_STATUS_BAD_REQUEST;
+    if (memcmp(descriptor, "PXIO", 4) != 0 || ptx_position_read_u32(descriptor + 4) != 1U)
+        return PTX_POS_STATUS_BAD_REQUEST;
+    axis = ptx_position_read_u32(descriptor + 8);
+    dtype = ptx_position_read_u32(descriptor + 12);
+    reserved = ptx_position_read_u32(descriptor + 16);
+    rank = ptx_position_read_u32(descriptor + 20);
+    output_elements = ptx_position_read_u64(descriptor + 24);
+    start = (int64_t)ptx_position_read_u64(descriptor + 32);
+    step = (int64_t)ptx_position_read_u64(descriptor + 40);
+    inner_stride = ptx_position_read_u64(descriptor + 48);
+    dimension = ptx_position_read_u64(descriptor + 56);
+    if (reserved != 0U) return PTX_POS_STATUS_BAD_REQUEST;
+    if (rank == 0U || rank > PTX_POS_MAX_RANK || axis >= rank)
+        return PTX_POS_STATUS_BAD_REQUEST;
+    if (dtype != PTX_POS_DTYPE_I32 && dtype != PTX_POS_DTYPE_I64)
+        return PTX_POS_STATUS_BAD_REQUEST;
+    if (output_elements != 0U &&
+        (dimension == 0U || inner_stride == 0U || inner_stride > output_elements))
+        return PTX_POS_STATUS_BAD_REQUEST;
+    if (ptx_position_wire_hash(descriptor, PTX_POS_IOTA_BYTES) != descriptor_tag)
+        return PTX_POS_STATUS_BAD_REQUEST;
+    if (output_elements != 0U && output == NULL) return PTX_POS_STATUS_BAD_REQUEST;
+    for (index = 0U; index < output_elements; ++index) {
+        uint64_t coordinate = (index / inner_stride) % dimension;
+        __int128 value;
+        if (step == 0) {
+            /* A huge zero-step axis can still be a valid constant iota; avoid
+             * narrowing a coordinate that does not fit signed 64-bit. */
+            value = (__int128)start;
+        } else {
+            value = (__int128)start + (__int128)(int64_t)coordinate * (__int128)step;
+        }
+        if (dtype == PTX_POS_DTYPE_I32) {
+            int32_t narrowed = (int32_t)value;
+            memcpy((unsigned char *)output + index * 4U, &narrowed, sizeof(narrowed));
+        } else {
+            int64_t widened = (int64_t)value;
+            memcpy((unsigned char *)output + index * 8U, &widened, sizeof(widened));
+        }
+    }
+    return 0;
+}
