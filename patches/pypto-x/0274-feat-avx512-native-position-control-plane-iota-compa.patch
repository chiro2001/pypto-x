+"""Native AVX-512 position-control plane (payload 8): iota / compare / where.
+
+The host reference is the only semantic source of truth.  These tests compare
+native PXIO/PXCP/PXWH descriptor execution against ``CpuScalarRuntime``
+bit-for-bit (float payloads included), audit the per-operation native/fallback
+metadata, and attack the strict payload/descriptor decoders.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import json
+import struct
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.tensor import _cast_value
+from pypto.backends.cpu.vector import runtime as vector_runtime
+from pypto.backends.cpu.x86 import Avx512Runtime
+from pypto.backends.cpu.x86 import avx512 as avx512_runtime
+from pypto.compiler import Artifact, CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_avx512 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    CONTROL_DESCRIPTOR_WIRE,
+    NATIVE_ABI_MARKER,
+    POSITION_FALLBACK_MODE,
+    POSITION_NATIVE_MODES,
+    Avx512Compiler,
+    position_native_contract,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import canonical_dtype, element_count, static_shape
+from pypto.target import TargetSpec
+
+
+AVX512_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    features=("avx512f",),
+    attributes={"lane_count": 16},
+)
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+POSITION_OPERATIONS = ("iota", "compare", "where")
+_RAW_DTYPES = frozenset(("float32", "bf16", "int8", "int32", "int64"))
+
+
+def _runtime() -> Avx512Runtime:
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _compile_avx512(program: CoreProgram, build_dir) -> Artifact:
+    compiler = Avx512Compiler()
+    return compiler.compile(
+        compiler.lower(program, AVX512_TARGET),
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx512",
+            extra={"build_dir": str(build_dir)},
+        ),
+    )
+
+
+def _compile_scalar(program: CoreProgram) -> Artifact:
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _launch(artifact, inputs, outputs, runtime, *, scalars=None):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item if isinstance(item, TensorDesc) else item.descriptor(readonly=True) for item in inputs],
+            outputs=[item if isinstance(item, TensorDesc) else item.descriptor() for item in outputs],
+            scalars=scalars or {},
+        )
+    )
+
+
+def _program(name: str, inputs, outputs, operations) -> CoreProgram:
+    return CoreProgram(
+        functions=(
+            CoreFunction(name, tuple(inputs), tuple(outputs), Region(tuple(operations))),
+        )
+    )
+
+
+def _raw_tensor(dtype: str, shape, payload: bytes, *, readonly: bool = True) -> TensorDesc:
+    return TensorDesc(dtype, shape, device="cpu", handle=bytearray(payload), readonly=readonly)
+
+
+def _f32_bytes(bits) -> bytes:
+    return b"".join(struct.pack("<I", int(bits) & 0xFFFFFFFF) for bits in bits)
+
+
+def _bf16_bytes(bits) -> bytes:
+    return b"".join(struct.pack("<H", int(bits) & 0xFFFF) for bits in bits)
+
+
+def _i8_bytes(values) -> bytes:
+    return b"".join(struct.pack("<b", int(value)) for value in values)
+
+
+def _i32_bytes(values) -> bytes:
+    return b"".join(struct.pack("<i", int(value)) for value in values)
+
+
+def _i64_bytes(values) -> bytes:
+    return b"".join(struct.pack("<q", int(value)) for value in values)
+
+
+def _bf16_to_float(bits: int) -> float:
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+def _decode_values(dtype: str, payload: bytes, count: int):
+    if dtype == "float32":
+        return list(struct.unpack("<{}f".format(count), payload))
+    if dtype == "bf16":
+        return [_bf16_to_float(bits) for bits in struct.unpack("<{}H".format(count), payload)]
+    if dtype == "int8":
+        return list(struct.unpack("<{}b".format(count), payload))
+    if dtype == "int32":
+        return list(struct.unpack("<{}i".format(count), payload))
+    if dtype == "int64":
+        return list(struct.unpack("<{}q".format(count), payload))
+    raise AssertionError("unsupported raw decode dtype {}".format(dtype))
+
+
+def _float_bytes(values) -> bytes:
+    return b"".join(
+        struct.pack("<f", _cast_value(value, "float32")) for value in values
+    )
+
+
+_ITEM_BYTES = {"float32": 4, "bf16": 2, "int8": 1, "int32": 4, "int64": 8}
+
+
+# ---------------------------------------------------------------------------
+# Differential value matrices
+# ---------------------------------------------------------------------------
+
+_F32_LEFT_BITS = (
+    0x00000000,  # +0.0
+    0x80000000,  # -0.0
+    0x00000001,  # +subnormal
+    0x80000001,  # -subnormal
+    0x00800000,  # min normal
+    0x3F800000,  # 1.0
+    0xBF800000,  # -1.0
+    0x7F7FFFFF,  # max finite
+    0xFF7FFFFF,
+    0x7F800000,  # +inf
+    0xFF800000,  # -inf
+    0x7FC00001,  # qNaN payload 0x1
+    0xFFC00002,  # -qNaN payload 0x2
+    0x7F800001,  # sNaN (quiet bit clear)
+    0x7F812345,  # sNaN payload
+    0xFF800007,  # -sNaN payload
+)
+_F32_RIGHT_BITS = list(reversed(_F32_LEFT_BITS))
+_F32_RIGHT_BITS[0] = _F32_LEFT_BITS[0]      # +0 == +0
+_F32_RIGHT_BITS[1] = _F32_LEFT_BITS[1]      # -0 == -0
+_F32_RIGHT_BITS[3] = _F32_LEFT_BITS[3]      # equal subnormals
+_F32_RIGHT_BITS[6] = _F32_LEFT_BITS[6]      # -1 == -1
+_F32_RIGHT_BITS[12] = _F32_LEFT_BITS[12]    # equal qNaN is still unordered
+_F32_RIGHT_BITS[14] = _F32_LEFT_BITS[14]    # equal sNaN is still unordered
+_F32_RIGHT_BITS[9] = _F32_LEFT_BITS[9]      # +inf == +inf
+
+_BF16_LEFT_BITS = (
+    0x0000,  # +0.0
+    0x8000,  # -0.0
+    0x0001,  # +subnormal
+    0x8001,  # -subnormal
+    0x0080,  # min normal
+    0x3F80,  # 1.0
+    0xBF80,  # -1.0
+    0x7F7F,  # max finite
+    0xFF7F,
+    0x7F80,  # +inf
+    0xFF80,  # -inf
+    0x7FC1,  # qNaN payload
+    0xFFC2,  # -qNaN payload
+    0x7F81,  # sNaN
+    0x7F91,  # sNaN payload
+    0xFF87,  # -sNaN payload
+)
+_BF16_RIGHT_BITS = list(reversed(_BF16_LEFT_BITS))
+_BF16_RIGHT_BITS[0] = _BF16_LEFT_BITS[0]
+_BF16_RIGHT_BITS[1] = _BF16_LEFT_BITS[1]
+_BF16_RIGHT_BITS[3] = _BF16_LEFT_BITS[3]
+_BF16_RIGHT_BITS[6] = _BF16_LEFT_BITS[6]
+_BF16_RIGHT_BITS[12] = _BF16_LEFT_BITS[12]
+_BF16_RIGHT_BITS[14] = _BF16_LEFT_BITS[14]
+
+_I8_LEFT = (-128, -127, -2, -1, 0, 1, 2, 126, 127, -3, 3, -100, 100, 5, -5, 7)
+_I8_RIGHT = list(reversed(_I8_LEFT))
+_I8_RIGHT[0] = _I8_LEFT[0]
+_I8_RIGHT[4] = _I8_LEFT[4]
+_I8_RIGHT[8] = _I8_LEFT[8]
+
+_I32_LEFT = (
+    -(2 ** 31), -(2 ** 31) + 1, -2, -1, 0, 1, 2,
+    2 ** 31 - 2, 2 ** 31 - 1, -3, 3, -100000, 100000, 5, -5, 7,
+)
+_I32_RIGHT = list(reversed(_I32_LEFT))
+_I32_RIGHT[0] = _I32_LEFT[0]
+_I32_RIGHT[4] = _I32_LEFT[4]
+_I32_RIGHT[8] = _I32_LEFT[8]
+
+_COMPARE_CASES = (
+    ("float32", _F32_LEFT_BITS, _F32_RIGHT_BITS),
+    ("bf16", _BF16_LEFT_BITS, _BF16_RIGHT_BITS),
+    ("int8", _I8_LEFT, _I8_RIGHT),
+    ("int32", _I32_LEFT, _I32_RIGHT),
+)
+
+
+def _compare_input_tensors() -> list:
+    tensors = []
+    for dtype, left, right in _COMPARE_CASES:
+        count = len(left)
+        if dtype == "float32":
+            tensors.append(_raw_tensor("float32", (count,), _f32_bytes(left)))
+            tensors.append(_raw_tensor("float32", (count,), _f32_bytes(right)))
+        elif dtype == "bf16":
+            tensors.append(_raw_tensor("bf16", (count,), _bf16_bytes(left)))
+            tensors.append(_raw_tensor("bf16", (count,), _bf16_bytes(right)))
+        elif dtype == "int8":
+            tensors.append(_raw_tensor("int8", (count,), _i8_bytes(left)))
+            tensors.append(_raw_tensor("int8", (count,), _i8_bytes(right)))
+        else:
+            tensors.append(_raw_tensor("int32", (count,), _i32_bytes(left)))
+            tensors.append(_raw_tensor("int32", (count,), _i32_bytes(right)))
+    return tensors
+
+
+def _compare_matrix_program():
+    inputs = []
+    outputs = []
+    operations = []
+    layout = []
+    for dtype, left, right in _COMPARE_CASES:
+        count = len(left)
+        left_ref = ValueRef("left_{}".format(dtype), CoreType.tensor(dtype, (count,)))
+        right_ref = ValueRef("right_{}".format(dtype), CoreType.tensor(dtype, (count,)))
+        inputs.extend((left_ref, right_ref))
+        for predicate in ("eq", "ne", "lt", "le", "gt", "ge"):
+            output_ref = ValueRef(
+                "compare_{}_{}".format(dtype, predicate), CoreType.tensor("bool", (count,))
+            )
+            outputs.append(output_ref)
+            operations.append(
+                Operation("compare", (left_ref, right_ref), (output_ref,), {"predicate": predicate})
+            )
+            layout.append((dtype, predicate, count))
+    return _program("compare_matrix", inputs, outputs, operations), layout
+
+
+def test_compare_native_differential_matrix(tmp_path):
+    runtime = _runtime()
+    program, layout = _compare_matrix_program()
+    artifact = _compile_avx512(program, tmp_path / "compare")
+    scalar_artifact = _compile_scalar(program)
+    metadata = artifact.metadata
+    assert metadata["position_control_fallback"] == "native"
+    assert tuple(metadata["position_control_fallback_operations"]) == ()
+    assert len(metadata["position_control_native_operations"]) == len(layout)
+    assert tuple(metadata["position_control_operations"]) == tuple(
+        entry["operation"] for entry in metadata["position_control_native_operations"]
+    )
+    assert all(entry["kernel"] == "compare_control" for entry in metadata["position_control_native_operations"])
+
+    inputs = _compare_input_tensors()
+    native_outputs = [HostTensor.zeros("bool", (count,)) for _, _, count in layout]
+    scalar_outputs = [HostTensor.zeros("bool", (count,)) for _, _, count in layout]
+    _launch(artifact, inputs, native_outputs, runtime)
+    _launch(scalar_artifact, inputs, scalar_outputs, runtime=CpuScalarRuntime())
+    for index, (dtype, predicate, _count) in enumerate(layout):
+        assert tuple(native_outputs[index].flat()) == tuple(scalar_outputs[index].flat()), (
+            dtype,
+            predicate,
+            native_outputs[index].flat(),
+            scalar_outputs[index].flat(),
+        )
+    modes = {item["operation_index"]: item["mode"] for item in metadata["execution_modes"]}
+    for plan_index in range(len(layout)):
+        assert modes[plan_index] == "native_avx512_compare"
+
+
+def test_compare_broadcast_strides_match_host(tmp_path):
+    runtime = _runtime()
+    left_bits = (0x7FC00001, 0x00000000, 0x80000000, 0x3F800000, 0x7F800001, 0xFF800000)
+    right_bits = (0x3F800000,)
+    left = ValueRef("left", CoreType.tensor("float32", (6,)))
+    right = ValueRef("right", CoreType.tensor("float32", (1,)))
+    output = ValueRef("output", CoreType.tensor("bool", (6,)))
+    operation = Operation("compare", (left, right), (output,), {"predicate": "lt"})
+    program = _program("compare_broadcast", (left, right), (output,), (operation,))
+    artifact = _compile_avx512(program, tmp_path / "broadcast")
+    scalar_artifact = _compile_scalar(program)
