+
+static int ptx_position_validate_strides(const uint64_t *shape, const uint64_t *strides,
+                                         uint32_t rank, uint64_t elements) {
+    uint64_t max_offset = 0U;
+    uint32_t axis;
+    for (axis = 0; axis < rank; ++axis)
+        if (shape[axis] == 0U) return 1; /* an empty shape never reads the source */
+    if (elements == 0U) return 1;
+    for (axis = 0; axis < rank; ++axis) {
+        uint64_t term;
+        if (strides[axis] > UINT64_MAX / (shape[axis] - 1U)) return 0;
+        term = (shape[axis] - 1U) * strides[axis];
