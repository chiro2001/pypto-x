+def test_where_native_differential_matrix_with_nan_payloads(tmp_path):
+    runtime = _runtime()
+    program, dtypes = _where_matrix_program()
+    artifact = _compile_avx512(program, tmp_path / "where")
+    scalar_artifact = _compile_scalar(program)
+    assert artifact.metadata["position_control_fallback"] == "native"
+    assert tuple(artifact.metadata["position_control_fallback_operations"]) == ()
+    assert len(artifact.metadata["position_control_native_operations"]) == len(dtypes)
+    assert all(
+        entry["kernel"] == "where_control"
+        for entry in artifact.metadata["position_control_native_operations"]
+    )
+
+    condition = HostTensor("bool", (4, 2), _WHERE_CONDITION)
+    native_inputs = []
+    scalar_inputs = []
+    native_outputs = []
+    scalar_outputs = []
+    raw_flags = []
+    for dtype in dtypes:
+        raw = dtype in _RAW_DTYPES
+        raw_flags.append(raw)
+        native_inputs.append(_where_inputs(dtype, raw, condition))
+        scalar_inputs.append(_where_inputs(dtype, raw, condition.copy()))
+        if raw:
+            size = _ITEM_BYTES[dtype] * 8
+            native_outputs.append(_raw_tensor(dtype, (4, 2), bytes(size), readonly=False))
+            scalar_outputs.append(_raw_tensor(dtype, (4, 2), bytes(size), readonly=False))
+        else:
+            native_outputs.append(HostTensor.zeros(dtype, (4, 2)))
+            scalar_outputs.append(HostTensor.zeros(dtype, (4, 2)))
+
+    def flatten(items):
+        return [value for group in items for value in group]
+
+    _launch(artifact, flatten(native_inputs), native_outputs, runtime)
+    _launch(scalar_artifact, flatten(scalar_inputs), scalar_outputs, runtime=CpuScalarRuntime())
+    for index, dtype in enumerate(dtypes):
+        if raw_flags[index]:
+            assert bytes(native_outputs[index].storage) == bytes(scalar_outputs[index].storage), dtype
+        else:
+            assert tuple(native_outputs[index].flat()) == tuple(scalar_outputs[index].flat()), dtype
+    modes = {item["operation_index"]: item["mode"] for item in artifact.metadata["execution_modes"]}
+    for plan_index in range(len(dtypes)):
+        assert modes[plan_index] == "native_avx512_where"
