+
+static float ptx_position_load_f32(const unsigned char *data, uint64_t byte_offset,
+                                   uint32_t dtype) {
+    if (dtype == PTX_POS_DTYPE_BF16) {
+        uint16_t bits; memcpy(&bits, data + byte_offset, sizeof(bits));
+        return ptx_bf16_to_f32(bits);
+    }
+    {
+        float value; memcpy(&value, data + byte_offset, sizeof(value));
+        return value;
+    }
+}
+
+/* Host-reference truthiness: NaN is true (it is not equal to zero), +-0.0 is
+ * false, and any non-zero integer/byte is true. */
+static unsigned char ptx_position_condition_truth(const unsigned char *data,
+                                                  uint64_t byte_offset,
+                                                  uint32_t dtype) {
+    if (ptx_position_is_float_dtype(dtype))
+        return (ptx_position_load_f32(data, byte_offset, dtype) == 0.0f) ? 0U : 1U;
+    if (dtype == PTX_POS_DTYPE_BOOL) return data[byte_offset] != 0U ? 1U : 0U;
+    return ptx_position_load_word(data, byte_offset, dtype) != 0U ? 1U : 0U;
