+    case PTX_POS_DTYPE_I16: {
+        int16_t value; memcpy(&value, data + byte_offset, sizeof(value));
+        return (uint64_t)(int64_t)value;
+    }
+    case PTX_POS_DTYPE_U16: {
+        uint16_t value; memcpy(&value, data + byte_offset, sizeof(value));
+        return (uint64_t)value;
+    }
+    case PTX_POS_DTYPE_I32: {
+        int32_t value; memcpy(&value, data + byte_offset, sizeof(value));
+        return (uint64_t)(int64_t)value;
+    }
+    case PTX_POS_DTYPE_U32: {
+        uint32_t value; memcpy(&value, data + byte_offset, sizeof(value));
+        return (uint64_t)value;
+    }
+    case PTX_POS_DTYPE_I64: {
+        int64_t value; memcpy(&value, data + byte_offset, sizeof(value));
+        return (uint64_t)value;
+    }
+    default: {
+        uint64_t value; memcpy(&value, data + byte_offset, sizeof(value));
+        return value;
+    }
+    }
