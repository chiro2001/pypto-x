+
+def _where_case(dtype: str):
+    if dtype == "float32":
+        true_bits = (0x7F800001, 0x7FC00002, 0x3F800000, 0xFF800007)
+        false_bits = (
+            0x00000000, 0x80000000, 0x7FC0DEAD, 0x7F800000,
+            0x00000001, 0xFFC00003, 0x4F000000, 0x7F800001,
+        )
+        return _f32_bytes(true_bits), _f32_bytes(false_bits)
+    if dtype == "bf16":
+        true_bits = (0x7F81, 0x7FC2, 0x3F80, 0xFF87)
+        false_bits = (0x0000, 0x8000, 0x7FC0, 0x7F80, 0x0001, 0xFFC3, 0x4F00, 0x7F81)
+        return _bf16_bytes(true_bits), _bf16_bytes(false_bits)
+    if dtype == "int8":
+        return _i8_bytes((-128, 0, 127, -1)), _i8_bytes((127, -128, 0, 1, -2, 2, -100, 100))
+    if dtype == "int32":
+        return _i32_bytes((-(2 ** 31), 0, 2 ** 31 - 1, -1)), _i32_bytes(
+            (2 ** 31 - 1, -(2 ** 31), 0, 1, -2, 2, -100000, 100000)
+        )
+    if dtype == "int64":
+        return _i64_bytes((-(2 ** 63), 0, 2 ** 63 - 1, -1)), _i64_bytes(
+            (2 ** 63 - 1, -(2 ** 63), 0, 1, -2, 2, -10 ** 12, 10 ** 12)
+        )
+    raise AssertionError("unhandled raw where dtype {}".format(dtype))
+
+
+_WHERE_HOST_CASES = {
+    "int16": ((-32768, 0, 32767, -1), (32767, -32768, 0, 1, -2, 2, -1000, 1000)),
+    "uint8": ((0, 255, 1, 128), (255, 0, 1, 2, 3, 4, 128, 254)),
+    "uint16": ((0, 65535, 1, 32768), (65535, 0, 1, 2, 3, 4, 32768, 65534)),
+    "uint32": ((0, 2 ** 32 - 1, 1, 2 ** 31), (2 ** 32 - 1, 0, 1, 2, 3, 4, 2 ** 31, 2 ** 32 - 2)),
+    "uint64": (
+        (0, 2 ** 64 - 1, 1, 2 ** 63),
+        (2 ** 64 - 1, 0, 1, 2, 3, 4, 2 ** 63, 2 ** 64 - 2),
+    ),
+    "bool": ((False, True, True, False), (True, False, True, False, True, False, True, False)),
+}
+
+
+def _where_matrix_program():
+    inputs = []
+    outputs = []
+    operations = []
+    dtypes = ("float32", "bf16", "int8", "int32", "int64") + tuple(sorted(_WHERE_HOST_CASES))
+    for dtype in dtypes:
+        condition = ValueRef("condition_{}".format(dtype), CoreType.tensor("bool", (4, 2)))
+        true_ref = ValueRef("true_{}".format(dtype), CoreType.tensor(dtype, (4, 1)))
+        false_ref = ValueRef("false_{}".format(dtype), CoreType.tensor(dtype, (4, 2)))
+        output_ref = ValueRef("where_{}".format(dtype), CoreType.tensor(dtype, (4, 2)))
+        inputs.extend((condition, true_ref, false_ref))
+        outputs.append(output_ref)
+        operations.append(Operation("where", (condition, true_ref, false_ref), (output_ref,)))
+    return _program("where_matrix", inputs, outputs, operations), dtypes
+
+
+def _where_inputs(dtype: str, raw: bool, condition) -> list:
+    if raw:
+        true_payload, false_payload = _where_case(dtype)
+        return [
+            condition,
+            _raw_tensor(dtype, (4, 1), true_payload),
+            _raw_tensor(dtype, (4, 2), false_payload),
+        ]
+    true_values, false_values = _WHERE_HOST_CASES[dtype]
+    return [
+        condition,
+        HostTensor(dtype, (4, 1), true_values),
+        HostTensor(dtype, (4, 2), false_values),
+    ]
+
