+# ---------------------------------------------------------------------------
+# Native position-control plane (artifact payload 8).
+#
+# iota/compare/where are driven by the compact PXIO/PXCP/PXWH v1 descriptors
+# shared with the SVE256 control wire.  The descriptor is a pure schedule; the
+# C decoder is fail-closed on magic, version, reserved fields, rank,
+# shape/stride bounds and the FNV-1a descriptor tag before it touches data.
+# ---------------------------------------------------------------------------
+
+_POSITION_DTYPE_CODES = {
+    "float32": 0,
+    "bf16": 1,
+    "int32": 4,
+    "int64": 5,
+    "bool": 6,
+    "int8": 7,
+    "uint8": 8,
+    "int16": 9,
+    "uint16": 10,
+    "uint32": 11,
+    "uint64": 12,
+}
+_POSITION_ITEM_BYTES = {
+    "float32": 4,
+    "bf16": 2,
+    "bool": 1,
+    "int8": 1,
+    "uint8": 1,
+    "int16": 2,
+    "uint16": 2,
+    "int32": 4,
+    "uint32": 4,
+    "int64": 8,
+    "uint64": 8,
+}
+_POSITION_PREDICATE_CODES = {"eq": 0, "ne": 1, "lt": 2, "le": 3, "gt": 4, "ge": 5}
+_POSITION_KERNELS = {
+    "iota": "iota_control",
+    "compare": "compare_control",
+    "where": "where_control",
+}
+_POSITION_IOTA_HEADER = struct.Struct("<4s5IQqqQQ")
+_POSITION_COMPARE_HEADER = struct.Struct("<4s7I3Q")
+_POSITION_WHERE_HEADER = struct.Struct("<4s7I4Q")
+_U64_MAX = (1 << 64) - 1
+_I64_MAX = (1 << 63) - 1
+
+
+def _pack_u64_values(values: Sequence[int]) -> bytes:
+    if not values:
+        return b""
+    return struct.pack("<{}Q".format(len(values)), *[int(value) for value in values])
+
+
+def _position_descriptor_tag(descriptor: bytes) -> int:
+    """Match the native runner's little-endian FNV-1a descriptor tag."""
+
+    result = 1469598103934665603
+    for byte in descriptor:
+        result ^= byte
+        result = (result * 1099511628211) & 0xFFFFFFFFFFFFFFFF
+    return result
+
+
+def _position_iota_descriptor_bytes(contract: Mapping[str, Any]) -> bytes:
+    return _POSITION_IOTA_HEADER.pack(
+        b"PXIO",
+        1,
+        int(contract["axis"]),
+        int(contract["dtype_code"]),
+        0,
+        int(contract["rank"]),
+        int(contract["output_elements"]),
+        int(contract["start"]),
+        int(contract["step"]),
+        int(contract["inner_stride"]),
+        int(contract["dimension"]),
+    )
+
+
+def _position_compare_descriptor_bytes(contract: Mapping[str, Any]) -> bytes:
+    left, right = contract["sources"]
+    return (
+        _POSITION_COMPARE_HEADER.pack(
+            b"PXCP",
+            1,
+            int(contract["rank"]),
+            int(left["dtype_code"]),
+            int(right["dtype_code"]),
+            int(contract["predicate_code"]),
+            0,
+            0,
+            int(left["elements"]),
+            int(right["elements"]),
+            int(contract["output_elements"]),
+        )
+        + _pack_u64_values(left["strides"])
+        + _pack_u64_values(right["strides"])
+        + _pack_u64_values(contract["output_shape"])
+    )
+
+
+def _position_where_descriptor_bytes(contract: Mapping[str, Any]) -> bytes:
+    condition, input_source, other_source = contract["sources"]
+    return (
+        _POSITION_WHERE_HEADER.pack(
+            b"PXWH",
+            1,
+            int(contract["rank"]),
+            int(condition["dtype_code"]),
+            int(input_source["dtype_code"]),
+            int(input_source["dtype_code"]),
+            0,
+            0,
+            int(condition["elements"]),
+            int(input_source["elements"]),
+            int(other_source["elements"]),
+            int(contract["output_elements"]),
+        )
+        + _pack_u64_values(condition["strides"])
+        + _pack_u64_values(input_source["strides"])
+        + _pack_u64_values(other_source["strides"])
+        + _pack_u64_values(contract["output_shape"])
+    )
+
+
+def _position_descriptor_buffer(descriptor: bytes) -> Any:
+    buffer = (ctypes.c_ubyte * len(descriptor)).from_buffer_copy(descriptor)
+    return ctypes.cast(buffer, ctypes.c_void_p)
+
+
+def _position_sequence(value: Any, context: str) -> tuple:
+    if isinstance(value, (str, bytes, bytearray, Mapping)) or not isinstance(value, (list, tuple)):
+        raise CpuAvx512ArtifactError("{} must be a sequence".format(context))
+    return tuple(value)
+
+
+def _position_integer(
+    value: Any,
+    context: str,
+    *,
+    minimum: Optional[int] = 0,
+    maximum: Optional[int] = _U64_MAX,
+) -> int:
+    if isinstance(value, bool) or not isinstance(value, Integral):
+        raise CpuAvx512ArtifactError("{} must be an integer".format(context))
+    number = int(value)
+    if minimum is not None and number < minimum:
+        raise CpuAvx512ArtifactError("{} is below {}".format(context, minimum))
+    if maximum is not None and number > maximum:
+        raise CpuAvx512ArtifactError("{} is above {}".format(context, maximum))
+    return number
+
+
+def _position_source_entries(entry: Mapping[str, Any], kind: str, context: str) -> tuple:
+    sources = _position_sequence(entry.get("sources"), context + ".sources")
+    labels = {"compare": ("left", "right"), "where": ("condition", "input", "other")}.get(kind, ())
+    if len(sources) != len(labels):
+        raise CpuAvx512ArtifactError(
+            "{} native {} entry must declare {} sources".format(context, kind, len(labels))
+        )
+    normalized = []
+    for index, source in enumerate(sources):
+        if not isinstance(source, Mapping):
+            raise CpuAvx512ArtifactError("{}.sources[{}] must be a mapping".format(context, index))
+        label = source.get("label")
+        if label != labels[index]:
+            raise CpuAvx512ArtifactError(
+                "{}.sources[{}] label must be {!r}".format(context, index, labels[index])
+            )
+        dtype = source.get("dtype")
+        if dtype not in _POSITION_DTYPE_CODES:
+            raise CpuAvx512ArtifactError(
+                "{}.sources[{}] dtype {!r} is unsupported".format(context, index, dtype)
+            )
+        shape = _position_sequence(source.get("shape"), "{}.sources[{}].shape".format(context, index))
+        for axis, dimension in enumerate(shape):
+            _position_integer(dimension, "{}.sources[{}].shape[{}]".format(context, index, axis))
+        strides = _position_sequence(
+            source.get("strides"), "{}.sources[{}].strides".format(context, index)
+        )
+        for axis, stride in enumerate(strides):
+            _position_integer(
+                stride,
+                "{}.sources[{}].strides[{}]".format(context, index, axis),
+                maximum=_I64_MAX,
+            )
+        elements = _position_integer(
+            source.get("elements"), "{}.sources[{}].elements".format(context, index)
+        )
+        normalized.append(
+            {
+                "label": label,
+                "dtype": dtype,
+                "shape": tuple(int(dimension) for dimension in shape),
+                "strides": tuple(int(stride) for stride in strides),
+                "elements": elements,
+            }
+        )
+    return tuple(normalized)
+
+
+def _decode_position_control_metadata(metadata: Mapping[str, Any], context: str) -> None:
+    """Strictly decode the payload-8 position-control metadata.
+
+    A native payload must carry the versioned ``control_descriptor_wire``; a
+    legacy host_reference-only payload (payload 7 had no wire marker) is
+    rejected here even before the CoreProgram is re-lowered.  The per
+    operation native/fallback tables must be internally consistent so the
+    artifact can never advertise a native kernel the runtime would not call.
+    """
+
+    wire = metadata.get("control_descriptor_wire")
+    if wire is None:
+        raise CpuAvx512ArtifactError(
+            "{} payload {} position-control metadata has no control_descriptor_wire; "
+            "legacy host_reference payloads are rejected".format(context, ARTIFACT_PAYLOAD_VERSION)
+        )
+    if wire != CONTROL_DESCRIPTOR_WIRE:
+        raise CpuAvx512ArtifactError(
+            "{} position descriptor wire {!r} is unsupported (expected {!r})".format(
+                context, wire, CONTROL_DESCRIPTOR_WIRE
+            )
+        )
+    overall = metadata.get("position_control_fallback")
+    if overall not in POSITION_FALLBACK_MODES:
+        raise CpuAvx512ArtifactError(
+            "{} position_control_fallback {!r} is invalid".format(context, overall)
+        )
+    native_entries = _position_sequence(
+        metadata.get("position_control_native_operations"),
+        context + ".position_control_native_operations",
+    )
+    fallback_entries = _position_sequence(
+        metadata.get("position_control_fallback_operations"),
+        context + ".position_control_fallback_operations",
+    )
+    execution_modes = _position_sequence(metadata.get("execution_modes"), context + ".execution_modes")
+    modes_by_index: dict = {}
+    for item in execution_modes:
+        if not isinstance(item, Mapping):
+            raise CpuAvx512ArtifactError("{} execution_modes entry is invalid".format(context))
+        index = _position_integer(item.get("operation_index"), context + ".execution_modes.operation_index")
+        operation = item.get("operation")
+        if operation in POSITION_NATIVE_MODES or operation == "where":
+            modes_by_index[index] = item.get("mode")
+    for index, entry in enumerate(native_entries):
+        entry_context = "{}.position_control_native_operations[{}]".format(context, index)
+        if not isinstance(entry, Mapping):
+            raise CpuAvx512ArtifactError("{} must be a mapping".format(entry_context))
+        operation_index = _position_integer(entry.get("operation_index"), entry_context + ".operation_index")
+        kind = entry.get("kind")
+        if kind not in POSITION_NATIVE_MODES:
+            raise CpuAvx512ArtifactError("{} kind {!r} is unsupported".format(entry_context, kind))
+        if entry.get("operation") != kind:
+            raise CpuAvx512ArtifactError("{} operation must equal its kind".format(entry_context))
+        if entry.get("mode") != POSITION_NATIVE_MODES[kind]:
+            raise CpuAvx512ArtifactError("{} native mode is inconsistent".format(entry_context))
+        if entry.get("kernel") != _POSITION_KERNELS[kind]:
+            raise CpuAvx512ArtifactError("{} native kernel is inconsistent".format(entry_context))
+        if entry.get("dtype") not in _POSITION_DTYPE_CODES:
+            raise CpuAvx512ArtifactError("{} dtype is unsupported".format(entry_context))
+        rank = _position_integer(entry.get("rank"), entry_context + ".rank", maximum=POSITION_MAX_RANK)
+        _position_integer(entry.get("output_elements"), entry_context + ".output_elements")
+        sources = _position_source_entries(entry, kind, entry_context)
+        for source in sources:
+            if len(source["shape"]) > rank or len(source["strides"]) != rank:
+                raise CpuAvx512ArtifactError("{} source rank is inconsistent".format(entry_context))
+            if not source["shape"] and (
+                source["elements"] != 1 or any(source["strides"])
+            ):
+                raise CpuAvx512ArtifactError(
+                    "{} scalar source must declare one element and zero strides".format(entry_context)
+                )
+        if kind == "iota":
+            if sources:
+                raise CpuAvx512ArtifactError("{} iota must declare no sources".format(entry_context))
+            axis = _position_integer(entry.get("axis"), entry_context + ".axis", maximum=POSITION_MAX_RANK)
+            if rank == 0 or axis >= rank:
+                raise CpuAvx512ArtifactError("{} iota axis is outside rank".format(entry_context))
+            _position_integer(entry.get("start"), entry_context + ".start", minimum=-(1 << 63), maximum=_I64_MAX)
+            _position_integer(entry.get("step"), entry_context + ".step", minimum=-(1 << 63), maximum=_I64_MAX)
+            _position_integer(entry.get("inner_stride"), entry_context + ".inner_stride")
+            _position_integer(entry.get("dimension"), entry_context + ".dimension")
+            if entry.get("predicate") is not None:
+                raise CpuAvx512ArtifactError("{} iota must not declare a predicate".format(entry_context))
+        elif kind == "compare":
+            predicate = entry.get("predicate")
+            if predicate not in _POSITION_PREDICATE_CODES:
+                raise CpuAvx512ArtifactError("{} predicate {!r} is unsupported".format(entry_context, predicate))
+            if entry.get("dtype") != "bool":
+                raise CpuAvx512ArtifactError("{} compare output must be bool".format(entry_context))
+            if sources[0]["dtype"] != sources[1]["dtype"]:
+                raise CpuAvx512ArtifactError("{} compare input dtypes differ".format(entry_context))
+            if sources[0]["dtype"] == "bool" and predicate not in ("eq", "ne"):
+                raise CpuAvx512ArtifactError("{} ordered bool compare is unsupported".format(entry_context))
+        else:
+            predicate = entry.get("predicate")
+            if predicate is not None:
+                raise CpuAvx512ArtifactError("{} where must not declare a predicate".format(entry_context))
+            if sources[1]["dtype"] != sources[2]["dtype"]:
+                raise CpuAvx512ArtifactError("{} where value dtypes differ".format(entry_context))
+            if sources[1]["dtype"] != entry.get("dtype"):
+                raise CpuAvx512ArtifactError("{} where value dtype is inconsistent".format(entry_context))
+        declared_mode = modes_by_index.get(operation_index)
+        if declared_mode != entry.get("mode"):
+            raise CpuAvx512ArtifactError(
+                "{} execution mode {!r} does not match the native declaration".format(
+                    entry_context, declared_mode
+                )
+            )
+    for index, entry in enumerate(fallback_entries):
+        entry_context = "{}.position_control_fallback_operations[{}]".format(context, index)
+        if not isinstance(entry, Mapping):
+            raise CpuAvx512ArtifactError("{} must be a mapping".format(entry_context))
+        operation_index = _position_integer(entry.get("operation_index"), entry_context + ".operation_index")
+        kind = entry.get("kind")
+        if kind not in POSITION_NATIVE_MODES:
+            raise CpuAvx512ArtifactError("{} kind {!r} is unsupported".format(entry_context, kind))
+        if entry.get("operation") != kind:
+            raise CpuAvx512ArtifactError("{} operation must equal its kind".format(entry_context))
+        if entry.get("mode") != POSITION_FALLBACK_MODE:
+            raise CpuAvx512ArtifactError("{} fallback mode is inconsistent".format(entry_context))
+        if entry.get("dtype") is not None and entry.get("dtype") not in _POSITION_DTYPE_CODES:
+            raise CpuAvx512ArtifactError("{} dtype is unsupported".format(entry_context))
+        reason = entry.get("reason")
+        if not isinstance(reason, str) or not reason.strip():
+            raise CpuAvx512ArtifactError("{} fallback reason is missing".format(entry_context))
+        declared_mode = modes_by_index.get(operation_index)
+        if declared_mode != POSITION_FALLBACK_MODE:
+            raise CpuAvx512ArtifactError(
+                "{} execution mode {!r} does not match the fallback declaration".format(
+                    entry_context, declared_mode
+                )
+            )
+    native_names = tuple(entry.get("operation") for entry in native_entries)
+    declared_names = _position_sequence(
+        metadata.get("position_control_operations"),
+        context + ".position_control_operations",
+    )
+    if tuple(str(name) for name in declared_names) != native_names:
+        raise CpuAvx512ArtifactError(
+            "{} position_control_operations does not match the native table".format(context)
+        )
+    if overall == "not_applicable":
+        if native_entries or fallback_entries:
+            raise CpuAvx512ArtifactError("{} position_control_fallback is inconsistent".format(context))
+    elif overall == "native":
+        if fallback_entries or not native_entries:
+            raise CpuAvx512ArtifactError("{} position_control_fallback is inconsistent".format(context))
+    elif overall == "host_reference":
+        if native_entries or not fallback_entries:
+            raise CpuAvx512ArtifactError("{} position_control_fallback is inconsistent".format(context))
+    else:
+        if not native_entries or not fallback_entries:
+            raise CpuAvx512ArtifactError("{} position_control_fallback is inconsistent".format(context))
+
+
 def _call_copy(module: Any, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
     function = _safe_symbol(
         module,
@@ -1643,6 +2008,7 @@ def _validate_primary_semantics(artifact: Artifact, metadata: Mapping[str, Any])
