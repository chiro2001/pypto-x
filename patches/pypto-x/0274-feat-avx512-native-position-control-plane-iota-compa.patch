+#define PTX_POS_DTYPE_BF16 1U
+#define PTX_POS_DTYPE_I32 4U
+#define PTX_POS_DTYPE_I64 5U
+#define PTX_POS_DTYPE_BOOL 6U
+#define PTX_POS_DTYPE_I8 7U
+#define PTX_POS_DTYPE_U8 8U
+#define PTX_POS_DTYPE_I16 9U
+#define PTX_POS_DTYPE_U16 10U
+#define PTX_POS_DTYPE_U32 11U
