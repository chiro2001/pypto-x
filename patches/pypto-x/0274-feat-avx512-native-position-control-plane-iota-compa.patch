+def test_native_descriptor_kernels_reject_tampering(tmp_path):
+    runtime = _runtime()
+    left = ValueRef("left", CoreType.tensor("float32", (4,)))
+    right = ValueRef("right", CoreType.tensor("float32", (4,)))
+    condition = ValueRef("condition", CoreType.tensor("bool", (4,)))
+    outputs = (
+        ValueRef("iota_out", CoreType.tensor("int32", (4,))),
+        ValueRef("compare_out", CoreType.tensor("bool", (4,))),
+        ValueRef("where_out", CoreType.tensor("float32", (4,))),
+    )
+    program = _program(
+        "position_kernels",
+        (left, right, condition),
+        outputs,
+        (
+            Operation("iota", (), (outputs[0],), {"axis": 0}),
+            Operation("compare", (left, right), (outputs[1],), {"predicate": "lt"}),
+            Operation("where", (condition, left, right), (outputs[2],)),
+        ),
+    )
+    artifact = _compile_avx512(program, tmp_path / "kernels")
+    loaded = runtime.load(artifact)
+    module = loaded.module
+    function = next(
+        item for item in loaded.target_ir.program.functions
+        if item.name == loaded.target_ir.entrypoint
+    )
+    operations = function.body.operations
+    contracts = {}
+    for plan in loaded.target_ir.plans:
+        contract = position_native_contract(operations[plan.operation_index], plan)
+        if contract is not None:
+            contracts[contract["kind"]] = contract
+    assert tuple(sorted(contracts)) == ("compare", "iota", "where")
+
+    def descriptor_for(kind: str) -> bytes:
+        if kind == "iota":
+            return avx512_runtime._position_iota_descriptor_bytes(contracts["iota"])
+        if kind == "compare":
+            return avx512_runtime._position_compare_descriptor_bytes(contracts["compare"])
+        return avx512_runtime._position_where_descriptor_bytes(contracts["where"])
+
+    def call(kind: str, descriptor: bytes, tag: int, data: dict) -> int:
+        symbol = "ptx_avx512_{}".format(avx512_runtime._POSITION_KERNELS[kind])
+        if kind == "iota":
+            function = avx512_runtime._status_symbol(
+                module,
+                symbol,
+                [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint64, ctypes.c_void_p],
+            )
+            return int(
+                function(
+                    avx512_runtime._position_descriptor_buffer(descriptor),
+                    len(descriptor),
+                    tag,
+                    data["output"].pointer,
+                )
+            )
+        if kind == "compare":
+            function = avx512_runtime._status_symbol(
+                module,
+                symbol,
+                [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p],
+            )
+            return int(
+                function(
+                    avx512_runtime._position_descriptor_buffer(descriptor),
+                    len(descriptor),
+                    tag,
+                    data["left"].pointer,
+                    data["right"].pointer,
+                    data["output"].pointer,
+                )
+            )
+        function = avx512_runtime._status_symbol(
+            module,
+            symbol,
+            [
+                ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint64,
+                ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p,
+            ],
+        )
+        return int(
+            function(
+                avx512_runtime._position_descriptor_buffer(descriptor),
+                len(descriptor),
+                tag,
+                data["condition"].pointer,
+                data["true"].pointer,
+                data["false"].pointer,
+                data["output"].pointer,
+            )
+        )
+
+    buffers = {
+        "left": avx512_runtime._buffer_alloc("float32", 4, "left"),
+        "right": avx512_runtime._buffer_alloc("float32", 4, "right"),
+        "condition": avx512_runtime._buffer_alloc("bool", 4, "condition"),
+        "true": avx512_runtime._buffer_alloc("float32", 4, "true"),
+        "false": avx512_runtime._buffer_alloc("float32", 4, "false"),
+        "output": avx512_runtime._buffer_alloc("float32", 4, "output"),
+    }
+    for index in range(4):
+        buffers["left"].pointer[index] = 1.0
+        buffers["right"].pointer[index] = float(index)
+        buffers["condition"].pointer[index] = bool(index % 2)
+        buffers["true"].pointer[index] = 1.0
+        buffers["false"].pointer[index] = -1.0
+    for kind in contracts:
+        descriptor = descriptor_for(kind)
+        tag = avx512_runtime._position_descriptor_tag(descriptor)
+        assert call(kind, descriptor, tag, buffers) == 0, kind
+        reserved_offset = 16 if kind == "iota" else 24
+        reserved_tamper = (
+            descriptor[:reserved_offset]
+            + b"\x01\x00\x00\x00"
+            + descriptor[reserved_offset + 4:]
+        )
+        for label, tampered in (
+            ("magic", bytes([descriptor[0] ^ 0x01]) + descriptor[1:]),
+            ("version", descriptor[:4] + b"\x02\x00\x00\x00" + descriptor[8:]),
+            ("reserved", reserved_tamper),
+            ("tag", descriptor),
+            ("length", descriptor + b"\x00"),
+        ):
+            if label == "tag":
+                assert call(kind, tampered, tag ^ 1, buffers) != 0, (kind, label)
+            else:
+                tampered_tag = avx512_runtime._position_descriptor_tag(tampered)
+                assert call(kind, tampered, tampered_tag, buffers) != 0, (kind, label)
+
+
