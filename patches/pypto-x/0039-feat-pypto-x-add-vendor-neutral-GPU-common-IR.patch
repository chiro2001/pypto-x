diff --git a/python/pypto/compiler/targets/gpu.py b/python/pypto/compiler/targets/gpu.py
new file mode 100644
index 000000000..b4dec5e7e
--- /dev/null
+++ b/python/pypto/compiler/targets/gpu.py
@@ -0,0 +1,163 @@
+"""Deterministic compiler facade for the vendor-neutral GPU common IR."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any, Mapping, Optional
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram
+from pypto.lowering.gpu import (
+    GPU_COMMON_BACKEND,
+    GPU_IR_VERSION,
+    GPU_LOWERING_VERSION,
+    GPU_PLAN_VERSION,
+    GpuProgram,
+    lower_gpu_common,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_text
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+DEFAULT_ARTIFACT_FORMAT = "pypto-x.gpu.common"
+
+
+def _plain(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [_plain(item) for item in value]
+    if isinstance(value, list):
+        return [_plain(item) for item in value]
+    return value
+
+
+class GpuCommonCompiler:
+    """Lower CoreProgram and emit canonical JSON only.
+
+    No device code or vendor intrinsic is generated here.  The resulting
+    artifact is intentionally suitable as an input to later target-specific
+    compiler/runtime adapters.
+    """
+
+    name = GPU_COMMON_BACKEND
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> GpuProgram:
+        return lower_gpu_common(program, target)
+
+    def compile(self, target_ir: GpuProgram, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, GpuProgram):
+            raise TypeError("GPU common compile() requires GpuProgram from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        target_ir.validate()
+        program_json = target_ir.program.canonical_json()
+        program_payload = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        target_data = dict(target_ir.target.to_dict())
+        gpu_program = target_ir.to_dict()
+        plan_digest = target_ir.plan_digest
+        envelope = {
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "backend": GPU_COMMON_BACKEND,
+            "gpu_ir_version": GPU_IR_VERSION,
+            "lowering_version": GPU_LOWERING_VERSION,
+            "plan_version": GPU_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "target": target_data,
+            "program": program_payload,
+            "program_digest": program_digest,
+            "gpu_program": gpu_program,
+            "plan_digest": plan_digest,
+        }
+        if options is not None:
+            envelope["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "metadata": _plain(options.metadata),
+                "extra": _plain(options.extra),
+            }
+        payload = json.dumps(
+            envelope,
+            ensure_ascii=False,
+            allow_nan=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        ).encode("utf-8")
+        payload_digest = hashlib.sha256(payload).hexdigest()
+        dtypes = sorted(set(plan.dtype for plan in target_ir.plans))
+        layouts = sorted(set(plan.layout for plan in target_ir.plans))
+        geometry = [plan.geometry.to_dict() for plan in target_ir.plans]
+        metadata = {
+            "backend": GPU_COMMON_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "gpu_ir_version": GPU_IR_VERSION,
+            "lowering_version": GPU_LOWERING_VERSION,
+            "plan_version": GPU_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "program_digest": program_digest,
+            "plan_digest": plan_digest,
+            "payload_digest": payload_digest,
+            "target_digest": sha256_text(target_data),
+            "required_capabilities": list(target_ir.required_capabilities),
+            "geometry": geometry,
+            "specialization": mapping_copy(target_ir.specialization),
+            "dtypes": dtypes,
+            "layouts": layouts,
+        }
+        if options is not None:
+            option_metadata = _plain(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError(
+                    "compile option metadata uses reserved GPU common keys: {}".format(
+                        ", ".join(sorted(reserved))
+                    )
+                )
+            metadata.update(option_metadata)
+            metadata["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "extra": _plain(options.extra),
+            }
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            payload=payload,
+            metadata=metadata,
+        )
+        artifact.validate()
+        return artifact
+
+
+GpuCompiler = GpuCommonCompiler
+GPUCommonCompiler = GpuCommonCompiler
+
+
+def compile_gpu_common(
+    program: CoreProgram,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None,
+) -> Artifact:
+    compiler = GpuCommonCompiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION",
+    "DEFAULT_ARTIFACT_FORMAT",
+    "GPUCommonCompiler",
+    "GpuCommonCompiler",
+    "GpuCompiler",
+    "compile_gpu_common",
+]
