diff --git a/python/pypto/lowering/gpu/plan.py b/python/pypto/lowering/gpu/plan.py
new file mode 100644
index 000000000..98c0671c2
--- /dev/null
+++ b/python/pypto/lowering/gpu/plan.py
@@ -0,0 +1,963 @@
+"""Vendor-neutral GPU execution plans for PyPTO-X.
+
+The objects in this module describe logical coverage only.  They intentionally
+do not contain an instruction name, a register model, or a vendor launch
+handle.  A CUDA- or HIP-specific lowering can consume the same immutable
+``GpuProgram`` and choose its own final code generation details.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import math
+import re
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi.gpu import (
+    AddressSpace,
+    GridDim,
+    LaunchGeometry,
+    MemoryBarrier,
+    MemoryScope,
+    WorkgroupDim,
+)
+from pypto.core_ir import CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import (
+    CpuScalarError,
+    CpuScalarUnsupportedError,
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    reduced_shape,
+    static_shape,
+    validate_program,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import canonical_json, frozen_mapping, mapping_copy, sha256_text
+
+
+GPU_PLAN_VERSION = 1
+GPU_LOWERING_VERSION = 1
+GPU_COMMON_BACKEND = "gpu.common"
+GPU_IR_VERSION = "gpu.ir.v1"
+GPU_SUPPORTED_DTYPES = frozenset(("float32", "bf16"))
+GPU_SUPPORTED_OPERATIONS = frozenset(
+    ("constant", "identity", "add", "sub", "mul", "div", "neg", "reduce_sum", "reduce_max", "matmul")
+)
+MAX_LOGICAL_INDEX = (1 << 64) - 1
+_SSA_NAME_RE = re.compile(r"^(?:%[A-Za-z0-9_.$-]+|[A-Za-z_][A-Za-z0-9_.$-]*)$")
+_VENDOR_TERMS = ("cuda", "hip", "nvvm", "ptx", "amdgpu", "rocdl", "warp", "wavefront", "wmma", "mfma")
+
+
+class GpuError(ValueError):
+    """Base error for the vendor-neutral GPU common contract."""
+
+
+class GpuValidationError(GpuError):
+    """Malformed Core IR, target, geometry, or plan data."""
+
+
+class GpuUnsupportedError(GpuError):
+    """A valid Core IR feature outside the first common GPU subset."""
+
+
+def _positive_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+        raise GpuValidationError("{} must be a positive integer".format(field))
+    if value > MAX_LOGICAL_INDEX:
+        raise GpuValidationError("{} exceeds the 64-bit logical index range".format(field))
+    return value
+
+
+def _non_negative_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise GpuValidationError("{} must be a non-negative integer".format(field))
+    if value > MAX_LOGICAL_INDEX:
+        raise GpuValidationError("{} exceeds the 64-bit logical index range".format(field))
+    return value
+
+
+def _product(values: Sequence[int], field: str = "value") -> int:
+    result = 1
+    for index, value in enumerate(values):
+        result *= value
+        if result > MAX_LOGICAL_INDEX:
+            raise GpuValidationError(
+                "{} product exceeds the 64-bit logical index range at axis {}".format(field, index)
+            )
+    return result
+
+
+def _shape(value: Sequence[Any], field: str) -> Tuple[int, ...]:
+    if isinstance(value, (str, bytes)):
+        raise GpuValidationError("{} must be a sequence of non-negative integers".format(field))
+    try:
+        result = tuple(value)
+    except TypeError as exc:
+        raise GpuValidationError("{} must be a sequence of non-negative integers".format(field)) from exc
+    for index, item in enumerate(result):
+        if isinstance(item, bool) or not isinstance(item, int) or item < 0:
+            raise GpuValidationError("{}[{}] must be a non-negative integer".format(field, index))
+    _product(result, field)
+    return result
+
+
+def _ssa(value: Any, field: str) -> str:
+    if not isinstance(value, str) or not _SSA_NAME_RE.fullmatch(value):
+        raise GpuValidationError("{} must be a stable SSA name".format(field))
+    return value
+
+
+def _names(value: Any, field: str) -> Tuple[str, ...]:
+    if value is None:
+        return ()
+    if isinstance(value, str):
+        value = (value,)
+    try:
+        values = tuple(value)
+    except TypeError as exc:
+        raise GpuValidationError("{} must be a string or sequence of strings".format(field)) from exc
+    result = []
+    seen = set()
+    for item in values:
+        if not isinstance(item, str) or not item.strip():
+            raise GpuValidationError("{} must contain non-empty strings".format(field))
+        item = item.strip().lower()
+        if item not in seen:
+            result.append(item)
+            seen.add(item)
+    return tuple(sorted(result))
+
+
+def _reject_vendor_terms(value: Any, context: str = "value") -> None:
+    """Keep vendor entities out of common serialized structures."""
+
+    if isinstance(value, str):
+        lowered = value.lower()
+        for term in _VENDOR_TERMS:
+            if term in lowered:
+                raise GpuValidationError("{} contains a vendor-specific GPU term".format(context))
+        return
+    if isinstance(value, Mapping):
+        for key, item in value.items():
+            _reject_vendor_terms(key, "{}.key".format(context))
+            _reject_vendor_terms(item, "{}.{}".format(context, key))
+        return
+    if isinstance(value, (list, tuple, set, frozenset)):
+        for index, item in enumerate(value):
+            _reject_vendor_terms(item, "{}[{}]".format(context, index))
+
+
+def _layout(program: CoreProgram, operation: Operation, refs: Sequence[Any], context: str) -> str:
+    """Reject views, symbolic dimensions, and non-contiguous layouts."""
+
+    raw = operation.attributes.get("layout")
+    if operation.attributes.get("contiguous") is False or operation.attributes.get("is_contiguous") is False:
+        raise GpuUnsupportedError("{} declares a non-contiguous layout".format(context))
+    if isinstance(raw, str):
+        if raw.strip().lower().replace("-", "_") not in ("contiguous", "row_major", "row_major_contiguous", "c"):
+            raise GpuUnsupportedError("{} layout is unsupported".format(context))
+    elif raw is not None and not isinstance(raw, Mapping):
+        raise GpuValidationError("{} layout must be a string or mapping".format(context))
+    if isinstance(raw, Mapping):
+        kind = str(raw.get("kind", raw.get("layout", "row_major_contiguous"))).lower().replace("-", "_")
+        if kind not in ("contiguous", "row_major", "row_major_contiguous", "c"):
+            raise GpuUnsupportedError("{} layout is unsupported".format(context))
+        strides = raw.get("strides")
+        if strides is not None:
+            for index, stride in enumerate(tuple(strides)):
+                if isinstance(stride, bool) or not isinstance(stride, int) or stride < 0:
+                    raise GpuValidationError("{} layout stride {} is invalid".format(context, index))
+            for ref in refs:
+                if ref.type.kind in ("tensor", "view", "tile"):
+                    shape = static_shape(ref.type, context)
+                    expected = _contiguous_strides(shape)
+                    if tuple(strides) != expected:
+                        raise GpuUnsupportedError("{} has non-contiguous strides".format(context))
+    layouts = program.metadata.get("layouts", {})
+    if layouts is not None and not isinstance(layouts, Mapping):
+        raise GpuValidationError("program metadata layouts must be a mapping")
+    for ref in refs:
+        if ref.type.kind == "view":
+            raise GpuUnsupportedError("{} value {!r} is a non-portable view".format(context, ref.name))
+        if ref.type.kind in ("tensor", "view", "tile") and isinstance(layouts, Mapping) and ref.name in layouts:
+            selected = layouts[ref.name]
+            if isinstance(selected, Mapping) and (
+                selected.get("contiguous") is False or selected.get("is_contiguous") is False
+            ):
+                raise GpuUnsupportedError("{} value {!r} is non-contiguous".format(context, ref.name))
+            if isinstance(selected, Mapping) and selected.get("strides") is not None:
+                shape = static_shape(ref.type, context)
+                if tuple(selected["strides"]) != _contiguous_strides(shape):
+                    raise GpuUnsupportedError("{} value {!r} has non-contiguous strides".format(context, ref.name))
+    return "row_major_contiguous"
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _normalise_axes(attributes: Mapping[str, Any], rank: int, context: str) -> Tuple[int, ...]:
+    raw = attributes.get("axes", attributes.get("axis"))
+    if raw is None:
+        raw = tuple(range(rank))
+    elif isinstance(raw, int) and not isinstance(raw, bool):
+        raw = (raw,)
+    elif isinstance(raw, (str, bytes)):
+        raise GpuValidationError("{} axes must be an integer or sequence".format(context))
+    try:
+        axes = tuple(raw)
+    except TypeError as exc:
+        raise GpuValidationError("{} axes must be an integer or sequence".format(context)) from exc
+    normalized = []
+    for axis in axes:
+        if isinstance(axis, bool) or not isinstance(axis, int):
+            raise GpuValidationError("{} axes must contain integers".format(context))
+        axis = axis + rank if axis < 0 else axis
+        if axis < 0 or axis >= rank:
+            raise GpuValidationError("{} axis is outside rank".format(context))
+        if axis in normalized:
+            raise GpuValidationError("{} axes contain a duplicate".format(context))
+        normalized.append(axis)
+    return tuple(sorted(normalized))
+
+
+def _ceildiv(left: int, right: int) -> int:
+    return (left + right - 1) // right if left else 1
+
+
+def _target_mapping(target: TargetSpec, key: str, default: Any) -> Any:
+    value = target.attributes.get(key, default)
+    if isinstance(value, Mapping):
+        value = value.get("values", value.get("dims", value.get("size", default)))
+    return value
+
+
+def _target_workgroup(target: TargetSpec) -> Any:
+    return target.attributes.get(
+        "workgroup",
+        target.attributes.get("workgroup_size", target.attributes.get("block_dim")),
+    )
+
+
+def _dims(value: Any, field: str, default: Sequence[int]) -> Tuple[int, int, int]:
+    if value is None:
+        value = default
+    if isinstance(value, Mapping):
+        if "dims" in value or "values" in value or "size" in value:
+            value = value.get("dims", value.get("values", value.get("size")))
+        else:
+            value = tuple(value.get(axis, 1) for axis in ("x", "y", "z"))
+    if isinstance(value, int) and not isinstance(value, bool):
+        value = (value,)
+    try:
+        values = tuple(value)
+    except TypeError as exc:
+        raise GpuValidationError("{} must be a 1-3D integer sequence".format(field)) from exc
+    if not 1 <= len(values) <= 3:
+        raise GpuValidationError("{} must have between 1 and 3 dimensions".format(field))
+    values = tuple(_positive_int(item, "{}[{}]".format(field, index)) for index, item in enumerate(values))
+    return values + (1,) * (3 - len(values))
+
+
+def _target_geometry(
+    target: TargetSpec,
+    *,
+    grid: Sequence[int],
+    workgroup: Optional[Sequence[int]] = None,
+    subgroup_size: Optional[int] = None,
+    dynamic_workgroup_memory_bytes: Optional[int] = None,
+) -> LaunchGeometry:
+    if workgroup is None:
+        workgroup = target.attributes.get(
+            "workgroup",
+            target.attributes.get("workgroup_size", target.attributes.get("block_dim")),
+        )
+    wg = _dims(
+        workgroup,
+        "workgroup",
+        (128,),
+    )
+    selected_subgroup = subgroup_size
+    if selected_subgroup is None:
+        selected_subgroup = target.attributes.get("subgroup_size")
+    if selected_subgroup is not None:
+        selected_subgroup = _positive_int(selected_subgroup, "subgroup_size")
+        supported = target.attributes.get("supported_subgroup_sizes", target.attributes.get("subgroup_sizes"))
+        if supported is not None:
+            supported = tuple(supported) if not isinstance(supported, int) else (supported,)
+            if selected_subgroup not in supported:
+                raise GpuUnsupportedError("subgroup_size is not in target capability set")
+    if dynamic_workgroup_memory_bytes is None:
+        dynamic_workgroup_memory_bytes = target.attributes.get("dynamic_workgroup_memory_bytes", 0)
+    geometry = LaunchGeometry(
+        GridDim(_dims(grid, "grid", (1,))),
+        WorkgroupDim(wg),
+        selected_subgroup,
+        dynamic_workgroup_memory_bytes,
+    )
+    geometry.validate()
+    return geometry
+
+
+@dataclass(frozen=True)
+class BoundsPredicate:
+    """A checked logical bounds predicate for one operation plan."""
+
+    kind: str
+    logical_shape: Tuple[int, ...]
+    predicate: str
+    index_width: int = 64
+
+    def __post_init__(self) -> None:
+        if self.kind not in ("flat", "matrix"):
+            raise GpuValidationError("unknown bounds predicate kind {!r}".format(self.kind))
+        object.__setattr__(self, "logical_shape", _shape(self.logical_shape, "bounds.logical_shape"))
+        if self.index_width != 64:
+            raise GpuValidationError("GPU logical indices must be 64-bit")
+        if not isinstance(self.predicate, str) or not self.predicate.strip():
+            raise GpuValidationError("bounds predicate must be non-empty")
+
+    @property
+    def element_count(self) -> int:
+        return _product(self.logical_shape, "bounds.logical_shape")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "kind": self.kind,
+            "logical_shape": list(self.logical_shape),
+            "index_width": self.index_width,
+            "predicate": self.predicate,
+        }
+
+
+@dataclass(frozen=True)
+class TilePlan:
+    """Logical output/reduction tile sizes; no matrix instruction semantics."""
+
+    output: Tuple[int, ...]
+    reduction: Tuple[int, ...]
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "output", tuple(_positive_int(value, "tile.output") for value in self.output))
+        object.__setattr__(self, "reduction", tuple(_positive_int(value, "tile.reduction") for value in self.reduction))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"output": list(self.output), "reduction": list(self.reduction)}
+
+
+@dataclass(frozen=True)
+class ReductionPlan:
+    input_shape: Tuple[int, ...]
+    output_shape: Tuple[int, ...]
+    axes: Tuple[int, ...]
+    keepdims: bool
+    reduction_size: int
+    output_elements: int
+    reduction_tile: int
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "input_shape", _shape(self.input_shape, "reduction.input_shape"))
+        object.__setattr__(self, "output_shape", _shape(self.output_shape, "reduction.output_shape"))
+        if tuple(sorted(self.axes)) != tuple(self.axes) or len(set(self.axes)) != len(self.axes):
+            raise GpuValidationError("reduction axes must be sorted and unique")
+        if any(axis < 0 or axis >= len(self.input_shape) for axis in self.axes):
+            raise GpuValidationError("reduction axis is outside input rank")
+        if not isinstance(self.keepdims, bool):
+            raise GpuValidationError("reduction keepdims must be bool")
+        expected = _product(tuple(self.input_shape[axis] for axis in self.axes), "reduction")
+        if self.reduction_size != expected:
+            raise GpuValidationError("reduction_size does not match reduction axes")
+        if self.output_elements != _product(self.output_shape, "reduction.output_shape"):
+            raise GpuValidationError("output_elements does not match reduction output shape")
+        _positive_int(self.reduction_tile, "reduction.reduction_tile")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "input_shape": list(self.input_shape),
+            "output_shape": list(self.output_shape),
+            "axes": list(self.axes),
+            "keepdims": self.keepdims,
+            "reduction_size": self.reduction_size,
+            "output_elements": self.output_elements,
+            "reduction_tile": self.reduction_tile,
+        }
+
+
+@dataclass(frozen=True)
+class MatmulPlan:
+    m: int
+    k: int
+    n: int
+    output_shape: Tuple[int, int]
+    output_elements: int
+    tile: TilePlan
+
+    def __post_init__(self) -> None:
+        _non_negative_int(self.m, "matmul.m")
+        _non_negative_int(self.k, "matmul.k")
+        _non_negative_int(self.n, "matmul.n")
+        if self.output_shape != (self.m, self.n):
+            raise GpuValidationError("matmul output shape must be (m, n)")
+        if self.output_elements != self.m * self.n:
+            raise GpuValidationError("matmul output element count does not match m*n")
+        if not isinstance(self.tile, TilePlan):
+            raise GpuValidationError("matmul tile must be TilePlan")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "m": self.m,
+            "k": self.k,
+            "n": self.n,
+            "output_shape": list(self.output_shape),
+            "output_elements": self.output_elements,
+            "tile": self.tile.to_dict(),
+        }
+
+
+def _storage_for(operation: str, inputs: Sequence[Any], output: Any) -> Mapping[str, str]:
+    result = {ref.name: AddressSpace.GLOBAL.value for ref in inputs if ref.type.kind in ("tensor", "view", "tile")}
+    if output.type.kind in ("tensor", "view", "tile"):
+        result[output.name] = AddressSpace.GLOBAL.value
+    if operation in ("reduce_sum", "reduce_max", "matmul"):
+        result["accumulator"] = AddressSpace.PRIVATE.value
+    return result
+
+
+@dataclass(frozen=True, init=False)
+class GpuKernelPlan:
+    plan_version: int
+    operation: str
+    plan_kind: str
+    operation_index: int
+    input_names: Tuple[str, ...]
+    output_name: str
+    dtype: str
+    shape: Tuple[int, ...]
+    layout: str
+    geometry: LaunchGeometry
+    bounds: BoundsPredicate
+    storage: Mapping[str, str]
+    memory_scope: MemoryScope
+    tile: TilePlan
+    reduction: Optional[ReductionPlan]
+    matmul: Optional[MatmulPlan]
+    required_capabilities: Tuple[str, ...]
+    specialization: Mapping[str, Any]
+    barriers: Tuple[MemoryBarrier, ...]
+
+    def __init__(
+        self,
+        plan_version: int,
+        operation: str,
+        plan_kind: str,
+        operation_index: int,
+        input_names: Sequence[str],
+        output_name: str,
+        dtype: str,
+        shape: Sequence[int],
+        layout: str,
+        geometry: LaunchGeometry,
+        bounds: BoundsPredicate,
+        storage: Mapping[str, str],
+        memory_scope: Any = MemoryScope.WORKGROUP,
+        tile: Optional[TilePlan] = None,
+        reduction: Optional[ReductionPlan] = None,
+        matmul: Optional[MatmulPlan] = None,
+        required_capabilities: Any = (),
+        specialization: Optional[Mapping[str, Any]] = None,
+        barriers: Any = (),
+    ):
+        if plan_version != GPU_PLAN_VERSION:
+            raise GpuValidationError("unsupported GPU plan version {!r}".format(plan_version))
+        if not isinstance(operation, str) or not operation.strip():
+            raise GpuValidationError("plan operation must be non-empty")
+        if plan_kind not in ("elementwise", "reduction", "matmul"):
+            raise GpuValidationError("unknown GPU plan kind {!r}".format(plan_kind))
+        if isinstance(operation_index, bool) or not isinstance(operation_index, int) or operation_index < 0:
+            raise GpuValidationError("operation_index must be non-negative")
+        inputs = tuple(_ssa(value, "plan.input_names[{}]".format(index)) for index, value in enumerate(input_names))
+        output = _ssa(output_name, "plan.output_name")
+        dtype = canonical_dtype(dtype)
+        if dtype not in GPU_SUPPORTED_DTYPES:
+            raise GpuUnsupportedError("GPU common supports only float32 and bf16")
+        shape = _shape(shape, "plan.shape")
+        if not isinstance(layout, str) or not layout.strip():
+            raise GpuValidationError("plan.layout must be non-empty")
+        if not isinstance(geometry, LaunchGeometry):
+            raise GpuValidationError("plan.geometry must be LaunchGeometry")
+        geometry.validate()
+        if not isinstance(bounds, BoundsPredicate):
+            raise GpuValidationError("plan.bounds must be BoundsPredicate")
+        if bounds.element_count != _product(shape, "plan.shape"):
+            raise GpuValidationError("bounds logical domain does not match plan shape")
+        if not isinstance(storage, Mapping):
+            raise GpuValidationError("plan.storage must be a mapping")
+        normalized_storage = {}
+        for name, space in storage.items():
+            if not isinstance(name, str) or not isinstance(space, str):
+                raise GpuValidationError("plan.storage names and spaces must be strings")
+            try:
+                normalized_storage[name] = AddressSpace(space).value
+            except ValueError as exc:
+                raise GpuValidationError("unknown GPU address space {!r}".format(space)) from exc
+        if not isinstance(memory_scope, MemoryScope):
+            try:
+                memory_scope = MemoryScope(str(memory_scope).lower())
+            except ValueError as exc:
+                raise GpuValidationError("unknown GPU memory scope") from exc
+        tile = TilePlan((1,), (1,)) if tile is None else tile
+        if not isinstance(tile, TilePlan):
+            raise GpuValidationError("plan.tile must be TilePlan")
+        capabilities = _names(required_capabilities, "required_capabilities")
+        normalized_specialization = frozen_mapping(specialization)
+        if barriers is None:
+            barriers = ()
+        try:
+            normalized_barriers = tuple(barriers)
+        except TypeError as exc:
+            raise GpuValidationError("plan.barriers must be a sequence") from exc
+        if any(not isinstance(barrier, MemoryBarrier) for barrier in normalized_barriers):
+            raise GpuValidationError("plan.barriers must contain MemoryBarrier values")
+        _reject_vendor_terms(
+            {
+                "operation": operation,
+                "plan_kind": plan_kind,
+                "storage": normalized_storage,
+                "required_capabilities": capabilities,
+                "specialization": mapping_copy(normalized_specialization),
+            },
+            "gpu plan",
+        )
+        if plan_kind == "reduction" and reduction is None:
+            raise GpuValidationError("reduction plan kind requires reduction details")
+        if plan_kind == "matmul" and matmul is None:
+            raise GpuValidationError("matmul plan kind requires matmul details")
+        if plan_kind == "elementwise" and (reduction is not None or matmul is not None):
+            raise GpuValidationError("elementwise plan cannot carry reduction/matmul details")
+        object.__setattr__(self, "plan_version", plan_version)
+        object.__setattr__(self, "operation", operation.strip())
+        object.__setattr__(self, "plan_kind", plan_kind)
+        object.__setattr__(self, "operation_index", operation_index)
+        object.__setattr__(self, "input_names", inputs)
+        object.__setattr__(self, "output_name", output)
+        object.__setattr__(self, "dtype", dtype)
+        object.__setattr__(self, "shape", shape)
+        object.__setattr__(self, "layout", layout.strip().lower())
+        object.__setattr__(self, "geometry", geometry)
+        object.__setattr__(self, "bounds", bounds)
+        object.__setattr__(self, "storage", frozen_mapping(normalized_storage))
+        object.__setattr__(self, "memory_scope", memory_scope)
+        object.__setattr__(self, "tile", tile)
+        object.__setattr__(self, "reduction", reduction)
+        object.__setattr__(self, "matmul", matmul)
+        object.__setattr__(self, "required_capabilities", capabilities)
+        object.__setattr__(self, "specialization", normalized_specialization)
+        object.__setattr__(self, "barriers", normalized_barriers)
+
+    @property
+    def kind(self) -> str:
+        return self.plan_kind
+
+    @property
+    def output_shape(self) -> Tuple[int, ...]:
+        return self.shape
+
+    @property
+    def launch_geometry(self) -> LaunchGeometry:
+        return self.geometry
+
+    @property
+    def grid(self) -> GridDim:
+        return self.geometry.grid
+
+    @property
+    def workgroup(self) -> WorkgroupDim:
+        return self.geometry.workgroup
+
+    @property
+    def subgroup_size(self) -> Optional[int]:
+        return self.geometry.subgroup_size
+
+    @property
+    def bounds_predicate(self) -> BoundsPredicate:
+        return self.bounds
+
+    @property
+    def address_spaces(self) -> Mapping[str, str]:
+        return self.storage
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "plan_version": self.plan_version,
+            "operation": self.operation,
+            "plan_kind": self.plan_kind,
+            "operation_index": self.operation_index,
+            "input_names": list(self.input_names),
+            "output_name": self.output_name,
+            "dtype": self.dtype,
+            "shape": list(self.shape),
+            "layout": self.layout,
+            "geometry": self.geometry.to_dict(),
+            "bounds": self.bounds.to_dict(),
+            "storage": mapping_copy(self.storage),
+            "memory_scope": self.memory_scope.value,
+            "tile": self.tile.to_dict(),
+            "reduction": None if self.reduction is None else self.reduction.to_dict(),
+            "matmul": None if self.matmul is None else self.matmul.to_dict(),
+            "required_capabilities": list(self.required_capabilities),
+            "specialization": mapping_copy(self.specialization),
+            "barriers": [barrier.to_dict() for barrier in self.barriers],
+        }
+
+    def canonical_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+    dumps = canonical_json
+    to_json = canonical_json
+
+    @property
+    def fingerprint(self) -> str:
+        return sha256_text(self.to_dict())
+
+
+GpuPlan = GpuKernelPlan
+
+
+def _target_capabilities(target: TargetSpec) -> Tuple[str, ...]:
+    raw = target.attributes.get("required_capabilities", target.attributes.get("capabilities", ()))
+    if target.features:
+        raw = tuple(target.features) + (tuple(raw) if not isinstance(raw, str) else (raw,))
+    return _names(raw, "target capabilities")
+
+
+def _target_specialization(target: TargetSpec, specialization: Optional[Mapping[str, Any]]) -> Mapping[str, Any]:
+    value = specialization if specialization is not None else target.attributes.get("specialization", {})
+    if not isinstance(value, Mapping):
+        raise GpuValidationError("specialization must be a mapping")
+    _reject_vendor_terms(value, "specialization")
+    return frozen_mapping(value)
+
+
+def _tile_from_target(target: TargetSpec, operation: str, attrs: Mapping[str, Any]) -> TilePlan:
+    raw = attrs.get("tile", target.attributes.get("tile"))
+    if isinstance(raw, Mapping):
+        output = raw.get("output", raw.get("output_tile", (8, 8) if operation == "matmul" else (128,)))
+        reduction = raw.get("reduction", raw.get("reduction_tile", (8,)))
+    elif raw is None:
+        output = (8, 8) if operation == "matmul" else (128,)
+        reduction = (8,)
+    else:
+        output = raw
+        reduction = (8,)
+    if isinstance(output, int) and not isinstance(output, bool):
+        output = (output,)
+    if isinstance(reduction, int) and not isinstance(reduction, bool):
+        reduction = (reduction,)
+    try:
+        output = tuple(output)
+        reduction = tuple(reduction)
+    except TypeError as exc:
+        raise GpuValidationError("tile output/reduction must be integer sequences") from exc
+    return TilePlan(output, reduction)
+
+
+def _make_plan_for_operation(
+    program: CoreProgram,
+    target: TargetSpec,
+    operation: Operation,
+    operation_index: int,
+    required_capabilities: Tuple[str, ...],
+    specialization: Mapping[str, Any],
+) -> GpuKernelPlan:
+    name = canonical_operation_name(operation.name)
+    if len(operation.outputs) != 1:
+        raise GpuValidationError("operation {} must have exactly one output".format(operation_index))
+    output = operation.outputs[0]
+    output_type = output.type
+    if output_type.kind not in ("tensor", "view", "tile", "scalar"):
+        raise GpuUnsupportedError("GPU common requires tensor or scalar outputs")
+    output_shape = static_shape(output_type, "GPU operation output") if output_type.kind != "scalar" else ()
+    refs = tuple(operation.inputs) + (output,)
+    layout = _layout(program, operation, refs, "function operation {}".format(operation_index))
+    dtype = canonical_dtype(output_type.dtype)
+    if dtype not in GPU_SUPPORTED_DTYPES:
+        raise GpuUnsupportedError("GPU common supports only float32 and bf16")
+    for ref in operation.inputs:
+        if ref.type.kind in ("tensor", "view", "tile") and canonical_dtype(ref.type.dtype) not in GPU_SUPPORTED_DTYPES:
+            raise GpuUnsupportedError("GPU common supports only float32 and bf16")
+    count = _product(output_shape, "output_shape")
+    tile = _tile_from_target(target, name, operation.attributes)
+    reduction = None
+    matmul = None
+    if name in ("reduce_sum", "reduce_max"):
+        if output_type.kind != "tensor":
+            raise GpuUnsupportedError("GPU reductions require tensor outputs")
+        input_shape = static_shape(operation.inputs[0].type, "GPU reduction input")
+        axes = _normalise_axes(operation.attributes, len(input_shape), "GPU reduction")
+        expected_shape = reduced_shape(input_shape, operation.attributes, "GPU reduction")
+        if output_shape != expected_shape:
+            raise GpuValidationError("GPU reduction output shape does not match input axes")
+        reduction_size = _product(tuple(input_shape[axis] for axis in axes), "reduction")
+        workgroup_hint = _dims(_target_workgroup(target), "workgroup", (128,))[0]
+        reduction = ReductionPlan(
+            input_shape,
+            output_shape,
+            axes,
+            bool(operation.attributes.get("keepdims", False)),
+            reduction_size,
+            count,
+            min(workgroup_hint, max(1, reduction_size)),
+        )
+        geometry = _target_geometry(target, grid=(_ceildiv(count, workgroup_hint), 1, 1))
+        bounds = BoundsPredicate("flat", output_shape, "logical_index < {}".format(count))
+        kind = "reduction"
+    elif name == "matmul":
+        if output_type.kind != "tensor":
+            raise GpuUnsupportedError("GPU matmul requires tensor outputs")
+        left_shape = static_shape(operation.inputs[0].type, "GPU matmul left")
+        right_shape = static_shape(operation.inputs[1].type, "GPU matmul right")
+        if len(left_shape) != 2 or len(right_shape) != 2 or len(output_shape) != 2:
+            raise GpuValidationError("GPU matmul requires rank-2 values")
+        m, k = left_shape
+        right_k, n = right_shape
+        if right_k != k or output_shape != (m, n):
+            raise GpuValidationError("GPU matmul shapes are inconsistent")
+        tile_m = tile.output[0]
+        tile_n = tile.output[1] if len(tile.output) > 1 else tile.output[0]
+        tile = TilePlan((tile_m, tile_n), tile.reduction)
+        geometry = _target_geometry(
+            target,
+            grid=(_ceildiv(n, tile_n), _ceildiv(m, tile_m), 1),
+            workgroup=operation.attributes.get("workgroup", _target_workgroup(target) or (tile_m, tile_n)),
+        )
+        bounds = BoundsPredicate("matrix", output_shape, "row < {} and column < {}".format(m, n))
+        matmul = MatmulPlan(m, k, n, (m, n), count, tile)
+        kind = "matmul"
+    else:
+        workgroup_hint = _dims(_target_workgroup(target), "workgroup", (128,))[0]
+        geometry = _target_geometry(target, grid=(_ceildiv(count, workgroup_hint), 1, 1))
+        bounds = BoundsPredicate("flat", output_shape, "logical_index < {}".format(count))
+        kind = "elementwise"
+    return GpuKernelPlan(
+        GPU_PLAN_VERSION,
+        name,
+        kind,
+        operation_index,
+        tuple(ref.name for ref in operation.inputs),
+        output.name,
+        dtype,
+        output_shape,
+        layout,
+        geometry,
+        bounds,
+        _storage_for(name, operation.inputs, output),
+        MemoryScope.WORKGROUP,
+        tile,
+        reduction,
+        matmul,
+        required_capabilities,
+        specialization,
+    )
+
+
+@dataclass(frozen=True, init=False)
+class GpuProgram:
+    """Validated GPU common target IR containing one plan per operation."""
+
+    program: CoreProgram
+    target: TargetSpec
+    entrypoint: str
+    plans: Tuple[GpuKernelPlan, ...]
+    required_capabilities: Tuple[str, ...]
+    specialization: Mapping[str, Any]
+    plan_version: int
+
+    def __init__(
+        self,
+        program: CoreProgram,
+        target: TargetSpec,
+        entrypoint: str,
+        plans: Sequence[GpuKernelPlan],
+        required_capabilities: Any = (),
+        specialization: Optional[Mapping[str, Any]] = None,
+        plan_version: int = GPU_PLAN_VERSION,
+    ):
+        if not isinstance(program, CoreProgram):
+            raise GpuValidationError("GPU program requires CoreProgram")
+        if not isinstance(target, TargetSpec):
+            raise GpuValidationError("GPU program requires TargetSpec")
+        validate_gpu_target(target)
+        _reject_vendor_terms(program.to_dict(), "CoreProgram")
+        try:
+            validate_program(program)
+        except CpuScalarUnsupportedError as exc:
+            raise GpuUnsupportedError("Core program is outside the portable GPU subset: {}".format(exc)) from exc
+        except CpuScalarError as exc:
+            raise GpuValidationError("Core program validation failed: {}".format(exc)) from exc
+        if any(function.body.blocks for function in program.functions):
+            raise GpuUnsupportedError("GPU common supports direct operation bodies only")
+        if not isinstance(entrypoint, str) or not entrypoint.strip():
+            raise GpuValidationError("GPU entrypoint must be non-empty")
+        functions = {function.name: function for function in program.functions}
+        if entrypoint not in functions:
+            raise GpuValidationError("GPU entrypoint {!r} is not in CoreProgram".format(entrypoint))
+        values = tuple(plans)
+        if any(not isinstance(plan, GpuKernelPlan) for plan in values):
+            raise GpuValidationError("GPU plans must be GpuKernelPlan values")
+        if len(values) != len(functions[entrypoint].body.operations):
+            raise GpuValidationError("GPU plan count does not match entrypoint operation count")
+        capabilities = _names(required_capabilities, "required_capabilities")
+        normalized_specialization = _target_specialization(target, specialization)
+        expected = tuple(
+            _make_plan_for_operation(program, target, operation, index, capabilities, normalized_specialization)
+            for index, operation in enumerate(functions[entrypoint].body.operations)
+        )
+        for index, (actual, wanted) in enumerate(zip(values, expected)):
+            if actual.to_dict() != wanted.to_dict():
+                raise GpuValidationError("GPU plan at operation index {} does not match Core IR".format(index))
+        if any(plan.required_capabilities != capabilities for plan in values):
+            raise GpuValidationError("all GPU plans must use the same required capabilities")
+        if any(plan.specialization != normalized_specialization for plan in values):
+            raise GpuValidationError("all GPU plans must use the same specialization")
+        _reject_vendor_terms(target.to_dict(), "target")
+        object.__setattr__(self, "program", program)
+        object.__setattr__(self, "target", target)
+        object.__setattr__(self, "entrypoint", entrypoint.strip())
+        object.__setattr__(self, "plans", values)
+        object.__setattr__(self, "required_capabilities", capabilities)
+        object.__setattr__(self, "specialization", normalized_specialization)
+        object.__setattr__(self, "plan_version", plan_version)
+
+    @property
+    def plan_digest(self) -> str:
+        return sha256_text([plan.to_dict() for plan in self.plans])
+
+    @property
+    def kernels(self) -> Tuple[GpuKernelPlan, ...]:
+        return self.plans
+
+    @property
+    def gpu_plans(self) -> Tuple[GpuKernelPlan, ...]:
+        return self.plans
+
+    @property
+    def features(self) -> Tuple[str, ...]:
+        return self.required_capabilities
+
+    def validate(self) -> "GpuProgram":
+        GpuProgram(
+            self.program,
+            self.target,
+            self.entrypoint,
+            self.plans,
+            self.required_capabilities,
+            mapping_copy(self.specialization),
+            self.plan_version,
+        )
+        return self
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "plan_version": self.plan_version,
+            "entrypoint": self.entrypoint,
+            "required_capabilities": list(self.required_capabilities),
+            "specialization": mapping_copy(self.specialization),
+            "plans": [plan.to_dict() for plan in self.plans],
+            "plan_digest": self.plan_digest,
+        }
+
+    def canonical_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+    dumps = canonical_json
+    to_json = canonical_json
+
+
+GpuCommonProgram = GpuProgram
+GpuKernel = GpuKernelPlan
+
+
+def validate_gpu_target(target: TargetSpec) -> TargetSpec:
+    if not isinstance(target, TargetSpec):
+        raise GpuValidationError("GPU common requires TargetSpec")
+    if target.kind != "gpu":
+        raise GpuValidationError("GPU common target requires kind='gpu', got {!r}".format(target.kind))
+    _reject_vendor_terms(target.to_dict(), "target")
+    return target
+
+
+def lower_gpu_common(
+    program: CoreProgram,
+    target: TargetSpec,
+    entrypoint: Optional[str] = None,
+    *,
+    required_capabilities: Any = None,
+    specialization: Optional[Mapping[str, Any]] = None,
+) -> GpuProgram:
+    validate_gpu_target(target)
