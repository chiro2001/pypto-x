+def test_invalid_layout_unknown_op_symbolic_and_wrong_target_are_explicit():
+    program = _add_program((4,))
+    with pytest.raises(GpuValidationError, match="kind='gpu'"):
+        lower_gpu_common(program, TargetSpec("cpu", "x86_64-linux-gnu"))
+    with pytest.raises(GpuUnsupportedError, match="non-contiguous"):
+        lower_gpu_common(
+            _program(
+                "bad_layout",
+                program.functions[0].parameters,
+                program.functions[0].returns,
+                (
+                    Operation(
+                        "add",
+                        program.functions[0].body.operations[0].inputs,
+                        program.functions[0].body.operations[0].outputs,
+                        attributes={"contiguous": False},
+                    ),
+                ),
+            ),
+            TARGET,
+        )
+    value_type = CoreType.tensor("float32", ("N",))
+    x = ValueRef("x", value_type)
+    y = ValueRef("y", value_type)
+    z = ValueRef("z", value_type)
+    with pytest.raises((GpuUnsupportedError, GpuValidationError), match="symbolic|dimension"):
+        lower_gpu_common(_program("symbolic", (x, y), (z,), (Operation("add", (x, y), (z,)),)), TARGET)
+
