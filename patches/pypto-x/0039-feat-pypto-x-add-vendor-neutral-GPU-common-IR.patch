+"""GPU common IR/ABI and no-device simulator tests."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from pypto.abi import (
+    AddressSpace,
+    GridDim,
+    GpuLaunchRequest,
+    LaunchGeometry,
+    TensorDesc,
+    WorkgroupDim,
+)
+from pypto.backends.cpu import HostTensor
+from pypto.backends.gpu import GpuArtifactError, GpuCommonSimulator, GpuExecutionError
+from pypto.compiler.artifact import Artifact
+from pypto.compiler.targets.gpu import GpuCommonCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.gpu import GpuUnsupportedError, GpuValidationError, lower_gpu_common
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec(
+    "gpu",
+    "gpu-neutral",
+    attributes={"workgroup": (4,), "supported_subgroup_sizes": (2, 4, 8)},
+)
+
+
+def _program(name, parameters, returns, operations, metadata=None):
+    return CoreProgram(
+        functions=(CoreFunction(name, parameters, returns, Region(tuple(operations))),),
+        metadata=metadata,
+    )
+
+
+def _add_program(shape=(11,), dtype="float32"):
+    value_type = CoreType.tensor(dtype, shape)
+    x = ValueRef("x", value_type)
+    y = ValueRef("y", value_type)
+    z = ValueRef("z", value_type)
+    return _program("add", (x, y), (z,), (Operation("add", (x, y), (z,)),))
+
+
+def _compile(program, target=TARGET):
+    compiler = GpuCommonCompiler()
+    target_ir = compiler.lower(program, target)
+    return compiler, target_ir, compiler.compile(target_ir)
+
+
+def _descriptor(tensor, readonly=False):
+    return TensorDesc(
+        tensor.dtype,
+        tensor.shape,
+        device="gpu",
+        handle=tensor,
+        readonly=readonly,
+    )
+
+
+def test_geometry_is_immutable_three_dimensional_and_64_bit_checked():
+    geometry = LaunchGeometry(GridDim(x=2, y=3, z=1), WorkgroupDim((4, 2)), subgroup_size=2)
+    assert geometry.grid.rank == 2
+    assert geometry.workgroup.count == 8
+    assert geometry.to_dict()["grid"] == {"x": 2, "y": 3, "z": 1}
+    with pytest.raises((AttributeError, TypeError)):
+        geometry.grid.x = 9
+    with pytest.raises(Exception, match="positive"):
+        GridDim((0,))
+    with pytest.raises(Exception, match="64-bit|range"):
+        GridDim((1 << 64,))
+    with pytest.raises(Exception, match="subgroup"):
+        LaunchGeometry((1,), (2,), subgroup_size=4)
+
+
+def test_gpu_plan_is_deterministic_and_contains_no_vendor_entities():
+    compiler, target_ir, artifact = _compile(_add_program())
+    second = compiler.compile(compiler.lower(_add_program(), TARGET))
+    assert artifact.payload == second.payload
+    assert target_ir.plan_digest == compiler.lower(_add_program(), TARGET).plan_digest
+    payload_text = artifact.payload.decode("utf-8").lower()
+    for forbidden in ("cuda", "hip", "nvvm", "ptx", "amdgpu", "rocdl", "warp", "wavefront", "wmma", "mfma"):
+        assert forbidden not in payload_text
+    assert target_ir.plans[0].bounds.index_width == 64
+    assert target_ir.plans[0].storage["x"] == AddressSpace.GLOBAL.value
+
+
+@pytest.mark.parametrize("length", (0, 1, 3, 4, 5, 7, 11, 15))
+def test_elementwise_simulator_covers_empty_and_odd_domains(length):
+    compiler, target_ir, artifact = _compile(_add_program((length,)))
+    left = HostTensor("float32", (length,), list(range(length)))
+    right = HostTensor("float32", (length,), [2.0] * length)
+    output = HostTensor.zeros("float32", (length,))
+    request = GpuLaunchRequest(
+        artifact,
+        target_ir.plans[0].geometry,
+        inputs=[_descriptor(left, True), _descriptor(right, True)],
+        outputs=[_descriptor(output)],
+    )
+    GpuCommonSimulator().launch(request)
+    assert output.flat() == tuple(float(index + 2) for index in range(length))
+    summary = GpuCommonSimulator().validate_coverage(artifact)[0]
+    assert summary["logical_elements"] == length
+
+
+def test_bf16_fp32_accumulation_and_rne():
+    value_type = CoreType.tensor("bf16", (5,))
+    x = ValueRef("x", value_type)
+    y = ValueRef("y", value_type)
+    z = ValueRef("z", value_type)
+    program = _program("sum", (x, y), (z,), (Operation("add", (x, y), (z,)),))
+    compiler, target_ir, artifact = _compile(program)
+    left = HostTensor("bf16", (5,), [1.0] * 5)
+    right = HostTensor("bf16", (5,), [0.5] * 5)
+    output = HostTensor.zeros("bf16", (5,))
+    GpuCommonSimulator().launch(
+        GpuLaunchRequest(
+            artifact,
+            target_ir.plans[0].geometry,
+            inputs=[_descriptor(left, True), _descriptor(right, True)],
+            outputs=[_descriptor(output)],
+        )
+    )
+    assert output.flat() == (1.5,) * 5
+
