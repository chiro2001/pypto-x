+"""Pure-Python GPU common simulator and artifact validator.
+
+This module validates logical thread coverage and executes the portable subset
+with ordinary Python loops.  It is a correctness oracle for later device
+backends; it does not claim to launch a device kernel.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, LaunchRequest, TensorDesc
+from pypto.abi.gpu import GpuLaunchRequest
+from pypto.compiler.artifact import Artifact
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import canonical_dtype, canonical_operation_name, element_count, flatten_values, static_shape
+from pypto.lowering.gpu import (
+    GPU_COMMON_BACKEND,
+    GPU_IR_VERSION,
+    GPU_LOWERING_VERSION,
+    GPU_PLAN_VERSION,
+    BoundsPredicate,
+    GpuKernelPlan,
+    GpuProgram,
+    GpuUnsupportedError,
+    GpuValidationError,
+    lower_gpu_common,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_text
+
+from ..cpu.tensor import FlatBuffer, HostTensor, _cast_value
+
+
+class GpuRuntimeError(RuntimeError):
+    """Base simulator/runtime contract error."""
+
+
+class GpuArtifactError(GpuRuntimeError):
+    """Artifact payload, metadata, digest, or target-plan mismatch."""
+
+
+class GpuExecutionError(GpuRuntimeError):
+    """Invocation or logical simulator execution error."""
+
+
+@dataclass(frozen=True)
+class LoadedGpuArtifact:
+    artifact: Artifact
+    target_ir: GpuProgram
+
+    @property
+    def program(self) -> GpuProgram:
+        return self.target_ir
+
+
+class GpuCommonSimulator:
+    """No-device logical executor for the common GPU subset."""
+
+    name = GPU_COMMON_BACKEND
+
+    def availability(self) -> Availability:
+        return Availability.yes(self.name)
+
+    def is_available(self) -> bool:
+        return True
+
+    def load(self, artifact: Artifact) -> LoadedGpuArtifact:
+        return _decode_artifact(artifact)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, (LaunchRequest, GpuLaunchRequest)):
+            raise GpuExecutionError("GPU workspace_size requires a launch request")
+        self.load(request.artifact)
+        if isinstance(request, GpuLaunchRequest) and isinstance(request.workspace, int):
+            return request.workspace
+        return 0
+
+    def validate_coverage(self, artifact: Artifact) -> Tuple[Mapping[str, Any], ...]:
+        loaded = self.load(artifact)
+        return tuple(_coverage_summary(plan) for plan in loaded.target_ir.plans)
+
+    def launch(self, request: Any) -> Tuple[Any, ...]:
+        gpu_request = _as_gpu_request(request)
+        try:
+            gpu_request.validate()
+        except Exception as exc:
+            raise GpuExecutionError("invalid GPU launch request: {}".format(exc)) from exc
+        loaded = self.load(gpu_request.artifact)
+        target_ir = loaded.target_ir
+        if not target_ir.plans:
+            raise GpuExecutionError("GPU entrypoint has no kernel plans")
+        if gpu_request.geometry.to_dict() != target_ir.plans[0].geometry.to_dict():
+            raise GpuExecutionError("launch geometry does not match the artifact entrypoint plan")
+        if (
+            isinstance(gpu_request.workspace, int)
+            and gpu_request.workspace < gpu_request.geometry.dynamic_workgroup_memory_bytes
+        ):
+            raise GpuExecutionError("launch workspace is smaller than the required dynamic workgroup memory")
+        function = _find_function(target_ir.program, target_ir.entrypoint)
+        _validate_request_target(gpu_request, target_ir.target, function, target_ir.plans[0])
+        tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+        tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+        if len(gpu_request.inputs) != len(tensor_parameters):
+            raise GpuExecutionError(
+                "function {!r} expects {} tensor inputs, got {}".format(
+                    function.name, len(tensor_parameters), len(gpu_request.inputs)
+                )
+            )
+        if len(gpu_request.outputs) != len(tensor_returns):
+            raise GpuExecutionError(
+                "function {!r} expects {} tensor outputs, got {}".format(
+                    function.name, len(tensor_returns), len(gpu_request.outputs)
+                )
+            )
+        if len(target_ir.plans) != len(function.body.operations):
+            raise GpuExecutionError("artifact GPU plan count does not match operation count")
+        environment: Dict[str, _RuntimeValue] = {}
+        input_index = 0
+        for parameter in function.parameters:
+            if _is_tensor(parameter.type):
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _read_tensor(gpu_request.inputs[input_index], parameter.type, parameter.name),
+                )
+                input_index += 1
+            elif _is_scalar(parameter.type):
+                if parameter.name not in gpu_request.scalars:
+                    raise GpuExecutionError("missing scalar input {!r}".format(parameter.name))
+                try:
+                    environment[parameter.name] = _RuntimeValue(
+                        parameter.type,
+                        _cast_value(gpu_request.scalars[parameter.name], canonical_dtype(parameter.type.dtype)),
+                    )
+                except (TypeError, ValueError, OverflowError) as exc:
+                    raise GpuExecutionError("invalid scalar input {!r}".format(parameter.name)) from exc
+            else:
+                raise GpuExecutionError("unsupported parameter kind {!r}".format(parameter.type.kind))
+        for index, operation in enumerate(function.body.operations):
+            _execute_operation(
+                operation,
+                target_ir.plans[index],
+                environment,
+                "function {} operation {}".format(function.name, index),
+            )
+        results = []
+        output_index = 0
+        for result_ref in function.returns:
+            if result_ref.name not in environment:
+                raise GpuExecutionError("return value {!r} was not produced".format(result_ref.name))
+            result = environment[result_ref.name]
+            if result.type != result_ref.type:
+                raise GpuExecutionError("return value {!r} has the wrong type".format(result_ref.name))
+            if _is_tensor(result_ref.type):
+                descriptor = gpu_request.outputs[output_index]
+                _write_tensor(descriptor, result_ref.type, result.data, result_ref.name)
+                results.append(descriptor.storage)
+                output_index += 1
+            else:
+                results.append(result.data)
+        return tuple(results)
+
+
+GpuRuntime = GpuCommonSimulator
+GpuCommonRuntime = GpuCommonSimulator
+GpuReferenceRuntime = GpuCommonSimulator
+GpuBackend = GpuCommonSimulator
+
+
+def launch(request: Any) -> Tuple[Any, ...]:
+    return GpuCommonSimulator().launch(request)
+
+
+def _as_gpu_request(request: Any) -> GpuLaunchRequest:
+    if isinstance(request, GpuLaunchRequest):
+        return request
+    if not isinstance(request, LaunchRequest):
+        raise GpuExecutionError("GPU launch requires GpuLaunchRequest or LaunchRequest")
+    loaded = _decode_artifact(request.artifact)
+    if not loaded.target_ir.plans:
+        raise GpuExecutionError("GPU artifact has no plan")
+    return GpuLaunchRequest(
+        request.artifact,
+        loaded.target_ir.plans[0].geometry,
+        inputs=request.inputs,
+        outputs=request.outputs,
+        scalars=request.scalars,
+        workspace=request.workspace,
+        stream_handle=request.stream_handle,
+    )
+
+
+def _decode_artifact(artifact: Artifact) -> LoadedGpuArtifact:
+    if not isinstance(artifact, Artifact):
+        raise GpuArtifactError("GPU common runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise GpuArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.payload is None:
+        raise GpuArtifactError("GPU common artifact requires an inline canonical payload")
+    payload = bytes(artifact.payload)
+    metadata = artifact.metadata
+    metadata_plain = mapping_copy(metadata)
+    if metadata.get("backend") != GPU_COMMON_BACKEND:
+        raise GpuArtifactError("artifact backend metadata is not GPU common")
+    if metadata.get("artifact_payload_version") != 1:
+        raise GpuArtifactError("unsupported GPU artifact metadata payload version")
+    actual_digest = hashlib.sha256(payload).hexdigest()
+    if actual_digest != artifact.content_digest or metadata.get("payload_digest") != actual_digest:
+        raise GpuArtifactError("GPU artifact payload digest mismatch")
+    try:
+        decoded = json.loads(payload.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise GpuArtifactError("GPU artifact payload is not UTF-8 JSON") from exc
+    if not isinstance(decoded, dict):
+        raise GpuArtifactError("GPU artifact payload must be a JSON object")
+    canonical_payload = json.dumps(
+        decoded,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    if canonical_payload != payload:
+        raise GpuArtifactError("GPU artifact payload is not canonical JSON")
+    if decoded.get("artifact_payload_version") != 1:
+        raise GpuArtifactError("unsupported GPU artifact payload version")
+    if decoded.get("backend") != GPU_COMMON_BACKEND:
+        raise GpuArtifactError("GPU artifact payload backend mismatch")
+    if decoded.get("gpu_ir_version") != GPU_IR_VERSION:
+        raise GpuArtifactError("unsupported GPU IR version")
+    if decoded.get("lowering_version") != GPU_LOWERING_VERSION:
+        raise GpuArtifactError("unsupported GPU lowering version")
+    if decoded.get("plan_version") != GPU_PLAN_VERSION:
+        raise GpuArtifactError("unsupported GPU plan version")
+    if decoded.get("target") != artifact.target.to_dict():
+        raise GpuArtifactError("GPU artifact target mismatch")
+    program_data = decoded.get("program")
+    if not isinstance(program_data, dict):
+        raise GpuArtifactError("GPU artifact does not contain a CoreProgram")
+    gpu_data = decoded.get("gpu_program")
+    if not isinstance(gpu_data, dict):
+        raise GpuArtifactError("GPU artifact does not contain GPU common program data")
+    try:
+        program = CoreProgram.from_dict(program_data)
+    except Exception as exc:
+        raise GpuArtifactError("GPU artifact CoreProgram is invalid: {}".format(exc)) from exc
+    program_digest = hashlib.sha256(program.canonical_json().encode("utf-8")).hexdigest()
+    if decoded.get("program_digest") != program_digest or metadata.get("program_digest") != program_digest:
+        raise GpuArtifactError("GPU artifact program digest mismatch")
+    try:
+        target_ir = lower_gpu_common(
+            program,
+            artifact.target,
+            gpu_data.get("entrypoint"),
+            required_capabilities=gpu_data.get("required_capabilities", ()),
+            specialization=gpu_data.get("specialization", {}),
+        )
+    except (GpuValidationError, GpuUnsupportedError, ValueError, TypeError) as exc:
+        raise GpuArtifactError("GPU artifact CoreProgram/plan is invalid: {}".format(exc)) from exc
+    if target_ir.to_dict() != gpu_data:
+        raise GpuArtifactError("GPU artifact GPU plan mismatch")
+    if decoded.get("plan_digest") != target_ir.plan_digest or metadata.get("plan_digest") != target_ir.plan_digest:
+        raise GpuArtifactError("GPU artifact plan digest mismatch")
+    if metadata.get("entrypoint") != artifact.entrypoint or gpu_data.get("entrypoint") != artifact.entrypoint:
+        raise GpuArtifactError("GPU artifact entrypoint mismatch")
+    if metadata.get("gpu_ir_version") != GPU_IR_VERSION:
+        raise GpuArtifactError("GPU artifact metadata IR version mismatch")
+    if metadata.get("lowering_version") != GPU_LOWERING_VERSION:
+        raise GpuArtifactError("GPU artifact metadata lowering version mismatch")
+    if metadata.get("plan_version") != GPU_PLAN_VERSION:
+        raise GpuArtifactError("GPU artifact metadata plan version mismatch")
+    if metadata.get("target_digest") != sha256_text(artifact.target.to_dict()):
+        raise GpuArtifactError("GPU artifact target digest mismatch")
+    if tuple(metadata.get("required_capabilities", ())) != target_ir.required_capabilities:
+        raise GpuArtifactError("GPU artifact required capability metadata mismatch")
+    expected_geometry = [plan.geometry.to_dict() for plan in target_ir.plans]
+    if metadata_plain.get("geometry") != expected_geometry:
+        raise GpuArtifactError("GPU artifact geometry metadata mismatch")
+    if metadata_plain.get("specialization") != mapping_copy(target_ir.specialization):
+        raise GpuArtifactError("GPU artifact specialization metadata mismatch")
+    if list(metadata.get("dtypes", ())) != sorted(set(plan.dtype for plan in target_ir.plans)):
+        raise GpuArtifactError("GPU artifact dtype metadata mismatch")
+    if list(metadata.get("layouts", ())) != sorted(set(plan.layout for plan in target_ir.plans)):
+        raise GpuArtifactError("GPU artifact layout metadata mismatch")
+    return LoadedGpuArtifact(artifact, target_ir)
+
+
+@dataclass(frozen=True)
+class _RuntimeValue:
+    type: CoreType
+    data: Any
+
+
+def _find_function(program: CoreProgram, entrypoint: str) -> CoreFunction:
+    for function in program.functions:
+        if function.name == entrypoint:
+            return function
+    raise GpuExecutionError("entrypoint {!r} is not present".format(entrypoint))
+
+
+def _validate_request_target(
+    request: GpuLaunchRequest,
+    target: TargetSpec,
+    function: Optional[CoreFunction] = None,
+    plan: Optional[GpuKernelPlan] = None,
+) -> None:
+    if target.kind != "gpu":
+        raise GpuExecutionError("GPU artifact target kind must be gpu")
+    for index, descriptor in enumerate(request.inputs + request.outputs):
+        if descriptor.device not in ("gpu", "device"):
+            raise GpuExecutionError(
+                "GPU tensor descriptor {} has device {!r}, expected 'gpu'".format(index, descriptor.device)
+            )
+        if descriptor.strides != _contiguous_strides(descriptor.shape):
+            raise GpuExecutionError("GPU common requires contiguous tensor descriptors")
+    if request.argument_bindings and function is not None and plan is not None:
+        expected_names = [
+            ref.name
+            for ref in function.parameters + function.returns
+            if _is_tensor(ref.type)
+        ]
+        by_index = {binding.index: binding for binding in request.argument_bindings}
+        if tuple(sorted(by_index)) != tuple(range(len(by_index))):
+            raise GpuExecutionError("GPU argument binding indices must be contiguous")
+        if len(by_index) != len(expected_names):
+            raise GpuExecutionError("GPU argument binding count does not match kernel tensors")
+        for index, name in enumerate(expected_names):
+            binding = by_index[index]
+            if binding.name != name:
+                raise GpuExecutionError("GPU argument binding name does not match Core IR")
+            expected_space = plan.storage.get(name, "global")
+            if binding.address_space is not None and binding.address_space.value != expected_space:
+                raise GpuExecutionError("GPU argument binding address space does not match the plan")
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _read_tensor(descriptor: TensorDesc, value_type: CoreType, context: str) -> List[Any]:
+    expected_dtype = canonical_dtype(value_type.dtype)
+    descriptor_dtype = canonical_dtype(descriptor.dtype)
+    expected_shape = static_shape(value_type, context)
+    if descriptor_dtype != expected_dtype or descriptor.shape != expected_shape:
+        raise GpuExecutionError("{} descriptor dtype/shape does not match Core IR".format(context))
+    if isinstance(descriptor.storage, HostTensor):
+        if canonical_dtype(descriptor.storage.dtype) != expected_dtype or descriptor.storage.shape != expected_shape:
+            raise GpuExecutionError("{} HostTensor metadata does not match descriptor".format(context))
+    values = _storage_values(descriptor.storage, context)
+    if len(values) != element_count(expected_shape):
+        raise GpuExecutionError("{} storage length does not match shape".format(context))
+    try:
+        return [_cast_value(value, expected_dtype) for value in values]
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise GpuExecutionError("{} contains an invalid value".format(context)) from exc
+
+
+def _write_tensor(descriptor: TensorDesc, value_type: CoreType, values: Sequence[Any], context: str) -> None:
+    if descriptor.readonly:
+        raise GpuExecutionError("{} output descriptor is read-only".format(context))
+    expected_dtype = canonical_dtype(value_type.dtype)
+    if canonical_dtype(descriptor.dtype) != expected_dtype or descriptor.shape != static_shape(value_type, context):
+        raise GpuExecutionError("{} output descriptor dtype/shape does not match Core IR".format(context))
+    storage = descriptor.storage
+    if isinstance(storage, HostTensor):
+        if canonical_dtype(storage.dtype) != expected_dtype or storage.shape != descriptor.shape:
+            raise GpuExecutionError("{} HostTensor metadata does not match output descriptor".format(context))
+        destination = storage.data
+    elif isinstance(storage, FlatBuffer):
+        destination = storage.data
+    elif isinstance(storage, list):
+        destination = storage
+    elif hasattr(storage, "data") and isinstance(storage.data, list):
+        destination = storage.data
+    else:
+        destination = None
+    try:
+        cast_values = [_cast_value(value, expected_dtype) for value in values]
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise GpuExecutionError("{} produced an invalid value".format(context)) from exc
+    if len(cast_values) != element_count(descriptor.shape):
+        raise GpuExecutionError("{} output length does not match shape".format(context))
+    if destination is not None:
+        if len(destination) != len(cast_values):
+            raise GpuExecutionError("{} output storage length does not match shape".format(context))
+        destination[:] = cast_values
+        return
+    if storage is None or not hasattr(storage, "__setitem__"):
+        raise GpuExecutionError("{} output storage is not mutable".format(context))
+    try:
+        if len(storage) != len(cast_values):
+            raise GpuExecutionError("{} output storage length does not match shape".format(context))
+        for index, value in enumerate(cast_values):
+            storage[index] = value
+    except (TypeError, IndexError, AttributeError) as exc:
+        raise GpuExecutionError("{} output storage is not mutable".format(context)) from exc
+
+
+def _storage_values(storage: Any, context: str) -> List[Any]:
+    if isinstance(storage, HostTensor):
+        return list(storage.data)
+    if isinstance(storage, FlatBuffer):
+        return list(storage.data)
+    if isinstance(storage, (str, bytes, bytearray, Mapping)) or storage is None:
+        raise GpuExecutionError("{} storage must be a flat numeric sequence".format(context))
+    if isinstance(storage, (list, tuple)):
+        return list(flatten_values(storage))
+    if hasattr(storage, "data") and isinstance(storage.data, (list, tuple)):
+        return list(storage.data)
+    try:
+        return [storage[index] for index in range(len(storage))]
+    except (TypeError, IndexError, KeyError, AttributeError) as exc:
+        raise GpuExecutionError("{} storage must support flat sequence access".format(context)) from exc
+
+
+def _value_sequence(value: Any, value_type: CoreType, context: str) -> Tuple[List[Any], bool]:
+    if _is_tensor(value_type):
+        expected = element_count(static_shape(value_type, context))
+        if not isinstance(value, list) or len(value) != expected:
+            raise GpuExecutionError("{} tensor value length mismatch".format(context))
+        return value, False
+    if _is_scalar(value_type):
+        return [value], True
+    raise GpuExecutionError("{} value kind {!r} is unsupported".format(context, value_type.kind))
+
+
+def _coverage(plan: GpuKernelPlan) -> Tuple[int, ...]:
+    count = element_count(plan.shape)
+    if plan.plan_kind != "matmul":
+        geometry = plan.geometry
+        seen = []
+        for gz in range(geometry.grid.z):
+            for gy in range(geometry.grid.y):
+                for gx in range(geometry.grid.x):
+                    block_index = ((gz * geometry.grid.y + gy) * geometry.grid.x + gx)
+                    for local in range(geometry.workgroup.count):
+                        index = block_index * geometry.workgroup.count + local
+                        if index < count:
+                            seen.append(index)
+        expected = tuple(range(count))
+        if tuple(seen) != expected:
+            raise GpuExecutionError("logical thread coverage has gaps, duplicates, or out-of-bounds indices")
+        return expected
+    matmul = plan.matmul
+    seen = []
+    for block_y in range(plan.geometry.grid.y):
+        for block_x in range(plan.geometry.grid.x):
+            row_start = block_y * matmul.tile.output[0]
+            col_start = block_x * matmul.tile.output[1]
+            for row in range(row_start, min(row_start + matmul.tile.output[0], matmul.m)):
+                for col in range(col_start, min(col_start + matmul.tile.output[1], matmul.n)):
+                    seen.append(row * matmul.n + col)
+    expected = tuple(range(count))
+    if tuple(seen) != expected:
+        raise GpuExecutionError("matrix tile coverage has gaps, duplicates, or out-of-bounds indices")
+    return expected
+
+
+def _coverage_summary(plan: GpuKernelPlan) -> Mapping[str, Any]:
+    covered = _coverage(plan)
+    return {
+        "operation": plan.operation,
+        "plan_kind": plan.plan_kind,
+        "logical_elements": len(covered),
+        "grid": plan.geometry.grid.to_dict(),
+        "workgroup": plan.geometry.workgroup.to_dict(),
+        "bounds": plan.bounds.to_dict(),
+        "covered_indices": list(covered),
+    }
+
+
+def _execute_operation(
+    operation: Operation,
+    plan: GpuKernelPlan,
+    environment: Dict[str, _RuntimeValue],
+    context: str,
+) -> None:
+    name = canonical_operation_name(operation.name)
+    if name != plan.operation:
+        raise GpuExecutionError("{} operation does not match GPU plan".format(context))
+    inputs = []
+    for ref in operation.inputs:
+        if ref.name not in environment:
+            raise GpuExecutionError("{} input {!r} is unavailable".format(context, ref.name))
+        value = environment[ref.name]
+        if value.type != ref.type:
+            raise GpuExecutionError("{} input {!r} has a type mismatch".format(context, ref.name))
+        inputs.append(value)
+    output_ref = operation.outputs[0]
+    try:
+        _coverage(plan)
+        if name == "constant":
+            raw = operation.attributes.get("value", operation.attributes.get("values"))
+            values = list(flatten_values(raw))
+            if output_ref.type.kind == "scalar":
+                if len(values) != 1:
+                    raise GpuExecutionError("{} scalar constant requires one value".format(context))
+                result = _cast_value(values[0], plan.dtype)
+            else:
+                result = [_cast_value(value, plan.dtype) for value in values]
+        elif name == "identity":
+            source, scalar = _value_sequence(inputs[0].data, inputs[0].type, context)
+            result = source[0] if scalar else [_cast_value(value, plan.dtype) for value in source]
+        elif name in ("add", "sub", "mul", "div"):
+            result = _execute_binary(name, inputs[0], inputs[1], output_ref.type, plan, context)
+        elif name == "neg":
+            source, scalar = _value_sequence(inputs[0].data, inputs[0].type, context)
+            mapped = [_cast_value(-value, plan.dtype) for value in source]
+            result = mapped[0] if scalar else mapped
+        elif name in ("reduce_sum", "reduce_max"):
+            result = _execute_reduction(name, inputs[0], output_ref.type, plan, context)
+        elif name == "matmul":
+            result = _execute_matmul(inputs[0], inputs[1], output_ref.type, plan, context)
+        else:
+            raise GpuExecutionError("{} operation is unsupported".format(context))
+    except GpuExecutionError:
+        raise
+    except (TypeError, ValueError, ZeroDivisionError, OverflowError) as exc:
+        raise GpuExecutionError("{} failed: {}".format(context, exc)) from exc
+    environment[output_ref.name] = _RuntimeValue(output_ref.type, result)
+
+
+def _execute_binary(
+    name: str,
+    left: _RuntimeValue,
+    right: _RuntimeValue,
+    output_type: CoreType,
+    plan: GpuKernelPlan,
+    context: str,
+) -> Any:
+    left_values, left_scalar = _value_sequence(left.data, left.type, context + ".left")
+    right_values, right_scalar = _value_sequence(right.data, right.type, context + ".right")
+    count = element_count(plan.shape)
+    if not left_scalar and len(left_values) != count:
+        raise GpuExecutionError("{} left value length mismatch".format(context))
+    if not right_scalar and len(right_values) != count:
+        raise GpuExecutionError("{} right value length mismatch".format(context))
+    result = []
+    for index in _coverage(plan):
+        left_value = left_values[0] if left_scalar else left_values[index]
+        right_value = right_values[0] if right_scalar else right_values[index]
+        if name == "add":
+            value = left_value + right_value
+        elif name == "sub":
+            value = left_value - right_value
+        elif name == "mul":
+            value = left_value * right_value
+        else:
+            if right_value == 0:
+                raise GpuExecutionError("division by zero")
+            value = left_value / right_value
+        result.append(_cast_value(value, plan.dtype))
+    return result[0] if output_type.kind == "scalar" else result
+
+
+def _execute_reduction(
+    name: str,
+    value: _RuntimeValue,
+    output_type: CoreType,
+    plan: GpuKernelPlan,
+    context: str,
+) -> List[Any]:
+    reduction = plan.reduction
+    values, scalar = _value_sequence(value.data, value.type, context + ".input")
+    if scalar or len(values) != element_count(reduction.input_shape):
+        raise GpuExecutionError("{} reduction input length mismatch".format(context))
+    result = [None] * reduction.output_elements
+    for output_index in _coverage(plan):
+        output_coords = _unravel(output_index, reduction.output_shape)
+        candidates = []
+        for input_index, input_value in enumerate(values):
+            input_coords = _unravel(input_index, reduction.input_shape)
+            if reduction.keepdims:
+                projected = tuple(
+                    0 if axis in reduction.axes else input_coords[axis]
+                    for axis in range(len(reduction.input_shape))
+                )
+            else:
+                projected = tuple(
+                    input_coords[axis]
+                    for axis in range(len(reduction.input_shape))
+                    if axis not in reduction.axes
+                )
+            if projected == output_coords:
+                candidates.append(input_value)
+        if len(candidates) != reduction.reduction_size:
+            if reduction.reduction_size == 0 and not candidates:
+                candidates = []
+            else:
+                raise GpuExecutionError("{} reduction group length mismatch".format(context))
+        aggregate = None
+        for candidate in candidates:
+            if aggregate is None:
+                aggregate = candidate
+            elif name == "reduce_sum":
+                aggregate += candidate
+            elif candidate > aggregate:
+                aggregate = candidate
+        if aggregate is None:
+            if name == "reduce_sum":
+                aggregate = 0.0
+            else:
+                raise GpuExecutionError("reduce_max has an empty reduction group")
+        result[output_index] = _cast_value(aggregate, canonical_dtype(output_type.dtype))
+    return result
+
+
+def _execute_matmul(
+    left: _RuntimeValue,
+    right: _RuntimeValue,
+    output_type: CoreType,
+    plan: GpuKernelPlan,
+    context: str,
+) -> List[Any]:
+    matmul = plan.matmul
+    left_values, left_scalar = _value_sequence(left.data, left.type, context + ".left")
+    right_values, right_scalar = _value_sequence(right.data, right.type, context + ".right")
+    if left_scalar or right_scalar:
+        raise GpuExecutionError("{} matmul inputs must be tensors".format(context))
+    if len(left_values) != matmul.m * matmul.k or len(right_values) != matmul.k * matmul.n:
+        raise GpuExecutionError("{} matmul input length mismatch".format(context))
+    result = [0] * matmul.output_elements
+    tile_m = matmul.tile.output[0]
+    tile_n = matmul.tile.output[1]
+    for block_y in range(plan.geometry.grid.y):
+        for block_x in range(plan.geometry.grid.x):
+            row_start = block_y * tile_m
+            col_start = block_x * tile_n
+            for row in range(row_start, min(row_start + tile_m, matmul.m)):
+                for col in range(col_start, min(col_start + tile_n, matmul.n)):
+                    aggregate = 0.0
+                    for inner in range(matmul.k):
+                        aggregate += left_values[row * matmul.k + inner] * right_values[inner * matmul.n + col]
+                    result[row * matmul.n + col] = _cast_value(aggregate, canonical_dtype(output_type.dtype))
+    return result
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _unravel(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
+    if not shape:
+        return ()
+    coordinates = [0] * len(shape)
+    remainder = index
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension == 0:
+            return tuple(coordinates)
+        coordinates[axis] = remainder % dimension
+        remainder //= dimension
+    return tuple(coordinates)
+
+
+__all__ = [
+    "GpuArtifactError",
+    "GpuBackend",
+    "GpuCommonRuntime",
+    "GpuCommonSimulator",
+    "GpuExecutionError",
+    "GpuReferenceRuntime",
+    "GpuRuntime",
+    "GpuRuntimeError",
+    "LoadedGpuArtifact",
+    "launch",
+]
