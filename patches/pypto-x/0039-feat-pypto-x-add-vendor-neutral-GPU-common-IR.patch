diff --git a/python/pypto/abi/gpu.py b/python/pypto/abi/gpu.py
new file mode 100644
index 000000000..91655d7dd
--- /dev/null
+++ b/python/pypto/abi/gpu.py
@@ -0,0 +1,523 @@
+"""Vendor-neutral GPU launch and memory contracts.
+
+The common GPU layer deliberately stops at a logical execution model.  It does
+not expose a vendor stream type, kernel descriptor, or device pointer ABI.  A
+later target backend may wrap :class:`GpuLaunchRequest` while retaining the
+ordinary :class:`~pypto.abi.LaunchRequest` tensor and stream fields.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.compiler.artifact import ARTIFACT_FORMAT_VERSION, Artifact
+from pypto.target._utils import frozen_mapping, mapping_copy
+from pypto.target.errors import ABIValidationError, VersionMismatchError
+
+from .descriptors import ABI_SCHEMA_VERSION, LaunchRequest, TensorDesc
+
+
+GPU_ABI_SCHEMA_VERSION = 1
+MAX_LOGICAL_INDEX = (1 << 64) - 1
+MAX_DIMENSIONS = 3
+
+
+def _positive_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+        raise ABIValidationError("{} must be a positive integer".format(field), field=field)
+    if value > MAX_LOGICAL_INDEX:
+        raise ABIValidationError("{} exceeds the 64-bit logical index range".format(field), field=field)
+    return value
+
+
+def _non_negative_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise ABIValidationError("{} must be a non-negative integer".format(field), field=field)
+    if value > MAX_LOGICAL_INDEX:
+        raise ABIValidationError("{} exceeds the 64-bit logical index range".format(field), field=field)
+    return value
+
+
+def _checked_product(values: Sequence[int], field: str) -> int:
+    result = 1
+    for index, value in enumerate(values):
+        result *= value
+        if result > MAX_LOGICAL_INDEX:
+            raise ABIValidationError(
+                "{} product exceeds the 64-bit logical index range at axis {}".format(field, index),
+                field=field,
+            )
+    return result
+
+
+def _dim_tuple(value: Any, field: str) -> Tuple[int, int, int]:
+    if isinstance(value, Mapping):
+        if "dims" in value or "values" in value or "size" in value:
+            value = value.get("dims", value.get("values", value.get("size")))
+        else:
+            value = tuple(value.get(axis, 1) for axis in ("x", "y", "z"))
+    if isinstance(value, (str, bytes)):
+        raise ABIValidationError("{} must be a 1-3D integer sequence".format(field), field=field)
+    try:
+        values = tuple(value)
+    except TypeError as exc:
+        raise ABIValidationError("{} must be a 1-3D integer sequence".format(field), field=field) from exc
+    if not 1 <= len(values) <= MAX_DIMENSIONS:
+        raise ABIValidationError("{} must have between 1 and 3 dimensions".format(field), field=field)
+    values = tuple(_positive_int(item, "{}[{}]".format(field, index)) for index, item in enumerate(values))
+    return values + (1,) * (MAX_DIMENSIONS - len(values))
+
+
+@dataclass(frozen=True, init=False)
+class GridDim:
+    """Logical grid extent, normalized to three positive dimensions."""
+
+    x: int
+    y: int
+    z: int
+
+    def __init__(
+        self,
+        value: Any = (1,),
+        y: Optional[int] = None,
+        z: Optional[int] = None,
+        *,
+        x: Optional[int] = None,
+    ):
+        if x is not None:
+            if value != (1,) or y is None and z is not None:
+                raise ValueError("x keyword cannot be combined with a positional grid value")
+            value = x
+        if isinstance(value, int) and not isinstance(value, bool) and y is None and z is None:
+            raw = (value,)
+        elif y is not None or z is not None:
+            raw = (value, y if y is not None else 1, z if z is not None else 1)
+        else:
+            raw = value
+        dims = _dim_tuple(raw, "grid")
+        object.__setattr__(self, "x", dims[0])
+        object.__setattr__(self, "y", dims[1])
+        object.__setattr__(self, "z", dims[2])
+        _checked_product(dims, "grid")
+
+    @property
+    def dims(self) -> Tuple[int, int, int]:
+        return (self.x, self.y, self.z)
+
+    @property
+    def rank(self) -> int:
+        if self.z != 1:
+            return 3
+        if self.y != 1:
+            return 2
+        return 1
+
+    @property
+    def count(self) -> int:
+        return _checked_product(self.dims, "grid")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"x": self.x, "y": self.y, "z": self.z}
+
+
+@dataclass(frozen=True, init=False)
+class WorkgroupDim:
+    """Logical workgroup extent, normalized to three positive dimensions."""
+
+    x: int
+    y: int
+    z: int
+
+    def __init__(
+        self,
+        value: Any = (1,),
+        y: Optional[int] = None,
+        z: Optional[int] = None,
+        *,
+        x: Optional[int] = None,
+    ):
+        if x is not None:
+            if value != (1,) or y is None and z is not None:
+                raise ValueError("x keyword cannot be combined with a positional workgroup value")
+            value = x
+        if isinstance(value, int) and not isinstance(value, bool) and y is None and z is None:
+            raw = (value,)
+        elif y is not None or z is not None:
+            raw = (value, y if y is not None else 1, z if z is not None else 1)
+        else:
+            raw = value
+        dims = _dim_tuple(raw, "workgroup")
+        object.__setattr__(self, "x", dims[0])
+        object.__setattr__(self, "y", dims[1])
+        object.__setattr__(self, "z", dims[2])
+        _checked_product(dims, "workgroup")
+
+    @property
+    def dims(self) -> Tuple[int, int, int]:
+        return (self.x, self.y, self.z)
+
+    @property
+    def rank(self) -> int:
+        if self.z != 1:
+            return 3
+        if self.y != 1:
+            return 2
+        return 1
+
+    @property
+    def count(self) -> int:
+        return _checked_product(self.dims, "workgroup")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"x": self.x, "y": self.y, "z": self.z}
+
+
+# Block is retained as an ergonomic spelling for callers, but serialized data
+# uses only the vendor-neutral "workgroup" field.
+BlockDim = WorkgroupDim
+
+
+@dataclass(frozen=True, init=False)
+class LaunchGeometry:
+    """Complete logical launch geometry and optional subgroup constraint."""
+
+    grid: GridDim
+    workgroup: WorkgroupDim
+    subgroup_size: Optional[int]
+    dynamic_workgroup_memory_bytes: int
+    schema_version: int
+
+    def __init__(
+        self,
+        grid: Any = (1,),
+        workgroup: Any = (1,),
+        subgroup_size: Optional[int] = None,
+        dynamic_workgroup_memory_bytes: int = 0,
+        *,
+        block: Any = None,
+        block_dim: Any = None,
+        schema_version: int = GPU_ABI_SCHEMA_VERSION,
+    ):
+        if block is not None and block_dim is not None:
+            raise ValueError("block and block_dim are aliases; pass only one")
+        if block is not None or block_dim is not None:
+            if workgroup != (1,):
+                raise ValueError("workgroup and block aliases; pass only one")
+            workgroup = block if block is not None else block_dim
+        if not isinstance(grid, GridDim):
+            grid = GridDim(grid)
+        if not isinstance(workgroup, WorkgroupDim):
+            workgroup = WorkgroupDim(workgroup)
+        if subgroup_size is not None:
+            subgroup_size = _positive_int(subgroup_size, "subgroup_size")
+        dynamic_workgroup_memory_bytes = _non_negative_int(
+            dynamic_workgroup_memory_bytes, "dynamic_workgroup_memory_bytes"
+        )
+        if isinstance(schema_version, bool) or not isinstance(schema_version, int) or schema_version <= 0:
+            raise ABIValidationError("GPU ABI schema version must be a positive integer", field="schema_version")
+        object.__setattr__(self, "grid", grid)
+        object.__setattr__(self, "workgroup", workgroup)
+        object.__setattr__(self, "subgroup_size", subgroup_size)
+        object.__setattr__(self, "dynamic_workgroup_memory_bytes", dynamic_workgroup_memory_bytes)
+        object.__setattr__(self, "schema_version", schema_version)
+        self.validate()
+
+    @property
+    def block(self) -> WorkgroupDim:
+        return self.workgroup
+
+    @property
+    def block_dim(self) -> WorkgroupDim:
+        return self.workgroup
+
+    @property
+    def grid_dim(self) -> GridDim:
+        return self.grid
+
+    @property
+    def workgroup_dim(self) -> WorkgroupDim:
+        return self.workgroup
+
+    @property
+    def logical_threads(self) -> int:
+        return _checked_product((self.grid.count, self.workgroup.count), "logical_threads")
+
+    def validate(self) -> None:
+        if self.schema_version > GPU_ABI_SCHEMA_VERSION:
+            raise VersionMismatchError("GPU ABI schema", GPU_ABI_SCHEMA_VERSION, self.schema_version)
+        if self.subgroup_size is not None and self.workgroup.count < self.subgroup_size:
+            raise ABIValidationError(
+                "subgroup_size cannot exceed workgroup thread count", field="subgroup_size"
+            )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate()
+        return {
+            "schema_version": self.schema_version,
+            "grid": self.grid.to_dict(),
+            "workgroup": self.workgroup.to_dict(),
+            "subgroup_size": self.subgroup_size,
+            "dynamic_workgroup_memory_bytes": self.dynamic_workgroup_memory_bytes,
+        }
+
+
+Grid = GridDim
+Workgroup = WorkgroupDim
+
+
+class AddressSpace(str, Enum):
+    GLOBAL = "global"
+    WORKGROUP = "workgroup"
+    PRIVATE = "private"
+    CONSTANT = "constant"
+
+    global_ = GLOBAL
+    shared = WORKGROUP
+    local = PRIVATE
+
+
+class MemoryScope(str, Enum):
+    INVOCATION = "invocation"
+    SUBGROUP = "subgroup"
+    WORKGROUP = "workgroup"
+    DEVICE = "device"
+    SYSTEM = "system"
+
+
+class BarrierKind(str, Enum):
+    EXECUTION = "execution"
+    MEMORY = "memory"
+    EXECUTION_AND_MEMORY = "execution_and_memory"
+
+
+@dataclass(frozen=True)
+class MemoryBarrier:
+    """Vendor-neutral barrier declaration for a target extension."""
+
+    scope: MemoryScope = MemoryScope.WORKGROUP
+    kind: BarrierKind = BarrierKind.EXECUTION_AND_MEMORY
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.scope, MemoryScope):
+            try:
+                object.__setattr__(self, "scope", MemoryScope(str(self.scope).lower()))
+            except ValueError as exc:
+                raise ABIValidationError("unknown memory barrier scope", field="scope") from exc
+        if not isinstance(self.kind, BarrierKind):
+            try:
+                object.__setattr__(self, "kind", BarrierKind(str(self.kind).lower()))
+            except ValueError as exc:
+                raise ABIValidationError("unknown memory barrier kind", field="kind") from exc
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"scope": self.scope.value, "kind": self.kind.value}
+
+
+@dataclass(frozen=True, init=False)
+class KernelArgumentBinding:
+    """Stable argument binding without a device-specific descriptor."""
+
+    name: str
+    index: int
+    kind: str
+    address_space: Optional[AddressSpace]
+    readonly: bool
+    attributes: Any
+
+    def __init__(
+        self,
+        name: str,
+        index: int,
+        kind: str = "tensor",
+        address_space: Optional[Any] = AddressSpace.GLOBAL,
+        readonly: bool = False,
+        attributes: Optional[Mapping[str, Any]] = None,
+    ):
+        if not isinstance(name, str) or not name.strip():
+            raise ABIValidationError("kernel argument name must be non-empty", field="name")
+        if isinstance(index, bool) or not isinstance(index, int) or index < 0:
+            raise ABIValidationError("kernel argument index must be non-negative", field="index")
+        if not isinstance(kind, str) or not kind.strip():
+            raise ABIValidationError("kernel argument kind must be non-empty", field="kind")
+        if address_space is not None and not isinstance(address_space, AddressSpace):
+            try:
+                address_space = AddressSpace(str(address_space).lower())
+            except ValueError as exc:
+                raise ABIValidationError("unknown kernel argument address space", field="address_space") from exc
+        object.__setattr__(self, "name", name.strip())
+        object.__setattr__(self, "index", index)
+        object.__setattr__(self, "kind", kind.strip().lower())
+        object.__setattr__(self, "address_space", address_space)
+        object.__setattr__(self, "readonly", bool(readonly))
+        object.__setattr__(self, "attributes", frozen_mapping(attributes))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "name": self.name,
+            "index": self.index,
+            "kind": self.kind,
+            "address_space": None if self.address_space is None else self.address_space.value,
+            "readonly": self.readonly,
+            "attributes": mapping_copy(self.attributes),
+        }
+
+
+KernelArg = KernelArgumentBinding
+Barrier = MemoryBarrier
+
+
+@dataclass(frozen=True, init=False)
+class GpuLaunchRequest:
+    """A GPU launch request built on the common tensor launch ABI."""
+
+    artifact: Artifact
+    geometry: LaunchGeometry
+    inputs: Tuple[TensorDesc, ...]
+    outputs: Tuple[TensorDesc, ...]
+    scalars: Any
+    workspace: Any
+    stream_handle: Any
+    argument_bindings: Tuple[KernelArgumentBinding, ...]
+    schema_version: int
+
+    def __init__(
+        self,
+        artifact: Artifact,
+        geometry: LaunchGeometry,
+        inputs: Optional[Sequence[TensorDesc]] = None,
+        outputs: Optional[Sequence[TensorDesc]] = None,
+        scalars: Optional[Mapping[str, Any]] = None,
+        workspace: Any = None,
+        stream_handle: Any = None,
+        argument_bindings: Optional[Sequence[KernelArgumentBinding]] = None,
+        *,
+        input_tensors: Optional[Sequence[TensorDesc]] = None,
+        output_tensors: Optional[Sequence[TensorDesc]] = None,
+        stream: Any = None,
+        bindings: Optional[Sequence[KernelArgumentBinding]] = None,
+        schema_version: int = GPU_ABI_SCHEMA_VERSION,
+    ):
+        if not isinstance(artifact, Artifact):
+            raise ABIValidationError("GPU launch artifact must be Artifact", field="artifact")
+        if not isinstance(geometry, LaunchGeometry):
+            raise ABIValidationError("GPU launch geometry must be LaunchGeometry", field="geometry")
+        if inputs is not None and input_tensors is not None:
+            raise ValueError("inputs and input_tensors are aliases; pass only one")
+        if outputs is not None and output_tensors is not None:
+            raise ValueError("outputs and output_tensors are aliases; pass only one")
+        if stream_handle is not None and stream is not None:
+            raise ValueError("stream_handle and stream are aliases; pass only one")
+        if argument_bindings is not None and bindings is not None:
+            raise ValueError("argument_bindings and bindings are aliases; pass only one")
+        base = LaunchRequest(
+            artifact,
+            inputs=inputs if inputs is not None else input_tensors,
+            outputs=outputs if outputs is not None else output_tensors,
+            scalars=scalars,
+            workspace=workspace,
+            stream_handle=stream_handle if stream_handle is not None else stream,
+            schema_version=ABI_SCHEMA_VERSION,
+        )
+        values = () if argument_bindings is None and bindings is None else tuple(
+            argument_bindings if argument_bindings is not None else bindings
+        )
+        if any(not isinstance(value, KernelArgumentBinding) for value in values):
+            raise ABIValidationError("GPU argument bindings must be KernelArgumentBinding values", field="bindings")
+        if len({value.index for value in values}) != len(values):
+            raise ABIValidationError("GPU argument binding indices must be unique", field="bindings")
+        if isinstance(schema_version, bool) or not isinstance(schema_version, int) or schema_version <= 0:
+            raise ABIValidationError("GPU ABI schema version must be a positive integer", field="schema_version")
+        object.__setattr__(self, "artifact", artifact)
+        object.__setattr__(self, "geometry", geometry)
+        object.__setattr__(self, "inputs", base.inputs)
+        object.__setattr__(self, "outputs", base.outputs)
+        object.__setattr__(self, "scalars", base.scalars)
+        object.__setattr__(self, "workspace", workspace)
+        object.__setattr__(self, "stream_handle", stream_handle if stream_handle is not None else stream)
+        object.__setattr__(self, "argument_bindings", values)
+        object.__setattr__(self, "schema_version", schema_version)
+
+    @property
+    def input_tensors(self) -> Tuple[TensorDesc, ...]:
+        return self.inputs
+
+    @property
+    def output_tensors(self) -> Tuple[TensorDesc, ...]:
+        return self.outputs
+
+    @property
+    def stream(self) -> Any:
+        return self.stream_handle
+
+    @property
+    def bindings(self) -> Tuple[KernelArgumentBinding, ...]:
+        return self.argument_bindings
+
+    @property
+    def launch_geometry(self) -> LaunchGeometry:
+        return self.geometry
+
+    @property
+    def dynamic_workgroup_memory_bytes(self) -> int:
+        return self.geometry.dynamic_workgroup_memory_bytes
+
+    def as_launch_request(self) -> LaunchRequest:
+        return LaunchRequest(
+            self.artifact,
+            inputs=self.inputs,
+            outputs=self.outputs,
+            scalars=mapping_copy(self.scalars),
+            workspace=self.workspace,
+            stream_handle=self.stream_handle,
+        )
+
+    def validate(self, require_storage: bool = True) -> None:
+        if self.schema_version > GPU_ABI_SCHEMA_VERSION:
+            raise VersionMismatchError("GPU ABI schema", GPU_ABI_SCHEMA_VERSION, self.schema_version)
+        self.geometry.validate()
+        self.as_launch_request().validate(require_storage=require_storage)
+        if self.workspace is not None and isinstance(self.workspace, int):
+            _non_negative_int(self.workspace, "workspace")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate(require_storage=False)
+        return {
+            "schema_version": self.schema_version,
+            "artifact": self.artifact.cache_key,
+            "geometry": self.geometry.to_dict(),
+            "inputs": [value.to_dict() for value in self.inputs],
+            "outputs": [value.to_dict() for value in self.outputs],
+            "scalars": mapping_copy(self.scalars),
+            "workspace_present": self.workspace is not None,
+            "stream_present": self.stream_handle is not None,
+            "argument_bindings": [value.to_dict() for value in self.argument_bindings],
+        }
+
+
+GpuLaunch = GpuLaunchRequest
+KernelLaunchRequest = GpuLaunchRequest
+
+
+__all__ = [
+    "ABI_SCHEMA_VERSION",
+    "AddressSpace",
+    "Barrier",
+    "BarrierKind",
+    "BlockDim",
+    "GPU_ABI_SCHEMA_VERSION",
+    "Grid",
+    "GridDim",
+    "GpuLaunch",
+    "GpuLaunchRequest",
+    "KernelArg",
+    "KernelArgumentBinding",
+    "KernelLaunchRequest",
+    "LaunchGeometry",
+    "MAX_LOGICAL_INDEX",
+    "MemoryBarrier",
+    "MemoryScope",
+    "Workgroup",
+    "WorkgroupDim",
+]
