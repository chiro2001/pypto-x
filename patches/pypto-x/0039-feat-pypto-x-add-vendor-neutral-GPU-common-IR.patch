+def test_artifact_roundtrip_and_tamper_rejection():
+    compiler, target_ir, artifact = _compile(_add_program((5,)))
+    assert GpuCommonSimulator().load(artifact).target_ir.to_dict() == target_ir.to_dict()
+    envelope = json.loads(artifact.payload.decode("utf-8"))
+    envelope["gpu_program"]["plan_digest"] = "tampered"
+    payload = json.dumps(envelope, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=payload,
+        metadata=artifact.metadata,
+    )
+    with pytest.raises(GpuArtifactError, match="plan|digest"):
+        GpuCommonSimulator().load(tampered)
+
