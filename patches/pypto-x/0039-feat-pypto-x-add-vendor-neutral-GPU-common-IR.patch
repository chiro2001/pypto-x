+def test_launch_geometry_and_readonly_device_validation():
+    compiler, target_ir, artifact = _compile(_add_program((3,)))
+    left = HostTensor("float32", (3,), [1, 2, 3])
+    right = HostTensor("float32", (3,), [1, 1, 1])
+    output = HostTensor.zeros("float32", (3,))
