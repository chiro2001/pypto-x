+    except CpuScalarError as exc:
+        raise GpuValidationError("Core program validation failed: {}".format(exc)) from exc
+    functions = {function.name: function for function in program.functions}
+    selected = entrypoint
+    if selected is None:
+        selected = target.attributes.get("entrypoint", program.functions[0].name)
+    if not isinstance(selected, str) or selected not in functions:
+        raise GpuValidationError("GPU entrypoint {!r} is not in CoreProgram".format(selected))
+    target_caps = _target_capabilities(target)
+    explicit_caps = (
+        target_caps
+        if required_capabilities is None
+        else _names(required_capabilities, "required_capabilities")
+    )
+    if required_capabilities is not None:
+        explicit_caps = tuple(sorted(set(target_caps + explicit_caps)))
+    normalized_specialization = _target_specialization(target, specialization)
+    function = functions[selected]
+    plans = tuple(
+        _make_plan_for_operation(program, target, operation, index, explicit_caps, normalized_specialization)
+        for index, operation in enumerate(function.body.operations)
+    )
+    return GpuProgram(program, target, selected, plans, explicit_caps, normalized_specialization)
