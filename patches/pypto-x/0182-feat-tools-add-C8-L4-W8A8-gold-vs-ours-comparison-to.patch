+    parser.add_argument("--prompt", action="append", choices=PROMPTS, default=None)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+
+    gold_dir = Path(args.gold_dir).resolve()
+    ours_dir = Path(args.ours_dir).resolve()
