+#!/usr/bin/env python3
+# ---------------------------------------------------------------------------
+# 归档版本（Q5 / c8-l4-sve256 分支产出，CLI 为 --ours-dir 形式）。
+#
+# 为什么会同时存在两个判定工具：
+#   Q3（c8-l4-avx512）与 Q5（c8-l4-sve256）在各自分支上**独立**实现了同名工具
+#   `tools/c8_l4_compare.py`，合并时发生路径冲突。处理如下：
+#     * `tools/c8_l4_compare.py`            = Q3 版（**规范版**，生产出 ①主判定 + ②decode 扩展的全部判定，
+#                                             CLI 为 --ours-manifest 形式）；
+#     * `tools/c8_l4_compare_ours_dir.py`   = 本文件（Q5 版的归档，CLI 为 --ours-dir 形式）。
+#
+# 纪律：**跨腿比较必须用同一个判定器**。Q5 重跑（SVE256 的 L4 判定）应改用规范版，
+#       或先把它的 driver 输出转成规范版要求的 manifest 形式；否则两腿的口径不可比。
+# ---------------------------------------------------------------------------
+"""C8 L4 判定：我们的 W8A8 整网 logits vs W8A8 参照 gold。
+
+判据（docs/20-planning/0005-2026-09-11-c8-execution-queue.zh-CN.md §3；
+本脚本不改判据、不写死阈值）：
+
+    - 逐行 argmax 与 gold 一致（硬门槛）；
+      唯一例外：gold 该行 top1/top2 margin <= 0.5 x band 且
+      ours argmax == gold top2 -> 记 near-tie flip，不判失败，但单列计数。
+    - max|delta logits| <= 2 x band
+    - cosine >= band_cosine - 1e-4
+
+band 与 band_cosine 每次运行都从 ``--gold-dir`` 下的 ``band.json`` 读取
+（``variants.<variant>.per_prompt.<prompt>.band``），并把 band.json 的绝对
+路径、sha256、JSON pointer 与读到的数字打印到 stdout，同时写进输出 JSON 的
+``band_source``。
+
+判定粒度（防止同一批行被重复计入门禁）：
+
+    * primary：``prefill_logits``（T 行）、``prefill_next_logits``（1 行）、
+      ``decode_logits``（只含"本步输入 token 与 gold 一致"的 step，对应
+      gold decode_logits[1..k]，整体算一个 block）。
+    * breakdown（只报数）：每个 decode step 单行。
+    * informational：``last_hidden_state``（不是 logits，不套用 §3 判据）。
+    * diagnostic：``--diagnostic-variant``（默认 ``w8a8_f32ref``）单独成节，
+      明确标注不可比、不进入总判定。
+
+输入约定：``--ours-dir`` 下按 driver ``--debug-dump`` 命名：
+
+    <prompt>.s3-prefill.past0.npz
+    <prompt>.s3-decode.past<steps>.npz  ... past<steps+3>.npz
+
+每个 npz 至少含 ``logits`` 输出；可选 ``final_hidden``。
+
+本工具只依赖 numpy，只读文件，不执行模型/后端代码。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import Any, Dict, List, Mapping, Optional, Sequence
+
+import numpy as np
+
+TOOL = "c8_l4_compare"
+TOOL_VERSION = 1
+TWO_X = 2.0
+COSINE_SLACK = 1e-4
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+VOCAB = 248320
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def load_npz(path: Path) -> Mapping[str, np.ndarray]:
+    with np.load(str(path), allow_pickle=False) as data:
+        return {name: np.asarray(data[name]) for name in data.files}
+
+
+def flatten_rows(array: np.ndarray) -> np.ndarray:
+    array = np.asarray(array, dtype=np.float64)
+    if array.ndim == 1:
+        return array.reshape(1, -1)
+    return array.reshape(-1, array.shape[-1])
+
+
+def top2(row: np.ndarray) -> Mapping[str, Any]:
+    row = np.asarray(row, dtype=np.float64)
+    top1 = int(np.argmax(row))
+    top1_value = float(row[top1])
+    masked = np.where(np.arange(row.size) == top1, -np.inf, row)
+    top2_token = int(np.argmax(masked))
+    top2_value = float(masked[top2_token])
+    return {
+        "top1_token": top1, "top1_value": top1_value,
+        "top2_token": top2_token, "top2_value": top2_value,
+        "margin": top1_value - top2_value,
+    }
+
+
+def cosine(actual: np.ndarray, expected: np.ndarray) -> float:
+    a = np.asarray(actual, dtype=np.float64).reshape(-1)
+    b = np.asarray(expected, dtype=np.float64).reshape(-1)
+    na = math.sqrt(float(np.dot(a, a)))
+    nb = math.sqrt(float(np.dot(b, b)))
+    if na == 0.0 or nb == 0.0:
+        return float("nan")
+    return float(np.dot(a, b) / (na * nb))
+
+
+def classify(ours_argmax: int, gold: Mapping[str, Any], near_tie_threshold: float) -> str:
+    if ours_argmax == gold["top1_token"]:
+        return "strict_match"
+    if gold["margin"] <= near_tie_threshold and ours_argmax == gold["top2_token"]:
+        return "near_tie_flip"
+    return "argmax_fail"
+
+
+def compare_block(ours: np.ndarray, gold: np.ndarray, key: str, gate_role: str,
+                  band: Mapping[str, Any],
+                  comparable: Optional[Sequence[bool]] = None) -> Mapping[str, Any]:
+    ours_rows = flatten_rows(ours)
+    gold_rows = flatten_rows(gold)
+    if ours_rows.shape != gold_rows.shape:
+        raise SystemExit("{} shape mismatch: ours {} vs gold {}".format(
+            key, ours_rows.shape, gold_rows.shape))
+    if comparable is None:
+        comparable = [True] * ours_rows.shape[0]
+    near_tie_threshold = float(band["near_tie_threshold"])
+    max_abs_limit = TWO_X * float(band["max_abs"])
+    cosine_floor = float(band["cosine"]) - COSINE_SLACK
+
+    delta = np.abs(ours_rows - gold_rows)
+    rows = []
+    counts = {"strict_match": 0, "near_tie_flip": 0, "argmax_fail": 0,
+              "not_comparable": 0}
+    for index in range(ours_rows.shape[0]):
+        ours_t = top2(ours_rows[index])
+        gold_t = top2(gold_rows[index])
+        verdict = classify(ours_t["top1_token"], gold_t, near_tie_threshold)
+        if not bool(comparable[index]):
+            counts["not_comparable"] += 1
+        else:
+            counts[verdict] += 1
+        rows.append({
+            "row": index,
+            "comparable": bool(comparable[index]),
+            "classification": verdict if comparable[index] else "not_comparable",
+            "ours_argmax": ours_t["top1_token"],
+            "ours_top1_value": ours_t["top1_value"],
+            "ours_top2_token": ours_t["top2_token"],
+            "ours_margin": ours_t["margin"],
+            "gold_top1_token": gold_t["top1_token"],
+            "gold_top1_value": gold_t["top1_value"],
+            "gold_top2_token": gold_t["top2_token"],
+            "gold_margin": gold_t["margin"],
+        })
+    gated_rows = [row for row in rows if row["comparable"]]
+    max_abs = float(np.max(delta)) if delta.size else 0.0
+    mean_abs = float(np.mean(delta)) if delta.size else 0.0
+    cos = cosine(ours_rows, gold_rows)
+    if gated_rows:
+        gates = {
+            "argmax_gate": all(row["classification"] != "argmax_fail" for row in gated_rows),
+            "max_abs_gate": bool(max_abs <= max_abs_limit),
+            "max_abs_limit_2x_band": max_abs_limit,
+            "cosine_gate": bool(cos >= cosine_floor),
+            "cosine_floor": cosine_floor,
+        }
+    else:
+        gates = {"argmax_gate": None, "max_abs_gate": None,
+                 "max_abs_limit_2x_band": max_abs_limit, "cosine_gate": None,
+                 "cosine_floor": cosine_floor,
+                 "note": "无可比行；数字仅作信息"}
+    return {
+        "key": key,
+        "gate_role": gate_role,
+        "primary": gate_role == "primary",
+        "rows": int(ours_rows.shape[0]),
+        "gated_rows": len(gated_rows),
+        "max_abs": max_abs,
+        "mean_abs": mean_abs,
+        "cosine": cos,
+        "counts": counts,
+        "gold_near_tie_rows": sum(
+            1 for row in rows
+            if row["comparable"] and row["gold_margin"] <= near_tie_threshold
+        ),
+        "gates": gates,
+        "row_details": rows,
+        "near_tie_details": [
+            row for row in rows
+            if row["comparable"] and row["gold_margin"] <= near_tie_threshold
+        ],
+    }
+
+
+def read_band(band_json: Mapping[str, Any], variant: str, prompt: str,
+              band_path: Path, band_sha: str) -> Mapping[str, Any]:
+    pointer = ["variants", variant, "per_prompt", prompt, "band"]
+    node: Any = band_json
+    for step in pointer:
+        if not isinstance(node, Mapping) or step not in node:
+            raise SystemExit("band.json 缺少 {}（variant={} prompt={}）".format(
+                ".".join(pointer), variant, prompt))
+        node = node[step]
+    for field in ("max_abs", "cosine", "near_tie_threshold", "source_key"):
+        if field not in node:
+            raise SystemExit("band.json {} 缺少字段 {}".format(".".join(pointer), field))
+    max_abs = float(node["max_abs"])
+    near_tie = float(node["near_tie_threshold"])
+    return {
+        "path": str(band_path),
+        "sha256": band_sha,
+        "json_pointer": ".".join(pointer),
+        "source_key": node["source_key"],
+        "max_abs": max_abs,                         # band
+        "cosine": float(node["cosine"]),            # band_cosine
+        "near_tie_threshold": near_tie,             # 0.5 x band (from band.json)
+        "near_tie_equals_half_band": bool(abs(near_tie - 0.5 * max_abs) <= 1e-9 * max(1.0, max_abs)),
+        "two_x_band": TWO_X * max_abs,
+        "cosine_floor": float(node["cosine"]) - COSINE_SLACK,
+        "criteria_source": "docs/20-planning/0005-2026-09-11-c8-execution-queue.zh-CN.md §3",
+    }
+
+
+def per_key_band(band_json: Mapping[str, Any], variant: str,
+                 prompt: str) -> Mapping[str, Any]:
+    node = band_json.get("variants", {}).get(variant, {}).get("per_prompt", {}).get(prompt, {})
+    keys = node.get("keys", {})
+    out = {}
+    for key in ("prefill_logits", "prefill_next_logits", "decode_logits",
+                "last_hidden_state", "hidden_states_layers"):
+        if key in keys and isinstance(keys[key], Mapping) and "max_abs" in keys[key]:
+            out[key] = {
+                "max_abs": float(keys[key]["max_abs"]),
+                "cosine": (float(keys[key]["cosine"])
+                           if keys[key].get("cosine") is not None else None),
+                "note": "band.json 内该 key 自身统计，仅作交叉参考；门禁仍用 prefill_logits band",
+            }
+    return out
+
+
+def discover_decode(directory: Path, prompt: str) -> Dict[int, Path]:
+    found: Dict[int, Path] = {}
+    for path in sorted(directory.glob("{}.s3-decode.past*.npz".format(prompt))):
+        try:
+            past = int(path.name.split(".past")[-1].split(".")[0])
+        except ValueError:
+            continue
+        found[past] = path
+    return found
+
+
+def run_prompt(prompt: str, steps: int, ours_dir: Path, gold_dir: Path,
+               variant: str, band_json: Mapping[str, Any], band_path: Path,
+               band_sha: str,
+               diagnostic_variant: Optional[str]) -> Mapping[str, Any]:
+    gold_path = gold_dir / variant / "{}.npz".format(prompt)
+    if not gold_path.is_file():
+        raise SystemExit("gold npz 不存在: {}".format(gold_path))
+    gold = load_npz(gold_path)
+    for required in ("prefill_logits", "prefill_next_logits", "decode_logits",
+                     "decode_token_ids"):
+        if required not in gold:
+            raise SystemExit("gold {} 缺少键 {}".format(gold_path, required))
+    band = read_band(band_json, variant, prompt, band_path, band_sha)
+
+    prefill_path = ours_dir / "{}.s3-prefill.past0.npz".format(prompt)
+    if not prefill_path.is_file():
+        raise SystemExit("ours prefill npz 不存在: {}".format(prefill_path))
+    prefill = load_npz(prefill_path)
+    if "logits" not in prefill:
+        raise SystemExit("{} 缺少 'logits' 输出".format(prefill_path))
+    prefill_rows = flatten_rows(prefill["logits"])
+    if prefill_rows.shape[0] != steps:
+        raise SystemExit("{} prefill logits 行数 {} != steps {}".format(
+            prefill_path, prefill_rows.shape[0], steps))
+
+    keys: Dict[str, Any] = {}
+    keys["prefill_logits"] = compare_block(
+        prefill["logits"], gold["prefill_logits"], "prefill_logits", "primary", band)
+    keys["prefill_next_logits"] = compare_block(
+        prefill_rows[-1:], gold["prefill_next_logits"], "prefill_next_logits",
+        "primary", band)
+
+    gold_decode = flatten_rows(gold["decode_logits"])
+    gold_chain = [int(v) for v in gold["decode_token_ids"]]
+    ours_chain = [int(np.argmax(prefill_rows[-1]))]
+    decode_paths = discover_decode(ours_dir, prompt)
+    decode_steps = []
+    comparable_ours: List[np.ndarray] = []
+    comparable_gold: List[np.ndarray] = []
+    for step_index in range(4):
+        past = steps + step_index
+        path = decode_paths.get(past)
+        if path is None:
+            decode_steps.append({
+                "step_index": step_index, "past_length": past,
+                "status": "missing_dump", "path": str(path) if path else None,
+            })
+            continue
+        dump = load_npz(path)
+        if "logits" not in dump:
+            raise SystemExit("{} 缺少 'logits' 输出".format(path))
+        row = flatten_rows(dump["logits"])[0]
+        ours_argmax = int(np.argmax(row))
+        ours_input = ours_chain[step_index]
+        gold_input = gold_chain[step_index] if step_index < len(gold_chain) else None
+        comparable = gold_input is not None and ours_input == gold_input
+        gold_row = step_index + 1
+        step_record = {
+            "step_index": step_index,
+            "past_length": past,
+            "path": str(path),
+            "gold_row": gold_row if gold_row < gold_decode.shape[0] else None,
+            "ours_input_token": ours_input,
+            "gold_input_token": gold_input,
+            "input_comparable": bool(comparable),
+            "ours_argmax_token": ours_argmax,
+        }
+        if gold_row < gold_decode.shape[0]:
+            block = compare_block(row.reshape(1, -1), gold_decode[gold_row],
+                                  "decode_step_{}_gold_row_{}".format(step_index, gold_row),
+                                  "breakdown", band, [comparable])
+            block.update(step_record)
+            keys["decode_step_{}".format(step_index)] = block
+        if comparable:
+            comparable_ours.append(row)
+            comparable_gold.append(gold_decode[gold_row])
+        ours_chain.append(ours_argmax)
+        decode_steps.append(step_record)
+
+    if comparable_ours:
+        keys["decode_logits"] = compare_block(
+            np.vstack(comparable_ours), np.vstack(comparable_gold),
+            "decode_logits(rows_1..{})".format(len(comparable_ours)),
+            "primary", band)
+    else:
+        keys["decode_logits"] = {
+            "key": "decode_logits", "gate_role": "primary", "primary": True,
+            "status": "no_comparable_decode_rows",
+            "rows": 0, "gated_rows": 0,
+            "counts": {"strict_match": 0, "near_tie_flip": 0,
+                       "argmax_fail": 0, "not_comparable": 0},
+            "gold_near_tie_rows": 0,
+            "gates": {"argmax_gate": None, "max_abs_gate": None,
+                      "max_abs_limit_2x_band": band["two_x_band"],
+                      "cosine_gate": None, "cosine_floor": band["cosine_floor"],
+                      "note": "没有输入 token 与 gold 一致的 decode step"},
+        }
+    keys["decode_chain"] = {
+        "ours": ours_chain,
+        "gold_decode_token_ids": gold_chain,
+        "gold_argmax_tokens": [int(np.argmax(gold_decode[row]))
+                               for row in range(min(4, gold_decode.shape[0]))],
+        "steps": decode_steps,
+        "note": ("gold decode_token_ids[k] 是第 k 步消费的 token；"
+                 "我们的 decode 链第 k 步输入 = 上一步 argmax"),
+    }
+    if "final_hidden" in prefill and "last_hidden_state" in gold:
+        keys["last_hidden_state"] = compare_block(
+            prefill["final_hidden"], gold["last_hidden_state"],
+            "last_hidden_state", "informational", band)
+        keys["last_hidden_state"]["gates"] = {
+            "note": "hidden state 不是 logits，不套用 §3 判据；数字仅作信息"}
+
+    primary = [item for item in keys.values()
+               if isinstance(item, Mapping) and item.get("primary")]
+    strict = sum(item["counts"]["strict_match"] for item in primary)
+    near_tie = sum(item["counts"]["near_tie_flip"] for item in primary)
+    failed = sum(item["counts"]["argmax_fail"] for item in primary)
+    gated_rows = sum(item["gated_rows"] for item in primary)
+    argmax_gate = all(item["gates"]["argmax_gate"] for item in primary)
+    max_abs_gate = all(bool(item["gates"]["max_abs_gate"]) for item in primary)
+    cosine_gate = all(bool(item["gates"]["cosine_gate"]) for item in primary)
+    verdict = "PASS" if (argmax_gate and max_abs_gate and cosine_gate) else "FAIL"
+    result: Dict[str, Any] = {
+        "prompt": prompt,
+        "steps": steps,
+        "variant": variant,
+        "band": band,
+        "per_key_band_reference": per_key_band(band_json, variant, prompt),
+        "keys": keys,
+        "verdict": verdict,
+        "strict_argmax": strict,
+        "near_tie_flips": near_tie,
+        "argmax_failures": failed,
+        "gated_rows": gated_rows,
+        "gates": {"argmax_gate": argmax_gate, "max_abs_gate": max_abs_gate,
+                  "cosine_gate": cosine_gate},
+        "near_tie_rows": [
+            {"key": item["key"], **row}
+            for item in primary for row in item.get("near_tie_details", [])
+        ],
+    }
+    if diagnostic_variant:
+        diag_path = gold_dir / diagnostic_variant / "{}.npz".format(prompt)
+        if diag_path.is_file():
+            diag = load_npz(diag_path)
+            diag_band = read_band(band_json, diagnostic_variant, prompt, band_path, band_sha)
+            result["diagnostic_only_not_comparable"] = {
+                "variant": diagnostic_variant,
+                "warning": ("第二参照只作诊断：它的孤岛精度与主参照不同，"
+                            "不进入 L4 总判定，也不得与主参照数字混算"),
+                "band": diag_band,
+                "prefill_logits_vs_diagnostic_gold": compare_block(
+                    prefill["logits"], diag["prefill_logits"],
+                    "diagnostic_prefill_logits", "diagnostic", diag_band),
+                "decode_logits_vs_diagnostic_gold": compare_block(
+                    np.vstack(comparable_ours) if comparable_ours else prefill_rows[-1:],
+                    flatten_rows(diag["decode_logits"])[1:1 + len(comparable_ours)]
+                    if comparable_ours else flatten_rows(diag["decode_logits"])[0:1],
+                    "diagnostic_decode_logits", "diagnostic", diag_band),
+            }
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="C8 L4 判定（w8a8 主参照）")
+    parser.add_argument("--gold-dir", required=True)
+    parser.add_argument("--variant", default="w8a8")
+    parser.add_argument("--diagnostic-variant", default="w8a8_f32ref")
+    parser.add_argument("--ours-dir", required=True,
+                        help="driver --debug-dump 输出目录（<prompt>.s3-*.npz）")
+    parser.add_argument("--config", default=None, help="配置名（仅写进报告）")
+    parser.add_argument("--steps", default=None,
