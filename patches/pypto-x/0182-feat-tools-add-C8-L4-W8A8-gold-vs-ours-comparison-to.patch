+    steps_map = {"en_continuation": 5, "zh_continuation": 8, "chat_zh_user": 18}
+    if args.steps:
+        for item in args.steps.split(","):
+            name, value = item.split("=", 1)
+            steps_map[name] = int(value)
+    prompts = list(args.prompt) if args.prompt else list(PROMPTS)
+    print("[{}/v{}] band source: {}".format(TOOL, TOOL_VERSION, band_path))
+    print("[{}/v{}] band.json sha256: {}".format(TOOL, TOOL_VERSION, band_sha))
+    print("[{}/v{}] criteria: docs/20-planning/0005-2026-09-11-c8-execution-queue.zh-CN.md §3".format(
+        TOOL, TOOL_VERSION))
+
+    report: Dict[str, Any] = {
+        "tool": TOOL,
+        "tool_version": TOOL_VERSION,
+        "backend_config": args.config,
+        "primary_variant": args.variant,
+        "diagnostic_variant": args.diagnostic_variant,
+        "band_source": {"path": str(band_path), "sha256": band_sha,
+                        "criteria_source": "0005 §3"},
+        "ours_dir": str(ours_dir),
+        "prompts": {},
+    }
+    overall_pass = True
+    for prompt in prompts:
+        steps = steps_map[prompt]
+        result = run_prompt(prompt, steps, ours_dir, gold_dir, args.variant,
+                            band_json, band_path, band_sha, args.diagnostic_variant)
+        report["prompts"][prompt] = result
+        overall_pass = overall_pass and result["verdict"] == "PASS"
+        band = result["band"]
+        print("[{}] band[{}] max_abs={:.6f} cosine={:.8f} near_tie=0.5*band={:.6f} "
+              "floor={:.6f} pointer={}".format(
+                  prompt, args.variant, band["max_abs"], band["cosine"],
+                  band["near_tie_threshold"], band["cosine_floor"], band["json_pointer"]))
+        for key in ("prefill_logits", "prefill_next_logits", "decode_logits"):
+            block = result["keys"][key]
+            print("  {:<20} rows={:>3} gated={:>3} strict={} near_tie={} fail={} "
+                  "max_abs={:.6f} cos={:.8f} gates={}".format(
+                      key, block["rows"], block["gated_rows"],
+                      block["counts"]["strict_match"], block["counts"]["near_tie_flip"],
+                      block["counts"]["argmax_fail"], block["max_abs"], block["cosine"],
+                      {k: v for k, v in block["gates"].items()
+                       if k.endswith("_gate") and v is not None}))
+        print("  chain ours={} gold={} verdict={}".format(
