+def top2(row: np.ndarray) -> tuple:
+    """返回 (top1_token, top1_value, top2_token, top2_value, margin)。
+
+    tie-break：并列时取 token id 较小者（np.argmax 的第一个最大下标）。
+    """
     row = np.asarray(row, dtype=np.float64)
     top1 = int(np.argmax(row))
     top1_value = float(row[top1])
     masked = np.where(np.arange(row.size) == top1, -np.inf, row)
     top2_token = int(np.argmax(masked))
     top2_value = float(masked[top2_token])
