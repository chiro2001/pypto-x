+def _validate_layout_decision(data: Mapping[str, Any]) -> None:
+    """Reject a self-inconsistent frozen layout/view decision.
+
+    Content-local checks only: the alias-proof digest must recompute, the
+    proof facts must agree with the declared obligation, the obligation
+    invariants (``must_not_alias``/``require``/``view``/``materialized``) must
+    hold, and the ``layout.alias_proof`` rule trace must agree with the
+    decision.  The cross-check against the registered OpDefinition runs in
+    :func:`pypto.execution.entry._verify_plan_layout_decision`, where the plan
+    meets the contract registry.
+    """
+
+    decision = data["layout_decision"]
+    errors = list(layout_decision_errors(decision))
+    errors.extend(layout_rule_errors(data))
+    if not errors:
+        return
+    first = errors[0]
+    raise ArtifactMismatchError(
+        "execution plan layout decision failed {} validation: {}".format(
+            first.get("reason"), first.get("field")
+        ),
+        field="plan." + str(first.get("field")),
+        requested=first.get("requested"),
+        available=first.get("available"),
+        reason=first.get("reason"),
+        details={"errors": [dict(item) for item in errors]},
+    )
+
+
