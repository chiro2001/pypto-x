+# ---------------------------------------------------------------------------
+# adversarial forgery probes (independent-verification blockers V3)
+# ---------------------------------------------------------------------------
+def _valid_report_document():
+    left = HostTensor("float32", (2, 4), [float(index + 1) for index in range(8)])
+    right = HostTensor("float32", (4, 4), [0.5] * 16)
+    _, report = execute_matmul(left, right, policy=ExecutionPolicy())
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def _align_rules_with_decision(payload):
+    """Update the plan rule trace so only the contract cross-check can refuse."""
+
+    decision = payload["layout_decision"]
+    proof = decision["alias_proof"]
+    for rule in payload["resolution"]["rules"]:
+        if rule.get("rule") == "layout.alias_proof":
+            rule["details"].update(
+                {
+                    "requested_view_mode": decision["requested_view_mode"],
+                    "resolved_view_mode": decision["resolved_view_mode"],
+                    "view_obligation": decision["view_obligation"],
+                    "alias_proof_status": proof["status"],
+                    "alias_proof_digest": decision["alias_proof_digest"],
+                    "failed_conditions": list(proof["failed_conditions"]),
+                    "layout_copy_bytes": decision["layout_copy_bytes"],
+                }
+            )
+    return payload
+
+
+def _make_self_consistent_forged_view_decision(payload):
+    """Turn a matmul plan into a (content-local) self-consistent require->view."""
+
+    layout = payload["layout_decision"]
+    layout["requested_view_mode"] = "require"
+    layout["resolved_view_mode"] = "view"
+    layout["layout_copy_bytes"] = 0
+    layout["materialize_allowed"] = False
+    layout["materialize_reason"] = "forged"
+    layout["resolution_reason"] = "forged"
+    # Flip the declared obligation and the proof facts together, then rebuild
+    # every digest so that only the registered contract can tell the forgery.
+    layout["view_obligation"] = "may_alias"
+    layout["alias_proof"]["facts"]["contract"]["view_obligation"] = "may_alias"
+    layout["alias_proof"]["status"] = "proven"
+    layout["alias_proof"]["reason"] = "all_alias_proof_conditions_passed"
+    layout["alias_proof"]["failed_conditions"] = []
+    for condition in layout["alias_proof"]["conditions"]:
+        condition["status"] = "passed"
+        condition["code"] = "forged"
+        condition["reason"] = "forged"
+        condition["evidence"] = {}
+    layout["alias_proof"]["digest"] = recompute_alias_proof_digest(layout["alias_proof"])
+    layout["alias_proof_digest"] = layout["alias_proof"]["digest"]
+    return _align_rules_with_decision(payload)
+
+
+def test_report_schema_rejects_forged_alias_proof_without_digest_recompute():
+    document = _valid_report_document()
+    layout = document["layout_decision"]
+    layout["requested_view_mode"] = "require"
+    layout["resolved_view_mode"] = "view"
+    layout["layout_copy_bytes"] = 0
+    layout["alias_proof"]["status"] = "proven"
+    layout["alias_proof"]["reason"] = "forged"
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(document)
+    assert getattr(excinfo.value, "code", None) == REPORT_SCHEMA_INVALID
+
+
+def test_plan_validate_rejects_content_inconsistent_alias_decision():
+    payload = plan_matmul((2, 3), (3, 4), "float32").plan.payload
+
+    # (a) alias_proof_digest must equal the recomputable proof digest.
+    forged = copy.deepcopy(payload)
+    forged["layout_decision"]["alias_proof_digest"] = "sha256:" + "0" * 64
+    with pytest.raises(Exception) as digest_error:
+        ExecutionPlan(forged).validate()
+    assert getattr(digest_error.value, "code", None) == ARTIFACT_MISMATCH
+    assert digest_error.value.reason == "alias_proof_digest_mismatch"
+
+    # (b) the proof facts and the declared obligation must agree.
+    forged = copy.deepcopy(payload)
+    forged["layout_decision"]["alias_proof"]["facts"]["contract"][
+        "view_obligation"
+    ] = "may_alias"
+    recomputed = recompute_alias_proof_digest(forged["layout_decision"]["alias_proof"])
+    forged["layout_decision"]["alias_proof"]["digest"] = recomputed
+    forged["layout_decision"]["alias_proof_digest"] = recomputed
+    with pytest.raises(Exception) as obligation_error:
+        ExecutionPlan(forged).validate()
+    assert obligation_error.value.reason == "alias_proof_contract_obligation_mismatch"
+
+    # (c) must_not_alias may never claim require/view (no digest recompute needed).
+    forged = copy.deepcopy(payload)
+    forged["layout_decision"]["requested_view_mode"] = "require"
+    forged["layout_decision"]["resolved_view_mode"] = "view"
+    forged["layout_decision"]["layout_copy_bytes"] = 0
+    with pytest.raises(Exception) as view_error:
