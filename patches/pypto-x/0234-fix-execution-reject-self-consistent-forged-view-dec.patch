diff --git a/python/pypto/execution/layout_verify.py b/python/pypto/execution/layout_verify.py
new file mode 100644
index 000000000..233789652
--- /dev/null
+++ b/python/pypto/execution/layout_verify.py
@@ -0,0 +1,414 @@
+"""Fail-closed verification of a frozen layout/view decision.
+
+The resolver computes a layout decision from ``(OpDefinition, layout policy)``.
+This module re-derives the same decision and checks every frozen plan/report
+copy against it, so a self-consistent forgery (recomputed alias-proof digest
+and recomputed top-level plan digest) is still rejected unless it also matches
+the registered operator contract.
+
+Three layers call the same helpers:
+
+* :meth:`pypto.execution.plan.ExecutionPlan.validate` -- content-local checks
+  (digest self-consistency, obligation invariants, rule/decision agreement);
+* :func:`pypto.execution.entry.execute_matmul_plan` / ``_execute`` -- the same
+  checks plus the cross-check against the registered ``OpDefinition`` and the
+  canonical decision re-derived from the frozen policy;
+* :func:`pypto.execution.report.validate_report_schema` -- the same for the
+  report copy (with ``alias_check=verified_distinct`` from the runtime).
+
+Nothing here relaxes a semantic rule; every helper only adds a refusal.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Callable, Mapping, Optional, Sequence, Tuple
+
+from pypto.alias import (
+    VIEW_MODES,
+    ViewCapability,
+    ViewContract,
+    ViewIntent,
+    ViewResolutionError,
+    recompute_alias_proof_digest,
+    resolve_view,
+)
+
+from .errors import (
+    AliasProofUnavailableError,
+    ExecutionError,
+    PolicyConflictError,
+)
+
+
+def matmul_view_contract(definition: Any) -> ViewContract:
+    """Translate a matmul ``OpDefinition`` into the shared alias contract."""
+
+    return ViewContract(
+        opcode=definition.canonical_opcode,
+        view_obligation=definition.view_obligation,
+        allows_materialize_copy=False,
+        copy_bytes=0,
+        max_copy_bytes=None,
+        effects=str(definition.numeric_contract.get("effects", "pure")),
+    )
+
+
+def matmul_view_capability() -> ViewCapability:
+    """Capability facts for evaluating the matmul contract obligation."""
+
+    return ViewCapability(
+        backend="portable.cpu.scalar",
+        alias_proof="supported",
+        stride_class="contiguous_identity",
+        supported_view_modes=VIEW_MODES,
+        max_rank=4,
+        reason="",
+    )
+
+
+def layout_intent_from_document(layout_document: Optional[Mapping[str, Any]]) -> ViewIntent:
+    """Rebuild the layout intent from a policy/report layout document.
+
+    Unknown or malformed values fail closed through ``ViewIntent``.
+    """
+
+    document = dict(layout_document or {})
+    return ViewIntent(
+        view_mode=document.get("view_mode", "forbid"),
+        allow_materialize_copy=document.get("allow_materialize_copy", True),
+        max_copy_bytes=document.get("max_copy_bytes", None),
+    )
+
+
+def _translate_resolution_error(exc: ViewResolutionError) -> ExecutionError:
+    details = exc.to_dict()
+    if exc.code == "POLICY_CONFLICT":
+        return PolicyConflictError(
+            str(exc),
+            field=exc.field,
+            requested={"view_mode": exc.requested_view_mode},
+            available=exc.available,
+            reason=exc.reason,
+            suggested_policy=exc.suggested_policy,
+            details=details,
+        )
+    return AliasProofUnavailableError(
+        str(exc),
+        field=exc.field,
+        requested={"view_mode": exc.requested_view_mode},
+        available=exc.available,
+        reason=exc.reason,
+        suggested_policy=exc.suggested_policy,
+        details=details,
+    )
+
+
+def canonical_layout_decision(
+    definition: Any, layout_policy_document: Optional[Mapping[str, Any]]
+) -> Mapping[str, Any]:
+    """Re-derive the exact layout decision for a frozen policy.
+
+    Raises :class:`AliasProofUnavailableError` / :class:`PolicyConflictError`
+    when the policy is not satisfiable for this contract (for example
+    ``view_mode=require`` on ``must_not_alias``).
+    """
+
+    contract = matmul_view_contract(definition)
+    capability = matmul_view_capability()
+    intent = layout_intent_from_document(layout_policy_document)
+    try:
+        resolution = resolve_view(contract, capability, intent)
+    except ViewResolutionError as exc:
+        raise _translate_resolution_error(exc) from exc
+    proof = resolution.alias_proof
+    return {
+        "requested_view_mode": resolution.requested_view_mode,
+        "resolved_view_mode": resolution.resolved_view_mode,
+        "view_obligation": definition.view_obligation,
+        "alias_check": "contract_requires_distinct_storage"
+        if definition.view_obligation == "must_not_alias"
+        else "contract_permits_alias",
+        "alias_proof_digest": proof.digest,
+        "alias_proof": proof.to_dict(),
+        "layout_copy_bytes": resolution.layout_copy_bytes,
+        "transfer_bytes": 0,
+        "materialize_allowed": resolution.materialize_allowed,
+        "materialize_reason": resolution.materialize_reason,
+        "resolution_reason": resolution.reason,
+    }
+
+
+def _error(field: str, reason: str, requested: Any = None, available: Any = None) -> Mapping[str, Any]:
+    return {"field": field, "reason": reason, "requested": requested, "available": available}
+
+
+def alias_proof_errors(
+    decision: Mapping[str, Any],
+    *,
+    runtime_alias_check: bool = False
+) -> Tuple[Mapping[str, Any], ...]:
+    """Content-local checks on one frozen ``layout_decision``."""
+
+    errors = []
+    alias_proof = decision.get("alias_proof")
+    if not isinstance(alias_proof, Mapping):
+        return (_error("layout_decision.alias_proof", "alias_proof_missing"),)
+    digest = decision.get("alias_proof_digest")
+    proof_digest = alias_proof.get("digest")
+    if not isinstance(digest, str) or digest != proof_digest:
+        errors.append(
+            _error(
+                "layout_decision.alias_proof_digest",
+                "alias_proof_digest_mismatch",
+                requested=digest,
+                available=proof_digest,
+            )
+        )
+    try:
+        recomputed = recompute_alias_proof_digest(alias_proof)
+    except Exception as exc:  # pragma: no cover - defensive
+        errors.append(
+            _error(
+                "layout_decision.alias_proof.digest",
+                "alias_proof_digest_unrecomputable:{}".format(exc),
+            )
+        )
+    else:
+        if recomputed != proof_digest:
+            errors.append(
+                _error(
+                    "layout_decision.alias_proof.digest",
+                    "alias_proof_digest_mismatch",
+                    requested=proof_digest,
+                    available=recomputed,
+                )
+            )
+
+    obligation = decision.get("view_obligation")
+    facts = alias_proof.get("facts")
+    facts = facts if isinstance(facts, Mapping) else {}
+    contract_facts = facts.get("contract")
+    contract_facts = contract_facts if isinstance(contract_facts, Mapping) else {}
+    if contract_facts.get("view_obligation") != obligation:
+        errors.append(
+            _error(
+                "layout_decision.view_obligation",
+                "alias_proof_contract_obligation_mismatch",
+                requested=obligation,
+                available=contract_facts.get("view_obligation"),
+            )
+        )
+    requested = decision.get("requested_view_mode")
+    resolved = decision.get("resolved_view_mode")
+    if obligation == "must_not_alias" and (requested == "require" or resolved == "view"):
+        errors.append(
+            _error(
+                "layout_decision.resolved_view_mode",
+                "must_not_alias_requires_no_view",
+                requested={"requested_view_mode": requested, "resolved_view_mode": resolved},
+                available={"requested_view_mode": "forbid|prefer", "resolved_view_mode": "not_applicable|materialized"},
+            )
+        )
+    if requested == "require" and resolved != "view":
+        errors.append(
+            _error(
+                "layout_decision.resolved_view_mode",
+                "require_view_mode_not_satisfied",
+                requested=resolved,
+                available="view",
+            )
+        )
+    if resolved == "view" and decision.get("layout_copy_bytes") != 0:
+        errors.append(
+            _error(
+                "layout_decision.layout_copy_bytes",
+                "view_with_nonzero_copy_bytes",
+                requested=decision.get("layout_copy_bytes"),
+                available=0,
+            )
+        )
+    if resolved == "materialized" and decision.get("materialize_allowed") is not True:
+        errors.append(
+            _error(
+                "layout_decision.materialize_allowed",
+                "materialized_without_materialize_permission",
+                requested=decision.get("materialize_allowed"),
+                available=True,
+            )
+        )
+    if runtime_alias_check and decision.get("alias_check") != "verified_distinct":
+        errors.append(
+            _error(
+                "layout_decision.alias_check",
+                "layout_alias_check_not_verified",
+                requested=decision.get("alias_check"),
+                available="verified_distinct",
+            )
+        )
+    return tuple(errors)
+
+
+def layout_rule_errors(payload: Mapping[str, Any]) -> Tuple[Mapping[str, Any], ...]:
+    """Require the plan rule trace to agree with the frozen decision."""
+
+    decision = payload.get("layout_decision")
+    if not isinstance(decision, Mapping):
+        return (_error("layout_decision", "layout_decision_missing"),)
+    resolution = payload.get("resolution")
+    rules = resolution.get("rules") if isinstance(resolution, Mapping) else None
+    if not isinstance(rules, list):
+        return (_error("resolution.rules", "plan_layout_rule_missing"),)
+    matching = [
+        rule
+        for rule in rules
+        if isinstance(rule, Mapping) and rule.get("rule") == "layout.alias_proof"
+    ]
+    if len(matching) != 1:
+        return (
+            _error(
+                "resolution.rules",
+                "plan_layout_rule_missing",
+                requested=len(matching),
+                available=1,
+            ),
+        )
+    details = matching[0].get("details")
+    details = details if isinstance(details, Mapping) else {}
+    alias_proof = decision.get("alias_proof")
+    alias_proof = alias_proof if isinstance(alias_proof, Mapping) else {}
+    expected = {
+        "requested_view_mode": decision.get("requested_view_mode"),
+        "resolved_view_mode": decision.get("resolved_view_mode"),
+        "view_obligation": decision.get("view_obligation"),
+        "alias_proof_status": alias_proof.get("status"),
+        "alias_proof_digest": decision.get("alias_proof_digest"),
+        "failed_conditions": list(alias_proof.get("failed_conditions", [])),
+        "layout_copy_bytes": decision.get("layout_copy_bytes"),
+    }
+    errors = []
+    for key, value in expected.items():
+        if details.get(key) != value:
+            errors.append(
+                _error(
+                    "resolution.rules.layout.alias_proof.{}".format(key),
+                    "plan_layout_rule_decision_mismatch",
+                    requested=details.get(key),
+                    available=value,
+                )
+            )
+    if matching[0].get("outcome") != "ok":
+        errors.append(
+            _error(
+                "resolution.rules.layout.alias_proof.outcome",
+                "plan_layout_rule_decision_mismatch",
+                requested=matching[0].get("outcome"),
+                available="ok",
+            )
+        )
+    return tuple(errors)
+
+
+def layout_decision_errors(
+    decision: Mapping[str, Any],
+    *,
+    definition: Optional[Any] = None,
+    layout_policy_document: Optional[Mapping[str, Any]] = None,
+    runtime_alias_check: bool = False
+) -> Tuple[Mapping[str, Any], ...]:
+    """All layout-decision refusals available at the caller's layer.
+
+    ``definition`` adds the registered-contract cross-check and, together with
+    ``layout_policy_document``, the canonical re-derivation comparison.
+    """
+
+    if not isinstance(decision, Mapping):
+        return (_error("layout_decision", "layout_decision_not_a_mapping"),)
+    errors = list(alias_proof_errors(decision, runtime_alias_check=runtime_alias_check))
+    if definition is not None:
+        obligation = decision.get("view_obligation")
+        if obligation != definition.view_obligation:
+            errors.append(
+                _error(
+                    "layout_decision.view_obligation",
+                    "layout_view_obligation_contract_mismatch",
+                    requested=obligation,
+                    available=definition.view_obligation,
+                )
+            )
+        alias_proof = decision.get("alias_proof")
+        facts = alias_proof.get("facts") if isinstance(alias_proof, Mapping) else None
+        contract_facts = facts.get("contract") if isinstance(facts, Mapping) else None
+        contract_facts = contract_facts if isinstance(contract_facts, Mapping) else {}
+        if contract_facts.get("opcode") != definition.canonical_opcode:
+            errors.append(
+                _error(
+                    "layout_decision.alias_proof.facts.contract.opcode",
+                    "alias_proof_opcode_mismatch",
+                    requested=contract_facts.get("opcode"),
+                    available=definition.canonical_opcode,
+                )
+            )
+        if layout_policy_document is not None:
+            try:
+                expected = canonical_layout_decision(definition, layout_policy_document)
+            except ExecutionError as exc:
+                errors.append(
+                    _error(
+                        "layout_decision",
+                        "layout_decision_not_satisfiable:{}".format(exc.reason or exc.code),
+                        requested=decision.get("requested_view_mode"),
+                        available={
+                            "reason": exc.reason,
+                            "code": exc.code,
+                            "failed_conditions": exc.details.get("failed_conditions")
+                            if isinstance(exc.details, Mapping)
+                            else None,
+                        },
+                    )
+                )
+            else:
+                for key, value in expected.items():
+                    if key == "alias_check" and runtime_alias_check:
+                        continue
+                    if decision.get(key) != value:
+                        errors.append(
+                            _error(
+                                "layout_decision.{}".format(key),
+                                "layout_decision_contract_mismatch",
+                                requested=decision.get(key),
+                                available=value,
+                            )
+                        )
+    return tuple(errors)
+
+
+def raise_first_layout_error(
+    errors: Sequence[Mapping[str, Any]],
+    error_type: Callable[..., Any],
+    field_prefix: str = "plan."
+) -> None:
+    """Raise the first structured layout error through a layer-specific class."""
+
+    if not errors:
+        return
+    first = errors[0]
+    raise error_type(
+        "layout decision failed {} validation: {}".format(first.get("reason"), first.get("field")),
+        field=field_prefix + str(first.get("field")),
+        requested=first.get("requested"),
+        available=first.get("available"),
+        reason=first.get("reason"),
+        details={"errors": [dict(item) for item in errors]},
+    )
+
+
+__all__ = [
+    "alias_proof_errors",
+    "canonical_layout_decision",
+    "layout_decision_errors",
+    "layout_intent_from_document",
+    "layout_rule_errors",
+    "matmul_view_capability",
+    "matmul_view_contract",
+    "raise_first_layout_error",
+]
