+def _verify_plan_layout_decision(plan: ExecutionPlan, definition: Any) -> None:
+    """Cross-check the frozen layout decision against the registered contract.
+
+    ``ExecutionPlan.validate`` already rejects content-local inconsistencies
+    (recomputed alias-proof digest, obligation invariants, rule/decision
+    agreement).  This second gate re-derives the canonical decision from the
+    frozen policy and the registered ``OpDefinition``, so a forgery that also
+    recomputes every digest is still refused before any provider is invoked.
+    """
+
+    if plan.contract_digest != definition.contract_digest:
+        raise ArtifactMismatchError(
+            "plan contract digest does not match the registered OpDefinition",
+            field="plan.contract.digest",
+            requested=plan.contract_digest,
+            available=definition.contract_digest,
+            reason="contract_digest_mismatch",
+        )
+    payload = plan.payload
+    policy_layout = None
+    policy_document = payload.get("policy")
+    if isinstance(policy_document, Mapping):
+        requested_document = policy_document.get("requested")
+        if isinstance(requested_document, Mapping):
+            candidate = requested_document.get("layout")
+            if isinstance(candidate, Mapping):
+                policy_layout = candidate
+    errors = layout_decision_errors(
+        payload["layout_decision"],
+        definition=definition,
+        layout_policy_document=policy_layout,
+    )
+    if not errors:
+        return
+    first = errors[0]
+    raise ArtifactMismatchError(
+        "plan layout decision failed {} validation: {}".format(
+            first.get("reason"), first.get("field")
+        ),
+        field="plan." + str(first.get("field")),
+        requested=first.get("requested"),
+        available=first.get("available"),
+        reason=first.get("reason"),
+        details={"errors": [dict(item) for item in errors]},
+    )
+
+
 def _execute(
