+def test_binding_runtime_rejects_name_order_readonly_address_and_kind():
+    scalar_type = CoreType.scalar("float32")
+    tensor_type = CoreType.tensor("float32", (2,))
+    scalar = ValueRef("scale", scalar_type)
+    tensor = ValueRef("x", tensor_type)
+    output = ValueRef("y", tensor_type)
+    program = _program(
+        "binding_runtime",
+        (scalar, tensor),
+        (output,),
+        (Operation("mul", (tensor, scalar), (output,)),),
+    )
+    compiler, target_ir, artifact = _compile(program)
+    source = HostTensor("float32", (2,), [1, 2])
+    destination = HostTensor.zeros("float32", (2,))
+    descriptors = {
+        "inputs": [_descriptor(source, True)],
+        "outputs": [_descriptor(destination)],
+        "scalars": {"scale": 2.0},
+    }
+
+    def run(bindings):
+        return GpuCommonSimulator().launch(
+            GpuLaunchRequest(
+                artifact,
+                target_ir.plans[0].geometry,
+                argument_bindings=bindings,
+                **descriptors,
+            )
+        )
+
+    valid = (
+        KernelArgumentBinding("scale", 0, "scalar", None, readonly=False),
+        KernelArgumentBinding("x", 1, "tensor", AddressSpace.GLOBAL, readonly=True),
+        KernelArgumentBinding("y", 2, "tensor", AddressSpace.GLOBAL, readonly=False),
+    )
+    run(valid)
+    for bad in (
+        (
+            KernelArgumentBinding("wrong", 0, "scalar", None),
+            valid[1],
+            valid[2],
+        ),
+        (
+            valid[1],
+            valid[0],
+            valid[2],
+        ),
+        (
+            KernelArgumentBinding("scale", 0, "scalar", None),
+            KernelArgumentBinding("x", 1, "tensor", AddressSpace.GLOBAL, readonly=False),
+            valid[2],
+        ),
+        (
+            valid[0],
+            KernelArgumentBinding("x", 1, "tensor", AddressSpace.CONSTANT, readonly=True),
+            valid[2],
+        ),
+    ):
+        with pytest.raises(GpuExecutionError, match="binding|readonly|address|name|kind"):
+            run(bad)
+    tampered = KernelArgumentBinding("x", 1, "tensor", AddressSpace.GLOBAL, readonly=True)
+    object.__setattr__(tampered, "kind", "scalar")
+    with pytest.raises(GpuExecutionError, match="kind"):
+        run((valid[0], tampered, valid[2]))
+
