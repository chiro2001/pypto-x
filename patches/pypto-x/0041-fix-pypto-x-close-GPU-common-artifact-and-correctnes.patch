+def test_cache_key_same_semantics_and_real_tile_subgroup_specialization_options_variants():
+    program = _add_program((7,))
+    compiler = GpuCommonCompiler()
+    base_target = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+    base = compiler.compile(compiler.lower(program, base_target))
+    same = compiler.compile(compiler.lower(program, TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})))
+    assert same.cache_key == base.cache_key
+    variants = (
+        compiler.compile(
+            compiler.lower(
+                program,
+                TargetSpec(
+                    "gpu",
+                    "gpu-neutral",
+                    attributes={"workgroup": (4,), "tile": {"output": (64,), "reduction": (8,)}},
+                ),
+            )
+        ),
+        compiler.compile(
+            compiler.lower(
+                program,
+                TargetSpec(
+                    "gpu",
+                    "gpu-neutral",
+                    attributes={"workgroup": (4,), "subgroup_size": 32, "supported_subgroup_sizes": (32,)},
+                ),
+            )
+        ),
+        compiler.compile(
+            compiler.lower(
+                program,
+                TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,), "specialization": {"N": 7}}),
+            )
+        ),
+        compiler.compile(compiler.lower(program, base_target), CompileOptions(metadata={"option": 1})),
+    )
+    assert all(variant.cache_key != base.cache_key for variant in variants)
