diff --git a/python/pypto/abi/gpu_tokens.py b/python/pypto/abi/gpu_tokens.py
new file mode 100644
index 000000000..4a1d59bef
--- /dev/null
+++ b/python/pypto/abi/gpu_tokens.py
@@ -0,0 +1,61 @@
+"""Shared vendor-token boundary checks for the GPU common contracts."""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Mapping, Optional
+
+
+VENDOR_TERMS = (
+    "cuda",
+    "nvidia",
+    "amd",
+    "rocm",
+    "hip",
+    "nvvm",
+    "ptx",
+    "nvptx",
+    "amdgpu",
+    "amdgcn",
+    "rocdl",
+    "warp",
+    "wavefront",
+    "wmma",
+    "mfma",
+)
+_VENDOR_TOKEN_RE = re.compile(
+    r"(?<![A-Za-z0-9])(?:" + "|".join(re.escape(term) for term in VENDOR_TERMS) + r")(?![A-Za-z0-9])",
+    re.IGNORECASE,
+)
+
+
+def find_vendor_term(value: Any, context: str = "value") -> Optional[str]:
+    """Return the first offending path, using token/namespace boundaries.
+
+    An ordinary word such as ``relationship`` is allowed even though its
+    suffix happens to contain the letters ``hip``.  Namespaced or delimited
+    values such as ``hip-target`` and ``cuda_stream`` remain rejected.
+    """
+
+    if isinstance(value, str):
+        if _VENDOR_TOKEN_RE.search(value):
+            return context
+        return None
+    if isinstance(value, Mapping):
+        for key, item in value.items():
+            found = find_vendor_term(key, "{}.key".format(context))
+            if found is not None:
+                return found
+            found = find_vendor_term(item, "{}.{}".format(context, key))
+            if found is not None:
+                return found
+        return None
+    if isinstance(value, (list, tuple, set, frozenset)):
+        for index, item in enumerate(value):
+            found = find_vendor_term(item, "{}[{}]".format(context, index))
+            if found is not None:
+                return found
+    return None
+
+
+__all__ = ["VENDOR_TERMS", "find_vendor_term"]
