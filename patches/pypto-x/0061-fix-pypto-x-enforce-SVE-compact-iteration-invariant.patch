From: Chiro <chiro2001@163.com>
Date: Wed, 9 Sep 2026 02:41:05 +0800
Subject: [PATCH 061/256] fix(pypto-x): enforce SVE compact iteration invariant

---
 python/pypto/lowering/cpu/aarch64/sve/lowering.py | 23 ++++++++++++++++++
 python/tests/ut/pypto_x/test_cpu_sve256.py        | 56 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+)

diff --git a/python/pypto/lowering/cpu/aarch64/sve/lowering.py b/python/pypto/lowering/cpu/aarch64/sve/lowering.py
index e1f35377f..1efdd1da4 100644
--- a/python/pypto/lowering/cpu/aarch64/sve/lowering.py
+++ b/python/pypto/lowering/cpu/aarch64/sve/lowering.py
@@ -194,6 +194,29 @@ class Sve256Program:
                     ",".join(sorted(required))
                 )
             )
+        for plan in self.vector_program.plans:
+            iteration_domains = [("iteration", plan.iteration)]
+            if plan.reduction is not None:
+                iteration_domains.extend(
+                    (
+                        ("reduction.output_iteration", plan.reduction.output_iteration),
+                        ("reduction.reduction_iteration", plan.reduction.reduction_iteration),
+                    )
+                )
+            if plan.matmul is not None:
+                iteration_domains.extend(
+                    (
+                        ("matmul.output_iteration", plan.matmul.output_iteration),
+                        ("matmul.reduction_iteration", plan.matmul.reduction_iteration),
+                    )
+                )
+            for domain_name, iteration in iteration_domains:
+                if not iteration.compact:
+                    raise Sve256ValidationError(
+                        "SVE256 lowering version 4 requires compact {} for {!r}".format(
+                            domain_name, plan.operation
+                        )
+                    )
         function = next(
             function for function in self.vector_program.program.functions
             if function.name == self.vector_program.entrypoint
