 )
+from pypto.lowering.cpu.vector import lower_cpu_vector, make_iteration_plan
 from pypto.lowering.cpu.aarch64.sve import capabilities as capabilities_module
 from pypto.target import TargetSpec
 from pypto_x.harness import compare_outputs
@@ -265,6 +266,61 @@ def test_sve_v3_plan_and_artifact_are_explicitly_incompatible_after_compact_bump
         Sve256Runtime(execution_mode="qemu").load(old_artifact)
 
 
+def test_sve_v4_compact_iteration_invariant_covers_nested_domains():
+    programs = (
+        _elementwise(shape=(9,)),
+        _reduction("float32", (2, 3), (2,), "reduce_sum", {"axis": 1}),
+        _matmul("float32", (1, 3), (3, 1)),
+    )
+    manual_target = TargetSpec(
+        "cpu",
+        "aarch64-linux-gnu",
+        features=("sve", "vl256"),
+        attributes={"vl_bytes": 32},
+    )
+    for program in programs:
+        valid = lower_sve256(program, _target("sve", "sve2"))
+        Sve256Program(valid.vector_program, lowering_version=4).validate()
+
+        legacy = lower_cpu_vector(
+            program,
+            manual_target,
+            lane_count=8,
+            tail_policy="masked",
+            required_features=("sve", "vl256"),
+            specialization={},
+        )
+        with pytest.raises(Sve256ValidationError, match="requires compact iteration"):
+            Sve256Program(legacy, lowering_version=4)
+
+    for program, nested_name in (
+        (_reduction("float32", (2, 3), (2,), "reduce_sum", {"axis": 1}), "reduction.output_iteration"),
+        (_matmul("float32", (1, 3), (3, 1)), "matmul.output_iteration"),
+    ):
+        legacy = lower_cpu_vector(
+            program,
+            manual_target,
+            lane_count=8,
+            tail_policy="masked",
+            required_features=("sve", "vl256"),
+            specialization={},
+        )
+        plan = legacy.plans[0]
+        object.__setattr__(
+            plan,
+            "iteration",
+            make_iteration_plan(
+                plan.element_count,
+                plan.lane_count,
+                plan.contiguous_axis,
+                plan.tail_policy,
+                compact=True,
+            ),
+        )
+        with pytest.raises(Sve256ValidationError, match=nested_name):
+            Sve256Program(legacy, lowering_version=4)
+
+
