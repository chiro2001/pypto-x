+def _elementwise_shape_program(operation_name, input_shapes, output_shape):
+    refs = []
+    for index, shape in enumerate(input_shapes):
+        refs.append(ValueRef("input{}".format(index), CoreType.tensor("float32", shape)))
+    output = ValueRef("output", CoreType.tensor("float32", output_shape))
+    operation = Operation(operation_name, tuple(refs), (output,))
+    return CoreProgram(
+        functions=(CoreFunction("main", tuple(refs), (output,), Region((operation,))),)
+    )
+
