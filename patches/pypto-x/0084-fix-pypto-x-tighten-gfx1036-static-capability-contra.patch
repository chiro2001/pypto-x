+def validate_static_operation(operation: Operation) -> str:
+    """Validate exactly the operation subset emitted by the static backend.
+
+    The lowerer and the metadata-only model capability audit both call this
+    function.  Keeping the predicate here prevents the audit from counting an
+    operation merely because its name happens to be in the C1 list.
+    """
+
+    try:
+        name = canonical_operation_name(operation.name)
+    except Exception as exc:
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU backend explicitly rejects operation {!r}; supported operations are {}".format(
+                operation.name, ", ".join(AMDGPU_STATIC_SUPPORTED_OPERATIONS)
+            )
+        ) from exc
+    if name not in _SUPPORTED_OPS:
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU backend explicitly rejects operation {!r}; supported operations are {}".format(
+                name, ", ".join(AMDGPU_STATIC_SUPPORTED_OPERATIONS)
+            )
+        )
+    if name in ("identity", "add", "mul"):
+        expected_inputs = 1 if name == "identity" else 2
+        if len(operation.inputs) != expected_inputs:
+            raise AmdgpuUnsupportedError(
+                "static AMDGPU {} requires {} input tensors".format(name, expected_inputs)
+            )
+        _validate_tensor_pair(operation, name, require_exact_shape=True)
+        return name
+    if name == "reduce_sum":
+        if len(operation.inputs) != 1:
+            raise AmdgpuUnsupportedError("static AMDGPU reduce_sum requires one input tensor")
+        dtype, output_shape = _validate_tensor_pair(operation, name)
+        del dtype
+        input_shape = static_shape(operation.inputs[0].type, "AMDGPU reduce_sum input")
+        raw_axes = operation.attributes.get("axes", operation.attributes.get("axis"))
+        if raw_axes is None:
+            axes = tuple(range(len(input_shape)))
+        elif isinstance(raw_axes, int) and not isinstance(raw_axes, bool):
+            axes = (raw_axes,)
+        else:
+            try:
+                axes = tuple(raw_axes)
+            except TypeError as exc:
+                raise AmdgpuUnsupportedError("static AMDGPU reduce_sum axes are invalid") from exc
+        normalized_axes = tuple(sorted(axis + len(input_shape) if axis < 0 else axis for axis in axes))
+        if normalized_axes != tuple(range(len(input_shape))) or _element_count(output_shape) != 1:
+            raise AmdgpuUnsupportedError(
+                "static AMDGPU reduce_sum C1 supports only reduction over all axes into one element"
+            )
+        return name
+    if name == "matmul":
+        if len(operation.inputs) != 2:
+            raise AmdgpuUnsupportedError("static AMDGPU matmul requires two input tensors")
+        _validate_tensor_pair(operation, name)
+        left_shape = static_shape(operation.inputs[0].type, "AMDGPU matmul left")
+        right_shape = static_shape(operation.inputs[1].type, "AMDGPU matmul right")
+        output_shape = static_shape(operation.outputs[0].type, "AMDGPU matmul output")
+        if len(left_shape) != 2 or len(right_shape) != 2 or len(output_shape) != 2:
+            raise AmdgpuUnsupportedError("static AMDGPU matmul C1 supports rank-2 matrices only")
+        if left_shape[1] != right_shape[0] or output_shape != (left_shape[0], right_shape[1]):
+            raise AmdgpuUnsupportedError("static AMDGPU matmul shapes are inconsistent")
+        return name
+    raise AmdgpuUnsupportedError("static AMDGPU operation validation is incomplete")
+
