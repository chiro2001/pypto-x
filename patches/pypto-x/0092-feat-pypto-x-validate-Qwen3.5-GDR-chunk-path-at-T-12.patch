+#!/usr/bin/env python3
+"""Qwen3.5-0.8B GDR T=128 acceptance driver (closes ``gdr_t128_not_validated``).
+
+This driver builds the *unmodified* public Qwen3.5 GDR recurrent-state graph
+(:func:`pypto.portable.qwen35.build_qwen35_gdr_recurrent_state`) at the fixed
+model shape (H=16, K=V=128, state ``[B,H,K,V]``) with ``T=128`` and records:
+
+* per-backend lowering/compile facts (plan count, iteration domains, compact
+  flags, empty chunk lists, plan/artifact/ELF bytes, peak RSS);
+* real execution of the T=128 prefill chunk against an independent NumPy
+  token-by-token sequential reference (prediction/state/output);
+* a T=1 decode entry that carries ``new_state`` produced by the chunk, plus an
+  optional 128-step T=1 carry chain compared with the single chunk launch;
+* input immutability and guarded canary checks.
+
+Two graph variants are used deliberately:
+
+``plain``    the shipped public program (2 returns: ``output``, ``new_state``);
+``observe``  the identical SSA graph with the 128 internal ``step_t_predicted``
+             values appended as extra returns.  Only the return list changes;
+             no operation, plan, or contract is modified.  The augmented
+             variant exists because the public ABI intentionally exposes only
+             ``output`` and ``new_state``.
+
+Every sub-command handles exactly one backend in one process so that the raw
+log stays auditable and RSS stays bounded.  All tensors are synthetic; no
+model or checkpoint file is read.
+
+Usage (all heavy commands must run through ``run_local_heavy.sh``)::
+
+    PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=<worktree>/python \\
+        python3 qwen35_gdr_t128_driver.py lower --backend sve256 --steps 128 \\
+        --work-dir <dir> --report <dir>/sve256_lower.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import resource
+import struct
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.portable.qwen35 import build_qwen35_gdr_recurrent_state
+from pypto.target import TargetSpec
+
+
+BACKENDS = ("scalar", "vector", "avx2", "avx512", "sve256")
+QWEN_BATCH = 1
+QWEN_HEADS = 16
+QWEN_KEY_DIM = 128
+QWEN_VALUE_DIM = 128
+QWEN_SCALE = 128 ** -0.5
+INPUT_SEED = 20260910
+GUARD_HEAD = 0xA5
+GUARD_TAIL = 0x5A
+PREDICTION_PREFIX = "step_{}_predicted"
+
+
+# ---------------------------------------------------------------------------
+# input generation and independent sequential reference
+# ---------------------------------------------------------------------------
+
+
+def _bf16_round(values):
+    """Round an FP32 array to BF16 (round-to-nearest-even), returning FP32."""
+
+    fp32 = np.asarray(values, dtype=np.float32)
+    bits = fp32.view(np.uint32).astype(np.uint32)
+    exponent_mask = np.uint32(0x7F800000)
+    guard = np.uint32(0x7FFF) + ((bits >> np.uint32(16)) & np.uint32(1))
+    finite = (bits & exponent_mask) != exponent_mask
+    rounded = np.where(finite, (bits + guard) & np.uint32(0xFFFF0000), bits & np.uint32(0xFFFF0000))
+    return rounded.astype(np.uint32).view(np.float32).copy()
+
+
+def _l2_normalize(values):
+    fp32 = np.asarray(values, dtype=np.float32)
+    norm = np.sqrt(np.sum(fp32.astype(np.float64) ** 2, axis=-1, keepdims=True))
+    norm = np.maximum(norm, 1.0e-12)
+    return (fp32 / norm.astype(np.float32)).astype(np.float32)
+
+
+def build_inputs(steps):
+    """Deterministic non-symmetric BF16/FP32 inputs for ``steps + 1`` tokens."""
+
+    total = steps + 1
+    rng = np.random.RandomState(INPUT_SEED)
+    query = _bf16_round(_l2_normalize(rng.uniform(-0.5, 0.5, (total, QWEN_HEADS, QWEN_KEY_DIM))))
+    key = _bf16_round(_l2_normalize(rng.uniform(-0.5, 0.5, (total, QWEN_HEADS, QWEN_KEY_DIM))))
+    value = _bf16_round(rng.uniform(-0.6, 0.6, (total, QWEN_HEADS, QWEN_VALUE_DIM)))
+    gate = (-0.05 - 0.05 * rng.uniform(0.0, 1.0, (total, QWEN_HEADS))).astype(np.float32)
+    beta = _bf16_round(0.10 + 0.50 * rng.uniform(0.0, 1.0, (total, QWEN_HEADS)))
+    prior = (rng.uniform(-0.05, 0.05, (QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM))).astype(np.float32)
+    return {
+        "query": query,
+        "key": key,
+        "value": value,
+        "gate": gate,
+        "beta": beta,
+        "prior_state": prior,
+    }
+
+
+def sequential_reference(inputs, steps, dtype=np.float64):
+    """Token-by-token GDR reference: the independent sequential oracle.
+
+    ``S_decay = exp(g) * S``; ``predicted = k @ S_decay``;
+    ``S_new = S_decay + (beta*k)^T @ (v - predicted)``;
+    ``output = scale * q @ S_new``.
+    """
+
+    query = inputs["query"][:steps].astype(dtype)
+    key = inputs["key"][:steps].astype(dtype)
+    value = inputs["value"][:steps].astype(dtype)
+    gate = inputs["gate"][:steps].astype(dtype)
+    beta = inputs["beta"][:steps].astype(dtype)
+    state = inputs["prior_state"].astype(dtype).copy()
+    outputs = np.zeros((steps, QWEN_HEADS, QWEN_VALUE_DIM), dtype=dtype)
+    predictions = np.zeros((steps, QWEN_HEADS, QWEN_VALUE_DIM), dtype=dtype)
+    for time_index in range(steps):
+        decay = np.exp(gate[time_index])
+        decayed = state * decay[:, None, None]
+        predicted = np.einsum("hk,hkv->hv", key[time_index], decayed)
+        delta = value[time_index] - predicted
+        beta_key = beta[time_index][:, None] * key[time_index]
+        state = decayed + np.einsum("hk,hv->hkv", beta_key, delta)
+        predictions[time_index] = predicted
+        outputs[time_index] = (QWEN_SCALE * np.einsum("hk,hkv->hv", query[time_index], state)).astype(dtype)
+    return outputs, state, predictions
+
+
+# ---------------------------------------------------------------------------
+# graph construction
+# ---------------------------------------------------------------------------
+
+
+def build_program(steps):
+    return build_qwen35_gdr_recurrent_state(QWEN_BATCH, steps)
+
+
+def _value_refs(program):
+    found = {}
+    for operation in program.functions[0].body.operations:
+        for ref in operation.outputs:
+            found[ref.name] = ref
+    return found
+
+
+def build_observe_program(steps):
+    """Return the same SSA graph with every ``step_t_predicted`` observable."""
+
+    from pypto.core_ir import CoreFunction, CoreProgram
+
+    program = build_program(steps)
+    function = program.functions[0]
+    refs = _value_refs(program)
+    extra = []
+    for time_index in range(steps):
+        name = PREDICTION_PREFIX.format(time_index)
+        if name not in refs:
+            raise SystemExit("missing observable prediction value {!r}".format(name))
+        extra.append(refs[name])
+    returns = tuple(function.returns) + tuple(extra)
+    observed = CoreFunction(function.name, function.parameters, returns, function.body)
+    return CoreProgram(functions=(observed,), metadata=program.metadata)
+
+
+# ---------------------------------------------------------------------------
+# lowering / compile helpers
+# ---------------------------------------------------------------------------
+
+
+def _target(backend):
+    if backend == "scalar":
+        return TargetSpec("cpu", "x86_64-linux-gnu")
+    if backend == "vector":
+        return TargetSpec(
+            "cpu",
+            "x86_64-linux-gnu",
+            attributes={"lane_count": 4, "specialization": {"compact_iteration": True}},
+        )
+    if backend == "avx2":
+        return TargetSpec(
+            "cpu",
+            "x86_64-linux-gnu",
+            features=("avx", "avx2", "osxsave", "ymm"),
+            attributes={"lane_count": 8},
+        )
+    if backend == "avx512":
+        return TargetSpec(
+            "cpu",
+            "x86_64-linux-gnu",
+            features=("avx512f",),
+            attributes={"lane_count": 16},
+        )
+    if backend == "sve256":
+        return TargetSpec(
+            "cpu",
+            "aarch64-linux-gnu",
+            features=("sve", "sve2"),
+            attributes={"vl_bytes": 32},
+        )
+    raise SystemExit("unknown backend {!r}".format(backend))
+
+
+def _compiler(backend):
+    if backend == "scalar":
+        from pypto.compiler.targets.cpu import CpuScalarCompiler
+
+        return CpuScalarCompiler()
+    if backend == "vector":
+        from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+
+        return CpuVectorCompiler()
+    if backend == "avx2":
+        from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+
+        return Avx2Compiler()
+    if backend == "avx512":
+        from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+
+        return Avx512Compiler()
+    if backend == "sve256":
+        from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+
+        return Sve256Compiler()
+    raise SystemExit("unknown backend {!r}".format(backend))
+
+
+def _artifact_format(backend):
+    return {
+        "scalar": "pypto-x.cpu.scalar",
+        "vector": "pypto-x.cpu.vector.common",
+        "avx2": "pypto-x.cpu.avx2",
+        "avx512": "pypto-x.cpu.avx512",
+        "sve256": "pypto-x.cpu.sve256",
+    }[backend]
+
+
+def _plans(target_ir):
+    plans = getattr(target_ir, "plans", None)
+    if plans is None:
+        vector_program = getattr(target_ir, "vector_program", None)
+        plans = None if vector_program is None else vector_program.plans
+    return None if plans is None else tuple(plans)
+
+
+def _iteration_nodes(value, path="root"):
+    found = []
+    if isinstance(value, dict):
+        if "compact" in value and "chunks" in value:
+            found.append((path, value))
+        for key, child in value.items():
+            found.extend(_iteration_nodes(child, "{}.{}".format(path, key)))
+    elif isinstance(value, list):
+        for index, child in enumerate(value):
+            found.extend(_iteration_nodes(child, "{}[{}]".format(path, index)))
+    return found
+
+
+def _target_ir_dict(target_ir):
+    if hasattr(target_ir, "to_dict"):
+        return dict(target_ir.to_dict())
+    raise SystemExit("target IR {} has no to_dict()".format(type(target_ir).__name__))
+
+
+def lower_program(backend, program):
+    compiler = _compiler(backend)
+    return compiler.lower(program, _target(backend))
+
+
+def compile_target_ir(backend, target_ir, build_dir):
+    from pypto.compiler import CompileOptions
+
+    compiler = _compiler(backend)
+    options = CompileOptions(
+        artifact_format=_artifact_format(backend),
+        extra={"build_dir": str(build_dir)},
+    )
+    return compiler.compile(target_ir, options)
+
+
+def describe_lowering(backend, target_ir):
+    """Plan/iteration-domain facts for one target IR.
+
+    The scalar backend has no vector plan construct at all: its lowering output
+    is the validated ``CoreProgram`` itself.  That case is reported explicitly
+    instead of being confused with a plan whose compact flag is false.
+    """
+
+    plans = _plans(target_ir)
+    if plans is None:
+        program = getattr(target_ir, "program", None)
+        core_bytes = (
+            len(program.canonical_json().encode("utf-8")) if program is not None else None
+        )
+        described = {
+            "backend": backend,
+            "plan_count": 0,
+            "iteration_domain_count": 0,
+            "iteration_compact_all": None,
+            "iteration_chunks_empty_all": None,
+            "plan_bytes": core_bytes if core_bytes is not None else 0,
+            "plan_construct": "none_scalar_core_program",
+            "target_ir_class": type(target_ir).__name__,
+            "core_program_bytes": core_bytes,
+        }
+        lowering_version = getattr(target_ir, "lowering_version", None)
+        if lowering_version is not None:
+            described["lowering_version"] = lowering_version
+        return described
+
+    data = _target_ir_dict(target_ir)
+    nodes = _iteration_nodes(data)
+    plan_bytes = len(json.dumps(data, sort_keys=True, separators=(",", ":")).encode("utf-8"))
+    compact_flags = [bool(node["compact"]) for _path, node in nodes]
+    chunk_lists = [list(node["chunks"]) for _path, node in nodes]
+    described = {
+        "backend": backend,
+        "plan_count": len(plans),
+        "iteration_domain_count": len(nodes),
+        "iteration_compact_all": all(compact_flags) if compact_flags else None,
+        "iteration_chunks_empty_all": all(len(chunks) == 0 for chunks in chunk_lists) if chunk_lists else None,
+        "plan_bytes": plan_bytes,
+        "plan_construct": "vector_plan",
+        "target_ir_class": type(target_ir).__name__,
+    }
+    for name in ("lowering_version", "plan_version"):
+        value = getattr(target_ir, name, None)
+        if value is not None:
+            described[name] = value
+    if plans:
+        plan_versions = getattr(plans[0], "plan_version", None)
+        if plan_versions is not None:
+            described["vector_plan_version"] = plan_versions
+    return described
+
+
+# ---------------------------------------------------------------------------
+# execution helpers
+# ---------------------------------------------------------------------------
+
+
+def _nbytes(dtype, count):
+    return count * (2 if dtype == "bf16" else 4)
+
+
+def element_count(shape):
+    total = 1
+    for value in shape:
+        total *= value
+    return total
+
+
+class GuardedOutput:
+    """Output descriptor backed by a bytearray with head/tail canaries."""
+
+    def __init__(self, dtype, shape):
+        self.dtype = dtype
+        self.shape = tuple(shape)
+        self.count = element_count(self.shape)
+        self.raw = bytearray(b"\xA5" + b"\x00" * _nbytes(dtype, self.count) + b"\x5A")
+        self.descriptor = TensorDesc(dtype, self.shape, handle=memoryview(self.raw)[1:-1])
+
+    def body(self):
+        return bytes(self.raw[1:-1])
+
+    def canary_ok(self):
+        return self.raw[0] == GUARD_HEAD and self.raw[-1] == GUARD_TAIL
+
+    def values(self):
+        return decode_values(self.dtype, self.body(), self.count)
+
+
+class HostOutput:
+    """Fallback output backed by a HostTensor (vector-common rejects byte views)."""
+
+    def __init__(self, dtype, shape):
+        from pypto.backends.cpu import HostTensor
+
+        self.tensor = HostTensor.zeros(dtype, shape)
+        self.dtype = dtype
+        self.shape = tuple(shape)
+        self.count = element_count(self.shape)
+        self.descriptor = self.tensor.descriptor()
+
+    def body(self):
+        raise NotImplementedError("HostTensor output has no byte view")
+
+    def canary_ok(self):
+        return None
+
+    def values(self):
+        return np.asarray(self.tensor.data, dtype=np.float64)
+
+
+def make_outputs(backend, dtype, shape):
+    """Guarded byte view where supported, HostTensor for vector-common."""
+
+    if backend == "vector":
+        return HostOutput(dtype, shape)
+    return GuardedOutput(dtype, shape)
+
+
+def _canary_state(items):
+    flags = [item.canary_ok() for item in items]
+    known = [flag for flag in flags if flag is not None]
+    if not known:
+        return None
+    return all(known)
+
+
+def decode_values(dtype, payload, count):
+    if dtype == "float32":
+        return np.frombuffer(payload, dtype="<f4", count=count).astype(np.float64)
+    bits = np.frombuffer(payload, dtype="<u2", count=count).astype(np.uint32)
+    return (bits << np.uint32(16)).view(np.float32).astype(np.float64)
+
+
+def host_inputs(inputs, steps, token_offset=0):
+    """HostTensor inputs for one chunk starting at ``token_offset``."""
+
+    from pypto.backends.cpu import HostTensor
+
+    def slice_time(name, dtype):
+        array = inputs[name][token_offset : token_offset + steps]
+        return HostTensor(dtype, (QWEN_BATCH, steps) + array.shape[1:], array.reshape(-1).tolist())
+
+    return [
+        slice_time("query", "bf16"),
+        slice_time("key", "bf16"),
+        slice_time("value", "bf16"),
+        slice_time("gate", "float32"),
+        slice_time("beta", "bf16"),
+        HostTensor(
+            "float32",
+            (QWEN_BATCH, QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM),
+            inputs["prior_state"].reshape(-1).tolist(),
+        ),
+    ]
+
+
+def make_runtime(backend):
+    if backend == "scalar":
+        from pypto.backends.cpu import CpuScalarRuntime
+
+        return CpuScalarRuntime()
+    if backend == "vector":
+        from pypto.backends.cpu.vector import CpuVectorRuntime
+
+        return CpuVectorRuntime()
+    if backend == "avx2":
+        from pypto.backends.cpu.x86 import Avx2Runtime
+
+        return Avx2Runtime()
+    if backend == "avx512":
+        from pypto.backends.cpu.x86 import Avx512Runtime
+
+        return Avx512Runtime()
+    if backend == "sve256":
+        from pypto.backends.cpu.aarch64.sve256 import Sve256Runtime
+
+        return Sve256Runtime(execution_mode="qemu")
+    raise SystemExit("unknown backend {!r}".format(backend))
+
+
+def _runtime_availability(runtime):
+    availability = getattr(runtime, "availability", None)
+    if availability is None:
+        return None
+    try:
+        return availability().to_dict()
+    except Exception as exc:  # pragma: no cover - defensive reporting only
+        return {"probe_error": str(exc)}
+
+
+def guarded_self_test(runtime, artifact):
+    checker = None
+    for name in ("guarded_self_test", "guarded_buffer_self_test"):
+        candidate = getattr(runtime, name, None)
+        if candidate is not None:
+            checker = candidate
+            break
+    if checker is None:
+        return None
+    try:
+        checker(artifact)
+        return True
+    except Exception as exc:
+        return "FAILED: {}".format(exc)
+
+
+def execute_chunk(backend, steps, work_dir, inputs, observe=True, plain=False, carry=False, carry_chain=False):
+    """Execute the T=128 chunk + decode entries and compare with the reference."""
+
+    from pypto.compiler import CompileOptions
+
+    result = {
+        "backend": backend,
+        "steps": steps,
+        "qwen_scale": QWEN_SCALE,
+        "observations": [],
+        "failures": [],
+    }
+    runtime = make_runtime(backend)
+    result["runtime_available"] = getattr(runtime, "is_available", lambda: None)()
+    result["runtime_availability"] = _runtime_availability(runtime)
+    if result["runtime_available"] is False:
+        result["status"] = "SKIPPED_UNAVAILABLE"
+        return result
+
+    chunk_program = build_observe_program(steps) if observe else build_program(steps)
+    compiler = _compiler(backend)
+    target_ir = compiler.lower(chunk_program, _target(backend))
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format=_artifact_format(backend),
+            extra={"build_dir": str(Path(work_dir) / (backend + "_observe_build"))},
+        ),
+    )
+    result["observe_variant"] = bool(observe)
+    result["artifact_metadata"] = {
+        key: artifact.metadata[key]
+        for key in ("backend", "lowering_version", "plan_version", "artifact_payload_version")
+        if key in artifact.metadata
+    }
+    result["guarded_self_test"] = guarded_self_test(runtime, artifact)
+    if artifact.path is not None and Path(artifact.path).is_file():
+        result["artifact_bytes"] = Path(artifact.path).stat().st_size
+        result["artifact_sha256"] = hashlib.sha256(Path(artifact.path).read_bytes()).hexdigest()
+
+    loaded = runtime.load(artifact)
+    result["loaded_plan_count"] = len(_plans(loaded.target_ir) or ())
+
+    chunk_inputs = host_inputs(inputs, steps, 0)
+    snapshots = [list(item.data) for item in chunk_inputs]
+    outputs = []
+    for ref in chunk_program.functions[0].returns:
+        outputs.append(make_outputs(backend, ref.type.dtype, ref.type.shape))
+    request = LaunchRequest(
+        artifact,
+        inputs=[item.descriptor(readonly=True) for item in chunk_inputs],
+        outputs=[item.descriptor for item in outputs],
+        scalars={"scale": QWEN_SCALE},
+    )
+    started = time.time()
+    runtime.launch(request)
+    chunk_seconds = time.time() - started
+    result["chunk_wall_seconds"] = chunk_seconds
+    result["chunk_seconds_per_step"] = chunk_seconds / steps
+    result["chunk_launch_calls"] = 1
+    result["input_immutable"] = all(
+        item.data == snapshot for item, snapshot in zip(chunk_inputs, snapshots)
+    )
+    result["guard_canary_ok"] = _canary_state(outputs)
+
+    output = outputs[0].values().reshape(steps, QWEN_HEADS, QWEN_VALUE_DIM)
+    new_state = outputs[1].values().reshape(QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM)
+    predictions = np.stack(
+        [item.values().reshape(QWEN_HEADS, QWEN_VALUE_DIM) for item in outputs[2:]]
+    ) if observe else None
+    result["chunk_output_bytes_sha256"] = hashlib.sha256(
+        np.asarray(output, dtype=np.float64).tobytes()
+    ).hexdigest()
+    result["chunk_state_bytes_sha256"] = hashlib.sha256(
+        np.asarray(new_state, dtype=np.float64).tobytes()
+    ).hexdigest()
+
+    ref64_output, ref64_state, ref64_pred = sequential_reference(inputs, steps, np.float64)
+    ref32_output, ref32_state, ref32_pred = sequential_reference(inputs, steps, np.float32)
+    bf16_ref_output = _bf16_round(ref64_output).astype(np.float64)
+
+    comparison = {
+        "output_vs_bf16_rounded_reference": float(np.max(np.abs(output - bf16_ref_output))),
+        "output_vs_fp64_reference": float(np.max(np.abs(output - ref64_output))),
+        "output_reference_bf16_quantization": float(np.max(np.abs(bf16_ref_output - ref64_output))),
+        "state_vs_fp64_reference": float(np.max(np.abs(new_state - ref64_state))),
+        "state_vs_fp32_reference": float(np.max(np.abs(new_state - ref32_state.astype(np.float64)))),
+        "state_reference_fp32_noise": float(np.max(np.abs(ref32_state.astype(np.float64) - ref64_state))),
+        "nonzero_output": bool(np.max(np.abs(output)) > 1.0e-6),
+        "nonzero_state": bool(np.max(np.abs(new_state)) > 1.0e-6),
+    }
+    if predictions is not None:
+        comparison["prediction_vs_fp64_reference"] = float(np.max(np.abs(predictions - ref64_pred)))
+        comparison["prediction_vs_fp32_reference"] = float(np.max(np.abs(predictions - ref32_pred.astype(np.float64))))
+    result["comparison"] = comparison
+
+    # T=1 decode entry that carries the chunk's new_state for the next token.
+    decode_program = build_program(1)
+    decode_artifact = compiler.compile(
+        compiler.lower(decode_program, _target(backend)),
+        CompileOptions(
+            artifact_format=_artifact_format(backend),
+            extra={"build_dir": str(Path(work_dir) / (backend + "_decode_build"))},
+        ),
+    )
+    decode_runtime = make_runtime(backend)
+    decode_runtime.load(decode_artifact)
+    if carry:
+        carry_inputs = host_inputs(inputs, 1, steps)
+        carry_inputs[5] = _state_host_tensor(new_state)
+        carry_snapshots = [list(item.data) for item in carry_inputs]
+        carry_outputs = [
+            make_outputs(backend, "bf16", (1, 1, QWEN_HEADS, QWEN_VALUE_DIM)),
+            make_outputs(backend, "float32", (1, QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM)),
+        ]
+        started = time.time()
+        decode_runtime.launch(
+            LaunchRequest(
+                decode_artifact,
+                inputs=[item.descriptor(readonly=True) for item in carry_inputs],
+                outputs=[item.descriptor for item in carry_outputs],
+                scalars={"scale": QWEN_SCALE},
+            )
+        )
+        decode_seconds = time.time() - started
+        full_output, full_state, _full_pred = sequential_reference(inputs, steps + 1, np.float64)
+        total = steps + 1
+        _ = total
+        carry_output = carry_outputs[0].values().reshape(QWEN_HEADS, QWEN_VALUE_DIM)
+        carry_state = carry_outputs[1].values().reshape(QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM)
+        result["decode_carry"] = {
+            "wall_seconds": decode_seconds,
+            "launch_calls": 1,
+            "prior_state_from_chunk_new_state": True,
+            "input_immutable": all(
+                item.data == snapshot for item, snapshot in zip(carry_inputs, carry_snapshots)
+            ),
+            "guard_canary_ok": _canary_state(carry_outputs),
+            "output_vs_reference": float(
+                np.max(np.abs(carry_output - _bf16_round(full_output[steps]).astype(np.float64)))
+            ),
+            "state_vs_reference": float(np.max(np.abs(carry_state - full_state))),
+        }
+
+    if plain:
+        plain_result = _execute_plain(backend, steps, work_dir, inputs, runtime_available=result["runtime_available"])
+        result["plain_variant"] = plain_result
+
+    if carry_chain:
+        result["carry_chain"] = _execute_carry_chain(backend, steps, work_dir, inputs, output, new_state)
+
+    result["peak_rss_kib"] = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    result["children_peak_rss_kib"] = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+    result["status"] = "PASS"
+    return result
+
+
+def _state_host_tensor(state):
+    from pypto.backends.cpu import HostTensor
+
+    return HostTensor(
+        "float32",
+        (QWEN_BATCH, QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM),
+        np.asarray(state, dtype=np.float32).reshape(-1).tolist(),
+    )
+
+
+def _execute_plain(backend, steps, work_dir, inputs, runtime_available=None):
+    """Execute the unmodified 2-return public artifact at T=128."""
+
+    from pypto.compiler import CompileOptions
+
+    compiler = _compiler(backend)
+    program = build_program(steps)
+    artifact = compiler.compile(
+        compiler.lower(program, _target(backend)),
+        CompileOptions(
+            artifact_format=_artifact_format(backend),
+            extra={"build_dir": str(Path(work_dir) / (backend + "_plain_build"))},
+        ),
+    )
+    runtime = make_runtime(backend)
+    runtime.load(artifact)
+    chunk_inputs = host_inputs(inputs, steps, 0)
+    outputs = [
+        make_outputs(backend, "bf16", (1, steps, QWEN_HEADS, QWEN_VALUE_DIM)),
+        make_outputs(backend, "float32", (1, QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM)),
+    ]
+    started = time.time()
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in chunk_inputs],
+            outputs=[item.descriptor for item in outputs],
+            scalars={"scale": QWEN_SCALE},
+        )
+    )
+    elapsed = time.time() - started
+    ref64_output, ref64_state, _ref64_pred = sequential_reference(inputs, steps, np.float64)
+    output = outputs[0].values().reshape(steps, QWEN_HEADS, QWEN_VALUE_DIM)
+    state = outputs[1].values().reshape(QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM)
+    if artifact.path is not None and Path(artifact.path).is_file():
+        payload = Path(artifact.path).read_bytes()
+    else:
+        payload = bytes(artifact.payload or b"")
+    return {
+        "wall_seconds": elapsed,
+        "artifact_bytes": len(payload),
+        "artifact_sha256": hashlib.sha256(payload).hexdigest(),
+        "guard_canary_ok": _canary_state(outputs),
+        "output_bytes_sha256": hashlib.sha256(np.asarray(outputs[0].values(), dtype=np.float64).tobytes()).hexdigest(),
+        "state_bytes_sha256": hashlib.sha256(np.asarray(outputs[1].values(), dtype=np.float64).tobytes()).hexdigest(),
+        "output_vs_bf16_rounded_reference": float(
+            np.max(np.abs(output - _bf16_round(ref64_output).astype(np.float64)))
+        ),
+        "state_vs_fp64_reference": float(np.max(np.abs(state - ref64_state))),
+    }
+
+
+def _execute_carry_chain(backend, steps, work_dir, inputs, chunk_output, chunk_state):
+    """Feed the chunk one token at a time (128 x T=1) and compare with the chunk."""
+
+    from pypto.compiler import CompileOptions
+
+    compiler = _compiler(backend)
+    program = build_program(1)
+    artifact = compiler.compile(
+        compiler.lower(program, _target(backend)),
+        CompileOptions(
+            artifact_format=_artifact_format(backend),
+            extra={"build_dir": str(Path(work_dir) / (backend + "_chain_build"))},
+        ),
+    )
+    runtime = make_runtime(backend)
+    runtime.load(artifact)
+    state = inputs["prior_state"].astype(np.float32).copy()
+    outputs = np.zeros((steps, QWEN_HEADS, QWEN_VALUE_DIM), dtype=np.float64)
+    started = time.time()
+    for time_index in range(steps):
+        decode_inputs = host_inputs(inputs, 1, time_index)
+        decode_inputs[5] = _state_host_tensor(state)
+        decode_outputs = [
+            make_outputs(backend, "bf16", (1, 1, QWEN_HEADS, QWEN_VALUE_DIM)),
+            make_outputs(backend, "float32", (1, QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM)),
+        ]
+        runtime.launch(
+            LaunchRequest(
+                artifact,
+                inputs=[item.descriptor(readonly=True) for item in decode_inputs],
+                outputs=[item.descriptor for item in decode_outputs],
+                scalars={"scale": QWEN_SCALE},
+            )
+        )
+        outputs[time_index] = decode_outputs[0].values().reshape(QWEN_HEADS, QWEN_VALUE_DIM)
+        state = decode_outputs[1].values().reshape(QWEN_HEADS, QWEN_KEY_DIM, QWEN_VALUE_DIM).astype(np.float32)
+    elapsed = time.time() - started
+    return {
+        "wall_seconds": elapsed,
+        "launch_calls": steps,
+        "seconds_per_step": elapsed / steps,
+        "output_vs_chunk": float(np.max(np.abs(outputs - chunk_output))),
+        "state_vs_chunk": float(np.max(np.abs(state.astype(np.float64) - chunk_state))),
+    }
+
+
+# ---------------------------------------------------------------------------
+# sub-commands
+# ---------------------------------------------------------------------------
+
+
+def command_lower(args):
+    work_dir = Path(args.work_dir)
+    work_dir.mkdir(parents=True, exist_ok=True)
+    report = {
+        "command": "lower",
+        "backend": args.backend,
+        "steps": args.steps,
+        "target": _target(args.backend).to_dict(),
+    }
+    program = build_program(args.steps)
+    report["program"] = {
+        "operations": len(program.functions[0].body.operations),
+        "parameters": [ref.name for ref in program.functions[0].parameters],
+        "returns": [ref.name for ref in program.functions[0].returns],
+        "metadata_keys": sorted(program.metadata.keys()),
+        "unroll": program.metadata.get("unroll"),
+        "state_shape": list(program.functions[0].parameters[5].type.shape),
+    }
+    started = time.time()
+    target_ir = lower_program(args.backend, program)
+    report["lower_seconds"] = time.time() - started
+    report["lowering"] = describe_lowering(args.backend, target_ir)
+    started = time.time()
+    artifact = compile_target_ir(args.backend, target_ir, work_dir / (args.backend + "_build"))
+    report["compile_seconds"] = time.time() - started
+    if artifact.path is not None and Path(artifact.path).is_file():
+        payload = Path(artifact.path).read_bytes()
+        report["artifact_kind"] = "file"
+        report["artifact_path"] = str(artifact.path)
+    else:
+        payload = bytes(artifact.payload or b"")
+        report["artifact_kind"] = "payload"
+    report["artifact_bytes"] = len(payload)
+    report["artifact_sha256"] = hashlib.sha256(payload).hexdigest()
+    report["artifact_metadata"] = {
+        key: artifact.metadata[key]
+        for key in sorted(artifact.metadata.keys())
+        if key
+        in (
+            "backend",
+            "lowering_version",
+            "plan_version",
+            "artifact_payload_version",
+            "vector_plan_version",
+            "batched_matmul_fallback",
+            "guarded_self_test",
+        )
+    }
+    if artifact.metadata.get("vector_plan") is not None:
+        vector_plan = artifact.metadata["vector_plan"]
+        report["vector_plan_metadata_keys"] = (
+            sorted(vector_plan.keys()) if hasattr(vector_plan, "keys") else None
+        )
+    runtime = make_runtime(args.backend)
+    available = getattr(runtime, "is_available", lambda: None)()
+    report["runtime_available"] = available
+    report["runtime_availability"] = _runtime_availability(runtime)
+    if available:
+        loaded = runtime.load(artifact)
+        report["loaded_plan_count"] = len(_plans(loaded.target_ir) or ())
+        report["guarded_self_test"] = guarded_self_test(runtime, artifact)
+    report["observe_variant"] = describe_lowering(
+        args.backend, lower_program(args.backend, build_observe_program(args.steps))
+    )
+    report["peak_rss_kib"] = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    report["children_peak_rss_kib"] = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+    report["status"] = "PASS"
+    _write_report(args.report, report)
+    return 0
+
+
+def command_execute(args):
+    work_dir = Path(args.work_dir)
+    work_dir.mkdir(parents=True, exist_ok=True)
+    inputs = build_inputs(args.steps)
+    report = execute_chunk(
+        args.backend,
+        args.steps,
+        work_dir,
+        inputs,
+        observe=not args.no_observe,
+        plain=args.plain,
+        carry=not args.no_carry,
+        carry_chain=args.carry_chain,
+    )
+    report["command"] = "execute"
+    if args.backend == "sve256" and report.get("status") == "PASS":
+        report["sve_runner_subprocess_calls_estimate"] = report.get("loaded_plan_count")
+    _write_report(args.report, report)
+    return 0 if report.get("status") == "PASS" or report.get("status") == "SKIPPED_UNAVAILABLE" else 1
+
+
+def command_reference(args):
+    inputs = build_inputs(args.steps)
+    ref64_output, ref64_state, ref64_pred = sequential_reference(inputs, args.steps, np.float64)
+    ref32_output, ref32_state, _ref32_pred = sequential_reference(inputs, args.steps, np.float32)
+    report = {
+        "command": "reference",
+        "steps": args.steps,
+        "shape": {
+            "query": list(inputs["query"].shape),
+            "state": list(inputs["prior_state"].shape),
+        },
+        "output_checksum": float(np.sum(ref64_output)),
+        "state_checksum": float(np.sum(ref64_state)),
+        "prediction_checksum": float(np.sum(ref64_pred)),
+        "output_max_abs": float(np.max(np.abs(ref64_output))),
+        "state_max_abs": float(np.max(np.abs(ref64_state))),
+        "fp32_vs_fp64_output": float(np.max(np.abs(ref32_output.astype(np.float64) - ref64_output))),
+        "fp32_vs_fp64_state": float(np.max(np.abs(ref32_state.astype(np.float64) - ref64_state))),
+        "bf16_output_rounding": float(
+            np.max(np.abs(_bf16_round(ref64_output).astype(np.float64) - ref64_output))
+        ),
+        "status": "PASS",
+    }
+    _write_report(args.report, report)
+    return 0
+
+
+def _json_default(value):
+    """Serialize frozen mappings and ABI objects that leak into reports."""
+
+    from collections.abc import Mapping as _Mapping
+
+    if isinstance(value, _Mapping):
+        return dict(value)
+    if isinstance(value, (tuple, list, set)):
+        return list(value)
+    to_dict = getattr(value, "to_dict", None)
+    if callable(to_dict):
+        return to_dict()
+    return repr(value)
+
+
+def _write_report(path, report):
+    text = json.dumps(report, indent=2, sort_keys=True, default=_json_default)
+    if path:
+        Path(path).parent.mkdir(parents=True, exist_ok=True)
+        Path(path).write_text(text + "\n", encoding="utf-8")
+    print(text)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command")
+    lower = sub.add_parser("lower")
+    lower.add_argument("--backend", choices=BACKENDS, required=True)
+    lower.add_argument("--steps", type=int, default=128)
+    lower.add_argument("--work-dir", required=True)
+    lower.add_argument("--report")
+    lower.set_defaults(func=command_lower)
+
+    execute = sub.add_parser("execute")
+    execute.add_argument("--backend", choices=BACKENDS, required=True)
+    execute.add_argument("--steps", type=int, default=128)
+    execute.add_argument("--work-dir", required=True)
+    execute.add_argument("--report")
+    execute.add_argument("--no-observe", action="store_true")
+    execute.add_argument("--plain", action="store_true")
+    execute.add_argument("--no-carry", action="store_true")
+    execute.add_argument("--carry-chain", action="store_true")
+    execute.set_defaults(func=command_execute)
+
+    reference = sub.add_parser("reference")
+    reference.add_argument("--steps", type=int, default=128)
+    reference.add_argument("--report")
+    reference.set_defaults(func=command_reference)
+
+    args = parser.parse_args(argv)
+    if not getattr(args, "func", None):
+        parser.print_help()
+        return 64
+    return args.func(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
