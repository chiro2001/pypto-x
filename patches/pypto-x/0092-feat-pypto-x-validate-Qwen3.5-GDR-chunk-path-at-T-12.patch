+#!/usr/bin/env python3
+"""Kunpeng 920B native T=128 Qwen3.5 GDR acceptance driver (stdlib only).
+
+The static SVE256 ELF built by the pypto-x SVE256 backend is used exactly as
+its documented runtime contract allows: as a rank-2 native matmul runner.  The
+rank-4 ``[B,H,K,V]`` traversal, the ``exp(g)`` decay and the FP32 state update
+stay in this host loop, matching the frozen contract
+``sve_batched_matmul = host_batch_loop_rank2_runner`` and the M1G native
+evidence pattern.  This driver therefore proves *native SVE execution of every
+T=128 matmul in the GDR recurrence*, not a fused native chunk kernel.
+
+Everything is synthetic; no model or checkpoint is read.  The script only uses
+the Python standard library because the ECS has no NumPy or Torch.
+
+Usage on the ECS::
+
+    python3 qwen35_gdr_t128_920b_driver.py <static-sve256.elf> [--steps 128]
+"""
+
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import json
+import math
+import operator
+import os
+import platform
+import struct
+import subprocess
+import sys
+import time
+
+
+REQUEST = struct.Struct("<6I4Q")
+RESPONSE = struct.Struct("<4IQ")
+MAGIC = int.from_bytes(b"PXSV", "little")
+MATMUL = 8
+DTYPES = {"float32": 0, "bf16": 1}
+
+BATCH = 1
+HEADS = 16
+KEY_DIM = 128
+VALUE_DIM = 128
+DEFAULT_STEPS = 128
+INPUT_SEED = 20260910
+
+
+def count(shape):
+    result = 1
+    for value in shape:
+        result *= value
+    return result
+
+
+def bf16_bits(value):
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return (bits >> 16) & 0xFFFF
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def bf16_value(bits):
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+def bf16_round(value):
+    return bf16_value(bf16_bits(value))
+
+
+class Lcg:
+    """Deterministic 31-bit LCG so hosts without NumPy agree on inputs."""
+
+    def __init__(self, seed):
+        self.state = seed & 0x7FFFFFFF
+
+    def uniform(self):
+        self.state = (self.state * 1103515245 + 12345) & 0x7FFFFFFF
+        return self.state / float(0x7FFFFFFF)
+
+
+def pack_values(dtype, values):
+    if dtype == "float32":
+        return struct.pack("<{}f".format(len(values)), *[float(value) for value in values])
+    return struct.pack("<{}H".format(len(values)), *[bf16_bits(value) for value in values])
+
+
+def decode_values(dtype, payload, count_value):
+    if dtype == "float32":
+        return list(struct.unpack("<{}f".format(count_value), payload)) if count_value else []
+    bits = struct.unpack("<{}H".format(count_value), payload) if count_value else ()
+    return [bf16_value(value) for value in bits]
+
+
+def available_kib():
+    values = {}
+    with open("/proc/meminfo", "r") as stream:
+        for line in stream:
+            key, value = line.split(":", 1)
+            if key in ("MemTotal", "MemAvailable"):
+                values[key] = int(value.split()[0])
+    return values
+
+
+def hwcap():
+    try:
+        libc = ctypes.CDLL(None, use_errno=True)
+        libc.getauxval.restype = ctypes.c_ulong
+        return int(libc.getauxval(16))
+    except Exception as exc:  # pragma: no cover - reporting only
+        return "unavailable: {}".format(exc)
+
+
+def vl_bytes():
+    libc = ctypes.CDLL(None)
+    libc.prctl.restype = ctypes.c_int
+    return libc.prctl(51, 0, 0, 0, 0) & 65535
+
+
+def probe(artifact):
+    machine = platform.machine()
+    if machine != "aarch64":
+        raise RuntimeError("native machine is not aarch64: {}".format(machine))
+    features = ""
+    with open("/proc/cpuinfo", "r") as stream:
+        for line in stream:
+            if line.startswith("Features"):
+                features = line.split(":", 1)[1].strip()
+                break
+    feature_list = features.split()
+    if "sve" not in feature_list:
+        raise RuntimeError("SVE is missing from /proc/cpuinfo")
+    raw_vl = vl_bytes()
+    if raw_vl != 32:
+        raise RuntimeError("unexpected SVE VL: {}".format(raw_vl))
+    memory = available_kib()
+    if memory.get("MemAvailable", 0) < 512 * 1024:
+        raise RuntimeError("insufficient native MemAvailable KiB: {}".format(memory))
+    contract = subprocess.run(
+        [artifact, "--contract"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        check=False, timeout=60,
+    )
+    if contract.returncode != 0:
+        raise RuntimeError("contract probe failed: {!r}".format(contract.stderr))
+    raw_hwcap = hwcap()
+    return {
+        "architecture": machine,
+        "sve": True,
+        "sve2": "sve2" in feature_list,
+        "vl_bytes": raw_vl,
+        "hwcap": raw_hwcap,
+        "hwcap_sve_bit_22": bool(raw_hwcap & (1 << 22)) if isinstance(raw_hwcap, int) else None,
+        "mem_kib": memory,
+        "python": platform.python_version(),
+        "emulated": False,
+        "contract": contract.stdout.decode("ascii", "replace").strip().splitlines(),
+    }
+
+
+def guarded_self_test(artifact):
+    result = subprocess.run(
+        [artifact, "--guarded-self-test"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        check=False, timeout=120,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(
+            "guarded self-test failed exit={} stdout={!r} stderr={!r}".format(
+                result.returncode, result.stdout, result.stderr
+            )
+        )
+
+
+def run_matmul(artifact, dtype, left, right, m, k, n, timeout=120):
+    count_value = m * n
+    header = REQUEST.pack(MAGIC, 3, MATMUL, DTYPES[dtype], 0, 0, count_value, m, k, n)
+    completed = subprocess.run(
+        [artifact],
+        input=header + pack_values(dtype, left) + pack_values(dtype, right),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=timeout,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError("matmul exit={} stderr={!r}".format(completed.returncode, completed.stderr))
+    if len(completed.stdout) < RESPONSE.size:
+        raise RuntimeError("matmul returned a short response")
+    magic, version, status, response_dtype, response_count = RESPONSE.unpack(completed.stdout[: RESPONSE.size])
+    if (magic, version, status, response_dtype, response_count) != (
+        MAGIC,
+        3,
+        0,
+        DTYPES[dtype],
+        count_value,
+    ):
+        raise RuntimeError(
+            "matmul response mismatch: {!r}".format((magic, version, status, response_dtype, response_count))
+        )
+    item_size = 4 if dtype == "float32" else 2
+    return decode_values(
+        dtype,
+        completed.stdout[RESPONSE.size : RESPONSE.size + response_count * item_size],
+        response_count,
+    )
+
+
+def build_inputs(steps):
+    """T+1 deterministic tokens; every token differs across t/h/k/v."""
+
+    total = steps + 1
+    rng = Lcg(INPUT_SEED)
+    query = []
+    key = []
+    value = []
+    gate = []
+    beta = []
+    for _time in range(total):
+        for _head in range(HEADS):
+            q_row = [(rng.uniform() - 0.5) * 0.5 for _ in range(KEY_DIM)]
+            k_row = [(rng.uniform() - 0.5) * 0.5 for _ in range(KEY_DIM)]
+            q_norm = math.sqrt(sum(item * item for item in q_row)) or 1.0e-12
+            k_norm = math.sqrt(sum(item * item for item in k_row)) or 1.0e-12
+            query.extend(bf16_round(item / q_norm) for item in q_row)
+            key.extend(bf16_round(item / k_norm) for item in k_row)
+            value.extend(bf16_round((rng.uniform() - 0.5) * 1.2) for _ in range(VALUE_DIM))
+            gate.append(-0.05 - 0.05 * rng.uniform())
+            beta.append(bf16_round(0.10 + 0.50 * rng.uniform()))
+    prior = [rng.uniform() * 0.1 - 0.05 for _ in range(HEADS * KEY_DIM * VALUE_DIM)]
+    return {"query": query, "key": key, "value": value, "gate": gate, "beta": beta, "prior_state": prior}
+
+
+def run_chunk(artifact, steps, inputs):
+    """Execute every T=128 matmul natively and track the golden recurrence."""
+
+    heads, key_dim, value_dim = HEADS, KEY_DIM, VALUE_DIM
+    state_extent = key_dim * value_dim
+    scale = 1.0 / math.sqrt(float(key_dim))
+    golden_state = list(inputs["prior_state"])
+    native_state = list(inputs["prior_state"])
+    prediction_error = 0.0
+    update_error = 0.0
+    output_error = 0.0
+    outputs_nonzero = False
+    runner_calls = 0
+    output_checksum = 0.0
+    started = time.time()
+    for time_index in range(steps):
+        base_time = time_index * heads
+        for head in range(heads):
+            decay = math.exp(inputs["gate"][base_time + head])
+            beta_head = inputs["beta"][base_time + head]
+            head_base = head * state_extent
+            key_row = inputs["key"][(base_time + head) * key_dim : (base_time + head + 1) * key_dim]
+            value_row = inputs["value"][(base_time + head) * value_dim : (base_time + head + 1) * value_dim]
+            query_row = inputs["query"][(base_time + head) * key_dim : (base_time + head + 1) * key_dim]
+
+            # S_decay = exp(g) * S
+            decayed = [item * decay for item in native_state[head_base : head_base + state_extent]]
+            golden_decayed = [item * decay for item in golden_state[head_base : head_base + state_extent]]
+            native_state[head_base : head_base + state_extent] = decayed
+            golden_state[head_base : head_base + state_extent] = golden_decayed
+
+            # predicted = k @ S_decay, executed by the native SVE rank-2 matmul
+            predicted = run_matmul(artifact, "float32", key_row, decayed, 1, key_dim, value_dim)
+            runner_calls += 1
+            golden_predicted = [
+                sum(map(operator.mul, key_row, golden_decayed[column : state_extent : value_dim]))
+                for column in range(value_dim)
+            ]
+            prediction_error = max(
+                prediction_error,
+                max(abs(left - right) for left, right in zip(predicted, golden_predicted)),
+            )
+
+            delta = [left - right for left, right in zip(value_row, predicted)]
+            golden_delta = [left - right for left, right in zip(value_row, golden_predicted)]
+            beta_key = [beta_head * item for item in key_row]
+
+            # update = (beta*k)^T @ delta, executed natively
+            update = run_matmul(artifact, "float32", beta_key, delta, key_dim, 1, value_dim)
+            runner_calls += 1
+            golden_update = [
+                [beta_key[row] * item for item in golden_delta] for row in range(key_dim)
+            ]
+            update_error = max(
+                update_error,
+                max(
+                    abs(update[row * value_dim + column] - golden_update[row][column])
+                    for row in range(key_dim)
+                    for column in range(value_dim)
+                ),
+            )
+            for row in range(key_dim):
+                row_base = head_base + row * value_dim
+                beta_row = beta_key[row]
+                native_row = native_state[row_base : row_base + value_dim]
+                golden_row = golden_state[row_base : row_base + value_dim]
+                native_state[row_base : row_base + value_dim] = [
+                    item + update[row * value_dim + column]
+                    for column, item in enumerate(native_row)
+                ]
+                golden_state[row_base : row_base + value_dim] = [
+                    item + beta_row * golden_delta[column]
+                    for column, item in enumerate(golden_row)
+                ]
+
+            # output = scale * q @ S_new, executed natively on the native state
+            new_state_slice = native_state[head_base : head_base + state_extent]
+            emitted = run_matmul(artifact, "float32", query_row, new_state_slice, 1, key_dim, value_dim)
+            runner_calls += 1
+            golden_state_slice = golden_state[head_base : head_base + state_extent]
+            golden_emitted = [
+                scale
+                * sum(map(operator.mul, query_row, golden_state_slice[column : state_extent : value_dim]))
+                for column in range(value_dim)
+            ]
+            scaled = [scale * item for item in emitted]
+            output_error = max(
+                output_error,
+                max(abs(left - right) for left, right in zip(scaled, golden_emitted)),
+            )
+            if any(abs(item) > 1.0e-9 for item in scaled):
+                outputs_nonzero = True
+            output_checksum += sum(scaled)
+    elapsed = time.time() - started
+
+    state_error = max(abs(left - right) for left, right in zip(native_state, golden_state))
+    if not any(abs(item) > 1.0e-9 for item in native_state):
+        raise RuntimeError("native state is unexpectedly zero")
+    if not outputs_nonzero:
+        raise RuntimeError("native outputs are unexpectedly zero")
+    result = {
+        "steps": steps,
+        "shape": [BATCH, HEADS, KEY_DIM, VALUE_DIM],
+        "runner_rank": 2,
+        "runner_calls": runner_calls,
+        "host_batch_loop": True,
+        "host_elementwise_fallback": True,
+        "beta_dtype": "bf16",
+        "state_dtype": "float32",
+        "wall_seconds": elapsed,
+        "seconds_per_step": elapsed / steps,
+        "max_abs_prediction": prediction_error,
+        "max_abs_update": update_error,
+        "max_abs_state": state_error,
+        "max_abs_output": output_error,
+        "output_checksum": output_checksum,
+        "state_checksum": sum(native_state),
+        "state_first": native_state[:4],
+        "state_last": native_state[-4:],
+    }
+    return result, native_state, golden_state
+
+
+def run_decode_carry(artifact, steps, inputs, native_state, golden_state):
+    """One T=1 decode entry that carries the chunk's final states.
+
+    Both the native runner path and the pure-Python golden path advance one
+    extra token from the *same* state produced by the T=128 chunk, so the
+    result is a real carry-correctness check rather than a re-run.
+    """
+
+    heads, key_dim, value_dim = HEADS, KEY_DIM, VALUE_DIM
+    state_extent = key_dim * value_dim
+    scale = 1.0 / math.sqrt(float(key_dim))
+    base_time = steps * heads
+    state = list(native_state)
+    golden = list(golden_state)
+    prediction_error = 0.0
+    update_error = 0.0
+    output_error = 0.0
+    output_checksum = 0.0
+    runner_calls = 0
+    started = time.time()
+    for head in range(heads):
+        decay = math.exp(inputs["gate"][base_time + head])
+        beta_head = inputs["beta"][base_time + head]
+        head_base = head * state_extent
+        key_row = inputs["key"][(base_time + head) * key_dim : (base_time + head + 1) * key_dim]
+        value_row = inputs["value"][(base_time + head) * value_dim : (base_time + head + 1) * value_dim]
+        query_row = inputs["query"][(base_time + head) * key_dim : (base_time + head + 1) * key_dim]
+        state[head_base : head_base + state_extent] = [
+            item * decay for item in state[head_base : head_base + state_extent]
+        ]
+        golden[head_base : head_base + state_extent] = [
+            item * decay for item in golden[head_base : head_base + state_extent]
+        ]
+        decayed = state[head_base : head_base + state_extent]
+        golden_decayed = golden[head_base : head_base + state_extent]
+        predicted = run_matmul(artifact, "float32", key_row, decayed, 1, key_dim, value_dim)
+        runner_calls += 1
+        golden_predicted = [
+            sum(map(operator.mul, key_row, golden_decayed[column : state_extent : value_dim]))
+            for column in range(value_dim)
+        ]
+        prediction_error = max(
+            prediction_error,
+            max(abs(left - right) for left, right in zip(predicted, golden_predicted)),
+        )
+        delta = [left - right for left, right in zip(value_row, predicted)]
+        golden_delta = [left - right for left, right in zip(value_row, golden_predicted)]
+        beta_key = [beta_head * item for item in key_row]
+        update = run_matmul(artifact, "float32", beta_key, delta, key_dim, 1, value_dim)
+        runner_calls += 1
+        for row in range(key_dim):
+            row_base = head_base + row * value_dim
+            beta_row = beta_key[row]
+            update_error = max(
+                update_error,
+                max(
+                    abs(update[row * value_dim + column] - beta_row * golden_delta[column])
+                    for column in range(value_dim)
+                ),
+            )
+            state[row_base : row_base + value_dim] = [
+                item + update[row * value_dim + column]
+                for column, item in enumerate(state[row_base : row_base + value_dim])
+            ]
+            golden[row_base : row_base + value_dim] = [
+                item + beta_row * golden_delta[column]
+                for column, item in enumerate(golden[row_base : row_base + value_dim])
+            ]
+        emitted = run_matmul(
+            artifact, "float32", query_row, state[head_base : head_base + state_extent], 1, key_dim, value_dim
+        )
+        runner_calls += 1
+        golden_state_slice = golden[head_base : head_base + state_extent]
+        golden_emitted = [
+            scale
+            * sum(map(operator.mul, query_row, golden_state_slice[column : state_extent : value_dim]))
+            for column in range(value_dim)
+        ]
+        scaled = [scale * item for item in emitted]
+        output_error = max(
+            output_error,
+            max(abs(left - right) for left, right in zip(scaled, golden_emitted)),
+        )
+        output_checksum += sum(scaled)
+    elapsed = time.time() - started
+    return {
+        "entry": "T1_decode_with_chunk_new_state",
+        "runner_calls": runner_calls,
+        "wall_seconds": elapsed,
+        "max_abs_prediction": prediction_error,
+        "max_abs_update": update_error,
+        "max_abs_state": max(abs(left - right) for left, right in zip(state, golden)),
+        "max_abs_output": output_error,
+        "output_checksum": output_checksum,
+        "output_nonzero": any(abs(item) > 1.0e-9 for item in scaled),
+    }
+
+
+def main(argv):
+    if len(argv) < 2:
+        raise SystemExit("usage: qwen35_gdr_t128_920b_driver.py STATIC_SVE_ELF [--steps N] [--skip-carry]")
+    artifact = os.path.abspath(argv[1])
+    if not os.path.isfile(artifact):
+        raise SystemExit("artifact does not exist: {}".format(artifact))
+    steps = DEFAULT_STEPS
+    skip_carry = False
+    index = 2
+    while index < len(argv):
+        if argv[index] == "--steps":
+            steps = int(argv[index + 1])
+            index += 2
+        elif argv[index] == "--skip-carry":
+            skip_carry = True
+            index += 1
+        else:
+            raise SystemExit("unknown argument {!r}".format(argv[index]))
+
+    probe_data = probe(artifact)
+    guarded_self_test(artifact)
+    build_started = time.time()
+    inputs = build_inputs(steps)
+    build_seconds = time.time() - build_started
+    snapshots = (
+        tuple(inputs["query"][: 16 * 128]),
+        inputs["gate"][: HEADS],
+        inputs["prior_state"][: 16],
+    )
+    chunk, native_final_state, golden_final_state = run_chunk(artifact, steps, inputs)
+    decode = None
+    if not skip_carry:
+        decode = run_decode_carry(artifact, steps, inputs, native_final_state, golden_final_state)
+    inputs_unchanged = snapshots == (
+        tuple(inputs["query"][: 16 * 128]),
+        inputs["gate"][: HEADS],
+        inputs["prior_state"][: 16],
+    )
+    if not inputs_unchanged:
+        raise RuntimeError("native inputs changed during execution")
+    thresholds = {
+        "max_abs_prediction": 2.0e-4,
+        "max_abs_update": 2.0e-4,
+        "max_abs_state": 2.0e-4,
+        "max_abs_output": 2.0e-4,
+    }
+    for key, limit in thresholds.items():
+        if chunk[key] > limit:
+            raise RuntimeError("native T=128 mismatch {}={}".format(key, chunk[key]))
+    if decode is not None:
+        for key, limit in thresholds.items():
+            if decode[key] > limit:
+                raise RuntimeError("native T=1 decode mismatch {}={}".format(key, decode[key]))
+    with open(artifact, "rb") as stream:
+        digest = hashlib.sha256(stream.read()).hexdigest()
+    print("native_gdr_t128=PASS")
+    print("probe={}".format(json.dumps(probe_data, sort_keys=True)))
+    print("guarded_self_test=PASS")
+    print("input_build_seconds={}".format(build_seconds))
+    print("inputs_unchanged={}".format(inputs_unchanged))
+    print("gdr_chunk={}".format(json.dumps(chunk, sort_keys=True)))
+    if decode is not None:
+        print("decode_entry={}".format(json.dumps(decode, sort_keys=True)))
+    print("artifact_sha256={}".format(digest))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/python/tests/ut/pypto_x/qwen35_gdr_t128_driver.py b/python/tests/ut/pypto_x/qwen35_gdr_t128_driver.py
