+"""Bounded regression tests for the Qwen3.5 GDR T=128 acceptance driver.
+
+The real T=128 matrix is deliberately *not* executed here: it is a heavy,
+locked acceptance run whose raw logs live in the evidence directory.  These
+tests keep the driver's reference math, observability rewrite, guarded output
+buffer and end-to-end scalar comparison honest at a small step count.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from pypto.backends.cpu import CpuScalarRuntime
+from pypto.portable.qwen35 import build_qwen35_gdr_recurrent_state
+
+
+DRIVER_PATH = Path(__file__).with_name("qwen35_gdr_t128_driver.py")
+
+
+def _load_driver():
+    spec = importlib.util.spec_from_file_location("qwen35_gdr_t128_driver", DRIVER_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+driver = _load_driver()
+
+
+def test_fixed_qwen_t128_program_shape_is_static_ssa():
+    program = build_qwen35_gdr_recurrent_state(1, 128)
+    function = program.functions[0]
+    assert [ref.type.shape for ref in function.parameters] == [
+        (1, 128, 16, 128),
+        (1, 128, 16, 128),
+        (1, 128, 16, 128),
+        (1, 128, 16),
+        (1, 128, 16),
+        (1, 16, 128, 128),
+        (),
+    ]
+    assert [ref.name for ref in function.returns] == ["output", "new_state"]
+    assert [ref.type.shape for ref in function.returns] == [(1, 128, 16, 128), (1, 16, 128, 128)]
+    assert program.metadata["unroll"] == "static_sequential_reference"
+    assert len(function.body.operations) == 30 * 128 + 3
+
+
+def test_observe_program_only_appends_returns():
+    steps = 2
+    plain = driver.build_program(steps)
+    observed = driver.build_observe_program(steps)
+    assert [ref.name for ref in observed.functions[0].returns] == [
+        "output",
+        "new_state",
+        "step_0_predicted",
+        "step_1_predicted",
+    ]
+    assert len(observed.functions[0].body.operations) == len(plain.functions[0].body.operations)
+    assert observed.metadata == plain.metadata
+
+
+def test_sequential_reference_is_nonzero_and_tracks_fp32():
+    steps = 3
+    inputs = driver.build_inputs(steps)
+    fp64 = driver.sequential_reference(inputs, steps, np.float64)
+    fp32 = driver.sequential_reference(inputs, steps, np.float32)
+    output64, state64, predicted64 = fp64
+    output32, state32, predicted32 = fp32
+    assert np.max(np.abs(output64)) > 1.0e-3
+    assert np.max(np.abs(state64)) > 1.0e-3
+    assert np.max(np.abs(predicted64)) > 1.0e-4
+    # The FP32 oracle differs from FP64 only by accumulation noise.
+    assert np.max(np.abs(output32.astype(np.float64) - output64)) < 1.0e-4
+    assert np.max(np.abs(state32.astype(np.float64) - state64)) < 1.0e-4
+    # Token order matters: reversing the time axis must change the result.
+    reversed_inputs = dict(inputs)
+    for name in ("query", "key", "value", "gate", "beta"):
+        reversed_inputs[name] = inputs[name][::-1]
+    other = driver.sequential_reference(reversed_inputs, steps, np.float64)
+    assert np.max(np.abs(other[0] - output64)) > 1.0e-4
+
+
+def test_guarded_output_buffer_canary_and_decode():
+    output = driver.GuardedOutput("float32", (2, 3))
+    assert output.canary_ok()
+    assert output.descriptor.shape == (2, 3)
+    assert output.descriptor.storage is output.descriptor.storage
+    values = output.values()
+    assert values.shape == (6,)
+    assert float(np.max(np.abs(values))) == 0.0
+    output.raw[0] = 0x00
+    assert not output.canary_ok()
+
+
+def test_scalar_driver_end_to_end_matches_reference(tmp_path):
+    steps = 2
+    inputs = driver.build_inputs(steps)
+    runtime = CpuScalarRuntime()
+    assert runtime.is_available()
+    report = driver.execute_chunk(
+        "scalar",
+        steps,
+        tmp_path,
+        inputs,
+        observe=True,
+        plain=False,
+        carry=True,
+        carry_chain=False,
+    )
+    assert report["status"] == "PASS"
+    assert report["input_immutable"] is True
+    assert report["guard_canary_ok"] is True
+    comparison = report["comparison"]
+    assert comparison["nonzero_output"] and comparison["nonzero_state"]
+    assert comparison["state_vs_fp64_reference"] < 1.0e-5
+    assert comparison["prediction_vs_fp64_reference"] < 1.0e-5
+    assert comparison["output_vs_bf16_rounded_reference"] < 1.0e-6
+    assert report["decode_carry"]["state_vs_reference"] < 1.0e-5
+
+
+@pytest.mark.parametrize("backend", ["vector", "avx2", "avx512"])
+def test_x86_backends_execute_small_chunk_when_available(backend, tmp_path):
+    steps = 2
+    inputs = driver.build_inputs(steps)
+    report = driver.execute_chunk(
+        backend,
+        steps,
+        tmp_path,
+        inputs,
+        observe=True,
+        plain=False,
+        carry=False,
+        carry_chain=False,
+    )
+    if report.get("status") == "SKIPPED_UNAVAILABLE":
+        pytest.skip("{} runtime is unavailable: {}".format(backend, report["runtime_availability"]))
+    assert report["status"] == "PASS"
+    if backend != "vector":
+        assert report["guard_canary_ok"] is True
+    assert report["input_immutable"] is True
+    assert report["comparison"]["state_vs_fp64_reference"] < 1.0e-4
+    assert report["comparison"]["prediction_vs_fp64_reference"] < 1.0e-4
