index 19ecd8630..e0403d8df 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256.py
@@ -1563,3 +1563,200 @@ def test_sve_b2_integrated_native_control_pipeline_and_metadata(tmp_path, monkey
 def _scalar_artifact(program):
     compiler = CpuScalarCompiler()
     return compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+
+
+# --------------------------------------------------------------------------
+# SSA liveness release in the SVE256 launch loop (AVX-512 parity)
+# --------------------------------------------------------------------------
+
+
+class _RecordingSve256Runtime(Sve256Runtime):
+    """Records the live SSA environment and value kinds before every op."""
+
+    def __init__(self, *args, **kwargs):
+        kwargs.setdefault("execution_mode", "qemu")
+        super().__init__(*args, **kwargs)
+        self.live_before = []
+        self.kinds_before = []
+
+    def _execute_operation(self, operation, plan, environment, artifact):
+        self.live_before.append(frozenset(environment))
+        self.kinds_before.append(
+            {name: type(value).__name__ for name, (_, value) in environment.items()}
+        )
+        super()._execute_operation(operation, plan, environment, artifact)
+
+
+def _liveness_chain_program():
+    """a,b,c,d -> t0 -> (t1,t2) -> out, plus one value that dies immediately."""
+
+    value_type = CoreType.tensor("float32", (4,))
+    a = ValueRef("a", value_type)
+    b = ValueRef("b", value_type)
+    c = ValueRef("c", value_type)
+    d = ValueRef("d", value_type)
+    t0 = ValueRef("t0", value_type)
+    t1 = ValueRef("t1", value_type)
+    t2 = ValueRef("t2", value_type)
+    dead = ValueRef("dead", value_type)
+    out = ValueRef("out", value_type)
+    operations = (
+        Operation("add", (a, b), (t0,)),
+        Operation("mul", (t0, c), (t1,)),
+        Operation("add", (t0, d), (t2,)),
+        Operation("neg", (c,), (dead,)),
+        Operation("add", (t1, t2), (out,)),
+    )
+    return _program("liveness_chain", (a, b, c, d), (out,), operations)
+
+
+def _liveness_chain_inputs():
+    return [
+        HostTensor("float32", (4,), [float(index + 1) for index in range(4)]),
+        HostTensor("float32", (4,), [0.5] * 4),
+        HostTensor("float32", (4,), [2.0] * 4),
+        HostTensor("float32", (4,), [1.25] * 4),
+    ]
+
+
+def _float32_payload(values):
+    return b"".join(struct.pack("<f", float(value)) for value in values)
+
+
+def test_sve256_liveness_release_point_matches_avx512_and_is_bit_identical(tmp_path, monkeypatch):
+    import pypto.backends.cpu.aarch64.sve256 as sve256_module
+    from pypto.backends.cpu.ssa_liveness import plan_release
+
+    program = _liveness_chain_program()
+    function = program.functions[0]
+    last_use, pinned = plan_release(function)
+    assert last_use == {"a": 0, "b": 0, "c": 3, "t0": 2, "d": 2, "t1": 4, "t2": 4}
+    assert pinned == frozenset(("a", "b", "c", "d", "out"))
+
+    _, _, artifact = _compile(program, tmp_path / "release-on")
+    inputs = _liveness_chain_inputs()
+    released = []
+    original = sve256_module.release_dead_values
+
+    def spy_release(environment, last_use, pinned, index, used_names, produced_names):
+        result = original(environment, last_use, pinned, index, used_names, produced_names)
+        released.append(result)
+        return result
+
+    monkeypatch.setattr(sve256_module, "release_dead_values", spy_release)
+    actual_runtime = _RecordingSve256Runtime()
+    actual = HostTensor.zeros("float32", (4,))
+    actual_runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[actual.descriptor()],
+        )
+    )
+
+    # Same release schedule as the AVX-512 unit test: t0 dies at its last
+    # consumer (op 2), the never-consumed ``dead`` dies when produced, and the
+    # final operands die at the last add; every parameter stays pinned.
+    assert released == [(), (), ("t0",), ("dead",), ("t1", "t2")]
+    live = actual_runtime.live_before
+    assert live[0] == frozenset(("a", "b", "c", "d"))
+    assert live[1] == frozenset(("a", "b", "c", "d", "t0"))
+    assert "t0" in live[2]
+    assert "t0" not in live[4]
+    assert "dead" not in live[4]
+    assert frozenset(("a", "b", "c", "d", "t1", "t2")) <= live[4]
+
+    disabled_runtime = _RecordingSve256Runtime()
+    disabled = HostTensor.zeros("float32", (4,))
+    monkeypatch.setattr(sve256_module, "release_dead_values", lambda *args, **kwargs: ())
+    disabled_runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[disabled.descriptor()],
+        )
+    )
+    # A/B: with every release disabled, both the live trajectory and the output
+    # bits are exactly those of the release-enabled launch.
+    assert "t0" in disabled_runtime.live_before[4]
+    assert "dead" in disabled_runtime.live_before[4]
+    assert _float32_payload(actual.flat()) == _float32_payload(disabled.flat())
+
+    expected = HostTensor.zeros("float32", (4,))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            _scalar_artifact(program),
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[expected.descriptor()],
+        )
+    )
+    assert _float32_payload(actual.flat()) == _float32_payload(expected.flat())
+
+
+def test_sve256_release_never_drops_a_caller_owned_typed_view(tmp_path, monkeypatch):
+    np = pytest.importorskip("numpy")
+    import pypto.backends.cpu.aarch64.sve256 as sve256_module
+
+    value_type = CoreType.tensor("float32", (2, 3))
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    scale = ValueRef("scale", value_type)
+    total = ValueRef("total", value_type)
+    unused = ValueRef("unused", value_type)
+    output = ValueRef("output", value_type)
+    operations = (
+        Operation("add", (left, right), (total,)),
+        Operation("neg", (total,), (unused,)),
+        Operation("mul", (total, scale), (output,)),
+    )
+    program = _program("view_ownership", (left, right, scale), (output,), operations)
+    _, _, artifact = _compile(program, tmp_path / "view-ownership")
+
+    inputs = [
+        np.arange(6, dtype="<f4").reshape(2, 3),
+        np.full((2, 3), 0.5, dtype="<f4"),
+        np.full((2, 3), 3.0, dtype="<f4"),
+    ]
+    expected = (inputs[0] + inputs[1]) * inputs[2]
+    output = np.zeros((2, 3), dtype="<f4")
+
+    released = []
+    original = sve256_module.release_dead_values
+
+    def spy_release(environment, last_use, pinned, index, used_names, produced_names):
+        views = {
+            name
+            for name, (_, value) in environment.items()
+            if isinstance(value, sve256_module.TypedByteView)
+        }
+        result = original(environment, last_use, pinned, index, used_names, produced_names)
+        for name in result:
+            assert name not in views, "released a caller-owned typed view: {}".format(name)
+        released.append(result)
+        return result
+
+    monkeypatch.setattr(sve256_module, "release_dead_values", spy_release)
+    runtime = _RecordingSve256Runtime()
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[TensorDesc("float32", (2, 3), handle=item, readonly=True) for item in inputs],
+            outputs=[TensorDesc("float32", (2, 3), handle=output)],
+        )
+    )
+
+    # The numpy parameters really went through the non-owning TypedByteView
+    # path, and every non-parameter value the loop ever holds is a plain list
+    # produced by the runtime itself -- never a borrowed view or an ELF-owned
+    # buffer.
+    assert runtime.kinds_before[0]["left"] == "TypedByteView"
+    assert runtime.kinds_before[0]["right"] == "TypedByteView"
+    assert runtime.kinds_before[0]["scale"] == "TypedByteView"
+    for kinds in runtime.kinds_before:
+        for name, kind in kinds.items():
+            if name not in ("left", "right", "scale"):
+                assert kind == "list", (name, kind)
+    assert released == [(), ("unused",), ("total",)]
+    # The caller's buffer export survives the whole launch.
+    assert memoryview(inputs[0]).tobytes() == inputs[0].tobytes()
+    np.testing.assert_array_equal(output, expected)
