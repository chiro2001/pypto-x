index 000000000..e93dba8a3
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_w8a8_v2_packed_differential.py
@@ -0,0 +1,340 @@
+"""W8A8 contract 0010 v2: packed ``[K,out]`` vs v1 transpose, opcode level.
+
+This module is the M2a cross-backend assembly evidence for route c1:
+
+* the v1 program (0002 FROZEN) explicitly ``transpose``s the ``[out,K]`` weight
+  parameter before ``qmatmul_s8s8_s32``; the v2 program feeds the packed
+  ``[K,out]`` weight parameter directly (no transpose node);
+* both programs carry the same integer codes (v2 packed bytes are the
+  row-major mirror of the v1 transpose output), so every backend must produce
+  the *same* BF16 output bit-pattern;
+* a v1 artifact (different ``program_digest``) is rejected by the v2 binding
+  schema before any launch (fail-closed);
+* backends: scalar, vector-common, AVX2, AVX-512 VNNI and SVE256 (QEMU by
+  default; ``PYPTO_X_SVE_TEST_MODE=native`` on an AArch64 host).  CUDA's local
+  fake-driver differential lives in ``test_w8a8_cuda.py`` because its W8A8
+  plane only accepts the four frozen opcodes (there is no CUDA graph
+  executor / transpose opcode).
+"""
+
+from __future__ import annotations
+
+import os
+import random
+import shutil
+import struct
+from pathlib import Path
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.aarch64 import Sve256Runtime
+from pypto.backends.cpu.vector import CpuVectorRuntime
+from pypto.backends.cpu.x86 import Avx2Runtime, Avx512Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35_w8a8_scheme import (
+    dequantize_epilogue_bf16,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+from pypto.portable.runtime_binding import (
+    BindingMismatchError,
+    assemble_launch_request,
+    build_binding_schema,
+)
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+VECTOR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu", attributes={"lane_count": 4})
+AVX2_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    features=("avx", "avx2", "fma", "osxsave", "ymm"),
+    attributes={"lane_count": 8},
+)
+AVX512_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    features=("avx512f", "avx512vnni"),
+    attributes={"lane_count": 16},
+)
+SVE256_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2", "vl256"),
+    attributes={"vl_bytes": 32},
+)
+
+SHAPES = ((5, 7, 3), (9, 16, 17))
+SVE_SHAPES = ((5, 7, 3),)
+
+_SVE_MODE = os.environ.get("PYPTO_X_SVE_TEST_MODE", "qemu").strip().lower()
+if _SVE_MODE not in ("native", "qemu"):
+    raise RuntimeError("PYPTO_X_SVE_TEST_MODE must be 'native' or 'qemu'")
+
+_COMPILED = {}
+
+
+# --------------------------------------------------------------------------
+# v1 / v2 four-op and three-op programs
+# --------------------------------------------------------------------------
+
+
+_PROGRAM_METADATA = {
+    "runtime_inputs": [{"name": "x", "shape": [5, 7], "dtype": "float32"}],
+    "state_input_names": [],
+    "parameter_function_inputs": ["w", "ws"],
+    "quantized_parameters": [
+        {
+            "name": "w",
+            "scale_entry": "ws",
+            "storage_layout": "k_out_rowmajor",
+        }
+    ],
+}
+
+
+def _v1_transpose_program(rows, k, columns, name="w8a8_demo"):
+    """0002 v1: weight parameter is [out,K]; an explicit transpose feeds qmatmul."""
+
+    x = ValueRef("x", CoreType.tensor("float32", (rows, k)))
+    w = ValueRef("w", CoreType.tensor("int8", (columns, k)))
+    ws = ValueRef("ws", CoreType.tensor("float32", (columns,)))
+    q = ValueRef("q", CoreType.tensor("int8", (rows, k)))
+    sa = ValueRef("sa", CoreType.tensor("float32", (rows,)))
+    wt = ValueRef("wt", CoreType.tensor("int8", (k, columns)))
+    acc = ValueRef("acc", CoreType.tensor("int32", (rows, columns)))
+    out = ValueRef("out", CoreType.tensor("bf16", (rows, columns)))
+    operations = (
+        Operation("quantize_per_token_s8", (x,), (q, sa)),
+        Operation("transpose", (w,), (wt,), {"permutation": [1, 0]}),
+        Operation("qmatmul_s8s8_s32", (q, wt), (acc,)),
+        Operation("dequantize_epilogue_bf16", (acc, sa, ws), (out,)),
+    )
+    metadata = dict(_PROGRAM_METADATA)
+    metadata["runtime_inputs"] = [{"name": "x", "shape": [rows, k], "dtype": "float32"}]
+    return CoreProgram(
+        functions=(CoreFunction(name, (x, w, ws), (out,), Region(operations)),),
+        metadata=metadata,
+    )
+
+
+def _v2_packed_program(rows, k, columns, name="w8a8_demo"):
+    """0010 v2: weight parameter is already packed [K,out]; no transpose node."""
+
+    x = ValueRef("x", CoreType.tensor("float32", (rows, k)))
+    w = ValueRef("w", CoreType.tensor("int8", (k, columns)))
+    ws = ValueRef("ws", CoreType.tensor("float32", (columns,)))
+    q = ValueRef("q", CoreType.tensor("int8", (rows, k)))
+    sa = ValueRef("sa", CoreType.tensor("float32", (rows,)))
+    acc = ValueRef("acc", CoreType.tensor("int32", (rows, columns)))
+    out = ValueRef("out", CoreType.tensor("bf16", (rows, columns)))
+    operations = (
+        Operation("quantize_per_token_s8", (x,), (q, sa)),
+        Operation("qmatmul_s8s8_s32", (q, w), (acc,)),
+        Operation("dequantize_epilogue_bf16", (acc, sa, ws), (out,)),
+    )
+    metadata = dict(_PROGRAM_METADATA)
+    metadata["runtime_inputs"] = [{"name": "x", "shape": [rows, k], "dtype": "float32"}]
+    return CoreProgram(
+        functions=(CoreFunction(name, (x, w, ws), (out,), Region(operations)),),
+        metadata=metadata,
+    )
+
+
+def _inputs(rows, k, columns, seed):
+    rng = random.Random(seed)
+    x_values = [[rng.uniform(-3.0, 3.0) for _ in range(k)] for _ in range(rows)]
+    w_source = [[rng.randint(-127, 127) for _ in range(k)] for _ in range(columns)]
+    ws_values = [rng.uniform(0.001, 0.05) for _ in range(columns)]
+    # packed [K,out] is byte-identical to the v1 transpose output.
+    w_packed = [[w_source[o][inner] for o in range(columns)] for inner in range(k)]
+    quantized = quantize_per_token_s8(x_values)
+    accumulator = qmatmul_s8s8_s32(
+        list(quantized.code_rows()), w_packed, left_shape=(rows, k), right_shape=(k, columns)
+    )
+    epilogue = dequantize_epilogue_bf16(
+        list(accumulator.values), list(quantized.scales), ws_values, shape=(rows, columns)
+    )
+    golden = [
+        struct.unpack("<f", struct.pack("<I", epilogue.bf16_bits[row * columns + column] << 16))[0]
+        for row in range(rows)
+        for column in range(columns)
+    ]
+    v1_inputs = [
+        HostTensor("float32", (rows, k), [value for row in x_values for value in row]),
+        HostTensor("int8", (columns, k), [value for row in w_source for value in row]),
+        HostTensor("float32", (columns,), ws_values),
+    ]
+    v2_inputs = [
+        HostTensor("float32", (rows, k), [value for row in x_values for value in row]),
+        HostTensor("int8", (k, columns), [value for row in w_packed for value in row]),
+        HostTensor("float32", (columns,), ws_values),
+    ]
+    return v1_inputs, v2_inputs, golden
+
+
+def _run(runtime, artifact, inputs, rows, columns):
+    output = HostTensor.zeros("bf16", (rows, columns))
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[output.descriptor()],
+        )
+    )
+    return [value for row in output.tolist() for value in row]
+
+
+def _compile(backend, program, build_dir, key, target):
+    cache_key = (backend, key, program.canonical_json())
+    cached = _COMPILED.get(cache_key)
+    if cached is not None:
+        return cached
+    if backend == "scalar":
+        compiler = CpuScalarCompiler()
+        artifact = compiler.compile(compiler.lower(program, target))
+    elif backend == "vector":
+        compiler = CpuVectorCompiler()
+        artifact = compiler.compile(compiler.lower(program, target))
+    elif backend == "avx2":
+        compiler = Avx2Compiler()
+        artifact = compiler.compile(
+            compiler.lower(program, target),
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx2",
+                extra={"build_dir": str(Path(build_dir) / key)},
+            ),
+        )
+    elif backend == "avx512":
+        compiler = Avx512Compiler()
+        artifact = compiler.compile(
+            compiler.lower(program, target),
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx512",
+                extra={"build_dir": str(Path(build_dir) / key)},
+            ),
+        )
+    elif backend == "sve256":
+        compiler = Sve256Compiler()
+        artifact = compiler.compile(
+            compiler.lower(program, target),
+            CompileOptions(
+                artifact_format="pypto-x.cpu.sve256",
+                extra={"build_dir": str(Path(build_dir) / key)},
+            ),
+        )
+    else:  # pragma: no cover - test plumbing
+        raise AssertionError("unknown backend {!r}".format(backend))
+    _COMPILED[cache_key] = artifact
+    return artifact
+
+
+def _assert_v1_artifact_rejected_by_v2_schema(v1_artifact, v2_program):
+    schema = build_binding_schema(v2_program)
+    assert v1_artifact.metadata.get("program_digest") != schema.graph_digest
+    with pytest.raises(BindingMismatchError, match="program_digest"):
+        assemble_launch_request(
+            schema,
+            v1_artifact,
+            runtime_bindings={},
+            parameter_bindings={},
+            state_bindings={},
+            outputs={},
+            state_outputs={},
+        )
+
+
+def _differential(runtime, backend, build_dir, shapes, target, seed):
+    for rows, k, columns in shapes:
+        v1_program = _v1_transpose_program(rows, k, columns)
+        v2_program = _v2_packed_program(rows, k, columns)
+        v1_inputs, v2_inputs, golden = _inputs(rows, k, columns, seed)
+        v1_artifact = _compile(backend, v1_program, build_dir, "v1", target)
+        v2_artifact = _compile(backend, v2_program, build_dir, "v2", target)
+        v1_output = _run(runtime, v1_artifact, v1_inputs, rows, columns)
+        v2_output = _run(runtime, v2_artifact, v2_inputs, rows, columns)
+        assert v1_output == golden
+        assert v2_output == golden
+        assert v1_output == v2_output
+        _assert_v1_artifact_rejected_by_v2_schema(v1_artifact, v2_program)
+
+
+def test_v2_graph_has_no_int8_transpose_and_v1_graph_has_one():
+    import hashlib
+
+    v1 = _v1_transpose_program(5, 7, 3)
+    v2 = _v2_packed_program(5, 7, 3)
+    v1_ops = [operation.name for operation in v1.functions[0].body.operations]
+    v2_ops = [operation.name for operation in v2.functions[0].body.operations]
+    assert v1_ops == [
+        "quantize_per_token_s8",
+        "transpose",
+        "qmatmul_s8s8_s32",
+        "dequantize_epilogue_bf16",
+    ]
+    assert v2_ops == [
+        "quantize_per_token_s8",
+        "qmatmul_s8s8_s32",
+        "dequantize_epilogue_bf16",
+    ]
+    v1_weight = v1.functions[0].parameters[1]
+    v2_weight = v2.functions[0].parameters[1]
+    assert tuple(v1_weight.type.shape) == (3, 7)  # [out,K]
+    assert tuple(v2_weight.type.shape) == (7, 3)  # packed [K,out]
+    # The transpose + flipped parameter shape are the only structural
+    # difference; both graph digests differ (graph_digest has no version
+    # constant, contract 0010 §4.2.6).
+    v1_digest = hashlib.sha256(v1.canonical_json().encode("utf-8")).hexdigest()
+    v2_digest = hashlib.sha256(v2.canonical_json().encode("utf-8")).hexdigest()
+    assert v1_digest != v2_digest
+    # The v2 program produces a valid v3 schema; the v1-shaped parameter is
+    # rejected by the same v3 scale/out-channel rule (fail-closed).
+    assert build_binding_schema(v2).graph_digest == v2_digest
+    with pytest.raises(BindingMismatchError):
+        build_binding_schema(v1)
+
+
+def test_packed_k_out_matches_v1_transpose_on_scalar_and_vector(tmp_path):
+    _differential(CpuScalarRuntime(), "scalar", tmp_path, SHAPES, SCALAR_TARGET, seed=11)
+    _differential(CpuVectorRuntime(), "vector", tmp_path, SHAPES, VECTOR_TARGET, seed=13)
+
+
+def test_packed_k_out_matches_v1_transpose_on_avx2(tmp_path):
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2/YMM capability")
+    _differential(runtime, "avx2", tmp_path, SHAPES, AVX2_TARGET, seed=17)
+
+
+def test_packed_k_out_matches_v1_transpose_on_avx512_vnni(tmp_path):
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability")
+    if not getattr(runtime.capability, "avx512vnni", False):
+        pytest.skip("host lacks AVX-512 VNNI capability")
+    _differential(runtime, "avx512", tmp_path, SHAPES, AVX512_TARGET, seed=19)
+
+
+def test_packed_k_out_matches_v1_transpose_on_sve256(tmp_path):
+    if _SVE_MODE == "qemu":
+        if shutil.which("qemu-aarch64") is None:
+            pytest.skip("qemu-aarch64 is unavailable")
+    else:
+        import platform
+
+        if platform.machine().lower() not in ("aarch64", "arm64"):
+            pytest.skip("native SVE256 execution requires an AArch64 host")
+    runtime = Sve256Runtime(
+        execution_mode=_SVE_MODE,
+        qemu_cpu="max,sve256=on",
+    )
+    _differential(runtime, "sve256", tmp_path, SVE_SHAPES, SVE256_TARGET, seed=23)
