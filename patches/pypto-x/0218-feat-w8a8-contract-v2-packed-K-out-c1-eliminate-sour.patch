+def test_qmatmul_packed_k_out_equals_host_transpose_of_v1_source():
+    """M2a CUDA decision: evidence boundary stays opcode level.
+
+    The CUDA W8A8 plane has no graph executor and accepts only the four frozen
+    opcodes (no ``transpose``), so a literal v1 4-op artifact cannot exist.
+    The c1 contract only requires that the packed ``[K,out]`` region is the
+    byte-identical row-major mirror of the host transpose of the v1
+    ``[out,K]`` source and that ``dp4a`` consumes it bit-exactly.
+    """
+
+    rows, k, columns = 5, 7, 3
+    rng = random.Random(20260912)
+    left = [rng.randint(-127, 127) for _ in range(rows * k)]
+    w_source = [[rng.randint(-127, 127) for _ in range(k)] for _ in range(columns)]
+    # Host transpose: exactly what the 0002 v1 graph node would have produced.
+    w_transposed = [w_source[o][inner] for inner in range(k) for o in range(columns)]
+    # Packed [K,out] region bytes: q[k*out + o].
+    w_packed_bytes = bytes(value & 0xFF for value in w_transposed)
+    expected = qmatmul_s8s8_s32(
+        left, w_transposed, left_shape=(rows, k), right_shape=(k, columns)
+    )
+    artifact, target_ir = _compile(_qmatmul_program((rows, k), (k, columns)))
+    driver = FakeCudaDriver()
+    driver.active_operation = target_ir.operations[0]
+    copies = []
+    original_memcpy_htod = driver.memcpy_htod
+
+    def recording_memcpy_htod(pointer, data):
+        copies.append(bytes(data))
+        return original_memcpy_htod(pointer, data)
+
+    driver.memcpy_htod = recording_memcpy_htod
+    actual = CudaRuntime(driver=driver).run_w8a8_qmatmul(
+        artifact, left, w_transposed, left_shape=(rows, k), right_shape=(k, columns)
+    )
+    assert tuple(actual) == tuple(expected.values)
+    # The right operand is H2D-copied as exactly the packed [K,out] region
+    # bytes (left is copies[0]); no Python list survives the wire boundary.
+    assert copies[0] == bytes(value & 0xFF for value in left)
+    assert copies[1] == w_packed_bytes
+
+
