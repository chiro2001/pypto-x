+"""sm_120/sm_121 first-class CUDA arch selection tests (no GPU required).
+
+Contract covered here:
+  * default ``CudaPtxCompiler()`` stays sm_80 / PTX 8.0 and emits payload
+    version 2 without an ``arch_selection`` block (byte-compatible path);
+  * explicit ``arch=``/``ptx_target=``/``TargetSpec.attributes['arch']`` selects
+    a native arch, resolves the required PTX ISA version, and records the
+    selection in payload + metadata, which are covered by the artifact digest;
+  * artifacts carrying the selection use payload version 3 and fail closed on
+    any tampering; version-2 artifacts without the block still decode;
+  * PTX headers below the arch minimum are rejected at render time.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+
+import pytest
+
+from pypto.compiler import Artifact
+from pypto.compiler.targets.cuda import (
+    ARCH_SELECTION_PAYLOAD_VERSION,
+    ARTIFACT_PAYLOAD_VERSION,
+    CUDA_ARCH_PTX_VERSIONS,
+    DEFAULT_PTX_TARGET,
+    SM120_ARCH,
+    SM121_ARCH,
+    SM80_ARCH,
+    CudaPtxArtifactError,
+    CudaPtxCompiler,
+    CudaPtxError,
+    _decode_cuda_artifact,
+    render_ptx,
+    resolve_cuda_arch,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+
+
+def _program():
+    value_type = CoreType.tensor("float32", (5,))
+    x, y, z = ValueRef("x", value_type), ValueRef("y", value_type), ValueRef("z", value_type)
+    operation = Operation("add", (x, y), (z,))
+    return CoreProgram(functions=(CoreFunction("main", (x, y), (z,), Region((operation,))),))
+
+
+def _artifact(compiler=None, target=TARGET):
+    compiler = compiler or CudaPtxCompiler()
+    return compiler.compile(compiler.lower(_program(), target))
+
+
+def test_default_arch_path_is_unchanged():
+    compiler = CudaPtxCompiler()
+    assert compiler.ptx_target == SM80_ARCH
+    assert compiler.ptx_version == "8.0"
+    assert compiler.arch_selection is None
+    artifact = _artifact(compiler)
+    assert artifact.metadata["ptx_target"] == SM80_ARCH
+    assert artifact.metadata["ptx_version"] == "8.0"
+    assert artifact.metadata["artifact_payload_version"] == ARTIFACT_PAYLOAD_VERSION
+    assert "arch_selection" not in artifact.metadata
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    assert "arch_selection" not in payload
+    assert payload["artifact_payload_version"] == ARTIFACT_PAYLOAD_VERSION
+    assert artifact.payload.decode("utf-8").startswith('{"artifact_payload_version":2,')
+    assert ".version 8.0\n.target sm_80\n" in payload["ptx"]
+
+
+def test_resolve_cuda_arch_mapping():
+    assert resolve_cuda_arch(SM120_ARCH) == (SM120_ARCH, "8.7")
+    assert resolve_cuda_arch(SM121_ARCH) == (SM121_ARCH, "8.8")
+    assert resolve_cuda_arch(SM80_ARCH) == (SM80_ARCH, "8.0")
+    assert CUDA_ARCH_PTX_VERSIONS[SM120_ARCH] == "8.7"
+    with pytest.raises(CudaPtxError, match="unsupported CUDA arch"):
+        resolve_cuda_arch("sm_999")
+
+
+@pytest.mark.parametrize(
+    "arch, target, version",
+    ((SM120_ARCH, SM120_ARCH, "8.7"), (SM121_ARCH, SM121_ARCH, "8.8")),
+)
+def test_explicit_compiler_arch_selection(arch, target, version):
+    compiler = CudaPtxCompiler(arch=arch)
+    assert (compiler.ptx_target, compiler.ptx_version) == (target, version)
+    artifact = _artifact(compiler)
+    assert artifact.metadata["artifact_payload_version"] == ARCH_SELECTION_PAYLOAD_VERSION
+    selection = artifact.metadata["arch_selection"]
+    assert selection == {
+        "policy": "explicit_arch",
+        "source": "compiler_arch",
+        "requested_arch": arch,
+        "ptx_target": target,
+        "ptx_version": version,
+    }
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    assert payload["arch_selection"] == selection
+    assert payload["ptx_target"] == target
+    assert payload["ptx_version"] == version
+    assert ".version {}\n.target {}\n".format(version, target) in payload["ptx"]
+    assert artifact.metadata["payload_digest"] == hashlib.sha256(artifact.payload).hexdigest()
+    assert artifact.content_digest == artifact.metadata["payload_digest"]
+    decoded = _decode_cuda_artifact(artifact)
+    assert decoded.ptx_target == target
+    assert decoded.ptx_version == version
+    assert dict(decoded.arch_selection) == selection
+
+
+def test_explicit_legacy_ptx_target_resolves_minimum_version():
+    compiler = CudaPtxCompiler(ptx_target=SM120_ARCH)
+    assert compiler.ptx_version == "8.7"
+    assert compiler.arch_selection["source"] == "compiler_ptx_target"
+    artifact = _artifact(compiler)
+    assert artifact.metadata["arch_selection"]["requested_arch"] == SM120_ARCH
+
+
+def test_version_below_arch_minimum_is_rejected():
+    # Leaving ptx_version at its default resolves the arch minimum instead of
+    # silently emitting an unloadable header; an explicitly *older* version is
+    # rejected by the renderer (and can never reach a valid artifact).
+    assert CudaPtxCompiler(ptx_target=SM120_ARCH).ptx_version == "8.7"
+    assert CudaPtxCompiler(ptx_target=SM121_ARCH).ptx_version == "8.8"
+    compiler = CudaPtxCompiler()
+    gpu_program = compiler.lower(_program(), TARGET).gpu_program
+    with pytest.raises(CudaPtxError, match="does not support target"):
+        render_ptx(gpu_program, SM121_ARCH, "8.7")
+
+
+def test_target_attribute_arch_selection():
+    target = TargetSpec(
+        "gpu", "gpu-neutral", attributes={"workgroup": (4,), "arch": SM120_ARCH}
+    )
+    artifact = _artifact(CudaPtxCompiler(), target)
+    selection = artifact.metadata["arch_selection"]
+    assert selection["source"] == "target_attribute"
+    assert selection["requested_arch"] == SM120_ARCH
+    assert (selection["ptx_target"], selection["ptx_version"]) == (SM120_ARCH, "8.7")
+    assert artifact.target.to_dict()["attributes"]["arch"] == SM120_ARCH
+    assert artifact.metadata["artifact_payload_version"] == ARCH_SELECTION_PAYLOAD_VERSION
+
+
+def test_conflicting_or_unknown_arch_selection_is_rejected():
+    with pytest.raises(CudaPtxError, match="cannot be combined"):
+        CudaPtxCompiler(arch=SM120_ARCH, ptx_target=SM121_ARCH)
+    with pytest.raises(CudaPtxError, match="unsupported CUDA arch"):
+        CudaPtxCompiler(arch="sm_999")
+    compiler = CudaPtxCompiler(arch=SM120_ARCH)
+    conflicting = TargetSpec(
+        "gpu", "gpu-neutral", attributes={"workgroup": (4,), "arch": SM121_ARCH}
+    )
+    with pytest.raises(CudaPtxError, match="conflicts"):
+        compiler.lower(_program(), conflicting)
+    with pytest.raises(CudaPtxError, match="must be a string"):
+        compiler.lower(_program(), TargetSpec("gpu", "gpu-neutral", attributes={"arch": 120}))
+
+
+def test_render_ptx_enforces_arch_minimum():
+    compiler = CudaPtxCompiler()
+    gpu_program = compiler.lower(_program(), TARGET).gpu_program
+    assert ".version 8.7\n.target sm_120\n" in render_ptx(gpu_program, SM120_ARCH, "8.7")
+    assert ".version 8.8\n.target sm_121\n" in render_ptx(gpu_program, SM121_ARCH, "8.8")
+    with pytest.raises(CudaPtxError, match="PTX version|does not support target"):
+        render_ptx(gpu_program, SM120_ARCH, "8.0")
+    with pytest.raises(CudaPtxError, match="does not support target"):
+        render_ptx(gpu_program, SM121_ARCH, "8.7")
+
+
+def test_default_artifact_digest_is_stable_across_calls():
+    first = _artifact()
+    second = _artifact()
+    assert first.payload == second.payload
+    assert first.metadata["payload_digest"] == second.metadata["payload_digest"]
+    explicit = _artifact(CudaPtxCompiler(arch=SM120_ARCH))
+    assert explicit.metadata["payload_digest"] != first.metadata["payload_digest"]
+    assert explicit.content_digest != first.content_digest
+
+
+def _plain(value):
+    if isinstance(value, Mapping):
+        return {key: _plain(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def _mutated(artifact, mutate):
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    metadata = _plain(artifact.metadata)
+    mutate(payload, metadata)
+    mutated = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=json.dumps(payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8"),
+        metadata=metadata,
+    )
+    return mutated
+
+
+def test_arch_selection_tamper_fails_closed():
+    artifact = _artifact(CudaPtxCompiler(arch=SM120_ARCH))
+
+    def drop_selection(payload, metadata):
+        payload.pop("arch_selection")
+        metadata.pop("arch_selection")
+
+    with pytest.raises(CudaPtxArtifactError, match="arch_selection"):
+        _decode_cuda_artifact(_mutated(artifact, drop_selection))
+
+    def wrong_version(payload, metadata):
+        payload["arch_selection"]["ptx_version"] = "8.0"
+        payload["ptx_version"] = "8.0"
+        metadata["arch_selection"]["ptx_version"] = "8.0"
+        metadata["ptx_version"] = "8.0"
+
+    with pytest.raises(CudaPtxArtifactError):
+        _decode_cuda_artifact(_mutated(artifact, wrong_version))
+
+    def mismatch_source(payload, metadata):
+        payload["arch_selection"]["source"] = "tampered"
+        metadata["arch_selection"]["source"] = "tampered"
+
+    with pytest.raises(CudaPtxArtifactError, match="arch_selection"):
+        _decode_cuda_artifact(_mutated(artifact, mismatch_source))
+
+
+def test_version_2_with_arch_selection_fails_closed():
+    artifact = _artifact()
+    assert artifact.metadata["artifact_payload_version"] == ARTIFACT_PAYLOAD_VERSION
+
+    def inject_selection(payload, metadata):
+        selection = {
+            "policy": "explicit_arch",
+            "source": "compiler_arch",
+            "requested_arch": SM120_ARCH,
+            "ptx_target": SM120_ARCH,
+            "ptx_version": "8.7",
+        }
+        payload["arch_selection"] = selection
+        metadata["arch_selection"] = selection
+
+    with pytest.raises(CudaPtxArtifactError, match="arch_selection"):
+        _decode_cuda_artifact(_mutated(artifact, inject_selection))
+
+
+def test_default_compiler_without_selection_decodes_with_none():
+    artifact = _artifact()
+    decoded = _decode_cuda_artifact(artifact)
+    assert decoded.arch_selection is None
+    assert decoded.ptx_target == DEFAULT_PTX_TARGET
+    assert decoded.ptx_version == "8.0"
