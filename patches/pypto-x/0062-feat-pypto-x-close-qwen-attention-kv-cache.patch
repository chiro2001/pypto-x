+        }
+        for plan in target_ir.plans
+        if plan.matmul is not None and plan.matmul.batch_shape
+    ]
+    if metadata.get("batched_matmul_operations") != expected_batched_matmul:
+        raise CpuSve256ArtifactError("SVE256 batched matmul metadata mismatch")
     expected_indexing = [
         {
             "operation": plan.operation,
@@ -1406,10 +1422,44 @@ class Sve256Runtime:
             )
         elif name == "matmul":
             matmul = plan.matmul
-            values = self._run_runner(
-                artifact, "matmul", dtype, [inputs[0][1], inputs[1][1]],
-                matmul.output_elements, matmul.m, matmul.k, matmul.n,
-            )
+            if matmul.batch_shape:
+                # The native wire contract remains rank-2.  Keep batched
+                # semantics explicit and auditable by invoking that runner
+                # once per equal batch-prefix slice on the host.  This is a
+                # correctness fallback, never a claim of a fused/native
+                # batched SVE kernel.
+                batch_count = 1
+                for dimension in matmul.batch_shape:
+                    batch_count *= dimension
+                left_matrix_elements = matmul.m * matmul.k
+                right_matrix_elements = matmul.k * matmul.n
+                output_matrix_elements = matmul.m * matmul.n
+                if len(inputs[0][1]) != batch_count * left_matrix_elements or len(inputs[1][1]) != batch_count * right_matrix_elements:
+                    raise CpuSve256ExecutionError("SVE256 batched matmul input length mismatch")
+                values = []
+                for batch_index in range(batch_count):
+                    left_base = batch_index * left_matrix_elements
+                    right_base = batch_index * right_matrix_elements
+                    values.extend(
+                        self._run_runner(
+                            artifact,
+                            "matmul",
+                            dtype,
+                            [
+                                inputs[0][1][left_base:left_base + left_matrix_elements],
+                                inputs[1][1][right_base:right_base + right_matrix_elements],
+                            ],
+                            output_matrix_elements,
+                            matmul.m,
+                            matmul.k,
+                            matmul.n,
+                        )
+                    )
+            else:
+                values = self._run_runner(
+                    artifact, "matmul", dtype, [inputs[0][1], inputs[1][1]],
+                    matmul.output_elements, matmul.m, matmul.k, matmul.n,
+                )
         elif name in ("reshape", "view", "transpose", "contiguous", "slice"):
             layout = plan.layout_plan
             if layout is None or layout.operation != name:
