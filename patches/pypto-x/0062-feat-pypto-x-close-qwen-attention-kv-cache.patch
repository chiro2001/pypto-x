diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
index 06864148a..3d32aa19b 100644
--- a/python/pypto/portable/qwen35.py
+++ b/python/pypto/portable/qwen35.py
@@ -1080,6 +1080,273 @@ def build_decoder_subgraph(
     )
 
 
+def _matmul_output_shape(
+    left_shape: Tuple[int, ...], right_shape: Tuple[int, ...], field: str
+) -> Tuple[int, ...]:
+    """Validate the portable equal-prefix batched matmul contract."""
+
+    if len(left_shape) < 2 or len(left_shape) > 4:
+        raise ValueError("{} left operand must have rank 2, 3, or 4".format(field))
+    if len(left_shape) != len(right_shape):
+        raise ValueError("{} operands must have equal rank".format(field))
+    if left_shape[:-2] != right_shape[:-2]:
+        raise ValueError("{} operands must have identical batch prefixes".format(field))
+    if left_shape[-1] != right_shape[-2]:
+        raise ValueError(
+            "{} reduction dimensions {} and {} do not match".format(
+                field, left_shape[-1], right_shape[-2]
+            )
+        )
+    return left_shape[:-2] + (left_shape[-2], right_shape[-1])
+
+
+def build_batched_matmul(
+    left_shape: Sequence[int],
+    right_shape: Sequence[int],
+    dtype: str = "bf16",
+    output_dtype: Optional[str] = None,
+) -> CoreProgram:
+    """Build an equal-prefix rank-2/rank-3/rank-4 portable matmul.
+
+    The public contract intentionally has no implicit transpose attributes.
+    Callers express QK^T/PV layouts with an explicit ``transpose`` operation
+    before this builder's ``matmul``.  Batch prefixes must match exactly; no
+    NumPy-style batch broadcasting is inferred by the Core layer.
+    """
+
+    left_shape = _shape(left_shape, "left_shape")
+    right_shape = _shape(right_shape, "right_shape")
+    output_shape = _matmul_output_shape(left_shape, right_shape, "batched matmul")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    if output_dtype != dtype:
+        raise ValueError(
+            "batched matmul output_dtype must match dtype; cast inputs explicitly for FP32 accumulation"
+        )
+    builder = _Builder("qwen35_batched_matmul", "batched_matmul", output_shape)
+    left = builder.parameter("left", _tensor(dtype, left_shape))
+    right = builder.parameter("right", _tensor(dtype, right_shape))
+    output = builder.op(
+        "matmul",
+        (left, right),
+        (("output", _tensor(dtype, output_shape)),),
+    )[0]
+    return builder.finish(
+        (output,),
+        {
+            "matmul_rank": len(left_shape),
+            "batch_shape": list(left_shape[:-2]),
+            "batch_prefix_broadcast": False,
+            "transpose_attributes": False,
+            "transpose_semantics": "caller_must_emit_explicit_transpose",
+            "accumulation_dtype": "float32" if dtype in ("bf16", "float32") else dtype,
+            "fallbacks": ["python_list_wire_staging"],
+        },
+    )
+
+
+def build_qwen35_attention_kv_cache(
+    query_shape: Sequence[int],
+    prior_k_shape: Sequence[int],
+    prior_v_shape: Sequence[int],
+    current_k_shape: Sequence[int],
+    current_v_shape: Sequence[int],
+    dtype: str = "bf16",
+    index_dtype: str = "int64",
+) -> CoreProgram:
+    """Build Qwen3.5 full attention with a pure functional KV transition.
+
+    Shapes follow the fixed 0.8B text contract:
+
+    * query: ``[B, 8, T, 256]``;
+    * prior/current K and V: ``[B, 2, P/T, 256]``;
+    * explicit runtime head indices: ``[8]``;
+    * explicit runtime causal mask: ``[B, 8, T, P+T]``.
+
+    ``prior_k/prior_v`` and ``current_k/current_v`` are never mutated.  The
+    function returns ``(activation, new_k, new_v)`` where the new caches are
+    SSA results of concatenation.  Query/key/value storage stays BF16 while
+    QK scaling, masking, softmax, and PV matmul use FP32 intermediates.
+    ``qk_scale`` and ``fill_value`` are scalar LaunchRequest inputs.
+    """
+
+    query_shape = _shape(query_shape, "query_shape", rank=4)
+    prior_k_shape = _shape(prior_k_shape, "prior_k_shape", rank=4)
+    prior_v_shape = _shape(prior_v_shape, "prior_v_shape", rank=4)
+    current_k_shape = _shape(current_k_shape, "current_k_shape", rank=4)
+    current_v_shape = _shape(current_v_shape, "current_v_shape", rank=4)
+    dtype = _dtype(dtype, "dtype")
+    if dtype != "bf16":
+        raise ValueError("Qwen3.5 attention/KV contract requires dtype='bf16'")
+    batch, query_heads, steps, head_dim = query_shape
+    if (query_heads, head_dim) != (QWEN35_08B_SHAPE_METADATA["num_attention_heads"], QWEN35_08B_SHAPE_METADATA["head_dim"]):
+        raise ValueError("query_shape must use fixed Qwen3.5 heads=8 and head_dim=256")
+    kv_heads = QWEN35_08B_SHAPE_METADATA["num_key_value_heads"]
+    if prior_k_shape != prior_v_shape or current_k_shape != current_v_shape:
+        raise ValueError("K and V shapes must match within prior/current cache pairs")
+    if prior_k_shape[0] != batch or current_k_shape[0] != batch:
+        raise ValueError("query and KV batch dimensions must match exactly")
+    if prior_k_shape[1] != kv_heads or current_k_shape[1] != kv_heads:
+        raise ValueError("KV shapes must use fixed Qwen3.5 kv_heads=2")
+    if prior_k_shape[3] != head_dim or current_k_shape[3] != head_dim:
+        raise ValueError("query and KV head_dim must match fixed value 256")
+    past = prior_k_shape[2]
+    current_steps = current_k_shape[2]
+    if current_steps <= 0:
+        raise ValueError("current KV sequence length must be positive")
+    if steps != current_steps:
+        raise ValueError("query and current KV sequence lengths must match")
+    total_steps = past + current_steps
+    attention_shape = (batch, query_heads, steps, total_steps)
+    index_dtype = _index_dtype(index_dtype)
+    builder = _Builder(
+        "qwen35_attention_kv_cache",
+        "attention_kv_cache",
+        query_shape,
+    )
+    query = builder.parameter("query", _tensor("bf16", query_shape))
+    prior_k = builder.parameter("prior_k", _tensor("bf16", prior_k_shape))
+    prior_v = builder.parameter("prior_v", _tensor("bf16", prior_v_shape))
+    current_k = builder.parameter("current_k", _tensor("bf16", current_k_shape))
+    current_v = builder.parameter("current_v", _tensor("bf16", current_v_shape))
+    head_indices = builder.parameter("head_indices", _tensor(index_dtype, (query_heads,)))
+    causal_mask = builder.parameter("causal_mask", _tensor("bool", attention_shape))
+    qk_scale = builder.parameter("qk_scale", _scalar("float32"))
+    fill_value = builder.parameter("fill_value", _scalar("float32"))
+
+    new_k = builder.op(
+        "concat",
+        (prior_k, current_k),
+        (("new_k", _tensor("bf16", (batch, kv_heads, total_steps, head_dim))),),
+        {"axis": 2},
+    )[0]
+    new_v = builder.op(
+        "concat",
+        (prior_v, current_v),
+        (("new_v", _tensor("bf16", (batch, kv_heads, total_steps, head_dim))),),
+        {"axis": 2},
+    )[0]
+    repeated_k = builder.op(
+        "gather",
+        (new_k, head_indices),
+        (("repeated_k", _tensor("bf16", (batch, query_heads, total_steps, head_dim))),),
+        {"axis": 1},
+    )[0]
+    repeated_v = builder.op(
+        "gather",
+        (new_v, head_indices),
+        (("repeated_v", _tensor("bf16", (batch, query_heads, total_steps, head_dim))),),
+        {"axis": 1},
+    )[0]
+    query_f32 = _as_f32(builder, query, "bf16", "attention_query")
+    key_f32 = _as_f32(builder, repeated_k, "bf16", "attention_key")
+    key_transposed = builder.op(
+        "transpose",
+        (key_f32,),
+        (("key_transposed", _tensor("float32", (batch, query_heads, head_dim, total_steps))),),
+        {"permutation": [0, 1, 3, 2]},
+    )[0]
+    logits = builder.op(
+        "matmul",
+        (query_f32, key_transposed),
+        (("qk_logits", _tensor("float32", attention_shape)),),
+    )[0]
+    scaled_logits = builder.op(
+        "mul",
+        (logits, qk_scale),
+        (("scaled_logits", _tensor("float32", attention_shape)),),
+    )[0]
+    masked_logits = builder.op(
+        "where",
+        (causal_mask, scaled_logits, fill_value),
+        (("masked_logits", _tensor("float32", attention_shape)),),
+    )[0]
+    reduced_shape = attention_shape[:-1] + (1,)
+    maximum = builder.op(
+        "reduce_max",
+        (masked_logits,),
+        (("attention_max", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    maximum_full = builder.op(
+        "broadcast",
+        (maximum,),
+        (("attention_max_full", _tensor("float32", attention_shape)),),
+        {"shape": list(attention_shape)},
+    )[0]
+    shifted = builder.op(
+        "sub",
+        (masked_logits, maximum_full),
+        (("attention_shifted", _tensor("float32", attention_shape)),),
+    )[0]
+    exponent = builder.op(
+        "exp",
+        (shifted,),
+        (("attention_exp", _tensor("float32", attention_shape)),),
+    )[0]
+    total = builder.op(
+        "reduce_sum",
+        (exponent,),
+        (("attention_sum", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    total_full = builder.op(
+        "broadcast",
+        (total,),
+        (("attention_sum_full", _tensor("float32", attention_shape)),),
+        {"shape": list(attention_shape)},
+    )[0]
+    probabilities = builder.op(
+        "div",
+        (exponent, total_full),
+        (("attention_probabilities", _tensor("float32", attention_shape)),),
+    )[0]
+    value_f32 = _as_f32(builder, repeated_v, "bf16", "attention_value")
+    context = builder.op(
+        "matmul",
+        (probabilities, value_f32),
+        (("attention_context", _tensor("float32", query_shape)),),
+    )[0]
+    output = _cast_from_f32(builder, context, "bf16", "output")
+    return builder.finish(
+        (output, new_k, new_v),
+        {
+            "attention_heads": query_heads,
+            "kv_heads": kv_heads,
+            "head_dim": head_dim,
+            "past_length": past,
+            "current_length": current_steps,
+            "total_length": total_steps,
+            "mode": "prefill" if past == 0 else "decode_or_chunk",
+            "gqa_indices_runtime": True,
+            "causal_mask_runtime": True,
+            "causal_mask_shape": list(attention_shape),
+            "qk_scale_runtime_scalar": True,
+            "fill_value_runtime_scalar": True,
+            "qk_scale_accumulation_dtype": "float32",
+            "softmax_accumulation_dtype": "float32",
+            "pv_accumulation_dtype": "float32",
+            "activation_dtype": "bf16",
+            "kv_cache_dtype": "bf16",
+            "state_semantics": "functional_pure_ssa_output",
+            "transpose_semantics": "explicit_core_transpose_for_qk_t",
+            "batch_prefix_broadcast": False,
+            "fallbacks": [
+                "primitive_composition_not_fused",
+                "scalar_math_lane_fallback:exp",
+                "host_broadcast_pre_expansion",
+                "bf16_indexing_scalar_lane_fallback",
+                "python_list_wire_staging",
+                "sve_batched_matmul_host_batch_loop_rank2_runner",
+            ],
+        },
+    )
+
+
+# Short spelling kept for callers that do not need the model prefix.
+build_attention_kv_cache = build_qwen35_attention_kv_cache
+
