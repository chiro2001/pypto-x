+"""M1F batched matmul and functional Qwen3.5 attention/KV tests.
+
+All values are synthetic.  The attention contract is deliberately the fixed
+0.8B text shape (8 query heads, 2 KV heads, head_dim=256); no model or
+checkpoint is loaded.
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Iterable, List, Sequence, Tuple
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.vector import CpuVectorRuntime
+from pypto.backends.cpu.aarch64.sve256 import Sve256Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35 import (
+    build_batched_matmul,
+    build_qwen35_attention_kv_cache,
+)
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+VECTOR_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    attributes={"lane_count": 4, "specialization": {"compact_iteration": True}},
+)
+SVE_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2"),
+    attributes={"vl_bytes": 32},
+)
+
+
+def _count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+def _compile_scalar(program: CoreProgram):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _compile_vector(program: CoreProgram):
+    compiler = CpuVectorCompiler()
+    return compiler.compile(compiler.lower(program, VECTOR_TARGET))
+
+
+def _compile_sve(program: CoreProgram, tmp_path: Path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE_TARGET)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+
+
+def _launch(artifact, inputs, outputs, runtime, scalars=None):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+            scalars=scalars or {},
+        )
+    )
+
+
+def _assert_close(actual: Sequence[float], expected: Sequence[float], tolerance: float):
+    assert len(actual) == len(expected)
+    for left, right in zip(actual, expected):
+        assert math.isclose(float(left), float(right), rel_tol=tolerance, abs_tol=tolerance), (left, right)
+
+
+def _matmul_golden(left: Sequence[float], right: Sequence[float], left_shape, right_shape):
+    batch_shape = left_shape[:-2]
+    m, k = left_shape[-2:]
+    n = right_shape[-1]
+    batch_count = _count(batch_shape)
+    result = []
+    for batch_index in range(batch_count):
+        left_base = batch_index * m * k
+        right_base = batch_index * k * n
+        for row in range(m):
+            for column in range(n):
+                result.append(
+                    sum(
+                        left[left_base + row * k + inner]
+                        * right[right_base + inner * n + column]
+                        for inner in range(k)
+                    )
+                )
+    return result
+
+
+@pytest.mark.parametrize(
+    "left_shape,right_shape",
+    [((2, 2, 3), (2, 3, 4)), ((1, 2, 2, 3), (1, 2, 3, 4))],
+)
+def test_rank3_rank4_batched_matmul_scalar_vector_sve(left_shape, right_shape, tmp_path):
+    program = build_batched_matmul(left_shape, right_shape, dtype="float32")
+    output_shape = program.functions[0].returns[0].type.shape
+    left_values = [float((index % 11) - 5) * 0.125 for index in range(_count(left_shape))]
+    right_values = [float((index % 13) - 6) * 0.1 for index in range(_count(right_shape))]
+    left = HostTensor("float32", left_shape, left_values)
+    right = HostTensor("float32", right_shape, right_values)
+    expected = _matmul_golden(left_values, right_values, left_shape, right_shape)
+
+    scalar_output = HostTensor.zeros("float32", output_shape)
+    _launch(_compile_scalar(program), [left, right], [scalar_output], CpuScalarRuntime())
+    _assert_close(scalar_output.flat(), expected, 2.0e-6)
+
+    vector_output = HostTensor.zeros("float32", output_shape)
+    _launch(_compile_vector(program), [left, right], [vector_output], CpuVectorRuntime())
+    _assert_close(vector_output.flat(), expected, 2.0e-6)
+
+    sve_output = HostTensor.zeros("float32", output_shape)
+    artifact = _compile_sve(program, tmp_path / "rank{}".format(len(left_shape)))
+    assert artifact.metadata["batched_matmul_fallback"] == "host_batch_loop_rank2_runner"
+    assert artifact.metadata["batched_matmul_operations"][0]["mode"] == "host_batch_loop_rank2_runner"
+    _launch(
+        artifact,
+        [left, right],
+        [sve_output],
+        Sve256Runtime(execution_mode="qemu"),
+    )
+    _assert_close(sve_output.flat(), expected, 2.0e-6)
+
+
+def test_batched_matmul_rejects_broadcast_and_implicit_transpose():
+    with pytest.raises(ValueError, match="identical batch prefixes"):
+        build_batched_matmul((2, 3, 4), (1, 4, 5), dtype="float32")
+    with pytest.raises(ValueError, match="equal rank"):
+        build_batched_matmul((3, 4), (2, 3, 4), dtype="float32")
+
+    left = ValueRef("left", CoreType.tensor("float32", (2, 3, 4)))
+    right = ValueRef("right", CoreType.tensor("float32", (2, 4, 5)))
+    output = ValueRef("output", CoreType.tensor("float32", (2, 3, 5)))
+    program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "implicit_transpose",
+                (left, right),
+                (output,),
+                Region((Operation("matmul", (left, right), (output,), {"transpose_b": True}),)),
+            ),
+        )
+    )
+    with pytest.raises(Exception, match="transpose_b"):
+        _compile_scalar(program)
+
+
+def _attention_inputs(past: int, steps: int):
+    query_shape = (1, 8, steps, 256)
+    prior_shape = (1, 2, past, 256)
+    current_shape = (1, 2, steps, 256)
+    query = HostTensor(
+        "bf16",
+        query_shape,
+        [0.01 * ((index * 5) % 17 - 8) for index in range(_count(query_shape))],
+    )
+    prior_k = HostTensor(
+        "bf16",
+        prior_shape,
+        [0.02 * ((index * 3) % 19 - 9) for index in range(_count(prior_shape))],
+    )
+    prior_v = HostTensor(
+        "bf16",
+        prior_shape,
+        [0.03 * ((index * 7) % 23 - 11) for index in range(_count(prior_shape))],
+    )
+    current_k = HostTensor(
+        "bf16",
+        current_shape,
+        [0.015 * ((index * 11) % 17 - 8) for index in range(_count(current_shape))],
+    )
+    current_v = HostTensor(
+        "bf16",
+        current_shape,
+        [0.025 * ((index * 13) % 29 - 14) for index in range(_count(current_shape))],
+    )
+    head_indices = HostTensor("int64", (8,), [0, 0, 0, 0, 1, 1, 1, 1])
+    total = past + steps
+    mask_values = []
+    for _batch in range(1):
+        for _head in range(8):
+            for row in range(steps):
+                mask_values.extend(column <= past + row for column in range(total))
+    mask = HostTensor("bool", (1, 8, steps, total), mask_values)
+    return [query, prior_k, prior_v, current_k, current_v, head_indices, mask]
+
+
+def _attention_golden(inputs, past: int, steps: int):
+    query, prior_k, prior_v, current_k, current_v, head_indices, mask = inputs
+    q = query.flat()
+    prior_k_values = prior_k.flat()
+    prior_v_values = prior_v.flat()
+    current_k_values = current_k.flat()
+    current_v_values = current_v.flat()
+    output = []
+    scale = 1.0 / math.sqrt(256.0)
+    for head in range(8):
+        kv_head = int(head_indices.flat()[head])
+        for row in range(steps):
+            scores = []
+            for column in range(past + steps):
+                score = 0.0
+                for inner in range(256):
+                    q_index = (head * steps + row) * 256 + inner
+                    if column < past:
+                        k_index = (kv_head * past + column) * 256 + inner
+                        key_value = prior_k_values[k_index]
+                    else:
+                        k_index = (kv_head * steps + column - past) * 256 + inner
+                        key_value = current_k_values[k_index]
+                    score += float(q[q_index]) * float(key_value)
+                mask_index = ((head * steps + row) * (past + steps)) + column
+                scores.append(score * scale if mask.flat()[mask_index] else -10000.0)
+            maximum = max(scores)
+            probabilities = [math.exp(score - maximum) for score in scores]
+            total = sum(probabilities)
+            probabilities = [value / total for value in probabilities]
+            for inner in range(256):
+                value = 0.0
+                for column, probability in enumerate(probabilities):
+                    if column < past:
+                        v_index = (kv_head * past + column) * 256 + inner
+                        value_value = prior_v_values[v_index]
+                    else:
+                        v_index = (kv_head * steps + column - past) * 256 + inner
+                        value_value = current_v_values[v_index]
+                    value += probability * float(value_value)
+                output.append(value)
+    return output
+
+
+def _run_attention(program, inputs, output, new_k, new_v, runtime, artifact, past, steps):
+    _launch(
+        artifact,
+        inputs,
+        [output, new_k, new_v],
+        runtime,
+        scalars={"qk_scale": 1.0 / math.sqrt(256.0), "fill_value": -10000.0},
+    )
+    _assert_close(output.flat(), _attention_golden(inputs, past, steps), 0.04)
+
+
+def test_qwen_attention_prefill_decode_functional_kv_scalar_and_sve(tmp_path):
+    prefill_inputs = _attention_inputs(0, 2)
+    prefill = build_qwen35_attention_kv_cache(
+        (1, 8, 2, 256), (1, 2, 0, 256), (1, 2, 0, 256), (1, 2, 2, 256), (1, 2, 2, 256)
+    )
+    assert [ref.name for ref in prefill.functions[0].returns] == ["output", "new_k", "new_v"]
+    assert prefill.metadata["mode"] == "prefill"
+    assert prefill.metadata["gqa_indices_runtime"] is True
+    assert prefill.metadata["causal_mask_runtime"] is True
+    scalar_artifact = _compile_scalar(prefill)
+    scalar_output = HostTensor.zeros("bf16", (1, 8, 2, 256))
+    scalar_k = HostTensor.zeros("bf16", (1, 2, 2, 256))
+    scalar_v = HostTensor.zeros("bf16", (1, 2, 2, 256))
+    _run_attention(
+        prefill,
+        prefill_inputs,
+        scalar_output,
+        scalar_k,
+        scalar_v,
+        CpuScalarRuntime(),
+        scalar_artifact,
+        0,
+        2,
+    )
+
+    sve_artifact = _compile_sve(prefill, tmp_path / "prefill")
+    sve_output = HostTensor.zeros("bf16", (1, 8, 2, 256))
+    sve_k = HostTensor.zeros("bf16", (1, 2, 2, 256))
+    sve_v = HostTensor.zeros("bf16", (1, 2, 2, 256))
+    _run_attention(
+        prefill,
+        prefill_inputs,
+        sve_output,
+        sve_k,
+        sve_v,
+        Sve256Runtime(execution_mode="qemu"),
+        sve_artifact,
+        0,
+        2,
+    )
+    _assert_close(sve_output.flat(), scalar_output.flat(), 0.04)
+    _assert_close(sve_k.flat(), scalar_k.flat(), 0.04)
+    _assert_close(sve_v.flat(), scalar_v.flat(), 0.04)
+
+    decode_inputs = _attention_inputs(2, 1)
+    decode_inputs[1] = scalar_k
+    decode_inputs[2] = scalar_v
+    decode = build_qwen35_attention_kv_cache(
+        (1, 8, 1, 256), (1, 2, 2, 256), (1, 2, 2, 256), (1, 2, 1, 256), (1, 2, 1, 256)
+    )
+    assert decode.metadata["mode"] == "decode_or_chunk"
+    decode_artifact = _compile_scalar(decode)
+    decode_output = HostTensor.zeros("bf16", (1, 8, 1, 256))
+    decode_k = HostTensor.zeros("bf16", (1, 2, 3, 256))
+    decode_v = HostTensor.zeros("bf16", (1, 2, 3, 256))
+    _run_attention(
+        decode,
+        decode_inputs,
+        decode_output,
+        decode_k,
+        decode_v,
+        CpuScalarRuntime(),
+        decode_artifact,
+        2,
+        1,
+    )
+    decode_inputs[1] = sve_k
+    decode_inputs[2] = sve_v
+    decode_sve_artifact = _compile_sve(decode, tmp_path / "decode")
+    decode_sve_output = HostTensor.zeros("bf16", (1, 8, 1, 256))
+    decode_sve_k = HostTensor.zeros("bf16", (1, 2, 3, 256))
+    decode_sve_v = HostTensor.zeros("bf16", (1, 2, 3, 256))
+    _run_attention(
