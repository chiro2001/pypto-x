From 35100030ff1d842041ee2a96d1ac7b4fd90388bd Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 09:03:53 +0800
Subject: [PATCH 225/256] perf(cpu): keep the SVE256 W8A8 declaration gate O(1)

`_require_w8a8_declaration` ran `mapping_copy(artifact.metadata)` on
every W8A8 dispatch just to read two top-level keys.  For a model graph
the frozen metadata carries the whole CoreProgram plus vector plan, so
that deep thaw is O(graph): the profile after the decode-memo fix showed
~0.9 s per node inside `_require_w8a8_declaration` -> `mapping_copy` ->
`thaw_value` (535,957 recursive calls), which kept steady-state
quantize at ~0.45 s/op for 65,536 elements even with the memo warm.

Read the immutable FrozenMapping directly.  Every field the gate
compares (runner wire version, digest, dtypes, matrix capabilities,
SDOT/I8MM flags) is a scalar or tuple, so no thaw is needed.  The full
declaration gate still runs on every dispatch; a new or tampered
Artifact object still misses the memo and is fully re-decoded.

Tests pin the no-thaw invariant (a forbidden `mapping_copy` proves the
memo-hit path never deep-thaws) together with the other memo
discipline checks.
---
 python/pypto/backends/cpu/aarch64/sve256.py |  9 ++++++++-
 python/tests/ut/pypto_x/test_w8a8_sve256.py | 19 ++++++++++++++++++-
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/python/pypto/backends/cpu/aarch64/sve256.py b/python/pypto/backends/cpu/aarch64/sve256.py
index 4dfb5245a..96b84cb6a 100644
--- a/python/pypto/backends/cpu/aarch64/sve256.py
+++ b/python/pypto/backends/cpu/aarch64/sve256.py
@@ -1963,7 +1963,14 @@ class Sve256Runtime:
         )
 
     def _require_w8a8_declaration(self, artifact: Artifact, declared: Any) -> Any:
-        metadata = mapping_copy(artifact.metadata)
+        # Read the declaration keys straight off the immutable FrozenMapping.
+        # ``mapping_copy`` would deep-thaw the whole artifact metadata
+        # (CoreProgram + vector plan, multi-MB on a model graph) on every
+        # dispatch; that is the same O(graph) host cost the decode memo
+        # removes, and it dominated the memo-only profile (~0.9 s per node).
+        # Every field below is a scalar/tuple comparison on the frozen values,
+        # so no thaw is needed.
+        metadata = artifact.metadata
         declaration = metadata.get("w8a8_capability")
         if not isinstance(declaration, Mapping):
             raise CpuSve256ArtifactError("SVE256 artifact has no W8A8 capability declaration")
diff --git a/python/tests/ut/pypto_x/test_w8a8_sve256.py b/python/tests/ut/pypto_x/test_w8a8_sve256.py
index 67671c190..af4ccf203 100644
--- a/python/tests/ut/pypto_x/test_w8a8_sve256.py
+++ b/python/tests/ut/pypto_x/test_w8a8_sve256.py
@@ -1056,9 +1056,26 @@ def test_sve256_w8a8_dispatch_revalidates_declaration_on_memo_hit(build_root):
     with pytest.raises(CpuSve256ArtifactError, match="declaration re-check"):
         runtime._load_w8a8(artifact)
 
+    # The per-dispatch gate must stay O(1): it may not deep-thaw the whole
+    # artifact metadata (multi-MB CoreProgram + vector plan) just to read the
+    # two top-level declaration keys.
+    runtime._require_w8a8_declaration = real_declaration
+    import pypto.backends.cpu.aarch64.sve256 as sve_module
+
+    real_mapping_copy = sve_module.mapping_copy
+
+    def forbidden_mapping_copy(*args, **kwargs):
+        raise AssertionError("mapping_copy must not run on a memo hit")
+
+    sve_module.mapping_copy = forbidden_mapping_copy
+    try:
+        runtime._load_w8a8(artifact)
+        runtime._load_w8a8(artifact)
+    finally:
+        sve_module.mapping_copy = real_mapping_copy
+
     # A new Artifact object with a tampered declaration misses the memo and is
     # rejected by the full decode + the per-dispatch declaration gate.
-    runtime._require_w8a8_declaration = real_declaration
     bad_declaration = dict(artifact.metadata["w8a8_capability"])
     bad_declaration["digest"] = "0" * 64
     tampered_metadata = dict(artifact.metadata)
