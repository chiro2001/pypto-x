+    def _infer_result_type(
+        self,
+        op_name: str,
+        inputs: tuple[ValueRef, ...],
+        output: ValueRef,
+        path: str,
+        value_id: Optional[int] = None,
+    ) -> ValueRef:
+        if not inputs or output.type.kind != "unknown":
+            if inputs and output.type.kind != "unknown":
+                self._check_inferred_type(op_name, inputs, output, path)
+            return output
+        inferred: Optional[CoreType] = None
+        if op_name in {"identity", "neg"} and len(inputs) == 1 and self._type_known(inputs[0].type):
+            inferred = inputs[0].type
+        elif op_name in {"add", "sub", "mul", "div"} and len(inputs) == 2:
+            left, right = inputs
+            if self._type_known(left.type) and self._type_known(right.type):
+                if left.type == right.type:
+                    inferred = left.type
+                elif (
+                    left.type.dtype == right.type.dtype
+                    and left.type.kind == "tensor"
+                    and right.type.kind == "scalar"
+                ):
+                    inferred = left.type
+                elif (
+                    left.type.dtype == right.type.dtype
+                    and left.type.kind == "scalar"
+                    and right.type.kind == "tensor"
+                ):
+                    inferred = right.type
+                else:
+                    self.diagnostic(path, "type_conflict", "binary 输入 CoreType 不一致，不能推导 result")
+        elif op_name == "matmul" and len(inputs) == 2:
+            left, right = inputs
+            if self._type_known(left.type) and self._type_known(right.type):
+                if (
+                    left.type.kind == right.type.kind == "tensor"
+                    and left.type.dtype == right.type.dtype
+                    and len(left.type.shape) == len(right.type.shape) == 2
+                    and left.type.shape[1] == right.type.shape[0]
+                ):
+                    inferred = CoreType("tensor", left.type.dtype, (left.type.shape[0], right.type.shape[1]))
+                else:
+                    self.diagnostic(path, "type_conflict", "matmul 输入 CoreType 不一致，不能推导 result")
+        if inferred is None:
+            return output
+        if value_id is None:
+            value_id = self._value_id_from_ref(output)
+        return self._update_value_type(value_id, output, inferred, path)
+
+    def _check_inferred_type(
+        self,
+        op_name: str,
+        inputs: tuple[ValueRef, ...],
+        output: ValueRef,
+        path: str,
+    ) -> None:
+        if op_name in {"identity", "neg"} and len(inputs) == 1 and self._type_known(inputs[0].type):
+            if inputs[0].type != output.type:
+                self.diagnostic(path, "type_conflict", f"{op_name} result CoreType 与输入不一致")
+        elif op_name in {"add", "sub", "mul", "div"} and len(inputs) == 2:
+            left, right = inputs
+            if self._type_known(left.type) and self._type_known(right.type):
+                expected = left.type if left.type == right.type else None
+                if expected is None and left.type.dtype == right.type.dtype:
+                    if left.type.kind == "tensor" and right.type.kind == "scalar":
+                        expected = left.type
+                    elif left.type.kind == "scalar" and right.type.kind == "tensor":
+                        expected = right.type
+                if expected is None:
+                    self.diagnostic(path, "type_conflict", "binary 输入 CoreType 不一致")
+                elif expected != output.type:
+                    self.diagnostic(path, "type_conflict", "binary result CoreType 与输入不一致")
+        elif op_name == "matmul" and len(inputs) == 2:
+            left, right = inputs
+            if not (
+                self._type_known(left.type)
+                and self._type_known(right.type)
+                and left.type.kind == right.type.kind == "tensor"
+                and left.type.dtype == right.type.dtype
+                and len(left.type.shape) == len(right.type.shape) == 2
+                and left.type.shape[1] == right.type.shape[0]
+            ):
+                self.diagnostic(path, "type_conflict", "matmul 输入 CoreType 不一致")
+            elif output.type != CoreType("tensor", left.type.dtype, (left.type.shape[0], right.type.shape[1])):
+                self.diagnostic(path, "type_conflict", "matmul result CoreType 与输入不一致")
+
+    def _value_id_from_ref(self, ref: ValueRef) -> int:
+        name = ref.name[2:] if ref.name.startswith("%v") else ""
+        if name.isdigit():
+            return int(name)
+        raise PilCoreBridgeError(f"无法从 ValueRef {ref.name} 恢复 PIL Value id")
