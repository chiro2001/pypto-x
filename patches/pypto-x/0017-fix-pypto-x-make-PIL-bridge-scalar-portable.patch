+    def _update_value_type(self, value_id: int, ref: ValueRef, value_type: CoreType, path: str) -> ValueRef:
+        if ref.type == value_type:
+            return ref
+        if ref.type.kind == "unknown":
+            self.diagnostics = [
+                item
+                for item in self.diagnostics
+                if not (item.kind == "unknown_type" and item.path == path + ".type")
+            ]
+        typed = ValueRef(ref.name, value_type)
+        self._value_refs[value_id] = typed
+        self._value_types[value_id] = value_type
+        return typed
