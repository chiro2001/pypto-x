+#!/usr/bin/env bash
+# Build the A3 transfer bundle for sve256-liveness-release.
+#
+# Runs on the LOCAL machine.  Ships only source + the focused suites + the
+# whole-net driver + golden input_ids + RoPE tables.  Model weights are never
+# shipped: the A3 side reads the already-present ~/models/Qwen3.5-0.8B.
+set -euo pipefail
+
+WT=/home/chiro/projects/pypto/worktrees/pypto-x/sve256-liveness-release
+EV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/sve256-liveness-release
+GOLD=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+ROPE_SRC=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/qwen35-bf16-weighted-execution/reference_rope
+BUNDLE="${EV}/a3_bundle"
+TESTS=(
+  qwen35_weighted_execution_driver.py
+  test_w8a8_sve256.py
+  test_cpu_sve256_layout.py
+  test_cpu_sve256_indexing.py
+)
+
+rm -rf "${BUNDLE}"
+mkdir -p "${BUNDLE}/src/python/tests/ut/pypto_x" "${BUNDLE}/refmin/float32" "${BUNDLE}/rope"
+
+tar -C "${WT}" -cf - --exclude='__pycache__' --exclude='*.pyc' python/pypto \
+  | tar -C "${BUNDLE}/src" -xf -
+for test in "${TESTS[@]}"; do
+  cp -f "${WT}/python/tests/ut/pypto_x/${test}" "${BUNDLE}/src/python/tests/ut/pypto_x/"
+done
+cp -f "${WT}/tools/sve256_liveness_evidence/run_a3_window.sh" "${BUNDLE}/"
+
+# Golden input_ids only (no logits ever leave the reference machine).
+python3 - "${GOLD}" "${BUNDLE}/refmin/float32" <<'PY'
+import sys
+from pathlib import Path
+import numpy as np
+
+gold = Path(sys.argv[1])
+out = Path(sys.argv[2])
+out.mkdir(parents=True, exist_ok=True)
+total = 0
+for prompt in ("en_continuation", "zh_continuation", "chat_zh_user"):
+    with np.load(gold / "float32" / (prompt + ".npz"), allow_pickle=False) as data:
+        ids = np.asarray(data["input_ids"])
+    path = out / (prompt + ".npz")
+    np.savez(path, input_ids=ids)
+    total += path.stat().st_size
+    print("[refmin] {} input_ids={} bytes={}".format(prompt, ids.tolist(), path.stat().st_size))
+print("[refmin] total_bytes={}".format(total))
+PY
+
+cp -f "${ROPE_SRC}/rope_summary.json" "${BUNDLE}/rope/"
+for prompt in en_continuation zh_continuation chat_zh_user; do
+  cp -f "${ROPE_SRC}/${prompt}.npz" "${BUNDLE}/rope/"
+done
+
+(
+  cd "${BUNDLE}"
+  find . -type f ! -name 'MANIFEST.sha256' -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256
+)
+BUNDLE_BYTES=$(du -sb "${BUNDLE}" | cut -f1)
+TAR="${EV}/a3_bundle.tar"
+tar -C "${EV}" -cf "${TAR}" a3_bundle
+echo "[bundle] dir=${BUNDLE} bytes=${BUNDLE_BYTES} tar=${TAR} tar_bytes=$(stat -c %s "${TAR}")"
+sha256sum "${TAR}" | tee "${EV}/a3_bundle.tar.sha256"
diff --git a/tools/sve256_liveness_evidence/run_a3_window.sh b/tools/sve256_liveness_evidence/run_a3_window.sh
new file mode 100755
index 000000000..b373299b1
--- /dev/null
+++ b/tools/sve256_liveness_evidence/run_a3_window.sh
@@ -0,0 +1,154 @@
+#!/usr/bin/env bash
+# sve256-liveness-release A3 window.  Runs ON a3-21 as l00886679.
+#
+# Deliverables, in order:
+#   1. env evidence (host/SVE/python/clock/cpuset);
+#   2. the same focused SVE256 suites used locally, now with
+#      PYPTO_X_SVE_TEST_MODE=native (W8A8 4-opcode, layout, indexing);
+#   3. the Q5 whole-net BF16 protocol for en_continuation T=5
+#      (prefill + 4 decode) twice with identical inputs/flags/cpus:
+#        - release disabled  (pre-change semantics A/B control)
+#        - release enabled   (the change)
+#      with an external /proc/<pid>/status VmRSS/VmHWM sampler per leg.
+#
+# Discipline: only writes under ~/pypto-x-a3/sve256-liveness-release, only
+# tasksets host CPUs 320-334 (8 even physical cores, no HT), never touches
+# the NPU/chip7 or any other user's directory/config.
+set -u
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PY="${HOME}/pypto-x-a3/envs/pypto-x-c8/bin/python"
+DRIVER="${ROOT}/src/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py"
+ASSET="${HOME}/models/Qwen3.5-0.8B"
+RAW="${ROOT}/raw"
+LOGS="${ROOT}/logs"
+WORK="${ROOT}/work"
+TMP="${ROOT}/tmp"
+CPUS=320,322,324,326,328,330,332,334
+mkdir -p "${RAW}" "${LOGS}" "${WORK}" "${TMP}"
+rm -f "${RAW}/sha256sums.txt"
+
+export PYTHONPATH="${ROOT}/src/python"
+export PYPTO_X_PORTABLE_ONLY=1
+export TMPDIR="${TMP}"
+export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8
+export OMP_PROC_BIND=close OMP_PLACES=cores
+
+{
+  echo "== sve256-liveness-release a3 window =="
+  date -u '+started_utc=%Y-%m-%dT%H:%M:%SZ'
+  date '+started_local=%Y-%m-%dT%H:%M:%S%z'
+  echo "hostname=$(hostname) user=$(whoami) home=${HOME} kernel=$(uname -r)"
+  echo "cpuset_self=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  echo "nproc=$(nproc) mem_total_kib=$(awk '/^MemTotal:/{print $2}' /proc/meminfo) mem_available_kib=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)"
+  echo "python=$(${PY} --version 2>&1) cc=$(cc --version | head -1)"
+  echo "env_numpy=$(${PY} -c 'import numpy; print(numpy.__version__)' 2>&1)"
+  echo "weight_bytes=$(stat -c %s "${ASSET}/model.safetensors-00001-of-00001.safetensors" 2>/dev/null)"
+  echo "taskset_window_self=$(taskset -c "${CPUS}" awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  ${PY} - <<'PY'
+from pypto.lowering.cpu.aarch64.sve import probe_sve256_capabilities
+import json
+capability = probe_sve256_capabilities(execution_mode="native")
+print("sve256_capability=" + json.dumps(capability.to_dict(), sort_keys=True))
+PY
+} > "${LOGS}/env_evidence.log" 2>&1
+
+a3_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
+printf 'a3_utc=%s\na3_epoch=%s\n' "${a3_utc}" "$(date -u +%s)" > "${RAW}/a3_clock.txt"
+
+# --- 1. focused suites, native ---------------------------------------------
+run_suite() {
+  local name="$1"; shift
+  local log="${LOGS}/native_${name}.log"
+  echo "[suite] ${name} start=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  taskset -c "${CPUS}" env PYPTO_X_SVE_TEST_MODE=native "${PY}" -m pytest -q \
+    -p no:cacheprovider --confcutdir="${ROOT}/src/python/tests/ut/pypto_x" "$@" \
+    > "${log}" 2>&1
+  local rc=$?
+  echo "[suite] ${name} exit=${rc}"
+  tail -3 "${log}"
+  return 0
+}
+
+python_tests="${ROOT}/src/python/tests/ut/pypto_x"
+run_suite w8a8 "${python_tests}/test_w8a8_sve256.py"
+run_suite layout "${python_tests}/test_cpu_sve256_layout.py"
+run_suite indexing "${python_tests}/test_cpu_sve256_indexing.py"
+
+# --- 2. whole-net BF16 A/B legs --------------------------------------------
+start_sampler() {
+  local pid="$1" out="$2"
+  (
+    echo "# pid=${pid} started_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+    local cg=""
+    if [ -r "/proc/${pid}/cgroup" ]; then
+      cg=$(sed -n 's/^0:://p' "/proc/${pid}/cgroup")
+    fi
+    while kill -0 "${pid}" 2>/dev/null; do
+      local ts mem cur peak
+      ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
+      mem=$(awk '/^VmRSS:/{rss=$2} /^VmHWM:/{hwm=$2} END{printf "rss_kib=%s hwm_kib=%s", rss, hwm}' "/proc/${pid}/status" 2>/dev/null)
+      cur=""; peak=""
+      if [ -n "${cg}" ] && [ -r "/sys/fs/cgroup${cg}/memory.current" ]; then
+        cur=$(cat "/sys/fs/cgroup${cg}/memory.current" 2>/dev/null)
+        peak=$(cat "/sys/fs/cgroup${cg}/memory.peak" 2>/dev/null)
+      fi
+      echo "${ts} ${mem} cgroup_current_bytes=${cur} cgroup_peak_bytes=${peak}"
+      sleep 5
+    done
+  ) > "${out}" 2>&1 &
+  echo $!
+}
+
+run_leg() {
+  local label="$1"; shift
+  local out="${RAW}/liveness_ab_release_${label}.json"
+  local progress="${RAW}/liveness_ab_release_${label}.progress.log"
+  local log="${LOGS}/liveness_ab_release_${label}.log"
+  local samples="${RAW}/rss_${label}.samples"
+  local leg_work="${WORK}/liveness_ab_release_${label}"
+  rm -f "${out}" "${progress}" "${log}" "${samples}"
+  mkdir -p "${leg_work}"
+  echo "[leg:${label}] start=$(date -u '+%Y-%m-%dT%H:%M:%SZ') cpus=${CPUS}"
+  taskset -c "${CPUS}" "${PY}" "${DRIVER}" \
+    --stage s3 --backend sve256 --precision bf16 \
+    --prompt en_continuation --steps 5 --decode-steps 4 \
+    --asset-dir "${ASSET}" --reference-dir "${ROOT}/refmin" --rope-dir "${ROOT}/rope" \
+    --skip-gold-alignment --no-watchdog \
+    --output "${out}" --progress "${progress}" --work-dir "${leg_work}" \
+    "$@" \
+    > "${log}" 2>&1 &
+  local pid=$!
+  echo "${pid}" > "${RAW}/liveness_ab_release_${label}.pid"
+  local sampler
+  sampler=$(start_sampler "${pid}" "${samples}")
+  wait "${pid}"
+  local rc=$?
+  wait "${sampler}" 2>/dev/null
+  echo "[leg:${label}] exit=${rc} end=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  tail -2 "${log}"
+  return "${rc}"
+}
+
+leg_a_rc=0
+leg_b_rc=0
+run_leg disabled --disable-liveness-release || leg_a_rc=$?
+run_leg enabled || leg_b_rc=$?
+
+# --- 3. discipline / residue ------------------------------------------------
+{
+  echo "== discipline =="
+  date -u '+finished_utc=%Y-%m-%dT%H:%M:%SZ'
+  echo "leg_disabled_exit=${leg_a_rc} leg_enabled_exit=${leg_b_rc}"
+  echo "write_path_only=${ROOT}"
+  echo "cpus_used=${CPUS} concurrency=1 case x 8 threads (no HT)"
+  echo "-- own processes still alive (must be none) --"
+  ps -u "$(whoami)" -o pid,psr,nlwp,pcpu,rss,args | grep -E "qwen35_weighted_execution_driver|test_w8a8_sve256|test_cpu_sve256" | grep -v grep || echo "NO_RESIDUE"
+  echo "-- NPU: this script never invokes npu-smi / ACL / torch_npu; no ASCEND device env is set --"
+  [[ -z "${ASCEND_RT_VISIBLE_DEVICES:-}" ]] && echo "ASCEND_RT_VISIBLE_DEVICES=unset"
+  echo "-- tree size --"
+  du -sb "${ROOT}" 2>/dev/null
+} > "${LOGS}/discipline_check.txt" 2>&1
+
+( cd "${ROOT}" && find raw logs -type f -print0 | sort -z | xargs -0 sha256sum > raw/sha256sums.txt 2>/dev/null )
+echo "[window] done rc_disabled=${leg_a_rc} rc_enabled=${leg_b_rc}"
