diff --git a/tools/sve256_liveness_evidence/compare_ab.py b/tools/sve256_liveness_evidence/compare_ab.py
new file mode 100644
index 000000000..581a97419
--- /dev/null
+++ b/tools/sve256_liveness_evidence/compare_ab.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+"""Compare the A3 release-disabled/release-enabled whole-net legs.
+
+Reads the two driver JSONs, proves the per-launch output raw_sha256 maps are
+identical, and prints the RSS / wall-clock A/B table.  Writes a compact
+machine-readable summary next to the evidence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+def _outputs_digest(record):
+    return {
+        name: entry["raw_sha256"]
+        for name, entry in sorted(record.get("outputs", {}).items())
+    }
+
+
+def _launch_rows(label, record):
+    rows = [
+        {
+            "leg": label,
+            "launch": "prefill",
+            "launch_seconds": record.get("launch_seconds"),
+            "rss_peak_mib": record.get("rss_peak_mib"),
+            "outputs_sha256": _outputs_digest(record),
+            "argmax": record.get("prefill_next_token"),
+        }
+    ]
+    for step in record.get("decode_steps", []):
+        rows.append(
+            {
+                "leg": label,
+                "launch": "decode[{}]".format(step.get("decode_step")),
+                "launch_seconds": step.get("launch_seconds"),
+                "rss_peak_mib": step.get("rss_peak_mib"),
+                "outputs_sha256": _outputs_digest(step),
+                "argmax": step.get("argmax_token"),
+            }
+        )
+    return rows
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--disabled", required=True, type=Path)
+    parser.add_argument("--enabled", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--baseline-rss-mib", type=int, default=68218)
+    parser.add_argument("--baseline-prefill-seconds", type=float, default=241.897)
+    args = parser.parse_args()
+
+    disabled = json.loads(args.disabled.read_text())
+    enabled = json.loads(args.enabled.read_text())
+    rows_disabled = _launch_rows("disabled", disabled)
+    rows_enabled = _launch_rows("enabled", enabled)
+
+    assert len(rows_disabled) == len(rows_enabled), "launch count differs"
+    comparisons = []
+    for left, right in zip(rows_disabled, rows_enabled):
+        same = left["outputs_sha256"] == right["outputs_sha256"]
+        same_argmax = left["argmax"] == right["argmax"]
+        comparisons.append(
+            {
+                "launch": left["launch"],
+                "bit_identical_outputs": same,
+                "same_argmax": same_argmax,
+                "disabled_launch_seconds": left["launch_seconds"],
+                "enabled_launch_seconds": right["launch_seconds"],
+                "disabled_rss_peak_mib": left["rss_peak_mib"],
+                "enabled_rss_peak_mib": right["rss_peak_mib"],
+            }
+        )
+
+    all_bit_identical = all(item["bit_identical_outputs"] for item in comparisons)
+    prefill = comparisons[0]
+    decode_disabled = sum(item["disabled_launch_seconds"] for item in comparisons[1:])
+    decode_enabled = sum(item["enabled_launch_seconds"] for item in comparisons[1:])
+    summary = {
+        "all_launches_bit_identical": all_bit_identical,
+        "all_argmax_identical": all(item["same_argmax"] for item in comparisons),
+        "launch_count": len(comparisons),
+        "prefill_seconds_disabled": prefill["disabled_launch_seconds"],
+        "prefill_seconds_enabled": prefill["enabled_launch_seconds"],
+        "decode_total_seconds_disabled": round(decode_disabled, 3),
+        "decode_total_seconds_enabled": round(decode_enabled, 3),
+        "whole_run_seconds_disabled": disabled.get("wall_seconds"),
+        "whole_run_seconds_enabled": enabled.get("wall_seconds"),
+        "rss_peak_mib_disabled": disabled.get("rss_peak_mib"),
+        "rss_peak_mib_enabled": enabled.get("rss_peak_mib"),
+        "recorded_baseline_rss_mib": args.baseline_rss_mib,
+        "recorded_baseline_prefill_seconds": args.baseline_prefill_seconds,
+        "rss_peak_delta_vs_recorded_baseline_mib": (
+            None
+            if enabled.get("rss_peak_mib") is None
+            else enabled.get("rss_peak_mib") - args.baseline_rss_mib
+        ),
+        "rss_peak_reduction_vs_disabled_mib": (
+            None
+            if enabled.get("rss_peak_mib") is None or disabled.get("rss_peak_mib") is None
+            else disabled.get("rss_peak_mib") - enabled.get("rss_peak_mib")
+        ),
+        "graph_digest_disabled": disabled.get("graph_digest"),
+        "graph_digest_enabled": enabled.get("graph_digest"),
+        "operation_total": enabled.get("operation_total"),
+        "decode_token_ids_disabled": disabled.get("decode_token_ids_ours"),
+        "decode_token_ids_enabled": enabled.get("decode_token_ids_ours"),
+        "launches": comparisons,
+    }
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(summary, indent=2, ensure_ascii=False) + "\n")
+    print(json.dumps({k: v for k, v in summary.items() if k != "launches"}, indent=2, ensure_ascii=False))
+    print("\nper-launch:")
+    for item in comparisons:
+        print(
+            "  {launch:10s} bit_identical={bit_identical_outputs} "
+            "argmax_same={same_argmax} prefill/dis_lau={disabled_launch_seconds} "
+            "en={enabled_launch_seconds} rss_dis={disabled_rss_peak_mib} rss_en={enabled_rss_peak_mib}".format(
+                **item
+            )
+        )
+    if not all_bit_identical:
+        raise SystemExit("BIT-IDENTITY FAILED: release changed an output digest")
+    if not summary["all_argmax_identical"]:
+        raise SystemExit("ARGMAX MISMATCH between release-disabled and release-enabled legs")
+
+
+if __name__ == "__main__":
+    main()
