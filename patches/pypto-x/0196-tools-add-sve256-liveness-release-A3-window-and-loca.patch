index 000000000..49c84998b
--- /dev/null
+++ b/tools/sve256_liveness_evidence/run_with_lock_retry.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# 在全局 local 锁 BUSY(75)/资源不足(69) 时按策略等待重试，绝不绕过 run_local_heavy.sh。
+# 重试节奏：每 300 s（本任务启动字段要求）。
+#
+# usage: run_with_lock_retry.sh <attempts> <sleep_seconds> <log_prefix> -- <runner args...>
+set -uo pipefail
+
+attempts=$1
+sleep_seconds=$2
+log_prefix=$3
+shift 3
+[[ ${1:-} == -- ]] || { echo "missing -- separator" >&2; exit 64; }
+shift
+
+RUNNER=/home/chiro/projects/pypto/pypto_x/scripts/resource/run_local_heavy.sh
+mkdir -p "$(dirname -- "${log_prefix}")"
+
+for ((attempt = 1; attempt <= attempts; attempt++)); do
+  echo "[run_with_lock_retry] attempt ${attempt}/${attempts} at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  start_ns=$(date +%s%N)
+  "${RUNNER}" "$@" > "${log_prefix}.attempt${attempt}.log" 2>&1
+  status=$?
+  end_ns=$(date +%s%N)
+  printf '[run_with_lock_retry] attempt %d exit=%d wall=%.1fs\n' \
+    "${attempt}" "${status}" "$(echo "scale=1; (end_ns - start_ns)/1000000000" | bc)"
+  cat "${log_prefix}.attempt${attempt}.log"
+  if [[ ${status} -ne 75 && ${status} -ne 69 ]]; then
+    exit "${status}"
+  fi
+  if (( attempt < attempts )); then
+    sleep "${sleep_seconds}"
+  fi
+done
+echo "[run_with_lock_retry] exhausted ${attempts} attempts while the local lock stayed BUSY" >&2
+exit 75
