From 2f7c491343d71aeeac497593289818bcaca9ca9b Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sun, 13 Sep 2026 12:23:34 +0800
Subject: [PATCH 263/274] feat(execution): add discovery document conveniences

task=u3-discovery
follow-up to c60658974:

- explain gains a report-shaped guarantees view alongside numeric_guarantee
  (precision_class mirrors numeric_class) for discoverability consumers;
- doctor_document / explain_document / plan_document return plain mappings
  next to the typed DoctorReport / Explanation / PlanDocument objects.
---
 python/pypto/execution/__init__.py                  |  6 ++++++
 python/pypto/execution/discovery.py                 | 45 +++++++++++++++++++++++++++++++++++++++++
 python/tests/ut/pypto_x/test_execution_discovery.py | 13 ++++++++++++
 3 files changed, 64 insertions(+)

diff --git a/python/pypto/execution/__init__.py b/python/pypto/execution/__init__.py
index 1ab5c9884..e71e73cfe 100644
--- a/python/pypto/execution/__init__.py
+++ b/python/pypto/execution/__init__.py
@@ -160,9 +160,12 @@ from .discovery import (
     Explanation,
     PlanDocument,
     doctor,
+    doctor_document,
     explain,
+    explain_document,
     export_capability_snapshot,
     import_capability_snapshot,
+    plan_document,
     plan_request,
 )
 
@@ -338,8 +341,11 @@ __all__ = [
     "PlanDocument",
     "cli_main",
     "doctor",
+    "doctor_document",
     "explain",
+    "explain_document",
     "export_capability_snapshot",
     "import_capability_snapshot",
+    "plan_document",
     "plan_request",
 ]
diff --git a/python/pypto/execution/discovery.py b/python/pypto/execution/discovery.py
index 16d7ce515..33f76a6c1 100644
--- a/python/pypto/execution/discovery.py
+++ b/python/pypto/execution/discovery.py
@@ -562,6 +562,22 @@ def _explain_document(
     fallback_used = bool(payload["fallback"].get("used", False))
     if why is None:
         why = _entry_explain(plan, selected_provider, fallback_used)
+    numeric = payload["numeric_guarantee"]
+    guarantee_view = {
+        "numeric_class": numeric["class"],
+        "precision_class": numeric["class"],
+        "scope": numeric["scope"],
+        "deterministic": bool(numeric["deterministic"]),
+        "accumulation": numeric["accumulation"],
+        "rounding": numeric["rounding"],
+        "reduction_order": numeric["reduction_order"],
+        "reduction_order_id": numeric["reduction_order_id"],
+        "exactness_basis": numeric["exactness_basis"],
+        "reference": numeric["reference"],
+        "error_budget": numeric.get("error_budget"),
+    }
+    if numeric.get("exactness_basis_detail"):
+        guarantee_view["exactness_basis_detail"] = numeric["exactness_basis_detail"]
     document = {
         "schema_version": DISCOVERY_SCHEMA_VERSION,
         "kind": "explain",
@@ -572,6 +588,7 @@ def _explain_document(
         "resolved_policy": mapping_copy(payload["policy"]["resolved"]),
         "selected": mapping_copy(payload["selected"]),
         "numeric_guarantee": mapping_copy(payload["numeric_guarantee"]),
+        "guarantees": guarantee_view,
         "layout_decision": mapping_copy(payload["layout_decision"]),
         "candidates": [mapping_copy(item) for item in payload["candidates"]],
         "rejections": [mapping_copy(item) for item in payload["resolution"]["rejections"]],
@@ -1124,6 +1141,31 @@ def doctor(capability: Any = None) -> DoctorReport:
     )
 
 
+def doctor_document(capability: Any = None) -> Mapping[str, Any]:
+    """Convenience wrapper returning the doctor document as a plain mapping."""
+
+    return doctor(capability).to_dict()
+
+
+def explain_document(**kwargs: Any) -> Mapping[str, Any]:
+    """Convenience wrapper returning the explain document as a plain mapping."""
+
+    return explain(**kwargs).to_dict()
+
+
+def plan_document(
+    op: str,
+    left_shape: Any,
+    right_shape: Any,
+    dtype: Any = None,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Any = None
+) -> Mapping[str, Any]:
+    """Convenience wrapper returning the plan wrapper document as a mapping."""
+
+    return plan_request(op, left_shape, right_shape, dtype, policy, capability).to_dict()
+
+
 __all__ = [
     "DISCOVERY_SCHEMA_VERSION",
     "ENV_VAR_REGISTRY",
@@ -1133,8 +1175,11 @@ __all__ = [
     "Explanation",
     "PlanDocument",
     "doctor",
+    "doctor_document",
     "explain",
+    "explain_document",
     "export_capability_snapshot",
     "import_capability_snapshot",
+    "plan_document",
     "plan_request",
 ]
