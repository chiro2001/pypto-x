@@ -257,6 +263,7 @@ def test_doctor_reports_pinned_library_and_environment_status():
         assert row["status"] in ("set", "unset")
         assert "value" not in row, "raw environment values must never be echoed"
     assert document["fail_closed"] in (True, False)
+    assert doctor_document()["kind"] == "doctor"
 
 
 def test_doctor_never_leaks_private_access_information():
@@ -333,6 +340,8 @@ def test_explain_request_is_a_view_of_the_resolver_trace():
     assert document["fallback"] == dict(resolution.plan.payload["fallback"])
     assert document["why"]
     assert document["boundaries"] == [dict(item) for item in EXPLAIN_BOUNDARIES]
+    assert document["guarantees"]["precision_class"] == document["selected"]["numeric_class"]
+    assert document["guarantees"]["reduction_order_id"] == document["numeric_guarantee"]["reduction_order_id"]
     assert "execution_facts" not in document
     # A digest is present and recomputable.
     without_digest = dict(document)
@@ -405,6 +414,10 @@ def test_plan_is_replayable_deterministic_and_never_executes(monkeypatch):
     assert first.to_dict()["kind"] == "plan"
     assert first.to_dict()["capability_digest"] == snapshot.digest
     assert first.to_dict()["plan_digest"] == first.plan.digest
+    assert plan_document("matmul", (2, 3), (3, 4), "float32")["kind"] == "plan"
+    assert explain_document(
+        op="matmul", left_shape=(2, 3), right_shape=(3, 4), dtype="float32"
+    )["kind"] == "explain"
     assert calls == [], "plan_request must not execute"
 
     round_trip = import_capability_snapshot(export_capability_snapshot(snapshot))
