index 000000000..c63267358
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_portable_bootstrap.py
@@ -0,0 +1,233 @@
+"""Explicit portable bootstrap tests for the PyPTO-X public import path."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[4]
+PYTHON_ROOT = REPOSITORY_ROOT / "python"
+TEST_ROOT = PYTHON_ROOT / "tests" / "ut"
+
+
+def _run_child(script: str, *, portable: bool) -> dict:
+    environment = os.environ.copy()
+    environment["PYTHONPATH"] = os.pathsep.join((str(PYTHON_ROOT), str(TEST_ROOT)))
+    if portable:
+        environment["PYPTO_X_PORTABLE_ONLY"] = "1"
+    else:
+        environment.pop("PYPTO_X_PORTABLE_ONLY", None)
+    completed = subprocess.run(
+        [sys.executable, "-S", "-c", script],
+        env=environment,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        check=False,
+    )
+    lines = [line for line in completed.stdout.splitlines() if line.strip()]
+    if not lines:
+        raise AssertionError(
+            "child produced no JSON result (returncode={}):\nstdout={}\nstderr={}".format(
+                completed.returncode,
+                completed.stdout,
+                completed.stderr,
+            )
+        )
+    try:
+        result = json.loads(lines[-1])
+    except ValueError as exc:
+        raise AssertionError(
+            "child did not produce a JSON result:\nstdout={}\nstderr={}".format(
+                completed.stdout,
+                completed.stderr,
+            )
+        ) from exc
+    result["returncode"] = completed.returncode
+    result["stderr"] = completed.stderr
+    return result
+
+
+PORTABLE_SCRIPT = r'''
+import dataclasses
+import importlib
+import json
+import sys
+
+
+result = {"portable_marker": False}
+try:
+    import pypto
+
+    result["portable_marker"] = bool(getattr(pypto, "__portable_only__", False))
+    modules = (
+        "pypto.core_ir",
+        "pypto.target",
+        "pypto.compiler",
+        "pypto.abi",
+        "pypto.backends.cpu",
+        "pypto.frontend.core_export",
+        "pypto.frontend.pil_core_bridge",
+    )
+    for module_name in modules:
+        importlib.import_module(module_name)
+
+    forbidden = ("torch", "pypto._loader", "pypto.pypto_impl", "pypto_pro", "torch_npu")
+    result["forbidden_modules"] = [name for name in forbidden if name in sys.modules]
+
+    errors = {}
+    try:
+        pypto.Tensor
+    except (AttributeError, RuntimeError) as exc:
+        errors["pypto.Tensor"] = str(exc)
+    try:
+        importlib.import_module("pypto.frontend").jit
+    except (AttributeError, RuntimeError) as exc:
+        errors["pypto.frontend.jit"] = str(exc)
+    result["classic_errors"] = errors
+
+    from pypto.abi import LaunchRequest
+    from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+    from pypto.compiler.targets.cpu import CpuScalarCompiler
+    from pypto.core_ir import CoreType
+    from pypto.frontend.pil_core_bridge import export_pil_function
+    from pypto.target import TargetSpec
+    from pypto_x.harness import compare_outputs
+
+    @dataclasses.dataclass(frozen=True)
+    class FakeValue:
+        id: int
+        type: object = None
+
+    @dataclasses.dataclass(frozen=True)
+    class FakeParameter:
+        name: str
+        type: object
+        id: object = None
+
+    @dataclasses.dataclass
+    class FakeCall:
+        result: object
+        callee: object
+        args: tuple = ()
+        kwargs: object = ()
+
+    @dataclasses.dataclass
+    class FakeBlock:
+        id: int
+        args: tuple
+        calls: list
+        result: object = None
+        jump: object = None
+
+    @dataclasses.dataclass
+    class FakeFunction:
+        name: str
+        body: object
+        params: tuple = ()
+        parameters: object = None
+
+    def add(*_args):
+        raise AssertionError("PIL callable must not execute during Core IR export")
+
+    add.__module__ = "pypto.op.math"
+    add.__qualname__ = "add"
+    tensor_type = CoreType.tensor("DT_FP32", (2,))
+    loaded_x = FakeValue(10)
+    loaded_y = FakeValue(11)
+    output = FakeValue(12)
+    body = FakeBlock(
+        0,
+        (),
+        [
+            FakeCall(loaded_x, "pil.load", ("x",)),
+            FakeCall(loaded_y, "pil.load", ("y",)),
+            FakeCall(output, add, (loaded_x, loaded_y)),
+        ],
+        output,
+        "RETURN",
+    )
+    parsed = FakeFunction(
+        "add",
+        body,
+        parameters=(
+            FakeParameter("x", tensor_type, 1),
+            FakeParameter("y", tensor_type, 2),
+        ),
+    )
+    program = export_pil_function(parsed)
+    compiler = CpuScalarCompiler()
+    target = TargetSpec("cpu", "x86_64-linux-gnu")
+    artifact = compiler.compile(compiler.lower(program, target))
+    left = HostTensor("float32", (2,), [1.0, 2.0])
+    right = HostTensor("float32", (2,), [10.0, 20.0])
+    destination = HostTensor.zeros("float32", (2,))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[left.descriptor(readonly=True), right.descriptor(readonly=True)],
+            outputs=[destination.descriptor()],
+        )
+    )
+    report = compare_outputs([11.0, 22.0], destination.tolist())
+    result["program_verified"] = program.verify()
+    result["output"] = destination.tolist()
+    result["differential_passed"] = report.passed
+except BaseException as exc:
+    result["failure"] = "{}: {}".format(type(exc).__name__, exc)
+
+print(json.dumps(result, sort_keys=True))
+'''
+
+
+DEFAULT_SCRIPT = r'''
+import json
+import sys
+
+result = {"portable_marker": False, "imported": False}
+try:
+    import pypto
+except BaseException as exc:
+    result["error_type"] = type(exc).__name__
+    result["error"] = str(exc)
+else:
+    result["imported"] = True
+    result["portable_marker"] = bool(getattr(pypto, "__portable_only__", False))
+module = sys.modules.get("pypto")
+if module is not None:
+    result["portable_marker"] = result["portable_marker"] or bool(
+        getattr(module, "__portable_only__", False)
+    )
+print(json.dumps(result, sort_keys=True))
+'''
+
+
+def test_portable_subprocess_bootstraps_public_modules_without_native_dependencies():
+    result = _run_child(PORTABLE_SCRIPT, portable=True)
+    assert result["returncode"] == 0, result
+    assert result.get("failure") is None, result
+    assert result["portable_marker"] is True
+    assert result["forbidden_modules"] == []
+    assert set(result["classic_errors"]) == {"pypto.Tensor", "pypto.frontend.jit"}
+    for message in result["classic_errors"].values():
+        assert "PYPTO_X_PORTABLE_ONLY" in message
+        assert "complete PyPTO wheel" in message
+    assert result["program_verified"] is True
+    assert result["output"] == [11.0, 22.0]
+    assert result["differential_passed"] is True
+
+
+def test_unset_switch_never_silently_enters_portable_mode():
+    result = _run_child(DEFAULT_SCRIPT, portable=False)
+    # A complete wheel may import successfully, while a source checkout can
+    # fail in the original native loader. Both outcomes are valid here; only
+    # an implicit portable initializer would violate the contract.
+    assert result["portable_marker"] is False, result
+    if result["imported"]:
+        assert result.get("error") is None
+    else:
+        assert result.get("error_type")
