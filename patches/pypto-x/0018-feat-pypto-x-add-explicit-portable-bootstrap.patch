+    __portable_only__ = True
+    _PORTABLE_ONLY_ERROR = (
+        "classic PyPTO frontend is unavailable in portable-only mode; "
+        "unset PYPTO_X_PORTABLE_ONLY or install the complete PyPTO wheel "
+        "to use frontend.jit and the native parser"
+    )
+
+    def __getattr__(name):
+        if name in {"jit", "function", "dynamic", "parser"}:
+            raise RuntimeError(_PORTABLE_ONLY_ERROR)
+        raise AttributeError("module 'pypto.frontend' has no attribute {!r}".format(name))
