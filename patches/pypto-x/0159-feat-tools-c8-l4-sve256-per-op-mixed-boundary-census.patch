new file mode 100644
index 000000000..8ea425746
--- /dev/null
+++ b/tools/c8_sve256_a3/crosscheck_bf16.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""C8/Q5 diagnostic cross-checks for the A3 BF16 whole-net SVE256 window.
+
+Explicitly NOT an L4 verdict: the run is BF16, not W8A8, and no L4 logits
+comparison is performed.  Two outputs:
+
+1. executed census rollup (native / host_boundary / host_reference shares and
+   the op names in each boundary) from raw/a3_summary.json;
+2. token-chain cross-check of the SVE256 BF16 greedy chain against the frozen
+   W8A8 gold ``decode_token_ids`` (the gold has no row for the 5th token, which
+   is a known uncovered boundary from the W8C evidence).
+
+Usage::
+
+    python3 tools/c8_sve256_a3/crosscheck_bf16.py \
+        --summary <evidence>/raw/a3_summary.json \
+        --gold-dir <evidence>/../c8-w8a8-reference-gold/reference (or --skip-gold) \
+        --output <evidence>/raw/bf16_diagnostic_crosscheck.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any, Dict, Mapping
+
+import numpy as np
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--summary", required=True)
+    parser.add_argument("--gold-dir", default=None)
+    parser.add_argument("--variant", default="w8a8")
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    summary = json.loads(Path(args.summary).read_text(encoding="utf-8"))
+
+    report: Dict[str, Any] = {
+        "not_l4": True,
+        "note": ("BF16 whole-net SVE256 diagnostic cross-check only; not an L4 "
+                 "verdict, not a performance conclusion"),
+        "executed_census": {},
+        "token_chain_crosscheck": {},
+    }
+    for prompt, data in summary.get("prompts", {}).items():
+        prefill = data["prefill"]
+        census = prefill["census"]
+        totals = dict(prefill["census"]["boundary_totals"] or {})
+        total = sum(int(v) for v in totals.values()) or 1
+        report["executed_census"][prompt] = {
+            "operation_total": prefill["operation_total"],
+            "boundary_totals": totals,
+            "boundary_share": {key: round(int(value) / total, 6) for key, value in totals.items()},
+            "mode_totals": census["mode_totals"],
+            "host_operations": data.get("host_operations"),
+            "prefill_launch_seconds": prefill["launch_seconds"],
+            "total_wall_seconds": data["wall_seconds"],
+            "rss_peak_mib": prefill["rss_peak_mib"],
+            "all_outputs_finite": prefill["all_outputs_finite"],
+        }
+
+    gold_dir = Path(args.gold_dir) if args.gold_dir else None
+    for prompt, data in summary.get("prompts", {}).items():
+        chain = list(data.get("token_chain") or [])
+        entry: Dict[str, Any] = {"ours_chain": chain}
+        if gold_dir is not None:
+            with np.load(gold_dir / args.variant / "{}.npz".format(prompt),
+                         allow_pickle=False) as gold:
+                gold_chain = [int(v) for v in np.asarray(gold["decode_token_ids"])]
+                prefill_next_gold = int(np.argmax(np.asarray(gold["prefill_next_logits"])))
+            ours_first = chain[:len(gold_chain)]
+            entry.update({
+                "gold_decode_token_ids": gold_chain,
+                "gold_prefill_next_argmax": prefill_next_gold,
+                "ours_first_n_vs_gold": ours_first,
+                "first_n_match": ours_first == gold_chain,
+                "ours_extra_tokens_without_gold_row": chain[len(gold_chain):],
+                "note": ("gold decode_logits 只有 4 行（row0=prefill_next）；"
+                         "第 5 个 token 没有 gold 行，与 W8C 证据登记的 "
+                         "token5_6511_has_no_gold_row 边界一致"),
+            })
+        report["token_chain_crosscheck"][prompt] = entry
+
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n",
+                                 encoding="utf-8")
+    for prompt, entry in report["token_chain_crosscheck"].items():
+        print("[chain] {} ours={} gold={} first_n_match={}".format(
+            prompt, entry["ours_chain"], entry.get("gold_decode_token_ids"),
+            entry.get("first_n_match")))
+    print("[census] " + json.dumps(
+        {p: report["executed_census"][p]["boundary_share"]
+         for p in report["executed_census"]}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/c8_sve256_a3/executed_census_from_progress.py b/tools/c8_sve256_a3/executed_census_from_progress.py
new file mode 100644
index 000000000..cbcc1578d
--- /dev/null
+++ b/tools/c8_sve256_a3/executed_census_from_progress.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Executed SVE256 census from the driver ``--progress`` streams.
+
+The progress log is the per-operation record actually written by the
+instrumented runtime, so counting ``(operation, mode)`` pairs there is an
+*executed* census (not a declared/static one).  Each launch resets the op
+index to 0; launches are separated here for per-launch tables.
+
+Boundary mapping (same vocabulary as the driver):
+
+    native_*                    -> native
+    host_*_loop_*               -> host_boundary
+    host_reference              -> host_reference
+
+Usage::
+
+    python3 executed_census_from_progress.py --progress-dir <raw/a3/bf16> \
+        --output <raw/bf16_executed_census.json>
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any, Dict, List, Mapping
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+
+
+def boundary_of(mode: str) -> str:
+    if mode.startswith("native"):
+        return "native"
+    if mode == "host_reference":
+        return "host_reference"
+    if mode.startswith("host"):
+        return "host_boundary"
+    return "unclassified"
+
+
+def parse(path: Path) -> Mapping[str, Any]:
+    launches: List[Dict[str, Any]] = []
+    current: Dict[str, Any] = {"operations": {}, "boundaries": {}, "count": 0}
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            item = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        if item.get("kind") != "op":
+            continue
+        index = int(item.get("index") or 0)
+        if current["count"] and index == 0:
+            launches.append(current)
+            current = {"operations": {}, "boundaries": {}, "count": 0}
+        name = str(item.get("operation"))
+        mode = str(item.get("mode"))
+        boundary = boundary_of(mode)
+        current["count"] += 1
+        entry = current["operations"].setdefault(name, {})
+        entry[mode] = entry.get(mode, 0) + 1
+        current["boundaries"][boundary] = current["boundaries"].get(boundary, 0) + 1
+    if current["count"]:
+        launches.append(current)
+    total_ops: Dict[str, Dict[str, int]] = {}
+    total_boundaries: Dict[str, int] = {}
+    for launch in launches:
+        for name, modes in launch["operations"].items():
+            target = total_ops.setdefault(name, {})
+            for mode, count in modes.items():
+                target[mode] = target.get(mode, 0) + int(count)
+        for boundary, count in launch["boundaries"].items():
+            total_boundaries[boundary] = total_boundaries.get(boundary, 0) + int(count)
+    return {
+        "launches": launches,
+        "total_operations": total_ops,
+        "total_boundaries": total_boundaries,
+        "total_executed": sum(total_boundaries.values()),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--progress-dir", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    directory = Path(args.progress_dir).resolve()
+    report: Dict[str, Any] = {
+        "definition": {
+            "source": "driver --progress per-op stream (executed, not declared)",
+            "boundary_native": "mode starts with native_ (ELF executes the op)",
+            "boundary_host_boundary": "Python host loop around native kernels",
+            "boundary_host_reference": "Python-only implementation",
+        },
+        "prompts": {},
+    }
+    for prompt in PROMPTS:
+        path = directory / "{}.progress.log".format(prompt)
+        if not path.is_file():
+            continue
+        parsed = parse(path)
+        report["prompts"][prompt] = {
+            "launch_count": len(parsed["launches"]),
+            "launch_op_counts": [launch["count"] for launch in parsed["launches"]],
+            "launch_boundaries": [launch["boundaries"] for launch in parsed["launches"]],
+            "total_executed": parsed["total_executed"],
+            "total_boundaries": parsed["total_boundaries"],
+            "total_operations": parsed["total_operations"],
+        }
+        print("[census] {} launches={} ops_per_launch={} totals={}".format(
+            prompt, len(parsed["launches"]), [launch["count"] for launch in parsed["launches"]],
+            parsed["total_boundaries"]))
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n",
+                                 encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
