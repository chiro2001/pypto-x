 python/tests/ut/pypto_x/harness/snapshot.py     | 25 ++++++++++++++++++-------
 python/tests/ut/pypto_x/harness/test_harness.py | 16 ++++++++++++++++
 3 files changed, 43 insertions(+), 8 deletions(-)

diff --git a/python/tests/ut/pypto_x/harness/README.md b/python/tests/ut/pypto_x/harness/README.md
index a2b5372ed..141a58244 100644
--- a/python/tests/ut/pypto_x/harness/README.md
+++ b/python/tests/ut/pypto_x/harness/README.md
@@ -19,4 +19,12 @@ assert result.passed, result.to_dict()
 稳定的结构化 JSON。
 
 命令行入口 `tools/pypto_x/verify.py` 接受 JSON 数组或文本/JSON/IR 快照，适合
-在没有后端设备的 CI 阶段运行。
+在没有后端设备的 CI 阶段运行。直接导入 harness 时需要将
+`python/tests/ut` 放入 `PYTHONPATH`，例如：
+
+```bash
+PYTHONPATH=python/tests/ut python3 -m pytest \
+  --confcutdir=python/tests/ut/pypto_x python/tests/ut/pypto_x/harness
+```
+
+命令行工具会自动定位仓库内的 harness，无需额外设置 `PYTHONPATH`。
diff --git a/python/tests/ut/pypto_x/harness/snapshot.py b/python/tests/ut/pypto_x/harness/snapshot.py
index 54b0af5f0..b60817e95 100644
--- a/python/tests/ut/pypto_x/harness/snapshot.py
+++ b/python/tests/ut/pypto_x/harness/snapshot.py
@@ -68,16 +68,27 @@ class SnapshotReport:
 
 
 def _json_value(value: Any) -> Any:
-    if dataclasses.is_dataclass(value):
-        return _json_value(dataclasses.asdict(value))
-    if hasattr(value, "to_dict") and callable(value.to_dict):
-        return _json_value(value.to_dict())
-    if hasattr(value, "to_json") and callable(value.to_json):
-        encoded = value.to_json()
+    # Core IR objects own their canonical representation.  It must take
+    # precedence over dataclass reflection: IR attributes may be frozen
+    # mapping proxies which dataclasses.asdict() tries (and fails) to deepcopy.
+    to_dict = getattr(value, "to_dict", None)
+    if callable(to_dict):
+        return _json_value(to_dict())
+    to_json = getattr(value, "to_json", None)
+    if callable(to_json):
+        encoded = to_json()
+        if not isinstance(encoded, (str, bytes, bytearray)):
+            return _json_value(encoded)
         try:
             return _json_value(json.loads(encoded))
-        except (TypeError, json.JSONDecodeError):
+        except (TypeError, UnicodeDecodeError, json.JSONDecodeError):
             return str(encoded)
+    if dataclasses.is_dataclass(value):
+        # Avoid dataclasses.asdict(): it recursively deep-copies fields and is
+        # not safe for immutable mapping-like IR metadata.
+        return _json_value(
+            {field.name: getattr(value, field.name) for field in dataclasses.fields(value)}
+        )
     if isinstance(value, Mapping):
         return {str(key): _json_value(item) for key, item in value.items()}
     if isinstance(value, (list, tuple)):
