+++ b/python/tests/ut/pypto_x/qwen35_native_reduce_broadcast_diff.py
@@ -0,0 +1,365 @@
+#!/usr/bin/env python3
+"""Bit-level differential harness for native reduce/broadcast.
+
+The committed golden is produced from the pre-change implementation
+(``dca302ef4``) and replayed against the current tree:
+
+    PYPTO_X_PYPTO_ROOT=<base-src>/python/pypto python3 \
+        python/tests/ut/pypto_x/qwen35_native_reduce_broadcast_diff.py \
+        --emit <evidence>/reduce_broadcast_diff.base.json \
+        --build-dir <evidence>/base-build
+
+The same command without ``--baseline`` runs the current implementation; the
+pytest wrapper compares the SHA-256 digests per input pattern.  Inputs are
+exact raw bit patterns (finite noise, ±0, all-zero, quiet/signaling NaN, ±inf,
+subnormals), so digest equality is bit equality.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import struct
+import sys
+import time
+import types
+from collections.abc import Mapping
+from pathlib import Path
+
+
+def _plain(value):
+    """Convert frozen artifact metadata into JSON-serializable containers."""
+
+    if isinstance(value, Mapping):
+        return {str(key): _plain(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def _default_pypto_root() -> Path:
+    override = os.environ.get("PYPTO_X_PYPTO_ROOT")
+    if override:
+        return Path(override)
+    return Path(__file__).resolve().parents[3] / "pypto"
+
+
+def install_package(pypto_root: Path) -> None:
+    """Import ``pypto`` directly from a source tree, bypassing the loader."""
+
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(pypto_root)]
+    sys.modules["pypto"] = package
+    for name in list(sys.modules):
+        if name.startswith("pypto."):
+            del sys.modules[name]
+
+
+install_package(_default_pypto_root())
+
+from pypto.abi import LaunchRequest, TensorDesc  # noqa: E402
+from pypto.backends.cpu.x86 import Avx512Runtime  # noqa: E402
+from pypto.compiler import CompileOptions  # noqa: E402
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler  # noqa: E402
+from pypto.core_ir import (  # noqa: E402
+    CoreFunction,
+    CoreProgram,
+    CoreType,
+    Operation,
+    Region,
+    ValueRef,
+)
+from pypto.target import TargetSpec  # noqa: E402
+
+GENERATOR = "qwen35_native_reduce_broadcast_diff"
+TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+)
+ITEMSIZE = {"float32": 4, "bf16": 2}
+ALL_PATTERNS = ("zeros", "mixed", "nan", "snan", "inf", "subnormal")
+#: The largest pre-change cases visit every (output, input) pair twice in the
+#: host path; four patterns already cover the numeric boundaries.
+FAST_PATTERNS = ("zeros", "mixed", "nan", "snan")
+
+
+def pattern_bytes(dtype: str, count: int, pattern: str) -> bytes:
+    """Deterministic raw little-endian element bit patterns."""
+
+    if dtype not in ITEMSIZE:
+        raise ValueError("unsupported dtype {!r}".format(dtype))
+    out = bytearray()
+    state = 0x12345678
+    for index in range(count):
+        if dtype == "float32":
+            if pattern == "zeros":
+                word = 0x00000000
+            elif pattern == "mixed":
+                state = (1103515245 * state + 12345) & 0xFFFFFFFF
+                word = 0x3F000000 | (state & 0x00FFFFFF)
+            elif pattern == "nan":
+                word = 0x7FC00000 | (index & 0x3FF)
+            elif pattern == "snan":
+                word = 0x7F800001 | ((index & 0x1FFFFF) << 1)
+            elif pattern == "inf":
+                word = 0x7F800000 if index % 2 == 0 else 0xFF800000
+            elif pattern == "subnormal":
+                word = 0x00000001 + (index % 0x7F)
+            else:
+                raise ValueError("unknown pattern {!r}".format(pattern))
+            out += struct.pack("<I", word)
+        else:
+            if pattern == "zeros":
+                word = 0x0000
+            elif pattern == "mixed":
+                state = (1103515245 * state + 12345) & 0xFFFFFFFF
+                word = 0x3F00 | ((state >> 8) & 0x7F)
+            elif pattern == "nan":
+                word = 0x7FC0 | (index & 0x3F)
+            elif pattern == "snan":
+                word = 0x7F81 | ((index & 0x1F) << 1)
+            elif pattern == "inf":
+                word = 0x7F80 if index % 2 == 0 else 0xFF80
+            elif pattern == "subnormal":
+                word = 0x0001 + (index % 0x3F)
+            else:
+                raise ValueError("unknown pattern {!r}".format(pattern))
+            out += struct.pack("<H", word)
+    return bytes(out)
+
+
+def _case(name, operation, dtype, input_shape, output_shape, attributes=None,
+          patterns=ALL_PATTERNS, scalar_input=None):
+    return {
+        "name": name,
+        "operation": operation,
+        "dtype": dtype,
+        "input_shape": list(input_shape) if input_shape is not None else None,
+        "output_shape": list(output_shape),
+        "attributes": dict(attributes or {}),
+        "patterns": list(patterns),
+        "scalar_input": scalar_input,
+    }
+
+
+def build_cases() -> list:
+    cases = []
+    for steps in (1, 5, 18):
+        tag = "T{}".format(steps)
+        fast = FAST_PATTERNS if steps == 18 else ALL_PATTERNS
+        cases += [
+            _case("rsum_softmax_" + tag, "reduce_sum", "float32",
+                  [1, steps, 16, 128], [1, steps, 16, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("rmean_softmax_" + tag, "reduce_mean", "float32",
+                  [1, steps, 16, 128], [1, steps, 16, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("rmean_rms_" + tag, "reduce_mean", "float32",
+                  [1, steps, 1024], [1, steps, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("rmax_mask_" + tag, "reduce_max", "float32",
+                  [1, 8, steps, steps], [1, 8, steps, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("rsum_mask_" + tag, "reduce_sum", "float32",
+                  [1, 8, steps, steps], [1, 8, steps, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("rmean_gdr_" + tag, "reduce_mean", "float32",
+                  [1, 8, steps, 256], [1, 8, steps, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("rmean_mamba_" + tag, "reduce_mean", "float32",
+                  [1, 2, steps, 256], [1, 2, steps, 1], {"axis": -1, "keepdims": True}, fast),
+            _case("bcast_weight128_" + tag, "broadcast", "float32",
+                  [128], [1, steps, 16, 128], {"shape": [1, steps, 16, 128]}, fast),
+            _case("bcast_prob_" + tag, "broadcast", "float32",
+                  [1, steps, 16, 1], [1, steps, 16, 128], {"shape": [1, steps, 16, 128]}, fast),
+            _case("bcast_rms_" + tag, "broadcast", "float32",
+                  [1, steps, 1], [1, steps, 1024], {"shape": [1, steps, 1024]}, fast),
+            _case("bcast_mask_" + tag, "broadcast", "float32",
+                  [1, 16, 1, 1], [1, 16, 128, 128], {"shape": [1, 16, 128, 128]}, fast),
+            _case("bcast_wide_" + tag, "broadcast", "float32",
+                  [16], [1, steps, 16], {"shape": [1, steps, 16]}, fast),
+            _case("bcast_decay_" + tag, "broadcast", "float32",
+                  [1, 6144, 1], [1, 6144, steps], {"shape": [1, 6144, steps]}, fast),
+            _case("bcast_gdr_sq_" + tag, "broadcast", "float32",
+                  [1, 8, steps, 1], [1, 8, steps, steps], {"shape": [1, 8, steps, steps]}, fast),
+            _case("bcast_gdr256_" + tag, "broadcast", "float32",
+                  [1, 2, steps, 1], [1, 2, steps, 256], {"shape": [1, 2, steps, 256]}, fast),
+        ]
+    cases += [
+        # Non-trailing reduction axes: exercise the native group gather.
+        _case("reduce_axis0_nokeep", "reduce_sum", "float32", [4, 3], [3],
+              {"axis": 0, "keepdims": False}),
+        _case("reduce_axis0_keep", "reduce_sum", "float32", [4, 3], [1, 3],
+              {"axis": 0, "keepdims": True}),
+        _case("reduce_axis1_nokeep", "reduce_mean", "float32", [2, 3, 4], [2, 4],
+              {"axis": 1, "keepdims": False}),
+        _case("reduce_axes12", "reduce_max", "float32", [2, 3, 4], [2, 1, 1],
+              {"axes": (1, 2), "keepdims": True}),
+        _case("reduce_axes13", "reduce_sum", "float32", [2, 3, 4, 2], [2, 1, 4, 1],
+              {"axes": (1, 3), "keepdims": True}),
+        _case("reduce_axes_all", "reduce_sum", "float32", [2, 3, 4], [1, 1, 1],
+              {"axes": (0, 1, 2), "keepdims": True}),
+        # General broadcast shapes, including a non-monotonic source pattern.
+        _case("bcast_mid", "broadcast", "float32", [2, 1, 3], [2, 4, 3],
+              {"shape": [2, 4, 3]}),
+        _case("bcast_identity", "broadcast", "float32", [2, 3], [2, 3], {"shape": [2, 3]}),
+        # BF16 same-dtype reduce and broadcast.
+        _case("rsum_bf16", "reduce_sum", "bf16", [2, 3, 4], [2, 3, 1],
+              {"axis": 2, "keepdims": True}),
+        _case("rmean_bf16", "reduce_mean", "bf16", [2, 3, 4], [2, 3, 1],
+              {"axis": 2, "keepdims": True}),
+        _case("rmax_bf16", "reduce_max", "bf16", [2, 3, 4], [2, 3, 1],
+              {"axis": 2, "keepdims": True}),
+        _case("bcast_inner_bf16", "broadcast", "bf16", [1, 3, 1], [1, 3, 7],
+              {"shape": [1, 3, 7]}),
+        # Scalar broadcast (rank-0 source) uses the scalar parameter plane; the
+        # LaunchRequest scalar plane rejects NaN/infinity, so only finite
+        # patterns are exercised here.
+        _case("bcast_scalar", "broadcast", "float32", None, [1, 5], {"shape": [1, 5]},
+              patterns=("zeros", "mixed", "subnormal"), scalar_input=True),
+    ]
+    return cases
+
+
+CASES = build_cases()
+
+
+def _program_for(case):
+    output_dtype = case["dtype"]
+    output_type = CoreType.tensor(output_dtype, tuple(case["output_shape"]))
+    output_ref = ValueRef("output", output_type)
+    if case["scalar_input"]:
+        input_type = CoreType.scalar(case["dtype"])
+        input_ref = ValueRef("source", input_type)
+    else:
+        input_type = CoreType.tensor(case["dtype"], tuple(case["input_shape"]))
+        input_ref = ValueRef("source", input_type)
+    operation = Operation(
+        case["operation"],
+        (input_ref,),
+        (output_ref,),
+        attributes=dict(case["attributes"]),
+    )
+    return CoreProgram(
+        functions=(CoreFunction(case["name"], (input_ref,), (output_ref,), Region((operation,))),)
+    )
+
+
+def _scalar_value(pattern: str):
+    if pattern == "zeros":
+        return 0.0
+    if pattern == "mixed":
+        return -0.75
+    if pattern == "nan":
+        return float("nan")
+    if pattern == "snan":
+        return float("nan")
+    if pattern == "inf":
+        return float("inf")
+    if pattern == "subnormal":
+        return 5.0e-45
+    raise ValueError("unknown pattern {!r}".format(pattern))
+
+
+def run_case(case, build_dir: Path, runtime_factory=None):
+    program = _program_for(case)
+    compiler = Avx512Compiler()
+    target_ir = compiler.lower(program, TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx512",
+            extra={"build_dir": str(build_dir / case["name"])},
+        ),
+    )
+    modes = [entry["mode"] for entry in artifact.metadata["execution_modes"]]
+    runtime = runtime_factory(case) if runtime_factory is not None else Avx512Runtime()
+    if not runtime.is_available():
+        raise RuntimeError("AVX-512 runtime is unavailable: {}".format(runtime.availability().to_dict()))
+    input_count = 1 if case["scalar_input"] else _product(case["input_shape"])
+    output_count = _product(case["output_shape"])
+    input_dtype = case["dtype"]
+    results = {}
+    for pattern in case["patterns"]:
+        source = bytearray(pattern_bytes(input_dtype, input_count, pattern)) if not case["scalar_input"] else bytearray()
+        destination = bytearray(ITEMSIZE[input_dtype] * output_count)
+        inputs = []
+        scalars = {}
+        if case["scalar_input"]:
+            scalars = {"source": _scalar_value(pattern)}
+            input_digest = hashlib.sha256(repr(scalars["source"]).encode("utf-8")).hexdigest()
+        else:
+            inputs = [TensorDesc(input_dtype, tuple(case["input_shape"]), handle=source, readonly=True)]
+            input_digest = hashlib.sha256(bytes(source)).hexdigest()
+        request = LaunchRequest(
+            artifact,
+            inputs=inputs,
+            outputs=[TensorDesc(input_dtype, tuple(case["output_shape"]), handle=destination)],
+            scalars=scalars,
+        )
+        started = time.perf_counter()
+        try:
+            runtime.launch(request)
+        except Exception as exc:
+            raise RuntimeError(
+                "case {!r} pattern {!r} failed: {}".format(case["name"], pattern, exc)
+            ) from exc
+        elapsed = time.perf_counter() - started
+        payload = bytes(destination)
+        entry = {
+            "sha256": hashlib.sha256(payload).hexdigest(),
+            "input_sha256": input_digest,
+            "bytes": len(payload),
+            "seconds": round(elapsed, 6),
+        }
+        if len(payload) <= 4096:
+            entry["hex"] = payload.hex()
+        results[pattern] = entry
+    return {
+        "operation": case["operation"],
+        "dtype": case["dtype"],
+        "input_shape": case["input_shape"],
+        "output_shape": case["output_shape"],
+        "modes": modes,
+        "host_preexpanded_operations": _plain(artifact.metadata.get("host_preexpanded_operations", [])),
+        "native_broadcast_operations": _plain(artifact.metadata.get("native_broadcast_operations", [])),
+        "native_helper_symbols": _plain(artifact.metadata.get("native_helper_symbols", [])),
+        "patterns": results,
+    }
+
+
+def _product(shape) -> int:
+    result = 1
+    for dimension in shape:
+        result *= int(dimension)
+    return result
+
+
+def run_cases(cases, build_dir: Path, pypto_root: str = "", runtime_factory=None):
+    build_dir.mkdir(parents=True, exist_ok=True)
+    report = {
+        "generator": GENERATOR,
+        "argv": list(sys.argv),
+        "pypto_root": pypto_root or str(_default_pypto_root()),
+        "cases": {},
+    }
+    started = time.perf_counter()
+    for case in cases:
+        report["cases"][case["name"]] = run_case(case, build_dir, runtime_factory=runtime_factory)
+    report["total_seconds"] = round(time.perf_counter() - started, 3)
+    return report
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--emit", required=True, help="output JSON path")
+    parser.add_argument("--build-dir", required=True, help="artifact build directory")
+    parser.add_argument("--pypto-root", default=None, help="source tree of the pypto package")
+    args = parser.parse_args(argv)
+    if args.pypto_root:
+        install_package(Path(args.pypto_root))
+    report = run_cases(CASES, Path(args.build_dir), pypto_root=args.pypto_root or str(_default_pypto_root()))
+    output = Path(args.emit)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=1) + "\n")
+    print("cases={} seconds={}".format(len(report["cases"]), report["total_seconds"]))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
