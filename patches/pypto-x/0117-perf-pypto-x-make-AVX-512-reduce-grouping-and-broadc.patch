+        contract = decision["broadcast"]
+        output_ref = decision["output_ref"]
+        source = decision["inputs"][0].buffer
+        dtype = canonical_dtype(output_ref.type.dtype)
+        output_shape = tuple(int(dimension) for dimension in contract["output_shape"])
+        expected_input = element_count(tuple(contract["input_shape"]))
+        if source.count != expected_input:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 broadcast input length {} does not match shape {}".format(
+                    source.count, list(contract["input_shape"])
+                )
+            )
+        count = element_count(output_shape)
+        destination = _buffer_alloc(dtype, count, output_ref.name)
+        rank = int(contract["rank"])
+        strides = (ctypes.c_int64 * rank)(*contract["input_strides"])
+        shape = (ctypes.c_size_t * rank)(*output_shape)
+        function = _safe_symbol(
+            module,
+            "ptx_avx512_{}".format(contract["kernel"]),
+            [
+                _pointer(dtype),
+                _pointer(dtype),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.POINTER(ctypes.c_size_t),
+                ctypes.c_size_t,
+                ctypes.c_size_t,
+            ],
+        )
+        function(source.pointer, destination.pointer, strides, shape, rank, count)
+        return {output_ref.name: _RuntimeValue(output_ref.type, destination)}
+
     def _execute_reduction(
         self,
         name: str,
@@ -1350,6 +1478,81 @@ class Avx512Runtime:
         module: Any,
         context: str,
     ) -> _NativeBuffer:
+        """Reduce by plan geometry instead of scanning every input per output.
+
+        The earlier implementation visited every (output, input) pair and
+        recomputed its coordinates in Python, so a ``[1, T, 16, 128]``
+        last-axis reduction cost ``32768 * T**2`` operations and became
+        superlinear in ``T``.  Trailing reduction axes (which is every
+        reduction emitted by the Qwen graph) form contiguous input groups, so
+        the same native reduce kernel now runs on a pointer offset into the
+        source buffer.  Non-trailing axes gather the group with the native
+        gather kernel and then run the same reduce kernel, preserving the
+        ascending input-index candidate order and the exact numeric result.
+        """
+
+        reduction = plan.reduction
+        input_shape = reduction.input_shape
+        output_shape = reduction.output_shape
+        input_dtype = value.buffer.dtype
+        output_dtype = canonical_dtype(output_type.dtype)
+        if value.buffer.count != element_count(input_shape):
+            raise CpuAvx512ExecutionError("{} reduction input length mismatch".format(context))
+        if input_dtype != output_dtype:
+            # The vector plan assigns the output dtype to this native mode, but
+            # a mixed-dtype reduction must keep the legacy conversion path so
+            # that its bytes are unchanged.
+            return self._execute_reduction_reference(name, value, output_type, plan, module, context)
+        output = _buffer_alloc(output_dtype, reduction.output_elements, context)
+        if reduction.reduction_size == 0:
+            # ``_buffer_alloc`` already wrote the reduce_sum identity (zero);
+            # every other op keeps the explicit empty-group failure below.
+            for _output_index in range(reduction.output_elements):
+                if name == "reduce_sum":
+                    continue
+                raise CpuAvx512ExecutionError("reduce_max has an empty reduction group")
+            return output
+        if reduction.output_elements == 0:
+            return output
+        result = _buffer_alloc(output_dtype, 1, context + ".result")
+        if reduction_group_contiguous(reduction):
+            group_size = reduction.reduction_size
+            for output_index in range(reduction.output_elements):
+                group = _buffer_view(value.buffer, output_index * group_size, group_size)
+                _call_reduce(module, name, output_dtype, group, result)
+                output.pointer[output_index] = result.pointer[0]
+            return output
+        offsets = _reduction_offsets(input_shape, reduction.axes)
+        offset_array = (ctypes.c_int64 * len(offsets))(*offsets)
+        staging = _buffer_alloc(input_dtype, reduction.reduction_size, context + ".group")
+        gather = _safe_symbol(
+            module,
+            reduction_gather_symbol(input_dtype),
+            [
+                _pointer(input_dtype),
+                ctypes.POINTER(ctypes.c_int64),
+                ctypes.c_int64,
+                _pointer(input_dtype),
+                ctypes.c_size_t,
+            ],
+        )
+        for output_index, base in enumerate(_reduction_group_bases(reduction)):
+            gather(value.buffer.pointer, offset_array, base, staging.pointer, reduction.reduction_size)
+            _call_reduce(module, name, output_dtype, staging, result)
+            output.pointer[output_index] = result.pointer[0]
+        return output
+
+    def _execute_reduction_reference(
+        self,
+        name: str,
+        value: _RuntimeValue,
+        output_type: CoreType,
+        plan: Any,
+        module: Any,
+        context: str,
+    ) -> _NativeBuffer:
+        """Legacy pair-scan reduction retained for mixed-dtype inputs."""
+
         reduction = plan.reduction
         input_shape = reduction.input_shape
         output_shape = reduction.output_shape
