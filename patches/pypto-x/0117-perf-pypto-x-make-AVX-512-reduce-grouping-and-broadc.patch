+def _buffer_view(buffer: _NativeBuffer, offset: int, count: int) -> _NativeBuffer:
+    """Return a zero-copy view of ``count`` elements starting at ``offset``."""
+
+    ctype = _ctype(buffer.dtype)
+    base = ctypes.cast(buffer.pointer, ctypes.c_void_p).value
+    if base is None or (count and int(base) == 0):
+        raise CpuAvx512ExecutionError("AVX-512 buffer view requires a non-null address")
+    address = int(base) + int(offset) * ctypes.sizeof(ctype)
+    return _NativeBuffer(
+        buffer.dtype,
+        count,
+        ctypes.cast(ctypes.c_void_p(address), _pointer(buffer.dtype)),
+        buffer.owner,
+        buffer.direct,
+    )
+
+
+def _reduction_offsets(input_shape: Sequence[int], axes: Sequence[int]) -> List[int]:
+    """Element offsets of one reduction group, in ascending input-index order."""
+
+    strides = _contiguous_strides(input_shape)
+    sizes = tuple(int(input_shape[axis]) for axis in axes)
+    offsets: List[int] = []
+    coordinates = [0] * len(axes)
+    total = 1
+    for size in sizes:
+        total *= size
+    for _ in range(total):
+        offsets.append(sum(coordinates[index] * strides[axes[index]] for index in range(len(axes))))
+        for index in range(len(axes) - 1, -1, -1):
+            coordinates[index] += 1
+            if coordinates[index] < sizes[index]:
+                break
+            coordinates[index] = 0
+    return offsets
+
+
+def _reduction_group_bases(reduction: Any) -> List[int]:
+    """First input element of every reduction group in output order."""
+
+    input_shape = reduction.input_shape
+    output_shape = reduction.output_shape
+    axes = set(reduction.axes)
+    strides = _contiguous_strides(input_shape)
+    if reduction.keepdims:
+        mapping = [(axis, axis) for axis in range(len(input_shape)) if axis not in axes]
+    else:
+        mapping = [
+            (output_axis, input_axis)
+            for output_axis, input_axis in enumerate(
+                axis for axis in range(len(input_shape)) if axis not in axes
+            )
+        ]
+    bases: List[int] = []
+    for output_index in range(reduction.output_elements):
+        coordinates = _unravel(output_index, output_shape)
+        base = 0
+        for output_axis, input_axis in mapping:
+            base += coordinates[output_axis] * strides[input_axis]
+        bases.append(base)
+    return bases
+
