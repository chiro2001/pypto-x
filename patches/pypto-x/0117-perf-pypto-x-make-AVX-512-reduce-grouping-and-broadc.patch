+    def _execute_broadcast(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+    ) -> Dict[str, _RuntimeValue]:
+        """Run one ``broadcast`` with the generated native kernel.
+
+        The kernel expands the contiguous source buffer in place of a Python
+        element list: ``input_strides``/``output_shape`` describe the standard
+        broadcast mapping and the destination is written directly.
+        """
