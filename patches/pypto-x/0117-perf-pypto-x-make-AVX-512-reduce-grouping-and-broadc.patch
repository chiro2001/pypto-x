+/* Native broadcast/expand.  ``input_strides`` and ``output_shape`` are written
+ * in the *output* rank: the stride of each output axis is the element stride of
+ * the input axis it maps to, or zero when the axis is new or singleton.  The
+ * kernel walks the output in row-major order and carries the source index with
+ * an odometer, so the host never materializes a Python element list.  The
+ * signaling-NaN quieting matches the host reference, which round-trips every
+ * element through a Python float before writing it back. */
+static inline uint32_t ptx_quiet_nan_f32(uint32_t bits) {
+    if ((bits & 0x7f800000U) == 0x7f800000U &&
+        (bits & 0x007fffffU) != 0U &&
+        (bits & 0x00400000U) == 0U)
+        bits |= 0x00400000U;
+    return bits;
+}
+
+static inline uint16_t ptx_quiet_nan_bf16(uint16_t bits) {
+    if ((bits & 0x7f80U) == 0x7f80U &&
+        (bits & 0x007fU) != 0U &&
+        (bits & 0x0040U) == 0U)
+        bits |= 0x0040U;
+    return bits;
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_broadcast_f32(const float *input, float *output,
+                              const int64_t *input_strides,
+                              const size_t *output_shape,
+                              size_t rank, size_t output_count) {
+    size_t coords[16];
+    size_t axis, index;
+    int64_t source = 0;
+    uint32_t bits;
+    if (rank > 16) return;
+    for (axis = 0; axis < rank; ++axis) coords[axis] = 0;
+    for (index = 0; index < output_count; ++index) {
+        memcpy(&bits, input + source, sizeof(bits));
+        bits = ptx_quiet_nan_f32(bits);
+        memcpy(output + index, &bits, sizeof(bits));
+        for (axis = rank; axis > 0; --axis) {
+            size_t last = axis - 1;
+            coords[last] += 1;
+            source += input_strides[last];
+            if (coords[last] < output_shape[last]) break;
+            source -= (int64_t)output_shape[last] * input_strides[last];
+            coords[last] = 0;
+        }
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_broadcast_bf16(const uint16_t *input, uint16_t *output,
+                               const int64_t *input_strides,
+                               const size_t *output_shape,
+                               size_t rank, size_t output_count) {
+    size_t coords[16];
+    size_t axis, index;
+    int64_t source = 0;
+    uint16_t bits;
+    if (rank > 16) return;
+    for (axis = 0; axis < rank; ++axis) coords[axis] = 0;
+    for (index = 0; index < output_count; ++index) {
+        bits = input[source];
+        output[index] = ptx_quiet_nan_bf16(bits);
+        for (axis = rank; axis > 0; --axis) {
+            size_t last = axis - 1;
+            coords[last] += 1;
+            source += input_strides[last];
+            if (coords[last] < output_shape[last]) break;
+            source -= (int64_t)output_shape[last] * input_strides[last];
+            coords[last] = 0;
+        }
+    }
+}
+
+/* Native reduction group gather.  ``offsets`` lists the element offsets of one
+ * reduction group in ascending input-index order (shared by all output
+ * elements); ``base`` selects the group.  The gathered group is then reduced
+ * by the ordinary ptx_avx512_reduce_* kernel, so the candidate order and the
+ * numeric result are bit-identical to the host reference. */
+__attribute__((visibility("default")))
+void ptx_avx512_gather_offsets_f32(const float *input, const int64_t *offsets,
+                                   int64_t base, float *output, size_t n) {
+    size_t index;
+    for (index = 0; index < n; ++index) output[index] = input[base + offsets[index]];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_gather_offsets_bf16(const uint16_t *input, const int64_t *offsets,
+                                    int64_t base, uint16_t *output, size_t n) {
+    size_t index;
+    for (index = 0; index < n; ++index) output[index] = input[base + offsets[index]];
+}
+
 __attribute__((visibility("default")))
 void ptx_avx512_neg_f32(const float *input, float *output, size_t n) {
     size_t i = 0;
@@ -748,6 +844,99 @@ def packed_kernel_contract(operation: Any, plan: Any) -> Optional[dict]:
     return None
 
 
+#: Native broadcast plane.  Broadcast is standard shape expansion (input dim 1
+#: or equal to the output dim) with the same dtype, expressed to the kernel as
+#: per-output-axis input strides; it no longer uses host pre-expansion.
+BROADCAST_MODE = "native_avx512_broadcast"
+BROADCAST_MAX_RANK = 16
+#: Non-trailing reduction axes need a native group gather before the ordinary
+#: reduce kernel; trailing axes are already contiguous and skip it.
+REDUCTION_GATHER_MODE = "native_gather_offsets"
+
+
+def _contiguous_element_strides(shape):
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def broadcast_native_contract(operation: Any, plan: Any) -> Optional[dict]:
+    """Describe the native broadcast kernel for one plan, or ``None``.
+
+    ``None`` keeps the operation on the vector-common host reference.  The
+    runtime and the artifact metadata both call this predicate, so a declared
+    kernel and the executed kernel can never disagree.
+    """
+
+    if operation is None or plan is None:
+        return None
+    if canonical_operation_name(operation.name) != "broadcast":
+        return None
+    if len(operation.inputs) != 1:
+        return None
+    try:
+        output_shape = tuple(int(dimension) for dimension in plan.shape)
+    except (TypeError, ValueError):
+        return None
+    if len(output_shape) > BROADCAST_MAX_RANK:
+        return None
+    output_dtype = canonical_dtype(plan.dtype)
+    if output_dtype not in _PACKED_DTYPES:
+        return None
+    input_type = operation.inputs[0].type
+    try:
+        input_dtype = canonical_dtype(input_type.dtype)
+    except (TypeError, ValueError):
+        return None
+    if input_dtype != output_dtype:
+        return None
+    if input_type.kind == "scalar":
+        input_shape = ()
+    elif input_type.kind in _PACKED_TENSOR_KINDS:
+        try:
+            input_shape = tuple(int(dimension) for dimension in input_type.shape)
+        except (TypeError, ValueError):
+            return None
+    else:
+        return None
+    rank_delta = len(output_shape) - len(input_shape)
+    if rank_delta < 0:
+        return None
+    input_strides = [0] * rank_delta
+    contiguous = _contiguous_element_strides(input_shape)
+    for axis, dimension in enumerate(input_shape):
+        output_dimension = output_shape[rank_delta + axis]
+        if dimension == 1:
+            input_strides.append(0)
+        elif dimension == output_dimension:
+            input_strides.append(contiguous[axis])
+        else:
+            return None
+    return {
+        "mode": BROADCAST_MODE,
+        "kernel": "broadcast_{}".format(_packed_suffix(output_dtype)),
+        "input_shape": input_shape,
+        "output_shape": output_shape,
+        "input_strides": tuple(input_strides),
+        "rank": len(output_shape),
+    }
+
+
+def reduction_group_contiguous(reduction: Any) -> bool:
+    """Return whether every reduction group is a contiguous input range."""
+
+    rank = len(reduction.input_shape)
+    axes = tuple(reduction.axes)
+    return axes == tuple(range(rank - len(axes), rank))
+
+
+def reduction_gather_symbol(dtype: str) -> str:
+    return "ptx_avx512_gather_offsets_{}".format(_packed_suffix(dtype))
+
+
 def _execution_metadata(target_ir: Avx512Program) -> dict:
     """Describe the immutable AVX-512 native/reference boundary."""
 
@@ -758,6 +947,8 @@ def _execution_metadata(target_ir: Avx512Program) -> dict:
     host_operations = []
     packed_operations = []
     packed_names = []
+    broadcast_operations = []
