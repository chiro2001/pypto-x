+++ b/python/tests/ut/pypto_x/test_qwen35_native_reduce_broadcast_diff.py
@@ -0,0 +1,287 @@
+"""Bit-level differential test for the native reduce/broadcast boundary.
+
+W8B B5 fix.  For every Qwen3.5-0.8B reduction and broadcast shape at
+T=1/5/18 (plus all-zero/NaN/inf/subnormal/signaling-NaN raw-bit patterns),
+the test runs one AVX-512 artifact per case and compares the results with the
+pre-change implementation:
+
+* when ``snapshots/qwen35_native_reduce_broadcast_diff.base.json`` is present
+  (generated by running ``qwen35_native_reduce_broadcast_diff.py`` against the
+  pre-change ``dca302ef4`` source tree), every pattern's full output bytes are
+  compared through their SHA-256 digests;
+* in addition, a representative subset runs with a runtime that evaluates the
+  new native path and the pre-change path on the same invocation and asserts
+  byte equality: reduce ``_execute_reduction`` vs the pair-scan
+  ``_execute_reduction_reference`` kept verbatim from ``dca302ef4``, and the
+  generated ``ptx_avx512_broadcast_*`` kernel vs the vector-common host
+  reference that was used before the change.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import importlib.util
+import json
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+_HERE = Path(__file__).resolve().parent
+_PYTHON_ROOT = _HERE.parents[3]
+_PYPTO_ROOT = _PYTHON_ROOT / "pypto"
+_HARNESS_PATH = _HERE / "qwen35_native_reduce_broadcast_diff.py"
+_GOLDEN_PATH = _HERE / "snapshots" / "qwen35_native_reduce_broadcast_diff.base.json"
+_HARNESS_NAME = "qwen35_native_reduce_broadcast_diff_module"
+
+#: Cases re-run through the verbatim pre-change path inside one launch.  The
+#: pair-scan reference is intentionally O(output x input), so the largest
+#: T=18 softmax reductions are covered by the committed base golden instead.
+_REFERENCE_CASES = (
+    "rmean_rms_T18",
+    "rmax_mask_T18",
+    "rsum_mask_T18",
+    "reduce_axis0_nokeep",
+    "reduce_axis0_keep",
+    "reduce_axis1_nokeep",
+    "reduce_axes12",
+    "reduce_axes13",
+    "reduce_axes_all",
+    "rsum_bf16",
+    "rmean_bf16",
+    "rmax_bf16",
+    "bcast_prob_T18",
+    "bcast_mask_T18",
+    "bcast_mid",
+    "bcast_identity",
+    "bcast_inner_bf16",
+    "bcast_scalar",
+)
+
+
+def _install_package(pypto_root: Path) -> None:
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(pypto_root)]
+    sys.modules["pypto"] = package
+    for name in list(sys.modules):
+        if name.startswith("pypto."):
+            del sys.modules[name]
+
+
+def _load_harness():
+    spec = importlib.util.spec_from_file_location(_HARNESS_NAME, _HARNESS_PATH)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[_HARNESS_NAME] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _restore(saved) -> None:
+    for name in list(sys.modules):
+        if name == "pypto" or name.startswith("pypto."):
+            del sys.modules[name]
+    sys.modules.pop(_HARNESS_NAME, None)
+    sys.modules.update(saved)
+
+
+def _buffer_bytes(buffer, runtime_module) -> bytes:
+    if not buffer.count:
+        return b""
+    itemsize = ctypes.sizeof(runtime_module._ctype(buffer.dtype))
+    address = ctypes.cast(buffer.pointer, ctypes.c_void_p)
+    return ctypes.string_at(address, buffer.count * itemsize)
+
+
+@pytest.fixture(scope="module")
+def harness_module():
+    saved = {
+        name: module
+        for name, module in sys.modules.items()
+        if name == "pypto" or name.startswith("pypto.")
+    }
+    _install_package(_PYPTO_ROOT)
+    module = _load_harness()
+    runtime_module = sys.modules["pypto.backends.cpu.x86.avx512"]
+    plan_module = sys.modules["pypto.compiler.targets.cpu_avx512"]
+    yield {"module": module, "runtime_module": runtime_module, "plan_module": plan_module}
+    _restore(saved)
+
+
+@pytest.fixture(scope="module")
+def differential(harness_module, tmp_path_factory):
+    module = harness_module["module"]
+    runtime_module = harness_module["runtime_module"]
+    runtime_cls = runtime_module.Avx512Runtime
+    if not runtime_cls().is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability")
+    instances = {}
+    compared_cases = set()
+
+    class DifferentialRuntime(runtime_cls):
+        """Evaluate the native and the pre-change path and compare bytes."""
+
+        def __init__(self, case_name: str) -> None:
+            super().__init__()
+            self.case_name = case_name
+            self.comparisons = 0
+
+        def _compare(self, label, left, right) -> None:
+            self.comparisons += 1
+            left_bytes = _buffer_bytes(left, runtime_module)
+            right_bytes = _buffer_bytes(right, runtime_module)
+            if left_bytes != right_bytes:
+                raise AssertionError(
+                    "case {} {} byte mismatch: native={} reference={}".format(
+                        self.case_name, label, left_bytes[:32].hex(), right_bytes[:32].hex()
+                    )
+                )
+
+        def _execute_reduction(self, name, value, output_type, plan, native_module, context):
+            native = super()._execute_reduction(name, value, output_type, plan, native_module, context)
+            reference = self._execute_reduction_reference(
+                name, value, output_type, plan, native_module, context
+            )
+            self._compare("reduce:{}".format(name), native, reference)
+            return native
+
+        def _execute_broadcast(self, decision, operation, plan, native_module):
+            native = super()._execute_broadcast(decision, operation, plan, native_module)
+            output_ref = decision["output_ref"]
+            host = runtime_module._reference_operation(
+                operation, plan, list(decision["inputs"]), "differential broadcast"
+            )
+            self._compare(
+                "broadcast:{}".format(plan.dtype),
+                native[output_ref.name].buffer,
+                host[output_ref.name].buffer,
+            )
+            return native
+
+    def factory(case):
+        if case["name"] in _REFERENCE_CASES:
+            runtime = DifferentialRuntime(case["name"])
+            instances[case["name"]] = runtime
+            compared_cases.add(case["name"])
+            return runtime
+        return runtime_cls()
+
+    results = module.run_cases(
+        module.CASES, tmp_path_factory.mktemp("native-diff"), runtime_factory=factory
+    )
+    yield {
+        "module": module,
+        "runtime_module": runtime_module,
+        "results": results,
+        "comparisons": sum(runtime.comparisons for runtime in instances.values()),
+        "compared_cases": compared_cases,
+        "instances": instances,
+    }
+
+
+def test_native_modes_and_metadata(harness_module, differential):
+    results = differential["results"]["cases"]
+    assert len(results) == len(differential["module"].CASES)
+    for name, case in results.items():
+        assert case["modes"], name
+        if case["operation"] == "broadcast":
+            assert set(case["modes"]) == {"native_avx512_broadcast"}, name
+            assert case["native_broadcast_operations"], name
+            assert "broadcast" not in case["host_preexpanded_operations"], name
+            assert any(
+                symbol.startswith("ptx_avx512_broadcast_")
+                for symbol in case["native_helper_symbols"]
+            ), name
+        else:
+            assert set(case["modes"]) == {"native_avx512_zmm"}, name
+    gather = "ptx_avx512_gather_offsets_f32"
+    assert gather in results["reduce_axis0_nokeep"]["native_helper_symbols"]
+    assert gather in results["reduce_axes13"]["native_helper_symbols"]
+    assert gather not in results["rsum_softmax_T18"]["native_helper_symbols"]
+    assert gather not in results["reduce_axes_all"]["native_helper_symbols"]
+
+
+def test_native_and_prechange_paths_are_bit_identical(differential):
+    cases = {case["name"]: case for case in differential["module"].CASES}
+    expected_cases = set(_REFERENCE_CASES)
+    assert differential["compared_cases"] == expected_cases
+    expected_comparisons = sum(len(cases[name]["patterns"]) for name in expected_cases)
+    assert differential["comparisons"] == expected_comparisons
+
+
+def test_golden_matches_prechange_implementation(differential):
+    if not _GOLDEN_PATH.exists():
+        pytest.skip("pre-change golden {} is not present".format(_GOLDEN_PATH.name))
+    golden = json.loads(_GOLDEN_PATH.read_text())
+    results = differential["results"]["cases"]
+    assert set(golden["cases"]) == set(results)
+    for name, expected in golden["cases"].items():
+        actual = results[name]
+        assert actual["operation"] == expected["operation"], name
+        assert actual["input_shape"] == expected["input_shape"], name
+        assert actual["output_shape"] == expected["output_shape"], name
+        assert set(actual["patterns"]) == set(expected["patterns"]), name
+        for pattern, expected_pattern in expected["patterns"].items():
+            actual_pattern = actual["patterns"][pattern]
+            assert actual_pattern["input_sha256"] == expected_pattern["input_sha256"], (name, pattern)
+            assert actual_pattern["sha256"] == expected_pattern["sha256"], (name, pattern)
+
+
+def _unravel(index, shape):
+    coordinates = [0] * len(shape)
+    for axis in range(len(shape) - 1, -1, -1):
+        coordinates[axis] = index % shape[axis]
+        index //= shape[axis]
+    return tuple(coordinates)
+
+
+def test_reduction_group_geometry_against_brute_force(harness_module):
+    plan_module = harness_module["plan_module"]
+    runtime_module = harness_module["runtime_module"]
+    cases = [
+        ((4, 3), (0,)),
+        ((2, 3, 4), (1,)),
+        ((2, 3, 4), (0, 2)),
+        ((2, 3, 4, 2), (1, 3)),
+        ((2, 3, 4), (0, 1, 2)),
+        ((3, 2), (1,)),
+    ]
+
+    def product(values):
+        result = 1
+        for value in values:
+            result *= value
+        return result
+
+    for shape, axes in cases:
+        groups = {}
+        for input_index in range(product(shape)):
+            coordinates = _unravel(input_index, shape)
+            key = tuple(coordinates[axis] for axis in range(len(shape)) if axis not in axes)
+            groups.setdefault(key, []).append(input_index)
+        ordered_keys = sorted(groups)
+        expected_offsets = [
+            value - groups[ordered_keys[0]][0] for value in groups[ordered_keys[0]]
+        ]
+        offsets = runtime_module._reduction_offsets(shape, axes)
+        assert offsets == expected_offsets, (shape, axes)
+        reduction = types.SimpleNamespace(
+            input_shape=shape,
+            output_shape=tuple(
+                dimension for axis, dimension in enumerate(shape) if axis not in axes
+            ),
+            axes=tuple(sorted(axes)),
+            keepdims=False,
+            reduction_size=product(shape[axis] for axis in axes),
+            output_elements=len(ordered_keys),
+        )
+        bases = runtime_module._reduction_group_bases(reduction)
+        for output_index, key in enumerate(ordered_keys):
+            assert bases[output_index] == groups[key][0], (shape, axes, output_index)
+            assert [bases[output_index] + offset for offset in offsets] == groups[key]
+        contiguous = plan_module.reduction_group_contiguous(
+            types.SimpleNamespace(input_shape=shape, axes=tuple(sorted(axes)))
+        )
+        assert contiguous == (
+            tuple(sorted(axes)) == tuple(range(len(shape) - len(axes), len(shape)))
+        )
