diff --git a/python/pypto/execution/decision.py b/python/pypto/execution/decision.py
new file mode 100644
index 000000000..033a891ca
--- /dev/null
+++ b/python/pypto/execution/decision.py
@@ -0,0 +1,64 @@
+"""Canonical resolution-decision document derived from a plan payload.
+
+Schema v4 embeds the plan's canonical payload in the report.  The
+``resolution_decision`` block is a deterministic projection of that payload:
+this module is the single source of truth for the projection, used both by
+the report builder (:mod:`pypto.execution.entry`) and by the schema
+validator (:mod:`pypto.execution.binding_verify`), so the embedded decision
+cannot drift from the embedded plan preimage.
+
+The module is a leaf (no provider/registry imports): the projection is pure
+data, and the plan digest is recomputed from the payload itself.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from pypto.target._utils import mapping_copy, sha256_text
+
+
+def plan_payload_digest(payload: Mapping[str, Any]) -> str:
+    """Return the canonical ``sha256:`` digest of a plan payload."""
+
+    return "sha256:" + sha256_text(payload)
+
+
+def decision_document_from_payload(payload: Mapping[str, Any]) -> Mapping[str, Any]:
+    """Project the declared/selected resolution decision from a plan payload.
+
+    Raises ``KeyError``/``TypeError`` when the payload is not a canonical plan
+    payload; the report validator converts that into a structured refusal.
+    """
+
+    selected = payload["selected"]
+    numeric = payload["numeric_guarantee"]
+    artifact = payload["artifact"]
+    return {
+        "selected_provider": str(selected["provider"]),
+        "selected_provider_version": str(selected["provider_version"]),
+        "selected_implementation": str(selected["implementation"]),
+        "selected_numeric_class": str(selected["numeric_class"]),
+        "selected_deterministic": bool(selected["deterministic"]),
+        "selected_reduction_order": str(numeric["reduction_order"]),
+        "selected_reduction_order_id": str(numeric["reduction_order_id"]),
+        "selected_library": mapping_copy(selected["library"]),
+        "selected_threads": int(selected["threads"]),
+        "selected_thread_mode": str(selected["thread_mode"]),
+        "artifact_kind": str(artifact["kind"]),
+        "artifact_contract_version": str(artifact["contract_version"]),
+        "artifact_lowering_version": int(artifact["lowering_version"]),
+        "artifact_runner_version": int(artifact["runner_version"]),
+        "artifact_wire_version": int(artifact["wire_version"]),
+        "artifact_provider_version": str(artifact["provider_version"]),
+        "artifact_provider_artifact_digest": artifact["provider_artifact_digest"],
+        "artifact_pack": mapping_copy(artifact["pack"]),
+        "artifact_library": mapping_copy(artifact["library"]),
+        "policy_digest": str(payload["request"]["policy_digest"]),
+        "capability_digest": str(payload["target"]["capability_digest"]),
+        "contract_digest": str(payload["contract"]["digest"]),
+        "plan_digest": plan_payload_digest(payload),
+    }
+
+
+__all__ = ["decision_document_from_payload", "plan_payload_digest"]
