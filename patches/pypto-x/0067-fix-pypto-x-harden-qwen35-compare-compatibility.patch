+def _tamper_vector_version(artifact, *, plan_version=None, lowering_version=None):
+    envelope = json.loads(artifact.payload.decode("utf-8"))
+    metadata = dict(artifact.metadata)
+    if plan_version is not None:
+        envelope["plan_version"] = plan_version
+        envelope["vector_plan"]["plan_version"] = plan_version
+        metadata["plan_version"] = plan_version
+    if lowering_version is not None:
+        envelope["lowering_version"] = lowering_version
+        metadata["lowering_version"] = lowering_version
+    payload = json.dumps(
+        envelope,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    metadata["payload_digest"] = hashlib.sha256(payload).hexdigest()
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=payload,
+        metadata=metadata,
+    )
+
+
+def test_vector_version_migration_rejects_plan_v2_and_lowering_v1():
+    artifact = _compile_vector(build_qwen35_position_ids(1, 2, past_length=1))
+    old_plan = _tamper_vector_version(artifact, plan_version=2)
+    old_lowering = _tamper_vector_version(artifact, lowering_version=1)
+    assert old_plan.cache_key != artifact.cache_key
+    assert old_lowering.cache_key != artifact.cache_key
+    with pytest.raises(CpuVectorArtifactError, match="unsupported CPU vector plan version"):
+        CpuVectorRuntime().load(old_plan)
+    with pytest.raises(CpuVectorArtifactError, match="unsupported CPU vector lowering version"):
+        CpuVectorRuntime().load(old_lowering)
