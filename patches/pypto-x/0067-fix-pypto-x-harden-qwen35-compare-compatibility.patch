+def comparison_predicate_for_operation(
+    operation_name: str,
+    attributes: Mapping[str, Any],
+    context: str = "compare",
+) -> str:
+    """Resolve a compare relation from an operation name and/or attributes.
+
+    Comparison aliases such as ``eq`` carry their relation in the operation
+    name.  The generic ``compare`` spelling requires an explicit attribute.
+    If both are present they must agree; this prevents an adapter from
+    silently turning ``eq(..., predicate='gt')`` into a different operation.
+    """
+
+    if not isinstance(operation_name, str):
+        raise CpuScalarValidationError("{} operation name must be a string".format(context))
+    name_predicate = _COMPARISON_NAME_PREDICATES.get(operation_name.strip().lower())
+    has_explicit = any(key in attributes for key in ("predicate", "comparison", "relation", "op"))
+    explicit = comparison_predicate(attributes, context) if has_explicit else None
+    if name_predicate is None and explicit is None:
+        raise CpuScalarValidationError("{} requires predicate".format(context))
+    if name_predicate is not None and explicit is not None and name_predicate != explicit:
+        raise CpuScalarValidationError(
+            "{} operation name predicate {!r} conflicts with explicit predicate {!r}".format(
+                context, name_predicate, explicit
+            )
+        )
+    return name_predicate or explicit
+
+
