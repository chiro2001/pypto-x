+def test_forged_plan_envelope_is_refused_even_with_recomputed_digest():
+    k = 1041
+    left = _tensor((2, k), [127] * (2 * k))
+    right = _tensor((k, 2), [127] * (k * 2))
+    plan = plan_qmatmul((2, k), (k, 2), _strict_policy()).plan
+    payload = plan.payload
+    payload["selected"]["exactness_envelope"]["deviation_bound_by_k"][
+        "all_k_le_limit"
+    ] = 1
+    payload["numeric_guarantee"]["exactness_envelope"]["deviation_bound_by_k"][
+        "all_k_le_limit"
+    ] = 1
+    forged = ExecutionPlan(payload)
+    assert forged.digest != plan.digest
+    # capability=None rebuilds the same opt-in snapshot from the frozen policy,
+    # so the refusal comes from the resolver re-derivation, not a digest check.
+    with pytest.raises(Exception) as excinfo:
+        execute_qmatmul_plan(forged, left, right)
+    assert getattr(excinfo.value, "code", None) == ARTIFACT_MISMATCH
+    assert "plan" in str(getattr(excinfo.value, "field", ""))
+    assert getattr(excinfo.value, "reason", "") in (
+        "plan_declaration_mismatch",
+        "plan_selected_field_not_reconciled_with_provider_manifest",
+    )
