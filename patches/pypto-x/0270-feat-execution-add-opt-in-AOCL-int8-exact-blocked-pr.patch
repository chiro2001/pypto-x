+@requires_execution_host
+def test_bad_codes_and_overflow_are_refused():
+    for bad in (-128, 128, 200):
+        details = _assert_failure(
+            "OP_CONTRACT_INVALID", lambda bad=bad: _check_codes([1, bad, 3], "left")
+        )
+        assert details["reason"] in ("reserved_code_point", "code_out_of_range")
+    for bad in (True, False, 1.5, "1", None):
+        details = _assert_failure(
+            "OP_CONTRACT_INVALID", lambda bad=bad: _check_codes([1, bad, 3], "left")
+        )
+        assert details["reason"] == "code_not_integer"
+    details = _assert_failure(
+        "OP_CONTRACT_INVALID", lambda: _check_int32_totals([0, 2 ** 31])
+    )
+    assert details["reason"] == "exact_block_accumulation_overflow_int32"
+    details = _assert_failure(
+        "OP_CONTRACT_INVALID", lambda: _check_int32_totals([-(2 ** 31) - 1])
+    )
+    assert details["reason"] == "exact_block_accumulation_overflow_int32"
+    # The accepted contract range cannot overflow: (2**31-1)//(127*127) is the
+    # largest K whose exact sum is representable.
+    assert AOCL_INT8_K_ACCUMULATION_LIMIT * 127 * 127 <= 2 ** 31 - 1
