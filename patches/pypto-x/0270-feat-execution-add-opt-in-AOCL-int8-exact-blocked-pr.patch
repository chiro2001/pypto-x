+    assert envelope["upper_bound"]["status"] == "proven"
+    derivation = envelope["bound_derivation"]
+    assert derivation["f32_exact_integer_limit"] == 16777216
+    assert "min(2048" in derivation["kc_rule"]
+    assert "2**24" in derivation["chunk_partial_bound"]
+    assert "order" in derivation["order_invariance"]
+    assert "arbitrary-precision" in derivation["accumulation"]
+    assert measured_witness_shortfall(envelope) == {}
