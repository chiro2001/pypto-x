+def _codes(count: int, seed: int, low: int = AOCL_INT8_QUANT_MIN, high: int = AOCL_INT8_QUANT_MAX) -> list:
+    """Deterministic LCG codes in ``[low, high]`` (no numpy dependency)."""
+
+    state = seed & 0x7FFFFFFF
+    values = []
+    span = high - low + 1
+    for _ in range(count):
+        state = (1103515245 * state + 12345) & 0x7FFFFFFF
+        values.append(low + (state % span))
+    return values
+
+
+def _tensor(shape, codes):
+    return HostTensor("int8", shape, list(codes))
+
+
+def _strict_policy(threads: int = 1, mode: str = "required") -> ExecutionPolicy:
+    """An explicit opt-in policy that pins the 0047 entry."""
+
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode=mode, required=AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID),
+        numeric=NumericPolicy(
+            requirement="deterministic", require_proven_deviation_bound=True
+        ),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=threads),
+    )
+
+
+def _proven_vendor_policy(threads: int = 1) -> ExecutionPolicy:
+    """require_proven_deviation_bound=true with both vendor entries in scope."""
+
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(
+            requirement="deterministic", require_proven_deviation_bound=True
+        ),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=threads),
+    )
+
+
+def _plain(value):
+    """Recursively normalize frozen mappings / tuples to plain JSON types."""
+
+    from collections.abc import Mapping as _Mapping
+
+    if isinstance(value, _Mapping):
+        return {str(key): _plain(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def _canonical(document):
+    """Plain JSON view: normalizes frozen mappings / tuples to dicts / lists."""
+
+    return json.loads(json.dumps(_plain(document), sort_keys=True))
+
+
+def _legacy_vendor_policy(threads: int = 1) -> ExecutionPolicy:
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=threads),
+    )
