+def _witness_tensors(k, seed):
+    """The verify-0042-u2b witness generator (uniform[100,127], m=2, n=6)."""
+
+    import numpy as np
+
+    a = np.random.default_rng(seed).integers(100, 128, size=(2, k), dtype=np.int16).astype(np.int8)
+    b = np.random.default_rng(seed + 7001).integers(100, 128, size=(k, 6), dtype=np.int16).astype(np.int8)
+    left = HostTensor("int8", (2, k), [int(value) for value in a.reshape(-1)])
+    right = HostTensor("int8", (k, 6), [int(value) for value in b.reshape(-1)])
+    exact = [int(value) for value in (a.astype(np.int64) @ b.astype(np.int64)).reshape(-1)]
+    return left, right, exact
+
+
+@requires_execution_host
+@pytest.mark.parametrize(
+    "k,seed,expected_legacy_delta",
+    ((1041, None, 1), (16696, 147, 75), (133144, 1591, 1067)),
+)
+def test_chunking_eliminates_the_legacy_observed_deviation(k, seed, expected_legacy_delta):
+    """(b) The legacy (unchunked) path shows ERR-0010 deviations on adversarial
+    inputs; the same inputs through the exact-blocked entry are bitwise equal
+    to the exact integer sum."""
+
+    if seed is None:
+        left = _tensor((2, k), [127] * (2 * k))
+        right = _tensor((k, 6), [127] * (k * 6))
+        exact = [k * 127 * 127] * 12
+    else:
+        left, right, exact = _witness_tensors(k, seed)
+
+    legacy_output, _ = execute_qmatmul(left, right, _legacy_vendor_policy())
+    legacy_delta = _max_abs_delta(legacy_output.flat(), exact)
+    assert legacy_delta == expected_legacy_delta, (legacy_delta, expected_legacy_delta)
+
+    output, report = execute_qmatmul(left, right, _strict_policy(threads=1))
+    assert _max_abs_delta(output.flat(), exact) == 0
+    assert report.to_dict()["guarantees"]["exactness_envelope"]["deviation_bound_kind"] == "exact_contract_bound"
+
