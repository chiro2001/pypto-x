+@requires_execution_host
+def test_plan_report_and_binding_verify_carry_the_manifest_envelope():
+
+    k = 1041
+    left = _tensor((2, k), [127] * (2 * k))
+    right = _tensor((k, 2), [127] * (k * 2))
+    policy = _strict_policy(threads=1)
+    resolution = plan_qmatmul((2, k), (k, 2), policy)
+    plan = resolution.plan
+    manifest = _execution_entry()
+    assert plan.numeric_guarantee["exactness_envelope"] == dict(
+        _exact_blocked_exactness_envelope()
+    )
+    assert plan.selected["exactness_basis_detail"] == AOCL_INT8_EXACT_BLOCKED_EXACTNESS_BASIS
+    assert plan.selected["reduction_order"] == AOCL_INT8_EXACT_BLOCKED_REDUCTION_ORDER
+
+    # Frozen-plan replay without an explicit capability rebuilds the opt-in
+    # snapshot from the embedded policy and must succeed.
+    output, report = execute_qmatmul_plan(plan, left, right)
+    reference = _contract_reference(left, right)
+    assert output.flat() == tuple(reference)
+    document = report.to_dict()
+    validate_report_schema(document)
+    envelope = _exact_blocked_exactness_envelope()
+    assert document["guarantees"]["exactness_envelope"] == dict(envelope)
+    assert document["resolved"]["exactness_envelope"] == dict(envelope)
+    manifest_document = document["provider_manifest"]["document"]
+    assert manifest_document["provider_id"] == AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID
+    assert manifest_document["exactness_envelope"] == dict(envelope)
+    from pypto.execution import get_op_definition as fresh_get_op_definition
+    from pypto.execution.binding_verify import (
+        report_binding_errors as fresh_report_binding_errors,
+    )
+
+    assert (
+        fresh_report_binding_errors(
+            document, fresh_get_op_definition("qmatmul_s8s8_s32")
+        )
+        == ()
+    )
+
+    # A report cannot claim a different bound than the embedded manifest.
+    tampered = json.loads(json.dumps(document))
+    tampered["guarantees"]["exactness_envelope"]["deviation_bound_by_k"][
+        "all_k_le_limit"
+    ] = 1
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(tampered)
+    assert getattr(excinfo.value, "code", None) == REPORT_SCHEMA_INVALID
