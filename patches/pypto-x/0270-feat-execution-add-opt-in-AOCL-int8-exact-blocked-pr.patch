+def _snapshot_with_exact_blocked(entry=None) -> CapabilitySnapshot:
+    """Default cpu providers plus an (optionally synthetic) 0047 entry."""
+
+    if entry is None:
+        entry = aocl_int8_exact_blocked_capability_entry({}, 6, 6, available=True)
+    return CapabilitySnapshot.for_host(
+        features=HOST_FEATURES,
+        providers=tuple(default_providers("cpu")) + (entry,),
+    )
+
+
+def _contract_reference(left: HostTensor, right: HostTensor) -> list:
+    """The W8A8 contract's exact int32 reference for one request."""
+
+    m, k = left.shape
+    n = right.shape[1]
+    result = qmatmul_s8s8_s32(
+        left.flat(), right.flat(), left_shape=(m, k), right_shape=(k, n)
+    )
+    return [int(value) for value in result.values]
+
+
+def _max_abs_delta(actual, expected) -> int:
+    return max(abs(int(got) - int(want)) for got, want in zip(actual, expected))
+
+
+def _assert_failure(error_code, callable_):
+    with pytest.raises(ExecutionError) as excinfo:
+        callable_()
+    assert excinfo.value.code == error_code, excinfo.value.to_dict()
+    return excinfo.value.to_dict()
+
+
+def _execution_entry() -> ProviderCapability:
+    return aocl_int8_exact_blocked_provider_capabilities()[0]
