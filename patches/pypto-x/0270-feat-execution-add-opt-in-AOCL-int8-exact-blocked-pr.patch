+    checkable = " ".join(residual["checkable_items"])
+    assert "aocl_gemm_s8s8s32os32" in checkable
+    assert "alpha=1" in checkable and "beta=0" in checkable and "post_op=None" in checkable
+    not_covered = " ".join(envelope["not_covered"])
+    assert "sym_quant" in not_covered
+    assert envelope["wrap_behavior"].endswith("exact_block_accumulation_overflow_int32")
