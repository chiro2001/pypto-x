+        threads_used.append(report.to_dict()["dispatch"]["threads_used"])
+    assert outputs[0] == outputs[1] == outputs[2]
+    entry_max = _execution_entry().max_threads
+    if entry_max >= 6:
+        assert threads_used == [1, 2, 6]
+
