+"""0047 AOCL int8 exact-blocked provider regression suite.
+
+The opt-in ``vendor:aocl-lpgemm-int8-exact-blocked`` entry executes the pinned
+``aocl_gemm_s8s8s32os32`` kernel in K chunks of at most
+``min(2048, floor(2**24 / (max_abs_a * max_abs_b)))`` columns so every f32
+round trip inside the kernel is the identity, then accumulates the per-chunk
+int32 outputs with exact Python integers.  Its exactness envelope carries a
+*proven* deviation bound of 0 (``exact_contract_bound``) versus the contract's
+exact int32 sum, unlike the legacy measured-snapshot envelope.
+
+Coverage (per the 0047 dispatch):
+
+* differential correctness against the contract reference for the frozen K set
+  ``{1024, 1040, 1041, 2048, 2049, 16696, 133144}`` with all-127, mixed,
+  random and the refused all--128 pattern (observed max deviation must be 0);
+* order invariance: the same input at threads 1/2/6 is bitwise identical;
+* counterexample control: the Kc rule is tight (all-127 at K=1041 deviates by
+  1 when the rule is bypassed) and the legacy unchunked path's observed
+  deviations at K=1041/16696/133144 are eliminated by chunking;
+* fail-closed: K > accumulation limit, rank/dtype/code violations, empty work,
+  an unsatisfiable Kc formula and an int32 accumulator overflow;
+* resolution semantics: ``numeric.require_proven_deviation_bound=true``
+  selects the new entry, ``provider.mode=required`` pins it, the legacy fused
+  ``sym_quant`` path stays fail-closed, and the default policy never sees the
+  new entry (zero default change);
+* plan/report/binding_verify all carry the same envelope, and the envelope is
+  covered by the provider artifact digest.
+
+The tree-vs-tree byte comparison of the zero-default-change matrix lives in
+``_meta/pypto-x/int8-exact-blocked/raw/zero_default_change_{baseline,worktree}.json``.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        import pypto.execution.provider_aocl_int8 as provider_aocl_int8_module
+
+        from pypto.backends.cpu import HostTensor
+        from pypto.execution import (
+            AOCL_DEFAULT_LIBRARY,
+            AOCL_INT8_EXACT_BLOCKED_DIFFERENTIAL_K,
+            AOCL_INT8_EXACT_BLOCKED_EXACTNESS_BASIS,
+            AOCL_INT8_EXACT_BLOCKED_IMPLEMENTATION,
+            AOCL_INT8_EXACT_BLOCKED_NUMERIC_CLASS,
+            AOCL_INT8_EXACT_BLOCKED_PROVIDER_VERSION,
+            AOCL_INT8_EXACT_BLOCKED_REDUCTION_ORDER,
+            AOCL_INT8_EXACT_BLOCKED_WITHDRAWAL,
+            AOCL_INT8_F32_EXACT_INTEGER_LIMIT,
+            AOCL_INT8_IMPLEMENTATION,
+            AOCL_INT8_K_ACCUMULATION_LIMIT,
+            AOCL_INT8_QUANT_MAX,
+            AOCL_INT8_QUANT_MIN,
+            AOCL_INT8_UPPER_BOUND_STATUS,
+            AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID,
+            AOCL_LPGEMM_INT8_PROVIDER_ID,
+            ARTIFACT_MISMATCH,
+            NUMERIC_GUARANTEE_UNMET,
+            REPORT_SCHEMA_INVALID,
+            CapabilitySnapshot,
+            ExecutionError,
+            ExecutionPlan,
+            ExecutionPolicy,
+            FallbackPolicy,
+            NumericPolicy,
+            ProviderCapability,
+            ProviderPolicy,
+            ResourcePolicy,
+            _exact_blocked_exactness_envelope,
+            aocl_int8_exact_blocked_capability_entry,
+            aocl_int8_exact_blocked_provider_capabilities,
+            aocl_int8_provider_capabilities,
+            exact_blocked_kc,
+            execute_qmatmul,
+            execute_qmatmul_plan,
+            get_op_definition,
+            host_features,
+            plan_qmatmul,
+            probe_aocl_int8,
+            resolve_qmatmul,
+            validate_report_schema,
+            with_exact_blocked_provider,
+        )
