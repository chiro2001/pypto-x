+# ---------------------------------------------------------------------------
+# counterexample control: the bound is necessary / the legacy path deviates
+# ---------------------------------------------------------------------------
+@requires_execution_host
+def test_kc_rule_is_tight_at_1040_and_deviation_appears_at_1041(monkeypatch):
+    """(a) Bypassing the Kc rule on the representative all-127 pattern shows
+    that the bound is non-empty: K=1041 with Kc=1041 deviates by 1, while the
+    rule's Kc=1040 is exact."""
+
+    provider = provider_aocl_int8_module.AoclLpgemmInt8ExactBlockedProvider()
+
+    def _run_with_kc(k, kc_override):
+        left = _tensor((2, k), [127] * (2 * k))
+        right = _tensor((k, 2), [127] * (k * 2))
+        if kc_override is None:
+            prepared = provider.prepare_int32_exact_blocked(left, right)
+        else:
+            monkeypatch.setattr(
+                provider_aocl_int8_module, "exact_blocked_kc", lambda a, b: kc_override
+            )
+            prepared = provider.prepare_int32_exact_blocked(left, right)
+        prepared()
+        monkeypatch.undo()
+        return prepared.totals(), prepared.kc
+
+    exact_1040 = 1040 * 127 * 127
+    totals, kc = _run_with_kc(1040, None)
+    assert kc == 1040
+    assert totals == [exact_1040] * 4
+
+    exact_1041 = 1041 * 127 * 127
+    totals, kc = _run_with_kc(1041, 1041)
+    assert kc == 1041
+    assert totals[0] != exact_1041
+    assert abs(totals[0] - exact_1041) == 1
+
