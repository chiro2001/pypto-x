+def test_kc_rule_is_floor_and_capped():
+    assert exact_blocked_kc(127, 127) == 1040
+    assert exact_blocked_kc(128, 128) == 1024
+    assert exact_blocked_kc(1, 1) == 2048
+    assert exact_blocked_kc(0, 0) == 2048
+    assert exact_blocked_kc(0, 127) == 2048
+    assert exact_blocked_kc(2, 3) == 2048
+    for a_max, b_max in ((127, 127), (128, 128), (100, 127), (7, 3), (1, 0)):
+        kc = exact_blocked_kc(a_max, b_max)
+        assert 1 <= kc <= 2048
+        assert kc * a_max * b_max <= AOCL_INT8_F32_EXACT_INTEGER_LIMIT
