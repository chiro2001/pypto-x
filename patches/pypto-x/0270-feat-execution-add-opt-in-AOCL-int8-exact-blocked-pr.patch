+# ---------------------------------------------------------------------------
+_DIFFERENTIAL_PATTERNS = ("all_127", "mixed", "random")
+
+
+def _pattern_codes(shape, pattern, seed):
+    count = 1
+    for dimension in shape:
+        count *= dimension
+    if pattern == "all_127":
+        return [127] * count
+    if pattern == "mixed":
+        return [127 if index % 2 == 0 else -127 for index in range(count)]
+    if pattern == "random":
+        return _codes(count, seed)
+    raise AssertionError(pattern)
+
+
+@requires_execution_host
+@pytest.mark.parametrize("pattern", _DIFFERENTIAL_PATTERNS)
+@pytest.mark.parametrize("k", AOCL_INT8_EXACT_BLOCKED_DIFFERENTIAL_K)
+def test_differential_chunked_output_equals_contract_reference(pattern, k):
+    m, n = 2, 2
+    left = _tensor((m, k), _pattern_codes((m, k), pattern, 11 + k))
+    right = _tensor((k, n), _pattern_codes((k, n), pattern, 7001 + k))
+    output, report = execute_qmatmul(left, right, _strict_policy(threads=1))
+    expected = _contract_reference(left, right)
+    delta = _max_abs_delta(output.flat(), expected)
+    assert delta == 0, (pattern, k, delta)
+    envelope = report.to_dict()["guarantees"]["exactness_envelope"]
+    assert envelope["deviation_bound_by_k"]["all_k_le_limit"] == 0
+    assert envelope["deviation_bound_by_k"].get(str(k), 0) == 0
+    validate_report_schema(report.to_dict())
+
