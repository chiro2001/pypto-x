+# ---------------------------------------------------------------------------
+# 0047 opt-in exact-blocked provider admission
+# ---------------------------------------------------------------------------
+# The exact-blocked entry is deliberately *not* part of ``default_providers``:
+# adding it to every snapshot would change the capability digest, the provider
+# candidate list and therefore the default plan digest/selection of the frozen
+# 393d28e0f baseline.  It enters a snapshot only when the policy explicitly
+# opts in (proven-bound requirement, an explicit ``provider.required`` pin, or
+# an explicit declared fallback chain entry), and the resolver additionally
+# admits it as an executor of the frozen qmatmul contract without adding it to
+# ``OpDefinition.allowed_providers`` (which would change the frozen contract
+# digest for every provider).
+def exact_blocked_opt_in_requested(
+    *,
+    provider_mode: Any = None,
+    provider_required: Any = None,
+    require_proven_deviation_bound: bool = False,
+    fallback_mode: Any = None,
+    fallback_chain: Any = (),
+) -> bool:
+    """True when a policy explicitly opts into the 0047 exact-blocked provider."""
+
+    if (
+        provider_mode == "required"
+        and provider_required == AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID
+    ):
+        return True
+    if bool(require_proven_deviation_bound):
+        return True
+    if fallback_mode == "declared" and AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID in (
+        tuple(fallback_chain or ())
+    ):
+        return True
+    return False
+
+
+def policy_opts_into_exact_blocked(policy: Any) -> bool:
+    """Read the opt-in intent off an ``ExecutionPolicy`` (or duck type)."""
+
+    provider = getattr(policy, "provider", None)
+    numeric = getattr(policy, "numeric", None)
+    fallback = getattr(policy, "fallback", None)
+    return exact_blocked_opt_in_requested(
+        provider_mode=getattr(provider, "mode", None),
+        provider_required=getattr(provider, "required", None),
+        require_proven_deviation_bound=bool(
+            getattr(numeric, "require_proven_deviation_bound", False)
+        ),
+        fallback_mode=getattr(fallback, "mode", None),
+        fallback_chain=getattr(fallback, "chain", ()) or (),
+    )
+
+
+def policy_document_opts_into_exact_blocked(document: Any) -> bool:
+    """The same predicate over a serialized ``policy.requested`` document."""
+
+    if not isinstance(document, Mapping):
+        return False
+    provider = document.get("provider")
+    numeric = document.get("numeric")
+    fallback = document.get("fallback")
+    return exact_blocked_opt_in_requested(
+        provider_mode=provider.get("mode") if isinstance(provider, Mapping) else None,
+        provider_required=(
+            provider.get("required") if isinstance(provider, Mapping) else None
+        ),
+        require_proven_deviation_bound=bool(
+            numeric.get("require_proven_deviation_bound")
+            if isinstance(numeric, Mapping)
+            else False
+        ),
+        fallback_mode=fallback.get("mode") if isinstance(fallback, Mapping) else None,
+        fallback_chain=(
+            fallback.get("chain") if isinstance(fallback, Mapping) else ()
+        )
+        or (),
+    )
+
+
+def exact_blocked_provider_entry() -> ProviderCapability:
+    """Build the 0047 provider manifest from the local pinned-library probe."""
+
+    return aocl_int8_exact_blocked_provider_capabilities()[0]
+
+
+def with_exact_blocked_provider(
+    snapshot: "CapabilitySnapshot",
+) -> "CapabilitySnapshot":
+    """Return ``snapshot`` with the 0047 entry added (idempotent).
+
+    A non-cpu snapshot is returned unchanged.  The entry is probe-derived like
+    every other vendor manifest, so the augmented snapshot stays a platform
+    fact document and its digest covers the new provider.
+    """
+
+    if not isinstance(snapshot, CapabilitySnapshot):
+        return snapshot
+    if snapshot.kind != "cpu":
+        return snapshot
+    if AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID in snapshot.provider_ids():
+        return snapshot
+    entry = exact_blocked_provider_entry()
+    if entry.provider_id in snapshot.provider_ids():
+        return snapshot
+    return CapabilitySnapshot.for_host(
+        kind=snapshot.kind,
+        triple=snapshot.triple,
+        features=snapshot.features,
+        providers=tuple(snapshot.providers) + (entry,),
+    )
+
+
 @dataclass(frozen=True, init=False)
 class CapabilitySnapshot:
     """Immutable, digestible platform capability facts for one resolution."""
