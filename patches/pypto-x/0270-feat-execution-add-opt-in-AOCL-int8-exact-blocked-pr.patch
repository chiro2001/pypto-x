+# ---------------------------------------------------------------------------
+# 0047: opt-in exact-blocked executor of the same s8s8s32os32 kernel.
+#
+# The legacy entry above reports the pinned kernel's deviation as a measured
+# snapshot (no proven upper bound).  This entry keeps the same kernel call
+# semantics (alpha=1, beta=0, post_op=None, row-major A[M,K] / B[K,N], int32
+# C[M,N]) but splits K into chunks of at most ``kc`` columns with
+#
+#     kc = min(2048, floor(2**24 / (max_abs_a * max_abs_b)))
+#
+# where ``max_abs_a`` / ``max_abs_b`` are the largest magnitudes in the *actual*
+# quantized code buffers (O(MK) + O(KN) once per call).  Every integer partial
+# sum of at most ``kc`` columns is then bounded by
+# ``kc * max_abs_a * max_abs_b <= 2**24``, and every integer with magnitude at
+# most ``2**24`` is exactly representable in binary32, so **every** f32 round
+# trip the kernel performs on that chunk is the identity -- independent of the
+# kernel's internal reduction order (per-KC-block, per-64-column or a single
+# f32 accumulation before the int32 store).  The per-chunk int32 outputs are
+# therefore exact partial sums and are accumulated with Python arbitrary
+# precision integers, then range-checked against int32 before the output buffer
+# is written.  The result is the contract's exact int32 sum: deviation bound 0.
+#
+# Residual assumption (registered boundary): the pinned kernel performs no
+# lossy operation other than int32<->f32 conversion on this path.  The evidence
+# is the symbol name, the call arguments and the AOCL sources/docs; this is not
+# a formal proof of the closed-source kernel.  If that premise is ever refuted
+# the exact_contract_bound envelope and the ``exact`` numeric class must be
+# withdrawn (see ``AOCL_INT8_EXACT_BLOCKED_WITHDRAWAL``).
+# ---------------------------------------------------------------------------
+AOCL_INT8_EXACT_BLOCKED_PROVIDER_VERSION = (
+    "aocl-lpgemm.blis-5.3.2.zen4.dimt64.blasint32.int8.exact_blocked.v1"
+)
+AOCL_INT8_EXACT_BLOCKED_IMPLEMENTATION = (
+    "aocl.lpgemm.s8s8s32os32.kc_exact_blocked_int32_accum"
+)
+AOCL_INT8_EXACT_BLOCKED_NUMERIC_CLASS = "exact"
+AOCL_INT8_EXACT_BLOCKED_REDUCTION_ORDER = (
+    "aocl_lpgemm_s8s8s32os32_kc_exact_blocks_then_python_int_accum_v1"
+)
+AOCL_INT8_EXACT_BLOCKED_EXACTNESS_BASIS = (
+    "provider_version_and_threads_pinned; "
+    "kc_min(2048,_floor(2**24/(max_abs_a*max_abs_b)))_makes_every_kernel_f32_round_trip_identity; "
+    "per_chunk_int32_output_is_the_exact_integer_partial_sum; "
+    "python_arbitrary_precision_accumulation_then_int32_range_check; "
+    "deviation_bound_zero_vs_contract_int32_sum_for_all_k<=k_accumulation_limit"
+)
+AOCL_INT8_EXACT_BLOCKED_ABI_VERSION = "aocl-lpgemm.ctypes.v2.int8.exact_blocked"
+AOCL_INT8_EXACT_BLOCKED_ARTIFACT_FORMAT = "aocl.lpgemm.int8.exact_blocked.v1"
+AOCL_INT8_EXACT_BLOCKED_KC_CAP = AOCL_INT8_KC_BLOCK
+AOCL_INT8_F32_EXACT_INTEGER_LIMIT = 2 ** 24
+AOCL_INT8_INT32_MAX = 2 ** 31 - 1
+AOCL_INT8_INT32_MIN = -(2 ** 31)
+#: Differential regression K set (frozen for the 0047 evidence matrix).
+AOCL_INT8_EXACT_BLOCKED_DIFFERENTIAL_K = (1024, 1040, 1041, 2048, 2049, 16696, 133144)
+AOCL_INT8_EXACT_BLOCKED_WITHDRAWAL = (
+    "if the pinned kernel is shown to perform any lossy operation other than "
+    "int32<->f32 conversion on this path (bf16/f16 rounding, epilogue scaling, "
+    "saturating accumulation, ...), the exact_contract_bound envelope and the "
+    "exact numeric class must be withdrawn immediately and the provider must "
+    "fail closed under numeric.require_proven_deviation_bound=true"
+)
+AOCL_INT8_EXACT_BLOCKED_RESIDUAL_ASSUMPTIONS = (
+    {
+        "statement": "the pinned kernel performs only int32/f32 arithmetic on this "
+                     "path; under that premise every f32 round trip it performs is "
+                     "the identity because every converted value is an integer "
+                     "partial sum bounded by kc*max_abs_a*max_abs_b <= 2**24",
+        "checkable_items": [
+            "the invoked entry point is the symbol aocl_gemm_s8s8s32os32 "
+            "(probe checks the symbol on the pinned library)",
+            "the call arguments are order='r', transa='n', transb='n', alpha=1, "
+            "beta=0, post_op=None, row-major A[M,K] (lda=K) and B[K,N] (ldb=N), "
+            "int32 C[M,N]",
+            "AOCL documents/sources describe the s8s8s32os32 path as integer MAC "
+            "with int32 accumulation and int32<->f32 conversion at block "
+            "boundaries (no saturation, no epilogue) -- see the 0015 contract "
+            "document section 'residual assumptions' for the citations",
+        ],
+        "not_a_formal_proof": True,
+        "withdrawal": AOCL_INT8_EXACT_BLOCKED_WITHDRAWAL,
+    },
+)
+AOCL_INT8_EXACT_BLOCKED_PROOF_OBLIGATION = (
+    "show that every value the kernel converts through binary32 on this path is "
+    "an integer partial sum of at most kc columns (kc*max_abs_a*max_abs_b <= "
+    "2**24); then every f32 round trip is the identity, each per-chunk int32 "
+    "output equals the exact integer partial sum, and Python-int accumulation "
+    "with an int32 range check equals the contract's exact int32 sum"
+)
+
+
+def exact_blocked_kc(max_abs_a: int, max_abs_b: int) -> int:
+    """Return the exact-blocked K chunk width for the given code magnitudes.
+
+    ``kc = min(2048, floor(2**24 / (max_abs_a * max_abs_b)))`` with
+    ``kc = 2048`` when the product is zero (the result is then identically
+    zero) and a structured refusal when the product exceeds ``2**24`` so the
+    floor would fall below 1.  ``max_abs_*`` are the magnitudes of the actual
+    quantized codes; ``-128`` (if it ever reached this function) would only
+    shrink ``kc`` because it enters as 128.
+    """
+
+    product = int(max_abs_a) * int(max_abs_b)
+    if product <= 0:
+        return AOCL_INT8_EXACT_BLOCKED_KC_CAP
+    kc = AOCL_INT8_F32_EXACT_INTEGER_LIMIT // product
+    if kc < 1:
+        raise OpContractError(
+            "the exact-blocked Kc rule has no positive chunk width: "
+            "max_abs_a={} max_abs_b={} product={} exceeds 2**24".format(
