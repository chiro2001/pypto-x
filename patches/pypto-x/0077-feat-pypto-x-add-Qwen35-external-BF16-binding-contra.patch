+def test_layout_alias_ordering_and_launcher_assembly_are_zero_copy():
+    schema = _schema()
+    layout, packed, runtime, parameters, states, outputs, state_outputs = _make_bindings(schema)
+    embedding_region = layout.region_for("embedding.weight")
+    lm_head_region = layout.region_for("lm_head.weight")
+    assert embedding_region is lm_head_region
+    assert embedding_region.storage_id == "embedding_lm_head_shared_weight"
+    assert embedding_region.logical_names == (
+        "embedding_lm_head_shared_weight",
+        "embedding.weight",
+        "lm_head.weight",
+    )
+    assert layout.total_nbytes >= embedding_region.nbytes
+    descriptors = ordered_input_descriptors(schema, runtime, parameters, states)
+    assert len(descriptors) == 371
+    for descriptor, entry in zip(descriptors, schema.inputs):
+        binding = {
+            "runtime": runtime,
+            "parameter": parameters,
+            "state": states,
+        }[entry.role][entry.name]
+        assert descriptor.handle is binding.view
+        assert descriptor.shape == entry.shape
+        assert descriptor.dtype == entry.dtype
+    aliased_parameters = dict(parameters)
+    shared_binding = aliased_parameters.pop("embedding_lm_head_shared_weight")
+    aliased_parameters["embedding.weight"] = shared_binding
+    aliased_descriptors = ordered_input_descriptors(
+        schema=schema,
+        runtime_bindings=runtime,
+        parameter_bindings=aliased_parameters,
+        state_bindings=states,
+    )
+    assert aliased_descriptors[3].handle is shared_binding.view
+    artifact = Artifact(
+        format="binding-only",
+        entrypoint=schema.function_name,
+        target=TargetSpec("cpu", "x86_64-linux-gnu"),
+        payload=b"metadata-only",
+    )
+    request = assemble_launch_request(
+        schema,
+        artifact,
+        runtime,
+        parameters,
+        states,
+        outputs,
+        state_outputs,
+    )
+    assert tuple(item.handle for item in request.inputs) == tuple(item.handle for item in descriptors)
+    assert len(request.outputs) == len(schema.outputs)
+    assert request.inputs[3].handle.obj is packed
+
