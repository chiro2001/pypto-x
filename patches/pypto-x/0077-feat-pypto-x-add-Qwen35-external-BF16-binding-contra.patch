+++ b/python/tests/ut/pypto_x/qwen35_runtime_binding_metadata_driver.py
@@ -0,0 +1,68 @@
+"""Auditable M1J real-profile metadata-only layout driver.
+
+The driver constructs Core metadata and computes offsets only.  It never opens
+an external checkpoint and never allocates a parameter/state backing buffer.
+Run it through ``run_local_heavy.sh`` because the real graph has model-sized
+shape metadata even though its storage remains symbolic.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import resource
+from pathlib import Path
+
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.portable.runtime_binding import build_binding_schema, build_packed_layout
+
+
+def _rss_kib():
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    rss_before = _rss_kib()
+    program = build_qwen35_text_decoder_graph(1, 1, past_length=4096, shape_profile="model")
+    schema = build_binding_schema(program)
+    layout = build_packed_layout(schema)
+    rss_after = _rss_kib()
+    result = {
+        "status": "PASS",
+        "weights_loaded": False,
+        "buffers_allocated": False,
+        "graph_kind": program.metadata["graph_kind"],
+        "shape_profile": program.metadata["shape_profile"],
+        "graph_digest": schema.graph_digest,
+        "counts": {
+            "runtime_inputs": len(schema.runtime_inputs),
+            "parameters": len(schema.parameters),
+            "states": len(schema.states),
+            "outputs": len(schema.regular_outputs),
+            "state_outputs": len(schema.state_outputs),
+        },
+        "parameter_bytes_from_graph_manifest": int(program.metadata["parameter_byte_count"]),
+        "packed_region_count": len(layout.regions),
+        "packed_total_nbytes": layout.total_nbytes,
+        "packed_alignment": layout.alignment,
+        "tied_alias_storage_id": layout.region_for("embedding.weight").storage_id,
+        "tied_alias_region_count": sum(
+            1 for region in layout.regions if "embedding.weight" in region.logical_names
+        ),
+        "schema_json_bytes": len(schema.canonical_json().encode("utf-8")),
+        "layout_json_bytes": len(layout.canonical_json().encode("utf-8")),
+        "rss_maxrss_kib_before": rss_before,
+        "rss_maxrss_kib_after": rss_after,
+        "rss_delta_kib": rss_after - rss_before,
+    }
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/python/tests/ut/pypto_x/test_qwen35_runtime_binding.py b/python/tests/ut/pypto_x/test_qwen35_runtime_binding.py
