index 000000000..907907aae
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_qwen35_runtime_binding.py
@@ -0,0 +1,247 @@
+"""M1J external-buffer binding contract tests.
+
+These tests use only synthetic shapes and tiny temporary storage.  The model
+profile layout is exercised separately by the metadata-only driver so this
+module never allocates a Qwen checkpoint-sized buffer.
+"""
+
+from __future__ import annotations
+
+import mmap
+from pathlib import Path
+
+import pytest
+
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.portable.runtime_binding import (
+    BindingMismatchError,
+    BufferBinding,
+    RuntimeBindingError,
+    UINT64_MAX,
+    assemble_launch_request,
+    bind_packed_region,
+    build_binding_schema,
+    build_packed_layout,
+    ordered_input_descriptors,
+)
+from pypto.compiler.artifact import Artifact
+from pypto.target import TargetSpec
+
+
+def _schema():
+    return build_binding_schema(build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test"))
+
+
+def _small_storage(nbytes):
+    return bytearray(max(1, nbytes))
+
+
+def _make_bindings(schema):
+    layout = build_packed_layout(schema)
+    packed = bytearray(max(1, layout.total_nbytes))
+    runtime = {
+        entry.name: BufferBinding.from_buffer(
+            _small_storage(entry.nbytes),
+            entry.storage_id,
+            entry.dtype,
+            entry.shape,
+            readonly=True,
+        )
+        for entry in schema.runtime_inputs
+    }
+    parameters = {
+        entry.name: bind_packed_region(layout, entry.name, packed)
+        for entry in schema.parameters
+    }
+    states = {
+        entry.name: bind_packed_region(layout, entry.name, packed)
+        for entry in schema.states
+    }
+    outputs = {
+        entry.name: BufferBinding.from_buffer(
+            _small_storage(entry.nbytes),
+            entry.storage_id,
+            entry.dtype,
+            entry.shape,
+            readonly=False,
+        )
+        for entry in schema.regular_outputs
+    }
+    state_outputs = {
+        entry.name: BufferBinding.from_buffer(
+            _small_storage(entry.nbytes),
+            entry.storage_id,
+            entry.dtype,
+            entry.shape,
+            readonly=False,
+        )
+        for entry in schema.state_outputs
+    }
+    return layout, packed, runtime, parameters, states, outputs, state_outputs
+
+
+def test_schema_uses_exact_parameter_remainder_and_keeps_gdr_parameters():
+    schema = _schema()
+    assert len(schema.runtime_inputs) == 3
+    assert len(schema.parameters) == 320
+    assert len(schema.states) == 48
+    assert tuple(entry.ordinal for entry in schema.inputs) == tuple(range(371))
+    assert set(entry.name for entry in schema.inputs) == set(
+        entry.name for entry in schema.runtime_inputs + schema.parameters + schema.states
+    )
+    gdr_names = [entry.name for entry in schema.parameters if entry.name.endswith(("_A_log", "_dt_bias"))]
+    assert len(gdr_names) == 36
+    assert schema.entry_for("embedding.weight").name == "embedding_lm_head_shared_weight"
+    assert schema.entry_for("lm_head.weight").storage_id == "embedding_lm_head_shared_weight"
+    assert schema.canonical_json() == _schema().canonical_json()
+
+
+def test_readonly_mmap_and_bytes_are_zero_copy_contract_bindings(tmp_path):
+    path = Path(tmp_path) / "tiny.bin"
+    path.write_bytes(bytes(range(128)))
+    with path.open("r+b") as stream:
+        mapped = mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ)
+        binding = BufferBinding.from_buffer(
+            mapped,
+            "parameter:test",
+            "bf16",
+            (8,),
+            byte_offset=64,
+            alignment=64,
+            readonly=True,
+        )
+        assert binding.view.obj is mapped
+        assert binding.owner is mapped
+        assert binding.view.nbytes == 16
+        descriptor = binding.to_tensor_desc()
+        assert descriptor.handle is binding.view
+        assert descriptor.readonly is True
+        with pytest.raises(RuntimeBindingError):
+            BufferBinding.from_buffer(mapped, "bad", "bf16", (8,), byte_offset=65, alignment=64)
+        with pytest.raises(RuntimeBindingError):
+            BufferBinding.from_buffer(mapped, "bad", "bf16", (33,), byte_offset=64, alignment=64)
+        with pytest.raises(RuntimeBindingError):
+            BufferBinding.from_buffer(memoryview(bytearray(32))[::2], "bad", "bf16", (8,))
+        # A read-only bytes object remains a valid contract binding, while a
+        # mutable output request fails closed before any backend sees it.
+        raw = bytes(16)
+        readonly_bytes = BufferBinding.from_buffer(raw, "parameter:bytes", "bf16", (8,), readonly=True)
+        assert readonly_bytes.view.obj is raw
+        with pytest.raises(RuntimeBindingError):
+            BufferBinding.from_buffer(raw, "output:bytes", "bf16", (8,), readonly=False)
+        binding.view.release()
+        mapped.close()
+
+
+def test_uint64_overflow_is_rejected_before_storage_access():
+    with pytest.raises(RuntimeBindingError, match="uint64"):
+        BufferBinding.from_buffer(bytearray(1), "overflow", "float32", (UINT64_MAX, 2))
+    with pytest.raises(RuntimeBindingError, match="uint64"):
+        BufferBinding.from_buffer(bytearray(1), "overflow", "uint8", (1,), byte_offset=UINT64_MAX + 1)
+    with pytest.raises(RuntimeBindingError, match="uint64"):
+        BufferBinding.from_buffer(bytearray(1), "overflow", "uint8", (1,), nbytes=UINT64_MAX + 1)
