+def test_binding_tamper_missing_extra_and_mutability_fail_closed():
+    schema = _schema()
+    layout, packed, runtime, parameters, states, outputs, state_outputs = _make_bindings(schema)
+    del layout, packed
+    broken_parameters = dict(parameters)
+    first = schema.parameters[0]
+    broken_parameters[first.name] = BufferBinding.from_buffer(
+        _small_storage(first.nbytes),
+        "parameter:tampered",
+        first.dtype,
+        first.shape,
+        readonly=True,
+    )
+    with pytest.raises(BindingMismatchError, match="storage_id"):
+        ordered_input_descriptors(schema, runtime, broken_parameters, states)
+    missing_runtime = dict(runtime)
+    missing_runtime.pop(schema.runtime_inputs[0].name)
+    with pytest.raises(BindingMismatchError, match="missing"):
+        ordered_input_descriptors(schema, missing_runtime, parameters, states)
+    extra_runtime = dict(runtime)
+    extra_runtime["extra"] = runtime[schema.runtime_inputs[0].name]
+    with pytest.raises(BindingMismatchError, match="extra"):
+        ordered_input_descriptors(schema, extra_runtime, parameters, states)
+    mutable_state = dict(states)
+    state = schema.states[0]
+    mutable_state[state.name] = BufferBinding.from_buffer(
+        _small_storage(state.nbytes), state.storage_id, state.dtype, state.shape, readonly=False
+    )
+    with pytest.raises(BindingMismatchError, match="read-only"):
+        ordered_input_descriptors(schema, runtime, parameters, mutable_state)
+    readonly_output = dict(state_outputs)
+    state_output = schema.state_outputs[0]
+    readonly_output[state_output.name] = BufferBinding.from_buffer(
+        _small_storage(state_output.nbytes),
+        state_output.storage_id,
+        state_output.dtype,
+        state_output.shape,
+        readonly=True,
+    )
+    artifact = Artifact(
+        format="binding-only",
+        entrypoint=schema.function_name,
+        target=TargetSpec("cpu", "x86_64-linux-gnu"),
+        payload=b"metadata-only",
+    )
+    with pytest.raises(BindingMismatchError, match="mutable"):
+        assemble_launch_request(
+            schema, artifact, runtime, parameters, states, outputs, readonly_output
+        )
