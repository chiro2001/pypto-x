From dcb8ae7fcd6eb3d9ff6ecbe3e554bff23750ba5e Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 04:42:54 +0800
Subject: [PATCH 207/235] fix(tools): C7 state swap must copy injected states
 (HF updates caches in place)

torch.as_tensor aliases float32 numpy on the fp32 recurrent_state slot; the
HF layer then copy_()-s the next state into that tensor, mutating the
source arrays and poisoning later baselines/ablations (first run: default
baseline bitwise-exact, then full baseline corrupted, ablations unreliable).
Always use torch.tensor(...) so the source numpy stays pristine.
---
 tools/diag_c7/state_swap_experiment.py | 22 ++++++++++++----------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/tools/diag_c7/state_swap_experiment.py b/tools/diag_c7/state_swap_experiment.py
index eb3ddb578..94971fbb7 100644
--- a/tools/diag_c7/state_swap_experiment.py
+++ b/tools/diag_c7/state_swap_experiment.py
@@ -138,30 +138,32 @@ def inject(cache, snapshots, dtype_by_kind):
     参数 dtype（bf16），否则会把 fp32 的 recurrent state 截断成 bf16。
     """
     import torch
-    kind_slot = {"conv": "conv_states", "recurrent": "recurrent_states",
-                 "k": "keys", "v": "values"}
+    # 必须 torch.tensor(...)（总是拷贝），不能用 torch.as_tensor：当 numpy 是
+    # float32 且目标 dtype 也是 float32（recurrent_state）时 as_tensor 是零拷贝，
+    # 而 HF 的 update_recurrent_state/update_conv_state 会 copy_ 原地写回注入张量，
+    # 从而把源 numpy（甚至 npz 缓存）改写，污染后续所有测量。
+    def to_tensor(array, dtype):
+        return torch.tensor(np.ascontiguousarray(array), dtype=dtype)
+
     for index, cache_layer in enumerate(cache.layers):
         snap = snapshots.get(index, {})
         if hasattr(cache_layer, "conv_states"):
             if "conv" in snap:
-                tensor = torch.as_tensor(np.ascontiguousarray(snap["conv"]),
-                                         dtype=dtype_by_kind["conv"])
+                tensor = to_tensor(snap["conv"], dtype_by_kind["conv"])
                 cache_layer.conv_states[0] = tensor
                 cache_layer.is_conv_states_initialized[0] = True
                 cache_layer.conv_kernel_size[0] = int(tensor.shape[-1])
             if "recurrent" in snap:
-                cache_layer.recurrent_states[0] = torch.as_tensor(
-                    np.ascontiguousarray(snap["recurrent"]), dtype=dtype_by_kind["recurrent"])
+                cache_layer.recurrent_states[0] = to_tensor(
+                    snap["recurrent"], dtype_by_kind["recurrent"])
                 cache_layer.is_recurrent_states_initialized[0] = True
                 cache_layer.has_previous_state[0] = True
             cache_layer.dtype = dtype_by_kind.get("conv", dtype_by_kind.get("recurrent"))
             cache_layer.device = torch.device("cpu")
         else:
             if "k" in snap and "v" in snap:
-                cache_layer.keys = torch.as_tensor(np.ascontiguousarray(snap["k"]),
-                                                   dtype=dtype_by_kind["k"])
-                cache_layer.values = torch.as_tensor(np.ascontiguousarray(snap["v"]),
-                                                     dtype=dtype_by_kind["v"])
+                cache_layer.keys = to_tensor(snap["k"], dtype_by_kind["k"])
+                cache_layer.values = to_tensor(snap["v"], dtype_by_kind["v"])
                 cache_layer.is_initialized = True
                 cache_layer.dtype = dtype_by_kind["k"]
                 cache_layer.device = torch.device("cpu")
