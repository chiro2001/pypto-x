+def _parameter_entry_totals(entries: Sequence[BindingEntry]) -> Tuple[int, int]:
+    """Return exact Core parameter element/byte totals with uint64 checks."""
+
+    element_total = 0
+    byte_total = 0
+    for entry in entries:
+        if entry.role != "parameter":
+            continue
+        element_total = _checked_add(element_total, _element_count(entry.shape), "Core parameter elements")
+        byte_total = _checked_add(byte_total, entry.nbytes, "Core parameter bytes")
+    return element_total, byte_total
+
+
+def _audit_qwen_parameter_manifest(metadata: Mapping[str, Any]) -> Tuple[int, int]:
+    """Audit compact manifest arithmetic and return its aggregate totals.
+
+    A manifest entry describes one unique storage class, with ``count``
+    repeated layer tensors.  Aliases (notably embedding/lm-head) are metadata
+    names only and never contribute another entry or another storage range.
+    """
+
+    raw_manifest = metadata.get("parameter_manifest")
+    if raw_manifest is None or isinstance(raw_manifest, (str, bytes)):
+        raise BindingMismatchError("Qwen graph metadata parameter_manifest must be a sequence")
+    try:
+        manifest = tuple(raw_manifest)
+    except TypeError as exc:
+        raise BindingMismatchError("Qwen graph metadata parameter_manifest must be a sequence") from exc
+    storage_count = _metadata_uint64(metadata, "parameter_storage_count")
+    if storage_count != len(manifest):
+        raise BindingMismatchError(
+            "parameter_storage_count {} does not match manifest length {}".format(storage_count, len(manifest))
+        )
+    element_total = 0
+    byte_total = 0
+    storage_ids = set()
+    for index, entry in enumerate(manifest):
+        context = "parameter_manifest[{}]".format(index)
+        if not isinstance(entry, Mapping):
+            raise BindingMismatchError("{} must be a mapping".format(context))
+        name = entry.get("name")
+        if not isinstance(name, str) or not name:
+            raise BindingMismatchError("{}.name must be a non-empty string".format(context))
+        storage_id = entry.get("storage_id")
+        if not isinstance(storage_id, str) or not storage_id:
+            raise BindingMismatchError("{}.storage_id must be a non-empty string".format(context))
+        if storage_id in storage_ids:
+            raise BindingMismatchError("{} duplicates storage_id {!r}".format(context, storage_id))
+        storage_ids.add(storage_id)
+        dtype = _canonical_dtype(entry.get("dtype"))
+        if "shape" not in entry:
+            raise BindingMismatchError("{}.shape is missing".format(context))
+        shape = _checked_shape(entry["shape"], context + ".shape")
+        count = entry.get("count")
+        if isinstance(count, bool) or not isinstance(count, int) or count <= 0 or count > UINT64_MAX:
+            raise BindingMismatchError("{}.count must be a positive uint64".format(context))
+        elements_per_tensor = _element_count(shape, context + ".shape")
+        manifest_elements_per_tensor = _manifest_uint64(entry, "elements_per_tensor", context)
+        if manifest_elements_per_tensor != elements_per_tensor:
+            raise BindingMismatchError("{}.elements_per_tensor is inconsistent".format(context))
+        parameter_elements = _checked_mul(elements_per_tensor, count, context + ".parameter_elements")
+        manifest_parameter_elements = _manifest_uint64(entry, "parameter_elements", context)
+        if manifest_parameter_elements != parameter_elements:
+            raise BindingMismatchError("{}.parameter_elements is inconsistent".format(context))
+        storage_bytes = _checked_mul(
+            parameter_elements,
+            _DTYPE_BYTES[dtype],
+            context + ".storage_bytes",
+        )
+        manifest_storage_bytes = _manifest_uint64(entry, "storage_bytes", context)
+        if manifest_storage_bytes != storage_bytes:
+            raise BindingMismatchError("{}.storage_bytes is inconsistent".format(context))
+        element_total = _checked_add(element_total, parameter_elements, "parameter_manifest elements")
+        byte_total = _checked_add(byte_total, storage_bytes, "parameter_manifest bytes")
+
+    top_elements = _metadata_uint64(metadata, "parameter_element_count")
+    top_bytes = _metadata_uint64(metadata, "parameter_byte_count")
+    if (element_total, byte_total) != (top_elements, top_bytes):
+        raise BindingMismatchError(
+            "parameter_manifest totals ({}, {}) do not match graph metadata ({}, {})".format(
+                element_total, byte_total, top_elements, top_bytes
+            )
+        )
+    return element_total, byte_total
+
