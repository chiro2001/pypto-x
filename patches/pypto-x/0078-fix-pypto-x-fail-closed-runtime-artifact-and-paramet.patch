     return value
 
 
+def _checked_add(left: int, right: int, field_name: str) -> int:
+    if left < 0 or right < 0 or left > UINT64_MAX - right:
+        raise BindingMismatchError("{} exceeds uint64".format(field_name))
+    return left + right
+
+
+def _checked_mul(left: int, right: int, field_name: str) -> int:
+    if left < 0 or right < 0 or (right and left > UINT64_MAX // right):
+        raise BindingMismatchError("{} exceeds uint64".format(field_name))
+    return left * right
+
+
+def _metadata_uint64(metadata: Mapping[str, Any], field_name: str) -> int:
+    if field_name not in metadata:
+        raise BindingMismatchError("Qwen graph metadata is missing {}".format(field_name))
+    value = metadata[field_name]
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0 or value > UINT64_MAX:
+        raise BindingMismatchError("{} must be a uint64".format(field_name))
+    return value
+
+
+def _manifest_uint64(entry: Mapping[str, Any], field_name: str, context: str) -> int:
+    if field_name not in entry:
+        raise BindingMismatchError("{}.{} is missing".format(context, field_name))
+    value = entry[field_name]
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0 or value > UINT64_MAX:
+        raise BindingMismatchError("{}.{} must be a uint64".format(context, field_name))
+    return value
+
