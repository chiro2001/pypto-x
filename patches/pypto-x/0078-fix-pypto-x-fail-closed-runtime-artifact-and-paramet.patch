+@pytest.mark.parametrize("tamper", ("top_elements", "top_bytes", "shape", "count", "entry_bytes"))
+def test_qwen_parameter_totals_and_manifest_tamper_fail_closed(tamper):
+    program = build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test")
+    payload = program.to_dict()
+    metadata = payload["metadata"]
+    if tamper == "top_elements":
+        metadata["parameter_element_count"] += 1
+    elif tamper == "top_bytes":
+        metadata["parameter_byte_count"] += 2
+    elif tamper == "shape":
+        metadata["parameter_manifest"][0]["shape"][0] += 1
+    elif tamper == "count":
+        metadata["parameter_manifest"][1]["count"] += 1
+    else:
+        metadata["parameter_manifest"][2]["storage_bytes"] += 2
+    tampered = CoreProgram(functions=program.functions, metadata=metadata)
+    with pytest.raises(BindingMismatchError):
+        build_binding_schema(tampered)
+
