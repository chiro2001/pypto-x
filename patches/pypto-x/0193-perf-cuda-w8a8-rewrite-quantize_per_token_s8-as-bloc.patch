index 000000000..8485d7357
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_w8a8_quantize_rounding.py
@@ -0,0 +1,253 @@
+"""Host-side bit-exactness argument for the R6 CUDA quantize rewrite.
+
+Kernel version 1 rounded each element with a correctly rounded double
+division followed by ``cvt.rni.s32.f64`` (ties-to-even).  The rewritten
+block-per-row kernel drops the per-element ``div.rn.f64``: it computes the
+correctly rounded binary32 quotient ``q32 = div.rn.f32(x, scale)``, takes
+``n = cvt.rni.s32.f32(q32)`` as a candidate, forms the *exact* residual
+``d = x - n * scale`` with a single ``fma.rn.f64`` and compares ``2*|d|``
+against ``scale`` to settle the RNE half-way case.
+
+This module pins that algebra on the host.  It does not execute PTX; the
+device leg (old PTX vs new PTX, full-buffer SHA256) is
+``scripts/perf/c6_quantize_bitdiff.py``.  What is proven here is why the
+residual step is load-bearing: the plain ``cvt.rni.s32.f32(div.rn.f32(...))``
+scheme really does disagree with the old kernel on reachable inputs, while the
+residual scheme agrees on the whole generated corpus.
+"""
+
+from __future__ import annotations
+
+import math
+import random
+import struct
+from typing import Iterator, Tuple
+
+QUANT_MAX = 127
+QUANT_MIN = -127
+
+_F32 = struct.Struct("<f")
+_F32_BITS = struct.Struct("<I")
+
+
+def _f32(value: float) -> float:
+    return _F32.unpack(_F32.pack(float(value)))[0]
+
+
+def _sf32(value: float):
+    try:
+        return _f32(value)
+    except OverflowError:
+        return None
+
+
+def _decompose(value: float) -> Tuple[int, int]:
+    """Exact ``value == mantissa * 2**exponent`` for a finite binary32."""
+
+    bits = _F32_BITS.unpack(_F32.pack(float(value)))[0]
+    sign = -1 if bits >> 31 else 1
+    exponent = (bits >> 23) & 0xFF
+    fraction = bits & 0x7FFFFF
+    if exponent == 0:
+        return sign * fraction, -149
+    return sign * (fraction | 0x800000), exponent - 150
+
+
+def _rne_integer(value: float) -> int:
+    """Nearest integer, ties-to-even (mirrors ``cvt.rni.s32``)."""
+
+    floor = math.floor(value)
+    fraction = value - floor
+    if fraction < 0.5:
+        return floor
+    if fraction > 0.5:
+        return floor + 1
+    return floor if floor % 2 == 0 else floor + 1
+
+
+def _clamp_count(quantized: int) -> Tuple[int, int]:
+    count = 1 if (quantized > QUANT_MAX or quantized < QUANT_MIN) else 0
+    return max(QUANT_MIN, min(QUANT_MAX, quantized)), count
+
+
+def _kernel_v1_code(value: float, scale: float) -> Tuple[int, int]:
+    """Kernel version 1: f64 division, +/-200 clamp, cvt.rni.s32.f64."""
+
+    ratio = float(value) / float(scale)
+    ratio = min(max(ratio, -200.0), 200.0)
+    return _clamp_count(_rne_integer(ratio))
+
+
+def _naive_f32_code(value: float, scale: float) -> Tuple[int, int]:
+    """What a plain f32 quotient would produce (shown to be insufficient)."""
+
+    return _clamp_count(_rne_integer(_f32(float(value) / float(scale))))
+
+
+def _residual_code(value: float, scale: float) -> Tuple[int, int, bool]:
+    """The rewritten kernel's per-element rule, with an exact integer residual.
+
+    Returns ``(code, saturation, residual_is_f64_exact)``.  The residual is
+    kept as an exact integer here (``fraction`` module not needed); the
+    boolean reports whether the residual is representable in binary64, which
+    is what makes the single ``fma.rn.f64`` exact on the device.
+    """
+
+    candidate = _rne_integer(_f32(float(value) / float(scale)))
+    value_mantissa, value_exponent = _decompose(value)
+    scale_mantissa, scale_exponent = _decompose(scale)
+    common = min(value_exponent, scale_exponent)
+    residual = value_mantissa * (1 << (value_exponent - common)) - candidate * scale_mantissa * (
+        1 << (scale_exponent - common)
+    )
+    exact = residual.bit_length() <= 53
+    # 2*|residual| * 2**common  vs  scale_mantissa * 2**scale_exponent
+    lhs = 2 * abs(residual)
+    rhs = scale_mantissa * (1 << (scale_exponent - common))
+    if residual > 0:
+        if lhs > rhs:
+            quantized = candidate + 1
+        elif lhs == rhs:
+            quantized = candidate if candidate % 2 == 0 else candidate + 1
+        else:
+            quantized = candidate
+    elif residual < 0:
+        if lhs > rhs:
+            quantized = candidate - 1
+        elif lhs == rhs:
+            quantized = candidate if candidate % 2 == 0 else candidate - 1
+        else:
+            quantized = candidate
+    else:
+        quantized = candidate
+    code, count = _clamp_count(quantized)
+    return code, count, exact
+
+
+def _corpus() -> Iterator[Tuple[float, float]]:
+    """Deterministic adversarial (value, f32 scale) pairs.
+
+    Scales are reachable: every pair satisfies ``|value| <= 127.5 * scale`` so
+    it can come from a row whose ``absmax`` produced the f32 scale
+    ``fl32(absmax / 127)``.
+    """
+
+    rng = random.Random(20260912)
+    pairs = []
+    for _ in range(6000):
+        value = _f32(rng.uniform(-1.0, 1.0) * 2.0 ** rng.randint(-140, 128))
+        absmax = _f32(abs(value) if value != 0.0 else 1.0)
+        scale = _f32(absmax / QUANT_MAX)
+        pairs.append((value, scale))
+    for _ in range(300):
+        width = rng.randint(1, 40)
+        row = [_f32(rng.gauss(0.0, 1.0) * 2.0 ** rng.randint(-30, 30)) for _ in range(width)]
+        absmax = max(abs(item) for item in row)
+        if absmax == 0.0:
+            continue
+        scale = _f32(absmax / QUANT_MAX)
+        pairs.extend((item, scale) for item in row)
+    # Exact half-way ties on every boundary, plus +/-2 ulp neighbours.
+    for base in range(-127, 128):
+        value = _f32(base + 0.5)
+        pairs.append((value, 1.0))
+        for step in (-2, -1, 1, 2):
+            pairs.append((_f32(value + step * math.ulp(value)), 1.0))
+    # Near-ties for arbitrary scales: value = fl32(scale * (k + 0.5)).
+    for _ in range(4000):
+        scale = _f32(2.0 ** rng.randint(-120, 0) * rng.uniform(0.5, 2.0))
+        if scale == 0.0:
+            continue
+        target = _f32(float(scale) * (rng.randint(-127, 126) + 0.5))
+        if target == 0.0:
+            continue
+        for step in (-1, 0, 1):
+            value = _f32(target + step * math.ulp(target))
+            pairs.append((value, scale))
+    # Subnormal scales, signed zeros and extremes.
+    for exponent in range(-149, -120):
+        scale = _f32(2.0 ** exponent)
+        if scale == 0.0:
+            continue
+        for _ in range(60):
+            value = _f32(rng.uniform(-1.0, 1.0) * 2.0 ** rng.randint(-140, -100))
+            pairs.append((value, scale))
+    for scale in (_f32(1.0), _f32(1e-38), _f32(3.4e38), _f32(1.0 / QUANT_MAX)):
+        for value in (
+            0.0,
+            -0.0,
+            _f32(1e-45),
+            _f32(-1e-45),
+            _f32(3.4e38),
+            _f32(-3.4e38),
+            _f32(float(scale) * 0.5),
+            _f32(float(scale) * -0.5),
+            _sf32(float(scale) * 126.5),
+        ):
+            if value is not None:
+                pairs.append((value, scale))
+
+    filtered = []
+    for value, scale in pairs:
+        if scale == 0.0 or not math.isfinite(value) or not math.isfinite(scale):
+            continue
+        if abs(value) > float(scale) * 127.5:
+            continue
+        filtered.append((value, scale))
+    return filtered
+
+
+def test_residual_rounding_matches_kernel_v1_on_the_corpus():
+    corpus = _corpus()
+    assert len(corpus) > 20000
+    mismatches = []
+    for value, scale in corpus:
+        expected = _kernel_v1_code(value, scale)
+        actual = _residual_code(value, scale)[:2]
+        if actual != expected:
+            mismatches.append((value, scale, expected, actual))
+    assert mismatches == []
+
+
+def test_residual_is_exactly_representable_in_binary64():
+    corpus = _corpus()
+    inexact = [
+        (value, scale)
+        for value, scale in corpus
+        if not _residual_code(value, scale)[2]
+    ]
+    assert inexact == []
+
+
+def test_exact_half_way_ties_follow_rne():
+    for value, expected in (
+        (0.5, 0),
+        (1.5, 2),
+        (2.5, 2),
+        (3.5, 4),
+        (-0.5, 0),
+        (-1.5, -2),
+        (-2.5, -2),
+        (-3.5, -4),
+    ):
+        assert _kernel_v1_code(value, 1.0)[0] == expected
+        assert _residual_code(value, 1.0)[0] == expected
+
+
+def test_naive_f32_quotient_is_not_enough():
+    """The residual correction is required: plain f32 RNE changes codes.
+
+    Every pair below is reachable (``|value| <= 127.5 * scale``) and the old
+    kernel's double quotient sits on the other side of a half-way boundary
+    than the rounded binary32 quotient.
+    """
+
+    examples = []
+    for value, scale in _corpus():
+        if _naive_f32_code(value, scale) != _kernel_v1_code(value, scale):
+            examples.append((value, scale))
+            if len(examples) >= 3:
+                break
+    assert len(examples) == 3
+    for value, scale in examples:
+        assert _residual_code(value, scale)[:2] == _kernel_v1_code(value, scale)
