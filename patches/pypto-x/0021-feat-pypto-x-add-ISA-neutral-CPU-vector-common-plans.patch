+def _make_plan_for_operation(
+    program: CoreProgram,
+    operation: Operation,
+    operation_index: int,
+    lane_count: int,
+    tail_policy: TailPolicy,
+    required_features: CpuFeatureSet,
+    specialization: Mapping[str, Any],
+) -> VectorPlan:
+    name = canonical_operation_name(operation.name)
+    if len(operation.outputs) != 1:
+        raise CpuVectorValidationError("operation {} must have exactly one output".format(operation_index))
+    output = operation.outputs[0]
+    output_type = output.type
+    output_shape = static_shape(output_type, "vector operation output") if _is_tensor(output_type) else ()
+    # Reduction outputs may have a different rank (and therefore a different
+    # innermost-axis number) from their input.  The reduction iteration axis
+    # is defined by the input domain; elementwise/matmul outputs must share
+    # the input contiguous axis.
+    refs = tuple(operation.inputs) if name in ("reduce_sum", "reduce_max") else tuple(operation.inputs) + (output,)
+    layout, contiguous_axis = _check_layout(
+        program,
+        operation,
+        refs,
+        "function operation {}".format(operation_index),
+    )
+    count = element_count(output_shape)
+    output_axis = len(output_shape) - 1 if output_shape else None
+    if name in ("reduce_sum", "reduce_max"):
+        contiguous_axis = output_axis
+    iteration = make_iteration_plan(count, lane_count, contiguous_axis, tail_policy)
+    dtype = canonical_dtype(output_type.dtype)
+    if name in ("reduce_sum", "reduce_max"):
+        input_type = operation.inputs[0].type
+        input_shape = static_shape(input_type, "vector reduction input")
+        axes = _normalise_axes(operation.attributes, len(input_shape), "vector reduction")
+        expected_output_shape = reduced_shape(input_shape, operation.attributes, "vector reduction")
+        if output_shape != expected_output_shape:
+            raise CpuVectorValidationError(
+                "vector reduction output shape {} does not match {}".format(output_shape, expected_output_shape)
+            )
+        reduction_size = _product(tuple(input_shape[axis] for axis in axes))
+        reduction_axis = len(input_shape) - 1 if input_shape else None
+        reduction_iteration = make_iteration_plan(reduction_size, lane_count, reduction_axis, tail_policy)
+        reduction = ReductionPlan(
+            input_shape=input_shape,
+            output_shape=output_shape,
+            axes=axes,
+            keepdims=bool(operation.attributes.get("keepdims", False)),
+            reduction_size=reduction_size,
+            output_elements=count,
+            output_iteration=iteration,
+            reduction_iteration=reduction_iteration,
+        )
+        return VectorPlan(
+            VECTOR_PLAN_VERSION,
+            name,
+            "reduction",
+            operation_index,
+            tuple(ref.name for ref in operation.inputs),
+            output.name,
+            dtype,
+            output_shape,
+            layout,
+            contiguous_axis,
+            count,
+            lane_count,
+            iteration,
+            required_features,
+            specialization,
+            reduction=reduction,
+        )
+    if name == "matmul":
+        left_shape = static_shape(operation.inputs[0].type, "vector matmul left")
+        right_shape = static_shape(operation.inputs[1].type, "vector matmul right")
+        if len(left_shape) != 2 or len(right_shape) != 2 or len(output_shape) != 2:
+            raise CpuVectorValidationError("vector matmul requires rank-2 values")
+        m, k = left_shape
+        right_k, n = right_shape
+        if right_k != k or output_shape != (m, n):
+            raise CpuVectorValidationError("vector matmul shapes are inconsistent")
+        reduction_iteration = make_iteration_plan(k, lane_count, 1, tail_policy)
+        matmul = MatmulPlan(
+            m=m,
+            k=k,
+            n=n,
+            output_shape=(m, n),
+            output_elements=count,
+            output_iteration=iteration,
+            reduction_iteration=reduction_iteration,
+        )
+        return VectorPlan(
+            VECTOR_PLAN_VERSION,
+            name,
+            "matmul",
+            operation_index,
+            tuple(ref.name for ref in operation.inputs),
+            output.name,
+            dtype,
+            output_shape,
+            layout,
+            contiguous_axis,
+            count,
+            lane_count,
+            iteration,
+            required_features,
+            specialization,
+            matmul=matmul,
+        )
+    return VectorPlan(
+        VECTOR_PLAN_VERSION,
+        name,
+        "elementwise",
+        operation_index,
+        tuple(ref.name for ref in operation.inputs),
+        output.name,
+        dtype,
+        output_shape,
+        layout,
+        contiguous_axis,
+        count,
+        lane_count,
+        iteration,
+        required_features,
+        specialization,
+    )
+
+
+@dataclass(frozen=True, init=False)
+class CpuVectorProgram:
+    """Validated target IR containing a plan for every direct-body operation."""
+
+    program: CoreProgram
+    target: TargetSpec
+    entrypoint: str
+    plans: Tuple[VectorPlan, ...]
+    required_features: CpuFeatureSet
+    lane_count: int
+    tail_policy: TailPolicy
+    specialization: Mapping[str, Any]
+    plan_version: int
+
+    def __init__(
+        self,
+        program: CoreProgram,
+        target: TargetSpec,
+        entrypoint: str,
+        plans: Sequence[VectorPlan],
+        required_features: CpuFeatureSet,
+        lane_count: int,
+        tail_policy: Any,
+        specialization: Optional[Mapping[str, Any]] = None,
+        plan_version: int = VECTOR_PLAN_VERSION,
+    ) -> None:
+        if not isinstance(program, CoreProgram):
+            raise CpuVectorValidationError("vector program requires CoreProgram")
+        if not isinstance(target, TargetSpec):
+            raise CpuVectorValidationError("vector program requires TargetSpec")
+        if not isinstance(entrypoint, str) or not entrypoint.strip():
+            raise CpuVectorValidationError("vector entrypoint must be non-empty")
+        plan_values = tuple(plans)
+        if any(not isinstance(plan, VectorPlan) for plan in plan_values):
+            raise CpuVectorValidationError("vector program plans must be VectorPlan values")
+        if not isinstance(required_features, CpuFeatureSet):
+            raise CpuVectorValidationError("vector program required_features must be CpuFeatureSet")
+        lanes = _positive_int(lane_count, "lane_count")
+        policy = _tail_policy(tail_policy)
+        if plan_version != VECTOR_PLAN_VERSION:
+            raise CpuVectorValidationError("unsupported vector plan version {!r}".format(plan_version))
+        if any(plan.lane_count != lanes for plan in plan_values):
+            raise CpuVectorValidationError("all vector plans must use the program lane_count")
+        if any(plan.required_features != required_features for plan in plan_values):
+            raise CpuVectorValidationError("all vector plans must use program required_features")
+        object.__setattr__(self, "program", program)
+        object.__setattr__(self, "target", target)
+        object.__setattr__(self, "entrypoint", entrypoint.strip())
+        object.__setattr__(self, "plans", plan_values)
+        object.__setattr__(self, "required_features", required_features)
+        object.__setattr__(self, "lane_count", lanes)
+        object.__setattr__(self, "tail_policy", policy)
+        object.__setattr__(self, "specialization", frozen_mapping(specialization))
+        object.__setattr__(self, "plan_version", plan_version)
+
+    @property
+    def plan_digest(self) -> str:
+        return sha256_text([plan.to_dict() for plan in self.plans])
+
+    @property
+    def vector_plans(self) -> Tuple[VectorPlan, ...]:
+        return self.plans
+
+    @property
+    def features(self) -> CpuFeatureSet:
+        return self.required_features
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "plan_version": self.plan_version,
+            "entrypoint": self.entrypoint,
+            "lane_count": self.lane_count,
+            "tail_policy": self.tail_policy.value,
+            "required_features": self.required_features.to_dict(),
+            "specialization": mapping_copy(self.specialization),
+            "plans": [plan.to_dict() for plan in self.plans],
+            "plan_digest": self.plan_digest,
+        }
+
+    def canonical_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+    dumps = canonical_json
+    to_json = canonical_json
+
+
+def validate_cpu_vector_target(target: TargetSpec) -> TargetSpec:
+    try:
+        validate_cpu_target(target)
+    except CpuScalarError as exc:
+        raise CpuVectorValidationError(str(exc)) from exc
+    return target
+
+
+def lower_cpu_vector(
+    program: CoreProgram,
+    target: TargetSpec,
+    entrypoint: Optional[str] = None,
+    *,
+    lane_count: Optional[int] = None,
+    tail_policy: Any = None,
+    required_features: Any = None,
+    specialization: Optional[Mapping[str, Any]] = None,
+) -> CpuVectorProgram:
+    """Validate and construct ISA-neutral vector plans for one program."""
+
+    validate_cpu_vector_target(target)
+    try:
+        validate_program(program)
+    except CpuScalarUnsupportedError as exc:
+        raise CpuVectorUnsupportedError("scalar validation rejected vector plan: {}".format(exc)) from exc
+    except CpuScalarError as exc:
+        raise CpuVectorValidationError("scalar validation failed: {}".format(exc)) from exc
+    if any(function.body.blocks for function in program.functions):
+        raise CpuVectorUnsupportedError("vector common supports direct operation bodies only")
+    functions = {function.name: function for function in program.functions}
+    selected = entrypoint
+    if selected is None:
+        selected = target.attributes.get("entrypoint", program.functions[0].name)
+    if not isinstance(selected, str) or selected not in functions:
+        raise CpuVectorValidationError("vector entrypoint {!r} is not a program function".format(selected))
+    lanes = _target_lane_count(target, lane_count)
+    policy = _tail_policy(tail_policy if tail_policy is not None else target.attributes.get("tail_policy"))
+    required = _target_required_features(target, required_features)
+    normalized_specialization = _target_specialization(target, specialization)
+    function = functions[selected]
+    plans = tuple(
+        _make_plan_for_operation(
+            program,
+            operation,
+            index,
+            lanes,
+            policy,
+            required,
+            normalized_specialization,
+        )
+        for index, operation in enumerate(function.body.operations)
+    )
+    return CpuVectorProgram(
+        program,
+        target,
+        selected,
+        plans,
+        required,
+        lanes,
+        policy,
+        normalized_specialization,
+    )
+
+
+build_vector_plan = lower_cpu_vector
+make_vector_plan = lower_cpu_vector
+lower = lower_cpu_vector
+
+
+__all__ = [
+    "CPU_VECTOR_BACKEND",
+    "DEFAULT_LANE_COUNT",
+    "VECTOR_LOWERING_VERSION",
+    "VECTOR_PLAN_VERSION",
+    "CpuFeatureContract",
+    "CpuFeatureMismatch",
+    "CpuFeatureSet",
+    "CpuVectorError",
+    "CpuVectorFeatureMismatchError",
+    "CpuVectorPlan",
+    "CpuVectorProgram",
+    "CpuVectorUnsupportedError",
+    "CpuVectorValidationError",
+    "FeatureContract",
+    "FeatureMismatch",
+    "FeatureSet",
+    "IterationPlan",
+    "MatmulPlan",
+    "ReductionPlan",
+    "TailPlan",
+    "TailPolicy",
+    "VectorChunk",
+    "VectorIterationPlan",
+    "VectorPlan",
+    "build_vector_plan",
+    "lower",
+    "lower_cpu_vector",
+    "make_iteration_plan",
+    "make_vector_plan",
+    "validate_cpu_vector_target",
+]
