@@ -0,0 +1,643 @@
+"""Pure-Python reference executor for CPU vector plans.
+
+The executor intentionally visits every logical vector chunk and its bounded
+tail.  It is a correctness/reference path for later native vector backends;
+it does not call ``CpuScalarRuntime`` and does not claim SIMD execution.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, LaunchRequest, TensorDesc
+from pypto.compiler.artifact import Artifact
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import (
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    flatten_values,
+    static_shape,
+)
+from pypto.lowering.cpu.vector import (
+    CPU_VECTOR_BACKEND,
+    VECTOR_LOWERING_VERSION,
+    VECTOR_PLAN_VERSION,
+    CpuFeatureContract,
+    CpuFeatureSet,
+    CpuVectorFeatureMismatchError,
+    CpuVectorProgram,
+    lower_cpu_vector,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_text
+
+from ..tensor import FlatBuffer, HostTensor, _cast_value
+
+
+class CpuVectorRuntimeError(RuntimeError):
+    """Base class for explicit vector reference runtime failures."""
+
+
+class CpuVectorArtifactError(CpuVectorRuntimeError):
+    """An artifact payload, digest, plan, or feature contract is invalid."""
+
+
+class CpuVectorExecutionError(CpuVectorRuntimeError):
+    """A valid vector plan cannot execute a supplied invocation."""
+
+
+@dataclass(frozen=True)
+class LoadedCpuVectorArtifact:
+    artifact: Artifact
+    target_ir: CpuVectorProgram
+    feature_contract: CpuFeatureContract
+
+    @property
+    def contract(self) -> CpuFeatureContract:
+        return self.feature_contract
+
+
+@dataclass(frozen=True)
+class _RuntimeValue:
+    type: CoreType
+    data: Any
+
+
+class CpuVectorRuntime:
+    """Reference runtime that executes vector chunks with Python loops."""
+
+    name = CPU_VECTOR_BACKEND
+
+    def __init__(self, available_features: Any = None) -> None:
+        if available_features is None:
+            available_features = CpuFeatureSet((), source="injected")
+        elif not isinstance(available_features, CpuFeatureSet):
+            available_features = CpuFeatureSet(available_features, source="injected")
+        self.available_features = available_features
+
+    def availability(self) -> Availability:
+        return Availability.yes(self.name)
+
+    def is_available(self) -> bool:
+        # This is a dependency-free reference executor.  Artifact-specific
+        # CPU feature requirements are checked by load(), not faked here.
+        return True
+
+    def load(self, artifact: Artifact, available_features: Any = None) -> LoadedCpuVectorArtifact:
+        available = self.available_features if available_features is None else _feature_set(available_features)
+        return _decode_artifact(artifact, available)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, LaunchRequest):
+            raise CpuVectorExecutionError("workspace_size requires LaunchRequest")
+        self.load(request.artifact)
+        return 0
+
+    def launch(self, request: LaunchRequest) -> Tuple[Any, ...]:
+        if not isinstance(request, LaunchRequest):
+            raise CpuVectorExecutionError("CPU vector launch requires LaunchRequest")
+        try:
+            request.validate()
+        except Exception as exc:
+            raise CpuVectorExecutionError("invalid LaunchRequest: {}".format(exc)) from exc
+        loaded = self.load(request.artifact)
+        if request.entrypoint != loaded.target_ir.entrypoint:
+            raise CpuVectorExecutionError(
+                "launch entrypoint {!r} does not match loaded CPU vector entrypoint {!r}".format(
+                    request.entrypoint, loaded.target_ir.entrypoint
+                )
+            )
+        function = _find_function(loaded.target_ir.program, request.entrypoint)
+        _validate_request_target(request, loaded.target_ir.target)
+        tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+        tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+        if len(request.inputs) != len(tensor_parameters):
+            raise CpuVectorExecutionError(
+                "function {!r} expects {} tensor inputs, got {}".format(
+                    function.name, len(tensor_parameters), len(request.inputs)
+                )
+            )
+        if len(request.outputs) != len(tensor_returns):
+            raise CpuVectorExecutionError(
+                "function {!r} expects {} tensor outputs, got {}".format(
+                    function.name, len(tensor_returns), len(request.outputs)
+                )
+            )
+        if len(loaded.target_ir.plans) != len(function.body.operations):
+            raise CpuVectorExecutionError("artifact vector plan count does not match function operation count")
+
+        environment: Dict[str, _RuntimeValue] = {}
+        input_index = 0
+        for parameter in function.parameters:
+            if _is_tensor(parameter.type):
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _read_tensor(request.inputs[input_index], parameter.type, parameter.name),
+                )
+                input_index += 1
+            elif _is_scalar(parameter.type):
+                if parameter.name not in request.scalars:
+                    raise CpuVectorExecutionError(
+                        "missing scalar input {!r} in LaunchRequest.scalars".format(parameter.name)
+                    )
+                try:
+                    value = _cast_value(request.scalars[parameter.name], canonical_dtype(parameter.type.dtype))
+                except (TypeError, ValueError, OverflowError) as exc:
+                    raise CpuVectorExecutionError(
+                        "scalar input {!r} is invalid: {}".format(parameter.name, exc)
+                    ) from exc
+                environment[parameter.name] = _RuntimeValue(parameter.type, value)
+            else:
+                raise CpuVectorExecutionError("unsupported parameter kind {!r}".format(parameter.type.kind))
+
+        for index, operation in enumerate(function.body.operations):
+            _execute_operation(operation, loaded.target_ir.plans[index], environment, "function {} operation {}".format(function.name, index))
+
+        results: List[Any] = []
+        output_index = 0
+        for result_ref in function.returns:
+            if result_ref.name not in environment:
+                raise CpuVectorExecutionError("return value {!r} was not produced".format(result_ref.name))
+            result = environment[result_ref.name]
+            if result.type != result_ref.type:
+                raise CpuVectorExecutionError("return value {!r} has the wrong type".format(result_ref.name))
+            if _is_tensor(result_ref.type):
+                descriptor = request.outputs[output_index]
+                _write_tensor(descriptor, result_ref.type, result.data, result_ref.name)
+                results.append(descriptor.storage)
+                output_index += 1
+            else:
+                results.append(result.data)
+        return tuple(results)
+
+
+CpuVectorReferenceRuntime = CpuVectorRuntime
+CpuVectorBackend = CpuVectorRuntime
+VectorRuntime = CpuVectorRuntime
+
+
+def _feature_set(value: Any) -> CpuFeatureSet:
+    if isinstance(value, CpuFeatureSet):
+        return value
+    return CpuFeatureSet(value, source="injected")
+
+
+def _decode_artifact(artifact: Artifact, available: CpuFeatureSet) -> LoadedCpuVectorArtifact:
+    if not isinstance(artifact, Artifact):
+        raise CpuVectorArtifactError("CPU vector runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CpuVectorArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.payload is None:
+        raise CpuVectorArtifactError("CPU vector artifact requires an inline payload")
+    payload = bytes(artifact.payload)
+    metadata = artifact.metadata
+    if metadata.get("backend") != CPU_VECTOR_BACKEND:
+        raise CpuVectorArtifactError("artifact backend metadata is not CPU vector common")
+    actual_digest = hashlib.sha256(payload).hexdigest()
+    if actual_digest != artifact.content_digest:
+        raise CpuVectorArtifactError("artifact content digest does not match immutable Artifact payload")
+    if metadata.get("payload_digest") != actual_digest:
+        raise CpuVectorArtifactError("CPU vector artifact metadata payload digest mismatch")
+    try:
+        decoded = json.loads(payload.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError) as exc:
+        raise CpuVectorArtifactError("CPU vector artifact payload is not UTF-8 JSON") from exc
+    if not isinstance(decoded, dict):
+        raise CpuVectorArtifactError("CPU vector artifact payload must be a JSON object")
+    canonical_payload = json.dumps(
+        decoded,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    if canonical_payload != payload:
+        raise CpuVectorArtifactError("CPU vector artifact payload is not canonical JSON")
+    if decoded.get("artifact_payload_version") != 1:
+        raise CpuVectorArtifactError("unsupported CPU vector artifact payload version")
+    if decoded.get("backend") != CPU_VECTOR_BACKEND:
+        raise CpuVectorArtifactError("CPU vector artifact payload backend mismatch")
+    if decoded.get("target") != artifact.target.to_dict():
+        raise CpuVectorArtifactError("CPU vector artifact target mismatch")
+    program_data = decoded.get("program")
+    if not isinstance(program_data, dict):
+        raise CpuVectorArtifactError("CPU vector artifact does not contain a CoreProgram")
+    plan_data = decoded.get("vector_plan")
+    if not isinstance(plan_data, dict):
+        raise CpuVectorArtifactError("CPU vector artifact does not contain vector plan data")
+    required_data = plan_data.get("required_features", {})
+    if not isinstance(required_data, Mapping):
+        raise CpuVectorArtifactError("CPU vector artifact required_features is invalid")
+    required = CpuFeatureSet(required_data.get("features", ()), source=required_data.get("source", "artifact"))
+    try:
+        program = CoreProgram.from_dict(program_data)
+        target_ir = lower_cpu_vector(
+            program,
+            artifact.target,
+            plan_data.get("entrypoint"),
+            lane_count=plan_data.get("lane_count"),
+            tail_policy=plan_data.get("tail_policy"),
+            required_features=required,
+            specialization=plan_data.get("specialization", {}),
+        )
+    except Exception as exc:
+        raise CpuVectorArtifactError("CPU vector artifact CoreProgram/plan is invalid: {}".format(exc)) from exc
+    if target_ir.to_dict() != plan_data:
+        raise CpuVectorArtifactError("CPU vector artifact vector plan mismatch")
+    program_json = program.canonical_json()
+    program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+    if decoded.get("program_digest") != program_digest or metadata.get("program_digest") != program_digest:
+        raise CpuVectorArtifactError("CPU vector artifact program digest mismatch")
+    if decoded.get("plan_digest") != target_ir.plan_digest or metadata.get("plan_digest") != target_ir.plan_digest:
+        raise CpuVectorArtifactError("CPU vector artifact plan digest mismatch")
+    if metadata.get("entrypoint") != artifact.entrypoint or plan_data.get("entrypoint") != artifact.entrypoint:
+        raise CpuVectorArtifactError("CPU vector artifact entrypoint mismatch")
+    if metadata.get("artifact_payload_version") != 1:
+        raise CpuVectorArtifactError("unsupported CPU vector artifact metadata version")
+    if metadata.get("lowering_version") != VECTOR_LOWERING_VERSION:
+        raise CpuVectorArtifactError("unsupported CPU vector lowering version")
+    if metadata.get("plan_version") != VECTOR_PLAN_VERSION:
+        raise CpuVectorArtifactError("unsupported CPU vector plan version")
+    if metadata.get("target_digest") != sha256_text(artifact.target.to_dict()):
+        raise CpuVectorArtifactError("CPU vector artifact target digest mismatch")
+    expected_features = tuple(required.features)
+    if tuple(metadata.get("required_features", ())) != expected_features:
+        raise CpuVectorArtifactError("CPU vector artifact required feature metadata mismatch")
+    mismatch_contract = CpuFeatureContract(required, available)
+    try:
+        mismatch_contract.validate()
+    except CpuVectorFeatureMismatchError:
+        raise
+    return LoadedCpuVectorArtifact(artifact, target_ir, mismatch_contract)
+
+
+def launch(request: LaunchRequest, available_features: Any = None) -> Tuple[Any, ...]:
+    """Run one request with a fresh dependency-free vector reference runtime."""
+
+    return CpuVectorRuntime(available_features).launch(request)
+
+
+def _find_function(program: CoreProgram, entrypoint: str) -> CoreFunction:
+    for function in program.functions:
+        if function.name == entrypoint:
+            return function
+    raise CpuVectorExecutionError("entrypoint {!r} is not present in CoreProgram".format(entrypoint))
+
+
+def _validate_request_target(request: LaunchRequest, target: TargetSpec) -> None:
+    if target.kind != "cpu":
+        raise CpuVectorExecutionError("CPU vector artifact target kind must be cpu")
+    for index, descriptor in enumerate(request.inputs + request.outputs):
+        if descriptor.device != "cpu":
+            raise CpuVectorExecutionError(
+                "CPU vector tensor descriptor {} has device {!r}, expected 'cpu'".format(index, descriptor.device)
+            )
+        if descriptor.strides != _contiguous_strides(descriptor.shape):
+            raise CpuVectorExecutionError("CPU vector requires contiguous tensor descriptors")
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _read_tensor(descriptor: TensorDesc, value_type: CoreType, context: str) -> List[Any]:
+    try:
+        expected_dtype = canonical_dtype(value_type.dtype)
+        descriptor_dtype = canonical_dtype(descriptor.dtype)
+    except (TypeError, ValueError) as exc:
+        raise CpuVectorExecutionError("{} has an unsupported dtype: {}".format(context, exc)) from exc
+    expected_shape = static_shape(value_type, context)
+    if descriptor_dtype != expected_dtype or descriptor.shape != expected_shape:
+        raise CpuVectorExecutionError(
+            "{} descriptor dtype/shape ({}, {}) does not match expected ({}, {})".format(
+                context, descriptor.dtype, descriptor.shape, expected_dtype, expected_shape
+            )
+        )
+    if isinstance(descriptor.storage, HostTensor):
+        try:
+            storage_dtype = canonical_dtype(descriptor.storage.dtype)
+        except (TypeError, ValueError) as exc:
+            raise CpuVectorExecutionError("{} HostTensor has an unsupported dtype: {}".format(context, exc)) from exc
+        if storage_dtype != expected_dtype or descriptor.storage.shape != expected_shape:
+            raise CpuVectorExecutionError("{} HostTensor metadata does not match input descriptor".format(context))
+    values = _storage_values(descriptor.storage, context)
+    expected_count = element_count(expected_shape)
+    if len(values) != expected_count:
+        raise CpuVectorExecutionError(
+            "{} storage has {} values but shape {} requires {}".format(context, len(values), expected_shape, expected_count)
+        )
+    try:
+        return [_cast_value(value, expected_dtype) for value in values]
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise CpuVectorExecutionError("{} contains an invalid value: {}".format(context, exc)) from exc
+
+
+def _write_tensor(descriptor: TensorDesc, value_type: CoreType, values: Sequence[Any], context: str) -> None:
+    if descriptor.readonly:
+        raise CpuVectorExecutionError("{} output descriptor is read-only".format(context))
+    try:
+        expected_dtype = canonical_dtype(value_type.dtype)
+        descriptor_dtype = canonical_dtype(descriptor.dtype)
+    except (TypeError, ValueError) as exc:
+        raise CpuVectorExecutionError("{} has an unsupported dtype: {}".format(context, exc)) from exc
+    expected_shape = static_shape(value_type, context)
+    if descriptor_dtype != expected_dtype or descriptor.shape != expected_shape:
+        raise CpuVectorExecutionError(
+            "{} output descriptor dtype/shape ({}, {}) does not match expected ({}, {})".format(
+                context, descriptor.dtype, descriptor.shape, expected_dtype, expected_shape
+            )
+        )
+    storage = descriptor.storage
+    if isinstance(storage, HostTensor):
+        try:
+            storage_dtype = canonical_dtype(storage.dtype)
+        except (TypeError, ValueError) as exc:
+            raise CpuVectorExecutionError("{} HostTensor has an unsupported dtype: {}".format(context, exc)) from exc
+        if storage_dtype != expected_dtype or storage.shape != expected_shape:
+            raise CpuVectorExecutionError("{} HostTensor metadata does not match output descriptor".format(context))
+        destination = storage.data
+    elif isinstance(storage, FlatBuffer):
+        destination = storage.data
+    elif isinstance(storage, list):
+        destination = storage
+    elif hasattr(storage, "data") and isinstance(storage.data, list):
+        destination = storage.data
+    else:
+        destination = None
+    try:
+        cast_values = [_cast_value(value, expected_dtype) for value in values]
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise CpuVectorExecutionError("{} produced an invalid value: {}".format(context, exc)) from exc
+    if len(cast_values) != element_count(expected_shape):
+        raise CpuVectorExecutionError("{} result length does not match output shape".format(context))
+    if destination is not None:
+        if len(destination) != len(cast_values):
+            raise CpuVectorExecutionError("{} output storage length does not match output shape".format(context))
+        destination[:] = cast_values
+        return
+    if storage is None or not hasattr(storage, "__setitem__"):
+        raise CpuVectorExecutionError("{} output storage is not mutable".format(context))
+    try:
+        if len(storage) != len(cast_values):
+            raise CpuVectorExecutionError("{} output storage length does not match output shape".format(context))
+        for index, value in enumerate(cast_values):
+            storage[index] = value
+    except (TypeError, IndexError, AttributeError) as exc:
+        raise CpuVectorExecutionError("{} output storage is not mutable".format(context)) from exc
+
+
+def _storage_values(storage: Any, context: str) -> List[Any]:
+    if isinstance(storage, HostTensor):
+        return list(storage.data)
+    if isinstance(storage, FlatBuffer):
+        return list(storage.data)
+    if isinstance(storage, (str, bytes, bytearray, Mapping)) or storage is None:
+        raise CpuVectorExecutionError("{} storage must be a flat numeric sequence".format(context))
+    if isinstance(storage, (list, tuple)):
+        return list(flatten_values(storage))
+    if hasattr(storage, "data") and isinstance(storage.data, (list, tuple)):
+        return list(storage.data)
+    try:
+        return [storage[index] for index in range(len(storage))]
+    except (TypeError, IndexError, KeyError, AttributeError) as exc:
+        raise CpuVectorExecutionError("{} storage must support flat sequence access".format(context)) from exc
+
+
+def _value_sequence(value: Any, value_type: CoreType, context: str) -> Tuple[List[Any], bool]:
+    if _is_tensor(value_type):
+        expected = element_count(static_shape(value_type, context))
+        if not isinstance(value, list) or len(value) != expected:
+            raise CpuVectorExecutionError("{} tensor value length mismatch".format(context))
+        return value, False
+    if _is_scalar(value_type):
+        return [value], True
+    raise CpuVectorExecutionError("{} value kind {!r} is unsupported".format(context, value_type.kind))
+
+
+def _from_sequence(values: List[Any], scalar: bool) -> Any:
+    return values[0] if scalar else values
+
+
+def _execute_operation(
+    operation: Operation,
+    plan: Any,
+    environment: Dict[str, _RuntimeValue],
+    context: str,
+) -> None:
+    name = canonical_operation_name(operation.name)
+    if plan.operation != name:
+        raise CpuVectorExecutionError("{} operation does not match vector plan".format(context))
+    inputs = []
+    for ref in operation.inputs:
+        if ref.name not in environment:
+            raise CpuVectorExecutionError("{} input {!r} is unavailable".format(context, ref.name))
+        value = environment[ref.name]
+        if value.type != ref.type:
+            raise CpuVectorExecutionError("{} input {!r} has a type mismatch".format(context, ref.name))
+        inputs.append(value)
+    output_ref = operation.outputs[0]
+    try:
+        if name == "constant":
+            raw = operation.attributes.get("value", operation.attributes.get("values"))
+            if _is_scalar(output_ref.type):
+                if isinstance(raw, (list, tuple)):
+                    raw = raw[0] if len(raw) == 1 else raw
+                result = _cast_value(raw, canonical_dtype(output_ref.type.dtype))
+            else:
+                values = list(flatten_values(raw))
+                result = _vector_map(plan, values, lambda value: _cast_value(value, plan.dtype), context)
+        elif name == "identity":
+            source, scalar = _value_sequence(inputs[0].data, inputs[0].type, context)
+            result = _from_sequence(_vector_map(plan, source, lambda value: value, context), scalar)
+        elif name in ("add", "sub", "mul", "div"):
+            result = _execute_binary(name, inputs[0], inputs[1], output_ref.type, plan, context)
+        elif name == "neg":
+            source, scalar = _value_sequence(inputs[0].data, inputs[0].type, context)
+            result = _from_sequence(
+                _vector_map(plan, source, lambda value: _unary(name, value, plan.dtype), context), scalar
+            )
+        elif name in ("reduce_sum", "reduce_max"):
+            result = _execute_reduction(name, inputs[0], output_ref.type, plan, context)
+        elif name == "matmul":
+            result = _execute_matmul(inputs[0], inputs[1], output_ref.type, plan, context)
+        else:
+            raise CpuVectorExecutionError("{} operation {!r} is unsupported".format(context, operation.name))
+    except CpuVectorExecutionError:
+        raise
+    except (TypeError, ValueError, ZeroDivisionError, OverflowError) as exc:
+        raise CpuVectorExecutionError("{} failed: {}".format(context, exc)) from exc
+    environment[output_ref.name] = _RuntimeValue(output_ref.type, result)
+
+
+def _vector_map(plan: Any, values: Sequence[Any], operation: Callable[[Any], Any], context: str) -> List[Any]:
+    if len(values) != plan.element_count:
+        raise CpuVectorExecutionError(
+            "{} value length {} does not match vector plan element count {}".format(
+                context, len(values), plan.element_count
+            )
+        )
+    result = [None] * plan.element_count
+    for chunk in plan.iteration.chunks:
+        for offset in range(chunk.length):
+            index = chunk.start + offset
+            if index >= plan.element_count:
+                raise CpuVectorExecutionError("{} vector chunk exceeds element domain".format(context))
+            result[index] = operation(values[index])
+    return result
+
+
+def _execute_binary(name: str, left: _RuntimeValue, right: _RuntimeValue, output_type: CoreType, plan: Any, context: str) -> Any:
+    left_values, left_scalar = _value_sequence(left.data, left.type, context + ".left")
+    right_values, right_scalar = _value_sequence(right.data, right.type, context + ".right")
+    output_is_scalar = _is_scalar(output_type)
+    count = plan.element_count
+    if not left_scalar and len(left_values) != count:
+        raise CpuVectorExecutionError("{} left value length mismatch".format(context))
+    if not right_scalar and len(right_values) != count:
+        raise CpuVectorExecutionError("{} right value length mismatch".format(context))
+    result = [None] * count
+    for chunk in plan.iteration.chunks:
+        for offset in range(chunk.length):
+            index = chunk.start + offset
+            a = left_values[0] if left_scalar else left_values[index]
+            b = right_values[0] if right_scalar else right_values[index]
+            result[index] = _binary(name, a, b, plan.dtype)
+    return result[0] if output_is_scalar else result
+
+
+def _binary(name: str, left: Any, right: Any, dtype: str) -> Any:
+    if name == "add":
+        value = left + right
+    elif name == "sub":
+        value = left - right
+    elif name == "mul":
+        value = left * right
+    else:
+        if right == 0:
+            raise CpuVectorExecutionError("division by zero")
+        value = left / right
+    return _cast_value(value, dtype)
+
+
+def _unary(name: str, value: Any, dtype: str) -> Any:
+    if name != "neg":
+        raise CpuVectorExecutionError("unsupported unary operation {!r}".format(name))
+    return _cast_value(-value, dtype)
+
+
+def _execute_reduction(name: str, value: _RuntimeValue, output_type: CoreType, plan: Any, context: str) -> List[Any]:
+    reduction = plan.reduction
+    input_values, scalar = _value_sequence(value.data, value.type, context + ".input")
+    if scalar:
+        raise CpuVectorExecutionError("{} reduction input must be tensor".format(context))
+    input_shape = reduction.input_shape
+    output_shape = reduction.output_shape
+    if len(input_values) != element_count(input_shape):
+        raise CpuVectorExecutionError("{} reduction input length mismatch".format(context))
+    result = [None] * reduction.output_elements
+    for output_chunk in reduction.output_iteration.chunks:
+        for output_index in range(output_chunk.start, output_chunk.start + output_chunk.length):
+            output_coords = _unravel(output_index, output_shape)
+            candidates = []
+            for input_index, input_value in enumerate(input_values):
+                input_coords = _unravel(input_index, input_shape)
+                if reduction.keepdims:
+                    projected = tuple(0 if axis in reduction.axes else input_coords[axis] for axis in range(len(input_shape)))
+                else:
+                    projected = tuple(input_coords[axis] for axis in range(len(input_shape)) if axis not in reduction.axes)
+                if projected == output_coords:
+                    candidates.append(input_value)
+            if len(candidates) != reduction.reduction_size:
+                if reduction.reduction_size == 0 and not candidates:
+                    candidates = []
+                else:
+                    raise CpuVectorExecutionError("{} reduction group length mismatch".format(context))
+            aggregate = None
+            for reduction_chunk in reduction.reduction_iteration.chunks:
+                for offset in range(reduction_chunk.length):
+                    candidate_index = reduction_chunk.start + offset
+                    if candidate_index >= len(candidates):
+                        raise CpuVectorExecutionError("{} reduction chunk exceeds group".format(context))
+                    candidate = candidates[candidate_index]
+                    if aggregate is None:
+                        aggregate = candidate
+                    elif name == "reduce_sum":
+                        aggregate += candidate
+                    elif candidate > aggregate:
+                        aggregate = candidate
+            if name == "reduce_sum" and aggregate is None:
+                aggregate = 0
+            if aggregate is None:
+                raise CpuVectorExecutionError("reduce_max has an empty reduction group")
+            result[output_index] = _cast_value(aggregate, canonical_dtype(output_type.dtype))
+    return result
+
+
+def _execute_matmul(left: _RuntimeValue, right: _RuntimeValue, output_type: CoreType, plan: Any, context: str) -> List[Any]:
+    matmul = plan.matmul
+    left_values, left_scalar = _value_sequence(left.data, left.type, context + ".left")
+    right_values, right_scalar = _value_sequence(right.data, right.type, context + ".right")
+    if left_scalar or right_scalar:
+        raise CpuVectorExecutionError("{} matmul inputs must be tensors".format(context))
+    if len(left_values) != matmul.m * matmul.k or len(right_values) != matmul.k * matmul.n:
+        raise CpuVectorExecutionError("{} matmul input length mismatch".format(context))
+    result = [None] * matmul.output_elements
+    for output_chunk in matmul.output_iteration.chunks:
+        for output_index in range(output_chunk.start, output_chunk.start + output_chunk.length):
+            row = output_index // matmul.n if matmul.n else 0
+            column = output_index % matmul.n if matmul.n else 0
+            aggregate = 0
+            for reduction_chunk in matmul.reduction_iteration.chunks:
+                for offset in range(reduction_chunk.length):
+                    inner = reduction_chunk.start + offset
+                    if inner >= matmul.k:
+                        raise CpuVectorExecutionError("{} matmul reduction chunk exceeds k".format(context))
+                    aggregate += left_values[row * matmul.k + inner] * right_values[inner * matmul.n + column]
+            result[output_index] = _cast_value(aggregate, canonical_dtype(output_type.dtype))
+    return result
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _unravel(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
+    if not shape:
+        return ()
+    coordinates = [0] * len(shape)
+    remainder = index
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension == 0:
+            return tuple(coordinates)
+        coordinates[axis] = remainder % dimension
+        remainder //= dimension
+    return tuple(coordinates)
+
+
+__all__ = [
+    "CpuVectorArtifactError",
+    "CpuVectorBackend",
+    "CpuVectorExecutionError",
+    "CpuVectorReferenceRuntime",
+    "CpuVectorRuntime",
+    "CpuVectorRuntimeError",
+    "LoadedCpuVectorArtifact",
+    "VectorRuntime",
+    "launch",
+]
diff --git a/python/pypto/compiler/targets/cpu_vector.py b/python/pypto/compiler/targets/cpu_vector.py
new file mode 100644
index 000000000..a60409184
--- /dev/null
+++ b/python/pypto/compiler/targets/cpu_vector.py
@@ -0,0 +1,167 @@
+"""Deterministic compiler for the ISA-neutral CPU vector target."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any, Mapping, Optional
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu.vector import (
+    CPU_VECTOR_BACKEND,
+    VECTOR_LOWERING_VERSION,
+    VECTOR_PLAN_VERSION,
+    CpuVectorProgram,
+    lower_cpu_vector,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_text
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+DEFAULT_ARTIFACT_FORMAT = "pypto-x.cpu.vector.common"
+
+
+class CpuVectorCompiler:
+    """Lower and package target-owned vector plans.
+
+    Compilation here creates a deterministic Python/JSON artifact only.  It
+    deliberately emits no ISA instruction or intrinsic; AVX2/AVX-512
+    compilers can consume the same ``CpuVectorProgram`` later.
+    """
+
+    name = CPU_VECTOR_BACKEND
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> CpuVectorProgram:
+        return lower_cpu_vector(program, target)
+
+    def compile(self, target_ir: CpuVectorProgram, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, CpuVectorProgram):
+            raise TypeError("CPU vector compile() requires CpuVectorProgram from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+
+        program_json = target_ir.program.canonical_json()
+        program_payload = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        target_data = dict(target_ir.target.to_dict())
+        plan_data = target_ir.to_dict()
+        plan_digest = target_ir.plan_digest
+        envelope = {
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "backend": CPU_VECTOR_BACKEND,
+            "lowering_version": VECTOR_LOWERING_VERSION,
+            "plan_version": VECTOR_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "target": target_data,
+            "program": program_payload,
+            "program_digest": program_digest,
+            "vector_plan": plan_data,
+            "plan_digest": plan_digest,
+        }
+        if options is not None:
+            envelope["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "metadata": _plain_mapping(options.metadata),
+                "extra": _plain_mapping(options.extra),
+            }
+        payload_text = json.dumps(
+            envelope,
+            ensure_ascii=False,
+            allow_nan=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        payload = payload_text.encode("utf-8")
+        payload_digest = hashlib.sha256(payload).hexdigest()
+        plan_dtypes = sorted(set(plan.dtype for plan in target_ir.plans))
+        plan_layouts = sorted(set(plan.layout for plan in target_ir.plans))
+        metadata = {
+            "backend": CPU_VECTOR_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "lowering_version": VECTOR_LOWERING_VERSION,
+            "plan_version": VECTOR_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "program_digest": program_digest,
+            "plan_digest": plan_digest,
+            "payload_digest": payload_digest,
+            "target_digest": sha256_text(target_data),
+            "required_features": list(target_ir.required_features.features),
+            "dtypes": plan_dtypes,
+            "layouts": plan_layouts,
+            "lane_count": target_ir.lane_count,
+            "tail_policy": target_ir.tail_policy.value,
+            "specialization": mapping_copy(target_ir.specialization),
+        }
+        if options is not None:
+            option_metadata = _plain_mapping(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError(
+                    "compile option metadata uses reserved CPU vector keys: {}".format(
+                        ", ".join(sorted(reserved))
+                    )
+                )
+            metadata.update(option_metadata)
+            metadata["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "extra": _plain_mapping(options.extra),
+            }
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            payload=payload,
+            metadata=metadata,
+        )
+        artifact.validate()
+        return artifact
+
+
+def _plain_mapping(value: Mapping[str, Any]) -> dict:
+    if not isinstance(value, Mapping):
+        raise TypeError("metadata must be a mapping")
+    return {key: _plain_value(item) for key, item in value.items()}
+
+
+def _plain_value(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [_plain_value(item) for item in value]
+    if isinstance(value, list):
+        return [_plain_value(item) for item in value]
+    return value
+
+
+CPUVectorCompiler = CpuVectorCompiler
+
+
+def compile_cpu_vector(
+    program: CoreProgram,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None,
+) -> Artifact:
+    """Convenience wrapper using the public compiler contract."""
+
+    compiler = CpuVectorCompiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION",
+    "CPUVectorCompiler",
+    "DEFAULT_ARTIFACT_FORMAT",
+    "CpuVectorCompiler",
+    "compile_cpu_vector",
+]
