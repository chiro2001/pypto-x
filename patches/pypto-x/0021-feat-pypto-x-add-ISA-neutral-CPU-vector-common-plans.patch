diff --git a/python/pypto/lowering/cpu/vector/plan.py b/python/pypto/lowering/cpu/vector/plan.py
new file mode 100644
index 000000000..dd3cd4688
--- /dev/null
+++ b/python/pypto/lowering/cpu/vector/plan.py
@@ -0,0 +1,1091 @@
+"""ISA-neutral CPU vector plans for PyPTO-X.
+
+This module deliberately stops at a target-owned iteration plan.  It does not
+name an instruction, register file, compiler intrinsic, or vendor ISA.  The
+plan is consumed by the reference executor and by later AVX/SVE lowerings.
+
+The scalar CPU lowering remains the source of truth for Core IR operation,
+shape, and dtype validation.  Vector planning only adds a concrete, immutable
+iteration domain on top of that validated subset.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.core_ir import CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import (
+    CpuScalarError,
+    CpuScalarUnsupportedError,
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    reduced_shape,
+    static_shape,
+    validate_cpu_target,
+    validate_program,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import canonical_json, frozen_mapping, mapping_copy, sha256_text
+
+
+VECTOR_PLAN_VERSION = 1
+VECTOR_LOWERING_VERSION = 1
+CPU_VECTOR_BACKEND = "cpu.vector.common"
+DEFAULT_LANE_COUNT = 4
+
+
+class CpuVectorError(ValueError):
+    """Base class for vector-plan validation and execution contracts."""
+
+
+class CpuVectorValidationError(CpuVectorError):
+    """The Core IR or vector-plan options are invalid."""
+
+
+class CpuVectorUnsupportedError(CpuVectorError):
+    """The scalar subset is valid but not representable by this vector plan."""
+
+
+class CpuVectorFeatureMismatchError(CpuVectorError):
+    """Required CPU features are absent from an injected capability set."""
+
+    def __init__(self, mismatch: "FeatureMismatch") -> None:
+        self.mismatch = mismatch
+        super().__init__(
+            "missing CPU features: {}".format(", ".join(mismatch.missing) or "<none>")
+        )
+
+
+def _positive_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+        raise CpuVectorValidationError("{} must be a positive integer".format(field))
+    return value
+
+
+def _non_negative_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise CpuVectorValidationError("{} must be a non-negative integer".format(field))
+    return value
+
+
+def _product(values: Sequence[int]) -> int:
+    result = 1
+    for value in values:
+        result *= value
+    return result
+
+
+def _normalise_names(values: Any, field: str) -> Tuple[str, ...]:
+    if values is None:
+        return ()
+    if isinstance(values, str):
+        values = (values,)
+    try:
+        iterator = iter(values)
+    except TypeError as exc:
+        raise CpuVectorValidationError("{} must be a string or sequence of strings".format(field)) from exc
+    names = set()
+    for value in iterator:
+        if not isinstance(value, str) or not value.strip():
+            raise CpuVectorValidationError("{} must contain non-empty strings".format(field))
+        names.add(value.strip().lower())
+    return tuple(sorted(names))
+
+
+@dataclass(frozen=True, init=False)
+class CpuFeatureSet:
+    """Immutable, injected CPU capability names.
+
+    The common layer intentionally has no host probing method.  AVX2/AVX-512
+    variants can construct this value from CPUID plus OSXSAVE/XGETBV results,
+    while tests can inject a deterministic set directly.
+    """
+
+    features: Tuple[str, ...]
+    source: str
+
+    def __init__(self, features: Any = (), source: str = "injected") -> None:
+        names = _normalise_names(features, "features")
+        if not isinstance(source, str) or not source.strip():
+            raise CpuVectorValidationError("feature source must be a non-empty string")
+        object.__setattr__(self, "features", names)
+        object.__setattr__(self, "source", source.strip())
+
+    @property
+    def names(self) -> Tuple[str, ...]:
+        return self.features
+
+    def contains(self, feature: Any) -> bool:
+        return isinstance(feature, str) and feature.strip().lower() in self.features
+
+    def missing(self, required: Any) -> Tuple[str, ...]:
+        required_set = required if isinstance(required, CpuFeatureSet) else CpuFeatureSet(required)
+        return tuple(name for name in required_set.features if name not in self.features)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"features": list(self.features), "source": self.source}
+
+    @property
+    def fingerprint(self) -> str:
+        return sha256_text(self.to_dict())
+
+
+@dataclass(frozen=True)
+class FeatureMismatch:
+    """Stable diagnostic for a missing-feature decision."""
+
+    required: CpuFeatureSet
+    available: CpuFeatureSet
+    missing: Tuple[str, ...]
+    reason_code: str = "missing_cpu_features"
+
+    def __post_init__(self) -> None:
+        missing = tuple(sorted(set(self.missing)))
+        if missing != tuple(self.available.missing(self.required)):
+            raise CpuVectorValidationError("feature mismatch does not match required/available sets")
+        object.__setattr__(self, "missing", missing)
+
+    @property
+    def compatible(self) -> bool:
+        return not self.missing
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "reason_code": self.reason_code,
+            "required": self.required.to_dict(),
+            "available": self.available.to_dict(),
+            "missing": list(self.missing),
+        }
+
+
+@dataclass(frozen=True)
+class CpuFeatureContract:
+    """Required and injected available CPU features for one artifact."""
+
+    required: CpuFeatureSet
+    available: CpuFeatureSet
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.required, CpuFeatureSet) or not isinstance(self.available, CpuFeatureSet):
+            raise CpuVectorValidationError("feature contract requires CpuFeatureSet values")
+
+    @property
+    def missing(self) -> Tuple[str, ...]:
+        return self.available.missing(self.required)
+
+    @property
+    def compatible(self) -> bool:
+        return not self.missing
+
+    def mismatch(self) -> Optional[FeatureMismatch]:
+        missing = self.missing
+        if not missing:
+            return None
+        return FeatureMismatch(self.required, self.available, missing)
+
+    def validate(self) -> None:
+        mismatch = self.mismatch()
+        if mismatch is not None:
+            raise CpuVectorFeatureMismatchError(mismatch)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"required": self.required.to_dict(), "available": self.available.to_dict()}
+
+
+FeatureSet = CpuFeatureSet
+FeatureContract = CpuFeatureContract
+CpuFeatureMismatch = FeatureMismatch
+
+
+class TailPolicy(str, Enum):
+    """Abstract handling for a vector block shorter than ``lane_count``."""
+
+    SCALAR_CLEANUP = "scalar_cleanup"
+    MASKED = "masked"
+
+    # Convenient spellings for backend code without creating new values.
+    scalar = SCALAR_CLEANUP
+    masked = MASKED
+    SCALAR = SCALAR_CLEANUP
+    MASK = MASKED
+
+
+def _tail_policy(value: Any) -> TailPolicy:
+    if value is None:
+        return TailPolicy.SCALAR_CLEANUP
+    if isinstance(value, TailPolicy):
+        return value
+    if isinstance(value, str):
+        key = value.strip().lower().replace("-", "_")
+        for candidate in TailPolicy:
+            if candidate.value == key:
+                return candidate
+    raise CpuVectorValidationError("tail_policy must be 'scalar_cleanup' or 'masked'")
+
+
+@dataclass(frozen=True)
+class VectorChunk:
+    """One bounded logical vector block.
+
+    ``length`` is the number of active elements, including for a masked tail;
+    no chunk ever includes elements outside the iteration domain.
+    """
+
+    start: int
+    length: int
+    is_tail: bool
+
+    def __post_init__(self) -> None:
+        _non_negative_int(self.start, "chunk.start")
+        if isinstance(self.length, bool) or not isinstance(self.length, int) or self.length <= 0:
+            raise CpuVectorValidationError("chunk.length must be a positive integer")
+        if not isinstance(self.is_tail, bool):
+            raise CpuVectorValidationError("chunk.is_tail must be bool")
+
+    @property
+    def active_lanes(self) -> int:
+        return self.length
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"start": self.start, "length": self.length, "is_tail": self.is_tail}
+
+
+@dataclass(frozen=True)
+class TailPlan:
+    """Abstract tail policy and bounded tail interval."""
+
+    policy: TailPolicy
+    start: int
+    elements: int
+
+    def __post_init__(self) -> None:
+        _non_negative_int(self.start, "tail.start")
+        if isinstance(self.elements, bool) or not isinstance(self.elements, int) or self.elements < 0:
+            raise CpuVectorValidationError("tail.elements must be a non-negative integer")
+
+    @property
+    def is_present(self) -> bool:
+        return self.elements > 0
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"policy": self.policy.value, "start": self.start, "elements": self.elements}
+
+
+@dataclass(frozen=True)
+class IterationPlan:
+    """Immutable linear iteration domain split into vector blocks and a tail."""
+
+    element_count: int
+    lane_count: int
+    contiguous_axis: Optional[int]
+    tail: TailPlan
+    chunks: Tuple[VectorChunk, ...]
+
+    def __post_init__(self) -> None:
+        _non_negative_int(self.element_count, "iteration.element_count")
+        _positive_int(self.lane_count, "iteration.lane_count")
+        if self.contiguous_axis is not None:
+            _non_negative_int(self.contiguous_axis, "iteration.contiguous_axis")
+        expected = []
+        full = self.element_count // self.lane_count
+        remainder = self.element_count % self.lane_count
+        for index in range(full):
+            expected.append(VectorChunk(index * self.lane_count, self.lane_count, False))
+        if remainder:
+            expected.append(VectorChunk(full * self.lane_count, remainder, True))
+        if tuple(expected) != tuple(self.chunks):
+            raise CpuVectorValidationError("iteration chunks do not cover the declared domain")
+        expected_tail_start = full * self.lane_count
+        if self.tail.start != expected_tail_start or self.tail.elements != remainder:
+            raise CpuVectorValidationError("iteration tail does not match the declared domain")
+
+    @property
+    def vector_blocks(self) -> Tuple[VectorChunk, ...]:
+        return tuple(chunk for chunk in self.chunks if not chunk.is_tail)
+
+    @property
+    def full_chunks(self) -> int:
+        return len(self.vector_blocks)
+
+    @property
+    def tail_elements(self) -> int:
+        return self.tail.elements
+
+    @property
+    def vector_width(self) -> int:
+        """Number of elements in a logical vector block, not a register width."""
+
+        return self.lane_count
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "element_count": self.element_count,
+            "lane_count": self.lane_count,
+            "contiguous_axis": self.contiguous_axis,
+            "full_chunks": self.full_chunks,
+            "tail": self.tail.to_dict(),
+            "chunks": [chunk.to_dict() for chunk in self.chunks],
+        }
+
+    def canonical_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+    dumps = canonical_json
+    to_json = canonical_json
+
+
+VectorIterationPlan = IterationPlan
+
+
+def make_iteration_plan(
+    element_count: int,
+    lane_count: int,
+    contiguous_axis: Optional[int] = None,
+    tail_policy: Any = TailPolicy.SCALAR_CLEANUP,
+) -> IterationPlan:
+    """Create a bounded chunk plan for ``[0, element_count)``."""
+
+    count = _non_negative_int(element_count, "element_count")
+    lanes = _positive_int(lane_count, "lane_count")
+    policy = _tail_policy(tail_policy)
+    full, remainder = divmod(count, lanes)
+    chunks = [VectorChunk(index * lanes, lanes, False) for index in range(full)]
+    if remainder:
+        chunks.append(VectorChunk(full * lanes, remainder, True))
+    return IterationPlan(
+        element_count=count,
+        lane_count=lanes,
+        contiguous_axis=contiguous_axis,
+        tail=TailPlan(policy, full * lanes, remainder),
+        chunks=tuple(chunks),
+    )
+
+
+@dataclass(frozen=True)
+class ReductionPlan:
+    """Reduction iteration description independent of an instruction set."""
+
+    input_shape: Tuple[int, ...]
+    output_shape: Tuple[int, ...]
+    axes: Tuple[int, ...]
+    keepdims: bool
+    reduction_size: int
+    output_elements: int
+    output_iteration: IterationPlan
+    reduction_iteration: IterationPlan
+
+    def __post_init__(self) -> None:
+        if any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in self.input_shape):
+            raise CpuVectorValidationError("reduction input_shape must contain non-negative integers")
+        if any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in self.output_shape):
+            raise CpuVectorValidationError("reduction output_shape must contain non-negative integers")
+        rank = len(self.input_shape)
+        if tuple(sorted(self.axes)) != self.axes or len(set(self.axes)) != len(self.axes):
+            raise CpuVectorValidationError("reduction axes must be sorted and unique")
+        if any(axis < 0 or axis >= rank for axis in self.axes):
+            raise CpuVectorValidationError("reduction axis is outside input rank")
+        if not isinstance(self.keepdims, bool):
+            raise CpuVectorValidationError("reduction keepdims must be bool")
+        if self.reduction_size != _product(tuple(self.input_shape[axis] for axis in self.axes)):
+            raise CpuVectorValidationError("reduction_size does not match input_shape and axes")
+        if self.output_elements != _product(self.output_shape):
+            raise CpuVectorValidationError("output_elements does not match output_shape")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "input_shape": list(self.input_shape),
+            "output_shape": list(self.output_shape),
+            "axes": list(self.axes),
+            "keepdims": self.keepdims,
+            "reduction_size": self.reduction_size,
+            "output_elements": self.output_elements,
+            "output_iteration": self.output_iteration.to_dict(),
+            "reduction_iteration": self.reduction_iteration.to_dict(),
+        }
+
+
+@dataclass(frozen=True)
+class MatmulPlan:
+    """Rectangular ``(m,k) x (k,n)`` iteration description."""
+
+    m: int
+    k: int
+    n: int
+    output_shape: Tuple[int, int]
+    output_elements: int
+    output_iteration: IterationPlan
+    reduction_iteration: IterationPlan
+
+    def __post_init__(self) -> None:
+        _non_negative_int(self.m, "matmul.m")
+        _non_negative_int(self.k, "matmul.k")
+        _non_negative_int(self.n, "matmul.n")
+        if self.output_shape != (self.m, self.n):
+            raise CpuVectorValidationError("matmul output_shape must be (m, n)")
+        if self.output_elements != self.m * self.n:
+            raise CpuVectorValidationError("matmul output_elements does not match m*n")
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "m": self.m,
+            "k": self.k,
+            "n": self.n,
+            "output_shape": list(self.output_shape),
+            "output_elements": self.output_elements,
+            "output_iteration": self.output_iteration.to_dict(),
+            "reduction_iteration": self.reduction_iteration.to_dict(),
+        }
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _normalise_axes(attributes: Mapping[str, Any], rank: int, context: str) -> Tuple[int, ...]:
+    raw = attributes.get("axes", attributes.get("axis"))
+    if raw is None:
+        axes = tuple(range(rank))
+    elif isinstance(raw, int) and not isinstance(raw, bool):
+        axes = (raw,)
+    else:
+        if isinstance(raw, (str, bytes)):
+            raise CpuVectorValidationError("{} axes must be an integer or sequence".format(context))
+        try:
+            axes = tuple(raw)
+        except TypeError as exc:
+            raise CpuVectorValidationError("{} axes must be an integer or sequence".format(context)) from exc
+    result = []
+    for axis in axes:
+        if isinstance(axis, bool) or not isinstance(axis, int):
+            raise CpuVectorValidationError("{} axes must contain integers".format(context))
+        axis = axis + rank if axis < 0 else axis
+        if axis < 0 or axis >= rank:
+            raise CpuVectorValidationError("{} axis is outside rank".format(context))
+        if axis in result:
+            raise CpuVectorValidationError("{} axes contain a duplicate".format(context))
+        result.append(axis)
+    return tuple(sorted(result))
+
+
+def _layout_value(value: Any, context: str) -> Tuple[str, Optional[Tuple[int, ...]], Optional[int]]:
+    """Normalize a layout descriptor into kind, strides, and contiguous axis."""
+
+    if value is None:
+        return "row_major_contiguous", None, None
+    if isinstance(value, str):
+        key = value.strip().lower().replace("-", "_")
+        if key in ("contiguous", "row_major", "row_major_contiguous", "c"):
+            return "row_major_contiguous", None, None
+        raise CpuVectorUnsupportedError("{} layout {!r} is non-contiguous or unknown".format(context, value))
+    if not isinstance(value, Mapping):
+        raise CpuVectorValidationError("{} layout must be a string or mapping".format(context))
+    kind = value.get("kind", value.get("layout", "row_major_contiguous"))
+    if not isinstance(kind, str):
+        raise CpuVectorValidationError("{} layout kind must be a string".format(context))
+    kind = kind.strip().lower().replace("-", "_")
+    if kind not in ("contiguous", "row_major", "row_major_contiguous", "c"):
+        raise CpuVectorUnsupportedError("{} layout {!r} is non-contiguous or unknown".format(context, kind))
+    strides = value.get("strides")
+    if strides is not None:
+        if isinstance(strides, (str, bytes)):
+            raise CpuVectorValidationError("{} layout strides must be integer sequence".format(context))
+        try:
+            strides = tuple(strides)
+        except TypeError as exc:
+            raise CpuVectorValidationError("{} layout strides must be integer sequence".format(context)) from exc
+        for item in strides:
+            if isinstance(item, bool) or not isinstance(item, int) or item < 0:
+                raise CpuVectorValidationError("{} layout strides must be non-negative integers".format(context))
+    contiguous_axis = value.get("contiguous_axis")
+    if contiguous_axis is not None and (isinstance(contiguous_axis, bool) or not isinstance(contiguous_axis, int)):
+        raise CpuVectorValidationError("{} contiguous_axis must be an integer".format(context))
+    return kind if kind != "c" else "row_major_contiguous", strides, contiguous_axis
+
+
+def _check_layout(
+    program: CoreProgram,
+    operation: Operation,
+    refs: Sequence[Any],
+    context: str,
+) -> Tuple[str, Optional[int]]:
+    """Reject views/strides that the first vector planner cannot prove safe."""
+
+    operation_layout = operation.attributes.get("layout")
+    operation_strides = operation.attributes.get("strides")
+    operation_axis = operation.attributes.get("contiguous_axis")
+    if operation_strides is not None:
+        if isinstance(operation_layout, Mapping):
+            operation_layout = dict(operation_layout)
+            operation_layout["strides"] = operation_strides
+        else:
+            operation_layout = {"kind": operation_layout or "row_major_contiguous", "strides": operation_strides}
+    if operation_axis is not None:
+        if isinstance(operation_layout, Mapping):
+            operation_layout = dict(operation_layout)
+            operation_layout["contiguous_axis"] = operation_axis
+        else:
+            operation_layout = {
+                "kind": operation_layout or "row_major_contiguous",
+                "contiguous_axis": operation_axis,
+            }
+    if operation.attributes.get("contiguous") is False or operation.attributes.get("is_contiguous") is False:
+        raise CpuVectorUnsupportedError("{} declares a non-contiguous layout".format(context))
+    layouts = program.metadata.get("layouts", {})
+    if layouts is not None and not isinstance(layouts, Mapping):
+        raise CpuVectorValidationError("program metadata 'layouts' must be a mapping")
+    selected_kind = "row_major_contiguous"
+    selected_axis = None
+    for ref in refs:
+        if not _is_tensor(ref.type):
+            continue
+        if ref.type.kind == "view":
+            raise CpuVectorUnsupportedError("{} value {!r} is a view; non-contiguous views are unsupported".format(context, ref.name))
+        raw = operation_layout
+        if isinstance(layouts, Mapping) and ref.name in layouts:
+            raw = layouts[ref.name]
+        if isinstance(raw, Mapping) and (
+            raw.get("contiguous") is False or raw.get("is_contiguous") is False
+        ):
+            raise CpuVectorUnsupportedError("{} value {!r} declares a non-contiguous layout".format(context, ref.name))
+        kind, strides, axis = _layout_value(raw, "{} value {!r}".format(context, ref.name))
+        shape = static_shape(ref.type, "{} value {!r}".format(context, ref.name))
+        expected = _contiguous_strides(shape)
+        if strides is not None and tuple(strides) != expected:
+            raise CpuVectorUnsupportedError("{} value {!r} has non-contiguous strides".format(context, ref.name))
+        expected_axis = len(shape) - 1 if shape else None
+        if axis is not None:
+            normalized_axis = axis + len(shape) if axis < 0 else axis
+            if normalized_axis != expected_axis:
+                raise CpuVectorUnsupportedError("{} value {!r} contiguous axis is not the innermost axis".format(context, ref.name))
+            axis = normalized_axis
+        else:
+            axis = expected_axis
+        if selected_axis is None:
+            selected_axis = axis
+        elif selected_axis != axis and selected_axis is not None and axis is not None:
+            raise CpuVectorUnsupportedError("{} operands do not share a contiguous axis".format(context))
+        selected_kind = kind
+    return selected_kind, selected_axis
+
+
+def _target_lane_count(target: TargetSpec, requested: Optional[int]) -> int:
+    if requested is not None:
+        return _positive_int(requested, "lane_count")
+    attributes = target.attributes
+    for key in ("lane_count", "vector_lanes", "vector_lane_count", "vector_block_elements", "vector_width"):
+        if key in attributes:
+            return _positive_int(attributes[key], "target.attributes[{}]".format(key))
+    return DEFAULT_LANE_COUNT
+
+
+def _target_required_features(target: TargetSpec, required: Any) -> CpuFeatureSet:
+    if required is not None:
+        return required if isinstance(required, CpuFeatureSet) else CpuFeatureSet(required, source="compiler")
+    attributes = target.attributes
+    if "required_features" in attributes:
+        return CpuFeatureSet(attributes["required_features"], source="target")
+    return CpuFeatureSet(target.features, source="target")
+
+
+def _target_specialization(target: TargetSpec, specialization: Optional[Mapping[str, Any]]) -> Mapping[str, Any]:
+    value = specialization if specialization is not None else target.attributes.get("specialization", {})
+    if not isinstance(value, Mapping):
+        raise CpuVectorValidationError("specialization must be a mapping")
+    return frozen_mapping(value)
+
+
+@dataclass(frozen=True, init=False)
+class VectorPlan:
+    """Target-owned plan for one Core IR operation."""
+
+    plan_version: int
+    operation: str
+    plan_kind: str
+    operation_index: int
+    input_names: Tuple[str, ...]
+    output_name: str
+    dtype: str
+    shape: Tuple[int, ...]
+    layout: str
+    contiguous_axis: Optional[int]
+    element_count: int
+    lane_count: int
+    iteration: IterationPlan
+    required_features: CpuFeatureSet
+    specialization: Mapping[str, Any]
+    reduction: Optional[ReductionPlan]
+    matmul: Optional[MatmulPlan]
+
+    def __init__(
+        self,
+        plan_version: int,
+        operation: str,
+        plan_kind: str,
+        operation_index: int,
+        input_names: Sequence[str],
+        output_name: str,
+        dtype: str,
+        shape: Sequence[int],
+        layout: str,
+        contiguous_axis: Optional[int],
+        element_count: int,
+        lane_count: int,
+        iteration: IterationPlan,
+        required_features: CpuFeatureSet,
+        specialization: Optional[Mapping[str, Any]] = None,
+        reduction: Optional[ReductionPlan] = None,
+        matmul: Optional[MatmulPlan] = None,
+    ) -> None:
+        if plan_version != VECTOR_PLAN_VERSION:
+            raise CpuVectorValidationError("unsupported vector plan version {!r}".format(plan_version))
+        if not isinstance(operation, str) or not operation.strip():
+            raise CpuVectorValidationError("plan operation must be a non-empty string")
+        if plan_kind not in ("elementwise", "reduction", "matmul"):
+            raise CpuVectorValidationError("unknown vector plan kind {!r}".format(plan_kind))
+        if isinstance(operation_index, bool) or not isinstance(operation_index, int) or operation_index < 0:
+            raise CpuVectorValidationError("operation_index must be a non-negative integer")
+        if not isinstance(output_name, str) or not output_name:
+            raise CpuVectorValidationError("output_name must be non-empty")
+        normalized_dtype = canonical_dtype(dtype)
+        normalized_shape = tuple(shape)
+        count = _non_negative_int(element_count, "plan.element_count")
+        lanes = _positive_int(lane_count, "plan.lane_count")
+        if count != _product(normalized_shape):
+            raise CpuVectorValidationError("plan.element_count does not match shape")
+        if iteration.element_count != count or iteration.lane_count != lanes:
+            raise CpuVectorValidationError("plan iteration does not match element_count/lane_count")
+        if not isinstance(required_features, CpuFeatureSet):
+            raise CpuVectorValidationError("required_features must be CpuFeatureSet")
+        object.__setattr__(self, "plan_version", plan_version)
+        object.__setattr__(self, "operation", operation.strip())
+        object.__setattr__(self, "plan_kind", plan_kind)
+        object.__setattr__(self, "operation_index", operation_index)
+        object.__setattr__(self, "input_names", tuple(input_names))
+        object.__setattr__(self, "output_name", output_name)
+        object.__setattr__(self, "dtype", normalized_dtype)
+        object.__setattr__(self, "shape", normalized_shape)
+        object.__setattr__(self, "layout", layout)
+        object.__setattr__(self, "contiguous_axis", contiguous_axis)
+        object.__setattr__(self, "element_count", count)
+        object.__setattr__(self, "lane_count", lanes)
+        object.__setattr__(self, "iteration", iteration)
+        object.__setattr__(self, "required_features", required_features)
+        object.__setattr__(self, "specialization", frozen_mapping(specialization))
+        object.__setattr__(self, "reduction", reduction)
+        object.__setattr__(self, "matmul", matmul)
+        if plan_kind == "reduction" and reduction is None:
+            raise CpuVectorValidationError("reduction plan kind requires reduction details")
+        if plan_kind == "matmul" and matmul is None:
+            raise CpuVectorValidationError("matmul plan kind requires matmul details")
+        if plan_kind == "elementwise" and (reduction is not None or matmul is not None):
+            raise CpuVectorValidationError("elementwise plan cannot carry reduction/matmul details")
+
+    @property
+    def vector_blocks(self) -> Tuple[VectorChunk, ...]:
+        return self.iteration.vector_blocks
+
+    @property
+    def chunks(self) -> Tuple[VectorChunk, ...]:
+        """All bounded blocks, including the optional tail."""
+
+        return self.iteration.chunks
+
+    @property
+    def full_chunks(self) -> int:
+        return self.iteration.full_chunks
+
+    @property
+    def tail(self) -> TailPlan:
+        return self.iteration.tail
+
+    @property
+    def tail_elements(self) -> int:
+        return self.iteration.tail_elements
+
+    @property
+    def iteration_domain(self) -> IterationPlan:
+        return self.iteration
+
+    @property
+    def vector_block_elements(self) -> int:
+        return self.lane_count
+
+    @property
+    def tail_policy(self) -> TailPolicy:
+        return self.tail.policy
+
+    @property
+    def kind(self) -> str:
+        return self.plan_kind
+
+    @property
+    def output_shape(self) -> Tuple[int, ...]:
+        return self.shape
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "plan_version": self.plan_version,
+            "operation": self.operation,
+            "plan_kind": self.plan_kind,
+            "operation_index": self.operation_index,
+            "input_names": list(self.input_names),
+            "output_name": self.output_name,
+            "dtype": self.dtype,
+            "shape": list(self.shape),
+            "layout": self.layout,
+            "contiguous_axis": self.contiguous_axis,
+            "element_count": self.element_count,
+            "lane_count": self.lane_count,
+            "iteration": self.iteration.to_dict(),
+            "tail_policy": self.tail.policy.value,
+            "required_features": self.required_features.to_dict(),
+            "specialization": mapping_copy(self.specialization),
+            "reduction": None if self.reduction is None else self.reduction.to_dict(),
+            "matmul": None if self.matmul is None else self.matmul.to_dict(),
+        }
+
+    def canonical_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+    dumps = canonical_json
+    to_json = canonical_json
+
+    @property
+    def fingerprint(self) -> str:
+        return sha256_text(self.to_dict())
+
+
+CpuVectorPlan = VectorPlan
