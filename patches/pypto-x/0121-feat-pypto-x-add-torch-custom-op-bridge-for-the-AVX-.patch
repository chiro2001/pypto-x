index 000000000..9f6fa0bda
--- /dev/null
+++ b/python/tests/framework_torch/conftest.py
@@ -0,0 +1,54 @@
+"""Shared setup for the torch-dependent J1 bridge tests.
+
+The main PyPTO-X suite is torch-free: it imports ``pypto`` through a stub
+package so the upstream ``pypto/__init__.py`` online-build bootstrap (which
+needs wheel metadata) is not executed.  This suite uses the same seam and is
+run with the dedicated ``pypto-x-w8j`` conda environment; it is intentionally
+outside ``python/tests/ut`` so the system-python suite keeps its exact
+collection baseline.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+PYTHON_ROOT = Path(__file__).resolve().parents[2]
+if "pypto" not in sys.modules:
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(PYTHON_ROOT / "pypto")]
+    sys.modules["pypto"] = package
+
+import torch  # noqa: E402  (must come after the stub package is installed)
+
+import pypto.framework as framework  # noqa: E402
+from pypto.framework import torch_ops  # noqa: E402
+from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache  # noqa: E402
+
+framework.register_torch_ops()
+
+
+@pytest.fixture()
+def fresh_caches(tmp_path, monkeypatch):
+    """Isolate kernel cache, weight-pack cache and fallback counters."""
+
+    monkeypatch.setenv("PYPTO_X_TORCH_FALLBACK_WARNINGS", "1")
+    cache_dir = tmp_path / "kernel-cache"
+    cache = LinearKernelCache(cache_dir=cache_dir, disk_cache=True)
+    reset_linear_kernel_cache(cache)
+    torch_ops.reset_weight_pack_cache()
+    torch_ops.reset_fallback_stats()
+    yield cache
+    # Leave a fresh, isolated cache behind so a later test never inherits
+    # kernels or counters from this one.
+    reset_linear_kernel_cache(LinearKernelCache(cache_dir=cache_dir, disk_cache=True))
+    torch_ops.reset_weight_pack_cache()
+    torch_ops.reset_fallback_stats()
+
+
+@pytest.fixture()
+def device():
+    return torch.device("cpu")
diff --git a/python/tests/framework_torch/test_torch_linear_cache.py b/python/tests/framework_torch/test_torch_linear_cache.py
