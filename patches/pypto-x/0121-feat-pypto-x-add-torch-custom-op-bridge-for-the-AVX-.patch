index 000000000..03f038727
--- /dev/null
+++ b/python/pypto/framework/weight_pack.py
@@ -0,0 +1,164 @@
+"""Weight pre-packing for the single-kernel PyPTO-X linear bridge.
+
+The AVX-512 matmul kernel consumes the right operand as a rank-2 ``(K, N)``
+row-major buffer.  ``torch.nn.functional.linear`` stores the weight as
+``(N, K)``, so a static weight needs a one-time transpose (and, for the BF16
+kernel, a one-time BF16 bit copy) instead of doing it inside the per-call hot
+path.  The packed buffer is self-describing: a fixed 32-byte little-endian
+header carries magic/version/dtype/K/N, followed by the payload, so a packed
+handle can be cached on a framework layer and validated on every use.
+
+Layout (all little-endian)::
+
+    offset  size  field
+    0       4     magic  b"PXLP"
+    4       2     pack_version (u16)
+    6       1     dtype id   (0 = float32, 1 = bf16)
+    7       1     flags      (reserved, must be 0)
+    8       8     reserved   (0)
+    16      8     K (u64)
+    24      8     N (u64)
+    32      ...   payload, C-contiguous (K, N) row-major
+
+The payload is a raw byte copy of the kernel operand: ``uint16`` bits for
+BF16 and ``float32`` for FP32.  Packing copies exactly ``K * N * itemsize``
+bytes; the header is O(1).
+
+Copy accounting: :func:`pack_view` performs exactly one element copy (the
+``(N, K) -> (K, N)`` materialisation).  Returning a torch handle from
+``pack_weight`` serialises that payload into the handle tensor, which is a
+second byte copy at *pack* time only (never in the call hot path).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import struct
+from typing import Any
+
+import numpy as np
+
+
+PACK_MAGIC = b"PXLP"
+PACK_VERSION = 1
+HEADER_SIZE = 32
+_HEADER = struct.Struct("<4sHBB8xQQ")
+_DTYPE_IDS = {"float32": 0, "bf16": 1}
+_ID_DTYPES = {value: key for key, value in _DTYPE_IDS.items()}
+_NUMPY_DTYPES = {"float32": np.float32, "bf16": np.uint16}
+
+
+@dataclass(frozen=True)
+class PackedWeight:
+    """A validated packed weight: header fields plus a C-contiguous payload."""
+
+    dtype: str
+    k: int
+    n: int
+    payload: np.ndarray
+    copies: int = 0
+
+    @property
+    def itemsize(self) -> int:
+        return int(self.payload.dtype.itemsize)
+
+    @property
+    def payload_bytes(self) -> int:
+        return int(self.payload.nbytes)
+
+    @property
+    def address(self) -> int:
+        return int(self.payload.ctypes.data)
+
+    def header_bytes(self) -> bytes:
+        return _HEADER.pack(
+            PACK_MAGIC,
+            PACK_VERSION,
+            _DTYPE_IDS[self.dtype],
+            0,
+            int(self.k),
+            int(self.n),
+        )
+
+    def to_bytes(self) -> bytes:
+        """Return ``header + payload`` as one immutable byte string."""
+
+        return self.header_bytes() + self.payload.tobytes()
+
+
+def pack_view(view: Any, k: int, n: int, dtype: str) -> PackedWeight:
+    """Pack a ``(N, K)`` weight view into the kernel's ``(K, N)`` layout.
+
+    ``view`` must be a C-contiguous numpy array of ``uint16`` (BF16) or
+    ``float32`` (FP32).  Exactly one element copy is performed; the returned
+    object owns the payload.
+    """
+
+    if dtype not in _DTYPE_IDS:
+        raise ValueError("unsupported packed weight dtype {!r}".format(dtype))
+    array = np.asarray(view)
+    expected = _NUMPY_DTYPES[dtype]
+    if array.dtype != expected:
+        raise ValueError(
+            "packed weight view dtype {} does not match {}".format(array.dtype, dtype)
+        )
+    if array.ndim != 2 or array.shape != (n, k):
+        raise ValueError(
+            "packed weight view shape {} does not match (N, K) = ({}, {})".format(
+                array.shape, n, k
+            )
+        )
+    if not array.flags["C_CONTIGUOUS"]:
+        raise ValueError("packed weight view must be C-contiguous")
+    payload = np.ascontiguousarray(array.T)
+    return PackedWeight(dtype=dtype, k=int(k), n=int(n), payload=payload, copies=1)
+
+
+def parse_packed_bytes(buffer: Any) -> PackedWeight:
+    """Parse ``header + payload`` bytes into a zero-copy :class:`PackedWeight`."""
+
+    raw = memoryview(buffer)
+    if raw.ndim != 1 or raw.itemsize != 1:
+        raise ValueError("packed weight buffer must be a flat byte buffer")
+    if raw.nbytes < HEADER_SIZE:
+        raise ValueError("packed weight buffer is shorter than the header")
+    magic, version, dtype_id, flags, k, n = _HEADER.unpack_from(raw, 0)
+    if magic != PACK_MAGIC:
+        raise ValueError("packed weight magic does not match")
+    if version != PACK_VERSION:
+        raise ValueError("unsupported packed weight version {}".format(version))
+    if flags != 0:
+        raise ValueError("packed weight flags must be zero")
+    try:
+        dtype = _ID_DTYPES[int(dtype_id)]
+    except KeyError as exc:
+        raise ValueError("unsupported packed weight dtype id {}".format(dtype_id)) from exc
+    if k <= 0 or n <= 0:
+        raise ValueError("packed weight K and N must be positive")
+    itemsize = np.dtype(_NUMPY_DTYPES[dtype]).itemsize
+    expected = HEADER_SIZE + int(k) * int(n) * itemsize
+    if raw.nbytes != expected:
+        raise ValueError(
+            "packed weight size {} does not match expected {}".format(raw.nbytes, expected)
+        )
+    payload = np.frombuffer(raw, dtype=_NUMPY_DTYPES[dtype], count=int(k) * int(n), offset=HEADER_SIZE)
+    payload = payload.reshape(int(k), int(n))
+    return PackedWeight(dtype=dtype, k=int(k), n=int(n), payload=payload, copies=0)
+
+
+def packed_size_bytes(k: int, n: int, dtype: str) -> int:
+    """Return the exact packed byte size for ``header + (K, N)`` payload."""
+
+    itemsize = np.dtype(_NUMPY_DTYPES[dtype]).itemsize
+    return HEADER_SIZE + int(k) * int(n) * itemsize
+
+
+__all__ = [
+    "HEADER_SIZE",
+    "PACK_MAGIC",
+    "PACK_VERSION",
+    "PackedWeight",
+    "pack_view",
+    "packed_size_bytes",
+    "parse_packed_bytes",
+]
