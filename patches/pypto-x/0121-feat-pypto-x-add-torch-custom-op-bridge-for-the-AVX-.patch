index 000000000..43d9a1696
--- /dev/null
+++ b/python/pypto/framework/torch_bridge.py
@@ -0,0 +1,389 @@
+"""Torch tensor <-> PyPTO-X CPU runtime buffer bridge.
+
+Copy and ownership rules (J1 acceptance requires these to be explicit):
+
+* A C-contiguous CPU tensor of the expected dtype is exposed to the runtime
+  through a numpy view of the *same* storage: 0 copies.  ``tensor.numpy()``
+  (FP32) and ``tensor.view(torch.uint16).numpy()`` (BF16 bits) share memory,
+  and the numpy array keeps the torch tensor alive through its base object, so
+  the runtime may only read the buffer while the descriptor/view is alive.
+* A non-contiguous tensor is materialised once with ``tensor.contiguous()``:
+  exactly 1 copy (``BufferView.copies == 1``); the copy is owned by the bridge
+  and released when the view is released.
+* Outputs are freshly allocated by ``allocate_output``: 1 allocation, 0 input
+  copies.  The returned torch tensor owns the memory.
+* ``packed_tensor_to_view`` parses a packed handle produced by
+  ``pack_weight``; the payload is a zero-copy numpy view of the handle's bytes
+  (the handle tensor must stay alive while the view is used).
+* No implicit dtype casts and no implicit device transfers happen here.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Optional, Tuple
+
+import numpy as np
+import torch
+
+from pypto.abi import TensorDesc
+
+from .errors import PyPTOXBridgeError, PyPTOXUnsupportedError
+from .weight_pack import HEADER_SIZE, PACK_MAGIC, PackedWeight, parse_packed_bytes
+
+
+TORCH_DTYPES = {torch.float32: "float32", torch.bfloat16: "bf16"}
+_DTYPE_TORCH = {value: key for key, value in TORCH_DTYPES.items()}
+
+
+@dataclass
+class BufferPointer:
+    """A validated raw pointer into torch CPU storage.
+
+    The hot path only needs the address; ``tensor`` keeps the storage (or the
+    bridge-owned contiguous copy) alive for the duration of the native call.
+    ``copies`` follows the same accounting as :class:`BufferView`.
+    """
+
+    tensor: torch.Tensor
+    address: int
+    dtype: str
+    shape: Tuple[int, ...]
+    copies: int
+    owns_buffer: bool
+    writable: bool
+
+
+@dataclass
+class BufferView:
+    """A validated tensor view handed to the PyPTO-X runtime.
+
+    ``tensor`` keeps the storage alive, ``array`` is the 0-copy numpy view used
+    as the runtime descriptor handle, and ``copies`` documents how many element
+    copies the bridge had to make (0 for a contiguous input).
+    """
+
+    tensor: torch.Tensor
+    array: np.ndarray
+    dtype: str
+    shape: Tuple[int, ...]
+    copies: int
+    owns_buffer: bool
+    writable: bool
+
+    @property
+    def address(self) -> int:
+        return int(self.array.ctypes.data)
+
+    @property
+    def nbytes(self) -> int:
+        return int(self.array.nbytes)
+
+    @property
+    def itemsize(self) -> int:
+        return int(self.array.dtype.itemsize)
+
+    def descriptor(self) -> TensorDesc:
+        return TensorDesc(
+            self.dtype,
+            self.shape,
+            device="cpu",
+            handle=self.array,
+            readonly=not self.writable,
+        )
+
+
+def dtype_name(tensor: torch.Tensor, *, name: str = "tensor") -> str:
+    """Return the bridge dtype for a torch tensor or raise ``Unsupported``."""
+
+    if not torch.is_tensor(tensor):
+        raise PyPTOXUnsupportedError(
+            "{} must be a torch.Tensor, got {}".format(name, type(tensor).__name__),
+            reason_code="not_a_tensor",
+            details={"name": name, "type": type(tensor).__name__},
+        )
+    try:
+        return TORCH_DTYPES[tensor.dtype]
+    except KeyError as exc:
+        raise PyPTOXUnsupportedError(
+            "{} has unsupported dtype {}".format(name, tensor.dtype),
+            reason_code="dtype_unsupported",
+            details={"name": name, "dtype": str(tensor.dtype)},
+        ) from exc
+
+
+def _check_device(tensor: torch.Tensor, name: str) -> None:
+    if tensor.device.type != "cpu":
+        raise PyPTOXUnsupportedError(
+            "{} must be a CPU tensor, got device {!r}".format(name, str(tensor.device)),
+            reason_code="device_unsupported",
+            details={"name": name, "device": str(tensor.device)},
+        )
+
+
+def _validated_tensor(
+    tensor: torch.Tensor,
+    *,
+    dtype: Optional[str],
+    shape: Optional[Tuple[int, ...]],
+    name: str,
+    allow_copy: bool,
+    writable: bool,
+) -> Tuple[torch.Tensor, str, int]:
+    """Shared bridge validation; returns (source, dtype, copies)."""
+
+    _check_device(tensor, name)
+    actual_dtype = dtype_name(tensor, name=name)
+    if dtype is not None and actual_dtype != dtype:
+        raise PyPTOXUnsupportedError(
+            "{} dtype {} does not match expected {}".format(name, tensor.dtype, dtype),
+            reason_code="dtype_mismatch",
+            details={"name": name, "dtype": str(tensor.dtype), "expected": dtype},
+        )
+    if shape is not None and tuple(tensor.shape) != tuple(shape):
+        raise PyPTOXUnsupportedError(
+            "{} shape {} does not match expected {}".format(name, tuple(tensor.shape), tuple(shape)),
+            reason_code="shape_mismatch",
+            details={"name": name, "shape": list(tensor.shape), "expected": list(shape)},
+        )
+    if tensor.requires_grad:
+        raise PyPTOXUnsupportedError(
+            "{} requires grad; the single-kernel bridge does not define backward".format(name),
+            reason_code="requires_grad",
+            details={"name": name},
+        )
+    copies = 0
+    source = tensor
+    if not source.is_contiguous():
+        if not allow_copy:
+            raise PyPTOXUnsupportedError(
+                "{} is not C-contiguous".format(name),
+                reason_code="non_contiguous",
+                details={"name": name, "strides": list(source.stride())},
+            )
+        source = source.contiguous()
+        copies = 1
+    if writable and not source.is_contiguous():
+        raise PyPTOXBridgeError(
+            "{} is not writable".format(name), reason_code="buffer_not_writable"
+        )
+    return source, actual_dtype, copies
+
+
+def tensor_to_pointer(
+    tensor: torch.Tensor,
+    *,
+    dtype: Optional[str] = None,
+    shape: Optional[Tuple[int, ...]] = None,
+    name: str = "tensor",
+    allow_copy: bool = True,
+    writable: bool = False,
+) -> BufferPointer:
+    """Validate a CPU tensor and return its address without a numpy view.
+
+    This is the hot-path conversion: 0 copies for a contiguous tensor and one
+    ``contiguous()`` copy otherwise.  ``tensor_to_view`` remains the general
+    descriptor-producing bridge.
+    """
+
+    source, actual_dtype, copies = _validated_tensor(
+        tensor,
+        dtype=dtype,
+        shape=shape,
+        name=name,
+        allow_copy=allow_copy,
+        writable=writable,
+    )
+    return BufferPointer(
+        tensor=source,
+        address=int(source.data_ptr()),
+        dtype=actual_dtype if dtype is None else dtype,
+        shape=tuple(source.shape),
+        copies=copies,
+        owns_buffer=copies > 0,
+        writable=bool(writable),
+    )
+
+
+def tensor_to_view(
+    tensor: torch.Tensor,
+    *,
+    dtype: Optional[str] = None,
+    shape: Optional[Tuple[int, ...]] = None,
+    name: str = "tensor",
+    allow_copy: bool = True,
+    writable: bool = False,
+) -> BufferView:
+    """Expose a torch CPU tensor as a runtime buffer with explicit copies."""
+
+    source, actual_dtype, copies = _validated_tensor(
+        tensor,
+        dtype=dtype,
+        shape=shape,
+        name=name,
+        allow_copy=allow_copy,
+        writable=writable,
+    )
+    detached = source.detach()
+    if dtype is None:
+        dtype = actual_dtype
+    try:
+        if dtype == "bf16":
+            array = detached.view(torch.uint16).numpy()
+        else:
+            array = detached.numpy()
+    except (RuntimeError, TypeError, ValueError) as exc:
+        raise PyPTOXUnsupportedError(
+            "{} cannot expose a numpy view: {}".format(name, exc),
+            reason_code="buffer_export_failed",
+            details={"name": name, "dtype": str(tensor.dtype)},
+        ) from exc
+    if not array.flags["C_CONTIGUOUS"]:
+        raise PyPTOXBridgeError(
+            "{} numpy view is not C-contiguous after materialisation".format(name),
+            reason_code="buffer_not_contiguous",
+        )
+    if writable and not array.flags["WRITEABLE"]:
+        raise PyPTOXBridgeError(
+            "{} is not writable but the runtime output requires a writable buffer".format(name),
+            reason_code="buffer_not_writable",
+        )
+    return BufferView(
+        tensor=tensor,
+        array=array,
+        dtype=dtype,
+        shape=tuple(source.shape),
+        copies=copies,
+        owns_buffer=copies > 0,
+        writable=bool(writable),
+    )
+
+
+def allocate_output_address(dtype: str, shape: Tuple[int, ...]) -> Tuple[torch.Tensor, BufferPointer]:
+    """Allocate a fresh output tensor and return it with its raw address."""
+
+    try:
+        torch_dtype = _DTYPE_TORCH[dtype]
+    except KeyError as exc:
+        raise PyPTOXUnsupportedError(
+            "unsupported output dtype {!r}".format(dtype),
+            reason_code="dtype_unsupported",
+            details={"dtype": str(dtype)},
+        ) from exc
+    tensor = torch.empty(tuple(shape), dtype=torch_dtype)
+    return tensor, BufferPointer(
+        tensor=tensor,
+        address=int(tensor.data_ptr()),
+        dtype=dtype,
+        shape=tuple(shape),
+        copies=0,
+        owns_buffer=True,
+        writable=True,
+    )
+
+
+def allocate_output(dtype: str, shape: Tuple[int, ...]) -> Tuple[torch.Tensor, BufferView]:
+    """Allocate a fresh output tensor and return it with its runtime view."""
+
+    tensor, pointer = allocate_output_address(dtype, shape)
+    if dtype == "bf16":
+        array = tensor.view(torch.uint16).numpy()
+    else:
+        array = tensor.numpy()
+    return tensor, BufferView(
+        tensor=tensor,
+        array=array,
+        dtype=dtype,
+        shape=tuple(shape),
+        copies=0,
+        owns_buffer=True,
+        writable=True,
+    )
+
+
+def is_packed_like(tensor: Any) -> bool:
+    """Return whether ``tensor`` has the opaque packed-handle shape (1-D uint8).
+
+    Any such tensor is routed to the packed path and fails closed when its
+    header is invalid; it can never be a meaningful ``F.linear`` weight.
+    """
+
+    return bool(
+        torch.is_tensor(tensor) and tensor.dtype == torch.uint8 and tensor.dim() == 1
+    )
+
+
+def is_packed_handle(tensor: torch.Tensor) -> bool:
+    """Return whether ``tensor`` is a *valid* packed-weight handle produced by us."""
+
+    if not is_packed_like(tensor):
+        return False
+    if tensor.device.type != "cpu" or tensor.numel() < HEADER_SIZE:
+        return False
+    try:
+        head = tensor[:4].numpy().tobytes()
+    except (RuntimeError, TypeError, ValueError):
+        return False
+    return head == PACK_MAGIC
+
+
+def packed_tensor_to_view(tensor: torch.Tensor) -> PackedWeight:
+    """Parse a packed handle tensor into a zero-copy :class:`PackedWeight`."""
+
+    _check_device(tensor, "packed weight")
+    if tensor.dtype != torch.uint8 or tensor.dim() != 1:
+        raise PyPTOXUnsupportedError(
+            "packed weight must be a 1-D uint8 tensor, got {} / rank {}".format(
+                tensor.dtype, tensor.dim()
+            ),
+            reason_code="packed_handle_invalid",
+        )
+    if not tensor.is_contiguous():
+        raise PyPTOXUnsupportedError(
+            "packed weight handle must be C-contiguous",
+            reason_code="packed_handle_invalid",
+        )
+    array = tensor.detach().numpy()
+    try:
+        return parse_packed_bytes(array)
+    except ValueError as exc:
+        raise PyPTOXUnsupportedError(
+            "invalid packed weight handle: {}".format(exc),
+            reason_code="packed_handle_invalid",
+            details={"reason": str(exc), "bytes": int(array.nbytes)},
+        ) from exc
+
+
+def bytes_to_tensor(payload: bytes) -> torch.Tensor:
+    """Wrap ``header + payload`` bytes into a 1-D uint8 torch tensor (1 copy)."""
+
+    if not isinstance(payload, (bytes, bytearray, memoryview)):
+        raise TypeError("payload must be bytes-like")
+    buffer = bytearray(payload)
+    return torch.frombuffer(buffer, dtype=torch.uint8)
+
+
+def pack_view_to_tensor(view: BufferView, k: int, n: int) -> torch.Tensor:
+    """Pack a ``(N, K)`` weight view and return a uint8 handle tensor."""
+
+    from .weight_pack import pack_view
+
+    packed = pack_view(view.array, k=k, n=n, dtype=view.dtype)
+    return bytes_to_tensor(packed.to_bytes())
+
+
+__all__ = [
+    "BufferPointer",
+    "BufferView",
+    "TORCH_DTYPES",
+    "allocate_output",
+    "allocate_output_address",
+    "bytes_to_tensor",
+    "dtype_name",
+    "is_packed_handle",
+    "is_packed_like",
+    "pack_view_to_tensor",
+    "packed_tensor_to_view",
+    "tensor_to_pointer",
+    "tensor_to_view",
+]
diff --git a/python/pypto/framework/torch_ops.py b/python/pypto/framework/torch_ops.py
new file mode 100644
index 000000000..93c716a39
--- /dev/null
+++ b/python/pypto/framework/torch_ops.py
@@ -0,0 +1,488 @@
+"""``torch.ops.pypto_x`` single-kernel linear bridge (CPU).
+
+Public ops (registered on import, idempotent):
+
+* ``torch.ops.pypto_x.linear(x, weight, bias=None)`` - fail-open: on any
+  unsupported input or unavailable kernel it records a fallback event and
+  returns ``torch.nn.functional.linear`` semantics.  A ``RuntimeWarning`` is
+  emitted once per reason unless ``PYPTO_X_TORCH_FALLBACK_WARNINGS=0``.
+* ``torch.ops.pypto_x.linear_strict(x, weight, bias=None)`` - fail-closed:
+  raises ``PyPTOXUnsupportedError`` / ``PyPTOXBuildError`` unchanged.
+* ``torch.ops.pypto_x.pack_weight(weight)`` - fail-closed one-time BF16/FP32
+  weight pre-pack into a self-describing 1-D uint8 handle.
+* ``torch.ops.pypto_x.linear_prepacked(x, packed, bias=None)`` - fail-closed
+  kernel call with a handle produced by ``pack_weight``.
+
+``linear`` covers exactly rank-2 CPU tensors of dtype BF16/FP32 with matching
+activation/weight/bias dtype; anything else (rank != 2, float64, int32,
+requires_grad, M/K/N <= 0, packed handles on the wrong path) is explicit.
+Fake implementations are registered for ``linear``/``linear_strict``/
+``pack_weight`` so ``meta`` shape inference and ``torch.compile`` tracing see
+correct metadata; packed handles cannot be traced because the K/N values live
+in the handle bytes rather than in tensor metadata.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from typing import Any, Dict, Mapping, Optional, Tuple
+import warnings
+import weakref
+
+import torch
+
+from .errors import PyPTOXBridgeError, PyPTOXUnsupportedError
+from .linear_kernel import linear_kernel_cache
+from .torch_bridge import (
+    TORCH_DTYPES,
+    allocate_output_address,
+    dtype_name,
+    is_packed_like,
+    pack_view_to_tensor,
+    packed_tensor_to_view,
+    tensor_to_pointer,
+    tensor_to_view,
+)
+from .weight_pack import PackedWeight, pack_view, packed_size_bytes
+
+
+# --------------------------------------------------------------------------- #
+# fallback observability
+# --------------------------------------------------------------------------- #
+_FALLBACK_LOCK = threading.Lock()
+_FALLBACK_STATS: Dict[str, int] = {}
+_FALLBACK_WARNED = set()
+
+
+def _warnings_enabled() -> bool:
+    value = os.environ.get("PYPTO_X_TORCH_FALLBACK_WARNINGS", "1").strip().lower()
+    return value not in ("0", "false", "no", "off")
+
+
+def _record_fallback(operation: str, error: Exception) -> None:
+    reason = getattr(error, "reason_code", "unknown")
+    key = "{}:{}".format(operation, reason)
+    with _FALLBACK_LOCK:
+        _FALLBACK_STATS[key] = _FALLBACK_STATS.get(key, 0) + 1
+        first = key not in _FALLBACK_WARNED
+        if first:
+            _FALLBACK_WARNED.add(key)
+    if first and _warnings_enabled():
+        warnings.warn(
+            "pypto_x.{} fell back to the torch reference ({}): {}".format(
+                operation, reason, error
+            ),
+            RuntimeWarning,
+            stacklevel=3,
+        )
+
+
+def fallback_stats() -> Mapping[str, Any]:
+    """Return a snapshot of fail-open fallback events keyed by op:reason."""
+
+    with _FALLBACK_LOCK:
+        events = dict(_FALLBACK_STATS)
+    return {"events": events, "total": sum(events.values())}
+
+
+def reset_fallback_stats() -> None:
+    with _FALLBACK_LOCK:
+        _FALLBACK_STATS.clear()
+        _FALLBACK_WARNED.clear()
+
+
+# --------------------------------------------------------------------------- #
+# weight pack cache (identity + torch version counter)
+# --------------------------------------------------------------------------- #
+def _tensor_version(tensor: torch.Tensor) -> Optional[int]:
+    return getattr(tensor, "_version", None)
+
+
+class _WeightPackEntry:
+    __slots__ = ("ref", "version", "shape", "dtype", "packed")
+
+    def __init__(self, ref, version, shape, dtype, packed):
+        self.ref = ref
+        self.version = version
+        self.shape = shape
+        self.dtype = dtype
+        self.packed = packed
+
+
+class _WeightPackCache:
+    def __init__(self) -> None:
+        self._lock = threading.RLock()
+        self._entries: Dict[int, _WeightPackEntry] = {}
+        self._stats = {"pack_builds": 0, "pack_hits": 0}
+
+    def _drop(self, ident: int, ref) -> None:
+        with self._lock:
+            entry = self._entries.get(ident)
+            if entry is not None and entry.ref is ref:
+                self._entries.pop(ident, None)
+
+    def stats(self) -> Mapping[str, int]:
+        with self._lock:
+            return dict(self._stats)
+
+    def lookup(self, weight: torch.Tensor, dtype: str, k: int, n: int) -> Optional[PackedWeight]:
+        """Return the packed weight for this exact tensor revision, if cached."""
+
+        ident = id(weight)
+        version = _tensor_version(weight)
+        with self._lock:
+            entry = self._entries.get(ident)
+            if (
+                entry is not None
+                and entry.ref() is weight
+                and entry.version == version
+                and entry.shape == (n, k)
+                and entry.dtype == dtype
+            ):
+                self._stats["pack_hits"] += 1
+                return entry.packed
+        return None
+
+    def store(
+        self, weight: torch.Tensor, dtype: str, k: int, n: int, packed: PackedWeight
+    ) -> PackedWeight:
+        """Cache a freshly packed weight keyed by identity + torch version."""
+
+        ident = id(weight)
+        ref = weakref.ref(weight, lambda dead, ident=ident: self._drop(ident, dead))
+        with self._lock:
+            self._entries[ident] = _WeightPackEntry(
+                ref, _tensor_version(weight), (n, k), dtype, packed
+            )
+            self._stats["pack_builds"] += 1
+        return packed
+
+
+_WEIGHT_CACHE = _WeightPackCache()
+
+
+# --------------------------------------------------------------------------- #
+# contract checks and execution
+# --------------------------------------------------------------------------- #
+def _require_tensor(tensor: Any, name: str) -> torch.Tensor:
+    if not torch.is_tensor(tensor):
+        raise PyPTOXUnsupportedError(
+            "{} must be a torch.Tensor, got {}".format(name, type(tensor).__name__),
+            reason_code="not_a_tensor",
+            details={"name": name},
+        )
+    return tensor
+
+
+def _require_rank(tensor: torch.Tensor, rank: int, name: str) -> None:
+    if tensor.dim() != rank:
+        raise PyPTOXUnsupportedError(
+            "{} must be rank {}, got rank {}".format(name, rank, tensor.dim()),
+            reason_code="rank_unsupported",
+            details={"name": name, "rank": tensor.dim(), "expected_rank": rank},
+        )
+
+
+def _require_device(tensor: torch.Tensor, name: str) -> None:
+    if tensor.device.type != "cpu":
+        raise PyPTOXUnsupportedError(
+            "{} must be a CPU tensor, got {!r}".format(name, str(tensor.device)),
+            reason_code="device_unsupported",
+            details={"name": name, "device": str(tensor.device)},
+        )
+
+
+def _check_bias(bias: Optional[torch.Tensor], n: int, dtype: str) -> None:
+    if bias is None:
+        return
+    _require_tensor(bias, "bias")
+    _require_device(bias, "bias")
+    _require_rank(bias, 1, "bias")
+    if bias.requires_grad:
+        raise PyPTOXUnsupportedError(
+            "bias requires grad; the single-kernel bridge does not define backward",
+            reason_code="requires_grad",
+            details={"name": "bias"},
+        )
+    bias_dtype = dtype_name(bias, name="bias")
+    if bias_dtype != dtype:
+        raise PyPTOXUnsupportedError(
+            "bias dtype {} does not match activation/weight dtype {}".format(bias.dtype, dtype),
+            reason_code="bias_dtype_mismatch",
+            details={"bias_dtype": str(bias.dtype), "dtype": dtype},
+        )
+    if int(bias.shape[0]) != n:
+        raise PyPTOXUnsupportedError(
+            "bias shape {} does not match output features {}".format(tuple(bias.shape), n),
+            reason_code="bias_shape_mismatch",
+            details={"bias_shape": list(bias.shape), "n": n},
+        )
+
+
+def _weight_contract(x: torch.Tensor, weight: torch.Tensor) -> Tuple[int, int, int, str]:
+    _require_tensor(x, "x")
+    _require_tensor(weight, "weight")
+    _require_device(x, "x")
+    _require_device(weight, "weight")
+    _require_rank(x, 2, "x")
+    _require_rank(weight, 2, "weight")
+    dtype = dtype_name(x, name="x")
+    weight_dtype = dtype_name(weight, name="weight")
+    if weight_dtype != dtype:
+        raise PyPTOXUnsupportedError(
+            "weight dtype {} does not match activation dtype {}".format(weight.dtype, x.dtype),
+            reason_code="dtype_mismatch",
+            details={"x_dtype": str(x.dtype), "weight_dtype": str(weight.dtype)},
+        )
+    m, k = int(x.shape[0]), int(x.shape[1])
+    n, weight_k = int(weight.shape[0]), int(weight.shape[1])
+    if k != weight_k:
+        raise PyPTOXUnsupportedError(
+            "activation K {} does not match weight K {}".format(k, weight_k),
+            reason_code="shape_mismatch",
+            details={"x_shape": list(x.shape), "weight_shape": list(weight.shape)},
+        )
+    if m <= 0 or k <= 0 or n <= 0:
+        raise PyPTOXUnsupportedError(
+            "PyPTO-X linear requires positive M/K/N, got ({}, {}, {})".format(m, k, n),
+            reason_code="shape_unsupported",
+            details={"m": m, "k": k, "n": n},
+        )
+    return m, k, n, dtype
+
+
+def _run_kernel(
+    x: torch.Tensor,
+    m: int,
+    k: int,
+    n: int,
+    dtype: str,
+    right_address: int,
+    bias: Optional[torch.Tensor],
+) -> torch.Tensor:
+    # Fast path: validate and take the activation address without a numpy view;
+    # the entry lookup is a dict hit keyed by (dtype, M, K, N).
+    left = tensor_to_pointer(x, dtype=dtype, shape=(m, k), name="x")
+    output, output_pointer = allocate_output_address(dtype, (m, n))
+    entry = linear_kernel_cache().get(dtype, m, k, n)
+    entry.invoke(left.address, int(right_address), output_pointer.address)
+    if bias is not None:
+        output.add_(bias)
+    return output
+
+
+def _linear_from_weight_impl(
+    x: torch.Tensor, weight: torch.Tensor, bias: Optional[torch.Tensor]
+) -> torch.Tensor:
+    m, k, n, dtype = _weight_contract(x, weight)
+    _check_bias(bias, n, dtype)
+    packed = _WEIGHT_CACHE.lookup(weight, dtype, k, n)
+    if packed is None:
+        weight_view = tensor_to_view(weight, dtype=dtype, shape=(n, k), name="weight")
+        packed = _WEIGHT_CACHE.store(
+            weight, dtype, k, n, pack_view(weight_view.array, k=k, n=n, dtype=dtype)
+        )
+    return _run_kernel(x, m, k, n, dtype, packed.address, bias)
+
+
+def _packed_contract(x: torch.Tensor, packed: PackedWeight) -> Tuple[int, int, int, str]:
+    _require_tensor(x, "x")
+    _require_device(x, "x")
+    _require_rank(x, 2, "x")
+    dtype = dtype_name(x, name="x")
+    if packed.dtype != dtype:
+        raise PyPTOXUnsupportedError(
+            "packed weight dtype {} does not match activation dtype {}".format(packed.dtype, x.dtype),
+            reason_code="dtype_mismatch",
+            details={"packed_dtype": packed.dtype, "x_dtype": str(x.dtype)},
+        )
+    m, k = int(x.shape[0]), int(x.shape[1])
+    if k != packed.k:
+        raise PyPTOXUnsupportedError(
+            "activation K {} does not match packed K {}".format(k, packed.k),
+            reason_code="shape_mismatch",
+            details={"x_shape": list(x.shape), "packed_k": packed.k},
+        )
+    if m <= 0 or packed.n <= 0 or packed.k <= 0:
+        raise PyPTOXUnsupportedError(
+            "PyPTO-X linear requires positive M/K/N",
+            reason_code="shape_unsupported",
+            details={"m": m, "k": packed.k, "n": packed.n},
+        )
+    return m, packed.k, packed.n, dtype
+
+
+def _linear_from_packed_impl(
+    x: torch.Tensor, packed: PackedWeight, bias: Optional[torch.Tensor]
+) -> torch.Tensor:
+    m, k, n, dtype = _packed_contract(x, packed)
+    _check_bias(bias, n, dtype)
+    return _run_kernel(x, m, k, n, dtype, packed.address, bias)
+
+
+def _linear_entry(
+    x: torch.Tensor, weight: torch.Tensor, bias: Optional[torch.Tensor]
+) -> torch.Tensor:
+    if is_packed_like(weight):
+        return _linear_from_packed_impl(x, packed_tensor_to_view(weight), bias)
+    return _linear_from_weight_impl(x, weight, bias)
+
+
+def _linear_impl(
+    x: torch.Tensor, weight: torch.Tensor, bias: Optional[torch.Tensor] = None
+) -> torch.Tensor:
+    """Fail-open single-kernel linear (see module docstring)."""
+
+    try:
+        return _linear_entry(x, weight, bias)
+    except PyPTOXBridgeError as exc:
+        if is_packed_like(weight):
+            # An opaque packed handle has no meaningful torch fallback: fail
+            # closed instead of surfacing an unrelated F.linear error.
+            raise
+        _record_fallback("linear", exc)
+        return torch.nn.functional.linear(x, weight, bias)
+
+
+def _linear_strict_impl(
+    x: torch.Tensor, weight: torch.Tensor, bias: Optional[torch.Tensor] = None
+) -> torch.Tensor:
+    """Fail-closed single-kernel linear (see module docstring)."""
+
+    return _linear_entry(x, weight, bias)
+
+
+def _pack_weight_impl(weight: torch.Tensor) -> torch.Tensor:
+    _require_tensor(weight, "weight")
+    _require_device(weight, "weight")
+    _require_rank(weight, 2, "weight")
+    dtype = dtype_name(weight, name="weight")
+    n, k = int(weight.shape[0]), int(weight.shape[1])
+    if n <= 0 or k <= 0:
+        raise PyPTOXUnsupportedError(
+            "pack_weight requires positive N/K",
+            reason_code="shape_unsupported",
+            details={"n": n, "k": k},
+        )
+    if weight.requires_grad:
+        raise PyPTOXUnsupportedError(
+            "pack_weight does not support tensors that require grad",
+            reason_code="requires_grad",
+        )
+    view = tensor_to_view(weight, dtype=dtype, shape=(n, k), name="weight")
+    return pack_view_to_tensor(view, k=k, n=n)
+
+
+def _linear_prepacked_impl(
+    x: torch.Tensor, packed: torch.Tensor, bias: Optional[torch.Tensor] = None
+) -> torch.Tensor:
+    """Fail-closed linear against a handle produced by ``pack_weight``."""
+
+    return _linear_from_packed_impl(x, packed_tensor_to_view(packed), bias)
+
+
+# --------------------------------------------------------------------------- #
+# fake/meta implementations
+# --------------------------------------------------------------------------- #
+def _fake_binary_shape(x: torch.Tensor, weight: torch.Tensor) -> Tuple[int, int]:
+    if x.dim() != 2 or weight.dim() != 2:
+        raise RuntimeError("pypto_x linear fake requires rank-2 x and weight")
+    if weight.dtype == torch.uint8:
+        raise NotImplementedError(
+            "pypto_x packed weight handles are not traceable; use a plain weight tensor"
+        )
+    return int(x.shape[0]), int(weight.shape[0])
+
+
+def _linear_fake(
+    x: torch.Tensor, weight: torch.Tensor, bias: Optional[torch.Tensor] = None
+) -> torch.Tensor:
+    m, n = _fake_binary_shape(x, weight)
+    return x.new_empty((m, n))
+
+
+def _pack_weight_fake(weight: torch.Tensor) -> torch.Tensor:
+    if weight.dim() != 2:
+        raise RuntimeError("pypto_x pack_weight fake requires a rank-2 weight")
+    dtype = TORCH_DTYPES.get(weight.dtype)
+    if dtype is None:
+        raise RuntimeError("pypto_x pack_weight fake received unsupported dtype {}".format(weight.dtype))
+    return weight.new_empty((packed_size_bytes(weight.shape[1], weight.shape[0], dtype),), dtype=torch.uint8)
+
+
+def _linear_prepacked_fake(
+    x: torch.Tensor, packed: torch.Tensor, bias: Optional[torch.Tensor] = None
+) -> torch.Tensor:
+    raise NotImplementedError(
+        "pypto_x packed weight handles cannot be traced: K/N live in the handle bytes"
+    )
+
+
+# --------------------------------------------------------------------------- #
+# registration
+# --------------------------------------------------------------------------- #
+_REGISTER_LOCK = threading.RLock()
+_REGISTERED = False
+
+def _define(name: str, fn: Any) -> None:
+    try:
+        torch.library.custom_op(name, fn, mutates_args=(), device_types="cpu")
+    except (RuntimeError, ValueError) as exc:
+        if not hasattr(torch.ops.pypto_x, name.split("::", 1)[1]):
+            raise
+        # Another import of this module (test reload, plugin re-registration)
+        # already defined the op; registration must stay idempotent.
+        del exc
+
+
+def _fake_define(name: str, fn: Any) -> None:
+    torch.library.register_fake(name, fn)
+
+
+def register() -> None:
+    """Register the ``pypto_x`` torch ops exactly once per process."""
+
+    global _REGISTERED
+    with _REGISTER_LOCK:
+        if _REGISTERED:
+            return
+        _define("pypto_x::linear", _linear_impl)
+        _define("pypto_x::linear_strict", _linear_strict_impl)
+        _define("pypto_x::pack_weight", _pack_weight_impl)
+        _define("pypto_x::linear_prepacked", _linear_prepacked_impl)
+        _fake_define("pypto_x::linear", _linear_fake)
+        _fake_define("pypto_x::linear_strict", _linear_fake)
+        _fake_define("pypto_x::pack_weight", _pack_weight_fake)
+        _fake_define("pypto_x::linear_prepacked", _linear_prepacked_fake)
+        _REGISTERED = True
+
+
+def reset_weight_pack_cache() -> None:
+    """Test hook: drop all cached packed weights."""
+
+    global _WEIGHT_CACHE
+    _WEIGHT_CACHE = _WeightPackCache()
+
+
+def op_stats() -> Mapping[str, Any]:
+    """Return kernel + weight-pack + fallback counters for evidence/tests."""
+
+    from .linear_kernel import linear_kernel_cache
+
+    return {
+        "kernel_cache": linear_kernel_cache().to_dict(),
+        "weight_pack": _WEIGHT_CACHE.stats(),
+        "fallbacks": fallback_stats(),
+    }
+
+
+register()
+
+__all__ = [
+    "fallback_stats",
+    "op_stats",
+    "register",
+    "reset_fallback_stats",
+    "reset_weight_pack_cache",
+]
