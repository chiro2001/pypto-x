+"""J1 torch-free contract: ``pypto.framework`` must import without torch.
+
+The torch custom-op suite lives outside ``python/tests/ut`` because it needs
+the dedicated ``pypto-x-w8j`` environment.  These tests pin the optional
+dependency boundary and the torch-free cache-key rules inside the normal
+system-python suite.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {
+        name: module
+        for name, module in sys.modules.items()
+        if name == "pypto" or name.startswith("pypto.")
+    }
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        import pypto.framework as framework
+        from pypto.framework.errors import PyPTOXUnsupportedError
+        from pypto.framework.linear_kernel import LinearKernelCache, linear_target, normalize_dtype
+        return locals()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+
+
+_C = _imports()
+framework = _C["framework"]
+PyPTOXUnsupportedError = _C["PyPTOXUnsupportedError"]
+LinearKernelCache = _C["LinearKernelCache"]
+linear_target = _C["linear_target"]
+normalize_dtype = _C["normalize_dtype"]
+
+
+def test_framework_import_does_not_import_torch():
+    torch_was_loaded = "torch" in sys.modules
+    saved = {
+        name: module
+        for name, module in sys.modules.items()
+        if name == "pypto" or name.startswith("pypto.")
+    }
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(Path(__file__).parents[3] / "pypto")]
+    sys.modules["pypto"] = package
+    try:
+        import pypto.framework  # noqa: F401
+
+        assert ("torch" in sys.modules) is torch_was_loaded
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+
+
+def test_register_torch_ops_without_torch_is_a_structured_error():
+    if importlib.util.find_spec("torch") is not None:
+        pytest.skip("torch is installed in this interpreter; laziness is tested in the torch suite")
+    with pytest.raises(framework.PyPTOXBridgeError) as info:
+        framework.register_torch_ops()
+    assert info.value.reason_code == "torch_missing"
+    assert framework.torch_available() is False
+
+
+def test_dtype_normalisation_and_target_features():
+    assert normalize_dtype("bfloat16") == "bf16"
+    assert normalize_dtype("float32") == "float32"
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        normalize_dtype("float64")
+    assert info.value.reason_code == "dtype_unsupported"
+
+    bf16 = linear_target("bf16")
+    f32 = linear_target("float32")
+    assert bf16.kind == "cpu"
+    assert bf16.triple.startswith("x86_64")
+    assert "avx512bf16" in bf16.features
+    assert "avx512bf16" not in f32.features
+    assert bf16.features != f32.features
+
+
+def test_kernel_cache_key_is_stable_and_input_sensitive():
+    cache = LinearKernelCache(cache_dir=None, disk_cache=False)
+    base = cache.key("bf16", 2, 6, 10)
+    assert base.digest == cache.key("bf16", 2, 6, 10).digest
+    assert base.digest != cache.key("bf16", 2, 6, 11).digest
+    assert base.digest != cache.key("float32", 2, 6, 10).digest
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        cache.key("bf16", 0, 6, 10)
+    assert info.value.reason_code == "shape_unsupported"
