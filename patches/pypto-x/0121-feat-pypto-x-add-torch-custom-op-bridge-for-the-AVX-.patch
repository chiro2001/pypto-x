index 000000000..43df59bb6
--- /dev/null
+++ b/python/tests/framework_torch/test_torch_linear_cache.py
@@ -0,0 +1,154 @@
+"""J1 compile/weight-pack cache evidence tests.
+
+The contract is: one Core IR program build and one clang invocation per
+``(dtype, M, K, N, target)``; a second call in the same process is a memory
+hit; a fresh process with the same ``PYPTO_X_TORCH_CACHE_DIR`` is a disk hit
+(no rebuild, no clang); a mutated weight is re-packed because the torch
+version counter changed.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+import torch
+
+from pypto.framework import torch_ops
+from pypto.framework.linear_kernel import LinearKernelCache, linear_kernel_cache, reset_linear_kernel_cache
+
+
+BF16 = torch.bfloat16
+
+
+def _call(m=2, k=4, n=5, dtype=BF16):
+    x = torch.randn(m, k, dtype=dtype)
+    weight = torch.randn(n, k, dtype=dtype)
+    return torch.ops.pypto_x.linear(x, weight), x, weight
+
+
+def test_same_shape_builds_and_compiles_once(fresh_caches):
+    _call()
+    first = fresh_caches.stats
+    assert first["kernel_builds"] == 1
+    assert first["compile_calls"] == 1
+    assert first["disk_hits"] == 0
+
+    _call()
+    _call()
+    second = fresh_caches.stats
+    assert second["kernel_builds"] == 1
+    assert second["compile_calls"] == 1
+    assert second["memory_hits"] == 2
+
+
+def test_new_shape_builds_again_but_never_rebuilds_the_same_shape(fresh_caches):
+    _call(k=4, n=5)
+    _call(k=4, n=6)
+    _call(k=4, n=5)
+    stats = fresh_caches.stats
+    assert stats["kernel_builds"] == 2
+    assert stats["compile_calls"] == 2
+    assert stats["memory_hits"] == 1
+
+
+def test_disk_cache_is_reused_across_cache_instances(fresh_caches):
+    _call(m=3, k=8, n=7)
+    assert fresh_caches.stats["kernel_builds"] == 1
+
+    # A fresh instance has an empty memory tier but the same cache directory,
+    # which is what a new worker process sees.
+    second = LinearKernelCache(cache_dir=fresh_caches.cache_dir, disk_cache=True)
+    reset_linear_kernel_cache(second)
+    _call(m=3, k=8, n=7)
+    stats = second.stats
+    assert stats["kernel_builds"] == 0
+    assert stats["compile_calls"] == 0
+    assert stats["disk_hits"] == 1
+    assert stats["load_failures"] == 0
+
+
+def test_disk_sidecar_records_the_kernel_key(fresh_caches):
+    _call(m=1, k=2, n=3)
+    key = fresh_caches.key("bf16", 1, 2, 3)
+    sidecar = fresh_caches.cache_dir / ("pypto_x_linear_{}.json".format(key.digest[:32]))
+    payload = json.loads(sidecar.read_text(encoding="utf-8"))
+    assert payload["key"] == key.to_dict()
+    assert payload["artifact"]["entrypoint"] == "pypto_x_linear"
+    assert payload["artifact"]["metadata"]["native_variant"] == "avx512-fma-bf16"
+
+
+def test_stale_or_tampered_sidecar_is_rebuilt_not_trusted(fresh_caches):
+    _call(m=1, k=2, n=3)
+    key = fresh_caches.key("bf16", 1, 2, 3)
+    sidecar = fresh_caches.cache_dir / ("pypto_x_linear_{}.json".format(key.digest[:32]))
+    sidecar.write_text("{not json", encoding="utf-8")
+
+    second = LinearKernelCache(cache_dir=fresh_caches.cache_dir, disk_cache=True)
+    reset_linear_kernel_cache(second)
+    got, _, _ = _call(m=1, k=2, n=3)
+    assert got.shape == (1, 3)
+    stats = second.stats
+    assert stats["load_failures"] == 1
+    assert stats["kernel_builds"] == 1
+    assert stats["compile_calls"] == 1
+
+
+def test_key_identity_is_stable_and_input_sensitive(fresh_caches):
+    cache = LinearKernelCache(cache_dir=None, disk_cache=False)
+    base = cache.key("bf16", 4, 8, 16)
+    assert base.digest == cache.key("bf16", 4, 8, 16).digest
+    assert base.digest != cache.key("float32", 4, 8, 16).digest
+    assert base.digest != cache.key("bf16", 5, 8, 16).digest
+    assert base.digest != cache.key("bf16", 4, 9, 16).digest
+    assert base.digest != cache.key("bf16", 4, 8, 17).digest
+    assert base.to_dict()["target"]["features"] != cache.key("float32", 4, 8, 16).to_dict()["target"]["features"]
+    with pytest.raises(Exception) as info:
+        cache.key("float64", 1, 2, 3)
+    assert getattr(info.value, "reason_code", None) == "dtype_unsupported"
+
+
+def test_weight_pack_is_cached_by_identity_and_invalidated_by_version(fresh_caches):
+    x = torch.randn(2, 4, dtype=BF16)
+    weight = torch.randn(5, 4, dtype=BF16)
+    torch.ops.pypto_x.linear(x, weight)
+    torch.ops.pypto_x.linear(x, weight)
+    stats = torch_ops.op_stats()["weight_pack"]
+    assert stats["pack_builds"] == 1
+    assert stats["pack_hits"] == 1
+
+    with torch.no_grad():
+        weight.add_(1.0)
+    got = torch.ops.pypto_x.linear(x, weight)
+    ref = torch.nn.functional.linear(x, weight)
+    assert torch.equal(got, ref)
+    stats = torch_ops.op_stats()["weight_pack"]
+    assert stats["pack_builds"] == 2
+
+
+def test_explicit_packed_handle_bypasses_the_weight_cache(fresh_caches):
+    x = torch.randn(2, 4, dtype=BF16)
+    weight = torch.randn(5, 4, dtype=BF16)
+    packed = torch.ops.pypto_x.pack_weight(weight)
+    before = torch_ops.op_stats()["weight_pack"]
+    for _ in range(3):
+        torch.ops.pypto_x.linear_prepacked(x, packed)
+    after = torch_ops.op_stats()["weight_pack"]
+    assert before == after
+
+
+def test_kernel_cache_clear_keeps_the_compiled_artifact_usable(fresh_caches):
+    got, x, weight = _call()
+    entry = linear_kernel_cache().get("bf16", 2, 4, 5)
+    fresh_caches.clear()
+    assert fresh_caches.stats["kernel_builds"] == 1
+    # entry is immutable and remains usable after the cache was cleared
+    from pypto.framework.torch_bridge import allocate_output, tensor_to_view
+    from pypto.framework.weight_pack import pack_view
+
+    left = tensor_to_view(x, dtype="bf16", shape=(2, 4), name="x")
+    weight_view = tensor_to_view(weight, dtype="bf16", shape=(5, 4), name="weight")
+    packed = pack_view(weight_view.array, k=4, n=5, dtype="bf16")
+    output, output_view = allocate_output("bf16", (2, 5))
+    entry.invoke(left.address, packed.address, output_view.address)
+    assert torch.equal(output, got)
diff --git a/python/tests/framework_torch/test_torch_linear_correctness.py b/python/tests/framework_torch/test_torch_linear_correctness.py
new file mode 100644
index 000000000..ddadf0712
--- /dev/null
+++ b/python/tests/framework_torch/test_torch_linear_correctness.py
@@ -0,0 +1,225 @@
+"""J1 correctness: torch.ops.pypto_x.linear/linear_prepacked vs F.linear.
+
+Tolerance policy (self-documented, measured on the AVX-512 host):
+
+* float32: the bridge compares against the float64 gold and requires
+  ``max|ours - gold| <= 1e-5 * max(1, |gold|max)``; against ``F.linear``
+  (float32) the requirement is ``max|ours - ref| <= 1e-5``.  Measured
+  differences are <= 2.0e-7 for K <= 1024/3584 shapes, i.e. a few fp32 ulps.
+* bfloat16: ``gold`` is the float64 reference.  One bf16 rounding unit at
+  scale s is ``2**-8 * s``.  The bridge allows 2 LSB against gold and 4 LSB
+  against ``F.linear`` because the bias is added after the kernel's bf16
+  output rounding (torch/oneDNN fuses bias into the fp32 accumulator).
+  Without bias the measured difference vs F.linear is bitwise zero for most
+  shapes and <= 2.4e-4 for the largest tested one.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+import torch
+
+from pypto.framework import PyPTOXUnsupportedError, torch_ops
+from pypto.framework.torch_bridge import allocate_output, tensor_to_view
+
+
+DTYPES = (torch.float32, torch.bfloat16)
+SHAPES = ((1, 2, 3), (3, 5, 4), (4, 17, 19), (2, 33, 7), (1, 128, 64))
+BF16_LSB = 2.0 ** -8.0
+
+
+def _rand(dtype, shape, generator, scale):
+    return (torch.randn(*shape, generator=generator) * scale).to(dtype)
+
+
+def _max_abs(left, right):
+    return (left.float() - right.float()).abs().max().item()
+
+
+def _bps(dtype):
+    return torch.bfloat16 if dtype == "bf16" else torch.float32
+
+
+@pytest.mark.parametrize("dtype", DTYPES, ids=("f32", "bf16"))
+@pytest.mark.parametrize("shape", SHAPES, ids=lambda s: "{}x{}x{}".format(*s))
+@pytest.mark.parametrize("with_bias", (False, True), ids=("nobias", "bias"))
+def test_linear_matches_functional(dtype, shape, with_bias, fresh_caches):
+    m, k, n = shape
+    generator = torch.Generator().manual_seed(20260911 + m * 31 + k * 7 + n)
+    x = _rand(dtype, (m, k), generator, 1.0 / k ** 0.5)
+    weight = _rand(dtype, (n, k), generator, 1.0 / k ** 0.5)
+    bias = _rand(dtype, (n,), generator, 0.1) if with_bias else None
+
+    got = torch.ops.pypto_x.linear(x, weight, bias)
+    ref = torch.nn.functional.linear(x, weight, bias)
+    gold = torch.nn.functional.linear(
+        x.double(), weight.double(), None if bias is None else bias.double()
+    )
+
+    assert got.shape == (m, n)
+    assert got.dtype == x.dtype
+    ours_gold = _max_abs(got, gold)
+    ref_gold = _max_abs(ref, gold)
+    scale = max(1.0, gold.abs().max().item())
+    if dtype == torch.float32:
+        assert ours_gold <= 1e-5 * scale
+        assert _max_abs(got, ref) <= 1e-5
+        assert ref_gold <= 1e-5 * scale
+    else:
+        assert ours_gold <= 2.0 * BF16_LSB * scale
+        assert _max_abs(got, ref) <= 4.0 * BF16_LSB * scale
+        assert ref_gold <= 2.0 * BF16_LSB * scale
+
+
+@pytest.mark.parametrize("dtype", (torch.float32, torch.bfloat16), ids=("f32", "bf16"))
+def test_packed_weight_path_is_equivalent(dtype, fresh_caches):
+    m, k, n = 3, 40, 33
+    generator = torch.Generator().manual_seed(99)
+    x = _rand(dtype, (m, k), generator, 1.0 / k ** 0.5)
+    weight = _rand(dtype, (n, k), generator, 1.0 / k ** 0.5)
+    bias = _rand(dtype, (n,), generator, 0.1)
+
+    packed = torch.ops.pypto_x.pack_weight(weight)
+    itemsize = 4 if dtype == torch.float32 else 2
+    assert packed.dtype == torch.uint8
+    assert packed.dim() == 1
+    assert packed.numel() == 32 + k * n * itemsize
+
+    prepacked = torch.ops.pypto_x.linear_prepacked(x, packed, bias)
+    direct = torch.ops.pypto_x.linear(x, weight, bias)
+    ref = torch.nn.functional.linear(x, weight, bias)
+    assert torch.equal(prepacked, direct)
+    if dtype == torch.float32:
+        assert _max_abs(prepacked, ref) <= 1e-5
+    else:
+        assert _max_abs(prepacked, ref) <= 4.0 * BF16_LSB * max(1.0, ref.abs().max().item())
+
+
+def test_bridge_is_zero_copy_for_contiguous_inputs(fresh_caches):
+    x = torch.randn(4, 8, dtype=torch.float32)
+    view = tensor_to_view(x, dtype="float32", shape=(4, 8), name="x")
+    assert view.copies == 0
+    assert view.address == x.data_ptr()
+    assert not view.owns_buffer
+
+    weight = torch.randn(16, 8, dtype=torch.bfloat16)
+    bits = tensor_to_view(weight, dtype="bf16", shape=(16, 8), name="weight")
+    assert bits.copies == 0
+    assert bits.address == weight.data_ptr()
+    # BF16 is exposed as a raw uint16 view of the same storage.
+    assert bits.array.dtype == np.uint16
+    assert bits.nbytes == weight.numel() * 2
+
+
+def test_bridge_copies_non_contiguous_inputs_once(fresh_caches):
+    base = torch.randn(16, 8, dtype=torch.float32)
+    transposed = base.t()
+    assert not transposed.is_contiguous()
+    view = tensor_to_view(transposed, dtype="float32", shape=(8, 16), name="x")
+    assert view.copies == 1
+    assert view.owns_buffer
+    assert view.address != transposed.data_ptr()
+    assert np.array_equal(view.array, transposed.contiguous().numpy())
+
+
+def test_output_allocation_owns_memory(fresh_caches):
+    tensor, view = allocate_output("bf16", (2, 5))
+    assert tensor.dtype == torch.bfloat16
+    assert view.copies == 0
+    assert view.owns_buffer
+    assert view.writable
+    assert view.address == tensor.data_ptr()
+
+
+def test_meta_fake_inference_has_no_kernel_call(fresh_caches):
+    x = torch.empty(3, 7, dtype=torch.bfloat16, device="meta")
+    weight = torch.empty(5, 7, dtype=torch.bfloat16, device="meta")
+    bias = torch.empty(5, dtype=torch.bfloat16, device="meta")
+    out = torch.ops.pypto_x.linear(x, weight, bias)
+    assert out.shape == (3, 5)
+    assert out.dtype == torch.bfloat16
+    assert out.device.type == "meta"
+    stats = fresh_caches.stats
+    assert stats["kernel_builds"] == 0
+    assert stats["compile_calls"] == 0
+
+    strict = torch.ops.pypto_x.linear_strict(x, weight)
+    assert strict.shape == (3, 5)
+
+
+def test_strict_unsupported_raises_with_reason(fresh_caches):
+    x = torch.randn(2, 4, dtype=torch.float64)
+    weight = torch.randn(5, 4, dtype=torch.float64)
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        torch.ops.pypto_x.linear_strict(x, weight)
+    assert info.value.reason_code == "dtype_unsupported"
+    assert fresh_caches.stats["kernel_builds"] == 0
+    assert torch_ops.fallback_stats()["total"] == 0
+
+
+def test_non_contiguous_activation_and_weight_are_supported(fresh_caches):
+    base_x = torch.randn(16, 8, dtype=torch.float32)
+    x = base_x.t()  # (8, 16), non-contiguous
+    base_w = torch.randn(16, 6, dtype=torch.float32)
+    weight = base_w.t()  # (6, 16), non-contiguous
+    assert not x.is_contiguous() and not weight.is_contiguous()
+
+    got = torch.ops.pypto_x.linear(x, weight)
+    ref = torch.nn.functional.linear(x, weight)
+    assert got.shape == (8, 6)
+    assert _max_abs(got, ref) <= 1e-5
+    # the second call reuses the packed contiguous weight copy
+    again = torch.ops.pypto_x.linear(x, weight)
+    assert torch.equal(got, again)
+
+
+def test_torch_compile_traces_through_fake_impl(fresh_caches):
+    def fn(x, weight):
+        return torch.ops.pypto_x.linear(x, weight) + 1.0
+
+    compiled = torch.compile(fn, fullgraph=True, backend="eager")
+    x = torch.randn(2, 4, dtype=torch.bfloat16)
+    weight = torch.randn(5, 4, dtype=torch.bfloat16)
+    out = compiled(x, weight)
+    eager = torch.ops.pypto_x.linear(x, weight) + 1.0
+    assert torch.equal(out, eager)
+
+
+def test_runtime_descriptor_launch_consumes_zero_copy_torch_buffers(fresh_caches):
+    """Exercise the full PyPTO-X runtime ABI with torch-backed numpy handles.
+
+    This is the descriptor path behind tensor_to_view: torch storage -> numpy
+    view -> TensorDesc(handle=...) -> Avx512Runtime.launch; no copy is made on
+    either side and the runtime writes directly into the torch output tensor.
+    """
+
+    from pypto.abi import LaunchRequest, TensorDesc
+    from pypto.backends.cpu.x86 import Avx512Runtime
+    from pypto.framework.linear_kernel import linear_kernel_cache
+    from pypto.framework.weight_pack import pack_view
+
+    m, k, n = 2, 3, 5
+    x = torch.randn(m, k, dtype=torch.bfloat16)
+    weight = torch.randn(n, k, dtype=torch.bfloat16)
+    output = torch.empty(m, n, dtype=torch.bfloat16)
+
+    left = tensor_to_view(x, dtype="bf16", shape=(m, k), name="x")
+    weight_view = tensor_to_view(weight, dtype="bf16", shape=(n, k), name="weight")
+    packed = pack_view(weight_view.array, k=k, n=n, dtype="bf16")
+    right = TensorDesc(
+        "bf16", (k, n), device="cpu", handle=packed.payload, readonly=True
+    )
+    output_view = tensor_to_view(output, dtype="bf16", shape=(m, n), name="output", writable=True)
+    assert output_view.address == output.data_ptr()
+
+    entry = linear_kernel_cache().get("bf16", m, k, n)
+    Avx512Runtime().launch(
+        LaunchRequest(
+            entry.artifact,
+            inputs=[left.descriptor(), right],
+            outputs=[output_view.descriptor()],
+        )
+    )
+    reference = torch.nn.functional.linear(x, weight)
+    assert _max_abs(output, reference) <= 4.0 * BF16_LSB * max(1.0, reference.abs().max().item())
diff --git a/python/tests/framework_torch/test_torch_linear_failure_semantics.py b/python/tests/framework_torch/test_torch_linear_failure_semantics.py
new file mode 100644
index 000000000..f655822ca
--- /dev/null
+++ b/python/tests/framework_torch/test_torch_linear_failure_semantics.py
@@ -0,0 +1,283 @@
+"""J1 failure semantics: fail-open vs fail-closed must both be explicit.
+
+* ``torch.ops.pypto_x.linear`` is fail-open.  Any unsupported input raises a
+  structured ``PyPTOXUnsupportedError`` internally, is recorded in the
+  process fallback counters, warns once per reason, and recomputes the exact
+  reference with ``F.linear``.  The only exception is an opaque packed-weight
+  handle (1-D uint8): there is no meaningful torch fallback for it, so it
+  fails closed with ``packed_handle_invalid``.
+* ``torch.ops.pypto_x.linear_strict`` never falls back: the structured error
+  propagates and the fallback counters stay untouched.
+"""
+
+from __future__ import annotations
+
+import warnings
+
+import pytest
+import torch
+
+from pypto.framework import (
+    PyPTOXBridgeError,
+    PyPTOXBuildError,
+    PyPTOXUnsupportedError,
+    torch_ops,
+)
+from pypto.framework.linear_kernel import linear_kernel_cache
+
+
+BF16 = torch.bfloat16
+
+
+def _fallback_events():
+    return dict(torch_ops.fallback_stats()["events"])
+
+
+@pytest.mark.parametrize(
+    "build,reason",
+    (
+        (lambda: (torch.randn(2, 4, dtype=torch.float64), torch.randn(5, 4, dtype=torch.float64), None),
+         "dtype_unsupported"),
+        (lambda: (torch.ones(2, 4, dtype=torch.int32), torch.ones(5, 4, dtype=torch.int32), None),
+         "dtype_unsupported"),
+        (lambda: (torch.randn(2, 3, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16), None),
+         "rank_unsupported"),
+        (lambda: (torch.randn(4, dtype=BF16), torch.randn(5, 4, dtype=BF16), None),
+         "rank_unsupported"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 4, dtype=torch.float32), None),
+         "dtype_mismatch"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 6, dtype=BF16), None),
+         "shape_mismatch"),
+        (lambda: (torch.randn(0, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16), None),
+         "shape_unsupported"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16), torch.randn(4, dtype=BF16)),
+         "bias_shape_mismatch"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16), torch.randn(5, dtype=torch.float32)),
+         "bias_dtype_mismatch"),
+        (lambda: (torch.randn(2, 4, dtype=BF16, requires_grad=True), torch.randn(5, 4, dtype=BF16), None),
+         "requires_grad"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16, requires_grad=True), None),
+         "requires_grad"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16),
+                  torch.randn(5, dtype=BF16, requires_grad=True)),
+         "requires_grad"),
+    ),
+    ids=(
+        "f64", "int32", "rank3_x", "rank1_x", "dtype_mismatch", "k_mismatch",
+        "zero_m", "bias_shape", "bias_dtype", "x_grad", "weight_grad", "bias_grad",
+    ),
+)
+def test_fail_open_matches_reference_and_records_reason(build, reason, fresh_caches):
+    x, weight, bias = build()
+    # Some unsupported inputs (e.g. mixed dtypes) are rejected by torch itself,
+    # so the fail-open contract is "same outcome as a caller-side F.linear
+    # fallback", which may also be an exception.  A fallback event must still
+    # be recorded in every case: nothing is silent.
+    reference = None
+    reference_error = None
+    try:
+        reference = torch.nn.functional.linear(x, weight, bias)
+    except Exception as exc:  # noqa: BLE001 - the reference failure is the expectation
+        reference_error = exc
+
+    with pytest.warns(RuntimeWarning, match=reason):
+        try:
+            got = torch.ops.pypto_x.linear(x, weight, bias)
+            raised = None
+        except Exception as exc:  # noqa: BLE001 - asserted against the reference below
+            raised = exc
+
+    if reference_error is None:
+        assert raised is None
+        assert torch.equal(got, reference)
+    else:
+        assert raised is not None
+        assert type(raised) is type(reference_error)
+    events = _fallback_events()
+    assert events.get("linear:" + reason) == 1
+    assert fresh_caches.stats["kernel_builds"] == 0
+
+
+def test_fail_open_warns_once_per_reason_but_keeps_counting(fresh_caches):
+    x = torch.randn(2, 4, dtype=torch.float64)
+    weight = torch.randn(5, 4, dtype=torch.float64)
+    with pytest.warns(RuntimeWarning):
+        torch.ops.pypto_x.linear(x, weight)
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        torch.ops.pypto_x.linear(x, weight)
+        assert not any(item.category is RuntimeWarning for item in caught)
+    assert _fallback_events()["linear:dtype_unsupported"] == 2
+
+
+def test_fail_open_can_silence_warnings_without_hiding_counters(fresh_caches, monkeypatch):
+    monkeypatch.setenv("PYPTO_X_TORCH_FALLBACK_WARNINGS", "0")
+    x = torch.randn(2, 4, dtype=torch.float64)
+    weight = torch.randn(5, 4, dtype=torch.float64)
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        got = torch.ops.pypto_x.linear(x, weight)
+        assert not any(item.category is RuntimeWarning for item in caught)
+    assert torch.equal(got, torch.nn.functional.linear(x, weight))
+    assert _fallback_events()["linear:dtype_unsupported"] == 1
+
+
+@pytest.mark.parametrize(
+    "build,reason",
+    (
+        (lambda: (torch.randn(2, 4, dtype=torch.float64), torch.randn(5, 4, dtype=torch.float64), None),
+         "dtype_unsupported"),
+        (lambda: (torch.randn(2, 3, 4, dtype=BF16), torch.randn(5, 4, dtype=BF16), None),
+         "rank_unsupported"),
+        (lambda: (torch.randn(2, 4, dtype=BF16), torch.randn(5, 6, dtype=BF16), None),
+         "shape_mismatch"),
+    ),
+    ids=("dtype", "rank", "shape"),
+)
+def test_fail_closed_raises_structured_error(build, reason, fresh_caches):
+    x, weight, bias = build()
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        torch.ops.pypto_x.linear_strict(x, weight, bias)
+    assert info.value.reason_code == reason
+    assert info.value.to_dict()["reason_code"] == reason
+    # strict mode never records a fallback and never builds a kernel
+    assert torch_ops.fallback_stats()["total"] == 0
+    assert fresh_caches.stats["kernel_builds"] == 0
+
+
+def test_build_failure_falls_back_open_but_strict_raises(fresh_caches, monkeypatch):
+    cache = linear_kernel_cache()
+
+    def _explode(*args, **kwargs):
+        raise PyPTOXBuildError("simulated clang failure", reason_code="compile_failed")
+
+    monkeypatch.setattr(cache, "get", _explode)
+    x = torch.randn(2, 4, dtype=BF16)
+    weight = torch.randn(5, 4, dtype=BF16)
+    with pytest.warns(RuntimeWarning, match="compile_failed"):
+        got = torch.ops.pypto_x.linear(x, weight)
+    assert torch.equal(got, torch.nn.functional.linear(x, weight))
+    assert _fallback_events()["linear:compile_failed"] == 1
+
+    with pytest.raises(PyPTOXBuildError) as info:
+        torch.ops.pypto_x.linear_strict(x, weight)
+    assert info.value.reason_code == "compile_failed"
+
+
+def test_corrupt_packed_handle_fails_closed_even_in_fail_open_op(fresh_caches):
+    x = torch.randn(2, 4, dtype=BF16)
+    corrupt = torch.zeros(40, dtype=torch.uint8)
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        torch.ops.pypto_x.linear(x, corrupt)
+    assert info.value.reason_code == "packed_handle_invalid"
+    assert torch_ops.fallback_stats()["total"] == 0
+
+    packed = torch.ops.pypto_x.pack_weight(torch.randn(5, 4, dtype=BF16))
+    broken = packed.clone()
+    broken[4] = 9  # corrupt the pack version (header offset 4)
+    with pytest.raises(PyPTOXUnsupportedError) as info2:
+        torch.ops.pypto_x.linear_prepacked(x, broken)
+    assert info2.value.reason_code == "packed_handle_invalid"
+
+
+def test_pack_weight_unsupported_inputs_fail_closed(fresh_caches):
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        torch.ops.pypto_x.pack_weight(torch.randn(4, 8, dtype=torch.float64))
+    assert info.value.reason_code == "dtype_unsupported"
+    with pytest.raises(PyPTOXUnsupportedError) as info2:
+        torch.ops.pypto_x.pack_weight(torch.randn(8, dtype=BF16))
+    assert info2.value.reason_code == "rank_unsupported"
+
+
+def test_non_cpu_device_is_not_silently_remapped(fresh_caches):
+    if not torch.cuda.is_available():
+        pytest.skip("no CUDA device on this host")
+    x = torch.randn(2, 4, dtype=BF16, device="cuda")
+    weight = torch.randn(5, 4, dtype=BF16, device="cuda")
+    with pytest.raises(Exception):
+        torch.ops.pypto_x.linear(x, weight)
+
+
+def _injected_runtime(*features):
+    from pypto.backends.cpu.x86 import Avx512Runtime
+    from pypto.lowering.cpu.x86.avx512 import Avx512Capability
+
+    capability = Avx512Capability.injected_capability(tuple(features))
+    return Avx512Runtime(capability=capability)
+
+
+BASE_FEATURES = ("avx", "avx512f", "osxsave", "ymm", "opmask", "zmm", "fma")
+
+
+def test_avx512_unavailable_falls_back_open_and_strict_raises(tmp_path, monkeypatch):
+    from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache
+
+    cache = LinearKernelCache(cache_dir=tmp_path / "unavailable", runtime=_injected_runtime())
+    reset_linear_kernel_cache(cache)
+    x = torch.randn(2, 4, dtype=BF16)
+    weight = torch.randn(5, 4, dtype=BF16)
+    with pytest.warns(RuntimeWarning, match="avx512_unavailable"):
+        got = torch.ops.pypto_x.linear(x, weight)
+    assert torch.equal(got, torch.nn.functional.linear(x, weight))
+    with pytest.raises(PyPTOXUnsupportedError) as info:
+        torch.ops.pypto_x.linear_strict(x, weight)
+    assert info.value.reason_code == "avx512_unavailable"
+    assert cache.stats["kernel_builds"] == 0
+
+
+def test_missing_bf16_capability_only_falls_back_for_bf16(tmp_path):
+    from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache
+
+    cache = LinearKernelCache(
+        cache_dir=tmp_path / "nobf16",
+        runtime=_injected_runtime(*BASE_FEATURES),
+    )
+    reset_linear_kernel_cache(cache)
+    x_bf16 = torch.randn(2, 4, dtype=BF16)
+    w_bf16 = torch.randn(5, 4, dtype=BF16)
+    with pytest.warns(RuntimeWarning, match="avx512bf16_unavailable"):
+        got = torch.ops.pypto_x.linear(x_bf16, w_bf16)
+    assert torch.equal(got, torch.nn.functional.linear(x_bf16, w_bf16))
+
+    x = torch.randn(2, 4, dtype=torch.float32)
+    weight = torch.randn(5, 4, dtype=torch.float32)
+    result = torch.ops.pypto_x.linear(x, weight)
+    assert torch.allclose(result, torch.nn.functional.linear(x, weight), rtol=1e-5, atol=1e-5)
+    assert cache.stats["kernel_builds"] == 1
+
+
+def test_op_without_avx512bf16_is_never_silently_wrong(tmp_path):
+    """Fail-open must not mix a bf16 kernel into an f32/bf16 mismatch path."""
+
+    from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache
+
+    cache = LinearKernelCache(
+        cache_dir=tmp_path / "nobf16b",
+        runtime=_injected_runtime(*BASE_FEATURES),
+    )
+    reset_linear_kernel_cache(cache)
+    x = torch.randn(2, 4, dtype=BF16)
+    weight = torch.randn(5, 4, dtype=BF16)
+    strict_error = None
+    try:
+        torch.ops.pypto_x.linear_strict(x, weight)
+    except PyPTOXUnsupportedError as exc:
+        strict_error = exc
+    assert strict_error is not None
+    assert strict_error.reason_code == "avx512bf16_unavailable"
+
+
+def test_missing_fma_capability_falls_back(tmp_path):
+    from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache
+
+    cache = LinearKernelCache(
+        cache_dir=tmp_path / "nofma",
+        runtime=_injected_runtime("avx", "avx512f", "osxsave", "ymm", "opmask", "zmm"),
+    )
+    reset_linear_kernel_cache(cache)
+    x = torch.randn(2, 4, dtype=torch.float32)
+    weight = torch.randn(5, 4, dtype=torch.float32)
+    with pytest.warns(RuntimeWarning, match="fma_unavailable"):
+        got = torch.ops.pypto_x.linear(x, weight)
+    assert torch.equal(got, torch.nn.functional.linear(x, weight))
+    assert cache.stats["kernel_builds"] == 0
