diff --git a/python/pypto/framework/__init__.py b/python/pypto/framework/__init__.py
new file mode 100644
index 000000000..4cc9af413
--- /dev/null
+++ b/python/pypto/framework/__init__.py
@@ -0,0 +1,83 @@
+"""PyPTO-X framework adapters (W8J).
+
+This package is the torch-facing boundary of PyPTO-X.  Importing
+``pypto.framework`` never imports torch or numpy: torch is an *optional*
+dependency and stays lazy until the caller explicitly registers the ops::
+
+    import pypto.framework
+    pypto.framework.register_torch_ops()   # imports torch, registers torch.ops.pypto_x.*
+
+What J1 provides:
+
+* :mod:`pypto.framework.linear_kernel` - one compiled AVX-512 matmul Core IR
+  program per ``(dtype, M, K, N, target)`` with an in-process and a
+  cross-process (disk sidecar) cache;
+* :mod:`pypto.framework.torch_bridge` - explicit zero-copy-first CPU tensor
+  conversion with documented copy counts;
+* :mod:`pypto.framework.torch_ops` - ``torch.ops.pypto_x.linear`` fail-open,
+  ``linear_strict`` fail-closed, ``pack_weight``/``linear_prepacked``
+  pre-packed weight path and fake/meta implementations.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from typing import Any
+
+from .errors import PyPTOXBridgeError, PyPTOXBuildError, PyPTOXUnsupportedError
+from .linear_kernel import (
+    LinearKernelCache,
+    LinearKernelKey,
+    default_cache_dir,
+    linear_kernel_cache,
+    linear_target,
+    normalize_dtype,
+    reset_linear_kernel_cache,
+)
+
+
+def torch_available() -> bool:
+    """Return whether a torch installation is importable (without importing it)."""
+
+    try:
+        return importlib.util.find_spec("torch") is not None
+    except (ImportError, AttributeError, ValueError):
+        return False
+
+
+def register_torch_ops() -> Any:
+    """Import torch and register ``torch.ops.pypto_x.*``; returns the module."""
+
+    if not torch_available():
+        raise PyPTOXBridgeError(
+            "torch is not installed; torch.ops.pypto_x cannot be registered",
+            reason_code="torch_missing",
+        )
+    from . import torch_ops
+
+    return torch_ops
+
+
+def kernel_stats() -> Any:
+    """Return cache/fallback counters; requires the torch bridge to be loaded."""
+
+    from . import torch_ops
+
+    return torch_ops.op_stats()
+
+
+__all__ = [
+    "LinearKernelCache",
+    "LinearKernelKey",
+    "PyPTOXBridgeError",
+    "PyPTOXBuildError",
+    "PyPTOXUnsupportedError",
+    "default_cache_dir",
+    "kernel_stats",
+    "linear_kernel_cache",
+    "linear_target",
+    "normalize_dtype",
+    "register_torch_ops",
+    "reset_linear_kernel_cache",
+    "torch_available",
+]
diff --git a/python/pypto/framework/errors.py b/python/pypto/framework/errors.py
new file mode 100644
index 000000000..caedb6598
--- /dev/null
+++ b/python/pypto/framework/errors.py
@@ -0,0 +1,87 @@
+"""Structured errors for the PyPTO-X framework bridge.
+
+The bridge is intentionally explicit about *why* an input was not handled so
+that a framework adapter can either fall back to the vendor kernel (fail-open)
+or surface the failure (fail-closed) without silent numeric behaviour.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+
+def _details(value: Optional[Mapping[str, Any]]) -> Mapping[str, Any]:
+    if value is None:
+        return {}
+    if not isinstance(value, Mapping):
+        raise TypeError("error details must be a mapping")
+    return {str(key): value[key] for key in value}
+
+
+class PyPTOXBridgeError(RuntimeError):
+    """Base class for framework bridge failures.
+
+    ``reason_code`` is a stable machine-readable token (snake_case) and
+    ``details`` carries structured context.  Callers must not branch on the
+    human-readable message.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        reason_code: str = "bridge_error",
+        details: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        if not isinstance(reason_code, str) or not reason_code.strip():
+            raise ValueError("reason_code must be a non-empty string")
+        super().__init__(message)
+        self.reason_code = reason_code.strip()
+        self.details = _details(details)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "error": self.__class__.__name__,
+            "message": str(self),
+            "reason_code": self.reason_code,
+            "details": dict(self.details),
+        }
+
+
+class PyPTOXUnsupportedError(PyPTOXBridgeError):
+    """The input is outside the kernel contract.
+
+    This is the fail-open signal: a caller may safely recompute the same
+    semantics with ``torch.nn.functional.linear``.  It is never raised for a
+    failure that would make the fallback numerically different.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        reason_code: str = "unsupported_input",
+        details: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message, reason_code=reason_code, details=details)
+
+
+class PyPTOXBuildError(PyPTOXBridgeError):
+    """The kernel could not be built, loaded or verified.
+
+    Build failures are not input-contract failures; silently falling back is
+    still semantically safe, but the condition should be visible in logs and
+    counters.  The fail-closed entry points re-raise this unchanged.
+    """
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        reason_code: str = "kernel_build_failed",
+        details: Optional[Mapping[str, Any]] = None,
+    ) -> None:
+        super().__init__(message, reason_code=reason_code, details=details)
+
+
+__all__ = ["PyPTOXBridgeError", "PyPTOXUnsupportedError", "PyPTOXBuildError"]
diff --git a/python/pypto/framework/linear_kernel.py b/python/pypto/framework/linear_kernel.py
new file mode 100644
index 000000000..19932bfa7
--- /dev/null
+++ b/python/pypto/framework/linear_kernel.py
@@ -0,0 +1,548 @@
+"""Compiled single-kernel linear cache for the PyPTO-X AVX-512 backend.
+
+J0 established that rebuilding a Core IR graph per call is not viable inside
+an inference hot path.  This module compiles *one* rank-2 matmul CoreProgram
+per ``(dtype, M, K, N, target)`` tuple, loads it through the public AVX-512
+runtime once, and then exposes a direct native-symbol invocation for that
+kernel.  The cache key and invalidation rules are explicit:
+
+* memory hit  - same process, same key: no Core IR rebuild, no compile;
+* disk hit    - a previous process compiled the same key: the immutable
+  artifact metadata is loaded from a sidecar next to the content-addressed
+  ``.so`` and re-validated by ``Avx512Runtime.load``; no clang invocation;
+* invalidation - the key embeds the AVX-512 lowering version, artifact
+  payload/ABI/format versions, the target dict and a bridge key version.
+  A stale or tampered sidecar fails runtime validation and is rebuilt.
+  ``PYPTO_X_TORCH_CACHE_DIR`` selects the directory; deleting it forces a
+  cold rebuild.
+
+This module deliberately imports no torch and no numpy, so the kernel cache
+can be inspected from the torch-free test suite.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+from dataclasses import dataclass
+import ctypes
+import hashlib
+import json
+import os
+from pathlib import Path
+import threading
+import tempfile
+from typing import Any, Dict, Mapping, Optional, Tuple
+
+from pypto.backends.cpu.x86 import Avx512Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, ARTIFACT_FORMAT_VERSION, Artifact
+from pypto.compiler.targets.cpu_avx512 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    DEFAULT_ARTIFACT_FORMAT,
+    Avx512Compiler,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu.x86.avx512 import AVX512_LOWERING_VERSION
+from pypto.target import TargetSpec
+
+from .errors import PyPTOXBuildError, PyPTOXUnsupportedError
+
+
+LINEAR_KERNEL_CACHE_VERSION = 1
+_DTYPE_NATIVE_SUFFIX = {"float32": "f32", "bf16": "bf16"}
+_SUPPORTED_DTYPES = ("bf16", "float32")
+_DEFAULT_MAX_ENTRIES = 512
+_SIDECAR_PREFIX = "pypto_x_linear_"
+
+
+def normalize_dtype(dtype: Any) -> str:
+    """Return the canonical bridge dtype name or raise ``Unsupported``."""
+
+    name = dtype if isinstance(dtype, str) else getattr(dtype, "name", str(dtype))
+    value = str(name).strip().lower().replace("torch.", "")
+    if value == "float":
+        value = "float32"
+    if value == "bfloat16":
+        value = "bf16"
+    if value not in _SUPPORTED_DTYPES:
+        raise PyPTOXUnsupportedError(
+            "PyPTO-X linear supports bf16/float32, got {!r}".format(dtype),
+            reason_code="dtype_unsupported",
+            details={"dtype": str(dtype)},
+        )
+    return value
+
+
+def linear_target(dtype: str) -> TargetSpec:
+    """Return the fixed AVX-512 target for one bridge dtype."""
+
+    dtype = normalize_dtype(dtype)
+    features = ["avx512f", "fma"]
+    if dtype == "bf16":
+        features.append("avx512bf16")
+    return TargetSpec(
+        "cpu",
+        "x86_64-linux-gnu",
+        features=tuple(features),
+        attributes={"lane_count": 16},
+    )
+
+
+@dataclass(frozen=True)
+class LinearKernelKey:
+    """Stable cache identity for one compiled single-kernel matmul."""
+
+    dtype: str
+    m: int
+    k: int
+    n: int
+    target: Mapping[str, Any]
+    lowering_version: int = AVX512_LOWERING_VERSION
+    payload_version: int = ARTIFACT_PAYLOAD_VERSION
+    abi_version: str = ABI_VERSION
+    format_version: int = ARTIFACT_FORMAT_VERSION
+    key_version: int = LINEAR_KERNEL_CACHE_VERSION
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "key_version": self.key_version,
+            "op": "linear",
+            "dtype": self.dtype,
+            "m": self.m,
+            "k": self.k,
+            "n": self.n,
+            "target": dict(self.target),
+            "lowering_version": self.lowering_version,
+            "payload_version": self.payload_version,
+            "abi_version": self.abi_version,
+            "format_version": self.format_version,
+        }
+
+    @property
+    def digest(self) -> str:
+        return hashlib.sha256(
+            json.dumps(self.to_dict(), sort_keys=True, separators=(",", ":")).encode("utf-8")
+        ).hexdigest()
+
+    @property
+    def display(self) -> str:
+        return "linear:{dtype}:M{m}:K{k}:N{n}:{target}".format(
+            dtype=self.dtype, m=self.m, k=self.k, n=self.n, target=self.target.get("key", "?")
+        )
+
+
+class LinearKernelEntry:
+    """A loaded AVX-512 matmul artifact plus its direct native entry point."""
+
+    __slots__ = ("key", "artifact", "loaded", "_native", "m", "k", "n", "dtype", "disk_backed")
+
+    def __init__(
+        self,
+        key: LinearKernelKey,
+        artifact: Artifact,
+        loaded: Any,
+        native: Any,
+        *,
+        disk_backed: bool,
+    ) -> None:
+        self.key = key
+        self.artifact = artifact
+        self.loaded = loaded
+        self._native = native
+        self.m = key.m
+        self.k = key.k
+        self.n = key.n
+        self.dtype = key.dtype
+        self.disk_backed = bool(disk_backed)
+
+    @property
+    def native_symbol(self) -> str:
+        return "ptx_avx512_matmul_{}".format(_DTYPE_NATIVE_SUFFIX[self.dtype])
+
+    def invoke(self, left_address: int, right_address: int, output_address: int) -> None:
+        """Call the single native matmul kernel with raw buffer addresses."""
+
+        self._native(
+            int(left_address),
+            int(right_address),
+            int(output_address),
+            self.m,
+            self.k,
+            self.n,
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "key": self.key.to_dict(),
+            "digest": self.key.digest,
+            "artifact_digest": self.artifact.content_digest,
+            "native_symbol": self.native_symbol,
+            "native_variant": getattr(self.loaded.target_ir, "native_variant", None),
+            "disk_backed": self.disk_backed,
+        }
+
+
+def _matmul_program(dtype: str, m: int, k: int, n: int) -> CoreProgram:
+    left_type = CoreType.tensor(dtype, (m, k))
+    right_type = CoreType.tensor(dtype, (k, n))
+    output_type = CoreType.tensor(dtype, (m, n))
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("output", output_type)
+    function = CoreFunction(
+        "pypto_x_linear",
+        (left, right),
+        (output,),
+        Region((Operation("matmul", (left, right), (output,)),)),
+    )
+    return CoreProgram(functions=(function,))
+
+
+def _resolve_native(loaded: Any, key: LinearKernelKey, artifact: Artifact) -> Any:
+    plans = tuple(getattr(loaded.target_ir, "plans", ()))
+    if len(plans) != 1:
+        raise PyPTOXBuildError(
+            "PyPTO-X linear artifact must contain exactly one plan, got {}".format(len(plans)),
+            reason_code="kernel_plan_mismatch",
+            details={"plans": len(plans)},
+        )
+    plan = plans[0]
+    matmul = getattr(plan, "matmul", None)
+    if getattr(plan, "operation", None) != "matmul" or matmul is None:
+        raise PyPTOXBuildError(
+            "PyPTO-X linear artifact plan is not a rank-2 matmul",
+            reason_code="kernel_plan_mismatch",
+            details={"operation": getattr(plan, "operation", None)},
+        )
+    if tuple(getattr(matmul, "batch_shape", ())):
+        raise PyPTOXBuildError(
+            "PyPTO-X linear kernel does not support batched matmul plans",
+            reason_code="kernel_plan_mismatch",
+            details={"batch_shape": list(getattr(matmul, "batch_shape", ()))},
+        )
+    actual = (int(matmul.m), int(matmul.k), int(matmul.n))
+    if actual != (key.m, key.k, key.n):
+        raise PyPTOXBuildError(
+            "PyPTO-X linear artifact plan shape {} does not match key {}".format(
+                actual, (key.m, key.k, key.n)
+            ),
+            reason_code="kernel_plan_mismatch",
+            details={"plan": actual, "key": [key.m, key.k, key.n]},
+        )
+    if normalize_dtype(getattr(plan, "dtype", None)) != key.dtype:
+        raise PyPTOXBuildError(
+            "PyPTO-X linear artifact plan dtype {!r} does not match key {!r}".format(
+                getattr(plan, "dtype", None), key.dtype
+            ),
+            reason_code="kernel_plan_mismatch",
+            details={"plan_dtype": str(getattr(plan, "dtype", None)), "key_dtype": key.dtype},
+        )
+    symbol = "ptx_avx512_matmul_{}".format(_DTYPE_NATIVE_SUFFIX[key.dtype])
+    try:
+        native = getattr(loaded.module, symbol)
+    except AttributeError as exc:
+        raise PyPTOXBuildError(
+            "PyPTO-X AVX-512 artifact does not export {!r}".format(symbol),
+            reason_code="kernel_symbol_missing",
+            details={"symbol": symbol, "artifact_digest": artifact.content_digest},
+        ) from exc
+    native.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_void_p,
+        ctypes.c_void_p,
+        ctypes.c_size_t,
+        ctypes.c_size_t,
+        ctypes.c_size_t,
+    ]
+    native.restype = None
+    return native
+
+
+class LinearKernelCache:
+    """Per-process kernel cache with an optional cross-process disk tier."""
+
+    def __init__(
+        self,
+        cache_dir: Optional[Any] = None,
+        *,
+        runtime: Optional[Avx512Runtime] = None,
+        disk_cache: bool = True,
+        max_entries: int = _DEFAULT_MAX_ENTRIES,
+        build_dir: Optional[Any] = None,
+    ) -> None:
+        if max_entries <= 0:
+            raise ValueError("max_entries must be positive")
+        self._lock = threading.RLock()
+        # Hot-path memory tier keyed by (dtype, M, K, N); the content digest is
+        # only computed when the key is cold (json+sha256 costs ~10 us).
+        self._memory: "OrderedDict[Tuple[str, int, int, int], LinearKernelEntry]" = OrderedDict()
+        self._digests: Dict[Tuple[str, int, int, int], str] = {}
+        self._runtime = runtime
+        self._disk_cache = bool(disk_cache)
+        self._cache_dir = Path(os.fspath(cache_dir)).expanduser() if cache_dir is not None else None
+        self._build_dir = Path(os.fspath(build_dir)).expanduser() if build_dir is not None else None
+        self._max_entries = int(max_entries)
+        self._stats: Dict[str, int] = {
+            "kernel_builds": 0,
+            "memory_hits": 0,
+            "disk_hits": 0,
+            "compile_calls": 0,
+            "load_failures": 0,
+            "unsupported": 0,
+        }
+        self._last_disk_error: Optional[str] = None
+
+    # -- configuration -------------------------------------------------
+    @property
+    def cache_dir(self) -> Optional[Path]:
+        if self._cache_dir is None and self._disk_cache:
+            self._cache_dir = default_cache_dir()
+        return self._cache_dir
+
+    @property
+    def disk_cache(self) -> bool:
+        return self._disk_cache
+
+    @property
+    def stats(self) -> Mapping[str, int]:
+        with self._lock:
+            return dict(self._stats)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        with self._lock:
+            return {
+                "cache_dir": str(self.cache_dir) if self.cache_dir is not None else None,
+                "disk_cache": self._disk_cache,
+                "entries": len(self._memory),
+                "max_entries": self._max_entries,
+                "stats": dict(self._stats),
+                "last_disk_error": self._last_disk_error,
+            }
+
+    # -- availability --------------------------------------------------
+    def runtime(self) -> Avx512Runtime:
+        with self._lock:
+            if self._runtime is None:
+                self._runtime = Avx512Runtime()
+            return self._runtime
+
+    def ensure_available(self, dtype: str) -> Avx512Runtime:
+        dtype = normalize_dtype(dtype)
+        runtime = self.runtime()
+        if not runtime.is_available():
+            with self._lock:
+                self._stats["unsupported"] += 1
+            status = runtime.availability()
+            raise PyPTOXUnsupportedError(
+                "PyPTO-X AVX-512 runtime is unavailable: {}".format(status.reason or status.reason_code),
+                reason_code="avx512_unavailable",
+                details=dict(status.to_dict()),
+            )
+        capability = runtime.capability
+        if dtype == "bf16" and not getattr(capability, "avx512bf16", False):
+            with self._lock:
+                self._stats["unsupported"] += 1
+            raise PyPTOXUnsupportedError(
+                "host does not report AVX-512 BF16 (required for the bf16 kernel)",
+                reason_code="avx512bf16_unavailable",
+                details=dict(capability.to_dict()),
+            )
+        if not getattr(capability, "fma", False):
+            with self._lock:
+                self._stats["unsupported"] += 1
+            raise PyPTOXUnsupportedError(
+                "host does not report FMA (required by the AVX-512 kernel variant)",
+                reason_code="fma_unavailable",
+                details=dict(capability.to_dict()),
+            )
+        return runtime
+
+    # -- kernel lookup -------------------------------------------------
+    def key(self, dtype: str, m: int, k: int, n: int) -> LinearKernelKey:
+        dtype = normalize_dtype(dtype)
+        if any(isinstance(value, bool) or not isinstance(value, int) or value <= 0 for value in (m, k, n)):
+            raise PyPTOXUnsupportedError(
+                "PyPTO-X linear requires positive M/K/N, got ({}, {}, {})".format(m, k, n),
+                reason_code="shape_unsupported",
+                details={"m": m, "k": k, "n": n},
+            )
+        target = linear_target(dtype)
+        return LinearKernelKey(dtype=dtype, m=int(m), k=int(k), n=int(n), target=target.to_dict())
+
+    def _fast_key(self, dtype: str, m: int, k: int, n: int) -> Tuple[str, int, int, int]:
+        dtype = normalize_dtype(dtype)
+        if any(isinstance(value, bool) or not isinstance(value, int) or value <= 0 for value in (m, k, n)):
+            raise PyPTOXUnsupportedError(
+                "PyPTO-X linear requires positive M/K/N, got ({}, {}, {})".format(m, k, n),
+                reason_code="shape_unsupported",
+                details={"m": m, "k": k, "n": n},
+            )
+        return dtype, int(m), int(k), int(n)
+
+    def get(self, dtype: str, m: int, k: int, n: int) -> LinearKernelEntry:
+        """Return a compiled kernel for ``(dtype, M, K, N)``, building at most once."""
+
+        fast = self._fast_key(dtype, m, k, n)
+        with self._lock:
+            memory = self._memory.get(fast)
+            if memory is not None:
+                self._memory.move_to_end(fast)
+                self._stats["memory_hits"] += 1
+                return memory
+        # Cold path: build the full content-addressed key/digest without the
+        # lock, then re-check under the lock so concurrent callers still build
+        # each kernel at most once per process.
+        key = self.key(*fast)
+        digest = key.digest
+        with self._lock:
+            memory = self._memory.get(fast)
+            if memory is not None:
+                self._memory.move_to_end(fast)
+                self._stats["memory_hits"] += 1
+                return memory
+            runtime = self.ensure_available(key.dtype)
+            entry = self._load_disk(runtime, key, digest)
+            if entry is None:
+                entry = self._compile(runtime, key, digest)
+            self._memory[fast] = entry
+            self._digests[fast] = digest
+            self._memory.move_to_end(fast)
+            while len(self._memory) > self._max_entries:
+                evicted, _ = self._memory.popitem(last=False)
+                self._digests.pop(evicted, None)
+            return entry
+
+    # -- disk tier -----------------------------------------------------
+    def _sidecar(self, digest: str) -> Path:
+        return self.cache_dir / "{}{}.json".format(_SIDECAR_PREFIX, digest[:32])
+
+    def _load_disk(self, runtime: Avx512Runtime, key: LinearKernelKey, digest: str) -> Optional[LinearKernelEntry]:
+        if not self._disk_cache or self.cache_dir is None:
+            return None
+        sidecar = self._sidecar(digest)
+        if not sidecar.is_file():
+            return None
+        try:
+            payload = json.loads(sidecar.read_text(encoding="utf-8"))
+            if payload.get("key") != key.to_dict():
+                raise ValueError("sidecar cache key does not match the requested key")
+            data = payload["artifact"]
+            target = TargetSpec(**dict(data["target"]))
+            artifact = Artifact(
+                format=data["format"],
+                entrypoint=data["entrypoint"],
+                target=target,
+                abi_version=data["abi_version"],
+                path=data["path"],
+                metadata=data["metadata"],
+                format_version=data["format_version"],
+            )
+            loaded = runtime.load(artifact)
+            native = _resolve_native(loaded, key, artifact)
+        except Exception as exc:  # sidecar/artifact is untrusted input: repair by rebuilding
+            self._stats["load_failures"] += 1
+            self._last_disk_error = "{}: {}".format(type(exc).__name__, exc)
+            return None
+        self._stats["disk_hits"] += 1
+        return LinearKernelEntry(key, artifact, loaded, native, disk_backed=True)
+
+    def _write_sidecar(self, key: LinearKernelKey, artifact: Artifact, digest: str) -> None:
+        if not self._disk_cache or self.cache_dir is None:
+            return
+        try:
+            self.cache_dir.mkdir(parents=True, exist_ok=True)
+            sidecar = self._sidecar(digest)
+            temporary = None
+            try:
+                descriptor, temporary = tempfile.mkstemp(
+                    prefix=sidecar.name + ".tmp.", dir=str(self.cache_dir)
+                )
+                with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+                    json.dump({"key": key.to_dict(), "artifact": artifact.to_dict()}, handle, sort_keys=True)
+                    handle.flush()
+                    os.fsync(handle.fileno())
+                os.replace(temporary, sidecar)
+                temporary = None
+            finally:
+                if temporary is not None:
+                    try:
+                        os.unlink(temporary)
+                    except OSError:
+                        pass
+        except Exception as exc:
+            # A read-only cache directory must not break execution.
+            self._last_disk_error = "{}: {}".format(type(exc).__name__, exc)
+
+    # -- build ---------------------------------------------------------
+    def _compile(self, runtime: Avx512Runtime, key: LinearKernelKey, digest: str) -> LinearKernelEntry:
+        self._stats["kernel_builds"] += 1
+        program = _matmul_program(key.dtype, key.m, key.k, key.n)
+        target = TargetSpec(**dict(key.target))
+        compiler = Avx512Compiler()
+        target_ir = compiler.lower(program, target)
+        build_dir = self._build_dir
+        if build_dir is None and self.cache_dir is not None:
+            build_dir = self.cache_dir / "build"
+        if build_dir is None:
+            build_dir = Path(tempfile.mkdtemp(prefix="pypto-x-torch-linear-"))
+        options = CompileOptions(
+            artifact_format=DEFAULT_ARTIFACT_FORMAT,
+            extra={"build_dir": str(build_dir)},
+        )
+        self._stats["compile_calls"] += 1
+        artifact = compiler.compile(target_ir, options)
+        loaded = runtime.load(artifact)
+        native = _resolve_native(loaded, key, artifact)
+        self._write_sidecar(key, artifact, digest)
+        return LinearKernelEntry(key, artifact, loaded, native, disk_backed=False)
+
+    # -- maintenance ---------------------------------------------------
+    def clear(self) -> None:
+        with self._lock:
+            self._memory.clear()
+            self._digests.clear()
+
+
+def default_cache_dir() -> Path:
+    """Return the cross-process cache directory (env override first)."""
+
+    override = os.environ.get("PYPTO_X_TORCH_CACHE_DIR")
+    if override:
+        return Path(override).expanduser()
+    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
+    return Path(base).expanduser() / "pypto_x" / "torch_linear"
+
+
+_DEFAULT_CACHE: Optional[LinearKernelCache] = None
+_DEFAULT_LOCK = threading.Lock()
+
+
+def linear_kernel_cache() -> LinearKernelCache:
+    """Return the process-global kernel cache, creating it lazily."""
+
+    global _DEFAULT_CACHE
+    with _DEFAULT_LOCK:
+        if _DEFAULT_CACHE is None:
+            _DEFAULT_CACHE = LinearKernelCache()
+        return _DEFAULT_CACHE
+
+
+def reset_linear_kernel_cache(cache: Optional[LinearKernelCache] = None) -> None:
+    """Test hook: replace the process-global cache (memory tier is dropped)."""
+
+    global _DEFAULT_CACHE
+    with _DEFAULT_LOCK:
+        _DEFAULT_CACHE = cache
+
+
+__all__ = [
+    "LINEAR_KERNEL_CACHE_VERSION",
+    "LinearKernelCache",
+    "LinearKernelEntry",
+    "LinearKernelKey",
+    "default_cache_dir",
+    "linear_kernel_cache",
+    "linear_target",
+    "normalize_dtype",
+    "reset_linear_kernel_cache",
+]
