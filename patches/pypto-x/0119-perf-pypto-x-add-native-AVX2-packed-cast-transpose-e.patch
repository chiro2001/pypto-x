+# --------------------------------------------------------------------------
+# packed transpose
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "shape",
+    ((1, 9), (7, 5), (5, 7), (16, 16), (17, 19), (40, 37), (65, 33)),
+)
+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_avx2_packed_transpose_matches_avx512_bit_for_bit(dtype, shape, tmp_path):
+    program = _transpose_program(dtype, shape)
+    _, avx2_artifact = _compile_avx2(program, tmp_path, name="avx2-{}".format(dtype))
+    _, avx512_artifact = _compile_avx512(
+        program, tmp_path, name="avx512-{}".format(dtype)
+    )
+    assert tuple(avx2_artifact.metadata["packed_kernel_operations"]) == ("transpose",)
+    assert tuple(avx2_artifact.metadata["native_layout_reorder_operations"]) == ("transpose",)
+    count = shape[0] * shape[1]
+    values = [((index % 23) - 11) * 0.25 for index in range(count)]
+    source = HostTensor(dtype, shape, values)
+    output_shape = (shape[1], shape[0])
+    expected = HostTensor.zeros(dtype, output_shape)
+    actual = HostTensor.zeros(dtype, output_shape)
+    _launch(avx512_artifact, [source], [expected], runtime=_avx512_runtime())
+    _launch(avx2_artifact, [source], [actual], runtime=_avx2_runtime())
+    assert _bit_signature(actual.data, dtype) == _bit_signature(expected.data, dtype)
+
+
+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_avx2_non_square_transpose_matches_the_scalar_runtime(dtype, tmp_path):
+    shape = (3, 11)
+    program = _transpose_program(dtype, shape)
+    _, artifact = _compile_avx2(program, tmp_path, name="transpose-scalar")
+    values = [float((index % 7) - 3) for index in range(shape[0] * shape[1])]
+    source = HostTensor(dtype, shape, values)
+    actual = HostTensor.zeros(dtype, (shape[1], shape[0]))
+    expected = _scalar_reference(program, [source], [actual])
+    _launch(artifact, [source], [actual], runtime=_avx2_runtime())
+    assert _bit_signature(actual.data, dtype) == _bit_signature(expected[0].data, dtype)
+
+
+def test_avx2_rank3_transpose_stays_on_the_host_reference(tmp_path):
+    program = _transpose_program("float32", (2, 3, 4), permutation=(0, 2, 1))
+    target_ir, artifact = _compile_avx2(program, tmp_path, name="rank3")
+    assert tuple(artifact.metadata["packed_kernel_operations"]) == ()
+    assert "transpose" in tuple(artifact.metadata["host_reference_operations"])
+    contract = packed_kernel_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is None
+    source = HostTensor("float32", (2, 3, 4), [float(index) for index in range(24)])
+    actual = HostTensor.zeros("float32", (2, 4, 3))
+    expected = _scalar_reference(program, [source], [actual])
+    _launch(artifact, [source], [actual], runtime=_avx2_runtime())
+    assert _bit_signature(actual.data, "float32") == _bit_signature(
+        expected[0].data, "float32"
+    )
