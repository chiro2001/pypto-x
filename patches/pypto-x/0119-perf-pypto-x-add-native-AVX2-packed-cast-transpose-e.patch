+def test_avx2_packed_metadata_records_the_exact_plane(tmp_path):
+    program = _cast_program("bf16", "float32", (10,))
+    _, artifact = _compile_avx2(program, tmp_path, name="plane")
+    metadata = artifact.metadata
+    assert metadata["packed_kernel_version"] == 1
+    assert tuple(metadata["packed_kernel_operations"]) == ("cast",)
+    entry = dict(metadata["packed_operations"][0])
+    assert entry == {
+        "operation_index": 0,
+        "operation": "cast",
+        "mode": PACKED_CAST_MODE,
+        "kernel": "cast_bf16_f32",
+        "source_dtype": "bf16",
+        "target_dtype": "float32",
+    }
+    assert tuple(metadata["host_reference_operations"]) == ()
