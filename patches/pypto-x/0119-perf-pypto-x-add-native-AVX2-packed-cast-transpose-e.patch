+def test_avx2_large_embedding_never_expands_the_table(monkeypatch, tmp_path):
+    """A parameter-scale table must not be turned into per-element Python values."""
+
+    table_shape = (1 << 12, 64)
+    program = _embedding_program("bf16", table_shape, (3,))
+    _, artifact = _compile_avx2(program, tmp_path, name="embedding-large")
+    table = HostTensor.zeros("bf16", table_shape)
+    table.data[5 * table_shape[1]] = 1.5
+    table.data[9 * table_shape[1] + 3] = -2.25
+    indices = HostTensor("int64", (3,), [9, 5, 9])
+    actual = HostTensor.zeros("bf16", (3, table_shape[1]))
+
+    expanded = []
+    original = avx2_runtime._buffer_values
+
+    def guarded(buffer):
+        if buffer.count > 4096:
+            expanded.append(buffer.count)
+            raise AssertionError("packed path expanded a large buffer into Python values")
+        return original(buffer)
+
+    monkeypatch.setattr(avx2_runtime, "_buffer_values", guarded)
+    _launch(artifact, [table, indices], [actual], runtime=_avx2_runtime())
+    assert expanded == []
+    assert actual.data[0] == actual.data[2 * table_shape[1]]
+    assert float(actual.data[3]) == pytest.approx(-2.25)
+    assert float(actual.data[table_shape[1]]) == pytest.approx(1.5)
+
