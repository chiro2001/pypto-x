+# fail-closed
+# --------------------------------------------------------------------------
+
+
+def _original_metadata(artifact):
+    return dict(mapping_copy(artifact.metadata))
+
+
+def _tampered_metadata(original, **updates):
+    metadata = dict(original)
+    for key, value in updates.items():
+        if value is None:
+            metadata.pop(key, None)
+        else:
+            metadata[key] = value
+    return metadata
+
+
+def test_avx2_payload_one_metadata_fails_closed(tmp_path):
+    program = _cast_program("bf16", "float32", (10,))
+    _, artifact = _compile_avx2(program, tmp_path, name="payload")
+    runtime = _avx2_runtime()
+    original = _original_metadata(artifact)
+
+    object.__setattr__(
+        artifact, "metadata", _tampered_metadata(original, artifact_payload_version=1)
+    )
+    with pytest.raises(CpuAvx2ArtifactError, match="payload version"):
+        runtime.load(artifact)
+
+    object.__setattr__(
+        artifact, "metadata", _tampered_metadata(original, lowering_version=1)
+    )
+    with pytest.raises(CpuAvx2ArtifactError, match="lowering version"):
+        runtime.load(artifact)
+
+    object.__setattr__(artifact, "metadata", original)
+
+
+def test_avx2_missing_or_tampered_packed_metadata_fails_closed(tmp_path):
+    program = _cast_program("bf16", "float32", (10,))
+    _, artifact = _compile_avx2(program, tmp_path, name="packed-meta")
+    runtime = _avx2_runtime()
+    original = _original_metadata(artifact)
+
+    # Defense in depth: even with the current payload version, a stripped or
+    # rewritten packed plane must not load.
+    object.__setattr__(
