+/* ------------------------------------------------------------------ *
+ * Packed parameter-scale kernels (artifact payload version 2).
+ *
+ * These kernels exist so that parameter-sized tensors (embedding tables,
+ * promoted weights) never pass through a per-element Python list.  They
+ * operate on caller-owned packed buffers and are bit-exact with both the
+ * vector-common host reference and the AVX-512 packed plane:
+ *   - f32 -> bf16 uses the same round-to-nearest-even bit rounding as
+ *     pypto.backends.cpu.tensor._round_bf16 / _bf16_bits (non-finite
+ *     values truncate, exactly like the reference),
+ *   - bf16 -> f32 is an exact left shift,
+ *   - transpose is a pure element permutation of one rank-2 matrix,
+ *   - embedding copies whole source rows selected by int64 indices; index
+ *     bounds are validated by the runtime before this call.
+ * ------------------------------------------------------------------ */
+
+__attribute__((visibility("default")))
+void ptx_avx2_cast_f32_bf16(const float *input, uint16_t *output, size_t n) {
+    size_t i = 0;
+    const __m256i bias = _mm256_set1_epi32(0x7fff);
+    const __m256i low_bit = _mm256_set1_epi32(1);
+    const __m256i exponent_mask = _mm256_set1_epi32(0x7f800000);
+    for (; i + 16 <= n; i += 16) {
+        __m256i first = _mm256_castps_si256(_mm256_loadu_ps(input + i));
+        __m256i second = _mm256_castps_si256(_mm256_loadu_ps(input + i + 8));
+        __m256i first_special = _mm256_cmpeq_epi32(
+            _mm256_and_si256(first, exponent_mask), exponent_mask);
+        __m256i second_special = _mm256_cmpeq_epi32(
+            _mm256_and_si256(second, exponent_mask), exponent_mask);
+        __m256i first_rounding = _mm256_add_epi32(
+            bias, _mm256_and_si256(_mm256_srli_epi32(first, 16), low_bit));
+        __m256i second_rounding = _mm256_add_epi32(
+            bias, _mm256_and_si256(_mm256_srli_epi32(second, 16), low_bit));
+        __m256i first_rounded = _mm256_srli_epi32(_mm256_add_epi32(first, first_rounding), 16);
+        __m256i second_rounded = _mm256_srli_epi32(_mm256_add_epi32(second, second_rounding), 16);
+        __m256i first_truncated = _mm256_srli_epi32(first, 16);
+        __m256i second_truncated = _mm256_srli_epi32(second, 16);
+        __m256i first_selected = _mm256_blendv_epi8(first_rounded, first_truncated, first_special);
+        __m256i second_selected = _mm256_blendv_epi8(second_rounded, second_truncated, second_special);
+        __m256i packed = _mm256_packus_epi32(first_selected, second_selected);
+        packed = _mm256_permute4x64_epi64(packed, 0xD8);
+        _mm256_storeu_si256((__m256i *)(output + i), packed);
+    }
+    for (; i < n; ++i) output[i] = ptx_f32_to_bf16(input[i]);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_cast_bf16_f32(const uint16_t *input, float *output, size_t n) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        __m128i packed = _mm_loadu_si128((const __m128i *)(input + i));
+        __m256i widened = _mm256_cvtepu16_epi32(packed);
+        _mm256_storeu_ps(output + i, _mm256_castsi256_ps(_mm256_slli_epi32(widened, 16)));
+    }
+    for (; i < n; ++i) output[i] = ptx_bf16_to_f32(input[i]);
+}
+
+#define PTX_TRANSPOSE_BLOCK 32
+
+#define PTX_DEFINE_TRANSPOSE(NAME, TYPE)                                        \
+__attribute__((visibility("default")))                                          \
+void NAME(const TYPE *restrict input, TYPE *restrict output,                    \
+          size_t rows, size_t cols) {                                           \
+    size_t row, column, row_block, column_block;                                 \
+    for (row_block = 0; row_block < rows; row_block += PTX_TRANSPOSE_BLOCK) {    \
+        size_t row_end = row_block + PTX_TRANSPOSE_BLOCK;                        \
+        if (row_end > rows) row_end = rows;                                      \
+        for (column_block = 0; column_block < cols; column_block += PTX_TRANSPOSE_BLOCK) { \
+            size_t column_end = column_block + PTX_TRANSPOSE_BLOCK;              \
+            if (column_end > cols) column_end = cols;                            \
+            for (row = row_block; row < row_end; ++row)                          \
+                for (column = column_block; column < column_end; ++column)       \
+                    output[column * rows + row] = input[row * cols + column];    \
+        }                                                                        \
+    }                                                                            \
+}
+
+PTX_DEFINE_TRANSPOSE(ptx_avx2_transpose_f32, float)
+PTX_DEFINE_TRANSPOSE(ptx_avx2_transpose_bf16, uint16_t)
+
+#define PTX_DEFINE_EMBEDDING(NAME, TYPE)                                        \
+__attribute__((visibility("default")))                                          \
+void NAME(const TYPE *restrict table, const int64_t *restrict indices,          \
+          TYPE *restrict output, size_t index_count, size_t row_elements) {      \
+    size_t index, element;                                                       \
+    for (index = 0; index < index_count; ++index) {                              \
+        const TYPE *row = table + (size_t)indices[index] * row_elements;         \
+        TYPE *destination = output + index * row_elements;                       \
+        for (element = 0; element < row_elements; ++element)                     \
+            destination[element] = row[element];                                 \
+    }                                                                            \
+}
+
+PTX_DEFINE_EMBEDDING(ptx_avx2_embedding_f32, float)
+PTX_DEFINE_EMBEDDING(ptx_avx2_embedding_bf16, uint16_t)
 '''
 
 
