+    _, artifact = _compile_avx2(program, tmp_path, name="embedding-2d")
+    assert tuple(artifact.metadata["packed_kernel_operations"]) == ("embedding",)
+    table = HostTensor("float32", table_shape, [float(index) for index in range(20)])
+    indices = HostTensor("int64", index_shape, [4, 0, 2, 2, 4, 1])
+    actual = HostTensor.zeros("float32", index_shape + (4,))
+    expected = _scalar_reference(program, [table, indices], [actual])
+    _launch(artifact, [table, indices], [actual], runtime=_avx2_runtime())
+    assert _bit_signature(actual.data, "float32") == _bit_signature(
+        expected[0].data, "float32"
+    )
