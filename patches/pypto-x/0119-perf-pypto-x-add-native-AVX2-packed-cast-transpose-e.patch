+def _core_operations(target_ir: Avx2Program) -> tuple:
+    """Return the entrypoint operations in plan order."""
+
+    for function in target_ir.program.functions:
+        if function.name == target_ir.entrypoint:
+            return tuple(function.body.operations)
+    raise ValueError("AVX2 entrypoint {!r} is missing from the program".format(target_ir.entrypoint))
+
+
+#: Packed native kernel plane.  The runtime selects kernels with the exact
+#: same predicate that produces this metadata, so an artifact cannot claim a
+#: packed kernel the runtime would not use (or vice versa).
+PACKED_KERNEL_VERSION = 1
+PACKED_CAST_MODE = "native_avx2_packed_cast"
+PACKED_TRANSPOSE_MODE = "native_avx2_packed_transpose"
+PACKED_EMBEDDING_MODE = "native_avx2_packed_embedding"
+_PACKED_DTYPES = frozenset(("float32", "bf16"))
+_PACKED_TENSOR_KINDS = frozenset(("tensor", "view", "tile"))
+
+
+def _packed_suffix(dtype: str) -> str:
+    return "f32" if canonical_dtype(dtype) == "float32" else "bf16"
+
+
+def packed_kernel_contract(operation: Any, plan: Any) -> Optional[dict]:
+    """Describe the packed native kernel for one operation, or ``None``.
+
+    ``None`` means the operation stays on the vector-common host reference.
+    The runtime and the artifact metadata both call this predicate, so a
+    declared kernel and the executed kernel can never disagree.  The shape of
+    the contract mirrors the frozen AVX-512 packed plane; only the mode and
+    symbol names are AVX2-specific.
+    """
+
+    if operation is None or plan is None:
+        return None
+    name = canonical_operation_name(operation.name)
+    if name != plan.operation:
+        return None
+    if name == "cast":
+        if plan.plan_kind != "elementwise":
+            return None
+        if len(operation.inputs) != 1 or len(operation.outputs) != 1:
+            return None
+        source_type = operation.inputs[0].type
+        target_type = operation.outputs[0].type
+        if source_type.kind not in _PACKED_TENSOR_KINDS or target_type.kind not in _PACKED_TENSOR_KINDS:
+            return None
+        source_dtype = canonical_dtype(source_type.dtype)
+        target_dtype = canonical_dtype(target_type.dtype)
+        if source_dtype not in _PACKED_DTYPES or target_dtype not in _PACKED_DTYPES:
+            return None
+        if source_dtype == target_dtype:
+            kernel = "copy_{}".format(_packed_suffix(source_dtype))
+        else:
+            kernel = "cast_{}_{}".format(_packed_suffix(source_dtype), _packed_suffix(target_dtype))
+        return {
+            "mode": PACKED_CAST_MODE,
+            "kernel": kernel,
+            "source_dtype": source_dtype,
+            "target_dtype": target_dtype,
+        }
+    if name == "transpose":
+        layout = plan.layout_plan
+        if layout is None or layout.operation != "transpose" or layout.kind != "transpose":
+            return None
+        if len(layout.input_shape) != 2 or tuple(layout.permutation) != (1, 0):
+            return None
+        if any(layout.slice_starts) or any(step != 1 for step in layout.slice_steps):
+            return None
+        source_dtype = canonical_dtype(operation.inputs[0].type.dtype)
+        target_dtype = canonical_dtype(operation.outputs[0].type.dtype)
+        if source_dtype != target_dtype or source_dtype not in _PACKED_DTYPES:
+            return None
+        return {
+            "mode": PACKED_TRANSPOSE_MODE,
+            "kernel": "transpose_{}".format(_packed_suffix(source_dtype)),
+            "source_dtype": source_dtype,
+            "target_dtype": target_dtype,
+            "rows": int(layout.input_shape[0]),
+            "columns": int(layout.input_shape[1]),
+        }
+    if name == "embedding":
+        indexing = plan.indexing_plan
+        if indexing is None or indexing.operation != "embedding" or indexing.axis != 0:
+            return None
+        if len(indexing.source_shape) != 2:
+            return None
+        source_dtype = canonical_dtype(operation.inputs[0].type.dtype)
+        target_dtype = canonical_dtype(operation.outputs[0].type.dtype)
+        index_dtype = canonical_dtype(operation.inputs[1].type.dtype)
+        if source_dtype != target_dtype or source_dtype not in _PACKED_DTYPES:
+            return None
+        if index_dtype != "int64":
+            return None
+        return {
+            "mode": PACKED_EMBEDDING_MODE,
+            "kernel": "embedding_{}".format(_packed_suffix(source_dtype)),
+            "source_dtype": source_dtype,
+            "target_dtype": target_dtype,
+            "table_rows": int(indexing.source_shape[0]),
+            "row_elements": int(indexing.source_shape[1]),
+        }
+    return None
+
