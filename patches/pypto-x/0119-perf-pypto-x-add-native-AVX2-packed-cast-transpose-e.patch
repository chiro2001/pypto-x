+# --------------------------------------------------------------------------
+# packed embedding
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("table_shape", ((7, 5), (1, 1), (3, 1), (2, 17)))
+@pytest.mark.parametrize("dtype", ("bf16", "float32"))
+def test_avx2_packed_embedding_matches_avx512_bit_for_bit(dtype, table_shape, tmp_path):
+    program = _embedding_program(dtype, table_shape, (4,))
+    _, avx2_artifact = _compile_avx2(program, tmp_path, name="avx2-embedding")
+    _, avx512_artifact = _compile_avx512(program, tmp_path, name="avx512-embedding")
+    assert tuple(avx2_artifact.metadata["packed_kernel_operations"]) == ("embedding",)
+    assert avx2_artifact.metadata["packed_operations"][0]["mode"] == PACKED_EMBEDDING_MODE
+    table_rows, row_elements = table_shape
+    table = HostTensor(
+        dtype, table_shape, [0.5 + index for index in range(table_rows * row_elements)]
+    )
+    # boundary rows: first, last, repeat, and a middle row.
+    indices = HostTensor(
+        "int64", (4,), [0, table_rows - 1, table_rows - 1, table_rows // 2]
+    )
+    expected = HostTensor.zeros(dtype, (4, row_elements))
+    actual = HostTensor.zeros(dtype, (4, row_elements))
+    _launch(avx512_artifact, [table, indices], [expected], runtime=_avx512_runtime())
+    _launch(avx2_artifact, [table, indices], [actual], runtime=_avx2_runtime())
+    assert _bit_signature(actual.data, dtype) == _bit_signature(expected.data, dtype)
+
