+def test_avx2_old_abi_marker_artifact_fails_closed(tmp_path):
+    program = _cast_program("bf16", "float32", (10,))
+    _, artifact = _compile_avx2(program, tmp_path, name="legacy-marker")
+    current_marker = b"pypto-x.cpu.avx2:3"
+    legacy_marker = b"pypto-x.cpu.avx2:2"
+    native_bytes = Path(artifact.path).read_bytes()
+    assert current_marker in native_bytes
+    legacy_bytes = native_bytes.replace(current_marker, legacy_marker)
+    assert len(legacy_bytes) == len(native_bytes)
+    # Keep the content-addressed file name so the compile-command binding check
+    # passes and the ABI marker check is reached.
+    legacy_dir = tmp_path / "legacy-artifacts"
+    legacy_dir.mkdir()
+    legacy_path = legacy_dir / Path(artifact.path).name
+    legacy_path.write_bytes(legacy_bytes)
+    metadata = _original_metadata(artifact)
+    metadata["native_digest"] = hashlib.sha256(legacy_bytes).hexdigest()
+    legacy_artifact = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(legacy_path),
+        metadata=metadata,
+    )
+    with pytest.raises(CpuAvx2ArtifactError, match="safety marker"):
+        _avx2_runtime().load(legacy_artifact)
