+    def _execute_packed(
+        self,
+        packed: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        inputs: Sequence[_RuntimeValue],
+        module: Any,
+    ) -> Mapping[str, _RuntimeValue]:
+        """Run one packed parameter-scale kernel on caller-owned buffers.
+
+        The descriptor comes from :func:`packed_kernel_contract`, the same
+        predicate that produced the artifact metadata, so the declared kernel
+        and the launched kernel cannot disagree.
+        """
+
+        mode = packed["mode"]
+        kernel = packed["kernel"]
+        output_ref = operation.outputs[0]
+        target_dtype = canonical_dtype(output_ref.type.dtype)
+        if not inputs:
+            raise CpuAvx2ArtifactError("AVX2 packed operation has no input buffer")
+        source = inputs[0].buffer
+        count = int(plan.element_count)
+        if mode == PACKED_CAST_MODE:
+            # A cast is elementwise: the plan domain is both the source and the
+            # destination element count.
+            if source.count != count:
+                raise CpuAvx2ArtifactError(
+                    "AVX2 packed cast input element count {} does not match plan {}".format(
+                        source.count, count
+                    )
+                )
+            destination = _buffer_alloc(target_dtype, count, output_ref.name)
+            _call_packed_cast(
+                module,
+                kernel,
+                packed["source_dtype"],
+                target_dtype,
+                source,
+                destination,
+                count,
+            )
+        elif mode == PACKED_TRANSPOSE_MODE:
+            rows = int(packed["rows"])
+            columns = int(packed["columns"])
+            if rows <= 0 or columns <= 0 or source.count != rows * columns or count != rows * columns:
+                raise CpuAvx2ArtifactError("AVX2 packed transpose descriptor is invalid")
+            destination = _buffer_alloc(target_dtype, count, output_ref.name)
+            _call_packed_transpose(module, kernel, source, destination, rows, columns)
+        elif mode == PACKED_EMBEDDING_MODE:
+            if len(inputs) != 2:
+                raise CpuAvx2ArtifactError("AVX2 packed embedding requires table and indices")
+            index_buffer = inputs[1].buffer
+            table_rows = int(packed["table_rows"])
+            row_elements = int(packed["row_elements"])
+            if source.count != table_rows * row_elements or index_buffer.count * row_elements != count:
+                raise CpuAvx2ArtifactError("AVX2 packed embedding descriptor is invalid")
+            for position in range(index_buffer.count):
