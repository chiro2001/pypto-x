+def test_avx2_mixed_packed_program_matches_scalar_and_avx512(tmp_path):
+    """cast -> transpose -> embedding in one program, all on the packed plane."""
+
+    source = ValueRef("source", CoreType.tensor("bf16", (4, 6)))
+    cast_value = ValueRef("cast_value", CoreType.tensor("float32", (4, 6)))
+    transposed = ValueRef("transposed", CoreType.tensor("float32", (6, 4)))
+    indices = ValueRef("indices", CoreType.tensor("int64", (3,)))
+    output = ValueRef("output", CoreType.tensor("float32", (3, 4)))
+    program = _program(
+        "mixed",
+        (source, indices),
+        (output,),
+        (
+            Operation("cast", (source,), (cast_value,), {"dtype": "float32"}),
+            Operation("transpose", (cast_value,), (transposed,), {"permutation": [1, 0]}),
+            Operation("embedding", (transposed, indices), (output,), {"axis": 0}),
+        ),
+    )
+    target_ir, artifact = _compile_avx2(program, tmp_path, name="mixed-avx2")
+    _, avx512_artifact = _compile_avx512(program, tmp_path, name="mixed-avx512")
+    modes = [item["mode"] for item in artifact.metadata["execution_modes"]]
+    assert modes == [PACKED_CAST_MODE, PACKED_TRANSPOSE_MODE, PACKED_EMBEDDING_MODE]
+    assert tuple(artifact.metadata["packed_kernel_operations"]) == (
+        "cast",
+        "transpose",
+        "embedding",
+    )
+    contracts = [
+        packed_kernel_contract(operation, plan)
+        for operation, plan in zip(program.functions[0].body.operations, target_ir.plans)
+    ]
+    assert [contract["mode"] for contract in contracts] == modes
+
+    source_tensor = HostTensor("bf16", (4, 6), [0.25 * index for index in range(24)])
+    indices_tensor = HostTensor("int64", (3,), [5, 0, 2])
+    actual = HostTensor.zeros("float32", (3, 4))
+    expected_avx512 = HostTensor.zeros("float32", (3, 4))
+    expected_scalar = _scalar_reference(
+        program, [source_tensor, indices_tensor], [actual]
+    )
+    _launch(artifact, [source_tensor, indices_tensor], [actual], runtime=_avx2_runtime())
+    _launch(
+        avx512_artifact,
+        [source_tensor, indices_tensor],
+        [expected_avx512],
+        runtime=_avx512_runtime(),
+    )
+    assert actual.data == expected_scalar[0].data
+    assert _bit_signature(actual.data, "float32") == _bit_signature(
+        expected_avx512.data, "float32"
+    )
+
