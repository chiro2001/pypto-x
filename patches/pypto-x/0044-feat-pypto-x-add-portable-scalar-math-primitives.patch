 def _reduce_value(
     name: str,
     values: Sequence[Any],
@@ -470,6 +611,13 @@ def _reduce_value(
             aggregate = 0
             for value in candidates:
                 aggregate += value
+        elif name == "reduce_mean":
+            if not candidates:
+                raise CpuScalarExecutionError("reduce_mean has an empty reduction group")
+            aggregate = 0
+            for value in candidates:
+                aggregate += value
+            aggregate /= len(candidates)
         else:
             if not candidates:
                 raise CpuScalarExecutionError("reduce_max has an empty reduction group")
@@ -531,6 +679,17 @@ def _unravel(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
     return tuple(coordinates)
 
 
+def _ravel(coordinates: Sequence[int], shape: Sequence[int]) -> int:
+    if len(coordinates) != len(shape):
+        raise CpuScalarExecutionError("coordinate rank does not match shape rank")
+    index = 0
+    for coordinate, dimension in zip(coordinates, shape):
+        if coordinate < 0 or coordinate >= dimension:
+            raise CpuScalarExecutionError("coordinate is outside tensor shape")
+        index = index * dimension + coordinate
+    return index
+
