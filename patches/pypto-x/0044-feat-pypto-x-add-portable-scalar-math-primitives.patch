+def _cast_value_for_operation(value: Any, output_type: CoreType) -> Any:
+    """Cast a scalar or flat tensor to the already-validated output dtype."""
+
+    dtype = canonical_dtype(output_type.dtype)
+    if isinstance(value, list):
+        return [_cast_value(item, dtype) for item in value]
+    return _cast_value(value, dtype)
+
+
+def _math_scalar(name: str, value: Any) -> Any:
+    """Evaluate one portable scalar math primitive with stable edge handling."""
+
+    value = float(value)
+    if name == "exp":
+        return math.exp(value)
+    if name == "rsqrt":
+        if value <= 0.0:
+            raise CpuScalarExecutionError("rsqrt input must be greater than zero")
+        return 1.0 / math.sqrt(value)
+    if name == "sigmoid":
+        # Avoid exp(-x) overflow for large negative x.
+        if value >= 0.0:
+            return 1.0 / (1.0 + math.exp(-value))
+        exp_value = math.exp(value)
+        return exp_value / (1.0 + exp_value)
+    if name == "silu":
+        if value == float("-inf"):
+            return 0.0
+        if value == float("inf"):
+            return value
+        if value >= 0.0:
+            sigmoid = 1.0 / (1.0 + math.exp(-value))
+        else:
+            exp_value = math.exp(value)
+            sigmoid = exp_value / (1.0 + exp_value)
+        return value * sigmoid
+    if name == "softplus":
+        # log1p(exp(-abs(x))) + max(x, 0) is finite for the useful finite
+        # range and does not overflow on large positive activations.
+        return math.log1p(math.exp(-abs(value))) + max(value, 0.0)
+    raise CpuScalarExecutionError("unsupported scalar math operation {!r}".format(name))
+
+
+def _math_value(name: str, value: Any, output_type: CoreType) -> Any:
+    dtype = canonical_dtype(output_type.dtype)
+    if isinstance(value, list):
+        return [_cast_value(_math_scalar(name, item), dtype) for item in value]
+    return _cast_value(_math_scalar(name, value), dtype)
+
