+def _broadcast_value(value: Any, input_type: CoreType, output_type: CoreType) -> List[Any]:
+    """Materialize a validated logical broadcast into a flat output tensor."""
+
+    output_shape = static_shape(output_type, "broadcast output")
+    output_count = element_count(output_shape)
+    output_dtype = canonical_dtype(output_type.dtype)
+    if _is_scalar(input_type):
+        return [_cast_value(value, output_dtype) for _ in range(output_count)]
+    input_shape = static_shape(input_type, "broadcast input")
+    if not isinstance(value, list) or len(value) != element_count(input_shape):
+        raise CpuScalarExecutionError("broadcast input storage length mismatch")
+    rank_delta = len(output_shape) - len(input_shape)
+    result = []
+    for output_index in range(output_count):
+        output_coords = _unravel(output_index, output_shape)
+        input_coords = []
+        for axis, dimension in enumerate(input_shape):
+            output_axis = axis + rank_delta
+            coordinate = output_coords[output_axis]
+            input_coords.append(0 if dimension == 1 else coordinate)
+        input_index = _ravel(input_coords, input_shape)
+        result.append(_cast_value(value[input_index], output_dtype))
+    return result
+
+
+def _where_value(
+    condition: Any,
+    condition_type: CoreType,
+    true_value: Any,
+    true_type: CoreType,
+    false_value: Any,
+    false_type: CoreType,
+    output_type: CoreType,
+) -> Any:
+    """Execute a validated, trailing-axis broadcasted selection."""
+
+    output_shape = static_shape(output_type, "where output") if _is_tensor(output_type) else ()
+    output_count = element_count(output_shape) if _is_tensor(output_type) else 1
+    output_dtype = canonical_dtype(output_type.dtype)
+    sources = (
+        (condition, condition_type, "where condition"),
+        (true_value, true_type, "where input"),
+        (false_value, false_type, "where other"),
+    )
+    prepared = []
+    for value, value_type, context in sources:
+        if _is_scalar(value_type):
+            prepared.append((value, value_type, None))
+            continue
+        input_shape = static_shape(value_type, context)
+        if not isinstance(value, list) or len(value) != element_count(input_shape):
+            raise CpuScalarExecutionError("{} storage length mismatch".format(context))
+        prepared.append((value, value_type, input_shape))
+
+    def source_at(item: Tuple[Any, CoreType, Any], output_coords: Tuple[int, ...]) -> Any:
+        value, value_type, input_shape = item
+        if input_shape is None:
+            return value
+        rank_delta = len(output_shape) - len(input_shape)
+        coordinates = []
+        for axis, dimension in enumerate(input_shape):
+            coordinate = output_coords[axis + rank_delta]
+            coordinates.append(0 if dimension == 1 else coordinate)
+        return value[_ravel(coordinates, input_shape)]
+
+    selected = []
+    for output_index in range(output_count):
+        coordinates = _unravel(output_index, output_shape)
+        predicate = source_at(prepared[0], coordinates)
+        selected_value = source_at(prepared[1], coordinates) if predicate else source_at(prepared[2], coordinates)
+        selected.append(_cast_value(selected_value, output_dtype))
+    return selected[0] if _is_scalar(output_type) else selected
+
