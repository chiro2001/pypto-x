+def _broadcast_shape(shapes: Sequence[Sequence[int]], context: str) -> Tuple[int, ...]:
+    """Return the trailing-axis broadcast shape for concrete tensor shapes.
+
+    The scalar reference uses the same logical rule for ``broadcast`` and
+    ``where``.  A zero-sized axis is compatible with a singleton axis and
+    remains zero, which lets empty tensors stay empty without touching a
+    source element.
+    """
+
+    normalized = [tuple(shape) for shape in shapes]
+    rank = max((len(shape) for shape in normalized), default=0)
+    result = []
+    for offset in range(1, rank + 1):
+        dimensions = [shape[-offset] for shape in normalized if len(shape) >= offset]
+        non_singleton = [dimension for dimension in dimensions if dimension != 1]
+        if not non_singleton:
+            result.append(1)
+            continue
+        if all(dimension in (0, 1) for dimension in dimensions):
+            result.append(0 if 0 in dimensions else 1)
+            continue
+        first = non_singleton[0]
+        if any(dimension != first for dimension in non_singleton):
+            raise CpuScalarValidationError(
+                "{} shapes {} are not broadcast-compatible".format(context, normalized)
+            )
+        result.append(first)
+    return tuple(reversed(result))
+
+
+def _shape_attribute(attributes: Mapping[str, Any], context: str) -> Optional[Tuple[int, ...]]:
+    """Read an optional target shape using the Core operation attribute spellings."""
+
+    present = [key for key in ("shape", "target_shape", "out_shape") if key in attributes]
+    if not present:
+        return None
+    if len(present) > 1:
+        values = [attributes[key] for key in present]
+        if any(value != values[0] for value in values[1:]):
+            raise CpuScalarValidationError("{} contains conflicting target shape attributes".format(context))
+    raw = attributes[present[0]]
+    if isinstance(raw, (str, bytes)):
+        raise CpuScalarValidationError("{} shape must be a sequence of non-negative integers".format(context))
+    try:
+        dimensions = tuple(raw)
+    except TypeError as exc:
+        raise CpuScalarValidationError("{} shape must be a sequence of non-negative integers".format(context)) from exc
+    for index, dimension in enumerate(dimensions):
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise CpuScalarValidationError(
+                "{} shape[{}] must be a non-negative integer".format(context, index)
+            )
+    return dimensions
+
+
+def _cast_target_dtype(operation: Operation, output_type: CoreType, context: str) -> str:
+    """Validate optional cast target attributes against the output CoreType."""
+
+    keys = ("dtype", "to", "target_dtype", "out_dtype")
+    present = [key for key in keys if key in _attrs(operation)]
+    output_dtype = canonical_dtype(output_type.dtype)
+    if not present:
+        return output_dtype
+    normalized = []
+    for key in present:
+        try:
+            normalized.append(canonical_dtype(_attrs(operation)[key]))
+        except (TypeError, ValueError) as exc:
+            raise CpuScalarValidationError("{} cast target dtype is invalid".format(context)) from exc
+    if any(value != normalized[0] for value in normalized[1:]) or normalized[0] != output_dtype:
+        raise CpuScalarValidationError(
+            "{} cast target dtype does not match output dtype {!r}".format(context, output_type.dtype)
+        )
+    return output_dtype
+
+
+def _validate_cast_attributes(operation: Operation, context: str) -> None:
+    """Reject cast modes that the portable scalar contract cannot reproduce."""
+
+    for key in ("mode", "cast_mode"):
+        if key not in _attrs(operation):
+            continue
+        value = _attrs(operation)[key]
+        text = str(getattr(value, "value", value)).strip().lower()
+        if text not in ("none", "cast_none", "0"):
+            raise CpuScalarUnsupportedError(
+                "{} cast mode {!r} is unsupported; only CAST_NONE is portable".format(context, value)
+            )
+    for key in ("satmode", "saturation", "saturate"):
+        if key not in _attrs(operation):
+            continue
+        value = _attrs(operation)[key]
+        text = str(getattr(value, "value", value)).strip().lower()
+        if text not in ("off", "false", "0") and value is not False:
+            raise CpuScalarUnsupportedError(
+                "{} cast saturation {!r} is unsupported in the scalar portable subset".format(context, value)
+            )
+
+
+def _validate_unary_math(operation: Operation, context: str) -> None:
+    if len(operation.inputs) != 1:
+        raise CpuScalarValidationError(
+            "{} {} requires one input".format(context, canonical_operation_name(operation.name))
+        )
+    output_type = _one_output(operation, canonical_operation_name(operation.name))
+    input_type = operation.inputs[0].type
+    if not (_is_tensor(input_type) or _is_scalar(input_type)) or not (
+        _is_tensor(output_type) or _is_scalar(output_type)
+    ):
+        raise CpuScalarUnsupportedError("{} unary math only supports tensor/scalar values".format(context))
+    _validate_dtype(input_type, context + ".input")
+    _validate_dtype(output_type, context + ".output")
+    if input_type.kind != output_type.kind or canonical_dtype(input_type.dtype) != canonical_dtype(output_type.dtype):
+        raise CpuScalarValidationError("{} unary input and output must have matching kind and dtype".format(context))
+    if _is_tensor(input_type) and input_type.shape != output_type.shape:
+        raise CpuScalarValidationError("{} unary input and output shapes must match".format(context))
+    if canonical_dtype(input_type.dtype) not in FLOAT_DTYPES:
+        raise CpuScalarUnsupportedError("{} requires a floating-point dtype".format(context))
+    if _is_tensor(input_type):
+        static_shape(input_type, context + ".input")
+
+
+def _validate_broadcast_input(input_type: CoreType, output_type: CoreType, context: str) -> None:
+    if not _is_tensor(output_type):
+        raise CpuScalarUnsupportedError("{} output must be a tensor".format(context))
+    _validate_dtype(input_type, context + ".input")
+    _validate_dtype(output_type, context + ".output")
+    if canonical_dtype(input_type.dtype) != canonical_dtype(output_type.dtype):
+        raise CpuScalarValidationError("{} input and output dtypes must match".format(context))
+    output_shape = static_shape(output_type, context + ".output")
+    if _is_scalar(input_type):
+        return
+    if not _is_tensor(input_type):
+        raise CpuScalarUnsupportedError("{} input kind {!r} is unsupported".format(context, input_type.kind))
+    input_shape = static_shape(input_type, context + ".input")
+    if _broadcast_shape((input_shape, output_shape), context) != output_shape:
+        raise CpuScalarValidationError(
+            "{} input shape {} cannot produce output shape {}".format(context, input_shape, output_shape)
+        )
+
+
+def _validate_where(operation: Operation, context: str) -> None:
+    if len(operation.inputs) != 3:
+        raise CpuScalarValidationError("{} where requires condition, input, and other".format(context))
+    output_type = _one_output(operation, "where")
+    condition_type, true_type, false_type = (ref.type for ref in operation.inputs)
+    for value_type, label in ((condition_type, "condition"), (true_type, "input"), (false_type, "other")):
+        if not (_is_tensor(value_type) or _is_scalar(value_type)):
+            raise CpuScalarUnsupportedError("{} {} kind {!r} is unsupported".format(context, label, value_type.kind))
+        _validate_dtype(value_type, context + "." + label)
+        if _is_tensor(value_type):
+            static_shape(value_type, context + "." + label)
+    if canonical_dtype(condition_type.dtype) != "bool":
+        raise CpuScalarValidationError("{} condition must have bool dtype".format(context))
+    if not (_is_tensor(output_type) or _is_scalar(output_type)):
+        raise CpuScalarUnsupportedError("{} output kind {!r} is unsupported".format(context, output_type.kind))
+    _validate_dtype(output_type, context + ".output")
+    true_dtype = canonical_dtype(true_type.dtype)
