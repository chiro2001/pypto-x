+        except AmdgpuUnsupportedError:
+            gates[name] = "rejected"
+    parity = {}
+    compiler = AmdgpuStaticCompiler()
+    parity_cases = {
+        "cast_int32_int64": Operation("cast", (tensor("x", "int32", (3,)),), (tensor("y", "int64", (3,)),), {"dtype": "int64"}),
+        "cast_bool_int64": Operation("cast", (tensor("x", "bool", (3,)),), (tensor("y", "int64", (3,)),), {"dtype": "int64"}),
+        "gather_int32_source": Operation("gather", (tensor("x", "int32", (3, 4)), tensor("i", "int64", (2,))), (tensor("y", "int32", (2, 4)),), {"axis": 0}),
+        "embedding_int32_source": Operation("embedding", (tensor("x", "int32", (3, 4)), tensor("i", "int32", (2,))), (tensor("y", "int32", (2, 4)),)),
+        "where_int32": Operation("where", (tensor("c", "bool", (2, 1)), tensor("a", "int32", (2, 3)), tensor("b", "int32", (2, 3))), (tensor("y", "int32", (2, 3)),)),
+        "where_bool": Operation("where", (tensor("c", "bool", (2, 1)), tensor("a", "bool", (2, 3)), tensor("b", "bool", (2, 3))), (tensor("y", "bool", (2, 3)),)),
+    }
+    for name, operation in parity_cases.items():
+        try:
+            validate_static_operation(operation)
+            compiler.lower(operation_program(operation), AMD_IGPU_GFX1036)
+            parity[name] = "accepted"
+        except Exception as exc:
+            parity[name] = "rejected:{}".format(type(exc).__name__)
+    return gates, parity
+
+
+def audit_bf16():
+    source = tensor("source", "float32", (5,))
+    output = tensor("output", "bf16", (5,))
+    operation = Operation("cast", (source,), (output,), {"dtype": "bf16"})
+    artifact = AmdgpuStaticCompiler().compile(AmdgpuStaticCompiler().lower(operation_program(operation), AMD_IGPU_GFX1036))
+    ir = json.loads(bytes(artifact.payload).decode("utf-8"))["llvm_ir"]
+    def bits(value):
+        return struct.unpack("<I", struct.pack("<f", value))[0]
+    edge = [0x7F800001, 0x7FC00001, 0xFF800001]
+    guarded = []
+    for raw in edge:
+        upper = ((raw + 0x7FFF + ((raw >> 16) & 1)) >> 16) & 0xFFFF
+        is_nan = (raw & 0x7F800000) == 0x7F800000 and (raw & 0x007FFFFF) != 0
+        guarded.append((upper | 0x40) & 0xFFFF if is_nan else upper)
+    return {
+        "input_bits": ["0x{:08x}".format(value) for value in edge],
+        "guarded_expected_bf16": ["0x{:04x}".format(value) for value in guarded],
+        "ir_has_exponent_mantissa_guard": all(token in ir for token in ("2139095040", "8388607", "fcmp uno", "select i1")),
+        "nan_outputs_remain_nan": all((value & 0x7F80) == 0x7F80 and (value & 0x007F) != 0 for value in guarded),
+    }
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    gates, parity = audit_gates_and_parity()
+    report = {
+        "static_only": True,
+        "runtime": "BLOCKED_DEVICE",
+        "transpose": audit_transpose(),
+        "split": audit_split(),
+        "rejection_gates": gates,
+        "validator_lowering_parity": parity,
+        "bf16": audit_bf16(),
+    }
+    report["pass"] = (
+        report["transpose"]["pass"]
+        and report["split"]["pass"]
+        and all(value == "rejected" for value in gates.values())
+        and all(value == "accepted" for value in parity.values())
+        and report["bf16"]["ir_has_exponent_mantissa_guard"]
+        and report["bf16"]["nan_outputs_remain_nan"]
+    )
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"pass": report["pass"], "output": str(output)}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
