+
+def audit_split():
+    source_shape, output_shapes = (2, 3), ((2, 1), (2, 2))
+    operation = Operation(
+        "split",
+        (tensor("source", "float32", source_shape),),
+        (tensor("first", "float32", output_shapes[0]), tensor("second", "float32", output_shapes[1])),
+        {"axis": 1, "sizes": [1, 2]},
+    )
+    builder = hip._IRBuilder()
+    hip._emit_split_c2(builder, operation, "%out")
