+def audit_gates_and_parity():
+    cases = {
+        "zero_add": Operation("add", (tensor("a", "float32", (0, 3)), tensor("b", "float32", (0, 3))), (tensor("y", "float32", (0, 3)),)),
+        "zero_transpose": Operation("transpose", (tensor("a", "float32", (0, 3)),), (tensor("y", "float32", (3, 0)),), {"permutation": [1, 0]}),
+        "rank0_transpose": Operation("transpose", (tensor("a", "float32", ()),), (tensor("y", "float32", ()),), {"permutation": []}),
+    }
+    gates = {}
+    for name, operation in cases.items():
+        try:
