     return ValueRef(name, CoreType.tensor(dtype, shape))
 
 
+_I64_ASSIGN = re.compile(r"^\s+(%[A-Za-z0-9_.$-]+) = (add|sub|mul|udiv|urem) i64 (.+), (.+)$")
+_GEP = re.compile(r"getelementptr [^,]+, ptr addrspace\(1\) (%arg[0-9]+), i64 (%[A-Za-z0-9_.$-]+|[0-9-]+)")
+
+
+def _eval_i64_lines(lines, output_index):
+    values = {"%out": int(output_index)}
+
+    def resolve(value):
+        value = value.strip()
+        return values[value] if value.startswith("%") else int(value)
+
+    for line in lines:
+        match = _I64_ASSIGN.match(line)
+        if not match:
+            continue
+        name, opcode, left, right = match.groups()
+        left_value, right_value = resolve(left), resolve(right)
+        if opcode == "add":
+            values[name] = left_value + right_value
+        elif opcode == "sub":
+            values[name] = left_value - right_value
+        elif opcode == "mul":
+            values[name] = left_value * right_value
+        elif opcode == "udiv":
+            values[name] = left_value // right_value
+        else:
+            values[name] = left_value % right_value
+    geps = []
+    for line in lines:
+        match = _GEP.search(line)
+        if match:
+            pointer, expression = match.groups()
+            geps.append((pointer, values[expression] if expression.startswith("%") else int(expression)))
+    return geps
+
+
+def _unravel(index, shape):
+    coordinates = [0] * len(shape)
+    for axis in range(len(shape) - 1, -1, -1):
+        coordinates[axis] = index % shape[axis]
+        index //= shape[axis]
+    return tuple(coordinates)
+
+
+def _ravel(coordinates, shape):
+    result = 0
+    for coordinate, dimension in zip(coordinates, shape):
+        result = result * dimension + coordinate
+    return result
+
