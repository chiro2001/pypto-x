+def audit_transpose():
+    source_shape, output_shape, permutation = (2, 3, 4), (4, 2, 3), (2, 0, 1)
+    operation = Operation(
+        "transpose",
+        (tensor("source", "float32", source_shape),),
+        (tensor("output", "float32", output_shape),),
+        {"permutation": list(permutation)},
+    )
+    emitted, expected = [], []
+    for output_index in range(product(output_shape)):
+        builder = hip._IRBuilder()
+        hip._emit_transpose_c2(builder, operation, "%out")
+        emitted.append([value for pointer, value in eval_i64(builder.lines, output_index) if pointer == "%arg0"][-1])
+        output_coords = unravel(output_index, output_shape)
+        input_coords = [0] * len(source_shape)
+        for output_axis, input_axis in enumerate(permutation):
+            input_coords[input_axis] = output_coords[output_axis]
+        expected.append(ravel(input_coords, source_shape))
+    return {"expected": expected, "emitted": emitted, "pass": expected == emitted}
