@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Static-only artifact re-derivation/tamper evidence for gfx1036 C2."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+from pathlib import Path
+
+from pypto.compiler import Artifact
+from pypto.compiler.targets.hip import AmdgpuArtifactError, AmdgpuStaticCompiler, decode_amdgpu_artifact
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import AMD_IGPU_GFX1036
+
+
+def _base_artifact():
+    value_type = CoreType.tensor("float32", (5,))
+    source = ValueRef("source", value_type)
+    output = ValueRef("output", value_type)
+    operation = Operation("identity", (source,), (output,))
+    program = CoreProgram(functions=(CoreFunction("main", (source,), (output,), Region((operation,))),))
+    compiler = AmdgpuStaticCompiler()
+    return compiler.compile(compiler.lower(program, AMD_IGPU_GFX1036))
+
+
+def _rebuild(base, mutate, metadata_updates):
+    payload = json.loads(bytes(base.payload).decode("utf-8"))
+    mutate(payload)
+    encoded = json.dumps(payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    metadata = dict(base.metadata)
+    metadata["payload_digest"] = hashlib.sha256(encoded).hexdigest()
+    metadata.update(metadata_updates)
+    return Artifact(
+        format=base.format,
+        entrypoint=base.entrypoint,
+        target=base.target,
+        abi_version=base.abi_version,
+        payload=encoded,
+        metadata=metadata,
+    )
+
+
+def build_report():
+    base = _base_artifact()
+    decode_amdgpu_artifact(base)
+    base_payload = json.loads(bytes(base.payload).decode("utf-8"))
+    forged_assembly = base_payload["assembly"] + "\n; forged"
+    forged_assembly_digest = hashlib.sha256(forged_assembly.encode("utf-8")).hexdigest()
+    fake_elf = b"\x7fELF" + b"\x00" * 128
+    fake_object_digest = hashlib.sha256(fake_elf).hexdigest()
+    fake_toolchain = {
+        "llvm_as": "fake",
+        "llc": "fake",
+        "march": "amdgcn",
+        "mcpu": "gfx1036",
+        "filetypes": ["obj"],
+    }
+    candidates = {
+        "assembly_text_replacement": _rebuild(
+            base,
+            lambda payload: (
+                payload.__setitem__("assembly", forged_assembly),
+                payload.__setitem__("assembly_digest", forged_assembly_digest),
+            ),
+            {"assembly_digest": forged_assembly_digest},
+        ),
+        "generic_elf_object_replacement": _rebuild(
+            base,
+            lambda payload: (
+                payload.__setitem__("object_b64", base64.b64encode(fake_elf).decode("ascii")),
+                payload.__setitem__("object_digest", fake_object_digest),
+            ),
+            {"object_digest": fake_object_digest},
+        ),
+        "toolchain_manifest_replacement": _rebuild(
+            base,
+            lambda payload: payload.__setitem__("toolchain", fake_toolchain),
+            {"toolchain": fake_toolchain},
+        ),
+    }
+    results = {}
+    for name, candidate in candidates.items():
+        try:
+            decode_amdgpu_artifact(candidate)
+            results[name] = "ACCEPTED"
+        except AmdgpuArtifactError as exc:
+            results[name] = "REJECTED:{}".format(type(exc).__name__)
+    return {
+        "base_decodes": True,
+        "runtime": "BLOCKED_DEVICE",
+        "static_only": True,
+        "decode_requires_static_llvm_toolchain": True,
+        "results": results,
+        "all_required_rejections": all(value.startswith("REJECTED:") for value in results.values()),
+    }
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    report = build_report()
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(report, ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
