@@ -0,0 +1,219 @@
+#!/usr/bin/env python3
+"""Independent host oracle for the C2 fixes called out by acceptance."""
+
+from __future__ import annotations
+
+import json
+import re
+import struct
+from pathlib import Path
+
+import pypto.compiler.targets.hip as hip
+from pypto.compiler.targets.hip import AmdgpuStaticCompiler, AmdgpuUnsupportedError, validate_static_operation
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import AMD_IGPU_GFX1036
+
+
+_ASSIGN = re.compile(r"^\s+(%[A-Za-z0-9_.$-]+) = (add|sub|mul|udiv|urem) i64 (.+), (.+)$")
+_GEP = re.compile(r"getelementptr [^,]+, ptr addrspace\(1\) (%arg[0-9]+), i64 (%[A-Za-z0-9_.$-]+|[0-9-]+)")
+
+
+def tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, tuple(shape)))
+
+
+def operation_program(operation):
+    parameters = []
+    seen = set()
+    for ref in operation.inputs:
+        if ref.name not in seen:
+            seen.add(ref.name)
+            parameters.append(ref)
+    return CoreProgram(functions=(CoreFunction("main", tuple(parameters), operation.outputs, Region((operation,))),))
+
+
+def product(shape):
+    result = 1
+    for value in shape:
+        result *= value
+    return result
+
+
+def unravel(index, shape):
+    result = [0] * len(shape)
+    for axis in range(len(shape) - 1, -1, -1):
+        result[axis] = index % shape[axis]
+        index //= shape[axis]
+    return tuple(result)
+
+
+def ravel(coords, shape):
+    result = 0
+    for coordinate, dimension in zip(coords, shape):
+        result = result * dimension + coordinate
+    return result
+
+
+def eval_i64(lines, output_index):
+    values = {"%out": output_index}
+
+    def resolve(value):
+        value = value.strip()
+        return values[value] if value.startswith("%") else int(value)
+
+    for line in lines:
+        match = _ASSIGN.match(line)
+        if not match:
+            continue
+        name, opcode, left, right = match.groups()
+        left, right = resolve(left), resolve(right)
+        if opcode == "add":
+            values[name] = left + right
+        elif opcode == "sub":
+            values[name] = left - right
+        elif opcode == "mul":
+            values[name] = left * right
+        elif opcode == "udiv":
+            values[name] = left // right
+        else:
+            values[name] = left % right
