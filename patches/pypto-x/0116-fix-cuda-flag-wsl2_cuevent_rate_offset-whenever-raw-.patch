From 988f9ad12de543847441788e4a7c363897f7dde8 Mon Sep 17 00:00:00 2001
From: pypto-x-agent <pypto-x-agent@local>
Date: Fri, 11 Sep 2026 00:50:47 +0800
Subject: [PATCH 116/118] fix(cuda): flag wsl2_cuevent_rate_offset whenever raw
 wall agreement fails

The rate-offset flag must describe the same condition as
raw_wall_agreement=false: raw disagreement is driven by the platform
cuEvent rate offset plus host dispatch, so thresholding the flag on the
rate alone left runs with ~4.9% rate offset unflagged.  Also expose the
calibration spread as event_timer_rate_spread in addition to
event_timer_rate_spread_pct and at the top level.
---
 scripts/smoke/cuda_event_timing_smoke.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/scripts/smoke/cuda_event_timing_smoke.py b/scripts/smoke/cuda_event_timing_smoke.py
index 645efffcb..38c251900 100644
--- a/scripts/smoke/cuda_event_timing_smoke.py
+++ b/scripts/smoke/cuda_event_timing_smoke.py
@@ -596,7 +596,9 @@ def main(argv=None):
     gate_verdict = "PASS" if (rate_stable and linear_pass and corrected_pass) else "FAIL"
     raw_wall_agreement = raw_relative_pct is not None and raw_relative_pct <= RELATIVE_THRESHOLD_PCT
     platform_flags = []
-    if event_timer_rate is not None and abs(event_timer_rate - 1.0) * 100.0 > RELATIVE_THRESHOLD_PCT:
+    if (not raw_wall_agreement) or (
+        event_timer_rate is not None and abs(event_timer_rate - 1.0) * 100.0 > RELATIVE_THRESHOLD_PCT
+    ):
         platform_flags.append("wsl2_cuevent_rate_offset")
     same_span_corrected_pct = (
         abs(kernel_p50 * event_timer_rate - region_p50) / region_p50 * 100.0
@@ -703,6 +705,7 @@ def main(argv=None):
             "dispatch_seconds_median": dispatch_disp.get("p50"),
             "event_timer_rate": event_timer_rate,
             "event_timer_rate_spread_pct": rate_spread_pct,
+            "event_timer_rate_spread": rate_spread_pct,
             "raw_wall_agreement": raw_wall_agreement,
             "platform_flags": platform_flags,
             "peak_rss_mib": peak_rss_mib,
@@ -796,6 +799,8 @@ def main(argv=None):
         ),
         "kernel_seconds": kernel_p50,
         "kernel_seconds_corrected": (kernel_p50 * event_timer_rate) if event_timer_rate else None,
+        "event_timer_rate": event_timer_rate,
+        "event_timer_rate_spread": rate_spread_pct,
         "platform_flags": platform_flags,
     }
     payload = json.dumps(evidence, indent=2, sort_keys=True)
