From f1541d6bda7aa31535e814e30bbdb51459a0877a Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 18:27:07 +0800
Subject: [PATCH 248/250] fix(u2b): fold the verifier 1000-seed scan into the
 measured int8 envelope (K=133144 -> 966)

The round-2 snapshot table must record every scope that has been observed.
verify-0042-u2b's 1000-seed author-scope scan reached 966 at K=133144 (seed 428, 503/1000 seeds above the round-1 declaration of 457); this only widens the observation and does not change the deviation_bound_kind/no-bound semantics. Replays (16696,147)->75, (133144,115)->841 and (133144,428)->966 are pinned as regressions.
---
 python/pypto/execution/provider_aocl_int8.py           | 29 +++++++++++++++++++++++------
 python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py | 15 ++++++++++++---
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/python/pypto/execution/provider_aocl_int8.py b/python/pypto/execution/provider_aocl_int8.py
index fbd6d1c4b..152ff848d 100644
--- a/python/pypto/execution/provider_aocl_int8.py
+++ b/python/pypto/execution/provider_aocl_int8.py
@@ -119,9 +119,11 @@ AOCL_INT8_Q8_REFERENCE_OBSERVED_BY_K = {
     "133144": 22,
 }
 #: Aggregated measured worst-case |aocl_int32 - contract_int32| over every
-#: recorded scope (internal U2b scan + the independent verify-0042-u2b scans).
-#: These are **observations**, not an upper bound: the same generators reached
-#: 75 at K=16696 and 924 at K=133144 with wider seed sets.
+#: recorded scope (internal U2b scan + the independent verify-0042-u2b scans,
+#: including the 1000-seed author-scope scan).
+#: These are **observations**, not an upper bound: independent scans of the
+#: same generator reached 75 at K=16696 and 966 at K=133144 (seed 428), and
+#: each wider scan has so far only raised the observed maximum.
 AOCL_INT8_MEASURED_DEVIATION_BY_K = {
     "512": 0,
     "1024": 0,
@@ -129,7 +131,7 @@ AOCL_INT8_MEASURED_DEVIATION_BY_K = {
     "3584": 4,
     "5099": 8,
     "16696": 75,
-    "133144": 924,
+    "133144": 966,
 }
 AOCL_INT8_EXTERNAL_OBSERVATIONS = (
     {
@@ -140,6 +142,21 @@ AOCL_INT8_EXTERNAL_OBSERVATIONS = (
         "witnesses": {"16696": {"seed": 147, "delta": 75}, "133144": {"seed": 115, "delta": 841}},
         "artifact": "_meta/pypto-x/verify-0042-u2b/raw/envelope-author-scope.json",
     },
+    {
+        "source": "verify-0042-u2b author-scope 1000-seed scan (same generator family, seeds 1-1000)",
+        "generator": "same generator as the 1-200 author-scope scan, extended to seeds 1-1000",
+        "observed_max_by_k": {"16696": 75, "133144": 966},
+        "witnesses": {"16696": {"seed": 147, "delta": 75}, "133144": {"seed": 428, "delta": 966}},
+        "declared_vs_observed": {
+            "note": "the frozen round-1 snapshot declared 56 (K=16696) / 457 "
+                    "(K=133144); the 1000-seed scan exceeded those declarations "
+                    "in 48/1000 (K=16696) and 503/1000 (K=133144) cases",
+            "declared_by_k": {"16696": 56, "133144": 457},
+            "exceed_count_by_k": {"16696": 48, "133144": 503},
+            "n": 1000,
+        },
+        "artifact": "_meta/pypto-x/verify-0042-u2b/raw/envelope-author-scope-1000.json",
+    },
     {
         "source": "verify-0042-u2b alternate seed family (seeds 1-200)",
         "observed_max_by_k": {"16696": 67, "133144": 924},
@@ -168,8 +185,8 @@ AOCL_INT8_ENVELOPE_MEASUREMENT = {
     ],
     "thread_counts": [1, 2, 6],
     "thread_mode": "api_pinned",
-    "note": "observed maxima; the same generator with seeds 1-200 reaches 75 "
-            "(K=16696) and 841 (K=133144), so these are not a bound",
+    "note": "observed maxima; wider scans of the same generator family reach 75 "
+            "(K=16696) and 966 (K=133144), so these are not a bound",
 }
 #: No proven upper bound is offered for the pinned kernel.  The chained-f32
 #: block model that motivated an analytic bound is not bit-exact for all
diff --git a/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py b/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py
index cafc9b45a..c0f63bf46 100644
--- a/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py
+++ b/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py
@@ -287,11 +287,17 @@ def test_pinned_int8_probe_facts_and_manifest():
         key: int(value) for key, value in AOCL_INT8_MEASURED_DEVIATION_BY_K.items()
     }
     # Independent verify-0042-u2b scans are part of the recorded scope; they
-    # refuted the earlier snapshot (75 > 56 at K=16696, 924 > 457 at K=133144).
+    # refuted the earlier snapshot (75 > 56 at K=16696; the 1000-seed scan
+    # reached 966 > 457 at K=133144).
     assert envelope["measured_deviation_by_k"]["16696"] >= 75
-    assert envelope["measured_deviation_by_k"]["133144"] >= 924
+    assert envelope["measured_deviation_by_k"]["133144"] >= 966
     external = envelope["measurement_scope"]["external"]
     assert any("seeds 1-200" in item["source"] for item in external)
+    assert any("1000-seed" in item["source"] for item in external)
+    assert any(
+        item.get("observed_max_by_k", {}).get("133144") == 966
+        for item in external
+    )
     assert envelope["measurement_scope"]["observations_are_not_a_bound"] is True
     assert envelope["upper_bound"]["status"] == "not_provided"
     assert envelope["upper_bound"]["reason"] == AOCL_INT8_UPPER_BOUND_STATUS["reason"]
@@ -953,7 +959,10 @@ def test_policy_requiring_proven_bound_accepts_a_kind_carrying_manifest():
 
 @requires_aocl
 @requires_int8_host
-@pytest.mark.parametrize("k,seed,expected_delta", ((16696, 147, 75), (133144, 115, 841)))
+@pytest.mark.parametrize(
+    "k,seed,expected_delta",
+    ((16696, 147, 75), (133144, 115, 841), (133144, 428, 966)),
+)
 def test_verifier_witnesses_reproduce_the_snapshot_refutation(k, seed, expected_delta):
     """verify-0042-u2b's witnesses replayed through the real provider path."""
 
