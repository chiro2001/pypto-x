diff --git a/python/tests/ut/pypto_x/harness/diff.py b/python/tests/ut/pypto_x/harness/diff.py
new file mode 100644
index 000000000..9cdc5b7de
--- /dev/null
+++ b/python/tests/ut/pypto_x/harness/diff.py
@@ -0,0 +1,421 @@
+"""Reference/backend numerical comparison for PyPTO-X.
+
+Only the Python standard library is required.  Objects exposing the common
+``detach().cpu().numpy()`` or ``tolist()`` protocol are accepted, so the same
+checker can be used later with NumPy, PyTorch, or a backend-owned tensor
+without making any of those packages a harness dependency.
+"""
+
+from __future__ import annotations
+
+import math
+import numbers
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass
+from typing import Any, List, Optional, Tuple
+
+
+@dataclass(frozen=True)
+class Mismatch:
+    """One reported value mismatch.
+
+    ``index`` is an N-dimensional coordinate.  For a missing or unexpected
+    value it is computed from the corresponding flattened array shape.
+    """
+
+    index: Tuple[int, ...]
+    reference: Any
+    actual: Any
+    absolute_error: Optional[float]
+    relative_error: Optional[float]
+    reason: str
+
+    def to_dict(self) -> dict:
+        return {
+            "index": list(self.index),
+            "reference": self.reference,
+            "actual": self.actual,
+            "absolute_error": self.absolute_error,
+            "relative_error": self.relative_error,
+            "reason": self.reason,
+        }
+
+
+@dataclass(frozen=True)
+class NumericDiffReport:
+    """Structured result of a reference/backend comparison."""
+
+    passed: bool
+    reference_dtype: str
+    actual_dtype: str
+    reference_shape: Tuple[int, ...]
+    actual_shape: Tuple[int, ...]
+    dtype_match: bool
+    shape_match: bool
+    atol: float
+    rtol: float
+    total_count: int
+    mismatch_count: int
+    reported_mismatch_count: int
+    max_absolute_error: Optional[float]
+    max_relative_error: Optional[float]
+    mismatch_positions: Tuple[Tuple[int, ...], ...]
+    mismatches: Tuple[Mismatch, ...]
+    issues: Tuple[str, ...]
+
+    @property
+    def max_abs_error(self) -> Optional[float]:
+        """Short alias useful to callers rendering compact reports."""
+
+        return self.max_absolute_error
+
+    @property
+    def max_rel_error(self) -> Optional[float]:
+        return self.max_relative_error
+
+    @property
+    def mismatch_indices(self) -> Tuple[Tuple[int, ...], ...]:
+        return self.mismatch_positions
+
+    @property
+    def message(self) -> str:
+        if self.passed:
+            return "reference and backend outputs match"
+        issue_text = ", ".join(self.issues) if self.issues else "value_mismatch"
+        return "reference/backend mismatch: " + issue_text
+
+    def to_dict(self) -> dict:
+        return {
+            "kind": "numeric_diff",
+            "passed": self.passed,
+            "message": self.message,
+            "reference_dtype": self.reference_dtype,
+            "actual_dtype": self.actual_dtype,
+            "reference_shape": list(self.reference_shape),
+            "actual_shape": list(self.actual_shape),
+            "dtype_match": self.dtype_match,
+            "shape_match": self.shape_match,
+            "atol": self.atol,
+            "rtol": self.rtol,
+            "total_count": self.total_count,
+            "mismatch_count": self.mismatch_count,
+            "reported_mismatch_count": self.reported_mismatch_count,
+            "mismatch_truncated": self.reported_mismatch_count < self.mismatch_count,
+            "max_absolute_error": self.max_absolute_error,
+            "max_relative_error": self.max_relative_error,
+            "mismatch_positions": [list(index) for index in self.mismatch_positions],
+            "mismatches": [mismatch.to_dict() for mismatch in self.mismatches],
+            "issues": list(self.issues),
+        }
+
+
+class OutputMismatchError(AssertionError):
+    """Raised by :func:`assert_outputs_close` when a comparison fails."""
+
+    def __init__(self, report: NumericDiffReport):
+        self.report = report
+        super().__init__(report.message)
+
+
+@dataclass(frozen=True)
+class _ArrayView:
+    dtype: str
+    shape: Tuple[int, ...]
+    values: Tuple[Any, ...]
+
+
+def _unwrap_array(value: Any) -> Tuple[Any, Optional[Any], Optional[Any]]:
+    """Materialize common tensor wrappers without importing their packages."""
+
+    dtype = getattr(value, "dtype", None)
+    shape = getattr(value, "shape", None)
+    current = value
+
+    # PyTorch tensors commonly need both calls before numpy()/tolist().
+    for name in ("detach", "cpu"):
+        method = getattr(current, name, None)
+        if callable(method):
+            try:
+                current = method()
+            except (TypeError, RuntimeError, ValueError):
+                # A backend may expose a no-op method that needs device setup;
+                # falling through allows a useful error from materialization.
+                break
+    tolist = getattr(current, "tolist", None)
+    if callable(tolist):
+        current = tolist()
+    else:
+        numpy = getattr(current, "numpy", None)
+        if callable(numpy):
+            current = numpy()
+            tolist = getattr(current, "tolist", None)
+            if callable(tolist):
+                current = tolist()
+        elif not _is_scalar(current) and not isinstance(current, (list, tuple, str, bytes, Mapping)):
+            if isinstance(current, Iterable):
+                current = list(current)
+    return current, dtype, shape
+
+
+def _is_scalar(value: Any) -> bool:
+    return isinstance(value, (str, bytes, numbers.Number, bool)) or value is None
+
+
+def _shape(value: Any) -> Tuple[int, ...]:
+    if isinstance(value, (list, tuple)):
+        if not value:
+            return (0,)
+        children = [_shape(item) for item in value]
+        if any(child != children[0] for child in children[1:]):
+            raise ValueError("ragged arrays are not supported by the numerical harness")
+        return (len(value),) + children[0]
+    return ()
+
+
+def _flatten(value: Any, output: List[Any]) -> None:
+    if isinstance(value, (list, tuple)):
+        for item in value:
+            _flatten(item, output)
+    else:
+        output.append(value)
+
+
+def _leaf_values(value: Any) -> List[Any]:
+    result: List[Any] = []
+    _flatten(value, result)
+    return result
+
+
+def _dtype_name(source_dtype: Optional[Any], value: Any) -> str:
+    if source_dtype is not None:
+        name = getattr(source_dtype, "name", None)
+        return str(name if name is not None else source_dtype)
+    leaves = _leaf_values(value)
+    if not leaves:
+        return "unknown"
+    types = {type(item) for item in leaves}
+    if types <= {bool}:
+        return "bool"
+    if types <= {int}:
+        return "int64"
+    if types <= {int, float}:
+        return "float64"
+    if types <= {int, float, complex}:
+        return "complex128"
+    if len(types) == 1:
+        return types.pop().__name__
+    return "mixed[" + ",".join(sorted(item.__name__ for item in types)) + "]"
+
+
+def _normalize(value: Any) -> _ArrayView:
+    materialized, source_dtype, source_shape = _unwrap_array(value)
+    try:
+        inferred_shape = _shape(materialized)
+    except ValueError:
+        raise
+
+    if source_shape is not None:
+        try:
+            declared_shape = tuple(int(dim) for dim in source_shape)
+        except (TypeError, ValueError):
+            declared_shape = inferred_shape
+        if declared_shape != inferred_shape and not (
+            inferred_shape == () and declared_shape == (1,)
+        ):
+            # A malformed adapter should be visible to the caller rather than
+            # silently comparing a different shape than the backend reported.
+            raise ValueError(
+                "array shape metadata does not match materialized values: "
+                f"declared={declared_shape}, inferred={inferred_shape}"
+            )
+        normalized_shape = declared_shape
+    else:
+        normalized_shape = inferred_shape
+
+    values = tuple(_leaf_values(materialized))
+    return _ArrayView(_dtype_name(source_dtype, materialized), normalized_shape, values)
+
+
+def _coordinate(flat_index: int, shape: Tuple[int, ...]) -> Tuple[int, ...]:
+    if not shape:
+        return ()
+    if any(dim == 0 for dim in shape):
+        return ()
+    remainder = flat_index
+    coordinates: List[int] = []
+    for dim in reversed(shape):
+        coordinates.append(remainder % dim)
+        remainder //= dim
+    return tuple(reversed(coordinates))
+
+
+def _is_nan(value: Any) -> bool:
+    try:
+        return bool(value != value)
+    except Exception:
+        return False
+
+
+def _numeric_difference(reference: Any, actual: Any) -> Tuple[bool, Optional[float], Optional[float], str]:
+    if not isinstance(reference, numbers.Number) or not isinstance(actual, numbers.Number):
+        return reference == actual, None, None, "value_mismatch"
+
+    try:
+        absolute = float(abs(actual - reference))
+    except (TypeError, ValueError, OverflowError):
+        return reference == actual, None, None, "non_numeric_mismatch"
+
+    if _is_nan(reference) or _is_nan(actual):
+        return False, float("nan"), float("nan"), "nan_mismatch"
+    if reference == actual:
+        return True, 0.0, 0.0, ""
+
+    try:
+        denominator = float(abs(reference))
+    except (TypeError, ValueError, OverflowError):
+        denominator = 0.0
+    relative = float("inf") if denominator == 0.0 else absolute / denominator
+    return False, absolute, relative, "value_mismatch"
+
+
+def compare_outputs(
+    reference: Any,
+    actual: Any,
+    *,
+    atol: float = 1e-5,
+    rtol: float = 1e-5,
+    check_dtype: bool = True,
+    check_shape: bool = True,
+    max_mismatches: int = 20,
+    equal_nan: bool = False,
+) -> NumericDiffReport:
+    """Compare reference and backend outputs and return a structured report.
+
+    The comparison uses ``abs(actual-reference) <= atol + rtol*abs(reference)``
+    for numeric values.  Shape and dtype mismatches are reported independently
+    and always make the check fail when their corresponding check is enabled.
+    """
+
+    if atol < 0 or rtol < 0:
+        raise ValueError("atol and rtol must be non-negative")
+    if max_mismatches < 0:
+        raise ValueError("max_mismatches must be non-negative")
+
+    reference_view = _normalize(reference)
+    actual_view = _normalize(actual)
+    dtype_match = reference_view.dtype == actual_view.dtype
+    shape_match = reference_view.shape == actual_view.shape
+    issues: List[str] = []
+    if check_dtype and not dtype_match:
+        issues.append("dtype_mismatch")
+    if check_shape and not shape_match:
+        issues.append("shape_mismatch")
+
+    mismatch_records: List[Mismatch] = []
+    mismatch_count = 0
+    max_absolute: Optional[float] = None
+    max_relative: Optional[float] = None
+    common_count = min(len(reference_view.values), len(actual_view.values))
+    for index in range(common_count):
+        reference_value = reference_view.values[index]
+        actual_value = actual_view.values[index]
+        close, absolute, relative, reason = _numeric_difference(reference_value, actual_value)
+        if reason == "nan_mismatch" and equal_nan and _is_nan(reference_value) and _is_nan(actual_value):
+            close, absolute, relative, reason = True, 0.0, 0.0, ""
+        if absolute is not None and not math.isnan(absolute):
+            max_absolute = absolute if max_absolute is None else max(max_absolute, absolute)
+        if relative is not None and not math.isnan(relative):
+            max_relative = relative if max_relative is None else max(max_relative, relative)
+        if reason == "value_mismatch" and absolute is not None:
+            try:
+                scale = float(abs(reference_value))
+            except (TypeError, ValueError, OverflowError):
+                scale = float("inf")
+            if math.isfinite(absolute) and math.isfinite(scale):
+                close = absolute <= float(atol) + float(rtol) * scale
+        if not close:
+            mismatch_count += 1
+            if len(mismatch_records) < max_mismatches:
+                mismatch_records.append(
+                    Mismatch(
+                        index=_coordinate(index, reference_view.shape),
+                        reference=reference_value,
+                        actual=actual_value,
+                        absolute_error=absolute,
+                        relative_error=relative,
+                        reason=reason or "value_mismatch",
+                    )
+                )
+
+    if len(reference_view.values) > common_count:
+        for index in range(common_count, len(reference_view.values)):
+            mismatch_count += 1
+            if len(mismatch_records) < max_mismatches:
+                mismatch_records.append(
+                    Mismatch(
+                        index=_coordinate(index, reference_view.shape),
+                        reference=reference_view.values[index],
+                        actual=None,
+                        absolute_error=None,
+                        relative_error=None,
+                        reason="missing_value",
+                    )
+                )
+    if len(actual_view.values) > common_count:
+        for index in range(common_count, len(actual_view.values)):
+            mismatch_count += 1
+            if len(mismatch_records) < max_mismatches:
+                mismatch_records.append(
+                    Mismatch(
+                        index=_coordinate(index, actual_view.shape),
+                        reference=None,
+                        actual=actual_view.values[index],
+                        absolute_error=None,
+                        relative_error=None,
+                        reason="unexpected_value",
+                    )
+                )
+
+    if check_dtype and not dtype_match and "dtype_mismatch" not in issues:
+        issues.append("dtype_mismatch")
+    if check_shape and not shape_match and "shape_mismatch" not in issues:
+        issues.append("shape_mismatch")
+    if mismatch_count and "value_mismatch" not in issues:
+        issues.append("value_mismatch")
+
+    passed = (not check_dtype or dtype_match) and (not check_shape or shape_match) and mismatch_count == 0
+    positions = tuple(mismatch.index for mismatch in mismatch_records)
+    return NumericDiffReport(
+        passed=passed,
+        reference_dtype=reference_view.dtype,
+        actual_dtype=actual_view.dtype,
+        reference_shape=reference_view.shape,
+        actual_shape=actual_view.shape,
+        dtype_match=dtype_match,
+        shape_match=shape_match,
+        atol=float(atol),
+        rtol=float(rtol),
+        total_count=max(len(reference_view.values), len(actual_view.values)),
+        mismatch_count=mismatch_count,
+        reported_mismatch_count=len(mismatch_records),
+        max_absolute_error=max_absolute,
+        max_relative_error=max_relative,
+        mismatch_positions=positions,
+        mismatches=tuple(mismatch_records),
+        issues=tuple(issues),
+    )
+
+
+def compare_tensors(reference: Any, actual: Any, **kwargs: Any) -> NumericDiffReport:
+    """Tensor-oriented alias for :func:`compare_outputs`."""
+
+    return compare_outputs(reference, actual, **kwargs)
+
+
+def assert_outputs_close(reference: Any, actual: Any, **kwargs: Any) -> NumericDiffReport:
+    """Assert that reference and backend outputs satisfy the comparison."""
+
+    report = compare_outputs(reference, actual, **kwargs)
+    if not report.passed:
+        raise OutputMismatchError(report)
+    return report
diff --git a/python/tests/ut/pypto_x/harness/report.py b/python/tests/ut/pypto_x/harness/report.py
new file mode 100644
index 000000000..bc2f35e3b
--- /dev/null
+++ b/python/tests/ut/pypto_x/harness/report.py
@@ -0,0 +1,77 @@
+"""Structured report helpers for the PyPTO-X verification harness.
+
+The harness is intentionally dependency free.  Reports are plain Python data
+objects and can therefore be consumed by pytest, a CI job, or the command-line
+tool without importing a compiler, device runtime, or model package.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+from pathlib import Path
+from typing import Any, Dict
+
+
+def _json_safe(value: Any) -> Any:
+    """Convert report values into JSON-safe values.
+
+    Numeric reports can contain NaN and infinity, and mismatch values may be
+    scalars supplied by a third-party array implementation.  Keeping those
+    values as strings makes the emitted report valid JSON while retaining the
+    diagnostic information.
+    """
+
+    if dataclasses.is_dataclass(value):
+        return _json_safe(dataclasses.asdict(value))
+    if isinstance(value, dict):
+        return {str(key): _json_safe(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe(item) for item in value]
+    if isinstance(value, float):
+        if value != value:
+            return "NaN"
+        if value == float("inf"):
+            return "Infinity"
+        if value == float("-inf"):
+            return "-Infinity"
+    if value is None or isinstance(value, (str, int, bool, float)):
+        return value
+    return str(value)
+
+
+def report_to_dict(report: Any) -> Dict[str, Any]:
+    """Return a JSON-compatible dictionary for a harness report."""
+
+    if hasattr(report, "to_dict"):
+        result = report.to_dict()
+    elif dataclasses.is_dataclass(report):
+        result = dataclasses.asdict(report)
+    elif isinstance(report, dict):
+        result = report
+    else:
+        raise TypeError("report must provide to_dict() or be a dataclass/dict")
+    converted = _json_safe(result)
+    if not isinstance(converted, dict):
+        raise TypeError("report serialization must produce a mapping")
+    return converted
+
+
+def report_to_json(report: Any, *, indent: int = 2) -> str:
+    """Serialize a report with deterministic key ordering."""
+
+    return json.dumps(
+        report_to_dict(report),
+        ensure_ascii=False,
+        allow_nan=False,
+        indent=indent,
+        sort_keys=True,
+    )
+
+
+def write_report(report: Any, path: Path) -> None:
+    """Write a deterministic UTF-8 JSON report to *path*."""
+
+    output = Path(path)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(report_to_json(report) + "\n", encoding="utf-8")
diff --git a/python/tests/ut/pypto_x/harness/snapshot.py b/python/tests/ut/pypto_x/harness/snapshot.py
