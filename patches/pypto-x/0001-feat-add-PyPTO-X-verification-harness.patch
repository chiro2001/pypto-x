+"""Self-tests for the dependency-free PyPTO-X verification harness."""
+
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from pypto_x.harness import (
+    SnapshotStore,
+    canonical_json,
+    compare_outputs,
+    report_to_json,
+)
+
+
+class NumericDiffTest(unittest.TestCase):
+    def test_reports_dtype_shape_errors_and_locations(self):
+        report = compare_outputs(
+            [[1.0, 2.0], [3.0, 4.0]],
+            [[1.0, 2.5], [3.0, 4.0]],
+            atol=1e-6,
+            rtol=1e-6,
+            max_mismatches=4,
+        )
+        self.assertFalse(report.passed)
+        self.assertTrue(report.dtype_match)
+        self.assertTrue(report.shape_match)
+        self.assertEqual(report.mismatch_count, 1)
+        self.assertEqual(report.mismatch_positions, ((0, 1),))
+        self.assertAlmostEqual(report.max_absolute_error, 0.5)
+        self.assertIn("mismatch_count", json.loads(report_to_json(report)))
+
+    def test_shape_and_dtype_checks_are_independent(self):
+        report = compare_outputs([1, 2], [1.0, 2.0, 3.0], check_dtype=False)
+        self.assertFalse(report.passed)
+        self.assertFalse(report.shape_match)
+        self.assertEqual(report.actual_shape, (3,))
+        self.assertEqual(report.mismatch_count, 1)
+
+    def test_equal_nan_is_explicit(self):
+        without_opt_in = compare_outputs([float("nan")], [float("nan")])
+        with_opt_in = compare_outputs([float("nan")], [float("nan")], equal_nan=True)
+        self.assertFalse(without_opt_in.passed)
+        self.assertTrue(with_opt_in.passed)
+
+
+class SnapshotTest(unittest.TestCase):
+    def test_missing_snapshot_does_not_modify_store(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            report = SnapshotStore(root).compare("sample.txt", "one", kind="text")
+            self.assertFalse(report.passed)
+            self.assertEqual(report.status, "missing")
+            self.assertFalse((root / "sample.txt").exists())
+
+    def test_update_is_explicit_and_compare_is_stable(self):
+        with tempfile.TemporaryDirectory() as directory:
+            store = SnapshotStore(Path(directory))
+            updated = store.compare("ir.json", {"z": 1, "a": [2]}, kind="ir", update=True)
+            self.assertTrue(updated.passed)
+            self.assertTrue(updated.updated)
+            self.assertEqual(
+                (Path(directory) / "ir.json").read_text(encoding="utf-8"),
+                canonical_json({"a": [2], "z": 1}),
+            )
+            matched = store.compare("ir.json", '{"a":[2],"z":1}', kind="ir")
+            self.assertTrue(matched.passed)
+            self.assertEqual(matched.status, "matched")
+
+    def test_update_can_repair_an_invalid_json_snapshot(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            root.joinpath("bad.ir.json").write_text("not-json", encoding="utf-8")
+            report = SnapshotStore(root).compare("bad.ir.json", {"ok": True}, kind="ir", update=True)
+            self.assertTrue(report.passed)
+            self.assertTrue(report.updated)
+            self.assertEqual(report.status, "updated")
+            self.assertEqual(json.loads(root.joinpath("bad.ir.json").read_text(encoding="utf-8")), {"ok": True})
+
+    def test_snapshot_name_cannot_escape_root(self):
+        with tempfile.TemporaryDirectory() as directory:
+            with self.assertRaises(ValueError):
+                SnapshotStore(Path(directory)).compare("../outside.txt", "x")
+
+
+if __name__ == "__main__":
+    unittest.main()
