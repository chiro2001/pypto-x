+++ b/tools/pypto_x/verify.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Run PyPTO-X no-device verification checks from JSON/text inputs.
+
+Examples::
+
+    python tools/pypto_x/verify.py numeric --reference ref.json --actual out.json
+    python tools/pypto_x/verify.py snapshot --root python/tests/ut/pypto_x/snapshots \
+        --name core/example.ir.json --input actual.json --kind ir
+    python tools/pypto_x/verify.py snapshot --root ... --name ... --input ... \
+        --kind ir --update
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Any, List, Optional
+
+
+def _project_root() -> Path:
+    return Path(__file__).resolve().parents[2]
+
+
+def _load_harness() -> Any:
+    # The harness lives with the repository's unit tests and is intentionally
+    # not installed as part of the upstream pypto wheel.
+    tests_root = _project_root() / "python" / "tests" / "ut"
+    sys.path.insert(0, str(tests_root))
+    from pypto_x import harness
+
+    return harness
+
+
+def _read_json(path: Path) -> Any:
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError("cannot read JSON input " + str(path) + ": " + str(exc)) from exc
+
+
+def _write_or_print(report: Any, path: Optional[Path], harness: Any) -> None:
+    encoded = harness.report_to_json(report) + "\n"
+    if path is None:
+        sys.stdout.write(encoded)
+    else:
+        harness.write_report(report, path)
+
+
+def _numeric(args: argparse.Namespace) -> int:
+    harness = _load_harness()
+    report = harness.compare_outputs(
+        _read_json(Path(args.reference)),
+        _read_json(Path(args.actual)),
+        atol=args.atol,
+        rtol=args.rtol,
+        check_dtype=not args.no_check_dtype,
+        check_shape=not args.no_check_shape,
+        max_mismatches=args.max_mismatches,
+        equal_nan=args.equal_nan,
+    )
+    _write_or_print(report, Path(args.report) if args.report else None, harness)
+    return 0 if report.passed else 1
+
+
+def _snapshot(args: argparse.Namespace) -> int:
+    harness = _load_harness()
+    input_path = Path(args.input)
+    try:
+        if args.kind == "text":
+            actual = input_path.read_text(encoding="utf-8")
+        else:
+            actual = input_path.read_text(encoding="utf-8")
+        report = harness.compare_snapshot(
+            Path(args.root),
+            args.name,
+            actual,
+            kind=args.kind,
+            update=args.update,
+        )
+    except OSError as exc:
+        raise ValueError("cannot read snapshot input " + str(input_path) + ": " + str(exc)) from exc
+    _write_or_print(report, Path(args.report) if args.report else None, harness)
+    return 0 if report.passed else 1
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="PyPTO-X no-device verification harness")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    numeric = subparsers.add_parser("numeric", help="compare JSON reference/backend arrays")
+    numeric.add_argument("--reference", required=True, help="reference output JSON")
+    numeric.add_argument("--actual", required=True, help="backend output JSON")
+    numeric.add_argument("--atol", type=float, default=1e-5)
+    numeric.add_argument("--rtol", type=float, default=1e-5)
+    numeric.add_argument("--max-mismatches", type=int, default=20)
+    numeric.add_argument("--no-check-dtype", action="store_true")
+    numeric.add_argument("--no-check-shape", action="store_true")
+    numeric.add_argument("--equal-nan", action="store_true")
+    numeric.add_argument("--report", help="write JSON report instead of stdout")
+    numeric.set_defaults(handler=_numeric)
+
+    snapshot = subparsers.add_parser("snapshot", help="compare or explicitly update a snapshot")
+    snapshot.add_argument("--root", required=True, help="snapshot root directory")
+    snapshot.add_argument("--name", required=True, help="relative snapshot name")
+    snapshot.add_argument("--input", required=True, help="actual text or JSON/IR input")
+    snapshot.add_argument("--kind", choices=("text", "json", "ir"), default="text")
+    snapshot.add_argument("--update", action="store_true", help="explicitly create/update the snapshot")
+    snapshot.add_argument("--report", help="write JSON report instead of stdout")
+    snapshot.set_defaults(handler=_snapshot)
+    return parser
+
+
+def main(argv: Optional[List[str]] = None) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        return args.handler(args)
+    except ValueError as exc:
+        sys.stderr.write("error: " + str(exc) + "\n")
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
