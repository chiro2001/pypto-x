index 000000000..54b0af5f0
--- /dev/null
+++ b/python/tests/ut/pypto_x/harness/snapshot.py
@@ -0,0 +1,328 @@
+"""Deterministic text/IR snapshot comparison and explicit update support."""
+
+from __future__ import annotations
+
+import dataclasses
+import difflib
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any, Dict, Mapping, Optional
+
+
+class SnapshotError(ValueError):
+    """Raised for invalid snapshot names or malformed snapshot data."""
+
+
+class SnapshotMismatch(AssertionError):
+    """Raised by :meth:`SnapshotStore.assert_matches` on a stale snapshot."""
+
+    def __init__(self, report: "SnapshotReport"):
+        self.report = report
+        super().__init__(report.message)
+
+
+@dataclasses.dataclass(frozen=True)
+class SnapshotReport:
+    name: str
+    path: str
+    kind: str
+    status: str
+    passed: bool
+    exists: bool
+    updated: bool
+    expected_sha256: Optional[str]
+    actual_sha256: str
+    diff: str
+    error: Optional[str]
+
+    @property
+    def message(self) -> str:
+        if self.status == "matched":
+            return "snapshot matches"
+        if self.status == "updated":
+            return "snapshot updated explicitly"
+        if self.status == "missing":
+            return "snapshot is missing (pass update=True to create it)"
+        if self.error:
+            return "snapshot is invalid: " + self.error
+        return "snapshot does not match"
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "kind": "snapshot",
+            "name": self.name,
+            "path": self.path,
+            "snapshot_kind": self.kind,
+            "status": self.status,
+            "passed": self.passed,
+            "exists": self.exists,
+            "updated": self.updated,
+            "expected_sha256": self.expected_sha256,
+            "actual_sha256": self.actual_sha256,
+            "diff": self.diff,
+            "error": self.error,
+            "message": self.message,
+        }
+
+
+def _json_value(value: Any) -> Any:
+    if dataclasses.is_dataclass(value):
+        return _json_value(dataclasses.asdict(value))
+    if hasattr(value, "to_dict") and callable(value.to_dict):
+        return _json_value(value.to_dict())
+    if hasattr(value, "to_json") and callable(value.to_json):
+        encoded = value.to_json()
+        try:
+            return _json_value(json.loads(encoded))
+        except (TypeError, json.JSONDecodeError):
+            return str(encoded)
+    if isinstance(value, Mapping):
+        return {str(key): _json_value(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_value(item) for item in value]
+    if isinstance(value, Path):
+        return str(value)
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if hasattr(value, "__dict__"):
+        return _json_value(vars(value))
+    return str(value)
+
+
+def canonical_text(value: Any) -> str:
+    """Normalize line endings and ensure one trailing newline."""
+
+    if isinstance(value, bytes):
+        try:
+            value = value.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise SnapshotError("text snapshot must be valid UTF-8") from exc
+    text = str(value).replace("\r\n", "\n").replace("\r", "\n")
+    if text and not text.endswith("\n"):
+        text += "\n"
+    return text
+
+
+def canonical_json(value: Any) -> str:
+    """Serialize JSON/IR values using stable keys, separators, and newline."""
+
+    if isinstance(value, bytes):
+        try:
+            value = json.loads(value.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+            raise SnapshotError("JSON/IR snapshot must be valid UTF-8 JSON") from exc
+    elif isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except json.JSONDecodeError as exc:
+            raise SnapshotError("JSON/IR snapshot text must contain valid JSON") from exc
+    try:
+        return (
+            json.dumps(
+                _json_value(value),
+                ensure_ascii=False,
+                allow_nan=False,
+                sort_keys=True,
+                separators=(",", ":"),
+            )
+            + "\n"
+        )
+    except (TypeError, ValueError) as exc:
+        raise SnapshotError("value cannot be serialized as stable JSON/IR") from exc
+
+
+def canonicalize(value: Any, kind: str = "text") -> str:
+    if kind == "text":
+        return canonical_text(value)
+    if kind in ("json", "ir"):
+        return canonical_json(value)
+    raise SnapshotError("kind must be one of: text, json, ir")
+
+
+def _sha256(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _relative_to(path: Path, root: Path) -> bool:
+    try:
+        return os.path.commonpath((str(path), str(root))) == str(root)
+    except ValueError:
+        return False
+
+
+class SnapshotStore:
+    """Read and compare snapshots rooted at one controlled directory.
+
+    Updating is deliberately opt-in on every call.  A normal comparison never
+    creates a directory or modifies an existing file.
+    """
+
+    def __init__(self, root: Path):
+        self.root = Path(root).resolve()
+
+    def _path(self, name: str) -> Path:
+        candidate = Path(name)
+        if candidate.is_absolute() or "\x00" in name:
+            raise SnapshotError("snapshot name must be a relative path")
+        path = (self.root / candidate).resolve()
+        if not _relative_to(path, self.root):
+            raise SnapshotError("snapshot name escapes the snapshot root")
+        return path
+
+    @staticmethod
+    def _read(path: Path, kind: str) -> str:
+        try:
+            raw = path.read_bytes()
+        except OSError as exc:
+            raise SnapshotError("cannot read snapshot: " + str(exc)) from exc
+        return canonicalize(raw, kind)
+
+    @staticmethod
+    def _atomic_write(path: Path, content: str) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = path.with_name("." + path.name + ".tmp-" + str(os.getpid()))
+        try:
+            with temporary.open("w", encoding="utf-8", newline="\n") as stream:
+                stream.write(content)
+            os.replace(str(temporary), str(path))
+        finally:
+            if temporary.exists():
+                temporary.unlink()
+
+    def compare(self, name: str, actual: Any, *, kind: str = "text", update: bool = False) -> SnapshotReport:
+        """Compare *actual* with a snapshot; update only when explicitly asked."""
+
+        path = self._path(name)
+        actual_text = canonicalize(actual, kind)
+        actual_sha = _sha256(actual_text)
+        exists = path.exists()
+        if not exists:
+            if update:
+                self._atomic_write(path, actual_text)
+                return SnapshotReport(
+                    name=name,
+                    path=str(path),
+                    kind=kind,
+                    status="updated",
+                    passed=True,
+                    exists=True,
+                    updated=True,
+                    expected_sha256=None,
+                    actual_sha256=actual_sha,
+                    diff="",
+                    error=None,
+                )
+            return SnapshotReport(
+                name=name,
+                path=str(path),
+                kind=kind,
+                status="missing",
+                passed=False,
+                exists=False,
+                updated=False,
+                expected_sha256=None,
+                actual_sha256=actual_sha,
+                diff="",
+                error=None,
+            )
+
+        try:
+            expected_text = self._read(path, kind)
+        except SnapshotError as exc:
+            if update:
+                self._atomic_write(path, actual_text)
+                return SnapshotReport(
+                    name=name,
+                    path=str(path),
+                    kind=kind,
+                    status="updated",
+                    passed=True,
+                    exists=True,
+                    updated=True,
+                    expected_sha256=None,
+                    actual_sha256=actual_sha,
+                    diff="",
+                    error=str(exc),
+                )
+            return SnapshotReport(
+                name=name,
+                path=str(path),
+                kind=kind,
+                status="invalid",
+                passed=False,
+                exists=True,
+                updated=False,
+                expected_sha256=None,
+                actual_sha256=actual_sha,
+                diff="",
+                error=str(exc),
+            )
+
+        expected_sha = _sha256(expected_text)
+        if expected_text == actual_text:
+            return SnapshotReport(
+                name=name,
+                path=str(path),
+                kind=kind,
+                status="matched",
+                passed=True,
+                exists=True,
+                updated=False,
+                expected_sha256=expected_sha,
+                actual_sha256=actual_sha,
+                diff="",
+                error=None,
+            )
+
+        diff = "".join(
+            difflib.unified_diff(
+                expected_text.splitlines(keepends=True),
+                actual_text.splitlines(keepends=True),
+                fromfile=str(path),
+                tofile="actual",
+            )
+        )
+        if update:
+            self._atomic_write(path, actual_text)
+            return SnapshotReport(
+                name=name,
+                path=str(path),
+                kind=kind,
+                status="updated",
+                passed=True,
+                exists=True,
+                updated=True,
+                expected_sha256=expected_sha,
+                actual_sha256=actual_sha,
+                diff=diff,
+                error=None,
+            )
+        return SnapshotReport(
+            name=name,
+            path=str(path),
+            kind=kind,
+            status="mismatch",
+            passed=False,
+            exists=True,
+            updated=False,
+            expected_sha256=expected_sha,
+            actual_sha256=actual_sha,
+            diff=diff,
+            error=None,
+        )
+
+    def assert_matches(self, name: str, actual: Any, *, kind: str = "text") -> SnapshotReport:
+        """Compare without updating and raise a report-carrying assertion."""
+
+        report = self.compare(name, actual, kind=kind, update=False)
+        if not report.passed:
+            raise SnapshotMismatch(report)
+        return report
+
+
+def compare_snapshot(root: Path, name: str, actual: Any, *, kind: str = "text", update: bool = False) -> SnapshotReport:
+    """Convenience wrapper around :class:`SnapshotStore`."""
+
+    return SnapshotStore(root).compare(name, actual, kind=kind, update=update)
