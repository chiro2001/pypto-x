+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: 把 A2 回传的原始 JSON/CSV 装配成结构化 validation.json。
+
+用法::
+
+    python assemble_validation.py --evidence <_meta/pypto-x/qwen35-a2-vllm-ascend-profiling-baseline>
+
+读取（由回传 bundle 解包得到）：
+
+* raw/a2_final/{env_fingerprint,weights_check,model_download,offline_08b,online_08b,
+  sanity_big,offline_big,online_big,trace_paths}.json
+* csv/a2_final/extract_inventory.json
+
+写出：``<evidence>/validation.json``。
+"""
+
+import argparse
+import json
+import os
+import statistics
+import sys
+import time
+
+
+def load(path):
+    with open(path, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def median(values):
+    values = [value for value in values if value is not None]
+    return statistics.median(values) if values else None
+
+
+def offline_metrics(path):
+    data = load(path)
+    baseline = data.get("baseline") or {}
+    profile = (data.get("profile") or {}).get("items") or []
+    base_medians = [value["wall_seconds_median"] for value in baseline.values()]
+    prof_walls = [item["wall_seconds"] for item in profile]
+    warmup = [sample["wall_seconds"] for sample in data["warmup"]["samples"]]
+    baseline_median = median(base_medians)
+    profile_median = median(prof_walls)
+    return {
+        "api_used": data.get("api_used"),
+        "warmup_count": data["warmup"]["count"],
+        "warmup_median_seconds": median(warmup),
+        "baseline_per_item_median_seconds": {
+            key: value["wall_seconds_median"] for key, value in sorted(baseline.items())
+        },
+        "baseline_median_seconds": baseline_median,
+        "profiled_per_item_seconds": {
+            item["id"]: item["wall_seconds"] for item in profile
+        },
+        "profiled_median_seconds": profile_median,
+        "profiler_overhead_ratio": (profile_median / baseline_median)
+        if (profile_median and baseline_median)
+        else None,
+        "generated_tokens": 16,
+        "raw": os.path.basename(path),
+    }
+
+
+def online_metrics(path):
+    data = load(path)
+    result = {
+        "api_detected": data.get("api_detected"),
+        "concurrency": data.get("concurrency"),
+        "max_tokens": data.get("max_tokens"),
+    }
+    for phase in ("baseline", "profiled"):
+        phase_data = data.get(phase) or {}
+        items = phase_data.get("items") or {}
+        ttfts = [value["ttft_median_seconds"] for value in items.values()]
+        tpots = [value["tpot_median_seconds"] for value in items.values()]
+        totals = [value["total_median_seconds"] for value in items.values()]
+        p95s = [value["ttft_p95_seconds"] for value in items.values()]
+        result[phase] = {
+            "mode": phase_data.get("mode"),
+            "status": phase_data.get("status"),
+            "attempts": phase_data.get("attempts"),
+            "ttft_median_seconds": median(ttfts),
+            "ttft_p95_max_seconds": max(p95s) if p95s else None,
+            "tpot_median_seconds": median(tpots),
+            "total_median_seconds": median(totals),
+            "per_item": {
+                key: {
+                    "ttft_median_seconds": value["ttft_median_seconds"],
+                    "tpot_median_seconds": value["tpot_median_seconds"],
+                    "total_median_seconds": value["total_median_seconds"],
+                }
+                for key, value in sorted(items.items())
+            },
+        }
+    base = result["baseline"]["tpot_median_seconds"]
+    prof = result["profiled"]["tpot_median_seconds"]
+    result["profiler_overhead_ratio_tpot"] = (prof / base) if (base and prof) else None
+    base_ttft = result["baseline"]["ttft_median_seconds"]
+    prof_ttft = result["profiled"]["ttft_median_seconds"]
+    result["profiler_overhead_ratio_ttft"] = (
+        prof_ttft / base_ttft if (base_ttft and prof_ttft) else None
+    )
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence", required=True)
+    args = parser.parse_args(argv)
+    evidence = os.path.abspath(args.evidence)
+    raw = os.path.join(evidence, "raw", "a2_final")
+    csv_dir = os.path.join(evidence, "csv", "a2_final")
+
+    result = {
+        "schema": "pypto-x.a2-vllm-ascend.profiling.validation.v1",
+        "task_name": "qwen35-a2-vllm-ascend-profiling-baseline",
+        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "status": "PASS",
+        "a2_clock_note": (
+            "A2 容器 date -u 比本机真实 UTC 快约 8 小时（容器时钟按 CST 但标为 UTC）；"
+            "证据内 A2 时间戳全部保留原值，另在 trace_paths/本文件注明。"
+        ),
+        "matrix": [],
+        "notes": [],
+    }
+
+    env = load(os.path.join(raw, "env_fingerprint.json"))
+    result["environment"] = {
+        "packages": env.get("packages"),
+        "npu": env.get("npu"),
+        "cann": env.get("cann"),
+        "profiler_probe": {
+            key: (env.get("profiler_probe") or {}).get(key)
+            for key in (
+                "vllm_profiler_config_class",
+                "vllm_env_torch_profiler_dir_supported",
+                "vllm_ascend_profiler_module",
+                "vllm_ascend_torch_npu_profiler_wrapper",
+                "torch_npu_profiler",
+                "msprof_binary",
+            )
+        },
+        "captured_at": env.get("captured_at"),
+    }
+
+    weights = load(os.path.join(raw, "weights_check.json"))
+    result["weights_check"] = {
+        "dir": weights.get("dir"),
+        "manifest_revision": weights.get("manifest_revision"),
+        "manifest_sha256": weights.get("manifest_sha256"),
+        "status": weights.get("status"),
+        "summary": weights.get("summary"),
+        "anchor": weights.get("anchor", {}).get("ok"),
+        "safetensors": [
+            report
+            for report in weights.get("required", [])
+            if report.get("file", "").endswith(".safetensors")
+        ],
+    }
+
+    download = load(os.path.join(raw, "model_download.json"))
+    result["big_model_download"] = {
+        "model_id": download.get("model_id"),
+        "publisher": download.get("publisher"),
+        "method": download.get("method"),
+        "revision_requested": download.get("revision_requested"),
+        "revision_resolved": (download.get("revision_resolution") or {}).get("resolved"),
+        "total_bytes": download.get("total_bytes"),
+        "elapsed_seconds": download.get("elapsed_seconds"),
+        "rate_mib_per_second": download.get("rate_mib_per_second"),
+        "status": download.get("status"),
+        "safetensors_sha256": download.get("safetensors_sha256"),
+        "config_subset": download.get("config_subset"),
+    }
+
+    sanity = load(os.path.join(raw, "sanity_big.json"))
+    result["big_model_sanity"] = {
+        "wall_seconds": sanity.get("wall_seconds"),
+        "generated": sanity.get("summary", {}).get("generated"),
+        "workload_item": sanity.get("workload_item"),
+        "enforce_eager": sanity.get("llm_kwargs", {}).get("enforce_eager"),
+        "gpu_memory_utilization": sanity.get("llm_kwargs", {}).get("gpu_memory_utilization"),
+    }
+
+    for model, tag in (("Qwen3.5-0.8B", "08b"), ("Qwen3.5-9B", "big")):
+        result["matrix"].append(
+            {
+                "model": model,
+                "direction": "offline",
+                "metrics": offline_metrics(os.path.join(raw, "offline_%s.json" % tag)),
+            }
+        )
+        result["matrix"].append(
+            {
+                "model": model,
+                "direction": "online",
+                "metrics": online_metrics(os.path.join(raw, "online_%s.json" % tag)),
+            }
+        )
+
+    trace_paths = load(os.path.join(raw, "trace_paths.json"))
+    result["large_traces_on_a2"] = trace_paths
+
+    inventory = load(os.path.join(csv_dir, "extract_inventory.json"))
+    outputs = inventory.get("outputs") or []
+    reports = inventory.get("reports") or []
+    result["csv"] = {
+        "dir": os.path.relpath(csv_dir, evidence),
+        "file_count": len(outputs),
+        "total_bytes": sum(item["bytes"] for item in outputs),
+        "max_file_bytes": max((item["bytes"] for item in outputs), default=0),
+        "reports_by_kind": {
+            kind: sum(1 for report in reports if report.get("kind") == kind)
+            for kind in sorted({report.get("kind") for report in reports})
+        },
+        "errors": [report for report in reports if report.get("kind") == "error"],
+        "truncated": [
+            {
+                "output": report.get("output"),
+                "rows": report.get("rows"),
+                "rows_total": report.get("rows_total"),
+            }
+            for report in reports
+            if report.get("truncated")
+        ],
+        "torch_traces": [
+            {
+                "source": report.get("source"),
+                "events": report.get("events"),
+                "aggregated_rows": report.get("aggregated_rows"),
+                "anomalies": report.get("anomalies"),
+            }
+            for report in reports
+            if report.get("kind") == "torch_trace"
+        ],
+        "outputs": outputs,
+    }
+
+    result["notes"] = [
+        "0.8B 与 9B 都使用 vLLM 0.21.0 新 API：--profiler-config.profiler=torch + torch_profiler_dir；",
+        "vllm-ascend 0.21.0rc1 TorchNPUProfilerWrapper → torch_npu.profiler（ExportType.Text），"
+        "产物含 ASCEND_PROFILER_OUTPUT/{op_statistic,operator_details,kernel_details,api_statistic,step_trace_time}.csv；",
+        "profiler 只在 profiled phase 开启；baseline 与 profiled 分两次进程/两次 server 启动采集；",
+        "offline 只报 wall/吞吐（vLLM 离线接口不暴露逐 token 时间）；TTFT/TPOT 来自 online 流式接口；",
+        "大 trace（%.1f GiB）留在 A2，仅回传 CSV（%.2f MiB）与 JSON/日志；"
+        % (
+            sum(run.get("bytes", 0) for run in trace_paths.get("runs", [])) / (1024.0 ** 3),
+            sum(item["bytes"] for item in outputs) / (1024.0 ** 2),
+        ),
+        "a2_910b.sh --copy 的 scp 在本环境不可用（旧协议/端口问题），改用 ssh -J ... 'cat > / <' 完成双向传输，md5 校验一致；",
+        "extract_csv 对 kernel_details/operator_details 做了 top-5000 行截断（按 duration 降序），完整大表留在 A2 trace 内。",
+    ]
+    if inventory.get("errors"):
+        result["status"] = "PARTIAL"
+
+    out_path = os.path.join(evidence, "validation.json")
+    with open(out_path, "w", encoding="utf-8") as handle:
+        handle.write(json.dumps(result, ensure_ascii=False, indent=2) + "\n")
+    print("written", out_path)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
