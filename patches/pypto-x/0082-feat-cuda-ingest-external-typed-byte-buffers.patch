diff --git a/python/tests/ut/pypto_x/qwen35_cuda_byte_buffer_validation.py b/python/tests/ut/pypto_x/qwen35_cuda_byte_buffer_validation.py
new file mode 100644
index 000000000..1c254cf2b
--- /dev/null
+++ b/python/tests/ut/pypto_x/qwen35_cuda_byte_buffer_validation.py
@@ -0,0 +1,233 @@
+"""Weight-free CUDA M1K byte-buffer validation on the RTX 5080.
+
+This driver intentionally uses the explicit ``synthetic_test`` Qwen profile:
+it retains the 24-layer 18-GDR/6-attention topology while keeping the packed
+storage near 43 KiB.  It never downloads, maps, or loads checkpoint weights.
+"""
+
+from __future__ import annotations
+
+import math
+import json
+import struct
+import subprocess
+from typing import Dict, Sequence
+
+from pypto.backends.cuda import CudaDriver, CudaRuntime
+from pypto.compiler.targets.cuda import CudaPtxCompiler
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.portable.runtime_binding import (
+    BufferBinding,
+    assemble_launch_request,
+    bind_packed_region,
+    build_binding_schema,
+    build_packed_layout,
+)
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+CANARY = 0xCD
+
+
+def _count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= int(dimension)
+    return result
+
+
+def _bf16_bits(value: float) -> int:
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def _fill(dtype: str, shape: Sequence[int], value: float = 0.01) -> bytes:
+    count = _count(shape)
+    if dtype == "bf16":
+        return struct.pack("<{}H".format(count), *([_bf16_bits(value)] * count))
+    if dtype == "float32":
+        return struct.pack("<{}f".format(count), *([float(value)] * count))
+    if dtype == "int64":
+        return struct.pack("<{}q".format(count), *([int(value)] * count))
+    if dtype == "int32":
+        return struct.pack("<{}i".format(count), *([int(value)] * count))
+    raise ValueError("unsupported synthetic dtype {!r}".format(dtype))
+
+
+def _set_region(storage: bytearray, offset: int, payload: bytes) -> None:
+    storage[offset:offset + len(payload)] = payload
+
+
+def _make_external_bindings(schema, layout):
+    packed = bytearray(layout.total_nbytes + 128)
+    packed_before = None
+    for entry in schema.parameters:
+        region = layout.region_for(entry.name)
+        _set_region(packed, region.offset, _fill(entry.dtype, entry.shape))
+    for entry in schema.states:
+        region = layout.region_for(entry.name)
+        _set_region(packed, region.offset, bytes(entry.nbytes))
+    packed_before = bytes(packed)
+
+    runtime = {}
+    for entry in schema.runtime_inputs:
+        if entry.name == "input_ids":
+            payload = _fill(entry.dtype, entry.shape, 0)
+        elif entry.name == "cos":
+            payload = _fill(entry.dtype, entry.shape, 1.0)
+        else:
+            payload = _fill(entry.dtype, entry.shape, 0.0)
+        runtime[entry.name] = BufferBinding.from_buffer(
+            bytearray(payload), entry.storage_id, entry.dtype, entry.shape, readonly=True
+        )
+    parameters = {
+        entry.name: bind_packed_region(layout, entry.name, packed)
+        for entry in schema.parameters
+    }
+    states = {
+        entry.name: bind_packed_region(layout, entry.name, packed)
+        for entry in schema.states
+    }
+
+    output_storage: Dict[str, bytearray] = {}
+    outputs = {}
+    for entry in schema.outputs:
+        storage = bytearray([CANARY] * (64 + entry.nbytes + 64))
+        output_storage[entry.name] = storage
+        outputs[entry.name] = BufferBinding.from_buffer(
+            storage,
+            entry.storage_id,
+            entry.dtype,
+            entry.shape,
+            byte_offset=64,
+            alignment=64,
+            readonly=False,
+        )
+    return packed, packed_before, runtime, parameters, states, outputs, output_storage
+
+
+def _region_bytes(binding: BufferBinding) -> bytes:
+    binding.validate()
+    return bytes(binding.view)
+
+
+def _decode_values(binding: BufferBinding):
+    raw = _region_bytes(binding)
+    count = _count(binding.shape)
+    if binding.dtype == "bf16":
+        bits = struct.unpack("<{}H".format(count), raw) if count else ()
+        return tuple(struct.unpack("<f", struct.pack("<I", bit << 16))[0] for bit in bits)
+    if binding.dtype == "float32":
+        return struct.unpack("<{}f".format(count), raw) if count else ()
+    if binding.dtype == "int64":
+        return struct.unpack("<{}q".format(count), raw) if count else ()
+    if binding.dtype == "int32":
+        return struct.unpack("<{}i".format(count), raw) if count else ()
+    raise ValueError("unsupported output dtype {!r}".format(binding.dtype))
+
+
+def _assert_output_guards(schema, bindings, storage):
+    for entry in schema.outputs:
+        raw = storage[entry.name]
+        view = bindings[entry.name].view
+        assert raw[:64] == bytes([CANARY] * 64), entry.name
+        assert raw[64 + view.nbytes:] == bytes([CANARY] * 64), entry.name
+
+
+def _compute_processes():
+    command = (
+        "nvidia-smi",
+        "--query-compute-apps=pid,process_name,used_memory",
+        "--format=csv,noheader",
+    )
+    output = subprocess.check_output(command, stderr=subprocess.STDOUT)
+    return tuple(line.strip() for line in output.decode("utf-8", "replace").splitlines() if line.strip())
+
+
+def main() -> None:
+    compute_before = _compute_processes()
+    driver = CudaDriver()
+    compiler = None
+    runtime = None
+    result = None
+    try:
+        device = driver.device_info().to_dict()
+        program = build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test")
+        schema = build_binding_schema(program)
+        layout = build_packed_layout(schema)
+        assert len(schema.inputs) == 371
+        assert len(schema.outputs) == 51
+        assert layout.total_nbytes == 43200
+
+        # Compile/validate exactly this topology; no model data is supplied to
+        # the builder or compiler.
+        compiler = CudaPtxCompiler(driver=driver, probe_jit=True)
+        target_ir = compiler.lower(program, TARGET)
+        artifact = compiler.compile(target_ir)
+        assert artifact.metadata["program_digest"] == schema.graph_digest
+
+        packed, packed_before, runtime_inputs, parameters, states, outputs, output_storage = _make_external_bindings(schema, layout)
+        request = assemble_launch_request(
+            schema,
+            artifact,
+            runtime_inputs,
+            parameters,
+            states,
+            {entry.name: outputs[entry.name] for entry in schema.regular_outputs},
+            {entry.name: outputs[entry.name] for entry in schema.state_outputs},
+            device="gpu",
+        )
+        runtime = CudaRuntime(driver=driver)
+        input_before = {name: _region_bytes(binding) for name, binding in runtime_inputs.items()}
+        state_before = {name: _region_bytes(binding) for name, binding in states.items()}
+        launch_summaries = []
+        for launch_index in range(2):
+            runtime.launch(request)
+            _assert_output_guards(schema, outputs, output_storage)
+            assert bytes(packed) == packed_before
+            assert {name: _region_bytes(binding) for name, binding in runtime_inputs.items()} == input_before
+            assert {name: _region_bytes(binding) for name, binding in states.items()} == state_before
+            logits = _decode_values(outputs["logits"])
+            position = _decode_values(outputs["position_ids"])
+            assert logits and all(math.isfinite(value) for value in logits)
+            assert any(value != 0.0 for value in logits)
+            assert position == (0,)
+            state_values = []
+            for entry in schema.state_outputs:
+                values = _decode_values(outputs[entry.name])
+                assert all(math.isfinite(value) for value in values), entry.name
+                state_values.extend(values)
+            assert len(schema.state_outputs) == 48
+            assert len(state_values) > 0
+            launch_summaries.append({
+                "launch": launch_index + 1,
+                "logits_finite": True,
+                "logits_nonzero": True,
+                "position": list(position),
+                "state_outputs": len(schema.state_outputs),
+            })
+        result = {
+            "cuda_m1k": "PASS",
+            "device": device,
+            "inputs": len(schema.inputs),
+            "outputs": len(schema.outputs),
+            "packed_nbytes": layout.total_nbytes,
+            "launches": launch_summaries,
+            "host_inputs_immutable": True,
+            "output_canaries": True,
+        }
+    finally:
+        if runtime is not None:
+            runtime.close()
+        if driver is not None:
+            driver.close()
+    compute_after = _compute_processes()
+    assert not compute_after, compute_after
+    result["compute_processes_before"] = list(compute_before)
+    result["compute_processes_after"] = list(compute_after)
+    print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
