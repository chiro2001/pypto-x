@@ -0,0 +1,253 @@
+"""CUDA external typed-byte staging tests.
+
+The fake driver below models the address-based Driver API calls.  It refuses
+the legacy bytes/list helpers so a raw external buffer can only pass when the
+runtime keeps the shared :class:`TypedByteView` alive through both copies.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import mmap
+import struct
+from pathlib import Path
+
+import pytest
+
+from pypto.abi import GpuLaunchRequest, TensorDesc
+from pypto.backends.cuda import CudaDeviceInfo, CudaRuntime
+from pypto.backends.cuda import runtime as cuda_runtime
+from pypto.compiler.targets.cuda import CudaPtxCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+
+
+class _Context:
+    def close(self):
+        return None
+
+
+class _Module:
+    info_log = ""
+    error_log = ""
+
+    def __init__(self, driver):
+        self.driver = driver
+
+    def get_function(self, name):
+        return name
+
+    def close(self):
+        self.driver.calls.append(("module_close",))
+
+
+class _AddressOnlyDriver:
+    """Tiny fake which records exact address/byte-count copies."""
+
+    def __init__(self):
+        self.calls = []
+        self.memory = {}
+        self.next_pointer = 0x1000
+        self.output_payload = b""
+
+    def device_info(self, index=0):
+        return CudaDeviceInfo(index, "fake-address-gpu", 12, 0, 16 * 1024**3)
+
+    def context_create(self, index=0):
+        self.calls.append(("context_create", index))
+        return _Context()
+
+    def module_load_data(self, ptx):
+        self.calls.append(("module_load_data", len(ptx)))
+        return _Module(self)
+
+    def mem_alloc(self, size):
+        self.next_pointer += 1
+        self.memory[self.next_pointer] = bytearray(max(1, int(size)))
+        self.calls.append(("mem_alloc", int(size)))
+        return self.next_pointer
+
+    def mem_free(self, pointer):
+        self.calls.append(("mem_free", pointer))
+        self.memory.pop(pointer, None)
+
+    def memcpy_htod(self, pointer, payload):  # pragma: no cover - must not run
+        raise AssertionError("raw input staging called legacy memcpy_htod(bytes)")
+
+    def memcpy_dtoh(self, pointer, size):  # pragma: no cover - must not run
+        raise AssertionError("raw output staging called legacy memcpy_dtoh(bytes)")
+
+    def memcpy_htod_address(self, pointer, source_address, size):
+        size = int(size)
+        self.calls.append(("memcpy_htod_address", int(source_address), size))
+        self.memory[pointer][:size] = ctypes.string_at(int(source_address), size)
+
+    def memcpy_dtoh_address(self, destination_address, pointer, size):
+        size = int(size)
+        self.calls.append(("memcpy_dtoh_address", int(destination_address), size))
+        payload = bytes(self.memory[pointer][:size])
+        ctypes.memmove(int(destination_address), payload, size)
+
+    def launch_kernel(self, function, grid, block, parameters, stream=None, shared_memory=0):
+        self.calls.append(("launch_kernel", function, len(parameters)))
+        output_pointer = int(parameters[-1])
+        size = len(self.memory[output_pointer])
+        if self.output_payload:
+            payload = (self.output_payload * ((size + len(self.output_payload) - 1) // len(self.output_payload)))[:size]
+        else:
+            payload = b"\0" * size
+        self.memory[output_pointer][:size] = payload
+
+    def context_synchronize(self):
+        self.calls.append(("context_synchronize",))
+
+
+def _identity(dtype, shape):
+    tensor = CoreType.tensor(dtype, shape)
+    x = ValueRef("x", tensor)
+    z = ValueRef("z", tensor)
+    return CoreProgram(
+        functions=(CoreFunction("main", (x,), (z,), Region((Operation("identity", (x,), (z,)),))),)
+    )
+
+
+def _artifact(program):
+    compiler = CudaPtxCompiler()
+    target_ir = compiler.lower(program, TARGET)
+    return target_ir, compiler.compile(target_ir)
+
+
+@pytest.mark.parametrize(
+    "dtype,shape,input_payload,output_payload",
+    (
+        ("bf16", (3,), struct.pack("<3H", 0x3F80, 0xC000, 0x7FC1), struct.pack("<3H", 0x0001, 0x8000, 0x7FC1)),
+        ("float32", (2,), struct.pack("<2f", 1.25, -2.5), struct.pack("<2f", 3.5, -4.5)),
+        ("int32", (2,), struct.pack("<2i", -7, 19), struct.pack("<2i", 11, -23)),
+        ("int64", (2,), struct.pack("<2q", -7, 19), struct.pack("<2q", 11, -23)),
+    ),
+)
+def test_cuda_raw_typed_views_use_address_staging_and_preserve_bits(
+    monkeypatch, dtype, shape, input_payload, output_payload
+):
+    for name in ("_host_values", "_pack", "_unpack", "_write_host"):
+        monkeypatch.setattr(cuda_runtime, name, lambda *args, _name=name, **kwargs: (_ for _ in ()).throw(AssertionError(_name)))
+    program = _identity(dtype, shape)
+    target_ir, artifact = _artifact(program)
+    driver = _AddressOnlyDriver()
+    driver.output_payload = output_payload
+    runtime = CudaRuntime(driver=driver)
+    source = bytearray(input_payload)
+    destination = bytearray(b"\xA5" * len(output_payload))
+    source_before = bytes(source)
+    request = GpuLaunchRequest(
+        artifact,
+        geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+        inputs=(TensorDesc(dtype, shape, device="gpu", handle=memoryview(source), readonly=True),),
+        outputs=(TensorDesc(dtype, shape, device="gpu", handle=memoryview(destination)),),
+    )
+    try:
+        result = runtime.launch(request)
+    finally:
+        runtime.close()
+    assert result[0] is not None
+    assert bytes(source) == source_before
+    assert bytes(destination) == output_payload
+    input_calls = [call for call in driver.calls if call[0] == "memcpy_htod_address"]
+    output_calls = [call for call in driver.calls if call[0] == "memcpy_dtoh_address"]
+    assert [(call[2]) for call in input_calls] == [len(input_payload)]
+    assert [(call[2]) for call in output_calls] == [len(output_payload)]
+    assert all(call[1] != 0 for call in input_calls + output_calls)
+    assert not any(call[0] in ("memcpy_htod", "memcpy_dtoh") for call in driver.calls)
+    assert driver.memory == {}
