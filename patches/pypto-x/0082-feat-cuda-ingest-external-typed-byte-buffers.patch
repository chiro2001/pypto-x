+def test_cuda_raw_view_rejects_readonly_output_and_bad_contracts(monkeypatch):
+    program = _identity("bf16", (2,))
+    target_ir, artifact = _artifact(program)
+    driver = _AddressOnlyDriver()
+    runtime = CudaRuntime(driver=driver)
+    source = bytes(struct.pack("<2H", 1, 2))
+    readonly_output = bytes(4)
+    request = GpuLaunchRequest(
+        artifact,
+        geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+        inputs=(TensorDesc("bf16", (2,), device="gpu", handle=memoryview(source), readonly=True),),
+        outputs=(TensorDesc("bf16", (2,), device="gpu", handle=memoryview(readonly_output)),),
+    )
+    with pytest.raises(Exception, match="read-only|output"):
+        runtime.launch(request)
+    assert not any(call[0] in ("mem_alloc", "memcpy_htod_address") for call in driver.calls)
+
+    # Buffer validation happens before a driver allocation and does not infer
+    # elements from a short/strided byte exporter.
+    short = bytearray(2)
+    bad_request = GpuLaunchRequest(
+        artifact,
+        geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+        inputs=(TensorDesc("bf16", (2,), device="gpu", handle=memoryview(short), readonly=True),),
+        outputs=(TensorDesc("bf16", (2,), device="gpu", handle=bytearray(4)),),
+    )
+    with pytest.raises(Exception, match="shorter|bytes"):
+        runtime.launch(bad_request)
+    assert driver.memory == {}
+
+    released = memoryview(bytearray(4))
+    released.release()
+    released_request = GpuLaunchRequest(
+        artifact,
+        geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+        inputs=(TensorDesc("bf16", (2,), device="gpu", handle=released, readonly=True),),
+        outputs=(TensorDesc("bf16", (2,), device="gpu", handle=bytearray(4)),),
+    )
+    with pytest.raises(Exception, match="released"):
+        runtime.launch(released_request)
+    assert driver.memory == {}
+
+    non_contiguous = memoryview(bytearray(8))[::2]
+    non_contiguous_request = GpuLaunchRequest(
+        artifact,
+        geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+        inputs=(TensorDesc("bf16", (2,), device="gpu", handle=non_contiguous, readonly=True),),
+        outputs=(TensorDesc("bf16", (2,), device="gpu", handle=bytearray(4)),),
+    )
+    with pytest.raises(Exception, match="contiguous"):
+        runtime.launch(non_contiguous_request)
+    non_contiguous.release()
+    assert driver.memory == {}
