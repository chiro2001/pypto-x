+def test_cuda_raw_mmap_view_keeps_canary_and_zero_work(monkeypatch, tmp_path):
+    path = Path(tmp_path) / "raw.bin"
+    path.write_bytes(b"\x01\x02\x03\x04\xC7\xC7\xC7\xC7")
+    with path.open("r+b") as stream:
+        mapped = mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_WRITE)
+        try:
+            program = _identity("bf16", (0,))
+            target_ir, artifact = _artifact(program)
+            driver = _AddressOnlyDriver()
+            driver.output_payload = b""
+            runtime = CudaRuntime(driver=driver)
+            destination = memoryview(mapped)[4:]
+            input_view = memoryview(mapped)[:0]
+            output_view = destination[:0]
+            request = GpuLaunchRequest(
+                artifact,
+                geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+                inputs=(TensorDesc("bf16", (0,), device="gpu", handle=input_view, readonly=True),),
+                outputs=(TensorDesc("bf16", (0,), device="gpu", handle=output_view),),
+            )
+            try:
+                runtime.launch(request)
+            finally:
+                runtime.close()
+            assert mapped[4:] == b"\xC7\xC7\xC7\xC7"
+            assert not any(call[0] in ("memcpy_htod_address", "memcpy_dtoh_address") for call in driver.calls)
+            assert driver.memory == {}
+            input_view.release()
+            output_view.release()
+            destination.release()
+        finally:
+            mapped.close()
