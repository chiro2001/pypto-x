From 0bc662c6af9bdd32f587dbe2a0e9d0aec81290da Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Thu, 10 Sep 2026 00:32:43 +0800
Subject: [PATCH 081/141] fix(cpu): stabilize byte view reload and NumPy BF16
 format

---
 python/pypto/backends/cpu/byte_view.py                    | 28 ++++++++++++++----
 python/tests/ut/pypto_x/test_cpu_byte_buffer_ingestion.py | 56 +++++++++++++++++++++++++++++++++++
 2 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/python/pypto/backends/cpu/byte_view.py b/python/pypto/backends/cpu/byte_view.py
index 9ce401f55..264f5d41a 100644
--- a/python/pypto/backends/cpu/byte_view.py
+++ b/python/pypto/backends/cpu/byte_view.py
@@ -36,7 +36,10 @@ _DTYPE_INFO = {
     "int64": (8, "q"),
 }
 _NATIVE_FORMATS = {
-    "bf16": ("H",),
+    # NumPy exposes dtype=V2 through memoryview as the pad-byte format ``2x``
+    # (typestr ``|V2``).  It is a raw two-byte container, not an endian-aware
+    # numeric format, and is accepted only with the exact BF16 itemsize.
+    "bf16": ("H", "2x"),
     "float32": ("f",),
     "int32": ("i",),
     # NumPy exposes np.int64 as ``l`` on LP64 hosts, while ctypes/array use
@@ -107,10 +110,16 @@ class _PyBuffer(ctypes.Structure):
 
 try:
     _GET_BUFFER = ctypes.pythonapi.PyObject_GetBuffer
-    _GET_BUFFER.argtypes = [ctypes.py_object, ctypes.POINTER(_PyBuffer), ctypes.c_int]
+    # ``ctypes.pythonapi`` caches one _FuncPtr per process.  A module reload
+    # creates a new ``_PyBuffer`` Python class, so putting a module-local
+    # POINTER(_PyBuffer) into the cached function's argtypes makes an older
+    # function object reject pointers created after reload.  c_void_p is the
+    # stable ABI spelling for the second C argument and avoids that class
+    # identity trap while retaining the exact Py_buffer layout locally.
+    _GET_BUFFER.argtypes = [ctypes.py_object, ctypes.c_void_p, ctypes.c_int]
     _GET_BUFFER.restype = ctypes.c_int
     _RELEASE_BUFFER = ctypes.pythonapi.PyBuffer_Release
-    _RELEASE_BUFFER.argtypes = [ctypes.POINTER(_PyBuffer)]
+    _RELEASE_BUFFER.argtypes = [ctypes.c_void_p]
     _RELEASE_BUFFER.restype = None
 except AttributeError:  # pragma: no cover - CPython is the supported runtime.
     _GET_BUFFER = None
@@ -155,17 +164,24 @@ class _BorrowedBuffer:
         self.view = byte_view
         self._buffer = _PyBuffer()
         self._released = False
-        result = _GET_BUFFER(byte_view, ctypes.byref(self._buffer), 0)
-        if result != 0 or not self._buffer.buf and self._buffer.len:
+        buffer_pointer = ctypes.cast(ctypes.byref(self._buffer), ctypes.c_void_p)
+        result = _GET_BUFFER(byte_view, buffer_pointer, 0)
+        if result != 0:
             self._released = True
             raise CpuByteViewError("{} buffer address cannot be borrowed".format(context))
+        if not self._buffer.buf and self._buffer.len:
+            # GetBuffer succeeded, so this exceptional validation path must
+            # release the export before reporting the malformed address.
+            self._released = True
+            _RELEASE_BUFFER(buffer_pointer)
+            raise CpuByteViewError("{} buffer address cannot be borrowed".format(context))
         self.address = int(self._buffer.buf or 0)
         self.nbytes = int(self._buffer.len)
 
     def close(self) -> None:
         if not self._released:
             self._released = True
-            _RELEASE_BUFFER(ctypes.byref(self._buffer))
+            _RELEASE_BUFFER(ctypes.cast(ctypes.byref(self._buffer), ctypes.c_void_p))
 
     def __del__(self):  # pragma: no cover - exercised by CPython lifetime tests.
         try:
