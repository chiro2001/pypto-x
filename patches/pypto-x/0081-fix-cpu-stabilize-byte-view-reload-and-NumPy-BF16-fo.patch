+def test_typed_byte_view_reload_keeps_cpython_buffer_signature_stable():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        module = importlib.import_module("pypto.backends.cpu.byte_view")
+        first = module.TypedByteView(struct.pack("<f", 1.0), "float32", (1,), readonly=True)
+        importlib.reload(module)
+        second = module.TypedByteView(struct.pack("<f", 2.0), "float32", (1,), readonly=True)
+        assert first.to_values() == [1.0]
+        assert second.to_values() == [2.0]
+        first.close()
+        second.close()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+
+
+def test_numpy_v2_bf16_pad_format_is_exact_and_writable():
+    np = pytest.importorskip("numpy")
+    source = np.array([0x3F80, 0x4000], dtype="<u2").view("V2")
+    assert memoryview(source).format == "2x"
+    typed = TypedByteView(source, "bf16", (2,), readonly=True)
+    assert typed.to_raw_values() == [0x3F80, 0x4000]
+    typed.close()
+
+    destination = np.zeros((2,), dtype="V2")
+    writable = TypedByteView(destination, "bf16", (2,), readonly=False)
+    writable.write_values([1.0, 2.0])
+    writable.close()
+    assert tuple(np.frombuffer(destination.tobytes(), dtype="<u2")) == (0x3F80, 0x4000)
+
+
+def test_scalar_numpy_v2_bf16_ingestion_round_trips_raw_bits():
+    np = pytest.importorskip("numpy")
+    artifact = _scalar_artifact(_elementwise("bf16", operation="mul"))
+    left = np.array([0x3F80, 0x4000], dtype="<u2").view("V2")
+    right = np.array([0x4000, 0x3F80], dtype="<u2").view("V2")
+    output = np.zeros((2,), dtype="V2")
+    CpuScalarRuntime().launch(
+        _request(
+            artifact,
+            [TensorDesc("bf16", (2,), handle=left, readonly=True), TensorDesc("bf16", (2,), handle=right, readonly=True)],
+            TensorDesc("bf16", (2,), handle=output),
+        )
+    )
+    assert tuple(np.frombuffer(output.tobytes(), dtype="<u2")) == (0x4000, 0x4000)
+
+
