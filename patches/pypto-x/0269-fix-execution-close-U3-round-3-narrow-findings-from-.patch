+def test_doctor_reports_emptied_manifest_as_fail_closed_fact():
+    document = json.loads(json.dumps(export_capability_snapshot(_host_snapshot())))
+    document["providers"][_provider_index(document, PORTABLE_PROVIDER_ID)]["preconditions"] = {}
+    document["digest"] = _forge_snapshot_digest(document)
+    # The lenient U1 from_dict boundary can still build the object; doctor is
+    # the fact surface that must flag the emptied registered manifest.
+    snapshot = CapabilitySnapshot.from_dict(document)
+    report = doctor(capability=snapshot)
+    assert report.fail_closed is True
+    failed = [
+        item["check"] for item in report.to_dict()["fail_closed_checks"] if item["status"] != "ok"
+    ]
+    assert "provider_identity" in failed
+
+
+def test_redacted_documents_are_self_verifying():
+    redacted = doctor().to_dict()
+    assert redacted["path_policy"] == "basename"
+    for row in redacted["providers"]:
+        preimage = {key: value for key, value in row.items() if key != "manifest_digest"}
+        assert row["manifest_digest"] == "sha256:" + sha256_text(preimage)
+        assert row["manifest_canonical_digest"].startswith("sha256:")
+        assert row["manifest_canonical_digest"] != row["manifest_digest"]
+    full = doctor(show_paths=True).to_dict()
+    for row in full["providers"]:
+        preimage = {key: value for key, value in row.items() if key != "manifest_digest"}
+        assert row["manifest_digest"] == "sha256:" + sha256_text(preimage)
+        assert "manifest_canonical_digest" not in row
+
+    frozen = plan_request("matmul", (2, 3), (3, 4), "float32")
+    default_plan = frozen.to_dict()
+    embedded = default_plan["capability_snapshot"]
+    preimage = {key: value for key, value in embedded.items() if key != "digest"}
+    assert embedded["digest"] == "sha256:" + sha256_text(preimage)
+    assert embedded["canonical_digest"] == default_plan["capability_digest"]
+    full_plan = frozen.to_dict(show_paths=True)
+    full_embedded = full_plan["capability_snapshot"]
+    full_preimage = {key: value for key, value in full_embedded.items() if key != "digest"}
+    assert full_embedded["digest"] == "sha256:" + sha256_text(full_preimage)
+    assert full_embedded["digest"] == full_plan["capability_digest"]
+    assert "canonical_digest" not in full_embedded
+
