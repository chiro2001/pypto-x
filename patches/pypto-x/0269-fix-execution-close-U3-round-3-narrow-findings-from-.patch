+def test_snapshot_import_rejects_emptied_registered_collections(mutate):
+    details = _assert_failure(ARTIFACT_MISMATCH, lambda: import_capability_snapshot(_tampered_snapshot(mutate)))
+    assert details["reason"] == "capability_structure_mismatch"
+    assert any(
+        "non-empty" in item["detail"] or "missing registered manifest field" in item["detail"]
+        for item in details["details"]["violations"]
