+        ("Infinity", {"mutate": "inf"}),
+        ("duplicate-json-keys", {"mutate": "duplicate"}),
+    ),
+    ids=("library=5", "contracts=5", "NaN", "Infinity", "duplicate-json-keys"),
+)
+def test_cli_malformed_snapshot_is_always_structured(tmp_path, label, raw_text):
+    document = json.loads(json.dumps(export_capability_snapshot(_host_snapshot())))
+    mutate = raw_text["mutate"]
+    if mutate == "library":
+        document["providers"][0]["library"] = 5
+        text = json.dumps(document)
+    elif mutate == "contracts":
+        document["providers"][0]["contracts"] = 5
+        text = json.dumps(document)
+    elif mutate == "nan":
+        document["providers"][0]["preconditions"]["min_dimension"] = float("nan")
+        text = json.dumps(document)
+    elif mutate == "inf":
+        document["providers"][0]["preconditions"]["min_dimension"] = float("inf")
+        text = json.dumps(document)
+    else:
+        text = json.dumps(document).replace('"schema_version": 2,', '"schema_version": 1, "schema_version": 2,', 1)
+    path = tmp_path / "snapshot.json"
+    path.write_text(text, encoding="utf-8")
+    completed = _run_cli("doctor", "--snapshot", str(path), "--json", cwd=tmp_path)
+    assert completed.returncode == 1, completed.stderr
+    payload = json.loads(completed.stdout)
+    assert payload["code"] == ARTIFACT_MISMATCH
+    assert payload["reason"]
+    assert "Traceback" not in completed.stderr
+    if mutate in ("library", "contracts"):
+        assert payload["reason"] == "capability_structure_mismatch"
+    else:
+        assert payload["reason"] == "snapshot_file_invalid_json"
+
+
+def test_cli_show_paths_is_an_explicit_opt_in(tmp_path):
+    default = _run_cli("doctor", "--json", cwd=tmp_path)
+    assert default.returncode == 0, default.stderr
+    default_document = json.loads(default.stdout)
+    assert default_document["path_policy"] == "basename"
+    for row in default_document["pinned_libraries"]:
+        assert "/" not in row["path"]
+
+    shown = _run_cli("doctor", "--json", "--show-paths", cwd=tmp_path)
+    assert shown.returncode == 0, shown.stderr
+    shown_document = json.loads(shown.stdout)
+    assert shown_document["path_policy"] == "full"
+    assert any("/" in row["path"] for row in shown_document["pinned_libraries"])
+    assert "chiro" not in default.stdout
+
