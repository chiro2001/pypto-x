+def test_weaker_same_triple_snapshot_is_accepted_by_design():
+    # 0013 section 3.6 defines alignment as kind+triple; a same-triple
+    # snapshot with fewer features/providers is therefore accepted and the
+    # resolver simply has fewer candidates.  This is a registered boundary.
+    host = _host_snapshot()
+    weaker = CapabilitySnapshot(
+        kind="cpu",
+        triple=host.triple,
+        features=(),
+        providers=(portable_provider_capability(),),
+    )
+    document = json.loads(json.dumps(export_capability_snapshot(weaker)))
+    imported = import_capability_snapshot(document)
+    frozen = plan_request("matmul", (2, 3), (3, 4), "float32", capability=imported)
+    assert imported.features == ()
+    assert imported.provider_ids() == (PORTABLE_PROVIDER_ID,)
+    assert frozen.plan.selected_provider == PORTABLE_PROVIDER_ID
 
 
