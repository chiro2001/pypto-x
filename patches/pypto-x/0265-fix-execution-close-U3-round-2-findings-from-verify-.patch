+# ---------------------------------------------------------------------------
+# strict capability-snapshot schema
+#
+# The strict import path must not rely on Python ``==`` for nested mappings
+# (``False == 0``, ``True == 1``, ``1.0 == 1``) and must refuse unknown nested
+# fields instead of echoing them back verbatim.  The tables below declare the
+# exact registered shape; open maps (by-k measurements, symbol tables, fused
+# variant names) keep arbitrary keys only where the provider manifest itself
+# uses them as data.
+# ---------------------------------------------------------------------------
+def _check_json_value(value: Any, path: str, errors: list) -> None:
+    if value is None or isinstance(value, (str, bool)):
+        return
+    if isinstance(value, int):
+        return
+    if isinstance(value, float):
+        if math.isfinite(value):
+            return
+        errors.append((path, "non-finite number is not a JSON value"))
+        return
+    if isinstance(value, list):
+        for index, item in enumerate(value):
+            _check_json_value(item, "{}[{}]".format(path, index), errors)
+        return
+    if isinstance(value, Mapping):
+        for key, item in value.items():
+            if not isinstance(key, str):
+                errors.append((path, "mapping keys must be strings, got {!r}".format(key)))
+                continue
+            _check_json_value(item, "{}.{}".format(path, key), errors)
+        return
+    errors.append((path, "not a JSON value: {}".format(type(value).__name__)))
+
+
+def _check_schema(value: Any, schema: Any, path: str, errors: list) -> None:
+    if schema == "str":
+        if not isinstance(value, str):
+            errors.append((path, "expected string, got {}".format(type(value).__name__)))
+        return
+    if schema == "int":
+        if isinstance(value, bool) or not isinstance(value, int):
+            errors.append((path, "expected integer, got {}".format(type(value).__name__)))
+        return
+    if schema == "bool":
+        if not isinstance(value, bool):
+            errors.append((path, "expected boolean, got {}".format(type(value).__name__)))
+        return
+    if schema == "int_or_str":
+        if isinstance(value, bool) or not isinstance(value, (int, str)):
+            errors.append((path, "expected int or string, got {}".format(type(value).__name__)))
+        return
+    if schema == "contract_digest":
+        if not isinstance(value, str) or len(value) != 71 or not value.startswith("sha256:"):
+            errors.append((path, "expected sha256:<64 lowercase hex>, got {!r}".format(value)))
+            return
+        if any(character not in "0123456789abcdef" for character in value[7:]):
+            errors.append((path, "expected sha256:<64 lowercase hex>, got {!r}".format(value)))
+        return
+    if schema == "json":
+        _check_json_value(value, path, errors)
+        return
+    if not isinstance(schema, tuple):
+        raise ValueError("unknown snapshot schema {!r}".format(schema))
+    tag = schema[0]
+    if tag == "opt":
+        if value is not None:
+            _check_schema(value, schema[1], path, errors)
+        return
+    if tag == "list":
+        if not isinstance(value, list):
+            errors.append((path, "expected list, got {}".format(type(value).__name__)))
+            return
+        for index, item in enumerate(value):
+            _check_schema(item, schema[1], "{}[{}]".format(path, index), errors)
+        return
+    if tag == "tuple":
+        item_schemas = schema[1]
+        if not isinstance(value, list) or len(value) != len(item_schemas):
+            errors.append((path, "expected fixed list of {} items".format(len(item_schemas))))
+            return
+        for index, item_schema in enumerate(item_schemas):
+            _check_schema(value[index], item_schema, "{}[{}]".format(path, index), errors)
+        return
+    if tag == "openmap":
+        if not isinstance(value, Mapping):
+            errors.append((path, "expected mapping, got {}".format(type(value).__name__)))
+            return
+        for key, item in value.items():
+            if not isinstance(key, str):
+                errors.append((path, "mapping keys must be strings, got {!r}".format(key)))
+                continue
+            _check_schema(item, schema[1], "{}.{}".format(path, key), errors)
+        return
+    if tag in ("obj", "obj_if_nonempty"):
+        if not isinstance(value, Mapping):
+            errors.append((path, "expected mapping, got {}".format(type(value).__name__)))
+            return
+        if tag == "obj_if_nonempty" and not value:
+            return
+        required, optional = schema[1], schema[2]
+        if not isinstance(optional, Mapping):
+            optional = {}
+        allowed = set(required) | set(optional)
+        for key in value:
+            if key not in allowed:
+                errors.append(("{}.{}".format(path, key), "unknown nested field"))
+        for key in required:
+            if key not in value:
+                errors.append(("{}.{}".format(path, key), "missing required field"))
+        for key, item in value.items():
+            item_schema = required.get(key, optional.get(key))
+            if item_schema is not None:
+                _check_schema(item, item_schema, "{}.{}".format(path, key), errors)
+        return
+    raise ValueError("unknown snapshot schema tag {!r}".format(tag))
+
