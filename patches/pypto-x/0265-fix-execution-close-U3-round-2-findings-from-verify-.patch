+def _validate_provider_documents(providers: Any) -> None:
+    errors = []
+    provider_ids = []
+    for index, entry in enumerate(providers):
+        path = "snapshot.providers[{}]".format(index)
+        if not isinstance(entry, Mapping):
+            errors.append((path, "expected mapping, got {}".format(type(entry).__name__)))
+            continue
+        provider_ids.append(entry.get("provider_id"))
+        _check_schema(entry, ("obj", _PROVIDER_REQUIRED, _PROVIDER_OPTIONAL), path, errors)
+        contracts = entry.get("contracts")
+        if isinstance(contracts, Mapping):
+            for opcode, digest in contracts.items():
+                if not isinstance(opcode, str) or not opcode.strip():
+                    errors.append((path + ".contracts", "contract opcode must be a non-empty string"))
+                    continue
+                if opcode not in _REGISTERED_OPCODE_SET:
+                    continue
+                definition = get_op_definition(opcode)
+                if digest != definition.contract_digest:
