+    """Return the first type-strict difference between two JSON values."""
+
+    if type(left) is not type(right):
+        return (path, "type {} != {}".format(type(left).__name__, type(right).__name__))
+    if isinstance(left, Mapping):
+        if set(left) != set(right):
+            missing = sorted(set(right) - set(left))
+            extra = sorted(set(left) - set(right))
+            return (path, "key mismatch missing={} extra={}".format(missing, extra))
+        for key in sorted(left):
+            difference = _strict_json_difference(left[key], right[key], "{}.{}".format(path, key))
+            if difference is not None:
+                return difference
+        return None
+    if isinstance(left, list):
+        if len(left) != len(right):
+            return (path, "list length {} != {}".format(len(left), len(right)))
+        for index, (left_item, right_item) in enumerate(zip(left, right)):
+            difference = _strict_json_difference(left_item, right_item, "{}[{}]".format(path, index))
+            if difference is not None:
+                return difference
+        return None
+    if left != right:
+        return (path, "value {} != {}".format(left, right))
+    return None
