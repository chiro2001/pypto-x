Subject: [PATCH 28/96] fix(pypto-x): publish AVX2 artifacts read-only

---
 python/pypto/compiler/targets/cpu_avx2.py |  3 +++
 python/tests/ut/pypto_x/test_cpu_avx2.py  | 32 ++++++++++++++++++++++++++------
 2 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/python/pypto/compiler/targets/cpu_avx2.py b/python/pypto/compiler/targets/cpu_avx2.py
index 7e24f98e0..cc5c29145 100644
--- a/python/pypto/compiler/targets/cpu_avx2.py
+++ b/python/pypto/compiler/targets/cpu_avx2.py
@@ -439,6 +439,7 @@ def _compile_native(target_ir: Avx2Program, options: Optional[CompileOptions]) -
     if output_path.exists():
         if output_path.read_bytes() != native_bytes:
             raise Avx2CompileError("content-addressed AVX2 artifact path contains different bytes")
+        os.chmod(str(output_path), 0o444)
     else:
         descriptor, publication_name = tempfile.mkstemp(
             prefix=output_path.name + ".tmp.", dir=str(artifact_dir)
@@ -447,11 +448,13 @@ def _compile_native(target_ir: Avx2Program, options: Optional[CompileOptions]) -
         publication_path = Path(publication_name)
         try:
             publication_path.write_bytes(native_bytes)
+            os.chmod(str(publication_path), 0o444)
             if output_path.exists():
                 if output_path.read_bytes() != native_bytes:
                     raise Avx2CompileError(
                         "content-addressed AVX2 artifact publication raced with different bytes"
                     )
+                os.chmod(str(output_path), 0o444)
             else:
                 os.replace(str(publication_path), str(output_path))
         finally:
diff --git a/python/tests/ut/pypto_x/test_cpu_avx2.py b/python/tests/ut/pypto_x/test_cpu_avx2.py
