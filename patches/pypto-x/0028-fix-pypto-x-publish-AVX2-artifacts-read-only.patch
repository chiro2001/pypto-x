         import pypto.compiler.targets.cpu_avx2 as compiler_module
@@ -68,6 +68,7 @@ CpuAvx2ExecutionError = _C["CpuAvx2ExecutionError"]
 CpuAvx2FeatureMismatchError = _C["CpuAvx2FeatureMismatchError"]
 CpuAvx2UnavailableError = _C["CpuAvx2UnavailableError"]
 CompileOptions = _C["CompileOptions"]
+Artifact = _C["Artifact"]
 CpuScalarCompiler = _C["CpuScalarCompiler"]
 Avx2Compiler = _C["Avx2Compiler"]
 Avx2CompileError = _C["Avx2CompileError"]
@@ -809,15 +810,34 @@ def test_readonly_output_and_wrong_target_are_rejected(tmp_path):
 def test_artifact_native_file_and_metadata_tampering_are_rejected(tmp_path):
     _, _, artifact = _compile(_add_program(), _target("avx2"), tmp_path)
     original = Path(artifact.path).read_bytes()
-    Path(artifact.path).write_bytes(original + b"tamper")
+    assert Path(artifact.path).stat().st_mode & 0o222 == 0
+    tamper_path = tmp_path / "tampered-copy.so"
+    shutil.copyfile(artifact.path, tamper_path)
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(tamper_path),
+        metadata=artifact.metadata,
+    )
+    tamper_path.write_bytes(original + b"tamper")
     with pytest.raises(CpuAvx2ArtifactError):
-        Avx2Runtime().load(artifact)
-    Path(artifact.path).write_bytes(original)
+        Avx2Runtime().load(tampered)
     metadata = dict(artifact.metadata)
     metadata["native_digest"] = "0" * 64
-    object.__setattr__(artifact, "metadata", metadata)
+    metadata_path = tmp_path / "metadata-tampered-copy.so"
+    shutil.copyfile(artifact.path, metadata_path)
+    metadata_tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(metadata_path),
+        metadata=metadata,
+    )
     with pytest.raises(CpuAvx2ArtifactError):
-        Avx2Runtime().load(artifact)
+        Avx2Runtime().load(metadata_tampered)
 
 
