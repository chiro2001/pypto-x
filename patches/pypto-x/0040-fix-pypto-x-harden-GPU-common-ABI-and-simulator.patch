+def test_strict_artifact_envelope_program_and_options():
+    compiler, target_ir, artifact = _compile(_add_program((5,)))
+
+    def rebuild(payload_data, metadata=None, format_name=None, abi=None):
+        payload = json.dumps(payload_data, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        current = dict(artifact.metadata)
+        if metadata:
+            current.update(metadata)
+        current["payload_digest"] = __import__("hashlib").sha256(payload).hexdigest()
+        return Artifact(
+            format=format_name or artifact.format,
+            entrypoint=artifact.entrypoint,
+            target=artifact.target,
+            abi_version=abi or artifact.abi_version,
+            payload=payload,
+            metadata=current,
+        )
+
+    decoded = json.loads(artifact.payload.decode("utf-8"))
+    unknown = dict(decoded)
+    unknown["unknown"] = 1
+    with pytest.raises(GpuArtifactError, match="unknown|missing"):
+        GpuCommonSimulator().load(rebuild(unknown))
+    unknown_program = dict(decoded)
+    unknown_program["program"] = dict(unknown_program["program"])
+    unknown_program["program"]["unknown"] = 1
+    with pytest.raises(GpuArtifactError, match="unknown|discarded|digest"):
+        GpuCommonSimulator().load(rebuild(unknown_program))
+    with pytest.raises(GpuArtifactError, match="format|options"):
+        GpuCommonSimulator().load(rebuild(decoded, format_name="wrong-format"))
+
+    options = CompileOptions(artifact_format="gpu-test", metadata={"tag": "ok"}, extra={"tile": 8})
+    option_artifact = compiler.compile(target_ir, options)
+    option_payload = json.loads(option_artifact.payload.decode("utf-8"))
+    option_payload["compile_options"]["artifact_format"] = "other"
+    option_payload_bytes = json.dumps(option_payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    option_metadata = dict(option_artifact.metadata)
+    option_metadata["payload_digest"] = hashlib.sha256(option_payload_bytes).hexdigest()
+    with pytest.raises(GpuArtifactError, match="format|options"):
+        GpuCommonSimulator().load(
+            Artifact(
+                format=option_artifact.format,
+                entrypoint=option_artifact.entrypoint,
+                target=option_artifact.target,
+                abi_version=option_artifact.abi_version,
+                payload=option_payload_bytes,
+                metadata=option_metadata,
+            )
+        )
