+@dataclass(frozen=True, init=False)
+class ThreadIndex:
+    """A logical invocation coordinate; each component is a 64-bit index."""
+
+    x: int
+    y: int
+    z: int
+
+    def __init__(self, value: Any = (0,), y: Optional[int] = None, z: Optional[int] = None):
+        if isinstance(value, int) and not isinstance(value, bool) and y is None and z is None:
+            raw = (value,)
+        elif y is not None or z is not None:
+            raw = (value, y if y is not None else 0, z if z is not None else 0)
+        else:
+            raw = value
+        if isinstance(raw, (str, bytes)):
+            raise ABIValidationError("thread index must be a 1-3D integer sequence", field="thread")
+        try:
+            values = tuple(raw)
+        except TypeError as exc:
+            raise ABIValidationError("thread index must be a 1-3D integer sequence", field="thread") from exc
+        if not 1 <= len(values) <= MAX_DIMENSIONS:
+            raise ABIValidationError("thread index must have between 1 and 3 dimensions", field="thread")
+        normalized = tuple(_non_negative_int(item, "thread[{}]".format(index)) for index, item in enumerate(values))
+        normalized += (0,) * (MAX_DIMENSIONS - len(normalized))
+        object.__setattr__(self, "x", normalized[0])
+        object.__setattr__(self, "y", normalized[1])
+        object.__setattr__(self, "z", normalized[2])
+
+    @property
+    def dims(self) -> Tuple[int, int, int]:
+        return (self.x, self.y, self.z)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"x": self.x, "y": self.y, "z": self.z}
+
+
+Thread = ThreadIndex
