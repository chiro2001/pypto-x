+def _gpu_cast(value: Any, dtype: str) -> Any:
+    """Cast exactly as the common GPU scalar contract requires.
+
+    HostTensor intentionally remains dtype-light for the existing CPU tests;
+    the simulator performs the device-visible binary32/BF16 rounding here.
+    """
+
+    dtype = canonical_dtype(dtype)
+    if dtype == "float32":
+        try:
+            return struct.unpack("<f", struct.pack("<f", float(value)))[0]
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise GpuExecutionError("value cannot be represented as float32") from exc
+    if dtype == "bf16":
+        # Reuse the established round-to-nearest-even implementation after
+        # first forcing the input through the IEEE binary32 domain.
+        value = _gpu_cast(value, "float32")
+        return _cast_value(value, "bf16")
+    return _cast_value(value, dtype)
+
