+def _ravel(coordinates: Sequence[int], shape: Sequence[int]) -> int:
+    if len(coordinates) != len(shape):
+        raise CpuSve256ExecutionError("coordinate rank does not match shape rank")
+    index = 0
+    for coordinate, dimension in zip(coordinates, shape):
+        if coordinate < 0 or coordinate >= dimension:
+            raise CpuSve256ExecutionError("coordinate is outside tensor shape")
+        index = index * dimension + coordinate
+    return index
+
+
+def _broadcast_values(value: Any, input_type: CoreType, output_type: CoreType, context: str) -> List[Any]:
+    output_shape = static_shape(output_type, context + ".output")
+    output_count = element_count(output_shape)
+    output_dtype = canonical_dtype(output_type.dtype)
+    if _is_scalar(input_type):
+        return [_cast_value(value, output_dtype) for _ in range(output_count)]
+    input_shape = static_shape(input_type, context + ".input")
+    if len(value) != element_count(input_shape):
+        raise CpuSve256ExecutionError("{} input storage length mismatch".format(context))
+    rank_delta = len(output_shape) - len(input_shape)
+    result = []
+    for output_index in range(output_count):
+        output_coords = _unravel(output_index, output_shape)
+        input_coords = [
+            0 if dimension == 1 else output_coords[axis + rank_delta]
+            for axis, dimension in enumerate(input_shape)
+        ]
+        result.append(_cast_value(value[_ravel(input_coords, input_shape)], output_dtype))
+    return result
+
+
+def _where_values(
+    condition: Any,
