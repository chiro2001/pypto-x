+    context: str,
+) -> Tuple[List[Any], List[Any], List[Any]]:
+    output_shape = static_shape(output_type, context + ".output") if _is_tensor(output_type) else ()
+    output_count = element_count(output_shape) if _is_tensor(output_type) else 1
+    prepared = []
+    for value, value_type, label in (
+        (condition, condition_type, "condition"),
+        (true_value, true_type, "input"),
+        (false_value, false_type, "other"),
+    ):
+        if _is_scalar(value_type):
+            prepared.append((value, None))
+            continue
+        shape = static_shape(value_type, context + "." + label)
+        if len(value) != element_count(shape):
+            raise CpuSve256ExecutionError("{} {} storage length mismatch".format(context, label))
+        prepared.append((value, shape))
+
+    def source_at(item: Tuple[Any, Optional[Tuple[int, ...]]], coords: Tuple[int, ...]) -> Any:
+        value, shape = item
+        if shape is None:
+            return value
+        rank_delta = len(output_shape) - len(shape)
+        source_coords = [
+            0 if dimension == 1 else coords[axis + rank_delta]
+            for axis, dimension in enumerate(shape)
+        ]
+        return value[_ravel(source_coords, shape)]
+
+    conditions, true_values, false_values = [], [], []
+    for output_index in range(output_count):
+        coords = _unravel(output_index, output_shape)
+        predicate = source_at(prepared[0], coords)
+        conditions.append(predicate)
+        true_values.append(source_at(prepared[1], coords))
+        false_values.append(source_at(prepared[2], coords))
+    return conditions, true_values, false_values
