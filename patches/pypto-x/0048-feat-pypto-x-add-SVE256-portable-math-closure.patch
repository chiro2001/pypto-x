+    input_shape = static_shape(input_type, context + ".input")
+    if not isinstance(value, list) or len(value) != element_count(input_shape):
+        raise CpuVectorExecutionError("{} input storage length mismatch".format(context))
+    rank_delta = len(output_shape) - len(input_shape)
+    result = []
+    for output_index in range(output_count):
+        output_coords = _unravel(output_index, output_shape)
+        input_coords = []
+        for axis, dimension in enumerate(input_shape):
+            coordinate = output_coords[axis + rank_delta]
+            input_coords.append(0 if dimension == 1 else coordinate)
+        input_index = _ravel(input_coords, input_shape)
+        result.append(_cast_value(value[input_index], output_dtype))
+    return result
