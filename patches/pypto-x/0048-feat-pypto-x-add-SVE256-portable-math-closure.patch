+def _float32(value: Any) -> float:
+    """Round one intermediate to the FP32 accumulation contract."""
+
+    try:
+        return struct.unpack("<f", struct.pack("<f", float(value)))[0]
+    except OverflowError:
+        return math.copysign(float("inf"), float(value))
+
+
+def _math_scalar(name: str, value: Any) -> float:
+    value = float(value)
+    if name == "exp":
+        try:
+            return math.exp(value)
+        except OverflowError:
+            return float("inf")
+    if name == "rsqrt":
+        if math.isnan(value) or value < 0.0:
+            return float("nan")
+        if value == 0.0:
+            return float("inf")
+        return 1.0 / math.sqrt(value)
+    if name == "sigmoid":
+        if value >= 0.0:
+            return 1.0 / (1.0 + math.exp(-value))
+        exp_value = math.exp(value)
+        return exp_value / (1.0 + exp_value)
+    if name == "silu":
+        if value == float("-inf"):
+            return 0.0
+        if value == float("inf"):
+            return value
+        if value >= 0.0:
+            sigmoid = 1.0 / (1.0 + math.exp(-value))
+        else:
+            exp_value = math.exp(value)
+            sigmoid = exp_value / (1.0 + exp_value)
+        return value * sigmoid
+    if name == "softplus":
+        return math.log1p(math.exp(-abs(value))) + max(value, 0.0)
+    raise CpuVectorExecutionError("unsupported vector math operation {!r}".format(name))
+
+
+def _math_value(name: str, value: Any, dtype: str) -> Any:
+    return _cast_value(_math_scalar(name, value), canonical_dtype(dtype))
+
