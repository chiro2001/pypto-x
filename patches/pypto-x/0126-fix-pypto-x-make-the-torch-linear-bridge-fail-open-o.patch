+    def _quarantine_file(self, path: Path, reason: str) -> Optional[Path]:
+        """Rename a corrupt artifact aside; never delete the bytes."""
+
+        try:
+            stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
+            target = path.with_name("{}.corrupt-{}-{}".format(path.name, stamp, os.getpid()))
+            os.replace(str(path), str(target))
+        except OSError as exc:
+            self._last_disk_error = "quarantine failed for {}: {}".format(path, exc)
+            return None
+        with self._lock:
+            self._stats["quarantined"] += 1
+        self._last_disk_error = "quarantined corrupt artifact {} ({})".format(path, reason)
+        return target
