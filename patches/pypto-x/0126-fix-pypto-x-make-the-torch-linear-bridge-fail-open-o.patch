+    def _quarantine_corrupt(self, path: Optional[Any], expected_digest: Optional[str]) -> Optional[Path]:
+        """Quarantine ``path`` only when its bytes do not match the digest."""
+
+        if not path or not expected_digest:
+            return None
+        artifact_path = Path(str(path))
+        if not artifact_path.is_file():
+            return None
+        actual = _sha256_file(artifact_path)
+        if actual is None or actual == expected_digest:
+            return None
+        return self._quarantine_file(artifact_path, "content digest mismatch")
+
+    def _audit_artifacts(self) -> int:
+        """Quarantine any content-addressed .so whose bytes no longer match its name."""
+
+        directory = self._artifacts_dir()
+        if directory is None or not directory.is_dir():
+            return 0
+        repaired = 0
+        try:
+            entries = sorted(directory.glob("pypto_x_avx512_*.so"))
+        except OSError:
+            return 0
+        for path in entries:
+            match = _ARTIFACT_NAME.match(path.name)
+            if match is None:
+                continue
+            actual = _sha256_file(path)
+            if actual is None or actual == match.group(1):
+                continue
+            if self._quarantine_file(path, "filename/bytes digest mismatch") is not None:
+                repaired += 1
+        return repaired
