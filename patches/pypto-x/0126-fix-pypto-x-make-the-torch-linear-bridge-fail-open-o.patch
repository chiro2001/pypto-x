+def test_corrupt_content_addressed_so_is_quarantined_and_rebuilt(fresh_caches):
+    """V8J-D2: a rewritten content-addressed .so must self-heal.
+
+    The compiler refuses to publish different bytes at an existing digest
+    path, so the bridge has to quarantine the corrupt file first; the bytes
+    are renamed aside (kept for audit), not deleted.
+    """
+
+    import os
+    from pathlib import Path
+
+    got, x, weight = _call(m=2, k=4, n=5)
+    assert torch.equal(got, torch.nn.functional.linear(x, weight))
+    key = fresh_caches.key("bf16", 2, 4, 5)
+    sidecar = fresh_caches.cache_dir / ("pypto_x_linear_{}.json".format(key.digest[:32]))
+    payload = json.loads(sidecar.read_text(encoding="utf-8"))
+    so_path = Path(payload["artifact"]["path"])
+    original = so_path.read_bytes()
+    # Never truncate a file that this process may still have mapped (that is a
+    # SIGBUS, not a Python error).  Rename the mapped inode aside and publish
+    # a *new* corrupt inode at the same path: this is exactly what a second
+    # process would see after external corruption.
+    mapped_original = so_path.with_name(so_path.name + ".pre-tamper")
+    os.replace(so_path, mapped_original)
+    so_path.write_bytes(original[:96] + b"\x00" * 16)
+
+    second = LinearKernelCache(cache_dir=fresh_caches.cache_dir, disk_cache=True)
+    reset_linear_kernel_cache(second)
+    recovered, x2, weight2 = _call(m=2, k=4, n=5)
+    assert torch.equal(recovered, torch.nn.functional.linear(x2, weight2))
+
+    stats = second.stats
+    assert stats["load_failures"] == 1
+    assert stats["quarantined"] >= 1
+    assert stats["kernel_builds"] == 1
+    assert stats["compile_calls"] == 1
+    assert so_path.is_file()
+    assert list(so_path.parent.glob(so_path.name + ".corrupt-*"))
+
+    # A third fresh process must now be a normal disk hit.
+    third = LinearKernelCache(cache_dir=fresh_caches.cache_dir, disk_cache=True)
+    reset_linear_kernel_cache(third)
+    again, x3, weight3 = _call(m=2, k=4, n=5)
+    assert torch.equal(again, torch.nn.functional.linear(x3, weight3))
+    stats = third.stats
+    assert stats["disk_hits"] == 1
+    assert stats["kernel_builds"] == 0
+    assert stats["quarantined"] == 0
+
+
