+    source = struct.pack("<15f", *([1.0] * 15))
+    qemu = shutil.which("qemu-aarch64")
+    if qemu is None:
+        pytest.skip("qemu-aarch64 is unavailable")
+
+    def invoke(version, descriptor_bytes, descriptor_size, tag):
+        payload = struct.pack(
+            "<6I4Q", 0x56535850, version, 21, 0, 0, 0,
+            15, 15, descriptor_size, tag,
+        ) + source + descriptor_bytes
+        return subprocess.run(
+            [qemu, "-L", "/usr/aarch64-linux-gnu", "-cpu", "max,sve256=on", artifact.path],
+            input=payload, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+
+    old_layout = invoke(1, descriptor, len(descriptor), 0)
+    old_magic, old_version, old_status, _old_dtype, _old_count = struct.unpack(
+        "<4IQ", old_layout.stdout[:24]
+    )
+    assert old_layout.returncode != 0 and old_magic == 0x56535850
+    assert old_version == 1 and old_status != 0
+
+    legacy_v2 = invoke(2, descriptor, len(descriptor), 0)
+    _magic, version, status, _dtype, _count = struct.unpack("<4IQ", legacy_v2.stdout[:24])
+    assert legacy_v2.returncode != 0 and version == 3 and status != 0
+
+    truncated = invoke(3, descriptor[:-1], len(descriptor), 0)
+    _magic, version, status, _dtype, _count = struct.unpack("<4IQ", truncated.stdout[:24])
+    assert truncated.returncode != 0 and version == 3 and status != 0
