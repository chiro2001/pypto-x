-static uint64_t ptx_index_map_hash(const uint64_t *map, uint64_t count) {
+/* FNV-1a is a cheap in-process tamper check for the compact descriptor.  The
+ * artifact separately carries a SHA-256 descriptor digest for cache identity. */
