+static int ptx_layout_source_index(const PtxLayoutDescriptor *descriptor,
+                                    uint64_t output_index, uint64_t *source_index) {
+    uint64_t coordinates[PTX_LAYOUT_MAX_RANK] = {0};
+    uint64_t source_coordinates[PTX_LAYOUT_MAX_RANK] = {0};
+    uint64_t remaining = output_index, value, offset = 0;
+    uint32_t axis;
