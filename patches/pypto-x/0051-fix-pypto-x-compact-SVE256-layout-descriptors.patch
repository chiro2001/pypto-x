             result = _vector_map(
                 plan,
-                [source[source_index] for source_index in layout.index_map],
+                [source[_layout_source_index(layout, index, context)] for index in range(layout.output_elements)],
                 lambda value: _cast_value(value, plan.dtype),
                 context,
             )
@@ -543,6 +543,10 @@ def _vector_map(plan: Any, values: Sequence[Any], operation: Callable[[Any], Any
             )
         )
     result = [None] * plan.element_count
+    if plan.iteration.compact:
+        for index in range(plan.element_count):
+            result[index] = operation(values[index])
+        return result
     for chunk in plan.iteration.chunks:
         for offset in range(chunk.length):
             index = chunk.start + offset
@@ -552,6 +556,34 @@ def _vector_map(plan: Any, values: Sequence[Any], operation: Callable[[Any], Any
     return result
 
 
+def _layout_source_index(layout: Any, output_index: int, context: str) -> int:
+    if layout.kind == "logical_layout_copy":
+        source_index = output_index
+    else:
+        coordinates = [0] * len(layout.output_shape)
+        remaining = output_index
+        for axis in range(len(layout.output_shape) - 1, -1, -1):
+            dimension = layout.output_shape[axis]
+            if dimension:
+                coordinates[axis] = remaining % dimension
+                remaining //= dimension
+        source_coordinates = [0] * len(layout.input_shape)
+        for output_axis, source_axis in enumerate(layout.permutation):
+            source_coordinates[source_axis] = (
+                layout.slice_starts[source_axis]
+                + coordinates[output_axis] * layout.slice_steps[source_axis]
+            )
+        source_index = sum(
+            coordinate * stride
+            for coordinate, stride in zip(source_coordinates, layout.source_strides)
+        )
+    if source_index < 0 or source_index >= layout.source_elements:
+        raise CpuVectorExecutionError(
+            "{} layout descriptor produced source index outside bounds".format(context)
+        )
+    return source_index
+
+
