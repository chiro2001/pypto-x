+static uint32_t ptx_read_u32(const unsigned char *bytes) {
+    uint32_t value;
+    memcpy(&value, bytes, sizeof(value));
+    return value;
+}
+
+static uint64_t ptx_read_u64(const unsigned char *bytes) {
+    uint64_t value;
+    memcpy(&value, bytes, sizeof(value));
+    return value;
+}
+
+static void ptx_free_layout_descriptor(PtxLayoutDescriptor *descriptor) {
+    free(descriptor->storage);
+    memset(descriptor, 0, sizeof(*descriptor));
+}
+
+static int ptx_decode_layout_descriptor(const unsigned char *bytes, size_t length,
+                                        PtxLayoutDescriptor *descriptor) {
+    size_t expected, storage_bytes, cursor;
+    uint64_t array_count, storage_u64;
+    uint32_t rank, output_rank;
+    if (length < PTX_LAYOUT_DESC_HEADER_BYTES || memcmp(bytes, "PXLD", 4) != 0 ||
+        ptx_read_u32(bytes + 4) != PTX_LAYOUT_DESC_VERSION)
+        return PTX_STATUS_BAD_REQUEST;
+    rank = ptx_read_u32(bytes + 8);
+    output_rank = ptx_read_u32(bytes + 12);
+    if (rank > PTX_LAYOUT_MAX_RANK || output_rank > PTX_LAYOUT_MAX_RANK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_u64_mul((uint64_t)rank, 5U, &array_count) != PTX_STATUS_OK ||
+        ptx_u64_add(array_count, output_rank, &array_count) != PTX_STATUS_OK ||
+        ptx_u64_mul(array_count, sizeof(uint64_t), &array_count) != PTX_STATUS_OK ||
+        ptx_u64_add(PTX_LAYOUT_DESC_HEADER_BYTES, array_count, &array_count) != PTX_STATUS_OK ||
+        ptx_u64_to_size(array_count, &expected) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (expected != length ||
+        ptx_u64_mul((uint64_t)rank, 5U, &array_count) != PTX_STATUS_OK ||
+        ptx_u64_add(array_count, output_rank, &array_count) != PTX_STATUS_OK ||
+        ptx_u64_mul(array_count, sizeof(uint64_t), &storage_u64) != PTX_STATUS_OK ||
+        ptx_u64_to_size(storage_u64, &storage_bytes) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    memset(descriptor, 0, sizeof(*descriptor));
+    descriptor->kind = ptx_read_u32(bytes + 16);
+    if (ptx_read_u32(bytes + 20) != 0)
+        return PTX_STATUS_BAD_REQUEST;
+    descriptor->input_rank = rank;
+    descriptor->output_rank = output_rank;
+    descriptor->source_elements = ptx_read_u64(bytes + 24);
+    descriptor->output_elements = ptx_read_u64(bytes + 32);
+    descriptor->storage = (uint64_t *)calloc(
+        1, storage_bytes ? (size_t)storage_bytes : sizeof(uint64_t)
+    );
+    if (!descriptor->storage)
+        return PTX_STATUS_RUNTIME;
+    descriptor->input_shape = descriptor->storage;
+    descriptor->output_shape = descriptor->input_shape + rank;
+    descriptor->source_strides = descriptor->output_shape + output_rank;
+    descriptor->permutation = descriptor->source_strides + rank;
+    descriptor->slice_starts = descriptor->permutation + rank;
+    descriptor->slice_steps = descriptor->slice_starts + rank;
+    cursor = PTX_LAYOUT_DESC_HEADER_BYTES;
+    memcpy(descriptor->input_shape, bytes + cursor, rank * sizeof(uint64_t));
+    cursor += rank * sizeof(uint64_t);
+    memcpy(descriptor->output_shape, bytes + cursor, output_rank * sizeof(uint64_t));
+    cursor += output_rank * sizeof(uint64_t);
+    memcpy(descriptor->source_strides, bytes + cursor, rank * sizeof(uint64_t));
+    cursor += rank * sizeof(uint64_t);
+    memcpy(descriptor->permutation, bytes + cursor, rank * sizeof(uint64_t));
+    cursor += rank * sizeof(uint64_t);
+    memcpy(descriptor->slice_starts, bytes + cursor, rank * sizeof(uint64_t));
+    cursor += rank * sizeof(uint64_t);
+    memcpy(descriptor->slice_steps, bytes + cursor, rank * sizeof(uint64_t));
+    return cursor + rank * sizeof(uint64_t) == length ? PTX_STATUS_OK : PTX_STATUS_BAD_REQUEST;
+}
+
+static int ptx_validate_layout_descriptor(const PtxLayoutDescriptor *descriptor,
+                                          uint32_t operation,
+                                          uint64_t source_elements,
+                                          uint64_t output_elements) {
+    uint64_t source_product = 1, output_product = 1, running = 1, expected;
+    uint32_t axis;
+    if (descriptor->source_elements != source_elements ||
+        descriptor->output_elements != output_elements ||
+        (operation <= PTX_CONTIGUOUS && descriptor->kind != PTX_LAYOUT_KIND_COPY) ||
+        (operation == PTX_TRANSPOSE && descriptor->kind != PTX_LAYOUT_KIND_TRANSPOSE) ||
+        (operation == PTX_SLICE && descriptor->kind != PTX_LAYOUT_KIND_SLICE))
+        return PTX_STATUS_BAD_REQUEST;
+    for (axis = 0; axis < descriptor->input_rank; ++axis) {
+        if (ptx_u64_mul(source_product, descriptor->input_shape[axis], &source_product) != PTX_STATUS_OK ||
+            descriptor->permutation[axis] >= descriptor->input_rank ||
+            descriptor->slice_steps[axis] == 0 ||
+            descriptor->slice_starts[axis] > descriptor->input_shape[axis])
+            return PTX_STATUS_BAD_REQUEST;
+    }
+    for (axis = 0; axis < descriptor->output_rank; ++axis)
+        if (ptx_u64_mul(output_product, descriptor->output_shape[axis], &output_product) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    if (source_product != source_elements || output_product != output_elements)
+        return PTX_STATUS_BAD_REQUEST;
+    for (axis = descriptor->input_rank; axis > 0; --axis) {
+        uint32_t current = axis - 1;
+        if (descriptor->input_shape[current] == 0 && descriptor->slice_starts[current] != 0)
+            return PTX_STATUS_BAD_REQUEST;
+        if (descriptor->permutation[current] >= descriptor->input_rank)
+            return PTX_STATUS_BAD_REQUEST;
+        if (descriptor->kind == PTX_LAYOUT_KIND_SLICE && descriptor->permutation[current] != current)
+            return PTX_STATUS_BAD_REQUEST;
+        if (descriptor->kind != PTX_LAYOUT_KIND_SLICE &&
+            (descriptor->slice_starts[current] != 0 || descriptor->slice_steps[current] != 1))
+            return PTX_STATUS_BAD_REQUEST;
+        expected = running;
+        if (descriptor->source_strides[current] != expected ||
+            ptx_u64_mul(running, descriptor->input_shape[current], &running) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    }
+    for (axis = 0; axis < descriptor->input_rank; ++axis) {
+        uint32_t other;
+        for (other = axis + 1; other < descriptor->input_rank; ++other)
+            if (descriptor->permutation[axis] == descriptor->permutation[other])
+                return PTX_STATUS_BAD_REQUEST;
+    }
+    if (descriptor->kind == PTX_LAYOUT_KIND_COPY) {
+        if (source_elements != output_elements)
+            return PTX_STATUS_BAD_REQUEST;
+        for (axis = 0; axis < descriptor->input_rank; ++axis)
+            if (descriptor->permutation[axis] != axis)
+                return PTX_STATUS_BAD_REQUEST;
+    } else {
+        if (descriptor->input_rank != descriptor->output_rank)
+            return PTX_STATUS_BAD_REQUEST;
+        for (axis = 0; axis < descriptor->output_rank; ++axis) {
+            uint64_t source_axis = descriptor->permutation[axis];
+            if (descriptor->kind == PTX_LAYOUT_KIND_TRANSPOSE &&
+                descriptor->output_shape[axis] != descriptor->input_shape[source_axis])
+                return PTX_STATUS_BAD_REQUEST;
+            if (descriptor->kind == PTX_LAYOUT_KIND_SLICE && descriptor->output_shape[axis]) {
+                uint64_t last;
+                if (ptx_u64_mul(descriptor->output_shape[axis] - 1,
+                                descriptor->slice_steps[source_axis], &last) != PTX_STATUS_OK ||
+                    last >= descriptor->input_shape[source_axis] - descriptor->slice_starts[source_axis])
+                    return PTX_STATUS_BAD_REQUEST;
+            }
+        }
+    }
+    return PTX_STATUS_OK;
+}
