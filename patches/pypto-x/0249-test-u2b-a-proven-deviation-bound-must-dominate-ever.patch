+@requires_aocl
+@requires_int8_host
+def test_proven_bound_below_the_observations_is_refused_at_plan_validation():
+    """A bound that is refuted by its own recorded observations fail-closes."""
+
+    script = aocl_int8_provider_capabilities()[0].to_dict()["exactness_envelope"]
+    entries = []
+    for entry in aocl_int8_provider_capabilities():
+        document = dict(entry.to_dict())
+        envelope = dict(document["exactness_envelope"])
+        envelope["deviation_bound_kind"] = "analytic_f32_chain_upper_bound"
+        envelope["deviation_bound_available"] = True
+        # Dominates every observation except K=133144 (965 < recorded 966).
+        envelope["deviation_bound_by_k"] = {
+            key: value for key, value in envelope["measured_deviation_by_k"].items()
+        }
+        envelope["deviation_bound_by_k"]["133144"] = 965
+        envelope["upper_bound"] = {
+            "status": "proven",
+            "reason": "synthetic_unit_test_bound",
+            "blocking_evidence": [],
+        }
+        document["exactness_envelope"] = envelope
+        entries.append(ProviderCapability.from_dict(document))
+    assert script["measured_deviation_by_k"]["133144"] == 966
+    snapshot = _host_snapshot(providers=[portable_provider_capability()] + entries)
+    strict = ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="required", required=AOCL_LPGEMM_INT8_PROVIDER_ID),
+        numeric=NumericPolicy(requirement="deterministic", require_proven_deviation_bound=True),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=1),
+    )
+    details = _assert_failure(
+        ARTIFACT_MISMATCH, lambda: resolve_qmatmul(strict, snapshot, (2, 8), (8, 2))
+    )
+    assert details["reason"] == "plan_field_inconsistent"
+    assert "dominate" in str(details["message"])
+
+
