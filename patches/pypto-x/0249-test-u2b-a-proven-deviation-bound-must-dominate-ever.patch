From 6778ce58ef7a3edccb334e70b2d70d491e5f6446 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 18:29:21 +0800
Subject: [PATCH 249/256] test(u2b): a proven deviation bound must dominate
 every recorded observation

plan/report validators now fail closed (plan_field_inconsistent / report_field_inconsistent) when a proven-kind envelope declares a bound that is below one of its own measured_deviation_by_k observations; the synthetic analytic-kind test now carries a covering bound and a negative case pins the refusal.
---
 python/pypto/execution/plan.py                         | 21 ++++++++++++++++
 python/pypto/execution/report.py                       | 21 ++++++++++++++++
 python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py | 49 +++++++++++++++++++++++++++++++++++++-
 3 files changed, 90 insertions(+), 1 deletion(-)

diff --git a/python/pypto/execution/plan.py b/python/pypto/execution/plan.py
index 37574ceb5..06d661af0 100644
--- a/python/pypto/execution/plan.py
+++ b/python/pypto/execution/plan.py
@@ -317,6 +317,27 @@ def _validate_optional_exactness_fields(data: Mapping[str, Any]) -> None:
                 requested=None,
                 reason="plan_field_missing",
             )
+        declared = envelope.get("deviation_bound_by_k")
+        measured = envelope.get("measured_deviation_by_k")
+        if isinstance(declared, Mapping) and isinstance(measured, Mapping):
+            # A proven bound must dominate every recorded observation: a bound
+            # refuted by our own scope would be a false guarantee, so the
+            # envelope is refused (fail-closed) instead of carrying it forward.
+            shortfall = {
+                key: {"bound": declared.get(key), "observed": value}
+                for key, value in measured.items()
+                if not isinstance(declared.get(key), int)
+                or isinstance(declared.get(key), bool)
+                or declared[key] < value
+            }
+            if shortfall:
+                raise ArtifactMismatchError(
+                    "a proven deviation bound must dominate every recorded observation",
+                    field="plan.{}.exactness_envelope.deviation_bound_by_k".format(label),
+                    requested=shortfall,
+                    available=None,
+                    reason="plan_field_inconsistent",
+                )
         for field in ("measurement_scope", "upper_bound"):
             value = envelope.get(field)
             if value is not None and not isinstance(value, Mapping):
