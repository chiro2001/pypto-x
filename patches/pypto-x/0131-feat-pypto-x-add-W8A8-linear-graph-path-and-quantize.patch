+def test_four_opcode_program_is_bit_exact_on_scalar_and_vector():
+    scalar_output, golden = _compile_and_run_scalar()
+    assert [value for row in scalar_output.tolist() for value in row] == golden
+    vector_output, _ = _compile_and_run_vector()
+    assert [value for row in vector_output.tolist() for value in row] == golden
