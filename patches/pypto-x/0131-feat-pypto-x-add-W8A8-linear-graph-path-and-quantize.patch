+def build_qwen35_w8a8_analytic_coverage(
+    compact_manifest: Sequence[Mapping[str, Any]],
+    profile: Mapping[str, int],
+    *,
+    batch: int,
+    steps: int,
+    past_length: int = 0,
+    quantize_lm_head: bool = False,
+) -> Mapping[str, Any]:
+    """Analytic §2.4 coverage from the frozen topology and a shape profile.
+
+    This is the closed-form companion of
+    :func:`build_qwen35_w8a8_graph_coverage`; the builder compares both and
+    fails closed on drift.  The denominator is the whole-net MAC count and
+    includes the BF16 lm_head projection (contract §6: a BF16 lm_head must be
+    visible in the reported coverage).  The GDR recurrence is counted as the
+    three real rank-4 matmuls emitted by ``_gdr_step``
+    (``3 * nv * dk * dv`` per layer/token), not the obsolete legacy formula.
+    """
+
+    from pypto.portable.qwen35 import (
+        QWEN35_08B_SHAPE_METADATA,
+        QWEN35_LINEAR_WEIGHT_CLASSES,
+    )
+
+    if isinstance(batch, bool) or not isinstance(batch, int) or batch <= 0:
+        raise W8A8CoverageError("batch must be a positive integer")
+    if isinstance(steps, bool) or not isinstance(steps, int) or steps <= 0:
+        raise W8A8CoverageError("steps must be a positive integer")
+    if isinstance(past_length, bool) or not isinstance(past_length, int) or past_length < 0:
+        raise W8A8CoverageError("past_length must be a non-negative integer")
+    by_class = {_entry_name(entry): entry for entry in compact_manifest}
+    linear_classes = tuple(QWEN35_LINEAR_WEIGHT_CLASSES)
+    missing = [name for name in linear_classes if name not in by_class]
+    if missing:
+        raise W8A8CoverageError("compact manifest is missing linear classes {}".format(tuple(missing)[:4]))
+    quantized_classes = tuple(
+        name for name in linear_classes if by_class[name].get("dtype") == "int8"
+    )
+    if not quantized_classes:
+        raise W8A8CoverageError("analytic coverage requires at least one quantized linear class")
+    total_elements = sum(_entry_elements(by_class[name]) for name in linear_classes)
+    quantized_elements = sum(_entry_elements(by_class[name]) for name in quantized_classes)
+    coverage = quantized_elements / total_elements
+
+    int8_macs = quantized_elements * batch * steps
+    float_linear_macs = (total_elements - quantized_elements) * batch * steps
+
+    hidden = int(profile["hidden"])
+    intermediate = int(profile["intermediate"])
+    vocab = int(profile["vocab"])
+    qh = int(profile["query_heads"])
+    kvh = int(profile["kv_heads"])
+    d = int(profile["head_dim"])
+    nk = int(profile["linear_key_heads"])
+    nv = int(profile["linear_value_heads"])
+    dk = int(profile["linear_key_dim"])
+    dv = int(profile["linear_value_dim"])
+    kernel = int(profile["conv_kernel"])
+    gdr_layers = int(QWEN35_08B_SHAPE_METADATA["num_hidden_layers"]) - len(
+        QWEN35_08B_SHAPE_METADATA["full_attention_indices_zero_based"]
+    )
+    full_layers = len(QWEN35_08B_SHAPE_METADATA["full_attention_indices_zero_based"])
+    conv_channels = 2 * nk * dk + nv * dv
+    total_length = past_length + steps
+    attention_macs = full_layers * batch * 2 * qh * d * total_length * steps
+    recurrent_macs = gdr_layers * batch * steps * 3 * nv * dk * dv
+    conv_macs = gdr_layers * batch * steps * conv_channels * kernel
+    lm_head_macs = vocab * hidden * batch * steps
+    if quantize_lm_head:
+        int8_macs += lm_head_macs
+    else:
+        float_linear_macs += lm_head_macs
+    total_macs = int8_macs + float_linear_macs + attention_macs + recurrent_macs + conv_macs
+    ratio = int8_macs / total_macs
+    return {
+        QUANTIZED_LINEAR_COVERAGE_FIELD: coverage,
+        WHOLE_NET_INT8_COMPUTE_RATIO_FIELD: ratio,
+        "measurement": "frozen_topology_formula",
+        "quantized_linear_tensor_count": len(quantized_classes),
+        "total_linear_tensor_count": len(linear_classes),
+        "quantized_linear_parameter_elements": quantized_elements,
+        "total_linear_parameter_elements": total_elements,
+        "int8_macs": int8_macs,
+        "float_linear_macs": float_linear_macs,
+        "attention_qk_pv_macs": attention_macs,
+        "gdr_recurrent_macs": recurrent_macs,
+        "conv1d_macs": conv_macs,
+        "lm_head_macs": lm_head_macs,
+        "total_macs": total_macs,
+        "batch": batch,
+        "steps": steps,
+        "past_length": past_length,
+        "quantize_lm_head": bool(quantize_lm_head),
+        "intermediate_size": intermediate,
+        "kv_heads": kvh,
+    }
+
+
+def build_qwen35_w8a8_graph_coverage(
+    operations: Sequence[Any],
+    compact_manifest: Sequence[Mapping[str, Any]],
+    *,
+    quantized_scope: str = "default",
+    quantize_lm_head: bool = False,
+    batch: int = 1,
+    steps: int = 1,
+) -> W8A8GraphCoverageManifest:
+    """Compute the R9 fields from the operations actually emitted by the graph."""
+
+    from pypto.portable.qwen35 import (
+        QWEN35_LINEAR_WEIGHT_CLASSES,
+        qwen35_decoder_exact_parameter_manifest,
+    )
+
+    by_class = {_entry_name(entry): entry for entry in compact_manifest}
+    missing_classes = [name for name in QWEN35_LINEAR_WEIGHT_CLASSES if name not in by_class]
+    if missing_classes:
+        raise W8A8CoverageError(
+            "compact manifest is missing linear classes {}".format(tuple(missing_classes)[:4])
+        )
+    linear_classes = tuple(QWEN35_LINEAR_WEIGHT_CLASSES)
+    quantized_classes = tuple(
+        name for name in linear_classes if by_class[name].get("dtype") == "int8"
+    )
+    if not quantized_classes:
+        raise W8A8CoverageError("graph coverage requires at least one quantized linear class")
+    total_elements = sum(_entry_elements(by_class[name]) for name in linear_classes)
+    quantized_elements = sum(_entry_elements(by_class[name]) for name in quantized_classes)
+    coverage = quantized_elements / total_elements
+    quantized_names = _compact_quantized_names(compact_manifest)
+
+    int8_macs = 0
+    float_matmul_macs = 0
+    conv_macs = 0
+    int8_operations = 0
+    float_matmul_operations = 0
+    conv_operations = 0
+    for operation in operations:
+        name = str(getattr(operation, "name", ""))
+        if name in ("qmatmul_s8s8_s32", "tensor.qmatmul_s8s8_s32", "core.qmatmul_s8s8_s32"):
+            int8_macs += _operation_macs(operation)
+            int8_operations += 1
+        elif name == "matmul":
+            float_matmul_macs += _operation_macs(operation)
+            float_matmul_operations += 1
+        elif name == "mul":
+            # The depthwise causal Conv1D is emitted as ``kernel`` real mul
+            # operations ([B,C,T] each); their stable SSA output names carry
+            # the ``_causal_conv_product_`` prefix.  Count them from the graph
+            # instead of trusting a per-profile formula.
+            output = tuple(getattr(operation, "outputs", ()))
+            if len(output) != 1 or "_causal_conv_product_" not in str(output[0].name):
+                continue
+            shape = _concrete_shape(output[0], "causal conv product")
+            elements = 1
+            for dimension in shape:
+                elements *= dimension
+            conv_macs += elements
+            conv_operations += 1
+
+    if isinstance(batch, bool) or not isinstance(batch, int) or batch <= 0:
+        raise W8A8CoverageError("batch must be a positive integer")
+    if isinstance(steps, bool) or not isinstance(steps, int) or steps <= 0:
+        raise W8A8CoverageError("steps must be a positive integer")
+    total_macs = int8_macs + float_matmul_macs + conv_macs
+    ratio = int8_macs / total_macs
+
+    # The legacy static estimate is only defined for the frozen 0.8B shape
+    # profile; keep it visible there and mark it unavailable for small
+    # differential profiles (its formula uses checked-in 0.8B dimensions).
+    exact_entries = qwen35_decoder_exact_parameter_manifest()
+    model_linear_names = set(qwen35_linear_parameter_names(exact_entries))
+    model_elements = sum(
+        _entry_elements(entry)
+        for entry in exact_entries
+        if _entry_name(entry) in model_linear_names
+    )
+    static_ratio: Optional[float] = None
+    static_int8: Optional[int] = None
+    static_total: Optional[int] = None
+    static_breakdown: Mapping[str, Any]
+    if total_elements == model_elements:
+        static_macs = _mac_counts(
+            exact_entries,
+            quantized_names,
+            {"batch": batch, "prefill_steps": steps, "past_length": 1},
+        )
+        static_ratio = static_macs["int8_macs"] / static_macs["total_macs"]
+        static_int8 = static_macs["int8_macs"]
+        static_total = static_macs["total_macs"]
+        static_breakdown = dict(static_macs)
+        static_breakdown["available"] = True
+        static_breakdown["note"] = (
+            "legacy §2.4 static formula, kept for static-vs-real comparison; "
+            "its recurrent term uses the old nv*nk*dk+nv*nk*dv+2*nv*dk*dv shape model"
+        )
+    else:
+        static_breakdown = {
+            "available": False,
+            "reason": "shape_profile is not the frozen 0.8B profile",
+            "actual_linear_parameter_elements": total_elements,
+            "model_linear_parameter_elements": model_elements,
+        }
+
+    entries_by_name = {_entry_name(entry): entry for entry in exact_entries}
+    island_names = tuple(sorted(set(entries_by_name) - set(quantized_names)))
+    lm_head_elements = 0
+    if quantize_lm_head:
+        shared = by_class.get("embedding_lm_head_shared_weight")
+        if shared is None:
+            raise W8A8CoverageError("lm_head dual packing requires the tied embedding entry")
+        shared_shape = tuple(int(dimension) for dimension in shared.get("shape", ()))
+        if len(shared_shape) != 2:
+            raise W8A8CoverageError("tied embedding entry must be rank 2")
+        lm_head_elements = shared_shape[0] * shared_shape[1]
+    manifest = W8A8GraphCoverageManifest(
+        w8a8_linear_coverage=coverage,
+        whole_net_int8_compute_ratio=ratio,
+        measurement="graph_operation_count_real_matmul_and_conv1d",
+        quantized_linear_tensor_count=len(quantized_names),
+        total_linear_tensor_count=len(linear_classes),
+        quantized_linear_parameter_elements=quantized_elements,
+        total_linear_parameter_elements=total_elements,
+        int8_macs_from_graph=int8_macs,
+        float_matmul_macs_from_graph=float_matmul_macs,
+        conv1d_macs_from_graph=conv_macs,
+        total_macs_from_graph=total_macs,
+        static_shape_model_ratio=static_ratio,
+        static_shape_model_int8_macs=static_int8,
+        static_shape_model_total_macs=static_total,
+        mac_breakdown={
+            "int8_qmatmul_operations": int8_operations,
+            "float_matmul_operations": float_matmul_operations,
+            "causal_conv_product_operations": conv_operations,
+            "int8_macs": int8_macs,
+            "float_matmul_macs": float_matmul_macs,
+            "conv1d_macs": conv_macs,
+            "total_macs": total_macs,
+        },
+        static_shape_model_breakdown=static_breakdown,
+        quantized_parameter_names=tuple(quantized_names),
+        bf16_island_names=island_names,
+        quantized_lm_head_parameter_elements=lm_head_elements,
+    )
+    manifest.assert_nonzero()
+    return manifest
+
