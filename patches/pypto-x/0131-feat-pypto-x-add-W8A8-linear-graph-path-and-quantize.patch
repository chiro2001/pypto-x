+                "graph_contract_version": program.metadata["graph_contract_version"],
+                "parameters": len(schema.parameters),
+                "quant_scales": len(schema.quant_scales),
+                "states": len(schema.states),
+                "regions": len(layout.regions),
+                "expected_regions": expected,
+                "matches": len(layout.regions) == expected,
+                "formula": (
+                    "368-150+150*2=518" if expected == 518 else
+                    "368-186+186*2=554" if expected == 554 else
+                    "518+2 (default + lm_head dual packing)" if expected == 520 else
+                    "554+2 (all-186 + lm_head dual packing) = 556 (ERR-0003)"
+                ),
+                "quantized_lm_head_storage_ids": [
