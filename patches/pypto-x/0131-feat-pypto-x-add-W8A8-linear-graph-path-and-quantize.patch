+"""Qwen3.5-0.8B W8A8 weight quantization (offline ingestion, contract §1.1/§3).
+
+This module turns one BF16/FP16/FP32 checkpoint tensor in ``[out, in]`` layout
+into the frozen W8A8 storage:
+
+* int8 codes, symmetric, per-output-channel absmax scale ``s_w[o] =
+  max(|W[o,:]|)/127``, clamp ``[-127, 127]``, RNE ties-to-even;
+* fp32 per-output-channel scales;
+* Q1 zero rows -> ``s=1.0`` / ``q=0``; Q2 NaN/Inf fail closed; Q3 saturation
+  counts are reported; scale underflow on a non-zero row fails closed.
+
+The numpy implementation below is a vectorized transcription of the C1 golden
+(:mod:`pypto.portable.qwen35_w8a8_scheme`); a focused differential test pins it
+bit-for-bit against the scalar golden, including the zero/NaN/saturation/
+underflow edges.  It never writes weight bytes to the repository or evidence:
+callers keep the int8/scale payloads in memory and report only digests.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.portable.qwen35_w8a8_scheme import (
+    MAX_ACCUMULATOR_K,
+    QUANT_MAX,
+    QUANT_MIN,
+    W8A8SchemeError,
+)
+
+
+class W8A8WeightQuantizationError(ValueError):
+    """Weight quantization violated the frozen scheme."""
+
+
+@dataclass(frozen=True)
+class QuantizedWeight:
+    """One quantized weight payload plus its artifact-safe manifest fields."""
+
+    name: str
+    source_dtype: str
+    shape: Tuple[int, int]
+    codes: bytes
+    scales: bytes
+    max_abs: float
+    scale_min: float
+    scale_max: float
+    saturation_count: int
+    zero_row_count: int
+    codes_sha256: str
+    scales_sha256: str
+    source_sha256: str
+
+    def manifest_entry(self) -> Mapping[str, Any]:
+        """Per-tensor §5.1 manifest entry without any weight bytes."""
+
+        return {
+            "name": self.name,
+            "source_dtype": self.source_dtype,
+            "shape": list(self.shape),
+            "max_abs": self.max_abs,
+            "scale_min": self.scale_min,
+            "scale_max": self.scale_max,
+            "saturation_count": self.saturation_count,
+            "zero_row_count": self.zero_row_count,
+            "codes_sha256": self.codes_sha256,
+            "scales_sha256": self.scales_sha256,
+            "source_sha256": self.source_sha256,
+            "codes_dtype": "int8",
+            "scales_dtype": "float32",
+            "granularity": "per_output_channel",
+            "rounding": "rne_to_even",
+            "clamp": [QUANT_MIN, QUANT_MAX],
+        }
+
+    @property
+    def codes_elements(self) -> int:
+        return int(self.shape[0]) * int(self.shape[1])
+
+    @property
+    def scales_elements(self) -> int:
+        return int(self.shape[0])
+
+
+def _require_numpy() -> Any:
+    try:
+        import numpy as np  # noqa: WPS433
+    except Exception as exc:  # pragma: no cover - numpy is present in this repo env
+        raise W8A8WeightQuantizationError(
+            "W8A8 weight quantization requires numpy for the offline ingestion step"
+        ) from exc
+    return np
+
+
+def _decode_values(source_bytes: bytes, dtype: str, shape: Tuple[int, int]) -> Any:
+    np = _require_numpy()
+    rows, columns = shape
+    if rows <= 0 or columns <= 0:
+        raise W8A8WeightQuantizationError("weight shape must be non-empty")
+    if columns > MAX_ACCUMULATOR_K:
+        raise W8A8WeightQuantizationError(
+            "K={} exceeds the INT32 accumulation limit {} (Q5)".format(columns, MAX_ACCUMULATOR_K)
+        )
+    if dtype in ("bfloat16", "bf16"):
+        raw = np.frombuffer(source_bytes, dtype=np.uint16)
+        if raw.size != rows * columns:
+            raise W8A8WeightQuantizationError("BF16 source byte count does not match the shape")
+        values = (raw.astype(np.uint32) << 16).view(np.float32)
+    elif dtype in ("float32", "f32"):
+        values = np.frombuffer(source_bytes, dtype="<f4")
+        if values.size != rows * columns:
+            raise W8A8WeightQuantizationError("FP32 source byte count does not match the shape")
+    elif dtype in ("float16", "f16"):
+        values = np.frombuffer(source_bytes, dtype="<f2").astype(np.float32)
+        if values.size != rows * columns:
+            raise W8A8WeightQuantizationError("FP16 source byte count does not match the shape")
+    else:
+        raise W8A8WeightQuantizationError("unsupported weight source dtype {!r}".format(dtype))
+    return values.reshape(rows, columns).astype(np.float32, copy=False)
+
+
+def quantize_weight_per_output_channel(
+    source_bytes: bytes,
+    *,
+    dtype: str,
+    shape: Sequence[int],
+    name: str = "<weight>",
+) -> QuantizedWeight:
+    """Quantize one ``[out, in]`` weight with the frozen per-channel scheme."""
+
+    if not isinstance(source_bytes, (bytes, bytearray, memoryview)):
+        raise W8A8WeightQuantizationError("source_bytes must be a bytes-like object")
+    payload = bytes(source_bytes)
+    if len(shape) != 2:
+        raise W8A8WeightQuantizationError("weight shape must be rank 2 [out, in]")
+    rows, columns = int(shape[0]), int(shape[1])
+    np = _require_numpy()
+    values = _decode_values(payload, str(dtype).lower(), (rows, columns))
+    if not bool(np.isfinite(values).all()):
+        # Q2: NaN/Inf fail closed instead of being silently clamped.
+        raise W8A8WeightQuantizationError(
+            "{} contains NaN/Inf; quantize_per_token_s8 fails closed (Q2)".format(name)
+        )
+    absmax = np.max(np.abs(values), axis=1, keepdims=True)
+    zero_rows = absmax[:, 0] == np.float32(0.0)
+    # C1 golden computes ``float32_round(absmax / 127.0)`` in binary64 and then
+    # rounds once to binary32; reproduce that exact order here.
+    scales = (absmax.astype(np.float64) / float(QUANT_MAX)).astype(np.float32)
+    nonzero_rows = ~zero_rows
+    if bool(np.any((scales[:, 0] == np.float32(0.0)) & nonzero_rows)):
+        raise W8A8WeightQuantizationError(
+            "{} has a non-zero row whose float32 scale underflows to 0".format(name)
+        )
+    scales[zero_rows] = np.float32(1.0)
+    ratios = values.astype(np.float64) / scales.astype(np.float64)
+    rounded = np.rint(ratios)
+    saturation = int(np.count_nonzero((rounded < QUANT_MIN) | (rounded > QUANT_MAX)))
+    codes = np.clip(rounded, QUANT_MIN, QUANT_MAX).astype(np.int8)
+    codes[zero_rows] = np.int8(0)
+    scale_flat = scales.reshape(-1)
+    return QuantizedWeight(
+        name=name,
+        source_dtype=str(dtype).lower(),
+        shape=(rows, columns),
+        codes=codes.tobytes(),
+        scales=scale_flat.astype("<f4").tobytes(),
+        max_abs=float(absmax.max()) if rows else 0.0,
+        scale_min=float(scale_flat.min()) if rows else 0.0,
+        scale_max=float(scale_flat.max()) if rows else 0.0,
+        saturation_count=saturation,
+        zero_row_count=int(np.count_nonzero(zero_rows)),
+        codes_sha256=hashlib.sha256(codes.tobytes()).hexdigest(),
+        scales_sha256=hashlib.sha256(scale_flat.astype("<f4").tobytes()).hexdigest(),
+        source_sha256=hashlib.sha256(payload).hexdigest(),
+    )
+
+
+def quantize_weight_from_view(
+    view: Any,
+    *,
+    dtype: str,
+    shape: Sequence[int],
+    name: str = "<weight>",
+) -> QuantizedWeight:
+    """Quantize a safetensors ``memoryview`` without materializing a copy first."""
+
+    if not hasattr(view, "tobytes"):
+        raise W8A8WeightQuantizationError("weight view must expose tobytes()")
+    return quantize_weight_per_output_channel(
+        bytes(view.tobytes()), dtype=dtype, shape=tuple(int(d) for d in shape), name=name
+    )
+
+
+__all__ = [
+    "QuantizedWeight",
+    "W8A8WeightQuantizationError",
+    "quantize_weight_from_view",
+    "quantize_weight_per_output_channel",
+]
