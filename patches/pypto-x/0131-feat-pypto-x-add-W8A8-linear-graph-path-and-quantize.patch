+"""W8A8-linear graph path (contract 0002 C7): graph, lowering and CPU execution.
+
+Scope of this module:
+
+* the portable builder emits the frozen graph contract v4 with int8 weights +
+  fp32 per-output-channel scales and the four §3.3 opcodes;
+* binding schema v2 / packed layout v2 produce the 518 default regions, the
+  554 all-linear regions and the 556 §3.4 lm_head dual-packing regions;
+* the coverage fields are real graph counts and match the analytic
+  frozen-topology formula;
+* a four-opcode program is bit-exact against the C1 goldens on the scalar,
+  vector-common, AVX2 and AVX-512 reference/native paths (including a
+  non-multiple-of-lane tail);
+* weight quantization is bit-exact against the C1 per-token golden;
+* unsupported combinations fail closed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import random
+import struct
+import tempfile
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.vector import CpuVectorRuntime
+from pypto.backends.cpu.x86 import Avx2Runtime, Avx512Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import W8A8_QUANTIZE_OPCODE, W8A8_QMATMUL_OPCODE
+from pypto.lowering.cpu.x86.avx512 import Avx512UnsupportedError
+from pypto.portable.qwen35 import (
+    QWEN35_LM_HEAD_QUANTIZED_FUNCTION_PARAMETER,
+    build_qwen35_text_decoder_graph,
+)
+from pypto.portable.qwen35_w8a8_scheme import (
+    dequantize_epilogue_bf16,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+from pypto.portable.qwen35_w8a8_weight import quantize_weight_per_output_channel
+from pypto.portable.runtime_binding import build_binding_schema, build_packed_layout
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+AVX2_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu",
+    features=("avx", "avx2", "fma", "osxsave", "ymm"), attributes={"lane_count": 8},
+)
+AVX512_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu",
+    features=("avx512f", "avx512vnni"), attributes={"lane_count": 16},
+)
+VECTOR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu", attributes={"lane_count": 4})
+
+
+# --------------------------------------------------------------------------
+# graph / schema / layout
+# --------------------------------------------------------------------------
+
+
+def test_w8a8_default_graph_contract_and_518_regions():
+    program = build_qwen35_text_decoder_graph(
+        1, 1, past_length=0, shape_profile="synthetic_test", precision="w8a8-linear"
+    )
+    assert program.metadata["graph_contract_version"] == 4
+    assert program.metadata["precision"] == "w8a8-linear"
+    assert program.metadata["weight_dtype"] == "int8"
+    quantized = tuple(program.metadata["quantized_parameter_names"])
+    assert len(quantized) == 150
+    assert not any(name.endswith("in_proj_b_weight") or name.endswith("in_proj_a_weight") for name in quantized)
+    counts = {}
+    for operation in program.functions[0].body.operations:
+        counts[operation.name] = counts.get(operation.name, 0) + 1
+    assert counts["quantize_per_token_s8"] == 150
+    assert counts["qmatmul_s8s8_s32"] == 150
+    assert counts["dequantize_epilogue_bf16"] == 150
+    schema = build_binding_schema(program)
+    layout = build_packed_layout(schema)
+    assert len(schema.parameters) == 320
+    assert len(schema.quant_scales) == 150
+    assert len(schema.states) == 48
+    assert len(layout.regions) == 518
+    # Coverage fields are computed from the emitted graph and match the
+    # analytic frozen-topology formula (fail-closed drift check in the builder).
+    real = program.metadata["w8a8_coverage_manifest"]
+    analytic = program.metadata["w8a8_coverage_analytic"]
+    assert real["measurement"] == "graph_operation_count_real_matmul_and_conv1d"
+    assert analytic["measurement"] == "frozen_topology_formula"
+    assert real["w8a8_linear_coverage"] == pytest.approx(analytic["w8a8_linear_coverage"])
+    assert real["whole_net_int8_compute_ratio"] == pytest.approx(analytic["whole_net_int8_compute_ratio"])
+    assert real["mac_breakdown"]["causal_conv_product_operations"] == 72
+    assert real["int8_macs_from_graph"] > 0
+    assert real["conv1d_macs_from_graph"] > 0
+
+
+def test_w8a8_all_linear_scope_has_554_regions():
+    program = build_qwen35_text_decoder_graph(
+        1, 1, past_length=0, shape_profile="synthetic_test", precision="w8a8-linear",
+        quantized_linear_scope="all",
+    )
+    schema = build_binding_schema(program)
+    layout = build_packed_layout(schema)
+    assert len(schema.quant_scales) == 186
+    assert len(layout.regions) == 554
+    assert program.metadata["w8a8_coverage_manifest"]["w8a8_linear_coverage"] == pytest.approx(1.0)
+
+
+def test_w8a8_lm_head_dual_packing_region_counts_and_storage_ids():
+    program = build_qwen35_text_decoder_graph(
+        1, 1, past_length=0, shape_profile="synthetic_test", precision="w8a8-linear",
+        quantized_linear_scope="all", quantize_lm_head=True,
+    )
+    schema = build_binding_schema(program)
+    layout = build_packed_layout(schema)
+    assert len(schema.parameters) == 321  # 320 + the extra dual-packing weight
+    assert len(schema.quant_scales) == 187
+    assert len(layout.regions) == 556
+    weight = schema.entry_for(QWEN35_LM_HEAD_QUANTIZED_FUNCTION_PARAMETER)
+    scale = schema.entry_for(QWEN35_LM_HEAD_QUANTIZED_FUNCTION_PARAMETER + "_scale")
+    assert weight.dtype == "int8"
+    assert weight.storage_id == "parameter:embedding_lm_head_shared_weight.lm_head.int8"
+    assert scale.storage_id == "parameter:embedding_lm_head_shared_weight.lm_head.scale"
+    # The embedding region itself stays BF16 and keeps its tied storage id.
+    embedding = schema.entry_for("embedding_lm_head_shared_weight")
+    assert embedding.dtype == "bf16"
+    assert embedding.storage_id == "embedding_lm_head_shared_weight"
+    assert any(region.storage_id == "embedding_lm_head_shared_weight" for region in layout.regions)
+    # Coverage keeps lm_head out of the 186-linear numerator but reports its
+    # elements separately.
+    coverage = program.metadata["w8a8_coverage_manifest"]
+    assert coverage["quantized_lm_head_parameter_elements"] > 0
+    assert coverage["w8a8_linear_coverage"] == pytest.approx(1.0)
+
