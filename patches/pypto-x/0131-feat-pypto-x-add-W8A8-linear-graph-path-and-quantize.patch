+# --------------------------------------------------------------------------
+# Real graph counting (contract §2.4: "真实量化计数", not the default estimate)
+# --------------------------------------------------------------------------
+
+
+def _concrete_shape(ref: Any, context: str) -> Tuple[int, ...]:
+    value = getattr(ref, "type", None)
+    raw = getattr(value, "shape", None)
+    if raw is None:
+        raise W8A8CoverageError("{} has no static shape".format(context))
+    try:
+        shape = tuple(int(dimension) for dimension in raw)
+    except (TypeError, ValueError) as exc:
+        raise W8A8CoverageError("{} has a symbolic or invalid shape {!r}".format(context, raw)) from exc
+    for dimension in shape:
+        if dimension < 0:
+            raise W8A8CoverageError("{} has a negative shape dimension".format(context))
+    return shape
+
+
+def _operation_macs(operation: Any) -> int:
+    """MAC count of one rank-2..4 equal-prefix matmul/qmatmul operation.
+
+    ``element_count(output) * K`` is the exact batch*M*N*K count; the builder
+    only emits concrete integer shapes.
+    """
+
+    inputs = tuple(getattr(operation, "inputs", ()))
+    outputs = tuple(getattr(operation, "outputs", ()))
+    if len(inputs) != 2 or len(outputs) != 1:
+        raise W8A8CoverageError("matmul-like operation has an unexpected arity")
+    left = _concrete_shape(inputs[0], "matmul left")
+    right = _concrete_shape(inputs[1], "matmul right")
+    output = _concrete_shape(outputs[0], "matmul output")
+    if len(left) < 2 or len(right) < 2:
+        raise W8A8CoverageError("matmul-like operands must be rank >= 2")
+    if left[-1] != right[-2]:
+        raise W8A8CoverageError("matmul-like reduction dimensions do not match")
+    elements = 1
+    for dimension in output:
+        elements *= dimension
+    return elements * left[-1]
+
+
+def _compact_quantized_names(
+    compact_manifest: Sequence[Mapping[str, Any]],
+) -> Tuple[str, ...]:
+    """Expand a compact manifest and return the exact int8 linear weight names.
+
+    The opt-in tied lm_head dual-packing entry is not one of the 186 linear
+    weights and is reported separately by the graph coverage manifest.
+    """
+
+    from pypto.portable.qwen35 import (
+        QWEN35_08B_SHAPE_METADATA,
+        QWEN35_LM_HEAD_QUANTIZED_FUNCTION_PARAMETER,
+        expand_decoder_parameter_manifest,
+    )
+
+    expanded = expand_decoder_parameter_manifest(
+        compact_manifest,
+        QWEN35_08B_SHAPE_METADATA["full_attention_indices_zero_based"],
+        QWEN35_08B_SHAPE_METADATA["num_hidden_layers"],
+    )
+    return tuple(
+        entry["name"]
+        for entry in expanded
+        if entry["dtype"] == "int8"
+        and entry["name"] != QWEN35_LM_HEAD_QUANTIZED_FUNCTION_PARAMETER
+    )
+
+
+@dataclass(frozen=True)
+class W8A8GraphCoverageManifest:
+    """Coverage fields derived from the actually-emitted Core operations.
+
+    ``whole_net_int8_compute_ratio`` uses the real ``qmatmul_s8s8_s32`` and
+    ``matmul`` MAC counts from the built graph.  Conv1D is built from
+    elementwise multiply/add operations, so its MAC contribution is the only
+    shape-model complement and is labelled as such; the GDR recurrence is
+    emitted as three real ``matmul`` operations and is therefore counted from
+    the graph.  ``static_shape_model_ratio`` keeps the old §2.4 estimate
+    visible for the honest static-vs-real comparison.
+    """
+
+    w8a8_linear_coverage: float
+    whole_net_int8_compute_ratio: float
+    measurement: str
+    quantized_linear_tensor_count: int
+    total_linear_tensor_count: int
+    quantized_linear_parameter_elements: int
+    total_linear_parameter_elements: int
+    int8_macs_from_graph: int
+    float_matmul_macs_from_graph: int
+    conv1d_macs_from_graph: int
+    total_macs_from_graph: int
+    static_shape_model_ratio: Optional[float]
+    static_shape_model_int8_macs: Optional[int]
+    static_shape_model_total_macs: Optional[int]
+    mac_breakdown: Mapping[str, Any]
+    static_shape_model_breakdown: Mapping[str, Any]
+    quantized_parameter_names: Tuple[str, ...]
+    bf16_island_names: Tuple[str, ...]
+    quantized_lm_head_parameter_elements: int
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            QUANTIZED_LINEAR_COVERAGE_FIELD: self.w8a8_linear_coverage,
+            WHOLE_NET_INT8_COMPUTE_RATIO_FIELD: self.whole_net_int8_compute_ratio,
+            "measurement": self.measurement,
+            "quantized_linear_tensor_count": self.quantized_linear_tensor_count,
+            "total_linear_tensor_count": self.total_linear_tensor_count,
+            "quantized_linear_parameter_elements": self.quantized_linear_parameter_elements,
+            "total_linear_parameter_elements": self.total_linear_parameter_elements,
+            "int8_macs_from_graph": self.int8_macs_from_graph,
+            "float_matmul_macs_from_graph": self.float_matmul_macs_from_graph,
+            "conv1d_macs_from_graph": self.conv1d_macs_from_graph,
+            "total_macs_from_graph": self.total_macs_from_graph,
+            "static_shape_model_ratio": self.static_shape_model_ratio,
+            "static_shape_model_int8_macs": self.static_shape_model_int8_macs,
+            "static_shape_model_total_macs": self.static_shape_model_total_macs,
+            "mac_breakdown": dict(self.mac_breakdown),
+            "static_shape_model_breakdown": dict(self.static_shape_model_breakdown),
+            "quantized_parameter_names": list(self.quantized_parameter_names),
+            "bf16_island_names": list(self.bf16_island_names),
+            "quantized_lm_head_parameter_elements": self.quantized_lm_head_parameter_elements,
+        }
+
+    def assert_nonzero(self) -> None:
+        if not 0.0 < self.w8a8_linear_coverage <= 1.0:
+            raise W8A8CoverageError(
+                "{} must be in (0, 1]; got {!r}".format(
+                    QUANTIZED_LINEAR_COVERAGE_FIELD, self.w8a8_linear_coverage
+                )
+            )
+        if not 0.0 < self.whole_net_int8_compute_ratio <= 1.0:
+            raise W8A8CoverageError(
+                "{} must be in (0, 1]; got {!r}".format(
+                    WHOLE_NET_INT8_COMPUTE_RATIO_FIELD, self.whole_net_int8_compute_ratio
+                )
+            )
+
