+def test_model_profile_coverage_is_real_and_differs_from_legacy_static_model():
+    """R9 / ERR-0003 context: real graph counting vs the legacy static model.
+
+    The legacy §2.4 static model (kept under ``static_shape_model_ratio``)
+    excluded the BF16 lm_head matmul and used an obsolete GDR recurrence
+    formula; the graph count shows the honest whole-net ratio.
+    """
+
+    program = build_qwen35_text_decoder_graph(
+        1, 1, past_length=0, precision="w8a8-linear"
+    )
+    coverage = program.metadata["w8a8_coverage_manifest"]
+    analytic = program.metadata["w8a8_coverage_analytic"]
+    assert coverage["w8a8_linear_coverage"] == pytest.approx(0.9988146977479258)
+    assert coverage["whole_net_int8_compute_ratio"] == pytest.approx(0.6484198826534429)
+    assert coverage["static_shape_model_ratio"] == pytest.approx(0.9770048309178744)
+    assert coverage["whole_net_int8_compute_ratio"] < coverage["static_shape_model_ratio"]
+    # The difference is auditable: the real denominator includes the BF16
+    # lm_head matmul and the three real GDR recurrence matmuls.
+    assert coverage["mac_breakdown"]["float_matmul_operations"] == 103
+    assert coverage["conv1d_macs_from_graph"] == 442368
+    assert analytic["lm_head_macs"] == 254279680
+    assert analytic["gdr_recurrent_macs"] == 14155776
+    assert coverage["static_shape_model_breakdown"]["gdr_recurrent_macs"] == 10616832
+    assert coverage["measurement"] == "graph_operation_count_real_matmul_and_conv1d"
+
