+def test_quantize_lowering_rejects_non_float_input_program():
+    from pypto.lowering.cpu import CpuScalarValidationError
+
+    rows, k = 2, 3
+    q = ValueRef("q", CoreType.tensor("int8", (rows, k)))
+    sa = ValueRef("sa", CoreType.tensor("float32", (rows,)))
+    x_int8 = ValueRef("x", CoreType.tensor("int8", (rows, k)))
+    program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "bad_quantize",
+                (x_int8,),
+                (q, sa),
+                Region((Operation(W8A8_QUANTIZE_OPCODE, (x_int8,), (q, sa)),)),
+            ),
+        )
+    )
+    compiler = CpuScalarCompiler()
+    with pytest.raises((CpuScalarValidationError, ValueError)):
+        compiler.lower(program, SCALAR_TARGET)
+
