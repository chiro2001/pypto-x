diff --git a/python/pypto/backends/cpu/w8a8_reference.py b/python/pypto/backends/cpu/w8a8_reference.py
new file mode 100644
index 000000000..71a242f37
--- /dev/null
+++ b/python/pypto/backends/cpu/w8a8_reference.py
@@ -0,0 +1,94 @@
+"""Shared C1-golden adapter for the CPU reference executors (C7).
+
+The scalar and vector-common reference runtimes must execute the four W8A8
+opcodes with **exactly** the semantics frozen by
+:mod:`pypto.portable.qwen35_w8a8_scheme` (contract 0002 §1.4/§3.3).  Rather
+than reimplementing RNE/clamp/overflow rules a second time, this module is the
+single thin adapter from flat runtime storage to the portable golden and back:
+
+* ``quantize_per_token_s8``      flat f32/bf16 values -> int8 codes + fp32 scales
+* ``dequantize_s8``              int8 codes + fp32 scales -> fp32 values
+* ``dequantize_epilogue_bf16``   int32 accumulator + row/column scales -> bf16 values
+* ``qmatmul_s8s8_s32``           int8 x int8 -> int32 (vector-common gap only)
+
+The adapter is stdlib-only (the golden imports no numpy/torch/backend module),
+so importing it from ``pypto.backends.cpu`` cannot create an import cycle.
+Errors propagate as :class:`pypto.portable.qwen35_w8a8_scheme.W8A8SchemeError`
+(``ValueError``), which the executors wrap into their own execution errors.
+"""
+
+from __future__ import annotations
+
+import struct
+from typing import Any, List, Sequence, Tuple
+
+from pypto.portable.qwen35_w8a8_scheme import (
+    dequantize_epilogue_bf16,
+    dequantize_s8,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+
+
+class W8A8ReferenceError(ValueError):
+    """The reference adapter was given storage that violates the plan."""
+
+
+def _flat(values: Any) -> List[Any]:
+    if isinstance(values, (list, tuple)):
+        flat: List[Any] = []
+        for item in values:
+            flat.extend(_flat(item))
+        return flat
+    return [values]
+
+
+def _bf16_float(bits: int) -> float:
+    """Reconstruct the exact binary32 value of one BF16 bit pattern."""
+
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+def quantize_per_token_s8_flat(
+    values: Any, rows: int, k: int
+) -> Tuple[List[int], List[float], int]:
+    result = quantize_per_token_s8(_flat(values), shape=(int(rows), int(k)))
+    return list(result.codes), list(result.scales), int(result.saturation_count)
+
+
+def dequantize_s8_flat(codes: Any, scales: Any, rows: int, k: int) -> List[float]:
+    flat_scales = [float(scale) for scale in _flat(scales)]
+    return list(dequantize_s8(_flat(codes), flat_scales, shape=(int(rows), int(k))))
+
+
+def dequantize_epilogue_bf16_flat(
+    accumulator: Any, row_scales: Any, column_scales: Any, rows: int, columns: int
+) -> List[float]:
+    result = dequantize_epilogue_bf16(
+        _flat(accumulator),
+        [float(scale) for scale in _flat(row_scales)],
+        [float(scale) for scale in _flat(column_scales)],
+        shape=(int(rows), int(columns)),
+    )
+    return [_bf16_float(bits) for bits in result.bf16_bits]
+
+
+def qmatmul_s8s8_s32_flat(
+    left: Any, right: Any, left_shape: Sequence[int], right_shape: Sequence[int]
+) -> List[int]:
+    result = qmatmul_s8s8_s32(
+        _flat(left),
+        _flat(right),
+        left_shape=tuple(int(dimension) for dimension in left_shape),
+        right_shape=tuple(int(dimension) for dimension in right_shape),
+    )
+    return list(result.values)
+
+
+__all__ = [
+    "W8A8ReferenceError",
+    "dequantize_epilogue_bf16_flat",
+    "dequantize_s8_flat",
+    "qmatmul_s8s8_s32_flat",
+    "quantize_per_token_s8_flat",
+]
