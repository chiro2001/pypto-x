+# --------------------------------------------------------------------------
+# weight quantization vs the C1 golden
+# --------------------------------------------------------------------------
+
+
+def _to_bf16_bytes(values):
+    import numpy as np
+
+    flat = [value for row in values for value in row]
+    raw = np.asarray(flat, dtype=np.float32).view(np.uint32)
+    bits = ((raw + 0x7FFF + ((raw >> 16) & 1)) >> 16).astype(np.uint16)
+    return bits.tobytes(), bits
+
+
+def test_weight_quantization_matches_c1_per_token_golden():
+    import numpy as np
+
+    rng = random.Random(20260911)
+    for _ in range(60):
+        out = rng.randint(1, 8)
+        k = rng.randint(1, 17)
+        values = [[rng.uniform(-4.0, 4.0) for _ in range(k)] for _ in range(out)]
+        if rng.random() < 0.2:
+            values[rng.randrange(out)] = [0.0] * k
+        raw_bytes, bits = _to_bf16_bytes(values)
+        decoded = [
+            [struct.unpack("<f", struct.pack("<I", int(b) << 16))[0] for b in bits[row * k:(row + 1) * k]]
+            for row in range(out)
+        ]
+        golden = quantize_per_token_s8(decoded)
+        quantized = quantize_weight_per_output_channel(
+            raw_bytes, dtype="bf16", shape=(out, k), name="w"
+        )
+        assert list(struct.unpack("<{}b".format(out * k), quantized.codes)) == list(golden.codes)
+        assert list(struct.unpack("<{}f".format(out), quantized.scales)) == list(golden.scales)
+        assert quantized.saturation_count == golden.saturation_count
+    # Q1 zero row, Q2 NaN/Inf, scale underflow.
+    zero = quantize_weight_per_output_channel(
+        np.zeros((2, 3), dtype=np.float32).tobytes(), dtype="float32", shape=(2, 3)
+    )
+    assert list(struct.unpack("<2f", zero.scales)) == [1.0, 1.0]
+    assert list(zero.codes) == [0] * 6
+    for bad in (float("nan"), float("inf")):
+        with pytest.raises(ValueError):
+            quantize_weight_per_output_channel(
+                np.array([[bad]], dtype=np.float32).tobytes(), dtype="float32", shape=(1, 1)
+            )
+    tiny = np.zeros((1, 1), dtype=np.float32)
+    tiny[0, 0] = np.nextafter(np.float32(0), np.float32(1))
+    with pytest.raises(ValueError):
+        quantize_weight_per_output_channel(tiny.tobytes(), dtype="float32", shape=(1, 1))
+
+
+# --------------------------------------------------------------------------
+# four-opcode execution differential (C1 golden oracle)
+# --------------------------------------------------------------------------
+
+
+def _four_op_program(rows=5, k=7, columns=3):
+    x = ValueRef("x", CoreType.tensor("float32", (rows, k)))
+    w = ValueRef("w", CoreType.tensor("int8", (columns, k)))
+    ws = ValueRef("ws", CoreType.tensor("float32", (columns,)))
+    q = ValueRef("q", CoreType.tensor("int8", (rows, k)))
+    sa = ValueRef("sa", CoreType.tensor("float32", (rows,)))
+    wt = ValueRef("wt", CoreType.tensor("int8", (k, columns)))
+    acc = ValueRef("acc", CoreType.tensor("int32", (rows, columns)))
+    out = ValueRef("out", CoreType.tensor("bf16", (rows, columns)))
+    operations = (
+        Operation("quantize_per_token_s8", (x,), (q, sa)),
+        Operation("transpose", (w,), (wt,), {"permutation": [1, 0]}),
+        Operation("qmatmul_s8s8_s32", (q, wt), (acc,)),
+        Operation("dequantize_epilogue_bf16", (acc, sa, ws), (out,)),
+    )
+    return CoreProgram(
+        functions=(CoreFunction("w8a8_four_op", (x, w, ws), (out,), Region(operations)),)
+    )
+
+
+def _four_op_inputs(seed=11):
+    rng = random.Random(seed)
+    rows, k, columns = 5, 7, 3
+    x_values = [[rng.uniform(-3.0, 3.0) for _ in range(k)] for _ in range(rows)]
+    w_values = [[rng.randint(-127, 127) for _ in range(k)] for _ in range(columns)]
+    ws_values = [rng.uniform(0.001, 0.01) for _ in range(columns)]
+    quantized = quantize_per_token_s8(x_values)
+    accumulator = qmatmul_s8s8_s32(
+        list(quantized.code_rows()),
+        [[w_values[o][inner] for o in range(columns)] for inner in range(k)],
+        left_shape=(rows, k),
+        right_shape=(k, columns),
+    )
+    epilogue = dequantize_epilogue_bf16(
+        list(accumulator.values), list(quantized.scales), ws_values, shape=(rows, columns)
+    )
+    golden = [
+        struct.unpack("<f", struct.pack("<I", epilogue.bf16_bits[row * columns + column] << 16))[0]
+        for row in range(rows)
+        for column in range(columns)
+    ]
+    inputs = [
+        HostTensor("float32", (rows, k), x_values).descriptor(readonly=True),
+        HostTensor("int8", (columns, k), w_values).descriptor(readonly=True),
+        HostTensor("float32", (columns,), ws_values).descriptor(readonly=True),
+    ]
+    return inputs, golden
+
+
+def _compile_and_run_scalar():
+    compiler = CpuScalarCompiler()
+    artifact = compiler.compile(compiler.lower(_four_op_program(), SCALAR_TARGET))
+    inputs, golden = _four_op_inputs()
+    output = HostTensor.zeros("bf16", (5, 3))
+    CpuScalarRuntime().launch(LaunchRequest(artifact, inputs=inputs, outputs=[output.descriptor()]))
+    return output, golden
+
+
