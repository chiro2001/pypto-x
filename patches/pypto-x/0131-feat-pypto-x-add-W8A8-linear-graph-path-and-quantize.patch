+    inputs, golden = _four_op_inputs(seed=29)
+    output = HostTensor.zeros("bf16", (5, 3))
+    runtime.launch(LaunchRequest(artifact, inputs=inputs, outputs=[output.descriptor()]))
+    return output, golden
