+def w8a8_real_parameters(
+    schema: Any,
+    layout: Any,
+    mapping: Any,
+    reader: SafetensorsReader,
+) -> Tuple[Dict[str, BufferBinding], Mapping[str, Any]]:
+    """Real-weight W8A8 ingestion: quantize covered weights, keep islands zero-copy.
+
+    Every quantized weight is read from the official checkpoint tensor and
+    quantized in memory with the C1-pinned scheme; the embedding and the other
+    BF16 islands stay zero-copy mmap views (F32 sources use the existing RNE
+    conversion).  No weight bytes are written to disk or evidence.
+    """
+
+    by_name = {item.parameter: item for item in mapping.mappings}
+    bindings: Dict[str, BufferBinding] = {}
+    scale_payloads: Dict[str, bytes] = {}
+    quant_manifest: List[Mapping[str, Any]] = []
+    zero_copy = 0
+    converted = 0
+    quantized = 0
+    codes_bytes = 0
+    scale_bytes = 0
+    saturation_total = 0
+    for entry in schema.parameters:
+        region = layout.region_for(entry.name)
+        if entry.quant is not None:
+            item = by_name.get(entry.name)
+            if item is None:
+                raise DriverError("quantized parameter {!r} has no checkpoint mapping".format(entry.name))
+            if tuple(item.source.shape) != tuple(entry.shape):
+                raise DriverError(
+                    "quantized parameter {!r} source shape {} does not match contract {}".format(
+                        entry.name, tuple(item.source.shape), tuple(entry.shape)
+                    )
+                )
+            view = reader.view(item.source.official_name)
+            try:
+                quantized_weight = quantize_weight_from_view(
+                    view,
+                    dtype=item.source.pypto_dtype,
+                    shape=entry.shape,
+                    name=entry.name,
+                )
+            finally:
+                view.release()
+            bindings[entry.name] = BufferBinding.from_buffer(
+                quantized_weight.codes, region.storage_id, entry.dtype, entry.shape, readonly=True
+            )
+            scale_name = str(entry.quant["scale_entry"])
+            scale_payloads[scale_name] = quantized_weight.scales
+            quant_manifest.append(quantized_weight.manifest_entry())
+            quantized += 1
+            codes_bytes += len(quantized_weight.codes)
+            scale_bytes += len(quantized_weight.scales)
+            saturation_total += quantized_weight.saturation_count
+        else:
+            item = by_name.get(entry.name)
+            if item is None:
+                raise DriverError("parameter {!r} has no checkpoint mapping".format(entry.name))
+            source_dtype = item.source.pypto_dtype
+            if source_dtype == entry.dtype:
+                # Keep the mmap view alive for the launch lifetime; do not
+                # release it here (real_parameters has the same contract).
+                view = reader.view(item.source.official_name)
+                bindings[entry.name] = BufferBinding.from_buffer(
+                    view, region.storage_id, entry.dtype, entry.shape, readonly=True
+                )
+                zero_copy += 1
+            else:
+                view = reader.view(item.source.official_name)
+                try:
+                    if source_dtype != "float32" or entry.dtype != "bf16":
+                        raise DriverError(
+                            "unsupported island conversion {} -> {} for {!r}".format(
+                                source_dtype, entry.dtype, entry.name
+                            )
+                        )
+                    payload = bytes(convert_f32_view_to_bf16_rne(view))
+                finally:
+                    view.release()
+                bindings[entry.name] = BufferBinding.from_buffer(
+                    payload, region.storage_id, entry.dtype, entry.shape, readonly=True
+                )
+                converted += 1
+    for entry in schema.quant_scales:
+        payload = scale_payloads.get(entry.name)
+        if payload is None:
+            raise DriverError("quant_scale {!r} has no quantized source".format(entry.name))
+        region = layout.region_for(entry.name)
+        bindings[entry.name] = BufferBinding.from_buffer(
+            payload, region.storage_id, entry.dtype, entry.shape, readonly=True
+        )
+    manifest_bytes = json.dumps(
+        sorted(quant_manifest, key=lambda item: str(item["name"])),
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return bindings, {
+        "binding_mode": "w8a8_quantized_in_memory_plus_zero_copy_islands",
+        "zero_copy_parameters": zero_copy,
+        "converted_parameters": converted,
+        "quantized_parameters": quantized,
+        "quant_scale_parameters": len(scale_payloads),
+        "int8_payload_bytes": codes_bytes,
+        "scale_payload_bytes": scale_bytes,
+        "quantization_saturation_total": saturation_total,
+        "weight_scale_manifest_digest": hashlib.sha256(manifest_bytes).hexdigest(),
+        "weight_scale_manifest": sorted(quant_manifest, key=lambda item: str(item["name"])),
+        "weight_bytes_written_to_disk": False,
+    }
+
