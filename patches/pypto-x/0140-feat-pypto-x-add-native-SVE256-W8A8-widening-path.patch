+/* ------------------------------------------------------------------ *
+ * Native W8A8 widening kernels (runner protocol v6, contract 0002 C5/R6).
+ *
+ * qmatmul: int8 lanes are sign-widened in two ``sunpklo`` steps
+ * (s8 -> s16 -> s32) and accumulated with integer mul/add (``mla``).  This
+ * is the SVE analogue of the AVX2 vpmovsxbw/vpmaddwd path.  SDOT (SVE2) and
+ * SMMLA/I8MM are deliberately *not* emitted; the real probe records whether
+ * the machine exposes them so the evidence can distinguish "unavailable"
+ * from "available but unused".
+ *
+ * The frozen scheme admits only codes in [-127, 127]; INT8_MIN is rejected
+ * before any arithmetic rather than silently wrapped.  K is bounded by Q5
+ * so the int32 accumulator cannot overflow.
+ * ------------------------------------------------------------------ */
+
+static int ptx_w8a8_has_reserved(const int8_t *values, uint64_t count) {
+    uint64_t index;
+    for (index = 0; index < count; ++index)
+        if (values[index] == INT8_MIN) return 1;
+    return 0;
+}
+
+__attribute__((noinline, used, visibility("default"))) void ptx_sve256_qmatmul_s8s8_s32(const int8_t *left, const int8_t *right,
+                                      int32_t *output, uint64_t m, uint64_t k, uint64_t n) {
+    uint64_t row;
+    for (row = 0; row < m; ++row) {
+        const int8_t *left_row = left + row * k;
+        int32_t *output_row = output + row * n;
+        uint64_t column = 0;
+        while (column < n) {
+            uint64_t inner;
+            svbool_t store_pg = svwhilelt_b32(column, n);
+            svbool_t load_pg = svwhilelt_b8((uint64_t)0, n - column);
+            svint32_t accumulator = svdup_n_s32(0);
+            for (inner = 0; inner < k; ++inner) {
+                svint8_t a8 = svdup_n_s8(left_row[inner]);
+                svint8_t b8 = svld1_s8(load_pg, right + inner * n + column);
+                svint16_t a16 = svunpklo_s16(a8);
+                svint16_t b16 = svunpklo_s16(b8);
+                svint32_t a32 = svunpklo_s32(a16);
+                svint32_t b32 = svunpklo_s32(b16);
+                accumulator = svmla_m(store_pg, accumulator, a32, b32);
+            }
+            svst1_s32(store_pg, output_row + column, accumulator);
+            column += svcntw();
+        }
+    }
