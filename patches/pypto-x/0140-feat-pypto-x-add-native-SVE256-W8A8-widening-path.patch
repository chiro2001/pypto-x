+def test_sve_write_storage_integer_raw_address_preexisting_fix(build_root):
+    """Pin the connected fix for the pre-existing raw-address TypeError.
+
+    Before the fix, ``_write_storage`` forced every non-BF16 value through
+    ``float(value)``, so a raw int32/int64 output address raised
+    ``TypeError: 'float' object cannot be interpreted as an integer``.  C5's
+    int32 qmatmul output exposed the defect; the fix is general, not
+    W8A8-specific.
+    """
+
+    _require_sve_execution()
+    runtime = _runtime()
+
+    # int64 raw output via a native iota program (non-W8A8, proves generality).
+    index = ValueRef("index", CoreType.tensor("int64", (5,)))
+    iota = _program("iota", (), (index,), {"axis": 0, "start": 2, "step": 3})
+    _, iota_artifact = _compile(iota, build_root, "iota_i64")
+    buffer64 = (ctypes.c_int64 * 5)(0, 0, 0, 0, 0)
+    runtime.launch(
+        LaunchRequest(
+            iota_artifact,
+            inputs=[],
+            outputs=[TensorDesc("int64", (5,), address=ctypes.addressof(buffer64))],
+        )
+    )
+    assert [buffer64[index] for index in range(5)] == [2, 5, 8, 11, 14]
+
+    # int8 + float32 raw outputs via the W8A8 quantizer.
+    program = _quantize_program((2, 4))
+    _, artifact = _compile(program, build_root, "quant_raw")
+    values = HostTensor("float32", (2, 4), [1.0, -2.0, 3.0, -4.0, 0.0, 0.0, 0.0, 0.0])
+    codes = (ctypes.c_int8 * 8)()
+    scales = (ctypes.c_float * 2)()
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[values.descriptor(readonly=True)],
+            outputs=[
+                TensorDesc("int8", (2, 4), address=ctypes.addressof(codes)),
+                TensorDesc("float32", (2,), address=ctypes.addressof(scales)),
+            ],
+        )
+    )
+    assert list(codes) == [32, -64, 95, -127, 0, 0, 0, 0]
+    assert list(scales) == [0.031496062874794006, 1.0]
+
+    # NumPy integer arrays are raw handles too.
+    np = pytest.importorskip("numpy")
+    qprogram, qshape = _qmatmul_program((1, 2), (2, 2))
+    _, qartifact = _compile(qprogram, build_root, "qm_numpy")
+    output = np.zeros(qshape, dtype="<i4")
+    runtime.launch(
+        LaunchRequest(
+            qartifact,
+            inputs=[
+                HostTensor("int8", (1, 2), [1, 2]).descriptor(readonly=True),
+                HostTensor("int8", (2, 2), [1, 2, 3, 4]).descriptor(readonly=True),
+            ],
+            outputs=[TensorDesc("int32", qshape, handle=output)],
+        )
+    )
+    assert output.tolist() == [[7, 10]]
+
