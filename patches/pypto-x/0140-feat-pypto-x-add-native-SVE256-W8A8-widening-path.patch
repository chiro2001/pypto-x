+__attribute__((noinline, used, visibility("default"))) int ptx_sve256_dequantize_s8_f32(const int8_t *codes, const float *scales,
+                                       float *output, uint64_t rows, uint64_t k) {
+    uint64_t row;
+    for (row = 0; row < rows; ++row) {
+        float scale = scales[row];
+        const int8_t *code_row = codes + row * k;
+        float *output_row = output + row * k;
+        uint64_t column = 0;
+        while (column < k) {
+            svbool_t load_pg = svwhilelt_b8((uint64_t)0, k - column);
+            svbool_t store_pg = svwhilelt_b32(column, k);
+            svint8_t b8 = svld1_s8(load_pg, code_row + column);
+            svint16_t b16 = svunpklo_s16(b8);
+            svint32_t b32 = svunpklo_s32(b16);
+            svfloat32_t values = svcvt_f32_s32_x(store_pg, b32);
+            svfloat32_t scaled = svmul_f32_x(store_pg, values, svdup_n_f32(scale));
+            svst1_f32(store_pg, output_row + column, scaled);
+            column += svcntw();
