+def test_sve256_w8a8_disassembly_emits_widening_not_dot_or_i8mm(build_root):
+    _require_sve_execution()
+    objdump = shutil.which("aarch64-linux-gnu-objdump") or shutil.which("objdump")
+    if objdump is None:
+        pytest.skip("AArch64 objdump is unavailable")
+    program, _ = _qmatmul_program((2, 3), (3, 4))
+    _, artifact = _compile(program, build_root, "qm_objdump")
+    flags = tuple(artifact.metadata["native_flags"])
+    assert "-march=armv8.2-a+sve" in flags
+    assert "-msve-vector-bits=scalable" in flags
+    assert not any("sve2" in flag or "i8mm" in flag for flag in flags)
+    listing = subprocess.run(
+        [objdump, "-d", artifact.path],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        universal_newlines=True,
+        check=True,
+    ).stdout
+    symbol = listing.split("<{}>:".format(W8A8_QMATMUL_KERNEL), 1)
+    assert len(symbol) == 2, "native qmatmul symbol is missing from the ELF"
+    body = symbol[1].split("\n\n", 1)[0].lower()
+    assert len(re.findall(r"\bsunpklo\b", body)) >= 2, body
+    assert re.search(r"\b(mla|mul)\b", body)
+    assert re.search(r"\bst1w\b", body)
+    whole = listing.lower()
+    for forbidden in ("sdot", "udot", "smmla", "ummla", "usmmla", "bfdot", "bfmmla"):
+        assert not re.search(r"\b{}\b".format(forbidden), whole)
+    for kernel in (
+        W8A8_QMATMUL_KERNEL,
+        W8A8_DEQUANTIZE_S8_KERNEL,
+        W8A8_QUANTIZE_KERNEL,
+        W8A8_EPILOGUE_KERNEL,
+    ):
+        assert "<{}>:".format(kernel) in listing
+
