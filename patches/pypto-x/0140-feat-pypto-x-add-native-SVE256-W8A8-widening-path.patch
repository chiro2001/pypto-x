+def _w8a8_plan_error(operation: Any, plan: Any) -> Optional[str]:
+    """Return a fail-closed error string for a malformed W8A8 SVE plan.
+
+    The shared CPU vector planner already validates shapes and the C1 scalar
+    opcode contract; this extra check pins the exact dtype signature each
+    W8A8 plan must have before the SVE runner protocol can describe it
+    (contract 0002 section 3.3 / R6).
+    """
