+        {"w8a8_kernel_version": 0},
+        {"w8a8_sdot_used": True},
+        {"w8a8_i8mm_used": True},
+        {"w8a8_capability": capability},
+    )
+    for update in cases:
+        with pytest.raises(CpuSve256ArtifactError):
+            runtime.load(tampered(**update))
+    bad_dtypes = dict(artifact.metadata["w8a8_capability"])
+    bad_dtypes["dtypes"] = ["int8", "int32"]
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime.load(tampered(w8a8_capability=bad_dtypes))
+    bad_matrix = dict(artifact.metadata["w8a8_capability"])
+    bad_matrix["matrix_capabilities"] = ["s8s8_s32_widening"]
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime.load(tampered(w8a8_capability=bad_matrix))
+    bad_entry = dict(artifact.metadata["w8a8_capability"])
+    bad_entry["sdot_used"] = True
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime.load(tampered(w8a8_capability=bad_entry))
+
