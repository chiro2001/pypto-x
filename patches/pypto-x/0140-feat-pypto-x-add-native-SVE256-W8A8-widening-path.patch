+    declared = sve256_w8a8_capabilities(capability)
+    assert declared.dtypes == SVE256_W8A8_CAPABILITY.dtypes
+    assert set(declared.dtypes) == {"int8", "int32", "float32", "bf16"}
+    assert declared.matrix_capabilities == (SVE256_W8A8_MATRIX_CAPABILITY,)
+    for forbidden in SVE256_W8A8_FORBIDDEN_MATRIX_CAPABILITIES:
