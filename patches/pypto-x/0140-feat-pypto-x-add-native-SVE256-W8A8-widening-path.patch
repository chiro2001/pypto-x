+    name = plan.operation
+    plan_dtype = canonical_dtype(plan.dtype)
+    inputs = tuple(canonical_dtype(ref.type.dtype) for ref in operation.inputs)
+    outputs = tuple(canonical_dtype(ref.type.dtype) for ref in operation.outputs)
+    if name == W8A8_QMATMUL_OPCODE:
+        if plan_dtype != "int32" or inputs != ("int8", "int8") or outputs != ("int32",):
+            return "SVE256 {} requires int8 x int8 -> int32, got {!r}/{!r}".format(
+                name, inputs, outputs
+            )
+        if plan.matmul is None:
+            return "SVE256 {} requires a matmul plan".format(name)
+        return None
+    if name == W8A8_QUANTIZE_OPCODE:
+        if plan_dtype != "int8" or inputs not in (("float32",), ("bf16",)):
+            return "SVE256 {} requires a single float32/bf16 input and int8 codes, got {!r}/{!r}".format(
+                name, inputs, plan_dtype
+            )
+        if outputs != ("int8", "float32"):
+            return "SVE256 {} requires int8 codes and float32 scales, got {!r}".format(
+                name, outputs
+            )
+        return None
+    if name == W8A8_DEQUANTIZE_OPCODE:
+        if plan_dtype != "float32" or inputs != ("int8", "float32") or outputs != ("float32",):
+            return "SVE256 {} requires int8+float32 -> float32, got {!r}/{!r}".format(
+                name, inputs, outputs
+            )
+        return None
+    if name == W8A8_EPILOGUE_OPCODE:
+        if plan_dtype != "bf16" or inputs != ("int32", "float32", "float32") or outputs != ("bf16",):
+            return "SVE256 {} requires int32+float32+float32 -> bf16, got {!r}/{!r}".format(
+                name, inputs, outputs
+            )
+        return None
+    return "SVE256 received unknown W8A8 operation {!r}".format(name)
