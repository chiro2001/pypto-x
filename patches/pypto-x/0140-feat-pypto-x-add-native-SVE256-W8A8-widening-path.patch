+def test_sve256_w8a8_metadata_describes_native_contract(build_root):
+    program, _ = _qmatmul_program((2, 3, 5), (2, 5, 7))
+    target_ir, artifact = _compile(program, build_root, "qm_meta")
+    assert target_ir.lowering_version == SVE256_LOWERING_VERSION == 8
+    assert RUNNER_PROTOCOL == "pypto-x.cpu.sve256.runner.v6"
+    assert artifact.metadata["runner_protocol"] == RUNNER_PROTOCOL
+    assert artifact.metadata["w8a8_runner_wire"] == W8A8_RUNNER_WIRE
+    assert artifact.metadata["w8a8_kernel_version"] == W8A8_KERNEL_VERSION
+    assert tuple(artifact.metadata["w8a8_kernel_operations"]) == (W8A8_QMATMUL_OPCODE,)
+    assert artifact.metadata["w8a8_capability"]["digest"] == SVE256_W8A8_CAPABILITY.fingerprint
+    assert artifact.metadata["w8a8_sdot_used"] is False
+    assert artifact.metadata["w8a8_i8mm_used"] is False
+    entry = artifact.metadata["w8a8_operations"][0]
+    assert entry["mode"] == W8A8_QMATMUL_MODE
+    assert entry["kernel"] == W8A8_QMATMUL_KERNEL
+    assert entry["compensation"] == W8A8_COMPENSATION
+    assert tuple(entry["batch_shape"]) == (2,)
+    assert (entry["m"], entry["k"], entry["n"]) == (3, 5, 7)
+    assert artifact.metadata["w8a8_batched_qmatmul_dispatch"] == (
+        "host_batch_loop_rank2_native_kernel"
+    )
+    batched = list(artifact.metadata["w8a8_batched_qmatmul_operations"])
+    assert len(batched) == 1
+    assert batched[0]["operation"] == W8A8_QMATMUL_OPCODE
+    assert tuple(batched[0]["batch_shape"]) == (2,)
+    assert (batched[0]["m"], batched[0]["k"], batched[0]["n"]) == (3, 5, 7)
+    contract = w8a8_kernel_contract(
+        target_ir.program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None
+    assert contract["kernel"] == W8A8_QMATMUL_KERNEL
+    assert contract["sdot_used"] is False and contract["i8mm_used"] is False
+
