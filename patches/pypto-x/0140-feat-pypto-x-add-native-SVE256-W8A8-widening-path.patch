+def _storage_scalar_value(dtype: str, value: Any) -> Any:
+    """Convert one host value to the native scalar used by a storage handle.
+
+    This is the write-side mirror of :func:`_cast_value`: BF16 is stored as
+    raw bits, float32 as a C float, and every integer dtype as a Python int
+    (never ``float(value)``, which ctypes rejects for integer arrays).  The
+    historical raw-address integer output path crashed with a TypeError
+    because it forced every non-BF16 value through ``float``.
+    """
+
+    dtype = canonical_dtype(dtype)
+    if dtype == "bf16":
+        return _bf16_bits(value)
+    if dtype == "float32":
+        return float(value)
+    if dtype == "bool":
+        return 1 if _cast_value(value, "bool") else 0
+    if dtype in _PACK_CODES:
+        return _cast_value(value, dtype)
+    return value
+
+
 def _bf16_bits(value: Any) -> int:
     number = float(value)
     bits = struct.unpack("<I", struct.pack("<f", number))[0]
@@ -209,6 +294,92 @@ def _bf16_value(bits: int) -> float:
     return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
 
 
