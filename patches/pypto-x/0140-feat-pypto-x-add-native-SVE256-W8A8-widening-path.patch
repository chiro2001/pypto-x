@@ -0,0 +1,984 @@
+"""SVE256 W8A8 widening path: contract 0002 C5 / R6 evidence.
+
+Scope of this module:
+
+* the native ``qmatmul_s8s8_s32`` Core IR path is bit-exact with the C1
+  scalar integer golden, including rank-3/rank-4 batch prefixes,
+  non-multiple-of-8 M/N/K tails, the K upper bound, the reserved ``-128``
+  code point and integer extremes;
+* the SVE256 capability declaration travels through ``CapabilitySet`` and is
+  gated by the real ``getauxval``/``prctl`` probe; injected capabilities can
+  neither forge nor disable the real gate (fail-closed);
+* the three dequantize/quantize primitives are bit-exact with the C1
+  goldens through the probe-gated target entry points;
+* the emitted widening code is proven by disassembly: two-stage ``sunpklo``
+  (s8 -> s16 -> s32) plus integer ``mla``, and no SDOT/I8MM instruction is
+  emitted even when the machine exposes those HWCAP2 bits;
+* runner wire v6 and lowering v7 artifacts fail closed instead of being
+  reinterpreted under the float-only operation set.
+
+This file also pins the connected fix for the pre-existing
+``sve256_write_storage`` integer raw-address output TypeError (registered as
+known limit ``sve256_write_storage_integer_raw_address_output_preexisting_typeerror``);
+the fix is not a C5-new defect but was required for an int32 W8A8 output
+handle.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import math
+import os
+from pathlib import Path
+import platform
+import random
+import re
+import shutil
+import struct
+import subprocess
+
+import pytest
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cpu.aarch64 import (
+    CpuSve256ArtifactError,
+    CpuSve256ExecutionError,
+    CpuSve256UnavailableError,
+    Sve256Runtime,
+)
+from pypto.backends.cpu.tensor import _cast_value
+from pypto.compiler import Artifact, CompileOptions
+from pypto.compiler.targets.cpu_sve256 import (
+    RUNNER_PROTOCOL,
+    W8A8_COMPENSATION,
+    W8A8_DEQUANTIZE_S8_KERNEL,
+    W8A8_EPILOGUE_KERNEL,
+    W8A8_KERNEL_VERSION,
+    W8A8_QMATMUL_KERNEL,
+    W8A8_QMATMUL_MODE,
+    W8A8_QUANTIZE_KERNEL,
+    W8A8_RUNNER_WIRE,
+    Sve256Compiler,
+    w8a8_kernel_contract,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import (
+    CpuScalarUnsupportedError,
+    W8A8_DEQUANTIZE_OPCODE,
+    W8A8_EPILOGUE_OPCODE,
+    W8A8_MAX_ACCUMULATOR_K,
+    W8A8_QMATMUL_OPCODE,
+    W8A8_QUANTIZE_OPCODE,
+    flatten_values,
+)
+from pypto.lowering.cpu.aarch64.sve import (
+    SVE256_LOWERING_VERSION,
+    SVE256_W8A8_CAPABILITY,
+    SVE256_W8A8_FORBIDDEN_MATRIX_CAPABILITIES,
+    SVE256_W8A8_MATRIX_CAPABILITY,
+    Sve256Capability,
+    probe_sve256_capabilities,
+    sve256_w8a8_capabilities,
+)
+from pypto.lowering.cpu.aarch64.sve import capabilities as capabilities_module
+from pypto.lowering.cpu.vector import CpuVectorUnsupportedError
+from pypto.portable.qwen35_w8a8_scheme import (
+    OPCODE_DEQUANTIZE_EPILOGUE_BF16,
+    OPCODE_DEQUANTIZE_S8,
+    OPCODE_QMATMUL_S8S8_S32,
+    OPCODE_QUANTIZE_PER_TOKEN_S8,
+    W8A8QuantizationError,
+    W8A8SchemeError,
+    dequantize_epilogue_bf16,
+    dequantize_s8,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+from pypto.target import TargetSpec, UnsupportedCapabilityError
+
+
+_QEMU_CPU = "max,sve256=on"
+# The same focused suite runs natively on A3 (SVE VL=32) by exporting
+# PYPTO_X_SVE_TEST_MODE=native; the default local leg is the explicit QEMU
+# differential.  No test ever silently crosses between the two modes.
+_EXECUTION_MODE = os.environ.get("PYPTO_X_SVE_TEST_MODE", "qemu").strip().lower()
+if _EXECUTION_MODE not in ("native", "qemu"):
+    raise RuntimeError("PYPTO_X_SVE_TEST_MODE must be 'native' or 'qemu'")
+
+
+@pytest.fixture(scope="session")
+def build_root(tmp_path_factory):
+    return tmp_path_factory.mktemp("pypto-x-sve256-w8a8")
+_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2", "vl256"),
+    attributes={"vl_bytes": 32},
+)
+_COMPILED = {}
+
+
+def _require_sve_execution() -> None:
+    if _EXECUTION_MODE == "qemu":
+        if shutil.which("qemu-aarch64") is None:
+            pytest.skip("qemu-aarch64 is unavailable")
+    elif platform.machine().lower() not in ("aarch64", "arm64"):
+        pytest.skip("native SVE256 execution requires an AArch64 host")
+
+
+def _runtime(**kwargs) -> Sve256Runtime:
+    return Sve256Runtime(execution_mode=_EXECUTION_MODE, qemu_cpu=_QEMU_CPU, **kwargs)
+
+
+def _program(name, inputs, outputs, attributes=None):
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "main",
+                tuple(inputs),
+                tuple(outputs),
+                Region((Operation(name, tuple(inputs), tuple(outputs), attributes or {}),)),
+            ),
+        )
+    )
+
+
+def _qmatmul_program(left_shape, right_shape):
+    left = ValueRef("left", CoreType.tensor("int8", left_shape))
+    right = ValueRef("right", CoreType.tensor("int8", right_shape))
+    output_shape = left_shape[:-2] + (left_shape[-2], right_shape[-1])
+    output = ValueRef("output", CoreType.tensor("int32", output_shape))
+    return _program(W8A8_QMATMUL_OPCODE, (left, right), (output,)), output_shape
+
+
+def _quantize_program(shape):
+    source = ValueRef("values", CoreType.tensor("float32", shape))
+    codes = ValueRef("codes", CoreType.tensor("int8", shape))
+    scales = ValueRef("scales", CoreType.tensor("float32", (shape[0],)))
+    return _program(W8A8_QUANTIZE_OPCODE, (source,), (codes, scales))
+
+
+def _dequantize_program(shape):
+    codes = ValueRef("codes", CoreType.tensor("int8", shape))
+    rows = math.prod(shape[:-1]) if len(shape) > 1 else 1
+    scales = ValueRef("scales", CoreType.tensor("float32", (rows,)))
+    output = ValueRef("output", CoreType.tensor("float32", shape))
+    return _program(W8A8_DEQUANTIZE_OPCODE, (codes, scales), (output,))
+
+
+def _epilogue_program(rows, columns):
+    accumulator = ValueRef("accumulator", CoreType.tensor("int32", (rows, columns)))
+    row_scales = ValueRef("row_scales", CoreType.tensor("float32", (rows,)))
+    column_scales = ValueRef("column_scales", CoreType.tensor("float32", (columns,)))
+    output = ValueRef("output", CoreType.tensor("bf16", (rows, columns)))
+    return _program(
+        W8A8_EPILOGUE_OPCODE,
+        (accumulator, row_scales, column_scales),
+        (output,),
+    )
+
+
+def _elementwise_program(shape=(4,)):
+    source = ValueRef("source", CoreType.tensor("float32", shape))
+    output = ValueRef("output", CoreType.tensor("float32", shape))
+    return _program("neg", (source,), (output,))
+
+
+def _compile(program, build_root, key):
+    if key not in _COMPILED:
+        compiler = Sve256Compiler()
+        target_ir = compiler.lower(program, _TARGET)
+        artifact = compiler.compile(
+            target_ir,
+            CompileOptions(
+                artifact_format="pypto-x.cpu.sve256",
+                extra={"build_dir": str(Path(build_root) / key)},
+            ),
+        )
+        _COMPILED[key] = (target_ir, artifact)
+    return _COMPILED[key]
+
+
+def _launch(artifact, inputs, outputs, runtime=None):
+    (_runtime() if runtime is None else runtime).launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[value.descriptor() for value in outputs],
+        )
+    )
+
+
+def _flat_values(output):
+    return tuple(flatten_values(output.data))
+
+
+def _rand_codes(rng, count, low=-127, high=127):
+    return [rng.randint(low, high) for _ in range(count)]
+
+
+def _qmatmul_golden(left, right, left_shape, right_shape):
+    return qmatmul_s8s8_s32(left, right, left_shape=left_shape, right_shape=right_shape).values
+
+
+def _float_bits(values):
+    return tuple(struct.pack("<f", value) for value in values)
+
+
+def _f32_nan(value: float) -> bool:
+    bits = struct.unpack("<I", struct.pack("<f", value))[0]
+    return (bits & 0x7F800000) == 0x7F800000 and bool(bits & 0x007FFFFF)
+
+
+def _f32_equal(left: float, right: float) -> bool:
+    if struct.pack("<f", left) == struct.pack("<f", right):
+        return True
+    return _f32_nan(left) and _f32_nan(right)
+
+
+def _bf16_nan(bits: int) -> bool:
+    return (bits & 0x7F80) == 0x7F80 and bool(bits & 0x007F)
+
+
+def _bf16_bits_equal(left: int, right: int) -> bool:
+    if left == right:
+        return True
+    return _bf16_nan(left) and _bf16_nan(right)
+
+
+def _f32_sequence_equal(left, right) -> bool:
+    return len(left) == len(right) and all(
+        _f32_equal(a, b) for a, b in zip(left, right)
+    )
+
+
+# ---------------------------------------------------------------------------
+# a) qmatmul_s8s8_s32 native Core IR, bit-exact with the scalar golden
+# ---------------------------------------------------------------------------
+
+QMATMUL_SHAPES = (
+    ((1, 1), (1, 1)),
+    ((2, 3), (3, 4)),
+    ((17, 13), (13, 19)),
+    ((2, 3, 5), (2, 5, 7)),
+    ((2, 1, 4, 3), (2, 1, 3, 5)),
+    ((3, 5, 7, 11), (3, 5, 11, 13)),
+    ((5, 7, 19), (5, 19, 3)),
+    ((1, 8, 9), (1, 9, 1)),
+)
+
+
+@pytest.mark.parametrize("left_shape,right_shape", QMATMUL_SHAPES)
+def test_sve_w8a8_qmatmul_core_ir_matches_integer_golden(left_shape, right_shape, build_root):
+    _require_sve_execution()
+    program, output_shape = _qmatmul_program(left_shape, right_shape)
+    key = "qm_{}_{}".format(left_shape, right_shape).replace(" ", "")
+    target_ir, artifact = _compile(program, build_root, key)
+    assert [plan.operation for plan in target_ir.plans] == [W8A8_QMATMUL_OPCODE]
+    assert tuple(artifact.metadata["w8a8_kernel_operations"]) == (W8A8_QMATMUL_OPCODE,)
