+def _w8a8_flatten(values: Any, context: str) -> Tuple[Tuple[Any, ...], Tuple[int, ...]]:
+    """Flatten a regular nested sequence and infer its row-major shape."""
+
+    if isinstance(values, (list, tuple)):
+        if not values:
+            return (), (0,)
+        flat: List[Any] = []
+        child_shape: Optional[Tuple[int, ...]] = None
+        for index, item in enumerate(values):
+            item_flat, item_shape = _w8a8_flatten(item, "{}[{}]".format(context, index))
+            if child_shape is None:
+                child_shape = item_shape
+            elif item_shape != child_shape:
+                raise CpuSve256ExecutionError(
+                    "{} is ragged: {} != {}".format(context, item_shape, child_shape)
+                )
+            flat.extend(item_flat)
+        assert child_shape is not None
+        return tuple(flat), (len(values),) + child_shape
+    return (values,), ()
+
+
+def _w8a8_declared_shape(
+    values: Any,
+    shape: Optional[Sequence[int]],
+    context: str,
+) -> Tuple[Tuple[Any, ...], Tuple[int, ...]]:
+    flat, inferred = _w8a8_flatten(values, context)
+    if shape is None:
+        return flat, inferred
+    try:
+        declared = tuple(int(dimension) for dimension in shape)
+    except (TypeError, ValueError) as exc:
+        raise CpuSve256ExecutionError(
+            "{} shape must be a sequence of integers".format(context)
+        ) from exc
+    for index, dimension in enumerate(declared):
+        if isinstance(dimension, bool) or dimension < 0:
+            raise CpuSve256ExecutionError(
+                "{} shape[{}] must be a non-negative integer".format(context, index)
+            )
+    product = 1
+    for dimension in declared:
+        product *= dimension
+    if product != len(flat):
+        raise CpuSve256ExecutionError(
+            "{} shape {} does not match {} flattened elements".format(context, declared, len(flat))
+        )
+    return flat, declared
+
+
+def _w8a8_int_codes(flat: Sequence[Any], context: str) -> Tuple[int, ...]:
+    """Validate the frozen symmetric [-127, 127] code domain (no -128)."""
+
+    codes = []
+    for index, code in enumerate(flat):
+        if isinstance(code, bool) or not isinstance(code, int):
+            raise CpuSve256ExecutionError(
+                "{}[{}] must be an integer code".format(context, index)
+            )
+        if code < -127 or code > 127:
+            raise CpuSve256ExecutionError(
+                "{}[{}]={} outside [-127, 127]".format(context, index, code)
+            )
+        codes.append(code)
+    return tuple(codes)
+
+
+def _w8a8_row_count(shape: Sequence[int]) -> int:
+    rows = 1
+    for dimension in shape[:-1]:
+        rows *= dimension
+    return rows
+
