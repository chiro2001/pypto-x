+def test_sve256_w8a8_elf_wire_is_version_locked(build_root):
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_wire")
+    request = struct.Struct("<6I4Q")
+
+    def run(version, operation):
+        header = request.pack(0x56535850, version, operation, 4, 0, 0, 1, 1, 2, 1)
+        payload = struct.pack("<2b", 1, 2) + struct.pack("<2b", 1, 1)
+        if _EXECUTION_MODE == "qemu":
+            command = [
+                "qemu-aarch64", "-L", "/usr/aarch64-linux-gnu", "-cpu", _QEMU_CPU,
+                artifact.path,
+            ]
+        else:
+            command = [artifact.path]
+        return subprocess.run(
+            command,
+            input=header + payload,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+
+    good = run(6, 29)
+    assert good.returncode == 0
+    magic, version, status, dtype, count = struct.unpack("<4IQ", good.stdout[:24])
+    assert (magic, version, status, dtype, count) == (0x56535850, 6, 0, 4, 1)
+    # v5 must not be reinterpreted as the W8A8 wire, and v6 must not carry a
+    # non-W8A8 operation.
+    for version, operation in ((5, 29), (6, 1)):
+        result = run(version, operation)
+        assert result.returncode != 0
+        _, response_version, status, _, _ = struct.unpack("<4IQ", result.stdout[:24])
+        assert response_version == version
+        assert status != 0
+
