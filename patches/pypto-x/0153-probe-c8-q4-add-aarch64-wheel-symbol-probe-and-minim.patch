From: c8-axis-b-probe <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:35:10 +0800
Subject: [PATCH 153/258] probe(c8-q4): add aarch64 wheel symbol probe and
 minimal dep bootstrap

---
 scripts/c8_axis_b_probe/15_a3_wheel_symbol_probe.sh | 41 +++++++++++++++++++++++++++++
 scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh     | 57 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 98 insertions(+)

diff --git a/scripts/c8_axis_b_probe/15_a3_wheel_symbol_probe.sh b/scripts/c8_axis_b_probe/15_a3_wheel_symbol_probe.sh
new file mode 100644
index 000000000..fa762de49
--- /dev/null
+++ b/scripts/c8_axis_b_probe/15_a3_wheel_symbol_probe.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# A3 follow-up (light, decisive): does the aarch64 vllm-cpu 0.29.0 wheel
+# actually contain the CPU int8/oneDNN kernel symbols and libraries?
+# No vLLM import, no dependency installation: unzip + symbol scan only.
+set -uo pipefail
+BASE="$HOME/pypto-x-a3"
+RUN="$BASE/c8axisb"
+WHEEL="$(ls "$RUN"/wheel/vllm_cpu-0.29.0*aarch64*.whl 2>/dev/null | head -1)"
+EX="$RUN/wheel/extract"
+echo "### aarch64 wheel symbol probe $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "wheel=$WHEEL bytes=$(stat -c %s "$WHEEL" 2>/dev/null)"
+rm -rf "$EX"; mkdir -p "$EX"
+python3 - "$WHEEL" "$EX" <<'PY'
+import sys, zipfile, os
+wheel, ex = sys.argv[1], sys.argv[2]
+with zipfile.ZipFile(wheel) as z:
+    names = z.namelist()
+    picks = [n for n in names if n.endswith('.so') or 'dnnl' in n.lower()
+             or 'onednn' in n.lower() or 'arm_compute' in n.lower() or 'acl' in os.path.basename(n).lower()]
+    z.extractall(ex, members=[n for n in names if n.endswith('.so') or 'dnnl' in n.lower() or 'arm_compute' in n.lower()])
+    print("total_entries=", len(names))
+    print("so_and_lib_entries=", len(picks))
+    for n in sorted(picks)[:40]:
+        print("  ", n)
+PY
+echo "--- extracted files ---"
+find "$EX" -type f | sed "s|$EX/||" | head -40
+echo "--- symbol scan ---"
+for so in $(find "$EX" -name "*.so" -o -name "*.so.*" | head -20); do
+    echo "## $so"
+    if command -v nm >/dev/null 2>&1; then
+        nm -D --defined-only "$so" 2>/dev/null | grep -iE "onednn_scaled|dynamic_scaled_int8|scaled_int8_quant|create_onednn" | head -8
+    fi
+    strings "$so" 2>/dev/null | grep -iE "dynamic_scaled_int8_quant|create_onednn_scaled_mm_handler|onednn_scaled_mm" | sort -u | head -8
+done
+echo "--- dnnl/acl linkage check in wheel ---"
+for so in $(find "$EX" -name "*.so" | head -20); do
+    echo "## $(basename "$so")"
+    strings "$so" 2>/dev/null | grep -iE "libdnnl|libarm_compute|libmkl|dnnl_|arm_compute" | sort -u | head -5
+done
+echo "### done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
diff --git a/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh b/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh
new file mode 100644
index 000000000..4eb576512
--- /dev/null
+++ b/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# A3 follow-up: bootstrap the minimal import closure of the aarch64
+# vllm-cpu 0.29.0 wheel INSIDE the removable venv (--no-deps per module,
+# looping on ModuleNotFoundError), then run the cross-architecture probe.
+#
+# The wheel itself (already installed) contains the CPU int8/oneDNN symbols;
+# only Python-level deps are missing.  Everything stays under ~/pypto-x-a3/**.
+set -uo pipefail
+BASE="$HOME/pypto-x-a3"
+RUN="$BASE/c8axisb"
+VENV="$BASE/envs/pypto-x-c8-axisb"
+PY="$VENV/bin/python"
+PIP="$VENV/bin/pip"
+export PIP_CACHE_DIR="$RUN/pip-cache"
+export TMPDIR="$RUN/tmp"
+mkdir -p "$PIP_CACHE_DIR" "$TMPDIR" "$RUN/logs"
+
+echo "### A3 minimal dep bootstrap $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+for i in $(seq 1 50); do
+    out="$("$PY" -c 'import vllm' 2>&1)"
+    rc=$?
+    if [[ $rc -eq 0 ]]; then
+        echo "IMPORT_OK after $((i-1)) installs"
+        break
+    fi
+    mod="$(echo "$out" | grep -oE "No module named '[^']+'" | tail -1 | sed "s/No module named '//; s/'//")"
+    if [[ -z "$mod" ]]; then
+        echo "NON_MODULE_ERROR at iteration $i:"
+        echo "$out" | tail -25
+        break
+    fi
+    pkg="${mod%%.*}"
+    case "$pkg" in
+        cv2) pkg=opencv-python-headless ;;
+        yaml) pkg=PyYAML ;;
+        PIL) pkg=pillow ;;
+        google) pkg=protobuf ;;
+        googleapis_common_protos) pkg=googleapis-common-protos ;;
+        opentelemetry) pkg=opentelemetry-api ;;
+        * ) ;;
+    esac
+    echo "[$i] missing '$mod' -> pip install --no-deps '$pkg'"
+    timeout 240 "$PIP" install --no-input --no-deps "$pkg" 2>&1 | tail -2
+done
+
+echo "--- vllm import result ---"
+"$PY" -c "import vllm; print('vllm', vllm.__version__)" 2>&1 | tail -3
+
+echo "--- cross-architecture single-layer probe ---"
+timeout 1200 "$PY" "$RUN/scripts/14_a3_cpu_probe.py" \
+    --artifact-npz "$RUN/artifact/our_artifact_subset.npz" \
+    --x86-outputs "$RUN/artifact/vllm_cpu_layer_probe_outputs.npz" \
+    --out-json "$RUN/logs/16_a3_cpu_probe.json" \
+    > "$RUN/logs/16_a3_cpu_probe.stdout.log" 2>&1
+echo "probe_rc=$?"
+tail -25 "$RUN/logs/16_a3_cpu_probe.stdout.log"
+echo "### done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
