+#!/usr/bin/env bash
+# =============================================================================
+# PyPTO-X 本机 CANN Toolkit-only 安装脚本
+#
+# 目标：在无 Ascend NPU 的 x86_64 开发机上安装 CANN 9.2.0-beta.2 的
+#       **toolkit 组件**（含 cannsim 仿真入口），并显式保证：
+#         1. 不安装 Ascend-cann-950-ops（A5 算子包）—— 本包内也不存在该子包；
+#         2. 不安装 driver / firmware 子包；
+#         3. 不加载、不编译任何内核模块（无 modprobe / insmod / dkms）；
+#         4. 不重启、不改 grub、不卸载既有软件。
+#
+# 用法（分阶段，重任务必须经全局 local 锁）：
+#   # 轻量阶段（下载 + 校验 + 用户组），可直接跑
+#   tools/cann/install_cann_toolkit_local.sh --stage download
+#   tools/cann/install_cann_toolkit_local.sh --stage user
+#
+#   # 安装与验证是重任务，必须经 heavy runner（脚本会自己套一层）
+#   tools/cann/install_cann_toolkit_local.sh --stage install
+#   tools/cann/install_cann_toolkit_local.sh --stage verify
+#
+#   # 一次性全流程
+#   tools/cann/install_cann_toolkit_local.sh --stage all
+#
+# 幂等性：重复执行是安全的。已下载且 sha256 匹配则跳过下载；HwHiAiUser 已
+#         存在则跳过创建；已安装同版本会走安装器的既有逻辑。
+# =============================================================================
+set -euo pipefail
+
+# ------------------------------- 常量 ---------------------------------------
+readonly CANN_VERSION="9.2.0-beta.2"
+readonly PKG_BASENAME="Ascend-cann_${CANN_VERSION}_linux-x86_64.run"
+readonly PKG_URL="https://ascend-cann-open.obs.cn-north-4.myhuaweicloud.com/CANN/CANN%20${CANN_VERSION}/${PKG_BASENAME}"
+# 官方 OBS bucket 目录列表未提供 .sha256 旁文件（2026-09-10 用 list-type=2 核实，
+# 该 prefix 下仅有 x86_64 / aarch64 两个 .run）。以下 sha256 由本次下载后本地计算，
+# 并与官方 Content-Length=2185327136 及 multipart ETag 交叉核对。
+readonly PKG_SHA256="ffb8f5525f7ed60fd8ae57ac7883d45ddf382cfdc9468aaa72a117a7ba41c987"
+readonly PKG_SIZE=2185327136
+readonly PKG_ETAG="d9f6f9474dd8948c31af019dc8afead4-232"
+
+readonly PROXY_DEFAULT="http://127.0.0.1:14514"
+readonly META_ROOT_DEFAULT="/home/chiro/projects/pypto/worktrees/_meta/pypto-x/cann-toolkit-local-install"
+readonly HEAVY_RUNNER_DEFAULT="/home/chiro/projects/pypto/pypto_x/scripts/resource/run_local_heavy.sh"
+readonly DEFAULT_INSTALL_PATH="/usr/local/Ascend"
+
+# 本次安装明确不涉及的东西
+readonly FORBIDDEN_PKG_PATTERN="950-ops|cann-950|NNAL|nnal"
+readonly FORBIDDEN_KERNEL_MODULES="drv_ascend|ascend_kmd|hisi_hdc"
+
+# ------------------------------ 参数解析 ------------------------------------
+stage="all"
+meta_root="${META_ROOT_DEFAULT}"
+proxy="${https_proxy:-$PROXY_DEFAULT}"
+heavy_runner="${HEAVY_RUNNER_DEFAULT}"
+task="cann-toolkit-local-install"
+agent="cann-toolkit-local-install"
+allow_bare=0
+
+usage() {
+  sed -n '2,32p' "$0"
+  exit 64
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --stage) stage="$2"; shift 2 ;;
+    --meta-root) meta_root="$2"; shift 2 ;;
+    --proxy) proxy="$2"; shift 2 ;;
+    --heavy-runner) heavy_runner="$2"; shift 2 ;;
+    --task) task="$2"; shift 2 ;;
+    --agent) agent="$2"; shift 2 ;;
+    --allow-bare) allow_bare=1; shift ;;
+    -h|--help) usage ;;
+    *) echo "未知参数: $1" >&2; usage ;;
+  esac
+done
+
+readonly PKG_DIR="${meta_root}/pkg"
+readonly RAW_DIR="${meta_root}/raw"
+readonly PKG_PATH="${PKG_DIR}/${PKG_BASENAME}"
+readonly SHIM_DIR="${meta_root}/shim"
+
+log() { printf '[%s] %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }
+
+# ------------------------------ 显式断言 ------------------------------------
+# 这些断言在安装前后都会跑，任何一条被违反就立即失败，
+# 用于机械保证「只装 toolkit、不装 950-ops、不动内核模块」。
+assert_boundaries() {
+  local phase="$1" rc=0
+
+  # 1) 内核模块：不允许出现任何 Ascend 内核模块被加载
+  if lsmod 2>/dev/null | grep -Eq "^(${FORBIDDEN_KERNEL_MODULES})"; then
+    log "断言失败[$phase]: 检测到 Ascend 内核模块已加载"
+    lsmod | grep -E "^(${FORBIDDEN_KERNEL_MODULES})" >&2
+    rc=1
+  fi
+
+  # 2) 950-ops 子包：本合一包内不存在，安装目录也不允许出现 950-ops 痕迹
+  if [[ -d "${DEFAULT_INSTALL_PATH}" ]] && \
+     grep -rqE "${FORBIDDEN_PKG_PATTERN}" "${DEFAULT_INSTALL_PATH}" \
+       --include='*.info' 2>/dev/null; then
+    log "断言失败[$phase]: 安装目录出现 950-ops/NNAL 痕迹"
+    rc=1
+  fi
+
+  # 3) dkms：不允许有任何 Ascend 相关的 dkms 动作
+  if command -v dkms >/dev/null 2>&1 && dkms status 2>/dev/null | grep -qi ascend; then
+    log "断言失败[$phase]: dkms 中出现 Ascend 模块"
+    rc=1
+  fi
+
+  # 4) 明确声明：本脚本绝不调用这些命令
+  for forbidden_cmd in modprobe insmod dkms reboot; do
+    if grep -qE "^[[:space:]]*(sudo[[:space:]]+)?${forbidden_cmd}[[:space:]]" "$0"; then
+      log "断言失败[$phase]: 脚本自身引用了被禁命令 ${forbidden_cmd}"
+      rc=1
+    fi
+  done
+
+  if [[ $rc -eq 0 ]]; then
+    log "边界断言[$phase]: PASS（无 Ascend 内核模块 / 无 950-ops / 无 dkms）"
+  else
+    return 1
+  fi
+}
+
+# ------------------------------ 阶段实现 ------------------------------------
+stage_preflight() {
+  mkdir -p "${PKG_DIR}" "${RAW_DIR}" "${SHIM_DIR}"
+  {
+    echo "== 发行版 =="; cat /etc/os-release
+    echo "== 内核 =="; uname -a
+    echo "== 虚拟化 =="; systemd-detect-virt || true
+    echo "== 磁盘 =="; df -h / "${DEFAULT_INSTALL_PATH%/Ascend}" 2>/dev/null || df -h /
+    echo "== 内存 =="; free -m
+    echo "== 既有 Ascend =="; ls -la "${DEFAULT_INSTALL_PATH}" 2>&1 || echo "未安装"
+  } > "${RAW_DIR}/30-preflight.txt" 2>&1
+  assert_boundaries "preflight"
+}
+
+# arch(1) 在精简发行版上缺失会导致安装器 frame="" 从而拒绝 --whitelist；
+# 这里只在证据目录内造一个 shim，并通过显式 PATH 注入，不写系统目录。
+stage_shim() {
+  mkdir -p "${SHIM_DIR}"
+  cat > "${SHIM_DIR}/arch" <<'SHIM'
+#!/bin/sh
+exec uname -m
+SHIM
+  chmod 0755 "${SHIM_DIR}/arch"
+  log "arch shim 就绪: ${SHIM_DIR}/arch -> $(uname -m)"
+}
+
+stage_download() {
+  mkdir -p "${PKG_DIR}" "${RAW_DIR}"
+  if [[ -f "${PKG_PATH}" ]] && \
+     [[ "$(stat -c%s "${PKG_PATH}")" == "${PKG_SIZE}" ]] && \
+     [[ "$(sha256sum "${PKG_PATH}" | cut -d' ' -f1)" == "${PKG_SHA256}" ]]; then
+    log "包已存在且 sha256 匹配，跳过下载"
+    return 0
+  fi
+  log "开始下载 ${PKG_BASENAME}（代理 ${proxy}，断点续传）"
+  local t0 t1
+  t0=$(date +%s)
+  https_proxy="${proxy}" http_proxy="${proxy}" \
+    wget -c -T 60 -t 20 --progress=dot:giga -O "${PKG_PATH}" "${PKG_URL}" \
+    2> "${RAW_DIR}/31-download.log"
+  t1=$(date +%s)
+  log "下载完成，耗时 $((t1 - t0)) 秒"
+
+  # 大小校验（官方 Content-Length / OBS 列表 Size）
+  local size
+  size=$(stat -c%s "${PKG_PATH}")
+  [[ "${size}" == "${PKG_SIZE}" ]] || {
+    log "失败: 大小 ${size} != 官方 ${PKG_SIZE}"; return 1; }
+
+  # sha256 校验（无官方旁文件，使用本地记录值 + 内嵌包自校验双保险）
+  local sum
+  sum=$(sha256sum "${PKG_PATH}" | cut -d' ' -f1)
+  [[ "${sum}" == "${PKG_SHA256}" ]] || {
+    log "失败: sha256 ${sum} != 记录值 ${PKG_SHA256}"; return 1; }
+
+  # 安装器内嵌 sha256 自校验（--check 在解压后会调用内嵌脚本的 --check 分支，
+  # 内嵌脚本对 --check 的处理是直接 exit 0，不会真正安装）
+  log "运行安装器内嵌完整性校验 (--check)"
+  bash "${PKG_PATH}" --quiet --check > "${RAW_DIR}/32-embedded-check.txt" 2>&1 || true
+  grep -q "SHA256 checksums are OK" "${RAW_DIR}/32-embedded-check.txt" || {
+    log "警告: 未在内嵌校验输出中看到 OK，请人工复核 32-embedded-check.txt"; }
+
+  log "下载与校验 PASS: size=${size} sha256=${sum} etag=${PKG_ETAG}"
+}
+
+stage_user() {
+  if getent group HwHiAiUser >/dev/null; then
+    log "组 HwHiAiUser 已存在，跳过 groupadd"
+  else
+    sudo -n groupadd HwHiAiUser && log "已创建组 HwHiAiUser"
+  fi
+  if getent passwd HwHiAiUser >/dev/null; then
+    log "用户 HwHiAiUser 已存在，跳过 useradd"
+  else
+    sudo -n useradd -g HwHiAiUser -d /home/HwHiAiUser -m HwHiAiUser -s /bin/bash \
+      && log "已创建用户 HwHiAiUser"
+  fi
+  getent group HwHiAiUser; getent passwd HwHiAiUser
+}
+
+stage_install() {
+  stage_preflight
+  stage_shim
+  assert_boundaries "pre-install"
+
+  # 幂等：已安装同版本则跳过
+  if [[ -f "${DEFAULT_INSTALL_PATH}/cann-${CANN_VERSION}/x86_64-linux/ascend_all_cann_install.info" ]]; then
+    log "检测到 CANN ${CANN_VERSION} 已安装，跳过安装步骤"
+    return 0
+  fi
+
+  log "开始 toolkit-only 安装"
+  log "命令: sudo env PATH=<shim>:\$PATH bash ${PKG_BASENAME} \\"
+  log "        --install --whitelist=toolkit --install-for-all --quiet"
+
+  local t0 t1 rc=0
+  t0=$(date +%s)
+  # 关键 1：--whitelist=toolkit 让安装器从 install_packages 中剔除
+  #   Ascend-hdk-driver_26.0.rc1_linux-x86-64.run，并在 execute_install()
+  #   中对 driver 子包显式 continue（all_cann_install.sh:1695-1709）。
+  # 关键 2：--quiet 关闭 EULA/交互；stdin 接 /dev/null 防止任何 read 挂起。
+  # 关键 3（上游打包缺陷绕行）：子包安装器在 is_valid_path() 中用
+  #   `sh -c 'cd "$VAR" >> /dev/null 2>&1'` 校验安装目录可访问性，但 VAR
+  #   所在脚本全文没有任何 export 语句，内层 sh 读到空值后必然报
+  #   ERR_NO:0x0093 "The root do not have the permission to access <path>"。
+  #   对 32 个子包做脚本扫描（raw/37-subpkg-check-sweep.txt）后确认只用两种
+  #   变量名：
+  #     install_path                 -> acl-extend/asc-devkit/dflow-executor/
+  #                                     ge-compiler/ge-executor/graph-autofusion/
+  #                                     hcomm/metadef/npu-runtime/tbe-tik
+  #     input_install_path_param     -> cann-aoe, cann-simulator
+  #   两者都显式放进子进程环境即可通过（bash 的 local 会继承已导出变量的
+  #   export 属性）。这不是绕过权限：目录本来就由 root 可写。
+  sudo -n env "PATH=${SHIM_DIR}:${PATH}" \
+    "install_path=${DEFAULT_INSTALL_PATH}" \
+    "input_install_path_param=${DEFAULT_INSTALL_PATH}" \
+    bash "${PKG_PATH}" --install --whitelist=toolkit --install-for-all --quiet \
+    < /dev/null > "${RAW_DIR}/33-install.log" 2>&1 || rc=$?
+  t1=$(date +%s)
+  log "安装退出码=${rc}，耗时 $((t1 - t0)) 秒"
+
+  # 汇出安装日志尾部
+  tail -40 "${RAW_DIR}/33-install.log" || true
+
+  assert_boundaries "post-install"
+
+  if [[ $rc -ne 0 ]]; then
+    log "安装器返回非零；请在 33-install.log 中确认是整体失败还是个别子包失败"
+    return $rc
+  fi
+  log "安装阶段完成"
+}
+
+# 安装后验证（只读、低资源，不需要 local 锁）
+stage_verify() {
+  # 注意：不能用 `find ... | head -1`——head 提前关闭管道会让 find 收到
+  # SIGPIPE，在 `set -o pipefail` + `set -e` 下等于 141 并静默终止脚本。
+  # 用 GNU find 的 -print -quit 取第一个匹配。
+  local set_env
+  set_env=$(find "${DEFAULT_INSTALL_PATH}" -maxdepth 4 -name 'set_env.sh' -print -quit 2>/dev/null || true)
+  if [[ -z "${set_env}" ]]; then
+    log "未找到 set_env.sh，安装可能不完整"
+    return 1
+  fi
+  log "set_env.sh = ${set_env}"
+
+  # set_env.sh 内部用 `eval echo "\${VAR}"` 读取既有值，调用方开着 set -u 时
+  # 会对 LD_LIBRARY_PATH/PYTHONPATH/CMAKE_PREFIX_PATH 打印 "未绑定的变量"；
+  # 它自身也会 `set -e`。这里临时关掉 -u/-e，避免噪声与误终止。
+  set +u
+  set +e
+  # shellcheck disable=SC1090
+  source "${set_env}"
+  local src_rc=$?
+  set -u
+  set -e
+  log "source set_env.sh rc=${src_rc}"
+  {
+    echo "ASCEND_HOME_PATH=${ASCEND_HOME_PATH:-<未设置>}"
+    echo "PATH=${PATH}"
+    echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-<未设置>}"
+    echo "cannsim -> $(command -v cannsim 2>&1 || echo '<未找到>')"
+    echo "llvm-objcopy -> $(command -v llvm-objcopy 2>&1 || echo '<未找到>')"
+    echo "--- import acl ---"
+    python3 -c "import acl; print('ACL_SOC_NAME=', acl.get_soc_name())" 2>&1 || true
+    echo "--- import torch_npu（预期失败：未安装 torch_npu）---"
+    python3 -c "import torch_npu; print(torch_npu.__version__)" 2>&1 || true
+  } | tee "${RAW_DIR}/43-stage-verify.txt"
+
+  assert_boundaries "post-verify"
+}
+
+# 安装/验证是重任务：默认自动套 heavy runner 取全局 local 锁
+wrap_heavy() {
+  local target_stage="$1"
+  if [[ "${allow_bare}" == "1" ]]; then
+    log "已指定 --allow-bare，直接执行 stage=${target_stage}"
+    "stage_${target_stage}"
+    return
+  fi
+  if [[ ! -x "${heavy_runner}" ]]; then
+    log "heavy runner 不可执行: ${heavy_runner}；如需裸跑请显式加 --allow-bare" >&2
+    exit 69
+  fi
+  log "经 heavy runner 取 local 锁执行 stage=${target_stage}"
+  "${heavy_runner}" --task "${task}" --agent "${agent}" -- \
+    "$0" --stage "${target_stage}" --allow-bare \
+    --meta-root "${meta_root}" --proxy "${proxy}"
+}
+
+main() {
+  case "${stage}" in
+    preflight) stage_preflight ;;
+    shim)      stage_shim ;;
+    download)  stage_download ;;
+    user)      stage_user ;;
+    install)   wrap_heavy install ;;
+    verify)    stage_verify ;;
+    all)
+      stage_preflight; stage_shim; stage_download; stage_user
+      wrap_heavy install
+      stage_verify
+      ;;
+    *) echo "未知 stage: ${stage}" >&2; usage ;;
+  esac
+}
+
+main "$@"
