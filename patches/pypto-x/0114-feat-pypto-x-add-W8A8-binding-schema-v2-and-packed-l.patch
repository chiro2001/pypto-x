index 000000000..a41e8c053
--- /dev/null
+++ b/python/tests/ut/pypto_x/qwen35_w8a8_binding_driver.py
@@ -0,0 +1,263 @@
+"""W8A8 binding v2 / packed layout v2 metadata-only driver（R7–R9 证据）。
+
+驱动只展开 0.8B 的**符号**参数 manifest 并计算 region 计数与偏移：不打开任何
+checkpoint、不加载权重、不分配参数/state 存储。默认 150 个量化线性层按
+契约 §3.1 每个占 2 个 region，期望 region 数为 **518**。
+
+用法::
+
+    python3 qwen35_w8a8_binding_driver.py --output <path.json>
+
+生产环境的真实 0.8B graph metadata 体量较大，R8 证据通过
+``run_local_heavy.sh`` 运行本驱动；单元测试可只调用
+``build_default_w8a8_schema`` / ``collect_driver_result``（纯 metadata，轻）。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Dict, List, Mapping, Sequence, Tuple
+
+from pypto.portable.qwen35 import QWEN35_08B_SHAPE_METADATA, qwen35_decoder_exact_parameter_manifest
+from pypto.portable.qwen35_w8a8_coverage import (
+    build_qwen35_w8a8_coverage_manifest,
+    qwen35_default_quantized_linear_names,
+)
+from pypto.portable.runtime_binding import (
+    BINDING_SCHEMA_VERSION,
+    PACKED_LAYOUT_VERSION,
+    QUANT_SCALE_ROLE,
+    QUANT_SCHEME_NAME,
+    QUANT_WEIGHT_REGION_ROLE,
+    BindingEntry,
+    BindingMismatchError,
+    BindingSchema,
+    build_packed_layout,
+)
+
+_ITEMSIZE = {"bool": 1, "int8": 1, "int16": 2, "int32": 4, "int64": 8, "bf16": 2, "float32": 4}
+
+
+def _nbytes(dtype: str, shape: Sequence[int]) -> int:
+    elements = 1
+    for dimension in shape:
+        elements *= int(dimension)
+    return elements * _ITEMSIZE[dtype]
+
+
+def _quant_mapping(scale_entry: str) -> Mapping[str, Any]:
+    return {
+        "scheme": QUANT_SCHEME_NAME,
+        "signed": True,
+        "bits": 8,
+        "axis": 0,
+        "granularity": "per_output_channel",
+        "scale_dtype": "float32",
+        "zero_point": 0,
+        "scale_entry": scale_entry,
+        "group_size": None,
+    }
+
+
+def _runtime_entries(batch: int = 1, steps: int = 1, query_heads: int = 8) -> Tuple[Tuple[str, str, Tuple[int, ...]], ...]:
+    rotary_dim = int(QWEN35_08B_SHAPE_METADATA["rotary_dim"])
+    return (
+        ("input_ids", "int64", (batch, steps)),
+        ("cos", "bf16", (batch, query_heads, steps, rotary_dim)),
+        ("sin", "bf16", (batch, query_heads, steps, rotary_dim)),
+    )
+
+
+def build_default_w8a8_schema(*, past_length: int = 1, batch: int = 1, steps: int = 1) -> BindingSchema:
+    """构造默认 W8A8（150 线性层）精确 binding schema（纯 metadata）。"""
+
+    model = QWEN35_08B_SHAPE_METADATA
+    exact_entries = qwen35_decoder_exact_parameter_manifest()
+    quantized_names = set(qwen35_default_quantized_linear_names(exact_entries))
+    full_indices = set(model["full_attention_indices_zero_based"])
+    nk = int(model["linear_num_key_heads"])
+    nv = int(model["linear_num_value_heads"])
+    dk = int(model["linear_key_head_dim"])
+    dv = int(model["linear_value_head_dim"])
+    conv_channels = 2 * nk * dk + nv * dv
+    conv_kernel = int(model["linear_conv_kernel_dim"])
+    kvh = int(model["num_key_value_heads"])
+    head_dim = int(model["head_dim"])
+
+    inputs: List[BindingEntry] = []
+    ordinal = 0
+    for name, dtype, shape in _runtime_entries(batch, steps):
+        inputs.append(BindingEntry(ordinal, name, "runtime", dtype, shape, _nbytes(dtype, shape), "runtime:" + name, True))
+        ordinal += 1
+    for entry in exact_entries:
+        name = str(entry["name"])
+        shape = tuple(int(dimension) for dimension in entry["shape"])
+        if name in quantized_names:
+            scale_name = name + "_scale"
+            inputs.append(
+                BindingEntry(
+                    ordinal,
+                    name,
+                    "parameter",
+                    "int8",
+                    shape,
+                    _nbytes("int8", shape),
+                    "parameter:" + name + ".int8",
+                    True,
+                    quant=_quant_mapping(scale_name),
+                )
+            )
+            ordinal += 1
+            scale_shape = (shape[0],)
+            inputs.append(
+                BindingEntry(
+                    ordinal,
+                    scale_name,
+                    QUANT_SCALE_ROLE,
+                    "float32",
+                    scale_shape,
+                    _nbytes("float32", scale_shape),
+                    "parameter:" + name + ".scale",
+                    True,
+                )
+            )
+            ordinal += 1
+        else:
+            inputs.append(
+                BindingEntry(
+                    ordinal,
+                    name,
+                    "parameter",
+                    entry["dtype"],
+                    shape,
+                    _nbytes(entry["dtype"], shape),
+                    "parameter:" + name,
+                    True,
+                )
+            )
+            ordinal += 1
+    for index in range(int(model["num_hidden_layers"])):
+        prefix = "layer_{:02d}".format(index)
+        if index in full_indices:
+            for suffix in ("prior_k", "prior_v"):
+                name = "{}_{}".format(prefix, suffix)
+                shape = (batch, kvh, past_length, head_dim)
+                inputs.append(
+                    BindingEntry(ordinal, name, "state", "bf16", shape, _nbytes("bf16", shape), "state:" + name, True)
+                )
+                ordinal += 1
+        else:
+            name = prefix + "_conv_state_in"
+            shape = (batch, conv_channels, conv_kernel)
+            inputs.append(
+                BindingEntry(ordinal, name, "state", "bf16", shape, _nbytes("bf16", shape), "state:" + name, True)
+            )
+            ordinal += 1
+            name = prefix + "_recurrent_state_in"
+            shape = (batch, nv, dk, dv)
+            inputs.append(
+                BindingEntry(
+                    ordinal, name, "state", "float32", shape, _nbytes("float32", shape), "state:" + name, True
+                )
+            )
+            ordinal += 1
+
+    digest = hashlib.sha256(
+        json.dumps(
+            {"graph_kind": "qwen35_text_decoder_w8a8", "quantized": sorted(quantized_names), "past_length": past_length},
+            sort_keys=True,
+            separators=(",", ":"),
+        ).encode("utf-8")
+    ).hexdigest()
+    return BindingSchema(
+        function_name="qwen35_text_decoder_w8a8_metadata_only",
+        graph_digest=digest,
+        inputs=tuple(inputs),
+        outputs=(),
+        aliases={},
+    )
+
+
+def _v1_rejection_probe(schema: BindingSchema) -> Dict[str, Any]:
+    v1 = BindingSchema(
+        function_name=schema.function_name,
+        graph_digest=schema.graph_digest,
+        inputs=schema.inputs,
+        outputs=schema.outputs,
+        aliases=dict(schema.aliases),
+        schema_version=1,
+    )
+    try:
+        build_packed_layout(v1)
+    except BindingMismatchError as exc:
+        message = str(exc)
+        return {"rejected": True, "message": message, "mentions_reject_and_recompile": "reject_and_recompile" in message}
+    return {"rejected": False, "message": "", "mentions_reject_and_recompile": False}
+
+
+def collect_driver_result(*, past_length: int = 1) -> Dict[str, Any]:
+    """收集 R7–R9 的 metadata-only 证据（不写文件、不分配存储）。"""
+
+    schema = build_default_w8a8_schema(past_length=past_length)
+    layout = build_packed_layout(schema)
+    coverage = build_qwen35_w8a8_coverage_manifest(qwen35_decoder_exact_parameter_manifest())
+    quant_regions = [region for region in layout.regions if region.role == QUANT_WEIGHT_REGION_ROLE]
+    scale_regions = [region for region in layout.regions if region.role == QUANT_SCALE_ROLE]
+    parameter_regions = [region for region in layout.regions if region.role == "parameter"]
+    state_regions = [region for region in layout.regions if region.role == "state"]
+    return {
+        "status": "PASS",
+        "weights_loaded": False,
+        "buffers_allocated": False,
+        "schema_version": schema.schema_version,
+        "layout_version": layout.layout_version,
+        "expected_schema_version": BINDING_SCHEMA_VERSION,
+        "expected_layout_version": PACKED_LAYOUT_VERSION,
+        "counts": {
+            "runtime_inputs": len(schema.runtime_inputs),
+            "parameters": len(schema.parameters),
+            "quant_scales": len(schema.quant_scales),
+            "states": len(schema.states),
+            "quant_weight_regions": len(quant_regions),
+            "quant_scale_regions": len(scale_regions),
+            "parameter_regions": len(parameter_regions),
+            "state_regions": len(state_regions),
+            "packed_region_count": len(layout.regions),
+        },
+        "packed_region_count_expected": 518,
+        "packed_region_count_formula": "368 - 150 + 150*2",
+        "packed_region_count_matches": len(layout.regions) == 518,
+        "packed_total_nbytes": layout.total_nbytes,
+        "packed_alignment": layout.alignment,
+        "quant_weight_region_example": (
+            quant_regions[0].to_dict() if quant_regions else None
+        ),
+        "quant_scale_region_example": (scale_regions[0].to_dict() if scale_regions else None),
+        "v1_rejection": _v1_rejection_probe(schema),
+        "coverage_manifest": coverage.to_dict(),
+        "coverage_manifest_summary": {
+            "w8a8_linear_coverage": coverage.w8a8_linear_coverage,
+            "whole_net_int8_compute_ratio": coverage.whole_net_int8_compute_ratio,
+            "quantized_linear_tensor_count": coverage.quantized_linear_tensor_count,
+            "total_linear_tensor_count": coverage.total_linear_tensor_count,
+        },
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--past-length", type=int, default=1)
+    args = parser.parse_args()
+    result = collect_driver_result(past_length=args.past_length)
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
