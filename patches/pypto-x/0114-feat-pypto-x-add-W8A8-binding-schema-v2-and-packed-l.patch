+def test_r9_coverage_manifest_fields_exist_and_are_nonzero():
+    exact_entries = qwen35_decoder_exact_parameter_manifest()
+    linear = qwen35_linear_parameter_names(exact_entries)
+    quantized = qwen35_default_quantized_linear_names(exact_entries)
+    assert len(linear) == 186
+    assert len(quantized) == 150
+    manifest = build_qwen35_w8a8_coverage_manifest(exact_entries)
+    payload = manifest.to_dict()
+    assert QUANTIZED_LINEAR_COVERAGE_FIELD in payload
+    assert WHOLE_NET_INT8_COMPUTE_RATIO_FIELD in payload
+    assert payload[QUANTIZED_LINEAR_COVERAGE_FIELD] > 0.0
+    assert payload[WHOLE_NET_INT8_COMPUTE_RATIO_FIELD] > 0.0
+    assert payload[QUANTIZED_LINEAR_COVERAGE_FIELD] <= 1.0
+    assert payload[WHOLE_NET_INT8_COMPUTE_RATIO_FIELD] < 1.0
+    assert manifest.quantized_linear_tensor_count == 150
+    assert manifest.total_linear_tensor_count == 186
+    assert manifest.int8_macs_per_forward > 0
+    assert manifest.total_macs_per_forward > manifest.int8_macs_per_forward
+    assert "in_proj_b" in " ".join(manifest.bf16_island_names)
+    manifest.assert_nonzero()
+    # 字段必须真实来自 manifest 断言（默认 150/186 与参数量加权）。
+    assert payload[QUANTIZED_LINEAR_COVERAGE_FIELD] == pytest.approx(
+        manifest.quantized_linear_parameter_elements / manifest.total_linear_parameter_elements
+    )
+    assert manifest.w8a8_linear_tensor_coverage == pytest.approx(150 / 186)
