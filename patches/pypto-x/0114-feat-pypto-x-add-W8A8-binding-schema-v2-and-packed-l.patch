diff --git a/python/pypto/portable/qwen35_w8a8_coverage.py b/python/pypto/portable/qwen35_w8a8_coverage.py
new file mode 100644
index 000000000..d5b67628d
--- /dev/null
+++ b/python/pypto/portable/qwen35_w8a8_coverage.py
@@ -0,0 +1,312 @@
+"""Qwen3.5-0.8B W8A8 覆盖率 manifest（契约 §2.4 / §3.5 / §5.3，验收 R9）。
+
+本模块只做目标无关的 metadata 计算，不加载权重、不分配存储、不执行 kernel：
+
+* ``w8a8_linear_coverage`` = 已量化线性层参数量 / 全部线性层参数量；
+* ``whole_net_int8_compute_ratio`` = INT8 MAC / 总 MAC，分母包含未量化
+  线性层、attention QK/PV、conv1d 与 GDR 递推的浮点 matmul。
+
+``whole_net_int8_compute_ratio`` 依赖运行点（prefill 步数、cache 长度），
+因此 manifest 显式记录 ``compute_operating_point`` 与 ``measurement``。
+默认值是单 token、cache=1 的静态 shape 模型估算，最终整网报告必须用运行时
+实测值覆盖（契约 §5.4：不预设性能/收益数字）。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Dict, Iterable, Mapping, Optional, Sequence, Tuple
+
+from pypto.portable.qwen35 import QWEN35_08B_SHAPE_METADATA
+
+
+QUANTIZED_LINEAR_COVERAGE_FIELD = "w8a8_linear_coverage"
+WHOLE_NET_INT8_COMPUTE_RATIO_FIELD = "whole_net_int8_compute_ratio"
+
+# 186 个线性权重（契约 §1.5 表）按名字后缀分类；lm_head 与 embedding 共享
+# storage，默认不量化，因此不在 186 内。
+QWEN35_LINEAR_WEIGHT_SUFFIXES = (
+    "_mlp_gate_proj_weight",
+    "_mlp_up_proj_weight",
+    "_mlp_down_proj_weight",
+    "_q_proj_weight",
+    "_k_proj_weight",
+    "_v_proj_weight",
+    "_o_proj_weight",
+    "_in_proj_qkv_weight",
+    "_in_proj_z_weight",
+    "_in_proj_b_weight",
+    "_in_proj_a_weight",
+    "_out_proj_weight",
+)
+# 默认保持 BF16 的小通道线性层（契约 §1.3 / §8-D1）。条件开启后覆盖率为 186/186。
+QWEN35_DEFAULT_BF16_LINEAR_SUFFIXES = ("_in_proj_b_weight", "_in_proj_a_weight")
+
+DEFAULT_QWEN35_COMPUTE_OPERATING_POINT = {
+    "batch": 1,
+    "prefill_steps": 1,
+    "past_length": 1,
+    "note": "static decode-step shape model; runtime measurement overrides",
+}
+
+
+class W8A8CoverageError(ValueError):
+    """覆盖率 manifest 输入或计算结果违反契约。"""
+
+
+def _entry_name(entry: Mapping[str, Any]) -> str:
+    name = entry.get("name")
+    if not isinstance(name, str) or not name:
+        raise W8A8CoverageError("parameter manifest entry has no stable name")
+    return name
+
+
+def _entry_elements(entry: Mapping[str, Any]) -> int:
+    value = entry.get("elements_per_tensor")
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise W8A8CoverageError("parameter manifest entry {!r} has invalid elements_per_tensor".format(_entry_name(entry)))
+    count = entry.get("count", 1)
+    if isinstance(count, bool) or not isinstance(count, int) or count <= 0:
+        raise W8A8CoverageError("parameter manifest entry {!r} has invalid count".format(_entry_name(entry)))
+    return value * count
+
+
+def qwen35_linear_parameter_names(exact_entries: Sequence[Mapping[str, Any]]) -> Tuple[str, ...]:
+    """从 320 条精确参数条目中筛出 186 个线性权重名（契约 §1.5）。"""
+
+    return tuple(
+        _entry_name(entry)
+        for entry in exact_entries
+        if _entry_name(entry).endswith(QWEN35_LINEAR_WEIGHT_SUFFIXES)
+    )
+
+
+def qwen35_default_quantized_linear_names(exact_entries: Sequence[Mapping[str, Any]]) -> Tuple[str, ...]:
+    """默认 W8A8 量化集合：186 个线性层中排除 in_proj_b / in_proj_a（150 个）。"""
+
+    return tuple(
+        name
+        for name in qwen35_linear_parameter_names(exact_entries)
+        if not name.endswith(QWEN35_DEFAULT_BF16_LINEAR_SUFFIXES)
+    )
+
+
+def _shape(entry: Mapping[str, Any]) -> Tuple[int, ...]:
+    value = entry.get("shape")
+    if isinstance(value, (str, bytes)):
+        raise W8A8CoverageError("parameter manifest entry {!r} has invalid shape".format(_entry_name(entry)))
+    try:
+        shape = tuple(value)
+    except TypeError as exc:
+        raise W8A8CoverageError("parameter manifest entry {!r} has invalid shape".format(_entry_name(entry))) from exc
+    for dimension in shape:
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise W8A8CoverageError("parameter manifest entry {!r} has invalid shape".format(_entry_name(entry)))
+    return shape
+
+
+def _mac_counts(
+    exact_entries: Sequence[Mapping[str, Any]],
+    quantized_names: Sequence[str],
+    operating_point: Mapping[str, int],
+) -> Dict[str, int]:
+    """静态 shape MAC 模型（MAC 数，不含 elementwise/norm/softmax）。
+
+    每层公式（单 forward，batch=B，本步 token=T，cache 长度=P）：
+
+    * 线性投影：``T * out * in``；
+    * full attention QKᵀ/PV：``2 * qh * head_dim * (P + T) * T``（非因果上界；
+      decode T=1 时即 ``2*qh*head_dim*(P+1)``）；
+    * GDR conv1d（depthwise causal）：``T * conv_channels * kernel``；
+    * GDR 递推：``T * (nv*nk*dk + nv*nk*dv + 2*nv*dk*dv)``
+      （q·k 打分 + 加权 v + 状态收缩 + outer product）。
+    """
+
+    entries_by_name = {_entry_name(entry): entry for entry in exact_entries}
+    quantized = set(quantized_names)
+    unknown = quantized - set(entries_by_name)
+    if unknown:
+        raise W8A8CoverageError("quantized names are absent from the parameter manifest: {}".format(tuple(sorted(unknown))))
+    linear_names = set(qwen35_linear_parameter_names(exact_entries))
+    if not quantized <= linear_names:
+        raise W8A8CoverageError("quantized names must be a subset of the 186 linear weights")
+    batch = int(operating_point["batch"])
+    steps = int(operating_point["prefill_steps"])
+    past = int(operating_point["past_length"])
+    for field, value in (("batch", batch), ("prefill_steps", steps), ("past_length", past)):
+        if value <= 0:
+            raise W8A8CoverageError("operating point {} must be positive".format(field))
+
+    model = QWEN35_08B_SHAPE_METADATA
+    full_layers = len(model["full_attention_indices_zero_based"])
+    gdr_layers = int(model["num_hidden_layers"]) - full_layers
+    hidden = int(model["hidden_size"])
+    qh = int(model["num_attention_heads"])
+    head_dim = int(model["head_dim"])
+    nk = int(model["linear_num_key_heads"])
+    nv = int(model["linear_num_value_heads"])
+    dk = int(model["linear_key_head_dim"])
+    dv = int(model["linear_value_head_dim"])
+    conv_channels = 2 * nk * dk + nv * dv
+    conv_kernel = int(model["linear_conv_kernel_dim"])
+
+    int8_macs = 0
+    bf16_linear_macs = 0
+    for name, entry in entries_by_name.items():
+        if name not in linear_names:
+            continue
+        shape = _shape(entry)
+        if len(shape) != 2:
+            raise W8A8CoverageError("linear weight {!r} must be rank 2".format(name))
+        macs = steps * shape[0] * shape[1]
+        if name in quantized:
+            int8_macs += macs
+        else:
+            bf16_linear_macs += macs
+
+    kv_length = past + steps
+    attention_macs = full_layers * batch * 2 * qh * head_dim * kv_length * steps
+    conv_macs = gdr_layers * batch * steps * conv_channels * conv_kernel
+    recurrent_macs = gdr_layers * batch * steps * (nv * nk * dk + nv * nk * dv + 2 * nv * dk * dv)
+    float_macs = bf16_linear_macs + attention_macs + conv_macs + recurrent_macs
+    return {
+        "int8_macs": int8_macs,
+        "bf16_linear_macs": bf16_linear_macs,
+        "attention_macs": attention_macs,
+        "conv1d_macs": conv_macs,
+        "gdr_recurrent_macs": recurrent_macs,
+        "float_macs": float_macs,
+        "total_macs": int8_macs + float_macs,
+        # 保持对 shape metadata 的显式引用，便于审计公式输入。
+        "hidden_size": hidden,
+    }
+
+
+@dataclass(frozen=True)
+class W8A8CoverageManifest:
+    """契约 §2.4 / §5.3 要求的覆盖率报告字段（R9 断言对象）。"""
+
+    w8a8_linear_coverage: float
+    whole_net_int8_compute_ratio: float
+    quantized_linear_tensor_count: int
+    total_linear_tensor_count: int
+    quantized_linear_parameter_elements: int
+    total_linear_parameter_elements: int
+    w8a8_linear_tensor_coverage: float
+    int8_macs_per_forward: int
+    total_macs_per_forward: int
+    mac_breakdown: Mapping[str, int]
+    compute_operating_point: Mapping[str, Any]
+    measurement: str
+    quantized_parameter_names: Tuple[str, ...]
+    bf16_island_names: Tuple[str, ...]
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            QUANTIZED_LINEAR_COVERAGE_FIELD: self.w8a8_linear_coverage,
+            WHOLE_NET_INT8_COMPUTE_RATIO_FIELD: self.whole_net_int8_compute_ratio,
+            "w8a8_linear_tensor_coverage": self.w8a8_linear_tensor_coverage,
+            "quantized_linear_tensor_count": self.quantized_linear_tensor_count,
+            "total_linear_tensor_count": self.total_linear_tensor_count,
+            "quantized_linear_parameter_elements": self.quantized_linear_parameter_elements,
+            "total_linear_parameter_elements": self.total_linear_parameter_elements,
+            "int8_macs_per_forward": self.int8_macs_per_forward,
+            "total_macs_per_forward": self.total_macs_per_forward,
+            "mac_breakdown": dict(self.mac_breakdown),
+            "compute_operating_point": dict(self.compute_operating_point),
+            "measurement": self.measurement,
+            "quantized_parameter_names": list(self.quantized_parameter_names),
+            "bf16_island_names": list(self.bf16_island_names),
+        }
+
+    def assert_nonzero(self) -> None:
+        """R9：两个必填字段必须存在且非零。"""
+
+        if not 0.0 < self.w8a8_linear_coverage <= 1.0:
+            raise W8A8CoverageError(
+                "{} must be in (0, 1]; got {!r}".format(
+                    QUANTIZED_LINEAR_COVERAGE_FIELD, self.w8a8_linear_coverage
+                )
+            )
+        if not 0.0 < self.whole_net_int8_compute_ratio <= 1.0:
+            raise W8A8CoverageError(
+                "{} must be in (0, 1]; got {!r}".format(
+                    WHOLE_NET_INT8_COMPUTE_RATIO_FIELD, self.whole_net_int8_compute_ratio
+                )
+            )
+
+
+def build_qwen35_w8a8_coverage_manifest(
+    exact_parameter_entries: Sequence[Mapping[str, Any]],
+    *,
+    quantized_names: Optional[Iterable[str]] = None,
+    operating_point: Optional[Mapping[str, Any]] = None,
+) -> W8A8CoverageManifest:
+    """从精确参数 manifest 构造覆盖率 manifest（默认 150/186 量化集合）。"""
+
+    entries = tuple(exact_parameter_entries)
+    default_quantized = qwen35_default_quantized_linear_names(entries)
+    if quantized_names is None:
+        quantized = default_quantized
+    else:
+        quantized = tuple(quantized_names)
+        if len(set(quantized)) != len(quantized):
+            raise W8A8CoverageError("quantized_names contains duplicates")
+    linear_names = qwen35_linear_parameter_names(entries)
+    if len(linear_names) != 186:
+        raise W8A8CoverageError(
+            "Qwen3.5 exact manifest must contain 186 linear weights; got {}".format(len(linear_names))
+        )
+    entries_by_name = {_entry_name(entry): entry for entry in entries}
+    total_elements = sum(_entry_elements(entries_by_name[name]) for name in linear_names)
+    quantized_elements = sum(_entry_elements(entries_by_name[name]) for name in quantized)
+    if total_elements <= 0 or quantized_elements <= 0:
+        raise W8A8CoverageError("linear parameter element totals must be positive")
+    coverage = quantized_elements / total_elements
+    tensor_coverage = len(quantized) / len(linear_names)
+
+    default_point = dict(DEFAULT_QWEN35_COMPUTE_OPERATING_POINT)
+    if operating_point is not None:
+        for key in ("batch", "prefill_steps", "past_length"):
+            if key in operating_point:
+                value = operating_point[key]
+                if isinstance(value, bool) or not isinstance(value, int):
+                    raise W8A8CoverageError("operating point {} must be an integer".format(key))
+                default_point[key] = value
+        default_point["note"] = str(operating_point.get("note", default_point["note"]))
+    macs = _mac_counts(entries, quantized, default_point)
+    ratio = macs["int8_macs"] / macs["total_macs"]
+
+    island_names = tuple(sorted(set(entries_by_name) - set(quantized)))
+    manifest = W8A8CoverageManifest(
+        w8a8_linear_coverage=coverage,
+        whole_net_int8_compute_ratio=ratio,
+        quantized_linear_tensor_count=len(quantized),
+        total_linear_tensor_count=len(linear_names),
+        quantized_linear_parameter_elements=quantized_elements,
+        total_linear_parameter_elements=total_elements,
+        w8a8_linear_tensor_coverage=tensor_coverage,
+        int8_macs_per_forward=macs["int8_macs"],
+        total_macs_per_forward=macs["total_macs"],
+        mac_breakdown=macs,
+        compute_operating_point=default_point,
+        measurement="static_shape_model",
+        quantized_parameter_names=tuple(quantized),
+        bf16_island_names=island_names,
+    )
+    manifest.assert_nonzero()
+    return manifest
+
+
+__all__ = [
+    "DEFAULT_QWEN35_COMPUTE_OPERATING_POINT",
+    "QWEN35_DEFAULT_BF16_LINEAR_SUFFIXES",
