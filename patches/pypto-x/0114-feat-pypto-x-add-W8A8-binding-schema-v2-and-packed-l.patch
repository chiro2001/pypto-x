diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
index 5a8a96347..c4f651b76 100644
--- a/python/pypto/portable/qwen35.py
+++ b/python/pypto/portable/qwen35.py
@@ -525,6 +525,79 @@ def _decoder_parameter_manifest(profile: Mapping[str, int], dtype: str) -> Tuple
     )
 
 
+def expand_decoder_parameter_manifest(
+    compact_manifest: Sequence[Mapping[str, Any]],
+    full_attention_indices: Sequence[int],
+    num_hidden_layers: int,
+) -> Tuple[Mapping[str, Any], ...]:
+    """把 compact per-storage manifest 展开成 320 条逐层精确参数条目。
+
+    展开规则与 ``runtime_binding._expected_qwen_parameter_manifest`` 的三方校验
+    完全一致（tied embedding 是单条；``layers.full_attention.*`` 与
+    ``layers.linear_attention.*`` 按 6/18 层路由；``layers.*`` 覆盖 24 层）。
+    返回条目带 ``elements_per_tensor``/``count=1``，可直接用于覆盖率统计。
+    """
+
+    full_indices = tuple(int(index) for index in full_attention_indices)
+    all_indices = tuple(range(int(num_hidden_layers)))
+    full_index_set = set(full_indices)
+    entries: List[Mapping[str, Any]] = []
+    for compact in compact_manifest:
+        pattern = compact.get("name")
+        if not isinstance(pattern, str) or not pattern:
+            raise ValueError("compact decoder manifest entry has no name")
+        if pattern == "embedding_lm_head_shared_weight":
+            names = (pattern,)
+        elif pattern == "final_norm.weight":
+            names = ("final_norm_weight",)
+        elif pattern.startswith("layers.full_attention.*."):
+            suffix = pattern.split("*.", 1)[1].replace(".", "_")
+            names = tuple("layer_{:02d}_{}".format(index, suffix) for index in full_indices)
+        elif pattern.startswith("layers.linear_attention.*."):
+            suffix = pattern.split("*.", 1)[1].replace(".", "_")
+            names = tuple("layer_{:02d}_{}".format(index, suffix) for index in all_indices if index not in full_index_set)
+        elif pattern.startswith("layers.*."):
+            suffix = pattern.split("*.", 1)[1].replace(".", "_")
+            names = tuple("layer_{:02d}_{}".format(index, suffix) for index in all_indices)
+        else:
+            raise ValueError("compact decoder manifest has an unknown name {!r}".format(pattern))
+        if len(names) != compact.get("count"):
+            raise ValueError("compact decoder manifest count is inconsistent for {!r}".format(pattern))
+        elements_per_tensor = int(compact["elements_per_tensor"])
+        for name in names:
+            entries.append(
+                {
+                    "name": name,
+                    "storage_id": pattern,
+                    "shape": tuple(compact["shape"]),
+                    "dtype": compact["dtype"],
+                    "count": 1,
+                    "elements_per_tensor": elements_per_tensor,
+                    "aliases": tuple(compact.get("aliases", ())),
+                }
+            )
+    if len({entry["name"] for entry in entries}) != len(entries):
+        raise ValueError("compact decoder manifest expands duplicate exact parameter names")
+    return tuple(entries)
+
+
+def qwen35_decoder_exact_parameter_manifest(
+    shape_profile: str = "model",
+    *,
+    query_heads: int = 8,
+    dtype: str = "bf16",
+) -> Tuple[Mapping[str, Any], ...]:
+    """返回 320 条逐层参数条目（name/shape/dtype），不包含任何权重字节。"""
+
+    dtype = _dtype(dtype, "dtype")
+    profile_values = _decoder_shape_profile(shape_profile, query_heads)
+    return expand_decoder_parameter_manifest(
+        _decoder_parameter_manifest(profile_values, dtype),
+        QWEN35_08B_SHAPE_METADATA["full_attention_indices_zero_based"],
+        QWEN35_08B_SHAPE_METADATA["num_hidden_layers"],
+    )
+
+
 def _manifest_bytes(entries: Sequence[Mapping[str, Any]]) -> Tuple[int, int]:
     total_elements = 0
     total_bytes = 0
