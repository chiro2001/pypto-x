+def test_r8_quantized_packed_layout_expands_to_two_regions():
+    schema = _quant_schema()
+    layout = build_packed_layout(schema)
+    assert layout.layout_version == PACKED_LAYOUT_VERSION == 2
+    assert [region.role for region in layout.regions] == [QUANT_WEIGHT_REGION_ROLE, QUANT_SCALE_ROLE]
+    weight_region, scale_region = layout.regions
+    assert weight_region.storage_id == "parameter:layer_weight.int8"
+    assert weight_region.dtype == "int8"
+    assert weight_region.shape == (2, 3)
+    assert weight_region.nbytes == 6
+    assert scale_region.storage_id == "parameter:layer_weight.scale"
+    assert scale_region.dtype == "float32"
+    assert scale_region.shape == (2,)
+    assert scale_region.nbytes == 8
+    assert weight_region.offset == 0
+    assert scale_region.offset == 64
+    assert weight_region.alignment == scale_region.alignment == 64
+    assert layout.region_for("layer_weight") is weight_region
+    assert layout.region_for("demo.weight.qweight") is weight_region
+    assert layout.region_for("layer_weight_scale") is scale_region
+    assert layout.region_for("demo.weight.scales") is scale_region
+    assert layout.total_nbytes == 64 + 8
+    # metadata-only 绑定：只切片已有 buffer，不分配、不拷贝。
+    packed = bytearray(layout.total_nbytes)
+    binding = bind_packed_region(layout, "layer_weight", packed)
+    assert binding.storage_id == "parameter:layer_weight.int8"
+    assert binding.dtype == "int8"
+    assert binding.byte_offset == 0
+    assert binding.nbytes == 6
+    assert binding.readonly is True
+    scale_binding = bind_packed_region(layout, "layer_weight_scale", packed)
+    assert scale_binding.readonly is True
+    assert scale_binding.byte_offset == 64
+
