+def test_r7_quantized_descriptor_assembly_is_zero_copy():
+    from pypto.portable.runtime_binding import BufferBinding, ordered_input_descriptors
+
+    schema = _quant_schema()
+    layout = build_packed_layout(schema)
+    packed = bytearray(layout.total_nbytes)
+    runtime = {
+        entry.name: BufferBinding.from_buffer(
+            bytearray(entry.nbytes), entry.storage_id, entry.dtype, entry.shape, readonly=True
+        )
+        for entry in schema.runtime_inputs
+    }
+    parameters = {
+        entry.name: bind_packed_region(layout, entry.name, packed)
+        for entry in schema.parameters + schema.quant_scales
+    }
+    descriptors = ordered_input_descriptors(schema, runtime, parameters, {})
+    assert [descriptor.dtype for descriptor in descriptors] == ["int8", "int8", "float32"]
+    assert descriptors[1].handle is not None
+
