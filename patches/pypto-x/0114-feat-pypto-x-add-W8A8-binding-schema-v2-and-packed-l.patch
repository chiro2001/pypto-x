+"""W8A8 binding schema v2 / packed layout v2 / coverage manifest 测试（R7–R9）。
+
+精确命令：
+
+``PYTHONPATH=python python3 -m pytest -q --confcutdir=python/tests/ut/pypto_x python/tests/ut/pypto_x/test_w8a8_binding.py``
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph, qwen35_decoder_exact_parameter_manifest
+from pypto.portable.runtime_binding import (
+    BINDING_SCHEMA_VERSION,
+    PACKED_LAYOUT_VERSION,
+    QUANT_SCALE_ROLE,
+    QUANT_WEIGHT_REGION_ROLE,
+    BindingMismatchError,
+    BindingSchema,
+    bind_packed_region,
+    build_binding_schema,
+    build_packed_layout,
+)
+from pypto.portable.qwen35_w8a8_coverage import (
+    QUANTIZED_LINEAR_COVERAGE_FIELD,
+    WHOLE_NET_INT8_COMPUTE_RATIO_FIELD,
+    build_qwen35_w8a8_coverage_manifest,
+    qwen35_default_quantized_linear_names,
+    qwen35_linear_parameter_names,
+)
+
+
+DRIVER_PATH = Path(__file__).with_name("qwen35_w8a8_binding_driver.py")
+
+
+def _load_driver():
+    spec = importlib.util.spec_from_file_location("qwen35_w8a8_binding_driver", DRIVER_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+driver = _load_driver()
+
+
+def _quant_program(*, weight_dtype="int8", granularity="per_output_channel", scale_shape=(2,), scale_entry="layer_weight_scale"):
+    activation = ValueRef("activation", CoreType.tensor("int8", (2, 3)))
+    weight = ValueRef("layer_weight", CoreType.tensor(weight_dtype, (2, 3)))
+    scale = ValueRef("layer_weight_scale", CoreType.tensor("float32", tuple(scale_shape)))
+    output = ValueRef("qmatmul_out", CoreType.tensor("int32", (2, 2)))
+    body = Region((Operation("qmatmul_s8s8_s32", inputs=(activation, weight), outputs=(output,)),))
+    function = CoreFunction(
+        "qmatmul_demo",
+        parameters=(activation, weight, scale),
+        returns=(output,),
+        body=body,
+    )
+    metadata = {
+        "runtime_inputs": [{"name": "activation", "shape": [2, 3], "dtype": "int8"}],
+        "state_input_names": [],
+        "parameter_function_inputs": ["layer_weight", "layer_weight_scale"],
+        "quantized_parameters": [
+            {
+                "name": "layer_weight",
+                "scale_entry": scale_entry,
+                "granularity": granularity,
+                "group_size": 64 if granularity == "per_group" else None,
+                "aliases": ["demo.weight"],
+            }
+        ],
+    }
+    return CoreProgram(functions=(function,), metadata=metadata)
+
+
+def _quant_schema():
+    return build_binding_schema(_quant_program())
+
+
+# ------------------------------------------------------------------ R7
+
+
+def test_r7_quantized_schema_has_weight_scale_and_aliases():
+    schema = _quant_schema()
+    assert schema.schema_version == BINDING_SCHEMA_VERSION == 2
+    assert len(schema.parameters) == 1
+    assert len(schema.quant_scales) == 1
+    weight = schema.entry_for("layer_weight")
+    scale = schema.entry_for("layer_weight_scale")
+    assert weight.dtype == "int8"
+    assert weight.shape == (2, 3)
+    assert weight.storage_id == "parameter:layer_weight.int8"
+    assert dict(weight.quant) == {
+        "scheme": "w8a8_linear",
+        "signed": True,
+        "bits": 8,
+        "axis": 0,
+        "granularity": "per_output_channel",
+        "scale_dtype": "float32",
+        "zero_point": 0,
+        "scale_entry": "layer_weight_scale",
+        "group_size": None,
+    }
+    assert scale.role == QUANT_SCALE_ROLE
+    assert scale.dtype == "float32"
+    assert scale.shape == (2,)
+    assert scale.storage_id == "parameter:layer_weight.scale"
+    assert schema.entry_for("demo.weight.qweight") is weight
+    assert schema.entry_for("demo.weight.scales") is scale
+    # to_dict/from_dict 往返（含 quant）。
+    assert BindingSchema.from_dict(schema.to_dict()) == schema
+    assert BindingSchema.from_dict(schema.to_dict()).canonical_json() == schema.canonical_json()
+
+
+def test_r7_dangling_scale_entry_is_rejected():
+    payload = _quant_schema().to_dict()
+    # 篡改 1：scale 条目被改名，权重的 scale_entry 成为悬空引用。
+    payload["inputs"][2]["name"] = "ghost_scale"
+    with pytest.raises(BindingMismatchError):
+        BindingSchema.from_dict(payload)
+    payload = _quant_schema().to_dict()
+    # 篡改 2：scale_entry 指向不存在的条目。
+    payload["inputs"][1]["quant"]["scale_entry"] = "ghost_scale"
+    with pytest.raises(BindingMismatchError):
+        BindingSchema.from_dict(payload)
+    # 篡改 3：quant 增加未知键（物理 packing 不得进入公共 schema）。
+    payload = _quant_schema().to_dict()
+    payload["inputs"][1]["quant"]["physical_packing"] = "vnni"
+    with pytest.raises(BindingMismatchError):
+        BindingSchema.from_dict(payload)
+    # 篡改 4：scale 条目被删除。
+    payload = _quant_schema().to_dict()
+    payload["inputs"] = [payload["inputs"][0], payload["inputs"][1]]
+    with pytest.raises(BindingMismatchError):
+        BindingSchema.from_dict(payload)
+
+
+def test_r7_unreferenced_scale_and_wrong_shape_are_rejected():
+    payload = _quant_schema().to_dict()
+    payload["inputs"][1]["quant"]["scale_entry"] = "layer_weight_scale"
+    payload["inputs"].append(
+        {
+            "ordinal": 3,
+            "name": "extra_scale",
+            "role": QUANT_SCALE_ROLE,
+            "dtype": "float32",
+            "shape": [2],
+            "nbytes": 8,
+            "storage_id": "parameter:extra.scale",
+            "readonly": True,
+        }
+    )
+    with pytest.raises(BindingMismatchError):
+        BindingSchema.from_dict(payload)
+    with pytest.raises(BindingMismatchError):
+        build_binding_schema(_quant_program(scale_shape=(3,)))
+
+
+def test_r7_quant_weight_dtype_and_per_group_fail_closed():
+    with pytest.raises(BindingMismatchError):
+        build_binding_schema(_quant_program(weight_dtype="bf16"))
+    with pytest.raises(BindingMismatchError):
+        build_binding_schema(_quant_program(granularity="per_group"))
+    with pytest.raises(BindingMismatchError):
+        payload = _quant_schema().to_dict()
+        payload["inputs"][0]["quantified"] = True
+        BindingSchema.from_dict(payload)
+
