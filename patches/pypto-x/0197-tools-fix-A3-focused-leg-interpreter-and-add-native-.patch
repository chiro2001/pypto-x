diff --git a/tools/sve256_liveness_evidence/run_native_suites.sh b/tools/sve256_liveness_evidence/run_native_suites.sh
new file mode 100755
index 000000000..033101179
--- /dev/null
+++ b/tools/sve256_liveness_evidence/run_native_suites.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# sve256-liveness-release: native focused-leg rerun (same three suites as the
+# local QEMU leg), using the window venv interpreter.  Runs ON a3-21.
+#
+# The first window attempt used the shared c8 env python, which has no pytest;
+# this script is the recorded fix (venv with system-site-packages + pytest).
+set -u
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PY="${ROOT}/venv/bin/python"
+TESTS="${ROOT}/src/python/tests/ut/pypto_x"
+CPUS=320,322,324,326,328,330,332,334
+LOGS="${ROOT}/logs"
+mkdir -p "${LOGS}"
+
+export PYTHONPATH="${ROOT}/src/python"
+export PYPTO_X_PORTABLE_ONLY=1
+export PYPTO_X_SVE_TEST_MODE=native
+export TMPDIR="${ROOT}/tmp"
+export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8
+export OMP_PROC_BIND=close OMP_PLACES=cores
+
+run_suite() {
+  local name="$1"; shift
+  local log="${LOGS}/native_${name}.log"
+  echo "[suite] ${name} start=$(date -u '+%Y-%m-%dT%H:%M:%SZ') py=${PY}"
+  timeout 1800 taskset -c "${CPUS}" "${PY}" -m pytest -q -p no:cacheprovider \
+    --confcutdir="${TESTS}" "$@" > "${log}" 2>&1
+  local rc=$?
+  echo "[suite] ${name} exit=${rc}"
+  tail -3 "${log}"
+  return 0
+}
+
+run_suite w8a8 "${TESTS}/test_w8a8_sve256.py"
+run_suite layout "${TESTS}/test_cpu_sve256_layout.py"
+run_suite indexing "${TESTS}/test_cpu_sve256_indexing.py"
+echo "[native-suites] done $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
