diff --git a/python/tests/ut/pypto_x/test_cpu_byte_buffer_ingestion.py b/python/tests/ut/pypto_x/test_cpu_byte_buffer_ingestion.py
new file mode 100644
index 000000000..9d3712701
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_cpu_byte_buffer_ingestion.py
@@ -0,0 +1,353 @@
+"""M1K CPU external byte-buffer ingestion tests.
+
+The tests intentionally use tiny tensors.  They validate the typed-byte seam,
+not model loading or a Qwen-sized allocation.
+"""
+
+from __future__ import annotations
+
+import mmap
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import types
+
+import pytest
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        from pypto.abi import LaunchRequest, TensorDesc
+        from pypto.backends.cpu import CpuScalarExecutionError, CpuScalarRuntime, HostTensor
+        from pypto.backends.cpu.aarch64 import CpuSve256ExecutionError, Sve256Runtime
+        from pypto.backends.cpu.byte_view import CpuByteViewError, TypedByteView
+        from pypto.backends.cpu.x86 import (
+            Avx2Runtime,
+            Avx512Runtime,
+            CpuAvx2ExecutionError,
+            CpuAvx512ExecutionError,
+        )
+        from pypto.portable import BufferBinding
+        from pypto.compiler import CompileOptions
+        from pypto.compiler.targets.cpu import CpuScalarCompiler
+        from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+        from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+        from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+        from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+        from pypto.target import TargetSpec
+        return locals()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+
+
+_C = _imports()
+LaunchRequest = _C["LaunchRequest"]
+TensorDesc = _C["TensorDesc"]
+CpuScalarExecutionError = _C["CpuScalarExecutionError"]
+CpuScalarRuntime = _C["CpuScalarRuntime"]
+CpuSve256ExecutionError = _C["CpuSve256ExecutionError"]
+Sve256Runtime = _C["Sve256Runtime"]
+CpuByteViewError = _C["CpuByteViewError"]
+TypedByteView = _C["TypedByteView"]
+Avx2Runtime = _C["Avx2Runtime"]
+Avx512Runtime = _C["Avx512Runtime"]
+CpuAvx2ExecutionError = _C["CpuAvx2ExecutionError"]
+CpuAvx512ExecutionError = _C["CpuAvx512ExecutionError"]
+BufferBinding = _C["BufferBinding"]
+CompileOptions = _C["CompileOptions"]
+CpuScalarCompiler = _C["CpuScalarCompiler"]
+Avx2Compiler = _C["Avx2Compiler"]
+Avx512Compiler = _C["Avx512Compiler"]
+Sve256Compiler = _C["Sve256Compiler"]
+CoreFunction = _C["CoreFunction"]
+CoreProgram = _C["CoreProgram"]
+CoreType = _C["CoreType"]
+Operation = _C["Operation"]
+Region = _C["Region"]
+ValueRef = _C["ValueRef"]
+TargetSpec = _C["TargetSpec"]
+
+
+def _program(name, parameters, returns, operations):
+    return CoreProgram(functions=(CoreFunction(name, parameters, returns, Region(tuple(operations))),))
+
+
+def _elementwise(dtype="float32", shape=(2,), operation="add"):
+    value_type = CoreType.tensor(dtype, shape)
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    inputs = (left,) if operation == "neg" else (left, right)
+    return _program(operation, inputs, (output,), (Operation(operation, inputs, (output,)),))
+
+
+def _scalar_artifact(program):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+
+
+def _avx2_artifact(program, tmp_path):
+    compiler = Avx2Compiler()
+    target = TargetSpec("cpu", "x86_64-linux-gnu", features=("avx2",), attributes={"lane_count": 8})
+    target_ir = compiler.lower(program, target)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(artifact_format="pypto-x.cpu.avx2", extra={"build_dir": str(tmp_path / "avx2")}),
+    )
+
+
+def _avx512_artifact(program, tmp_path):
+    compiler = Avx512Compiler()
+    target = TargetSpec("cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16})
+    target_ir = compiler.lower(program, target)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(artifact_format="pypto-x.cpu.avx512", extra={"build_dir": str(tmp_path / "avx512")}),
+    )
+
+
+def _sve_artifact(program, tmp_path):
+    compiler = Sve256Compiler()
+    target = TargetSpec(
+        "cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32}
+    )
+    target_ir = compiler.lower(program, target)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(artifact_format="pypto-x.cpu.sve256", extra={"build_dir": str(tmp_path / "sve")}),
+    )
+
+
+def _request(artifact, input_descriptors, output_descriptor):
+    return LaunchRequest(artifact, inputs=input_descriptors, outputs=[output_descriptor])
+
+
+def _bf16_bits(value):
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return (bits >> 16) & 0xFFFF
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def test_typed_byte_view_exactness_endianness_and_lifetime():
+    payload = struct.pack("<2H", 0x3F80, 0x4000)
+    view = TypedByteView(payload, "bf16", (2,), readonly=True)
+    assert view.to_raw_values() == [0x3F80, 0x4000]
+    assert view.to_values() == [1.0, 2.0]
+
+    with pytest.raises(CpuByteViewError, match="requires"):
+        TypedByteView(payload[:-1], "bf16", (2,), readonly=True)
+    with pytest.raises(CpuByteViewError, match="requires"):
+        TypedByteView(payload + b"\x00\x00", "bf16", (2,), readonly=True)
+
+    non_contiguous = memoryview(bytearray(payload * 2))[::2]
+    with pytest.raises(CpuByteViewError, match="C-contiguous"):
+        TypedByteView(non_contiguous, "bf16", (2,), readonly=True)
+
+    released = memoryview(bytearray(payload))
+    released.release()
+    with pytest.raises(CpuByteViewError, match="released"):
+        TypedByteView(released, "bf16", (2,), readonly=True)
+
+    with pytest.raises(CpuByteViewError, match="read-only"):
+        TypedByteView(payload, "bf16", (2,), readonly=False)
+    readonly_contract = TypedByteView(bytearray(payload), "bf16", (2,), readonly=True)
+    with pytest.raises(CpuByteViewError, match="read-only"):
+        readonly_contract.write_values([1.0, 2.0])
+    readonly_contract.close()
+
+    big_endian = memoryview(struct.pack(">2H", 0x3F80, 0x4000)).cast("B")
+    # Raw B streams are intentionally endian-neutral at the exporter layer;
+    # the BF16 contract itself is checked as little-endian uint16 bits.
+    assert TypedByteView(big_endian, "bf16", (2,), readonly=True).to_raw_values() == [0x803F, 0x0040]
+
+
+def test_scalar_bytes_bytearray_mmap_and_bf16_raw_write(tmp_path):
+    artifact = _scalar_artifact(_elementwise("bf16", operation="mul"))
+    left_bits = (0x3F01, 0x3F02)
+    right_bits = (0x3F40, 0x3F20)
+    left = struct.pack("<2H", *left_bits)
+    right = bytearray(struct.pack("<2H", *right_bits))
+    output = bytearray(b"\xA5" + b"\x00" * 4 + b"\x5A")
+    output_view = memoryview(output)[1:-1]
+    left_binding = BufferBinding(left, "left", "bf16", (2,), readonly=True)
+    output_binding = BufferBinding(output, "output", "bf16", (2,), byte_offset=1, readonly=False)
+    CpuScalarRuntime().launch(
+        _request(
+            artifact,
+            [left_binding.to_tensor_desc(), TensorDesc("bf16", (2,), handle=right, readonly=True)],
+            output_binding.to_tensor_desc(),
+        )
+    )
+    expected = [_bf16_bits(struct.unpack("<f", struct.pack("<I", left_bits[i] << 16))[0] *
+                            struct.unpack("<f", struct.pack("<I", right_bits[i] << 16))[0]) for i in range(2)]
+    assert struct.unpack("<2H", output_view.tobytes()) == tuple(expected)
+    assert output[0] == 0xA5 and output[-1] == 0x5A
+    assert left == struct.pack("<2H", *left_bits)
+
+    with tempfile.NamedTemporaryFile(dir=str(tmp_path)) as file_obj:
+        file_obj.write(left)
+        file_obj.flush()
+        fd = os.open(file_obj.name, os.O_RDONLY)
+        try:
+            readonly_map = mmap.mmap(fd, len(left), access=mmap.ACCESS_READ)
+        finally:
+            os.close(fd)
+        try:
+            assert TypedByteView(readonly_map, "bf16", (2,), readonly=True).to_raw_values() == list(left_bits)
+        finally:
+            readonly_map.close()
+
+    with tempfile.NamedTemporaryFile(dir=str(tmp_path)) as file_obj:
+        file_obj.write(left)
+        file_obj.flush()
+        writable_map = mmap.mmap(file_obj.fileno(), len(left), access=mmap.ACCESS_WRITE)
+        try:
+            typed = TypedByteView(writable_map, "bf16", (2,), readonly=False)
+            typed.write_values([1.0, 2.0])
+            assert writable_map[:] == struct.pack("<2H", 0x3F80, 0x4000)
+            typed.close()
+        finally:
+            writable_map.close()
+
+
+def test_scalar_byte_output_readonly_fails_closed():
+    program = _elementwise("float32")
+    artifact = _scalar_artifact(program)
+    with pytest.raises(CpuScalarExecutionError, match="read-only"):
+        CpuScalarRuntime().launch(
+            _request(
+                artifact,
+                [
+                    TensorDesc("float32", (2,), handle=struct.pack("<2f", 1.0, 2.0), readonly=True),
+                    TensorDesc("float32", (2,), handle=struct.pack("<2f", 3.0, 4.0), readonly=True),
+                ],
+                TensorDesc("float32", (2,), handle=bytes(8)),
+            )
+        )
+
+
+def test_avx2_byte_views_are_direct_and_preserve_canary(tmp_path):
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2: {}".format(runtime.availability().to_dict()))
+    artifact = _avx2_artifact(_elementwise("bf16", operation="mul"), tmp_path)
+    left = struct.pack("<2H", 0x3F01, 0x3F02)
+    right = struct.pack("<2H", 0x3F40, 0x3F20)
+    guarded = bytearray(b"\xA5" + b"\x00" * 4 + b"\x5A")
+    runtime.launch(
+        _request(
+            artifact,
+            [TensorDesc("bf16", (2,), handle=left, readonly=True), TensorDesc("bf16", (2,), handle=right, readonly=True)],
+            TensorDesc("bf16", (2,), handle=memoryview(guarded)[1:-1]),
+        )
+    )
+    assert guarded[0] == 0xA5 and guarded[-1] == 0x5A
+    assert left == struct.pack("<2H", 0x3F01, 0x3F02)
+    left_bits = struct.unpack("<2H", left)
+    right_bits = struct.unpack("<2H", right)
+    assert struct.unpack("<2H", guarded[1:-1]) == tuple(
+        _bf16_bits(struct.unpack("<f", struct.pack("<I", left_bits[i] << 16))[0] *
+                   struct.unpack("<f", struct.pack("<I", right_bits[i] << 16))[0])
+        for i in range(2)
+    )
+
+
+def test_avx2_short_long_noncontiguous_and_readonly_outputs_fail(tmp_path):
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2: {}".format(runtime.availability().to_dict()))
+    artifact = _avx2_artifact(_elementwise("float32"), tmp_path)
+    good = struct.pack("<2f", 1.0, 2.0)
+    for bad in (good[:-1], good + b"\x00"):
+        with pytest.raises(CpuAvx2ExecutionError, match="bytes"):
+            runtime.launch(
+                _request(
+                    artifact,
+                    [TensorDesc("float32", (2,), handle=bad, readonly=True), TensorDesc("float32", (2,), handle=good, readonly=True)],
+                    TensorDesc("float32", (2,), handle=bytearray(8)),
+                )
+            )
+    non_contiguous = memoryview(bytearray(good * 2))[::2]
+    with pytest.raises(CpuAvx2ExecutionError, match="C-contiguous"):
+        runtime.launch(
+            _request(
+                artifact,
+                [TensorDesc("float32", (2,), handle=non_contiguous, readonly=True), TensorDesc("float32", (2,), handle=good, readonly=True)],
+                TensorDesc("float32", (2,), handle=bytearray(8)),
+            )
+        )
+    with pytest.raises(CpuAvx2ExecutionError, match="read-only"):
+        runtime.launch(
+            _request(
+                artifact,
+                [TensorDesc("float32", (2,), handle=good, readonly=True), TensorDesc("float32", (2,), handle=good, readonly=True)],
+                TensorDesc("float32", (2,), handle=bytes(8)),
+            )
+        )
+
+
+def test_avx512_byte_views_execute_natively_when_available(tmp_path):
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512: {}".format(runtime.availability().to_dict()))
+    artifact = _avx512_artifact(_elementwise("float32"), tmp_path)
+    left = struct.pack("<2f", 1.0, 2.0)
+    right = struct.pack("<2f", 3.0, 4.0)
+    output = bytearray(8)
+    runtime.launch(
+        _request(
+            artifact,
+            [TensorDesc("float32", (2,), handle=left, readonly=True), TensorDesc("float32", (2,), handle=right, readonly=True)],
+            TensorDesc("float32", (2,), handle=output),
+        )
+    )
+    assert struct.unpack("<2f", output) == (4.0, 6.0)
+
+
+def test_sve_qemu_raw_bytes_are_staged_without_mutating_input(tmp_path):
+    program = _elementwise("float32", shape=(3,), operation="add")
+    artifact = _sve_artifact(program, tmp_path)
+    runtime = Sve256Runtime(execution_mode="qemu")
+    if not runtime.is_available():
+        pytest.skip("QEMU SVE256 unavailable: {}".format(runtime.availability().to_dict()))
+    left = struct.pack("<3f", 1.0, 2.0, 3.0)
+    right = struct.pack("<3f", 4.0, 5.0, 6.0)
+    guarded = bytearray(b"\xA5" + b"\x00" * 12 + b"\x5A")
+    # The SVE artifact marker verifier imports the source module by name.  A
+    # package-only shim keeps this test independent of an installed CANN/PyPTO
+    # distribution while still exercising the real QEMU runner.
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(Path(__file__).parents[3] / "pypto")]
+    sys.modules["pypto"] = package
+    try:
+        runtime.launch(
+            _request(
+                artifact,
+                [TensorDesc("float32", (3,), handle=left, readonly=True), TensorDesc("float32", (3,), handle=right, readonly=True)],
+                TensorDesc("float32", (3,), handle=memoryview(guarded)[1:-1]),
+            )
+        )
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+    assert left == struct.pack("<3f", 1.0, 2.0, 3.0)
+    assert guarded[0] == 0xA5 and guarded[-1] == 0x5A
+    assert struct.unpack("<3f", guarded[1:-1]) == (5.0, 7.0, 9.0)
