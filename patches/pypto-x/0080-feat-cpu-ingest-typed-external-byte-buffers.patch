diff --git a/python/pypto/backends/cpu/byte_view.py b/python/pypto/backends/cpu/byte_view.py
new file mode 100644
index 000000000..9ce401f55
--- /dev/null
+++ b/python/pypto/backends/cpu/byte_view.py
@@ -0,0 +1,395 @@
+"""Strict, non-owning typed views for CPU external byte buffers.
+
+The runtime ABI deliberately carries an opaque ``TensorDesc.handle``.  This
+module is the small CPU-side seam that gives a byte handle a tensor meaning.
+It keeps the caller's exporter alive, validates the byte contract before any
+read/write, and exposes the exporter address without turning the buffer into a
+Python element sequence.  A scalar/reference backend may explicitly call
+``to_values`` for a small tensor; native backends keep the view and pointer.
+
+Only the dtypes used by the current CPU ingestion contract are accepted here:
+BF16, FP32, INT32 and INT64.  BF16 is always a little-endian raw uint16
+stream.  The utility intentionally does not infer a dtype from a byte buffer.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import struct
+import sys
+from typing import Any, Optional, Sequence, Tuple
+
+
+class CpuByteViewError(ValueError):
+    """A byte exporter cannot satisfy an exact typed tensor contract."""
+
+
+class ByteViewNotApplicable(TypeError):
+    """The object is not a buffer exporter; a legacy sequence path may try."""
+
+
+_DTYPE_INFO = {
+    "bf16": (2, "H"),
+    "bfloat16": (2, "H"),
+    "float32": (4, "f"),
+    "int32": (4, "i"),
+    "int64": (8, "q"),
+}
+_NATIVE_FORMATS = {
+    "bf16": ("H",),
+    "float32": ("f",),
+    "int32": ("i",),
+    # NumPy exposes np.int64 as ``l`` on LP64 hosts, while ctypes/array use
+    # ``q``.  Both are signed 64-bit native-little-endian exporters.
+    "int64": ("q", "l"),
+}
+
+
+def _canonical_dtype(dtype: Any) -> str:
+    value = dtype if isinstance(dtype, str) else getattr(dtype, "name", dtype)
+    value = str(value).strip().lower()
+    if value == "bfloat16":
+        return "bf16"
+    if value not in ("bf16", "float32", "int32", "int64"):
+        raise CpuByteViewError("typed byte view does not support dtype {!r}".format(dtype))
+    return value
+
+
+def _shape(shape: Sequence[int]) -> Tuple[int, ...]:
+    if isinstance(shape, (str, bytes, bytearray)):
+        raise CpuByteViewError("typed byte view shape must be a sequence of non-negative integers")
+    try:
+        result = tuple(shape)
+    except TypeError as exc:
+        raise CpuByteViewError("typed byte view shape must be a sequence of non-negative integers") from exc
+    for index, dimension in enumerate(result):
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise CpuByteViewError("typed byte view shape[{}] must be a non-negative integer".format(index))
+    return result
+
+
+def _element_count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+def _bf16_bits(value: Any) -> int:
+    number = float(value)
+    bits = struct.unpack("<I", struct.pack("<f", number))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return (bits >> 16) & 0xFFFF
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def _bf16_value(bits: int) -> float:
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+class _PyBuffer(ctypes.Structure):
+    """The stable CPython ``Py_buffer`` layout used by PyObject_GetBuffer."""
+
+    _fields_ = [
+        ("buf", ctypes.c_void_p),
+        ("obj", ctypes.c_void_p),
+        ("len", ctypes.c_ssize_t),
+        ("itemsize", ctypes.c_ssize_t),
+        ("readonly", ctypes.c_int),
+        ("ndim", ctypes.c_int),
+        ("format", ctypes.c_char_p),
+        ("shape", ctypes.POINTER(ctypes.c_ssize_t)),
+        ("strides", ctypes.POINTER(ctypes.c_ssize_t)),
+        ("suboffsets", ctypes.POINTER(ctypes.c_ssize_t)),
+        ("internal", ctypes.c_void_p),
+    ]
+
+
+try:
+    _GET_BUFFER = ctypes.pythonapi.PyObject_GetBuffer
+    _GET_BUFFER.argtypes = [ctypes.py_object, ctypes.POINTER(_PyBuffer), ctypes.c_int]
+    _GET_BUFFER.restype = ctypes.c_int
+    _RELEASE_BUFFER = ctypes.pythonapi.PyBuffer_Release
+    _RELEASE_BUFFER.argtypes = [ctypes.POINTER(_PyBuffer)]
+    _RELEASE_BUFFER.restype = None
+except AttributeError:  # pragma: no cover - CPython is the supported runtime.
+    _GET_BUFFER = None
+    _RELEASE_BUFFER = None
+
+
+def _source_format_is_compatible(raw: memoryview, dtype: str, context: str) -> None:
+    """Validate an optional typed exporter format before casting to bytes."""
+
+    try:
+        fmt = raw.format or "B"
+        itemsize = int(raw.itemsize)
+    except (AttributeError, TypeError, ValueError) as exc:
+        raise CpuByteViewError("{} buffer format is unavailable".format(context)) from exc
+    expected_size = _DTYPE_INFO[dtype][0]
+    accepted_formats = _NATIVE_FORMATS[dtype]
+    # A byte stream has no endian marker; its contract is explicitly little
+    # endian and is checked by the typed decoder below.  For typed exporters,
+    # reject a big-endian view instead of silently reinterpreting it.
+    if fmt in ("B", "b", "c", "V") and itemsize == 1:
+        return
+    if fmt.startswith(">"):
+        raise CpuByteViewError("{} buffer dtype byte order must be little-endian".format(context))
+    if fmt.startswith("<") or fmt.startswith("="):
+        fmt = fmt[1:]
+    if itemsize != expected_size or fmt not in accepted_formats + ("V{}".format(expected_size),):
+        raise CpuByteViewError(
+            "{} buffer format {!r}/itemsize {} does not match {}".format(
+                context, raw.format, itemsize, dtype
+            )
+        )
+    if sys.byteorder != "little":
+        raise CpuByteViewError("{} typed byte view requires a little-endian host".format(context))
+
+
+class _BorrowedBuffer:
+    """Own one CPython buffer export and release it exactly once."""
+
+    def __init__(self, byte_view: memoryview, context: str) -> None:
+        if _GET_BUFFER is None or _RELEASE_BUFFER is None:
+            raise CpuByteViewError("{} requires CPython buffer API".format(context))
+        self.view = byte_view
+        self._buffer = _PyBuffer()
+        self._released = False
+        result = _GET_BUFFER(byte_view, ctypes.byref(self._buffer), 0)
+        if result != 0 or not self._buffer.buf and self._buffer.len:
+            self._released = True
+            raise CpuByteViewError("{} buffer address cannot be borrowed".format(context))
+        self.address = int(self._buffer.buf or 0)
+        self.nbytes = int(self._buffer.len)
+
+    def close(self) -> None:
+        if not self._released:
+            self._released = True
+            _RELEASE_BUFFER(ctypes.byref(self._buffer))
+
+    def __del__(self):  # pragma: no cover - exercised by CPython lifetime tests.
+        try:
+            self.close()
+        except Exception:
+            pass
+
+
+class TypedByteView:
+    """An exact, contiguous, caller-owned typed byte view.
+
+    ``address`` is valid while this object is alive.  The object retains both
+    the byte memoryview and a CPython buffer export, so native AVX callers can
+    use the address without copying.  ``to_bytes`` is the sole explicit
+    process-boundary/staging copy used by SVE; ``to_values`` is reserved for
+    scalar/reference semantics.
+    """
+
+    def __init__(
+        self,
+        storage: Any,
+        dtype: Any,
+        shape: Sequence[int],
+        *,
+        readonly: bool,
+        context: str = "tensor",
+    ) -> None:
+        self.dtype = _canonical_dtype(dtype)
+        self.shape = _shape(shape)
+        self.count = _element_count(self.shape)
+        self.nbytes = self.count * _DTYPE_INFO[self.dtype][0]
+        self.readonly = bool(readonly)
+        self.context = str(context)
+        try:
+            raw = memoryview(storage)
+        except TypeError as exc:
+            raise ByteViewNotApplicable("{} does not export a buffer".format(context)) from exc
+        except ValueError as exc:
+            raise CpuByteViewError("{} buffer view is released".format(context)) from exc
+        try:
+            if not raw.c_contiguous:
+                raise CpuByteViewError("{} external buffer must be C-contiguous".format(context))
+            _source_format_is_compatible(raw, self.dtype, context)
+            byte_view = raw if raw.format == "B" and raw.itemsize == 1 else raw.cast("B")
+            actual_nbytes = int(byte_view.nbytes)
+        except CpuByteViewError:
+            raw.release()
+            raise
+        except (TypeError, ValueError) as exc:
+            raw.release()
+            if isinstance(exc, ValueError):
+                raise CpuByteViewError("{} buffer view is released".format(context)) from exc
+            raise CpuByteViewError("{} buffer cannot be viewed as contiguous bytes".format(context)) from exc
+        if actual_nbytes != self.nbytes:
+            raw.release()
+            relation = "shorter" if actual_nbytes < self.nbytes else "longer"
+            raise CpuByteViewError(
+                "{} buffer is {} than descriptor: has {} bytes; descriptor requires {}".format(
+                    context, relation, actual_nbytes, self.nbytes
+                )
+            )
+        if not self.readonly and byte_view.readonly:
+            raw.release()
+            raise CpuByteViewError("{} buffer is read-only but descriptor is writable".format(context))
+        try:
+            borrowed = _BorrowedBuffer(byte_view, context)
+        except Exception:
+            raw.release()
+            raise
+        self._raw = raw
+        self._view = byte_view
+        self._borrowed = borrowed
+        self.address = borrowed.address
+        self.owner = storage
+
+    @classmethod
+    def from_descriptor(cls, descriptor: Any, dtype: Any, shape: Sequence[int], context: str) -> "TypedByteView":
+        storage = descriptor.storage
+        if storage is None:
+            raise CpuByteViewError("{} tensor descriptor has no storage".format(context))
+        return cls(storage, dtype, shape, readonly=descriptor.readonly, context=context)
+
+    def validate(self, *, writable: bool = False) -> None:
+        if writable and self.readonly:
+            raise CpuByteViewError("{} output descriptor is read-only".format(self.context))
+        try:
+            if not self._view.c_contiguous:
+                raise CpuByteViewError("{} external buffer is no longer C-contiguous".format(self.context))
+            actual = int(self._view.nbytes)
+            source_readonly = bool(self._view.readonly)
+        except (AttributeError, TypeError, ValueError) as exc:
+            raise CpuByteViewError("{} buffer view is released".format(self.context)) from exc
+        if actual != self.nbytes:
+            raise CpuByteViewError("{} buffer length changed".format(self.context))
+        if writable and source_readonly:
+            raise CpuByteViewError("{} output buffer is read-only".format(self.context))
+        if not self.readonly and source_readonly:
+            raise CpuByteViewError("{} buffer is read-only but descriptor is writable".format(self.context))
+        if self.count and self.address == 0:
+            raise CpuByteViewError("{} buffer address is null".format(self.context))
+
+    def __len__(self) -> int:
+        return self.count
+
+    def to_bytes(self) -> bytes:
+        self.validate()
+        try:
+            return self._view.tobytes()
+        except (AttributeError, ValueError) as exc:
+            raise CpuByteViewError("{} buffer view is released".format(self.context)) from exc
+
+    def to_values(self) -> list:
+        """Decode a small/reference tensor into Python values explicitly."""
+
+        payload = self.to_bytes()
+        if self.dtype == "bf16":
+            bits = struct.unpack("<{}H".format(self.count), payload) if self.count else ()
+            return [_bf16_value(value) for value in bits]
+        if self.dtype == "float32":
+            return list(struct.unpack("<{}f".format(self.count), payload)) if self.count else []
+        if self.dtype == "int32":
+            return list(struct.unpack("<{}i".format(self.count), payload)) if self.count else []
+        if self.dtype == "int64":
+            return list(struct.unpack("<{}q".format(self.count), payload)) if self.count else []
+        raise CpuByteViewError("{} dtype cannot be decoded".format(self.context))
+
+    def to_raw_values(self) -> list:
+        """Return raw integer bits for BF16, or typed integers for integer dtypes."""
+
+        payload = self.to_bytes()
+        if self.dtype == "bf16":
+            return list(struct.unpack("<{}H".format(self.count), payload)) if self.count else []
+        if self.dtype == "int32":
+            return list(struct.unpack("<{}i".format(self.count), payload)) if self.count else []
+        if self.dtype == "int64":
+            return list(struct.unpack("<{}q".format(self.count), payload)) if self.count else []
+        if self.dtype == "float32":
+            return list(struct.unpack("<{}f".format(self.count), payload)) if self.count else []
+        raise CpuByteViewError("{} dtype cannot be decoded".format(self.context))
+
+    def write_values(self, values: Sequence[Any]) -> None:
+        """Encode values into a writable view, preserving BF16 raw bits."""
+
+        self.validate(writable=True)
+        try:
+            values = tuple(values)
+        except TypeError as exc:
+            raise CpuByteViewError("{} output values are not a sequence".format(self.context)) from exc
+        if len(values) != self.count:
+            raise CpuByteViewError(
+                "{} output has {} values; descriptor requires {}".format(
+                    self.context, len(values), self.count
+                )
+            )
+        try:
+            if self.dtype == "bf16":
+                payload = struct.pack("<{}H".format(self.count), *[_bf16_bits(value) for value in values])
+            elif self.dtype == "float32":
+                payload = struct.pack("<{}f".format(self.count), *[float(value) for value in values])
+            elif self.dtype == "int32":
+                payload = struct.pack("<{}i".format(self.count), *[int(value) for value in values])
+            elif self.dtype == "int64":
+                payload = struct.pack("<{}q".format(self.count), *[int(value) for value in values])
+            else:
+                raise CpuByteViewError("{} dtype cannot be encoded".format(self.context))
+            self._view[:] = payload
+        except CpuByteViewError:
+            raise
+        except (AttributeError, TypeError, ValueError, OverflowError, struct.error) as exc:
+            raise CpuByteViewError("{} output buffer cannot be written".format(self.context)) from exc
+
+    def close(self) -> None:
+        """Release the CPython export after all native users have finished."""
+
+        borrowed = getattr(self, "_borrowed", None)
+        if borrowed is not None:
+            borrowed.close()
+        view = getattr(self, "_view", None)
+        raw = getattr(self, "_raw", None)
+        if view is not None:
+            try:
+                view.release()
+            except (AttributeError, ValueError):
+                pass
+        if raw is not None and raw is not view:
+            try:
+                raw.release()
+            except (AttributeError, ValueError):
+                pass
+
+    def __del__(self):  # pragma: no cover - exercised by lifetime tests.
+        try:
+            self.close()
+        except Exception:
+            pass
+
+
+def try_typed_byte_view(
+    storage: Any,
+    dtype: Any,
+    shape: Sequence[int],
+    *,
+    readonly: bool,
+    context: str,
+) -> Optional[TypedByteView]:
+    """Return a typed view for buffer exporters, or ``None`` for sequences."""
+
+    try:
+        _canonical_dtype(dtype)
+    except CpuByteViewError:
+        # Preserve existing sequence/array handling for dtypes outside this
+        # deliberately small ingestion seam.  A raw byte object for such a
+        # dtype still fails closed in the legacy path; it is never decoded as
+        # one-byte elements here.
+        return None
+    try:
+        return TypedByteView(storage, dtype, shape, readonly=readonly, context=context)
+    except ByteViewNotApplicable:
+        return None
+
+
+__all__ = [
+    "ByteViewNotApplicable",
+    "CpuByteViewError",
+    "TypedByteView",
+    "try_typed_byte_view",
+]
