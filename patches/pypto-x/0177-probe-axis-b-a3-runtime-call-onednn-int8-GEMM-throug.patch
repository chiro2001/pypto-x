     rec("dynamic_scaled_int8_quant", s_quant)
 
+    def _onednn_scaled_mm(w, w_scales, a, dynamic=True):
+        """Direct call through the public CPU int8 wrapper (same API the
+        CPUInt8ScaledMMLinearKernel uses): create_onednn_scaled_mm + onednn_scaled_mm."""
+        M, K = a.shape
+        N = w.shape[1]
+        codes, a_scales, _ = ops.onednn_scaled_int8_quant(a, None, None, True)[:3]
+        handler = ops.create_onednn_scaled_mm(w, w_scales, torch.float32, dynamic, False, 32)
+        out = torch.empty((M, N), dtype=torch.float32)
+        ops.onednn_scaled_mm(handler, codes, out, a_scales, None, None, None)
+        ref = (codes.float() * a_scales) @ (w.float() * w_scales)
+        return codes, out, ref, handler
+
