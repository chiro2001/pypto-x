-            elif "scale" in ln:
-                kwargs[n] = a_scales
-            elif ln in ("bias", "output", "out", "azp", "a_zp", "b_zp"):
-                kwargs[n] = None
-            elif "dtype" in ln:
-                kwargs[n] = torch.float32
-            else:
-                kwargs[n] = None
