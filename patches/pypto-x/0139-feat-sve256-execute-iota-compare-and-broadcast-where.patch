+static int ptx_decode_expand_descriptor(const unsigned char *bytes, size_t length,
+                                        PtxExpandDescriptor *descriptor) {
+    uint32_t rank, axis;
+    size_t expected;
+    if (length < PTX_EXPAND_DESCRIPTOR_HEADER_BYTES || memcmp(bytes, "PXBD", 4) != 0 ||
+        ptx_read_u32(bytes + 4) != 1U)
+        return PTX_STATUS_BAD_REQUEST;
+    rank = ptx_read_u32(bytes + 8);
+    if (rank > PTX_CONTROL_MAX_RANK) return PTX_STATUS_BAD_REQUEST;
+    if (ptx_size_mul(rank, sizeof(uint64_t), &expected) != PTX_STATUS_OK ||
+        ptx_size_mul(expected, 2U, &expected) != PTX_STATUS_OK ||
+        ptx_size_add(expected, PTX_EXPAND_DESCRIPTOR_HEADER_BYTES, &expected) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (length < expected) return PTX_STATUS_BAD_REQUEST;
+    memset(descriptor, 0, sizeof(*descriptor));
+    descriptor->rank = rank;
+    descriptor->dtype = ptx_read_u32(bytes + 12);
+    if (ptx_read_u32(bytes + 16) != 0U || ptx_read_u32(bytes + 20) != 0U)
+        return PTX_STATUS_BAD_REQUEST;
+    descriptor->input_elements = ptx_read_u64(bytes + 24);
+    descriptor->output_elements = ptx_read_u64(bytes + 32);
+    for (axis = 0; axis < rank; ++axis) {
+        descriptor->input_strides[axis] = ptx_read_u64(bytes + 40 + axis * 8U);
+        descriptor->output_shape[axis] = ptx_read_u64(bytes + 40 + (rank + axis) * 8U);
+    }
+    if (!ptx_is_float_dtype(descriptor->dtype)) return PTX_STATUS_BAD_REQUEST;
+    if (ptx_validate_shape_product(descriptor->output_shape, rank,
+                                   descriptor->output_elements) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_validate_broadcast_offsets(descriptor->output_shape, descriptor->input_strides,
+                                       rank, descriptor->input_elements) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    return PTX_STATUS_OK;
+}
+
+static int ptx_decode_where_descriptor(const unsigned char *bytes, size_t length,
+                                       PtxWhereDescriptor *descriptor) {
+    uint32_t rank, axis;
+    size_t expected;
+    if (length < PTX_WHERE_DESCRIPTOR_HEADER_BYTES || memcmp(bytes, "PXWH", 4) != 0 ||
+        ptx_read_u32(bytes + 4) != 1U)
+        return PTX_STATUS_BAD_REQUEST;
+    rank = ptx_read_u32(bytes + 8);
+    if (rank > PTX_CONTROL_MAX_RANK) return PTX_STATUS_BAD_REQUEST;
+    if (ptx_size_mul(rank, sizeof(uint64_t), &expected) != PTX_STATUS_OK ||
+        ptx_size_mul(expected, 4U, &expected) != PTX_STATUS_OK ||
+        ptx_size_add(expected, PTX_WHERE_DESCRIPTOR_HEADER_BYTES, &expected) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (length < expected) return PTX_STATUS_BAD_REQUEST;
+    memset(descriptor, 0, sizeof(*descriptor));
+    descriptor->rank = rank;
+    descriptor->condition_dtype = ptx_read_u32(bytes + 12);
+    descriptor->value_dtype = ptx_read_u32(bytes + 16);
+    descriptor->output_dtype = ptx_read_u32(bytes + 20);
+    if (ptx_read_u32(bytes + 24) != 0U || ptx_read_u32(bytes + 28) != 0U)
+        return PTX_STATUS_BAD_REQUEST;
+    descriptor->condition_elements = ptx_read_u64(bytes + 32);
+    descriptor->true_elements = ptx_read_u64(bytes + 40);
+    descriptor->false_elements = ptx_read_u64(bytes + 48);
+    descriptor->output_elements = ptx_read_u64(bytes + 56);
+    for (axis = 0; axis < rank; ++axis) {
+        descriptor->condition_strides[axis] = ptx_read_u64(bytes + 64 + axis * 8U);
+        descriptor->true_strides[axis] = ptx_read_u64(bytes + 64 + (rank + axis) * 8U);
+        descriptor->false_strides[axis] = ptx_read_u64(bytes + 64 + (2U * rank + axis) * 8U);
+        descriptor->output_shape[axis] = ptx_read_u64(bytes + 64 + (3U * rank + axis) * 8U);
+    }
+    if (descriptor->condition_dtype != PTX_DTYPE_BOOL)
+        return PTX_STATUS_BAD_REQUEST;
+    if (!ptx_is_float_dtype(descriptor->value_dtype) ||
+        descriptor->value_dtype != descriptor->output_dtype)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_validate_shape_product(descriptor->output_shape, rank,
+                                   descriptor->output_elements) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_validate_broadcast_offsets(descriptor->output_shape,
+                                       descriptor->condition_strides, rank,
+                                       descriptor->condition_elements) != PTX_STATUS_OK ||
+        ptx_validate_broadcast_offsets(descriptor->output_shape, descriptor->true_strides,
+                                       rank, descriptor->true_elements) != PTX_STATUS_OK ||
+        ptx_validate_broadcast_offsets(descriptor->output_shape, descriptor->false_strides,
+                                       rank, descriptor->false_elements) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    return PTX_STATUS_OK;
+}
+
+static int ptx_validate_control_request(const PtxRequest *request, const unsigned char *payload,
+                                        size_t payload_length, size_t *item_size,
+                                        size_t *payload_size, uint64_t *output_count,
+                                        size_t *result_size) {
+    size_t descriptor_bytes, data_size, output_size;
+    if (request->operation == PTX_IOTA) {
+        PtxIotaDescriptor descriptor;
+        if (ptx_decode_iota_descriptor(payload, payload_length, &descriptor) != PTX_STATUS_OK ||
+            request->dtype != descriptor.dtype || request->reserved || request->reserved2 ||
+            request->m != descriptor.output_elements || request->count != descriptor.output_elements ||
+            request->k != PTX_IOTA_DESCRIPTOR_BYTES ||
+            ptx_wire_hash(payload, PTX_IOTA_DESCRIPTOR_BYTES) != request->n)
+            return PTX_STATUS_BAD_REQUEST;
+        *item_size = descriptor.dtype == PTX_DTYPE_I32 ? sizeof(int32_t) : sizeof(int64_t);
+        *payload_size = PTX_IOTA_DESCRIPTOR_BYTES;
+        *output_count = request->count;
+        if (payload_length != *payload_size ||
+            ptx_u64_to_size(*output_count, &output_size) != PTX_STATUS_OK ||
+            ptx_size_mul(output_size, *item_size, result_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        return PTX_STATUS_OK;
+    }
+    if (request->operation == PTX_COMPARE) {
+        PtxCompareDescriptor descriptor;
+        size_t left_bytes, right_bytes;
+        uint32_t left_item, right_item;
+        if (ptx_decode_compare_descriptor(payload, payload_length, &descriptor) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        descriptor_bytes = PTX_COMPARE_DESCRIPTOR_HEADER_BYTES +
+            (size_t)descriptor.rank * 3U * sizeof(uint64_t);
+        left_item = ptx_dtype_item_size(descriptor.left_dtype);
+        right_item = ptx_dtype_item_size(descriptor.right_dtype);
+        if (request->dtype != PTX_DTYPE_BOOL || request->reserved != descriptor.predicate ||
+            request->reserved2 != descriptor_bytes || !left_item || !right_item ||
+            request->m != descriptor.left_elements ||
+            request->k != descriptor.right_elements ||
+            request->count != descriptor.output_elements ||
+            ptx_wire_hash(payload, descriptor_bytes) != request->n)
+            return PTX_STATUS_BAD_REQUEST;
+        if (ptx_u64_to_size(descriptor.left_elements, &left_bytes) != PTX_STATUS_OK ||
+            ptx_size_mul(left_bytes, left_item, &left_bytes) != PTX_STATUS_OK ||
+            ptx_u64_to_size(descriptor.right_elements, &right_bytes) != PTX_STATUS_OK ||
+            ptx_size_mul(right_bytes, right_item, &right_bytes) != PTX_STATUS_OK ||
+            ptx_size_add(descriptor_bytes, left_bytes, &data_size) != PTX_STATUS_OK ||
+            ptx_size_add(data_size, right_bytes, payload_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        if (payload_length != *payload_size) return PTX_STATUS_BAD_REQUEST;
+        *item_size = 1U;
+        *output_count = request->count;
+        if (ptx_u64_to_size(*output_count, &output_size) != PTX_STATUS_OK ||
+            ptx_size_mul(output_size, *item_size, result_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        return PTX_STATUS_OK;
+    }
+    if (request->operation == PTX_BROADCAST) {
+        PtxExpandDescriptor descriptor;
+        size_t input_bytes;
+        uint32_t item;
+        if (ptx_decode_expand_descriptor(payload, payload_length, &descriptor) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        descriptor_bytes = PTX_EXPAND_DESCRIPTOR_HEADER_BYTES +
+            (size_t)descriptor.rank * 2U * sizeof(uint64_t);
+        item = ptx_dtype_item_size(descriptor.dtype);
+        if (request->dtype != descriptor.dtype || request->reserved || request->reserved2 ||
+            request->m != descriptor.input_elements ||
+            request->count != descriptor.output_elements ||
+            request->k != descriptor_bytes || !item ||
+            ptx_wire_hash(payload, descriptor_bytes) != request->n)
+            return PTX_STATUS_BAD_REQUEST;
+        if (ptx_u64_to_size(descriptor.input_elements, &input_bytes) != PTX_STATUS_OK ||
+            ptx_size_mul(input_bytes, item, &input_bytes) != PTX_STATUS_OK ||
+            ptx_size_add(descriptor_bytes, input_bytes, payload_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        if (payload_length != *payload_size) return PTX_STATUS_BAD_REQUEST;
+        *item_size = item;
+        *output_count = request->count;
+        if (ptx_u64_to_size(*output_count, &output_size) != PTX_STATUS_OK ||
+            ptx_size_mul(output_size, *item_size, result_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        return PTX_STATUS_OK;
+    }
+    if (request->operation == PTX_WHERE) {
+        PtxWhereDescriptor descriptor;
+        size_t condition_bytes, true_bytes, false_bytes;
+        uint32_t item;
+        if (ptx_decode_where_descriptor(payload, payload_length, &descriptor) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        descriptor_bytes = PTX_WHERE_DESCRIPTOR_HEADER_BYTES +
+            (size_t)descriptor.rank * 4U * sizeof(uint64_t);
+        item = ptx_dtype_item_size(descriptor.output_dtype);
+        if (request->dtype != descriptor.output_dtype || request->reserved ||
+            request->reserved2 != 0U || request->m != descriptor.condition_elements ||
+            request->count != descriptor.output_elements ||
+            request->k != descriptor_bytes || !item ||
+            ptx_wire_hash(payload, descriptor_bytes) != request->n)
+            return PTX_STATUS_BAD_REQUEST;
+        if (ptx_u64_to_size(descriptor.condition_elements, &condition_bytes) != PTX_STATUS_OK ||
+            ptx_u64_to_size(descriptor.true_elements, &true_bytes) != PTX_STATUS_OK ||
+            ptx_size_mul(true_bytes, item, &true_bytes) != PTX_STATUS_OK ||
+            ptx_u64_to_size(descriptor.false_elements, &false_bytes) != PTX_STATUS_OK ||
+            ptx_size_mul(false_bytes, item, &false_bytes) != PTX_STATUS_OK ||
+            ptx_size_add(descriptor_bytes, condition_bytes, &data_size) != PTX_STATUS_OK ||
+            ptx_size_add(data_size, true_bytes, &data_size) != PTX_STATUS_OK ||
+            ptx_size_add(data_size, false_bytes, payload_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        if (payload_length != *payload_size) return PTX_STATUS_BAD_REQUEST;
+        *item_size = item;
+        *output_count = request->count;
+        if (ptx_u64_to_size(*output_count, &output_size) != PTX_STATUS_OK ||
+            ptx_size_mul(output_size, *item_size, result_size) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+        return PTX_STATUS_OK;
+    }
+    return PTX_STATUS_BAD_REQUEST;
+}
+
+static void ptx_odometer_advance(uint64_t *coordinates, const uint64_t *shape,
+                                 uint32_t rank) {
+    uint32_t axis = rank;
+    while (axis > 0) {
+        --axis;
+        coordinates[axis] += 1U;
+        if (coordinates[axis] < shape[axis]) return;
+        coordinates[axis] = 0;
+    }
+}
+
+static uint64_t ptx_linear_offset(const uint64_t *coordinates, const uint64_t *strides,
+                                  uint32_t rank) {
+    uint64_t offset = 0;
+    uint32_t axis;
+    for (axis = 0; axis < rank; ++axis)
+        offset += coordinates[axis] * strides[axis];
+    return offset;
+}
+
+static int ptx_store_integer(uint32_t dtype, unsigned char *output, uint64_t index,
+                             int64_t value) {
+    if (dtype == PTX_DTYPE_I32) {
+        int32_t narrowed = (int32_t)value;
+        memcpy(output + index * 4U, &narrowed, sizeof(narrowed));
+        return PTX_STATUS_OK;
+    }
+    if (dtype == PTX_DTYPE_I64) {
+        memcpy(output + index * 8U, &value, sizeof(value));
+        return PTX_STATUS_OK;
+    }
+    return PTX_STATUS_BAD_REQUEST;
+}
+
+static int ptx_iota_run(const PtxIotaDescriptor *descriptor, unsigned char *result,
+                        uint64_t count) {
+    uint64_t index;
+    for (index = 0; index < count; ++index) {
+        uint64_t coordinate = (index / descriptor->inner_stride) % descriptor->dimension;
+        int64_t value = descriptor->start + (int64_t)coordinate * descriptor->step;
+        if (ptx_store_integer(descriptor->dtype, result, index, value) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    }
+    return PTX_STATUS_OK;
+}
+
+static int64_t ptx_load_signed(const unsigned char *data, uint64_t offset, uint32_t dtype) {
+    if (dtype == PTX_DTYPE_I8) {
+        int8_t value; memcpy(&value, data + offset, sizeof(value)); return (int64_t)value;
+    }
+    if (dtype == PTX_DTYPE_I16) {
+        int16_t value; memcpy(&value, data + offset, sizeof(value)); return (int64_t)value;
+    }
+    if (dtype == PTX_DTYPE_I32) {
+        int32_t value; memcpy(&value, data + offset, sizeof(value)); return (int64_t)value;
+    }
+    {
+        int64_t value; memcpy(&value, data + offset, sizeof(value)); return value;
+    }
+}
+
+static uint64_t ptx_load_unsigned(const unsigned char *data, uint64_t offset, uint32_t dtype) {
+    if (dtype == PTX_DTYPE_BOOL || dtype == PTX_DTYPE_U8) return data[offset];
+    if (dtype == PTX_DTYPE_U16) {
+        uint16_t value; memcpy(&value, data + offset, sizeof(value)); return value;
+    }
+    if (dtype == PTX_DTYPE_U32) {
+        uint32_t value; memcpy(&value, data + offset, sizeof(value)); return value;
+    }
+    {
+        uint64_t value; memcpy(&value, data + offset, sizeof(value)); return value;
+    }
+}
+
+static float ptx_load_float(const unsigned char *data, uint64_t offset, uint32_t dtype) {
+    if (dtype == PTX_DTYPE_BF16) {
+        uint16_t bits; memcpy(&bits, data + offset, sizeof(bits));
+        return ptx_bf16_to_f32(bits);
+    }
+    {
+        float value; memcpy(&value, data + offset, sizeof(value)); return value;
+    }
+}
+
+static int ptx_predicate_satisfied(uint32_t predicate, int comparison) {
+    /* comparison: -1 left<right, 0 equal, 1 left>right, 2 unordered (NaN) */
+    if (predicate == PTX_PREDICATE_EQ) return comparison == 0;
+    if (predicate == PTX_PREDICATE_NE) return comparison != 0;
+    if (comparison > 1) return 0; /* NaN fails every ordered predicate */
+    if (predicate == PTX_PREDICATE_LT) return comparison < 0;
+    if (predicate == PTX_PREDICATE_LE) return comparison <= 0;
+    if (predicate == PTX_PREDICATE_GT) return comparison > 0;
+    return comparison >= 0;
+}
+
+static int ptx_float_comparison(float left, float right) {
+    if (left < right) return -1;
+    if (left > right) return 1;
+    if (left == right) return 0;
+    return 2;
+}
+
+static int ptx_compare_run(const PtxCompareDescriptor *descriptor,
+                           const unsigned char *payload, size_t descriptor_bytes,
+                           unsigned char *result, uint64_t count) {
+    const unsigned char *left_data = payload + descriptor_bytes;
+    const unsigned char *right_data =
+        left_data + descriptor->left_elements * ptx_dtype_item_size(descriptor->left_dtype);
+    uint64_t coordinates[PTX_CONTROL_MAX_RANK];
+    uint64_t index;
+    memset(coordinates, 0, sizeof(coordinates));
+    for (index = 0; index < count; ++index) {
+        uint64_t left_offset = ptx_linear_offset(coordinates, descriptor->left_strides,
+                                                 descriptor->rank);
+        uint64_t right_offset = ptx_linear_offset(coordinates, descriptor->right_strides,
+                                                  descriptor->rank);
+        int comparison;
+        if (ptx_is_float_dtype(descriptor->left_dtype)) {
+            comparison = ptx_float_comparison(
+                ptx_load_float(left_data, left_offset * ptx_dtype_item_size(descriptor->left_dtype),
+                               descriptor->left_dtype),
+                ptx_load_float(right_data, right_offset * ptx_dtype_item_size(descriptor->right_dtype),
+                               descriptor->right_dtype));
+        } else if (ptx_is_signed_integer_dtype(descriptor->left_dtype)) {
+            int64_t left = ptx_load_signed(left_data,
+                left_offset * ptx_dtype_item_size(descriptor->left_dtype), descriptor->left_dtype);
+            int64_t right = ptx_load_signed(right_data,
+                right_offset * ptx_dtype_item_size(descriptor->right_dtype), descriptor->right_dtype);
+            comparison = left < right ? -1 : (left > right ? 1 : 0);
+        } else {
+            uint64_t left = ptx_load_unsigned(left_data,
+                left_offset * ptx_dtype_item_size(descriptor->left_dtype), descriptor->left_dtype);
+            uint64_t right = ptx_load_unsigned(right_data,
+                right_offset * ptx_dtype_item_size(descriptor->right_dtype), descriptor->right_dtype);
+            comparison = left < right ? -1 : (left > right ? 1 : 0);
+        }
+        result[index] = ptx_predicate_satisfied(descriptor->predicate, comparison) ? 1U : 0U;
+        ptx_odometer_advance(coordinates, descriptor->output_shape, descriptor->rank);
+    }
+    return PTX_STATUS_OK;
+}
+
+static int ptx_broadcast_run(const PtxExpandDescriptor *descriptor,
+                             const unsigned char *input, unsigned char *result,
+                             uint64_t count) {
+    uint64_t coordinates[PTX_CONTROL_MAX_RANK];
+    uint64_t index;
+    size_t item = ptx_dtype_item_size(descriptor->dtype);
+    memset(coordinates, 0, sizeof(coordinates));
+    for (index = 0; index < count; ++index) {
+        uint64_t offset = ptx_linear_offset(coordinates, descriptor->input_strides,
+                                            descriptor->rank);
+        memcpy(result + index * item, input + offset * item, item);
+        ptx_odometer_advance(coordinates, descriptor->output_shape, descriptor->rank);
+    }
+    return PTX_STATUS_OK;
+}
+
+static int ptx_where_run(const PtxWhereDescriptor *descriptor, const unsigned char *payload,
+                         size_t descriptor_bytes, unsigned char *result, uint64_t count) {
+    size_t item = ptx_dtype_item_size(descriptor->output_dtype);
+    const unsigned char *condition = payload + descriptor_bytes;
+    const unsigned char *true_data = condition + descriptor->condition_elements;
+    const unsigned char *false_data = true_data + descriptor->true_elements * item;
+    uint64_t coordinates[PTX_CONTROL_MAX_RANK];
+    uint64_t index;
+    memset(coordinates, 0, sizeof(coordinates));
+    for (index = 0; index < count; ++index) {
+        uint64_t condition_offset = ptx_linear_offset(coordinates,
+            descriptor->condition_strides, descriptor->rank);
+        uint64_t true_offset = ptx_linear_offset(coordinates,
+            descriptor->true_strides, descriptor->rank);
+        uint64_t false_offset = ptx_linear_offset(coordinates,
+            descriptor->false_strides, descriptor->rank);
+        const unsigned char *selected = condition[condition_offset]
+            ? true_data + true_offset * item
+            : false_data + false_offset * item;
+        memcpy(result + index * item, selected, item);
+        ptx_odometer_advance(coordinates, descriptor->output_shape, descriptor->rank);
+    }
+    return PTX_STATUS_OK;
+}
