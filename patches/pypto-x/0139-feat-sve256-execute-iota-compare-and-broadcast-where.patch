+def _iota_program(dtype, shape, attributes):
+    output = ValueRef("output", CoreType.tensor(dtype, shape))
+    return _program("iota", (), (output,), (Operation("iota", (), (output,), attributes),))
+
+
+def _compare_program(name, left_type, right_type, output_type, attributes=None):
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("output", output_type)
+    operation = Operation(name, (left, right), (output,), attributes or {})
+    return _program(name, (left, right), (output,), (operation,))
+
+
+def _broadcast_program(input_type, output_type, shape):
+    source = ValueRef("source", input_type)
+    output = ValueRef("output", output_type)
+    operation = Operation("broadcast", (source,), (output,), {"shape": list(shape)})
+    return _program("broadcast", (source,), (output,), (operation,))
+
+
+def _scalar_run_with_scalars(program, inputs, output, scalars):
+    compiler = CpuScalarCompiler()
+    artifact = compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[output.descriptor()],
+            scalars=scalars,
+        )
+    )
