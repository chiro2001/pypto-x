+    descriptor->right_elements = ptx_read_u64(bytes + 40);
+    descriptor->output_elements = ptx_read_u64(bytes + 48);
+    for (axis = 0; axis < rank; ++axis) {
+        descriptor->left_strides[axis] = ptx_read_u64(bytes + 56 + axis * 8U);
+        descriptor->right_strides[axis] = ptx_read_u64(bytes + 56 + (rank + axis) * 8U);
+        descriptor->output_shape[axis] = ptx_read_u64(bytes + 56 + (2U * rank + axis) * 8U);
+    }
+    if (descriptor->left_dtype != descriptor->right_dtype)
+        return PTX_STATUS_BAD_REQUEST;
+    if (!ptx_is_float_dtype(descriptor->left_dtype) &&
+        !ptx_is_integer_dtype(descriptor->left_dtype))
+        return PTX_STATUS_BAD_REQUEST;
+    if (descriptor->predicate > PTX_PREDICATE_GE)
+        return PTX_STATUS_BAD_REQUEST;
+    if (descriptor->left_dtype == PTX_DTYPE_BOOL &&
+        descriptor->predicate != PTX_PREDICATE_EQ &&
+        descriptor->predicate != PTX_PREDICATE_NE)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_validate_shape_product(descriptor->output_shape, rank,
+                                   descriptor->output_elements) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_validate_broadcast_offsets(descriptor->output_shape, descriptor->left_strides,
+                                       rank, descriptor->left_elements) != PTX_STATUS_OK ||
+        ptx_validate_broadcast_offsets(descriptor->output_shape, descriptor->right_strides,
+                                       rank, descriptor->right_elements) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
+    return PTX_STATUS_OK;
+}
