+"""AVX2 W8A8 widening path: contract 0002 C3 / R6 evidence.
+
+Scope of this module:
+
+* the AVX2 capability declaration travels through :class:`CapabilitySet`
+  (``dtypes`` / ``matrix_capabilities``) and is probe-gated fail-closed;
+* the native ``qmatmul_s8s8_s32`` Core IR path is bit-exact with the C1
+  scalar integer golden, including rank-3/rank-4 batch prefixes, the K
+  upper bound and the reserved ``-128`` code point;
+* the native dequantize / single-rounding BF16 epilogue / dynamic per-token
+  quantizer primitives are bit-exact with the C1 goldens through the
+  probe-gated target entry points;
+* the compiled shared object emits AVX2 widening instructions and no
+  EVEX/AVX-512 instructions;
+* the AVX-512 backend still rejects the opcode fail-closed (C4 owns VNNI).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import math
+from pathlib import Path
+import random
+import re
+import shutil
+import struct
+import subprocess
+
+import numpy as np
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.tensor import _cast_value
+from pypto.backends.cpu.x86 import (
+    Avx2Runtime,
+    Avx512Runtime,
+    CpuAvx2ArtifactError,
+    CpuAvx2ExecutionError,
+)
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_avx2 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    NATIVE_ABI_MARKER,
+    W8A8_DEQUANTIZE_S8_KERNEL,
+    W8A8_EPILOGUE_KERNEL,
+    W8A8_KERNEL_VERSION,
+    W8A8_QMATMUL_KERNEL,
+    W8A8_QMATMUL_MODE,
+    Avx2Compiler,
+    w8a8_kernel_contract,
+)
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import (
+    W8A8_MAX_ACCUMULATOR_K,
+    W8A8_QMATMUL_OPCODE,
+)
+from pypto.lowering.cpu.vector import (
+    CpuVectorUnsupportedError,
+    CpuVectorValidationError,
+)
+from pypto.lowering.cpu.x86.avx2 import (
+    AVX2_W8A8_CAPABILITY,
+    AVX2_W8A8_FORBIDDEN_MATRIX_CAPABILITIES,
+    W8A8_MATRIX_CAPABILITY,
+    Avx2Capability,
+    avx2_w8a8_capabilities,
+)
+from pypto.lowering.cpu.x86.avx512 import Avx512UnsupportedError
+from pypto.portable.qwen35_w8a8_scheme import (
+    OPCODE_DEQUANTIZE_EPILOGUE_BF16,
+    OPCODE_DEQUANTIZE_S8,
+    OPCODE_QMATMUL_S8S8_S32,
+    OPCODE_QUANTIZE_PER_TOKEN_S8,
+    W8A8QuantizationError,
+    dequantize_epilogue_bf16,
+    dequantize_s8,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+from pypto.target import TargetSpec, UnsupportedCapabilityError
+
+
+AVX2_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    features=("avx", "avx2", "osxsave", "ymm"),
+    attributes={"lane_count": 8},
+)
+AVX512_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+)
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+
+_ARTIFACT_CACHE = {}
+
+
+# --------------------------------------------------------------------------
+# helpers
+# --------------------------------------------------------------------------
+
+
+def _qmatmul_program(left_shape, right_shape, name=W8A8_QMATMUL_OPCODE):
+    left = ValueRef("left", CoreType.tensor("int8", left_shape))
+    right = ValueRef("right", CoreType.tensor("int8", right_shape))
+    output_shape = left_shape[:-2] + (left_shape[-2], right_shape[-1])
+    output = ValueRef("output", CoreType.tensor("int32", output_shape))
+    operation = Operation(name, (left, right), (output,), {})
+    return CoreProgram(
+        functions=(CoreFunction("qmatmul", (left, right), (output,), Region((operation,))),)
+    )
+
+
+def _raw_qmatmul_program(
+    left_shape,
+    right_shape,
+    output_shape,
+    *,
+    left_dtype="int8",
+    right_dtype="int8",
+    output_dtype="int32",
+):
+    left = ValueRef("left", CoreType.tensor(left_dtype, left_shape))
+    right = ValueRef("right", CoreType.tensor(right_dtype, right_shape))
+    output = ValueRef("output", CoreType.tensor(output_dtype, output_shape))
+    operation = Operation(W8A8_QMATMUL_OPCODE, (left, right), (output,), {})
+    return CoreProgram(
+        functions=(CoreFunction("qmatmul", (left, right), (output,), Region((operation,))),)
+    )
+
+
+def _cast_program(source_dtype, target_dtype, shape):
+    source = ValueRef("source", CoreType.tensor(source_dtype, shape))
+    output = ValueRef("output", CoreType.tensor(target_dtype, shape))
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "cast", (source,), (output,), Region((Operation("cast", (source,), (output,), {"dtype": target_dtype}),))
+            ),
+        )
+    )
+
+
+def _compile_avx2_artifact(program, build_dir, name="w8a8"):
+    key = (name, program.canonical_json())
+    cached = _ARTIFACT_CACHE.get(key)
+    if cached is None:
+        compiler = Avx2Compiler()
+        target_ir = compiler.lower(program, AVX2_TARGET)
+        cached = compiler.compile(
+            target_ir,
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx2",
+                extra={"build_dir": str(Path(build_dir) / name)},
+            ),
+        )
+        _ARTIFACT_CACHE[key] = cached
+    return cached
+
+
+def _avx2_runtime():
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2/YMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _launch(artifact, inputs, outputs, runtime):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[value.descriptor() for value in outputs],
+            scalars={},
+        )
+    )
+
+
+def _flat(value):
+    if isinstance(value, (list, tuple)):
+        result = []
+        for item in value:
+            result.extend(_flat(item))
+        return result
+    return [value]
+
+
+def _f32_round(value):
+    return float(_cast_value(float(value), "float32"))
+
+
+def _f32_bits(value):
+    return struct.unpack("<I", struct.pack("<f", float(value)))[0]
+
+
+def _random_int_codes(shape, rng):
+    return rng.integers(-127, 128, size=shape).tolist()
+
+
+@pytest.fixture(scope="module")
+def build_dir(tmp_path_factory):
+    _avx2_runtime()
+    return tmp_path_factory.mktemp("w8a8-avx2")
+
+
+@pytest.fixture(scope="module")
+def carrier_artifact(build_dir):
+    return _compile_avx2_artifact(_qmatmul_program((2, 3), (3, 4)), build_dir, name="carrier")
+
+
+# --------------------------------------------------------------------------
+# capability declaration (CapabilitySet, not loose booleans)
+# --------------------------------------------------------------------------
+
+
+def test_capability_set_declares_dtypes_and_widening_matrix_kind():
+    assert AVX2_W8A8_CAPABILITY.dtypes == ("int8", "int32", "float32", "bf16")
+    assert AVX2_W8A8_CAPABILITY.matrix_capabilities == (W8A8_MATRIX_CAPABILITY,)
+    assert W8A8_MATRIX_CAPABILITY == "s8s8_s32_widening"
+    assert AVX2_W8A8_CAPABILITY.supports_dtype("int8")
+    assert AVX2_W8A8_CAPABILITY.supports_dtype("int32")
+    assert not AVX2_W8A8_CAPABILITY.supports_dtype("float16")
+    assert AVX2_W8A8_CAPABILITY.supports_matrix(W8A8_MATRIX_CAPABILITY)
+    # AVX2 has no VNNI/dot-product matrix capability: those names must never
+    # appear in this declaration (C4 owns the AVX-512 VNNI comparison).
+    for forbidden in AVX2_W8A8_FORBIDDEN_MATRIX_CAPABILITIES:
+        assert not AVX2_W8A8_CAPABILITY.supports_matrix(forbidden)
+    # The CapabilitySet fingerprint is a stable sha256 text digest.
+    assert len(AVX2_W8A8_CAPABILITY.fingerprint) == 64
+    assert AVX2_W8A8_CAPABILITY.fingerprint == AVX2_W8A8_CAPABILITY.fingerprint
+
+
+def test_capability_set_is_probe_gated_fail_closed():
+    good = Avx2Capability.injected_capability(("avx", "avx2", "fma", "osxsave", "ymm"))
+    assert avx2_w8a8_capabilities(good) is AVX2_W8A8_CAPABILITY
+    bad = Avx2Capability.injected_capability(("avx",))
+    with pytest.raises(UnsupportedCapabilityError) as caught:
+        avx2_w8a8_capabilities(bad)
+    assert W8A8_MATRIX_CAPABILITY in str(caught.value)
+
+
+def test_w8a8_opcode_names_match_the_c1_portable_constants():
+    assert W8A8_QMATMUL_OPCODE == OPCODE_QMATMUL_S8S8_S32
+    assert OPCODE_DEQUANTIZE_S8 == "dequantize_s8"
+    assert OPCODE_DEQUANTIZE_EPILOGUE_BF16 == "dequantize_epilogue_bf16"
+    assert OPCODE_QUANTIZE_PER_TOKEN_S8 == "quantize_per_token_s8"
+    assert W8A8_MAX_ACCUMULATOR_K == 133144
