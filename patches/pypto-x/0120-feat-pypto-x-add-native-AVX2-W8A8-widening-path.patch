+def _call_w8a8_qmatmul(
+    module: Any,
+    left: _NativeBuffer,
+    right: _NativeBuffer,
+    destination: _NativeBuffer,
+    m: int,
+    k: int,
+    n: int,
+) -> None:
+    """Run the native AVX2 s8 x s8 -> s32 widening kernel.
+
+    The kernel returns ``-1`` when either operand contains the reserved
+    ``-128`` code point; that is a fail-closed scheme violation, not a value
+    that may be clamped silently.
+    """
+
+    function = _status_symbol(
+        module,
+        "ptx_avx2_qmatmul_s8s8_s32",
+        [
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_int32),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    status = int(function(left.pointer, right.pointer, destination.pointer, m, k, n))
+    if status != 0:
+        raise CpuAvx2ExecutionError(
+            "AVX2 {} rejected reserved int8 code -128 (status {})".format(
+                W8A8_QMATMUL_OPCODE, status
+            )
+        )
+
+
+def _call_w8a8_dequantize_s8(
+    module: Any,
+    codes: _NativeBuffer,
+    scales: _NativeBuffer,
+    destination: _NativeBuffer,
+    rows: int,
+    k: int,
+) -> None:
+    function = _status_symbol(
+        module,
+        W8A8_DEQUANTIZE_S8_KERNEL,
+        [
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    status = int(function(codes.pointer, scales.pointer, destination.pointer, rows, k))
+    if status == -3:
+        raise CpuAvx2ExecutionError(
+            "AVX2 dequantize_s8 product overflows binary32; refusing to return inf"
+        )
+    if status != 0:
+        raise CpuAvx2ExecutionError(
+            "AVX2 dequantize_s8 rejected reserved int8 code -128 (status {})".format(status)
+        )
+
+
+def _call_w8a8_epilogue(
+    module: Any,
+    accumulator: _NativeBuffer,
+    row_scales: _NativeBuffer,
+    column_scales: _NativeBuffer,
+    destination: _NativeBuffer,
+    rows: int,
+    columns: int,
+) -> None:
+    function = _status_symbol(
+        module,
+        W8A8_EPILOGUE_KERNEL,
+        [
+            ctypes.POINTER(ctypes.c_int32),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_uint16),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    status = int(
+        function(
+            accumulator.pointer,
+            row_scales.pointer,
+            column_scales.pointer,
+            destination.pointer,
+            rows,
+            columns,
+        )
+    )
+    if status != 0:
+        raise CpuAvx2ExecutionError(
+            "AVX2 dequantize_epilogue_bf16 product overflows binary32; refusing to return inf"
+        )
+
+
+def _call_w8a8_quantize_per_token_s8(
+    module: Any,
+    values: _NativeBuffer,
+    codes: _NativeBuffer,
+    scales: _NativeBuffer,
+    rows: int,
+    k: int,
+) -> int:
+    function = _status_symbol(
+        module,
+        "ptx_avx2_quantize_per_token_s8_f32",
+        [
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.POINTER(ctypes.c_size_t),
+        ],
+    )
+    saturation = ctypes.c_size_t(0)
+    status = int(function(values.pointer, codes.pointer, scales.pointer, rows, k, ctypes.byref(saturation)))
+    if status != 0:
+        raise CpuAvx2ExecutionError(
+            "AVX2 quantize_per_token_s8 native kernel rejected the input (status {})".format(status)
+        )
+    return int(saturation.value)
+
+
+def _w8a8_flatten(values: Any, context: str) -> Tuple[Tuple[Any, ...], Tuple[int, ...]]:
+    """Flatten a regular nested sequence and infer its row-major shape."""
+
+    if isinstance(values, (list, tuple)):
+        if not values:
+            return (), (0,)
+        flat: List[Any] = []
+        child_shape: Optional[Tuple[int, ...]] = None
+        for index, item in enumerate(values):
+            item_flat, item_shape = _w8a8_flatten(item, "{}[{}]".format(context, index))
+            if child_shape is None:
+                child_shape = item_shape
+            elif item_shape != child_shape:
+                raise CpuAvx2ExecutionError(
+                    "{} is ragged: {} != {}".format(context, item_shape, child_shape)
+                )
+            flat.extend(item_flat)
+        assert child_shape is not None
+        return tuple(flat), (len(values),) + child_shape
+    return (values,), ()
+
+
+def _w8a8_declared_shape(
+    values: Any,
+    shape: Optional[Sequence[int]],
+    context: str,
+) -> Tuple[Tuple[Any, ...], Tuple[int, ...]]:
+    flat, inferred = _w8a8_flatten(values, context)
+    if shape is None:
+        return flat, inferred
+    try:
+        declared = tuple(int(dimension) for dimension in shape)
+    except (TypeError, ValueError) as exc:
+        raise CpuAvx2ExecutionError(
+            "{} shape must be a sequence of integers".format(context)
+        ) from exc
+    for index, dimension in enumerate(declared):
+        if isinstance(dimension, bool) or dimension < 0:
+            raise CpuAvx2ExecutionError(
+                "{} shape[{}] must be a non-negative integer".format(context, index)
+            )
+    product = 1
+    for dimension in declared:
+        product *= dimension
+    if product != len(flat):
+        raise CpuAvx2ExecutionError(
+            "{} shape {} does not match {} flattened elements".format(context, declared, len(flat))
+        )
+    return flat, declared
+
+
+def _w8a8_int_codes(flat: Sequence[Any], context: str) -> Tuple[int, ...]:
+    codes = []
+    for index, code in enumerate(flat):
+        if isinstance(code, bool) or not isinstance(code, int):
+            raise CpuAvx2ExecutionError("{}[{}] must be an integer code".format(context, index))
+        if code < -127 or code > 127:
+            raise CpuAvx2ExecutionError(
+                "{}[{}]={} outside [-127, 127]".format(context, index, code)
+            )
+        codes.append(code)
+    return tuple(codes)
+
