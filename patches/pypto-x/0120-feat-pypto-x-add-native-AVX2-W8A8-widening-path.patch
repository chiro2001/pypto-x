+@pytest.mark.parametrize("rows,columns", ((1, 1), (2, 3), (3, 8), (5, 17), (4, 9), (2, 32)))
+def test_epilogue_matches_the_golden_bf16_bits(rows, columns, carrier_artifact):
+    rng = random.Random(777 + rows * 13 + columns)
