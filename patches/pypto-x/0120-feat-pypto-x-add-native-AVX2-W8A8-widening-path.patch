+@pytest.mark.parametrize(
+    "left_shape,right_shape",
+    (
+        ((2, 3), (3, 4)),
+        ((1, 8), (8, 1)),
+        ((3, 8), (8, 9)),
+        ((7, 1), (1, 6)),
+        ((2, 3, 4), (2, 4, 5)),
+        ((1, 2, 8, 4), (1, 2, 4, 3)),
+        ((2, 1, 4, 3), (2, 1, 3, 2)),
+        ((1, 1, 1, 1), (1, 1, 1, 1)),
+    ),
+)
+def test_qmatmul_matches_the_integer_golden_bit_for_bit(left_shape, right_shape, build_dir):
+    rng = np.random.default_rng(20260911)
+    left = _random_int_codes(left_shape, rng)
+    right = _random_int_codes(right_shape, rng)
+    expected = qmatmul_s8s8_s32(left, right)
+    program = _qmatmul_program(left_shape, right_shape)
+    artifact = _compile_avx2_artifact(
+        program, build_dir, name="golden-{}-{}".format(left_shape, right_shape)
+    )
+    left_host = HostTensor("int8", left_shape, _flat(left))
+    right_host = HostTensor("int8", right_shape, _flat(right))
+    actual = HostTensor.zeros("int32", expected.shape)
+    _launch(artifact, [left_host, right_host], [actual], _avx2_runtime())
+    assert tuple(int(value) for value in actual.data) == tuple(expected.values)
