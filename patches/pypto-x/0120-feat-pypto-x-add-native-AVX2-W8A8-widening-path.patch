+def _buffer_pointer(buffer: _NativeBuffer, element_offset: int) -> Any:
+    """Return a typed pointer advanced by ``element_offset`` elements."""
+
+    if element_offset < 0:
+        raise CpuAvx2ExecutionError("buffer element offset must be non-negative")
+    if element_offset == 0:
+        return buffer.pointer
+    address = ctypes.cast(buffer.pointer, ctypes.c_void_p).value
+    if address is None:
+        raise CpuAvx2ExecutionError("cannot offset a null native pointer")
+    itemsize = ctypes.sizeof(_ctype(buffer.dtype))
+    return ctypes.cast(address + element_offset * itemsize, _pointer(buffer.dtype))
+
