         return tuple(results)
 
+    # ------------------------------------------------------------------
+    # W8A8 target-specific native entry points (R6 evidence surface).
+    #
+    # These mirror the AVX-512 ``run_vnni_dot_i8`` precedent: they require an
+    # AVX2 artifact so the native ABI marker, payload version and declared
+    # CapabilitySet are validated before any symbol is called.  They are not
+    # public Core opcodes yet; ``qmatmul_s8s8_s32`` additionally has a full
+    # Core IR path through ``launch`` above.
+    # ------------------------------------------------------------------
+
+    def _require_w8a8_declaration(self, artifact: Artifact, declared: Any) -> None:
+        declaration = mapping_copy(artifact.metadata).get("w8a8_capability")
+        if not isinstance(declaration, Mapping):
+            raise CpuAvx2ArtifactError("AVX2 artifact has no W8A8 capability declaration")
+        if declaration.get("digest") != declared.fingerprint:
+            raise CpuAvx2ArtifactError("AVX2 artifact W8A8 capability digest mismatch")
+        if tuple(declaration.get("dtypes", ())) != tuple(declared.dtypes):
+            raise CpuAvx2ArtifactError("AVX2 artifact W8A8 dtype declaration mismatch")
+        if tuple(declaration.get("matrix_capabilities", ())) != tuple(declared.matrix_capabilities):
+            raise CpuAvx2ArtifactError("AVX2 artifact W8A8 matrix capability declaration mismatch")
+
+    def w8a8_capability(self, artifact: Artifact) -> Any:
+        """Return the probe-gated W8A8 :class:`CapabilitySet` for an artifact."""
+
+        capability = self._require_real_capability()
+        declared = _capabilities.avx2_w8a8_capabilities(capability, target=self.name)
+        loaded = self.load(artifact, available_features=capability.features)
+        self._require_w8a8_declaration(loaded.artifact, declared)
+        return declared
+
+    def run_w8a8_qmatmul(
+        self,
+        artifact: Artifact,
+        left: Any,
+        right: Any,
+        *,
+        left_shape: Optional[Sequence[int]] = None,
+        right_shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[int, ...]:
+        """Run the native AVX2 s8 x s8 -> s32 widening kernel."""
+
+        capability = self._require_real_capability()
+        declared = _capabilities.avx2_w8a8_capabilities(capability, target=self.name)
+        loaded = self.load(artifact, available_features=capability.features)
+        self._require_w8a8_declaration(loaded.artifact, declared)
+        left_flat, left_declared = _w8a8_declared_shape(left, left_shape, "qmatmul.left")
+        right_flat, right_declared = _w8a8_declared_shape(right, right_shape, "qmatmul.right")
+        if len(left_declared) != len(right_declared) or len(left_declared) not in (2, 3, 4):
+            raise CpuAvx2ExecutionError(
+                "AVX2 {} operands must have equal rank 2, 3, or 4".format(W8A8_QMATMUL_OPCODE)
+            )
+        if left_declared[:-2] != right_declared[:-2]:
+            raise CpuAvx2ExecutionError(
+                "AVX2 {} operands must have identical batch prefixes".format(W8A8_QMATMUL_OPCODE)
+            )
+        if left_declared[-1] != right_declared[-2]:
+            raise CpuAvx2ExecutionError(
+                "AVX2 {} reduction dimensions do not match".format(W8A8_QMATMUL_OPCODE)
+            )
+        k = left_declared[-1]
+        if k > W8A8_MAX_ACCUMULATOR_K:
+            raise CpuAvx2ExecutionError(
+                "AVX2 {} K={} exceeds the INT32 accumulation limit {}".format(
+                    W8A8_QMATMUL_OPCODE, k, W8A8_MAX_ACCUMULATOR_K
+                )
+            )
+        left_codes = _w8a8_int_codes(left_flat, "qmatmul.left")
+        right_codes = _w8a8_int_codes(right_flat, "qmatmul.right")
+        m = left_declared[-2]
+        n = right_declared[-1]
+        batch_shape = left_declared[:-2]
+        batch_count = 1
+        for dimension in batch_shape:
+            batch_count *= dimension
+        if len(left_codes) != batch_count * m * k or len(right_codes) != batch_count * k * n:
+            raise CpuAvx2ExecutionError("AVX2 {} operand sizes do not match the declared shapes".format(
+                W8A8_QMATMUL_OPCODE
+            ))
+        left_buffer = _buffer_from_values("int8", left_codes, "qmatmul.left")
+        right_buffer = _buffer_from_values("int8", right_codes, "qmatmul.right")
+        output = _buffer_alloc("int32", batch_count * m * n, "qmatmul.output")
+        left_elements = m * k
+        right_elements = k * n
+        output_elements = m * n
+        for batch_index in range(batch_count):
+            _call_w8a8_qmatmul(
+                loaded.module,
+                _NativeBuffer(
+                    left_buffer.dtype,
+                    left_elements,
+                    _buffer_pointer(left_buffer, batch_index * left_elements),
+                    left_buffer.owner,
+                    left_buffer.direct,
+                ),
+                _NativeBuffer(
+                    right_buffer.dtype,
+                    right_elements,
+                    _buffer_pointer(right_buffer, batch_index * right_elements),
+                    right_buffer.owner,
+                    right_buffer.direct,
+                ),
+                _NativeBuffer(
+                    output.dtype,
+                    output_elements,
+                    _buffer_pointer(output, batch_index * output_elements),
+                    output.owner,
+                    output.direct,
+                ),
+                m,
+                k,
+                n,
+            )
+        return tuple(_buffer_values(output))
+
+    def run_w8a8_dequantize_s8(
+        self,
+        artifact: Artifact,
+        codes: Any,
+        scales: Sequence[float],
+        *,
+        shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[float, ...]:
+        """Run the native AVX2 ``dequantize_s8`` diagnostic primitive."""
+
+        capability = self._require_real_capability()
+        declared = _capabilities.avx2_w8a8_capabilities(capability, target=self.name)
+        loaded = self.load(artifact, available_features=capability.features)
+        self._require_w8a8_declaration(loaded.artifact, declared)
+        flat, declared_shape = _w8a8_declared_shape(codes, shape, "dequantize_s8.codes")
+        if len(declared_shape) < 1:
+            raise CpuAvx2ExecutionError("AVX2 dequantize_s8 requires at least a 1-D input")
+        k = declared_shape[-1]
+        rows = 1
+        for dimension in declared_shape[:-1]:
+            rows *= dimension
+        if k == 0 or rows == 0:
+            raise CpuAvx2ExecutionError("AVX2 dequantize_s8 requires non-empty [rows, K]")
+        if len(scales) != rows:
+            raise CpuAvx2ExecutionError(
+                "AVX2 dequantize_s8 expects {} per-row scales, got {}".format(rows, len(scales))
+            )
+        code_values = _w8a8_int_codes(flat, "dequantize_s8.codes")
+        try:
+            scale_values = tuple(float(scale) for scale in scales)
+        except (TypeError, ValueError) as exc:
+            raise CpuAvx2ExecutionError("AVX2 dequantize_s8 scales must be real numbers") from exc
+        codes_buffer = _buffer_from_values("int8", code_values, "dequantize_s8.codes")
+        scales_buffer = _buffer_from_values("float32", scale_values, "dequantize_s8.scales")
+        output = _buffer_alloc("float32", rows * k, "dequantize_s8.output")
+        _call_w8a8_dequantize_s8(loaded.module, codes_buffer, scales_buffer, output, rows, k)
+        return tuple(_buffer_values(output))
