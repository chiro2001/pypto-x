+        uint16_t high = (uint16_t)(converted.bits >> 16);
+        if (converted.bits & 0x007fffffU) return (uint16_t)(high | 0x0040U);
+        return high;
+    }
+    return (uint16_t)((converted.bits + 0x7fffU + ((converted.bits >> 16) & 1U)) >> 16);
