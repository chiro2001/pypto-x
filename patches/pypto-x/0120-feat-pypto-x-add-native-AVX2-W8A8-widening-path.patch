+# --------------------------------------------------------------------------
+# qmatmul_s8s8_s32: native Core IR path
+# --------------------------------------------------------------------------
+
+
+def test_qmatmul_metadata_declares_the_native_widening_kernel(build_dir):
+    program = _qmatmul_program((2, 3), (3, 4))
+    artifact = _compile_avx2_artifact(program, build_dir, name="metadata")
+    assert artifact.metadata["artifact_payload_version"] == ARTIFACT_PAYLOAD_VERSION == 3
+    assert NATIVE_ABI_MARKER == "pypto-x.cpu.avx2:4"
+    assert tuple(artifact.metadata["w8a8_kernel_operations"]) == (W8A8_QMATMUL_OPCODE,)
+    assert artifact.metadata["w8a8_kernel_version"] == W8A8_KERNEL_VERSION == 1
+    declared = artifact.metadata["w8a8_capability"]
+    assert tuple(declared["dtypes"]) == AVX2_W8A8_CAPABILITY.dtypes
+    assert tuple(declared["matrix_capabilities"]) == AVX2_W8A8_CAPABILITY.matrix_capabilities
+    assert declared["digest"] == AVX2_W8A8_CAPABILITY.fingerprint
+    assert declared["isa"] == "avx2_no_vnni"
+    entry = artifact.metadata["w8a8_operations"][0]
+    assert entry["mode"] == W8A8_QMATMUL_MODE
+    assert entry["kernel"] == W8A8_QMATMUL_KERNEL == "ptx_avx2_qmatmul_s8s8_s32"
+    assert artifact.metadata["execution_modes"][0]["mode"] == W8A8_QMATMUL_MODE
+    assert AVX2_TARGET.features  # target contract unchanged
+
