+def _tampered_metadata(artifact, **changes):
+    metadata = {}
+    for key, value in artifact.metadata.items():
+        metadata[key] = dict(value) if isinstance(value, dict) else value
+    metadata.update(changes)
+    return metadata
+
+
+def test_qmatmul_artifact_tampering_fails_closed(carrier_artifact):
+    runtime = _avx2_runtime()
+    original = {key: value for key, value in carrier_artifact.metadata.items()}
+    tampered = _tampered_metadata(carrier_artifact, w8a8_kernel_operations=[])
+    object.__setattr__(carrier_artifact, "metadata", tampered)
+    try:
+        with pytest.raises(CpuAvx2ArtifactError, match="w8a8_kernel_operations"):
+            runtime.load(carrier_artifact)
+    finally:
+        object.__setattr__(carrier_artifact, "metadata", original)
+    declaration = dict(carrier_artifact.metadata["w8a8_capability"])
+    declaration["digest"] = "0" * 64
+    tampered = _tampered_metadata(carrier_artifact, w8a8_capability=declaration)
+    object.__setattr__(carrier_artifact, "metadata", tampered)
+    try:
+        with pytest.raises(CpuAvx2ArtifactError, match="w8a8_capability"):
+            runtime.load(carrier_artifact)
+    finally:
+        object.__setattr__(carrier_artifact, "metadata", original)
+    tampered = _tampered_metadata(carrier_artifact, artifact_payload_version=2)
+    object.__setattr__(carrier_artifact, "metadata", tampered)
+    try:
+        with pytest.raises(CpuAvx2ArtifactError, match="payload version"):
+            runtime.load(carrier_artifact)
+    finally:
+        object.__setattr__(carrier_artifact, "metadata", original)
+
