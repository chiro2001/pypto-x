+def _w8a8_qmatmul_value(
+    left: Sequence[Any],
+    left_type: CoreType,
+    right: Sequence[Any],
+    right_type: CoreType,
+    output_type: CoreType,
+) -> List[Any]:
+    """Scalar reference for ``qmatmul_s8s8_s32`` (C3 differential oracle)."""
+
+    left_shape = static_shape(left_type, "qmatmul left")
+    right_shape = static_shape(right_type, "qmatmul right")
+    output_shape = static_shape(output_type, "qmatmul output")
+    if len(left_shape) < 2 or len(left_shape) > 4:
+        raise CpuScalarExecutionError("qmatmul_s8s8_s32 supports rank 2 through rank 4")
+    if len(left_shape) != len(right_shape) or len(left_shape) != len(output_shape):
+        raise CpuScalarExecutionError("qmatmul_s8s8_s32 ranks are inconsistent")
+    if left_shape[:-2] != right_shape[:-2]:
+        raise CpuScalarExecutionError("qmatmul_s8s8_s32 batch prefixes are inconsistent")
+    batch_shape = left_shape[:-2]
+    m, k = left_shape[-2:]
+    right_k, n = right_shape[-2:]
+    if right_k != k or output_shape != batch_shape + (m, n):
+        raise CpuScalarExecutionError("qmatmul_s8s8_s32 shapes are inconsistent")
+    if k > W8A8_MAX_ACCUMULATOR_K:
+        raise CpuScalarExecutionError(
+            "qmatmul_s8s8_s32 K={} exceeds the INT32 accumulation limit {}".format(
+                k, W8A8_MAX_ACCUMULATOR_K
+            )
+        )
+    batch_count = element_count(batch_shape)
+    left_matrix_elements = m * k
+    right_matrix_elements = k * n
+    if len(left) != batch_count * left_matrix_elements or len(right) != batch_count * right_matrix_elements:
+        raise CpuScalarExecutionError("qmatmul_s8s8_s32 input storage length mismatch")
+    for index, code in enumerate(left):
+        if code == -128:
+            raise CpuScalarExecutionError(
+                "qmatmul_s8s8_s32 left[{}] uses the reserved -128 code point".format(index)
+            )
+    for index, code in enumerate(right):
+        if code == -128:
+            raise CpuScalarExecutionError(
+                "qmatmul_s8s8_s32 right[{}] uses the reserved -128 code point".format(index)
+            )
+    output = []
+    for batch_index in range(batch_count):
+        left_base = batch_index * left_matrix_elements
+        right_base = batch_index * right_matrix_elements
+        for row in range(m):
+            for column in range(n):
+                aggregate = 0
+                for inner in range(k):
+                    aggregate += (
+                        int(left[left_base + row * k + inner])
+                        * int(right[right_base + inner * n + column])
+                    )
+                output.append(aggregate)
+    return output
+
+
 def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
