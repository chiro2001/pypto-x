+int ptx_avx2_qmatmul_s8s8_s32(const int8_t *restrict left,
+                              const int8_t *restrict right,
+                              int32_t *restrict output,
+                              size_t m, size_t k, size_t n) {
+    size_t row, column, index, element;
+    for (element = 0; element < m * k; ++element)
+        if (left[element] == INT8_MIN) return -1;
+    for (element = 0; element < k * n; ++element)
+        if (right[element] == INT8_MIN) return -1;
+    for (row = 0; row < m; ++row) {
+        const int8_t *left_row = left + row * k;
+        int32_t *output_row = output + row * n;
+        for (column = 0; column < n; ++column) output_row[column] = 0;
+        index = 0;
+        for (; index + 2 <= k; index += 2) {
+            __m256i pair = _mm256_set1_epi32(
+                (int32_t)((uint32_t)(uint16_t)(int16_t)left_row[index]
+                          | ((uint32_t)(uint16_t)(int16_t)left_row[index + 1] << 16)));
+            size_t block = 0;
+            for (; block + 8 <= n; block += 8) {
+                __m128i first = _mm_loadl_epi64((const __m128i *)(right + index * n + block));
+                __m128i second = _mm_loadl_epi64((const __m128i *)(right + (index + 1) * n + block));
+                __m256i wide = _mm256_cvtepi8_epi16(_mm_unpacklo_epi8(first, second));
+                __m256i accumulated = _mm256_loadu_si256((const __m256i *)(output_row + block));
+                _mm256_storeu_si256(
+                    (__m256i *)(output_row + block),
+                    _mm256_add_epi32(accumulated, _mm256_madd_epi16(pair, wide)));
+            }
+            for (; block < n; ++block) {
+                output_row[block] += (int32_t)left_row[index] * (int32_t)right[index * n + block];
+                output_row[block] += (int32_t)left_row[index + 1] * (int32_t)right[(index + 1) * n + block];
+            }
+        }
+        if (index < k) {
+            for (column = 0; column < n; ++column)
