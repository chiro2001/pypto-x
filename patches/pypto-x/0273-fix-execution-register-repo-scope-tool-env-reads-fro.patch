+def test_repository_scope_scan_has_no_unregistered_pyp_to_x_reads():
+    """Static scan scope is repo-wide: python/ + tools/ + scripts/.
+
+    This is the follow-up guard for verify-0046-u4: a repo-scope scan with the
+    verifier's regex + AST semantics (``environ.get``/``environ[...]``/
+    ``getenv``/``setdefault``/``pop``/assignment reads) must find zero
+    unregistered ``PYPTO_X_*`` read names.  The six tooling/evidence names
+    found by that scan are registered in ``EXTRA_ENV_VARS``.
+    """
+
+    assert set(_REPO_SCAN_ROOTS) == {"python", "tools", "scripts"}
+    found = {
+        name: files
+        for name, files in _scan_repository_env_reads().items()
+        if name.startswith("PYPTO_X_")
+    }
+    # Non-vacuous scan: the tooling/evidence reads that forced this test exist.
+    assert "PYPTO_X_VENDOR_EVIDENCE" in found, sorted(found)[:10]
+    assert "PYPTO_X_AOCL_LIB" in found
+    assert "PYPTO_X_WORKTREE" in found
+    registered = set(registered_names())
+    unregistered = {
+        name: sorted(files) for name, files in found.items() if name not in registered
+    }
+    assert not unregistered, "unregistered PYPTO_X_* reads: {}".format(unregistered)
+
+
