+# Repo-scope scan protocol fixed by verify-0046-u4: python/ + tools/ + scripts/
+# with the verifier's dual regex + AST semantics for environ reads.
+_REPO_SCAN_ROOTS = ("python", "tools", "scripts")
+_REPO_SCAN_SKIP_DIRS = frozenset(
+    {".git", "build", "__pycache__", ".pytest_cache", "node_modules", ".mypy_cache", ".tox"}
+)
+_REPO_READ_PATTERNS = (
+    (
+        "environ.get",
+        re.compile(
+            r'(?:os\s*\.\s*)?environ\s*\.\s*get\s*\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'
+        ),
+    ),
+    (
+        "environ[...]",
+        re.compile(
+            r'(?:os\s*\.\s*)?environ\s*\[\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']\s*\]'
+        ),
+    ),
+    (
+        "getenv",
+        re.compile(r'(?:os\s*\.\s*)?getenv\s*\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'),
+    ),
+    (
+        "environ.setdefault",
+        re.compile(
+            r'(?:os\s*\.\s*)?environ\s*\.\s*setdefault\s*\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'
+        ),
+    ),
+    (
+        "environ.pop",
+        re.compile(
+            r'(?:os\s*\.\s*)?environ\s*\.\s*pop\s*\(\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']'
+        ),
+    ),
+    (
+        "environ[...]=",
+        re.compile(
+            r'(?:os\s*\.\s*)?environ\s*\[\s*["\']([A-Za-z_][A-Za-z0-9_]*)["\']\s*\]\s*='
+        ),
+    ),
+)
+
+
+def _environ_expression(node):
+    """True when ``node`` denotes the ``environ`` mapping (verifier parity)."""
+
+    if isinstance(node, ast.Name):
+        return node.id == "environ"
+    if isinstance(node, ast.Attribute):
+        return node.attr == "environ" or _environ_expression(node.value)
+    if isinstance(node, ast.Subscript):
+        return _environ_expression(node.value)
+    if isinstance(node, ast.Call):
+        return _environ_expression(node.func)
+    return False
+
+
+class _EnvReadVisitor(ast.NodeVisitor):
+    def __init__(self):
+        self.findings = []
+
+    def _record(self, name, kind, node):
+        if isinstance(name, str) and name:
+            self.findings.append((name, kind, getattr(node, "lineno", 0)))
+
+    def visit_Call(self, node):
+        function = node.func
+        kind = None
+        if isinstance(function, ast.Attribute) and function.attr in ("get", "setdefault", "pop"):
+            if _environ_expression(function.value):
+                kind = "environ." + function.attr
+        elif isinstance(function, ast.Name) and function.id == "getenv":
+            kind = "getenv"
+        elif isinstance(function, ast.Attribute) and function.attr == "getenv":
+            kind = "getenv"
+        if kind and node.args and isinstance(node.args[0], ast.Constant):
+            self._record(node.args[0].value, kind, node)
+        self.generic_visit(node)
+
+    def visit_Subscript(self, node):
+        if _environ_expression(node.value) and isinstance(node.slice, ast.Constant):
+            self._record(node.slice.value, "environ.subscript", node)
+        self.generic_visit(node)
+
+    def visit_Assign(self, node):
+        for target in node.targets:
+            if isinstance(target, ast.Subscript) and _environ_expression(target.value):
+                if isinstance(target.slice, ast.Constant):
+                    self._record(target.slice.value, "environ.assign", target)
+        self.generic_visit(node)
+
+
+def _scan_repository_env_reads():
+    """Return ``{name: {"<relative path>:<line>", ...}}`` for the repo scope."""
+
+    found = {}
+    for root in _REPO_SCAN_ROOTS:
+        root_path = REPOSITORY_ROOT / root
+        for path in root_path.rglob("*.py"):
+            relative = path.relative_to(REPOSITORY_ROOT)
+            if any(part in _REPO_SCAN_SKIP_DIRS for part in relative.parts):
+                continue
+            text = path.read_text(encoding="utf-8", errors="replace")
+            for _kind, pattern in _REPO_READ_PATTERNS:
+                for match in pattern.finditer(text):
+                    line = text.count("\n", 0, match.start()) + 1
+                    found.setdefault(match.group(1), set()).add(
+                        "{}:{}".format(relative.as_posix(), line)
+                    )
+            try:
+                parsed = ast.parse(text, filename=str(path))
+            except SyntaxError:
+                continue
+            visitor = _EnvReadVisitor()
+            visitor.visit(parsed)
+            for name, _kind, line in visitor.findings:
+                found.setdefault(name, set()).add(
+                    "{}:{}".format(relative.as_posix(), line)
+                )
+    return found
+
 
