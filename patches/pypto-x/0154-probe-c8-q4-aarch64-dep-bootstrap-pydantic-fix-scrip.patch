 scripts (env build incomplete)

---
 scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh       |  3 ++-
 scripts/c8_axis_b_probe/17_a3_fix_pydantic_and_run.sh | 25 +++++++++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh b/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh
index 4eb576512..0f6cf5966 100644
--- a/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh
+++ b/scripts/c8_axis_b_probe/16_a3_bootstrap_deps.sh
@@ -17,7 +17,7 @@ mkdir -p "$PIP_CACHE_DIR" "$TMPDIR" "$RUN/logs"
 
 echo "### A3 minimal dep bootstrap $(date -u +%Y-%m-%dT%H:%M:%SZ)"
 for i in $(seq 1 50); do
-    out="$("$PY" -c 'import vllm' 2>&1)"
+    out="$("$PY" -c 'import vllm; import vllm.distributed.parallel_state; from vllm.model_executor.layers.linear import ReplicatedLinear; from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import CompressedTensorsConfig; from vllm import _custom_ops' 2>&1)"
     rc=$?
     if [[ $rc -eq 0 ]]; then
         echo "IMPORT_OK after $((i-1)) installs"
@@ -32,6 +32,7 @@ for i in $(seq 1 50); do
     pkg="${mod%%.*}"
     case "$pkg" in
         cv2) pkg=opencv-python-headless ;;
+        zmq) pkg=pyzmq ;;
         yaml) pkg=PyYAML ;;
         PIL) pkg=pillow ;;
         google) pkg=protobuf ;;
diff --git a/scripts/c8_axis_b_probe/17_a3_fix_pydantic_and_run.sh b/scripts/c8_axis_b_probe/17_a3_fix_pydantic_and_run.sh
new file mode 100644
index 000000000..c2e3bf40e
--- /dev/null
+++ b/scripts/c8_axis_b_probe/17_a3_fix_pydantic_and_run.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# A3 follow-up: fix the pydantic / pydantic-core pair (broken by --no-deps
+# bootstrap), then run the cross-architecture single-layer probe.
+set -uo pipefail
+BASE="$HOME/pypto-x-a3"
+RUN="$BASE/c8axisb"
+VENV="$BASE/envs/pypto-x-c8-axisb"
+PY="$VENV/bin/python"
+PIP="$VENV/bin/pip"
+export PIP_CACHE_DIR="$RUN/pip-cache"
+export TMPDIR="$RUN/tmp"
+mkdir -p "$RUN/logs"
+
+echo "### A3 pydantic fix + probe $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+timeout 300 "$PIP" install --no-input --no-deps "pydantic==2.13.5" "pydantic-core==2.46.5" 2>&1 | tail -3
+"$PY" -c "import pydantic, pydantic_core; print('pydantic', pydantic.VERSION, 'core', pydantic_core.__version__)" 2>&1 | tail -2
+
+timeout 1200 "$PY" "$RUN/scripts/14_a3_cpu_probe.py" \
+    --artifact-npz "$RUN/artifact/our_artifact_subset.npz" \
+    --x86-outputs "$RUN/artifact/vllm_cpu_layer_probe_outputs.npz" \
+    --out-json "$RUN/logs/17_a3_cpu_probe.json" \
+    > "$RUN/logs/17_a3_cpu_probe.stdout.log" 2>&1
+echo "probe_rc=$?"
+tail -30 "$RUN/logs/17_a3_cpu_probe.stdout.log"
+echo "### done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
