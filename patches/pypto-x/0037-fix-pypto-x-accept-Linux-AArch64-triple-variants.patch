From 5e42eed7c432034db02c2d339e67789afd419ae9 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Tue, 8 Sep 2026 13:47:43 +0800
Subject: [PATCH 037/134] fix(pypto-x): accept Linux AArch64 triple variants

---
 python/pypto/compiler/targets/cpu_sve256.py       |  6 ++++-
 python/pypto/lowering/cpu/aarch64/sve/lowering.py |  6 ++++-
 python/tests/ut/pypto_x/test_cpu_sve256.py        | 54 ++++++++++++++++++++++++++++++++++++++++++-
 3 files changed, 63 insertions(+), 3 deletions(-)

diff --git a/python/pypto/compiler/targets/cpu_sve256.py b/python/pypto/compiler/targets/cpu_sve256.py
index 5f4620d63..b751d9b01 100644
--- a/python/pypto/compiler/targets/cpu_sve256.py
+++ b/python/pypto/compiler/targets/cpu_sve256.py
@@ -660,7 +660,11 @@ def _compiler_info(compiler_path: str) -> tuple:
     )
     triple = triple_result.stdout.strip() or "unknown"
     parts = triple.lower().split("-")
-    if len(parts) < 2 or parts[0] != "aarch64" or parts[1] != "linux":
+    if (
+        len(parts) < 2
+        or parts[0] not in ("aarch64", "arm64")
+        or "linux" not in parts[1:]
+    ):
         raise Sve256CompileError(
             "compiler target triple {!r} is not little-endian Linux AArch64".format(triple)
         )
diff --git a/python/pypto/lowering/cpu/aarch64/sve/lowering.py b/python/pypto/lowering/cpu/aarch64/sve/lowering.py
index 77549e59d..4802d7234 100644
--- a/python/pypto/lowering/cpu/aarch64/sve/lowering.py
+++ b/python/pypto/lowering/cpu/aarch64/sve/lowering.py
@@ -87,7 +87,11 @@ def _is_little_linux_aarch64(triple: str) -> bool:
     if not isinstance(triple, str):
         return False
     parts = triple.strip().lower().split("-")
-    return len(parts) >= 2 and parts[0] == "aarch64" and parts[1] == "linux"
+    return (
+        len(parts) >= 2
+        and parts[0] in ("aarch64", "arm64")
+        and "linux" in parts[1:]
+    )
 
 
 def _normalised_target(target: TargetSpec) -> TargetSpec:
diff --git a/python/tests/ut/pypto_x/test_cpu_sve256.py b/python/tests/ut/pypto_x/test_cpu_sve256.py
index fc1042b59..fd82d69e5 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256.py
@@ -13,6 +13,7 @@ import shutil
 import struct
 import subprocess
 import sys
+import types
 
 import pytest
 
@@ -178,11 +179,39 @@ def test_lowering_uses_eight_lanes_masked_tail_and_omits_sve2():
 
 
 def test_sve_target_is_fixed_little_endian_linux_protocol():
-    for triple in ("aarch64_be-linux-gnu", "aarch64-unknown-linux-gnu", "aarch64-none-elf"):
+    for triple in (
+        "aarch64-linux-gnu",
+        "aarch64-unknown-linux-gnu",
+        "aarch64-none-linux-gnu",
+        "arm64-unknown-linux-gnu",
+    ):
+        lower_sve256(_elementwise(), TargetSpec("cpu", triple, features=("sve",)))
+    for triple in ("aarch64_be-linux-gnu", "aarch64-none-elf", "arm64-apple-darwin"):
         with pytest.raises(Sve256ValidationError, match="little-endian Linux"):
             lower_sve256(_elementwise(), TargetSpec("cpu", triple, features=("sve",)))
 
 
+def test_sve_compiler_triple_accepts_linux_component_anywhere(monkeypatch):
+    import pypto.compiler.targets.cpu_sve256 as compiler_module
+
+    def fake_run(command, **kwargs):
+        if "--version" in command:
+            return types.SimpleNamespace(stdout="clang version test\n")
+        return types.SimpleNamespace(stdout="aarch64-unknown-linux-gnu\n")
+
+    monkeypatch.setattr(compiler_module.subprocess, "run", fake_run)
+    assert compiler_module._compiler_info("fake-clang")[1] == "aarch64-unknown-linux-gnu"
+
+    def fake_big_endian(command, **kwargs):
+        if "--version" in command:
+            return types.SimpleNamespace(stdout="clang version test\n")
+        return types.SimpleNamespace(stdout="aarch64_be-unknown-linux-gnu\n")
+
+    monkeypatch.setattr(compiler_module.subprocess, "run", fake_big_endian)
+    with pytest.raises(Sve256CompileError, match="little-endian Linux"):
+        compiler_module._compiler_info("fake-clang")
+
+
 def test_sve_compiler_rejects_format_and_abi_before_native_compile(tmp_path, monkeypatch):
     compiler = Sve256Compiler()
     target_ir = compiler.lower(_elementwise(), _target("sve"))
@@ -693,6 +722,27 @@ def test_sve_artifact_digest_metadata_and_hardlink_protection(tmp_path):
     with pytest.raises(CpuSve256ArtifactError, match="ELF64|little-endian"):
         Sve256Runtime(execution_mode="qemu").load(fake)
 
+    wrong_machine_path = tmp_path / "wrong-machine.elf"
+    wrong_machine_bytes = bytearray(64)
+    wrong_machine_bytes[:4] = b"\x7fELF"
+    wrong_machine_bytes[4] = 2
+    wrong_machine_bytes[5] = 1
+    struct.pack_into("<H", wrong_machine_bytes, 16, 2)
+    struct.pack_into("<H", wrong_machine_bytes, 18, 62)
+    wrong_machine_path.write_bytes(bytes(wrong_machine_bytes))
+    wrong_machine_metadata = dict(artifact.metadata)
+    wrong_machine_metadata["native_digest"] = hashlib.sha256(wrong_machine_bytes).hexdigest()
+    wrong_machine = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(wrong_machine_path),
+        metadata=wrong_machine_metadata,
+    )
+    with pytest.raises(CpuSve256ArtifactError, match="machine is not AArch64"):
+        Sve256Runtime(execution_mode="qemu").load(wrong_machine)
+
     wrong_target = Artifact(
         format=artifact.format,
         entrypoint=artifact.entrypoint,
@@ -806,6 +856,8 @@ def test_sve_objdump_proves_predicated_sve_and_no_neon(tmp_path):
     instruction_lines = [line for line in function_text.splitlines() if re.search(r"\b[a-f0-9]+\s+", line)]
     assert instruction_lines
     assert "whilelo" in function_text
+    assert re.search(r"\bld1w\b", function_text)
+    assert re.search(r"\bst1w\b", function_text)
     assert re.search(r"\bz[0-9]+\.[sdh]\b", function_text)
     assert re.search(r"\bp[0-9]+\.[bhsd]\b", function_text)
     assert not re.search(r"\b[vq][0-9]+(?:\.[bhsd])?\b", function_text)
