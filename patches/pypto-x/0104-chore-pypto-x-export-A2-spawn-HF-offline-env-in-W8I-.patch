From d86be89baed045ee396fbaad119cef9a25eb3c94 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Thu, 10 Sep 2026 21:32:54 +0800
Subject: [PATCH 104/118] chore(pypto-x): export A2 spawn/HF-offline env in W8I
 orchestrator

---
 tools/a2_vllm_ascend_profiling/run_a2_profiling.sh | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh b/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
index 609a3bbef..0f3c89e98 100755
--- a/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
+++ b/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
@@ -53,6 +53,10 @@ if [[ -f /usr/local/Ascend/nnal/atb/set_env.sh ]]; then
     # shellcheck disable=SC1091
     source /usr/local/Ascend/nnal/atb/set_env.sh
 fi
+# W8H 固化：spawn 避免 fork 后无法 re-initialize NPU；tokenizer/权重一律本地。
+export VLLM_WORKER_MULTIPROC_METHOD=spawn
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
 
 npu_smi() {
     export LD_LIBRARY_PATH="/usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/common:/usr/local/Ascend/driver/lib64/driver:${LD_LIBRARY_PATH:-}"
