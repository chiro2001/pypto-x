+def test_gated_norm_preserves_upstream_bf16_rounding_order():
+    """Check both Core dtype edges and the independent published bit sample."""
+
+    program = build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test")
+    operations = program.functions[0].body.operations
+    by_output = {operation.outputs[0].name: operation for operation in operations}
+    op_index = {
+        operation.outputs[0].name: index
+        for index, operation in enumerate(operations)
+        if operation.outputs
+    }
+    scaled = [
+        operation
+        for operation in operations
+        if operation.outputs and operation.outputs[0].name.endswith("_scaled_bf16")
+    ]
+    assert len(scaled) == 18
+    for operation in scaled:
+        assert operation.outputs[0].type.dtype == "bf16"
+        normalized_bf16_name, weight_name = (ref.name for ref in operation.inputs)
+        normalized_cast = by_output[normalized_bf16_name]
+        weight_broadcast = by_output[weight_name]
+        assert normalized_cast.name == "cast"
+        assert normalized_cast.inputs[0].name.endswith("_normalized")
+        assert normalized_cast.inputs[0].type.dtype == "float32"
+        assert normalized_cast.outputs[0].type.dtype == "bf16"
+        assert weight_broadcast.name == "broadcast"
+        assert weight_broadcast.inputs[0].type.dtype == "bf16"
+        assert weight_broadcast.outputs[0].type.dtype == "bf16"
+        cast_back = next(
+            candidate
+            for candidate in operations
+            if candidate.name == "cast"
+            and candidate.inputs
+            and candidate.inputs[0].name == operation.outputs[0].name
+            and candidate.outputs[0].name.endswith("_gated_norm_f32")
+        )
+        assert cast_back.outputs[0].type.dtype == "float32"
+        gate = by_output[cast_back.outputs[0].name.replace("_gated_norm_f32", "_z_gate")]
+        assert gate.name == "silu"
+        assert gate.outputs[0].type.dtype == "float32"
+        gated = by_output[cast_back.outputs[0].name.replace("_gated_norm_f32", "_gated_core")]
+        assert gated.name == "mul"
+        assert gated.outputs[0].type.dtype == "float32"
+        assert op_index[normalized_cast.outputs[0].name] < op_index[operation.outputs[0].name]
+        assert op_index[weight_broadcast.outputs[0].name] < op_index[operation.outputs[0].name]
+        assert op_index[operation.outputs[0].name] < op_index[cast_back.outputs[0].name]
+        assert op_index[cast_back.outputs[0].name] < op_index[gate.outputs[0].name]
+        assert op_index[gate.outputs[0].name] < op_index[gated.outputs[0].name]
+
+    # Same pure-standard-library BF16-RNE sample used by the independent
+    # acceptance audit.  It must distinguish the old FP32 weight product from
+    # the upstream normalized->BF16->weight->SiLU ordering.
+    x = (0.1234567, -0.2345678, 0.3456789, -0.4567891)
+    weight = (0.8765432, 1.1234567, 0.7654321, 1.2345678)
+    gate = (0.3333, -0.8888, 1.2345, -0.4321)
+    mean = sum(value * value for value in x) / len(x) + 1.0e-6
+    normalized = tuple(value / math.sqrt(mean) for value in x)
+    normalized_bf16 = tuple(_bf16_value(_bf16_bits(value)) for value in normalized)
+    weight_bf16 = tuple(_bf16_value(_bf16_bits(value)) for value in weight)
+    silu = tuple(value / (1.0 + math.exp(-value)) for value in gate)
+    upstream = tuple(
+        _bf16_value(_bf16_bits(normalized_bf16[index] * weight_bf16[index] * silu[index]))
+        for index in range(len(x))
+    )
+    current = tuple(
+        _bf16_value(_bf16_bits(normalized[index] * weight_bf16[index] * silu[index]))
+        for index in range(len(x))
+    )
+    assert [_bf16_bits(value) for value in upstream] == [15752, 15965, 16205, 16027]
+    assert [_bf16_bits(value) for value in current] == [15752, 15966, 16205, 16028]
+    assert max(abs(left - right) for left, right in zip(upstream, current)) == 0.001953125
+    assert upstream != current
+
+
