 from __future__ import annotations
 
+import math
+import struct
+
 from pypto.abi import LaunchRequest
 from pypto.backends.cpu import CpuScalarRuntime, HostTensor
 from pypto.compiler.targets.cpu import CpuScalarCompiler
@@ -58,6 +61,15 @@ def _count(shape):
     return result
 
 
+def _bf16_bits(value):
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    return (bits + 0x7FFF + ((bits >> 16) & 1)) >> 16
+
+
+def _bf16_value(bits):
+    return struct.unpack("<f", struct.pack("<I", int(bits) << 16))[0]
+
+
