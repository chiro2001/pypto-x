+def _chain_case(dtype_root, shapes, *, derive):
+    """Build a cast/transpose parameter-chain program for one root dtype."""
+
+    parameters = []
+    returns = []
+    operations = []
+    inputs = []
+    for index, (m, k, n) in enumerate(shapes):
+        left = ValueRef("left_{}".format(index), CoreType.tensor("float32", (m, k)))
+        root = ValueRef("root_{}".format(index), CoreType.tensor(dtype_root, (n, k)))
+        transposed = ValueRef("transposed_{}".format(index), CoreType.tensor("float32", (k, n)))
+        output = ValueRef("output_{}".format(index), CoreType.tensor("float32", (m, n)))
+        parameters.extend((left, root))
+        if dtype_root == "bf16":
+            cast = ValueRef("cast_{}".format(index), CoreType.tensor("float32", (n, k)))
+            operations.append(Operation("cast", (root,), (cast,), attributes={"dtype": "float32"}))
+            source = cast
+        else:
+            source = root
+        operations.append(
+            Operation("transpose", (source,), (transposed,), attributes={"permutation": (1, 0)})
+        )
+        if derive:
+            zero = ValueRef("zero_{}".format(index), CoreType.tensor("float32", (k, n)))
+            shifted = ValueRef("shifted_{}".format(index), CoreType.tensor("float32", (k, n)))
+            parameters.append(zero)
+            operations.append(Operation("add", (transposed, zero), (shifted,)))
+            right_operand = shifted
+        else:
+            right_operand = transposed
+        operations.append(Operation("matmul", (left, right_operand), (output,)))
+        returns.append(output)
+        inputs.append(HostTensor("float32", (m, k), _values(m * k)))
+        root_values = _values(n * k, 0.5)
+        if dtype_root == "bf16":
+            root_values = [
+                struct.unpack("<f", struct.pack("<I", _bf16_bits(value) << 16))[0]
+                for value in root_values
+            ]
+        inputs.append(HostTensor(dtype_root, (n, k), root_values))
+        if derive:
+            inputs.append(HostTensor.zeros("float32", (k, n)))
+    program = _program(
+        "chain_{}_{}".format(dtype_root, "derive" if derive else "packed"),
+        tuple(parameters),
+        tuple(returns),
+        operations,
+    )
+    outputs = [HostTensor.zeros("float32", (m, n)) for (m, k, n) in shapes]
+    return program, inputs, outputs
+
