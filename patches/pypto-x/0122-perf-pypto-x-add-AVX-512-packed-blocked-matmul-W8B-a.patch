+def _make_shapes_program(shapes, dtype, *, derive):
+    parameters = []
+    returns = []
+    operations = []
+    for index, (m, k, n) in enumerate(shapes):
+        left = ValueRef("left_{}".format(index), CoreType.tensor(dtype, (m, k)))
+        right = ValueRef("right_{}".format(index), CoreType.tensor(dtype, (k, n)))
+        output = ValueRef("output_{}".format(index), CoreType.tensor(dtype, (m, n)))
+        parameters.append(left)
+        parameters.append(right)
+        if derive:
+            zero = ValueRef("zero_{}".format(index), CoreType.tensor(dtype, (k, n)))
+            derived = ValueRef("derived_{}".format(index), CoreType.tensor(dtype, (k, n)))
+            parameters.append(zero)
+            operations.append(Operation("add", (right, zero), (derived,)))
+            right_operand = derived
+        else:
+            right_operand = right
+        operations.append(Operation("matmul", (left, right_operand), (output,)))
+        returns.append(output)
+    return _program("shapes_{}".format(dtype), tuple(parameters), tuple(returns), operations)
+
+
+def _run_shapes(shapes, dtype, target, tmp_path, *, runtime=None, derive):
+    program = _make_shapes_program(shapes, dtype, derive=derive)
+    _, _, artifact = _compile(program, target, tmp_path / ("derive" if derive else "packed"))
+    inputs = []
+    for (m, k, n) in shapes:
+        inputs.append(HostTensor(dtype, (m, k), _values(m * k)))
+        inputs.append(HostTensor(dtype, (k, n), _values(k * n, 0.25)))
+        if derive:
+            inputs.append(HostTensor.zeros(dtype, (k, n)))
+    outputs = [HostTensor.zeros(dtype, (m, n)) for (m, k, n) in shapes]
+    _run(artifact, inputs, outputs, runtime=runtime)
+    return artifact, outputs
+
