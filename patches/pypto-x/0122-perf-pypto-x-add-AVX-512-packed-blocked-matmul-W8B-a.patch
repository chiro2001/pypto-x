+def test_packed_bf16_and_mixed_parameter_chains_are_bitwise_identical(tmp_path):
+    target = _target("avx512f", "avx512bf16", "fma")
+    # bf16 direct right operands (bf16 -> bf16 kernel).
+    packed_artifact, packed_outputs = _run_shapes(
+        BF16_SHAPES, "bf16", target, tmp_path / "bf16", derive=False
+    )
+    _, legacy_outputs = _run_shapes(
+        BF16_SHAPES, "bf16", target, tmp_path / "bf16", derive=True
+    )
+    assert len(packed_artifact.metadata["packed_matmul_operations"]) == len(BF16_SHAPES)
+    for actual, expected in zip(packed_outputs, legacy_outputs):
+        assert actual.flat() == expected.flat()
+
+    # mixed: bf16 parameter -> cast -> transpose -> f32 matmul (the Qwen graph
+    # shape), plus an f32 parameter -> transpose -> f32 matmul.
+    shapes = ((5, 64, 96), (18, 65, 66))
+    for dtype_root, suffix in (("bf16", "mixed"), ("float32", "f32root")):
+        packed_program, packed_inputs, packed_outputs = _chain_case(dtype_root, shapes, derive=False)
+        _, _, packed_artifact = _compile(packed_program, target, tmp_path / suffix)
+        assert len(packed_artifact.metadata["packed_matmul_operations"]) == len(shapes)
+        expected_kernel = (
+            "matmul_packed_bf16_f32" if dtype_root == "bf16" else "matmul_packed_f32"
+        )
+        assert packed_artifact.metadata["packed_matmul_operations"][0]["gemm_kernel"] == expected_kernel
+        _run(packed_artifact, packed_inputs, packed_outputs)
+
+        legacy_program, legacy_inputs, legacy_outputs = _chain_case(dtype_root, shapes, derive=True)
+        _, _, legacy_artifact = _compile(legacy_program, target, tmp_path / (suffix + "_legacy"))
+        assert not legacy_artifact.metadata["packed_matmul_operations"]
+        assert len(legacy_artifact.metadata["matmul_legacy_operations"]) == len(shapes)
+        _run(legacy_artifact, legacy_inputs, legacy_outputs)
+        for actual, expected in zip(packed_outputs, legacy_outputs):
+            assert actual.flat() == expected.flat()
+
+
+def _bf16_bits(value):
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return (bits >> 16) & 0xFFFF
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
