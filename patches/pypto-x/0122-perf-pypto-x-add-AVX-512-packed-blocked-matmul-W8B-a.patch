+        "k": k,
+        "n": n,
+        "source_parameter": name,
+        "source_dtype": root_dtype,
+        "source_shape": [root_shape[0], root_shape[1]],
+        "source_k_stride": int(source_k_stride),
+        "source_n_stride": int(source_n_stride),
+        "chain": list(reversed(chain)),
+        "pack_dtype": pack_dtype,
+        "pack_kernel": pack_kernel,
+        "gemm_kernel": gemm_kernel,
+        "k_tile": PACKED_GEMM_K_TILE,
+        "n_tile": PACKED_GEMM_N_TILE,
+        "layout_version": PACKED_GEMM_LAYOUT_VERSION,
