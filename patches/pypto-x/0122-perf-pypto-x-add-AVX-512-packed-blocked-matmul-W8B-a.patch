+def _packed_dispatch_for(target_ir: Any, program_digest: str) -> Dict[int, dict]:
+    """Cache the immutable packed-plan dispatch per (program, plan) digest.
+
+    The vector plan digest alone does not include SSA parameter names, so the
+    program digest is part of the key; otherwise two programs with identical
+    shapes but different parameter names would share a stale dispatch.
+    """
+
+    digest = "{}:{}".format(program_digest, getattr(target_ir, "plan_digest", ""))
+    with _PACKED_DISPATCH_LOCK:
+        cached = _PACKED_DISPATCH_CACHE.get(digest)
+        if cached is not None:
+            return cached
+    packed, _legacy = packed_matmul_dispatch(target_ir)
+    with _PACKED_DISPATCH_LOCK:
+        if len(_PACKED_DISPATCH_CACHE) >= 8:
+            _PACKED_DISPATCH_CACHE.clear()
+        _PACKED_DISPATCH_CACHE[digest] = packed
+    return packed
+
