+#:
+#: A rank-2 matmul whose right operand is a *parameter-derived* tensor (a chain
+#: of value-preserving ``cast`` / ``transpose`` / ``identity`` operations rooted
+#: in one function parameter) is executed by packing that parameter into the
+#: blocked tile layout once and calling the matching packed kernel.  The
+#: predicate below is shared by the artifact metadata and the runtime, so a
+#: declared packed plan can never silently fall back to the column-block
+#: kernel.  Non-qualifying rank-2 matmuls stay on the legacy ``native_avx512_zmm``
+#: kernel and are enumerated (with a reason) in ``matmul_legacy_operations``.
+PACKED_GEMM_MODE = "native_avx512_packed_matmul"
+PACKED_GEMM_KERNEL_VERSION = 1
+PACKED_GEMM_LAYOUT_VERSION = 1
+PACKED_GEMM_K_TILE = 64
+PACKED_GEMM_N_TILE = 64
+PACKED_GEMM_MAX_THREADS = 6
+_PACKED_GEMM_CHAIN_OPERATIONS = frozenset(("cast", "transpose", "identity"))
