+        return override
+    raw = str(os.environ.get("PYPTO_X_AVX512_WEIGHT_CACHE", "")).strip().lower()
+    if raw in _TRUTHY:
+        return True
+    if raw in _FALSY:
+        return False
+    raise CpuAvx512ExecutionError(
+        "PYPTO_X_AVX512_WEIGHT_CACHE must be one of {} (got {!r})".format(
+            sorted(_TRUTHY | _FALSY), raw
+        )
+    )
