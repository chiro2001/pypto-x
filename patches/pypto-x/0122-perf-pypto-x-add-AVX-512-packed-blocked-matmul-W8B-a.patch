+static size_t ptx_bounded_threads(size_t threads, size_t num_nb, size_t m, size_t k, size_t n) {
+    if (threads > PTX_PACKED_GEMM_MAX_THREADS) threads = PTX_PACKED_GEMM_MAX_THREADS;
+    if (threads < 1 || num_nb <= 1) return 1;
+    if (m * k * n < (size_t)262144) return 1;
