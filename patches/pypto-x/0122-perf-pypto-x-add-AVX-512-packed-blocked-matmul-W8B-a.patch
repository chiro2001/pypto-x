+    # -- packed/blocked rank-2 matmul ----------------------------------
+    def _packed_weight(
+        self,
+        contract: Mapping[str, Any],
+        source: _NativeBuffer,
+        module: Any,
+    ) -> _NativeBuffer:
+        """Pack one parameter-derived right operand (or reuse the opt-in cache)."""
+
+        global _PACKED_WEIGHT_CACHE_BYTES
+        k = int(contract["k"])
+        n = int(contract["n"])
+        packed_dtype = canonical_dtype(contract["pack_dtype"])
+        count = packed_matmul_pack_elements(k, n)
+        address = _buffer_address(source)
+        key = (
+            self._packed_plan_digest,
+            contract["pack_kernel"],
+            contract["gemm_kernel"],
+            contract["source_parameter"],
+            tuple(contract["chain"]),
+            contract["source_dtype"],
+            tuple(contract["source_shape"]),
+            int(contract["source_k_stride"]),
+            int(contract["source_n_stride"]),
+            k,
+            n,
+            packed_dtype,
+            address,
+            int(source.count),
+        )
+        if self._packed_weight_cache_enabled and address is not None:
+            fingerprint = _buffer_sample(source)
+            with _PACKED_WEIGHT_CACHE_LOCK:
+                entry = _PACKED_WEIGHT_CACHE.get(key)
+                if entry is not None and entry["fingerprint"] == fingerprint:
+                    _PACKED_WEIGHT_CACHE_STATS["hits"] += 1
+                    return entry["packed"]
+                if entry is not None:
+                    _PACKED_WEIGHT_CACHE_STATS["invalidations"] += 1
+                    _PACKED_WEIGHT_CACHE_BYTES -= int(entry.get("bytes", 0))
+                    del _PACKED_WEIGHT_CACHE[key]
+        else:
+            fingerprint = None
+        packed = _buffer_alloc(packed_dtype, count, "packed_right")
+        _call_packed_matmul_pack(
+            module,
+            contract["pack_kernel"],
+            source,
+            packed,
+            k,
+            n,
+            int(contract["source_k_stride"]),
+            int(contract["source_n_stride"]),
+        )
+        with _PACKED_WEIGHT_CACHE_LOCK:
+            _PACKED_WEIGHT_CACHE_STATS["packs"] += 1
+            if self._packed_weight_cache_enabled:
+                _PACKED_WEIGHT_CACHE_STATS["misses"] += 1
+                if address is not None:
+                    size = count * ctypes.sizeof(_ctype(packed_dtype))
+                    _packed_weight_cache_evict(size)
+                    _PACKED_WEIGHT_CACHE[key] = {
+                        "packed": packed,
+                        "fingerprint": fingerprint,
+                        "bytes": size,
+                    }
+                    _PACKED_WEIGHT_CACHE_BYTES += size
+        return packed
+
+    def _execute_packed_matmul(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+        environment: Mapping[str, _RuntimeValue],
+    ) -> Mapping[str, _RuntimeValue]:
+        """Run one packed/blocked rank-2 matmul on the shared native module."""
+
+        contract = decision["packed_matmul"]
+        inputs = list(decision["inputs"])
+        if len(inputs) != 2:
+            raise CpuAvx512ArtifactError("AVX-512 packed matmul requires two tensor inputs")
+        output_ref = operation.outputs[0]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        m = int(contract["m"])
+        k = int(contract["k"])
+        n = int(contract["n"])
+        if int(plan.matmul.m) != m or int(plan.matmul.k) != k or int(plan.matmul.n) != n:
+            raise CpuAvx512ArtifactError("AVX-512 packed matmul plan shape changed")
+        left = inputs[0].buffer
+        if canonical_dtype(left.dtype) != dtype or left.count != m * k:
+            raise CpuAvx512ArtifactError(
+                "AVX-512 packed matmul left operand does not match M={} K={}".format(m, k)
+            )
+        source_name = contract["source_parameter"]
+        source_value = environment.get(source_name)
+        if source_value is None:
+            raise CpuAvx512ArtifactError(
+                "AVX-512 packed matmul parameter {!r} is unavailable".format(source_name)
+            )
+        source = source_value.buffer
+        source_shape = tuple(int(dimension) for dimension in contract["source_shape"])
+        if (
+            canonical_dtype(source.dtype) != canonical_dtype(contract["source_dtype"])
+            or source.count != source_shape[0] * source_shape[1]
+        ):
+            raise CpuAvx512ArtifactError(
+                "AVX-512 packed matmul parameter {!r} does not match its contract".format(source_name)
+            )
+        packed = self._packed_weight(contract, source, module)
+        destination = _buffer_alloc(dtype, m * n, output_ref.name)
+        _call_packed_matmul(
+            module,
+            contract["gemm_kernel"],
+            dtype,
+            canonical_dtype(contract["pack_dtype"]),
+            left,
+            packed,
+            destination,
+            m,
+            k,
+            n,
+            int(self._gemm_threads),
+        )
+        return {output_ref.name: _RuntimeValue(output_ref.type, destination)}
