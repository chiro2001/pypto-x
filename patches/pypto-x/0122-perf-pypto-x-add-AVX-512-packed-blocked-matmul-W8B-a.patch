+_PACKED_WEIGHT_CACHE: Dict[Any, Any] = {}
+_PACKED_WEIGHT_CACHE_LOCK = threading.RLock()
+_PACKED_WEIGHT_CACHE_MAX_ENTRIES = 4096
+#: The opt-in cross-launch cache must stay byte-bounded: one model can contain
+#: several graph digests (prefill T shapes plus every decode past_length), and
+#: an unbounded cache would retain a packed copy per digest.
+_PACKED_WEIGHT_CACHE_MAX_BYTES = 2 * 1024 * 1024 * 1024
+_PACKED_WEIGHT_CACHE_BYTES = 0
+_PACKED_WEIGHT_CACHE_STATS: Dict[str, int] = {
+    "packs": 0,
+    "hits": 0,
+    "misses": 0,
+    "invalidations": 0,
+    "evictions": 0,
+}
+_PACKED_DISPATCH_CACHE: Dict[str, Dict[int, dict]] = {}
+_PACKED_DISPATCH_LOCK = threading.RLock()
+_TRUTHY = frozenset(("1", "true", "yes", "on"))
+_FALSY = frozenset(("", "0", "false", "no", "off"))
+
