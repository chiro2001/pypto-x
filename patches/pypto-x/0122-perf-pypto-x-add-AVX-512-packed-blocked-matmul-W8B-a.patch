+def _resolve_gemm_threads(override: Optional[int]) -> int:
+    """Return the bounded packed-matmul thread count (1..6), fail loud."""
+
+    if override is None:
+        raw = os.environ.get("PYPTO_X_AVX512_GEMM_THREADS", "")
+        if not str(raw).strip():
+            return 1
+        try:
+            value = int(str(raw).strip())
+        except (TypeError, ValueError) as exc:
+            raise CpuAvx512ExecutionError(
+                "PYPTO_X_AVX512_GEMM_THREADS must be an integer in [1, {}]".format(
+                    PACKED_GEMM_MAX_THREADS
+                )
+            ) from exc
+    else:
+        if isinstance(override, bool) or not isinstance(override, Integral):
+            raise CpuAvx512ExecutionError("packed matmul threads must be an integer")
+        value = int(override)
+    if value < 1 or value > PACKED_GEMM_MAX_THREADS:
+        raise CpuAvx512ExecutionError(
+            "packed matmul threads must be in [1, {}], got {}".format(
+                PACKED_GEMM_MAX_THREADS, value
+            )
+        )
+    return value
+
