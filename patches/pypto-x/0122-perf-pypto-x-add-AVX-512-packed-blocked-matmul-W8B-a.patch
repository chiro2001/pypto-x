+static void ptx_pack_bf16_impl(const void *source, uint16_t *packed,
+                               size_t k, size_t n,
+                               size_t source_k_stride, size_t source_n_stride,
+                               int source_is_f32) {
+    size_t num_kb = ptx_blocks(k, PTX_PACKED_GEMM_K_TILE);
+    size_t num_nb = ptx_blocks(n, PTX_PACKED_GEMM_N_TILE);
+    size_t nb, kb, pair, nn;
+    for (nb = 0; nb < num_nb; ++nb) {
+        size_t nt = n - nb * PTX_PACKED_GEMM_N_TILE;
+        if (nt > PTX_PACKED_GEMM_N_TILE) nt = PTX_PACKED_GEMM_N_TILE;
+        for (kb = 0; kb < num_kb; ++kb) {
+            size_t kt = k - kb * PTX_PACKED_GEMM_K_TILE;
+            uint16_t *block = packed + (nb * num_kb + kb) * (size_t)PTX_PACKED_GEMM_K_TILE * PTX_PACKED_GEMM_N_TILE;
+            if (kt > PTX_PACKED_GEMM_K_TILE) kt = PTX_PACKED_GEMM_K_TILE;
+            for (pair = 0; pair < PTX_PACKED_GEMM_K_TILE / 2; ++pair) {
+                size_t k0 = kb * PTX_PACKED_GEMM_K_TILE + 2 * pair;
+                uint16_t *dst = block + pair * 2 * PTX_PACKED_GEMM_N_TILE;
+                int first_ok = k0 < k;
+                int second_ok = (k0 + 1) < k;
+                for (nn = 0; nn < PTX_PACKED_GEMM_N_TILE; ++nn) {
+                    size_t ni = nb * PTX_PACKED_GEMM_N_TILE + nn;
+                    uint16_t lo = 0;
+                    uint16_t hi = 0;
+                    if (ni < n) {
+                        size_t offset = ni * source_n_stride;
+                        if (first_ok) {
+                            if (source_is_f32)
+                                lo = ptx_f32_to_bf16(((const float *)source)[k0 * source_k_stride + offset]);
+                            else
+                                lo = ((const uint16_t *)source)[k0 * source_k_stride + offset];
+                        }
+                        if (second_ok) {
+                            if (source_is_f32)
+                                hi = ptx_f32_to_bf16(((const float *)source)[(k0 + 1) * source_k_stride + offset]);
+                            else
+                                hi = ((const uint16_t *)source)[(k0 + 1) * source_k_stride + offset];
+                        }
