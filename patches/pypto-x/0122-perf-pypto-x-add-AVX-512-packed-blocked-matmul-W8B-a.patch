+def test_packed_weight_cache_is_opt_in_and_invalidates(tmp_path):
+    import ctypes
+
+    shapes = ((5, 64, 96),)
+    program = _make_shapes_program(shapes, "float32", derive=False)
+    _, _, artifact = _compile(program, _target("avx512f", "fma"), tmp_path / "cache")
+    left = HostTensor("float32", (5, 64), _values(5 * 64))
+    raw = (ctypes.c_float * (64 * 96))(*_values(64 * 96, 0.25))
+    weight = TensorDesc(
+        "float32", (64, 96), address=ctypes.addressof(raw), readonly=True
+    )
+    runtime_module.clear_packed_weight_cache()
+    runtime = Avx512Runtime(packed_weight_cache=True)
+    before = runtime.packed_weight_cache_stats()
+
+    def _launch():
+        runtime.launch(
+            LaunchRequest(
+                artifact,
+                inputs=[left.descriptor(readonly=True), weight],
+                outputs=[HostTensor.zeros("float32", (5, 96)).descriptor()],
+            )
+        )
+
+    _launch()
+    packed_once = [HostTensor.zeros("float32", (5, 96))]
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[left.descriptor(readonly=True), weight],
+            outputs=[packed_once[0].descriptor()],
+        )
+    )
+    after = runtime.packed_weight_cache_stats()
+    assert after["packs"] - before["packs"] == 1
+    assert after["hits"] - before["hits"] == 1
+    assert after["entries"] == 1
+    # k=64, n=96 -> 2 N-tiles of 64x64 f32 elements
+    assert after["bytes"] == 2 * 64 * 64 * 4
+    # Rebind different content at the same address: the sampled fingerprint must
+    # invalidate the entry and repack.
+    raw[0] = 12345.0
+    rebound = [HostTensor.zeros("float32", (5, 96))]
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[left.descriptor(readonly=True), weight],
+            outputs=[rebound[0].descriptor()],
+        )
+    )
+    invalidated = runtime.packed_weight_cache_stats()
+    assert invalidated["invalidations"] - after["invalidations"] == 1
+    assert invalidated["packs"] - after["packs"] == 1
+    assert rebound[0].flat() != packed_once[0].flat()
+    runtime.clear_packed_weight_cache()
+    assert runtime.packed_weight_cache_stats()["entries"] == 0
+
