+def _buffer_address(buffer: _NativeBuffer) -> Optional[int]:
+    if buffer.count == 0:
+        return None
+    try:
+        return int(ctypes.cast(buffer.pointer, ctypes.c_void_p).value)
+    except (TypeError, ValueError):
+        return None
+
+
+def _buffer_sample(buffer: _NativeBuffer) -> Optional[Tuple[bytes, ...]]:
+    """Cheap content guard for the opt-in cross-launch packed-weight cache.
+
+    The cache contract requires immutable, address-stable source buffers.  The
+    sampled fingerprint catches accidental rebinding at the same address; it is
+    a guard rail, not a proof.  Callers that cannot guarantee immutability must
+    leave the cache disabled (the default).
+    """
+
+    address = _buffer_address(buffer)
+    if address is None:
+        return None
+    element = ctypes.sizeof(_ctype(buffer.dtype))
+    total = int(buffer.count) * element
+    if total <= 0:
+        return None
+    chunks = []
+    step = max(total // 16, 1)
+    for index in range(16):
+        offset = index * step
+        if offset >= total:
+            break
+        size = min(32, total - offset)
+        chunks.append(ctypes.string_at(address + offset, size))
+    return tuple(chunks)
+
