+def _target(*features, lane_count=16):
+    return TargetSpec(
+        "cpu", "x86_64-linux-gnu", features=features, attributes={"lane_count": lane_count}
+    )
+
+
+def _program(name, parameters, returns, operations):
+    return CoreProgram(
+        functions=(CoreFunction(name, parameters, returns, Region(tuple(operations))),)
+    )
+
+
+def _values(count, offset=0.0):
+    return [((index * 37 + 11) % 101 - 50) / 43.0 + offset for index in range(count)]
+
+
+def _compile(program, target, tmp_path, options=None):
+    compiler = Avx512Compiler()
+    target_ir = compiler.lower(program, target)
+    if options is None:
+        options = CompileOptions(
+            artifact_format="pypto-x.cpu.avx512",
+            extra={"build_dir": str(tmp_path / "native")},
+        )
+    return compiler, target_ir, compiler.compile(target_ir, options)
+
+
+def _run(artifact, inputs, outputs, runtime=None, scalars=None):
+    (runtime or Avx512Runtime()).launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[output.descriptor() for output in outputs],
+            scalars=scalars or {},
+        )
+    )
+
