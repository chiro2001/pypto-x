+def test_packed_dispatch_prefers_parameter_chains_on_the_qwen_graph():
+    # The real decoder graph lowers to 187 packed rank-2 matmuls and no legacy
+    # rank-2 matmul; batched attention matmuls keep their own declared mode.
+    import importlib.util
+
+    driver_path = Path(__file__).resolve().parent / "qwen35_weighted_execution_driver.py"
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {
+        name: module
+        for name, module in sys.modules.items()
+        if name == "pypto" or name.startswith("pypto.")
+    }
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        spec = importlib.util.spec_from_file_location("qwen35_driver_packed_test", driver_path)
+        driver = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(driver)
+        from pypto.compiler.targets import cpu_avx512 as local_compiler_module
+        from pypto.target import TargetSpec
+
+        program, _schema, _layout = driver.build_graph(5, 0)
+        target = TargetSpec(
+            "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+        )
+        compiler = local_compiler_module.Avx512Compiler()
+        target_ir = compiler.lower(program, target)
+        packed, legacy = local_compiler_module.packed_matmul_dispatch(target_ir)
+        assert len(packed) == 187
+        assert legacy == {}
+        contracts = list(packed.values())
+        assert {entry["gemm_kernel"] for entry in contracts} == {"matmul_packed_bf16_f32"}
+        sample = contracts[0]
+        assert sample["source_dtype"] == "bf16"
+        assert sample["pack_dtype"] == "bf16"
+        assert sample["chain"] == ["cast", "transpose"]
+        assert sample["source_k_stride"] == 1
+        assert sample["source_n_stride"] == sample["k"]
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
