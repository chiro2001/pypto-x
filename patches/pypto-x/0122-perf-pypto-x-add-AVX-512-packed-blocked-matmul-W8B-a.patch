+_PACKED_GEMM_VARIANTS = {
+    ("float32", "float32"): ("pack_matmul_f32", "matmul_packed_f32", "float32"),
+    ("bf16", "float32"): ("pack_matmul_bf16", "matmul_packed_bf16_f32", "bf16"),
+    ("bf16", "bf16"): ("pack_matmul_bf16", "matmul_packed_bf16", "bf16"),
