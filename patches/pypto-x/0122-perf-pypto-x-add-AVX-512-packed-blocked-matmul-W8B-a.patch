+/* ------------------------------------------------------------------ */
+/* pack kernels                                                       */
+/* ------------------------------------------------------------------ */
+
+void ptx_avx512_pack_matmul_f32(const float *source, float *packed,
+                                size_t k, size_t n,
+                                size_t source_k_stride, size_t source_n_stride) {
+    size_t num_kb = ptx_blocks(k, PTX_PACKED_GEMM_K_TILE);
+    size_t num_nb = ptx_blocks(n, PTX_PACKED_GEMM_N_TILE);
+    size_t nb, kb, kk, nn;
+    for (nb = 0; nb < num_nb; ++nb) {
+        size_t nt = n - nb * PTX_PACKED_GEMM_N_TILE;
+        if (nt > PTX_PACKED_GEMM_N_TILE) nt = PTX_PACKED_GEMM_N_TILE;
+        for (kb = 0; kb < num_kb; ++kb) {
+            size_t kt = k - kb * PTX_PACKED_GEMM_K_TILE;
+            float *block = packed + (nb * num_kb + kb) * (size_t)PTX_PACKED_GEMM_K_TILE * PTX_PACKED_GEMM_N_TILE;
+            if (kt > PTX_PACKED_GEMM_K_TILE) kt = PTX_PACKED_GEMM_K_TILE;
+            for (kk = 0; kk < kt; ++kk) {
+                size_t ki = kb * PTX_PACKED_GEMM_K_TILE + kk;
+                float *dst = block + kk * PTX_PACKED_GEMM_N_TILE;
+                if (source_n_stride == 1 && nt == PTX_PACKED_GEMM_N_TILE) {
+                    const float *src = source + ki * source_k_stride + nb * PTX_PACKED_GEMM_N_TILE;
+                    for (nn = 0; nn < PTX_PACKED_GEMM_N_TILE; ++nn) dst[nn] = src[nn];
+                } else {
+                    for (nn = 0; nn < nt; ++nn)
+                        dst[nn] = source[ki * source_k_stride + (nb * PTX_PACKED_GEMM_N_TILE + nn) * source_n_stride];
+                    for (; nn < PTX_PACKED_GEMM_N_TILE; ++nn) dst[nn] = 0.0f;
+                }
+            }
+            for (; kk < PTX_PACKED_GEMM_K_TILE; ++kk) {
+                memset(block + kk * PTX_PACKED_GEMM_N_TILE, 0, PTX_PACKED_GEMM_N_TILE * sizeof(float));
+            }
+        }
+    }
+}
