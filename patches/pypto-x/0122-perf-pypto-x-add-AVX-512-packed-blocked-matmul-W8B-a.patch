+/* ------------------------------------------------------------------ *
+ * Packed/blocked rank-2 matmul plane (artifact payload version 4).
+ *
+ * The runtime packs parameter-derived right operands once per source
+ * (optionally caching the packed tile across launches) and calls the
+ * matching kernel; the accumulation order per output element is the
+ * legacy k order, so results stay bit-identical to the column-block
+ * kernels above.  Threading is bounded to PTX_PACKED_GEMM_MAX_THREADS
+ * and partitions the N-tile range only, which keeps the result
+ * deterministic.
+ * ------------------------------------------------------------------ */
+#define PTX_PACKED_GEMM_K_TILE 64
+#define PTX_PACKED_GEMM_N_TILE 64
+#define PTX_PACKED_GEMM_MAX_THREADS 6
+
+static inline float ptx_accumulate_scalar(float a, float b, float acc) {
+    return a * b + acc;
+}
+
+static inline size_t ptx_blocks(size_t length, size_t tile) {
+    return length == 0 ? 0 : (length + tile - 1) / tile;
+}
