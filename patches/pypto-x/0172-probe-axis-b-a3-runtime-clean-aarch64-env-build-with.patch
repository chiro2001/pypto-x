From 00e671f70ae178d9e48133f0ca3035b6f2422079 Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:57:11 +0800
Subject: [PATCH 172/217] probe(axis-b-a3-runtime): clean aarch64 env build
 with exact torch 2.13.0+cpu pin

---
 scripts/a3_axis_b_runtime/03_build_env.sh | 151 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 151 insertions(+)

diff --git a/scripts/a3_axis_b_runtime/03_build_env.sh b/scripts/a3_axis_b_runtime/03_build_env.sh
new file mode 100755
index 000000000..0b156647f
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/03_build_env.sh
@@ -0,0 +1,151 @@
+#!/usr/bin/env bash
+# axis-b-a3-runtime 03: build a CLEAN aarch64 env for vllm-cpu 0.29.0 with the
+# exact upstream pin torch==2.13.0+cpu (download.pytorch.org/whl/cpu has the
+# aarch64 cp312 wheel; PyPI/NJU mirror has no +cpu flavor).
+#
+# Fix for Q4 block: Q4 installed each dep with --no-deps, which broke the
+# pydantic / pydantic-core pair and left typing-inspection missing.  Here pip's
+# real resolver installs the whole closure in ONE transaction.
+#
+# Env: $HOME/pypto-x-a3/envs/pypto-x-c8-axisb-t213  (no system-site-packages)
+# Note: A3 wall clock ~366 s slow; log lines are A3-source unless prefixed local.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+LOGS="$RUN/logs"
+RAW="$RUN/raw"
+VENV="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb-t213"
+BASE_PY="$HOME/pypto-x-a3/envs/pypto-x-c8/bin/python"
+WHEEL="$HOME/pypto-x-a3/c8axisb/wheel/vllm_cpu-0.29.0-cp38-abi3-manylinux_2_28_aarch64.whl"
+MIRROR="https://mirror.nju.edu.cn/pypi/web/simple"
+PT_CPU="https://download.pytorch.org/whl/cpu"
+CPUS="${AXISB_CPUS:-600-639}"
+EXIT_FILE="$RUN/03_build_env.exit"
+
+mkdir -p "$LOGS" "$RAW" "$RUN/tmp"
+export PIP_CACHE_DIR="$HOME/pypto-x-a3/c8axisb/pip-cache"   # reuse Q4 download cache
+export TMPDIR="$RUN/tmp"
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+
+log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ) A3] $*"; }
+finish() { rc=$?; echo "$rc" > "$EXIT_FILE"; log "EXIT rc=$rc"; exit "$rc"; }
+trap finish EXIT
+
+log "### 03_build_env (A3 clock source)"
+echo "$VENV" > "$RAW/03_env_path.txt"
+
+if [[ ! -f "$WHEEL" ]]; then log "FATAL wheel missing $WHEEL"; exit 1; fi
+
+log "--- recreate venv (no system-site-packages) ---"
+rm -rf "$VENV"
+"$BASE_PY" -m venv "$VENV" || { log "FATAL venv create failed"; exit 1; }
+PY="$VENV/bin/python"
+PIP="$VENV/bin/pip"
+log "python=$("$PY" -VV 2>&1)"
+
+log "--- [1/4] install torch==2.13.0+cpu (aarch64 cp312) from pytorch cpu index ---"
+t0=$(date +%s)
+timeout 2700 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check --no-deps \
+    --index-url "$PT_CPU" "torch==2.13.0+cpu" 2>&1 | tail -6
+rc_torch=${PIPESTATUS[0]}
+t1=$(date +%s)
+log "torch_install_rc=$rc_torch elapsed_s=$((t1-t0))"
+[[ $rc_torch -eq 0 ]] || { log "FATAL torch install failed"; exit 1; }
+
+log "--- [2/4] install vllm_cpu-0.29.0 wheel (--no-deps) ---"
+timeout 600 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check --no-deps "$WHEEL" 2>&1 | tail -4
+log "vllm_wheel_install_rc=${PIPESTATUS[0]}"
+
+log "--- [3/4] generate resolved requirement list from wheel + torch METADATA ---"
+TORCH_META="$(ls "$VENV"/lib/python3.12/site-packages/torch-*.dist-info/METADATA 2>/dev/null | head -1)"
+log "torch_metadata=$TORCH_META"
+"$BASE_PY" - "$WHEEL" "$TORCH_META" "$RUN/requirements.from_metadata.txt" "$RUN/requirements.install.txt" <<'PY' 2>&1 | tee "$RAW/03_requirement_filter.log"
+import sys, zipfile
+from packaging.requirements import Requirement
+from packaging.markers import default_environment
+wheel, torch_meta, out_all, out_install = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
+
+def meta_requires(path, is_zip):
+    if is_zip:
+        with zipfile.ZipFile(path) as z:
+            name = [n for n in z.namelist() if n.endswith('.dist-info/METADATA')][0]
+            text = z.read(name).decode('utf-8', 'replace')
+    else:
+        with open(path, encoding='utf-8', errors='replace') as fh:
+            text = fh.read()
+    return [l.split(':', 1)[1].strip() for l in text.splitlines() if l.startswith('Requires-Dist:')]
+
+requires = meta_requires(wheel, True)
+n_vllm = len(requires)
+if torch_meta:
+    tr = meta_requires(torch_meta, False)
+    requires += tr
+    print("torch_metadata_requires=", len(tr))
+env = dict(default_environment()); env['extra'] = ''
+with open(out_all, 'w') as fa, open(out_install, 'w') as fi:
+    for line in requires:
+        fa.write(line + '\n')
+        r = Requirement(line)
+        if r.marker is not None and not r.marker.evaluate(env):
+            continue  # extra / platform marker not active here
+        # torch family handled explicitly: torch installed above; vision/audio/codec
+        # are multimodal-only and lack guaranteed aarch64 wheels -> excluded, documented.
+        if r.name.lower() in {'torch', 'torchaudio', 'torchvision', 'torchcodec'}:
+            print(f"[filtered torch-family] {line}")
+            continue
+        fi.write(str(r) + '\n')
+print("vllm_metadata_requires=", n_vllm)
+PY
+log "install_requirements=$(wc -l < "$RUN/requirements.install.txt") lines"
+cat "$RUN/requirements.install.txt" | head -5
+
+log "--- [4/4] single-transaction resolution (dry-run first) ---"
+t0=$(date +%s)
+timeout 1800 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check \
+    --dry-run --report "$RAW/03_dryrun_report.json" \
+    --index-url "$MIRROR" --extra-index-url "$PT_CPU" \
+    -r "$RUN/requirements.install.txt" > "$RAW/03_dryrun.log" 2>&1
+rc_dry=$?
+t1=$(date +%s)
+log "dryrun_rc=$rc_dry elapsed_s=$((t1-t0))"
+tail -25 "$RAW/03_dryrun.log" | sed 's/^/[dryrun] /'
+if [[ $rc_dry -ne 0 ]]; then
+    log "RESOLUTION_FAILED (see raw/03_dryrun.log)"
+    exit 3
+fi
+
+log "--- real install (single pip resolve) ---"
+t0=$(date +%s)
+timeout 3600 taskset -c "$CPUS" "$PIP" install --no-input --disable-pip-version-check \
+    --index-url "$MIRROR" --extra-index-url "$PT_CPU" \
+    -r "$RUN/requirements.install.txt" > "$RAW/03_pip_install.log" 2>&1
+rc_inst=$?
+t1=$(date +%s)
+log "pip_install_rc=$rc_inst elapsed_s=$((t1-t0))"
+tail -20 "$RAW/03_pip_install.log" | sed 's/^/[install] /'
+[[ $rc_inst -eq 0 ]] || { log "FATAL install failed"; exit 4; }
+
+log "--- freeze / disk / import ---"
+taskset -c "$CPUS" "$PIP" freeze --local > "$RAW/03_pip_freeze.txt" 2>/dev/null
+log "freeze_lines=$(wc -l < "$RAW/03_pip_freeze.txt")"
+du -sh "$VENV" > "$RAW/03_venv_du.txt" 2>/dev/null
+cat "$RAW/03_venv_du.txt" | sed 's/^/[du] /'
+{
+    echo "== torch =="; taskset -c "$CPUS" "$PY" -c 'import torch; print(torch.__version__, torch.__file__)' 2>&1 | tail -3
+    echo "== import vllm =="; taskset -c "$CPUS" "$PY" -c 'import vllm; print("VLLM", vllm.__version__)' 2>&1 | tail -5
+    echo "== import vllm._C =="; taskset -c "$CPUS" "$PY" -c 'import vllm._C as C; print("VLLM_C_OK", C.__file__)' 2>&1 | tail -5
+    echo "== import vllm._custom_ops =="; taskset -c "$CPUS" "$PY" -c '
+from vllm import _custom_ops as ops
+print("CUSTOM_OPS_OK")
+print("has_dynamic_scaled_int8_quant", hasattr(ops, "dynamic_scaled_int8_quant"))
+print("has_static_scaled_int8_quant", hasattr(ops, "static_scaled_int8_quant"))
+print("has_onednn_scaled_mm", hasattr(ops, "onednn_scaled_mm"))
+' 2>&1 | tail -6
+    echo "== platform =="; taskset -c "$CPUS" "$PY" -c 'from vllm.platforms import current_platform; print("PLATFORM", current_platform)' 2>&1 | tail -4
+    echo "== pip check =="; taskset -c "$CPUS" "$PIP" check 2>&1 | tail -20
+} > "$RAW/03_import_results.txt" 2>&1
+sed 's/^/[imports] /' "$RAW/03_import_results.txt"
+log "### done 03_build_env"
