+#: C8/Q5 execution-mode census vocabulary for the SVE256 runtime.
+#:
+#: ``native_*``       element computation happens inside the native AArch64 ELF
+#:                   (payload crosses the runner wire as raw storage bytes).
+#: ``host_*_loop_*``  the Python runtime orchestrates a per-slice/per-group
+#:                   loop around native rank-2 kernels and materialises the
+#:                   loop operands as Python lists (explicit host boundary).
+#: ``host_reference`` the operation is implemented in Python without native
+#:                   element compute.
+SVE256_W8A8_OPERATIONS = frozenset(
+    (
+        "qmatmul_s8s8_s32",
+        "quantize_per_token_s8",
+        "dequantize_s8",
+        "dequantize_epilogue_bf16",
+    )
+)
+#: artifact metadata ``scalar_math_lane_fallback``
+SVE256_SCALAR_MATH_LANE = frozenset(("exp", "sigmoid", "silu", "softplus"))
+#: artifact metadata ``scalar_conversion_lane_fallback``
+SVE256_SCALAR_CONVERSION_LANE = frozenset(("cast",))
+#: artifact metadata ``layout_scalar_lane_fallback`` / ``indexing_scalar_lane_fallback``
+#: (``bf16_reorder``): the descriptor is still evaluated natively, but the
+#: bf16 element load is a scalar lane loop (see ``ptx_layout_bf16`` /
+#: ``ptx_index_bf16`` in compiler/targets/cpu_sve256.py).
+SVE256_BF16_REORDER_LANE = frozenset(("transpose", "slice", "gather", "embedding"))
+#: Python host group loop around per-group native runner calls
+#: (``Sve256Runtime._execute_reduction``).
+SVE256_HOST_GROUP_LOOP = frozenset(("reduce_sum", "reduce_max", "reduce_mean"))
+
+
+def sve256_execution_decision(name: str, plan: Any) -> Mapping[str, Any]:
+    """Describe how the SVE256 runtime will execute one operation.
+
+    The decision mirrors ``Sve256Runtime._execute_operation`` /
+    ``_execute_reduction`` / ``_execute_w8a8_operation`` in
+    ``python/pypto/backends/cpu/aarch64/sve256.py`` plus the ELF scalar-lane
+    declarations in the artifact metadata
+    (``python/pypto/compiler/targets/cpu_sve256.py``).  It is evaluated on the
+    real plan object at execution time, so it cannot drift into a stale
+    name-only table.
+    """
+
+    dtype = str(getattr(plan, "dtype", ""))
+    matmul = getattr(plan, "matmul", None)
+    batch_shape = tuple(getattr(matmul, "batch_shape", ()) or ())
+    reduction = getattr(plan, "reduction", None)
+
+    def decision(mode: str, boundary: str, basis: str,
+                 list_elements: int = 0) -> Mapping[str, Any]:
+        return {
+            "mode": mode,
+            "boundary": boundary,
+            "basis": basis,
+            "python_list_elements": int(list_elements),
+        }
+
+    if name in SVE256_W8A8_OPERATIONS:
+        if name == "qmatmul_s8s8_s32" and batch_shape and matmul is not None:
+            batch = 1
+            for dimension in batch_shape:
+                batch *= int(dimension)
+            elements = batch * (int(matmul.m) * int(matmul.k) + int(matmul.k) * int(matmul.n))
+            return decision(
+                "host_batch_loop_native_kernel", "host_boundary",
+                "w8a8_batched_qmatmul_dispatch=host_batch_loop_rank2_native_kernel",
+                elements,
+            )
+        return decision(
+            "native_sve256_w8a8", "native",
+            "v6 W8A8 runner wire raw bytes; integer widening kernel in the ELF",
+        )
+    if name == "constant":
+        return decision(
+            "host_reference", "host_reference",
+            "Sve256Runtime builds the constant value in Python (no ELF call)",
+            int(getattr(plan, "element_count", 0) or 0),
+        )
+    if name in SVE256_HOST_GROUP_LOOP:
+        elements = 1
+        if reduction is not None:
+            for dimension in tuple(getattr(reduction, "input_shape", ()) or ()):
+                elements *= int(dimension)
+        return decision(
+            "host_group_loop_native_kernel", "host_boundary",
+            "Sve256Runtime._execute_reduction: Python group/bucket loop + one native runner call per group",
+            elements,
+        )
+    if name == "matmul" and batch_shape and matmul is not None:
+        batch = 1
+        for dimension in batch_shape:
+            batch *= int(dimension)
+        elements = batch * (int(matmul.m) * int(matmul.k) + int(matmul.k) * int(matmul.n))
+        return decision(
+            "host_batch_loop_native_kernel", "host_boundary",
+            "Sve256Runtime batched matmul: Python slice loop of rank-2 native runner calls",
+            elements,
+        )
+    if name in ("iota", "compare"):
+        return decision(
+            "native_sve256_scalar_lane", "native",
+            "B2 control runner: descriptor wire native, ELF descriptor loop is scalar; host_preexpanded_operations=[]",
+        )
+    if dtype not in ("float32", "bf16"):
+        # Defensive: the SVE256 runner wire only carries float32/bf16 payloads
+        # (the W8A8 plane above is the only integer exception), so an int8
+        # layout op is not executable by this runtime even if it lowered.
+        return decision(
+            "unsupported_by_sve256_runtime", "unsupported",
+            "Sve256Runtime._run_runner accepts float32/bf16 only; no int8 layout wire",
+        )
+    if name in SVE256_SCALAR_MATH_LANE:
+        return decision(
+            "native_sve256_scalar_lane", "native",
+            "artifact metadata scalar_math_lane_fallback; ptx_scalar_math_f32 / ptx_math_bf16",
+        )
+    if name in SVE256_SCALAR_CONVERSION_LANE:
+        return decision(
+            "native_sve256_scalar_lane", "native",
+            "artifact metadata scalar_conversion_lane_fallback; ptx_cast_* scalar lane loop",
+        )
+    if name in SVE256_BF16_REORDER_LANE and dtype == "bf16":
+        return decision(
+            "native_sve256_scalar_lane", "native",
+            "artifact metadata bf16_reorder; ptx_layout_bf16 / ptx_index_bf16 scalar lane loop",
+        )
+    if dtype != "float32" and name in (
+        "add", "sub", "mul", "div", "neg", "rsqrt", "matmul", "broadcast", "where",
+    ):
+        return decision(
+            "native_sve256_scalar_convert", "native",
+            "bf16 payload: ELF converts lanes with scalar helpers, element math stays SVE vector",
+        )
+    return decision(
+        "native_sve256_vector", "native",
+        "raw-byte runner wire; element math in SVE vector lanes",
+    )
+
+
+def sve256_census_summary(recorder: "OpRecorder") -> Mapping[str, Any]:
+    """Roll up the instrumented per-op decisions into native/host counts."""
+
+    per_op: Dict[str, Dict[str, Any]] = {}
+    boundary_totals: Dict[str, int] = {}
+    mode_totals: Dict[str, int] = {}
+    scalar_lane_total = 0
+    for record in recorder.records:
+        name = str(record.get("operation"))
+        mode = str(record.get("mode"))
+        decision = getattr(recorder, "sve256_basis", {}).get(str(record.get("index")), {})
+        boundary = decision.get("boundary")
+        if boundary is None:
+            if mode.startswith("native"):
+                boundary = "native"
+            elif mode == "host_reference":
+                boundary = "host_reference"
+            elif mode.startswith("host"):
+                boundary = "host_boundary"
+            else:
+                boundary = "unclassified"
+        entry = per_op.setdefault(
+            name,
+            {"count": 0, "boundary": boundary, "modes": set(), "basis": set(),
+             "seconds": 0.0},
+        )
+        entry["count"] += 1
+        entry["modes"].add(mode)
+        if decision.get("basis"):
+            entry["basis"].add(str(decision["basis"]))
+        entry["seconds"] += float(record.get("seconds", 0.0) or 0.0)
+        boundary_totals[boundary] = boundary_totals.get(boundary, 0) + 1
+        mode_totals[mode] = mode_totals.get(mode, 0) + 1
+        if mode == "native_sve256_scalar_lane":
+            scalar_lane_total += 1
+    return {
+        "definition": {
+            "native": "element compute inside the native AArch64 ELF (raw-byte runner wire)",
+            "host_boundary": (
+                "Python runtime orchestrates a per-slice/per-group loop around native "
+                "rank-2 kernels and materialises loop operands as Python lists"
+            ),
+            "host_reference": "Python implementation without native element compute",
+            "scalar_lane_detail": (
+                "native_sve256_scalar_lane = ELF executes the op with a scalar lane loop "
+                "(declared in artifact metadata); native_sve256_scalar_convert = ELF does "
+                "scalar lane conversion around SVE vector element math"
+            ),
+        },
+        "executed_operations": len(recorder.records),
+        "boundary_totals": dict(sorted(boundary_totals.items())),
+        "mode_totals": dict(sorted(mode_totals.items())),
+        "scalar_lane_operations": scalar_lane_total,
+        "by_operation": {
+            name: {
+                "count": entry["count"],
+                "boundary": entry["boundary"],
+                "modes": "+".join(sorted(entry["modes"])),
+                "seconds": round(entry["seconds"], 3),
+                "basis": "+".join(sorted(entry["basis"]))[:240],
+            }
+            for name, entry in sorted(per_op.items(), key=lambda kv: -kv[1]["seconds"])
+        },
+    }
+
+
+def make_sve256_census_runtime(recorder: Optional[OpRecorder],
+                               execution_mode: str = "native") -> Any:
+    """SVE256 runtime + per-op execution-mode census (semantics unchanged).
+
+    The subclass only wraps ``_execute_operation`` for timing and mode
+    bookkeeping.  It never alters the dispatch decision: the mode label is a
+    description computed from the same plan object the base class dispatches
+    on, and ``super()._execute_operation`` performs the real work.
+    """
+
+    from pypto.backends.cpu.aarch64.sve256 import Sve256Runtime
+
+    class Sve256CensusRuntime(Sve256Runtime):
+        def __init__(self) -> None:
+            super().__init__(execution_mode=execution_mode)
+            self._census_recorder = recorder
+            self._census_op_index = 0
+            self._census_basis: Dict[str, Mapping[str, Any]] = {}
+            if recorder is not None:
+                # Shared with sve256_census_summary(); keyed by op index.
+                recorder.sve256_basis = self._census_basis
+
+        def _execute_operation(self, operation: Any, plan: Any, environment: Any,
+                               artifact: Any) -> None:
+            active = self._census_recorder
+            if active is None:
+                return super()._execute_operation(operation, plan, environment, artifact)
+            index = self._census_op_index
+            self._census_op_index += 1
+            name = str(getattr(plan, "operation", operation.name))
+            out_bytes = sum(_ref_bytes(ref) for ref in operation.outputs)
+            in_bytes = sum(_ref_bytes(ref) for ref in operation.inputs)
+            decision = sve256_execution_decision(name, plan)
+            self._census_basis[str(index)] = decision
+            active.before_op(
+                index, name, in_bytes, out_bytes, mode=decision["mode"],
+                python_list_elements=decision["python_list_elements"],
+            )
+            started = time.perf_counter()
+            super()._execute_operation(operation, plan, environment, artifact)
+            active.record_op(
+                index, name, str(getattr(plan, "dtype", "")),
+                time.perf_counter() - started, out_bytes, in_bytes, mode=decision["mode"],
+            )
+
+    return Sve256CensusRuntime()
+
+
