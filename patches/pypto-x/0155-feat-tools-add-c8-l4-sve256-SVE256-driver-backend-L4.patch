@@ -0,0 +1,436 @@
+#!/usr/bin/env python3
+"""C8/Q5 SVE256 W8A8 whole-net gap probe (local, no model, no compiler).
+
+Why this tool exists
+--------------------
+The C8/Q5 task requires running the integration tree's **SVE256** backend on
+the real-weight W8A8 whole-net graph.  That requires lowering the portable
+W8A8 graph to the SVE256 target first.  This probe reproduces, locally and
+without weights, the exact point where the integration tree fails.
+
+It reports two independent facts:
+
+1. ``whole_net_w8a8``: for every prompt length and both W8A8 configurations,
+   whether ``lower_sve256`` accepts the graph, the first failing plan index,
+   and a **shadow census** of every plan that the SVE256 plan validator would
+   reject.  The shadow census re-implements the validator checks from
+   ``python/pypto/lowering/cpu/aarch64/sve/lowering.py``
+   (``Sve256Program.validate``, lines ~296-340) so the report can state
+   whether fixing the first failure unblocks the rest.
+2. ``whole_net_bf16``: the same lowering attempt for the BF16 graph, which
+   contains no int8 plans.  This isolates the gap to the W8A8 planes.
+
+``minimal_repro`` shows a 1-op rank-2 int8 ``transpose`` is rejected while
+the identical bf16 program lowers fine.
+
+This tool never compiles native code and never loads weights.  A failure here
+is a *lowering* gap, not an A3 hardware result.
+"""
+
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import sys
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Mapping, Optional
+
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import canonical_dtype
+from pypto.lowering.cpu.aarch64.sve import lower_sve256
+from pypto.lowering.cpu.aarch64.sve.lowering import (
+    SVE256_REQUIRED_FEATURES,
+    SVE256_TAIL_POLICY,
+    W8A8_SVE256_OPERATIONS,
+    _w8a8_plan_error,
+)
+from pypto.lowering.cpu.vector import lower_cpu_vector
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.target import TargetSpec
+
+TOOL = "c8_sve256_w8a8_gap_probe"
+PROMPTS = collections.OrderedDict(
+    (("en_continuation", 5), ("zh_continuation", 8), ("chat_zh_user", 18))
+)
+CONFIGS = (("default", "default", False), ("full", "all", True))
+
+TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2", "vl256"),
+    attributes={"vl_bytes": 32},
+)
+
+#: Source of the copied checks: python/pypto/lowering/cpu/aarch64/sve/lowering.py
+#: ``Sve256Program.validate`` (integration c2ec98f3c).
+VALIDATOR_SOURCE = "python/pypto/lowering/cpu/aarch64/sve/lowering.py::Sve256Program.validate"
+
+_DRIVER_DECISION = None
+
+
+def _driver_decision():
+    """Load the driver's ``sve256_execution_decision`` classifier.
+
+    The census must use the same classifier as the execution-time
+    instrumentation, so the static report and the executed report cannot drift.
+    """
+
+    global _DRIVER_DECISION
+    if _DRIVER_DECISION is None:
+        import importlib.util
+
+        path = (Path(__file__).resolve().parents[1]
+                / "python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py")
+        spec = importlib.util.spec_from_file_location("c8_q5_census_driver", str(path))
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        _DRIVER_DECISION = module.sve256_execution_decision
+    return _DRIVER_DECISION
+
+
+def _plan_violations(operation, plan) -> List[Mapping[str, Any]]:
+    """Return every SVE256 plan-validator violation for one (op, plan).
+
+    Faithful re-implementation of the checks in ``Sve256Program.validate`` so
+    the probe can enumerate *all* violations instead of the first one.
+    """
+
+    violations: List[Mapping[str, Any]] = []
+    plan_dtype = canonical_dtype(plan.dtype)
+    if plan.operation in W8A8_SVE256_OPERATIONS:
+        error = _w8a8_plan_error(operation, plan)
+        if error is not None:
+            violations.append({"kind": "w8a8_plan_error", "detail": error})
+        return violations
+    allowed_plan_dtype = plan_dtype in ("float32", "bf16") or (
+        plan.operation == "iota" and plan_dtype in ("int32", "int64")
+    ) or (plan.operation == "compare" and plan_dtype == "bool")
+    if not allowed_plan_dtype:
+        violations.append(
+            {
+                "kind": "output_dtype_not_allowed",
+                "detail": (
+                    "SVE256 supports float32/bf16 plans plus iota int32/int64 "
+                    "and compare bool, got {!r}".format(plan.dtype)
+                ),
+            }
+        )
+    for input_index, input_ref in enumerate(operation.inputs):
+        input_dtype = canonical_dtype(input_ref.type.dtype)
+        if input_dtype not in ("float32", "bf16") and not (
+            plan.operation == "where" and input_index == 0 and input_dtype == "bool"
+        ) and not (
+            plan.operation in ("gather", "embedding")
+            and input_index == 1
+            and input_dtype in ("int32", "int64")
+        ) and not (
+            plan.operation == "compare"
+            and input_dtype
+            in (
+                "bool", "int8", "uint8", "int16", "uint16",
+                "int32", "uint32", "int64", "uint64",
+            )
+        ):
+            violations.append(
+                {
+                    "kind": "input_dtype_not_allowed",
+                    "detail": (
+                        "SVE256 does not support {!r} input dtype for operation {!r}".format(
+                            input_dtype, plan.operation
+                        )
+                    ),
+                }
+            )
+    return violations
+
+
+def _shape_of(ref: ValueRef) -> Optional[List[int]]:
+    try:
+        return [int(value) for value in ref.type.shape]
+    except Exception:
+        return None
+
+
+def _audit_w8a8(prompt: str, steps: int, scope: str, quantize_lm_head: bool) -> Mapping[str, Any]:
+    started = time.time()
+    program = build_qwen35_text_decoder_graph(
+        batch=1,
+        steps=steps,
+        past_length=0,
+        precision="w8a8-linear",
+        quantized_linear_scope=scope,
+        quantize_lm_head=quantize_lm_head,
+    )
+    built = time.time()
+    operations = list(program.functions[0].body.operations)
+    record: Dict[str, Any] = {
+        "prompt": prompt,
+        "steps": steps,
+        "config": "full" if quantize_lm_head else "default",
+        "quantized_linear_scope": scope,
+        "quantize_lm_head": bool(quantize_lm_head),
+        "operation_total": len(operations),
+        "graph_build_seconds": round(built - started, 3),
+    }
+
+    # The vector common lowering succeeds; the SVE256-specific validator runs
+    # afterwards and is where the graph is rejected.
+    vector_program = lower_cpu_vector(
+        program,
+        TARGET,
+        None,
+        lane_count=8,
+        tail_policy=SVE256_TAIL_POLICY,
+        required_features=SVE256_REQUIRED_FEATURES,
+        specialization={"compact_iteration": True},
+    )
+    lowered = time.time()
+    record["vector_plan_count"] = len(vector_program.plans)
+    record["vector_lower_seconds"] = round(lowered - built, 3)
+
+    violations_by_op: Dict[str, Dict[str, Any]] = {}
+    first_violation_index = None
+    for index, (operation, plan) in enumerate(zip(operations, vector_program.plans)):
+        violations = _plan_violations(operation, plan)
+        if not violations:
+            continue
+        if first_violation_index is None:
+            first_violation_index = index
+        key = "{}|{}|{}".format(operation.name, plan.operation, canonical_dtype(plan.dtype))
+        entry = violations_by_op.setdefault(
+            key,
+            {
+                "operation": operation.name,
+                "plan_operation": plan.operation,
+                "plan_dtype": canonical_dtype(plan.dtype),
+                "count": 0,
+                "violation_kinds": sorted({item["kind"] for item in violations}),
+                "detail": violations[0]["detail"],
+                "sample_index": index,
+                "sample_input_shapes": [_shape_of(ref) for ref in operation.inputs],
+                "sample_output_shapes": [_shape_of(ref) for ref in operation.outputs],
+                "sample_attributes": {
+                    str(name): value for name, value in dict(operation.attributes).items()
+                    if name in ("permutation", "shape", "axis", "sizes", "starts", "steps")
+                },
+            },
+        )
+        entry["count"] += 1
+    record["shadow_violations"] = {
+        key: value for key, value in sorted(violations_by_op.items())
+    }
+    record["shadow_violation_operations"] = sum(
+        value["count"] for value in violations_by_op.values()
+    )
+    record["first_violation_index"] = first_violation_index
+    if first_violation_index is not None:
+        first_op = operations[first_violation_index]
+        record["first_violation_operation"] = first_op.name
+
+    consumers: Dict[str, int] = collections.Counter()
+    for operation in operations:
+        if operation.name != "transpose":
+            continue
+        if canonical_dtype(operation.outputs[0].type.dtype) != "int8":
+            continue
+        consumer_names = sorted(
+            {
+                other.name
+                for other in operations
+                if operation.outputs[0].name in {ref.name for ref in other.inputs}
+            }
+        )
+        consumers["+".join(consumer_names)] += 1
+    record["int8_transpose_consumers"] = dict(consumers)
+
+    # ---- plan-level execution-mode census (static; the graph cannot run) ----
+    decision_fn = _driver_decision()
+    census: Dict[str, Dict[str, Any]] = {}
+    boundary_totals: Dict[str, int] = collections.Counter()
+    mode_totals: Dict[str, int] = collections.Counter()
+    int8_transpose_bytes = 0
+    quantized_linear_ops = 0
+    for operation, plan in zip(operations, vector_program.plans):
+        name = plan.operation
+        decision = decision_fn(name, plan)
+        entry = census.setdefault(
+            name,
+            {"count": 0, "dtypes": set(), "modes": collections.Counter(),
+             "boundary": decision["boundary"], "unsupported": 0},
+        )
+        entry["count"] += 1
+        entry["dtypes"].add(canonical_dtype(plan.dtype))
+        entry["modes"][decision["mode"]] += 1
+        boundary_totals[decision["boundary"]] += 1
+        mode_totals[decision["mode"]] += 1
+        if decision["boundary"] == "unsupported":
+            entry["unsupported"] += 1
+        if name == "transpose" and canonical_dtype(plan.dtype) == "int8":
+            elements = 1
+            for ref in operation.inputs:
+                for dimension in tuple(getattr(ref.type, "shape", ()) or ()):
+                    elements *= int(dimension)
+            int8_transpose_bytes += elements * 1  # int8 = 1 byte/element
+        if name == "qmatmul_s8s8_s32":
+            quantized_linear_ops += 1
+    record["plan_census"] = {
+        "note": (
+            "static census from lowering plans (executed census is impossible: "
+            "Sve256Program.validate rejects this graph before compile/run); "
+            "mode/boundary labels come from the same classifier the runtime "
+            "instrumentation uses"
+        ),
+        "by_operation": {
+            name: {
+                "count": entry["count"],
+                "dtypes": sorted(entry["dtypes"]),
+                "modes": {mode: count for mode, count in sorted(entry["modes"].items())},
+                "boundary": entry["boundary"],
+                "unsupported_count": entry["unsupported"],
+            }
+            for name, entry in sorted(census.items())
+        },
+        "boundary_totals": dict(sorted(boundary_totals.items())),
+        "mode_totals": dict(sorted(mode_totals.items())),
+        "int8_transpose_bytes_positive": int8_transpose_bytes,
+        "quantized_linear_count": quantized_linear_ops,
+    }
+
+    try:
+        lower_sve256(program, TARGET)
+        record["lower_sve256"] = "OK"
+        record["lower_error"] = None
+    except Exception as exc:  # noqa: BLE001 - the error is the evidence
+        record["lower_sve256"] = "FAIL"
+        record["lower_error"] = "{}: {}".format(type(exc).__name__, exc)
+    record["audit_seconds"] = round(time.time() - lowered, 3)
+    return record
+
+
+def _audit_bf16(prompt: str, steps: int) -> Mapping[str, Any]:
+    program = build_qwen35_text_decoder_graph(
+        batch=1, steps=steps, past_length=0, precision="bf16"
+    )
+    record: Dict[str, Any] = {"prompt": prompt, "steps": steps,
+                              "operation_total": len(program.functions[0].body.operations)}
+    try:
+        target_ir = lower_sve256(program, TARGET)
+        record["lower_sve256"] = "OK"
+        record["plan_count"] = len(target_ir.plans)
+        record["plan_dtypes"] = dict(
+            sorted(collections.Counter(plan.dtype for plan in target_ir.plans).items())
+        )
+    except Exception as exc:  # noqa: BLE001
+        record["lower_sve256"] = "FAIL"
+        record["lower_error"] = "{}: {}".format(type(exc).__name__, exc)
+    return record
+
+
+def _minimal_transpose(dtype: str, permutation=(-1, 0)) -> Mapping[str, Any]:
+    input_type = CoreType.tensor(dtype, (3, 5))
+    output_type = CoreType.tensor(dtype, (5, 3))
+    source = ValueRef("source", input_type)
+    output = ValueRef("output", output_type)
+    operation = Operation(
+        "transpose", (source,), (output,), attributes={"permutation": list(permutation)}
+    )
+    program = CoreProgram(
+        functions=(
+            CoreFunction("transpose_probe", (source,), (output,), Region((operation,))),
+        )
+    )
+    result: Dict[str, Any] = {"dtype": dtype, "shape": [3, 5], "permutation": list(permutation)}
+    try:
+        lower_sve256(program, TARGET)
+        result["lower_sve256"] = "OK"
+        result["lower_error"] = None
+    except Exception as exc:  # noqa: BLE001
+        result["lower_sve256"] = "FAIL"
+        result["lower_error"] = "{}: {}".format(type(exc).__name__, exc)
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True, help="JSON evidence path")
+    args = parser.parse_args()
+
+    report: Dict[str, Any] = {
+        "tool": TOOL,
+        "integration_base": "c2ec98f3ccc8a6b8419a7a75abb2790cd62456b1",
+        "target_triple": TARGET.triple,
+        "validator_source": VALIDATOR_SOURCE,
+        "graph_contract": "qwen35 text decoder portable graph (W8A8-linear / bf16)",
+        "whole_net_w8a8": {},
+        "whole_net_bf16": {},
+        "minimal_repro": {},
+    }
+    print("[probe] whole-net W8A8 lowering attempts", flush=True)
+    for prompt, steps in PROMPTS.items():
+        for config, scope, quantize_lm_head in CONFIGS:
+            record = _audit_w8a8(prompt, steps, scope, quantize_lm_head)
+            report["whole_net_w8a8"]["{}/{}".format(prompt, config)] = record
+            print(
+                "  {} {:>4} steps={:>2} ops={:>5} lower={:<4} first_violation={!r} "
+                "violating_ops={}".format(
+                    prompt, config, steps, record["operation_total"],
+                    record["lower_sve256"], record["first_violation_operation"],
+                    record["shadow_violation_operations"],
+                ),
+                flush=True,
+            )
+    print("[probe] whole-net BF16 lowering attempts", flush=True)
+    for prompt, steps in PROMPTS.items():
+        record = _audit_bf16(prompt, steps)
+        report["whole_net_bf16"][prompt] = record
+        print(
+            "  {} {:>4} steps={:>2} ops={:>5} lower={}".format(
+                prompt, "bf16", steps, record["operation_total"], record["lower_sve256"]
+            ),
+            flush=True,
+        )
+    print("[probe] minimal int8 vs bf16 transpose", flush=True)
+    for dtype in ("int8", "bf16"):
+        record = _minimal_transpose(dtype)
+        report["minimal_repro"][dtype] = record
+        print("  {} -> {} ({})".format(dtype, record["lower_sve256"], record["lower_error"]), flush=True)
+
+    # Facts a follow-up implementation task needs; values are read from the
+    # integration tree instead of being retyped into the brief.
+    from pypto.backends.cpu.aarch64.sve256 import (
+        _DTYPE_CODES, _INDEXING_WIRE_VERSION, _LAYOUT_WIRE_VERSION,
+    )
+    from pypto.compiler.targets.cpu_sve256 import (
+        ARTIFACT_PAYLOAD_VERSION, RUNNER_PROTOCOL, W8A8_RUNNER_WIRE,
+    )
+    from pypto.lowering.cpu.aarch64.sve.lowering import SVE256_LOWERING_VERSION
+
+    report["code_facts"] = {
+        "sve256_lowering_version": SVE256_LOWERING_VERSION,
+        "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+        "runner_protocol": RUNNER_PROTOCOL,
+        "w8a8_runner_wire": W8A8_RUNNER_WIRE,
+        "layout_wire_version": _LAYOUT_WIRE_VERSION,
+        "indexing_wire_version": _INDEXING_WIRE_VERSION,
+        "runtime_dtype_codes": dict(sorted(_DTYPE_CODES.items())),
+        "validator_source": VALIDATOR_SOURCE,
+        "runtime_source": "python/pypto/backends/cpu/aarch64/sve256.py::Sve256Runtime._run_runner",
+        "native_c_source": "python/pypto/compiler/targets/cpu_sve256.py (ptx_layout_f32/ptx_layout_bf16 only)",
+        "avx2_host_reference_precedent": (
+            "python/pypto/backends/cpu/x86/avx2.py::_reference_operation delegates "
+            "layout/indexing/control to python/pypto/backends/cpu/vector/runtime.py::_execute_operation "
+            "and cpu_avx2.py::_execution_metadata declares host_reference_operations"
+        ),
+    }
+
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n",
+                                 encoding="utf-8")
+    print("[probe] wrote {}".format(args.output))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
