+#!/usr/bin/env bash
+# C8/Q5: build the A3 transfer bundle from this worktree + evidence assets.
+#
+# Runs on the LOCAL machine.  Never contains model weights: the A3 side reads
+# the already-present ~/models/Qwen3.5-0.8B.  Everything staged here is small
+# enough to move over SSH (source tree + golden input_ids + RoPE tables).
+set -euo pipefail
+
+WT=/home/chiro/projects/pypto/worktrees/pypto-x/c8-l4-sve256
+EV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-l4-sve256
+GOLD=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+ROPE_SRC=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/qwen35-bf16-weighted-execution/reference_rope
+BUNDLE="${EV}/a3_bundle"
+
+rm -rf "${BUNDLE}"
+mkdir -p "${BUNDLE}/src/python/tests/ut/pypto_x" "${BUNDLE}/tools" "${BUNDLE}/refmin/float32" "${BUNDLE}/rope"
+
+# --- source (only what the driver needs; __pycache__ excluded) -------------
+tar -C "${WT}" -cf - --exclude='__pycache__' --exclude='*.pyc' python/pypto \
+    | tar -C "${BUNDLE}/src" -xf -
+cp -f "${WT}/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py" \
+      "${BUNDLE}/src/python/tests/ut/pypto_x/"
+cp -f "${WT}/tools/c8_l4_compare.py" "${WT}/tools/c8_sve256_w8a8_gap_probe.py" \
+      "${BUNDLE}/tools/"
+if [[ -d "${WT}/tools/c8_sve256_a3" ]]; then
+  cp -rf "${WT}/tools/c8_sve256_a3" "${BUNDLE}/tools/"
+fi
+
+# --- golden input_ids only (no logits are shipped to A3) -------------------
+python3 - "${GOLD}" "${BUNDLE}/refmin/float32" <<'PY'
+import sys
+from pathlib import Path
+import numpy as np
+
+gold = Path(sys.argv[1])
+out = Path(sys.argv[2])
+out.mkdir(parents=True, exist_ok=True)
+total = 0
+for prompt in ("en_continuation", "zh_continuation", "chat_zh_user"):
+    with np.load(gold / "float32" / (prompt + ".npz"), allow_pickle=False) as data:
+        ids = np.asarray(data["input_ids"])
+    path = out / (prompt + ".npz")
+    np.savez(path, input_ids=ids)
+    total += path.stat().st_size
+    print("[refmin] {} input_ids={} bytes={}".format(prompt, ids.tolist(), path.stat().st_size))
+print("[refmin] total_bytes={}".format(total))
+PY
+
+# --- RoPE tables (292 KiB) --------------------------------------------------
+cp -f "${ROPE_SRC}/rope_summary.json" "${BUNDLE}/rope/"
+for prompt in en_continuation zh_continuation chat_zh_user; do
+  cp -f "${ROPE_SRC}/${prompt}.npz" "${BUNDLE}/rope/"
+done
+
+# --- manifest ---------------------------------------------------------------
+( cd "${BUNDLE}" && find . -type f ! -name 'MANIFEST.sha256' -print0 \
+    | sort -z | xargs -0 sha256sum > MANIFEST.sha256 )
+BUNDLE_BYTES=$(du -sb "${BUNDLE}" | cut -f1)
+TAR="${EV}/a3_bundle.tar"
+tar -C "${EV}" -cf "${TAR}" a3_bundle
+echo "[bundle] dir=${BUNDLE} bytes=${BUNDLE_BYTES} tar=${TAR} tar_bytes=$(stat -c %s "${TAR}")"
+sha256sum "${TAR}" | tee "${EV}/a3_bundle.tar.sha256"
