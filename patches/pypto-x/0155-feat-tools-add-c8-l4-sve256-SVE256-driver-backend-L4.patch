+#!/usr/bin/env bash
+# C8/Q5: fetch the A3 diagnostic evidence back to the local evidence dir.
+# Runs on the LOCAL machine.  Bulk npz dumps stay on A3; only JSON/logs and
+# their sha256 lists move (plus the remote dump inventory for auditing).
+set -euo pipefail
+
+EV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-l4-sve256
+A3=a3-21
+A3_ROOT='pypto-x-a3/c8-l4-sve256'
+LOCAL_RAW="${EV}/raw/a3"
+LOCAL_LOGS="${EV}/logs/a3"
+mkdir -p "${LOCAL_RAW}" "${LOCAL_LOGS}"
+
+echo "[fetch] remote inventory"
+ssh -o BatchMode=yes "${A3}" "cd \$HOME/${A3_ROOT} && du -sb raw logs work 2>/dev/null; du -sh raw/bf16 raw/w8a8_repro 2>/dev/null; find raw -name '*.npz' -type f | sort | xargs -r sha256sum" \
+  > "${LOCAL_RAW}/a3_dump_inventory.txt"
+
+scp -q -o BatchMode=yes \
+  "${A3}:\$HOME/${A3_ROOT}/raw/bf16/*.json" \
+  "${A3}:\$HOME/${A3_ROOT}/raw/bf16/*.progress.log" \
+  "${A3}:\$HOME/${A3_ROOT}/raw/w8a8_repro/*.json" \
+  "${A3}:\$HOME/${A3_ROOT}/raw/w8a8_repro/*.log" \
+  "${A3}:\$HOME/${A3_ROOT}/raw/matrix_status.json" \
+  "${A3}:\$HOME/${A3_ROOT}/raw/sha256sums.txt" \
+  "${LOCAL_RAW}/"
+scp -q -o BatchMode=yes \
+  "${A3}:\$HOME/${A3_ROOT}/logs/*.log" \
+  "${LOCAL_LOGS}/"
+# The remote sha256sums.txt uses paths relative to the A3 root; keep both the
+# raw file and a local re-hash of what was actually fetched.
+( cd "${LOCAL_RAW}" && find . -type f ! -name 'LOCAL_SHA256SUMS.txt' -print0 \
+    | sort -z | xargs -0 sha256sum > LOCAL_SHA256SUMS.txt )
+echo "[fetch] local bytes:"
+du -sb "${LOCAL_RAW}" "${LOCAL_LOGS}"
