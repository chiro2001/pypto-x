@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Compact the driver ``--debug-dump`` npz files into one judge pack per prompt.
+
+For a future (post-unblock) C8/Q5 SVE256 W8A8 run, the execution machine
+produces ``<prompt>.s3-prefill.past0.npz`` and
+``<prompt>.s3-decode.past<steps+k>.npz`` dumps.  This tool keeps only the
+``logits`` rows needed by ``tools/c8_l4_compare.py`` (prefill T x vocab and the
+4 decode rows) so only "our" arrays travel back to the machine that holds the
+gold (never gold to the execution machine).
+
+Usage::
+
+    python3 pack_ours_logits.py --ours-dir <raw/bf16-or-w8a8> \
+        --output-dir <pack> [--prompt en_continuation] [--steps 5]
+
+Output layout matches ``c8_l4_compare.py --ours-dir``:
+``<prompt>.s3-prefill.past0.npz`` and ``<prompt>.s3-decode.past*.npz``.
+"""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+import numpy as np
+
+PROMPTS = (("en_continuation", 5), ("zh_continuation", 8), ("chat_zh_user", 18))
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ours-dir", required=True)
+    parser.add_argument("--output-dir", required=True)
+    parser.add_argument("--prompt", action="append", default=None)
+    parser.add_argument("--steps", type=int, default=None)
+    args = parser.parse_args()
+
+    ours = Path(args.ours_dir).resolve()
+    out = Path(args.output_dir).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    selected = [item for item in PROMPTS if not args.prompt or item[0] in args.prompt]
+    total = 0
+    for prompt, steps in selected:
+        if args.steps is not None:
+            steps = args.steps
+        prefill_path = ours / "{}.s3-prefill.past0.npz".format(prompt)
+        with np.load(prefill_path, allow_pickle=False) as data:
+            arrays = {"logits": np.asarray(data["logits"], dtype=np.float32)}
+            if "final_hidden" in data.files:
+                arrays["final_hidden"] = np.asarray(data["final_hidden"], dtype=np.float32)
+        target = out / "{}.s3-prefill.past0.npz".format(prompt)
+        np.savez(target, **arrays)
+        total += target.stat().st_size
+        count = 0
+        for k in range(4):
+            path = ours / "{}.s3-decode.past{}.npz".format(prompt, steps + k)
+            if not path.is_file():
+                continue
+            with np.load(path, allow_pickle=False) as data:
+                row = np.asarray(data["logits"], dtype=np.float32)
+            decode_target = out / "{}.s3-decode.past{}.npz".format(prompt, steps + k)
+            np.savez(decode_target, logits=row)
+            total += decode_target.stat().st_size
+            count += 1
+        print("[pack] {} prefill_rows={} decode_rows={} bytes={}".format(
+            prompt, logits.shape[0], count, target.stat().st_size))
+    print("[pack] total_bytes={} (out={})".format(total, out))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
