@@ -0,0 +1,146 @@
+#!/usr/bin/env bash
+# C8/Q5 A3-side diagnostic window (runs ON a3-21 as l00886679, NOT in the
+# container: the host side owns cpus 320-639 per a3_cpu_grant_2026_09_11).
+#
+# Scope, explicitly:
+#   * W8A8 whole-net SVE256 is expected to FAIL at lowering (int8 weight
+#     transpose has no SVE256 layout path); this script records that failure
+#     on A3 so the blocker is shown to be host-independent.
+#   * BF16 whole-net SVE256 is a NON-L4 LINK DIAGNOSTIC.  It produces an
+#     executed native/host_reference census and wall-clock magnitudes only.
+#     It is NOT an accuracy verdict, NOT an L4 verdict, NOT performance.
+#
+# Discipline: only writes under ~/pypto-x-a3/c8-l4-sve256, only taskset CPUs
+# 320-639, never touches chip7/NPU, no machine config changes, no residue.
+set -u
+
+ROOT="${HOME}/pypto-x-a3/c8-l4-sve256"
+PY="${HOME}/pypto-x-a3/envs/pypto-x-c8/bin/python"
+DRIVER="${ROOT}/src/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py"
+ASSET="${HOME}/models/Qwen3.5-0.8B"
+RAW="${ROOT}/raw"
+LOGS="${ROOT}/logs"
+WORK="${ROOT}/work"
+TMP="${ROOT}/tmp"
+mkdir -p "${RAW}/bf16" "${RAW}/w8a8_repro" "${LOGS}" "${WORK}/bf16" "${TMP}"
+rm -f "${RAW}/sha256sums.txt"
+
+export PYTHONPATH="${ROOT}/src/python"
+export PYPTO_X_PORTABLE_ONLY=1
+export TMPDIR="${TMP}"
+export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8
+export OMP_PROC_BIND=close OMP_PLACES=cores
+
+# --- env evidence (append-only log) ----------------------------------------
+{
+  echo "== a3_c8_q5_window =="
+  date -u '+started_utc=%Y-%m-%dT%H:%M:%SZ'
+  date '+started_local=%Y-%m-%dT%H:%M:%S%z'
+  echo "hostname=$(hostname) user=$(whoami) home=${HOME}"
+  echo "cpuset_self=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  echo "nproc=$(nproc) mem_available_kib=$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
+  echo "uname=$(uname -m) kernel=$(uname -r)"
+  grep -m1 -i '^features' /proc/cpuinfo || true
+  echo "python=$(${PY} --version 2>&1) cc=$(cc --version | head -1)"
+  echo "weight_bytes=$(stat -c %s "${ASSET}/model.safetensors-00001-of-00001.safetensors" 2>/dev/null)"
+  echo "env_numpy=$(${PY} -c 'import numpy; print(numpy.__version__)' 2>&1)"
+  # static link check with the exact SVE256 native flags
+  printf 'int main(void){return 0;}\n' > "${TMP}/static_probe.c"
+  if cc -static -O2 -std=c99 -march=armv8.2-a+sve -msve-vector-bits=scalable \
+        "${TMP}/static_probe.c" -o "${TMP}/static_probe" 2>"${TMP}/static_probe.err"; then
+    echo "static_probe=PASS"
+    file "${TMP}/static_probe" | head -1
+  else
+    echo "static_probe=FAIL"
+    head -5 "${TMP}/static_probe.err"
+  fi
+  ${PY} - <<'PY'
+from pypto.lowering.cpu.aarch64.sve import probe_sve256_capabilities
+import json
+capability = probe_sve256_capabilities(execution_mode="native")
+print("sve256_capability=" + json.dumps(capability.to_dict(), sort_keys=True))
+PY
+} > "${LOGS}/env_evidence.log" 2>&1
+
+echo "[run] W8A8 lowering repro on A3 (expected FAIL)"
+timeout 900 taskset -c 320,322,324,326,328,330,332,334 "${PY}" "${DRIVER}" \
+  --stage s1 --backend sve256 --precision w8a8-linear --quantized-linear-scope default \
+  --prompt en_continuation --steps 5 --shape-profile model \
+  --output "${RAW}/w8a8_repro/en_default.json" \
+  --progress "${RAW}/w8a8_repro/en_default.progress.log" \
+  --work-dir "${WORK}/w8a8_repro" --no-watchdog \
+  > "${LOGS}/w8a8_repro.log" 2>&1
+echo "[run] W8A8 repro exit=$?"
+
+# --- bf16 whole-net diagnostic: 3 prompts in parallel, 8 threads each ------
+# Physical-core map (Q1 measured): core c -> cpu 320 + (c/40)*80 + (c%40)*2.
+declare -A CPUS
+CPUS[en_continuation]="320,322,324,326,328,330,332,334"
+CPUS[zh_continuation]="336,338,340,342,344,346,348,350"
+CPUS[chat_zh_user]="352,354,356,358,360,362,364,366"
+STEPS=(5 8 18)
+PROMPTS=(en_continuation zh_continuation chat_zh_user)
+declare -a PIDS=()
+declare -a STARTS=()
+
+for index in 0 1 2; do
+  prompt="${PROMPTS[$index]}"
+  steps="${STEPS[$index]}"
+  out="${RAW}/bf16/${prompt}.json"
+  progress="${RAW}/bf16/${prompt}.progress.log"
+  log="${LOGS}/bf16_${prompt}.log"
+  STARTS[$index]=$(date +%s)
+  echo "[run] bf16 ${prompt} steps=${steps} cpus=${CPUS[$prompt]} start=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  setsid --wait timeout 7200 taskset -c "${CPUS[$prompt]}" \
+    env OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 \
+        OMP_PROC_BIND=close OMP_PLACES=cores \
+    "${PY}" "${DRIVER}" \
+      --stage s3 --backend sve256 --precision bf16 \
+      --prompt "${prompt}" --steps "${steps}" --decode-steps 4 \
+      --asset-dir "${ASSET}" --reference-dir "${ROOT}/refmin" \
+      --rope-dir "${ROOT}/rope" \
+      --skip-gold-alignment \
+      --debug-dump "${RAW}/bf16/${prompt}" \
+      --output "${out}" --progress "${progress}" \
+      --work-dir "${WORK}/bf16/${prompt}" --no-watchdog \
+    > "${log}" 2>&1 &
+  PIDS+=("$!")
+  echo "[run] pid=${PIDS[$index]} log=${log}"
+done
+
+failures=0
+for index in 0 1 2; do
+  pid="${PIDS[$index]}"
+  prompt="${PROMPTS[$index]}"
+  status=0
+  wait "${pid}" || status=$?
+  elapsed=$(( $(date +%s) - STARTS[$index] ))
+  echo "[done] ${prompt} exit=${status} elapsed_s=${elapsed} end=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  if [[ ${status} -ne 0 ]]; then
+    failures=$((failures + 1))
+  fi
+done
+
+# --- compact status + sha256 of the JSON evidence --------------------------
+{
+  echo "{"
+  echo "  \"stage\": \"a3_c8_q5_diagnostic\","
+  echo "  \"not_l4\": true,"
+  echo "  \"note\": \"bf16 whole-net SVE256 is a link diagnostic only; no L4/accuracy/performance claim\","
+  echo "  \"a3_utc\": \"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\","
+  echo "  \"failures\": ${failures}"
+  echo "}"
+} > "${RAW}/matrix_status.json"
+
+for prompt in en_continuation zh_continuation chat_zh_user; do
+  if [[ -f "${RAW}/bf16/${prompt}.json" ]]; then
+    sha256sum "${RAW}/bf16/${prompt}.json" "${RAW}/bf16/${prompt}.progress.log" \
+      >> "${RAW}/sha256sums.txt" 2>/dev/null || true
+  fi
+done
+sha256sum "${RAW}/w8a8_repro/en_default.json" >> "${RAW}/sha256sums.txt" 2>/dev/null || true
+
+date -u '+finished_utc=%Y-%m-%dT%H:%M:%SZ' >> "${LOGS}/env_evidence.log"
+date '+finished_local=%Y-%m-%dT%H:%M:%S%z' >> "${LOGS}/env_evidence.log"
+echo "[run] failures=${failures}"
+exit 0
