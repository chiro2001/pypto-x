+# Default case set: two large non-dispatch-dominated GEMMs (the G3 keys) plus
+# two scaled-down large GEMMs and two model-shaped GEMMs that are expected to
+# be dispatch-dominated and therefore stay out of the ratio gate.
+DEFAULT_CASES = (
+    {"name": "gemm_f32_4096x4096x4096", "m": 4096, "n": 4096, "k": 4096, "dtype": "float32"},
+    {"name": "gemm_bf16_4096x4096x4096", "m": 4096, "n": 4096, "k": 4096, "dtype": "bf16"},
+    {"name": "gemm_f32_2048x4096x4096", "m": 2048, "n": 4096, "k": 4096, "dtype": "float32"},
+    {"name": "gemm_bf16_2048x4096x4096", "m": 2048, "n": 4096, "k": 4096, "dtype": "bf16"},
+    # Qwen3.5-0.8B prefill projection shape (T=128, hidden 1024 -> 3584).
+    {"name": "qwen_prefill_proj_bf16_128x3584x1024", "m": 128, "n": 3584, "k": 1024, "dtype": "bf16"},
+    # Qwen3.5-0.8B decode lm_head shape (T=1, hidden 1024 -> vocab 248320).
+    {"name": "qwen_decode_lmhead_bf16_1x248320x1024", "m": 1, "n": 248320, "k": 1024, "dtype": "bf16"},
+)
