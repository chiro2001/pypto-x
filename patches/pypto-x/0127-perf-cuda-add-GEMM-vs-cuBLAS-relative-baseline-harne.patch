+# ---------------------------------------------------------------------------
+# cuBLAS binding (ctypes; no headers/compiler required)
+# ---------------------------------------------------------------------------
+
+
+CUBLAS_OP_N = 0
+CUDA_R_32F = 0
+CUDA_R_16BF = 14
+CUBLAS_COMPUTE_32F = 68
+CUBLAS_GEMM_DEFAULT = -1
+CUBLAS_DEFAULT_MATH = 0
+CUBLAS_STATUS_SUCCESS = 0
+
+
+class CublasError(RuntimeError):
+    pass
+
+
+class Cublas:
+    """Minimal cuBLAS binding for f32 SGEMM and bf16 GemmEx."""
+
+    _CANDIDATES = (
+        "/usr/local/cuda/lib64/libcublas.so.13",
+        "/usr/local/cuda/lib64/libcublas.so",
+        "libcublas.so.13",
+        "libcublas.so",
+    )
+
+    def __init__(self):
+        last_error = None
+        lt_candidates = (
+            "/usr/local/cuda/lib64/libcublasLt.so.13",
+            "/usr/local/cuda/lib64/libcublasLt.so",
+        )
+        for candidate in lt_candidates:
+            if Path(candidate).exists():
+                try:
+                    ctypes.CDLL(candidate, mode=ctypes.RTLD_GLOBAL)
+                except OSError:
+                    pass
+        self.path = None
+        for candidate in self._CANDIDATES:
+            try:
+                self.library = ctypes.CDLL(candidate)
+                self.path = candidate
+                break
+            except OSError as exc:
+                last_error = exc
+        else:  # pragma: no cover
+            raise CublasError("cuBLAS library not found: {}".format(last_error))
+
+        library = self.library
+        library.cublasCreate_v2.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
+        library.cublasCreate_v2.restype = ctypes.c_int
+        library.cublasDestroy_v2.argtypes = [ctypes.c_void_p]
+        library.cublasDestroy_v2.restype = ctypes.c_int
+        library.cublasGetVersion_v2.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
+        library.cublasGetVersion_v2.restype = ctypes.c_int
+        library.cublasSetStream_v2.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
+        library.cublasSetStream_v2.restype = ctypes.c_int
+        library.cublasSetMathMode.argtypes = [ctypes.c_void_p, ctypes.c_int]
+        library.cublasSetMathMode.restype = ctypes.c_int
+        library.cublasSgemm_v2.argtypes = [
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.c_void_p,
+            ctypes.c_int,
+        ]
+        library.cublasSgemm_v2.restype = ctypes.c_int
+        # handle, transa, transb, m, n, k, alpha, A, Atype, lda, B, Btype, ldb,
+        # beta, C, Ctype, ldc, computeType, algo
+        library.cublasGemmEx.argtypes = [
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+            ctypes.c_int,
+        ]
+        library.cublasGemmEx.restype = ctypes.c_int
+
+        handle = ctypes.c_void_p()
+        status = library.cublasCreate_v2(ctypes.byref(handle))
+        if status != CUBLAS_STATUS_SUCCESS:
+            raise CublasError("cublasCreate_v2 failed with status {}".format(status))
+        self.handle = handle
+        self._check("cublasSetMathMode", library.cublasSetMathMode(handle, CUBLAS_DEFAULT_MATH))
+        self._check("cublasSetStream_v2", library.cublasSetStream_v2(handle, ctypes.c_void_p(0)))
+        version = ctypes.c_int(0)
+        self.version_raw = None
+        if library.cublasGetVersion_v2(handle, ctypes.byref(version)) == CUBLAS_STATUS_SUCCESS:
+            self.version_raw = int(version.value)
+
+    def _check(self, operation, status):
+        if status != CUBLAS_STATUS_SUCCESS:
+            raise CublasError("{} failed with status {}".format(operation, status))
+
+    def call(self, case: dict, left_ptr: int, right_ptr: int, out_ptr: int) -> None:
+        """Compute C(m,n) = A(m,k) @ B(k,n) with the buffer's row-major layout.
+
+        cuBLAS is column-major, so we compute C^T = B^T @ A^T on the same
+        storage: ``m`` and ``n`` are swapped and both operands are passed with
+        the identity transposition, which is the standard row-major mapping.
+        """
+
+        m, n, k, dtype = case["m"], case["n"], case["k"], case["dtype"]
+        if dtype == "float32":
+            alpha = ctypes.c_float(1.0)
+            beta = ctypes.c_float(0.0)
+            self._check(
+                "cublasSgemm_v2",
+                self.library.cublasSgemm_v2(
+                    self.handle,
+                    CUBLAS_OP_N,
+                    CUBLAS_OP_N,
+                    n,
+                    m,
+                    k,
+                    ctypes.byref(alpha),
+                    ctypes.c_void_p(int(right_ptr)),
+                    n,
+                    ctypes.c_void_p(int(left_ptr)),
+                    k,
+                    ctypes.byref(beta),
+                    ctypes.c_void_p(int(out_ptr)),
+                    n,
+                ),
+            )
+            return
+        if dtype == "bf16":
+            alpha = ctypes.c_float(1.0)
+            beta = ctypes.c_float(0.0)
+            self._check(
+                "cublasGemmEx",
+                self.library.cublasGemmEx(
+                    self.handle,
+                    CUBLAS_OP_N,
+                    CUBLAS_OP_N,
+                    n,
+                    m,
+                    k,
+                    ctypes.byref(alpha),
+                    ctypes.c_void_p(int(right_ptr)),
+                    CUDA_R_16BF,
+                    n,
+                    ctypes.c_void_p(int(left_ptr)),
+                    CUDA_R_16BF,
+                    k,
+                    ctypes.byref(beta),
+                    ctypes.c_void_p(int(out_ptr)),
+                    CUDA_R_16BF,
+                    n,
+                    CUBLAS_COMPUTE_32F,
+                    CUBLAS_GEMM_DEFAULT,
+                ),
+            )
+            return
+        raise CublasError("unsupported cuBLAS dtype {!r}".format(dtype))
+
+    def close(self) -> None:
+        if getattr(self, "handle", None):
+            self.library.cublasDestroy_v2(self.handle)
+            self.handle = None
+
+
+# ---------------------------------------------------------------------------
+# measurement primitives
+# ---------------------------------------------------------------------------
+
+
+def _gpu_request(case: dict, left_ptr: int, right_ptr: int, out_ptr: int) -> GpuLaunchRequest:
+    dtype, m, n, k = case["dtype"], case["m"], case["n"], case["k"]
+    return GpuLaunchRequest(
+        case["artifact"],
+        geometries=(case["plan"].geometry,),
+        inputs=(
+            TensorDesc(dtype, (m, k), device="gpu", address=left_ptr, readonly=True),
+            TensorDesc(dtype, (k, n), device="gpu", address=right_ptr, readonly=True),
+        ),
+        outputs=(TensorDesc(dtype, (m, n), device="gpu", address=out_ptr),),
+    )
+
+
+def _launch_cublas_timed(driver, cublas: Cublas, case: dict, left_ptr, right_ptr, out_ptr):
+    """One cuBLAS call bracketed by device events and a host wall clock."""
+
+    start_event = driver.event_create()
+    stop_event = driver.event_create()
+    try:
+        start_event.record(None)
+        wall_started = time.perf_counter()
+        cublas.call(case, left_ptr, right_ptr, out_ptr)
+        wall_seconds = time.perf_counter() - wall_started
+        stop_event.record(None)
+        driver.event_synchronize(stop_event)
+        kernel_seconds = start_event.elapsed_time_seconds(stop_event)
+    finally:
+        for event in (start_event, stop_event):
+            try:
+                event.close()
+            except Exception:
+                pass
+    dispatch_seconds = max(0.0, wall_seconds - kernel_seconds)
+    return {
+        "kernel_seconds": kernel_seconds,
+        "wall_seconds": wall_seconds,
+        "dispatch_seconds": dispatch_seconds,
+    }
+
+
+def _measure_side(repeats: int, warmup: int, launch_fn, launches_per_sample: int = 1) -> dict:
+    """Warmup (W=5 samples, acceptance rule) followed by R measured samples.
+
+    Each sample is the mean of ``launches_per_sample`` back-to-back timed
+    launches.  On WSL2 the GPU power state oscillates at a few-millisecond
+    granularity, so a single-launch sample can exceed the protocol's 3% cv
+    ceiling even when the underlying clock is asserted; the sample mean keeps
+    the R=21 sample count while averaging that platform jitter.  The raw
+    per-launch decomposition (kernel/dispatch) is preserved for every launch.
+    """
+
+    batch = max(1, int(launches_per_sample))
+
+    def sample_once():
+        kernel = 0.0
+        wall = 0.0
+        dispatch = 0.0
+        timed_region = 0.0
+        for _ in range(batch):
+            result = launch_fn()
+            kernel += result["kernel_seconds"]
+            wall += result["wall_seconds"]
+            dispatch += result.get("dispatch_seconds") or 0.0
+            timed_region += result.get("timed_region_wall_seconds") or 0.0
+        return {
+            "kernel_seconds": kernel / batch,
+            "wall_seconds": wall / batch,
+            "dispatch_seconds": dispatch / batch,
+            "timed_region_wall_seconds": timed_region / batch,
+            "launches": batch,
+        }
+
+    attempts = []
+    warmup_last = None
+    samples = []
+    for attempt in range(WARMUP_ATTEMPTS):
+        for _ in range(warmup):
+            warmup_last = sample_once()
+        attempt_samples = [sample_once() for _ in range(repeats)]
+        kernel = [sample["kernel_seconds"] for sample in attempt_samples]
+        first_five = kernel[:5]
+        smallest = min(first_five)
+        acceptance = (
+            abs(warmup_last["kernel_seconds"] - smallest) / smallest if smallest else None
+        )
+        accepted = acceptance is not None and acceptance < WARMUP_ACCEPTANCE
+        attempts.append(
+            {
+                "attempt": attempt + 1,
+                "warmup_samples": warmup,
+                "launches_per_sample": batch,
+                "last_warmup_kernel_seconds": warmup_last["kernel_seconds"],
+                "min_first_five_kernel_seconds": smallest,
+                "relative_gap": acceptance,
+                "accepted": accepted,
+            }
+        )
+        samples = attempt_samples
+        if accepted:
+            break
+    warmup_verdict = "PASS" if attempts[-1]["accepted"] else "INVALID_WARMUP"
+    return {
+        "warmup": {
+            "iterations": warmup,
+            "launches_per_sample": batch,
+            "acceptance_rule": "|last_warmup - min(first 5 measured)| / min(...) < 0.05",
+            "attempts": attempts,
+            "verdict": warmup_verdict,
+        },
+        "samples": samples,
+        "warmup_verdict": warmup_verdict,
+    }
+
+
+def _launch_ours_once(runtime: CudaRuntime, request):
+    _results, timing = runtime.launch_timed(request)
+    if timing.kernel_seconds is None:
+        raise RuntimeError("CUDA launch_timed returned no kernel_seconds: {}".format(timing.timing_error))
+    return {
+        "kernel_seconds": timing.kernel_seconds,
+        "wall_seconds": timing.wall_seconds,
+        "dispatch_seconds": timing.dispatch_seconds,
+        "timed_region_wall_seconds": timing.timed_region_wall_seconds,
+    }
+
+
+def _rate_calibration(driver, gap_seconds: float, rounds: int) -> dict:
+    """Kernel-free host-sleep spans -> cuEvent timer rate vs host wall clock."""
+
+    rates = []
+    spans = []
+    for _ in range(max(1, rounds)):
+        start_event = driver.event_create()
+        stop_event = driver.event_create()
+        try:
+            start_event.record(None)
+            host_started = time.perf_counter()
+            time.sleep(max(0.0, gap_seconds))
+            stop_event.record(None)
+            host_seconds = time.perf_counter() - host_started
+            driver.event_synchronize(stop_event)
+            event_seconds = start_event.elapsed_time_seconds(stop_event)
+        finally:
+            for event in (start_event, stop_event):
+                try:
+                    event.close()
+                except Exception:
+                    pass
+        rate = (host_seconds / event_seconds) if event_seconds else None
+        if rate is not None:
+            rates.append(rate)
+        spans.append(
+            {
+                "gap_seconds": gap_seconds,
+                "host_seconds": host_seconds,
+                "event_seconds": event_seconds,
+                "rate": rate,
+                "kernels_in_span": 0,
+            }
+        )
+    median_rate = statistics.median(rates) if rates else None
+    spread_pct = (
+        (max(rates) - min(rates)) / median_rate * 100.0 if len(rates) > 1 and median_rate else 0.0
+    )
+    return {
+        "method": "kernel-free host sleep inside one event pair; rate = host_wall / event_span",
+        "gap_seconds": gap_seconds,
+        "rounds": max(1, rounds),
+        "rates": rates,
+        "median_rate": median_rate,
+        "rate_offset_pct": ((median_rate - 1.0) * 100.0) if median_rate else None,
+        "spread_pct": spread_pct,
+        "spans": spans,
+    }
+
+
+# ---------------------------------------------------------------------------
+# G1 correctness
+# ---------------------------------------------------------------------------
+
+
+def _reference_matmul_fp64(left, right, m, n, k):
+    """Pure-Python float64 oracle (small shapes only)."""
+
+    output = [0.0] * (m * n)
+    for row in range(m):
+        base_left = row * k
+        base_out = row * n
+        for inner in range(k):
+            left_value = left[base_left + inner]
+            if left_value == 0.0:
+                continue
+            base_right = inner * n
+            for column in range(n):
+                output[base_out + column] += left_value * right[base_right + column]
+    return output
+
+
+def _integer_case_values(m, n, k):
+    left = [float(1 + ((row * 7 + inner * 3) % 6)) for row in range(m) for inner in range(k)]
+    right = [float(1 + ((inner * 5 + column * 2) % 6)) for inner in range(k) for column in range(n)]
+    return left, right
+
+
+def _random_case_values(m, n, k, seed=20260910):
+    import random
+
+    generator = random.Random(seed)
+    left = [generator.uniform(-1.0, 1.0) for _ in range(m * k)]
+    right = [generator.uniform(-1.0, 1.0) for _ in range(k * n)]
+    return left, right
+
+
+def _max_error(observed, expected):
+    max_abs = 0.0
+    max_rel = 0.0
+    for value, reference in zip(observed, expected):
+        difference = abs(value - reference)
+        max_abs = max(max_abs, difference)
+        if reference != 0.0:
+            max_rel = max(max_rel, difference / abs(reference))
+    return max_abs, max_rel
+
+
+def _tolerance(dtype: str):
+    # f32: far above the K*eps accumulation budget for K<=160 and O(1) inputs.
+    # bf16: about two bf16 ulps at O(1..10) result magnitude (final RNE store).
+    if dtype == "bf16":
+        return {"atol": 0.08, "rtol": 0.02}
+    return {"atol": 1.0e-3, "rtol": 1.0e-4}
+
+
+def _within_tolerance(observed, expected, tolerance) -> dict:
+    max_abs, max_rel = _max_error(observed, expected)
+    violations = 0
+    for value, reference in zip(observed, expected):
+        limit = tolerance["atol"] + tolerance["rtol"] * abs(reference)
+        if abs(value - reference) > limit:
+            violations += 1
+    return {
+        "max_abs": max_abs,
+        "max_rel": max_rel,
+        "atol": tolerance["atol"],
+        "rtol": tolerance["rtol"],
+        "violations": violations,
+        "pass": violations == 0,
+    }
+
+
+def _g1_small_shape(runtime: CudaRuntime, cublas: Cublas, dtype: str) -> dict:
+    """Integer-exact and random-tolerance checks against independent oracles."""
+
+    result = {}
+    for label, shape, values_fn, oracle_kind in (
+        ("integer_equivalence", SMALL_INTEGER_SHAPE, _integer_case_values, "exact"),
+        ("random_tolerance", SMALL_FLOAT_SHAPE, _random_case_values, "fp64"),
+    ):
+        m, n, k = shape
+        left, right = values_fn(m, n, k)
+        if dtype == "bf16":
+            left = [_round_to_dtype("bf16", value) for value in left]
+            right = [_round_to_dtype("bf16", value) for value in right]
+        case = _build_case(m, n, k, dtype, name="{}_{}".format(label, dtype))
+        left_ptr = runtime.driver.mem_alloc(len(left) * _itemsize(dtype))
+        right_ptr = runtime.driver.mem_alloc(len(right) * _itemsize(dtype))
+        out_ptr = runtime.driver.mem_alloc(m * n * _itemsize(dtype))
+        try:
+            runtime.driver.memcpy_htod(left_ptr, _pack_values(dtype, left))
+            runtime.driver.memcpy_htod(right_ptr, _pack_values(dtype, right))
+            request = _gpu_request(case, left_ptr, right_ptr, out_ptr)
+            runtime.launch(request)
+            ours = _unpack_values(dtype, runtime.driver.memcpy_dtoh(out_ptr, m * n * _itemsize(dtype)))
+            cublas.call(case, left_ptr, right_ptr, out_ptr)
+            runtime.driver.context_synchronize()
+            theirs = _unpack_values(dtype, runtime.driver.memcpy_dtoh(out_ptr, m * n * _itemsize(dtype)))
+        finally:
+            for pointer in (left_ptr, right_ptr, out_ptr):
+                try:
+                    runtime.driver.mem_free(pointer)
+                except Exception:
+                    pass
+        if oracle_kind == "exact":
+            exact = _reference_matmul_fp64(left, right, m, n, k)
+            expected = [_round_to_dtype(dtype, value) for value in exact]
+            ours_errors = _max_error(ours, expected)
+            theirs_errors = _max_error(theirs, expected)
+            pass_verdict = ours_errors[0] == 0.0 and theirs_errors[0] == 0.0
+            result[label] = {
+                "shape_m_n_k": [m, n, k],
+                "dtype": dtype,
+                "oracle": "exact integer arithmetic (all partial sums <= 2**24, f32-exact)",
+                "max_abs_partial_sum": max(abs(value) for value in exact),
+                "ours_vs_oracle": {"max_abs": ours_errors[0], "max_rel": ours_errors[1], "pass": ours_errors[0] == 0.0},
+                "cublas_vs_oracle": {
+                    "max_abs": theirs_errors[0],
+                    "max_rel": theirs_errors[1],
+                    "pass": theirs_errors[0] == 0.0,
+                },
+                "ours_bitwise_equal_cublas": ours == theirs,
+                "pass": pass_verdict,
+            }
+        else:
+            expected = _reference_matmul_fp64(left, right, m, n, k)
+            tolerance = _tolerance(dtype)
+            ours_check = _within_tolerance(ours, expected, tolerance)
+            theirs_check = _within_tolerance(theirs, expected, tolerance)
+            cross = _max_error(ours, theirs)
+            result[label] = {
+                "shape_m_n_k": [m, n, k],
+                "dtype": dtype,
+                "oracle": "pure-python float64 triple loop",
+                "tolerance": tolerance,
+                "ours_vs_oracle": ours_check,
+                "cublas_vs_oracle": theirs_check,
+                "ours_vs_cublas": {"max_abs": cross[0], "max_rel": cross[1]},
+                "pass": ours_check["pass"] and theirs_check["pass"],
+            }
+    result["status"] = "PASS" if all(entry.get("pass") for key, entry in result.items() if key != "status") else "FAIL"
+    return result
+
+
+def _g1_full_shape_ones(runtime: CudaRuntime, cublas: Cublas, case: dict, left_ptr, right_ptr, out_ptr) -> dict:
+    """Full measured shape: 1.0 x 1.0 -> every output must be exactly K."""
+
+    m, n, k, dtype = case["m"], case["n"], case["k"], case["dtype"]
+    pattern = _ones_pattern(dtype)
+    runtime.driver.memcpy_htod(left_ptr, pattern * (m * k))
+    runtime.driver.memcpy_htod(right_ptr, pattern * (k * n))
+    request = _gpu_request(case, left_ptr, right_ptr, out_ptr)
+    runtime.launch(request)
+    size = m * n * _itemsize(dtype)
+    ours_raw = runtime.driver.memcpy_dtoh(out_ptr, size)
+    cublas.call(case, left_ptr, right_ptr, out_ptr)
+    runtime.driver.context_synchronize()
+    theirs_raw = runtime.driver.memcpy_dtoh(out_ptr, size)
+    expected_word = _float_word(dtype, float(k))
+    expected_raw = expected_word * (m * n)
+
+    def first_mismatch(raw):
+        if raw == expected_raw:
+            return None
+        stride = _itemsize(dtype)
+        for index in range(m * n):
+            if raw[index * stride : (index + 1) * stride] != expected_word:
+                return index
+        return None
+
+    return {
+        "shape_m_n_k": [m, n, k],
+        "dtype": dtype,
+        "inputs": "all ones",
+        "expected_value": float(k),
+        "expected_exact": True,
+        "ours_pass": ours_raw == expected_raw,
+        "cublas_pass": theirs_raw == expected_raw,
+        "ours_first_mismatch_index": first_mismatch(ours_raw),
+        "cublas_first_mismatch_index": first_mismatch(theirs_raw),
+        "output_elements": m * n,
+    }
+
+
+# ---------------------------------------------------------------------------
+# one round
+# ---------------------------------------------------------------------------
+
+
+def _case_key(case: dict, affinity: str) -> dict:
+    return {
+        "op": "matmul",
+        "shape_tuple": [case["m"], case["n"], case["k"]],
+        "dtype": case["dtype"],
+        "isa": case["ptx_target"],
+        "cpu_affinity": affinity,
+    }
+
+
+def _parse_affinity(spec: str):
+    """Parse ``0-5``/``0,1,2`` into a set of CPU ids."""
+
+    result = set()
+    for part in spec.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            start, end = part.split("-", 1)
+            result.update(range(int(start), int(end) + 1))
+        else:
+            result.add(int(part))
+    return result
+
+
+def run_round(args) -> dict:
+    started_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    cases_spec = list(DEFAULT_CASES)
+    if args.cases_json:
+        cases_spec = json.loads(args.cases_json)
+    if args.only_case:
+        wanted = set(args.only_case)
+        cases_spec = [spec for spec in cases_spec if spec["name"] in wanted]
+        if not cases_spec:
+            raise SystemExit("--only-case matched no case: {}".format(sorted(wanted)))
+
+    affinity = sorted(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else []
+    affinity_label = args.affinity or ",".join(str(cpu) for cpu in affinity)
+    requested_affinity = _parse_affinity(affinity_label) if affinity_label else set(affinity)
+    affinity_matches = set(affinity) == set(requested_affinity)
+
+    fingerprint_before = _nvidia_smi_fingerprint()
+    noise_before = _host_noise_sample()
+    gpu = {
+        "name": (fingerprint_before.get("raw_csv") or "").split(",")[0].strip(),
+        "driver_kmd": fingerprint_before.get("driver_kmd"),
+        "cuda_umd": fingerprint_before.get("cuda_umd"),
+    }
+
+    runtime = CudaRuntime()
+    if not runtime.is_available():
+        raise SystemExit("CUDA device unavailable: {}".format(runtime.availability().to_dict()))
+    runtime._ensure_context()
+    cublas = Cublas()
+
+    environment_freeze = {
+        "uname": " ".join(platform.uname()),
+        "python": sys.version.split()[0],
+        "cpu_model": _cpu_model(),
+        "nproc_online": len(affinity) if affinity else os.cpu_count(),
+        "cpu_affinity": affinity,
+        "cpu_affinity_label": affinity_label,
+        "requested_affinity": sorted(requested_affinity),
+        "affinity_matches_requested": affinity_matches,
+        "virtualization": "wsl2" if "microsoft" in platform.release().lower() else platform.system(),
+        "mem_total_mib": _mem_total_mib(),
+        "gpu_name": gpu["name"],
+        "driver_kmd": gpu["driver_kmd"],
+        "cuda_umd": gpu["cuda_umd"],
+        "cublas_path": cublas.path,
+        "cublas_version_raw": cublas.version_raw,
+        "ptx_target": DEFAULT_PTX_TARGET,
+        "ptx_version": CUDA_PTX_VERSION,
+        "execution_model": "op_by_op_dispatch",
+        "weights_loaded": False,
+    }
+
+    # Build every case up front so lowering/compile time is outside the
+    # measured section and every round validates the same artifacts.
+    built_cases = []
+    for spec in cases_spec:
+        case = _build_case(spec["m"], spec["n"], spec["k"], spec["dtype"], name=spec["name"])
+        case["keys"] = _case_key(case, affinity_label)
+        case["left_ptr"] = runtime.driver.mem_alloc(case["m"] * case["k"] * _itemsize(case["dtype"]))
+        case["right_ptr"] = runtime.driver.mem_alloc(case["k"] * case["n"] * _itemsize(case["dtype"]))
+        case["out_ptr"] = runtime.driver.mem_alloc(case["m"] * case["n"] * _itemsize(case["dtype"]))
+        case["request"] = _gpu_request(case, case["left_ptr"], case["right_ptr"], case["out_ptr"])
+        built_cases.append(case)
+
+    g1 = {
+        "small_shape": {dtype: _g1_small_shape(runtime, cublas, dtype) for dtype in ("float32", "bf16")},
+        "full_shape_ones": {},
+    }
+    for case in built_cases:
+        g1["full_shape_ones"][case["name"]] = _g1_full_shape_ones(
+            runtime, cublas, case, case["left_ptr"], case["right_ptr"], case["out_ptr"]
+        )
+    g1["status"] = (
+        "PASS"
+        if all(entry["status"] == "PASS" for entry in g1["small_shape"].values())
+        and all(
+            entry["ours_pass"] and entry["cublas_pass"] for entry in g1["full_shape_ones"].values()
+        )
+        else "FAIL"
+    )
+
+    # Refill timed buffers with ones so the timed launches never see
+    # uninitialized/denormal data (the ones check above already did this).
+    for case in built_cases:
+        runtime.driver.memcpy_htod(case["left_ptr"], _ones_pattern(case["dtype"]) * (case["m"] * case["k"]))
+        runtime.driver.memcpy_htod(case["right_ptr"], _ones_pattern(case["dtype"]) * (case["k"] * case["n"]))
+
+    # Protocol clock warmup: keep the device busy for >= clock-warmup seconds
+    # before any clock sample is taken, and keep it busy while sampling.
+    largest = max(built_cases, key=lambda entry: entry["m"] * entry["n"] * entry["k"])
+    clock_deadline = time.perf_counter() + max(0.0, args.clock_warmup_seconds)
+    clock_launches = 0
+    while time.perf_counter() < clock_deadline and clock_launches < 200:
+        runtime.launch(largest["request"])
+        clock_launches += 1
+
+    sampler = _ClockSampler(interval=args.clock_interval)
+    sampler.start()
+    case_results = []
+    try:
+        for case in built_cases:
+            ours_side = _measure_side(
+                args.repeats,
+                args.warmup,
+                lambda current=case: _launch_ours_once(runtime, current["request"]),
+                args.launches_per_sample,
+            )
+            cublas_side = _measure_side(
+                args.repeats,
+                args.warmup,
+                lambda current=case: _launch_cublas_timed(
+                    runtime.driver, cublas, current, current["left_ptr"], current["right_ptr"], current["out_ptr"]
+                ),
+                args.launches_per_sample,
+            )
+            case_results.append({"case": case, "ours": ours_side, "cublas": cublas_side})
+    finally:
+        sampler.stop()
+
+    # Timer rate calibration runs after the clock samples: its sleep spans
+    # would otherwise let the device clocks drop.
+    calibration = _rate_calibration(runtime.driver, args.rate_gap_seconds, args.calibration_rounds)
+    event_timer_rate = calibration.get("median_rate")
+
+    clock_values = [sample["clocks_sm_mhz"] for sample in sampler.samples]
+    clock_max = max([sample["clocks_max_sm_mhz"] for sample in sampler.samples] or [0])
+    clock_sm = statistics.median(clock_values) if clock_values else None
+    clock_ratio = (clock_sm / clock_max) if clock_sm and clock_max else None
+    clock_verdict = "VALID" if clock_ratio is not None and clock_ratio >= CLOCK_RATIO_MIN else "INVALID_CLOCK"
+    limits = VARIANCE_LIMITS_LOCKED if clock_verdict == "VALID" else VARIANCE_LIMITS_UNLOCKED
+
+    cases_out = []
+    for result in case_results:
+        case = result["case"]
+        ours_samples = result["ours"]["samples"]
+        cublas_samples = result["cublas"]["samples"]
+        ours_kernel = [sample["kernel_seconds"] for sample in ours_samples]
+        cublas_kernel = [sample["kernel_seconds"] for sample in cublas_samples]
+        ours_disp = _dispersion(ours_kernel)
+        cublas_disp = _dispersion(cublas_kernel)
+        ours_wall = _dispersion([sample["wall_seconds"] for sample in ours_samples])
+        ours_dispatch = _dispersion(
+            [sample["dispatch_seconds"] for sample in ours_samples if sample["dispatch_seconds"] is not None]
+        )
+        cublas_wall = _dispersion([sample["wall_seconds"] for sample in cublas_samples])
+        cublas_dispatch = _dispersion(
+            [sample["dispatch_seconds"] for sample in cublas_samples if sample["dispatch_seconds"] is not None]
+        )
+        ours_corrected = (
+            ours_disp["median"] * event_timer_rate if event_timer_rate and ours_disp.get("median") else None
+        )
+        cublas_corrected = (
+            cublas_disp["median"] * event_timer_rate if event_timer_rate and cublas_disp.get("median") else None
+        )
+        ratio = (
+            ours_corrected / cublas_corrected if ours_corrected and cublas_corrected else None
+        )
+        dispatch_median = ours_dispatch.get("median")
+        dispatch_share = (
+            dispatch_median / ours_wall["median"] if dispatch_median is not None and ours_wall.get("median") else None
+        )
+        dispatch_dominated = (
+            dispatch_median is not None and ours_disp.get("median") is not None and ours_disp["median"] <= dispatch_median
+        )
+        ours_verdict = _variance_verdict(ours_disp, limits)
+        cublas_verdict = _variance_verdict(cublas_disp, limits)
+        flops = 2.0 * case["m"] * case["n"] * case["k"]
+        cases_out.append(
+            {
+                "name": case["name"],
+                "key": case["keys"],
+                "shape_m_n_k": [case["m"], case["n"], case["k"]],
+                "flops": flops,
+                "flop_accounting": "2 * B * M * N * K (B=1)",
+                "measurement": {
+                    "level": "L0_op",
+                    "execution_model": "op_by_op_dispatch",
+                    "r": args.repeats,
+                    "warmup_samples": args.warmup,
+                    "launches_per_sample": args.launches_per_sample,
+                    "total_launches_per_side": args.repeats * args.launches_per_sample,
+                    "sample_kind": "mean of launches_per_sample back-to-back timed launches",
+                },
+                "lowering": {
+                    "lower_seconds": _round(case["lower_seconds"]),
+                    "compile_seconds": _round(case["compile_seconds"]),
+                    "ptx_target": case["ptx_target"],
+                    "ptx_version": case["ptx_version"],
+                    "ptx_bytes": case["ptx_bytes"],
+                    "artifact_bytes": case["artifact_bytes"],
+                    "ptx_digest": case["ptx_digest"],
+                    "plan_digest": case["plan_digest"],
+                    "program_digest": case["program_digest"],
+                    "kernel_count": case["kernel_count"],
+                },
+                "g1": g1["full_shape_ones"][case["name"]],
+                "pypto_x": {
+                    "warmup": result["ours"]["warmup"],
+                    "statistics": {
+                        "kernel_seconds": ours_disp,
+                        "wall_seconds": ours_wall,
+                        "dispatch_seconds": ours_dispatch,
+                        "variance_limits": limits,
+                        "verdict": ours_verdict,
+                    },
+                    "metrics": {
+                        "kernel_seconds_median": ours_disp.get("median"),
+                        "kernel_seconds_corrected_median": ours_corrected,
+                        "wall_seconds_median": ours_wall.get("median"),
+                        "dispatch_seconds_median": dispatch_median,
+                        "dispatch_share_of_wall": dispatch_share,
+                        "dispatch_dominated": dispatch_dominated,
+                        "gflops": (flops / ours_corrected / 1.0e9) if ours_corrected else None,
+                        "gflops_scope": "kernel_only",
+                    },
+                    "samples": {
+                        "kernel_seconds": [_round(value) for value in ours_kernel],
+                        "wall_seconds": [_round(sample["wall_seconds"]) for sample in ours_samples],
+                        "dispatch_seconds": [
+                            _round(sample["dispatch_seconds"]) for sample in ours_samples
+                        ],
+                    },
+                },
+                "cublas": {
+                    "warmup": result["cublas"]["warmup"],
+                    "library": cublas.path,
+                    "version_raw": cublas.version_raw,
+                    "api": "cublasSgemm_v2" if case["dtype"] == "float32" else "cublasGemmEx",
+                    "compute_type": "CUBLAS_COMPUTE_32F" if case["dtype"] == "bf16" else "f32",
+                    "statistics": {
+                        "kernel_seconds": cublas_disp,
+                        "wall_seconds": cublas_wall,
+                        "dispatch_seconds": cublas_dispatch,
+                        "variance_limits": limits,
+                        "verdict": cublas_verdict,
+                    },
+                    "metrics": {
+                        "kernel_seconds_median": cublas_disp.get("median"),
+                        "kernel_seconds_corrected_median": cublas_corrected,
+                        "wall_seconds_median": cublas_wall.get("median"),
+                        "dispatch_seconds_median": cublas_dispatch.get("median"),
+                        "gflops": (flops / cublas_corrected / 1.0e9) if cublas_corrected else None,
+                        "gflops_scope": "kernel_only",
+                    },
+                    "samples": {
+                        "kernel_seconds": [_round(value) for value in cublas_kernel],
+                        "wall_seconds": [_round(sample["wall_seconds"]) for sample in cublas_samples],
+                    },
+                },
+                "ratio": {
+                    "measured_ratio_raw": (
+                        ours_disp["median"] / cublas_disp["median"]
+                        if ours_disp.get("median") and cublas_disp.get("median")
+                        else None
+                    ),
+                    "measured_ratio_corrected": ratio,
+                    "definition": "pypto_x_median / cublas_median (time ratio, lower is better)",
+                },
+                "stability": {
+                    "rounds": 1,
+                    "r": args.repeats,
+                    "cv_max": limits["cv"],
+                    "p95_over_median_max": limits["p95_over_median"],
+                    "pypto_x_verdict": ours_verdict,
+                    "cublas_verdict": cublas_verdict,
+                    "warmup_verdict": result["ours"]["warmup_verdict"],
+                    "verdict": (
+                        "VALID"
+                        if ours_verdict == "VALID"
+                        and cublas_verdict == "VALID"
+                        and result["ours"]["warmup_verdict"] == "PASS"
+                        else "INVALID"
+                    ),
+                },
+            }
+        )
+
+    runtime.close()
+    fingerprint_after = _nvidia_smi_fingerprint()
+    noise_after = _host_noise_sample()
+    finished_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+    host_fingerprint = _host_fingerprint(gpu)
+    gpu_evidence = {
+        "name": gpu["name"],
+        "driver_kmd": gpu["driver_kmd"],
+        "cuda_umd": gpu["cuda_umd"],
+        "fingerprint_before": fingerprint_before,
+        "fingerprint_after": fingerprint_after,
+        "compute_processes_before_empty": fingerprint_before["compute_apps_empty"],
+        "compute_processes_after_empty": fingerprint_after["compute_apps_empty"],
+        "clock_samples": sampler.samples,
+        "clocks_sm_mhz_p50_under_load": clock_sm,
+        "clocks_sm_mhz_min_under_load": min(clock_values) if clock_values else None,
+        "clocks_sm_mhz_max_under_load": max(clock_values) if clock_values else None,
+        "clocks_max_sm_mhz": clock_max,
+        "clock_ratio": clock_ratio,
+        "clock_verdict": clock_verdict,
+        "clock_warmup_seconds": args.clock_warmup_seconds,
+        "clock_warmup_launches": clock_launches,
+    }
+    noise_verdict = "VALID"
+    for sample in (noise_before, noise_after):
+        if sample["load1"] is not None and sample["load1"] >= (len(affinity) or os.cpu_count()) * HOST_LOAD_MAX_RATIO:
+            noise_verdict = "ENV_NOISY"
+        if sample["cpu_psi_avg10"] is not None and sample["cpu_psi_avg10"] >= HOST_PSI_MAX_AVG10:
+            noise_verdict = "ENV_NOISY"
+        if sample["mem_available_mib"] is not None and sample["mem_available_mib"] <= 4096:
+            noise_verdict = "ENV_NOISY"
+
+    status = "PASS"
+    if g1["status"] != "PASS" or clock_verdict != "VALID" or noise_verdict != "VALID":
+        status = "FAIL"
+    if not affinity_matches:
+        status = "FAIL"
+    blocking = [
+        entry
+        for entry in cases_out
+        if not entry["pypto_x"]["metrics"]["dispatch_dominated"]
+    ]
+    if not blocking:
+        status = "FAIL"
+    if any(entry["stability"]["verdict"] != "VALID" for entry in blocking):
+        status = "FAIL"
+
+    evidence = {
+        "schema_version": 1,
+        "artifact_kind": "pypto-x.perf-evidence",
+        "evidence_role": "raw_round",
+        "task": TASK,
+        "agent": args.agent,
+        "round": args.round,
+        "started_at_utc": started_at,
+        "finished_at_utc": finished_at,
+        "git": {
+            "repository": "upstream/pypto",
+            "head": args.git_head,
+            "branch": args.git_branch,
+        },
+        "host": {
+            "class": "nvidia-5080-wsl2",
+            "fingerprint": host_fingerprint,
+            "uname": environment_freeze["uname"],
+            "python": environment_freeze["python"],
+            "nproc_online": environment_freeze["nproc_online"],
+            "cpu_affinity": affinity,
+            "cpu_affinity_label": affinity_label,
+            "requested_affinity": sorted(requested_affinity),
+            "affinity_matches_requested": affinity_matches,
+            "cpu_model": environment_freeze["cpu_model"],
+            "virtualization": environment_freeze["virtualization"],
+            "mem_total_mib": environment_freeze["mem_total_mib"],
+            "mem_available_before_mib": noise_before["mem_available_mib"],
+            "mem_available_after_mib": noise_after["mem_available_mib"],
+            "noise": {
+                "samples": [noise_before, noise_after],
+                "load1_max": max(
+                    [
+                        sample["load1"]
+                        for sample in (noise_before, noise_after)
+                        if sample["load1"] is not None
+                    ]
+                    or [0.0]
+                ),
+                "cpu_psi_avg10_max": max(
+                    [
+                        sample["cpu_psi_avg10"]
+                        for sample in (noise_before, noise_after)
+                        if sample["cpu_psi_avg10"] is not None
+                    ]
+                    or [0.0]
+                ),
+                "verdict": noise_verdict,
+            },
+            "gpu": gpu_evidence,
+        },
+        "environment_freeze": environment_freeze,
+        "timer_calibration": calibration,
+        "metrics": {
+            "event_timer_rate": event_timer_rate,
+            "event_timer_rate_offset_pct": calibration.get("rate_offset_pct"),
+            "event_timer_rate_spread_pct": calibration.get("spread_pct"),
+            "platform_flags": (
+                ["wsl2_cuevent_rate_offset"]
+                if event_timer_rate is not None and abs(event_timer_rate - 1.0) * 100.0 > 5.0
+                else []
+            ),
+            "peak_rss_mib": _peak_rss_mib(),
+            "gflops_scope": "kernel_only",
+        },
+        "g1_correctness": g1,
+        "cases": [
+            {key: value for key, value in case.items()}
+            for case in cases_out
+        ],
+        "host_fingerprint": host_fingerprint,
+        "status": status,
