+def run_g1_only(args) -> dict:
+    """Deterministic correctness verification only: no timing, no warmup loops.
+
+    This mode exists so G1 can be validated while the measurement window is
+    contended (for example while GamePC is used interactively).  It compiles
+    the selected artifacts, runs the exact-integer / float64-oracle / full-shape
+    ones checks, records the environment fingerprint, and performs **no**
+    clock sampling, rate calibration or timed launch series.
+    """
+
+    started_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    cases_spec = list(DEFAULT_CASES)
+    if args.cases_json:
+        cases_spec = json.loads(args.cases_json)
+    if args.only_case:
+        wanted = set(args.only_case)
+        cases_spec = [spec for spec in cases_spec if spec["name"] in wanted]
+        if not cases_spec:
+            raise SystemExit("--only-case matched no case: {}".format(sorted(wanted)))
+
+    affinity = sorted(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else []
+    affinity_label = args.affinity or ",".join(str(cpu) for cpu in affinity)
+    requested_affinity = _parse_affinity(affinity_label) if affinity_label else set(affinity)
+    affinity_matches = set(affinity) == set(requested_affinity)
+
+    fingerprint_before = _nvidia_smi_fingerprint()
+    noise_before = _host_noise_sample()
+    gpu = {
+        "name": (fingerprint_before.get("raw_csv") or "").split(",")[0].strip(),
+        "driver_kmd": fingerprint_before.get("driver_kmd"),
+        "cuda_umd": fingerprint_before.get("cuda_umd"),
+    }
+
+    runtime = CudaRuntime()
+    if not runtime.is_available():
+        raise SystemExit("CUDA device unavailable: {}".format(runtime.availability().to_dict()))
+    runtime._ensure_context()
+    cublas = Cublas()
+
+    environment_freeze = {
+        "uname": " ".join(platform.uname()),
+        "python": sys.version.split()[0],
+        "cpu_model": _cpu_model(),
+        "nproc_online": len(affinity) if affinity else os.cpu_count(),
+        "cpu_affinity": affinity,
+        "cpu_affinity_label": affinity_label,
+        "requested_affinity": sorted(requested_affinity),
+        "affinity_matches_requested": affinity_matches,
+        "virtualization": "wsl2" if "microsoft" in platform.release().lower() else platform.system(),
+        "mem_total_mib": _mem_total_mib(),
+        "gpu_name": gpu["name"],
+        "driver_kmd": gpu["driver_kmd"],
+        "cuda_umd": gpu["cuda_umd"],
+        "cublas_path": cublas.path,
+        "cublas_version_raw": cublas.version_raw,
+        "ptx_target": DEFAULT_PTX_TARGET,
+        "ptx_version": CUDA_PTX_VERSION,
+        "execution_model": "op_by_op_dispatch",
+        "weights_loaded": False,
+    }
+
+    built_cases = []
+    for spec in cases_spec:
+        case = _build_case(spec["m"], spec["n"], spec["k"], spec["dtype"], name=spec["name"])
+        case["keys"] = _case_key(case, affinity_label)
+        case["left_ptr"] = runtime.driver.mem_alloc(case["m"] * case["k"] * _itemsize(case["dtype"]))
+        case["right_ptr"] = runtime.driver.mem_alloc(case["k"] * case["n"] * _itemsize(case["dtype"]))
+        case["out_ptr"] = runtime.driver.mem_alloc(case["m"] * case["n"] * _itemsize(case["dtype"]))
+        built_cases.append(case)
+
+    g1 = {
+        "small_shape": {dtype: _g1_small_shape(runtime, cublas, dtype) for dtype in ("float32", "bf16")},
+        "full_shape_ones": {},
+    }
+    try:
+        for case in built_cases:
+            g1["full_shape_ones"][case["name"]] = _g1_full_shape_ones(
+                runtime, cublas, case, case["left_ptr"], case["right_ptr"], case["out_ptr"]
+            )
+    finally:
+        for case in built_cases:
+            for key in ("left_ptr", "right_ptr", "out_ptr"):
+                try:
+                    runtime.driver.mem_free(case[key])
+                except Exception:
+                    pass
+    runtime.close()
+    g1["status"] = (
+        "PASS"
+        if all(entry["status"] == "PASS" for entry in g1["small_shape"].values())
+        and all(
+            entry["ours_pass"] and entry["cublas_pass"] for entry in g1["full_shape_ones"].values()
+        )
+        else "FAIL"
+    )
+
+    fingerprint_after = _nvidia_smi_fingerprint()
+    noise_after = _host_noise_sample()
+    host_fingerprint = _host_fingerprint(gpu)
+    status = "PASS" if g1["status"] == "PASS" else "FAIL"
+    return {
+        "schema_version": 1,
+        "artifact_kind": "pypto-x.perf-evidence",
+        "evidence_role": "g1_only",
+        "task": TASK,
+        "agent": args.agent,
+        "started_at_utc": started_at,
+        "finished_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "git": {
+            "repository": "upstream/pypto",
+            "head": args.git_head,
+            "branch": args.git_branch,
+        },
+        "host": {
+            "class": "nvidia-5080-wsl2",
+            "fingerprint": host_fingerprint,
+            "cpu_affinity": affinity,
+            "affinity_matches_requested": affinity_matches,
+            "gpu": {
+                "name": gpu["name"],
+                "driver_kmd": gpu["driver_kmd"],
+                "cuda_umd": gpu["cuda_umd"],
+                "fingerprint_before": fingerprint_before,
+                "fingerprint_after": fingerprint_after,
+                "compute_processes_before_empty": fingerprint_before["compute_apps_empty"],
+                "compute_processes_after_empty": fingerprint_after["compute_apps_empty"],
+                "note": "contended-window fingerprint; no clock assertion and no timing in this mode",
+            },
+            "noise": {"samples": [noise_before, noise_after]},
+        },
+        "host_fingerprint": host_fingerprint,
+        "environment_freeze": environment_freeze,
+        "timing_performed": False,
+        "g1_correctness": g1,
+        "status": status,
+    }
+
+
+# ---------------------------------------------------------------------------
+# aggregation (candidate_ratio only; no threshold freezing)
+# ---------------------------------------------------------------------------
+
+
+def _case_by_name(round_evidence: dict, name: str):
+    for case in round_evidence.get("cases", []):
+        if case["name"] == name:
+            return case
+    return None
+
+
+def aggregate(args) -> dict:
+    rounds = []
+    for path in args.rounds:
+        rounds.append(json.loads(Path(path).read_text(encoding="utf-8")))
+    if len(rounds) != 3:
+        raise SystemExit("aggregate requires exactly 3 round files")
+    first = rounds[0]
+    names = [case["name"] for case in first["cases"]]
+    ratios_out = []
+    stability_out = []
+    for name in names:
+        per_round = []
+        for index, round_evidence in enumerate(rounds, start=1):
+            case = _case_by_name(round_evidence, name)
+            if case is None:
+                raise SystemExit("round {} is missing case {!r}".format(index, name))
+            per_round.append(
+                {
+                    "round": index,
+                    "pypto_x_kernel_seconds_median": case["pypto_x"]["metrics"]["kernel_seconds_median"],
+                    "pypto_x_kernel_seconds_corrected_median": case["pypto_x"]["metrics"]["kernel_seconds_corrected_median"],
+                    "cublas_kernel_seconds_median": case["cublas"]["metrics"]["kernel_seconds_median"],
+                    "cublas_kernel_seconds_corrected_median": case["cublas"]["metrics"]["kernel_seconds_corrected_median"],
+                    "measured_ratio_raw": case["ratio"]["measured_ratio_raw"],
+                    "measured_ratio_corrected": case["ratio"]["measured_ratio_corrected"],
+                    "pypto_x_cv_over_median": case["pypto_x"]["statistics"]["kernel_seconds"]["cv_over_median"],
+                    "pypto_x_p95_over_median": case["pypto_x"]["statistics"]["kernel_seconds"]["p95_over_median"],
+                    "cublas_cv_over_median": case["cublas"]["statistics"]["kernel_seconds"]["cv_over_median"],
+                    "cublas_p95_over_median": case["cublas"]["statistics"]["kernel_seconds"]["p95_over_median"],
+                    "dispatch_share_of_wall": case["pypto_x"]["metrics"]["dispatch_share_of_wall"],
+                    "dispatch_dominated": case["pypto_x"]["metrics"]["dispatch_dominated"],
+                    "launches_per_sample": case.get("measurement", {}).get("launches_per_sample"),
+                    "stability_verdict": case["stability"]["verdict"],
+                    "g1_pass": bool(case["g1"]["ours_pass"] and case["g1"]["cublas_pass"]),
+                }
+            )
+        medians = [entry["pypto_x_kernel_seconds_corrected_median"] for entry in per_round]
+        cublas_medians = [entry["cublas_kernel_seconds_corrected_median"] for entry in per_round]
+        measured_ratios = [entry["measured_ratio_corrected"] for entry in per_round]
+        candidate_ratio = statistics.median(measured_ratios)
+        median_of_medians = statistics.median(medians)
+        median_spread_ratio = (
+            (max(medians) - min(medians)) / median_of_medians if median_of_medians else None
+        )
+        median_spread_ok = median_spread_ratio is not None and median_spread_ratio <= MEDIAN_SPREAD_LIMIT
+        g1_pass = all(entry["g1_pass"] for entry in per_round)
+        g2_pass = all(entry["stability_verdict"] == "VALID" for entry in per_round) and median_spread_ok
+        dispatch_dominated = all(entry["dispatch_dominated"] for entry in per_round)
+        clock_ok = all(
+            round_evidence["host"]["gpu"]["clock_verdict"] == "VALID" for round_evidence in rounds
+        )
+        noise_ok = all(
+            round_evidence["host"]["noise"]["verdict"] == "VALID" for round_evidence in rounds
+        )
+        gate_eligible = bool(
+            g1_pass
+            and g2_pass
+            and noise_ok
+            and clock_ok
+            and not dispatch_dominated
+            and all(round_evidence["status"] == "PASS" for round_evidence in rounds)
+        )
+        key = first["cases"][names.index(name)]["key"]
+        ratio_entry = {
+            "key": key,
+            "baseline": {
+                "tier": "T1_vendor_gpu_lib",
+                "name": "cublas",
+                "availability": "available",
+                "version_raw": rounds[0]["environment_freeze"].get("cublas_version_raw"),
+                "median": statistics.median(cublas_medians),
+                "median_definition": "median over 3 rounds of cuBLAS kernel_seconds_corrected_median",
+                "ratio": candidate_ratio,
+            },
+            "pypto_x_median": median_of_medians,
+            "cublas_median": statistics.median(cublas_medians),
+            "candidate_ratio": candidate_ratio,
+            "frozen_ratio": None,
+            "approved_by": None,
+            "approved_at": None,
+            "measured_ratios": measured_ratios,
+            "per_round": per_round,
+            "stability": {
+                "rounds": 3,
+                "measured_iterations_per_round": args.repeats,
+                "per_round_verdicts": [entry["stability_verdict"] for entry in per_round],
+                "median_spread_ratio": median_spread_ratio,
+                "median_spread_limit": MEDIAN_SPREAD_LIMIT,
+                "median_spread_ok": median_spread_ok,
+                "verdict": "VALID" if g2_pass else "INVALID",
+            },
+            "dispatch": {
+                "dispatch_seconds_median": statistics.median(
+                    [
+                        _case_by_name(round_evidence, name)["pypto_x"]["metrics"]["dispatch_seconds_median"]
+                        for round_evidence in rounds
+                    ]
+                ),
+                "dispatch_share_of_wall": statistics.median(
+                    [entry["dispatch_share_of_wall"] for entry in per_round]
+                ),
+                "dispatch_dominated": dispatch_dominated,
+                "rule": "dispatch_dominated when kernel_seconds <= dispatch_seconds; such numbers do not enter the ratio gate",
+            },
+            "gate_eligible": gate_eligible,
+        }
+        ratios_out.append(ratio_entry)
+        stability_out.append(
+            {
+                "key": key,
+                "confidence": candidate_ratio,
+                "verdict": ratio_entry["stability"]["verdict"],
+                "median_spread_ratio": median_spread_ratio,
+                "per_round": per_round,
+            }
+        )
+
+    host_consistent = len({round_evidence["host_fingerprint"] for round_evidence in rounds}) == 1
+    head_consistent = len({round_evidence["git"]["head"] for round_evidence in rounds}) == 1
+    affinity_consistent = (
+        len(
+            {
+                tuple(round_evidence.get("host", {}).get("cpu_affinity", []))
+                for round_evidence in rounds
+            }
+        )
+        == 1
+    )
+    if not (host_consistent and head_consistent and affinity_consistent):
+        for entry in ratios_out:
+            entry["gate_eligible"] = False
+    eligible = [entry for entry in ratios_out if entry["gate_eligible"]]
+    primary = (
+        max(eligible, key=lambda entry: entry["key"]["shape_tuple"][0] * entry["key"]["shape_tuple"][1] * entry["key"]["shape_tuple"][2])
+        if eligible
+        else None
+    )
+    top_baseline = (
+        {
+            "tier": primary["baseline"]["tier"],
+            "name": primary["baseline"]["name"],
+            "availability": primary["baseline"]["availability"],
+            "version_raw": primary["baseline"]["version_raw"],
+            "median": primary["baseline"]["median"],
+            "ratio": primary["baseline"]["ratio"],
+            "primary_key": primary["key"],
+        }
+        if primary
+        else {
+            "tier": "T1_vendor_gpu_lib",
+            "name": "cublas",
+            "availability": "available",
+            "version_raw": rounds[0]["environment_freeze"].get("cublas_version_raw"),
+            "median": None,
+            "ratio": None,
+            "primary_key": None,
+        }
+    )
+    evidence = {
+        "schema_version": 1,
+        "artifact_kind": "pypto-x.perf-evidence",
+        "evidence_role": "aggregate_3_rounds",
+        "task": TASK,
+        "agent": args.agent,
+        "started_at_utc": first["started_at_utc"],
+        "finished_at_utc": rounds[-1]["finished_at_utc"],
+        "git": first["git"],
+        "host": first["host"],
+        "host_fingerprint": first["host_fingerprint"],
+        "environment_freeze": first["environment_freeze"],
+        "timer_calibration": {
+            "per_round_event_timer_rate": [
+                round_evidence["metrics"]["event_timer_rate"] for round_evidence in rounds
+            ],
+            "per_round_offset_pct": [
+                round_evidence["metrics"]["event_timer_rate_offset_pct"] for round_evidence in rounds
+            ],
+            "platform_flags": sorted(
+                set(
+                    flag
+                    for round_evidence in rounds
+                    for flag in round_evidence["metrics"]["platform_flags"]
+                )
+            ),
+        },
+        "baseline": top_baseline,
+        "ratios": ratios_out,
+        "stability": {
+            "rounds": 3,
+            "measured_iterations_per_round": args.repeats,
+            "independent_processes": True,
+            "host_fingerprint_consistent": host_consistent,
+            "git_head_consistent": head_consistent,
+            "cpu_affinity_consistent": affinity_consistent,
+            "keys": stability_out,
+        },
+        "dispatch": {
+            "definition": "dispatch_seconds = wall_seconds - kernel_seconds per launch; share = dispatch_median / wall_median",
+            "per_key": [
+                {"key": entry["key"], **entry["dispatch"]} for entry in ratios_out
+            ],
+        },
+        "g1_correctness": first["g1_correctness"],
+        "gate": {
+            "g1": first["g1_correctness"]["status"],
+            "g2": (
+                "PASS"
+                if all(
+                    entry["stability"]["verdict"] == "VALID"
+                    for entry in ratios_out
+                    if not entry["dispatch"]["dispatch_dominated"]
+                )
+                and any(not entry["dispatch"]["dispatch_dominated"] for entry in ratios_out)
+                else "FAIL"
+            ),
+            "relative": "G3_ELIGIBLE" if eligible else "UNGATED",
+            "eligible_keys": [entry["key"] for entry in eligible],
+            "consistency": {
+                "host_fingerprint_consistent": host_consistent,
+                "git_head_consistent": head_consistent,
+                "cpu_affinity_consistent": affinity_consistent,
+            },
+            "ineligible_reasons": {
+                "{}:{}:{}".format(
+                    entry["key"]["op"],
+                    "x".join(str(dim) for dim in entry["key"]["shape_tuple"]),
+                    entry["key"]["dtype"],
+                ): (
+                    []
+                    if entry["gate_eligible"]
+                    else (
+                        (["dispatch_dominated"] if entry["dispatch"]["dispatch_dominated"] else [])
+                        + ([] if entry["stability"]["verdict"] == "VALID" else ["INVALID_G2"])
+                        + ([] if entry["per_round"][0]["g1_pass"] else ["INVALID_G1"])
+                        + ([] if host_consistent else ["HOST_FINGERPRINT_INCONSISTENT"])
+                        + ([] if head_consistent else ["GIT_HEAD_INCONSISTENT"])
+                        + ([] if affinity_consistent else ["AFFINITY_INCONSISTENT"])
+                    )
+                )
+                for entry in ratios_out
+            },
+            "threshold_note": "candidate_ratio only; frozen_ratio/approval belongs to B4 and requires user approval",
+        },
+        "raw_round_files": [str(path) for path in args.rounds],
+        "status": "PASS" if eligible and first["g1_correctness"]["status"] == "PASS" else "FAIL",
+    }
+    return evidence
+
+
+# ---------------------------------------------------------------------------
+# CLI
+# ---------------------------------------------------------------------------
+
+
+def _parse_args(argv):
+    parser = argparse.ArgumentParser(description="CUDA GEMM baseline vs cuBLAS (W8B B3b)")
+    parser.add_argument("--mode", choices=("measure", "aggregate", "g1"), default="measure")
+    parser.add_argument("--round", type=int, default=1)
+    parser.add_argument("--repeats", type=int, default=DEFAULT_REPEATS)
+    parser.add_argument("--warmup", type=int, default=DEFAULT_WARMUP)
+    parser.add_argument("--launches-per-sample", type=int, default=5)
+    parser.add_argument("--only-case", action="append", default=[])
+    parser.add_argument("--clock-warmup-seconds", type=float, default=DEFAULT_CLOCK_WARMUP_SECONDS)
+    parser.add_argument("--clock-interval", type=float, default=DEFAULT_CLOCK_INTERVAL)
+    parser.add_argument("--rate-gap-seconds", type=float, default=DEFAULT_RATE_GAP_SECONDS)
+    parser.add_argument("--calibration-rounds", type=int, default=DEFAULT_CALIBRATION_ROUNDS)
+    parser.add_argument("--affinity", default=DEFAULT_AFFINITY)
+    parser.add_argument("--cases-json", default="")
+    parser.add_argument("--json-out", default="")
+    parser.add_argument("--rounds", nargs="*", default=[])
+    parser.add_argument("--git-head", default="unknown")
+    parser.add_argument("--git-branch", default="work/cuda-gemm-baseline")
+    parser.add_argument("--agent", default=DEFAULT_AGENT)
+    return parser.parse_args(argv)
+
+
+def main(argv=None):
+    args = _parse_args(argv)
+    if args.mode == "aggregate":
+        evidence = aggregate(args)
+    elif args.mode == "g1":
+        evidence = run_g1_only(args)
+    else:
+        if args.repeats < 11:
+            raise SystemExit("--repeats must be >= 11 for a dispersion report")
+        evidence = run_round(args)
+    payload = json.dumps(evidence, indent=2, sort_keys=True)
+    if args.json_out:
+        Path(args.json_out).write_text(payload + "\n", encoding="utf-8")
+    print(payload)
+    if args.mode == "aggregate":
+        print(
+            "aggregate gate.relative={} eligible={} status={}".format(
+                evidence["gate"]["relative"],
+                len(evidence["gate"]["eligible_keys"]),
+                evidence["status"],
+            )
+        )
+    elif args.mode == "g1":
+        print(
+            "g1 status={} timing_performed={} cases={}".format(
+                evidence["status"],
+                evidence["timing_performed"],
+                len(evidence["g1_correctness"]["full_shape_ones"]),
+            )
+        )
+    else:
+        print(
+            "round={} status={} g1={} clock_ratio={} rate={}".format(
+                args.round,
+                evidence["status"],
+                evidence["g1_correctness"]["status"],
+                evidence["host"]["gpu"]["clock_ratio"],
+                evidence["metrics"]["event_timer_rate"],
+            )
+        )
+    return 0 if evidence["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
