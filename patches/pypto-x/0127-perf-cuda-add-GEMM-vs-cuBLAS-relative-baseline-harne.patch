+DEFAULT_AGENT = "cuda-gemm-baseline"
+DEFAULT_AFFINITY = "0-5"
+DEFAULT_WORKGROUP = 256
+DEFAULT_TILE = (64, 64)
+DEFAULT_REPEATS = 21
+DEFAULT_WARMUP = 5
+DEFAULT_CLOCK_WARMUP_SECONDS = 3.0
+DEFAULT_RATE_GAP_SECONDS = 3.0
+DEFAULT_CALIBRATION_ROUNDS = 2
+DEFAULT_CLOCK_INTERVAL = 0.4
+WARMUP_ACCEPTANCE = 0.05
+WARMUP_ATTEMPTS = 3
+
+# Protocol §3.4 variance ceilings.  ``clock_unlocked`` selects the relaxed row.
+VARIANCE_LIMITS_LOCKED = {"cv": 0.03, "p95_over_median": 1.15}
+VARIANCE_LIMITS_UNLOCKED = {"cv": 0.05, "p95_over_median": 1.25}
+MEDIAN_SPREAD_LIMIT = 0.10
+CLOCK_RATIO_MIN = 0.9
