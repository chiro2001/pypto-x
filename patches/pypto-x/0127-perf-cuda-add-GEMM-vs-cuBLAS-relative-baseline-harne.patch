+# ---------------------------------------------------------------------------
+# Core IR / artifact helpers
+# ---------------------------------------------------------------------------
+
+
+def _matmul_program(m: int, n: int, k: int, dtype: str) -> CoreProgram:
+    left_type = CoreType.tensor(dtype, (m, k))
+    right_type = CoreType.tensor(dtype, (k, n))
+    output_type = CoreType.tensor(dtype, (m, n))
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("out", output_type)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "matmul",
+                (left, right),
+                (output,),
+                Region((Operation("matmul", (left, right), (output,)),)),
+            ),
+        )
+    )
+
+
+def _build_case(shape_m: int, shape_n: int, shape_k: int, dtype: str, name: str = "") -> dict:
+    """Lower + compile one matmul case and return its immutable description."""
+
+    tile = DEFAULT_TILE
+    target = TargetSpec(
+        "gpu",
+        "gpu-neutral",
+        attributes={"workgroup": (DEFAULT_WORKGROUP,), "tile": tile},
+    )
+    compiler = CudaPtxCompiler()
+    started = time.perf_counter()
+    target_ir = compiler.lower(_matmul_program(shape_m, shape_n, shape_k, dtype), target)
+    lower_seconds = time.perf_counter() - started
+    started = time.perf_counter()
+    artifact = compiler.compile(target_ir)
+    compile_seconds = time.perf_counter() - started
+    plan = target_ir.gpu_program.plans[0]
+    return {
+        "name": name or "gemm_{}x{}x{}_{}".format(shape_m, shape_n, shape_k, dtype),
+        "m": int(shape_m),
+        "n": int(shape_n),
+        "k": int(shape_k),
+        "dtype": dtype,
+        "tile": list(tile),
+        "workgroup": DEFAULT_WORKGROUP,
+        "artifact": artifact,
+        "plan": plan,
+        "ptx_target": target_ir.ptx_target,
+        "ptx_version": target_ir.ptx_version,
+        "ptx_digest": artifact.metadata.get("ptx_digest"),
+        "plan_digest": artifact.metadata.get("plan_digest"),
+        "program_digest": artifact.metadata.get("program_digest"),
+        "artifact_bytes": len(artifact.payload),
+        "lower_seconds": lower_seconds,
+        "compile_seconds": compile_seconds,
+        "ptx_bytes": len(target_ir.ptx.encode("utf-8")),
+        "kernel_count": len(target_ir.gpu_program.plans),
+    }
+
+
+# ---------------------------------------------------------------------------
+# dtype packing helpers
+# ---------------------------------------------------------------------------
+
+
+def _itemsize(dtype: str) -> int:
+    return 2 if dtype == "bf16" else 4
+
+
+def _ones_pattern(dtype: str) -> bytes:
+    if dtype == "bf16":
+        return b"\x80\x3f"  # 1.0 bf16 = 0x3f80 little-endian
+    return b"\x00\x00\x80\x3f"  # 1.0f = 0x3f800000 little-endian
+
+
+def _float_word(dtype: str, value: float) -> bytes:
+    if dtype == "bf16":
+        return struct.pack("<H", _bf16_bits(value))
+    return struct.pack("<f", float(value))
+
+
+def _bf16_bits(value: float) -> int:
+    """Round a Python float to bf16 with round-to-nearest-even."""
+
+    f32 = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    upper = f32 >> 16
+    lower = f32 & 0xFFFF
+    if lower > 0x8000 or (lower == 0x8000 and (upper & 1)):
+        upper += 1
+    return upper & 0xFFFF
+
+
+def _round_to_dtype(dtype: str, value: float) -> float:
+    if dtype == "bf16":
+        return struct.unpack("<f", struct.pack("<I", _bf16_bits(value) << 16))[0]
+    return struct.unpack("<f", struct.pack("<f", float(value)))[0]
+
+
+def _pack_values(dtype: str, values) -> bytes:
+    if dtype == "bf16":
+        return b"".join(struct.pack("<H", _bf16_bits(value)) for value in values)
+    return struct.pack("<{}f".format(len(values)), *[float(value) for value in values])
+
+
+def _unpack_values(dtype: str, raw: bytes):
+    count = len(raw) // _itemsize(dtype)
+    if dtype == "bf16":
+        return [
+            struct.unpack("<f", struct.pack("<I", struct.unpack_from("<H", raw, index * 2)[0] << 16))[0]
+            for index in range(count)
+        ]
+    return list(struct.unpack("<{}f".format(count), raw))
+
+
+# ---------------------------------------------------------------------------
+# statistics / environment helpers
+# ---------------------------------------------------------------------------
+
+
+def _percentile_nearest_rank(values, fraction):
+    ordered = sorted(values)
+    if not ordered:
+        return None
+    index = max(0, math.ceil(fraction * len(ordered)) - 1)
+    return ordered[index]
+
+
+def _dispersion(values) -> dict:
+    """Protocol §3.3 statistics: min/median/p95(nearest-rank)/max/stdev/cv."""
+
+    if not values:
+        return {"n": 0}
+    ordered = sorted(values)
+    median = statistics.median(ordered)
+    stdev = statistics.stdev(ordered) if len(ordered) > 1 else 0.0
+    p95 = _percentile_nearest_rank(ordered, 0.95)
+    mad = (
+        statistics.median([abs(value - median) for value in ordered]) if len(ordered) > 1 else 0.0
+    )
+    outlier_threshold = 3.0 * 1.4826 * mad
+    outliers = (
+        sum(1 for value in ordered if abs(value - median) > outlier_threshold) if mad > 0.0 else 0
+    )
+    return {
+        "n": len(ordered),
+        "min": ordered[0],
+        "median": median,
+        "p95": p95,
+        "p95_method": "nearest_rank",
+        "max": ordered[-1],
+        "mean": statistics.fmean(ordered),
+        "stdev": stdev,
+        "stdev_method": "sample_n_minus_1",
+        "cv_over_median": (stdev / median) if median else 0.0,
+        "cv_method": "stdev/median (perf protocol §3.3)",
+        "p95_over_median": (p95 / median) if median else 0.0,
+        "mad": mad,
+        "outliers_marked": outliers,
+        "outlier_ratio": (outliers / len(ordered)) if ordered else 0.0,
+    }
+
+
+def _variance_verdict(stats: dict, limits: dict) -> str:
+    if stats.get("n", 0) < 11:
+        return "INSUFFICIENT_SAMPLES"
+    if stats["cv_over_median"] > limits["cv"] or stats["p95_over_median"] > limits["p95_over_median"]:
+        return "INVALID_VARIANCE"
+    return "VALID"
+
+
+def _run(command, timeout=30):
+    completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
+    return completed.stdout.strip(), completed.stderr.strip(), completed.returncode
+
+
+def _nvidia_smi_fingerprint() -> dict:
+    raw, _err, code = _run(["nvidia-smi", "--query-gpu=" + GPU_QUERY, "--format=csv,noheader"])
+    apps, _err, _code = _run(
+        ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader"]
+    )
+    perf, _err, _code = _run(["nvidia-smi", "-q", "-d", "PERFORMANCE"])
+    version, _err, _code = _run(["nvidia-smi", "-q"])
+    kmd = cuda_umd = None
+    for line in version.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("KMD Version"):
+            kmd = stripped.split(":", 1)[1].strip()
+        elif stripped.startswith("CUDA UMD Version"):
+            cuda_umd = stripped.split(":", 1)[1].strip()
+    return {
+        "query_command": "nvidia-smi --query-gpu={} --format=csv,noheader".format(GPU_QUERY),
+        "raw_csv": raw,
+        "query_returncode": code,
+        "compute_apps_command": "nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader",
+        "compute_apps_raw": apps,
+        "compute_apps_empty": not apps.strip(),
+        "performance_head": "\n".join(perf.splitlines()[:25]),
+        "driver_kmd": kmd,
+        "cuda_umd": cuda_umd,
+    }
+
+
+def _clock_sample():
+    raw, _err, code = _run(["nvidia-smi", "--query-gpu=" + CLOCK_QUERY, "--format=csv,noheader,nounits"])
+    if code != 0:
+        return None
+    parts = [part.strip() for part in raw.split(",")]
+    try:
+        return {"clocks_sm_mhz": int(float(parts[0])), "clocks_max_sm_mhz": int(float(parts[1]))}
+    except (IndexError, ValueError):
+        return None
+
+
+class _ClockSampler(threading.Thread):
+    """Poll nvidia-smi clocks while the main thread keeps the GPU loaded."""
+
+    def __init__(self, interval=DEFAULT_CLOCK_INTERVAL):
+        super().__init__(daemon=True)
+        self.interval = float(interval)
+        self.samples = []
+        self._stop_event = threading.Event()
+
+    def run(self):
+        while not self._stop_event.is_set():
+            sample = _clock_sample()
+            if sample is not None:
+                self.samples.append(sample)
+            self._stop_event.wait(self.interval)
+
+    def stop(self):
+        self._stop_event.set()
+        self.join(timeout=10)
+
+
+def _cpu_model() -> str:
+    try:
+        with open("/proc/cpuinfo", encoding="utf-8") as handle:
+            for line in handle:
+                if line.lower().startswith("model name"):
+                    return line.split(":", 1)[1].strip()
+    except OSError:
+        pass
+    return platform.processor() or "unknown"
+
+
+def _mem_total_mib():
+    try:
+        with open("/proc/meminfo", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("MemTotal:"):
+                    return int(line.split()[1]) // 1024
+    except OSError:
+        pass
+    return None
+
+
+def _mem_available_mib():
+    try:
+        with open("/proc/meminfo", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("MemAvailable:"):
+                    return int(line.split()[1]) // 1024
+    except OSError:
+        pass
+    return None
+
+
+def _psi_cpu_avg10():
+    try:
+        with open("/proc/pressure/cpu", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("some"):
+                    for field in line.split()[1:]:
+                        if field.startswith("avg10="):
+                            return float(field.split("=", 1)[1])
+    except OSError:
+        pass
+    return None
+
+
+def _host_noise_sample() -> dict:
+    try:
+        load1 = os.getloadavg()[0]
+    except OSError:  # pragma: no cover
+        load1 = None
+    return {
+        "load1": load1,
+        "cpu_psi_avg10": _psi_cpu_avg10(),
+        "mem_available_mib": _mem_available_mib(),
+        "timestamp": time.time(),
+    }
+
+
+def _host_fingerprint(gpu: dict) -> str:
+    material = "|".join(
+        str(part)
+        for part in (
+            _cpu_model(),
+            len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else os.cpu_count(),
+            ",".join(str(cpu) for cpu in sorted(os.sched_getaffinity(0))) if hasattr(os, "sched_getaffinity") else "unknown",
+            platform.release(),
+            "wsl2" if "microsoft" in platform.release().lower() else "linux",
+            gpu.get("name"),
+            gpu.get("driver_kmd"),
+            _mem_total_mib(),
+        )
+    )
+    import hashlib
+
+    return hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def _peak_rss_mib():
+    if _resource is None:
+        return None
+    return _resource.getrusage(_resource.RUSAGE_SELF).ru_maxrss / 1024.0
+
+
+def _round(value, digits=9):
+    return None if value is None else round(float(value), digits)
+
