+
+
+@dataclass(frozen=True)
+class AoclInt8Probe:
+    """Structured result of probing the AOCL int8 symbols on the pinned library."""
+
+    available: bool
+    reason: str
+    message: str
+    library_path: str
+    fingerprint: Mapping[str, Any]
+    checks: Mapping[str, Any]
+    fused_available: bool = False
+
+    def fused_reason(self) -> str:
+        if not self.available:
+            return self.reason
+        missing = list(self.checks.get("fused_missing_symbols") or [])
+        if self.checks.get("k_multiple_of_violation"):
+            return "k_multiple_of_violation"
+        if missing:
+            return "symbol_missing:" + ",".join(missing)
+        return "ok"
+
+
+_PROBE_CACHE: dict = {}
+_BOUND_INT8_PATHS: set = set()
+
+
+def _ensure_int8_bound(path: str, lib: ctypes.CDLL) -> None:
+    """Bind the int8 signatures once per process/path."""
+
+    if path in _BOUND_INT8_PATHS:
+        return
+    _bind_int8_symbols(lib)
+    _BOUND_INT8_PATHS.add(path)
