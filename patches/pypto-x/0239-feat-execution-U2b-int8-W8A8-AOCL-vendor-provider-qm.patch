+#: U2b measured worst-case |aocl_int32 - contract_int32|, seeds 1-8 x
+#: {uniform [100,127], all-127, uniform [-127,127]} x threads {1,2,6},
+#: m=2,n=6 (see ``_meta/pypto-x/u2b-vendor-int8/raw/bit-envelope.json``).
+#: The U2b probe found the Q8 section 8.2 values are *not* upper bounds for
+#: stronger adversarial distributions (133144 alone: 452 vs Q8's 22), so the
+#: declared bound is the elementwise max of the two measurements and both
+#: tables plus the measurement scope are pinned into the provider artifact
+#: digest.  K <= 1024 stays bitwise (0) across every measured distribution.
+AOCL_INT8_MEASURED_BOUND_BY_K = {
+    "133144": 457,
+    "16696": 56,
+    "2048": 1,
+    "3584": 4,
+    "5099": 8,
+}
+AOCL_INT8_DEVIATION_BOUND_BY_K = {
+    key: max(
+        int(AOCL_INT8_Q8_REFERENCE_BOUND_BY_K.get(key, 0)),
+        int(AOCL_INT8_MEASURED_BOUND_BY_K.get(key, 0)),
+    )
+    for key in sorted(set(AOCL_INT8_Q8_REFERENCE_BOUND_BY_K) | set(AOCL_INT8_MEASURED_BOUND_BY_K))
+}
+AOCL_INT8_BITWISE_MAX_K = AOCL_INT8_K_EXACTNESS_BOUNDARY
+AOCL_INT8_ENVELOPE_EVIDENCE = "u2b-vendor-int8/raw/bit-envelope.json"
+AOCL_INT8_ENVELOPE_MEASUREMENT = {
+    "metric": "max_abs_delta_vs_contract_int32_reference",
+    "m": 2,
+    "n": 6,
+    "seeds": [1, 2, 3, 4, 5, 6, 7, 8],
+    "distributions": [
+        "uniform[100,127] (independent A/B generators)",
+        "all-127",
+        "uniform[-127,127]",
+        "uniform[100,127] (one continuing generator; adversarial probe)",
+    ],
+    "thread_counts": [1, 2, 6],
+    "thread_mode": "api_pinned",
+    "derivation": "elementwise max(q8_reference_bound_by_k, u2b_measured_bound_by_k)",
+    "note": "empirical measured envelope, not a proof; both source tables and "
+            "the scope are pinned in the provider artifact digest",
+}
+
+_INT8_SYMBOLS = ("aocl_gemm_s8s8s32os32",)
+_INT8_FUSED_SYMBOLS = (
+    "aocl_gemm_s8s8s32obf16_sym_quant",
+    "aocl_get_reorder_buf_size_s8s8s32os32_sym_quant",
+    "aocl_reorder_s8s8s32os32_sym_quant",
+)
+
+_DIM_T = ctypes.c_int64
+_I8_P = ctypes.POINTER(ctypes.c_int8)
+_I32_P = ctypes.POINTER(ctypes.c_int32)
+_U16_P = ctypes.POINTER(ctypes.c_uint16)
+
+# AOCL LPGEMM storage/post-op enums (aocl_gemm_interface_apis.h).
+AOCL_GEMM_F32 = 0
+AOCL_GEMM_BF16 = 1
