+"""U2b AOCL/LPGEMM int8 (W8A8 ``qmatmul_s8s8_s32``) vendor regressions.
+
+Mirrors the U2a AOCL test structure: the tests use the synthetic ``pypto``
+package namespace so the upstream native initializer never runs.  The AOCL
+artifact is host-local (Q8 ``vendor-gemm-survey``); execution tests skip when
+it is absent, while probe/fail-closed/forgery tests inject structured manifests
+and always run.
+
+Coverage: library probe failures, int8 manifest ground truth (packed ``[K,out]``
+direct consumption, K envelope, two-multiply-epilogue classification), the
+portable trunk's qmatmul path, vendor bit-envelope vs the contract int32
+reference, reserved ``-128`` rejection without output writes, K > 133144
+refusal, plan/report reproducibility, the 0042 report cross-block check on a
+genuine qmatmul report, and forged plan/report refusals.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        from pypto.backends.cpu import HostTensor
+        from pypto.execution import (
+            AOCL_DEFAULT_LIBRARY,
+            AOCL_INT8_DEVIATION_BOUND_BY_K,
+            AOCL_INT8_EXACTNESS_BASIS,
+            AOCL_INT8_IMPLEMENTATION,
+            AOCL_INT8_K_ACCUMULATION_LIMIT,
+            AOCL_INT8_K_EXACTNESS_BOUNDARY,
+            AOCL_INT8_NUMERIC_CLASS,
+            AOCL_INT8_PROVIDER_VERSION,
+            AOCL_INT8_REDUCTION_ORDER,
+            AOCL_LPGEMM_INT8_PROVIDER_ID,
+            AOCL_SHA256_PIN,
+            ARTIFACT_MISMATCH,
+            NUMERIC_GUARANTEE_UNMET,
+            PROVIDER_UNAVAILABLE,
+            CapabilitySnapshot,
+            ExecutionError,
+            ExecutionPlan,
+            ExecutionPolicy,
+            FallbackPolicy,
+            NumericPolicy,
+            OpContractError,
+            ProviderCapability,
+            ProviderPolicy,
+            ProviderUnavailableError,
+            ResourcePolicy,
+            aocl_int8_provider_capabilities,
+            execute_qmatmul,
+            execute_qmatmul_plan,
+            get_op_definition,
+            host_features,
+            plan_qmatmul,
+            portable_provider_capability,
+            probe_aocl_int8,
+            validate_report_schema,
+        )
+        from pypto.execution.provider_aocl_int8 import AoclLpgemmInt8Provider
+        from pypto.execution.resolver import resolve_qmatmul
+        return locals()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
