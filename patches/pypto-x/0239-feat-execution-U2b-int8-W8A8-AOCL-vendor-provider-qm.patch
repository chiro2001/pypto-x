+    entry = aocl_int8_provider_capabilities(probe=probe)[0]
+    definition = get_op_definition("qmatmul_s8s8_s32")
+    assert entry.contracts["qmatmul_s8s8_s32"] == definition.contract_digest
+    assert entry.version == AOCL_INT8_PROVIDER_VERSION
+    assert entry.implementation == AOCL_INT8_IMPLEMENTATION
+    assert entry.dtypes == ("int8",)
+    assert entry.rank_range == (2, 2)
+    assert entry.stride_class == "contiguous_only"
+    assert entry.numeric_class == "deterministic_bounded"
+    assert entry.deterministic is True
+    assert entry.reduction_order_id == AOCL_INT8_REDUCTION_ORDER
+    assert entry.exactness_basis == AOCL_INT8_EXACTNESS_BASIS
+    assert entry.preconditions["min_dimension"] == 1
+    assert entry.preconditions["max_k"] == AOCL_INT8_K_ACCUMULATION_LIMIT
+    assert entry.preconditions["max_rank"] == 2
+    assert entry.preconditions["packed_layout"] == "k_out_rowmajor"
+    assert entry.preconditions["packed_layout_version"] == 3
+    # Packed [K,out] is consumed directly: no per-forward repack/transfer.
+    assert entry.pack["strategy"] == "direct_consume_packed_k_out_rowmajor_zero_repack"
+    assert entry.pack["included_in_timing"] is False
+    assert entry.pack["per_forward_repack_bytes"] == 0
+    # Fused sym_quant is declared, classified and explicitly not routed.
+    fused = entry.fused_variants["sym_quant_bf16"]
+    assert fused["numeric_class"] == "deterministic_bounded"
+    assert fused["k_multiple_of"] == 4
+    assert fused["min_n"] == 2
+    assert fused["routable_via_opcode"] is False
+    assert "two_mul" in fused["epilogue_order_id"]
+    # Numeric envelope ground truth.
+    envelope = entry.exactness_envelope
+    assert envelope["k_exactness_boundary"] == AOCL_INT8_K_EXACTNESS_BOUNDARY
+    assert envelope["k_accumulation_limit"] == AOCL_INT8_K_ACCUMULATION_LIMIT
+    assert envelope["accumulation_width_bits"] == 32
+    assert envelope["reserved_code"] == -128
+    assert list(envelope["code_range"]) == [-127, 127]
+    assert dict(envelope["deviation_bound_by_k"]) == {
+        key: int(value) for key, value in AOCL_INT8_DEVIATION_BOUND_BY_K.items()
+    }
+    # The declared bound is max(Q8 reference, U2b measured): the Q8 section 8.2
+    # values under-state the KC=2048 binary32 chain for adversarial codes, so
+    # both tables and the measurement scope are pinned in the manifest.
+    assert envelope["q8_reference_bound_by_k"]["133144"] == 22
+    assert envelope["measured_bound_by_k"]["133144"] >= 24
+    assert list(envelope["measurement_scope"]["thread_counts"]) == [1, 2, 6]
+    for key, declared in envelope["deviation_bound_by_k"].items():
+        assert int(declared) == max(
+            int(envelope["q8_reference_bound_by_k"].get(key, 0)),
+            int(envelope["measured_bound_by_k"].get(key, 0)),
+        )
+    assert str(entry.provider_artifact_digest).startswith("sha256:")
+    assert entry.library["sha256"] == AOCL_SHA256_PIN
