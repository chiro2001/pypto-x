+
+def _packed_f32(values: Sequence[Any], label: str) -> "ctypes.Array":
+    if not isinstance(values, Sequence) or isinstance(values, (str, bytes)):
+        raise OpContractError(
+            "{} must be a sequence of fp32 scales".format(label),
+            field="fused." + label,
+            requested=type(values).__name__,
+            reason="fused_scale_invalid",
+        )
+    array = (ctypes.c_float * len(values))()
+    for index, value in enumerate(values):
+        if isinstance(value, bool) or not isinstance(value, numbers.Real):
+            raise OpContractError(
+                "{}[{}] must be a real number".format(label, index),
+                field="fused." + label,
+                requested=value,
+                reason="fused_scale_invalid",
+            )
+        array[index] = ctypes.c_float(float(value)).value
+    return array
+
+
+def _check_codes(values: Sequence[Any], label: str) -> None:
+    for index, code in enumerate(values):
+        # ``numbers.Integral`` accepts numpy integer scalars (the ingestion
+        # packer hands over array elements) but not bools or floats.
+        if isinstance(code, bool) or not isinstance(code, numbers.Integral):
+            raise OpContractError(
+                "{}[{}] must be an integer int8 code".format(label, index),
+                field="request." + label,
+                requested=code,
+                reason="code_not_integer",
+            )
+        code = int(code)
+        if code < AOCL_INT8_QUANT_MIN or code > AOCL_INT8_QUANT_MAX:
+            reason = "reserved_code_point" if code == -128 else "code_out_of_range"
+            raise OpContractError(
+                "{}[{}]={} is outside the frozen s8 code range [{}, {}]".format(
+                    label, index, code, AOCL_INT8_QUANT_MIN, AOCL_INT8_QUANT_MAX
+                ),
+                field="request." + label,
+                requested=code,
+                available={
+                    "min": AOCL_INT8_QUANT_MIN,
+                    "max": AOCL_INT8_QUANT_MAX,
+                    "reserved": -128,
+                },
+                reason=reason,
+            )
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = []
+    running = 1
+    for dimension in reversed(tuple(int(item) for item in shape)):
+        strides.append(running)
+        running *= max(dimension, 1)
+    return tuple(reversed(strides))
+
+
+def _check_operand(value: Any, label: str) -> HostTensor:
+    if not isinstance(value, HostTensor):
+        raise OpContractError(
+            "the AOCL int8 vendor provider requires HostTensor operands",
+            field="operand." + label,
+            requested=type(value).__name__,
+            available=["HostTensor"],
+            reason="unsupported_operand_handle",
+        )
+    strides = getattr(value, "strides", None)
+    if strides is not None and tuple(int(item) for item in strides) != _contiguous_strides(value.shape):
+        raise OpContractError(
+            "the AOCL int8 vendor provider requires contiguous row-major storage "
+            "(stride_class=contiguous_only; packed [K,out] is [n,1])",
+            field="operand.{}.strides".format(label),
+            requested=list(strides),
+            available=list(_contiguous_strides(value.shape)),
+            reason="stride_class_not_contiguous",
+        )
+    return value
+
+
+class AoclLpgemmInt8Provider:
+    """The AOCL ``s8s8s32os32`` kernel behind the U1 provider SPI."""
+
+    provider_id = AOCL_LPGEMM_INT8_PROVIDER_ID
+    version = AOCL_INT8_PROVIDER_VERSION
+    implementation = AOCL_INT8_IMPLEMENTATION
+    numeric_class = AOCL_INT8_NUMERIC_CLASS
+    runner_version = AOCL_INT8_RUNNER_VERSION
+    lowering_version = AOCL_LOWERING_VERSION
+    wire_version = AOCL_WIRE_VERSION
+    artifact_kind = AOCL_ARTIFACT_KIND
+    variant = "int8"
+    dtypes = ("int8",)
+    library_path = AOCL_DEFAULT_LIBRARY
+
+    # -- manifest ---------------------------------------------------------
+    def probe(self) -> AoclInt8Probe:
+        return probe_aocl_int8(library_path=self.library_path)
+
+    def capability(
+        self, available: Optional[bool] = None, reason: Optional[str] = None
+    ) -> ProviderCapability:
+        entry = aocl_int8_provider_capabilities(library_path=self.library_path)[0]
+        if available is None:
+            return entry
+        override = dict(entry.to_dict())
+        override["available"] = available
+        override["reason"] = None if available else (reason or "forced_unavailable")
+        return ProviderCapability.from_dict(override)
+
+    def verify_plan_binding(self, plan: ExecutionPlan) -> str:
+        """Reconcile the frozen plan's declaration with this executor manifest."""
+
+        plan.validate()
+        definition = get_op_definition(QMATMUL_CANONICAL_OPCODE)
+        if plan.opcode != QMATMUL_CANONICAL_OPCODE:
+            raise ArtifactMismatchError(
+                "the AOCL int8 provider implements only {!r}".format(QMATMUL_CANONICAL_OPCODE),
+                field="plan.request.op",
+                requested=plan.opcode,
+                available=QMATMUL_CANONICAL_OPCODE,
+                reason="declared_provider_does_not_match_executor",
+            )
+        if plan.contract_digest != definition.contract_digest:
+            raise ArtifactMismatchError(
+                "plan contract digest does not match the registered qmatmul contract",
+                field="plan.contract.digest",
+                requested=plan.contract_digest,
+                available=definition.contract_digest,
+                reason="contract_digest_mismatch",
+            )
+        declared = plan.selected_provider
+        if declared != self.provider_id:
+            allowed_chain = list(plan.fallback_chain)[: plan.fallback_max_steps + 1]
+            if self.provider_id not in allowed_chain:
+                raise ArtifactMismatchError(
+                    "plan declares provider {!r} and does not list {!r} in its fallback chain".format(
+                        declared, self.provider_id
+                    ),
+                    field="plan.selected.provider",
+                    requested=declared,
+                    available=self.provider_id,
+                    reason="declared_provider_does_not_match_executor",
+                )
+            return "declared_fallback"
+        selected = plan.selected
+        for field, manifest_value in (
+            ("provider_version", self.version),
+            ("implementation", self.implementation),
+            ("numeric_class", self.numeric_class),
+        ):
+            if selected.get(field) != manifest_value:
+                raise ArtifactMismatchError(
+                    "plan.selected.{} does not match the provider manifest".format(field),
+                    field="plan.selected." + field,
+                    requested=selected.get(field),
+                    available=manifest_value,
+                    reason="plan_selected_field_not_reconciled_with_provider_manifest",
+                )
+        if plan.artifact_versions.get("provider_version") != self.version:
+            raise ArtifactMismatchError(
+                "plan.artifact.provider_version does not match the provider manifest",
+                field="plan.artifact.provider_version",
+                requested=plan.artifact_versions.get("provider_version"),
+                available=self.version,
+                reason="artifact_declaration_mismatch",
+            )
+        if selected.get("exactness_basis") != "provider_version_threads_and_order":
+            raise ArtifactMismatchError(
+                "plan.selected.exactness_basis is not the vendor family basis",
+                field="plan.selected.exactness_basis",
+                requested=selected.get("exactness_basis"),
+                available="provider_version_threads_and_order",
+                reason="plan_selected_field_not_reconciled_with_provider_manifest",
+            )
+        declared_detail = str(selected.get("exactness_basis_detail") or "")
+        if declared_detail != AOCL_INT8_EXACTNESS_BASIS:
+            raise ArtifactMismatchError(
+                "plan.selected.exactness_basis_detail does not match the provider manifest",
+                field="plan.selected.exactness_basis_detail",
+                requested=declared_detail,
+                available=AOCL_INT8_EXACTNESS_BASIS,
+                reason="plan_selected_field_not_reconciled_with_provider_manifest",
+            )
+        declared_envelope = dict(selected.get("exactness_envelope") or {})
+        if declared_envelope != dict(_exactness_envelope()):
+            raise ArtifactMismatchError(
+                "plan.selected.exactness_envelope does not match the provider manifest",
+                field="plan.selected.exactness_envelope",
+                requested=declared_envelope,
+                available=dict(_exactness_envelope()),
+                reason="plan_selected_field_not_reconciled_with_provider_manifest",
+            )
+        return "selected"
+
+    # -- execution --------------------------------------------------------
+    def execute(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+        capability: Any,
+    ) -> ProviderOutcome:
+        binding_mode = self.verify_plan_binding(plan)
+        _check_operand(left, "left")
+        _check_operand(right, "right")
+        _check_operand(output, "output")
+        self._check_request(plan, left, right, output)
+        self._check_no_alias(left, right, output)
+
+        left_shape = plan.left_shape
+        right_shape = plan.right_shape
+        m, k = int(left_shape[0]), int(left_shape[1])
+        n = int(right_shape[1])
+        if min(m, k, n) < 1:
+            raise OpContractError(
+                "the AOCL int8 vendor provider requires m, k, n >= 1; the portable trunk "
+                "owns empty-axis cases",
+                field="request.shape",
+                requested={"m": m, "k": k, "n": n},
+                available={"min_dimension": 1},
+                reason="vendor_precondition_min_dimension",
+            )
+        if k > AOCL_INT8_K_ACCUMULATION_LIMIT:
+            raise OpContractError(
+                "qmatmul_s8s8_s32 K={} exceeds the provider's INT32 accumulation limit {} (Q5)".format(
+                    k, AOCL_INT8_K_ACCUMULATION_LIMIT
+                ),
+                field="request.shape.k",
+                requested=k,
+                available={"k_max": AOCL_INT8_K_ACCUMULATION_LIMIT},
+                reason="k_exceeds_accumulation_limit",
+            )
+        # Contract code-domain check *before* any kernel call: LPGEMM silently
+        # accepts -128 and any other int8, so the adapter owns this boundary.
+        _check_codes(left.data, "left")
+        _check_codes(right.data, "right")
+
+        if capability is not None and getattr(capability, "digest", None) != plan.capability_digest:
+            raise ArtifactMismatchError(
+                "capability snapshot does not match the frozen plan",
+                field="plan.target.capability_digest",
+                requested=getattr(capability, "digest", None),
+                available=plan.capability_digest,
+                reason="capability_digest_mismatch",
+            )
+
+        probe = self.probe()
+        if not probe.available:
+            raise ProviderUnavailableError(
+                "AOCL int8 provider {!r} is unavailable: {}".format(
+                    self.provider_id, probe.reason
+                ),
+                field="capability.providers",
+                requested=self.provider_id,
+                available=[],
+                reason="provider_capability_unavailable:" + probe.reason,
+                details={"library": mapping_copy(probe.fingerprint), "checks": mapping_copy(probe.checks)},
+            )
+
+        threads = int(plan.selected["threads"])
+        host_cpus = os.cpu_count() or 1
+        if threads < 1 or threads > host_cpus:
+            raise ArtifactMismatchError(
+                "plan selected.threads is outside the host parallelism the provider can honour",
+                field="plan.selected.threads",
+                requested=threads,
+                available={"min": 1, "max": host_cpus},
+                reason="plan_thread_exceeds_host_parallelism",
+            )
+        lib = _get_library(self.library_path)
+        thread_mode, thread_state = _apply_declared_thread_mode(
+            lib, self.library_path, threads, str(plan.selected.get("thread_mode", "env_default"))
+        )
+        return self._execute_int32(
+            plan, left, right, output, lib, threads, binding_mode, thread_mode, thread_state
+        )
+
+    def _check_request(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+    ) -> None:
+        mismatches = {}
+        if plan.opcode != QMATMUL_CANONICAL_OPCODE:
+            mismatches["op"] = plan.opcode
+        if tuple(left.shape) != plan.left_shape:
+            mismatches["left_shape"] = list(left.shape)
+        if tuple(right.shape) != plan.right_shape:
+            mismatches["right_shape"] = list(right.shape)
+        if tuple(output.shape) != plan.output_shape:
+            mismatches["output_shape"] = list(output.shape)
+        if plan.dtype != "int8":
+            mismatches["dtype"] = plan.dtype
+        if left.dtype != "int8" or right.dtype != "int8" or output.dtype != "int32":
+            mismatches["operand_dtypes"] = {
+                "left": left.dtype,
+                "right": right.dtype,
+                "output": output.dtype,
+            }
+        if mismatches:
+            raise ArtifactMismatchError(
+                "execution request does not match the frozen plan",
+                field="plan.request",
+                requested=mismatches,
+                available=plan.request,
+                reason="plan_request_mismatch",
+            )
+        if len(plan.left_shape) != 2 or len(plan.right_shape) != 2:
+            raise OpContractError(
+                "the AOCL int8 vendor provider supports rank-2 qmatmul only",
+                field="request.shape.rank",
+                requested={"left": len(plan.left_shape), "right": len(plan.right_shape)},
+                available=[2],
+                reason="vendor_precondition_rank_out_of_range",
+            )
+
+    def _check_no_alias(
+        self, left: HostTensor, right: HostTensor, output: HostTensor
+    ) -> None:
+        for label, operand in (("left", left), ("right", right)):
+            if output is operand or output.data is operand.data:
+                raise OpContractError(
+                    "output must not alias the {} input buffer".format(label),
+                    field="output",
+                    requested={
+                        "alias": label,
+                        "same_object": output is operand,
+                        "same_storage": output.data is operand.data,
+                    },
+                    available="distinct output storage",
+                    reason="output_input_alias",
+                )
+
+    def prepare_int32(
+        self, left: HostTensor, right: HostTensor
+    ) -> Any:
+        """Prepare one int32 GEMM call with buffers built outside the timed region.
+
+        Returns a zero-argument callable; ``output`` is the reused ``c_int32``
+        buffer.  The execution path uses this so ``op_seconds`` measures only
+        the library call, and the evidence matrix can run a tight Q8-aligned
+        loop without paying Python marshalling between timed calls.
+        """
+
+        _check_operand(left, "left")
+        _check_operand(right, "right")
+        if len(left.shape) != 2 or len(right.shape) != 2:
+            raise OpContractError(
+                "the AOCL int8 vendor provider supports rank-2 qmatmul only",
+                field="request.shape.rank",
+                requested={"left": len(left.shape), "right": len(right.shape)},
+                available=[2],
+                reason="vendor_precondition_rank_out_of_range",
+            )
+        m, k = (int(value) for value in left.shape)
+        n = int(right.shape[1])
+        if int(right.shape[0]) != k:
+            raise OpContractError(
+                "qmatmul K mismatch: left K={} right K={}".format(k, int(right.shape[0])),
+                field="request.shape.k",
+                requested={"left_k": k, "right_k": int(right.shape[0])},
+                reason="shape_rule_violation",
+            )
+        _check_codes(left.data, "left")
+        _check_codes(right.data, "right")
+        if k > AOCL_INT8_K_ACCUMULATION_LIMIT:
+            raise OpContractError(
+                "qmatmul_s8s8_s32 K={} exceeds the provider's INT32 accumulation limit {} (Q5)".format(
+                    k, AOCL_INT8_K_ACCUMULATION_LIMIT
+                ),
+                field="request.shape.k",
+                requested=k,
+                available={"k_max": AOCL_INT8_K_ACCUMULATION_LIMIT},
+                reason="k_exceeds_accumulation_limit",
+            )
+        lib = _get_library(self.library_path)
+        _ensure_int8_bound(self.library_path, lib)
+        a_arr = array("b", left.data)
+        b_arr = array("b", right.data)
+        a_buf = (ctypes.c_int8 * len(a_arr)).from_buffer(a_arr)
+        b_buf = (ctypes.c_int8 * len(b_arr)).from_buffer(b_arr)
+        c_buf = (ctypes.c_int32 * (m * n))()
+
+        class _PreparedInt32:
+            output = c_buf
+
+            def __call__(_self) -> None:
+                lib.aocl_gemm_s8s8s32os32(
+                    b"r", b"n", b"n",
+                    _DIM_T(m), _DIM_T(n), _DIM_T(k),
+                    ctypes.c_int32(1),
+                    ctypes.cast(a_buf, _I8_P), _DIM_T(k), b"n",
+                    ctypes.cast(b_buf, _I8_P), _DIM_T(n), b"n",
+                    ctypes.c_int32(0),
+                    ctypes.cast(c_buf, _I32_P), _DIM_T(n),
+                    None,
+                )
+
+        prepared = _PreparedInt32()
+        # Anchor the ctypes owners for the callable's lifetime.
+        prepared.keep = (a_arr, b_arr, a_buf, b_buf, c_buf)
+        return prepared
+
+    def _execute_int32(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+        lib: ctypes.CDLL,
+        threads: int,
+        binding_mode: str,
+        thread_mode: str,
+        thread_state: Mapping[str, Any],
+    ) -> ProviderOutcome:
+        prepared = self.prepare_int32(left, right)
+        started = time.perf_counter()
+        prepared()
+        op_seconds = time.perf_counter() - started
+        output.data[:] = [int(value) for value in prepared.output]
+        outcome = self._outcome(
+            plan, output, op_seconds, 0.0, lib, threads, binding_mode, thread_mode, thread_state
+        )
+        return outcome
+
+    # -- fused sym_quant variant (declared capability; evidence/future path) --
+    def reorder_sym_quant(self, right_codes: Sequence[int], k: int, n: int):
+        """Reorder a ``[K,out]`` int8 weight into the AOCL sym_quant layout.
+
+        This is the ingestion/artifact-time step of the fused variant.  It must
+        only be called during artifact preparation; the returned buffer is read
+        for every forward without any further transfer.
+        """
+
+        if k % 4 != 0:
+            raise OpContractError(
+                "the fused sym_quant variant requires K % 4 == 0 (K={})".format(k),
+                field="fused.k",
+                requested=k,
+                available={"multiple_of": 4},
+                reason="fused_k_multiple_of_violation",
+            )
+        if n < 2:
+            raise OpContractError(
+                "the fused sym_quant variant writes no output for n<2 on the pinned build",
+                field="fused.n",
+                requested=n,
+                available={"min_n": 2},
+                reason="fused_n_min_violation",
+            )
+        if isinstance(right_codes, HostTensor):
+            right_codes = right_codes.data
+        if isinstance(right_codes, ctypes.Array):
+            source = right_codes
+            if len(source) != k * n:
+                raise OpContractError(
+                    "reorder_sym_quant expects k*n={} codes, got {}".format(k * n, len(source)),
+                    field="fused.right",
+                    requested=len(source),
+                    available={"expected": k * n},
+                    reason="fused_shape_invalid",
+                )
+        else:
+            _check_codes(right_codes, "right")
+            source = (ctypes.c_int8 * len(right_codes))(*(int(value) for value in right_codes))
+        lib = _get_library(self.library_path)
+        _ensure_int8_bound(self.library_path, lib)
+        meta = _AoclSymmStatQuant(group_size=_DIM_T(k))
+        size = int(
+            lib.aocl_get_reorder_buf_size_s8s8s32os32_sym_quant(
+                b"r", b"n", b"b", _DIM_T(k), _DIM_T(n), ctypes.pointer(meta)
+            )
+        )
+        if size <= 0:
+            raise ProviderUnavailableError(
+                "AOCL sym_quant reorder buffer size is {} for k={} n={}; failing closed".format(
+                    size, k, n
+                ),
+                field="fused.shape",
+                requested={"k": k, "n": n},
+                available={"reorder_buffer_bytes": ">0"},
+                reason="reorder_buffer_size_zero",
+            )
+        reordered = (ctypes.c_int8 * size)()
+        lib.aocl_reorder_s8s8s32os32_sym_quant(
+            b"r", b"n", b"b",
+            ctypes.cast(source, _I8_P), ctypes.cast(reordered, _I8_P),
+            _DIM_T(k), _DIM_T(n), _DIM_T(n), ctypes.pointer(meta),
+        )
+        return reordered, size
+
+    def execute_fused_sym_quant(
+        self,
+        left_codes: Sequence[int],
+        right_reordered: Sequence[int],
+        m: int,
+        k: int,
+        n: int,
+        row_scales: Sequence[float],
+        column_scales: Sequence[float],
+    ) -> Tuple[int, ...]:
+        """Run the fused ``s8s8s32obf16_sym_quant`` variant and return bf16 bits.
+
+        The epilogue evaluates ``(acc * s_w) * s_a`` (per K-group; single group
+        here), which is deterministic but not the contract's single-RNE order.
+        """
+
+        call = self.prepare_fused_sym_quant(
+            left_codes, right_reordered, m, k, n, row_scales, column_scales
+        )
+        call()
+        return tuple(int(value) for value in call.output)
+
+    def prepare_fused_sym_quant(
+        self,
+        left_codes: Sequence[int],
+        right_reordered: Sequence[int],
+        m: int,
+        k: int,
+        n: int,
+        row_scales: Sequence[float],
+        column_scales: Sequence[float],
+    ) -> Any:
+        """Build the fused sym_quant call once (setup outside the timed region).
+
+        Returns a zero-argument callable whose ``output`` attribute is the
+        reused ``uint16`` bf16 buffer.  This mirrors the Q8 protocol (post-op
+        and buffers prepared outside the timed GEMM call) and lets the
+        evidence matrix compare identical measurement regions.
+        """
+
+        if k % 4 != 0:
+            raise OpContractError(
+                "the fused sym_quant variant requires K % 4 == 0 (K={})".format(k),
+                field="fused.k",
+                requested=k,
+                available={"multiple_of": 4},
+                reason="fused_k_multiple_of_violation",
+            )
+        if k > AOCL_INT8_K_ACCUMULATION_LIMIT:
+            raise OpContractError(
+                "fused sym_quant K={} exceeds the INT32 accumulation limit {}".format(
+                    k, AOCL_INT8_K_ACCUMULATION_LIMIT
+                ),
+                field="fused.k",
+                requested=k,
+                available={"k_max": AOCL_INT8_K_ACCUMULATION_LIMIT},
+                reason="k_exceeds_accumulation_limit",
+            )
+        if min(m, k, n) < 1:
+            raise OpContractError(
+                "fused sym_quant requires m, k, n >= 1",
+                field="fused.shape",
+                requested={"m": m, "k": k, "n": n},
+                reason="fused_shape_invalid",
+            )
+        if n < 2:
+            raise OpContractError(
+                "the fused sym_quant variant writes no output for n<2 on the pinned build",
+                field="fused.n",
+                requested=n,
+                available={"min_n": 2},
+                reason="fused_n_min_violation",
+            )
+        if len(row_scales) != m or len(column_scales) != n:
+            raise OpContractError(
+                "fused sym_quant scales must have lengths m={} / n={}".format(m, n),
+                field="fused.scales",
+                requested={"row": len(row_scales), "column": len(column_scales)},
+                reason="fused_scale_length_mismatch",
+            )
+        _check_codes(left_codes, "left")
+        if len(right_reordered) < k * n:
+            raise OpContractError(
+                "fused sym_quant reordered B buffer is shorter than k*n={}".format(k * n),
+                field="fused.right_reordered",
+                requested=len(right_reordered),
+                available={"min_len": k * n},
+                reason="fused_reordered_buffer_too_short",
+            )
+        lib = _get_library(self.library_path)
+        _ensure_int8_bound(self.library_path, lib)
+        a_arr = (ctypes.c_int8 * (m * k))(*(int(value) for value in left_codes))
+        if isinstance(right_reordered, ctypes.Array):
+            # The AOCL reorder buffer carries padding, so only the lower bound
+            # is a contract violation; the kernel owns the layout.
+            b_arr = right_reordered
+            if len(b_arr) < k * n:
+                raise OpContractError(
+                    "fused sym_quant reordered B buffer is shorter than k*n={}".format(k * n),
+                    field="fused.right_reordered",
+                    requested=len(b_arr),
+                    available={"min_len": k * n},
+                    reason="fused_shape_invalid",
+                )
+        else:
+            b_arr = (ctypes.c_int8 * len(right_reordered))(*(int(value) for value in right_reordered))
+        out = (ctypes.c_uint16 * (m * n))()
+        a_scale = _packed_f32(row_scales, "row_scales")
+        b_scale = _packed_f32(column_scales, "column_scales")
+        # Keep every ctypes owner alive until the callable returns.
+        keep = {"a_arr": a_arr, "b_arr": b_arr, "out": out, "a_scale": a_scale, "b_scale": b_scale}
+        a_sf = _AoclPreOpSf(
+            scale_factor=ctypes.cast(a_scale, ctypes.c_void_p),
+            scale_factor_len=_DIM_T(len(row_scales)),
+            scale_factor_type=AOCL_GEMM_F32,
+        )
+        b_sf = _AoclPreOpSf(
+            scale_factor=ctypes.cast(b_scale, ctypes.c_void_p),
+            scale_factor_len=_DIM_T(len(column_scales)),
+            scale_factor_type=AOCL_GEMM_F32,
+        )
+        group = _AoclGroupPostOp()
+        group.group_size = _DIM_T(k)
+        group.seq_length = _DIM_T(1)
+        group.a_scl = ctypes.cast(ctypes.pointer(a_sf), ctypes.c_void_p)
+        group.b_scl = ctypes.cast(ctypes.pointer(b_sf), ctypes.c_void_p)
+        group.a_zp = None
+        group.b_zp = None
+        post = _AoclPostOp()
+        post.post_op_grp = ctypes.cast(ctypes.pointer(group), ctypes.c_void_p)
+        keep.update({"a_sf": a_sf, "b_sf": b_sf, "group": group, "post": post})
+
+        class _PreparedFused:
+            output = out
+
+            def __call__(_self) -> None:
+                lib.aocl_gemm_s8s8s32obf16_sym_quant(
+                    b"r", b"n", b"n",
+                    _DIM_T(m), _DIM_T(n), _DIM_T(k),
+                    ctypes.c_int32(1),
+                    ctypes.cast(a_arr, _I8_P), _DIM_T(k), b"n",
+                    ctypes.cast(b_arr, _I8_P), _DIM_T(n), b"r",
+                    ctypes.c_int32(0),
+                    ctypes.cast(out, _U16_P), _DIM_T(n),
+                    ctypes.cast(ctypes.pointer(post), ctypes.c_void_p),
+                )
+
+        prepared = _PreparedFused()
+        prepared.keep = keep  # anchor the ctypes owners for the callable's lifetime
+        return prepared
+
+    # -- outcome ----------------------------------------------------------
+    def _outcome(
+        self,
+        plan: ExecutionPlan,
+        output: HostTensor,
+        op_seconds: float,
+        pack_seconds: float,
+        lib: ctypes.CDLL,
+        threads: int,
+        binding_mode: str,
+        thread_mode: str,
+        thread_state: Mapping[str, Any],
+    ) -> ProviderOutcome:
+        probe = self.probe()
+        fingerprint = mapping_copy(probe.fingerprint)
+        artifact_digest = _provider_artifact_digest(
+            fingerprint, self.implementation, "int32"
+        )
+        pack = _int8_pack_spec("int32")
+        try:
+            affinity = tuple(sorted(int(cpu) for cpu in os.sched_getaffinity(0)))
+        except (AttributeError, OSError):
+            affinity = ()
+        return ProviderOutcome(
+            output=output,
+            artifact_format="aocl.lpgemm.int8.v1",
+            artifact_content_digest=artifact_digest,
+            abi_version=AOCL_INT8_ABI_VERSION,
+            lowering_version=self.lowering_version,
+            wire_version=self.wire_version,
+            op_seconds=float(op_seconds),
+            threads_used=int(threads),
+            provider_version=self.version,
+            implementation=self.implementation,
+            numeric_class=self.numeric_class,
+            library=fingerprint,
+            pack_seconds=float(pack_seconds),
+            pack_strategy=str(pack["strategy"]),
+            pack_included_in_timing=bool(pack["included_in_timing"]),
+            artifact_kind=self.artifact_kind,
+            provider_artifact_digest=artifact_digest,
+            cpu_affinity=affinity,
+            binding_mode=binding_mode,
+            thread_mode=thread_mode,
+            thread_state=dict(thread_state),
+        )
+
+
+def aocl_int8_providers() -> Mapping[str, AoclLpgemmInt8Provider]:
+    return {AOCL_LPGEMM_INT8_PROVIDER_ID: AoclLpgemmInt8Provider()}
+
+
+__all__ = [
+    "AOCL_INT8_ABI_VERSION",
+    "AOCL_INT8_DEVIATION_BOUND_BY_K",
+    "AOCL_INT8_ENVELOPE_MEASUREMENT",
+    "AOCL_INT8_EXACTNESS_BASIS",
+    "AOCL_INT8_FUSED_EXACTNESS_BASIS",
+    "AOCL_INT8_FUSED_IMPLEMENTATION",
+    "AOCL_INT8_FUSED_REDUCTION_ORDER",
+    "AOCL_INT8_IMPLEMENTATION",
+    "AOCL_INT8_K_ACCUMULATION_LIMIT",
+    "AOCL_INT8_K_EXACTNESS_BOUNDARY",
+    "AOCL_INT8_KC_BLOCK",
+    "AOCL_INT8_MEASURED_BOUND_BY_K",
+    "AOCL_INT8_Q8_REFERENCE_BOUND_BY_K",
+    "AOCL_INT8_NUMERIC_CLASS",
+    "AOCL_INT8_PROVIDER_VERSION",
+    "AOCL_INT8_QUANT_MAX",
+    "AOCL_INT8_LOWERING_VERSION",
+    "AOCL_INT8_QUANT_MIN",
+    "AOCL_INT8_REDUCTION_ORDER",
+    "AOCL_INT8_RUNNER_VERSION",
+    "AOCL_INT8_WIRE_VERSION",
+    "AoclInt8Probe",
+    "AoclLpgemmInt8Provider",
