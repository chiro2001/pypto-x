+# ---------------------------------------------------------------------------
+# 0042 item 1b interaction: the named rule-echo surface on qmatmul reports
+# ---------------------------------------------------------------------------
+def _perturb(value):
+    from collections.abc import Mapping as _Mapping
+
+    if isinstance(value, bool):
+        return not value
+    if isinstance(value, int):
+        return value + 1
+    if isinstance(value, str):
+        return value + "_tamper"
+    if isinstance(value, list):
+        if value:
+            value = list(value)
+            value[0] = _perturb(value[0])
+            return value
+        return ["tamper"]
+    if isinstance(value, _Mapping):
+        result = dict(value)
+        if result:
+            key = sorted(result)[0]
+            result[key] = _perturb(result[key])
+        else:
+            result["tamper"] = True
+        return result
+    return "tamper"
+
+
+def _genuine_qmatmul_report_document():
+    import json
+
+    left = HostTensor("int8", (2, 4), [1, 2, 3, 4, 5, 6, 7, 8])
+    right = HostTensor("int8", (4, 2), [1, 0, 0, 1, 1, 1, -1, 1])
+    _, report = execute_qmatmul(left, right, _portable_policy())
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def test_qmatmul_every_named_rule_echo_is_reconciled():
+    """The 0042 item 1b named-echo surface must cover qmatmul too."""
+
+    import json
+
+    document = _genuine_qmatmul_report_document()
+    validate_report_schema(document)
+    declared = document["dispatch"]["provider_declared"]
+    failures = []
+    for index, rule in enumerate(document["resolution"]["rules"]):
+        name = rule["rule"]
+        for key, value in rule["details"].items():
+            if name == "provider.filter" and key == "deterministic" and rule["details"].get("provider") != declared:
+                continue
+            broken = json.loads(json.dumps(document))
+            target = broken["resolution"]["rules"][index]["details"]
+            if name == "provider.select" and key == "ordered" and target["ordered"]:
+                target["ordered"][0]["provider"] = "vendor:bogus"
+            else:
+                target[key] = _perturb(value)
+            try:
+                validate_report_schema(broken)
+            except Exception as exc:  # noqa: BLE001
+                if getattr(exc, "code", None) != "REPORT_SCHEMA_INVALID":
+                    failures.append((name, key, "wrong code {}".format(getattr(exc, "code", None))))
+                continue
+            failures.append((name, key, "ACCEPTED"))
+    assert failures == [], failures
+
