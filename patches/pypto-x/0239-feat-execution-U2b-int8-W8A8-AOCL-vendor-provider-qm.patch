+def test_pinned_int8_probe_facts_and_manifest():
+    probe = probe_aocl_int8(use_cache=False)
+    assert probe.available is True and probe.reason == "ok"
+    assert probe.fingerprint["sha256"] == AOCL_SHA256_PIN
+    assert probe.fingerprint["arch_string"] == "zen4"
+    assert probe.fingerprint["int8_api"]["gemm"] == "aocl_gemm_s8s8s32os32"
