+
+
+def _provider_artifact_digest(
+    fingerprint: Mapping[str, Any], implementation: str, variant: str
+) -> str:
+    document = {
+        "artifact_kind": AOCL_ARTIFACT_KIND,
+        "provider_version": AOCL_INT8_PROVIDER_VERSION,
+        "opcode": QMATMUL_CANONICAL_OPCODE,
