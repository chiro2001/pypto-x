+        "k_accumulation_limit": AOCL_INT8_K_ACCUMULATION_LIMIT,
+        "deviation_bound_by_k": dict(AOCL_INT8_DEVIATION_BOUND_BY_K),
+        "q8_reference_bound_by_k": dict(AOCL_INT8_Q8_REFERENCE_BOUND_BY_K),
+        "measured_bound_by_k": dict(AOCL_INT8_MEASURED_BOUND_BY_K),
+        "measurement_scope": dict(AOCL_INT8_ENVELOPE_MEASUREMENT),
+        "deviation_metric": "max_abs_delta_vs_contract_int32_reference_worst_case_codes",
+        "wrap_behavior": "k>=133145 is refused by the adapter before the kernel call; "
+                         "LPGEMM wraps silently and is never allowed to run",
+        "code_range": [AOCL_INT8_QUANT_MIN, AOCL_INT8_QUANT_MAX],
+        "reserved_code": -128,
+        "reserved_code_behavior": "LPGEMM accepts -128 silently; the adapter rejects it",
+        "reduction_order_id": AOCL_INT8_REDUCTION_ORDER,
+        "fused_epilogue_order_id": AOCL_INT8_FUSED_REDUCTION_ORDER,
+        "evidence": AOCL_INT8_ENVELOPE_EVIDENCE,
+    }
