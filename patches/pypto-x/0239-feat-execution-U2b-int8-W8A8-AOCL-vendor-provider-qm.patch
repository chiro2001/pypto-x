+class _AoclPreOpSf(ctypes.Structure):
+    _fields_ = [
+        ("scale_factor", ctypes.c_void_p),
+        ("scale_factor_len", _DIM_T),
+        ("scale_factor_type", ctypes.c_int),
+    ]
+
+
+class _AoclGroupPostOp(ctypes.Structure):
+    _fields_ = [
+        ("group_size", _DIM_T),
+        ("seq_length", _DIM_T),
+        ("a_scl", ctypes.c_void_p),
+        ("b_scl", ctypes.c_void_p),
+        ("a_zp", ctypes.c_void_p),
+        ("b_zp", ctypes.c_void_p),
+    ]
