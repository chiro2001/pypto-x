+def _int_codes(shape, seed, low=-127, high=127):
+    count = 1
+    for dimension in shape:
+        count *= dimension
+    state = seed & 0xFFFFFFFF
+    values = []
+    for _ in range(count):
+        state = (1103515245 * state + 12345) & 0x7FFFFFFF
+        values.append(low + (state % (high - low + 1)))
+    return values
+
+
+def _tensor(shape, seed, low=-127, high=127):
+    return HostTensor("int8", shape, _int_codes(shape, seed, low, high))
+
+
+def _vendor_policy(requirement="deterministic", max_threads=2, fallback=None, mode="vendor"):
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
