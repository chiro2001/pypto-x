+def test_fused_sym_quant_variant_matches_the_portable_epilogue_on_single_group():
+    # The fused variant is declared but not routed through the opcode SPI; it
+    # is still exercised directly so the deterministic-bounded classification
+    # and the two-multiply order have executable evidence.
+    left = _tensor((3, 64), seed=1101)
+    right = _tensor((64, 8), seed=1102)
+    row_scales = [0.5, 0.25, 0.75]
+    column_scales = [0.1 * (index + 1) for index in range(8)]
+    provider = AoclLpgemmInt8Provider()
+    reordered, size = provider.reorder_sym_quant(right.flat(), 64, 8)
+    assert size >= 64 * 8
+    bits = provider.execute_fused_sym_quant(
+        left.flat(), list(reordered), 3, 64, 8, row_scales, column_scales
+    )
+    from pypto.portable.qwen35_w8a8_scheme import dequantize_epilogue_bf16
+
+    reference = dequantize_epilogue_bf16(
+        _portable_int32_reference(left, right), row_scales, column_scales, shape=(3, 8)
+    )
+    mismatches = sum(1 for got, expected in zip(bits, reference.bf16_bits) if int(got) != int(expected))
+    # The two-multiply order is deterministic but *not* the contract's
+    # single-RNE order; the bound is a small bf16 ulp count, never a bitwise
+    # claim (Q8 observed 0 mismatches on many shapes).
+    assert mismatches <= 3 * 8
+    assert len(bits) == 24
+
