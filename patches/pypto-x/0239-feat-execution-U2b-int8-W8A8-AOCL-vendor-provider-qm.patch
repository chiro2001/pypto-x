+def test_fused_sym_quant_two_mul_order_witness():
+    """A crafted legal input where ``(acc*s_w)*s_a`` flips a bf16 bit."""
+
+    provider = AoclLpgemmInt8Provider()
+    k, n = 4, 4
+    left = [127, 127, 127, 127]
+    right = [127, 0, 0, 0, 127, 0, 0, 0, 127, 0, 0, 0, 6, 0, 0, 0]
+    row_scales = [0.08556543290615082]
+    column_scales = [0.2163855880498886, 1.0, 1.0, 1.0]
+    reordered, _ = provider.reorder_sym_quant(right, k, n)
+    fused = provider.execute_fused_sym_quant(left, reordered, 1, k, n, row_scales, column_scales)
+    from pypto.portable.qwen35_w8a8_scheme import dequantize_epilogue_bf16
+
+    accumulator = _portable_int32_reference(
+        HostTensor("int8", (1, k), left), HostTensor("int8", (k, n), right)
+    )
+    contract = dequantize_epilogue_bf16(accumulator, row_scales, column_scales, shape=(1, n))
+    assert int(fused[0]) != int(contract.bf16_bits[0])
+    assert int(fused[0]) == 17508 and int(contract.bf16_bits[0]) == 17507
+    assert fused[1:] == tuple(int(value) for value in contract.bf16_bits[1:])
+
