+"""AOCL-BLIS / LPGEMM int8 (W8A8) vendor provider binding for U2b.
+
+Scope (frozen by the U2b dispatch and the W8A8 contract v2):
+
+* ``vendor:aocl-lpgemm-int8`` -- ``aocl_gemm_s8s8s32os32`` consuming the c1
+  packed ``[K, out]`` row-major weight **directly** (``mem_format_b='n'``,
+  ``rs_b=n`` / ``cs_b='n'``): zero per-forward repack and zero transfer, the
+  pack is already the ingestion-time artifact layout (0010 sections 3.4/5);
+* the same library's fused ``aocl_gemm_s8s8s32obf16_sym_quant`` variant is
+  declared as a provider capability and implemented here, but is **not routed
+  through the U1 opcode SPI** in this slice: the SPI passes two operands and a
+  fused GEMM+epilogue contract is not registered (registered as a boundary).
+
+Numeric ground truth (0006 section 13.9 answer 5 + the Q8 measured envelope):
+
+* AOCL accumulates the exact per-``KC=2048`` int32 partial, then chains the
+  blocks in binary32 and wraps to int32.  K <= 1024 is bitwise equal to the
+  contract's exact int32 reference; larger K is only bounded by the declared
+  per-K envelope; K >= 133145 must be refused by *us* before the kernel call
+  (LPGEMM wraps silently);
+* the fused epilogue evaluates ``(acc * s_w) * s_a`` (two multiplies), while
+  the contract's ``dequantize_epilogue_bf16`` freezes "form ``s_a*s_w`` once,
+  then multiply the accumulator".  A vendor path with that ordering is
+  ``deterministic_bounded`` and must never inherit the contract's bitwise
+  claim;
+* ``-128`` is a legal int8 for LPGEMM and is silently accepted (Q8 E4), so the
+  reserved code point is rejected in the adapter before any kernel call.
+
+The library is the same pinned Q8 artifact as U2a (BLIS tag 5.3.2, explicit
+``zen4``, ``--int-size=64`` / ``--blas-int-size=32``, OpenMP).  Probing reuses
+the U2a common-symbol/ABI/arch fingerprint so a plan/report can never describe
+an unprobed library.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import numbers
+import os
+import time
+from array import array
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.backends.cpu import HostTensor
+from pypto.target._utils import frozen_mapping, mapping_copy, sha256_text
+
+from .errors import (
+    ArtifactMismatchError,
+    OpContractError,
+    ProviderUnavailableError,
+)
+from .manifest import ProviderCapability
+from .op_registry import (
+    QMATMUL_CANONICAL_OPCODE,
+    QMATMUL_K_ACCUMULATION_LIMIT,
+    QMATMUL_QUANT_MAX,
+    QMATMUL_QUANT_MIN,
+    get_op_definition,
+)
+from .outcome import ProviderOutcome
+from .plan import ExecutionPlan
+from .provider_aocl import (
+    AOCL_ARTIFACT_KIND,
+    AOCL_DEFAULT_LIBRARY,
+    AOCL_LOWERING_VERSION,
+    AOCL_RUNNER_VERSION,
+    AOCL_WIRE_VERSION,
+    AoclProbe,
+    _apply_declared_thread_mode,
+    _get_library,
+    probe_aocl,
+)
+from .provider_ids import AOCL_LPGEMM_INT8_PROVIDER_ID
+
+
+#: Version / implementation identity (U2a naming style).
+AOCL_INT8_PROVIDER_VERSION = "aocl-lpgemm.blis-5.3.2.zen4.dimt64.blasint32.int8.v1"
+AOCL_INT8_IMPLEMENTATION = "aocl.lpgemm.s8s8s32os32.packed_b_direct"
+AOCL_INT8_FUSED_IMPLEMENTATION = "aocl.lpgemm.s8s8s32obf16_sym_quant.reordered_b"
+AOCL_INT8_NUMERIC_CLASS = "deterministic_bounded"
+AOCL_INT8_REDUCTION_ORDER = "aocl_lpgemm_s8s8s32os32_zen4_kc2048_f32block_chain_int32_v1"
+AOCL_INT8_FUSED_REDUCTION_ORDER = "aocl_lpgemm_s8s8s32obf16_sym_quant_zen4_acc_sw_sa_two_mul_v1"
+AOCL_INT8_EXACTNESS_BASIS = (
