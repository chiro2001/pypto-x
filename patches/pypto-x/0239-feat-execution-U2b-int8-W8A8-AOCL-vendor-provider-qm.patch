+def _portable_policy():
+    return ExecutionPolicy(
+        profile="portable",
+        target="auto",
+        provider=ProviderPolicy(mode="portable"),
+        numeric=NumericPolicy(requirement="portable"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="portable_only"),
+        resources=ResourcePolicy(max_threads=1),
+    )
