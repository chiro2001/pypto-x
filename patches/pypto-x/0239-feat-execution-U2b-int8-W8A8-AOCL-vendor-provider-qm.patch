+    """Resolve one portable ``matmul`` request into an immutable plan."""
+
+    _require_resolution_inputs(policy, capability)
+    definition = get_op_definition(MATMUL_CANONICAL_OPCODE)
+    normalized_left = _shape_tuple(left_shape, "left_shape")
+    normalized_right = _shape_tuple(right_shape, "right_shape")
+    normalized_dtype = _normalize_dtype(dtype)
