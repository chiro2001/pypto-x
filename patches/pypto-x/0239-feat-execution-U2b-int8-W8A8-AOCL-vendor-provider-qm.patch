+
+class _AoclPostOp(ctypes.Structure):
+    _fields_ = [
+        ("sum", ctypes.c_void_p),
+        ("eltwise", ctypes.c_void_p),
+        ("bias", ctypes.c_void_p),
+        ("matrix_add", ctypes.c_void_p),
+        ("matrix_mul", ctypes.c_void_p),
+        ("seq_length", _DIM_T),
+        ("seq_vector", ctypes.c_void_p),
+        ("pre_ops", ctypes.c_void_p),
+        ("post_op_grp", ctypes.c_void_p),
+        ("num_eltwise", _DIM_T),
