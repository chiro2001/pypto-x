+            "contract_equivalence": "deterministic_bounded_not_bitwise_vs_contract_single_rne_order",
+            "routable_via_opcode": False,
+            "routable_reason": "the U1 provider SPI passes two operands; the fused GEMM+epilogue "
+                               "contract is not registered in the U2b slice",
