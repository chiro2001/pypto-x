+def test_vendor_report_passes_0042_cross_block_checks():
+    # The 0042 follow-up re-derives guarantees.accumulation from the registered
+    # qmatmul contract (request.dtype=int8 -> "integer") and
+    # guarantees.exactness_basis from the invoked vendor family; a genuine
+    # vendor int8 report must validate unchanged.
+    left = _tensor((2, 64), seed=601)
+    right = _tensor((64, 4), seed=602)
