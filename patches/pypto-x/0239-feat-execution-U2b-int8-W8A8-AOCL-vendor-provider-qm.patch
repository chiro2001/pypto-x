+    definition = get_op_definition("qmatmul_s8s8_s32")
+    assert document["request"]["dtype"] == "int8"
+    assert (
+        document["guarantees"]["accumulation"]
+        == definition.numeric_contract["accumulation"]["integer"]
+    )
+    assert document["guarantees"]["exactness_basis"] == "provider_version_threads_and_order"
+    assert document["guarantees"]["exactness_basis"] == document["resolved"]["exactness_basis"]
+    # Forging either contract-derived field is refused by the 0042 check.
+    forged_accumulation = dict(document)
+    forged_accumulation["guarantees"] = dict(document["guarantees"], accumulation="forged")
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(forged_accumulation)
+    assert getattr(excinfo.value, "reason", None) == "report_accumulation_not_reconciled"
+    forged_basis = dict(document)
+    forged_basis["guarantees"] = dict(document["guarantees"], exactness_basis="forged")
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(forged_basis)
+    assert getattr(excinfo.value, "reason", None) == "report_exactness_basis_not_reconciled"
