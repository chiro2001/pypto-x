+
+def _int8_pack_spec(variant: str = "int32") -> Mapping[str, Any]:
+    if variant == "fused_sym_quant":
+        return {
+            "strategy": "ingestion_time_aocl_reorder_s8s8s32os32_sym_quant",
+            "included_in_timing": False,
+            "api": "aocl_reorder_s8s8s32os32_sym_quant",
+            "b_layout": "aocl_sym_quant_reordered",
+            "requires_k_multiple_of": 4,
+            "per_forward_repack_bytes": 0,
+            "note": "B is reordered once at ingestion/artifact time; every forward reads the "
+                    "same reordered buffer (0 per-forward transfers)",
+        }
+    return {
+        "strategy": "direct_consume_packed_k_out_rowmajor_zero_repack",
+        "included_in_timing": False,
+        "api": "aocl_gemm_s8s8s32os32(mem_format_b='n')",
+        "b_layout": "k_out_rowmajor",
+        "b_strides": "[n, 1] (cs_b='n')",
+        "per_forward_repack_bytes": 0,
+        "note": "the c1 packed [K,out] row-major artifact is consumed directly as B; no "
+                "reorder, no copy, no per-forward transfer",
+    }
+
+
+def _exactness_envelope() -> Mapping[str, Any]:
+    return {
+        "class": AOCL_INT8_NUMERIC_CLASS,
+        "accumulation_width_bits": 32,
