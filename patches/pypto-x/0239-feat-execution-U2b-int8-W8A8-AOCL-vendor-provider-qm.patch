+
+def _unavailable_int8(
+    reason: str,
+    message: str,
+    path: str,
+    fingerprint: Mapping[str, Any],
+    checks: Mapping[str, Any],
+) -> AoclInt8Probe:
+    return AoclInt8Probe(
+        available=False,
+        reason=reason,
+        message=message,
+        library_path=path,
+        fingerprint=frozen_mapping(dict(fingerprint)),
+        checks=frozen_mapping(dict(checks)),
+    )
+
+
+def probe_aocl_int8(library_path: Optional[str] = None, use_cache: bool = True) -> AoclInt8Probe:
+    """Probe the pinned AOCL artifact for the int8/W8A8 symbols.
+
+    ``library_not_found`` / sha / load / ABI / arch failures are inherited from
+    the U2a common probe; this layer adds ``symbol_missing`` for the int8 GEMM
+    and records (but does not require) the fused sym_quant symbols.
+    """
+
+    path = os.path.abspath(library_path or AOCL_DEFAULT_LIBRARY)
+    stat_result = None
+    if os.path.isfile(path):
+        stat_result = os.stat(path)
+    cache_key = (
+        path,
+        None if stat_result is None else int(stat_result.st_size),
+        None if stat_result is None else int(stat_result.st_mtime_ns),
+    )
+    if use_cache:
+        cached = _PROBE_CACHE.get(cache_key)
+        if cached is not None:
+            return cached
+
+    base: AoclProbe = probe_aocl(path, use_cache=use_cache)
+    fingerprint = dict(base.fingerprint)
+    checks = dict(base.checks)
+    if not base.available:
+        probe = _unavailable_int8(base.reason, base.message, path, fingerprint, checks)
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    try:
+        lib = _get_library(path)
+    except OSError as exc:  # pragma: no cover - probe_aocl already loaded it
+        probe = _unavailable_int8(
+            "library_load_failed",
+            "ctypes load of the pinned AOCL artifact failed: {}".format(exc),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    missing = [name for name in _INT8_SYMBOLS if not hasattr(lib, name)]
+    checks["int8_missing_symbols"] = missing
+    if missing:
+        probe = _unavailable_int8(
+            "symbol_missing",
+            "pinned AOCL artifact lacks the int8 GEMM symbol(s): {}".format(", ".join(missing)),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    fused_missing = [name for name in _INT8_FUSED_SYMBOLS if not hasattr(lib, name)]
+    checks["fused_missing_symbols"] = fused_missing
+    try:
+        _ensure_int8_bound(path, lib)
+    except AttributeError as exc:  # pragma: no cover - hasattr checked above
+        probe = _unavailable_int8(
+            "symbol_missing",
+            "pinned AOCL artifact int8 symbol binding failed: {}".format(exc),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    symbols = dict(fingerprint.get("symbols") or {})
+    symbols["int8"] = list(_INT8_SYMBOLS)
+    symbols["int8_fused"] = list(_INT8_FUSED_SYMBOLS)
+    fingerprint["symbols"] = symbols
+    fingerprint["int8_api"] = {
+        "gemm": "aocl_gemm_s8s8s32os32",
+        "fused": "aocl_gemm_s8s8s32obf16_sym_quant",
+        "reorder": "aocl_reorder_s8s8s32os32_sym_quant",
+        "axis_contract": "s8s8_s32; zero_point=0; codes in [{}, {}]".format(
+            AOCL_INT8_QUANT_MIN, AOCL_INT8_QUANT_MAX
+        ),
+        "kc_block": AOCL_INT8_KC_BLOCK,
+    }
+    probe = AoclInt8Probe(
+        available=True,
+        reason="ok",
+        message="pinned AOCL artifact exposes the s8s8s32 int8 GEMM"
+                + ("" if not fused_missing else " (fused sym_quant symbols missing)"),
+        library_path=path,
+        fingerprint=frozen_mapping(fingerprint),
+        checks=frozen_mapping(checks),
+        fused_available=not fused_missing,
+    )
+    if use_cache:
+        _PROBE_CACHE[cache_key] = probe
+    return probe
+
+
+def aocl_int8_provider_capabilities(
+    probe: Optional[AoclInt8Probe] = None,
+    library_path: Optional[str] = None,
+) -> Tuple[ProviderCapability, ...]:
+    """Build the U2b int8 vendor manifest (available or structured-unavailable)."""
+
+    active = probe if probe is not None else probe_aocl_int8(library_path=library_path)
+    definition = get_op_definition(QMATMUL_CANONICAL_OPCODE)
+    fingerprint = mapping_copy(active.fingerprint)
