+def _int8_entry(available=True, reason=None):
+    entries = {entry.provider_id: entry for entry in aocl_int8_provider_capabilities()}
+    base = dict(entries[AOCL_LPGEMM_INT8_PROVIDER_ID].to_dict())
+    base["available"] = available
+    base["reason"] = None if available else (reason or "unit_test_unavailable")
+    return ProviderCapability.from_dict(base)
+
+
+def _host_snapshot(providers=None):
+    return CapabilitySnapshot.for_host(features=HOST_FEATURES, providers=providers)
+
+
+def _portable_int32_reference(left, right):
+    """The W8A8 scalar reference's int32 output (contract ground truth)."""
+
+    from pypto.portable.qwen35_w8a8_scheme import qmatmul_s8s8_s32
+
+    m, k = left.shape
+    n = right.shape[1]
+    result = qmatmul_s8s8_s32(
+        left.flat(), right.flat(), left_shape=(m, k), right_shape=(k, n)
+    )
+    return list(result.values)
+
+
+def _assert_failure(error_code, callable_):
+    with pytest.raises(ExecutionError) as excinfo:
+        callable_()
+    assert excinfo.value.code == error_code, excinfo.value.to_dict()
+    return excinfo.value.to_dict()
