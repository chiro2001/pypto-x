+    forged_envelope = ExecutionPlan(payload)
+    with pytest.raises(Exception) as excinfo:
+        execute_qmatmul_plan(forged_envelope, left, right, output=output)
+    assert getattr(excinfo.value, "code", None) == ARTIFACT_MISMATCH
