From fe6b54a0f40e739d5ebed87baa5d608565171695 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Wed, 9 Sep 2026 00:34:27 +0800
Subject: [PATCH 058/257] fix(pypto-x): align RMSNorm contract metadata

---
 python/pypto/portable/qwen35.py                          | 2 +-
 python/tests/ut/pypto_x/test_qwen35_sve256_composites.py | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
index bf7f76120..3a5197efa 100644
--- a/python/pypto/portable/qwen35.py
+++ b/python/pypto/portable/qwen35.py
@@ -404,7 +404,7 @@ def build_rms_norm(
     return builder.finish(
         (output,),
         {
-            "formula": "x * rsqrt(mean(x*x,axis=-1,keepdims=True)+epsilon) * weight",
+            "formula": "x * rsqrt(mean(x*x,axis=-1,keepdims=True)+epsilon) * (1 + weight.float())",
             "weight_semantics": "delta_from_identity",
             "scale_formula": "1 + weight.float()",
             "epsilon_semantics": "add_before_rsqrt",
diff --git a/python/tests/ut/pypto_x/test_qwen35_sve256_composites.py b/python/tests/ut/pypto_x/test_qwen35_sve256_composites.py
index 10777a46b..4ea151863 100644
--- a/python/tests/ut/pypto_x/test_qwen35_sve256_composites.py
+++ b/python/tests/ut/pypto_x/test_qwen35_sve256_composites.py
@@ -138,6 +138,7 @@ def test_rms_norm_three_way_fp32_accumulation_and_odd_tail(dtype, tmp_path):
             for item, weight_value in zip(row, weight.flat())
         )
     program = build_rms_norm(shape, dtype)
+    assert program.metadata["formula"].endswith("(1 + weight.float())")
     assert program.metadata["weight_semantics"] == "delta_from_identity"
     assert program.metadata["scale_formula"] == "1 + weight.float()"
     _three_way(
