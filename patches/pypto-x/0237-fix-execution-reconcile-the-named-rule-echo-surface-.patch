From 53d3deab9926d0e503dd196857b5c41901f4d30d Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 16:46:19 +0800
Subject: [PATCH 237/250] fix(execution): reconcile the named rule-echo surface
 of an ExecutionReport

0042 item 1b: independent probes showed that a report whose resolution.rules
trace had a stale echo of request/target/policy/layout/provider facts was
still accepted, because only some copies were cross-checked.

- report_rule_echo_errors performs a declarative, rule-name based
  reconciliation of every named resolution.rules[*].details echo against its
  authoritative in-document source (request block, capability/resolved
  target, requested/resolved policy, layout_decision, candidates/rejections),
  and fails closed on missing, duplicated or unknown rules
- additional cross-block checks cover coverage opcodes/providers/artifact
  formats, selected/invoked/declared provider copies, candidate/rejection
  named echoes, chain position, thread copies, portable artifact constants
  and contract-derived guarantees (scope/reference/rounding)
- positional checks/failed_checks payloads and manifest-only facts stay
  registered boundaries; tests exercise the whole named echo surface on
  portable and AOCL vendor reports plus deleted/duplicated rule cases
---
 python/pypto/execution/binding_verify.py                     | 664 +++++++++++++++++++++++++++++++
 python/tests/ut/pypto_x/test_execution_binding_forgery.py    | 106 +++++
 python/tests/ut/pypto_x/test_execution_report_cross_block.py | 122 ++++++
 3 files changed, 892 insertions(+)

diff --git a/python/pypto/execution/binding_verify.py b/python/pypto/execution/binding_verify.py
index ffaace2d4..b566d3ec6 100644
--- a/python/pypto/execution/binding_verify.py
+++ b/python/pypto/execution/binding_verify.py
@@ -32,6 +32,7 @@ from __future__ import annotations
 
 from typing import Any, Mapping, Optional, Sequence, Tuple
 
+from pypto.compiler.artifact import ABI_VERSION
 from pypto.compiler.targets.cpu import ARTIFACT_PAYLOAD_VERSION
 from pypto.lowering.cpu import LOWERING_VERSION
 
@@ -600,6 +601,668 @@ def report_binding_errors(
                     available="a provider-manifest pack strategy",
                 )
             )
+    errors.extend(report_rule_echo_errors(report, definition))
+    return tuple(errors)
+
+
+_RULE_NAMES = (
+    "op_contract.lookup",
+    "op_contract.verify",
+    "target.match",
+    "policy.applicability",
+    "layout.alias_proof",
+    "provider.filter",
+    "provider.select",
+)
+
+
+def _mapped(value: Any) -> Mapping[str, Any]:
+    return value if isinstance(value, Mapping) else {}
+
+
+def _listed(value: Any) -> list:
+    return list(value) if isinstance(value, (list, tuple)) else []
+
+
+def report_rule_echo_errors(
+    report: Mapping[str, Any], definition: Any = None
+) -> Tuple[Mapping[str, Any], ...]:
+    """Reconcile every named ``resolution.rules[*].details`` echo by rule name.
+
+    The resolver records the same decision fact in several named places (the
+    rule trace, the request/result blocks, the resolved policy).  A forger who
+    rewrites only one copy must be refused, so each named echo is mapped to its
+    authoritative in-document source declaratively (rule name + key, never a
+    list index).  Missing, duplicated or unknown rule entries fail closed.
+    Positional ``checks``/``failed_checks`` payloads are deliberately outside
+    this contract (registered as a boundary in the brief).
+
+    A coordinated rewrite of every copy of a fact that has no external truth
+    in the document (platform features, manifest-only fingerprints,
+    ``resolution.plan_digest``) remains the irreducible single-document limit.
+    """
+
+    errors = []
+    resolution = _mapped(report.get("resolution"))
+    request = _mapped(report.get("request"))
+    resolved = _mapped(report.get("resolved"))
+    resolved_contract = _mapped(resolved.get("contract"))
+    resolved_target = _mapped(resolved.get("target"))
+    capability = _mapped(report.get("capability"))
+    requested_policy = _mapped(report.get("requested_policy"))
+    resolved_policy = _mapped(report.get("resolved_policy"))
+    policy_applicability = _mapped(report.get("policy_applicability"))
+    layout_decision = _mapped(report.get("layout_decision"))
+    layout_proof = _mapped(layout_decision.get("alias_proof"))
+    guarantees = _mapped(report.get("guarantees"))
+    dispatch = _mapped(report.get("dispatch"))
+    artifact = _mapped(report.get("artifact"))
+    coverage = _mapped(report.get("coverage"))
+    parallelism = _mapped(_mapped(report.get("resources")).get("parallelism"))
+    thread_state = _mapped(parallelism.get("thread_state"))
+    timing_basis = _mapped(_mapped(report.get("timing")).get("timing_basis"))
+
+    def fail(field: str, reason: str, requested: Any = None, available: Any = None) -> None:
+        errors.append(_error(field, reason, requested, available))
+
+    # -- canonical identity: registered OpDefinition is the external truth ----
+    if definition is None:
+        fail("resolved.contract", "report_definition_unavailable")
+    else:
+        for attribute, value, field in (
+            ("canonical_opcode", resolved_contract.get("opcode"), "resolved.contract.opcode"),
+            ("contract_version", resolved_contract.get("version"), "resolved.contract.version"),
+            ("contract_digest", resolved_contract.get("digest"), "resolved.contract.digest"),
+        ):
+            if not hasattr(definition, attribute):
+                fail(field, "report_definition_attribute_missing:{}".format(attribute))
+            elif value != getattr(definition, attribute):
+                fail(field, "report_canonical_contract_mismatch", requested=value, available=getattr(definition, attribute))
+
+    if artifact.get("contract_version") != resolved_contract.get("version"):
+        fail(
+            "artifact.contract_version",
+            "report_artifact_contract_version_mismatch",
+            requested=artifact.get("contract_version"),
+            available=resolved_contract.get("version"),
+        )
+    if resolved.get("profile") != resolved_policy.get("profile"):
+        fail(
+            "resolved.profile",
+            "report_resolved_policy_echo_mismatch",
+            requested=resolved.get("profile"),
+            available=resolved_policy.get("profile"),
+        )
+    if resolved_policy.get("profile") != requested_policy.get("profile"):
+        fail(
+            "resolved_policy.profile",
+            "report_resolved_policy_echo_mismatch",
+            requested=resolved_policy.get("profile"),
+            available=requested_policy.get("profile"),
+        )
+
+    # -- collect rules by name; unknown / missing / duplicated fail closed ----
+    rules = resolution.get("rules")
+    if not isinstance(rules, list):
+        return (tuple(errors) + (_error("resolution.rules", "report_rule_echo_missing"),))
+    by_name: dict = {}
+    for index, rule in enumerate(rules):
+        if not isinstance(rule, Mapping):
+            fail("resolution.rules[{}]".format(index), "report_rule_malformed")
+            continue
+        name = str(rule.get("rule"))
+        by_name.setdefault(name, []).append(rule)
+    for name in sorted(by_name):
+        if name not in _RULE_NAMES:
+            fail("resolution.rules", "report_unknown_rule", requested=name, available=list(_RULE_NAMES))
+
+    singles: dict = {}
+    for name in _RULE_NAMES:
+        hits = by_name.get(name, [])
+        if name == "provider.filter":
+            if not hits:
+                fail("resolution.rules", "report_rule_echo_missing", requested=name)
+            continue
+        if not hits:
+            fail("resolution.rules", "report_rule_echo_missing", requested=name)
+            continue
+        if len(hits) != 1:
+            fail("resolution.rules", "report_rule_echo_duplicated", requested=len(hits), available=1)
+            continue
+        singles[name] = hits[0]
+
+    def details(rule_name: str) -> Mapping[str, Any]:
+        rule = singles.get(rule_name)
+        return _mapped(rule.get("details")) if isinstance(rule, Mapping) else {}
+
+    def echo(rule_name: str, key: str, expected: Any, field_override: Optional[str] = None) -> None:
+        field = field_override or "resolution.rules[{}].details.{}".format(rule_name, key)
+        if rule_name not in singles:
+            return  # missing rule already reported
+        rule_details = details(rule_name)
+        if key not in rule_details:
+            fail(field, "report_rule_echo_missing")
+            return
+        if rule_details[key] != expected:
+            fail(field, "report_rule_echo_mismatch", requested=rule_details[key], available=expected)
+
+    def require_outcome(rule_name: str, expected: str = "ok") -> None:
+        if rule_name not in singles:
+            return
+        rule = singles[rule_name]
+        if rule.get("outcome") != expected:
+            fail(
+                "resolution.rules[{}].outcome".format(rule_name),
+                "report_rule_echo_mismatch",
+                requested=rule.get("outcome"),
+                available=expected,
+            )
+
+    # -- op_contract.lookup / op_contract.verify / request block -------------
+    opcode = resolved_contract.get("opcode")
+    contract_digest = resolved_contract.get("digest")
+    contract_version = resolved_contract.get("version")
+    if request.get("op") != opcode:
+        fail("request.op", "report_request_opcode_mismatch", requested=request.get("op"), available=opcode)
+    if resolution.get("contract_digest") != contract_digest:
+        fail(
+            "resolution.contract_digest",
+            "report_resolution_contract_digest_mismatch",
+            requested=resolution.get("contract_digest"),
+            available=contract_digest,
+        )
+    echo("op_contract.lookup", "opcode", opcode)
+    echo("op_contract.lookup", "contract_version", contract_version)
+    echo("op_contract.lookup", "contract_digest", contract_digest)
+    require_outcome("op_contract.lookup")
+    echo("op_contract.verify", "dtype", request.get("dtype"))
+    for shape_key in ("left_shape", "right_shape", "output_shape"):
+        echo("op_contract.verify", shape_key, _listed(request.get(shape_key)))
+    require_outcome("op_contract.verify")
+
+    # -- coverage opcodes ----------------------------------------------------
+    for domain in ("logical_operation_counts", "provider_invocation_counts"):
+        for index, entry in enumerate(_listed(coverage.get(domain))):
+            entry = _mapped(entry)
+            if entry.get("opcode") != opcode:
+                fail(
+                    "coverage.{}[{}].opcode".format(domain, index),
+                    "report_coverage_opcode_mismatch",
+                    requested=entry.get("opcode"),
+                    available=opcode,
+                )
+
+    # -- target / capability family -----------------------------------------
+    echo("target.match", "requested", requested_policy.get("target"))
+    echo("target.match", "resolved_kind", resolved_target.get("kind"))
+    echo("target.match", "resolved_triple", resolved_target.get("triple"))
+    echo("target.match", "capability_digest", capability.get("snapshot_digest"))
+    require_outcome("target.match")
+    resolved_target_policy = _mapped(resolved_policy.get("target"))
+    for field, value, available in (
+        ("capability.kind", capability.get("kind"), resolved_target.get("kind")),
+        ("capability.triple", capability.get("triple"), resolved_target.get("triple")),
+        ("resolved_policy.target.resolved_kind", resolved_target_policy.get("resolved_kind"), resolved_target.get("kind")),
+        (
+            "resolved_policy.target.resolved_triple",
+            resolved_target_policy.get("resolved_triple"),
+            resolved_target.get("triple"),
+        ),
+    ):
+        if value != available:
+            fail(field, "report_target_echo_mismatch", requested=value, available=available)
+    if _listed(capability.get("features")) != _listed(resolved_target.get("features")):
+        fail(
+            "resolved.target.features",
+            "report_target_echo_mismatch",
+            requested=resolved_target.get("features"),
+            available=capability.get("features"),
+        )
+
+    # -- requested policy vs resolved policy copies -------------------------
+    resolved_provider = _mapped(resolved_policy.get("provider"))
+    resolved_numeric = _mapped(resolved_policy.get("numeric"))
+    resolved_fallback = _mapped(resolved_policy.get("fallback"))
+    resolved_resources = _mapped(resolved_policy.get("resources"))
+    requested_provider = _mapped(requested_policy.get("provider"))
+    requested_numeric = _mapped(requested_policy.get("numeric"))
+    requested_fallback = _mapped(requested_policy.get("fallback"))
+    requested_resources = _mapped(requested_policy.get("resources"))
+    for field, value, available in (
+        ("resolved_policy.profile", resolved_policy.get("profile"), requested_policy.get("profile")),
+        ("resolved_policy.target.requested", resolved_target_policy.get("requested"), requested_policy.get("target")),
+        ("resolved_policy.provider.requested_mode", resolved_provider.get("requested_mode"), requested_provider.get("mode")),
+        (
+            "resolved_policy.provider.requested_required",
+            resolved_provider.get("requested_required"),
+            requested_provider.get("required"),
+        ),
+        (
+            "resolved_policy.numeric.requested_requirement",
+            resolved_numeric.get("requested_requirement"),
+            requested_numeric.get("requirement"),
+        ),
+        ("resolved_policy.fallback.mode", resolved_fallback.get("mode"), requested_fallback.get("mode")),
+        ("resolved_policy.fallback.max_steps", resolved_fallback.get("max_steps"), requested_fallback.get("max_steps")),
+        (
+            "resolved_policy.fallback.allow_numeric_downgrade",
+            resolved_fallback.get("allow_numeric_downgrade"),
+            requested_fallback.get("allow_numeric_downgrade"),
+        ),
+        (
+            "resolved_policy.resources.requested_max_threads",
+            resolved_resources.get("requested_max_threads"),
+            requested_resources.get("max_threads"),
+        ),
+    ):
+        if value != available:
+            fail(field, "report_resolved_policy_echo_mismatch", requested=value, available=available)
+    if _mapped(resolved_policy.get("layout")) != _mapped(requested_policy.get("layout")):
+        fail(
+            "resolved_policy.layout",
+            "report_resolved_policy_echo_mismatch",
+            requested=_mapped(resolved_policy.get("layout")),
+            available=_mapped(requested_policy.get("layout")),
+        )
+
+    # -- policy.applicability rule echoes -----------------------------------
+    policy_echoes = (
+        ("status", policy_applicability.get("status")),
+        ("rejected_fields", _listed(policy_applicability.get("rejected_fields"))),
+        ("profile", requested_policy.get("profile")),
+        ("provider_mode", requested_provider.get("mode")),
+        ("provider_required", requested_provider.get("required")),
+        ("numeric_requirement", requested_numeric.get("requirement")),
+        ("error_budget_present", requested_numeric.get("error_budget") is not None),
+        ("deterministic", requested_policy.get("deterministic")),
+        ("fallback_mode", requested_fallback.get("mode")),
+        ("fallback_max_steps", requested_fallback.get("max_steps")),
+        ("fallback_allow_numeric_downgrade", requested_fallback.get("allow_numeric_downgrade")),
+        ("max_threads", requested_resources.get("max_threads")),
+    )
+    for key, expected in policy_echoes:
+        echo("policy.applicability", key, expected)
+    requested_layout = _mapped(requested_policy.get("layout"))
+    for key, source_key in (
+        ("layout_view_mode", "view_mode"),
+        ("layout_allow_materialize_copy", "allow_materialize_copy"),
+        ("layout_max_copy_bytes", "max_copy_bytes"),
+    ):
+        echo("policy.applicability", key, requested_layout.get(source_key))
+    require_outcome("policy.applicability")
+
+    # -- layout.alias_proof plain-field echoes ------------------------------
+    for key, expected in (
+        ("requested_view_mode", layout_decision.get("requested_view_mode")),
+        ("resolved_view_mode", layout_decision.get("resolved_view_mode")),
+        ("view_obligation", layout_decision.get("view_obligation")),
+        ("alias_proof_status", layout_proof.get("status")),
+        ("alias_proof_digest", layout_decision.get("alias_proof_digest")),
+        ("failed_conditions", _listed(layout_proof.get("failed_conditions"))),
+        ("layout_copy_bytes", layout_decision.get("layout_copy_bytes")),
+    ):
+        echo("layout.alias_proof", key, expected)
+    require_outcome("layout.alias_proof")
+
+    # -- provider.select plan-level and runtime-level copies ----------------
+    select_details = details("provider.select")
+    chain = _listed(resolution.get("fallback_chain"))
+    declared = dispatch.get("provider_declared")
+    invoked = dispatch.get("provider_invoked")
+    if chain and declared != chain[0]:
+        fail(
+            "dispatch.provider_declared",
+            "report_provider_declaration_mismatch",
+            requested=declared,
+            available=chain[0],
+        )
+    echo("provider.select", "selected", declared)
+    echo("provider.select", "primary", resolution.get("fallback_primary"))
+    echo("provider.select", "fallback_used", resolved_fallback.get("used"))
+    echo("provider.select", "degraded", resolved_fallback.get("degraded"))
+    echo("provider.select", "tie_break", _listed(resolution.get("tie_break")))
+    echo("provider.select", "numeric_class_order", _listed(resolution.get("numeric_class_order")))
+    require_outcome("provider.select")
+    if resolved_provider.get("resolved") != declared:
+        fail(
+            "resolved_policy.provider.resolved",
+            "report_provider_declaration_mismatch",
+            requested=resolved_provider.get("resolved"),
+            available=declared,
+        )
+    if _listed(resolved_fallback.get("chain")) != chain:
+        fail(
+            "resolved_policy.fallback.chain",
+            "report_resolved_policy_echo_mismatch",
+            requested=_listed(resolved_fallback.get("chain")),
+            available=chain,
+        )
+    if resolved_fallback.get("primary") != resolution.get("fallback_primary"):
+        fail(
+            "resolved_policy.fallback.primary",
+            "report_resolved_policy_echo_mismatch",
+            requested=resolved_fallback.get("primary"),
+            available=resolution.get("fallback_primary"),
+        )
+
+    # -- provider.filter multi-rule reconciliation --------------------------
+    candidates = [_mapped(item) for item in _listed(resolution.get("candidates"))]
+    candidate_ids = [item.get("id") for item in candidates]
+    if len(candidate_ids) != len(set(candidate_ids)):
+        fail("resolution.candidates", "report_candidate_duplicate_id", requested=candidate_ids)
+    candidate_by_id = {item.get("id"): item for item in candidates}
+    filter_rules = by_name.get("provider.filter", [])
+    seen_filter_ids = []
+    for rule in filter_rules:
+        rule_details = _mapped(rule.get("details"))
+        provider_id = rule_details.get("provider")
+        seen_filter_ids.append(provider_id)
+        candidate = candidate_by_id.get(provider_id)
+        if candidate is None:
+            fail(
+                "resolution.rules[provider.filter].details.provider",
+                "report_rule_echo_mismatch",
+                requested=provider_id,
+                available=sorted(candidate_by_id),
+            )
+            continue
+        for key, source_key in (
+            ("provider_version", "provider_version"),
+            ("numeric_class", "numeric_class"),
+            ("reason", "reason"),
+        ):
+            if rule_details.get(key) != candidate.get(source_key):
+                fail(
+                    "resolution.rules[provider.filter].details.{}".format(key),
+                    "report_rule_echo_mismatch",
+                    requested=rule_details.get(key),
+                    available=candidate.get(source_key),
+                )
+        candidate_scope = candidate.get("scope")
+        expected_scope = None if candidate_scope in (None, "out_of_scope") else candidate_scope
+        if rule_details.get("scope") != expected_scope:
+            fail(
+                "resolution.rules[provider.filter].details.scope",
+                "report_rule_echo_mismatch",
+                requested=rule_details.get("scope"),
+                available=expected_scope,
+            )
+        expected_outcome = (
+            "candidate" if candidate.get("state") in ("selected", "declared_fallback") else "rejected"
+        )
+        if rule.get("outcome") != expected_outcome:
+            fail(
+                "resolution.rules[provider.filter].outcome",
+                "report_rule_echo_mismatch",
+                requested=rule.get("outcome"),
+                available=expected_outcome,
+            )
+        if provider_id == declared:
+            if candidate.get("numeric_class") != resolved_numeric.get("resolved_class"):
+                fail(
+                    "resolved_policy.numeric.resolved_class",
+                    "report_numeric_class_not_reconciled",
+                    requested=resolved_numeric.get("resolved_class"),
+                    available=candidate.get("numeric_class"),
+                )
+            if candidate.get("provider_version") != resolved_provider.get("resolved_version"):
+                fail(
+                    "resolved_policy.provider.resolved_version",
+                    "report_provider_version_not_reconciled",
+                    requested=resolved_provider.get("resolved_version"),
+                    available=candidate.get("provider_version"),
+                )
+            if rule_details.get("deterministic") != guarantees.get("deterministic"):
+                fail(
+                    "resolution.rules[provider.filter].details.deterministic",
+                    "report_rule_echo_mismatch",
+                    requested=rule_details.get("deterministic"),
+                    available=guarantees.get("deterministic"),
+                )
+        if provider_id == invoked:
+            for field, value in (
+                ("resolved.numeric_class", resolved.get("numeric_class")),
+                ("guarantees.numeric_class", guarantees.get("numeric_class")),
+            ):
+                if candidate.get("numeric_class") != value:
+                    fail(
+                        field,
+                        "report_numeric_class_not_reconciled",
+                        requested=value,
+                        available=candidate.get("numeric_class"),
+                    )
+            if candidate.get("provider_version") != resolved.get("provider_version"):
+                fail(
+                    "resolved.provider_version",
+                    "report_artifact_provider_version_mismatch",
+                    requested=resolved.get("provider_version"),
+                    available=candidate.get("provider_version"),
+                )
+    if len(seen_filter_ids) != len(set(seen_filter_ids)):
+        fail("resolution.rules[provider.filter].details.provider", "report_rule_echo_duplicated")
+    for candidate_id in candidate_by_id:
+        if candidate_id not in seen_filter_ids:
+            fail(
+                "resolution.rules[provider.filter]",
+                "report_rule_echo_missing",
+                requested=candidate_id,
+            )
+    for candidate in candidates:
+        tie_break_key = _listed(candidate.get("tie_break_key"))
+        if tie_break_key and tie_break_key[-1] != candidate.get("id"):
+            fail(
+                "resolution.candidates[{}].tie_break_key".format(candidate.get("id")),
+                "report_candidate_tie_break_mismatch",
+                requested=tie_break_key,
+                available=candidate.get("id"),
+            )
+
+    # -- provider.select ordered trace ---------------------------------------
+    ordered = _listed(select_details.get("ordered"))
+    ordered_providers = []
+    for index, entry in enumerate(ordered):
+        entry = _mapped(entry)
+        provider_id = entry.get("provider")
+        ordered_providers.append(provider_id)
+        candidate = candidate_by_id.get(provider_id)
+        if candidate is None:
+            fail(
+                "resolution.rules[provider.select].details.ordered[{}].provider".format(index),
+                "report_rule_echo_mismatch",
+                requested=provider_id,
+                available=sorted(candidate_by_id),
+            )
+            continue
+        if _listed(entry.get("key")) != _listed(candidate.get("tie_break_key")):
+            fail(
+                "resolution.rules[provider.select].details.ordered[{}].key".format(index),
+                "report_rule_echo_mismatch",
+                requested=entry.get("key"),
+                available=candidate.get("tie_break_key"),
+            )
+    if len(ordered_providers) != len(set(ordered_providers)):
+        fail("resolution.rules[provider.select].details.ordered", "report_rule_echo_duplicated")
+    if declared not in ordered_providers:
+        fail(
+            "resolution.rules[provider.select].details.ordered",
+            "report_rule_echo_missing",
+            requested=declared,
+        )
+
+    # -- candidates vs rejections named echoes ------------------------------
+    for index, rejection in enumerate(_listed(resolution.get("rejections"))):
+        rejection = _mapped(rejection)
+        candidate = candidate_by_id.get(rejection.get("candidate"))
+        if candidate is None:
+            fail(
+                "resolution.rejections[{}].candidate".format(index),
+                "report_rule_echo_mismatch",
+                requested=rejection.get("candidate"),
+                available=sorted(candidate_by_id),
+            )
+            continue
+        for key in ("provider_version", "numeric_class", "scope", "state", "reason"):
+            if rejection.get(key) != candidate.get(key):
+                fail(
+                    "resolution.rejections[{}].{}".format(index, key),
+                    "report_rule_echo_mismatch",
+                    requested=rejection.get(key),
+                    available=candidate.get(key),
+                )
+        candidate_checks = [_mapped(item) for item in _listed(candidate.get("checks"))]
+        checks_by_name = {item.get("check"): item for item in candidate_checks}
