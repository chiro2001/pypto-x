+def test_explicit_ptx_version_must_equal_the_pinned_registry_version():
+    # D1: explicit 8.0 with ptx_target=sm_120 must be refused at construction,
+    # not silently upgraded to 8.7.
+    with pytest.raises(CudaPtxError, match="pinned version"):
+        CudaPtxCompiler(ptx_target=SM120_ARCH, ptx_version="8.0")
+    # D3: 8.8 is loadable for sm_120 but is not the pinned registry version, so
+    # it is refused at construction instead of failing later in compile().
+    with pytest.raises(CudaPtxError, match="pinned version"):
+        CudaPtxCompiler(ptx_target=SM120_ARCH, ptx_version="8.8")
+    # Positive: the pinned combinations are accepted.
+    compiler = CudaPtxCompiler(ptx_target=SM120_ARCH, ptx_version="8.7")
+    assert (compiler.ptx_target, compiler.ptx_version) == (SM120_ARCH, "8.7")
+    compiler = CudaPtxCompiler(ptx_target=SM121_ARCH, ptx_version="8.8")
+    assert (compiler.ptx_target, compiler.ptx_version) == (SM121_ARCH, "8.8")
+    with pytest.raises(CudaPtxError, match="pinned version"):
+        CudaPtxCompiler(ptx_target=SM121_ARCH, ptx_version="8.7")
+
+
+def test_arch_is_mutually_exclusive_with_explicit_target_or_version():
+    # D2: an explicitly supplied counterpart is a conflict, even when it equals
+    # a default value; "default value == not given" is no longer assumed.
+    with pytest.raises(CudaPtxError, match="cannot be combined"):
+        CudaPtxCompiler(arch=SM120_ARCH, ptx_target=SM80_ARCH)
+    with pytest.raises(CudaPtxError, match="cannot be combined"):
+        CudaPtxCompiler(arch=SM120_ARCH, ptx_version="8.0")
+    with pytest.raises(CudaPtxError, match="cannot be combined"):
+        CudaPtxCompiler(arch=SM120_ARCH, ptx_target=SM120_ARCH)
+    with pytest.raises(CudaPtxError, match="cannot be combined"):
+        CudaPtxCompiler(arch=SM120_ARCH, ptx_version="8.7")
+
+
+def test_unregistered_target_and_bare_version_are_rejected():
+    # B5: CudaPtxCompiler is registry-only; raw targets stay available through
+    # render_ptx for low-level tests.
+    with pytest.raises(CudaPtxError, match="unsupported CUDA arch"):
+        CudaPtxCompiler(ptx_target="sm_999")
+    with pytest.raises(CudaPtxError, match="without a registered arch target"):
+        CudaPtxCompiler(ptx_version="8.7")
+    compiler = CudaPtxCompiler()
+    gpu_program = compiler.lower(_program(), TARGET).gpu_program
+    assert ".target sm_999" in render_ptx(gpu_program, "sm_999", "8.0")
+
+
+@pytest.mark.parametrize("malformed", ("sm_120", 123, None, [["policy", "explicit_arch"]]))
+def test_malformed_payload_selection_is_a_named_artifact_error(malformed):
+    # D4: malformed payload arch_selection types must surface as
+    # CudaPtxArtifactError, never as a raw ValueError/TypeError.
+    artifact = _artifact(CudaPtxCompiler(arch=SM120_ARCH))
+    selection = dict(artifact.metadata["arch_selection"])
+
+    def mutate(payload, metadata):
+        payload["arch_selection"] = malformed
+        metadata["arch_selection"] = selection
+
+    mutated = _mutated(artifact, mutate)
+    with pytest.raises(CudaPtxArtifactError, match="arch_selection"):
+        _decode_cuda_artifact(mutated)
+
+
+def test_v2_payload_cannot_carry_a_native_header():
+    # D5: the encoder must force payload version 3 for any non-default target,
+    # so a hand-built CudaProgram cannot smuggle a native header through v2.
+    compiler = CudaPtxCompiler()
+    lowered = compiler.lower(_program(), TARGET)
+    native = CudaPtxCompiler(arch=SM120_ARCH)
+    native_ir = native.lower(_program(), TARGET)
+    manual = CudaProgram(
+        native_ir.gpu_program,
+        native_ir.ptx,
+        SM120_ARCH,
+        "8.7",
+        dict(lowered.device),
+        dict(lowered.jit),
+        lowered.bindings,
+        None,
+    )
+    with pytest.raises(CudaPtxError, match="requires an explicit arch_selection"):
+        manual.validate()
+    with pytest.raises(CudaPtxError, match="requires an explicit arch_selection"):
+        compiler.compile(manual)
+
+    # Decoder-side defense: a re-signed v2 payload with a native header is
+    # refused by the version-2 default-path gate.
+    artifact = _artifact(native)
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    payload["artifact_payload_version"] = ARTIFACT_PAYLOAD_VERSION
+    payload.pop("arch_selection")
+    payload_bytes = json.dumps(payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    metadata = _plain(artifact.metadata)
+    metadata["artifact_payload_version"] = ARTIFACT_PAYLOAD_VERSION
+    metadata.pop("arch_selection")
+    metadata["payload_digest"] = hashlib.sha256(payload_bytes).hexdigest()
+    v2_native = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=payload_bytes,
+        metadata=metadata,
+    )
+    with pytest.raises(CudaPtxArtifactError, match="version 2 only supports the default"):
+        _decode_cuda_artifact(v2_native)
+
