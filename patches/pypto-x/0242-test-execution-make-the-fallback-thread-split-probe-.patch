From b89e0b521274c3a2b890d63af3deb6997327ae36 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 18:55:03 +0800
Subject: [PATCH 242/254] test(execution): make the fallback thread-split probe
 independent of BLIS pinning

The selected/invoked thread counts can coincide when BLIS is already pinned
to the portable count; build a genuinely different value for each cross-check
instead of requiring the two counts to differ.
---
 python/tests/ut/pypto_x/test_execution_binding_forgery.py | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/python/tests/ut/pypto_x/test_execution_binding_forgery.py b/python/tests/ut/pypto_x/test_execution_binding_forgery.py
index 713648ffa..faf7f9950 100644
--- a/python/tests/ut/pypto_x/test_execution_binding_forgery.py
+++ b/python/tests/ut/pypto_x/test_execution_binding_forgery.py
@@ -585,18 +585,23 @@ def test_fallback_threads_separate_selected_plan_from_invoked_runtime():
     invoked = document["dispatch"]["provider_invoked"]
     selected_threads = _candidate_threads(document, declared)
     invoked_threads = _candidate_threads(document, invoked)
-    assert selected_threads != invoked_threads
+    # The plan-level copy always belongs to the selected (declared) provider;
+    # the runtime copy always belongs to the invoked provider.  The two values
+    # may coincide when BLIS is already pinned to the portable thread count on
+    # this host, so build a genuinely different value for each cross-check.
     assert document["resolved_policy"]["resources"]["resolved_threads"] == selected_threads
     assert document["dispatch"]["threads_used"] == invoked_threads
+    forged_runtime = selected_threads if selected_threads != invoked_threads else invoked_threads + 1
+    forged_plan = invoked_threads if invoked_threads != selected_threads else selected_threads + 1
 
     broken = copy.deepcopy(document)
-    broken["dispatch"]["threads_used"] = selected_threads
+    broken["dispatch"]["threads_used"] = forged_runtime
     with pytest.raises(Exception) as excinfo:
         validate_report_schema(broken)
     assert excinfo.value.reason == "report_threads_not_reconciled"
 
     broken = copy.deepcopy(document)
-    broken["resolved_policy"]["resources"]["resolved_threads"] = invoked_threads
+    broken["resolved_policy"]["resources"]["resolved_threads"] = forged_plan
     with pytest.raises(Exception) as excinfo:
         validate_report_schema(broken)
     assert excinfo.value.reason == "report_threads_not_reconciled"
