From bf7a499a2602143f946fac5c1612732c879670c5 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Wed, 9 Sep 2026 14:41:16 +0800
Subject: [PATCH 75/96] test(pypto-x): correct qwen bf16 product golden

---
 python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py | 22 ++++++++++++++--------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py b/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py
index 300f242bf..1e1110291 100644
--- a/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py
+++ b/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py
@@ -192,8 +192,9 @@ def test_gated_norm_preserves_upstream_bf16_rounding_order():
         assert op_index[gate.outputs[0].name] < op_index[gated.outputs[0].name]
 
     # Same pure-standard-library BF16-RNE sample used by the independent
-    # acceptance audit.  It must distinguish the old FP32 weight product from
-    # the upstream normalized->BF16->weight->SiLU ordering.
+    # acceptance audit.  The BF16 weight product has its own RNE boundary
+    # before the FP32 SiLU-gate multiply; omitting that intermediate round is
+    # exactly the semantic error this regression guards against.
     x = (0.1234567, -0.2345678, 0.3456789, -0.4567891)
     weight = (0.8765432, 1.1234567, 0.7654321, 1.2345678)
     gate = (0.3333, -0.8888, 1.2345, -0.4321)
@@ -202,18 +203,23 @@ def test_gated_norm_preserves_upstream_bf16_rounding_order():
     normalized_bf16 = tuple(_bf16_value(_bf16_bits(value)) for value in normalized)
     weight_bf16 = tuple(_bf16_value(_bf16_bits(value)) for value in weight)
     silu = tuple(value / (1.0 + math.exp(-value)) for value in gate)
+    product_bf16 = tuple(
+        _bf16_value(_bf16_bits(normalized_bf16[index] * weight_bf16[index]))
+        for index in range(len(x))
+    )
     upstream = tuple(
-        _bf16_value(_bf16_bits(normalized_bf16[index] * weight_bf16[index] * silu[index]))
+        _bf16_value(_bf16_bits(product_bf16[index] * silu[index]))
         for index in range(len(x))
     )
-    current = tuple(
+    old_fp32_weight_product = tuple(
         _bf16_value(_bf16_bits(normalized[index] * weight_bf16[index] * silu[index]))
         for index in range(len(x))
     )
-    assert [_bf16_bits(value) for value in upstream] == [15752, 15965, 16205, 16027]
-    assert [_bf16_bits(value) for value in current] == [15752, 15966, 16205, 16028]
-    assert max(abs(left - right) for left, right in zip(upstream, current)) == 0.001953125
-    assert upstream != current
+    assert [_bf16_bits(value) for value in product_bf16] == [16047, 48982, 16214, 49124]
+    assert [_bf16_bits(value) for value in upstream] == [15752, 15966, 16205, 16027]
+    assert [_bf16_bits(value) for value in old_fp32_weight_product] == [15752, 15966, 16205, 16028]
+    assert max(abs(left - right) for left, right in zip(upstream, old_fp32_weight_product)) == 0.001953125
+    assert upstream != old_fp32_weight_product
 
 
 def test_synthetic_full_graph_executes_and_returns_functional_state():
