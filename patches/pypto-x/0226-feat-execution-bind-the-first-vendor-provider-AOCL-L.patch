+"""Canonical provider identifiers shared by the execution-layer modules.
+
+The module is a leaf on purpose: ``op_registry`` (contract view), ``capability``
+(platform facts), ``providers``/``provider_aocl`` (implementations) and
+``resolver`` (selection) all reference the *same* ids.  Keeping them in one
+place prevents the registry, the capability snapshot and the plan from
+drifting apart, which the interface guidance requires (single source of truth,
+0006 sections 4.4 and 13.5).
+"""
+
+from __future__ import annotations
+
+
+PORTABLE_PROVIDER_ID = "portable"
+
+# AOCL-BLIS / LPGEMM addon, pinned to the Q8 vendor-gemm-survey artifact.
+AOCL_LPGEMM_BF16_PROVIDER_ID = "vendor:aocl-lpgemm-bf16"
+AOCL_LPGEMM_F32_PROVIDER_ID = "vendor:aocl-lpgemm-f32"
+
+KNOWN_PROVIDER_IDS = (
+    PORTABLE_PROVIDER_ID,
+    AOCL_LPGEMM_BF16_PROVIDER_ID,
+    AOCL_LPGEMM_F32_PROVIDER_ID,
+)
+
+
+__all__ = [
+    "AOCL_LPGEMM_BF16_PROVIDER_ID",
+    "AOCL_LPGEMM_F32_PROVIDER_ID",
+    "KNOWN_PROVIDER_IDS",
+    "PORTABLE_PROVIDER_ID",
+]
