+
+def probe_aocl(library_path: Optional[str] = None, use_cache: bool = True) -> AoclProbe:
+    """Probe the AOCL library and return structured facts.
+
+    Every failure mode has a stable ``reason``: ``library_not_found``,
+    ``library_sha256_mismatch``, ``library_load_failed``, ``symbol_missing``,
+    ``library_version_mismatch``, ``abi_mismatch``, ``arch_mismatch``.
+    """
+
+    path = os.path.abspath(library_path or AOCL_DEFAULT_LIBRARY)
+    stat_result = None
+    if not os.path.isfile(path):
+        checks = {"library_path": path, "exists": False}
+        probe = _unavailable(
+            "library_not_found",
+            "pinned AOCL artifact {} does not exist on this host".format(path),
+            path,
+            _base_fingerprint(path, None, None),
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[(path, None, None)] = probe
+        return probe
+
+    stat_result = os.stat(path)
+    cache_key = (path, int(stat_result.st_size), int(stat_result.st_mtime_ns))
+    if use_cache:
+        cached = _PROBE_CACHE.get(cache_key)
+        if cached is not None:
+            return cached
+
+    checks = {
+        "library_path": path,
+        "exists": True,
+        "size_bytes": int(stat_result.st_size),
+        "sha256_expected": AOCL_SHA256_PIN,
+    }
+    digest = _sha256_file(path)
+    checks["sha256_actual"] = digest
+    fingerprint = _base_fingerprint(path, stat_result, digest)
+    if digest != AOCL_SHA256_PIN:
+        probe = _unavailable(
+            "library_sha256_mismatch",
+            "AOCL artifact sha256 {} does not match the pinned {}".format(
+                digest[:16], AOCL_SHA256_PIN[:16]
+            ),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    if sys.byteorder != "little":
+        checks["byteorder"] = sys.byteorder
+        probe = _unavailable(
+            "endianness_mismatch",
+            "the pinned AOCL binding assumes a little-endian host, found {}".format(sys.byteorder),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    try:
+        lib = _get_library(path)
+    except OSError as exc:
+        probe = _unavailable(
+            "library_load_failed",
+            "ctypes.CDLL({!r}) failed: {}".format(path, exc),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    missing = [name for name in _COMMON_SYMBOLS if not hasattr(lib, name)]
+    if missing:
+        checks["missing_symbols"] = missing
+        probe = _unavailable(
+            "symbol_missing",
+            "library is missing common AOCL/BLIS symbols: {}".format(", ".join(missing)),
+            path,
+            fingerprint,
+            checks,
+        )
+        if use_cache:
+            _PROBE_CACHE[cache_key] = probe
+        return probe
+
+    version = _cstr(lib.bli_info_get_version_str())
+    arch_id = int(lib.bli_arch_query_id())
+    arch_string = _cstr(lib.bli_arch_string(arch_id))
+    int_type_size = int(lib.bli_info_get_int_type_size())
+    blas_int_type_size = int(lib.bli_info_get_blas_int_type_size())
+    default_threads = int(lib.bli_thread_get_num_threads())
+    checks.update(
+        {
+            "blis_version": version,
+            "arch_id": arch_id,
+            "arch_string": arch_string,
+            "int_type_size": int_type_size,
+            "blas_int_type_size": blas_int_type_size,
+            "default_threads": default_threads,
+        }
+    )
+    variant_missing = {
+        "bf16": [name for name in _BF16_SYMBOLS if not hasattr(lib, name)],
+        "f32": [name for name in _F32_SYMBOLS if not hasattr(lib, name)],
+    }
+    checks["variant_missing_symbols"] = variant_missing
+    fingerprint = dict(fingerprint)
+    fingerprint.update(
+        {
+            "blis_version": version,
+            "arch_id": arch_id,
+            "arch_string": arch_string,
+            "int_type_size": int_type_size,
+            "blas_int_type_size": blas_int_type_size,
+            "default_threads": default_threads,
+            "thread_knob": "bli_thread_set_num_threads",
+            "env_thread_knobs": ["OMP_NUM_THREADS", "BLIS_NUM_THREADS"],
+            "symbols": {"common": list(_COMMON_SYMBOLS), "bf16": list(_BF16_SYMBOLS), "f32": list(_F32_SYMBOLS)},
+        }
+    )
+    fingerprint = frozen_mapping(fingerprint)
+
+    reason = None
+    message = "ok"
+    if AOCL_VERSION_STRING_MATCH not in version:
+        reason = "library_version_mismatch"
+        message = "BLIS version {!r} does not contain the pinned tag {!r}".format(version, AOCL_BLIS_TAG)
+    elif int_type_size != AOCL_INT_TYPE_SIZE or blas_int_type_size != AOCL_BLAS_INT_TYPE_SIZE:
+        reason = "abi_mismatch"
+        message = "expected dim_t={} / blas_int={}, got {}/{}".format(
+            AOCL_INT_TYPE_SIZE, AOCL_BLAS_INT_TYPE_SIZE, int_type_size, blas_int_type_size
+        )
+    elif arch_id != AOCL_ARCH_ID or arch_string != AOCL_ARCH_STRING:
+        reason = "arch_mismatch"
+        message = "expected {} ({}), got {} ({})".format(
+            AOCL_ARCH_STRING, AOCL_ARCH_ID, arch_string, arch_id
+        )
+    if reason is not None:
+        probe = _unavailable(reason, message, path, fingerprint, checks)
+    else:
+        probe = AoclProbe(
+            available=True,
+            reason="ok",
+            message="AOCL artifact matches the pin and reports {} ({})".format(arch_string, arch_id),
+            library_path=path,
+            fingerprint=fingerprint,
+            checks=frozen_mapping(dict(checks)),
+        )
+    if use_cache:
+        _PROBE_CACHE[cache_key] = probe
+    return probe
+
+
+def _pack_spec(variant: str) -> Mapping[str, Any]:
+    if variant == "bf16":
+        return {
+            "strategy": "b_pre_reordered_outside_timing",
+            "included_in_timing": False,
+            "api": "aocl_reorder_bf16bf16f32of32",
+            "note": "B is packed before the timed region; the GEMM consumes mem_format_b='r' "
+                    "(same protocol as Q8 aocl_bf16_packed)",
+        }
+    return {
+        "strategy": "library_internal_pack_inside_timing",
+        "included_in_timing": True,
+        "api": "cblas_sgemm (BLIS internal blocks)",
+        "note": "BLIS packs A/B on every call, so pack cost is inside the timed region (Q8 f32 level)",
+    }
+
+
+def provider_artifact_digest(fingerprint: Mapping[str, Any], implementation: str, variant: str) -> str:
+    document = {
+        "artifact_kind": AOCL_ARTIFACT_KIND,
+        "provider_version": AOCL_PROVIDER_VERSION,
+        "implementation": implementation,
+        "variant": variant,
+        "numeric_class": AOCL_NUMERIC_CLASS,
+        "pack": dict(_pack_spec(variant)),
+        "library": dict(fingerprint),
+    }
+    return "sha256:" + sha256_text(document)
+
+
+def _library_fingerprint_for_capability(probe: AoclProbe) -> Mapping[str, Any]:
+    return mapping_copy(probe.fingerprint)
+
+
+def aocl_provider_capabilities(
+    probe: Optional[AoclProbe] = None,
+    library_path: Optional[str] = None
+) -> Tuple[ProviderCapability, ProviderCapability]:
+    """Build the two U2a vendor manifests (available or structured-unavailable)."""
+
+    active = probe if probe is not None else probe_aocl(library_path=library_path)
+    contract_digest = get_op_definition("matmul").contract_digest
+    fingerprint = _library_fingerprint_for_capability(active)
+    max_threads = int(active.fingerprint.get("default_threads") or 0) or (os.cpu_count() or 1)
+
+    def entry(variant: str) -> ProviderCapability:
+        available = active.variant_available(variant)
+        reason = None if available else active.variant_reason(variant)
+        if variant == "bf16":
+            provider_id = AOCL_LPGEMM_BF16_PROVIDER_ID
+            implementation = AOCL_BF16_IMPLEMENTATION
+            dtypes = ("bf16",)
+            reduction_order_id = AOCL_BF16_REDUCTION_ORDER
+            required_features = ("avx512_bf16", "avx512f")
+            api = "aocl_gemm_bf16bf16f32obf16"
+        else:
+            provider_id = AOCL_LPGEMM_F32_PROVIDER_ID
+            implementation = AOCL_F32_IMPLEMENTATION
+            dtypes = ("float32",)
+            reduction_order_id = AOCL_F32_REDUCTION_ORDER
+            required_features = ("avx512f",)
+            api = "cblas_sgemm"
+        return ProviderCapability(
+            provider_id=provider_id,
+            version=AOCL_PROVIDER_VERSION,
+            available=available,
+            target_kinds=("cpu",),
+            numeric_modes=(AOCL_NUMERIC_CLASS,),
+            deterministic=True,
+            required_features=required_features,
+            contracts={"matmul": contract_digest},
+            max_threads=max_threads,
+            workspace_bytes=0,
+            reason=reason,
+            implementation=implementation,
+            numeric_class=AOCL_NUMERIC_CLASS,
+            dtypes=dtypes,
+            stride_class="contiguous_only",
+            rank_range=(2, 2),
+            reduction_order_id=reduction_order_id,
+            artifact_kind=AOCL_ARTIFACT_KIND,
+            pack=_pack_spec(variant),
+            provider_artifact_digest=(
+                provider_artifact_digest(fingerprint, implementation, variant) if available else None
+            ),
+            library=fingerprint,
+            threads={
+                "model": "openmp_blis",
+                "knob": "bli_thread_set_num_threads",
+                "max_threads": max_threads,
+                "default_threads": int(active.fingerprint.get("default_threads") or max_threads),
+                "requires_env_before_load": False,
+                "env_knobs": ["OMP_NUM_THREADS", "BLIS_NUM_THREADS"],
+                "api": api,
+            },
+            preconditions={
+                "min_dimension": 1,
+                "slice_step_domain": "positive",
+                "layout_descriptor_version": 1,
+                "row_major_contiguous": True,
+            },
+        )
+
+    return (entry("bf16"), entry("f32"))
+
+
+# ---------------------------------------------------------------------------
+# execution
+# ---------------------------------------------------------------------------
+def _bf16_bits(values: Sequence[Any]) -> "array":
+    f32 = array("f", values)
+    pairs = array("H")
+    pairs.frombytes(f32.tobytes())
+    return pairs[1::2]
+
+
+def _bf16_bits_to_values(raw: bytes, count: int) -> list:
+    out16 = array("H")
+    out16.frombytes(raw)
+    if len(out16) != count:
+        raise ValueError("bf16 output buffer length {} does not match {}".format(len(out16), count))
+    interleaved = array("H", bytes(4 * count))
+    interleaved[1::2] = out16
+    f32 = array("f")
+    f32.frombytes(interleaved.tobytes())
+    return list(f32)
+
+
+def _f32_values(raw: bytes, count: int) -> list:
+    f32 = array("f")
+    f32.frombytes(raw)
+    if len(f32) != count:
+        raise ValueError("f32 output buffer length {} does not match {}".format(len(f32), count))
+    return list(f32)
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = []
+    running = 1
+    for dimension in reversed(tuple(int(item) for item in shape)):
+        strides.append(running)
+        running *= max(dimension, 1)
+    return tuple(reversed(strides))
+
+
+def _check_operand(value: Any, label: str) -> HostTensor:
+    if not isinstance(value, HostTensor):
+        raise OpContractError(
+            "the AOCL vendor provider requires HostTensor operands",
+            field="operand." + label,
+            requested=type(value).__name__,
+            available=["HostTensor"],
+            reason="unsupported_operand_handle",
+        )
+    strides = getattr(value, "strides", None)
+    if strides is not None and tuple(int(item) for item in strides) != _contiguous_strides(value.shape):
+        raise OpContractError(
+            "the AOCL vendor provider requires contiguous row-major storage (stride_class=contiguous_only)",
+            field="operand.{}.strides".format(label),
+            requested=list(strides),
+            available=list(_contiguous_strides(value.shape)),
+            reason="stride_class_not_contiguous",
+        )
+    return value
+
+
+def _check_request(plan: ExecutionPlan, left: HostTensor, right: HostTensor, output: HostTensor) -> None:
+    mismatches = {}
+    if plan.opcode != "matmul":
+        mismatches["op"] = plan.opcode
+    if tuple(left.shape) != plan.left_shape:
+        mismatches["left_shape"] = list(left.shape)
+    if tuple(right.shape) != plan.right_shape:
+        mismatches["right_shape"] = list(right.shape)
+    if tuple(output.shape) != plan.output_shape:
+        mismatches["output_shape"] = list(output.shape)
+    if left.dtype != plan.dtype or right.dtype != plan.dtype or output.dtype != plan.dtype:
+        mismatches["dtype"] = {"left": left.dtype, "right": right.dtype, "output": output.dtype}
+    if mismatches:
+        raise ArtifactMismatchError(
+            "execution request does not match the frozen plan",
+            field="plan.request",
+            requested=mismatches,
+            available=plan.request,
+            reason="plan_request_mismatch",
+        )
+
+
+def _check_no_alias(left: HostTensor, right: HostTensor, output: HostTensor) -> None:
+    for label, operand in (("left", left), ("right", right)):
+        if output is operand or output.data is operand.data:
+            raise OpContractError(
+                "output must not alias the {} input buffer".format(label),
+                field="output",
+                requested={
+                    "alias": label,
+                    "same_object": output is operand,
+                    "same_storage": output.data is operand.data,
+                },
+                available="distinct output storage",
+                reason="output_input_alias",
+            )
+
+
+class AoclLpgemmProvider:
+    """One AOCL kernel variant (bf16 or f32) behind the U1 provider SPI."""
+
+    provider_id = AOCL_LPGEMM_BF16_PROVIDER_ID
+    version = AOCL_PROVIDER_VERSION
+    implementation = AOCL_BF16_IMPLEMENTATION
+    numeric_class = AOCL_NUMERIC_CLASS
+    runner_version = AOCL_RUNNER_VERSION
+    lowering_version = AOCL_LOWERING_VERSION
+    wire_version = AOCL_WIRE_VERSION
+    artifact_kind = AOCL_ARTIFACT_KIND
+    variant = "bf16"
+    dtypes = ("bf16",)
+    library_path = AOCL_DEFAULT_LIBRARY
+
+    # -- manifest ---------------------------------------------------------
+    def probe(self) -> AoclProbe:
+        return probe_aocl(library_path=self.library_path)
+
+    def capability(self, available: Optional[bool] = None, reason: Optional[str] = None) -> ProviderCapability:
+        entries = aocl_provider_capabilities(library_path=self.library_path)
+        for entry in entries:
+            if entry.provider_id == self.provider_id:
+                if available is None:
+                    return entry
+                override = dict(entry.to_dict())
+                override["available"] = available
+                override["reason"] = None if available else (reason or "forced_unavailable")
+                return ProviderCapability.from_dict(override)
+        raise ProviderUnavailableError(
+            "AOCL provider manifest {!r} was not built".format(self.provider_id),
+            field="capability.providers",
+            requested=self.provider_id,
+            reason="provider_manifest_missing",
+        )
+
+    def verify_plan_binding(self, plan: ExecutionPlan) -> str:
+        """D1: reconcile the frozen plan's selected fields with this manifest.
+
+        A forged plan with a recomputed digest must not be able to *describe*
+        a different implementation, version or numeric class while invoking
+        this executor.  Returns ``"selected"`` or ``"declared_fallback"`` so
+        the entry layer can reconcile the outcome against the right manifest.
+        """
+
+        plan.validate()
+        declared = plan.selected_provider
+        if declared != self.provider_id:
+            allowed_chain = list(plan.fallback_chain)[: plan.fallback_max_steps + 1]
+            if self.provider_id not in allowed_chain:
+                raise ArtifactMismatchError(
+                    "plan declares provider {!r} and does not list {!r} in its fallback chain".format(
+                        declared, self.provider_id
+                    ),
+                    field="plan.selected.provider",
+                    requested=declared,
+                    available=self.provider_id,
+                    reason="declared_provider_does_not_match_executor",
+                )
+            return "declared_fallback"
+        selected = plan.selected
+        for field, manifest_value in (
+            ("provider_version", self.version),
+            ("implementation", self.implementation),
+            ("numeric_class", self.numeric_class),
+        ):
+            if selected.get(field) != manifest_value:
+                raise ArtifactMismatchError(
+                    "plan.selected.{} does not match the provider manifest".format(field),
+                    field="plan.selected." + field,
+                    requested=selected.get(field),
+                    available=manifest_value,
+                    reason="plan_selected_field_not_reconciled_with_provider_manifest",
+                )
+        artifact_versions = plan.artifact_versions
+        if artifact_versions.get("provider_version") != self.version:
+            raise ArtifactMismatchError(
+                "plan.artifact.provider_version does not match the provider manifest",
+                field="plan.artifact.provider_version",
+                requested=artifact_versions.get("provider_version"),
+                available=self.version,
+                reason="artifact_declaration_mismatch",
+            )
+        return "selected"
+
+    # -- execution --------------------------------------------------------
+    def execute(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+        capability: Any
+    ) -> ProviderOutcome:
+        binding_mode = self.verify_plan_binding(plan)
+        _check_operand(left, "left")
+        _check_operand(right, "right")
+        _check_operand(output, "output")
+        _check_request(plan, left, right, output)
+        _check_no_alias(left, right, output)
+        if plan.dtype not in self.dtypes:
+            raise OpContractError(
+                "the AOCL {} provider does not support dtype {!r}".format(self.variant, plan.dtype),
+                field="request.dtype",
+                requested=plan.dtype,
+                available=list(self.dtypes),
+                reason="provider_dtype_not_supported",
+            )
+        left_shape = plan.left_shape
+        right_shape = plan.right_shape
+        if len(left_shape) != 2 or len(right_shape) != 2:
+            raise OpContractError(
+                "the AOCL vendor provider supports rank-2 matmul only",
+                field="request.shape.rank",
+                requested={"left": len(left_shape), "right": len(right_shape)},
+                available=[2],
+                reason="vendor_precondition_rank_out_of_range",
+            )
+        m, k = int(left_shape[0]), int(left_shape[1])
+        n = int(right_shape[1])
+        if min(m, k, n) < 1:
+            raise OpContractError(
+                "the AOCL vendor provider requires m, k, n >= 1; the portable trunk owns empty-axis cases",
+                field="request.shape",
+                requested={"m": m, "k": k, "n": n},
+                available={"min_dimension": 1},
+                reason="vendor_precondition_min_dimension",
+            )
+        if capability is not None and getattr(capability, "digest", None) != plan.capability_digest:
+            raise ArtifactMismatchError(
+                "capability snapshot does not match the frozen plan",
+                field="plan.target.capability_digest",
+                requested=getattr(capability, "digest", None),
+                available=plan.capability_digest,
+                reason="capability_digest_mismatch",
+            )
+
+        probe = self.probe()
+        if not probe.available or not probe.variant_available(self.variant):
+            raise ProviderUnavailableError(
+                "AOCL provider {!r} is unavailable: {}".format(self.provider_id, probe.variant_reason(self.variant)),
+                field="capability.providers",
+                requested=self.provider_id,
+                available=[
+                    item.provider_id
+                    for item in aocl_provider_capabilities(probe=probe)
+                    if item.available
+                ],
+                reason="provider_capability_unavailable:" + probe.variant_reason(self.variant),
+                details={"library": mapping_copy(probe.fingerprint), "checks": mapping_copy(probe.checks)},
+            )
+
+        threads = int(plan.selected["threads"])
+        host_cpus = os.cpu_count() or 1
+        if threads < 1 or threads > host_cpus:
+            raise ArtifactMismatchError(
+                "plan selected.threads is outside the host parallelism the provider can honour",
+                field="plan.selected.threads",
+                requested=threads,
+                available={"min": 1, "max": host_cpus},
+                reason="plan_thread_exceeds_host_parallelism",
+            )
+        lib = _get_library(self.library_path, variant=self.variant)
+        thread_mode, thread_state = _apply_declared_thread_mode(
+            lib, self.library_path, threads, str(plan.selected.get("thread_mode", "env_default"))
+        )
+
+        if self.variant == "bf16":
+            outcome = self._execute_bf16(
+                plan, left, right, output, lib, threads, binding_mode, thread_mode, thread_state
+            )
+        else:
+            outcome = self._execute_f32(
+                plan, left, right, output, lib, threads, binding_mode, thread_mode, thread_state
+            )
+        return outcome
+
+    def _execute_bf16(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+        lib: ctypes.CDLL,
+        threads: int,
+        binding_mode: str,
+        thread_mode: str,
+        thread_state: Mapping[str, Any]
+    ) -> ProviderOutcome:
+        m, k = int(plan.left_shape[0]), int(plan.left_shape[1])
+        n = int(plan.right_shape[1])
+        a_arr = _bf16_bits(left.data)
+        b_arr = _bf16_bits(right.data)
+        size = int(lib.aocl_get_reorder_buf_size_bf16bf16f32of32(b"r", b"n", b"b", _DIM_T(k), _DIM_T(n)))
+        if size <= 0:
+            raise ProviderUnavailableError(
+                "AOCL reorder buffer size is {} for k={} n={}; failing closed".format(size, k, n),
+                field="request.shape",
+                requested={"k": k, "n": n},
+                available={"reorder_buffer_bytes": ">0"},
+                reason="reorder_buffer_size_zero",
+            )
+        a_ptr = (ctypes.c_uint16 * len(a_arr)).from_buffer(a_arr)
+        b_in_ptr = (ctypes.c_uint16 * len(b_arr)).from_buffer(b_arr)
+        packed = (ctypes.c_uint16 * max(size, 1))()
+        c_buf = (ctypes.c_uint16 * (m * n))()
+        started = time.perf_counter()
+        lib.aocl_reorder_bf16bf16f32of32(
+            b"r", b"n", b"b", b_in_ptr, packed, _DIM_T(k), _DIM_T(n), _DIM_T(n)
+        )
+        pack_seconds = time.perf_counter() - started
+        started = time.perf_counter()
+        lib.aocl_gemm_bf16bf16f32obf16(
+            b"r", b"n", b"n", _DIM_T(m), _DIM_T(n), _DIM_T(k), ctypes.c_float(1.0),
+            a_ptr, _DIM_T(k), b"n", packed, _DIM_T(n), b"r", ctypes.c_float(0.0),
+            c_buf, _DIM_T(n), None,
+        )
+        op_seconds = time.perf_counter() - started
+        raw = ctypes.string_at(ctypes.addressof(c_buf), 2 * m * n)
+        values = _bf16_bits_to_values(raw, m * n)
+        output.data[:] = values
+        return self._outcome(
+            plan, output, op_seconds, pack_seconds, lib, threads, binding_mode, thread_mode, thread_state
+        )
+
+    def _execute_f32(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+        lib: ctypes.CDLL,
+        threads: int,
+        binding_mode: str,
+        thread_mode: str,
+        thread_state: Mapping[str, Any]
+    ) -> ProviderOutcome:
+        m, k = int(plan.left_shape[0]), int(plan.left_shape[1])
+        n = int(plan.right_shape[1])
+        a_arr = array("f", left.data)
+        b_arr = array("f", right.data)
+        c_buf = (ctypes.c_float * (m * n))()
+        a_ptr = (ctypes.c_float * len(a_arr)).from_buffer(a_arr)
+        b_ptr = (ctypes.c_float * len(b_arr)).from_buffer(b_arr)
+        started = time.perf_counter()
+        lib.cblas_sgemm(
+            101,  # CblasRowMajor
+            111,  # CblasNoTrans
+            111,  # CblasNoTrans
+            ctypes.c_int(m), ctypes.c_int(n), ctypes.c_int(k),
+            ctypes.c_float(1.0), a_ptr, ctypes.c_int(k),
+            b_ptr, ctypes.c_int(n), ctypes.c_float(0.0), c_buf, ctypes.c_int(n),
+        )
+        op_seconds = time.perf_counter() - started
+        raw = ctypes.string_at(ctypes.addressof(c_buf), 4 * m * n)
+        values = _f32_values(raw, m * n)
+        output.data[:] = values
+        return self._outcome(
+            plan, output, op_seconds, 0.0, lib, threads, binding_mode, thread_mode, thread_state
+        )
+
+    def _outcome(
+        self,
+        plan: ExecutionPlan,
+        output: HostTensor,
+        op_seconds: float,
+        pack_seconds: float,
+        lib: ctypes.CDLL,
+        threads: int,
+        binding_mode: str,
+        thread_mode: str,
+        thread_state: Mapping[str, Any]
+    ) -> ProviderOutcome:
+        probe = self.probe()
+        fingerprint = mapping_copy(probe.fingerprint)
+        artifact_digest = provider_artifact_digest(fingerprint, self.implementation, self.variant)
+        pack = _pack_spec(self.variant)
+        try:
+            affinity = tuple(sorted(int(cpu) for cpu in os.sched_getaffinity(0)))
+        except (AttributeError, OSError):
+            affinity = ()
+        return ProviderOutcome(
+            output=output,
+            artifact_format="aocl.lpgemm.{}.v1".format(self.variant),
+            artifact_content_digest=artifact_digest,
+            abi_version=AOCL_ABI_VERSION,
+            lowering_version=self.lowering_version,
+            wire_version=self.wire_version,
+            op_seconds=float(op_seconds),
+            threads_used=int(threads),
+            provider_version=self.version,
+            implementation=self.implementation,
+            numeric_class=self.numeric_class,
