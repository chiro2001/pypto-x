+"""Provider manifest object shared by capability and vendor providers.
+
+``ProviderCapability`` lives in this leaf module so ``capability`` can import
+``provider_aocl`` (for the local probe) without a circular import, and so the
+manifest class identity is stable regardless of which execution module is
+imported first.  The class itself is re-exported by
+:mod:`pypto.execution.capability` for compatibility.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.target._utils import frozen_mapping, mapping_copy, normalize_names
+
+from .errors import CapabilityUnavailableError
+from .provider_ids import PORTABLE_PROVIDER_ID
+
+
+PORTABLE_PROVIDER_MAX_THREADS = 1
+PORTABLE_ARTIFACT_KIND = "core_ir_artifact"
+
+
+def _normalize_features(features: Any) -> Tuple[str, ...]:
+    try:
+        names = normalize_names(features)
+    except (TypeError, ValueError) as exc:
+        raise CapabilityUnavailableError(
+            "capability features must be a sequence of names",
+            field="capability.features",
+            requested=features,
+            reason="invalid_features",
+        ) from exc
+    return tuple(sorted(names))
+
+
+@dataclass(frozen=True, init=False)
+class ProviderCapability:
+    """One provider's declared availability and contract coverage.
+
+    The U1 subset (id/version/availability/contracts/threads/workspace) is
+    unchanged.  U2 adds the manifest fields 0006 section 3.3/3.4 requires for
+    vendor providers: the canonical implementation id, numeric class and
+    reduction-order id, dtype/rank/stride preconditions, and the library and
+    artifact fingerprints that make the provider auditable.
+    """
+
+    provider_id: str
+    version: str
+    available: bool
+    target_kinds: Tuple[str, ...]
+    numeric_modes: Tuple[str, ...]
+    deterministic: bool
+    required_features: Tuple[str, ...]
+    contracts: Mapping[str, str]
+    max_threads: int
+    workspace_bytes: int
+    reason: Optional[str]
+    implementation: str
+    numeric_class: Optional[str]
+    dtypes: Tuple[str, ...]
+    stride_class: str
+    rank_range: Tuple[int, int]
+    reduction_order_id: str
+    artifact_kind: str
+    pack: Mapping[str, Any]
+    provider_artifact_digest: Optional[str]
+    library: Mapping[str, Any]
+    threads: Mapping[str, Any]
+    preconditions: Mapping[str, Any]
+
+    def __init__(
+        self,
+        provider_id: str,
+        version: str,
+        available: bool = True,
+        target_kinds: Sequence[str] = ("cpu",),
+        numeric_modes: Sequence[str] = ("portable_bitwise", "deterministic"),
+        deterministic: bool = True,
+        required_features: Sequence[str] = (),
+        contracts: Optional[Mapping[str, str]] = None,
+        max_threads: int = PORTABLE_PROVIDER_MAX_THREADS,
+        workspace_bytes: int = 0,
+        reason: Optional[str] = None,
+        implementation: str = "",
+        numeric_class: Optional[str] = None,
+        dtypes: Sequence[str] = (),
+        stride_class: str = "contiguous_only",
+        rank_range: Sequence[int] = (2, 4),
+        reduction_order_id: str = "",
+        artifact_kind: str = PORTABLE_ARTIFACT_KIND,
+        pack: Optional[Mapping[str, Any]] = None,
+        provider_artifact_digest: Optional[str] = None,
+        library: Optional[Mapping[str, Any]] = None,
+        threads: Optional[Mapping[str, Any]] = None,
+        preconditions: Optional[Mapping[str, Any]] = None
+    ) -> None:
+        if not isinstance(provider_id, str) or not provider_id.strip():
+            raise CapabilityUnavailableError(
+                "provider capability id must be a non-empty string",
+                field="capability.provider.id",
+                requested=provider_id,
+                reason="invalid_provider_id",
+            )
+        if not isinstance(version, str) or not version.strip():
+            raise CapabilityUnavailableError(
+                "provider capability version must be a non-empty string",
+                field="capability.provider.version",
+                requested=version,
+                reason="invalid_provider_version",
+            )
+        if not isinstance(available, bool):
+            raise CapabilityUnavailableError(
+                "provider capability available must be a bool",
+                field="capability.provider.available",
+                requested=available,
+                reason="invalid_availability",
+            )
+        if not isinstance(deterministic, bool):
+            raise CapabilityUnavailableError(
+                "provider capability deterministic must be a bool",
+                field="capability.provider.deterministic",
+                requested=deterministic,
+                reason="invalid_deterministic_flag",
+            )
+        if not available and not reason:
+            raise CapabilityUnavailableError(
+                "an unavailable provider must carry a reason",
+                field="capability.provider.reason",
+                requested=None,
+                reason="missing_unavailable_reason",
+            )
+        if isinstance(max_threads, bool) or not isinstance(max_threads, int) or max_threads <= 0:
+            raise CapabilityUnavailableError(
+                "provider max_threads must be a positive integer",
+                field="capability.provider.max_threads",
+                requested=max_threads,
+                reason="invalid_max_threads",
+            )
+        if isinstance(workspace_bytes, bool) or not isinstance(workspace_bytes, int) or workspace_bytes < 0:
+            raise CapabilityUnavailableError(
+                "provider workspace_bytes must be a non-negative integer",
+                field="capability.provider.workspace_bytes",
+                requested=workspace_bytes,
+                reason="invalid_workspace_bytes",
+            )
+        normalized_contracts = {}
+        if contracts:
+            for key, digest in contracts.items():
+                if not isinstance(key, str) or not key.strip():
+                    raise CapabilityUnavailableError(
+                        "provider contract keys must be opcodes",
+                        field="capability.provider.contracts",
+                        requested=key,
+                        reason="invalid_contract_key",
+                    )
+                if not isinstance(digest, str) or not digest.startswith("sha256:"):
+                    raise CapabilityUnavailableError(
+                        "provider contract digests must be 'sha256:' strings",
+                        field="capability.provider.contracts." + key,
+                        requested=digest,
+                        reason="invalid_contract_digest",
+                    )
+                normalized_contracts[key.strip()] = digest
+        normalized_dtypes = tuple(sorted({str(item).strip().lower() for item in dtypes if str(item).strip()}))
+        try:
+            rank_min, rank_max = (int(rank_range[0]), int(rank_range[1]))
+        except (TypeError, ValueError, IndexError) as exc:
+            raise CapabilityUnavailableError(
+                "provider rank_range must be a (min, max) pair",
+                field="capability.provider.rank_range",
+                requested=rank_range,
