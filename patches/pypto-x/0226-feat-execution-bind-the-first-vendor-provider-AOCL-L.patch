+
+def _get_library(path: str, variant: Optional[str] = None) -> ctypes.CDLL:
+    """Load and bind the shared library once per process.
+
+    ``loaded_threads`` records the BLIS thread count captured at load time
+    from the process environment (``OMP_NUM_THREADS``).  That OpenMP-decorator
+    path is the Q8 timing path; the slower BLIS API path
+    (``bli_thread_set_num_threads``) is used only when the frozen plan
+    explicitly declares ``thread_mode=api_pinned``.
+    """
+
+    entry = _LIBRARY_CACHE.get(path)
+    if entry is None:
+        lib = ctypes.CDLL(path)
+        _bind_common(lib)
+        # BLIS captures its thread count at first init.  The Q8-aligned path is
+        # the BLIS-managed ("blis_mt") path selected by BLIS_NUM_THREADS; if the
+        # caller did not set it, seed it from OMP_NUM_THREADS / cpu_count for the
+        # init call and restore the environment afterwards.  The captured count
+        # is a process fact and is recorded in the probe fingerprint.
+        injected = _seed_blis_thread_env()
+        try:
+            loaded = int(lib.bli_thread_get_num_threads())
+        finally:
+            _restore_blis_thread_env(injected)
+        entry = {"lib": lib, "variants": set(), "loaded_threads": loaded}
+        _LIBRARY_CACHE[path] = entry
+    if variant is not None and variant not in entry["variants"]:
+        _bind_variant(entry["lib"], variant)
+        entry["variants"].add(variant)
+    return entry["lib"]
+
+
+def _desired_default_threads() -> int:
+    """Thread count the process environment asks for (BLIS > OMP > cpu_count)."""
+
+    for name in ("BLIS_NUM_THREADS", "OMP_NUM_THREADS"):
+        value = os.environ.get(name)
+        if value:
+            try:
+                parsed = int(value)
+            except ValueError:
+                continue
+            if parsed >= 1:
+                return parsed
+    return int(os.cpu_count() or 1)
+
+
+def _seed_blis_thread_env():
+    """Seed BLIS_NUM_THREADS for the first-init call; return the restore token.
+
+    Returning the previous value lets the caller put the environment back so
+    the provider does not leak a knob the user did not set.
+    """
+
+    if os.environ.get("BLIS_NUM_THREADS"):
+        return None
+    previous = os.environ.get("BLIS_NUM_THREADS")
+    os.environ["BLIS_NUM_THREADS"] = str(_desired_default_threads())
+    return ("set", previous)
+
+
+def _restore_blis_thread_env(token) -> None:
+    if token is None:
+        return
+    action, previous = token
+    if previous is None:
+        os.environ.pop("BLIS_NUM_THREADS", None)
+    else:
+        os.environ["BLIS_NUM_THREADS"] = previous
+
+
+def _loaded_threads(path: str) -> int:
+    _get_library(path)
+    return int(_LIBRARY_CACHE[path]["loaded_threads"])
+
+
+def _apply_declared_thread_mode(lib: ctypes.CDLL, path: str, threads: int, declared_mode: str):
+    """Apply the plan's frozen thread mode and verify the effective count.
+
+    ``env_default`` keeps BLIS on the environment/OpenMP path captured at
+    library load; ``api_pinned`` uses ``bli_thread_set_num_threads``.  The
+    mode is part of the plan (and therefore of the plan digest), so the
+    runtime never guesses and the same policy + capability digest always
+    produces the same mode.
+    """
+
+    if declared_mode not in ("env_default", "api_pinned"):
+        raise ArtifactMismatchError(
+            "plan declares an unknown thread mode",
+            field="plan.selected.thread_mode",
+            requested=declared_mode,
+            available=["env_default", "api_pinned"],
+            reason="plan_thread_mode_invalid",
+        )
+    loaded = _loaded_threads(path)
+    if declared_mode == "env_default":
+        current = int(lib.bli_thread_get_num_threads())
+        if threads != loaded or current != loaded:
+            raise ArtifactMismatchError(
+                "plan declares env_default threading but the loaded BLIS thread count differs",
+                field="plan.selected.thread_mode",
+                requested={"mode": declared_mode, "threads": threads},
+                available={"loaded_threads": loaded, "current_threads": current},
+                reason="thread_mode_runtime_mismatch",
+            )
+    else:
+        lib.bli_thread_set_num_threads(threads)
+    applied = int(lib.bli_thread_get_num_threads())
+    if applied != threads:
+        raise CapabilityUnavailableError(
+            "AOCL thread pinning did not take effect",
+            field="resources.max_threads",
+            requested=threads,
+            available={"applied": applied, "loaded": loaded},
+            reason="thread_policy_mismatch",
+        )
+    return declared_mode, {
+        "mode": declared_mode,
+        "requested_threads": int(threads),
+        "effective_threads": int(applied),
+        "loaded_threads": int(loaded),
+        "OMP_NUM_THREADS": os.environ.get("OMP_NUM_THREADS"),
+        "BLIS_NUM_THREADS": os.environ.get("BLIS_NUM_THREADS"),
+        "bli_thread_set_num_threads": int(applied) if declared_mode == "api_pinned" else None,
+    }
+
+
+def _bind_common(lib: ctypes.CDLL) -> None:
+    lib.bli_info_get_version_str.restype = ctypes.c_char_p
