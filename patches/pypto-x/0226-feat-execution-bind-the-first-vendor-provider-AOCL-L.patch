+# Host feature names relevant to the currently registered CPU providers.  The
+# list is intentionally explicit instead of "all /proc flags" so the
+# capability digest stays a stable, small platform fact set.
+_X86_FEATURES = (
+    "avx2",
+    "fma",
+    "avx512f",
+    "avx512bw",
+    "avx512cd",
+    "avx512dq",
+    "avx512vl",
+    "avx512_bf16",
+    "avx512_vnni",
+    "avx512vbmi",
+    "avx512_vpopcntdq",
+    "amx_bf16",
+)
+_AARCH64_FEATURES = (
+    "sve",
+    "sve2",
+    "bf16",
+    "i8mm",
+    "fp16",
+)
+
+
+def host_features() -> Tuple[str, ...]:
+    """Return the local CPU feature subset relevant to registered providers.
+
+    This is a *fact probe* (``/proc/cpuinfo``), not a policy: the resolver
+    compares provider ``required_features`` against it, and the snapshot
+    digest records the result so a plan cannot be replayed on a host with
+    different instruction support.
+    """
+
+    try:
+        with open("/proc/cpuinfo", "r", encoding="utf-8", errors="replace") as handle:
+            lines = handle.readlines()
+    except OSError:
+        return ()
+    machine = (platform.machine() or "").strip().lower()
+    if machine in ("x86_64", "amd64"):
+        interesting = set(_X86_FEATURES)
+        keys = ("flags", "Features")
+    elif machine in ("aarch64", "arm64"):
+        interesting = set(_AARCH64_FEATURES)
+        keys = ("Features", "flags")
+    else:
+        return ()
+    found = set()
+    for line in lines:
+        name, separator, value = line.partition(":")
+        if not separator or name.strip() not in keys:
+            continue
+        for flag in value.split():
+            flag = flag.strip().lower()
+            if flag in interesting:
+                found.add(flag)
+    return tuple(sorted(found))
 
 
