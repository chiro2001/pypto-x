+def _hard_rejected(item: Mapping[str, Any]) -> bool:
+    """True when the provider is outside the policy's *scope*.
+
+    Contract-digest mismatches stay in scope so the failure is reported as
+    ``provider_contract_digest_mismatch`` instead of a generic "no provider in
+    scope"; only scope/kind failures demote a provider here.
+    """
+
+    hard = (
+        "provider_not_allowed_by_contract",
+        "provider_target_kind_mismatch",
+        "provider_not_in_scope",
+    )
+    return str(item["reason"]) in hard
+
+
+def _rejection_record(item: Mapping[str, Any]) -> Mapping[str, Any]:
+    entry = item["entry"]
+    failed = [check for check in item["checks"] if check["outcome"] == "rejected"]
+    reason = str(item["reason"])
+    base_reason = reason.split(":", 1)[0]
+    message = _REASON_MESSAGES.get(base_reason, base_reason)
+    if reason.startswith("provider_capability_unavailable:"):
+        message = "{} ({})".format(message, reason.split(":", 1)[1])
+    return {
+        "candidate": entry.provider_id,
+        "provider_version": entry.version,
+        "numeric_class": item["numeric_class"],
+        "scope": item["scope"] or "out_of_scope",
+        "state": item.get("state", "rejected"),
+        "reason": reason,
+        "message": message,
+        "library_version": entry.library.get("blis_version"),
+        "failed_checks": [dict(check) for check in failed],
+    }
+
+
