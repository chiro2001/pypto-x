+@requires_aocl
+def test_runtime_provider_unavailability_walks_the_declared_chain():
+    """A declared chain is walked at runtime only for unavailability failures."""
+
+    dtype, shape_a, shape_b = "float32", (4, 32), (32, 8)
+    left = _tensor(dtype, shape_a, seed=101)
+    right = _tensor(dtype, shape_b, seed=102)
+    policy = _vendor_policy(dtype, fallback=FallbackPolicy(mode="portable_only"))
+    capability = _host_snapshot()
+    plan = plan_matmul(shape_a, shape_b, dtype, policy, capability=capability).plan
+    assert plan.selected_provider == AOCL_LPGEMM_F32_PROVIDER_ID
+    assert plan.fallback_chain == (AOCL_LPGEMM_F32_PROVIDER_ID, "portable")
+
+    original = providers_module.PROVIDERS[AOCL_LPGEMM_F32_PROVIDER_ID]
+
+    class UnavailableAtRuntime(object):
+        provider_id = AOCL_LPGEMM_F32_PROVIDER_ID
+        version = original.version
+        implementation = original.implementation
+        numeric_class = original.numeric_class
+
+        def execute(self, plan, left, right, output, capability):
+            raise ProviderUnavailableError(
+                "simulated runtime unavailability",
+                field="capability.providers",
+                requested=self.provider_id,
+                available=[],
+                reason="provider_capability_unavailable:library_not_found",
+            )
+
+    providers_module.PROVIDERS[AOCL_LPGEMM_F32_PROVIDER_ID] = UnavailableAtRuntime()
+    try:
+        result, report = execute_matmul_plan(plan, left, right, capability=capability)
+    finally:
+        providers_module.PROVIDERS[AOCL_LPGEMM_F32_PROVIDER_ID] = original
+
+    portable, _ = execute_matmul(left, right, ExecutionPolicy.portable())
+    assert result.flat() == portable.flat()
+    document = report.to_dict()
+    assert document["dispatch"]["provider_declared"] == AOCL_LPGEMM_F32_PROVIDER_ID
+    assert document["dispatch"]["provider_invoked"] == "portable"
+    assert document["dispatch"]["chain_position"] == 1
+    assert document["dispatch"]["declaration_match"] is True
+    assert document["dispatch"]["fallback_used"] is True
+    assert document["resolution"]["fallback_used"] is True
+    assert document["resolution"]["fallback_events"][-1]["kind"] == "provider_unavailable"
+    assert document["gates"]["status"] == "UNGATED"
+
