+def test_forged_thread_mode_inconsistent_with_loaded_threads_is_rejected():
+    """env_default may only be declared when the loaded count matches."""
+
+    dtype, shape_a, shape_b = "float32", (4, 32), (32, 8)
+    policy = _vendor_policy(dtype, max_threads=2)
+    plan = plan_matmul(shape_a, shape_b, dtype, policy).plan
+    if plan.selected["thread_mode"] != "api_pinned":
+        pytest.skip("test process already loaded BLIS with the plan's thread count")
+    payload = plan.payload
+    payload["selected"] = dict(payload["selected"], thread_mode="env_default")
+    forged = ExecutionPlan(payload)
+    left = _tensor(dtype, shape_a, seed=131)
+    right = _tensor(dtype, shape_b, seed=132)
+    output = HostTensor(dtype, (4, 8), [13.0] * 32)
+    details = _assert_failure(
+        ARTIFACT_MISMATCH, lambda: execute_matmul_plan(forged, left, right, output=output)
+    )
+    assert details["reason"] == "thread_mode_runtime_mismatch"
+    assert output.flat() == tuple([13.0] * 32)
