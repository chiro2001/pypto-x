+@requires_avx512_bf16
+def test_report_records_at_least_three_distinct_rejection_reasons():
+    capability = _host_snapshot()
+    reasons = {}
+
+    def absorb(plan):
+        for item in plan.payload["resolution"]["rejections"]:
+            reasons.setdefault(item["reason"], item["message"])
+
+    # (1) dtype + (2) scope reasons: a float32 vendor request sees the bf16
+    # vendor rejected for dtype and the portable trunk outside mode=vendor.
+    f32_policy = ExecutionPolicy(
+        profile="auto_static",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=2),
+    )
+    absorb(resolve_matmul(f32_policy, capability, (4, 32), (32, 8), "float32").plan)
+
+    # (3) rank precondition: rank-3 request under mode=auto.
+    auto_policy = ExecutionPolicy(
+        profile="auto_static",
+        provider=ProviderPolicy(mode="auto"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=2),
+    )
+    absorb(resolve_matmul(auto_policy, capability, (2, 4, 32), (2, 32, 8), "float32").plan)
+
+    # (4) availability: an injected unavailable vendor alongside the portable
+    # trunk, so a successful plan still carries the structured reason.
+    unavailable = _host_snapshot(
+        providers=(
+            _vendor_entry(AOCL_LPGEMM_F32_PROVIDER_ID, available=False, reason="library_not_found"),
+            _portable_entry(),
+        )
+    )
+    absorb(resolve_matmul(auto_policy, unavailable, (4, 32), (32, 8), "float32").plan)
+
+    assert len(reasons) >= 3, reasons
+    assert "dtype_not_supported" in reasons
+    assert any(reason.startswith("provider_capability_unavailable") for reason in reasons)
+    for message in reasons.values():
+        assert isinstance(message, str) and message.strip()
+
+    # The same reasons must be reachable from the execution report.
+    left = _tensor("float32", (4, 32), seed=91)
+    right = _tensor("float32", (32, 8), seed=92)
+    result, report = execute_matmul(left, right, f32_policy)
+    document = report.to_dict()
+    assert len(document["resolution"]["rejections"]) >= 1
+    assert any(
+        item["reason"] == "dtype_not_supported" for item in document["resolution"]["rejections"]
+    )
+    assert document["resolution"]["numeric_class_order"] == [
+        "exact",
+        "portable_bitwise",
+        "deterministic_bounded",
+        "best_effort",
+    ]
+
