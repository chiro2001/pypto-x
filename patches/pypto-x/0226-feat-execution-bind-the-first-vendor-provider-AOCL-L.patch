+
+def _sha256_file(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _cstr(value: Any) -> str:
+    if isinstance(value, bytes):
+        return value.decode("utf-8", errors="replace")
+    return str(value)
+
+
+def _base_fingerprint(path: str, stat_result: Any, digest: Optional[str]) -> Mapping[str, Any]:
+    document = {
+        "name": os.path.basename(path),
+        "path": path,
+        "sha256_expected": AOCL_SHA256_PIN,
+        "sha256": digest,
+        "size_bytes": None if stat_result is None else int(stat_result.st_size),
+        "blis_tag": AOCL_BLIS_TAG,
+        "blis_commit": AOCL_BLIS_COMMIT,
+        "arch_id_expected": AOCL_ARCH_ID,
+        "arch_string_expected": AOCL_ARCH_STRING,
+        "int_type_size_expected": AOCL_INT_TYPE_SIZE,
+        "blas_int_type_size_expected": AOCL_BLAS_INT_TYPE_SIZE,
+        "build_options": list(AOCL_BUILD_OPTIONS),
+    }
+    return document
+
+
+def _unavailable(
+    reason: str,
+    message: str,
+    path: str,
