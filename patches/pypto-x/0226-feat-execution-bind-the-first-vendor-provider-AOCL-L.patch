+@requires_aocl
+def test_vendor_report_pack_and_thread_semantics():
+    shape_a, shape_b = (4, 64), (64, 16)
+    left = _tensor("bf16", shape_a, seed=81)
+    right = _tensor("bf16", shape_b, seed=82)
+    policy = _vendor_policy("bf16", max_threads=2)
+    output, report = execute_matmul(left, right, policy)
+    document = report.to_dict()
+    assert document["artifact"]["kind"] == "vendor_library"
+    assert document["artifact"]["pack"]["strategy"] == "b_pre_reordered_outside_timing"
+    assert document["artifact"]["pack"]["included_in_timing"] is False
+    timing = document["timing"]
+    assert timing["pack_seconds"] >= 0.0
+    assert timing["kernel_seconds"] is None
+    assert math.isclose(
+        timing["wall_seconds"],
+        timing["op_seconds"] + timing["pack_seconds"] + timing["transfer_seconds"] + timing["dispatch_seconds"],
+        rel_tol=0.0,
+        abs_tol=1e-9,
+    )
+    assert document["resources"]["parallelism"]["intra_op_threads"] == 2
+    assert document["resolved"]["library"]["sha256"] == AOCL_SHA256_PIN
+    assert document["dispatch"]["threads_used"] == 2
+    assert document["dispatch"]["fallback_used"] is False
+    assert document["gates"]["status"] == "UNGATED"
+    # U2a thread contract: the mode is part of the frozen plan and the report
+    # records the effective environment/API values.
+    thread_mode = document["resources"]["parallelism"]["thread_mode"]
+    assert thread_mode in ("env_default", "api_pinned")
+    assert thread_mode == plan_matmul(shape_a, shape_b, "bf16", policy).plan.selected["thread_mode"]
+    thread_state = document["resources"]["parallelism"]["thread_state"]
+    assert thread_state["mode"] == thread_mode
+    assert thread_state["requested_threads"] == 2
+    assert thread_state["effective_threads"] == 2
+    assert "OMP_NUM_THREADS" in thread_state
+    assert "BLIS_NUM_THREADS" in thread_state
