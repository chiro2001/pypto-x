+def _reconcile_outcome(plan: ExecutionPlan, outcome: ProviderOutcome, provider: Any) -> None:
+    """F5 + D1: execution result must match the frozen plan and manifest.
+
+    A declared fallback step is reconciled against *its own* manifest (the
+    plan chain carries provider ids, not per-step versions); the report
+    records both the declared primary and the invoked provider.
+    """
+
+    mismatches = {}
+    if getattr(outcome, "binding_mode", "selected") == "declared_fallback":
+        if outcome.provider_version != provider.version:
+            mismatches["provider_version"] = {
+                "provider_manifest": provider.version,
+                "outcome": outcome.provider_version,
+            }
+        if outcome.implementation != provider.implementation:
+            mismatches["implementation"] = {
+                "provider_manifest": provider.implementation,
+                "outcome": outcome.implementation,
+            }
+        manifest_numeric = getattr(provider, "numeric_class", None)
+        if outcome.numeric_class and manifest_numeric and outcome.numeric_class != manifest_numeric:
+            mismatches["numeric_class"] = {
+                "provider_manifest": manifest_numeric,
+                "outcome": outcome.numeric_class,
+            }
+        if mismatches:
+            raise ArtifactMismatchError(
+                "fallback execution outcome does not match the invoked provider manifest",
+                field="plan.fallback.chain",
+                requested=mismatches,
+                available=plan.fallback_chain,
+                reason="execution_outcome_does_not_match_provider_manifest",
+            )
+        return
+    if outcome.provider_version != plan.selected_provider_version:
+        mismatches["provider_version"] = {
+            "plan": plan.selected_provider_version,
+            "outcome": outcome.provider_version,
+        }
+    if outcome.implementation != plan.selected_implementation:
+        mismatches["implementation"] = {
+            "plan": plan.selected_implementation,
+            "outcome": outcome.implementation,
+        }
+    if outcome.numeric_class and outcome.numeric_class != plan.selected_numeric_class:
+        mismatches["numeric_class"] = {
+            "plan": plan.selected_numeric_class,
+            "outcome": outcome.numeric_class,
+        }
+    artifact = plan.artifact
+    if int(outcome.lowering_version) != int(artifact["lowering_version"]):
+        mismatches["lowering_version"] = {
+            "plan": artifact["lowering_version"],
+            "outcome": outcome.lowering_version,
+        }
+    if int(outcome.wire_version) != int(artifact["wire_version"]):
+        mismatches["wire_version"] = {"plan": artifact["wire_version"], "outcome": outcome.wire_version}
+    if mismatches:
+        raise ArtifactMismatchError(
+            "execution outcome does not match the frozen plan declaration",
+            field="plan.selected",
+            requested=mismatches,
+            available=plan.selected,
+            reason="execution_outcome_does_not_match_plan",
+        )
+
