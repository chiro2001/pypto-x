--- /dev/null
+++ b/python/pypto/execution/outcome.py
@@ -0,0 +1,44 @@
+"""Facts observed while executing one declared plan.
+
+``ProviderOutcome`` is deliberately a leaf module: both the portable trunk
+binding (:mod:`pypto.execution.providers`) and the vendor binding
+(:mod:`pypto.execution.provider_aocl`) construct it, and the entry layer uses
+it to build the ``ExecutionReport``.  U1 only needed the Core IR artifact
+fields; U2 adds the provider/library/pack/numeric facts the report must
+reconcile (0006 sections 3.4, 8.1 and 13.6).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Mapping, Optional, Tuple
+
+
+@dataclass(frozen=True)
+class ProviderOutcome:
+    """Result plus the fingerprints observed while executing one plan."""
+
+    output: Any
+    artifact_format: str
+    artifact_content_digest: str
+    abi_version: str
+    lowering_version: int
+    wire_version: int
+    op_seconds: float
+    threads_used: int
+    provider_version: str
+    implementation: str
+    numeric_class: str = ""
+    library: Mapping[str, Any] = field(default_factory=dict)
+    pack_seconds: float = 0.0
+    pack_strategy: str = "none"
+    pack_included_in_timing: bool = True
+    artifact_kind: str = "core_ir_artifact"
+    provider_artifact_digest: Optional[str] = None
+    cpu_affinity: Tuple[int, ...] = ()
+    binding_mode: str = "selected"
+    thread_mode: str = "env_default"
+    thread_state: Mapping[str, Any] = field(default_factory=dict)
+
+
+__all__ = ["ProviderOutcome"]
