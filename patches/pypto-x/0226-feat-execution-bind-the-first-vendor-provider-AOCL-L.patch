+@dataclass(frozen=True)
+class AoclProbe:
+    """Structured result of probing the AOCL artifact."""
+
+    available: bool
+    reason: str
+    message: str
+    library_path: str
+    fingerprint: Mapping[str, Any]
+    checks: Mapping[str, Any]
+
+    def variant_available(self, variant: str) -> bool:
+        if not self.available:
+            return False
+        missing = self.checks.get("variant_missing_symbols", {}).get(variant) or []
+        return not missing
+
+    def variant_reason(self, variant: str) -> str:
+        if not self.available:
+            return self.reason
+        missing = self.checks.get("variant_missing_symbols", {}).get(variant) or []
+        if missing:
+            return "symbol_missing:" + ",".join(missing)
+        return "ok"
+
