+"""U2a AOCL/LPGEMM vendor provider regressions (bf16 + f32 matmul).
+
+These tests use the same synthetic ``pypto`` package namespace as
+``test_execution_matmul.py`` so they never trigger the upstream native
+initializer.  The AOCL artifact is host-local (Q8 ``vendor-gemm-survey``);
+the execution tests skip when it is not present, while the probe/fail-closed
+tests always run and inject structured manifests instead of the real library.
+
+Coverage: availability probing (missing/sha mismatch), manifest preconditions
+and fingerprints, vendor numeric band vs the portable trunk (no bitwise
+claim), plan determinism/replay, forged-plan rejection with a recomputed
+digest (U1 follow-up ``u1r1_D1``), outcome/provider reconciliation (``F5``),
+fallback semantics (deny / portable_only / declared) and rejection reasons.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import math
+import os
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        import pypto.execution.providers as providers_module
+        from pypto.backends.cpu import HostTensor
+        from pypto.execution import (
+            AOCL_DEFAULT_LIBRARY,
+            AOCL_LPGEMM_BF16_PROVIDER_ID,
+            AOCL_LPGEMM_F32_PROVIDER_ID,
+            AOCL_SHA256_PIN,
+            ARTIFACT_MISMATCH,
+            CAPABILITY_UNAVAILABLE,
+            FALLBACK_DISALLOWED,
+            NUMERIC_GUARANTEE_UNMET,
+            PROVIDER_UNAVAILABLE,
+            CapabilitySnapshot,
+            ExecutionPlan,
+            ExecutionPolicy,
+            FallbackPolicy,
+            NumericPolicy,
+            ProviderCapability,
+            ProviderPolicy,
+            ProviderUnavailableError,
+            ResourcePolicy,
+            aocl_provider_capabilities,
+            execute_matmul,
+            execute_matmul_plan,
+            get_op_definition,
+            host_features,
+            plan_matmul,
+            portable_provider_capability,
+            probe_aocl,
+            resolve_matmul,
+        )
+        from pypto.execution.errors import ExecutionError
+        return locals()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+
+
+_C = _imports()
+providers_module = _C["providers_module"]
+ProviderUnavailableError = _C["ProviderUnavailableError"]
+AOCL_DEFAULT_LIBRARY = _C["AOCL_DEFAULT_LIBRARY"]
+AOCL_LPGEMM_BF16_PROVIDER_ID = _C["AOCL_LPGEMM_BF16_PROVIDER_ID"]
+AOCL_LPGEMM_F32_PROVIDER_ID = _C["AOCL_LPGEMM_F32_PROVIDER_ID"]
+AOCL_SHA256_PIN = _C["AOCL_SHA256_PIN"]
+ARTIFACT_MISMATCH = _C["ARTIFACT_MISMATCH"]
+CAPABILITY_UNAVAILABLE = _C["CAPABILITY_UNAVAILABLE"]
+FALLBACK_DISALLOWED = _C["FALLBACK_DISALLOWED"]
+NUMERIC_GUARANTEE_UNMET = _C["NUMERIC_GUARANTEE_UNMET"]
+PROVIDER_UNAVAILABLE = _C["PROVIDER_UNAVAILABLE"]
+CapabilitySnapshot = _C["CapabilitySnapshot"]
+ExecutionError = _C["ExecutionError"]
+ExecutionPlan = _C["ExecutionPlan"]
+ExecutionPolicy = _C["ExecutionPolicy"]
+FallbackPolicy = _C["FallbackPolicy"]
+HostTensor = _C["HostTensor"]
+NumericPolicy = _C["NumericPolicy"]
+ProviderCapability = _C["ProviderCapability"]
+ProviderPolicy = _C["ProviderPolicy"]
+ResourcePolicy = _C["ResourcePolicy"]
+aocl_provider_capabilities = _C["aocl_provider_capabilities"]
+execute_matmul = _C["execute_matmul"]
+execute_matmul_plan = _C["execute_matmul_plan"]
+get_op_definition = _C["get_op_definition"]
+plan_matmul = _C["plan_matmul"]
+portable_provider_capability = _C["portable_provider_capability"]
+probe_aocl = _C["probe_aocl"]
+resolve_matmul = _C["resolve_matmul"]
+HOST_FEATURES = tuple(_C["host_features"]())
+
+AOCL_PRESENT = os.path.isfile(AOCL_DEFAULT_LIBRARY)
+requires_aocl = pytest.mark.skipif(not AOCL_PRESENT, reason="Q8 AOCL artifact is not present on this host")
+requires_avx512_bf16 = pytest.mark.skipif(
+    not {"avx512f", "avx512_bf16"} <= set(HOST_FEATURES),
+    reason="host feature probe lacks avx512f/avx512_bf16",
+)
+
+
+def _assert_failure(error_code, callable_):
+    with pytest.raises(ExecutionError) as excinfo:
+        callable_()
+    assert excinfo.value.code == error_code, excinfo.value.to_dict()
+    return excinfo.value.to_dict()
+
+
+def _tensor(dtype, shape, seed, scale=1.0):
+    count = 1
+    for dimension in shape:
+        count *= dimension
+    state = seed & 0xFFFFFFFF
+    values = []
+    for _ in range(count):
+        state = (1103515245 * state + 12345) & 0x7FFFFFFF
+        values.append(((state / 0x7FFFFFFF) * 2.0 - 1.0) * scale)
+    return HostTensor(dtype, shape, values)
+
+
+def _max_abs_rel(candidate, reference):
+    max_abs = 0.0
+    max_rel = 0.0
+    for got, expected in zip(candidate.flat(), reference.flat()):
+        difference = abs(float(got) - float(expected))
+        max_abs = max(max_abs, difference)
+        denominator = abs(float(expected))
+        if denominator > 1e-12:
+            max_rel = max(max_rel, difference / denominator)
+    return max_abs, max_rel
+
+
+def _vendor_policy(dtype, requirement="deterministic", max_threads=2, fallback=None, mode="vendor"):
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode=mode),
+        numeric=NumericPolicy(requirement=requirement),
+        deterministic=True,
+        fallback=fallback if fallback is not None else FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=max_threads),
+    )
+
+
+def _vendor_entry(provider_id, available=True, reason=None):
+    """Build one vendor manifest entry with an explicit availability override."""
+
+    entries = {entry.provider_id: entry for entry in aocl_provider_capabilities()}
+    base = dict(entries[provider_id].to_dict())
+    base["available"] = available
+    base["reason"] = None if available else (reason or "unit_test_unavailable")
+    return ProviderCapability.from_dict(base)
+
+
+def _portable_entry(available=True, reason=None):
+    return portable_provider_capability(available=available, reason=reason)
+
+
+def _host_snapshot(providers=None):
+    return CapabilitySnapshot.for_host(features=HOST_FEATURES, providers=providers)
+
+
+# ---------------------------------------------------------------------------
+# probing and manifests
+# ---------------------------------------------------------------------------
+def test_probe_missing_library_is_structured_unavailable(tmp_path):
+    missing = str(tmp_path / "libblis-mt.so.5.3.2")
+    probe = probe_aocl(library_path=missing, use_cache=False)
+    assert probe.available is False
+    assert probe.reason == "library_not_found"
+    assert probe.fingerprint["sha256_expected"] == AOCL_SHA256_PIN
+    for entry in aocl_provider_capabilities(probe=probe):
+        assert entry.available is False
+        assert entry.reason == "library_not_found"
+        assert entry.numeric_class == "deterministic_bounded"
+        assert entry.provider_artifact_digest is None
+
+
+def test_probe_sha256_mismatch_is_structured_unavailable(tmp_path):
+    bogus = tmp_path / "libblis-mt.so.5.3.2"
+    bogus.write_bytes(b"not the pinned AOCL build")
+    probe = probe_aocl(library_path=str(bogus), use_cache=False)
+    assert probe.available is False
+    assert probe.reason == "library_sha256_mismatch"
+    actual = hashlib.sha256(bogus.read_bytes()).hexdigest()
+    assert probe.checks["sha256_actual"] == actual
+    assert probe.checks["sha256_expected"] == AOCL_SHA256_PIN
+
+
+@requires_aocl
+def test_probe_pinned_facts_match_the_q8_artifact():
+    probe = probe_aocl(use_cache=False)
+    assert probe.available is True
+    assert probe.reason == "ok"
+    assert probe.fingerprint["sha256"] == AOCL_SHA256_PIN
+    assert probe.fingerprint["size_bytes"] == os.stat(AOCL_DEFAULT_LIBRARY).st_size
+    assert "5.3.2" in probe.fingerprint["blis_version"]
+    assert probe.fingerprint["arch_id"] == 10
+    assert probe.fingerprint["arch_string"] == "zen4"
+    assert probe.fingerprint["int_type_size"] == 64
+    assert probe.fingerprint["blas_int_type_size"] == 32
+    assert probe.fingerprint["default_threads"] >= 1
+    assert probe.fingerprint["thread_knob"] == "bli_thread_set_num_threads"
+    assert probe.variant_available("bf16") and probe.variant_available("f32")
+
+
+@requires_aocl
+def test_vendor_manifests_declare_preconditions_and_fingerprints():
+    entries = {entry.provider_id: entry for entry in aocl_provider_capabilities()}
+    bf16 = entries[AOCL_LPGEMM_BF16_PROVIDER_ID]
+    f32 = entries[AOCL_LPGEMM_F32_PROVIDER_ID]
+    assert bf16.dtypes == ("bf16",) and f32.dtypes == ("float32",)
+    assert bf16.rank_range == (2, 2) and f32.rank_range == (2, 2)
+    assert bf16.stride_class == "contiguous_only" and f32.stride_class == "contiguous_only"
+    assert bf16.numeric_class == "deterministic_bounded" and bf16.deterministic is True
+    assert bf16.reduction_order_id == "aocl_lpgemm_bf16_blocked_f32acc_v1"
+    assert f32.reduction_order_id == "blis_row_major_blocked_f32acc_v1"
+    assert bf16.preconditions["min_dimension"] == 1
+    assert bf16.artifact_kind == "vendor_library"
+    assert str(bf16.provider_artifact_digest).startswith("sha256:")
+    assert bf16.pack["included_in_timing"] is False
+    assert f32.pack["included_in_timing"] is True
+    definition = get_op_definition("matmul")
+    assert bf16.contracts["matmul"] == definition.contract_digest
+    assert definition.canonical_opcode == "matmul"
+
+
+# ---------------------------------------------------------------------------
+# numeric evidence vs the portable trunk (no bitwise claim)
+# ---------------------------------------------------------------------------
+@requires_aocl
+@pytest.mark.parametrize(
+    "dtype, shape_a, shape_b",
+    (
+        ("float32", (4, 64), (64, 16)),
+        ("float32", (5, 128), (128, 8)),
+        ("bf16", (4, 64), (64, 16)),
+        ("bf16", (5, 128), (128, 8)),
+    ),
+)
+def test_vendor_numeric_band_against_portable(dtype, shape_a, shape_b):
+    left = _tensor(dtype, shape_a, seed=11)
+    right = _tensor(dtype, shape_b, seed=12)
+    policy = _vendor_policy(dtype)
+    vendor_out, vendor_report = execute_matmul(left, right, policy)
+    portable_out, _ = execute_matmul(left, right, ExecutionPolicy.portable())
+
+    max_abs, max_rel = _max_abs_rel(vendor_out, portable_out)
+    if dtype == "bf16":
+        # bf16 output rounding (~2^-9 relative) plus a bounded f32-accumulation
+        # reorder term; never claim bitwise identity for the vendor path.
+        assert max_abs <= 2.0 ** -8, (max_abs, max_rel)
+        assert max_rel <= 2.0 ** -7, (max_abs, max_rel)
+    else:
+        assert max_abs <= 1e-4, (max_abs, max_rel)
+        assert max_rel <= 1e-5, (max_abs, max_rel)
+    document = vendor_report.to_dict()
+    assert document["guarantees"]["numeric_class"] == "deterministic_bounded"
+    assert document["guarantees"]["precision_class"] == "deterministic_bounded"
+    assert document["guarantees"]["exactness_basis"] == "provider_version_threads_and_order"
+    assert document["gates"]["status"] == "UNGATED"
+
+
+@requires_aocl
+def test_vendor_execution_is_reproducible_for_a_frozen_plan():
+    dtype, shape_a, shape_b = "float32", (6, 96), (96, 12)
+    left = _tensor(dtype, shape_a, seed=21)
+    right = _tensor(dtype, shape_b, seed=22)
+    policy = _vendor_policy(dtype)
+    capability = _host_snapshot()
+    resolution = resolve_matmul(policy, capability, shape_a, shape_b, dtype)
+    first, first_report = execute_matmul_plan(resolution.plan, left, right, capability=capability)
+    second = HostTensor.zeros(dtype, first.shape)
+    _, second_report = execute_matmul_plan(
+        resolution.plan, left, right, capability=capability, output=second
+    )
+    assert first.flat() == second.flat()
+    assert first_report.plan_digest == resolution.plan.digest
+    assert second_report.plan_digest == resolution.plan.digest
+    replay = resolve_matmul(policy, capability, shape_a, shape_b, dtype)
+    assert replay.plan.digest == resolution.plan.digest
+    document = first_report.to_dict()
+    assert document["dispatch"]["provider_invoked"] == resolution.plan.selected_provider
+    assert document["dispatch"]["provider_version_reconciled"] is True
+    assert document["dispatch"]["implementation_reconciled"] is True
+    assert document["resolved"]["provider_version"] == resolution.plan.selected_provider_version
+    assert str(document["artifact"]["provider_artifact_digest"]).startswith("sha256:")
+    assert document["artifact"]["library"]["sha256"] == AOCL_SHA256_PIN
+
+
+# ---------------------------------------------------------------------------
+# declared = executed: forged plans and F5 reconciliation
+# ---------------------------------------------------------------------------
+@requires_aocl
+def test_forged_plan_selected_implementation_is_rejected():
+    shape_a, shape_b = (4, 32), (32, 8)
+    policy = _vendor_policy("float32")
+    plan = plan_matmul(shape_a, shape_b, "float32", policy).plan
+    payload = plan.payload
+    payload["selected"] = dict(payload["selected"], implementation="forged.evil.matmul")
+    forged = ExecutionPlan(payload)
+    left = _tensor("float32", shape_a, seed=31)
+    right = _tensor("float32", shape_b, seed=32)
+    output = HostTensor("float32", (4, 8), [7.0] * 32)
+    details = _assert_failure(
+        ARTIFACT_MISMATCH, lambda: execute_matmul_plan(forged, left, right, output=output)
+    )
+    assert details["reason"] == "plan_selected_field_not_reconciled_with_provider_manifest"
+    assert output.flat() == tuple([7.0] * 32)
+
+
+@requires_aocl
+def test_forged_plan_selected_numeric_class_and_version_are_rejected():
+    shape_a, shape_b = (4, 32), (32, 8)
+    policy = _vendor_policy("bf16")
+    plan = plan_matmul(shape_a, shape_b, "bf16", policy).plan
+    left = _tensor("bf16", shape_a, seed=41)
+    right = _tensor("bf16", shape_b, seed=42)
+    for field, value in (("numeric_class", "portable_bitwise"), ("provider_version", "forged.v9")):
+        payload = plan.payload
+        payload["selected"] = dict(payload["selected"], **{field: value})
+        forged = ExecutionPlan(payload)
+        details = _assert_failure(
+            ARTIFACT_MISMATCH, lambda forged=forged: execute_matmul_plan(forged, left, right)
+        )
+        assert details["reason"] == "plan_selected_field_not_reconciled_with_provider_manifest"
+
+
+@requires_aocl
+def test_forged_artifact_provider_version_is_rejected_before_output():
+    shape_a, shape_b = (4, 32), (32, 8)
+    policy = _vendor_policy("float32")
+    plan = plan_matmul(shape_a, shape_b, "float32", policy).plan
+    payload = plan.payload
+    payload["artifact"] = dict(payload["artifact"], provider_version="forged.v9")
+    forged = ExecutionPlan(payload)
+    left = _tensor("float32", shape_a, seed=51)
+    right = _tensor("float32", shape_b, seed=52)
+    output = HostTensor("float32", (4, 8), [3.0] * 32)
+    details = _assert_failure(
+        ARTIFACT_MISMATCH, lambda: execute_matmul_plan(forged, left, right, output=output)
+    )
+    assert details["reason"] in (
+        "artifact_declaration_mismatch",
+        "plan_selected_field_not_reconciled_with_provider_manifest",
+    )
+    assert output.flat() == tuple([3.0] * 32)
+
+
+# ---------------------------------------------------------------------------
+# fail-closed and fallback semantics
+# ---------------------------------------------------------------------------
+@requires_avx512_bf16
+def test_vendor_requires_deterministic_numeric_requirement():
+    """A vendor request must not silently downgrade a portable requirement."""
+
+    capability = _host_snapshot()
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="portable"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=2),
+    )
+    details = _assert_failure(
+        NUMERIC_GUARANTEE_UNMET,
+        lambda: resolve_matmul(policy, capability, (4, 32), (32, 8), "float32"),
+    )
+    assert details["reason"] == "numeric_requirement_unmet"
+    assert details["field"] == "numeric.requirement"
+
+
+@requires_avx512_bf16
+def test_vendor_unavailable_with_fallback_deny_fails_closed_without_output():
+    providers = (
+        _vendor_entry(AOCL_LPGEMM_F32_PROVIDER_ID, available=False, reason="library_sha256_mismatch"),
+    )
+    capability = _host_snapshot(providers=providers)
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        provider=ProviderPolicy(mode="required", required=AOCL_LPGEMM_F32_PROVIDER_ID),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=2),
+    )
+    left = _tensor("float32", (4, 32), seed=61)
+    right = _tensor("float32", (32, 8), seed=62)
+    output = HostTensor("float32", (4, 8), [5.0] * 32)
+    details = _assert_failure(
+        PROVIDER_UNAVAILABLE,
+        lambda: execute_matmul(left, right, policy, capability=capability, output=output),
+    )
+    assert "library_sha256_mismatch" in details["reason"]
+    assert output.flat() == tuple([5.0] * 32)
+
+
+@requires_avx512_bf16
+def test_vendor_unavailable_portable_only_fallback_is_declared_and_degraded():
+    providers = (
+        _vendor_entry(AOCL_LPGEMM_F32_PROVIDER_ID, available=False, reason="library_sha256_mismatch"),
+        _portable_entry(),
+    )
+    capability = _host_snapshot(providers=providers)
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="portable_only"),
+        resources=ResourcePolicy(max_threads=2),
+    )
+    resolution = resolve_matmul(policy, capability, (4, 32), (32, 8), "float32")
+    plan = resolution.plan
+    assert plan.selected_provider == "portable"
+    assert plan.fallback_primary == AOCL_LPGEMM_F32_PROVIDER_ID
