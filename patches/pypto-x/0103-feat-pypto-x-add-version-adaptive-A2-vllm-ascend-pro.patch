+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: 从 ModelScope 下载并校验大模型（官方发布者）。
+
+用法::
+
+    python download_model_modelscope.py \
+        --model-id Qwen/Qwen3.5-9B --revision master \
+        --local-dir /root/models/Qwen3.5-9B \
+        --out /root/a2_vllm_qwen35/profiling/model_download.json
+
+规则：
+
+* 只允许 `--require-org`（默认 Qwen）前缀的官方发布者，否则直接拒绝；
+* 下载前检查剩余磁盘（`--min-free-gib`，默认 30）；
+* 记录 model id、请求/解析到的 revision、耗时、总字节、速率、逐文件 sha256；
+* `--dry-run` 本地可跑：只打印计划（不联网）。
+
+顺序：modelscope python API → `modelscope` CLI → HTTPS git clone。
+本脚本不写端点/凭据。
+"""
+
+import argparse
+import hashlib
+import inspect
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+
+
+def now_iso():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def sha256_file(path, chunk_size=1 << 22):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def dir_size_and_files(directory):
+    files = []
+    total = 0
+    for root, _dirs, names in os.walk(directory):
+        if os.sep + ".git" in root:
+            continue
+        for name in sorted(names):
+            path = os.path.join(root, name)
+            if not os.path.isfile(path):
+                continue
+            size = os.path.getsize(path)
+            files.append({"path": os.path.relpath(path, directory), "bytes": size})
+            total += size
+    return files, total
+
+
+def resolve_revision(model_id):
+    """尝试从 ModelScope HubApi 解析实际 revision/tag。"""
+    try:
+        from modelscope.hub.api import HubApi
+
+        api = HubApi()
+        info = api.get_model(model_id)
+        if isinstance(info, dict):
+            for key in ("Revision", "revision", "Tag", "tag"):
+                if info.get(key):
+                    return {"resolved": info[key], "source": "HubApi.get_model"}
+    except Exception as error:
+        return {"resolved": None, "error": "%s: %s" % (type(error).__name__, error)}
+    return {"resolved": None}
+
+
+def download_with_modelscope_python(model_id, revision, local_dir):
+    """使用 snapshot_download，兼容新旧函数签名。"""
+    import modelscope  # noqa: F401
+    from modelscope.hub.snapshot_download import snapshot_download
+
+    signature = inspect.signature(snapshot_download)
+    kwargs = {}
+    if "revision" in signature.parameters:
+        kwargs["revision"] = revision
+    if "local_dir" in signature.parameters:
+        kwargs["local_dir"] = local_dir
+    else:
+        kwargs["cache_dir"] = local_dir
+    path = snapshot_download(model_id, **kwargs)
+    return {"method": "modelscope.snapshot_download", "path": path, "kwargs": kwargs}
+
+
+def download_with_modelscope_cli(model_id, revision, local_dir):
+    command = [
+        sys.executable,
+        "-m",
+        "modelscope",
+        "download",
+        "--model",
+        model_id,
+        "--local_dir",
+        local_dir,
+    ]
+    if revision:
+        command += ["--revision", revision]
+    completed = subprocess.run(command, capture_output=True, text=True, timeout=None)
+    if completed.returncode != 0:
+        raise RuntimeError(
+            "modelscope CLI 失败（%s）：%s" % (completed.returncode, completed.stderr[-800:])
+        )
+    return {"method": "modelscope-cli", "command": command}
+
+
+def download_with_git(model_id, revision, local_dir):
+    url = "https://www.modelscope.cn/%s.git" % model_id
+    command = ["git", "clone", "--depth", "1"]
+    if revision and revision not in ("master", "main"):
+        command += ["--branch", revision]
+    command += [url, local_dir]
+    completed = subprocess.run(command, capture_output=True, text=True, timeout=None)
+    if completed.returncode != 0:
+        raise RuntimeError("git clone 失败：%s" % completed.stderr[-800:])
+    return {"method": "git-clone", "url": url, "command": command}
+
+
+def read_config(local_dir):
+    path = os.path.join(local_dir, "config.json")
+    try:
+        with open(path, "r", encoding="utf-8") as handle:
+            config = json.load(handle)
+        return {
+            key: config.get(key)
+            for key in (
+                "model_type",
+                "architectures",
+                "num_hidden_layers",
+                "hidden_size",
+                "intermediate_size",
+                "num_attention_heads",
+                "num_key_value_heads",
+                "vocab_size",
+                "torch_dtype",
+                "max_position_embeddings",
+                "tie_word_embeddings",
+            )
+            if key in config
+        }
+    except Exception as error:
+        return {"error": "%s: %s" % (type(error).__name__, error)}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model-id", required=True)
+    parser.add_argument("--revision", default="master")
+    parser.add_argument("--local-dir", required=True)
+    parser.add_argument("--out", default="")
+    parser.add_argument("--require-org", default="Qwen")
+    parser.add_argument("--min-free-gib", type=float, default=30.0)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--no-hash-safetensors", action="store_true")
+    parser.add_argument("--skip-existing", action="store_true")
+    args = parser.parse_args(argv)
+
+    result = {
+        "schema": "pypto-x.a2-vllm-ascend.model-download.v1",
+        "started_at": now_iso(),
+        "model_id": args.model_id,
+        "revision_requested": args.revision,
+        "local_dir": args.local_dir,
+        "require_org": args.require_org,
+    }
+
+    org = args.model_id.split("/", 1)[0] if "/" in args.model_id else ""
+    result["publisher"] = org
+    if args.require_org and org != args.require_org:
+        result["status"] = "REFUSED"
+        result["reason"] = "发布者 %r != 要求的官方发布者 %r" % (org, args.require_org)
+        _emit(result, args.out)
+        return 2
+
+    if args.skip_existing and os.path.isfile(os.path.join(args.local_dir, "config.json")):
+        files, total = dir_size_and_files(args.local_dir)
+        result.update(
+            {
+                "status": "SKIPPED_EXISTING",
+                "files": files,
+                "total_bytes": total,
+                "config_subset": read_config(args.local_dir),
+            }
+        )
+        _emit(result, args.out)
+        return 0
+
+    parent = os.path.dirname(os.path.abspath(args.local_dir)) or "."
+    os.makedirs(parent, exist_ok=True)
+    usage = shutil.disk_usage(parent)
+    free_gib = usage.free / (1024.0 ** 3)
+    result["disk_free_gib_before"] = free_gib
+    if free_gib < args.min_free_gib:
+        result["status"] = "REFUSED"
+        result["reason"] = "剩余磁盘 %.2f GiB < min-free-gib %.2f" % (
+            free_gib,
+            args.min_free_gib,
+        )
+        _emit(result, args.out)
+        return 3
+
+    result["revision_resolution"] = resolve_revision(args.model_id)
+
+    if args.dry_run:
+        result["status"] = "DRY_RUN"
+        result["plan"] = {
+            "attempts": [
+                "modelscope.snapshot_download(model_id, revision, local_dir)",
+                "python -m modelscope download --model ... --local_dir ...",
+                "git clone https://www.modelscope.cn/<model_id>.git",
+            ],
+            "min_free_gib": args.min_free_gib,
+        }
+        _emit(result, args.out)
+        return 0
+
+    attempts = []
+    started = time.perf_counter()
+    method = None
+    for name, function in (
+        ("modelscope_python", download_with_modelscope_python),
+        ("modelscope_cli", download_with_modelscope_cli),
+        ("git_clone", download_with_git),
+    ):
+        try:
+            info = function(args.model_id, args.revision, args.local_dir)
+            method = name
+            result["download"] = info
+            break
+        except Exception as error:
+            attempts.append({"method": name, "error": "%s: %s" % (type(error).__name__, error)})
+    elapsed = time.perf_counter() - started
+    result["attempts"] = attempts
+    if method is None:
+        result["status"] = "FAILED"
+        result["elapsed_seconds"] = elapsed
+        _emit(result, args.out)
+        return 1
+
+    result["method"] = method
+    result["elapsed_seconds"] = elapsed
+
+    files, total = dir_size_and_files(args.local_dir)
+    result["files"] = files
+    result["total_bytes"] = total
+    result["rate_mib_per_second"] = (total / (1024.0 ** 2) / elapsed) if elapsed > 0 else None
+    result["config_subset"] = read_config(args.local_dir)
+
+    if not args.no_hash_safetensors:
+        hashes = []
+        for item in files:
+            if not item["path"].endswith(".safetensors"):
+                continue
+            path = os.path.join(args.local_dir, item["path"])
+            hashes.append(
+                {
+                    "path": item["path"],
+                    "bytes": item["bytes"],
+                    "sha256": sha256_file(path),
+                }
+            )
+        result["safetensors_sha256"] = hashes
+
+    # 最小完整性判定：config.json + 至少一个 safetensors。
+    has_config = any(item["path"] == "config.json" for item in files)
+    has_weights = any(item["path"].endswith(".safetensors") for item in files)
+    result["status"] = "PASS" if (has_config and has_weights) else "PARTIAL"
+    result["finished_at"] = now_iso()
+    _emit(result, args.out)
+    return 0 if result["status"] == "PASS" else 1
+
+
+def _emit(result, out_path):
+    text = json.dumps(result, ensure_ascii=False, indent=2)
+    if out_path:
+        os.makedirs(os.path.dirname(os.path.abspath(out_path)), exist_ok=True)
+        with open(out_path, "w", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+    print(text)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
