+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: vllm-ascend 在线（serving）profiling harness（版本自适应）。
+
+固定请求模式：`vllm serve` 起服务 → warmup ≥5 → `POST /start_profile` →
+同一组 prompt × N 次、并发=1、流式采样 TTFT/ITL/TPOT → `POST /stop_profile`。
+
+版本自适应：
+* `config`：server 加 `--profiler-config.profiler=torch
+  --profiler-config.torch_profiler_dir=<abs>`（vLLM 0.18+ / vllm-ascend 0.23+）；
+* `env`：server 进程环境 `VLLM_TORCH_PROFILER_DIR=<abs>`（vLLM <=0.11.x）；
+* `auto`：先探测，404（路由未注册）/启动参数不识别时自动回退另一条路径。
+
+用法（A2 容器内，先 source CANN/ATB set_env.sh）::
+
+    python profiling_online.py \
+        --model-dir /root/models/Qwen3.5-0.8B \
+        --out online_08b.json \
+        --profiler-root /root/a2_vllm_qwen35/profiling/traces \
+        --tag online_08b --warmup 5 --repeats 3 --max-tokens 16 \
+        --enforce-eager
+
+约束：不写凭据/端点；结束时保证 server 进程组被回收（本地 127.0.0.1）。
+"""
+
+import argparse
+import json
+import os
+import signal
+import socket
+import statistics
+import subprocess
+import sys
+import time
+import urllib.error
+import urllib.request
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+from profiler_api import alternative_mode, detect_profiler_api  # noqa: E402
+from prompts import build_workload  # noqa: E402
+
+
+def now_iso():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def percentile(values, q):
+    ordered = sorted(values)
+    if not ordered:
+        return None
+    if len(ordered) == 1:
+        return float(ordered[0])
+    position = (len(ordered) - 1) * q
+    lower = int(position)
+    upper = min(lower + 1, len(ordered) - 1)
+    fraction = position - lower
+    return float(ordered[lower] * (1 - fraction) + ordered[upper] * fraction)
+
+
+class ServerStartError(RuntimeError):
+    pass
+
+
+class ProfileEndpointMissing(RuntimeError):
+    pass
+
+
+def http_request(method, url, payload=None, timeout=60):
+    data = None
+    headers = {}
+    if payload is not None:
+        data = json.dumps(payload).encode("utf-8")
+        headers["Content-Type"] = "application/json"
+    request = urllib.request.Request(url, data=data, headers=headers, method=method)
+    with urllib.request.urlopen(request, timeout=timeout) as response:
+        body = response.read().decode("utf-8", "replace")
+        return response.status, body
+
+
+def pick_port(preferred):
+    for offset in range(0, 50):
+        port = preferred + offset
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+            try:
+                sock.bind(("127.0.0.1", port))
+            except OSError:
+                continue
+            return port
+    raise RuntimeError("找不到可用本地端口（从 %s 起尝试 50 个）" % preferred)
+
+
+def build_server_command(args, mode):
+    command = [
+        sys.executable,
+        "-m",
+        "vllm.entrypoints.openai.api_server",
+        "--model",
+        args.model_dir,
+        "--served-model-name",
+        args.served_model_name,
+        "--host",
+        "127.0.0.1",
+        "--port",
+        str(args.port),
+        "--max-model-len",
+        str(args.max_model_len),
+        "--gpu-memory-utilization",
+        str(args.gpu_memory_utilization),
+    ]
+    if args.enforce_eager:
+        command.append("--enforce-eager")
+    if args.trust_remote_code:
+        command.append("--trust-remote-code")
+    if mode == "config":
+        command += [
+            "--profiler-config.profiler=torch",
+            "--profiler-config.torch_profiler_dir=" + args.profiler_dir_abs,
+        ]
+    return command
+
+
+def start_server(args, mode, log_path):
+    env = os.environ.copy()
+    if mode == "env":
+        env["VLLM_TORCH_PROFILER_DIR"] = args.profiler_dir_abs
+    else:
+        env.pop("VLLM_TORCH_PROFILER_DIR", None)
+    command = build_server_command(args, mode)
+    log_handle = open(log_path, "ab")
+    process = subprocess.Popen(
+        command,
+        stdout=log_handle,
+        stderr=subprocess.STDOUT,
+        env=env,
+        start_new_session=True,
+    )
+    return process, command, log_handle
+
+
+def tail_file(path, lines=60):
+    try:
+        with open(path, "r", encoding="utf-8", errors="replace") as handle:
+            content = handle.readlines()
+        return "".join(content[-lines:])
+    except Exception:
+        return ""
+
+
+def wait_ready(args, process, base_url, log_path):
+    deadline = time.time() + args.startup_timeout
+    while time.time() < deadline:
+        if process.poll() is not None:
+            raise ServerStartError(
+                "server 在就绪前退出（code=%s）。日志尾部：\n%s"
+                % (process.returncode, tail_file(log_path))
+            )
+        try:
+            status, _body = http_request("GET", base_url + "/health", timeout=5)
+            if status == 200:
+                return
+        except Exception:
+            pass
+        time.sleep(2)
+    raise ServerStartError(
+        "server 在 %ss 内未就绪。日志尾部：\n%s" % (args.startup_timeout, tail_file(log_path))
+    )
+
+
+def stop_server(process, log_handle):
+    try:
+        if process.poll() is None:
+            try:
+                os.killpg(os.getpgid(process.pid), signal.SIGTERM)
+            except ProcessLookupError:
+                pass
+            try:
+                process.wait(timeout=90)
+            except subprocess.TimeoutExpired:
+                try:
+                    os.killpg(os.getpgid(process.pid), signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                try:
+                    process.wait(timeout=30)
+                except subprocess.TimeoutExpired:
+                    pass
+    finally:
+        try:
+            log_handle.close()
+        except Exception:
+            pass
+
+
+def load_client_tokenizer(args):
+    try:
+        from transformers import AutoTokenizer
+
+        return AutoTokenizer.from_pretrained(
+            args.model_dir, trust_remote_code=bool(args.trust_remote_code)
+        )
+    except Exception as error:
+        # 回退：直接使用 tokenizer.json 构造 fast tokenizer（chat template 从
+        # tokenizer_config.json 读取，二者都在模型目录里）。
+        try:
+            from transformers import PreTrainedTokenizerFast
+
+            return PreTrainedTokenizerFast(
+                tokenizer_file=os.path.join(args.model_dir, "tokenizer.json")
+            )
+        except Exception:
+            raise RuntimeError(
+                "无法加载客户端 tokenizer（AutoTokenizer 与 tokenizer.json 均失败）："
+                "%s: %s" % (type(error).__name__, error)
+            )
+
+
+def build_requests(args, tokenizer):
+    """返回 (items, request_texts)；含 token 数记录，合成序列按固定长度 encode。"""
+    items = build_workload(tokenizer)
+    requests = []
+    for item in items:
+        if item["kind"] == "synthetic":
+            ids = list(item["token_ids"])
+            text = tokenizer.decode(ids, skip_special_tokens=False)
+            actual = len(tokenizer.encode(text, add_special_tokens=False))
+            requests.append({"item": item, "text": text, "actual_prompt_tokens": actual})
+        else:
+            requests.append(
+                {
+                    "item": item,
+                    "text": item["text"],
+                    "actual_prompt_tokens": item.get("target_tokens"),
+                }
+            )
+    return requests
+
+
+def stream_request(args, base_url, text, include_usage=True):
+    """发一次流式 completion；返回 TTFT/ITL/TPOT/总时长样本（失败返回 error 字段）。"""
+    payload = {
+        "model": args.served_model_name,
+        "prompt": text,
+        "max_tokens": args.max_tokens,
+        "min_tokens": args.max_tokens,
+        "temperature": 0.0,
+        "top_p": 1.0,
+        "stream": True,
+        "ignore_eos": True,
+    }
+    if include_usage:
+        payload["stream_options"] = {"include_usage": True}
+    data = json.dumps(payload).encode("utf-8")
+    request = urllib.request.Request(
+        base_url + "/v1/completions",
+        data=data,
+        headers={"Content-Type": "application/json"},
+        method="POST",
+    )
+
+    started = time.perf_counter()
+    content_times = []
+    usage = None
+    finish_reason = None
+    char_count = 0
+    try:
+        with urllib.request.urlopen(request, timeout=args.request_timeout) as response:
+            for raw_line in response:
+                line = raw_line.decode("utf-8", "replace").strip()
+                if not line.startswith("data:"):
+                    continue
+                chunk = line[5:].strip()
+                if chunk == "[DONE]":
+                    break
+                try:
+                    obj = json.loads(chunk)
+                except ValueError:
+                    continue
+                if obj.get("error"):
+                    return {
+                        "error": "server_sse_error",
+                        "server_error": str(obj.get("error"))[:500],
+                    }
+                if obj.get("usage"):
+                    usage = obj["usage"]
+                choices = obj.get("choices") or []
+                if not choices:
+                    continue
+                choice = choices[0]
+                piece = choice.get("text")
+                if piece is None:
+                    delta = choice.get("delta") or {}
+                    piece = delta.get("content") or delta.get("reasoning_content") or ""
+                if choice.get("finish_reason"):
+                    finish_reason = choice["finish_reason"]
+                if piece:
+                    content_times.append(time.perf_counter())
+                    char_count += len(piece)
+    except urllib.error.HTTPError as error:
+        body = ""
+        try:
+            body = error.read().decode("utf-8", "replace")[:800]
+        except Exception:
+            pass
+        if include_usage and error.code in (400, 422):
+            return stream_request(args, base_url, text, include_usage=False)
+        return {
+            "error": "HTTP %s" % error.code,
+            "http_body": body,
+        }
+    except Exception as error:
+        return {"error": "%s: %s" % (type(error).__name__, error)}
+
+    finished = time.perf_counter()
+    completion_tokens = None
+    if isinstance(usage, dict):
+        completion_tokens = usage.get("completion_tokens")
+    if completion_tokens is None:
+        completion_tokens = len(content_times)
+    itls = [
+        content_times[index] - content_times[index - 1]
+        for index in range(1, len(content_times))
+    ]
+    return {
+        "ttft_seconds": (content_times[0] - started) if content_times else None,
+        "total_seconds": finished - started,
+        "completion_tokens": completion_tokens,
+        "content_chunks": len(content_times),
+        "char_count": char_count,
+        "itl_seconds": itls,
+        "itl_mean_seconds": statistics.fmean(itls) if itls else None,
+        "itl_median_seconds": statistics.median(itls) if itls else None,
+        "itl_p95_seconds": percentile(itls, 0.95),
+        "tpot_seconds": ((finished - started) / completion_tokens)
+        if completion_tokens
+        else None,
+        "finish_reason": finish_reason,
+        "usage": usage,
+    }
+
+
+def aggregate_samples(samples):
+    ttfts = [sample["ttft_seconds"] for sample in samples if sample.get("ttft_seconds")]
+    tpots = [sample["tpot_seconds"] for sample in samples if sample.get("tpot_seconds")]
+    totals = [sample["total_seconds"] for sample in samples if sample.get("total_seconds")]
+    return {
+        "samples": len(samples),
+        "ttft_mean_seconds": statistics.fmean(ttfts) if ttfts else None,
+        "ttft_median_seconds": statistics.median(ttfts) if ttfts else None,
+        "ttft_p95_seconds": percentile(ttfts, 0.95),
+        "tpot_mean_seconds": statistics.fmean(tpots) if tpots else None,
+        "tpot_median_seconds": statistics.median(tpots) if tpots else None,
+        "tpot_p95_seconds": percentile(tpots, 0.95),
+        "total_median_seconds": statistics.median(totals) if totals else None,
+        "completion_tokens": samples[0].get("completion_tokens") if samples else None,
+    }
+
+
+def measure(args, base_url, requests, repeats):
+    results = {}
+    for entry in requests:
+        item = entry["item"]
+        samples = []
+        for repeat in range(max(1, repeats)):
+            sample = stream_request(args, base_url, entry["text"])
+            sample["repeat"] = repeat
+            sample["id"] = item["id"]
+            sample["kind"] = item["kind"]
+            sample["target_tokens"] = item["target_tokens"]
+            sample["actual_prompt_tokens"] = entry["actual_prompt_tokens"]
+            samples.append(sample)
+        results[item["id"]] = dict(
+            {"request_kind": item["kind"], "target_tokens": item["target_tokens"],
+             "actual_prompt_tokens": entry["actual_prompt_tokens"]},
+            **aggregate_samples(samples),
+        )
+        results[item["id"]]["samples"] = samples
+    return results
+
+
+def run_phase(args, mode, phase, requests):
+    """起一个 server 跑一个 phase；phase in {baseline, profile}。"""
+    args.port = pick_port(args.port)
+    base_url = "http://127.0.0.1:%d" % args.port
+    log_path = os.path.join(
+        args.workdir, "logs", "%s_%s_%d.log" % (args.tag, phase, args.port)
+    )
+    os.makedirs(os.path.dirname(log_path), exist_ok=True)
+    if mode == "env":
+        args.profiler_dir_abs = os.path.join(args.profiler_root, args.tag)
+    elif mode == "config":
+        args.profiler_dir_abs = os.path.join(args.profiler_root, args.tag)
+    os.makedirs(args.profiler_dir_abs, exist_ok=True)
+
+    process, command, log_handle = start_server(args, mode, log_path)
+    try:
+        wait_ready(args, process, base_url, log_path)
+        warmup_samples = []
+        for index in range(max(0, args.warmup)):
+            sample = stream_request(args, base_url, requests[0]["text"])
+            sample["index"] = index
+            warmup_samples.append(sample)
+        phase_result = {
+            "mode": mode,
+            "server_command": command,
+            "server_log": log_path,
+            "port": args.port,
+            "profiler_dir": args.profiler_dir_abs,
+            "warmup": {
+                "count": len(warmup_samples),
+                "samples": warmup_samples,
+                "aggregate": aggregate_samples(warmup_samples),
+            },
+        }
+        if phase == "profile":
+            status, body = _post_endpoint(
+                base_url + "/start_profile", args.request_timeout
+            )
+            if status == 404:
+                raise ProfileEndpointMissing(
+                    "/start_profile 返回 404（server 未注册 profiling 路由）；"
+                    "response=%s" % body[:200]
+                )
+            if status != 200:
+                raise RuntimeError("/start_profile 失败: HTTP %s %s" % (status, body[:200]))
+            phase_result["start_profile"] = "HTTP 200"
+        phase_result["items"] = measure(args, base_url, requests, args.repeats)
+        if phase == "profile":
+            status, body = _post_endpoint(
+                base_url + "/stop_profile", args.request_timeout
+            )
+            phase_result["stop_profile"] = "HTTP %s" % status
+            if status != 200:
+                phase_result["stop_profile_error"] = body[:400]
+        return phase_result
+    finally:
+        stop_server(process, log_handle)
+
+
+def _post_endpoint(url, timeout):
+    request = urllib.request.Request(url, data=b"", method="POST")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            return response.status, response.read().decode("utf-8", "replace")
+    except urllib.error.HTTPError as error:
+        return error.code, error.read().decode("utf-8", "replace")
+
+
+def run(args):
+    result = {
+        "schema": "pypto-x.a2-vllm-ascend.profiling.online.v1",
+        "started_at": now_iso(),
+        "model_dir": args.model_dir,
+        "served_model_name": args.served_model_name,
+        "model_tag": args.tag,
+        "max_model_len": args.max_model_len,
+        "gpu_memory_utilization": args.gpu_memory_utilization,
+        "enforce_eager": bool(args.enforce_eager),
+        "max_tokens": args.max_tokens,
+        "warmup_requested": args.warmup,
+        "repeats": args.repeats,
+        "profiler_api_requested": args.profiler_api,
+        "concurrency": 1,
+    }
+    detected, notes = detect_profiler_api()
+    result["api_detected"] = detected
+    result["api_notes"] = notes
+
+    tokenizer = load_client_tokenizer(args)
+    requests = build_requests(args, tokenizer)
+    result["workload"] = [
+        {
+            "id": entry["item"]["id"],
+            "kind": entry["item"]["kind"],
+            "target_tokens": entry["item"]["target_tokens"],
+            "actual_prompt_tokens": entry["actual_prompt_tokens"],
+        }
+        for entry in requests
+    ]
+
+    if not args.skip_baseline:
+        args.profiler_dir_abs = os.path.join(args.profiler_root, args.tag + "_baseline")
+        result["baseline"] = run_phase(args, "none", "baseline", requests)
+
+    if not args.skip_profile:
+        preferred = args.profiler_api if args.profiler_api in ("config", "env") else detected
+        if preferred in ("config", "env"):
+            candidates = [preferred]
+        else:
+            candidates = ["config", "env"]
+        fallback = alternative_mode(preferred)
+        if args.profiler_api == "auto" and fallback:
+            candidates.append(fallback)
+        attempts = []
+        profiled = None
+        for mode in candidates:
+            try:
+                profiled = run_phase(args, mode, "profile", requests)
+                break
+            except (ProfileEndpointMissing, ServerStartError) as error:
+                attempts.append({"mode": mode, "error": "%s: %s" % (type(error).__name__, error)})
+                continue
+            except Exception as error:
+                attempts.append({"mode": mode, "error": "%s: %s" % (type(error).__name__, error)})
+                break
+        if profiled is None:
+            result["profiled"] = {"status": "FAILED", "attempts": attempts}
+        else:
+            result["profiled"] = profiled
+            result["profiled"]["attempts"] = attempts
+            result["profiled"]["status"] = "OK"
+
+    result["trace_inventory"] = _inventory(args.profiler_root)
+    result["finished_at"] = now_iso()
+    return result
+
+
+def _inventory(directory):
+    import hashlib
+
+    items = []
+    if not directory or not os.path.isdir(directory):
+        return items
+    for root, _dirs, files in os.walk(directory):
+        for name in sorted(files):
+            path = os.path.join(root, name)
+            try:
+                size = os.path.getsize(path)
+            except OSError:
+                continue
+            entry = {"path": path, "bytes": size}
+            if size <= 256 * 1024 * 1024:
+                digest = hashlib.sha256()
+                with open(path, "rb") as handle:
+                    while True:
+                        block = handle.read(1 << 22)
+                        if not block:
+                            break
+                        digest.update(block)
+                entry["sha256"] = digest.hexdigest()
+            else:
+                entry["sha256"] = None
+                entry["sha256_skipped"] = True
+            items.append(entry)
+    return items
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model-dir", required=True)
+    parser.add_argument("--out", default="")
+    parser.add_argument("--tag", default="online_model")
+    parser.add_argument("--served-model-name", default="qwen35-under-test")
+    parser.add_argument("--workdir", default="/root/a2_vllm_qwen35/profiling")
+    parser.add_argument("--profiler-root", default="/root/a2_vllm_qwen35/profiling/traces")
+    parser.add_argument("--profiler-api", default="auto", choices=("auto", "config", "env"))
+    parser.add_argument("--port", type=int, default=18080)
+    parser.add_argument("--max-model-len", type=int, default=512)
+    parser.add_argument("--gpu-memory-utilization", type=float, default=0.6)
+    parser.add_argument("--max-tokens", type=int, default=16)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--repeats", type=int, default=3)
+    parser.add_argument("--request-timeout", type=float, default=600.0)
+    parser.add_argument("--startup-timeout", type=float, default=1200.0)
+    parser.add_argument("--enforce-eager", action="store_true")
+    parser.add_argument("--trust-remote-code", action="store_true")
+    parser.add_argument("--skip-baseline", action="store_true")
+    parser.add_argument("--skip-profile", action="store_true")
+    args = parser.parse_args(argv)
+    if not os.path.isdir(args.model_dir):
+        raise SystemExit("模型目录不存在: %s" % args.model_dir)
+    os.makedirs(os.path.join(args.workdir, "logs"), exist_ok=True)
+    os.makedirs(args.profiler_root, exist_ok=True)
+    return args
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    result = run(args)
+    text = json.dumps(result, ensure_ascii=False, indent=2)
+    if args.out:
+        os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+        with open(args.out, "w", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
