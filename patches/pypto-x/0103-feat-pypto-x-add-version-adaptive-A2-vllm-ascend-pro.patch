new file mode 100644
index 000000000..1ee5cff0d
--- /dev/null
+++ b/tools/a2_vllm_ascend_profiling/prompts.py
@@ -0,0 +1,132 @@
+# -*- coding: utf-8 -*-
+"""W8I: Qwen3.5 vllm-ascend profiling 的固定工作负载定义。
+
+本模块只定义 prompt / 合成序列，不导入 vllm/torch，便于本地静态检查。
+
+冻结 prompt 与 gold harness
+(``qwen35-bf16-reference`` -> ``tools/qwen35_reference/run_reference.py``)
+以及 W8H ``tools/a2_vllm_ascend/prompts.py`` 逐字段一致：
+
+1. ``en_continuation``  raw text T=5
+2. ``zh_continuation``  raw text T=8
+3. ``chat_zh_user``     官方 chat template T=18
+
+另外定义一组"固定长度合成序列"：16 / 64 / 128 / 256 token，用于把
+profiling 的 shape 维度（prompt 长度）固定下来。合成序列由固定 seed 文本
+tokenize 后按 token 复制/截断得到，token 数目标在证据里（实际 encode 长度）。
+"""
+
+PROMPTS = (
+    {
+        "id": "en_continuation",
+        "kind": "raw_text",
+        "text": "The capital of France is",
+    },
+    {
+        "id": "zh_continuation",
+        "kind": "raw_text",
+        "text": "请用一句话解释什么是张量并行。",
+    },
+    {
+        "id": "chat_zh_user",
+        "kind": "chat_template",
+        "messages": ({"role": "user", "content": "你好，请介绍一下你自己。"},),
+        "add_generation_prompt": True,
+        "enable_thinking": False,
+    },
+)
+
+# gold / W8H 冻结的前 4 个 greedy decode token（可选 sanity 对照，不要求对齐）。
+EXPECTED_DECODE_IDS = {
+    "en_continuation": [11751, 13, 198, 760],
+    "zh_continuation": [271, 248068, 271, 248069],
+    "chat_zh_user": [109266, 6115, 103724, 1167],
+}
+
+# 固定长度合成序列（token 数）。
+SYNTHETIC_LENGTHS = (16, 64, 128, 256)
+
+# 合成序列使用的固定 seed 文本（不使用上游 tokenizer 时也能复现同一串）。
+SYNTHETIC_SEED_TEXT = "The quick brown fox jumps over the lazy dog. "
+
+
+def render_prompt(tokenizer, spec):
+    """把 prompt 规格渲染为字符串（与 gold 口径一致）。"""
+    kind = spec.get("kind", "raw_text")
+    if kind == "chat_template":
+        kwargs = {
+            "tokenize": False,
+            "add_generation_prompt": spec.get("add_generation_prompt", True),
+        }
+        try:
+            return tokenizer.apply_chat_template(
+                spec["messages"],
+                enable_thinking=spec.get("enable_thinking", False),
+                **kwargs,
+            )
+        except TypeError:
+            # 旧 tokenizer 模板可能没有 enable_thinking 变量：退化为不带该参数。
+            return tokenizer.apply_chat_template(spec["messages"], **kwargs)
+    return spec["text"]
+
+
+def build_synthetic_token_ids(tokenizer, target_length, seed_text=SYNTHETIC_SEED_TEXT):
+    """用固定 seed 文本生成恰好 target_length 个 token id 的合成序列。"""
+    if target_length <= 0:
+        raise ValueError("target_length 必须为正")
+    seed_ids = tokenizer.encode(seed_text, add_special_tokens=False)
+    if not seed_ids:
+        raise RuntimeError("seed 文本 tokenize 为空，无法构造合成序列")
+    repeats = (target_length + len(seed_ids) - 1) // len(seed_ids)
+    ids = (seed_ids * repeats)[:target_length]
+    return [int(token) for token in ids]
+
+
+def build_workload(tokenizer=None):
+    """返回固定 workload 列表（frozen prompts + synthetic lengths）。
+
+    每项::
+
+        {"id": str, "kind": "frozen"|"synthetic", "text": str|None,
+         "token_ids": list[int]|None, "target_tokens": int}
+    """
+    items = []
+    for spec in PROMPTS:
+        if tokenizer is None:
+            text = spec.get("text") or "<chat_template>"
+            token_ids = None
+        else:
+            text = render_prompt(tokenizer, spec)
+            token_ids = [int(t) for t in tokenizer.encode(text, add_special_tokens=False)]
+        items.append(
+            {
+                "id": spec["id"],
+                "kind": "frozen",
+                "text": text,
+                "token_ids": token_ids,
+                "target_tokens": len(token_ids) if token_ids else None,
+            }
+        )
+    for length in SYNTHETIC_LENGTHS:
+        if tokenizer is None:
+            items.append(
+                {
+                    "id": "synthetic_%d" % length,
+                    "kind": "synthetic",
+                    "text": None,
+                    "token_ids": None,
+                    "target_tokens": length,
+                }
+            )
+        else:
+            ids = build_synthetic_token_ids(tokenizer, length)
+            items.append(
+                {
+                    "id": "synthetic_%d" % length,
+                    "kind": "synthetic",
+                    "text": None,
+                    "token_ids": ids,
+                    "target_tokens": len(ids),
+                }
+            )
+    return items
diff --git a/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh b/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
