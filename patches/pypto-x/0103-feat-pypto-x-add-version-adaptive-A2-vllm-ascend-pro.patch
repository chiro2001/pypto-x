@@ -0,0 +1,458 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: vllm-ascend 离线 profiling harness（版本自适应）。
+
+用法（在 A2 容器内，先 source CANN/ATB set_env.sh）::
+
+    python profiling_offline.py \
+        --model-dir /root/models/Qwen3.5-0.8B \
+        --out /root/a2_vllm_qwen35/profiling/offline_08b_baseline.json \
+        --profiler-root /root/a2_vllm_qwen35/profiling/traces \
+        --tag offline_08b --warmup 5 --repeats 3 --max-tokens 16 \
+        --profiler-api auto --enforce-eager
+
+行为：
+
+1. 版本自适应开启 profiler：
+   * `config`：`vllm.config.ProfilerConfig(profiler="torch", torch_profiler_dir=...)`
+     传给 `LLM(...)`（vLLM 0.18+ / vllm-ascend 0.23+ 路径）；
+   * `env`：设置 `VLLM_TORCH_PROFILER_DIR` 后构造 LLM（vLLM <=0.11.x 路径）；
+   * `auto`：先探测 `ProfilerConfig`，再探测 `vllm.envs.VLLM_TORCH_PROFILER_DIR`；
+     构造失败（TypeError/ValueError）时回退到另一条路径，两条都不行则显式报错。
+2. warmup >=5（默认 5）；baseline 采样 `repeats` 次/工作负载；
+3. 在一个 `start_profile()/stop_profile()` 区间内跑固定工作负载（frozen prompt + 合成序列）；
+4. 落盘 JSON：命令、api 模式、每项耗时样本、trace 目录清单（大 trace 不回传）；
+5. `--sanity` 只做最小推理 sanity check（大模型下载后使用）。
+
+本脚本不写端点/凭据；不下载模型。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import statistics
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+from prompts import build_workload  # noqa: E402
+from profiler_api import detect_profiler_api  # noqa: E402
+
+DEFAULT_MODEL_TAG = "model"
+MAX_HASH_BYTES = 256 * 1024 * 1024
+
+
+def now_iso():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def percentile(values, q):
+    ordered = sorted(values)
+    if not ordered:
+        return None
+    if len(ordered) == 1:
+        return float(ordered[0])
+    position = (len(ordered) - 1) * q
+    lower = int(position)
+    upper = min(lower + 1, len(ordered) - 1)
+    fraction = position - lower
+    return float(ordered[lower] * (1 - fraction) + ordered[upper] * fraction)
+
+
+def sha256_file(path, chunk_size=1 << 22):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def inventory(directory, hash_limit=MAX_HASH_BYTES):
+    """列出 profiler 产物（不递归复制；大文件只记字节数）。"""
+    items = []
+    if not directory or not os.path.isdir(directory):
+        return items
+    for root, _dirs, files in os.walk(directory):
+        for name in sorted(files):
+            path = os.path.join(root, name)
+            try:
+                size = os.path.getsize(path)
+            except OSError:
+                continue
+            entry = {
+                "path": path,
+                "bytes": size,
+                "sha256": sha256_file(path) if size <= hash_limit else None,
+                "sha256_skipped": size > hash_limit,
+            }
+            items.append(entry)
+    return items
+
+
+def build_llm(args, mode, profiler_dir):
+    """按 mode 构造 LLM；mode in {config, env, none}。"""
+    from vllm import LLM
+
+    if mode == "env":
+        os.environ["VLLM_TORCH_PROFILER_DIR"] = profiler_dir
+    elif mode == "config":
+        os.environ.pop("VLLM_TORCH_PROFILER_DIR", None)
+
+    kwargs = {
+        "model": args.model_dir,
+        "trust_remote_code": bool(args.trust_remote_code),
+        "max_model_len": args.max_model_len,
+        "gpu_memory_utilization": args.gpu_memory_utilization,
+        "enforce_eager": bool(args.enforce_eager),
+    }
+    if args.dtype:
+        kwargs["dtype"] = args.dtype
+    if mode == "config":
+        from vllm.config import ProfilerConfig
+
+        config_kwargs = {"profiler": "torch", "torch_profiler_dir": profiler_dir}
+        try:
+            kwargs["profiler_config"] = ProfilerConfig(**config_kwargs)
+        except Exception:
+            kwargs["profiler_config"] = config_kwargs
+    llm = LLM(**kwargs)
+    return llm, kwargs
+
+
+def make_sampling_params(args, with_logprobs=True):
+    from vllm import SamplingParams
+
+    kwargs = {
+        "temperature": 0.0,
+        "top_p": 1.0,
+        "max_tokens": args.max_tokens,
+    }
+    if with_logprobs:
+        kwargs["logprobs"] = args.topk
+        kwargs["prompt_logprobs"] = args.topk
+    try:
+        return SamplingParams(**kwargs)
+    except Exception:
+        if with_logprobs:
+            return make_sampling_params(args, with_logprobs=False)
+        raise
+
+
+def request_for_item(item, tokenizer, prefer_token_ids=True):
+    """构造 vLLM generate 的 prompt 入参。
+
+    返回 (request, actual_prompt_tokens)。合成序列默认用 ``prompt_token_ids``
+    以保证长度精确；``prefer_token_ids=False`` 时改为 decode 回文本再 encode，
+    长度可能漂移，实际值如实记录。
+    """
+    if item["kind"] == "synthetic":
+        if prefer_token_ids or tokenizer is None:
+            return {"prompt_token_ids": list(item["token_ids"])}, len(item["token_ids"])
+        ids = list(item["token_ids"])
+        text = tokenizer.decode(ids, skip_special_tokens=False)
+        actual_ids = tokenizer.encode(text, add_special_tokens=False)
+        return text, len(actual_ids)
+    text = item["text"]
+    if tokenizer is not None and item.get("token_ids") is not None:
+        return text, len(item["token_ids"])
+    return text, None
+
+
+def run_generate(llm, prompts, params):
+    started = time.perf_counter()
+    outputs = llm.generate(prompts, params, use_tqdm=False)
+    wall = time.perf_counter() - started
+    return wall, outputs
+
+
+def summarize_outputs(outputs, wall):
+    generated = []
+    for output in outputs:
+        completion = output.outputs[0]
+        generated.append(
+            {
+                "generated_tokens": len(completion.token_ids),
+                "first_tokens": [int(t) for t in completion.token_ids[:8]],
+                "finished": getattr(completion, "finish_reason", None),
+            }
+        )
+    return {
+        "wall_seconds": wall,
+        "generated": generated,
+        "outputs": len(outputs),
+    }
+
+
+def run_sanity(args):
+    tokenizer = None
+    mode = "unknown"
+    api_notes = {}
+    llm_kwargs = {}
+    if args.profiler_api != "none":
+        mode, api_notes = detect_profiler_api()
+        if args.profiler_api not in ("auto",):
+            mode = args.profiler_api
+    llm, llm_kwargs = build_llm(args, "none", args.profiler_dir or "/tmp/unused_profiler_dir")
+    tokenizer = llm.get_tokenizer()
+    items = build_workload(tokenizer)
+    item = items[0]
+    params = make_sampling_params(args, with_logprobs=False)
+    request, actual_prompt_tokens = request_for_item(item, tokenizer)
+    wall, outputs = run_generate(llm, [request], params)
+    result = {
+        "schema": "pypto-x.a2-vllm-ascend.profiling.sanity.v1",
+        "captured_at": now_iso(),
+        "model_dir": args.model_dir,
+        "model_tag": args.tag,
+        "api_mode": mode,
+        "api_notes": api_notes,
+        "llm_kwargs": {k: v for k, v in llm_kwargs.items() if k != "profiler_config"},
+        "wall_seconds": wall,
+        "summary": summarize_outputs(outputs, wall),
+        "workload_item": {
+            "id": item["id"],
+            "target_tokens": item["target_tokens"],
+            "actual_prompt_tokens": actual_prompt_tokens,
+        },
+    }
+    return result
+
+
+def run_offline(args):
+    result = {
+        "schema": "pypto-x.a2-vllm-ascend.profiling.offline.v1",
+        "started_at": now_iso(),
+        "model_dir": args.model_dir,
+        "model_tag": args.tag,
+        "profiler_api_requested": args.profiler_api,
+        "max_model_len": args.max_model_len,
+        "gpu_memory_utilization": args.gpu_memory_utilization,
+        "enforce_eager": bool(args.enforce_eager),
+        "max_tokens": args.max_tokens,
+        "warmup_requested": args.warmup,
+        "repeats": args.repeats,
+        "prefer_token_ids": not args.text_only,
+    }
+
+    api_mode, api_notes = detect_profiler_api()
+    if args.profiler_api not in ("auto",):
+        api_mode = args.profiler_api
+    result["api_detected"] = api_mode
+    result["api_notes"] = api_notes
+
+    profiler_dir = os.path.join(args.profiler_root, args.tag)
+    os.makedirs(profiler_dir, exist_ok=True)
+    result["profiler_dir"] = os.path.abspath(profiler_dir)
+
+    errors = []
+    llm = None
+    llm_kwargs = {}
+    used_mode = None
+    candidates = []
+    if args.profiler_api == "auto":
+        candidates = [api_mode, "env" if api_mode != "env" else "config"]
+    elif args.profiler_api in ("config", "env"):
+        candidates = [args.profiler_api]
+    else:
+        candidates = ["none"]
+    candidates = [mode for mode in candidates if mode in ("config", "env", "none")]
+
+    for mode in candidates:
+        try:
+            llm, llm_kwargs = build_llm(args, mode, result["profiler_dir"])
+            used_mode = mode
+            break
+        except Exception as error:
+            errors.append({"mode": mode, "error": "%s: %s" % (type(error).__name__, error)})
+            if not isinstance(error, (TypeError, ValueError, AttributeError)):
+                raise
+    if llm is None:
+        raise RuntimeError(
+            "无法构造 LLM（已尝试 %s）：%s" % (candidates, errors)
+        )
+    result["api_used"] = used_mode
+    result["construction_errors"] = errors
+    result["llm_kwargs"] = {
+        key: value for key, value in llm_kwargs.items() if key != "profiler_config"
+    }
+    result["version_strings"] = probe_versions()
+
+    try:
+        tokenizer = llm.get_tokenizer()
+    except Exception as error:
+        tokenizer = None
+        result["tokenizer_error"] = str(error)
+
+    items = build_workload(tokenizer)
+    result["workload"] = [
+        {
+            "id": item["id"],
+            "kind": item["kind"],
+            "target_tokens": item["target_tokens"],
+            "actual_tokens": item.get("target_tokens"),
+        }
+        for item in items
+    ]
+
+    params = make_sampling_params(args, with_logprobs=True)
+    result["sampling_params"] = {
+        "temperature": 0.0,
+        "max_tokens": args.max_tokens,
+        "logprobs": args.topk,
+        "prompt_logprobs": args.topk,
+    }
+
+    # ---- warmup >= 5 ----
+    warmup_item = items[0]
+    warmup_request, warmup_prompt_tokens = request_for_item(warmup_item, tokenizer)
+    warmup_samples = []
+    for index in range(max(0, args.warmup)):
+        wall, outputs = run_generate(llm, [warmup_request], params)
+        warmup_samples.append(
+            {"index": index, "wall_seconds": wall, "generated_tokens": len(outputs[0].outputs[0].token_ids)}
+        )
+    result["warmup"] = {
+        "count": len(warmup_samples),
+        "item": warmup_item["id"],
+        "prompt_tokens": warmup_prompt_tokens,
+        "samples": warmup_samples,
+    }
+
+    # ---- baseline（不开 profiler）----
+    baseline = {}
+    if not args.skip_baseline:
+        for item in items:
+            request, actual_prompt_tokens = request_for_item(
+                item, tokenizer, prefer_token_ids=not args.text_only
+            )
+            samples = []
+            for repeat in range(max(1, args.repeats)):
+                wall, outputs = run_generate(llm, [request], params)
+                sample = summarize_outputs(outputs, wall)
+                sample["repeat"] = repeat
+                samples.append(sample)
+            walls = [sample["wall_seconds"] for sample in samples]
+            baseline[item["id"]] = {
+                "request_kind": item["kind"],
+                "target_tokens": item["target_tokens"],
+                "actual_prompt_tokens": actual_prompt_tokens,
+                "samples": samples,
+                "wall_seconds_mean": statistics.fmean(walls) if walls else None,
+                "wall_seconds_median": statistics.median(walls) if walls else None,
+                "wall_seconds_p95": percentile(walls, 0.95),
+                "generated_tokens": samples[0]["generated"][0]["generated_tokens"] if samples else None,
+            }
+        result["baseline"] = baseline
+
+    # ---- profiled run ----
+    if not args.skip_profile:
+        if not hasattr(llm, "start_profile") or not hasattr(llm, "stop_profile"):
+            raise RuntimeError(
+                "当前 vllm 没有 LLM.start_profile/stop_profile（api_mode=%s）；"
+                "请检查 vllm/vllm-ascend 版本或 --profiler-api" % used_mode
+            )
+        profile_items = []
+        llm.start_profile()
+        try:
+            for item in items:
+                request, actual_prompt_tokens = request_for_item(
+                item, tokenizer, prefer_token_ids=not args.text_only
+            )
+                wall, outputs = run_generate(llm, [request], params)
+                sample = summarize_outputs(outputs, wall)
+                sample["id"] = item["id"]
+                sample["kind"] = item["kind"]
+                sample["target_tokens"] = item["target_tokens"]
+                sample["actual_prompt_tokens"] = actual_prompt_tokens
+                profile_items.append(sample)
+        finally:
+            llm.stop_profile()
+        if hasattr(llm, "sleep"):
+            try:
+                llm.sleep(0)
+            except Exception:
+                pass
+        result["profile"] = {
+            "enabled": True,
+            "api_mode": used_mode,
+            "items": profile_items,
+        }
+    else:
+        result["profile"] = {"enabled": False}
+
+    result["trace_inventory"] = inventory(result["profiler_dir"])
+    result["finished_at"] = now_iso()
+    return result
+
+
+def probe_versions():
+    versions = {}
+    for name in ("torch", "torch_npu", "vllm", "vllm_ascend", "transformers"):
+        try:
+            module = __import__(name)
+            versions[name] = getattr(module, "__version__", "unknown")
+        except Exception as error:
+            versions[name] = "import_error: %s" % error
+    return versions
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model-dir", required=True)
+    parser.add_argument("--out", default="")
+    parser.add_argument("--tag", default=None)
+    parser.add_argument("--profiler-root", default="/root/a2_vllm_qwen35/profiling/traces")
+    parser.add_argument("--profiler-dir", default="")
+    parser.add_argument("--profiler-api", default="auto", choices=("auto", "config", "env", "none"))
+    parser.add_argument("--max-model-len", type=int, default=512)
+    parser.add_argument("--gpu-memory-utilization", type=float, default=0.6)
+    parser.add_argument("--enforce-eager", action="store_true")
+    parser.add_argument("--dtype", default="")
+    parser.add_argument("--trust-remote-code", action="store_true")
+    parser.add_argument("--max-tokens", type=int, default=16)
+    parser.add_argument("--topk", type=int, default=5)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--repeats", type=int, default=3)
+    parser.add_argument("--skip-baseline", action="store_true")
+    parser.add_argument("--skip-profile", action="store_true")
+    parser.add_argument("--sanity", action="store_true")
+    parser.add_argument(
+        "--text-only",
+        action="store_true",
+        help="合成序列也转成文本（默认用 prompt_token_ids）",
+    )
+    args = parser.parse_args(argv)
+    if args.tag is None:
+        args.tag = os.path.basename(os.path.normpath(args.model_dir)) or DEFAULT_MODEL_TAG
+    if args.profiler_dir:
+        args.profiler_root = os.path.dirname(args.profiler_dir) or "."
+        args.tag = os.path.basename(args.profiler_dir)
+    return args
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    if not os.path.isdir(args.model_dir):
+        raise SystemExit("模型目录不存在: %s" % args.model_dir)
+    if args.sanity:
+        result = run_sanity(args)
+    else:
+        result = run_offline(args)
+    text = json.dumps(result, ensure_ascii=False, indent=2)
+    if args.out:
+        os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+        with open(args.out, "w", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
