+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: A2(910B3) 环境指纹采集（脱敏）。
+
+输出 JSON（默认 stdout，可用 --out 落盘），内容：
+
+* python / platform / CPU / 内存；
+* torch、torch_npu、vllm、vllm_ascend、transformers、tokenizers、numpy、modelscope 版本；
+* `vllm --version`、`npu-smi info`、CANN toolkit/driver 版本文件；
+* torch.npu 设备名与数量；
+* **profiling 能力探测**：`vllm.config.ProfilerConfig` 是否存在、
+  `vllm.envs.VLLM_TORCH_PROFILER_DIR` 是否存在、`vllm_ascend.profiler`、
+  `torch_npu.profiler`、`msprof` 可执行文件；
+* 可选 `--model-dir` 的 config.json 摘要。
+
+脱敏：IPv4 一律替换为 <redacted-ip>；不写任何凭据、端点、端口。
+"""
+
+import argparse
+import glob
+import json
+import os
+import platform
+import re
+import shutil
+import subprocess
+import sys
+
+IP_PATTERN = re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}\b")
+
+
+def sanitize(text):
+    if text is None:
+        return None
+    return IP_PATTERN.sub("<redacted-ip>", str(text))
+
+
+def run(command, timeout=120):
+    try:
+        completed = subprocess.run(
+            command,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return {
+            "command": command,
+            "returncode": completed.returncode,
+            "stdout": sanitize(completed.stdout.strip()),
+            "stderr": sanitize(completed.stderr.strip()),
+        }
+    except Exception as error:  # pragma: no cover - 诊断路径
+        return {"command": command, "returncode": None, "error": sanitize(error)}
+
+
+def read_file(path, limit=60):
+    try:
+        with open(path, "r", encoding="utf-8", errors="replace") as handle:
+            lines = []
+            for _ in range(limit):
+                line = handle.readline()
+                if not line:
+                    break
+                lines.append(line.rstrip("\n"))
+        return sanitize("\n".join(lines))
+    except Exception:
+        return None
+
+
+def package_version(module_name, attr="__version__"):
+    try:
+        module = __import__(module_name)
+        return sanitize(getattr(module, attr, "unknown"))
+    except Exception as error:
+        return {"import_error": sanitize(error)}
+
+
+def probe_profiler_api():
+    """运行时探测 profiling API（版本自适应 harness 的依据）。"""
+    info = {}
+    try:
+        from vllm.config import ProfilerConfig  # noqa: F401
+
+        fields = getattr(ProfilerConfig, "model_fields", None)
+        if fields is None:
+            fields = getattr(ProfilerConfig, "__dataclass_fields__", {})
+        info["vllm_profiler_config_class"] = "vllm.config.ProfilerConfig"
+        info["vllm_profiler_config_fields"] = sorted(fields.keys())
+    except Exception as error:
+        info["vllm_profiler_config_class"] = None
+        info["vllm_profiler_config_error"] = sanitize(error)
+
+    try:
+        import vllm.envs as vllm_envs
+
+        value = getattr(vllm_envs, "VLLM_TORCH_PROFILER_DIR", None)
+        info["vllm_env_torch_profiler_dir_supported"] = value is not None
+        info["vllm_env_torch_profiler_dir_value_set"] = bool(value)
+    except Exception as error:
+        info["vllm_env_torch_profiler_dir_supported"] = None
+        info["vllm_env_error"] = sanitize(error)
+
+    try:
+        import importlib.util
+
+        spec = importlib.util.find_spec("vllm_ascend.profiler")
+        info["vllm_ascend_profiler_module"] = spec is not None
+        if spec is not None:
+            try:
+                from vllm_ascend.profiler import TorchNPUProfilerWrapper  # noqa: F401
+
+                info["vllm_ascend_torch_npu_profiler_wrapper"] = True
+            except Exception as error:
+                info["vllm_ascend_torch_npu_profiler_wrapper"] = False
+                info["vllm_ascend_profiler_error"] = sanitize(error)
+    except Exception as error:
+        info["vllm_ascend_profiler_module"] = None
+        info["vllm_ascend_profiler_error"] = sanitize(error)
+
+    try:
+        import torch_npu  # noqa: F401
+
+        profiler = getattr(torch_npu, "profiler", None)
+        info["torch_npu_profiler"] = profiler is not None
+        if profiler is not None:
+            info["torch_npu_profiler_attrs"] = sorted(
+                name
+                for name in (
+                    "profile",
+                    "ProfilerActivity",
+                    "ProfilerLevel",
+                    "ExportType",
+                    "AiCMetrics",
+                    "tensorboard_trace_handler",
+                    "_ExperimentalConfig",
+                )
+                if hasattr(profiler, name)
+            )
+    except Exception as error:
+        info["torch_npu_profiler"] = None
+        info["torch_npu_profiler_error"] = sanitize(error)
+
+    info["msprof_binary"] = shutil.which("msprof")
+    for env_name in ("ASCEND_PROFILER_OUTPUT", "PROFILING_MODE", "MSMONITOR_USE_DAEMON"):
+        info["env_" + env_name] = os.environ.get(env_name)
+    return info
+
+
+def probe_npu():
+    info = {}
+    try:
+        import torch  # noqa: F401
+
+        try:
+            import torch_npu  # noqa: F401
+
+            info["npu_device_count"] = torch.npu.device_count()
+            if torch.npu.device_count() > 0:
+                info["npu_device_name_0"] = torch.npu.get_device_name(0)
+            info["npu_current_device"] = torch.npu.current_device()
+        except Exception as error:
+            info["torch_npu_error"] = sanitize(error)
+    except Exception as error:
+        info["torch_error"] = sanitize(error)
+    return info
+
+
+def model_summary(model_dir):
+    if not model_dir:
+        return None
+    summary = {"dir": model_dir, "exists": os.path.isdir(model_dir)}
+    config_path = os.path.join(model_dir, "config.json")
+    try:
+        with open(config_path, "r", encoding="utf-8") as handle:
+            config = json.load(handle)
+        summary["config_subset"] = {
+            key: config.get(key)
+            for key in (
+                "model_type",
+                "architectures",
+                "num_hidden_layers",
+                "hidden_size",
+                "intermediate_size",
+                "num_attention_heads",
+                "num_key_value_heads",
+                "vocab_size",
+                "torch_dtype",
+                "max_position_embeddings",
+                "tie_word_embeddings",
+            )
+            if key in config
+        }
+    except Exception as error:
+        summary["config_error"] = sanitize(error)
+    try:
+        files = []
+        for name in sorted(os.listdir(model_dir)):
+            path = os.path.join(model_dir, name)
+            if os.path.isfile(path):
+                files.append({"file": name, "bytes": os.path.getsize(path)})
+        summary["files"] = files
+        summary["total_bytes"] = sum(item["bytes"] for item in files)
+    except Exception as error:
+        summary["listing_error"] = sanitize(error)
+    return summary
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", default="")
+    parser.add_argument("--model-dir", default="")
+    parser.add_argument("--skip-npu-smi", action="store_true")
+    args = parser.parse_args(argv)
+
+    info = {
+        "schema": "pypto-x.a2-vllm-ascend.env-fingerprint.v1",
+        "captured_at": run("date -u +%Y-%m-%dT%H:%M:%SZ").get("stdout"),
+        "python": sys.version,
+        "python_executable": sys.executable,
+        "platform": platform.platform(),
+        "cpu_count": os.cpu_count(),
+        "packages": {
+            "torch": package_version("torch"),
+            "torch_npu": package_version("torch_npu"),
+            "vllm": package_version("vllm"),
+            "vllm_ascend": package_version("vllm_ascend"),
+            "transformers": package_version("transformers"),
+            "tokenizers": package_version("tokenizers"),
+            "numpy": package_version("numpy"),
+            "modelscope": package_version("modelscope"),
+        },
+        "commands": {
+            "vllm_version": run("%s -m vllm --version" % sys.executable),
+            "pip_show_vllm": run("%s -m pip show vllm vllm-ascend torch torch-npu" % sys.executable),
+        },
+        "cann": {
+            "version_cfg": read_file("/usr/local/Ascend/ascend-toolkit/latest/version.cfg"),
+            "ascend_toolkit_set_env": os.path.isfile(
+                "/usr/local/Ascend/ascend-toolkit/set_env.sh"
+            ),
+            "driver_version_info": read_file("/usr/local/Ascend/driver/version.info"),
+            "nnal_atb_set_env": os.path.isfile("/usr/local/Ascend/nnal/atb/set_env.sh"),
+            "glob_versions": sanitize(
+                sorted(glob.glob("/usr/local/Ascend/ascend-toolkit/*/version.cfg"))
+            ),
+        },
+        "profiler_probe": probe_profiler_api(),
+        "npu": probe_npu(),
+        "model_dir": model_summary(args.model_dir),
+    }
+
+    if not args.skip_npu_smi:
+        info["commands"]["npu_smi_info"] = run(
+            "bash -lc 'source /usr/local/Ascend/ascend-toolkit/set_env.sh 2>/dev/null; "
+            "export LD_LIBRARY_PATH=/usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/common:"
+            "/usr/local/Ascend/driver/lib64/driver:${LD_LIBRARY_PATH:-}; npu-smi info'",
+            timeout=120,
+        )
+
+    text = json.dumps(info, ensure_ascii=False, indent=2)
+    if args.out:
+        with open(args.out, "w", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
