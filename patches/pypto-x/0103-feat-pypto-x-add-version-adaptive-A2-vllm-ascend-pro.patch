+++ b/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
@@ -0,0 +1,183 @@
+#!/usr/bin/env bash
+# W8I: A2(910B3) 上的 profiling 采集编排（只在收到父 agent "A2 FREE" 后执行）。
+#
+# 用法（A2 容器内）：
+#   STAGE=all bash run_a2_profiling.sh
+#   STAGE=env bash run_a2_profiling.sh      # 只做环境指纹
+#   STAGE=weights ... / offline08 / online08 / bigmodel / extract
+#
+# 关键环境变量（都有默认值）：
+#   PYTHON          /usr/local/python3.12.13/bin/python3.12
+#   WORKDIR         /root/a2_vllm_qwen35/profiling
+#   MODEL_DIR       /root/models/Qwen3.5-0.8B
+#   MANIFEST        /root/a2_vllm_qwen35/model_manifest/_manifest.json
+#   BIG_MODEL_ID    Qwen/Qwen3.5-9B
+#   BIG_MODEL_DIR   /root/models/Qwen3.5-9B
+#   BIG_MODEL_REVISION master
+#   WARMUP=5 REPEATS=3 MAX_TOKENS=16
+#   GPU_UTIL_08B=0.35 GPU_UTIL_BIG=0.90
+#   ENFORCE_EAGER=1
+#
+# 纪律：串行执行；不 push/不合并；大 trace 留在 A2（只回传 csv/ 与 raw/ 小文件）。
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PYTHON="${PYTHON:-/usr/local/python3.12.13/bin/python3.12}"
+WORKDIR="${WORKDIR:-/root/a2_vllm_qwen35/profiling}"
+MODEL_DIR="${MODEL_DIR:-/root/models/Qwen3.5-0.8B}"
+MANIFEST="${MANIFEST:-/root/a2_vllm_qwen35/model_manifest/_manifest.json}"
+BIG_MODEL_ID="${BIG_MODEL_ID:-Qwen/Qwen3.5-9B}"
+BIG_MODEL_DIR="${BIG_MODEL_DIR:-/root/models/Qwen3.5-9B}"
+BIG_MODEL_REVISION="${BIG_MODEL_REVISION:-master}"
+STAGE="${STAGE:-all}"
+WARMUP="${WARMUP:-5}"
+REPEATS="${REPEATS:-3}"
+MAX_TOKENS="${MAX_TOKENS:-16}"
+GPU_UTIL_08B="${GPU_UTIL_08B:-0.35}"
+GPU_UTIL_BIG="${GPU_UTIL_BIG:-0.90}"
+ENFORCE_EAGER="${ENFORCE_EAGER:-1}"
+TRACES="${TRACES:-$WORKDIR/traces}"
+LOGS="$WORKDIR/logs"
+ENFORCE_FLAG=()
+if [[ "$ENFORCE_EAGER" == "1" ]]; then
+    ENFORCE_FLAG=(--enforce-eager)
+fi
+
+mkdir -p "$WORKDIR" "$LOGS" "$TRACES"
+
+# ---- CANN / ATB 环境（与 W8H 一致的加载顺序）----
+# shellcheck disable=SC1091
+source /usr/local/Ascend/ascend-toolkit/set_env.sh
+export PATH="$(dirname "$PYTHON"):${PATH}"
+if [[ -f /usr/local/Ascend/nnal/atb/set_env.sh ]]; then
+    # shellcheck disable=SC1091
+    source /usr/local/Ascend/nnal/atb/set_env.sh
+fi
+
+npu_smi() {
+    export LD_LIBRARY_PATH="/usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/common:/usr/local/Ascend/driver/lib64/driver:${LD_LIBRARY_PATH:-}"
+    npu-smi info
+}
+
+log() {
+    printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOGS/orchestrator.log"
+}
+
+run_stage() {
+    local name="$1"
+    shift
+    log ">> STAGE $name"
+    if ! "$@" 2>&1 | tee -a "$LOGS/$name.log"; then
+        log "!! STAGE $name FAILED (rc=${PIPESTATUS[0]})"
+        return 1
+    fi
+    log "<< STAGE $name OK"
+}
+
+stage_env() {
+    "$PYTHON" "$HERE/collect_env.py" --model-dir "$MODEL_DIR" \
+        --out "$WORKDIR/env_fingerprint.json" > "$LOGS/collect_env.log" 2>&1
+    npu_smi > "$WORKDIR/npu_smi_before.txt" 2>&1 || true
+    log "env fingerprint: $WORKDIR/env_fingerprint.json"
+}
+
+stage_weights() {
+    "$PYTHON" "$HERE/sha256_manifest_check.py" --dir "$MODEL_DIR" --manifest "$MANIFEST" \
+        --out "$WORKDIR/weights_check.json" > "$LOGS/weights_check.log" 2>&1
+    log "weights check: $WORKDIR/weights_check.json（0.8B 冻结锚点必须 match）"
+}
+
+stage_offline08() {
+    "$PYTHON" "$HERE/profiling_offline.py" \
+        --model-dir "$MODEL_DIR" \
+        --out "$WORKDIR/offline_08b.json" \
+        --tag offline_08b \
+        --profiler-root "$TRACES" \
+        --warmup "$WARMUP" --repeats "$REPEATS" --max-tokens "$MAX_TOKENS" \
+        --max-model-len 512 --gpu-memory-utilization "$GPU_UTIL_08B" \
+        "${ENFORCE_FLAG[@]}" > "$LOGS/offline_08b.log" 2>&1
+    log "offline 0.8B: $WORKDIR/offline_08b.json"
+}
+
+stage_online08() {
+    "$PYTHON" "$HERE/profiling_online.py" \
+        --model-dir "$MODEL_DIR" \
+        --out "$WORKDIR/online_08b.json" \
+        --tag online_08b --workdir "$WORKDIR" \
+        --profiler-root "$TRACES" \
+        --warmup "$WARMUP" --repeats "$REPEATS" --max-tokens "$MAX_TOKENS" \
+        --max-model-len 512 --gpu-memory-utilization "$GPU_UTIL_08B" \
+        "${ENFORCE_FLAG[@]}" > "$LOGS/online_08b.log" 2>&1
+    log "online 0.8B: $WORKDIR/online_08b.json"
+}
+
+stage_bigmodel() {
+    "$PYTHON" "$HERE/download_model_modelscope.py" \
+        --model-id "$BIG_MODEL_ID" --revision "$BIG_MODEL_REVISION" \
+        --local-dir "$BIG_MODEL_DIR" --skip-existing \
+        --out "$WORKDIR/model_download.json" > "$LOGS/download_big.log" 2>&1
+    log "big model download: $WORKDIR/model_download.json"
+
+    "$PYTHON" "$HERE/profiling_offline.py" \
+        --model-dir "$BIG_MODEL_DIR" \
+        --out "$WORKDIR/sanity_big.json" --tag sanity_big --sanity \
+        --profiler-root "$TRACES" --max-tokens 8 \
+        --max-model-len 512 --gpu-memory-utilization "$GPU_UTIL_BIG" \
+        "${ENFORCE_FLAG[@]}" > "$LOGS/sanity_big.log" 2>&1
+    log "big model sanity: $WORKDIR/sanity_big.json"
+
+    "$PYTHON" "$HERE/profiling_offline.py" \
+        --model-dir "$BIG_MODEL_DIR" \
+        --out "$WORKDIR/offline_big.json" \
+        --tag offline_big --profiler-root "$TRACES" \
+        --warmup "$WARMUP" --repeats "$REPEATS" --max-tokens "$MAX_TOKENS" \
+        --max-model-len 512 --gpu-memory-utilization "$GPU_UTIL_BIG" \
+        "${ENFORCE_FLAG[@]}" > "$LOGS/offline_big.log" 2>&1
+    log "offline big: $WORKDIR/offline_big.json"
+
+    "$PYTHON" "$HERE/profiling_online.py" \
+        --model-dir "$BIG_MODEL_DIR" \
+        --out "$WORKDIR/online_big.json" \
+        --tag online_big --workdir "$WORKDIR" --profiler-root "$TRACES" \
+        --warmup "$WARMUP" --repeats "$REPEATS" --max-tokens "$MAX_TOKENS" \
+        --max-model-len 512 --gpu-memory-utilization "$GPU_UTIL_BIG" \
+        "${ENFORCE_FLAG[@]}" > "$LOGS/online_big.log" 2>&1
+    log "online big: $WORKDIR/online_big.json"
+}
+
+stage_extract() {
+    "$PYTHON" "$HERE/extract_csv.py" --input "$TRACES" --outdir "$WORKDIR/csv" \
+        --max-rows 5000 --max-file-mb 25 > "$LOGS/extract_csv.log" 2>&1
+    log "csv: $WORKDIR/csv（还有 $WORKDIR/csv/extract_inventory.json）"
+}
+
+stage_cleanup() {
+    # 只做观察与收尾提示：不 kill 别人的进程。
+    log "残留进程检查（应为空）："
+    pgrep -af "vllm.entrypoints.openai.api_server" || true
+    npu_smi > "$WORKDIR/npu_smi_after.txt" 2>&1 || true
+}
+
+case "$STAGE" in
+    env) run_stage env stage_env ;;
+    weights) run_stage weights stage_weights ;;
+    offline08) run_stage offline08 stage_offline08 ;;
+    online08) run_stage online08 stage_online08 ;;
+    bigmodel) run_stage bigmodel stage_bigmodel ;;
+    extract) run_stage extract stage_extract ;;
+    all)
+        run_stage env stage_env
+        run_stage weights stage_weights
+        run_stage offline08 stage_offline08
+        run_stage online08 stage_online08
+        run_stage bigmodel stage_bigmodel
+        run_stage extract stage_extract
+        run_stage cleanup stage_cleanup
+        ;;
+    *)
+        echo "未知 STAGE=$STAGE（env|weights|offline08|online08|bigmodel|extract|all）" >&2
+        exit 2
+        ;;
+esac
+
+log "STAGE=$STAGE 完成；证据目录 $WORKDIR"
diff --git a/tools/a2_vllm_ascend_profiling/selfcheck_local.sh b/tools/a2_vllm_ascend_profiling/selfcheck_local.sh
new file mode 100755
index 000000000..ebf87c32e
--- /dev/null
+++ b/tools/a2_vllm_ascend_profiling/selfcheck_local.sh
@@ -0,0 +1,151 @@
+#!/usr/bin/env bash
+# W8I: 本地静态自检（不联网、不加载模型、不执行 A2 命令）。
+#
+#   bash selfcheck_local.sh
+#
+# 覆盖：shell 语法、Python 语法、extract_csv self-test、prompts/manifest 单元冒烟、
+# 以及"仓内不得出现 A2 凭据/端点"的粗检查。
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PYTHON="${PYTHON:-python3}"
+FAILED=0
+
+step() {
+    printf '\n== %s ==\n' "$*"
+}
+
+step "bash -n"
+for script in "$HERE"/*.sh; do
+    if bash -n "$script"; then
+        echo "OK  $(basename "$script")"
+    else
+        echo "FAIL $(basename "$script")"
+        FAILED=1
+    fi
+done
+
+step "python 语法（py_compile）"
+if "$PYTHON" -m py_compile "$HERE"/*.py; then
+    echo "OK  py_compile"
+else
+    echo "FAIL py_compile"
+    FAILED=1
+fi
+
+step "extract_csv self-test"
+if "$PYTHON" "$HERE/extract_csv.py" --self-test; then
+    echo "OK  extract_csv --self-test"
+else
+    echo "FAIL extract_csv --self-test"
+    FAILED=1
+fi
+
+step "prompts 合成序列与 chat template 渲染冒烟"
+if "$PYTHON" - "$HERE" <<'PY'
+import sys
+sys.path.insert(0, sys.argv[1])
+import prompts
+
+
+class FakeTokenizer(object):
+    def encode(self, text, add_special_tokens=False):
+        return [1, 2, 3, 4, 5, 6, 7]
+
+    def decode(self, ids, skip_special_tokens=False):
+        return "x" * len(ids)
+
+    def apply_chat_template(self, messages, tokenize=False, add_generation_prompt=True, **kwargs):
+        return "<chat>%s</chat>" % messages[0]["content"]
+
+
+tokenizer = FakeTokenizer()
+items = prompts.build_workload(tokenizer)
+assert len(items) == 3 + len(prompts.SYNTHETIC_LENGTHS), len(items)
+assert items[0]["text"] == "The capital of France is"
+assert items[2]["text"] == "<chat>你好，请介绍一下你自己。</chat>"
+for item, length in zip(items[3:], prompts.SYNTHETIC_LENGTHS):
+    assert item["id"] == "synthetic_%d" % length
+    assert len(item["token_ids"]) == length
+print("OK  prompts.build_workload")
+PY
+then
+    :
+else
+    echo "FAIL prompts"
+    FAILED=1
+fi
+
+step "sha256_manifest_check 逻辑冒烟（合成 manifest，一次 sha256）"
+if "$PYTHON" - "$HERE" <<'PY'
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+here = sys.argv[1]
+with tempfile.TemporaryDirectory() as tmp:
+    model_dir = os.path.join(tmp, "model")
+    os.makedirs(model_dir)
+    payload = b"weights"
+    with open(os.path.join(model_dir, "model.safetensors"), "wb") as handle:
+        handle.write(payload)
+    manifest = {
+        "repo_id": "synthetic",
+        "revision": "r",
+        "verified_at": "now",
+        "files": {
+            "model.safetensors": {
+                "bytes": len(payload),
+                "sha256": hashlib.sha256(payload).hexdigest(),
+            }
+        },
+    }
+    manifest_path = os.path.join(tmp, "_manifest.json")
+    with open(manifest_path, "w") as handle:
+        json.dump(manifest, handle)
+    completed = subprocess.run(
+        [sys.executable, os.path.join(here, "sha256_manifest_check.py"),
+         "--dir", model_dir, "--manifest", manifest_path, "--skip-optional"],
+        capture_output=True, text=True,
+    )
+    result = json.loads(completed.stdout)
+    assert result["summary"]["required_ok"] is False, "缺必需文件时应 required_ok=False"
+    # 锚点文件在该目录中缺失或大小不符 -> anchor_ok 必须为 False（fail-closed）
+    assert result["summary"]["anchor_ok"] is False
+    assert result["anchor"]["expected"]["bytes"] == 1746942600
+    print("OK  sha256_manifest_check fail-closed")
+PY
+then
+    :
+else
+    echo "FAIL sha256_manifest_check"
+    FAILED=1
+fi
+
+step "凭据/端点粗检查（仓内不得出现 A2 凭据变量）"
+if grep -rInE "A2_JUMP|A2_TARGET_PW|A2_TUNNEL_JUMP|jump_user|password[[:space:]]*=" "$HERE" --include='*.py' --include='*.sh' --include='*.md' | grep -v "密码\|凭据"; then
+    echo "FAIL 发现疑似凭据/端点引用"
+    FAILED=1
+else
+    echo "OK  未发现凭据/端点引用"
+fi
+
+step "git diff --check"
+if git -C "$(git -C "$HERE" rev-parse --show-toplevel)" diff --check; then
+    echo "OK  git diff --check"
+else
+    echo "FAIL git diff --check"
+    FAILED=1
+fi
+
+if [[ "$FAILED" -eq 0 ]]; then
+    echo
+    echo "SELF-CHECK PASS"
+else
+    echo
+    echo "SELF-CHECK FAIL"
+fi
+exit "$FAILED"
diff --git a/tools/a2_vllm_ascend_profiling/sha256_manifest_check.py b/tools/a2_vllm_ascend_profiling/sha256_manifest_check.py
new file mode 100644
