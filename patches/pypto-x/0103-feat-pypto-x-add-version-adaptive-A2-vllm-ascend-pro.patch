+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: profiler 产物 → 小体积 CSV（torch chrome trace + Ascend 文本导出）。
+
+用法::
+
+    python extract_csv.py --input <dir_or_file> [--input ...] \
+        --outdir <dir> [--max-rows 5000] [--max-file-mb 25]
+
+支持：
+
+* torch chrome trace：`*.pt.trace.json` / `*.json.gz`（含 `traceEvents`）；
+  输出 `torch_trace_summary.csv`（name/cat/device/calls/total_us/self_us/share_pct）、
+  `torch_trace_by_category.csv`、`torch_trace_device_summary.csv`；
+* Ascend 文本导出（vllm-ascend torch_npu profiler 的
+  `ASCEND_PROFILER_OUTPUT/`）：`op_summary*.csv`、`op_statistic*.csv`、
+  `kernel_details*.csv`、`step_trace_time*.csv`、`communication*.csv`；
+  保留关键列并做 top-N 截断，另输出 `ascend_op_duration_by_name.csv`；
+* 体积纪律：单文件默认 ≤25 MB、输出行数 ≤5000（超出按耗时 top-N 截断），
+  全部产物清单与截断标志写入 `extract_inventory.json`。
+
+`--self-test`：在临时目录生成嵌套事件 trace 并校验 self/total/calls，可离线运行。
+"""
+
+import argparse
+import csv
+import gzip
+import hashlib
+import json
+import os
+import sys
+import tempfile
+import time
+
+GZIP_MAGIC = b"\x1f\x8b"
+
+DEVICE_KEYS = ("device", "device_id", "device_index", "Device", "stream", "stream_id")
+
+
+def now_iso():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def sha256_file(path, chunk_size=1 << 22):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def open_text(path):
+    with open(path, "rb") as handle:
+        magic = handle.read(2)
+    if magic == GZIP_MAGIC:
+        return gzip.open(path, "rt", encoding="utf-8", errors="replace")
+    return open(path, "r", encoding="utf-8", errors="replace")
+
+
+def extract_device(args):
+    for key in DEVICE_KEYS:
+        if key in args and args[key] is not None:
+            return str(args[key])
+    return ""
+
+
+def merge_interval(intervals, start, end):
+    """把 [start,end) 并入已排序的区间列表（原地）。"""
+    if end <= start:
+        return
+    if not intervals or start > intervals[-1][1]:
+        intervals.append([start, end])
+        return
+    intervals[-1][1] = max(intervals[-1][1], end)
+
+
+def covered_length(intervals):
+    return sum(end - start for start, end in intervals)
+
+
+def summarize_trace_events(events):
+    """按 (pid,tid) 栈式算法计算每个事件的 self time，并聚合。
+
+    返回 (aggregate dict, anomalies int, event_count int)。
+    """
+    completes = []
+    for event in events:
+        if event.get("ph") != "X":
+            continue
+        try:
+            ts = float(event.get("ts"))
+            dur = float(event.get("dur"))
+        except (TypeError, ValueError):
+            continue
+        if dur < 0:
+            continue
+        completes.append(
+            {
+                "name": str(event.get("name", "")),
+                "cat": str(event.get("cat", "")),
+                "device": extract_device(event.get("args") or {}),
+                "pid": event.get("pid"),
+                "tid": event.get("tid"),
+                "ts": ts,
+                "dur": dur,
+                "end": ts + dur,
+                "cover": [],
+            }
+        )
+
+    completes.sort(key=lambda item: (str(item["pid"]), str(item["tid"]), item["ts"], -item["dur"]))
+    aggregate = {}
+    anomalies = 0
+    stack = []
+
+    def finalize(event):
+        nonlocal anomalies
+        self_us = event["dur"] - covered_length(event["cover"])
+        if self_us < -1e-6:
+            anomalies += 1
+            self_us = 0.0
+        key = (event["name"], event["cat"], event["device"])
+        bucket = aggregate.setdefault(
+            key,
+            {"name": event["name"], "cat": event["cat"], "device": event["device"],
+             "calls": 0, "total_us": 0.0, "self_us": 0.0},
+        )
+        bucket["calls"] += 1
+        bucket["total_us"] += event["dur"]
+        bucket["self_us"] += self_us
+
+    current_stream = None
+    for event in completes:
+        stream = (event["pid"], event["tid"])
+        if stream != current_stream:
+            # 切换到新的 pid/tid 轨道：先结算上一条轨道的整个栈。
+            while stack:
+                finalize(stack.pop())
+            current_stream = stream
+        while stack and event["ts"] >= stack[-1]["end"]:
+            finalize(stack.pop())
+        if stack:
+            parent = stack[-1]
+            merge_interval(parent["cover"], event["ts"], event["end"])
+        stack.append(event)
+    while stack:
+        finalize(stack.pop())
+
+    return aggregate, anomalies, len(completes)
+
+
+def write_csv(path, header, rows):
+    with open(path, "w", encoding="utf-8", newline="") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(header)
+        writer.writerows(rows)
+
+
+def cap_rows(rows, max_rows):
+    if max_rows and max_rows > 0 and len(rows) > max_rows:
+        return rows[:max_rows], True
+    return rows, False
+
+
+def shrink_to_limit(path, max_bytes):
+    """若 CSV 超过 max_bytes，按行数折半重写，直到达标或只剩表头。"""
+    try:
+        if os.path.getsize(path) <= max_bytes:
+            return False
+    except OSError:
+        return False
+    with open(path, "r", encoding="utf-8", newline="") as handle:
+        rows = list(csv.reader(handle))
+    header, body = rows[0], rows[1:]
+    truncated = False
+    while body and os.path.getsize(path) > max_bytes:
+        body = body[: max(1, len(body) // 2)]
+        truncated = True
+        with open(path, "w", encoding="utf-8", newline="") as handle:
+            writer = csv.writer(handle)
+            writer.writerow(header)
+            writer.writerows(body)
+    return truncated
+
+
+def process_torch_trace(path, outdir, max_rows, max_bytes):
+    with open_text(path) as handle:
+        data = json.load(handle)
+    events = data.get("traceEvents") or []
+    aggregate, anomalies, event_count = summarize_trace_events(events)
+    buckets = sorted(aggregate.values(), key=lambda item: -item["self_us"])
+    total_self = sum(item["self_us"] for item in buckets) or 1.0
+    rows = [
+        [
+            item["name"],
+            item["cat"],
+            item["device"],
+            item["calls"],
+            "%.3f" % item["total_us"],
+            "%.3f" % item["self_us"],
+            "%.4f" % (100.0 * item["self_us"] / total_self),
+        ]
+        for item in buckets
+    ]
+    rows, truncated = cap_rows(rows, max_rows)
+    summary_path = os.path.join(outdir, "torch_trace_summary.csv")
+    write_csv(summary_path, ["name", "cat", "device", "calls", "total_us", "self_us", "share_pct"], rows)
+    shrunk = shrink_to_limit(summary_path, max_bytes)
+
+    by_cat = {}
+    by_device = {}
+    for item in buckets:
+        cat = by_cat.setdefault(item["cat"], {"calls": 0, "total_us": 0.0, "self_us": 0.0})
+        cat["calls"] += item["calls"]
+        cat["total_us"] += item["total_us"]
+        cat["self_us"] += item["self_us"]
+        device = by_device.setdefault(item["device"], {"calls": 0, "total_us": 0.0, "self_us": 0.0})
+        device["calls"] += item["calls"]
+        device["total_us"] += item["total_us"]
+        device["self_us"] += item["self_us"]
+
+    cat_rows = [
+        [cat, value["calls"], "%.3f" % value["total_us"], "%.3f" % value["self_us"]]
+        for cat, value in sorted(by_cat.items(), key=lambda pair: -pair[1]["self_us"])
+    ]
+    write_csv(
+        os.path.join(outdir, "torch_trace_by_category.csv"),
+        ["cat", "calls", "total_us", "self_us"],
+        cat_rows,
+    )
+    device_rows = [
+        [device, value["calls"], "%.3f" % value["total_us"], "%.3f" % value["self_us"]]
+        for device, value in sorted(by_device.items(), key=lambda pair: -pair[1]["self_us"])
+    ]
+    write_csv(
+        os.path.join(outdir, "torch_trace_device_summary.csv"),
+        ["device", "calls", "total_us", "self_us"],
+        device_rows,
+    )
+    return {
+        "kind": "torch_trace",
+        "source": path,
+        "events": event_count,
+        "aggregated_rows": len(buckets),
+        "anomalies": anomalies,
+        "truncated": truncated or shrunk,
+    }
+
+
+NAME_CANDIDATES = ("op name", "opname", "op_name", "name", "kernel name", "kernel_name")
+DURATION_CANDIDATES = ("task duration", "duration", "total time", "time(us)", "elapsed time")
+TYPE_CANDIDATES = ("op type", "optype", "op_type", "type", "name")
+COUNT_CANDIDATES = ("count", "calls", "total count", "occurrences")
+DEVICE_CANDIDATES = ("device id", "device_id", "device", "rank id", "rank_id")
+RATIO_CANDIDATES = ("ratio", "proportion", "percent", "share")
+
+
+def find_column(header, candidates):
+    lowered = [column.strip().lower() for column in header]
+    for candidate in candidates:
+        for index, column in enumerate(lowered):
+            if candidate == column:
+                return index
+    for candidate in candidates:
+        for index, column in enumerate(lowered):
+            if candidate in column:
+                return index
+    return None
+
+
+def pick_columns(header, wanted):
+    """wanted: list of (output_name, candidates)；返回 [(index, output_name)]。"""
+    picked = []
+    used = set()
+    for output_name, candidates in wanted:
+        index = find_column(header, candidates)
+        if index is not None and index not in used:
+            picked.append((index, output_name))
+            used.add(index)
+    return picked
+
+
+def process_ascend_csv(path, outdir, max_rows, max_bytes, name):
+    with open(path, "r", encoding="utf-8", errors="replace", newline="") as handle:
+        reader = csv.reader(handle)
+        try:
+            header = next(reader)
+        except StopIteration:
+            return None
+        rows = list(reader)
+    if not header or not rows:
+        return None
+
+    if "op_statistic" in name:
+        wanted = [
+            ("op_type", TYPE_CANDIDATES),
+            ("count", COUNT_CANDIDATES),
+            ("total_us", DURATION_CANDIDATES),
+            ("ratio", RATIO_CANDIDATES),
+            ("device", DEVICE_CANDIDATES),
+        ]
+        sort_key = "count"
+    elif "kernel_details" in name:
+        wanted = [
+            ("name", NAME_CANDIDATES),
+            ("type", TYPE_CANDIDATES),
+            ("duration_us", DURATION_CANDIDATES),
+            ("device", DEVICE_CANDIDATES),
+        ]
+        sort_key = "duration_us"
+    elif "step_trace" in name:
+        wanted = [
+            ("name", NAME_CANDIDATES),
+            ("duration_us", DURATION_CANDIDATES),
+            ("device", DEVICE_CANDIDATES),
+        ]
+        sort_key = "duration_us"
+    else:  # op_summary / communication / 其他
+        wanted = [
+            ("name", NAME_CANDIDATES),
+            ("type", TYPE_CANDIDATES),
+            ("duration_us", DURATION_CANDIDATES),
+            ("device", DEVICE_CANDIDATES),
+        ]
+        sort_key = "duration_us"
+
+    picked = pick_columns(header, wanted)
+    if not picked:
+        # 无关键列：原样保留前若干行（仍受体积限制）
+        picked = [(index, header[index]) for index in range(min(len(header), 12))]
+
+    body = [[row[index] if index < len(row) else "" for index, _ in picked] for row in rows]
+    output_name = "ascend_%s.csv" % name
+    sort_index = None
+    for position, (_index, output_field) in enumerate(picked):
+        if output_field == sort_key:
+            sort_index = position
+            break
+    if sort_index is not None:
+        def numeric(row):
+            try:
+                return float(row[sort_index])
+            except (TypeError, ValueError):
+                return -1.0
+
+        body.sort(key=numeric, reverse=True)
+    body, truncated = cap_rows(body, max_rows)
+    header_out = [output_field for _index, output_field in picked]
+    output_path = os.path.join(outdir, output_name)
+    write_csv(output_path, header_out, body)
+    shrunk = shrink_to_limit(output_path, max_bytes)
+
+    extra = None
+    if sort_index is not None and "op_summary" in name:
+        by_name = {}
+        name_position = 0 if picked and picked[0][1] == "name" else None
+        if name_position is not None:
+            for row in body:
+                key = row[name_position]
+                duration = float(row[sort_index]) if _is_float(row[sort_index]) else 0.0
+                bucket = by_name.setdefault(key, {"calls": 0, "total_us": 0.0})
+                bucket["calls"] += 1
+                bucket["total_us"] += duration
+            extra_rows = [
+                [key, value["calls"], "%.3f" % value["total_us"]]
+                for key, value in sorted(by_name.items(), key=lambda pair: -pair[1]["total_us"])
+            ][: max_rows]
+            extra = os.path.join(outdir, "ascend_op_duration_by_name.csv")
+            write_csv(extra, ["name", "calls", "total_us"], extra_rows)
+            shrink_to_limit(extra, max_bytes)
+
+    return {
+        "kind": "ascend_csv",
+        "source": path,
+        "output": output_path,
+        "rows": len(body),
+        "rows_total": len(rows),
+        "truncated": truncated or shrunk,
+        "extra": extra,
+    }
+
+
+def _is_float(value):
+    try:
+        float(value)
+        return True
+    except (TypeError, ValueError):
+        return False
+
+
+def classify(path):
+    lower = path.lower()
+    if lower.endswith(".csv"):
+        return "ascend_csv"
+    return "trace_or_csv"
+
+
+def collect_inputs(inputs):
+    files = []
+    for entry in inputs:
+        if os.path.isdir(entry):
+            for root, _dirs, names in os.walk(entry):
+                for name in names:
+                    files.append(os.path.join(root, name))
+        elif os.path.isfile(entry):
+            files.append(entry)
+    return sorted(set(files))
+
+
+def process_file(path, outdir, max_rows, max_bytes):
+    lower = path.lower()
+    name = os.path.basename(path)
+    if lower.endswith(".csv"):
+        return process_ascend_csv(path, outdir, max_rows, max_bytes, name[: -len(".csv")])
+    if lower.endswith(".json") or lower.endswith(".json.gz"):
+        try:
+            info = process_torch_trace(path, outdir, max_rows, max_bytes)
+            return info
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            return {"kind": "skipped", "source": path, "reason": "json 解析失败"}
+        except Exception as error:
+            return {"kind": "error", "source": path, "error": "%s: %s" % (type(error).__name__, error)}
+    return {"kind": "skipped", "source": path, "reason": "不支持的后缀"}
+
+
+def build_inventory(outdir):
+    items = []
+    for name in sorted(os.listdir(outdir)):
+        path = os.path.join(outdir, name)
+        if not os.path.isfile(path):
+            continue
+        items.append({"file": name, "bytes": os.path.getsize(path), "sha256": sha256_file(path)})
+    return items
+
+
+def run(args):
+    os.makedirs(args.outdir, exist_ok=True)
+    files = collect_inputs(args.input)
+    max_bytes = int(args.max_file_mb * 1024 * 1024)
+    reports = []
+    for path in files:
+        report = process_file(path, args.outdir, args.max_rows, max_bytes)
+        if report is not None:
+            reports.append(report)
+    inventory = {
+        "schema": "pypto-x.a2-vllm-ascend.profiling.csv-inventory.v1",
+        "generated_at": now_iso(),
+        "inputs": files,
+        "max_rows": args.max_rows,
+        "max_file_mb": args.max_file_mb,
+        "reports": reports,
+        "outputs": build_inventory(args.outdir),
+    }
+    inventory_path = os.path.join(args.outdir, "extract_inventory.json")
+    with open(inventory_path, "w", encoding="utf-8") as handle:
+        handle.write(json.dumps(inventory, ensure_ascii=False, indent=2) + "\n")
+    return inventory
+
+
+def self_test():
+    """生成嵌套事件 trace，校验 self/total/calls 与 gzip 解析。"""
+    events = [
+        # tid 1: A[0,100) = B[0,40) + C[50,80)
+        {"ph": "X", "name": "opA", "cat": "cpu_op", "pid": 1, "tid": 1, "ts": 0, "dur": 100, "args": {}},
+        {"ph": "X", "name": "opB", "cat": "cpu_op", "pid": 1, "tid": 1, "ts": 0, "dur": 40, "args": {}},
+        {"ph": "X", "name": "opD", "cat": "cpu_op", "pid": 1, "tid": 1, "ts": 5, "dur": 10, "args": {}},
+        {"ph": "X", "name": "opC", "cat": "cpu_op", "pid": 1, "tid": 1, "ts": 50, "dur": 30, "args": {}},
+        # tid 2: kernel on device 0
+        {"ph": "X", "name": "kernelX", "cat": "Kernel", "pid": 2, "tid": 2, "ts": 0, "dur": 20,
+         "args": {"device_id": 0}},
+    ]
+    expected_self = {"opA": 30.0, "opB": 30.0, "opC": 30.0, "opD": 10.0, "kernelX": 20.0}
+    with tempfile.TemporaryDirectory() as tmp:
+        trace_path = os.path.join(tmp, "synthetic.pt.trace.json.gz")
+        with gzip.open(trace_path, "wt", encoding="utf-8") as handle:
+            json.dump({"traceEvents": events}, handle)
+        outdir = os.path.join(tmp, "csv")
+        args = argparse.Namespace(
+            input=[tmp], outdir=outdir, max_rows=100, max_file_mb=25
+        )
+        inventory = run(args)
+        summary_path = os.path.join(outdir, "torch_trace_summary.csv")
+        assert os.path.isfile(summary_path), "缺少 torch_trace_summary.csv"
+        rows = {}
+        with open(summary_path, "r", encoding="utf-8", newline="") as handle:
+            for row in csv.DictReader(handle):
+                rows[row["name"]] = row
+        failures = []
+        for name, self_us in expected_self.items():
+            if name not in rows:
+                failures.append("%s 未出现在 summary" % name)
+                continue
+            actual = float(rows[name]["self_us"])
+            if abs(actual - self_us) > 0.5:
+                failures.append("%s self_us=%s 期望 %s" % (name, actual, self_us))
+        if "device" in rows.get("kernelX", {}) and rows["kernelX"]["device"] != "0":
+            failures.append("kernelX device=%s 期望 0" % rows["kernelX"]["device"])
+        stats = [
+            report
+            for report in inventory["reports"]
+            if report.get("kind") == "torch_trace"
+        ]
+        if not stats:
+            failures.append("没有 torch_trace 报告")
+        elif stats[0].get("events") != len(events):
+            failures.append("events=%s 期望 %s" % (stats[0].get("events"), len(events)))
+        if failures:
+            print("SELF-TEST FAIL:")
+            for failure in failures:
+                print("  - " + failure)
+            return 1
+        print("SELF-TEST PASS: self/total/calls/device 均符合预期")
+        return 0
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", action="append", default=[])
+    parser.add_argument("--outdir", default="")
+    parser.add_argument("--max-rows", type=int, default=5000)
+    parser.add_argument("--max-file-mb", type=float, default=25.0)
+    parser.add_argument("--self-test", action="store_true")
+    return parser.parse_args(argv)
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    if args.self_test:
+        return self_test()
+    if not args.input or not args.outdir:
+        raise SystemExit("需要 --input 与 --outdir（或 --self-test）")
+    inventory = run(args)
+    print(json.dumps(inventory, ensure_ascii=False, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
