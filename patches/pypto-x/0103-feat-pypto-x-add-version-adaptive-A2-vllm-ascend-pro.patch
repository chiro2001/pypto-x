+# -*- coding: utf-8 -*-
+"""vllm profiling API 的运行时探测（离线/在线 harness 共用）。
+
+不开 vLLM 进程、不构造模型，只做 import 级探测：
+
+* `config`：`vllm.config.ProfilerConfig` 可用 → `--profiler-config` /
+  `LLM(profiler_config=...)` 路径（vLLM 0.18+，vllm-ascend 0.23+）；
+* `env`   ：`vllm.envs.VLLM_TORCH_PROFILER_DIR` 可用 → 环境变量路径（vLLM<=0.11.x）；
+* `unknown`：两条都不探测到 → harness 会显式报错，并给出回退建议。
+"""
+
+
+def detect_profiler_api():
+    """返回 (mode, notes)；mode in {config, env, unknown}。"""
+    notes = {}
+    try:
+        from vllm.config import ProfilerConfig  # noqa: F401
+
+        notes["profiler_config_class"] = True
+        fields = getattr(ProfilerConfig, "model_fields", None)
+        if fields is None:
+            fields = getattr(ProfilerConfig, "__dataclass_fields__", {})
+        notes["profiler_config_fields"] = sorted(fields.keys())
+    except Exception as error:
+        notes["profiler_config_class"] = False
+        notes["profiler_config_error"] = "%s: %s" % (type(error).__name__, error)
+    try:
+        import vllm.envs as vllm_envs
+
+        value = getattr(vllm_envs, "VLLM_TORCH_PROFILER_DIR", None)
+        notes["env_var_supported"] = value is not None
+        notes["env_var_value_set"] = bool(value)
+    except Exception as error:
+        notes["env_var_supported"] = False
+        notes["env_var_error"] = "%s: %s" % (type(error).__name__, error)
+
+    if notes.get("profiler_config_class"):
+        return "config", notes
+    if notes.get("env_var_supported"):
+        return "env", notes
+    return "unknown", notes
+
+
+def alternative_mode(mode):
+    if mode == "config":
+        return "env"
+    if mode == "env":
+        return "config"
+    return None
diff --git a/tools/a2_vllm_ascend_profiling/profiling_offline.py b/tools/a2_vllm_ascend_profiling/profiling_offline.py
