+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8I: 按冻结 `_manifest.json` 复核 A2 上的模型目录（sha256 + 字节数）。
+
+用法::
+
+    python sha256_manifest_check.py \
+        --dir /root/models/Qwen3.5-0.8B \
+        --manifest /root/a2_vllm_qwen35/model_manifest/_manifest.json \
+        --out weights_check.json
+
+规则：
+
+* 必需文件（推理直接依赖）任一不符 → 退出码 1（`required_mismatch`）；
+* 非必需文件（README/LICENSE/.gitattributes）差异只记 advisory，不阻断；
+* **独立锚点**（不依赖 manifest 内容）：Qwen3.5-0.8B 的
+  `model.safetensors-00001-of-00001.safetensors` 必须为
+  1,746,942,600 B / sha256 04b1c301231dd422b8860db31311ab2721511346a32cb1e079c4c4e5f1fe4696；
+  manifest 自身也记录 sha256，便于证据复核。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+REQUIRED_FILES = (
+    "config.json",
+    "tokenizer.json",
+    "tokenizer_config.json",
+    "vocab.json",
+    "merges.txt",
+    "chat_template.jinja",
+    "model.safetensors-00001-of-00001.safetensors",
+    "model.safetensors.index.json",
+    "preprocessor_config.json",
+    "video_preprocessor_config.json",
+)
+
+ADVISORY_FILES = (".gitattributes", "LICENSE", "README.md")
+
+# 与任务书一致的冻结锚点（同时覆盖单文件命名别名）。
+ANCHOR_NAME = "model.safetensors-00001-of-00001.safetensors"
+ANCHOR_ALIASES = ("model.safetensors", ANCHOR_NAME)
+ANCHOR_BYTES = 1746942600
+ANCHOR_SHA256 = "04b1c301231dd422b8860db31311ab2721511346a32cb1e079c4c4e5f1fe4696"
+
+
+def sha256_file(path, chunk_size=1 << 22):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def check_entry(directory, name, expected):
+    path = os.path.join(directory, name)
+    entry = {"file": name}
+    if not os.path.isfile(path):
+        entry["status"] = "missing"
+        if expected:
+            entry["expected_bytes"] = expected.get("bytes")
+            entry["expected_sha256"] = expected.get("sha256")
+        return entry
+    entry["actual_bytes"] = os.path.getsize(path)
+    entry["actual_sha256"] = sha256_file(path)
+    if not expected:
+        entry["status"] = "not_in_manifest"
+        return entry
+    entry["expected_bytes"] = expected.get("bytes")
+    entry["expected_sha256"] = expected.get("sha256")
+    if entry["actual_bytes"] != expected.get("bytes"):
+        entry["status"] = "size_mismatch"
+    elif entry["actual_sha256"] != expected.get("sha256"):
+        entry["status"] = "sha256_mismatch"
+    else:
+        entry["status"] = "match"
+    return entry
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dir", required=True)
+    parser.add_argument("--manifest", required=True)
+    parser.add_argument("--out", default="")
+    parser.add_argument(
+        "--skip-optional",
+        action="store_true",
+        help="只校验必需文件（默认也会校验 manifest 中其它小文件）",
+    )
+    args = parser.parse_args(argv)
+
+    result = {
+        "schema": "pypto-x.a2-vllm-ascend.weights-check.v1",
+        "dir": args.dir,
+        "manifest": args.manifest,
+    }
+
+    try:
+        with open(args.manifest, "rb") as handle:
+            manifest_bytes = handle.read()
+        manifest = json.loads(manifest_bytes.decode("utf-8"))
+    except Exception as error:
+        result["status"] = "FAIL"
+        result["error"] = "manifest 读取失败: %s" % error
+        _emit(result, args.out)
+        return 1
+
+    result["manifest_sha256"] = hashlib.sha256(manifest_bytes).hexdigest()
+    result["manifest_repo_id"] = manifest.get("repo_id")
+    result["manifest_revision"] = manifest.get("revision")
+    result["manifest_verified_at"] = manifest.get("verified_at")
+    manifest_files = manifest.get("files") or {}
+
+    entries = []
+    if not args.skip_optional:
+        for name, expected in sorted(manifest_files.items()):
+            entries.append(check_entry(args.dir, name, expected))
+
+    required_reports = []
+    for name in REQUIRED_FILES:
+        expected = manifest_files.get(name)
+        if expected is None:
+            required_reports.append(
+                {"file": name, "status": "not_in_manifest", "required": True}
+            )
+            continue
+        report = check_entry(args.dir, name, expected)
+        report["required"] = True
+        required_reports.append(report)
+
+    advisory_reports = []
+    for name in ADVISORY_FILES:
+        expected = manifest_files.get(name)
+        report = check_entry(args.dir, name, expected)
+        report["required"] = False
+        advisory_reports.append(report)
+
+    anchor_reports = []
+    for name in ANCHOR_ALIASES:
+        path = os.path.join(args.dir, name)
+        if not os.path.isfile(path):
+            continue
+        report = {
+            "file": name,
+            "actual_bytes": os.path.getsize(path),
+            "actual_sha256": sha256_file(path),
+            "expected_bytes": ANCHOR_BYTES,
+            "expected_sha256": ANCHOR_SHA256,
+        }
+        report["status"] = (
+            "match"
+            if (report["actual_bytes"] == ANCHOR_BYTES and report["actual_sha256"] == ANCHOR_SHA256)
+            else "mismatch"
+        )
+        anchor_reports.append(report)
+
+    required_bad = [
+        report for report in required_reports if report.get("status") != "match"
+    ]
+    anchor_ok = bool(anchor_reports) and all(
+        report["status"] == "match" for report in anchor_reports
+    )
+    advisory_bad = [
+        report for report in advisory_reports if report.get("status") != "match"
+    ]
+
+    result["entries"] = entries
+    result["required"] = required_reports
+    result["advisory"] = advisory_reports
+    result["anchor"] = {
+        "expected": {
+            "file": ANCHOR_NAME,
+            "bytes": ANCHOR_BYTES,
+            "sha256": ANCHOR_SHA256,
+        },
+        "reports": anchor_reports,
+        "ok": anchor_ok,
+    }
+    result["summary"] = {
+        "required_ok": not required_bad,
+        "required_mismatch": [report["file"] for report in required_bad],
+        "anchor_ok": anchor_ok,
+        "advisory_mismatch": [report["file"] for report in advisory_bad],
+    }
+    result["status"] = "PASS" if (not required_bad and anchor_ok) else "FAIL"
+
+    _emit(result, args.out)
+    return 0 if result["status"] == "PASS" else 1
+
+
+def _emit(result, out_path):
+    text = json.dumps(result, ensure_ascii=False, indent=2)
+    if out_path:
+        with open(out_path, "w", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+    print(text)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
