--- /dev/null
+++ b/scripts/smoke/cuda_driver_smoke.py
@@ -0,0 +1,46 @@
+"""Tiny CUDA Driver/PTX correctness probe; intentionally no model or toolkit."""
+
+from pypto.abi import GpuLaunchRequest, TensorDesc
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cuda import CudaRuntime
+from pypto.compiler.targets.cuda import CudaPtxCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+
+
+def main():
+    value_type = CoreType.tensor("float32", (5,))
+    x = ValueRef("x", value_type)
+    y = ValueRef("y", value_type)
+    z = ValueRef("z", value_type)
+    program = CoreProgram(
+        functions=(CoreFunction("main", (x, y), (z,), Region((Operation("add", (x, y), (z,)),))),)
+    )
+    target = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+    compiler = CudaPtxCompiler()
+    target_ir = compiler.lower(program, target)
+    artifact = compiler.compile(target_ir)
+    left = HostTensor("float32", (5,), [1, 2, 3, 4, 5])
