@@ -0,0 +1,738 @@
+"""Header-free CUDA/PTX target adapter for the GPU common plans.
+
+The common GPU lowering remains vendor-neutral.  This module consumes its
+validated plans and emits a deliberately boring PTX correctness kernel for
+each Core IR operation.  The PTX target is configurable (``sm_80`` is the
+conservative default for BF16-capable forward JIT) and the actual device
+compute capability is metadata supplied by the Driver API at compile/probe
+time; no ``sm_120`` syntax is invented here.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import struct
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram, CoreType, Operation, ValueRef
+from pypto.lowering.cpu import canonical_dtype, flatten_values
+from pypto.lowering.gpu import (
+    GPU_COMMON_BACKEND,
+    GPU_IR_VERSION,
+    GPU_LOWERING_VERSION,
+    GPU_PLAN_VERSION,
+    GpuProgram,
+    lower_gpu_common,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import frozen_mapping, mapping_copy, sha256_text
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+CUDA_ARTIFACT_FORMAT = "pypto-x.cuda.ptx"
+DEFAULT_ARTIFACT_FORMAT = CUDA_ARTIFACT_FORMAT
+CUDA_BACKEND = "cuda.ptx"
+CUDA_PTX_VERSION = "8.0"
+DEFAULT_PTX_TARGET = "sm_80"
+CUDA_LOWERING_VERSION = 1
+_PTX_TARGET_RE = re.compile(r"^sm_[0-9]+$")
+
+
+class CudaPtxError(ValueError):
+    """Base error for CUDA target lowering and artifact validation."""
+
+
+class CudaPtxUnsupportedError(CudaPtxError):
+    """A common GPU operation that this initial CUDA adapter cannot emit."""
+
+
+class CudaPtxArtifactError(CudaPtxError):
+    """Malformed, tampered or incompatible CUDA/PTX artifact."""
+
+
+def _plain(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def _shape_count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= int(dimension)
+    return result
+
+
+def _f32_bits(value: Any) -> int:
+    raw = struct.pack("<f", float(value))
+    return struct.unpack("<I", raw)[0]
+
+
+def _f32_literal(value: Any) -> str:
+    return "0f{:08X}".format(_f32_bits(value))
+
+
+def _u64(value: int) -> str:
+    return str(int(value))
+
+
+def _dtype_itemsize(dtype: str) -> int:
+    dtype = canonical_dtype(dtype)
+    if dtype in ("float32", "int32", "uint32"):
+        return 4
+    if dtype in ("bf16", "float16", "int16", "uint16"):
+        return 2
+    if dtype in ("int8", "uint8", "bool"):
+        return 1
+    if dtype in ("int64", "uint64", "float64"):
+        return 8
+    raise CudaPtxUnsupportedError("CUDA PTX adapter does not support dtype {!r}".format(dtype))
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _operation_bindings(operation: Operation) -> Tuple[Mapping[str, Any], ...]:
+    bindings = []
+    for ref in operation.inputs:
+        bindings.append(
+            {
+                "name": ref.name,
+                "kind": "tensor" if _is_tensor(ref.type) else "scalar",
+                "dtype": canonical_dtype(ref.type.dtype),
+                "role": "input",
+            }
+        )
+    output = operation.outputs[0]
+    bindings.append(
+        {
+            "name": output.name,
+            "kind": "tensor" if _is_tensor(output.type) else "scalar",
+            "dtype": canonical_dtype(output.type.dtype),
+            "role": "output",
+        }
+    )
+    return tuple(bindings)
+
+
+def _all_bindings(program: GpuProgram) -> Tuple[Tuple[Mapping[str, Any], ...], ...]:
+    function = next(function for function in program.program.functions if function.name == program.entrypoint)
+    return tuple(_operation_bindings(operation) for operation in function.body.operations)
+
+
+class _Kernel:
+    def __init__(self, index: int, operation: Operation, plan: Any) -> None:
+        self.index = index
+        self.operation = operation
+        self.plan = plan
+        self.lines = []
+        self.label_counter = 0
+
+    def line(self, text: str = "") -> None:
+        self.lines.append(text)
+
+    def label(self, prefix: str) -> str:
+        value = "{}_{}".format(prefix, self.label_counter)
+        self.label_counter += 1
+        return value
+
+    @property
+    def output(self) -> ValueRef:
+        return self.operation.outputs[0]
+
+    def param_declarations(self) -> Tuple[str, ...]:
+        declarations = []
+        for index, ref in enumerate(self.operation.inputs):
+            if _is_tensor(ref.type):
+                declarations.append("    .param .u64 p{}".format(index))
+            elif _is_scalar(ref.type):
+                dtype = canonical_dtype(ref.type.dtype)
+                if dtype == "bf16":
+                    declarations.append("    .param .b16 p{}".format(index))
+                elif dtype in ("float32", "float16"):
+                    declarations.append("    .param .f32 p{}".format(index))
+                else:
+                    declarations.append("    .param .u64 p{}".format(index))
+            else:
+                raise CudaPtxUnsupportedError("unsupported kernel parameter kind {!r}".format(ref.type.kind))
+        # Every operation result is written through a device pointer, even
+        # when the Core IR result is a scalar.
+        declarations.append("    .param .u64 p{}".format(len(self.operation.inputs)))
+        return tuple(declarations)
+
+    def preamble(self) -> None:
+        self.line("    .reg .pred %p<16>;")
+        self.line("    .reg .b32 %r<16>;")
+        self.line("    .reg .b64 %rd<64>;")
+        self.line("    .reg .f32 %f<32>;")
+        self.line("    .reg .b16 %rs<8>;")
+
+    def u64_special(self, target: int, special: str, temp: int) -> None:
+        self.line("    mov.u32 %r{}, %{};".format(temp, special))
+        self.line("    cvt.u64.u32 %rd{}, %r{};".format(target, temp,))
+
+    def linear_thread_index(self) -> None:
+        # A logical GPU common workgroup may be 1-, 2- or 3-dimensional.  Use
+        # compile-time launch extents for the flattening.  This avoids relying
+        # on optional grid-dimension special registers in conservative PTX
+        # accepted by older forward-JIT paths.
+        self.u64_special(1, "ctaid.x", 0)
+        self.u64_special(2, "ctaid.y", 1)
+        self.u64_special(3, "ctaid.z", 2)
+        self.u64_special(8, "tid.x", 3)
+        self.u64_special(9, "tid.y", 4)
+        self.u64_special(10, "tid.z", 5)
+        grid = self.plan.geometry.grid
+        workgroup = self.plan.geometry.workgroup
+        self.line("    mov.u64 %rd11, {};".format(grid.y))
+        self.line("    mul.lo.u64 %rd11, %rd3, %rd11;")
+        self.line("    add.u64 %rd11, %rd11, %rd2;")
+        self.line("    mov.u64 %rd12, {};".format(grid.x))
+        self.line("    mul.lo.u64 %rd11, %rd11, %rd12;")
+        self.line("    add.u64 %rd11, %rd11, %rd1;")
+        self.line("    mov.u64 %rd12, {};".format(workgroup.count))
+        self.line("    mul.lo.u64 %rd11, %rd11, %rd12;")
+        self.line("    mov.u64 %rd12, {};".format(workgroup.x))
+        self.line("    mul.lo.u64 %rd13, %rd9, %rd12;")
+        self.line("    add.u64 %rd13, %rd13, %rd8;")
+        self.line("    mov.u64 %rd12, {};".format(workgroup.x * workgroup.y))
+        self.line("    mul.lo.u64 %rd14, %rd10, %rd12;")
+        self.line("    add.u64 %rd13, %rd13, %rd14;")
+        self.line("    add.u64 %rd0, %rd11, %rd13;")
+
+    def guard_count(self, count: int) -> str:
+        done = self.label("DONE")
+        self.line("    setp.ge.u64 %p0, %rd0, {};".format(_u64(count)))
+        self.line("    @%p0 bra {};".format(done))
+        return done
+
+    def address(self, pointer_param: int, index_register: int, itemsize: int, result_register: int) -> None:
+        self.line("    ld.param.u64 %rd{}, [p{}];".format(result_register, pointer_param))
+        self.line("    mul.lo.u64 %rd{}, %rd{}, {};".format(result_register + 1, index_register, itemsize))
+        self.line("    add.u64 %rd{}, %rd{}, %rd{};".format(result_register, result_register, result_register + 1))
+
+    def load_value(self, ref: ValueRef, param_index: int, index_register: int, result_register: int, float_register: int) -> None:
+        dtype = canonical_dtype(ref.type.dtype)
+        if _is_scalar(ref.type):
+            if dtype == "bf16":
+                self.line("    ld.param.b16 %rs0, [p{}];".format(param_index))
+                self.line("    cvt.f32.bf16 %f{}, %rs0;".format(float_register))
+            else:
+                self.line("    ld.param.f32 %f{}, [p{}];".format(float_register, param_index))
+            return
+        self.address(param_index, index_register, _dtype_itemsize(dtype), result_register)
+        if dtype == "bf16":
+            self.line("    ld.global.b16 %rs0, [%rd{}];".format(result_register))
+            self.line("    cvt.f32.bf16 %f{}, %rs0;".format(float_register))
+        elif dtype == "float32":
+            self.line("    ld.global.f32 %f{}, [%rd{}];".format(float_register, result_register))
+        else:
+            raise CudaPtxUnsupportedError("PTX load does not support dtype {!r}".format(dtype))
+
+    def store_value(self, ref: ValueRef, param_index: int, index_register: int, float_register: int, address_register: int = 20) -> None:
+        dtype = canonical_dtype(ref.type.dtype)
+        if not _is_tensor(ref.type) and not _is_scalar(ref.type):
+            raise CudaPtxUnsupportedError("PTX store does not support {!r}".format(ref.type.kind))
+        self.address(param_index, index_register, _dtype_itemsize(dtype), address_register)
+        if dtype == "bf16":
+            # cvt.rn.bf16.f32 is explicitly round-to-nearest-even in PTX.
+            self.line("    cvt.rn.bf16.f32 %rs1, %f{};".format(float_register))
+            self.line("    st.global.b16 [%rd{}], %rs1;".format(address_register))
+        elif dtype == "float32":
+            self.line("    st.global.f32 [%rd{}], %f{};".format(address_register, float_register))
+        else:
+            raise CudaPtxUnsupportedError("PTX store does not support dtype {!r}".format(dtype))
+
+    def emit_elementwise(self) -> None:
+        self.linear_thread_index()
+        done = self.guard_count(_shape_count(self.plan.shape))
+        name = self.plan.operation
+        output = self.output
+        if name == "constant":
+            raw = self.operation.attributes.get("values", self.operation.attributes.get("value"))
+            values = list(flatten_values(raw))
+            if len(values) != _shape_count(self.plan.shape):
+                raise CudaPtxError("constant value count does not match output shape")
+            self.line("    mov.u64 %rd13, %rd0;")
+            # A constant tensor is emitted as one deterministic immediate per
+            # lane.  This is a correctness bootstrap, not a compact constant
+            # memory strategy.
+            for index, value in enumerate(values or [0]):
+                skip = self.label("CONST_SKIP")
+                self.line("    setp.ne.u64 %p1, %rd0, {};".format(index))
+                self.line("    @%p1 bra {};".format(skip))
+                self.line("    mov.f32 %f0, {};".format(_f32_literal(value)))
+                self.store_value(output, len(self.operation.inputs), 0, 0)
+                self.line("{}:".format(skip))
+        else:
+            for value_index, ref in enumerate(self.operation.inputs):
+                self.load_value(ref, value_index, 0, 14 + value_index * 2, value_index)
+            if name == "identity":
+                self.line("    mov.f32 %f0, %f0;")
+            elif name in ("add", "sub", "mul", "div"):
+                op = {"add": "add", "sub": "sub", "mul": "mul", "div": "div"}[name]
+                self.line("    {}.f32 %f0, %f0, %f1;".format(op))
+            elif name == "neg":
+                self.line("    neg.f32 %f0, %f0;")
+            else:
+                raise CudaPtxUnsupportedError("unsupported elementwise operation {!r}".format(name))
+            self.store_value(output, len(self.operation.inputs), 0, 0)
+        self.line("{}:".format(done))
+
+    def _coord_from_linear(self, source_register: int, stride: int, dimension: int, result: int) -> None:
+        self.line("    mov.u64 %rd{}, {};".format(result + 1, stride))
+        self.line("    div.u64 %rd{}, %rd{}, %rd{};".format(result, source_register, result + 1))
+        self.line("    mov.u64 %rd{}, {};".format(result + 1, dimension))
+        self.line("    rem.u64 %rd{}, %rd{}, %rd{};".format(result, result, result + 1))
+
+    def emit_reduction(self) -> None:
+        reduction = self.plan.reduction
+        self.linear_thread_index()
+        done = self.guard_count(reduction.output_elements)
+        self.line("    mov.f32 %f0, {};".format(_f32_literal(0.0 if self.plan.operation == "reduce_sum" else float("-inf"))))
+        self.line("    mov.u64 %rd3, 0;")
+        red_done = self.label("RED_DONE")
+        red_loop = self.label("RED_LOOP")
+        self.line("    mov.u64 %rd4, {};".format(reduction.reduction_size))
+        self.line("{}:".format(red_loop))
+        self.line("    setp.ge.u64 %p1, %rd3, %rd4;")
+        self.line("    @%p1 bra {};".format(red_done))
+        self.line("    mov.u64 %rd13, 0;")
+        input_shape = tuple(reduction.input_shape)
+        input_strides = _strides(input_shape)
+        axes = set(reduction.axes)
+        nonreduced_index = 0
+        for axis, (dimension, stride) in enumerate(zip(input_shape, input_strides)):
+            if axis in axes:
+                self._coord_from_linear(3, _strides(tuple(input_shape[a] for a in reduction.axes))[list(reduction.axes).index(axis)], dimension, 30)
+            else:
+                out_axis = axis if reduction.keepdims else nonreduced_index
+                out_shape = tuple(reduction.output_shape)
+                out_stride = _strides(out_shape)[out_axis] if out_shape else 1
+                self._coord_from_linear(0, out_stride, dimension, 31)
+                nonreduced_index += 1
+            coord_reg = 30 if axis in axes else 31
+            self.line("    mul.lo.u64 %rd32, %rd{}, {};".format(coord_reg, stride))
+            self.line("    add.u64 %rd13, %rd13, %rd32;")
+        self.load_value(self.operation.inputs[0], 0, 13, 14, 1)
+        if self.plan.operation == "reduce_sum":
+            self.line("    add.f32 %f0, %f0, %f1;")
+        else:
+            self.line("    max.f32 %f0, %f0, %f1;")
+        self.line("    add.u64 %rd3, %rd3, 1;")
+        self.line("    bra {};".format(red_loop))
+        self.line("{}:".format(red_done))
+        self.store_value(self.output, len(self.operation.inputs), 0, 0)
+        self.line("{}:".format(done))
+
+    def emit_matmul(self) -> None:
+        matmul = self.plan.matmul
+        self.linear_thread_index()
+        done = self.guard_count(matmul.output_elements)
+        loop = self.label("MM_OUT_LOOP")
+        self.line("{}:".format(loop))
+        # The common plan is allowed to use a logical tile larger than the
+        # concrete workgroup.  Striding the flat output domain lets a small
+        # correctness workgroup cover the whole tile without changing the
+        # vendor-neutral plan or ABI.
+        self.line("    mov.u64 %rd30, %rd0;")
+        self.line("    mov.u64 %rd31, {};".format(matmul.n))
+        self.line("    div.u64 %rd7, %rd30, %rd31;")
+        self.line("    rem.u64 %rd8, %rd30, %rd31;")
+        self.line("    mov.f32 %f0, 0f00000000;")
+        self.line("    mov.u64 %rd9, 0;")
+        inner_loop = self.label("MM_LOOP")
+        self.line("{}:".format(inner_loop))
+        self.line("    setp.ge.u64 %p2, %rd9, {};".format(matmul.k))
+        acc_done = self.label("MM_ACC_DONE")
+        self.line("    @%p2 bra {};".format(acc_done))
+        self.line("    mul.lo.u64 %rd10, %rd7, {};".format(matmul.k))
+        self.line("    add.u64 %rd10, %rd10, %rd9;")
+        self.load_value(self.operation.inputs[0], 0, 10, 14, 1)
+        self.line("    mul.lo.u64 %rd11, %rd9, {};".format(matmul.n))
+        self.line("    add.u64 %rd11, %rd11, %rd8;")
+        self.load_value(self.operation.inputs[1], 1, 11, 16, 2)
+        self.line("    mul.f32 %f3, %f1, %f2;")
+        self.line("    add.f32 %f0, %f0, %f3;")
+        self.line("    add.u64 %rd9, %rd9, 1;")
+        self.line("    bra {};".format(inner_loop))
+        self.line("{}:".format(acc_done))
+        self.store_value(self.output, 2, 0, 0)
+        self.line("    add.u64 %rd0, %rd0, {};".format(self.plan.geometry.logical_threads))
+        self.line("    setp.lt.u64 %p3, %rd0, {};".format(matmul.output_elements))
+        self.line("    @%p3 bra {};".format(loop))
+        self.line("{}:".format(done))
+
+    def render(self) -> str:
+        self.line(".visible .entry px_op{}(".format(self.index))
+        declarations = self.param_declarations()
+        if declarations:
+            self.line(",\n".join(declarations))
+        self.line(") {")
+        self.preamble()
+        if self.plan.plan_kind == "matmul":
+            self.emit_matmul()
+        elif self.plan.plan_kind == "reduction":
+            self.emit_reduction()
+        else:
+            self.emit_elementwise()
+        self.line("    ret;")
+        self.line("}")
+        return "\n".join(self.lines)
+
+
+def _strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    result = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        result[index] = running
+        running *= int(shape[index])
+    return tuple(result)
+
+
+def render_ptx(gpu_program: GpuProgram, ptx_target: str = DEFAULT_PTX_TARGET, ptx_version: str = CUDA_PTX_VERSION) -> str:
+    """Render deterministic PTX for a validated GPU common program."""
+
+    if not isinstance(gpu_program, GpuProgram):
+        raise TypeError("render_ptx requires GpuProgram")
+    if not isinstance(ptx_target, str) or not _PTX_TARGET_RE.fullmatch(ptx_target):
+        raise CudaPtxError("PTX target must have the form sm_<number>")
+    try:
+        kernels = []
+        function = next(function for function in gpu_program.program.functions if function.name == gpu_program.entrypoint)
+        for index, (operation, plan) in enumerate(zip(function.body.operations, gpu_program.plans)):
+            kernels.append(_Kernel(index, operation, plan).render())
+    except StopIteration as exc:
+        raise CudaPtxError("GPU entrypoint is missing") from exc
+    return ".version {}\n.target {}\n.address_size 64\n\n{}\n".format(
+        str(ptx_version), ptx_target, "\n\n".join(kernels)
+    )
+
+
+@dataclass(frozen=True)
+class CudaProgram:
+    """CUDA target IR: common plans plus immutable PTX and binding metadata."""
+
+    gpu_program: GpuProgram
+    ptx: str
+    ptx_target: str
+    ptx_version: str
+    device: Mapping[str, Any]
+    jit: Mapping[str, Any]
+    bindings: Tuple[Tuple[Mapping[str, Any], ...], ...]
+
+    @property
+    def program(self) -> CoreProgram:
+        return self.gpu_program.program
+
+    @property
+    def target(self) -> TargetSpec:
+        return self.gpu_program.target
+
+    @property
+    def entrypoint(self) -> str:
+        return self.gpu_program.entrypoint
+
+    @property
+    def plan_digest(self) -> str:
+        return self.gpu_program.plan_digest
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "cuda_lowering_version": CUDA_LOWERING_VERSION,
+            "ptx_target": self.ptx_target,
+            "ptx_version": self.ptx_version,
+            "gpu_program": self.gpu_program.to_dict(),
+            "ptx_digest": hashlib.sha256(self.ptx.encode("utf-8")).hexdigest(),
+            "device": mapping_copy(self.device),
+            "jit": mapping_copy(self.jit),
+            "bindings": [[mapping_copy(binding) for binding in sequence] for sequence in self.bindings],
+        }
+
+
+class CudaPtxCompiler:
+    """Compiler facade consuming only the existing vendor-neutral GPU plans."""
+
+    name = CUDA_BACKEND
+
+    def __init__(
+        self,
+        driver: Any = None,
+        device_index: int = 0,
+        ptx_target: str = DEFAULT_PTX_TARGET,
+        ptx_version: str = CUDA_PTX_VERSION,
+        probe_jit: bool = False,
+    ) -> None:
+        if not isinstance(ptx_target, str) or not _PTX_TARGET_RE.fullmatch(ptx_target):
+            raise ValueError("ptx_target must have the form sm_<number>")
+        self.driver = driver
+        self.device_index = int(device_index)
+        self.ptx_target = ptx_target
+        self.ptx_version = str(ptx_version)
+        self.probe_jit = bool(probe_jit)
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> CudaProgram:
+        gpu_program = lower_gpu_common(program, target)
+        ptx = render_ptx(gpu_program, self.ptx_target, self.ptx_version)
+        device = {"status": "not_probed", "index": self.device_index}
+        jit = {"status": "deferred", "info_log": "", "error_log": ""}
+        if self.driver is not None and hasattr(self.driver, "device_info"):
+            info = self.driver.device_info(self.device_index)
+            device = {"status": "available", **mapping_copy(info.to_dict() if hasattr(info, "to_dict") else info)}
+            if self.probe_jit and hasattr(self.driver, "module_load_data"):
+                context = None
+                try:
+                    # cuModuleLoadDataEx needs a current context on the real
+                    # Driver API.  Fake drivers can omit context_create.
+                    if hasattr(self.driver, "context_create"):
+                        context = self.driver.context_create(self.device_index)
+                    module = self.driver.module_load_data(ptx)
+                    jit = {
+                        "status": "validated",
+                        "info_log": getattr(module, "info_log", ""),
+                        "error_log": getattr(module, "error_log", ""),
+                    }
+                    if hasattr(module, "close"):
+                        module.close()
+                finally:
+                    if context is not None and hasattr(context, "close"):
+                        context.close()
+        bindings = _all_bindings(gpu_program)
+        return CudaProgram(gpu_program, ptx, self.ptx_target, self.ptx_version, device, jit, bindings)
+
+    def compile(self, target_ir: CudaProgram, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, CudaProgram):
+            raise TypeError("CUDA compile() requires CudaProgram from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        target_ir.gpu_program.validate()
+        program_json = target_ir.program.canonical_json()
+        program_data = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        target_data = target_ir.target.to_dict()
+        ptx_digest = hashlib.sha256(target_ir.ptx.encode("utf-8")).hexdigest()
+        envelope = {
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "backend": CUDA_BACKEND,
+            "cuda_lowering_version": CUDA_LOWERING_VERSION,
+            "gpu_common_backend": GPU_COMMON_BACKEND,
+            "gpu_ir_version": GPU_IR_VERSION,
+            "lowering_version": GPU_LOWERING_VERSION,
+            "plan_version": GPU_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "target": target_data,
+            "program": program_data,
+            "program_digest": program_digest,
+            "gpu_program": target_ir.gpu_program.to_dict(),
+            "plan_digest": target_ir.plan_digest,
+            "ptx": target_ir.ptx,
+            "ptx_digest": ptx_digest,
+            "ptx_target": target_ir.ptx_target,
+            "ptx_version": target_ir.ptx_version,
+            "device": _plain(target_ir.device),
+            "jit": _plain(target_ir.jit),
+            "bindings": _plain(target_ir.bindings),
+        }
+        if options is not None:
+            envelope["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "metadata": _plain(options.metadata),
+                "extra": _plain(options.extra),
+            }
+        payload = json.dumps(
+            envelope, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")
+        ).encode("utf-8")
+        payload_digest = hashlib.sha256(payload).hexdigest()
+        metadata = {
+            "backend": CUDA_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "cuda_lowering_version": CUDA_LOWERING_VERSION,
+            "gpu_common_backend": GPU_COMMON_BACKEND,
+            "gpu_ir_version": GPU_IR_VERSION,
+            "lowering_version": GPU_LOWERING_VERSION,
+            "plan_version": GPU_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "program_digest": program_digest,
+            "plan_digest": target_ir.plan_digest,
+            "ptx_digest": ptx_digest,
+            "payload_digest": payload_digest,
+            "target_digest": sha256_text(target_data),
+            "ptx_target": target_ir.ptx_target,
+            "ptx_version": target_ir.ptx_version,
+            "device": _plain(target_ir.device),
+            "jit": _plain(target_ir.jit),
+            "geometry": [plan.geometry.to_dict() for plan in target_ir.gpu_program.plans],
+            "bindings": _plain(target_ir.bindings),
+            "dtypes": sorted(set(plan.dtype for plan in target_ir.gpu_program.plans)),
+            "layouts": sorted(set(plan.layout for plan in target_ir.gpu_program.plans)),
+        }
+        if options is not None:
+            option_metadata = _plain(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError("compile option metadata uses reserved CUDA keys: {}".format(
+                    ", ".join(sorted(reserved))
+                ))
+            metadata.update(option_metadata)
+            metadata["compile_options"] = envelope["compile_options"]
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            payload=payload,
+            metadata=metadata,
+        )
+        artifact.validate()
+        return artifact
+
+
+CudaCompiler = CudaPtxCompiler
+CUDACompiler = CudaPtxCompiler
+
+
+def compile_cuda_ptx(program: CoreProgram, target: TargetSpec, options: Optional[CompileOptions] = None) -> Artifact:
+    compiler = CudaPtxCompiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+def _required_envelope() -> set:
+    return {
+        "artifact_payload_version", "backend", "cuda_lowering_version", "gpu_common_backend",
+        "gpu_ir_version", "lowering_version", "plan_version", "entrypoint", "target", "program",
+        "program_digest", "gpu_program", "plan_digest", "ptx", "ptx_digest", "ptx_target",
+        "ptx_version", "device", "jit", "bindings",
+    }
+
+
+def _decode_cuda_artifact(artifact: Artifact) -> CudaProgram:
+    """Strictly decode and re-derive every derived CUDA artifact field."""
+
+    if not isinstance(artifact, Artifact):
+        raise CudaPtxArtifactError("CUDA runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CudaPtxArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.payload is None:
+        raise CudaPtxArtifactError("CUDA artifact requires an inline payload")
+    try:
+        decoded = json.loads(bytes(artifact.payload).decode("utf-8"))
+    except Exception as exc:
+        raise CudaPtxArtifactError("CUDA payload is not UTF-8 JSON") from exc
+    if not isinstance(decoded, dict) or set(decoded) - (_required_envelope() | {"compile_options"}) or not _required_envelope().issubset(decoded):
+        raise CudaPtxArtifactError("CUDA payload has unknown or missing fields")
+    canonical = json.dumps(decoded, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    if canonical != bytes(artifact.payload):
+        raise CudaPtxArtifactError("CUDA payload is not canonical JSON")
+    metadata = mapping_copy(artifact.metadata)
+    required_metadata = {
+        "backend", "artifact_payload_version", "cuda_lowering_version", "gpu_common_backend", "gpu_ir_version",
+        "lowering_version", "plan_version", "entrypoint", "program_digest", "plan_digest", "ptx_digest",
+        "payload_digest", "target_digest", "ptx_target", "ptx_version", "device", "jit", "geometry",
+        "bindings", "dtypes", "layouts",
+    }
+    if not required_metadata.issubset(metadata):
+        raise CudaPtxArtifactError("CUDA artifact metadata has unknown or missing fields")
+    option_metadata = {}
+    if "compile_options" in decoded:
+        options = decoded["compile_options"]
+        if not isinstance(options, dict) or set(options) != {"artifact_format", "abi_version", "metadata", "extra"}:
+            raise CudaPtxArtifactError("CUDA compile options are malformed")
+        if not isinstance(options["metadata"], dict) or not isinstance(options["extra"], dict):
+            raise CudaPtxArtifactError("CUDA compile option metadata/extra must be objects")
+        option_metadata = options["metadata"]
+    allowed_metadata = required_metadata | {"compile_options"} | set(option_metadata)
+    if set(metadata) - allowed_metadata:
+        raise CudaPtxArtifactError("CUDA artifact metadata has unknown fields")
+    for key, value in option_metadata.items():
+        if metadata.get(key) != value:
+            raise CudaPtxArtifactError("CUDA option metadata does not match payload")
+    payload_digest = hashlib.sha256(bytes(artifact.payload)).hexdigest()
+    if metadata.get("payload_digest") != payload_digest or artifact.content_digest != payload_digest:
+        raise CudaPtxArtifactError("CUDA payload digest mismatch")
+    if decoded["backend"] != CUDA_BACKEND or metadata["backend"] != CUDA_BACKEND:
+        raise CudaPtxArtifactError("CUDA backend mismatch")
+    if decoded["artifact_payload_version"] != ARTIFACT_PAYLOAD_VERSION or metadata["artifact_payload_version"] != ARTIFACT_PAYLOAD_VERSION:
+        raise CudaPtxArtifactError("unsupported CUDA artifact payload version")
+    if decoded["cuda_lowering_version"] != CUDA_LOWERING_VERSION or metadata["cuda_lowering_version"] != CUDA_LOWERING_VERSION:
+        raise CudaPtxArtifactError("unsupported CUDA lowering version")
+    if decoded["gpu_common_backend"] != GPU_COMMON_BACKEND or metadata["gpu_common_backend"] != GPU_COMMON_BACKEND:
+        raise CudaPtxArtifactError("GPU common backend mismatch")
+    if decoded["target"] != artifact.target.to_dict() or metadata["target_digest"] != sha256_text(decoded["target"]):
+        raise CudaPtxArtifactError("CUDA artifact target mismatch")
+    if decoded["entrypoint"] != artifact.entrypoint or metadata["entrypoint"] != artifact.entrypoint:
+        raise CudaPtxArtifactError("CUDA artifact entrypoint mismatch")
+    program = CoreProgram.from_dict(decoded["program"])
+    program_json = program.canonical_json()
+    program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+    if decoded["program"] != program.to_dict() or decoded["program_digest"] != program_digest or metadata["program_digest"] != program_digest:
+        raise CudaPtxArtifactError("CUDA program digest mismatch")
+    try:
+        gpu_program = lower_gpu_common(
+            program,
+            artifact.target,
+            decoded["gpu_program"]["entrypoint"],
+            required_capabilities=decoded["gpu_program"].get("required_capabilities", ()),
+            specialization=decoded["gpu_program"].get("specialization", {}),
+        )
+    except Exception as exc:
+        raise CudaPtxArtifactError("GPU common plan is invalid: {}".format(exc)) from exc
+    if decoded["gpu_program"] != gpu_program.to_dict() or decoded["plan_digest"] != gpu_program.plan_digest:
+        raise CudaPtxArtifactError("CUDA plan digest mismatch")
+    ptx = decoded["ptx"]
+    ptx_digest = hashlib.sha256(ptx.encode("utf-8")).hexdigest()
+    if decoded["ptx_digest"] != ptx_digest or metadata["ptx_digest"] != ptx_digest:
+        raise CudaPtxArtifactError("CUDA PTX digest mismatch")
+    expected_ptx = render_ptx(gpu_program, decoded["ptx_target"], decoded["ptx_version"])
+    if ptx != expected_ptx:
+        raise CudaPtxArtifactError("CUDA PTX does not match the canonical GPU plan")
+    expected_bindings = _all_bindings(gpu_program)
+    if tuple(tuple(mapping_copy(item) for item in group) for group in decoded["bindings"]) != expected_bindings:
+        raise CudaPtxArtifactError("CUDA kernel bindings do not match Core IR")
+    expected_geometry = [plan.geometry.to_dict() for plan in gpu_program.plans]
+    if metadata["geometry"] != expected_geometry or metadata["bindings"] != _plain(expected_bindings):
+        raise CudaPtxArtifactError("CUDA geometry/binding metadata mismatch")
+    if metadata["ptx_target"] != decoded["ptx_target"] or metadata["ptx_version"] != decoded["ptx_version"]:
+        raise CudaPtxArtifactError("CUDA PTX target metadata mismatch")
+    if metadata["device"] != decoded["device"] or metadata["jit"] != decoded["jit"]:
+        raise CudaPtxArtifactError("CUDA device/JIT metadata mismatch")
+    if metadata["dtypes"] != sorted(set(plan.dtype for plan in gpu_program.plans)) or metadata["layouts"] != sorted(set(plan.layout for plan in gpu_program.plans)):
+        raise CudaPtxArtifactError("CUDA dtype/layout metadata mismatch")
+    if "compile_options" in decoded:
+        options = decoded["compile_options"]
+        if metadata.get("compile_options") != options or artifact.format != options["artifact_format"] or artifact.abi_version != options["abi_version"]:
+            raise CudaPtxArtifactError("CUDA artifact format/ABI options mismatch")
+    elif artifact.format != DEFAULT_ARTIFACT_FORMAT or artifact.abi_version != ABI_VERSION:
+        raise CudaPtxArtifactError("CUDA artifact format/ABI mismatch")
+    return CudaProgram(
+        gpu_program, ptx, decoded["ptx_target"], decoded["ptx_version"],
+        frozen_mapping(decoded["device"]), frozen_mapping(decoded["jit"]),
+        tuple(tuple(frozen_mapping(item) for item in group) for group in decoded["bindings"]),
+    )
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION", "CUDA_ARTIFACT_FORMAT", "CUDA_BACKEND", "CUDA_LOWERING_VERSION",
+    "CUDACompiler", "CudaCompiler", "CudaPtxArtifactError", "CudaPtxCompiler", "CudaPtxError",
+    "CudaPtxUnsupportedError", "CudaProgram", "DEFAULT_ARTIFACT_FORMAT", "DEFAULT_PTX_TARGET",
+    "compile_cuda_ptx", "render_ptx",
+]
diff --git a/python/tests/ut/pypto_x/test_cuda_driver_ptx.py b/python/tests/ut/pypto_x/test_cuda_driver_ptx.py
