index 000000000..7e2cec994
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_cuda_driver_ptx.py
@@ -0,0 +1,186 @@
+"""CUDA Driver/PTX bootstrap tests; no CUDA toolkit or model is required."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+
+import pytest
+
+from pypto.abi import GpuLaunchRequest, TensorDesc
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cuda import CudaDeviceInfo
+from pypto.backends.cuda.runtime import CudaArtifactError, CudaRuntime
+from pypto.compiler import Artifact
+from pypto.compiler.targets.cuda import CudaPtxCompiler, CudaPtxArtifactError, render_ptx
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+
+
+def _program(operation_name="add", dtype="float32", shape=(5,)):
+    value_type = CoreType.tensor(dtype, shape)
+    x = ValueRef("x", value_type)
+    y = ValueRef("y", value_type)
+    z = ValueRef("z", value_type)
+    operation = Operation(operation_name, (x, y), (z,))
+    return CoreProgram(functions=(CoreFunction("main", (x, y), (z,), Region((operation,))),))
+
+
+class _FakeContext:
+    def __init__(self):
+        self.closed = False
+
+    def close(self):
+        self.closed = True
+
+
+class _FakeModule:
+    info_log = "fake-jit-info"
+    error_log = ""
+
+    def __init__(self, driver):
+        self.driver = driver
+        self.closed = False
+
+    def get_function(self, name):
+        self.driver.calls.append(("get_function", name))
+        return name
+
+    def close(self):
+        self.closed = True
+        self.driver.calls.append(("module_close",))
+
+
+class _FakeDriver:
+    def __init__(self):
+        self.calls = []
+        self.next_pointer = 1000
+        self.memory = {}
+
+    def device_info(self, index=0):
+        self.calls.append(("device_info", index))
+        return CudaDeviceInfo(index, "Fake GPU", 12, 0, 16 * 1024**3)
+
+    def context_create(self, index=0):
+        self.calls.append(("context_create", index))
+        return _FakeContext()
+
+    def module_load_data(self, ptx):
+        self.calls.append(("module_load_data", hashlib.sha256(ptx.encode()).hexdigest()))
+        return _FakeModule(self)
+
+    def mem_alloc(self, size):
+        self.next_pointer += 1
+        self.memory[self.next_pointer] = bytearray(max(1, size))
+        self.calls.append(("mem_alloc", size))
+        return self.next_pointer
+
+    def mem_free(self, pointer):
+        self.calls.append(("mem_free", pointer))
+        self.memory.pop(pointer, None)
+
+    def memcpy_htod(self, pointer, payload):
+        self.calls.append(("memcpy_htod", len(payload)))
+        self.memory[pointer][: len(payload)] = payload
+
+    def memcpy_dtoh(self, pointer, size):
+        self.calls.append(("memcpy_dtoh", size))
+        return bytes(self.memory[pointer][:size])
+
+    def launch_kernel(self, function, grid, block, parameters, stream=None, shared_memory=0):
+        self.calls.append(("launch_kernel", function, tuple(grid), tuple(block), len(parameters)))
+
+    def context_synchronize(self):
+        self.calls.append(("context_synchronize",))
+
+
+def _compile(program, driver=None, probe_jit=False):
+    compiler = CudaPtxCompiler(driver=driver, probe_jit=probe_jit)
+    target_ir = compiler.lower(program, TARGET)
+    return compiler, target_ir, compiler.compile(target_ir)
+
+
+def test_cuda_ptx_is_deterministic_and_bf16_conversion_is_explicit():
+    _, first_ir, first = _compile(_program())
+    _, second_ir, second = _compile(_program())
+    assert first.payload == second.payload
+    assert first_ir.ptx == second_ir.ptx
+    _, bf_ir, _ = _compile(_program(dtype="bf16"))
+    assert "cvt.f32.bf16" in bf_ir.ptx
+    assert "cvt.rn.bf16.f32" in bf_ir.ptx
+    assert ".target sm_80" in bf_ir.ptx
+
+
+def test_fake_driver_records_device_cc_and_jit_metadata():
+    driver = _FakeDriver()
+    _, target_ir, artifact = _compile(_program(), driver=driver, probe_jit=True)
+    assert target_ir.device["compute_capability"] == "12.0"
+    assert target_ir.jit["status"] == "validated"
+    assert target_ir.jit["info_log"] == "fake-jit-info"
+    assert artifact.metadata["device"]["compute_capability"] == "12.0"
+    assert artifact.metadata["jit"]["info_log"] == "fake-jit-info"
+    assert ("context_create", 0) in driver.calls
+    assert any(call[0] == "module_load_data" for call in driver.calls)
+
+
+def test_cuda_artifact_fails_closed_on_ptx_and_binding_tamper():
+    _, target_ir, artifact = _compile(_program())
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    payload["ptx"] += "\n// tampered\n"
+    rebuilt_payload = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=rebuilt_payload,
+        metadata=dict(artifact.metadata, payload_digest=hashlib.sha256(rebuilt_payload).hexdigest()),
+    )
+    with pytest.raises((CudaPtxArtifactError, CudaArtifactError), match="PTX|canonical|digest"):
+        CudaRuntime().load(tampered)
+
+    payload = json.loads(artifact.payload.decode("utf-8"))
+    payload["bindings"][0][0]["name"] = "wrong"
+    rebuilt_payload = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=rebuilt_payload,
+        metadata=dict(artifact.metadata, payload_digest=hashlib.sha256(rebuilt_payload).hexdigest()),
+    )
+    with pytest.raises((CudaPtxArtifactError, CudaArtifactError), match="binding|digest"):
+        CudaRuntime().load(tampered)
+
+
+def test_fake_driver_launch_validates_geometry_and_uses_driver_abi():
+    driver = _FakeDriver()
+    _, target_ir, artifact = _compile(_program(), driver=driver)
+    left = HostTensor("float32", (5,), [1, 2, 3, 4, 5])
+    right = HostTensor("float32", (5,), [10, 20, 30, 40, 50])
+    output = HostTensor.zeros("float32", (5,))
+    request = GpuLaunchRequest(
+        artifact,
+        geometries=(target_ir.gpu_program.plans[0].geometry,),
+        inputs=(
+            TensorDesc("float32", (5,), device="gpu", handle=left, readonly=True),
+            TensorDesc("float32", (5,), device="gpu", handle=right, readonly=True),
+        ),
+        outputs=(TensorDesc("float32", (5,), device="gpu", handle=output),),
+    )
+    runtime = CudaRuntime(driver=driver)
+    runtime.launch(request)
+    assert any(call[0] == "launch_kernel" for call in driver.calls)
+    assert ("context_synchronize",) in driver.calls
+    assert any(call[0] == "module_close" for call in driver.calls)
+    assert runtime.last_jit_info_log == "fake-jit-info"
+
+
+def test_render_ptx_rejects_non_target_syntax_without_hardcoding_device_cc():
+    _, target_ir, _ = _compile(_program())
+    with pytest.raises(ValueError, match="sm_"):
+        render_ptx(target_ir.gpu_program, "compute_120")
