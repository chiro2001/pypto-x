diff --git a/python/pypto/backends/cuda/driver.py b/python/pypto/backends/cuda/driver.py
new file mode 100644
index 000000000..6e88141a1
--- /dev/null
+++ b/python/pypto/backends/cuda/driver.py
@@ -0,0 +1,462 @@
+"""Small CUDA Driver API adapter implemented without CUDA headers.
+
+The CUDA toolkit is deliberately not a dependency of PyPTO-X.  This module
+binds the stable Driver API through :mod:`ctypes`, which is sufficient for
+loading PTX, allocating/copying device memory, launching a kernel and
+synchronizing it.  The public classes are also intentionally easy to fake in
+unit tests: the higher-level runtime only relies on these small methods.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import ctypes.util
+from dataclasses import dataclass
+from typing import Any, Optional, Sequence
+
+
+CUDA_SUCCESS = 0
+
+# CU_JIT_* values are part of the Driver API enum.  We only use the log
+# buffers; no toolkit headers are needed to pass these numeric values.
+CU_JIT_INFO_LOG_BUFFER = 3
+CU_JIT_INFO_LOG_BUFFER_SIZE_BYTES = 4
+CU_JIT_ERROR_LOG_BUFFER = 5
+CU_JIT_ERROR_LOG_BUFFER_SIZE_BYTES = 6
+
+
+class CudaDriverUnavailable(RuntimeError):
+    """The driver library or a required Driver API symbol is unavailable."""
+
+
+class CudaDriverError(RuntimeError):
+    """A CUDA Driver API call returned a non-zero ``CUresult``."""
+
+    def __init__(self, operation: str, code: int, name: str = "unknown", message: str = "") -> None:
+        self.operation = operation
+        self.code = int(code)
+        self.name = name or "unknown"
+        self.message = message or "unknown CUDA driver error"
+        super().__init__(
+            "{} failed with {} ({}): {}".format(operation, self.name, self.code, self.message)
+        )
+
+
+@dataclass(frozen=True)
+class CudaDeviceInfo:
+    """Stable device facts recorded in CUDA artifact metadata."""
+
+    index: int
+    name: str
+    major: int
+    minor: int
+    total_memory: int
+
+    @property
+    def compute_capability(self) -> str:
+        return "{}.{}".format(self.major, self.minor)
+
+    def to_dict(self):
+        return {
+            "index": self.index,
+            "name": self.name,
+            "compute_capability": self.compute_capability,
+            "major": self.major,
+            "minor": self.minor,
+            "total_memory": self.total_memory,
+        }
+
+
+def _as_int(value: Any) -> int:
+    if isinstance(value, ctypes._SimpleCData):  # type: ignore[attr-defined]
+        return int(value.value)
+    return int(value)
+
+
+def _as_ptr(value: Any) -> ctypes.c_void_p:
+    if isinstance(value, ctypes.c_void_p):
+        return value
+    if value is None:
+        return ctypes.c_void_p()
+    if hasattr(value, "value") and isinstance(value.value, int):
+        return ctypes.c_void_p(int(value.value))
+    return ctypes.c_void_p(int(value))
+
+
+class CudaModule:
+    """Loaded PTX module with its JIT diagnostics."""
+
+    def __init__(self, driver: "CudaDriver", handle: Any, info_log: str, error_log: str) -> None:
+        self.driver = driver
+        self.handle = handle
+        self.info_log = info_log
+        self.error_log = error_log
+        self._closed = False
+
+    def get_function(self, name: str) -> Any:
+        if self._closed:
+            raise CudaDriverError("cuModuleGetFunction", 1, "CUDA_ERROR_INVALID_HANDLE", "module is closed")
+        return self.driver.module_get_function(self.handle, name)
+
+    def close(self) -> None:
+        if not self._closed:
+            self.driver.module_unload(self.handle)
+            self._closed = True
+
+    def __enter__(self) -> "CudaModule":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+
+class CudaContext:
+    """A Driver API context owned by :class:`CudaDriver`."""
+
+    def __init__(self, driver: "CudaDriver", handle: Any, device: int) -> None:
+        self.driver = driver
+        self.handle = handle
+        self.device = device
+        self._closed = False
+
+    def close(self) -> None:
+        if not self._closed:
+            self.driver.context_destroy(self.handle)
+            self._closed = True
+
+    def __enter__(self) -> "CudaContext":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+
+class CudaDriver:
+    """Lazy, header-free binding for the subset of the CUDA Driver API used here."""
+
+    _LIBRARY_CANDIDATES = (
+        "libcuda.so.1",
+        "libcuda.so",
+        "/usr/lib/wsl/lib/libcuda.so.1",
+    )
+
+    _ERROR_NAMES = {
+        1: "CUDA_ERROR_INVALID_VALUE",
+        2: "CUDA_ERROR_OUT_OF_MEMORY",
+        3: "CUDA_ERROR_NOT_INITIALIZED",
+        4: "CUDA_ERROR_DEINITIALIZED",
+        100: "CUDA_ERROR_NO_DEVICE",
+        201: "CUDA_ERROR_INVALID_DEVICE",
+        218: "CUDA_ERROR_INVALID_PTX",
+        400: "CUDA_ERROR_INVALID_HANDLE",
+        500: "CUDA_ERROR_NOT_FOUND",
+        600: "CUDA_ERROR_LAUNCH_FAILED",
+        700: "CUDA_ERROR_LAUNCH_OUT_OF_RESOURCES",
+        718: "CUDA_ERROR_INVALID_IMAGE",
+        719: "CUDA_ERROR_LAUNCH_FAILED",
+        7000: "CUDA_ERROR_JIT_COMPILER_NOT_FOUND",
+    }
+
+    def __init__(self, library: Any = None, library_path: Optional[str] = None) -> None:
+        if library is None:
+            library = self._load_library(library_path)
+        self._lib = library
+        self._bind_symbols()
+        self._initialized = False
+        self._closed = False
+
+    @classmethod
+    def _load_library(cls, library_path: Optional[str]) -> Any:
+        candidates = []
+        if library_path:
+            candidates.append(library_path)
+        discovered = ctypes.util.find_library("cuda")
+        if discovered:
+            candidates.append(discovered)
+        candidates.extend(cls._LIBRARY_CANDIDATES)
+        errors = []
+        for candidate in candidates:
+            try:
+                return ctypes.CDLL(candidate)
+            except OSError as exc:
+                errors.append("{}: {}".format(candidate, exc))
+        raise CudaDriverUnavailable("CUDA Driver library is unavailable ({})".format("; ".join(errors)))
+
+    def _resolve(self, *names: str) -> Any:
+        for name in names:
+            symbol = getattr(self._lib, name, None)
+            if symbol is not None:
+                return symbol
+        raise CudaDriverUnavailable("CUDA Driver API symbol is unavailable: {}".format("/".join(names)))
+
+    def _bind(self, names: Sequence[str], restype: Any, argtypes: Sequence[Any]) -> Any:
+        symbol = self._resolve(*names)
+        try:
+            symbol.restype = restype
+            symbol.argtypes = list(argtypes)
+        except (AttributeError, TypeError):
+            # A deliberately small fake library need not expose ctypes
+            # function metadata.  Calls still work through the same adapter.
+            pass
+        return symbol
+
+    def _bind_symbols(self) -> None:
+        u32 = ctypes.c_uint
+        i32 = ctypes.c_int
+        u64 = ctypes.c_uint64
+        size_t = ctypes.c_size_t
+        ptr = ctypes.c_void_p
+        self._cuInit = self._bind(("cuInit",), i32, (u32,))
+        self._cuDeviceGet = self._bind(("cuDeviceGet",), i32, (ctypes.POINTER(i32), i32))
+        self._cuDeviceGetName = self._bind(
+            ("cuDeviceGetName",), i32, (ctypes.c_char_p, i32, i32)
+        )
+        self._cuDeviceComputeCapability = self._bind(
+            ("cuDeviceComputeCapability",), i32, (ctypes.POINTER(i32), ctypes.POINTER(i32), i32)
+        )
+        self._cuDeviceTotalMem = self._bind(
+            ("cuDeviceTotalMem_v2", "cuDeviceTotalMem"), i32, (ctypes.POINTER(size_t), i32)
+        )
+        self._cuCtxCreate = self._bind(
+            ("cuCtxCreate_v2", "cuCtxCreate"), i32, (ctypes.POINTER(ptr), u32, i32)
+        )
+        self._cuCtxDestroy = self._bind(("cuCtxDestroy_v2", "cuCtxDestroy"), i32, (ptr,))
+        self._cuCtxSynchronize = self._bind(("cuCtxSynchronize",), i32, ())
+        self._cuStreamSynchronize = self._bind(("cuStreamSynchronize",), i32, (ptr,))
+        self._cuModuleLoadDataEx = self._bind(
+            ("cuModuleLoadDataEx",),
+            i32,
+            (ctypes.POINTER(ptr), ptr, u32, ctypes.POINTER(u32), ctypes.POINTER(ptr)),
+        )
+        self._cuModuleUnload = self._bind(("cuModuleUnload",), i32, (ptr,))
+        self._cuModuleGetFunction = self._bind(
+            ("cuModuleGetFunction",), i32, (ctypes.POINTER(ptr), ptr, ctypes.c_char_p)
+        )
+        self._cuMemAlloc = self._bind(("cuMemAlloc_v2", "cuMemAlloc"), i32, (ctypes.POINTER(u64), size_t))
+        self._cuMemFree = self._bind(("cuMemFree_v2", "cuMemFree"), i32, (u64,))
+        self._cuMemcpyHtoD = self._bind(("cuMemcpyHtoD_v2", "cuMemcpyHtoD"), i32, (u64, ptr, size_t))
+        self._cuMemcpyDtoH = self._bind(("cuMemcpyDtoH_v2", "cuMemcpyDtoH"), i32, (ptr, u64, size_t))
+        self._cuLaunchKernel = self._bind(
+            ("cuLaunchKernel",),
+            i32,
+            (
+                ptr,
+                u32,
+                u32,
+                u32,
+                u32,
+                u32,
+                u32,
+                u32,
+                ptr,
+                ctypes.POINTER(ptr),
+                ptr,
+            ),
+        )
+        self._cuGetErrorName = self._bind(("cuGetErrorName",), i32, (i32, ctypes.POINTER(ctypes.c_char_p)))
+        self._cuGetErrorString = self._bind(
+            ("cuGetErrorString",), i32, (i32, ctypes.POINTER(ctypes.c_char_p))
+        )
+
+    def _check(self, operation: str, result: Any) -> None:
+        code = _as_int(result)
+        if code == CUDA_SUCCESS:
+            return
+        name = self._ERROR_NAMES.get(code, "CUDA_ERROR_{}".format(code))
+        message = "driver call returned error {}".format(code)
+        try:
+            name_ptr = ctypes.c_char_p()
+            if _as_int(self._cuGetErrorName(code, ctypes.byref(name_ptr))) == CUDA_SUCCESS and name_ptr.value:
+                name = name_ptr.value.decode("utf-8", "replace")
+            text_ptr = ctypes.c_char_p()
+            if _as_int(self._cuGetErrorString(code, ctypes.byref(text_ptr))) == CUDA_SUCCESS and text_ptr.value:
+                message = text_ptr.value.decode("utf-8", "replace")
+        except Exception:
+            pass
+        raise CudaDriverError(operation, code, name, message)
+
+    def init(self) -> None:
+        if not self._initialized:
+            self._check("cuInit", self._cuInit(0))
+            self._initialized = True
+
+    def device_get(self, index: int = 0) -> int:
+        self.init()
+        value = ctypes.c_int()
+        self._check("cuDeviceGet", self._cuDeviceGet(ctypes.byref(value), int(index)))
+        return int(value.value)
+
+    def device_info(self, index: int = 0) -> CudaDeviceInfo:
+        device = self.device_get(index)
+        name = ctypes.create_string_buffer(256)
+        self._check("cuDeviceGetName", self._cuDeviceGetName(name, len(name), device))
+        major = ctypes.c_int()
+        minor = ctypes.c_int()
+        self._check(
+            "cuDeviceComputeCapability",
+            self._cuDeviceComputeCapability(ctypes.byref(major), ctypes.byref(minor), device),
+        )
+        total = ctypes.c_size_t()
+        self._check("cuDeviceTotalMem", self._cuDeviceTotalMem(ctypes.byref(total), device))
+        return CudaDeviceInfo(
+            int(index), name.value.decode("utf-8", "replace"), int(major.value), int(minor.value), int(total.value)
+        )
+
+    def context_create(self, index: int = 0) -> CudaContext:
+        device = self.device_get(index)
+        handle = ctypes.c_void_p()
+        self._check("cuCtxCreate", self._cuCtxCreate(ctypes.byref(handle), 0, device))
+        return CudaContext(self, handle, int(index))
+
+    def context_destroy(self, handle: Any) -> None:
+        self._check("cuCtxDestroy", self._cuCtxDestroy(_as_ptr(handle)))
+
+    def context_synchronize(self) -> None:
+        self._check("cuCtxSynchronize", self._cuCtxSynchronize())
+
+    def stream_synchronize(self, stream: Any = None) -> None:
+        self._check("cuStreamSynchronize", self._cuStreamSynchronize(_as_ptr(stream)))
+
+    def module_load_data(self, ptx: str, *, log_bytes: int = 8192) -> CudaModule:
+        if not isinstance(ptx, str) or not ptx:
+            raise ValueError("PTX must be a non-empty string")
+        image = ctypes.create_string_buffer(ptx.encode("utf-8") + b"\0")
+        info = ctypes.create_string_buffer(max(256, int(log_bytes)))
+        error = ctypes.create_string_buffer(max(256, int(log_bytes)))
+        info_size = ctypes.c_uint(len(info))
+        error_size = ctypes.c_uint(len(error))
+        options = (ctypes.c_uint * 4)(
+            CU_JIT_INFO_LOG_BUFFER,
+            CU_JIT_INFO_LOG_BUFFER_SIZE_BYTES,
+            CU_JIT_ERROR_LOG_BUFFER,
+        )
+        option_values = (ctypes.c_void_p * 4)()
+        option_values[0] = ctypes.cast(info, ctypes.c_void_p)
+        option_values[1] = ctypes.cast(ctypes.byref(info_size), ctypes.c_void_p)
+        option_values[2] = ctypes.cast(error, ctypes.c_void_p)
+        # The fourth slot is paired with the error-log option below.  Keeping
+        # the arrays explicit makes the ABI visible and avoids a toolkit.
+        options[3] = CU_JIT_ERROR_LOG_BUFFER_SIZE_BYTES
+        option_values[3] = ctypes.cast(ctypes.byref(error_size), ctypes.c_void_p)
+        handle = ctypes.c_void_p()
+        try:
+            result = self._cuModuleLoadDataEx(
+                ctypes.byref(handle),
+                ctypes.cast(image, ctypes.c_void_p),
+                len(options),
+                options,
+                option_values,
+            )
+            self._check("cuModuleLoadDataEx", result)
+        except CudaDriverError as exc:
+            jit_error = error.value.decode("utf-8", "replace").strip()
+            if jit_error:
+                raise CudaDriverError(
+                    exc.operation, exc.code, exc.name, "{}; JIT error log: {}".format(exc.message, jit_error)
+                ) from exc
+            raise
+        except Exception:
+            # The driver fills the error log even when module loading fails.
+            raise
+        return CudaModule(
+            self,
+            handle,
+            info.value.decode("utf-8", "replace"),
+            error.value.decode("utf-8", "replace"),
+        )
+
+    def module_unload(self, handle: Any) -> None:
+        self._check("cuModuleUnload", self._cuModuleUnload(_as_ptr(handle)))
+
+    def module_get_function(self, module: Any, name: str) -> Any:
+        if not isinstance(name, str) or not name:
+            raise ValueError("kernel name must be non-empty")
+        handle = ctypes.c_void_p()
+        self._check(
+            "cuModuleGetFunction",
+            self._cuModuleGetFunction(ctypes.byref(handle), _as_ptr(module), name.encode("utf-8")),
+        )
+        return handle
+
+    def mem_alloc(self, size: int) -> int:
+        size = max(1, int(size))
+        value = ctypes.c_uint64()
+        self._check("cuMemAlloc", self._cuMemAlloc(ctypes.byref(value), size))
+        return int(value.value)
+
+    def mem_free(self, pointer: Any) -> None:
+        self._check("cuMemFree", self._cuMemFree(ctypes.c_uint64(_as_int(pointer))))
+
+    def memcpy_htod(self, pointer: Any, data: bytes) -> None:
+        raw = bytes(data)
+        source = ctypes.create_string_buffer(raw if raw else b"\0")
+        self._check(
+            "cuMemcpyHtoD",
+            self._cuMemcpyHtoD(ctypes.c_uint64(_as_int(pointer)), ctypes.cast(source, ctypes.c_void_p), len(raw)),
+        )
+
+    def memcpy_dtoh(self, pointer: Any, size: int) -> bytes:
+        size = int(size)
+        destination = ctypes.create_string_buffer(max(1, size))
+        self._check(
+            "cuMemcpyDtoH",
+            self._cuMemcpyDtoH(ctypes.cast(destination, ctypes.c_void_p), ctypes.c_uint64(_as_int(pointer)), size),
+        )
+        return destination.raw[:size]
+
+    def launch_kernel(
+        self,
+        function: Any,
+        grid: Sequence[int],
+        block: Sequence[int],
+        parameters: Sequence[Any],
+        stream: Any = None,
+        shared_memory: int = 0,
+    ) -> None:
+        if len(grid) != 3 or len(block) != 3:
+            raise ValueError("CUDA launch grid and block must have three dimensions")
+        keepalive = []
+        values = (ctypes.c_void_p * len(parameters))()
+        for index, parameter in enumerate(parameters):
+            if isinstance(parameter, ctypes.c_void_p):
+                holder = parameter
+            elif isinstance(parameter, ctypes._SimpleCData):  # type: ignore[attr-defined]
+                holder = parameter
+            elif isinstance(parameter, float):
+                holder = ctypes.c_float(parameter)
+            else:
+                holder = ctypes.c_uint64(int(parameter))
+            keepalive.append(holder)
+            values[index] = ctypes.cast(ctypes.byref(holder), ctypes.c_void_p)
+        self._check(
+            "cuLaunchKernel",
+            self._cuLaunchKernel(
+                _as_ptr(function),
+                int(grid[0]), int(grid[1]), int(grid[2]),
+                int(block[0]), int(block[1]), int(block[2]),
+                int(shared_memory),
+                _as_ptr(stream),
+                values,
+                None,
+            ),
+        )
+
+    def close(self) -> None:
+        self._closed = True
+
+    def __enter__(self) -> "CudaDriver":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+
+__all__ = [
+    "CUDA_SUCCESS",
+    "CudaContext",
+    "CudaDeviceInfo",
+    "CudaDriver",
+    "CudaDriverError",
+    "CudaDriverUnavailable",
+    "CudaModule",
+]
diff --git a/python/pypto/backends/cuda/runtime.py b/python/pypto/backends/cuda/runtime.py
new file mode 100644
index 000000000..e8f7bece3
--- /dev/null
+++ b/python/pypto/backends/cuda/runtime.py
@@ -0,0 +1,468 @@
+"""CUDA Driver/PTX runtime for the initial PyPTO-X GPU common subset."""
+
+from __future__ import annotations
+
+import ctypes
+import struct
+from dataclasses import dataclass
+from typing import Any, Dict, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, GpuLaunchRequest, LaunchRequest, TensorDesc
+from pypto.backends.cpu.tensor import FlatBuffer, HostTensor
+from pypto.compiler.artifact import Artifact
+from pypto.compiler.targets.cuda import (
+    CudaPtxArtifactError,
+    CudaProgram,
+    _decode_cuda_artifact,
+)
+from pypto.core_ir import CoreFunction, CoreType
+from pypto.lowering.cpu import canonical_dtype, element_count, flatten_values, static_shape
+
+from .driver import CudaContext, CudaDriver, CudaDriverError, CudaDriverUnavailable
+
+
+class CudaRuntimeError(RuntimeError):
+    """Base CUDA runtime error."""
+
+
+class CudaArtifactError(CudaRuntimeError):
+    """Artifact validation failed before any device work was attempted."""
+
+
+class CudaExecutionError(CudaRuntimeError):
+    """Request, memory, launch or result-copy failure."""
+
+
+@dataclass(frozen=True)
+class LoadedCudaArtifact:
+    artifact: Artifact
+    target_ir: CudaProgram
+    module: Any = None
+    jit_info_log: str = ""
+    jit_error_log: str = ""
+
+    @property
+    def program(self) -> CudaProgram:
+        return self.target_ir
+
+
+@dataclass
+class _Allocation:
+    pointer: int
+    size: int
+    owned: bool
+    host_storage: Any = None
+    dtype: Optional[str] = None
+    shape: Tuple[int, ...] = ()
+
+
+def _bf16_bits(value: Any) -> int:
+    raw = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    upper = raw >> 16
+    lower = raw & 0xFFFF
+    if lower > 0x8000 or (lower == 0x8000 and (upper & 1)):
+        upper += 1
+    return upper & 0xFFFF
+
+
+def _pack(dtype: str, values: Sequence[Any]) -> bytes:
+    dtype = canonical_dtype(dtype)
+    if dtype == "float32":
+        return b"".join(struct.pack("<f", float(value)) for value in values)
+    if dtype == "bf16":
+        return b"".join(struct.pack("<H", _bf16_bits(value)) for value in values)
+    raise CudaExecutionError("CUDA bootstrap only supports float32 and bf16 host buffers")
+
+
+def _unpack(dtype: str, payload: bytes) -> list:
+    dtype = canonical_dtype(dtype)
+    if dtype == "float32":
+        if len(payload) % 4:
+            raise CudaExecutionError("float32 result byte count is not aligned")
+        return list(struct.unpack("<{}f".format(len(payload) // 4), payload)) if payload else []
+    if dtype == "bf16":
+        if len(payload) % 2:
+            raise CudaExecutionError("bf16 result byte count is not aligned")
+        result = []
+        for index in range(0, len(payload), 2):
+            bits = struct.unpack_from("<H", payload, index)[0]
+            result.append(struct.unpack("<f", struct.pack("<I", bits << 16))[0])
+        return result
+    raise CudaExecutionError("CUDA bootstrap only supports float32 and bf16 result buffers")
+
+
+def _itemsize(dtype: str) -> int:
+    dtype = canonical_dtype(dtype)
+    if dtype == "float32":
+        return 4
+    if dtype == "bf16":
+        return 2
+    raise CudaExecutionError("unsupported CUDA dtype {!r}".format(dtype))
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _pointer(value: Any) -> Optional[int]:
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        return int(value) if value else None
+    if isinstance(value, ctypes.c_void_p):
+        return int(value.value) if value.value else None
+    if hasattr(value, "value") and isinstance(value.value, int):
+        return int(value.value) if value.value else None
+    return None
+
+
+def _storage(desc: TensorDesc) -> Any:
+    return desc.address if desc.address is not None else desc.handle
+
+
+def _host_values(storage: Any) -> list:
+    if isinstance(storage, HostTensor):
+        return list(storage.data)
+    if isinstance(storage, FlatBuffer):
+        return list(storage.data)
+    if isinstance(storage, (str, bytes, bytearray, Mapping)) or storage is None:
+        raise CudaExecutionError("host tensor storage must be a flat numeric sequence")
+    if isinstance(storage, (list, tuple)):
+        return list(flatten_values(storage))
+    if hasattr(storage, "data") and isinstance(storage.data, (list, tuple)):
+        return list(storage.data)
+    try:
+        return [storage[index] for index in range(len(storage))]
+    except (TypeError, IndexError, KeyError, AttributeError) as exc:
+        raise CudaExecutionError("host tensor storage does not support flat sequence access") from exc
+
+
+def _write_host(storage: Any, values: Sequence[Any], expected: int) -> None:
+    if isinstance(storage, HostTensor):
+        destination = storage.data
+    elif isinstance(storage, FlatBuffer):
+        destination = storage.data
+    elif isinstance(storage, list):
+        destination = storage
+    elif hasattr(storage, "data") and isinstance(storage.data, list):
+        destination = storage.data
+    else:
+        destination = storage
+    try:
+        if len(destination) != expected:
+            raise CudaExecutionError("host output storage length does not match tensor shape")
+        for index, value in enumerate(values):
+            destination[index] = value
+    except (TypeError, IndexError, AttributeError) as exc:
+        raise CudaExecutionError("host output storage is not mutable") from exc
+
+
+def _find_function(program: CudaProgram, name: str) -> CoreFunction:
+    for function in program.program.functions:
+        if function.name == name:
+            return function
+    raise CudaExecutionError("CUDA entrypoint {!r} is not present".format(name))
+
+
+def _as_gpu_request(request: Any, target_ir: CudaProgram) -> GpuLaunchRequest:
+    if isinstance(request, GpuLaunchRequest):
+        return request
+    if not isinstance(request, LaunchRequest):
+        raise CudaExecutionError("CUDA launch requires GpuLaunchRequest or LaunchRequest")
+    return GpuLaunchRequest(
+        request.artifact,
+        geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+        inputs=request.inputs,
+        outputs=request.outputs,
+        scalars=request.scalars,
+        workspace=request.workspace,
+        stream_handle=request.stream_handle,
+    )
+
+
+def _validate_request(request: GpuLaunchRequest, target_ir: CudaProgram, function: CoreFunction) -> None:
+    try:
+        request.validate()
+    except Exception as exc:
+        raise CudaExecutionError("invalid CUDA launch request: {}".format(exc)) from exc
+    if request.artifact.target != target_ir.target:
+        raise CudaExecutionError("CUDA launch target does not match artifact")
+    if len(request.geometries) != len(target_ir.gpu_program.plans):
+        raise CudaExecutionError("CUDA geometry sequence does not match artifact plan count")
+    for index, (actual, plan) in enumerate(zip(request.geometries, target_ir.gpu_program.plans)):
+        if actual.to_dict() != plan.geometry.to_dict():
+            raise CudaExecutionError("CUDA geometry at operation {} does not match artifact".format(index))
+    for index, descriptor in enumerate(request.inputs + request.outputs):
+        if descriptor.device not in ("gpu", "device"):
+            raise CudaExecutionError("CUDA tensor descriptor {} must use device='gpu'".format(index))
+        if descriptor.strides != _contiguous_strides(descriptor.shape):
+            raise CudaExecutionError("CUDA bootstrap requires contiguous tensor descriptors")
+    tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+    tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+    if len(request.inputs) != len(tensor_parameters) or len(request.outputs) != len(tensor_returns):
+        raise CudaExecutionError("CUDA tensor argument count does not match Core IR")
+    for descriptor, ref in zip(request.inputs, tensor_parameters):
+        if canonical_dtype(descriptor.dtype) != canonical_dtype(ref.type.dtype) or descriptor.shape != static_shape(ref.type, ref.name):
+            raise CudaExecutionError("CUDA input descriptor does not match {!r}".format(ref.name))
+    for descriptor, ref in zip(request.outputs, tensor_returns):
+        if canonical_dtype(descriptor.dtype) != canonical_dtype(ref.type.dtype) or descriptor.shape != static_shape(ref.type, ref.name):
+            raise CudaExecutionError("CUDA output descriptor does not match {!r}".format(ref.name))
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    result = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        result[index] = running
+        running *= int(shape[index])
+    return tuple(result)
+
+
+class CudaRuntime:
+    """Driver API runtime for deterministic PTX artifacts."""
+
+    name = "cuda.ptx"
+
+    def __init__(self, driver: Any = None, device_index: int = 0) -> None:
+        self.device_index = int(device_index)
+        self._driver_error: Optional[str] = None
+        if driver is not None:
+            self.driver = driver
+        else:
+            try:
+                self.driver = CudaDriver()
+            except CudaDriverUnavailable as exc:
+                self.driver = None
+                self._driver_error = str(exc)
+        self._context: Optional[CudaContext] = None
+        self.last_jit_info_log = ""
+        self.last_jit_error_log = ""
+
+    def availability(self) -> Availability:
+        if self.driver is None:
+            return Availability.no(self.name, self._driver_error or "CUDA Driver API unavailable", "missing_driver")
+        try:
+            info = self.driver.device_info(self.device_index)
+            details = info.to_dict() if hasattr(info, "to_dict") else info
+            return Availability(True, self.name, details=details)
+        except Exception as exc:
+            return Availability.no(self.name, str(exc), "device_unavailable")
+
+    def is_available(self) -> bool:
+        return self.availability().available
+
+    def _ensure_context(self) -> Any:
+        if self.driver is None:
+            raise CudaExecutionError(self._driver_error or "CUDA Driver API unavailable")
+        if self._context is None:
+            try:
+                self._context = self.driver.context_create(self.device_index)
+            except Exception as exc:
+                raise CudaExecutionError("CUDA context creation failed: {}".format(exc)) from exc
+        return self._context
+
+    def load(self, artifact: Artifact) -> LoadedCudaArtifact:
+        try:
+            target_ir = _decode_cuda_artifact(artifact)
+        except CudaPtxArtifactError as exc:
+            raise CudaArtifactError(str(exc)) from exc
+        except Exception as exc:
+            raise CudaArtifactError("CUDA artifact validation failed: {}".format(exc)) from exc
+        return LoadedCudaArtifact(artifact, target_ir)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, (LaunchRequest, GpuLaunchRequest)):
+            raise CudaExecutionError("CUDA workspace_size requires a launch request")
+        loaded = self.load(request.artifact)
+        del loaded
+        return 0
+
+    def launch(self, request: Any) -> Tuple[Any, ...]:
+        loaded = self.load(request.artifact if isinstance(request, (LaunchRequest, GpuLaunchRequest)) else None)
+        gpu_request = _as_gpu_request(request, loaded.target_ir)
+        function = _find_function(loaded.target_ir, loaded.target_ir.entrypoint)
+        _validate_request(gpu_request, loaded.target_ir, function)
+        context = self._ensure_context()
+        module = None
+        allocations = []
+        values: Dict[str, Any] = {}
+        scalar_values: Dict[str, Any] = {}
+        output_allocations: Dict[str, _Allocation] = {}
+        try:
+            module = self.driver.module_load_data(loaded.target_ir.ptx)
+            self.last_jit_info_log = getattr(module, "info_log", "")
+            self.last_jit_error_log = getattr(module, "error_log", "")
+            input_index = 0
+            for ref in function.parameters:
+                if _is_tensor(ref.type):
+                    descriptor = gpu_request.inputs[input_index]
+                    values[ref.name] = self._prepare_input(descriptor, ref.type, allocations)
+                    input_index += 1
+                elif _is_scalar(ref.type):
+                    if ref.name not in gpu_request.scalars:
+                        raise CudaExecutionError("missing CUDA scalar input {!r}".format(ref.name))
+                    scalar_values[ref.name] = gpu_request.scalars[ref.name]
+                else:
+                    raise CudaExecutionError("unsupported CUDA parameter kind {!r}".format(ref.type.kind))
+            tensor_return_index = 0
+            return_names = set(ref.name for ref in function.returns)
+            return_descriptors = {}
+            for ref in function.returns:
+                if _is_tensor(ref.type):
+                    return_descriptors[ref.name] = gpu_request.outputs[tensor_return_index]
+                    tensor_return_index += 1
+            for index, operation in enumerate(function.body.operations):
+                output = operation.outputs[0]
+                if _is_tensor(output.type):
+                    if output.name in return_names:
+                        allocation = self._prepare_output(
+                            return_descriptors[output.name], output.type, allocations
+                        )
+                        output_allocations[output.name] = allocation
+                    else:
+                        allocation = self._allocate_for_type(output.type, allocations)
+                    values[output.name] = allocation.pointer
+                elif _is_scalar(output.type):
+                    allocation = self._allocate_for_type(output.type, allocations)
+                    values[output.name] = allocation.pointer
+                else:
+                    raise CudaExecutionError("unsupported CUDA operation output kind {!r}".format(output.type.kind))
+                function_handle = module.get_function("px_op{}".format(index))
+                parameters = []
+                for ref in operation.inputs:
+                    if _is_tensor(ref.type):
+                        parameters.append(values[ref.name])
+                    elif _is_scalar(ref.type):
+                        parameters.append(self._scalar_parameter(scalar_values.get(ref.name, values.get(ref.name)), ref.type))
+                    else:
+                        raise CudaExecutionError("unsupported CUDA operation input kind {!r}".format(ref.type.kind))
+                if _is_tensor(output.type) or _is_scalar(output.type):
+                    parameters.append(values[output.name])
+                plan = loaded.target_ir.gpu_program.plans[index]
+                self.driver.launch_kernel(
+                    function_handle,
+                    plan.geometry.grid.dims,
+                    plan.geometry.workgroup.dims,
+                    parameters,
+                    gpu_request.stream_handle,
+                    plan.geometry.dynamic_workgroup_memory_bytes,
+                )
+            if gpu_request.stream_handle is not None and hasattr(self.driver, "stream_synchronize"):
+                self.driver.stream_synchronize(gpu_request.stream_handle)
+            else:
+                self.driver.context_synchronize()
+            results = []
+            tensor_return_index = 0
+            for ref in function.returns:
+                allocation = _allocation_for_name(ref.name, values, output_allocations, allocations)
+                if _is_tensor(ref.type):
+                    descriptor = gpu_request.outputs[tensor_return_index]
+                    if _pointer(_storage(descriptor)) is None:
+                        size = element_count(static_shape(ref.type, ref.name)) * _itemsize(ref.type.dtype)
+                        raw = self.driver.memcpy_dtoh(allocation.pointer, size) if size else b""
+                        _write_host(_storage(descriptor), _unpack(ref.type.dtype, raw), element_count(static_shape(ref.type, ref.name)))
+                    results.append(_storage(descriptor))
+                    tensor_return_index += 1
+                elif _is_scalar(ref.type):
+                    size = _itemsize(ref.type.dtype)
+                    raw = self.driver.memcpy_dtoh(allocation.pointer, size)
+                    unpacked = _unpack(ref.type.dtype, raw)
+                    results.append(unpacked[0] if unpacked else 0.0)
+            return tuple(results)
+        except (CudaRuntimeError, CudaDriverError):
+            raise
+        except Exception as exc:
+            raise CudaExecutionError("CUDA launch failed: {}".format(exc)) from exc
+        finally:
+            if module is not None:
+                try:
+                    module.close()
+                except Exception:
+                    pass
+            for allocation in reversed(allocations):
+                if allocation.owned:
+                    try:
+                        self.driver.mem_free(allocation.pointer)
+                    except Exception:
+                        pass
+
+    def _prepare_input(self, descriptor: TensorDesc, value_type: CoreType, allocations: list) -> int:
+        pointer = _pointer(_storage(descriptor))
+        if pointer is not None:
+            return pointer
+        shape = static_shape(value_type, value_type.kind)
+        values = _host_values(_storage(descriptor))
+        expected = element_count(shape)
+        if len(values) != expected:
+            raise CudaExecutionError("CUDA input storage length does not match shape")
+        size = expected * _itemsize(value_type.dtype)
+        pointer = self.driver.mem_alloc(size)
+        allocation = _Allocation(pointer, size, True)
+        allocations.append(allocation)
+        self.driver.memcpy_htod(pointer, _pack(value_type.dtype, values))
+        return pointer
+
+    def _prepare_output(self, descriptor: TensorDesc, value_type: CoreType, allocations: list) -> _Allocation:
+        pointer = _pointer(_storage(descriptor))
+        if pointer is not None:
+            return _Allocation(pointer, element_count(static_shape(value_type, value_type.kind)) * _itemsize(value_type.dtype), False)
+        return self._allocate_for_type(value_type, allocations, _storage(descriptor))
+
+    def _allocate_for_type(self, value_type: CoreType, allocations: list, host_storage: Any = None) -> _Allocation:
+        shape = static_shape(value_type, value_type.kind)
+        size = element_count(shape) * _itemsize(value_type.dtype)
+        pointer = self.driver.mem_alloc(size)
+        allocation = _Allocation(pointer, size, True, host_storage, canonical_dtype(value_type.dtype), shape)
+        allocations.append(allocation)
+        return allocation
+
+    @staticmethod
+    def _scalar_parameter(value: Any, value_type: CoreType) -> Any:
+        dtype = canonical_dtype(value_type.dtype)
+        if dtype in ("float32", "bf16", "float16"):
+            return ctypes.c_float(float(value))
+        return ctypes.c_uint64(int(value))
+
+    def close(self) -> None:
+        if self._context is not None:
+            try:
+                self._context.close()
+            finally:
+                self._context = None
+
+    def __enter__(self) -> "CudaRuntime":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+
+def _allocation_for_name(name: str, values: Mapping[str, Any], output_allocations: Mapping[str, _Allocation], allocations: Sequence[_Allocation]) -> _Allocation:
+    allocation = output_allocations.get(name)
+    if allocation is not None:
+        return allocation
+    pointer = _pointer(values.get(name))
+    if pointer is None:
+        raise CudaExecutionError("CUDA return value {!r} has no device allocation".format(name))
+    for candidate in allocations:
+        if candidate.pointer == pointer:
+            return candidate
+    return _Allocation(pointer, 0, False)
+
+
+CudaBackend = CudaRuntime
+CudaDriverRuntime = CudaRuntime
+
+
+def launch(request: Any) -> Tuple[Any, ...]:
+    return CudaRuntime().launch(request)
+
+
+__all__ = [
+    "CudaArtifactError", "CudaBackend", "CudaDriverRuntime", "CudaExecutionError", "CudaRuntime",
+    "CudaRuntimeError", "LoadedCudaArtifact", "launch",
+]
