From ec60f95979a56a9646d84f163912e677e9eb08ac Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Wed, 9 Sep 2026 15:35:24 +0800
Subject: [PATCH 076/256] fix(pypto-x): preserve qwen layer residual chain

---
 python/pypto/portable/qwen35.py                                  |  2 +-
 python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py | 24 ++++++++++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
index f5d391ac1..9849a3e6c 100644
--- a/python/pypto/portable/qwen35.py
+++ b/python/pypto/portable/qwen35.py
@@ -1786,7 +1786,7 @@ def build_qwen35_text_decoder_graph(
         )
         hidden = builder.op(
             "add",
-            (hidden, down),
+            (residual, down),
             ((prefix + "_output", _tensor(dtype, input_shape)),),
         )[0]
         layer_hidden_outputs.append(hidden.name)
diff --git a/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py b/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py
index 1e1110291..8ff4f003a 100644
--- a/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py
+++ b/python/tests/ut/pypto_x/test_qwen35_full_decoder_connectivity.py
@@ -130,6 +130,30 @@ def test_model_profile_has_complete_layer_ssa_connectivity_without_weights():
     assert all("values" not in operation.attributes for operation in function.body.operations)
 
 
+def test_each_decoder_layer_closes_attention_residual_then_mlp():
+    """Every layer must feed token-mixer residual into the final MLP add."""
+
+    program = build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test")
+    function = program.functions[0]
+    metadata = program.metadata
+    by_output = {operation.outputs[0].name: operation for operation in function.body.operations}
+
+    assert len(metadata["layer_hidden_inputs"]) == 24
+    for layer_index in range(24):
+        prefix = "layer_{:02d}".format(layer_index)
+        layer_output = by_output[prefix + "_output"]
+        attention_residual = by_output[prefix + "_attention_residual"]
+        mlp_down = by_output[prefix + "_mlp_down_output"]
+
+        assert layer_output.name == "add"
+        assert layer_output.inputs[0].name == attention_residual.outputs[0].name
+        assert layer_output.inputs[1].name == mlp_down.outputs[0].name
+        assert attention_residual.name == "add"
+        assert attention_residual.inputs[0].name == metadata["layer_hidden_inputs"][layer_index]
+        assert attention_residual.inputs[1].name.endswith("_branch_output")
+        assert mlp_down.name == "reshape"
+
+
 def test_model_profile_builds_compact_for_decode_cache_lengths():
     for past in (0, 4096):
         program = build_qwen35_text_decoder_graph(1, 1, past_length=past)
