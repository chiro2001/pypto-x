+        if key not in attributes:
+            continue
+        raw = attributes[key]
+        try:
+            values = _static_shape_tuple(raw, "output")
+        except OpContractError as exc:
+            raise OpContractError(
+                "{} {} must be a non-empty sequence of non-negative integers".format(
+                    operation_name, key
+                ),
+                field="operation.attributes." + key,
+                requested=raw,
+                reason="{}_valid_shape_invalid".format(operation_name),
+            ) from exc
+        if not values:
+            raise OpContractError(
+                "{} {} must be a non-empty sequence of non-negative integers".format(
+                    operation_name, key
+                ),
+                field="operation.attributes." + key,
+                requested=raw,
+                reason="{}_valid_shape_invalid".format(operation_name),
+            )
