+def test_binary_float_path_is_deterministic_bounded_and_require_proven_fails_closed():
+    plan = plan_op("mul", [(2, 2), (2, 2)], ["float32", "float32"])
+    precision = plan.numeric_guarantee["precision"]
+    assert precision["class"] == "deterministic_bounded"
+    assert precision["deviation_bound_available"] is False
+    assert precision["analytic_upper_bound"] is None
+
+    strict = ExecutionPolicy(numeric=NumericPolicy(require_proven_deviation_bound=True))
+    with pytest.raises(NumericGuaranteeUnmetError) as info:
+        plan_operation(
+            "mul", [(2, 2), (2, 2)], ["float32", "float32"], policy=strict
+        )
+    assert info.value.field == "numeric.require_proven_deviation_bound"
+    # The integer path carries an exact contract bound and stays available.
+    assert plan_operation(
+        "mul", [(2, 2), (2, 2)], ["int32", "int32"], policy=strict
+    ).plan.numeric_guarantee["precision"]["class"] == "exact"
+
