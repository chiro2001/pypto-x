+def _view_semantics_block(
+    kind: str,
+    stride_rule: str,
+    *,
+    data: str
+) -> Mapping[str, Any]:
+    """Shared ``view`` block for the batch-2 shape/data-movement family.
+
+    The three-state ``layout.view_mode`` contract is frozen here:
+
+    * the opcode is a *logical* view family member: aliasing the input storage
+      would be legal for a provider that exposes a stride descriptor
+      (``view_obligation = may_alias``), but it is not required;
+    * the portable trunk has no strided-view ABI, so it always materializes an
+      independent output row-major buffer (``forbid``/``prefer`` resolve to
+      ``materialized`` with the real copy byte count);
+    * ``view_mode=require`` demands a proven zero-copy alias proof.  The
+      portable trunk cannot produce one, so it is refused with a structured
+      ``ALIAS_PROOF_UNAVAILABLE`` — never silently downgraded to a copy.
+    """
+
+    return {
+        "family": "view_data_movement",
+        "data": data,
+        "view": {
+            "kind": kind,
+            "view_obligation": "may_alias",
+            "allows_materialize_copy": True,
+            "copy_bytes_rule": "element_count(output_shape) * dtype_size(output_dtype)",
+            "alias_policy": (
+                "input storage may be aliased by a provider that can prove a stride "
+                "descriptor; the portable trunk always materializes an independent "
+                "output buffer"
+            ),
+            "view_mode": {
+                "forbid": (
+                    "explicit independent destination; the portable provider "
+                    "materializes a copy (resolved_view_mode=materialized)"
+                ),
+                "prefer": (
+                    "a zero-copy view would be preferred, but the portable provider "
+                    "cannot prove one; an explicit budgeted materialize copy is used"
+                ),
+                "require": (
+                    "structured ALIAS_PROOF_UNAVAILABLE refusal when no zero-copy "
+                    "proof exists; never a silent downgrade to a copy"
+                ),
+            },
+            "stride": stride_rule,
+            "inplace": (
+                "inplace=true is rejected (the output must not alias an input); "
+                "absent/false only"
+            ),
+            "valid_shape": (
+                "when present, valid_shape must equal the resolved output shape; a "
+                "partial valid shape is not represented by the portable tensor ABI"
+            ),
+        },
+    }
+
+
