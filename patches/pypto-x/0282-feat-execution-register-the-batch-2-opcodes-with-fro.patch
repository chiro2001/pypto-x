+def test_frozen_where_and_compare_patches_do_not_change_existing_results():
+    plan, output, report = run_op(
+        "where",
+        [(2, 2), (2, 2), ()],
+        ["bool", "float32", "float32"],
+        [
+            tensor("bool", (2, 2), [True, False, True, False]),
+            tensor("float32", (2, 2), [1.0, 2.0, 3.0, 4.0]),
+            9.0,
+        ],
+    )
+    # Patch A adds the scalar marker to the frozen request, so this new request
+    # naturally has a new digest; the tensor-only request above stays frozen.
+    assert plan.payload["request"]["inputs"][2]["kind"] == "scalar"
+    assert "kind" not in plan.payload["request"]["inputs"][1]
+    assert output.data == [1.0, 9.0, 3.0, 9.0]
+
+    compare_plan, compare_output, compare_report = run_op(
+        "compare",
+        [(2, 2), (2, 2)],
+        ["float32", "float32"],
+        [tensor("float32", (2, 2), [1.0, 2.0, 3.0, 4.0]), tensor("float32", (2, 2), [2.0, 2.0, 2.0, 2.0])],
+        {"predicate": "lt", "broadcast": "trailing_singleton"},
+    )
+    assert compare_plan.payload["request"]["attributes"] == {
+        "predicate": "lt",
+        "broadcast": "trailing_singleton",
+    }
+    assert compare_output.data == [True, False, False, False]
+    validate_report_schema(report.to_dict())
+    validate_report_schema(compare_report.to_dict())
+
