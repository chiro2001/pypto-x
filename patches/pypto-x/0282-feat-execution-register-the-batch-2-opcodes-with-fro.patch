+def test_frozen_legal_plan_digests_are_unchanged():
+    # Plan digests bind the host capability snapshot, whose vendor manifests
+    # carry thread facts; under the rule-8 lock environment (OMP_NUM_THREADS=6)
+    # the probe digest differs and this pin is skipped exactly like the batch-1
+    # and U5 baseline pins.  The contract digests above stay host-independent.
+    if CapabilitySnapshot.probe_host().digest != FROZEN_DEFAULT_CAPABILITY_DIGEST:
+        pytest.skip("the frozen plan digests were recorded on the baseline host probe")
+    assert plan_op("matmul", [(2, 3), (3, 4)], ["float32", "float32"]).digest == (
+        FROZEN_PLAN_DIGESTS["matmul_float32"]
+    )
+    assert plan_op("qmatmul_s8s8_s32", [(2, 3), (3, 4)], ["int8", "int8"]).digest == (
+        FROZEN_PLAN_DIGESTS["qmatmul_s8s8_s32"]
+    )
+    assert plan_op(
+        "where", [(2, 3), (2, 3), (1, 3)], ["bool", "float32", "float32"]
+    ).digest == FROZEN_PLAN_DIGESTS["where_tensor_only"]
+    assert plan_op(
+        "compare", [(2, 3), (3,)], ["float32", "float32"], attributes={"predicate": "le"}
+    ).digest == FROZEN_PLAN_DIGESTS["compare_no_broadcast_attribute"]
+    assert plan_op("exp", [(2, 3)], ["float32"]).digest == FROZEN_PLAN_DIGESTS["exp_float32"]
+    assert plan_op(
+        "iota", [], [], dtype="int32", output_shape=(8,),
+        attributes={"axis": 0, "start": 1, "step": 2},
+    ).digest == FROZEN_PLAN_DIGESTS["iota_int32"]
+    assert plan_op(
+        "reduce_sum", [(2, 3, 4)], ["float32"], attributes={"axes": [1]}
+    ).digest == FROZEN_PLAN_DIGESTS["reduce_sum_float32"]
+    assert plan_op(
+        "cast", [(2, 3)], ["int32"], output_dtype="bf16"
+    ).digest == FROZEN_PLAN_DIGESTS["cast_int32_bf16"]
+    assert plan_op(
+        "reshape", [(2, 3)], ["float32"], attributes={"shape": [6]}
+    ).digest == FROZEN_PLAN_DIGESTS["reshape_float32"]
