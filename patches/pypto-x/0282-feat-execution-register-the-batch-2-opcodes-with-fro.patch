+
+    The portable tensor ABI materializes one independent flat output buffer, so
+    ``inplace=true`` (output aliasing an input) is not representable and fails
+    closed.  ``valid_shape`` (when present) must equal the resolved output
+    shape; a partial valid shape is not representable and is refused instead of
+    being silently truncated.
+    """
+
+    if "inplace" in attributes:
+        inplace = attributes["inplace"]
+        if not isinstance(inplace, bool):
+            raise OpContractError(
+                "{} inplace must be a bool".format(operation_name),
+                field="operation.attributes.inplace",
+                requested=inplace,
+                reason="{}_inplace_not_bool".format(operation_name),
+            )
+        if inplace:
+            raise OpContractError(
+                "{} inplace=true is not portable: the output must not alias an input".format(
+                    operation_name
+                ),
+                field="operation.attributes.inplace",
+                requested=True,
+                available=False,
+                reason="{}_inplace_not_portable".format(operation_name),
+            )
