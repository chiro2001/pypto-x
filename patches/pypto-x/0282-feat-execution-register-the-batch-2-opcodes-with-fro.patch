+def test_view_family_bit_for_bit_value_preservation():
+    nan = struct.unpack("<f", struct.pack("<I", 0x7FC0 << 16))[0]
+    source = tensor("bf16", (1, 2), [nan, -0.0])
+    for opcode, attributes in (
+        ("transpose", {"permutation": [1, 0]}),
+        ("slice", {"starts": [0], "stops": [1], "axes": [1]}),
+        ("broadcast", {"shape": [1, 2]}),
+    ):
+        _, output, _ = run_op(opcode, [(1, 2)], ["bf16"], [source], attributes)
+        assert output.data[0] != output.data[0]  # NaN preserved
+    # The negative zero must keep its sign bit through a slice.
+    _, sliced, _ = run_op(
+        "slice", [(1, 2)], ["bf16"], [source],
+        {"starts": [1], "stops": [2], "axes": [1]},
+    )
+    assert math.copysign(1.0, sliced.data[0]) == -1.0
