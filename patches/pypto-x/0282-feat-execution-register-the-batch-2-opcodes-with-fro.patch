+def verify_binary_elementwise(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``add``/``mul``: elementwise binary with trailing-axis broadcast.
+
+    Scalar operands are admitted where the reference lowering supports them
+    (tensor+scalar or scalar+tensor); the scalar must carry the same dtype and
+    broadcasts as a rank-0 operand.  Two scalars would produce a scalar result,
+    which the execution contract (a tensor ABI) does not represent, so that
+    request is refused.  The full trailing-axis binary broadcast rule is
+    verified here; the portable reference executor currently only lowers the
+    same-shape tensor-tensor and scalar cases, and any other legal broadcast
+    request is refused by ``verify_lowering_accepts`` — never silently
+    materialized or re-associated.
+    """
+
+    opname = definition.canonical_opcode
+    _check_attributes(opname, attributes, definition.attribute_names)
+    if len(input_types) != 2:
+        raise _arity_error(opname, 2, len(input_types))
+    left_kind, left_dtype, left_shape = _require_operand(
+        input_types[0], "left", BINARY_DTYPES, allow_scalar=True
+    )
+    right_kind, right_dtype, right_shape = _require_operand(
+        input_types[1], "right", BINARY_DTYPES, allow_scalar=True
+    )
+    if left_dtype != right_dtype:
+        raise OpContractError(
+            "{} requires both operands to share one dtype (no implicit promotion)".format(opname),
+            field="dtype",
+            requested={"left": left_dtype, "right": right_dtype},
+            reason="dtype_mismatch",
+        )
+    tensor_shapes = [
+        shape for kind, shape in ((left_kind, left_shape), (right_kind, right_shape))
+        if kind == "tensor"
+    ]
+    if not tensor_shapes:
+        raise OpContractError(
+            "{} with two scalar operands would produce a scalar result, which the "
+            "execution contract does not represent".format(opname),
+            field="request.output",
+            requested={"left": left_kind, "right": right_kind},
+            available="at least one tensor operand",
+            reason="scalar_result_not_supported",
+        )
+    expected = _broadcast(tuple(tensor_shapes), opname)
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        left_dtype,
+        expected,
+        opname,
+        BINARY_DTYPES,
+    )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(left_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": left_dtype,
+        "input_dtypes": [left_dtype, right_dtype],
+        "input_kinds": [left_kind, right_kind],
+        "input_shapes": [list(left_shape), list(right_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": max(len(left_shape), len(right_shape)),
+        "min_dimension": _min_dimension((left_shape, right_shape)),
+        "attributes": {},
+        "precision": precision,
+    }
+
