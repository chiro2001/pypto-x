+# ---------------------------------------------------------------------------
+# registry and zero-default-change
+# ---------------------------------------------------------------------------
+def test_registry_registers_the_six_batch2_contracts():
+    registered = set(registered_opcodes())
+    assert set(BATCH2_OPS).issubset(registered)
+    assert set(FROZEN_ALL_OPS).issubset(registered)
+    for opcode in BATCH2_OPS:
+        definition = get_op_definition(opcode)
+        assert definition.canonical_opcode == opcode
+        assert definition.contract_version == "1.0"
+        assert definition.verifier == "generic"
+        assert definition.allowed_providers == ("portable",)
+        assert definition.contract_digest.startswith("sha256:")
+        assert definition.document_schema_version == 3
+        assert definition.arity == len(definition.input_roles)
+        assert definition.precision
+        assert definition.semantics
+        assert definition.canonical_opcode in GENERIC_VERIFIERS
+        aliases = tuple(
+            sorted(name for name, canonical in OP_ALIASES.items() if canonical == opcode)
+        )
+        assert definition.core_ir_opcodes == aliases
+        module_name, symbol = definition.portable_reference["executor_symbol"].rsplit(".", 1)
+        module = __import__(module_name, fromlist=[symbol])
+        assert callable(getattr(module, symbol))
+
