+                "each element is computed once in binary64 from the exactly decoded "
+                "operands and then cast to the output dtype with one RNE step; no "
+                "analytic envelope is registered for the float path",
+                "float16/bf16/float32/float64 operands with arbitrary finite or "
+                "non-finite values",
+                "one binary64 operation and one RNE cast per element; the class is "
+                "deterministic_bounded only because no envelope is registered, and "
+                "observations are never a bound",
+                when={"input_families": ["float"]},
+            ),
+        ),
+        notes=(
+            "operands share one dtype; there is no implicit dtype promotion",
+            "a scalar operand must already carry the value dtype",
+        ),
+    )
+    semantics = {
+        "operation": "out[i] = left[i] {0} right[i] over the trailing-axis broadcast "
+                     "shape; the two operands must share exactly one dtype".format(opcode),
+        "broadcast": _BROADCAST_RULE_TEXT,
+        "scalar_operands": "a rank-0 scalar operand is admitted on either side and "
+                           "broadcasts as the identity; it must already have the "
+                           "selected dtype (insert an explicit cast to change dtype); "
+                           "two scalar operands are refused because the execution "
+                           "contract returns tensors",
+        "execution_subset": "same-shape tensor-tensor and scalar requests lower to "
+                            "one op; a tensor-tensor broadcast is lowered to an "
+                            "explicit broadcast + elementwise program re-derived from "
+                            "the frozen request, so a legal broadcast executes "
+                            "instead of being refused or re-associated",
+        "nan": "IEEE-754 propagation: NaN operands produce NaN",
+        "signed_zero": "IEEE-754 signed-zero rules of the binary64 operation are "
+                       "preserved through the output cast",
+        "inf": "+inf + -inf produces NaN; float32/bf16 overflow saturates to signed "
+               "infinity, float16 overflow fails closed, integer results fail closed",
+        "subnormal": "operands are decoded exactly to binary64; the result is cast "
+                     "with RNE to the target format (subnormal or zero on underflow)",
