+def _require_ordered_container(
+    operation_name: str,
+    attributes: Mapping[str, Any],
+    keys: Sequence[str],
+    *,
+    allow_scalar: bool = False
+) -> None:
+    """Reject unordered attribute containers (set/generator/mapping).
+
+    A set or generator would make the attribute order (and therefore the
+    contract decision and the frozen plan attributes) depend on hash order.
+    Only ordered lists/tuples are accepted; slice bounds additionally accept a
+    single integer for a one-axis spelling.
+    """
+
+    for key in keys:
+        if key not in attributes:
+            continue
+        value = attributes[key]
+        if isinstance(value, (list, tuple)):
+            continue
+        if allow_scalar and isinstance(value, int) and not isinstance(value, bool):
+            continue
+        raise OpContractError(
+            "{} attribute {} must be an ordered list/tuple{}".format(
+                operation_name, key, " or an integer" if allow_scalar else ""
+            ),
+            field="operation.attributes." + key,
+            requested=type(value).__name__,
+            available=["list", "tuple"] + (["int"] if allow_scalar else []),
+            reason="unordered_attribute_container",
+        )
+
