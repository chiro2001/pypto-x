+def test_binary_integer_path_is_exact_and_fails_closed_on_overflow():
+    plan = plan_op("add", [(3,), (3,)], ["int8", "int8"])
+    assert plan.numeric_guarantee["precision"]["class"] == "exact"
+    _, output, _ = run_op(
+        "add", [(3,), (3,)], ["int8", "int8"],
+        [tensor("int8", (3,), [1, 2, 3]), tensor("int8", (3,), [4, 5, 6])],
+    )
+    assert output.data == [5, 7, 9]
+    # 127 + 1 is out of the int8 domain: the range-checked cast fails closed
+    # instead of wrapping.
+    with pytest.raises(RuntimeError):
+        run_op(
+            "add", [(1,), (1,)], ["int8", "int8"],
+            [tensor("int8", (1,), [127]), tensor("int8", (1,), [1])],
+        )
+    # An out-of-range scalar operand is refused with a structured error.
+    with pytest.raises(ExecutionError) as info:
+        run_op(
+            "add", [(1,), ()], ["int8", "int8"], [tensor("int8", (1,), [1]), 300]
+        )
+    assert info.value.reason == "operand_value_rejected"
+
