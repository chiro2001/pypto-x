+def test_view_family_default_policy_materializes_with_real_copy_bytes():
+    transpose = plan_op(
+        "transpose", [(2, 3)], ["bf16"], attributes={"permutation": [1, 0]}
+    )
+    decision = _layout(transpose)
+    assert decision["view_obligation"] == "may_alias"
+    assert decision["requested_view_mode"] == "forbid"
+    assert decision["resolved_view_mode"] == "materialized"
+    assert decision["layout_copy_bytes"] == 3 * 2 * 2  # (3,2) bf16 = 12 bytes
+    assert decision["materialize_allowed"] is True
+
+    slice_plan = plan_op(
+        "slice", [(4, 8)], ["float32"],
+        attributes={"starts": [1], "stops": [3], "axes": [0]},
+    )
+    assert _layout(slice_plan)["layout_copy_bytes"] == 2 * 8 * 4
+
+    broadcast_plan = plan_op(
+        "broadcast", [(3,)], ["float32"], attributes={"shape": [2, 3]}
+    )
+    assert _layout(broadcast_plan)["layout_copy_bytes"] == 2 * 3 * 4
