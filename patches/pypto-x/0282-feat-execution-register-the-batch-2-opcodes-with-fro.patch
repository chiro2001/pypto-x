+"""Batch-2 execution contracts (0050-A): elementwise + view/data movement.
+
+Covers:
+
+* the six new opcodes ``add``/``mul``/``rsqrt``/``transpose``/``slice``/
+  ``broadcast`` (registry, shape/dtype/attribute rules, execution differential,
+  precision declarations, fail-closed matrix);
+* the frozen-document contract patches: ``where`` scalar fill operands (patch
+  A) and ``compare.broadcast`` (patch B), both strictly additive;
+* the zero-default-change pin: the ten pre-batch-2 contract digests and a set
+  of legal batch-1/matmul plan points are byte-identical to the parent commit
+  ``41ae82a01`` (recorded by
+  ``_meta/pypto-x/u-ops-registry-batch2/scripts/record_batch2_zero_drift.py``);
+* the frozen view semantics: ``view_mode`` three-state behaviour, materialize
+  copy byte accounting, ``inplace``/``valid_shape`` and stride legality.
+"""
+
+from __future__ import annotations
+
+import math
+import struct
+
+import pytest
+
+from pypto.backends.cpu import HostTensor
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.execution import (
+    ExecutionError,
+    ExecutionPolicy,
+    NumericGuaranteeUnmetError,
+    NumericPolicy,
+    OpContractError,
+    execute_operation,
+    get_op_definition,
+    plan_operation,
+    registered_opcodes,
+    validate_report_schema,
+)
+from pypto.execution.capability import CapabilitySnapshot
+from pypto.execution.operation_contracts import (
+    BINARY_DTYPES,
+    GENERIC_VERIFIERS,
+    VIEW_DTYPES,
+)
+from pypto.execution.region import plan_region
+from pypto.lowering.cpu import OP_ALIASES
+
+
+BATCH2_OPS = ("add", "broadcast", "mul", "rsqrt", "slice", "transpose")
+FROZEN_BATCH1_OPS = (
+    "cast",
+    "compare",
+    "exp",
+    "iota",
+    "reduce_max",
+    "reduce_sum",
+    "reshape",
+    "where",
+)
+FROZEN_ALL_OPS = FROZEN_BATCH1_OPS + ("matmul", "qmatmul_s8s8_s32")
+
+# Recorded on the parent commit 41ae82a01 (same host, same capability
+# digest).  These pin the "zero default change" requirement for the ten
+# contracts frozen before 0050-A.
+FROZEN_DEFAULT_CAPABILITY_DIGEST = (
+    "sha256:e0a9dac8abc785a6a733448883cee5f1162db08e74ac5bd56cbff6f65641ad1e"
+)
+
+FROZEN_CONTRACT_DIGESTS = {
