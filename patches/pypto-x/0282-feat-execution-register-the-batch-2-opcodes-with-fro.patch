+def tensor(dtype, shape, values):
+    return HostTensor(dtype, tuple(shape), list(values))
+
+
+def plan_op(opcode, shapes, dtypes, **kwargs):
+    return plan_operation(opcode, shapes, dtypes, **kwargs).plan
+
+
+def run_op(opcode, shapes, dtypes, operands, attributes=None, **kwargs):
+    resolution = plan_operation(opcode, shapes, dtypes, attributes=attributes or {}, **kwargs)
+    output, report = execute_operation(resolution.plan, operands)
+    return resolution.plan, output, report
+
+
+def expect_reason(reason, call):
+    with pytest.raises(ExecutionError) as info:
+        call()
+    assert info.value.reason == reason, (info.value.reason, info.value)
+
