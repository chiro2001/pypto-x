+"""Clang-backed AVX-512 compiler for the PyPTO-X CPU target."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import tempfile
+from typing import Any, Mapping, Optional
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu.x86.avx512 import (
+    AVX512_BACKEND,
+    AVX512_LOWERING_VERSION,
+    Avx512Program,
+    lower_avx512,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_bytes, sha256_text
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+DEFAULT_ARTIFACT_FORMAT = "pypto-x.cpu.avx512"
+
+
+_NATIVE_SOURCE = r'''
+#include <immintrin.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef PTX_USE_FMA
+#define PTX_USE_FMA 0
+#endif
+#ifndef PTX_USE_VNNI
+#define PTX_USE_VNNI 0
+#endif
+#ifndef PTX_USE_BF16
+#define PTX_USE_BF16 0
+#endif
+#ifndef PTX_VARIANT
+#define PTX_VARIANT "avx512"
+#endif
+#ifndef PTX_SOURCE_DIGEST
+#define PTX_SOURCE_DIGEST "unknown"
+#endif
+#ifndef PTX_FEATURE_MASK
+#define PTX_FEATURE_MASK 1U
+#endif
+
+__attribute__((visibility("default"))) const char *ptx_avx512_variant = PTX_VARIANT;
+__attribute__((visibility("default"))) const char *ptx_avx512_source_digest = PTX_SOURCE_DIGEST;
+__attribute__((visibility("default"))) const unsigned int ptx_avx512_feature_mask = PTX_FEATURE_MASK;
+__attribute__((visibility("default"))) const char *ptx_avx512_abi = "pypto-x.cpu.avx512:1";
+
+static inline __m512 ptx_binary_f32(int op, __m512 a, __m512 b) {
+    if (op == 0) return _mm512_add_ps(a, b);
+    if (op == 1) return _mm512_sub_ps(a, b);
+    if (op == 2) return _mm512_mul_ps(a, b);
+    return _mm512_div_ps(a, b);
+}
+
+static inline __m512 ptx_accumulate(__m512 a, __m512 b, __m512 acc) {
+#if PTX_USE_FMA
+    return _mm512_fmadd_ps(a, b, acc);
+#else
+    return _mm512_add_ps(_mm512_mul_ps(a, b), acc);
+#endif
+}
+
+static inline float ptx_bf16_to_f32(uint16_t value) {
+    union { uint32_t bits; float value; } converted;
+    converted.bits = ((uint32_t)value) << 16;
+    return converted.value;
+}
+
+static inline uint16_t ptx_f32_to_bf16(float value) {
+    union { uint32_t bits; float value; } converted;
+    uint32_t rounding;
+    converted.value = value;
+    if ((converted.bits & 0x7f800000U) == 0x7f800000U)
+        return (uint16_t)(converted.bits >> 16);
+    rounding = 0x7fffU + ((converted.bits >> 16) & 1U);
+    return (uint16_t)((converted.bits + rounding) >> 16);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_copy_f32(const float *input, float *output, size_t n) {
+    size_t i = 0;
+    for (; i + 16 <= n; i += 16)
+        _mm512_storeu_ps(output + i, _mm512_loadu_ps(input + i));
+    if (i < n) {
+        __mmask16 mask = (__mmask16)((1U << (n - i)) - 1U);
+        _mm512_mask_storeu_ps(output + i, mask, _mm512_maskz_loadu_ps(mask, input + i));
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_neg_f32(const float *input, float *output, size_t n) {
+    size_t i = 0;
+    const __m512 zero = _mm512_setzero_ps();
+    for (; i + 16 <= n; i += 16)
+        _mm512_storeu_ps(output + i, _mm512_sub_ps(zero, _mm512_loadu_ps(input + i)));
+    if (i < n) {
+        __mmask16 mask = (__mmask16)((1U << (n - i)) - 1U);
+        __m512 value = _mm512_sub_ps(zero, _mm512_maskz_loadu_ps(mask, input + i));
+        _mm512_mask_storeu_ps(output + i, mask, value);
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_binary_f32(int op, const float *left, int left_scalar,
+                           const float *right, int right_scalar,
+                           float *output, size_t n) {
+    size_t i = 0;
+    for (; i + 16 <= n; i += 16) {
+        __m512 a = left_scalar ? _mm512_set1_ps(left[0]) : _mm512_loadu_ps(left + i);
+        __m512 b = right_scalar ? _mm512_set1_ps(right[0]) : _mm512_loadu_ps(right + i);
+        _mm512_storeu_ps(output + i, ptx_binary_f32(op, a, b));
+    }
+    if (i < n) {
+        __mmask16 mask = (__mmask16)((1U << (n - i)) - 1U);
+        __m512 a = left_scalar ? _mm512_set1_ps(left[0]) : _mm512_maskz_loadu_ps(mask, left + i);
+        __m512 b = right_scalar ? _mm512_set1_ps(right[0]) : _mm512_maskz_loadu_ps(mask, right + i);
+        _mm512_mask_storeu_ps(output + i, mask, ptx_binary_f32(op, a, b));
+    }
+}
+
+static inline void ptx_load_bf16(const uint16_t *input, float *output, size_t start, size_t count) {
+    size_t lane;
+    for (lane = 0; lane < count; ++lane) output[lane] = ptx_bf16_to_f32(input[start + lane]);
+}
+
+static inline void ptx_store_bf16(uint16_t *output, const float *input, size_t start, size_t count) {
+    size_t lane;
+    for (lane = 0; lane < count; ++lane) output[start + lane] = ptx_f32_to_bf16(input[lane]);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_copy_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16], result[16];
+    for (; i + 16 <= n; i += 16) {
+        ptx_load_bf16(input, values, i, 16);
+        _mm512_storeu_ps(result, _mm512_loadu_ps(values));
+        ptx_store_bf16(output, result, i, 16);
+    }
+    if (i < n) {
+        size_t count = n - i;
+        __mmask16 mask = (__mmask16)((1U << count) - 1U);
+        ptx_load_bf16(input, values, i, count);
+        _mm512_storeu_ps(result, _mm512_maskz_loadu_ps(mask, values));
+        for (lane = 0; lane < count; ++lane) output[i + lane] = ptx_f32_to_bf16(result[lane]);
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_neg_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16], result[16];
+    const __m512 zero = _mm512_setzero_ps();
+    for (; i + 16 <= n; i += 16) {
+        ptx_load_bf16(input, values, i, 16);
+        _mm512_storeu_ps(result, _mm512_sub_ps(zero, _mm512_loadu_ps(values)));
+        ptx_store_bf16(output, result, i, 16);
+    }
+    if (i < n) {
+        size_t count = n - i;
+        __mmask16 mask = (__mmask16)((1U << count) - 1U);
+        ptx_load_bf16(input, values, i, count);
+        _mm512_storeu_ps(result, _mm512_sub_ps(zero, _mm512_maskz_loadu_ps(mask, values)));
+        for (lane = 0; lane < count; ++lane) output[i + lane] = ptx_f32_to_bf16(result[lane]);
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_binary_bf16(int op, const uint16_t *left, int left_scalar,
+                            const uint16_t *right, int right_scalar,
+                            uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float a_values[16], b_values[16], result[16];
+    for (; i + 16 <= n; i += 16) {
+        for (lane = 0; lane < 16; ++lane) {
+            a_values[lane] = ptx_bf16_to_f32(left_scalar ? left[0] : left[i + lane]);
+            b_values[lane] = ptx_bf16_to_f32(right_scalar ? right[0] : right[i + lane]);
+        }
+        _mm512_storeu_ps(result, ptx_binary_f32(op, _mm512_loadu_ps(a_values), _mm512_loadu_ps(b_values)));
+        ptx_store_bf16(output, result, i, 16);
+    }
+    if (i < n) {
+        size_t count = n - i;
+        __mmask16 mask = (__mmask16)((1U << count) - 1U);
+        for (lane = 0; lane < count; ++lane) {
+            a_values[lane] = ptx_bf16_to_f32(left_scalar ? left[0] : left[i + lane]);
+            b_values[lane] = ptx_bf16_to_f32(right_scalar ? right[0] : right[i + lane]);
+        }
+        _mm512_storeu_ps(result, ptx_binary_f32(op, _mm512_maskz_loadu_ps(mask, a_values),
+                                                _mm512_maskz_loadu_ps(mask, b_values)));
+        for (lane = 0; lane < count; ++lane) output[i + lane] = ptx_f32_to_bf16(result[lane]);
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_reduce_sum_f32(const float *input, float *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16];
+    __m512 accumulator = _mm512_setzero_ps();
+    for (; i + 16 <= n; i += 16) accumulator = _mm512_add_ps(accumulator, _mm512_loadu_ps(input + i));
+    if (i < n) {
+        __mmask16 mask = (__mmask16)((1U << (n - i)) - 1U);
+        accumulator = _mm512_add_ps(accumulator, _mm512_maskz_loadu_ps(mask, input + i));
+    }
+    _mm512_storeu_ps(values, accumulator);
+    *output = 0.0f;
+    for (lane = 0; lane < 16; ++lane) *output += values[lane];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_reduce_max_f32(const float *input, float *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16];
+    if (n == 0) return;
+    if (n < 16) { *output = input[0]; for (i = 1; i < n; ++i) if (input[i] > *output) *output = input[i]; return; }
+    __m512 accumulator = _mm512_loadu_ps(input);
+    for (i = 16; i + 16 <= n; i += 16) accumulator = _mm512_max_ps(accumulator, _mm512_loadu_ps(input + i));
+    if (i < n) {
+        __mmask16 mask = (__mmask16)((1U << (n - i)) - 1U);
+        accumulator = _mm512_max_ps(accumulator, _mm512_maskz_loadu_ps(mask, input + i));
+    }
+    _mm512_storeu_ps(values, accumulator);
+    *output = values[0];
+    for (lane = 1; lane < 16; ++lane) if (values[lane] > *output) *output = values[lane];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_reduce_sum_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16], lanes[16];
+    __m512 accumulator = _mm512_setzero_ps();
+    for (; i + 16 <= n; i += 16) {
+        ptx_load_bf16(input, values, i, 16);
+        accumulator = _mm512_add_ps(accumulator, _mm512_loadu_ps(values));
+    }
+    if (i < n) {
+        size_t count = n - i;
+        __mmask16 mask = (__mmask16)((1U << count) - 1U);
+        ptx_load_bf16(input, values, i, count);
+        accumulator = _mm512_add_ps(accumulator, _mm512_maskz_loadu_ps(mask, values));
+    }
+    _mm512_storeu_ps(lanes, accumulator);
+    values[0] = 0.0f;
+    for (lane = 0; lane < 16; ++lane) values[0] += lanes[lane];
+    *output = ptx_f32_to_bf16(values[0]);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_reduce_max_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float values[16], lanes[16];
+    if (n == 0) return;
+    if (n < 16) {
+        *output = input[0];
+        for (i = 1; i < n; ++i) if (ptx_bf16_to_f32(input[i]) > ptx_bf16_to_f32(*output)) *output = input[i];
+        return;
+    }
+    ptx_load_bf16(input, values, 0, 16);
+    __m512 accumulator = _mm512_loadu_ps(values);
+    for (i = 16; i + 16 <= n; i += 16) {
+        ptx_load_bf16(input, values, i, 16);
+        accumulator = _mm512_max_ps(accumulator, _mm512_loadu_ps(values));
+    }
+    if (i < n) {
+        size_t count = n - i;
+        __mmask16 mask = (__mmask16)((1U << count) - 1U);
+        ptx_load_bf16(input, values, i, count);
+        accumulator = _mm512_max_ps(accumulator, _mm512_maskz_loadu_ps(mask, values));
+    }
+    _mm512_storeu_ps(lanes, accumulator);
+    *output = ptx_f32_to_bf16(lanes[0]);
+    for (lane = 1; lane < 16; ++lane)
+        if (lanes[lane] > ptx_bf16_to_f32(*output)) *output = ptx_f32_to_bf16(lanes[lane]);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_matmul_f32(const float *left, const float *right, float *output,
+                           size_t m, size_t k, size_t n) {
+    size_t row, inner, column;
+    for (row = 0; row < m; ++row) {
+        for (column = 0; column + 16 <= n; column += 16) {
+            __m512 accumulator = _mm512_setzero_ps();
+            for (inner = 0; inner < k; ++inner)
+                accumulator = ptx_accumulate(_mm512_set1_ps(left[row * k + inner]),
+                                             _mm512_loadu_ps(right + inner * n + column), accumulator);
+            _mm512_storeu_ps(output + row * n + column, accumulator);
+        }
+        if (column < n) {
+            size_t count = n - column;
+            __mmask16 mask = (__mmask16)((1U << count) - 1U);
+            __m512 accumulator = _mm512_setzero_ps();
+            for (inner = 0; inner < k; ++inner)
+                accumulator = ptx_accumulate(_mm512_set1_ps(left[row * k + inner]),
+                                             _mm512_maskz_loadu_ps(mask, right + inner * n + column), accumulator);
+            _mm512_mask_storeu_ps(output + row * n + column, mask, accumulator);
+        }
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx512_matmul_bf16(const uint16_t *left, const uint16_t *right, uint16_t *output,
+                            size_t m, size_t k, size_t n) {
+    size_t row, inner, column, lane;
+    float left_values[16], right_values[16], result[16];
+    for (row = 0; row < m; ++row) {
+        for (column = 0; column + 16 <= n; column += 16) {
+#if PTX_USE_BF16
+            __m512 accumulator = _mm512_setzero_ps();
+            size_t pair;
+            for (pair = 0; pair + 1 < k; pair += 2) {
+                uint16_t a_values[32], b_values[32];
+                for (lane = 0; lane < 16; ++lane) {
+                    a_values[2 * lane] = left[row * k + pair];
+                    a_values[2 * lane + 1] = left[row * k + pair + 1];
+                    b_values[2 * lane] = right[pair * n + column + lane];
+                    b_values[2 * lane + 1] = right[(pair + 1) * n + column + lane];
+                }
+                accumulator = _mm512_dpbf16_ps(
+                    accumulator, (__m512bh)_mm512_loadu_si512(a_values),
+                    (__m512bh)_mm512_loadu_si512(b_values));
+            }
+            _mm512_storeu_ps(result, accumulator);
+            if (k & 1) {
+                for (lane = 0; lane < 16; ++lane)
+                    result[lane] += ptx_bf16_to_f32(left[row * k + k - 1]) *
+                                    ptx_bf16_to_f32(right[(k - 1) * n + column + lane]);
+            }
+            for (lane = 0; lane < 16; ++lane) output[row * n + column + lane] = ptx_f32_to_bf16(result[lane]);
+#else
+            for (lane = 0; lane < 16; ++lane) result[lane] = 0.0f;
+            for (inner = 0; inner < k; ++inner)
+                for (lane = 0; lane < 16; ++lane)
+                    result[lane] += ptx_bf16_to_f32(left[row * k + inner]) *
+                                    ptx_bf16_to_f32(right[inner * n + column + lane]);
+            for (lane = 0; lane < 16; ++lane) output[row * n + column + lane] = ptx_f32_to_bf16(result[lane]);
+#endif
+        }
+        if (column < n) {
+            size_t count = n - column;
+            for (lane = 0; lane < count; ++lane) result[lane] = 0.0f;
+            for (inner = 0; inner < k; ++inner)
+                for (lane = 0; lane < count; ++lane)
+                    result[lane] += ptx_bf16_to_f32(left[row * k + inner]) *
+                                    ptx_bf16_to_f32(right[inner * n + column + lane]);
+            for (lane = 0; lane < count; ++lane) output[row * n + column + lane] = ptx_f32_to_bf16(result[lane]);
+        }
+    }
+}
+
+#if PTX_USE_VNNI
+__attribute__((visibility("default")))
+void ptx_avx512_vnni_dot_i8(const uint8_t *left, const int8_t *right,
+                            int32_t *output, size_t n) {
+    size_t i = 0, lane;
+    int32_t lanes[16];
+    __m512i accumulator = _mm512_setzero_si512();
+    for (; i + 64 <= n; i += 64)
+        accumulator = _mm512_dpbusd_epi32(
+            accumulator, _mm512_loadu_si512(left + i), _mm512_loadu_si512(right + i));
+    _mm512_storeu_si512(lanes, accumulator);
+    *output = 0;
+    for (lane = 0; lane < 16; ++lane) *output += lanes[lane];
+    for (; i < n; ++i) *output += (int32_t)left[i] * (int32_t)right[i];
+}
+#endif
+'''
+
+
+class Avx512CompileError(RuntimeError):
+    """Clang could not produce an AVX-512 shared object."""
+
+
+def _plain_mapping(value: Mapping[str, Any]) -> dict:
+    if not isinstance(value, Mapping):
+        raise TypeError("metadata must be a mapping")
+    return {key: _plain_value(item) for key, item in value.items()}
+
+
+def _plain_value(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [_plain_value(item) for item in value]
+    if isinstance(value, list):
+        return [_plain_value(item) for item in value]
+    return value
+
+
+def _cacheable_extra(value: Mapping[str, Any]) -> dict:
+    volatile = frozenset(("build_dir", "tmp_dir", "artifact_dir", "source_path", "output_path"))
+    return {key: _plain_value(item) for key, item in value.items() if key not in volatile}
+
+
+def _build_directory(options: Optional[CompileOptions]) -> Path:
+    extra = {} if options is None else mapping_copy(options.extra)
+    selected = extra.get("build_dir") or os.environ.get("PYPTO_X_AVX512_BUILD_DIR")
+    if selected is None:
+        selected = tempfile.mkdtemp(prefix="pypto-x-avx512-", dir=os.environ.get("TMPDIR") or None)
+    path = Path(os.fspath(selected)).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    (path / "tmp").mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _artifact_directory(options: Optional[CompileOptions], build_dir: Path) -> Path:
+    extra = {} if options is None else mapping_copy(options.extra)
+    selected = extra.get("artifact_dir") or os.environ.get("PYPTO_X_AVX512_ARTIFACT_DIR")
+    path = Path(os.fspath(selected or (build_dir / "artifacts"))).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _read_and_lock_existing_artifact(path: Path) -> Optional[bytes]:
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(str(path), os.O_RDONLY | nofollow)
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise Avx512CompileError(
+            "content-addressed artifact path is not a safe regular file: {} ({})".format(path, exc)
+        ) from exc
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
+            raise Avx512CompileError(
+                "content-addressed artifact path must be a single-link regular file: {}".format(path)
+            )
+        chunks = []
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        os.fchmod(descriptor, 0o444)
+        return b"".join(chunks)
+    finally:
+        os.close(descriptor)
+
+
+def _native_source(target_ir: Avx512Program) -> tuple:
+    mask = 1
+    mask |= 2 if target_ir.use_fma else 0
+    mask |= 4 if target_ir.use_dq else 0
+    mask |= 8 if target_ir.use_bw else 0
+    mask |= 16 if target_ir.use_vl else 0
+    mask |= 32 if target_ir.use_vnni else 0
+    mask |= 64 if target_ir.use_bf16 else 0
+    contract = "pypto-x.cpu.avx512.native.v1\n{}\nvariant={}\n".format(
+        _NATIVE_SOURCE, target_ir.native_variant
+    )
+    digest = hashlib.sha256(contract.encode("utf-8")).hexdigest()
+    prefix = (
+        "#define PTX_USE_FMA {}\n"
+        "#define PTX_USE_VNNI {}\n"
+        "#define PTX_USE_BF16 {}\n"
+        "#define PTX_VARIANT \"{}\"\n"
+        "#define PTX_SOURCE_DIGEST \"{}\"\n"
+        "#define PTX_FEATURE_MASK {}U\n"
+    ).format(
+        int(target_ir.use_fma),
+        int(target_ir.use_vnni),
+        int(target_ir.use_bf16),
+        target_ir.native_variant,
+        digest,
+        mask,
+    )
+    return prefix + _NATIVE_SOURCE, digest, mask
+
+
+def _compiler_info(compiler_path: str) -> tuple:
+    version_result = subprocess.run(
+        [compiler_path, "--version"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    version = (version_result.stdout.splitlines() or [compiler_path])[0].strip()
+    if "clang" not in version.lower():
+        raise Avx512CompileError("AVX-512 requires a real Clang compiler, got {!r}".format(version))
+    triple_result = subprocess.run(
+        [compiler_path, "-print-target-triple"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    triple = triple_result.stdout.strip() or "unknown"
+    if not triple.lower().startswith(("x86_64", "amd64")):
+        raise Avx512CompileError("Clang target triple {!r} is not x86_64/amd64".format(triple))
+    return version, triple
+
+
+def _compile_native(target_ir: Avx512Program, options: Optional[CompileOptions]) -> tuple:
+    extra = {} if options is None else mapping_copy(options.extra)
+    compiler = str(extra.get("clang") or "clang")
+    if not Path(compiler).name.lower().startswith("clang"):
+        raise Avx512CompileError("AVX-512 requires Clang; refusing compiler {!r}".format(compiler))
+    compiler_path = shutil.which(compiler) or compiler
+    if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
+        raise Avx512CompileError("Clang compiler {!r} was not found".format(compiler))
+    compiler_version, target_triple = _compiler_info(compiler_path)
+    build_dir = _build_directory(options)
+    artifact_dir = _artifact_directory(options, build_dir)
+    source, source_digest, feature_mask = _native_source(target_ir)
+    stem = "pypto_x_avx512_{}".format(source_digest[:20])
+    temporary_dir = build_dir / "tmp"
+    invocation = Path(tempfile.mkdtemp(prefix=stem + "-", dir=str(temporary_dir)))
+    source_path = invocation / (stem + ".c")
+    temporary_output = invocation / (stem + ".so")
+    try:
+        source_path.write_text(source, encoding="utf-8")
+        command = [compiler_path, "-shared", "-fPIC", "-O2", "-std=c99", "-mavx512f"]
+        feature_flags = ["-mavx512f"]
+        if target_ir.use_fma:
+            command.append("-mfma")
+            feature_flags.append("-mfma")
+        else:
+            command.append("-ffp-contract=off")
+            feature_flags.append("-ffp-contract=off")
+        if target_ir.use_dq:
+            command.append("-mavx512dq")
+            feature_flags.append("-mavx512dq")
+        if target_ir.use_bw:
+            command.append("-mavx512bw")
+            feature_flags.append("-mavx512bw")
+        if target_ir.use_vl:
+            command.append("-mavx512vl")
+            feature_flags.append("-mavx512vl")
+        if target_ir.use_vnni:
+            command.append("-mavx512vnni")
+            feature_flags.append("-mavx512vnni")
+        if target_ir.use_bf16:
+            command.append("-mavx512bf16")
+            feature_flags.append("-mavx512bf16")
+        command.extend([str(source_path), "-o", str(temporary_output)])
+        environment = dict(os.environ)
+        environment["TMPDIR"] = str(build_dir / "tmp")
+        result = subprocess.run(
+            command,
+            cwd=str(invocation),
+            env=environment,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            universal_newlines=True,
+            check=False,
+        )
+        if result.returncode != 0 or not temporary_output.is_file():
+            raise Avx512CompileError(
+                "Clang AVX-512 compilation failed ({}): {}".format(
+                    result.returncode, (result.stderr or result.stdout).strip()
+                )
+            )
+        native_bytes = temporary_output.read_bytes()
+    finally:
+        shutil.rmtree(str(invocation), ignore_errors=True)
+    native_digest = sha256_bytes(native_bytes)
+    output_path = artifact_dir / ("pypto_x_avx512_{}.so".format(native_digest))
+    existing = _read_and_lock_existing_artifact(output_path)
+    if existing is not None:
+        if existing != native_bytes:
+            raise Avx512CompileError("content-addressed AVX-512 artifact path contains different bytes")
+    else:
+        descriptor, temporary_name = tempfile.mkstemp(prefix=output_path.name + ".tmp.", dir=str(artifact_dir))
+        os.close(descriptor)
+        publication = Path(temporary_name)
+        try:
+            publication.write_bytes(native_bytes)
+            os.chmod(str(publication), 0o444)
+            existing = _read_and_lock_existing_artifact(output_path)
+            if existing is not None:
+                if existing != native_bytes:
+                    raise Avx512CompileError("content-addressed AVX-512 publication raced with different bytes")
+            else:
+                os.replace(str(publication), str(output_path))
+        finally:
+            if publication.exists():
+                publication.unlink()
+    normalized = [Path(compiler_path).name]
+    normalized.extend(command[1:-3])
+    normalized.extend([source_path.name, "-o", output_path.name])
+    return (
+        output_path,
+        source_digest,
+        native_digest,
+        compiler_path,
+        compiler_version,
+        target_triple,
+        tuple(normalized),
+        feature_mask,
+        tuple(feature_flags),
+    )
+
+
+class Avx512Compiler:
+    """Lower and compile an AVX-512 program with Clang."""
+
+    name = AVX512_BACKEND
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> Avx512Program:
+        return lower_avx512(program, target)
+
+    def compile(self, target_ir: Avx512Program, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, Avx512Program):
+            raise TypeError("AVX-512 compile() requires Avx512Program from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        if options is not None and options.artifact_format != DEFAULT_ARTIFACT_FORMAT:
+            raise Avx512CompileError(
+                "AVX-512 compiler requires artifact format {!r}, got {!r}".format(
+                    DEFAULT_ARTIFACT_FORMAT, options.artifact_format
+                )
+            )
+        if options is not None and options.abi_version != ABI_VERSION:
+            raise Avx512CompileError(
+                "AVX-512 compiler requires ABI {!r}, got {!r}".format(ABI_VERSION, options.abi_version)
+            )
+        target_ir.validate()
+        (
+            output_path,
+            source_digest,
+            native_digest,
+            compiler_path,
+            compiler_version,
+            target_triple,
+            command,
+            feature_mask,
+            native_flags,
+        ) = _compile_native(target_ir, options)
+        program_json = target_ir.program.canonical_json()
+        program_data = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        plan_data = _plain_mapping(target_ir.vector_program.to_dict())
+        metadata = {
+            "backend": AVX512_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "lowering_version": AVX512_LOWERING_VERSION,
+            "plan_version": plan_data["plan_version"],
+            "entrypoint": target_ir.entrypoint,
+            "program": program_data,
+            "program_digest": program_digest,
+            "vector_plan": plan_data,
+            "plan_digest": target_ir.plan_digest,
+            "target_digest": sha256_text(target_ir.target.to_dict()),
+            "required_features": list(target_ir.required_features.features),
+            "required_feature_source": target_ir.required_features.source,
+            "native_isa": "avx512",
+            "native_format": "elf-shared-object",
+            "native_digest": native_digest,
+            "native_source_digest": source_digest,
+            "native_feature_mask": feature_mask,
+            "native_variant": target_ir.native_variant,
+            "native_flags": list(native_flags),
+            "compiler": Path(compiler_path).name,
+            "compiler_version": compiler_version,
+            "compiler_target_triple": target_triple,
+            "compile_command": list(command),
+            "use_fma": target_ir.use_fma,
+            "use_dq": target_ir.use_dq,
+            "use_bw": target_ir.use_bw,
+            "use_vl": target_ir.use_vl,
+            "use_vnni": target_ir.use_vnni,
+            "use_bf16": target_ir.use_bf16,
+            "public_core_vnni": False,
+            "public_core_bf16": target_ir.use_bf16,
+        }
+        if options is not None:
+            option_metadata = _plain_mapping(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError(
+                    "compile option metadata uses reserved AVX-512 keys: {}".format(
+                        ", ".join(sorted(reserved))
+                    )
+                )
+            metadata.update(option_metadata)
+            metadata["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "extra": _cacheable_extra(mapping_copy(options.extra)),
+            }
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            path=str(output_path),
+            metadata=metadata,
+        )
+        artifact.validate()
+        if artifact.content_digest != native_digest:
+            raise Avx512CompileError("native artifact digest changed while packaging")
+        return artifact
+
+
+CPUAVX512Compiler = Avx512Compiler
+CPUAvx512Compiler = Avx512Compiler
+
+
+def compile_cpu_avx512(
+    program: CoreProgram,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None,
+) -> Artifact:
+    compiler = Avx512Compiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION",
+    "AVX512_BACKEND",
+    "Avx512CompileError",
+    "Avx512Compiler",
+    "CPUAVX512Compiler",
+    "CPUAvx512Compiler",
+    "DEFAULT_ARTIFACT_FORMAT",
+    "compile_cpu_avx512",
+]
