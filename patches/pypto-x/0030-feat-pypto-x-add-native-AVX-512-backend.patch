+def test_artifact_tampering_and_cache_variants_are_rejected(tmp_path):
+    program = _elementwise()
+    _, _, base = _compile(program, _target("avx512f"), tmp_path / "base")
+    _, _, fma = _compile(program, _target("avx512f", "fma"), tmp_path / "fma")
+    assert base.cache_key != fma.cache_key
+    assert base.content_digest != fma.content_digest
+    original = Path(base.path).read_bytes()
+    tampered_path = tmp_path / "tampered.so"
+    tampered_path.write_bytes(original + b"tamper")
+    tampered = Artifact(
+        format=base.format,
+        entrypoint=base.entrypoint,
+        target=base.target,
+        abi_version=base.abi_version,
+        path=str(tampered_path),
+        metadata=base.metadata,
+    )
+    with pytest.raises(CpuAvx512ArtifactError):
+        _runtime().load(tampered)
+
