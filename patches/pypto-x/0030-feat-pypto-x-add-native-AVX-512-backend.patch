+def test_avx2_fallback_dispatch_never_maps_avx512(tmp_path, monkeypatch):
+    program = _elementwise(shape=(17,))
+    _, _, avx512_artifact = _compile(program, _target("avx512f"), tmp_path / "avx512")
+    avx2_compiler = Avx2Compiler()
+    avx2_target = TargetSpec(
+        "cpu",
+        "x86_64-linux-gnu",
+        features=("avx2",),
+        attributes={"lane_count": 8},
+    )
+    avx2_artifact = avx2_compiler.compile(
+        avx2_compiler.lower(program, avx2_target),
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2",
+            extra={"build_dir": str(tmp_path / "avx2")},
+        ),
+    )
+    missing = Avx512Capability.injected_capability(())
+    runtime = Avx512Runtime(capability=missing)
+    monkeypatch.setattr(capabilities_module, "probe_avx512_capabilities", lambda **kwargs: missing)
+    fail_avx512 = {"called": False}
+    original_load = runtime.load
+
+    def fail_load(*args, **kwargs):
+        fail_avx512["called"] = True
+        raise AssertionError("AVX-512 load must not run on fallback")
+
+    monkeypatch.setattr(runtime, "load", fail_load)
+    left = HostTensor("float32", (17,), [float(index) for index in range(17)])
+    right = HostTensor("float32", (17,), [2.0] * 17)
+    output = HostTensor.zeros("float32", (17,))
+    runtime.launch(
+        LaunchRequest(
+            avx512_artifact,
+            inputs=[left.descriptor(readonly=True), right.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        ),
+        fallback_artifact=avx2_artifact,
+    )
+    assert not fail_avx512["called"]
+    assert output.flat() == tuple(float(index + 2) for index in range(17))
+
