@@ -0,0 +1,395 @@
+"""AVX-512 lowering on top of the ISA-neutral CPU vector plan."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu import canonical_dtype
+from pypto.lowering.cpu.vector import (
+    CpuFeatureSet,
+    CpuVectorProgram,
+    TailPolicy,
+    lower_cpu_vector,
+)
+from pypto.target import TargetSpec
+
+
+AVX512_BACKEND = "cpu.avx512"
+AVX512_LOWERING_VERSION = 1
+AVX512_LANE_COUNT = 16
+AVX512_TAIL_POLICY = TailPolicy.MASKED
+_BASE_FEATURES = frozenset(("avx", "avx512f", "osxsave", "ymm", "opmask", "zmm"))
+_ISA_FEATURES = frozenset(
+    _BASE_FEATURES
+    | {
+        "fma",
+        "avx512dq",
+        "avx512bw",
+        "avx512vl",
+        "avx512vnni",
+        "avx512bf16",
+    }
+)
+
+
+class Avx512Error(ValueError):
+    """Base class for AVX-512 lowering errors."""
+
+
+class Avx512ValidationError(Avx512Error):
+    """The target or vector plan violates the AVX-512 contract."""
+
+
+class Avx512UnsupportedError(Avx512Error):
+    """The validated scalar subset is not implemented by AVX-512."""
+
+
+def _canonical_feature(value: Any) -> str:
+    name = str(value).strip().lower().replace("_", "").replace("-", "")
+    return {
+        "avx512": "avx512f",
+        "f": "avx512f",
+        "dq": "avx512dq",
+        "bw": "avx512bw",
+        "vl": "avx512vl",
+        "vnni": "avx512vnni",
+        "bf16": "avx512bf16",
+    }.get(name, name)
+
+
+def _normalised_features(value: Any) -> tuple:
+    if isinstance(value, str):
+        value = (value,)
+    try:
+        return tuple(sorted({_canonical_feature(item) for item in value if str(item).strip()}))
+    except TypeError as exc:
+        raise Avx512ValidationError("features must be a sequence") from exc
+
+
+def _normalised_target(target: TargetSpec) -> TargetSpec:
+    features = _normalised_features(target.features)
+    if features == tuple(target.features):
+        return target
+    return TargetSpec(
+        target.kind,
+        target.triple,
+        features=features,
+        device=target.device,
+        abi=target.abi,
+        attributes=target.attributes,
+    )
+
+
+def _feature_values(value: Any) -> tuple:
+    if isinstance(value, CpuFeatureSet):
+        return tuple(_canonical_feature(item) for item in value.features)
+    if value is None:
+        return ()
+    if isinstance(value, str):
+        return (_canonical_feature(value),)
+    try:
+        return tuple(_canonical_feature(item) for item in value if str(item).strip())
+    except TypeError as exc:
+        raise Avx512ValidationError("required_features must be a feature sequence") from exc
+
+
+def _bool_attribute(target: TargetSpec, names: tuple, default: bool) -> bool:
+    for name in names:
+        if name in target.attributes:
+            value = target.attributes[name]
+            if not isinstance(value, bool):
+                raise Avx512ValidationError("target.attributes[{}] must be bool".format(name))
+            return value
+    return default
+
+
+def _variant_options(target: TargetSpec) -> Mapping[str, bool]:
+    names = set(_normalised_features(target.features))
+    return {
+        "fma": _bool_attribute(target, ("use_fma",), "fma" in names),
+        "dq": _bool_attribute(target, ("use_dq", "use_avx512dq"), "avx512dq" in names),
+        "bw": _bool_attribute(target, ("use_bw", "use_avx512bw"), "avx512bw" in names),
+        "vl": _bool_attribute(target, ("use_vl", "use_avx512vl"), "avx512vl" in names),
+        "vnni": _bool_attribute(
+            target, ("use_vnni", "use_avx512vnni"), "avx512vnni" in names
+        ),
+        "bf16": _bool_attribute(
+            target, ("use_bf16", "use_avx512bf16"), "avx512bf16" in names
+        ),
+    }
+
+
+def _target_lane_count(target: TargetSpec) -> Optional[int]:
+    for key in ("lane_count", "vector_lanes", "vector_lane_count", "vector_block_elements", "vector_width"):
+        if key in target.attributes:
+            value = target.attributes[key]
+            if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+                raise Avx512ValidationError("target.attributes[{}] must be a positive integer".format(key))
+            return value
+    return None
+
+
+def _normalised_required(required: Any, options: Mapping[str, bool]) -> CpuFeatureSet:
+    explicit = list(_feature_values(required))
+    for feature in sorted(_BASE_FEATURES):
+        if feature not in explicit:
+            explicit.append(feature)
+    for key, feature in (
+        ("fma", "fma"),
+        ("dq", "avx512dq"),
+        ("bw", "avx512bw"),
+        ("vl", "avx512vl"),
+        ("vnni", "avx512vnni"),
+        ("bf16", "avx512bf16"),
+    ):
+        if options[key] and feature not in explicit:
+            explicit.append(feature)
+    return CpuFeatureSet(tuple(explicit), source="compiler")
+
+
+def _variant_name(options: Mapping[str, bool]) -> str:
+    suffix = []
+    for key in ("fma", "dq", "bw", "vl", "vnni", "bf16"):
+        if options[key]:
+            suffix.append(key)
+    return "avx512" if not suffix else "avx512-{}".format("-".join(suffix))
+
+
+@dataclass(frozen=True)
+class Avx512Program:
+    """Validated AVX-512 target IR and shared vector-common plan."""
+
+    vector_program: CpuVectorProgram
+    use_fma: bool
+    use_dq: bool = False
+    use_bw: bool = False
+    use_vl: bool = False
+    use_vnni: bool = False
+    use_bf16: bool = False
+    lowering_version: int = AVX512_LOWERING_VERSION
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.vector_program, CpuVectorProgram):
+            raise Avx512ValidationError("AVX-512 program requires CpuVectorProgram")
+        if self.lowering_version != AVX512_LOWERING_VERSION:
+            raise Avx512ValidationError("unsupported AVX-512 lowering version {!r}".format(self.lowering_version))
+        if self.vector_program.target.kind != "cpu":
+            raise Avx512ValidationError("AVX-512 target requires kind='cpu'")
+        if not self.vector_program.target.triple.startswith(("x86_64", "amd64")):
+            raise Avx512ValidationError("AVX-512 target requires an x86_64 triple")
+        if self.vector_program.lane_count != AVX512_LANE_COUNT:
+            raise Avx512ValidationError("AVX-512 requires {} float32 lanes".format(AVX512_LANE_COUNT))
+        if self.vector_program.tail_policy != AVX512_TAIL_POLICY:
+            raise Avx512ValidationError("AVX-512 requires opmask masked tails")
+        for value, name in (
+            (self.use_fma, "use_fma"),
+            (self.use_dq, "use_dq"),
+            (self.use_bw, "use_bw"),
+            (self.use_vl, "use_vl"),
+            (self.use_vnni, "use_vnni"),
+            (self.use_bf16, "use_bf16"),
+        ):
+            if not isinstance(value, bool):
+                raise Avx512ValidationError("{} must be bool".format(name))
+        required = set(self.vector_program.required_features.features)
+        missing = sorted(_BASE_FEATURES.difference(required))
+        if missing:
+            raise Avx512ValidationError("AVX-512 vector plan must require {}".format(", ".join(missing)))
+        for enabled, feature in (
+            (self.use_fma, "fma"),
+            (self.use_dq, "avx512dq"),
+            (self.use_bw, "avx512bw"),
+            (self.use_vl, "avx512vl"),
+            (self.use_vnni, "avx512vnni"),
+            (self.use_bf16, "avx512bf16"),
+        ):
+            if enabled and feature not in required:
+                raise Avx512ValidationError("{} variant must declare {}".format(feature, feature))
+            if not enabled and feature in required:
+                raise Avx512ValidationError("disabled variant must not declare {}".format(feature))
+        for plan in self.vector_program.plans:
+            if canonical_dtype(plan.dtype) not in ("float32", "bf16"):
+                raise Avx512UnsupportedError(
+                    "AVX-512 supports float32 and bf16 plans, got {!r}".format(plan.dtype)
+                )
+
+    @property
+    def program(self) -> CoreProgram:
+        return self.vector_program.program
+
+    @property
+    def target(self) -> TargetSpec:
+        return self.vector_program.target
+
+    @property
+    def entrypoint(self) -> str:
+        return self.vector_program.entrypoint
+
+    @property
+    def required_features(self) -> CpuFeatureSet:
+        return self.vector_program.required_features
+
+    @property
+    def lane_count(self) -> int:
+        return self.vector_program.lane_count
+
+    @property
+    def tail_policy(self) -> TailPolicy:
+        return self.vector_program.tail_policy
+
+    @property
+    def plans(self):
+        return self.vector_program.plans
+
+    @property
+    def plan_digest(self) -> str:
+        return self.vector_program.plan_digest
+
+    @property
+    def native_variant(self) -> str:
+        return _variant_name(
+            {
+                "fma": self.use_fma,
+                "dq": self.use_dq,
+                "bw": self.use_bw,
+                "vl": self.use_vl,
+                "vnni": self.use_vnni,
+                "bf16": self.use_bf16,
+            }
+        )
+
+    def validate(self) -> "Avx512Program":
+        self.vector_program.validate()
+        Avx512Program(
+            self.vector_program,
+            self.use_fma,
+            self.use_dq,
+            self.use_bw,
+            self.use_vl,
+            self.use_vnni,
+            self.use_bf16,
+            self.lowering_version,
+        )
+        return self
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "backend": AVX512_BACKEND,
+            "lowering_version": self.lowering_version,
+            "use_fma": self.use_fma,
+            "use_dq": self.use_dq,
+            "use_bw": self.use_bw,
+            "use_vl": self.use_vl,
+            "use_vnni": self.use_vnni,
+            "use_bf16": self.use_bf16,
+            "native_variant": self.native_variant,
+            "vector_plan": self.vector_program.to_dict(),
+        }
+
+
+def lower_avx512(
+    program: CoreProgram,
+    target: TargetSpec,
+    entrypoint: Optional[str] = None,
+    *,
+    lane_count: Optional[int] = None,
+    tail_policy: Any = None,
+    required_features: Any = None,
+    specialization: Optional[Mapping[str, Any]] = None,
+    use_fma: Optional[bool] = None,
+    use_dq: Optional[bool] = None,
+    use_bw: Optional[bool] = None,
+    use_vl: Optional[bool] = None,
+    use_vnni: Optional[bool] = None,
+    use_bf16: Optional[bool] = None,
+) -> Avx512Program:
+    """Lower Core IR to a masked-tail AVX-512 vector plan."""
+
+    if not isinstance(target, TargetSpec):
+        raise Avx512ValidationError("AVX-512 lowering requires TargetSpec")
+    if target.kind != "cpu":
+        raise Avx512ValidationError("AVX-512 target requires kind='cpu', got {!r}".format(target.kind))
+    if not target.triple.startswith(("x86_64", "amd64")):
+        raise Avx512ValidationError("AVX-512 target requires an x86_64 triple, got {!r}".format(target.triple))
+    target = _normalised_target(target)
+    selected_lanes = _target_lane_count(target) if lane_count is None else lane_count
+    if selected_lanes is not None and selected_lanes != AVX512_LANE_COUNT:
+        raise Avx512ValidationError(
+            "AVX-512 requires lane_count={} (got {!r})".format(AVX512_LANE_COUNT, selected_lanes)
+        )
+    options = dict(_variant_options(target))
+    for name, value in (
+        ("fma", use_fma),
+        ("dq", use_dq),
+        ("bw", use_bw),
+        ("vl", use_vl),
+        ("vnni", use_vnni),
+        ("bf16", use_bf16),
+    ):
+        if value is not None:
+            if not isinstance(value, bool):
+                raise Avx512ValidationError("use_{} must be bool".format(name))
+            options[name] = value
+    explicit = set(_feature_values(required_features))
+    unsupported = sorted(explicit.difference(_ISA_FEATURES))
+    if unsupported:
+        raise Avx512UnsupportedError(
+            "AVX-512 lowering received unsupported features: {}".format(", ".join(unsupported))
+        )
+    for key, feature in (
+        ("fma", "fma"),
+        ("dq", "avx512dq"),
+        ("bw", "avx512bw"),
+        ("vl", "avx512vl"),
+        ("vnni", "avx512vnni"),
+        ("bf16", "avx512bf16"),
+    ):
+        if feature in explicit and not options[key]:
+            raise Avx512ValidationError("required feature {} conflicts with disabled variant".format(feature))
+        if options[key] and feature in target.features:
+            continue
+    selected_tail = tail_policy
+    if selected_tail is None:
+        selected_tail = target.attributes.get("tail_policy", AVX512_TAIL_POLICY.value)
+    if selected_tail not in (AVX512_TAIL_POLICY, AVX512_TAIL_POLICY.value, "mask"):
+        raise Avx512ValidationError("AVX-512 requires tail_policy='masked'")
+    required = _normalised_required(required_features, options)
+    vector_program = lower_cpu_vector(
+        program,
+        target,
+        entrypoint,
+        lane_count=AVX512_LANE_COUNT,
+        tail_policy=AVX512_TAIL_POLICY,
+        required_features=required,
+        specialization=specialization,
+    )
+    result = Avx512Program(
+        vector_program,
+        options["fma"],
+        options["dq"],
+        options["bw"],
+        options["vl"],
+        options["vnni"],
+        options["bf16"],
+    )
+    result.validate()
+    return result
+
+
+lower = lower_avx512
+
+
+__all__ = [
+    "AVX512_BACKEND",
+    "AVX512_LANE_COUNT",
+    "AVX512_LOWERING_VERSION",
+    "AVX512_TAIL_POLICY",
+    "Avx512Error",
+    "Avx512Program",
+    "Avx512UnsupportedError",
+    "Avx512ValidationError",
+    "lower",
+    "lower_avx512",
+]
