+
+def test_missing_zmm_does_not_load_native_object(tmp_path, monkeypatch):
+    _, _, artifact = _compile(_elementwise(), _target("avx512f"), tmp_path)
+    capability = Avx512Capability.injected_capability(("avx", "avx512f", "osxsave", "ymm"))
+    runtime = Avx512Runtime(capability=capability)
+
+    def fail_cdll(*args, **kwargs):
+        raise AssertionError("ctypes.CDLL must not be called for missing ZMM state")
+
+    monkeypatch.setattr(ctypes, "CDLL", fail_cdll)
+    with pytest.raises(CpuAvx512UnavailableError):
+        runtime.load(artifact)
+
+
+def test_advanced_missing_feature_is_rejected_before_dlopen(tmp_path, monkeypatch):
+    _, _, artifact = _compile(
+        _elementwise(),
+        _target("avx512f", "avx512bf16"),
+        tmp_path,
+    )
+    capability = Avx512Capability.injected_capability(
+        ("avx", "avx512f", "osxsave", "ymm", "opmask", "zmm")
+    )
+    runtime = Avx512Runtime(capability=capability)
+    monkeypatch.setattr(ctypes, "CDLL", lambda *args, **kwargs: (_ for _ in ()).throw(AssertionError("dlopen")))
+    with pytest.raises(CpuAvx512FeatureMismatchError) as error:
+        runtime.load(artifact)
+    assert "avx512bf16" in str(error.value.status.details)
+
+
+def test_non_aligned_buffer_and_canary_are_safe(tmp_path):
+    _, _, artifact = _compile(_elementwise(shape=(17,)), _target("avx512f"), tmp_path)
+    runtime = _runtime()
+    raw_left = (ctypes.c_ubyte * (17 * 4 + 2))()
+    raw_right = (ctypes.c_ubyte * (17 * 4 + 2))()
+    raw_output = (ctypes.c_ubyte * (17 * 4 + 2))()
+    left_address = ctypes.addressof(raw_left) + 1
+    right_address = ctypes.addressof(raw_right) + 1
+    output_address = ctypes.addressof(raw_output) + 1
+    left = ctypes.cast(left_address, ctypes.POINTER(ctypes.c_float))
+    right = ctypes.cast(right_address, ctypes.POINTER(ctypes.c_float))
+    output = ctypes.cast(output_address, ctypes.POINTER(ctypes.c_float))
+    raw_output[0] = 0xA5
+    raw_output[-1] = 0x5A
+    for index in range(17):
+        left[index] = float(index)
+        right[index] = 2.0
+        output[index] = -1.0
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[
+                TensorDesc("float32", (17,), address=left_address, readonly=True),
+                TensorDesc("float32", (17,), address=right_address, readonly=True),
+            ],
+            outputs=[TensorDesc("float32", (17,), address=output_address)],
+        )
+    )
+    assert [output[index] for index in range(17)] == [float(index + 2) for index in range(17)]
+    assert raw_output[0] == 0xA5 and raw_output[-1] == 0x5A
+
