@@ -0,0 +1,454 @@
+"""CPUID/XGETBV capability probing for the PyPTO-X AVX-512 target.
+
+The probe is deliberately a tiny Clang-built helper.  In particular it does
+not read ``/proc/cpuinfo``: AVX-512 instructions are only considered safe
+after CPUID and the operating system extended-state mask both agree.
+"""
+
+from __future__ import annotations
+
+import ctypes
+from dataclasses import dataclass
+from functools import lru_cache
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+from typing import Any, Mapping, Optional, Tuple
+
+
+_PROBE_SOURCE = r'''
+#include <stdint.h>
+
+static void ptx_cpuid(uint32_t leaf, uint32_t subleaf,
+                      uint32_t *eax, uint32_t *ebx,
+                      uint32_t *ecx, uint32_t *edx) {
+#if defined(__x86_64__) || defined(__i386__)
+    uint32_t a, b, c, d;
+    __asm__ volatile("cpuid"
+                     : "=a"(a), "=b"(b), "=c"(c), "=d"(d)
+                     : "a"(leaf), "c"(subleaf));
+    *eax = a; *ebx = b; *ecx = c; *edx = d;
+#else
+    (void)leaf; (void)subleaf;
+    *eax = 0; *ebx = 0; *ecx = 0; *edx = 0;
+#endif
+}
+
+static uint64_t ptx_xgetbv0(void) {
+#if defined(__x86_64__) || defined(__i386__)
+    uint32_t eax, edx;
+    __asm__ volatile(".byte 0x0f, 0x01, 0xd0"
+                     : "=a"(eax), "=d"(edx) : "c"(0));
+    return ((uint64_t)edx << 32) | eax;
+#else
+    return 0;
+#endif
+}
+
+/* out[0..17] = max leaf, leaf1 ECX/EDX, leaf7 EBX/ECX/max-subleaf,
+ * leaf7.1 EAX, XCR0, OSXSAVE, XGETBV-valid, AVX, AVX512F/DQ/BW/VL,
+ * VNNI, BF16 and FMA. */
+void ptx_probe(uint64_t *out) {
+    uint32_t max_leaf, eax, ebx, ecx, edx;
+    uint64_t xcr0 = 0;
+    uint32_t osxsave = 0, xgetbv_valid = 0;
+    uint32_t avx = 0, f = 0, dq = 0, bw = 0, vl = 0;
+    uint32_t vnni = 0, bf16 = 0, fma = 0;
+    uint32_t max_subleaf = 0;
+    uint32_t index;
+    for (index = 0; index < 18; ++index) out[index] = 0;
+    ptx_cpuid(0, 0, &max_leaf, &ebx, &ecx, &edx);
+    out[0] = max_leaf;
+    if (max_leaf >= 1) {
+        ptx_cpuid(1, 0, &eax, &ebx, &ecx, &edx);
+        out[1] = ecx; out[2] = edx;
+        osxsave = (ecx >> 27) & 1U;
+        avx = (ecx >> 28) & 1U;
+        fma = (ecx >> 12) & 1U;
+        out[8] = osxsave;
+        if (osxsave) { xcr0 = ptx_xgetbv0(); xgetbv_valid = 1; }
+    }
+    out[7] = xcr0;
+    out[9] = xgetbv_valid;
+    out[10] = avx;
+    out[17] = fma;
+    if (max_leaf >= 7) {
+        ptx_cpuid(7, 0, &max_subleaf, &ebx, &ecx, &edx);
+        out[3] = ebx; out[4] = ecx; out[5] = max_subleaf;
+        f = (ebx >> 16) & 1U;
+        dq = (ebx >> 17) & 1U;
+        bw = (ebx >> 30) & 1U;
+        vl = (ebx >> 31) & 1U;
+        vnni = (ecx >> 11) & 1U;
+        if (max_subleaf >= 1) {
+            ptx_cpuid(7, 1, &eax, &ebx, &ecx, &edx);
+            bf16 = (eax >> 5) & 1U;
+            out[6] = eax;
+        }
+    }
+    out[11] = f; out[12] = dq; out[13] = bw; out[14] = vl;
+    out[15] = vnni; out[16] = bf16;
+}
+'''
+
+
+class Avx512ProbeError(RuntimeError):
+    """The host capability probe could not be built or executed."""
+
+
+def _canonical_feature(value: Any) -> str:
+    name = str(value).strip().lower().replace("_", "").replace("-", "")
+    aliases = {
+        "avx512": "avx512f",
+        "f": "avx512f",
+        "dq": "avx512dq",
+        "bw": "avx512bw",
+        "vl": "avx512vl",
+        "vnni": "avx512vnni",
+        "avx512vnni": "avx512vnni",
+        "bf16": "avx512bf16",
+        "avx512bf16": "avx512bf16",
+        "mask": "opmask",
+        "maskstate": "opmask",
+        "zmmstate": "zmm",
+    }
+    return aliases.get(name, name)
+
+
+def _normalise_features(features: Any) -> Tuple[str, ...]:
+    if isinstance(features, str):
+        features = (features,)
+    names = {_canonical_feature(value) for value in (features or ()) if str(value).strip()}
+    return tuple(sorted(names))
+
+
+@dataclass(frozen=True)
+class Avx512Capability:
+    """Structured AVX-512 CPUID/XGETBV result.
+
+    ``available`` denotes only the base AVX-512F execution contract.  DQ/BW/
+    VL, VNNI and BF16 remain independent capability bits and are never
+    inferred from the base bit.
+    """
+
+    available: bool
+    features: Tuple[str, ...]
+    source: str
+    reason_code: Optional[str]
+    reason: Optional[str]
+    compiler: str
+    target_triple: str
+    max_basic_leaf: int
+    leaf1_ecx: int
+    leaf1_edx: int
+    leaf7_ebx: int
+    leaf7_ecx: int
+    leaf7_subleaf1_eax: int
+    leaf7_max_subleaf: int
+    xcr0: int
+    osxsave: bool
+    xgetbv_valid: bool
+    avx: bool
+    avx512f: bool
+    avx512dq: bool
+    avx512bw: bool
+    avx512vl: bool
+    avx512vnni: bool
+    avx512bf16: bool
+    fma: bool
+    injected: bool = False
+
+    @property
+    def ymm_state(self) -> bool:
+        return bool(self.osxsave and self.xgetbv_valid and (self.xcr0 & 0x6) == 0x6)
+
+    @property
+    def opmask_state(self) -> bool:
+        return bool(self.ymm_state and (self.xcr0 & 0x20) == 0x20)
+
+    @property
+    def zmm_state(self) -> bool:
+        return bool(self.opmask_state and (self.xcr0 & 0xE0) == 0xE0)
+
+    @property
+    def base_available(self) -> bool:
+        return self.available
+
+    @property
+    def vnni(self) -> bool:
+        return self.avx512vnni
+
+    @property
+    def bf16(self) -> bool:
+        return self.avx512bf16
+
+    @classmethod
+    def injected_capability(
+        cls,
+        features: Any = (
+            "avx",
+            "avx512f",
+            "fma",
+            "osxsave",
+            "ymm",
+            "opmask",
+            "zmm",
+        ),
+        source: str = "injected",
+    ) -> "Avx512Capability":
+        names = set(_normalise_features(features))
+        if "avx512f" in names:
+            names.add("avx")
+        if "avx512vnni" in names:
+            names.add("avx512f")
+        if "avx512bf16" in names:
+            names.add("avx512f")
+        avx = "avx" in names
+        osxsave = "osxsave" in names
+        ymm = "ymm" in names or "ymmstate" in names
+        opmask = "opmask" in names
+        zmm = "zmm" in names
+        xcr0 = 0
+        if ymm:
+            xcr0 |= 0x6
+        if opmask:
+            xcr0 |= 0x20
+        if zmm:
+            xcr0 |= 0xC0
+        f = "avx512f" in names
+        available = bool(avx and f and osxsave and ymm and opmask and zmm)
+        features_out = set(names)
+        if ymm:
+            features_out.add("ymm")
+        if zmm:
+            features_out.add("zmm")
+        if opmask:
+            features_out.add("opmask")
+        return cls(
+            available,
+            tuple(sorted(features_out)),
+            source,
+            None if available else "missing_cpu_features",
+            None if available else "injected capability lacks AVX-512F/ZMM state",
+            "injected",
+            "injected",
+            7 if f else 0,
+            0,
+            0,
+            (1 << 16 if f else 0),
+            (1 << 11 if "avx512vnni" in names else 0),
+            (1 << 5 if "avx512bf16" in names else 0),
+            1 if "avx512bf16" in names else 0,
+            xcr0,
+            osxsave,
+            bool(osxsave and (xcr0 & 0x6) == 0x6),
+            avx,
+            f,
+            "avx512dq" in names,
+            "avx512bw" in names,
+            "avx512vl" in names,
+            "avx512vnni" in names,
+            "avx512bf16" in names,
+            "fma" in names,
+            True,
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "available": self.available,
+            "features": list(self.features),
+            "source": self.source,
+            "reason_code": self.reason_code,
+            "reason": self.reason,
+            "compiler": self.compiler,
+            "target_triple": self.target_triple,
+            "max_basic_leaf": self.max_basic_leaf,
+            "leaf1_ecx": self.leaf1_ecx,
+            "leaf1_edx": self.leaf1_edx,
+            "leaf7_ebx": self.leaf7_ebx,
+            "leaf7_ecx": self.leaf7_ecx,
+            "leaf7_subleaf1_eax": self.leaf7_subleaf1_eax,
+            "leaf7_max_subleaf": self.leaf7_max_subleaf,
+            "xcr0": self.xcr0,
+            "osxsave": self.osxsave,
+            "xgetbv_valid": self.xgetbv_valid,
+            "ymm_state": self.ymm_state,
+            "opmask_state": self.opmask_state,
+            "zmm_state": self.zmm_state,
+            "avx": self.avx,
+            "avx512f": self.avx512f,
+            "avx512dq": self.avx512dq,
+            "avx512bw": self.avx512bw,
+            "avx512vl": self.avx512vl,
+            "avx512vnni": self.avx512vnni,
+            "avx512bf16": self.avx512bf16,
+            "vnni": self.avx512vnni,
+            "bf16": self.avx512bf16,
+            "fma": self.fma,
+            "injected": self.injected,
+        }
+
+
+def _plain_output(values: Any) -> Tuple[int, ...]:
+    return tuple(int(values[index]) for index in range(18))
+
+
+def _tool_info(compiler: str) -> Tuple[str, str]:
+    version = subprocess.run(
+        [compiler, "--version"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    ).stdout.splitlines()
+    triple_result = subprocess.run(
+        [compiler, "-print-target-triple"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    return (version[0].strip() if version else compiler, triple_result.stdout.strip() or "unknown")
+
+
+def _probe_directory(directory: Optional[Any]) -> Path:
+    selected = directory or os.environ.get("PYPTO_X_AVX512_PROBE_DIR")
+    if selected is None:
+        selected = os.environ.get("TMPDIR")
+    if selected is None:
+        selected = tempfile.mkdtemp(prefix="pypto-x-avx512-probe-")
+    path = Path(os.fspath(selected)).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _build_probe(compiler: str, directory: Path) -> Tuple[Path, Path]:
+    invocation = Path(tempfile.mkdtemp(prefix="cpuid-probe-", dir=str(directory)))
+    source = invocation / "cpuid_probe.c"
+    output = invocation / "cpuid_probe.so"
+    source.write_text(_PROBE_SOURCE, encoding="utf-8")
+    temporary = invocation / "tmp"
+    temporary.mkdir(parents=True, exist_ok=True)
+    environment = dict(os.environ)
+    environment["TMPDIR"] = str(temporary)
+    result = subprocess.run(
+        [compiler, "-shared", "-fPIC", "-O2", "-std=c99", str(source), "-o", str(output)],
+        cwd=str(invocation),
+        env=environment,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        universal_newlines=True,
+        check=False,
+    )
+    if result.returncode != 0 or not output.is_file():
+        shutil.rmtree(str(invocation), ignore_errors=True)
+        raise Avx512ProbeError(
+            "CPUID/XGETBV probe compilation failed: {}".format((result.stderr or result.stdout).strip())
+        )
+    return output, invocation
+
+
+def _run_probe(compiler: str, directory: Optional[Any]) -> Avx512Capability:
+    compiler_path = shutil.which(compiler) or compiler
+    if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
+        raise Avx512ProbeError("Clang compiler {!r} was not found".format(compiler))
+    compiler_text, triple = _tool_info(compiler_path)
+    output, invocation = _build_probe(compiler_path, _probe_directory(directory))
+    try:
+        library = ctypes.CDLL(str(output))
+        function = library.ptx_probe
+        function.argtypes = [ctypes.POINTER(ctypes.c_uint64)]
+        function.restype = None
+        values = (ctypes.c_uint64 * 18)()
+        function(values)
+    finally:
+        shutil.rmtree(str(invocation), ignore_errors=True)
+    (
+        max_leaf,
+        leaf1_ecx,
+        leaf1_edx,
+        leaf7_ebx,
+        leaf7_ecx,
+        max_subleaf,
+        leaf7_sub1_eax,
+        xcr0,
+        osxsave,
+        xgetbv_valid,
+        avx,
+        avx512f,
+        avx512dq,
+        avx512bw,
+        avx512vl,
+        vnni,
+        bf16,
+        fma,
+    ) = _plain_output(values)
+    ymm = bool(osxsave and xgetbv_valid and (xcr0 & 0x6) == 0x6)
+    opmask = bool(ymm and (xcr0 & 0x20) == 0x20)
+    zmm = bool(opmask and (xcr0 & 0xE0) == 0xE0)
+    features = []
+    for enabled, name in (
+        (avx, "avx"),
+        (avx512f, "avx512f"),
+        (avx512dq, "avx512dq"),
+        (avx512bw, "avx512bw"),
+        (avx512vl, "avx512vl"),
+        (vnni, "avx512vnni"),
+        (bf16, "avx512bf16"),
+        (fma, "fma"),
+        (osxsave, "osxsave"),
+        (ymm, "ymm"),
+        (opmask, "opmask"),
+        (zmm, "zmm"),
+    ):
+        if enabled:
+            features.append(name)
+    available = bool(avx and avx512f and zmm)
+    return Avx512Capability(
+        available,
+        tuple(features),
+        "cpuid+osxsave+xgetbv",
+        None if available else "missing_cpu_features",
+        None if available else "CPUID/XGETBV did not provide AVX-512F with OS ZMM state",
+        compiler_text,
+        triple,
+        max_leaf,
+        leaf1_ecx,
+        leaf1_edx,
+        leaf7_ebx,
+        leaf7_ecx,
+        leaf7_sub1_eax,
+        max_subleaf,
+        xcr0,
+        bool(osxsave),
+        bool(xgetbv_valid),
+        bool(avx),
+        bool(avx512f),
+        bool(avx512dq),
+        bool(avx512bw),
+        bool(avx512vl),
+        bool(vnni),
+        bool(bf16),
+        bool(fma),
+        False,
+    )
+
+
+@lru_cache(maxsize=4)
+def probe_avx512_capabilities(compiler: str = "clang", directory: Optional[str] = None) -> Avx512Capability:
+    """Probe the real x86 host with CPUID and XGETBV."""
+
+    return _run_probe(compiler, directory)
+
+
+probe_avx512 = probe_avx512_capabilities
+
+
+__all__ = [
+    "Avx512Capability",
+    "Avx512ProbeError",
+    "probe_avx512",
+    "probe_avx512_capabilities",
+]
