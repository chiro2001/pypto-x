+"""Native AVX-512 runtime with capability-gated dispatch.
+
+The public launch ABI is shared with the scalar and AVX2 backends.  This
+module only changes the final symbol names and the host feature contract; all
+shape, layout and Core operation validation remains the common path.
+"""
+
+from __future__ import annotations
+
+import ctypes
+from dataclasses import dataclass
+import hashlib
+import os
+from pathlib import Path
+import struct
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, LaunchRequest, TensorDesc
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.compiler.targets.cpu_avx512 import DEFAULT_ARTIFACT_FORMAT
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import (
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    flatten_values,
+    static_shape,
+)
+from pypto.lowering.cpu.x86.avx512 import (
+    AVX512_BACKEND,
+    AVX512_LOWERING_VERSION,
+    Avx512Capability,
+    Avx512Program,
+    lower_avx512,
+)
+from pypto.lowering.cpu.x86.avx512 import capabilities as _capabilities
+from pypto.lowering.cpu.vector import (
+    CpuFeatureContract,
+    CpuFeatureSet,
+    CpuVectorFeatureMismatchError,
+    FeatureMismatch,
+    VECTOR_PLAN_VERSION,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_text
+
+from ..tensor import FlatBuffer, HostTensor, _cast_value
+from . import avx2 as _avx2
+
+
+class CpuAvx512RuntimeError(RuntimeError):
+    """Base class for AVX-512 runtime failures."""
+
+
+class CpuAvx512UnavailableError(CpuAvx512RuntimeError):
+    """The host cannot safely execute the requested AVX-512 artifact."""
+
+    def __init__(self, status: Availability):
+        self.status = status
+        super().__init__(status.reason or "AVX-512 runtime is unavailable")
+
+
+class CpuAvx512ArtifactError(CpuAvx512RuntimeError):
+    """An immutable artifact, plan, or native module failed validation."""
+
+
+class CpuAvx512ExecutionError(CpuAvx512RuntimeError):
+    """A launch request or native operation is invalid."""
+
+
+class CpuAvx512FeatureMismatchError(CpuVectorFeatureMismatchError):
+    """The artifact requires features absent from the selected host contract."""
+
+    def __init__(self, mismatch: Any):
+        self.mismatch = mismatch
+        self.status = Availability.no(
+            AVX512_BACKEND,
+            "required AVX-512 artifact features are unavailable",
+            "missing_cpu_features",
+            mismatch.to_dict(),
+        )
+        super().__init__(mismatch)
+
+
+@dataclass(frozen=True)
+class LoadedAvx512Artifact:
+    artifact: Artifact
+    target_ir: Avx512Program
+    feature_contract: CpuFeatureContract
+    module: Any
+
+    @property
+    def contract(self) -> CpuFeatureContract:
+        return self.feature_contract
+
+
+_NativeBuffer = _avx2._NativeBuffer
+_RuntimeValue = _avx2._RuntimeValue
+_ctype = _avx2._ctype
+_pointer = _avx2._pointer
+_native_suffix = _avx2._native_suffix
+_bf16_bits = _avx2._bf16_bits
+_bf16_value = _avx2._bf16_value
+_buffer_from_values = _avx2._buffer_from_values
+_buffer_from_raw = _avx2._buffer_from_raw
+_buffer_from_descriptor = _avx2._buffer_from_descriptor
+_buffer_values = _avx2._buffer_values
+_buffer_raw = _avx2._buffer_raw
+_write_descriptor = _avx2._write_descriptor
+_symbol = _avx2._symbol
+_unravel = _avx2._unravel
+_contiguous_strides = _avx2._contiguous_strides
+_find_function = _avx2._find_function
+_is_tensor = _avx2._is_tensor
+_is_scalar = _avx2._is_scalar
+
+
+def _call_copy(module: Any, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx512_copy_{}".format(_native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), ctypes.c_size_t],
+    )
+    function(source.pointer, destination.pointer, source.count)
+
+
+def _call_unary(module: Any, name: str, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx512_{}_{}".format(name, _native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), ctypes.c_size_t],
+    )
+    function(source.pointer, destination.pointer, source.count)
+
+
+def _call_binary(
+    module: Any,
+    name: str,
+    dtype: str,
+    left: _NativeBuffer,
+    left_scalar: bool,
+    right: _NativeBuffer,
+    right_scalar: bool,
+    destination: _NativeBuffer,
+) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx512_binary_{}".format(_native_suffix(dtype)),
+        [
+            ctypes.c_int,
+            _pointer(dtype),
+            ctypes.c_int,
+            _pointer(dtype),
+            ctypes.c_int,
+            _pointer(dtype),
+            ctypes.c_size_t,
+        ],
+    )
+    function(
+        {"add": 0, "sub": 1, "mul": 2, "div": 3}[name],
+        left.pointer,
+        int(left_scalar),
+        right.pointer,
+        int(right_scalar),
+        destination.pointer,
+        destination.count,
+    )
+
+
+def _call_reduce(module: Any, name: str, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx512_{}_{}".format(name, _native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), ctypes.c_size_t],
+    )
+    function(source.pointer, destination.pointer, source.count)
+
+
+def _call_matmul(
+    module: Any,
+    dtype: str,
+    left: _NativeBuffer,
+    right: _NativeBuffer,
+    destination: _NativeBuffer,
+    m: int,
+    k: int,
+    n: int,
+) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx512_matmul_{}".format(_native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), _pointer(dtype), ctypes.c_size_t, ctypes.c_size_t, ctypes.c_size_t],
+    )
+    function(left.pointer, right.pointer, destination.pointer, m, k, n)
+
+
+def _read_native_bytes(path: str) -> bytes:
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(path, os.O_RDONLY | nofollow)
+    except OSError as exc:
+        raise CpuAvx512ArtifactError("AVX-512 native artifact path is unsafe: {}".format(exc)) from exc
+    try:
+        metadata = os.fstat(descriptor)
+        if not os.path.isfile(path) or metadata.st_nlink != 1:
+            raise CpuAvx512ArtifactError("AVX-512 native artifact must be a single-link regular file")
+        chunks = []
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        return b"".join(chunks)
+    finally:
+        os.close(descriptor)
+
+
+def _metadata_bool(metadata: Mapping[str, Any], key: str) -> bool:
+    value = metadata.get(key, False)
+    if not isinstance(value, bool):
+        raise CpuAvx512ArtifactError("AVX-512 metadata {!r} must be bool".format(key))
+    return value
+
+
+def _decode_artifact(
+    artifact: Artifact,
+    available: CpuFeatureSet,
+    capability: Avx512Capability,
+) -> LoadedAvx512Artifact:
+    if not isinstance(artifact, Artifact):
+        raise CpuAvx512ArtifactError("AVX-512 runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CpuAvx512ArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.path is None:
+        raise CpuAvx512ArtifactError("AVX-512 artifact must reference a native shared object path")
+    if artifact.format != DEFAULT_ARTIFACT_FORMAT:
+        raise CpuAvx512ArtifactError("unsupported AVX-512 artifact format {!r}".format(artifact.format))
+    if artifact.abi_version != ABI_VERSION:
+        raise CpuAvx512ArtifactError("unsupported AVX-512 artifact ABI {!r}".format(artifact.abi_version))
+    if artifact.target.kind != "cpu" or not artifact.target.triple.startswith(("x86_64", "amd64")):
+        raise CpuAvx512ArtifactError("AVX-512 artifact target must be x86_64 CPU")
+    metadata = mapping_copy(artifact.metadata)
+    if metadata.get("backend") != AVX512_BACKEND:
+        raise CpuAvx512ArtifactError("artifact backend metadata is not cpu.avx512")
+    if metadata.get("native_isa") != "avx512" or metadata.get("native_format") != "elf-shared-object":
+        raise CpuAvx512ArtifactError("artifact native format is not an AVX-512 shared object")
+    compile_command = metadata.get("compile_command")
+    if not isinstance(compile_command, (list, tuple)) or not compile_command:
+        raise CpuAvx512ArtifactError("AVX-512 compile_command metadata is missing")
+    if not str(compile_command[0]).lower().startswith("clang") or "-mavx512f" not in compile_command:
+        raise CpuAvx512ArtifactError("AVX-512 artifact was not compiled by required Clang AVX-512F command")
+    native_bytes = _read_native_bytes(artifact.path)
+    actual_digest = hashlib.sha256(native_bytes).hexdigest()
+    if actual_digest != artifact.content_digest or metadata.get("native_digest") != actual_digest:
+        raise CpuAvx512ArtifactError("native artifact content digest mismatch")
+    if metadata.get("entrypoint") != artifact.entrypoint:
+        raise CpuAvx512ArtifactError("AVX-512 artifact entrypoint mismatch")
+    if metadata.get("artifact_payload_version") != 1:
+        raise CpuAvx512ArtifactError("unsupported AVX-512 artifact payload version")
+    if metadata.get("lowering_version") != AVX512_LOWERING_VERSION:
+        raise CpuAvx512ArtifactError("unsupported AVX-512 lowering version")
+    program_data = metadata.get("program")
+    plan_data = metadata.get("vector_plan")
+    if not isinstance(program_data, Mapping) or not isinstance(plan_data, Mapping):
+        raise CpuAvx512ArtifactError("AVX-512 artifact is missing CoreProgram/vector plan metadata")
+    required_data = plan_data.get("required_features")
+    if not isinstance(required_data, Mapping):
+        raise CpuAvx512ArtifactError("AVX-512 required_features metadata is invalid")
+    required = CpuFeatureSet(
+        required_data.get("features", ()),
+        source=required_data.get("source", metadata.get("required_feature_source", "artifact")),
+    )
+    if not set(("avx", "avx512f", "osxsave", "ymm", "opmask", "zmm")).issubset(required.features):
+        raise CpuAvx512ArtifactError("AVX-512 artifact required_features omit AVX/ZMM safety fields")
+    flags = {
+        "use_fma": _metadata_bool(metadata, "use_fma"),
+        "use_dq": _metadata_bool(metadata, "use_dq"),
+        "use_bw": _metadata_bool(metadata, "use_bw"),
+        "use_vl": _metadata_bool(metadata, "use_vl"),
+        "use_vnni": _metadata_bool(metadata, "use_vnni"),
+        "use_bf16": _metadata_bool(metadata, "use_bf16"),
+    }
+    try:
+        program = CoreProgram.from_dict(program_data)
+        target_ir = lower_avx512(
+            program,
+            artifact.target,
+            plan_data.get("entrypoint"),
+            lane_count=plan_data.get("lane_count"),
+            tail_policy=plan_data.get("tail_policy"),
+            required_features=required,
+            specialization=plan_data.get("specialization", {}),
+            **flags
+        )
+    except Exception as exc:
+        raise CpuAvx512ArtifactError("AVX-512 CoreProgram/plan is invalid: {}".format(exc)) from exc
+    if target_ir.vector_program.to_dict() != dict(plan_data):
+        raise CpuAvx512ArtifactError("AVX-512 vector plan metadata mismatch")
+    if target_ir.native_variant != metadata.get("native_variant"):
+        raise CpuAvx512ArtifactError("AVX-512 native variant metadata is inconsistent")
+    program_digest = hashlib.sha256(program.canonical_json().encode("utf-8")).hexdigest()
+    if metadata.get("program_digest") != program_digest:
+        raise CpuAvx512ArtifactError("AVX-512 program digest mismatch")
+    if metadata.get("plan_digest") != target_ir.plan_digest:
+        raise CpuAvx512ArtifactError("AVX-512 plan digest mismatch")
+    if metadata.get("target_digest") != sha256_text(artifact.target.to_dict()):
+        raise CpuAvx512ArtifactError("AVX-512 target digest mismatch")
+    if tuple(metadata.get("required_features", ())) != tuple(required.features):
+        raise CpuAvx512ArtifactError("AVX-512 required feature metadata mismatch")
+    if metadata.get("required_feature_source") != required.source:
+        raise CpuAvx512ArtifactError("AVX-512 required feature source mismatch")
+    mismatch = CpuFeatureContract(required, available)
+    try:
+        mismatch.validate()
+    except CpuVectorFeatureMismatchError as exc:
+        raise CpuAvx512FeatureMismatchError(exc.mismatch) from exc
+    expected_mask = 1 | (2 if flags["use_fma"] else 0)
+    expected_mask |= 4 if flags["use_dq"] else 0
+    expected_mask |= 8 if flags["use_bw"] else 0
+    expected_mask |= 16 if flags["use_vl"] else 0
+    expected_mask |= 32 if flags["use_vnni"] else 0
+    expected_mask |= 64 if flags["use_bf16"] else 0
+    if metadata.get("native_feature_mask") != expected_mask:
+        raise CpuAvx512ArtifactError("AVX-512 native feature mask is inconsistent")
+    expected_flags = []
+    if flags["use_fma"]:
+        expected_flags.append("-mfma")
+    else:
+        expected_flags.append("-ffp-contract=off")
+    for enabled, flag in (
+        (flags["use_dq"], "-mavx512dq"),
+        (flags["use_bw"], "-mavx512bw"),
+        (flags["use_vl"], "-mavx512vl"),
+        (flags["use_vnni"], "-mavx512vnni"),
+        (flags["use_bf16"], "-mavx512bf16"),
+    ):
+        if enabled:
+            expected_flags.append(flag)
+    for flag in expected_flags:
+        if flag not in compile_command:
+            raise CpuAvx512ArtifactError("AVX-512 compile command is missing {}".format(flag))
+    if compile_command[-1] != Path(artifact.path).name:
+        raise CpuAvx512ArtifactError("AVX-512 compile command is not bound to artifact path")
+    if "clang" not in str(metadata.get("compiler_version", "")).lower():
+        raise CpuAvx512ArtifactError("AVX-512 compiler metadata is not Clang")
+    # The feature contract is checked before this CDLL call.  A fake or weak
+    # host therefore cannot accidentally map an unsupported ELF object.
+    try:
+        module = ctypes.CDLL(artifact.path)
+    except OSError as exc:
+        raise CpuAvx512ArtifactError("could not load AVX-512 shared object: {}".format(exc)) from exc
+    try:
+        native_variant = ctypes.c_char_p.in_dll(module, "ptx_avx512_variant").value.decode("ascii")
+        native_source_digest = ctypes.c_char_p.in_dll(module, "ptx_avx512_source_digest").value.decode("ascii")
+        native_feature_mask = ctypes.c_uint.in_dll(module, "ptx_avx512_feature_mask").value
+        native_abi = ctypes.c_char_p.in_dll(module, "ptx_avx512_abi").value.decode("ascii")
+    except (AttributeError, TypeError, UnicodeDecodeError, ValueError) as exc:
+        raise CpuAvx512ArtifactError("AVX-512 native safety marker is missing or malformed") from exc
+    if native_variant != target_ir.native_variant or metadata.get("native_source_digest") != native_source_digest:
+        raise CpuAvx512ArtifactError("AVX-512 native variant/source marker does not match metadata")
+    if native_feature_mask != expected_mask or native_abi != "pypto-x.cpu.avx512:1":
+        raise CpuAvx512ArtifactError("AVX-512 native safety marker does not match ABI metadata")
+    return LoadedAvx512Artifact(artifact, target_ir, mismatch, module)
+
+
+class Avx512Runtime:
+    """AVX-512 runtime with real-probe launch gating and AVX2 fallback."""
+
+    name = AVX512_BACKEND
+
+    def __init__(
+        self,
+        available_features: Any = None,
+        capability: Optional[Avx512Capability] = None,
+        probe_directory: Optional[str] = None,
+    ) -> None:
+        if capability is not None and available_features is not None:
+            raise ValueError("capability and available_features are aliases; pass only one")
+        injected = capability is not None or available_features is not None
+        self._probe_directory = probe_directory
+        if capability is None and available_features is None:
+            try:
+                capability = _capabilities.probe_avx512_capabilities(directory=probe_directory)
+            except Exception as exc:
+                capability = self._probe_failure(str(exc))
+        elif capability is None:
+            capability = Avx512Capability.injected_capability(available_features, source="injected")
+        self.capability = capability
+        self._injected = injected
+        self._real_capability = None if injected else capability
+        self.available_features = CpuFeatureSet(capability.features, source=capability.source)
+        if capability.available:
+            self._status = Availability.yes(self.name)
+        else:
+            self._status = Availability.no(
+                self.name,
+                capability.reason or "AVX-512 CPUID/XGETBV capability is unavailable",
+                capability.reason_code or "missing_cpu_features",
+                capability.to_dict(),
+            )
+
+    @staticmethod
+    def _probe_failure(reason: str) -> Avx512Capability:
+        return Avx512Capability(
+            False,
+            (),
+            "cpuid+osxsave+xgetbv",
+            "probe_failed",
+            reason,
+            "clang",
+            "unknown",
+            0,
+            0,
+            0,
+            0,
+            0,
+            0,
+            0,
+            0,
+            False,
+            False,
+            False,
+            False,
+            False,
+            False,
+            False,
+            False,
+            False,
+            False,
+            False,
+        )
+
+    def _probe_real_capability(self) -> Avx512Capability:
+        if self._real_capability is None:
+            try:
+                self._real_capability = _capabilities.probe_avx512_capabilities(
+                    directory=self._probe_directory
+                )
+            except Exception as exc:
+                self._real_capability = self._probe_failure(str(exc))
+        return self._real_capability
+
+    def _require_real_capability(self) -> Avx512Capability:
+        capability = self._probe_real_capability()
+        if not capability.available:
+            status = Availability.no(
+                self.name,
+                capability.reason or "real CPUID/XGETBV capability is unavailable",
+                "real_capability_unavailable",
+                capability.to_dict(),
+            )
+            raise CpuAvx512UnavailableError(status)
+        return capability
+
+    def availability(self) -> Availability:
+        return self._status
+
+    def is_available(self) -> bool:
+        return self._status.available
+
+    def load(self, artifact: Artifact, available_features: Any = None) -> LoadedAvx512Artifact:
+        if not self.is_available():
+            raise CpuAvx512UnavailableError(self._status)
+        available = self.available_features if available_features is None else CpuFeatureSet(
+            available_features, source="injected"
+        )
+        return _decode_artifact(artifact, available, self.capability)
+
+    def select_artifact(self, artifact: Artifact, fallback_artifact: Optional[Artifact] = None) -> Artifact:
+        """Choose a safe AVX-512/base/AVX2 artifact before loading any ELF."""
+
+        if artifact.format != DEFAULT_ARTIFACT_FORMAT:
+            return artifact
+        required = tuple(mapping_copy(artifact.metadata).get("required_features", ()))
+        available = set(self.available_features.features)
+        if self.is_available() and set(required).issubset(available):
+            return artifact
+        if fallback_artifact is not None:
+            return fallback_artifact
+        raise CpuAvx512UnavailableError(self._status)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, LaunchRequest):
+            raise CpuAvx512ExecutionError("workspace_size requires LaunchRequest")
+        self.load(request.artifact)
+        return 0
+
+    def launch(
+        self,
+        request: LaunchRequest,
+        fallback_artifact: Optional[Artifact] = None,
+        fallback: Optional[Artifact] = None,
+    ) -> Tuple[Any, ...]:
+        if fallback_artifact is not None and fallback is not None:
+            raise ValueError("fallback_artifact and fallback are aliases; pass only one")
+        fallback_artifact = fallback_artifact if fallback_artifact is not None else fallback
+        if not isinstance(request, LaunchRequest):
+            raise CpuAvx512ExecutionError("AVX-512 launch requires LaunchRequest")
+        if request.artifact.format != DEFAULT_ARTIFACT_FORMAT:
+            try:
+                return _avx2.Avx2Runtime().launch(request)
+            except Exception as exc:
+                raise CpuAvx512ExecutionError("unsupported fallback artifact format") from exc
+        # A supplied capability is useful for load-time tests, but launch still
+        # performs a real probe before mapping an ELF.  This also lets a fake
+        # low-capability host exercise the AVX2 fallback without loading the
+        # AVX-512 object.
+        real_capability = self._probe_real_capability()
+        available = CpuFeatureSet(real_capability.features, source=real_capability.source)
+        metadata = mapping_copy(request.artifact.metadata)
+        required = set(metadata.get("required_features", ()))
+        if not real_capability.available or not required.issubset(set(available.features)):
+            if fallback_artifact is None:
+                if not real_capability.available:
+                    raise CpuAvx512UnavailableError(
+                        Availability.no(
+                            self.name,
+                            real_capability.reason or "real AVX-512 capability is unavailable",
+                            "real_capability_unavailable",
+                            real_capability.to_dict(),
+                        )
+                    )
+                missing = sorted(required.difference(set(available.features)))
+                raise CpuAvx512FeatureMismatchError(
+                    FeatureMismatch(
+                        CpuFeatureSet(required, source="artifact"),
+                        available,
+                        tuple(missing),
+                    )
+                )
+            if fallback_artifact.format == DEFAULT_ARTIFACT_FORMAT:
+                fallback_request = LaunchRequest(
+                    fallback_artifact,
+                    entrypoint=request.entrypoint,
+                    inputs=request.inputs,
+                    outputs=request.outputs,
+                    scalars=request.scalars,
+                    workspace=request.workspace,
+                    stream_handle=request.stream_handle,
+                    schema_version=request.schema_version,
+                )
+                return self.launch(fallback_request)
+            return _avx2.Avx2Runtime().launch(
+                LaunchRequest(
+                    fallback_artifact,
+                    entrypoint=request.entrypoint,
+                    inputs=request.inputs,
+                    outputs=request.outputs,
+                    scalars=request.scalars,
+                    workspace=request.workspace,
+                    stream_handle=request.stream_handle,
+                    schema_version=request.schema_version,
+                )
+            )
+        try:
+            request.validate()
+        except Exception as exc:
+            raise CpuAvx512ExecutionError("invalid LaunchRequest: {}".format(exc)) from exc
+        loaded = _decode_artifact(request.artifact, available, real_capability)
+        target = loaded.target_ir.target
+        if target.kind != "cpu" or not target.triple.startswith(("x86_64", "amd64")):
+            raise CpuAvx512ExecutionError("AVX-512 artifact target must be x86_64 CPU")
+        for descriptor in request.inputs + request.outputs:
+            if descriptor.device != "cpu":
+                raise CpuAvx512ExecutionError("AVX-512 requires cpu tensor descriptors")
+            if descriptor.strides != _contiguous_strides(descriptor.shape):
+                raise CpuAvx512ExecutionError("AVX-512 requires contiguous tensor descriptors")
+        function = _find_function(loaded.target_ir.program, loaded.target_ir.entrypoint)
+        tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+        tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+        if len(request.inputs) != len(tensor_parameters):
+            raise CpuAvx512ExecutionError("AVX-512 input tensor count does not match function")
+        if len(request.outputs) != len(tensor_returns):
+            raise CpuAvx512ExecutionError("AVX-512 output tensor count does not match function")
+        for descriptor in request.outputs:
+            if descriptor.readonly:
+                raise CpuAvx512ExecutionError("AVX-512 output descriptor is read-only")
+        environment: Dict[str, _RuntimeValue] = {}
+        input_index = 0
+        for parameter in function.parameters:
+            if _is_tensor(parameter.type):
+                try:
+                    buffer = _buffer_from_descriptor(
+                        request.inputs[input_index], parameter.type, parameter.name
+                    )
+                except Exception as exc:
+                    raise CpuAvx512ExecutionError(str(exc)) from exc
+                environment[parameter.name] = _RuntimeValue(parameter.type, buffer)
+                input_index += 1
+            elif _is_scalar(parameter.type):
+                if parameter.name not in request.scalars:
+                    raise CpuAvx512ExecutionError("missing scalar input {!r}".format(parameter.name))
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _buffer_from_values(
+                        canonical_dtype(parameter.type.dtype), [request.scalars[parameter.name]], parameter.name
+                    ),
+                )
+            else:
+                raise CpuAvx512ExecutionError("unsupported parameter kind {!r}".format(parameter.type.kind))
+        if len(loaded.target_ir.plans) != len(function.body.operations):
+            raise CpuAvx512ArtifactError("AVX-512 plan count does not match operation count")
+        for operation, plan in zip(function.body.operations, loaded.target_ir.plans):
+            self._execute_operation(operation, plan, environment, loaded.module)
+        results: List[Any] = []
+        output_index = 0
+        for result_ref in function.returns:
+            if result_ref.name not in environment:
+                raise CpuAvx512ExecutionError("return value {!r} was not produced".format(result_ref.name))
+            result = environment[result_ref.name]
+            if _is_tensor(result_ref.type):
+                descriptor = request.outputs[output_index]
+                try:
+                    _write_descriptor(descriptor, result.buffer, result_ref.type, result_ref.name)
+                except Exception as exc:
+                    raise CpuAvx512ExecutionError(str(exc)) from exc
+                results.append(descriptor.storage)
+                output_index += 1
+            else:
+                values = _buffer_values(result.buffer)
+                results.append(values[0] if values else None)
+        return tuple(results)
+
+    def _execute_operation(
+        self,
+        operation: Operation,
+        plan: Any,
+        environment: Dict[str, _RuntimeValue],
+        module: Any,
+    ) -> None:
+        name = canonical_operation_name(operation.name)
+        if plan.operation != name:
+            raise CpuAvx512ArtifactError("AVX-512 operation does not match vector plan")
+        inputs = []
+        for ref in operation.inputs:
+            if ref.name not in environment:
+                raise CpuAvx512ExecutionError("AVX-512 input {!r} is unavailable".format(ref.name))
+            inputs.append(environment[ref.name])
+        output_ref = operation.outputs[0]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        try:
+            if name == "constant":
+                raw = operation.attributes.get("value", operation.attributes.get("values"))
+                values = [raw] if _is_scalar(output_ref.type) else list(flatten_values(raw))
+                environment[output_ref.name] = _RuntimeValue(
+                    output_ref.type, _buffer_from_values(dtype, values, output_ref.name)
+                )
+            elif name == "identity":
+                source = inputs[0].buffer
+                destination = _buffer_from_values(dtype, [0] * source.count, output_ref.name)
+                _call_copy(module, dtype, source, destination)
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            elif name in ("add", "sub", "mul", "div"):
+                left, right = inputs
+                if name == "div" and any(value == 0 for value in _buffer_values(right.buffer)):
+                    raise CpuAvx512ExecutionError("division by zero")
+                destination = _buffer_from_values(dtype, [0] * plan.element_count, output_ref.name)
+                _call_binary(
+                    module,
+                    name,
+                    dtype,
+                    left.buffer,
+                    _is_scalar(left.type),
+                    right.buffer,
+                    _is_scalar(right.type),
+                    destination,
+                )
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            elif name == "neg":
+                source = inputs[0].buffer
+                destination = _buffer_from_values(dtype, [0] * plan.element_count, output_ref.name)
+                _call_unary(module, "neg", dtype, source, destination)
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            elif name in ("reduce_sum", "reduce_max"):
+                result = self._execute_reduction(name, inputs[0], output_ref.type, plan, module, output_ref.name)
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, result)
+            elif name == "matmul":
+                matmul = plan.matmul
+                destination = _buffer_from_values(dtype, [0] * matmul.output_elements, output_ref.name)
+                _call_matmul(
+                    module,
+                    dtype,
+                    inputs[0].buffer,
+                    inputs[1].buffer,
+                    destination,
+                    matmul.m,
+                    matmul.k,
+                    matmul.n,
+                )
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            else:
+                raise CpuAvx512ExecutionError("AVX-512 operation {!r} is unsupported".format(operation.name))
+        except CpuAvx512RuntimeError:
+            raise
+        except Exception as exc:
+            raise CpuAvx512ExecutionError("AVX-512 operation {} failed: {}".format(name, exc)) from exc
+
+    def _execute_reduction(
+        self,
+        name: str,
+        value: _RuntimeValue,
+        output_type: CoreType,
+        plan: Any,
+        module: Any,
+        context: str,
+    ) -> _NativeBuffer:
+        reduction = plan.reduction
+        input_shape = reduction.input_shape
+        output_shape = reduction.output_shape
+        input_values = _buffer_raw(value.buffer)
+        if len(input_values) != element_count(input_shape):
+            raise CpuAvx512ExecutionError("{} reduction input length mismatch".format(context))
+        output = _buffer_from_values(canonical_dtype(output_type.dtype), [0] * reduction.output_elements, context)
+        for output_index in range(reduction.output_elements):
+            output_coords = _unravel(output_index, output_shape)
+            candidates = []
+            for input_index in range(len(input_values)):
+                input_coords = _unravel(input_index, input_shape)
+                if reduction.keepdims:
+                    projected = tuple(
+                        0 if axis in reduction.axes else input_coords[axis]
+                        for axis in range(len(input_shape))
+                    )
+                else:
+                    projected = tuple(
+                        input_coords[axis]
+                        for axis in range(len(input_shape))
+                        if axis not in reduction.axes
+                    )
+                if projected == output_coords:
+                    candidates.append(input_values[input_index])
+            if len(candidates) != reduction.reduction_size:
+                raise CpuAvx512ExecutionError("{} reduction group length mismatch".format(context))
+            if not candidates:
+                if name == "reduce_sum":
+                    if output.dtype == "bf16":
+                        output.pointer[output_index] = _bf16_bits(0.0)
+                    else:
+                        output.pointer[output_index] = 0.0
+                    continue
+                raise CpuAvx512ExecutionError("reduce_max has an empty reduction group")
+            group = _buffer_from_raw(value.buffer.dtype, candidates, context + ".group")
+            result = _buffer_from_values(output.dtype, [0], context + ".result")
+            _call_reduce(module, name, output.dtype, group, result)
+            output.pointer[output_index] = result.pointer[0]
+        return output
+
+    def run_vnni_dot_i8(self, artifact: Artifact, left: Sequence[int], right: Sequence[int]) -> int:
+        """Run the target-specific VNNI primitive (not a public Core op)."""
+
+        if not isinstance(artifact, Artifact) or not mapping_copy(artifact.metadata).get("use_vnni", False):
+            raise CpuAvx512ExecutionError("VNNI primitive requires a VNNI AVX-512 artifact")
+        capability = self._require_real_capability()
+        loaded = self.load(artifact, available_features=capability.features)
+        if len(left) != len(right):
+            raise CpuAvx512ExecutionError("VNNI operands must have equal length")
+        left_array = (ctypes.c_uint8 * len(left))(*[int(value) & 0xFF for value in left])
+        right_array = (ctypes.c_int8 * len(right))(*[int(value) for value in right])
+        result = ctypes.c_int32(0)
+        function = _symbol(
+            loaded.module,
+            "ptx_avx512_vnni_dot_i8",
+            [
+                ctypes.POINTER(ctypes.c_uint8),
+                ctypes.POINTER(ctypes.c_int8),
+                ctypes.POINTER(ctypes.c_int32),
+                ctypes.c_size_t,
+            ],
+        )
+        function(left_array, right_array, ctypes.byref(result), len(left))
+        return int(result.value)
+
+    execute_vnni_dot_i8 = run_vnni_dot_i8
+
+
+CpuAvx512Backend = Avx512Runtime
+CPUAVX512Runtime = Avx512Runtime
+CPUAvx512Runtime = Avx512Runtime
+
+
+def launch_avx512(
+    request: LaunchRequest,
+    available_features: Any = None,
+    fallback_artifact: Optional[Artifact] = None,
+) -> Tuple[Any, ...]:
+    return Avx512Runtime(available_features).launch(request, fallback_artifact=fallback_artifact)
+
+
+__all__ = [
+    "Avx512Runtime",
+    "CPUAVX512Runtime",
+    "CPUAvx512Runtime",
+    "CpuAvx512ArtifactError",
+    "CpuAvx512Backend",
+    "CpuAvx512ExecutionError",
+    "CpuAvx512FeatureMismatchError",
+    "CpuAvx512RuntimeError",
+    "CpuAvx512UnavailableError",
+    "LoadedAvx512Artifact",
+    "launch_avx512",
+]
