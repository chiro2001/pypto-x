-"""W1 Core IR 最小契约测试。"""
+"""W1 Core IR 最小契约测试。
 
+测试必须能在源码 checkout、没有 CANN/native shared library 的环境中直接
+运行。这里临时加载 ``pypto.core_ir`` 和 export adapter 到隔离 namespace，
+避免 ``pypto.__init__`` 的历史 online-build 逻辑成为 Core IR 单测前置条件。
+精确命令：
+
+``PYTHONPATH=python python3 -m pytest -q --confcutdir=python/tests/ut/pypto_x python/tests/ut/pypto_x/test_core_ir.py``
+"""
+
+import importlib.util
 import json
+from pathlib import Path
+import sys
+import types
 
 import pytest
 
-from pypto.core_ir import (
-    CoreFunction,
-    CoreIRValidationError,
-    CoreProgram,
-    CoreType,
-    Effect,
-    Operation,
-    Region,
-    UnsupportedSchemaVersionError,
-    ValueRef,
-)
-from pypto.frontend.core_export import (
-    NativeParserUnavailableError,
-    TensorExportInput,
-    export_tensor_frontend,
-    export_with_native_bridge,
-    native_parser_available,
-)
+
+def _load_isolated_modules():
+    """加载本 task 的模块而不触发真实 pypto package initializer。"""
+
+    repository_root = Path(__file__).resolve().parents[4]
+    package_root = repository_root / "python" / "pypto"
+    module_names = (
+        "pypto",
+        "pypto.core_ir",
+        "pypto.core_ir.model",
+        "pypto.frontend",
+        "pypto.frontend.core_export",
+    )
+    saved_modules = {name: sys.modules.get(name) for name in module_names}
+    isolated_pypto = types.ModuleType("pypto")
+    isolated_pypto.__path__ = [str(package_root)]
+    try:
+        # 只在这段加载期间遮蔽真实 pypto；finally 会恢复调用方的 module
+        # table，避免本测试污染同一 pytest session 的其他测试。
+        for name in module_names:
+            sys.modules.pop(name, None)
+        sys.modules["pypto"] = isolated_pypto
+
+        core_ir_spec = importlib.util.spec_from_file_location(
+            "pypto.core_ir",
+            package_root / "core_ir" / "__init__.py",
+            submodule_search_locations=[str(package_root / "core_ir")],
+        )
+        core_ir = importlib.util.module_from_spec(core_ir_spec)
+        sys.modules["pypto.core_ir"] = core_ir
+        assert core_ir_spec.loader is not None
+        core_ir_spec.loader.exec_module(core_ir)
+
+        isolated_frontend = types.ModuleType("pypto.frontend")
+        isolated_frontend.__path__ = [str(package_root / "frontend")]
+        sys.modules["pypto.frontend"] = isolated_frontend
+        export_spec = importlib.util.spec_from_file_location(
+            "pypto.frontend.core_export", package_root / "frontend" / "core_export.py"
+        )
+        core_export = importlib.util.module_from_spec(export_spec)
+        sys.modules["pypto.frontend.core_export"] = core_export
+        assert export_spec.loader is not None
+        export_spec.loader.exec_module(core_export)
+        return core_ir, core_export
+    finally:
+        for name, module in saved_modules.items():
+            if module is None:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = module
+
+
+_CORE_IR, _CORE_EXPORT = _load_isolated_modules()
+CoreFunction = _CORE_IR.CoreFunction
+CoreIRValidationError = _CORE_IR.CoreIRValidationError
+CoreProgram = _CORE_IR.CoreProgram
+CoreType = _CORE_IR.CoreType
+Effect = _CORE_IR.Effect
+Operation = _CORE_IR.Operation
+Region = _CORE_IR.Region
+UnsupportedSchemaVersionError = _CORE_IR.UnsupportedSchemaVersionError
+ValueRef = _CORE_IR.ValueRef
+NativeParserUnavailableError = _CORE_EXPORT.NativeParserUnavailableError
+TensorExportInput = _CORE_EXPORT.TensorExportInput
+export_tensor_frontend = _CORE_EXPORT.export_tensor_frontend
+export_with_native_bridge = _CORE_EXPORT.export_with_native_bridge
+native_parser_available = _CORE_EXPORT.native_parser_available
 
 
 def _program():
@@ -57,6 +118,29 @@ def test_round_trip_preserves_program():
     assert restored.verify() is True
 
 
+def test_attributes_and_metadata_are_deep_frozen():
+    tensor = CoreType.tensor("bf16", (4,))
+    x = ValueRef("x", tensor)
+    out = ValueRef("out", tensor)
+    attributes = {"nested": {"values": [1, 2]}}
+    metadata = {"nested": {"labels": ["portable"]}}
+    operation = Operation("identity", inputs=(x,), outputs=(out,), attributes=attributes)
+    program = CoreProgram(
+        functions=(CoreFunction("identity", (x,), (out,), Region((operation,))),),
+        metadata=metadata,
+    )
+    before = program.canonical_json()
+
+    # 改写构造者持有的原始容器不得影响 IR；IR 内部也不能再被写入。
+    attributes["nested"]["values"].append(3)
+    metadata["nested"]["labels"].append("changed")
+    assert program.canonical_json() == before
+    with pytest.raises(TypeError):
+        program.metadata["nested"]["labels"] = ("changed",)
+    with pytest.raises(TypeError):
+        operation.attributes["nested"]["values"] += (3,)
+
+
 def test_unknown_schema_version_fails_explicitly():
     payload = _program().to_dict()
     payload["schema_version"] = 99
