@@ -98,6 +99,25 @@ def _canonicalize(value: Any, context: str = "value") -> Any:
     raise CoreIRError("%s 含有不支持的值类型 %s" % (context, type(value).__name__))
 
 
+def _freeze_json(value: Any) -> Any:
+    """将已 canonicalize 的 JSON 值递归变成不可变值。
+
+    IR 对象是 frozen dataclass，但普通 dict/list 仍会绕过 dataclass 的
+    frozen 保护。attributes/metadata 在构造时经过这里后，调用方修改原始
+    输入或通过对象字段都不会改变后续 dump。
+    """
+
+    if isinstance(value, Mapping):
+        return MappingProxyType({key: _freeze_json(item) for key, item in value.items()})
+    if isinstance(value, (list, tuple)):
+        return tuple(_freeze_json(item) for item in value)
+    return value
+
+
+def _freeze_canonical(value: Any, context: str) -> Any:
+    return _freeze_json(_canonicalize(value, context))
+
+
 def _as_tuple(value: Optional[Iterable[Any]], context: str) -> Tuple[Any, ...]:
