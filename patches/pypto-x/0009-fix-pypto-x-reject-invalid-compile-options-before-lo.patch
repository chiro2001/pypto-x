From 2ab2f2ca59bd86dee654b55a0e97b7d25af966e9 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Mon, 7 Sep 2026 01:45:51 +0800
Subject: [PATCH 009/118] fix(pypto-x): reject invalid compile options before
 lowering

---
 python/pypto/compiler/api.py               |  4 ++--
 python/tests/ut/pypto_x/test_target_abi.py | 10 ++++++++++
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/python/pypto/compiler/api.py b/python/pypto/compiler/api.py
index a53d59a22..9ad5c04c2 100644
--- a/python/pypto/compiler/api.py
+++ b/python/pypto/compiler/api.py
@@ -88,6 +88,8 @@ def compile_program(
     validate_compiler_backend(backend)
     if not isinstance(target, TargetSpec):
         raise TypeError("target must be a TargetSpec")
+    if options is not None and not isinstance(options, CompileOptions):
+        raise BackendContractError("compile options must be CompileOptions")
     target_ir = backend.lower(program, target)
     artifact = backend.compile(target_ir, options)
     if not isinstance(artifact, Artifact):
@@ -102,8 +104,6 @@ def compile_program(
             details={"requested_target": target.key, "artifact_target": artifact.target.key},
         )
     if options is not None:
-        if not isinstance(options, CompileOptions):
-            raise BackendContractError("compile options must be CompileOptions")
         if artifact.format != options.artifact_format:
             raise BackendContractError(
                 "compiler backend returned an Artifact with a different format",
diff --git a/python/tests/ut/pypto_x/test_target_abi.py b/python/tests/ut/pypto_x/test_target_abi.py
index 3058c004e..f07cdbb7e 100644
--- a/python/tests/ut/pypto_x/test_target_abi.py
+++ b/python/tests/ut/pypto_x/test_target_abi.py
@@ -192,6 +192,16 @@ def test_compile_program_rejects_wrong_target_and_options():
     with pytest.raises(BackendContractError):
         compile_program(WrongOptionsBackend(), "program", target, options)
 
+    class MustNotRunBackend:
+        def lower(self, program, target_spec):
+            raise AssertionError("invalid options must fail before lowering")
+
+        def compile(self, target_ir, options=None):
+            raise AssertionError("invalid options must fail before compilation")
+
+    with pytest.raises(BackendContractError):
+        compile_program(MustNotRunBackend(), "program", target, options={})
+
 
 def test_launch_request_validates_storage_and_readonly_outputs():
     artifact = Artifact(format="python", entrypoint="main", target=_target(), payload=b"kernel")
