From 63261656b7ae772de89215a19750cd6ae923e2c4 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sun, 13 Sep 2026 12:20:24 +0800
Subject: [PATCH 260/275] feat(cuda): add correctness-only mode to the sm_120
 comparison harness

Allows the three load paths (sm_80 PTX JIT, native sm_120 PTX JIT,
native sm_120 cubin) to be validated bit-for-bit while the shared
GamePC is busy with a foreign/game load, without recording any timing.
---
 scripts/smoke/cuda_sm120_compare.py | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/scripts/smoke/cuda_sm120_compare.py b/scripts/smoke/cuda_sm120_compare.py
index 83b879e4f..1be708d06 100644
--- a/scripts/smoke/cuda_sm120_compare.py
+++ b/scripts/smoke/cuda_sm120_compare.py
@@ -407,7 +407,7 @@ def _stats(values):
             "p95_over_median": p95 / median if median else 0.0}
 
 
-def run(out_dir: Path, json_out: str):
+def run(out_dir: Path, json_out: str, correctness_only: bool = False):
     cases = json.loads((out_dir / "cases.json").read_text(encoding="utf-8"))
     cuda = _Cuda()
     fingerprint_before = _fingerprint()
@@ -445,6 +445,18 @@ def run(out_dir: Path, json_out: str):
         if len(outputs) == len(PATHS) and all(results["correctness"][name + ":" + path]["match"] for path in PATHS):
             results["correctness"][name] = "ALL_PATHS_BIT_EXACT"
 
+    if correctness_only:
+        checks = [entry for key, entry in results["correctness"].items() if key not in
+                  tuple(case["name"] for case in SMALL_CASES)]
+        results["mode"] = "correctness_only"
+        results["fingerprint_after"] = _fingerprint()
+        results["status"] = "PASS" if checks and all(entry.get("match") for entry in checks) else "FAIL"
+        payload = json.dumps(results, indent=2, sort_keys=True)
+        if json_out:
+            Path(json_out).write_text(payload + "\n", encoding="utf-8")
+        print(payload)
+        return 0 if results["status"] == "PASS" else 1
+
     # ---- load time ---------------------------------------------------------
     for name in tuple(case["name"] for case in SMALL_CASES[:1]) + ("perf_matmul_f32_4096",):
         case = cases["cases"][name]
@@ -592,11 +604,12 @@ def main(argv=None):
     parser.add_argument("--out-dir", default="sm120-compare")
     parser.add_argument("--json-out", default="")
     parser.add_argument("--allow-missing-ptxas", action="store_true")
+    parser.add_argument("--correctness-only", action="store_true")
     args = parser.parse_args(argv)
     out_dir = Path(args.out_dir)
     if args.mode == "prepare":
         return prepare(out_dir, args.allow_missing_ptxas)
-    return run(out_dir, args.json_out)
+    return run(out_dir, args.json_out, args.correctness_only)
 
 
 if __name__ == "__main__":
