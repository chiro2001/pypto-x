+/* The map is a serialized logical schedule.  FNV-1a is intentionally kept
+ * in the wire contract as a cheap in-process tamper check; the artifact also
+ * carries the SHA-256 map digest for cache identity and metadata validation. */
+static uint64_t ptx_index_map_hash(const uint64_t *map, uint64_t count) {
+    uint64_t hash = UINT64_C(1469598103934665603);
+    uint64_t index;
+    for (index = 0; index < count; ++index) {
+        uint64_t value = map[index];
+        unsigned int byte;
+        for (byte = 0; byte < 8; ++byte) {
+            hash ^= (value >> (byte * 8)) & UINT64_C(0xff);
+            hash *= UINT64_C(1099511628211);
+        }
+    }
+    return hash;
+}
+
+__attribute__((noinline))
+static void ptx_layout_f32(uint32_t operation, const float *input, float *output,
+                           const uint64_t *map, uint64_t count) {
+    uint64_t index = 0;
+    if (operation == PTX_RESHAPE || operation == PTX_VIEW || operation == PTX_CONTIGUOUS) {
+        ptx_copy_f32(input, output, count);
+        return;
+    }
+    /* The map is narrowed to SVE1's 32-bit indexed-gather contract only
+     * after the runner has checked the uint32 source-range bound. */
+    while (index < count) {
+        uint64_t end = index + (count - index > svcntw() ? svcntw() : count - index);
+        uint32_t index_values[8];
+        uint64_t lane;
+        svbool_t pg32 = svwhilelt_b32(index, end);
+        for (lane = 0; index + lane < end; ++lane) index_values[lane] = (uint32_t)map[index + lane];
+        svuint32_t indices = svld1_u32(pg32, index_values);
+        svfloat32_t values = svld1_gather_u32index_f32(pg32, input, indices);
+        svst1(pg32, output + index, values);
+        index = end;
+    }
+}
+
+__attribute__((noinline))
+static void ptx_layout_bf16(uint32_t operation, const uint16_t *input, uint16_t *output,
+                            const uint64_t *map, uint64_t count) {
+    uint64_t index = 0;
+    if (operation == PTX_RESHAPE || operation == PTX_VIEW || operation == PTX_CONTIGUOUS) {
+        for (index = 0; index < count; ++index) output[index] = input[index];
+        return;
+    }
+    /* GCC's SVE1 ACLE has no predicated u16 indexed gather.  Keep the BF16
+     * element reorder native (the runner owns the memory move), but make the
+     * scalar-lane limitation explicit rather than pretending to emit a BF16
+     * gather instruction. */
+    for (index = 0; index < count; ++index) output[index] = input[map[index]];
+}
