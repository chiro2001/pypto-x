+    _run(dim_program, tmp_path / "dim" / dtype, source, dim_actual)
+    dim_expected = HostTensor.zeros(dtype, (3, 2, 5))
+    _scalar_run(dim_program, source, dim_expected)
+    expected_dim = []
+    for axis0 in range(3):
+        for axis1 in range(2):
+            for axis2 in range(5):
+                expected_dim.append(source.flat()[(axis0 * 5 + axis2) * 2 + axis1])
+    assert dim_actual.flat() == dim_expected.flat() == tuple(expected_dim)
