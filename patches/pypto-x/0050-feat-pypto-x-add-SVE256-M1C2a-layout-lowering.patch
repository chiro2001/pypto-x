+def test_layout_sve_hotspot_has_predicated_gather_and_no_neon(tmp_path):
+    _target_ir, artifact = _compile(
+        _program("transpose", (3, 5), (5, 3), {"permutation": [1, 0]}), tmp_path
+    )
+    objdump = shutil.which("aarch64-linux-gnu-objdump")
+    if objdump is None:
+        pytest.skip("AArch64 objdump is unavailable")
+    result = subprocess.run(
+        [objdump, "-d", "--disassemble=ptx_layout_f32", artifact.path],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, check=True,
+    )
+    text = result.stdout.lower()
+    function_text = text.split("<ptx_layout_f32>:", 1)[-1]
+    assert "whilelo" in function_text
+    assert re.search(r"\bld1w\b", function_text)
+    assert re.search(r"\bst1w\b", function_text)
+    assert re.search(r"\bld1d\b", function_text)
+    assert re.search(r"\bz[0-9]+\.[sdh]\b", function_text)
+    assert re.search(r"\bp[0-9]+\.[bhsd]\b", function_text)
+    assert not re.search(r"\b[vq][0-9]+(?:\.[bhsd])?\b", function_text)
