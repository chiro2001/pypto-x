+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu.x86.avx2 import Avx2UnsupportedError, lower_avx2
+from pypto.lowering.cpu.x86.avx512 import Avx512UnsupportedError, lower_avx512
+from pypto.target import TargetSpec
+from pypto.target._utils import sha256_text
+
+
+def _program(name, input_shape, output_shape, attributes=None, dtype="float32"):
+    input_type = CoreType.tensor(dtype, input_shape)
+    output_type = CoreType.tensor(dtype, output_shape)
+    source = ValueRef("source", input_type)
+    output = ValueRef("output", output_type)
+    operation = Operation(name, (source,), (output,), attributes=attributes or {})
+    return CoreProgram(functions=(CoreFunction(name, (source,), (output,), Region((operation,))),))
+
+
+def _target():
+    return TargetSpec("cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32})
+
+
+def _compile(program, tmp_path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, _target())
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+    return target_ir, artifact
+
+
+def _run(program, tmp_path, source, output):
+    _target_ir, artifact = _compile(program, tmp_path)
+    Sve256Runtime(execution_mode="qemu").launch(
+        LaunchRequest(
+            artifact,
+            inputs=[source.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+    )
+    return artifact
+
+
+def _scalar_run(program, source, output):
+    compiler = CpuScalarCompiler()
+    artifact = compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[source.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+    )
+
+
+def test_layout_plan_is_serializable_and_distinguishes_copy_from_reorder(tmp_path):
+    copy_ir, copy_artifact = _compile(
+        _program("reshape", (3, 5), (5, 3), {"shape": [5, 3]}), tmp_path / "reshape"
+    )
+    transpose_ir, transpose_artifact = _compile(
+        _program("transpose", (3, 5), (5, 3), {"permutation": [-1, 0]}),
+        tmp_path / "transpose",
+    )
+    copy_plan = copy_ir.plans[0].layout_plan
+    transpose_plan = transpose_ir.plans[0].layout_plan
+    assert copy_plan.kind == "logical_layout_copy"
+    assert transpose_plan.kind == "transpose"
+    assert copy_plan.index_map == tuple(range(15))
+    assert transpose_plan.index_map == (0, 5, 10, 1, 6, 11, 2, 7, 12, 3, 8, 13, 4, 9, 14)
+    assert copy_artifact.metadata["logical_layout_copy_operations"] == ("reshape",)
+    assert transpose_artifact.metadata["native_layout_reorder_operations"] == ("transpose",)
+    assert copy_artifact.metadata["layout_index_map_wire"] == "uint64_le+fnv1a64"
+    assert copy_plan.index_map_digest == sha256_text(list(copy_plan.index_map))
