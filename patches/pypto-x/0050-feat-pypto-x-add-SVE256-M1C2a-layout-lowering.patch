+def test_layout_index_map_metadata_tamper_is_rejected(tmp_path):
+    _target_ir, artifact = _compile(
+        _program("transpose", (3, 5), (5, 3), {"permutation": [1, 0]}), tmp_path
+    )
+    metadata = dict(artifact.metadata)
+    metadata["layout_operations"] = [dict(metadata["layout_operations"][0], index_map_digest="0" * 64)]
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=metadata,
+    )
+    with pytest.raises(CpuSve256ArtifactError, match="layout operation metadata"):
+        Sve256Runtime(execution_mode="qemu").load(tampered)
