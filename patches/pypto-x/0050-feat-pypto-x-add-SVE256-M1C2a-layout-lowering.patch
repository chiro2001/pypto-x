+def test_layout_runner_rejects_bad_map_and_wire_tamper_before_memory_access(tmp_path):
+    _target_ir, artifact = _compile(
+        _program("transpose", (3, 5), (5, 3), {"permutation": [1, 0]}), tmp_path
+    )
+    runtime = Sve256Runtime(execution_mode="qemu")
+    with pytest.raises(CpuSve256ExecutionError, match="outside source range"):
+        runtime._run_runner(artifact, "transpose", "float32", [[1.0] * 15], 15, index_map=[0] * 14 + [15])
+
+    qemu = shutil.which("qemu-aarch64")
+    if qemu is None:
+        pytest.skip("qemu-aarch64 is unavailable")
+    header = struct.pack(
+        "<6I4Q", 0x56535850, 2, 21, 0, 0, 0, 1, 1, 1, 0
+    )
+    # A map entry outside the source range must produce a structured error,
+    # never an out-of-bounds access or a signal.
+    payload = header + struct.pack("<fQ", 1.0, 1)
+    result = subprocess.run(
+        [qemu, "-L", "/usr/aarch64-linux-gnu", "-cpu", "max,sve256=on", artifact.path],
+        input=payload, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    assert result.returncode != 0 and result.returncode != -11
+    assert len(result.stdout) >= 24
+    magic, version, status, _dtype, _count = struct.unpack("<4IQ", result.stdout[:24])
+    assert magic == 0x56535850 and version == 2 and status != 0
+
