diff --git a/scripts/a3_axis_b_runtime/06_int8_probe.py b/scripts/a3_axis_b_runtime/06_int8_probe.py
index 6a745e42e..2d7c3f453 100755
--- a/scripts/a3_axis_b_runtime/06_int8_probe.py
+++ b/scripts/a3_axis_b_runtime/06_int8_probe.py
@@ -181,6 +181,58 @@ def main():
         })(torch.randn(16, 64), torch.randn(16, 64))
     )
 
+    def s_compressed_linear():
+        """The full vLLM consumer path: CompressedTensors W8A8-int8 config ->
+        selected scheme/kernel -> layer.forward on aarch64 CPU."""
+        import vllm.distributed.parallel_state as ps
+
+        ps.init_distributed_environment(
+            world_size=1, rank=0, distributed_init_method="tcp://127.0.0.1:29559",
+            local_rank=0, backend="gloo",
+        )
+        ps._TP = ps._WORLD
+        from vllm.model_executor.layers.linear import ReplicatedLinear
+        from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (
+            CompressedTensorsConfig,
+        )
+
+        cfg = {
+            "config_groups": {"group_0": {
+                "targets": ["Linear"],
+                "weights": {"num_bits": 8, "type": "int", "symmetric": True,
+                            "strategy": "channel", "dynamic": False},
+                "input_activations": {"num_bits": 8, "type": "int", "symmetric": True,
+                                      "strategy": "token", "dynamic": True},
+            }},
+            "quant_method": "compressed-tensors",
+            "format": "int-quantized",
+            "ignore": [],
+        }
+        qc = CompressedTensorsConfig.from_config(cfg)
+        n, k = 64, 128
+        layer = ReplicatedLinear(k, n, bias=False, params_dtype=torch.bfloat16,
+                                 quant_config=qc, prefix="probe.axisb", disable_tp=True)
+        codes = torch.randint(-127, 127, (n, k), dtype=torch.int8)
+        scales = (torch.rand(n, 1, dtype=torch.float32) + 0.5) * 0.02
+        layer.weight.data.copy_(codes)
+        layer.weight_scale.data.copy_(scales)
+        layer.quant_method.process_weights_after_loading(layer)
+        x = torch.randn(4, k, dtype=torch.bfloat16)
+        y = layer.forward(x)
+        if isinstance(y, (tuple, list)):
+            y = y[0]
+        ref = x.float() @ (codes.float() * scales).t()
+        return {
+            "scheme": type(layer.scheme).__name__,
+            "kernel": type(layer.scheme.kernel).__name__,
+            "out_shape": list(y.shape),
+            "out_dtype": str(y.dtype),
+            "max_abs_diff_vs_fp32_dequant_ref": float((y.float() - ref).abs().max()),
+            "ref_absmax": float(ref.abs().max()),
+        }
+
+    rec("compressed_tensors_w8a8_linear", s_compressed_linear)
+
 
 try:
     main()
