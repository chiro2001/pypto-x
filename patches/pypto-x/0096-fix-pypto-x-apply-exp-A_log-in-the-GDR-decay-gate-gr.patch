diff --git a/python/tests/ut/pypto_x/test_qwen35_gdr_decay_gate.py b/python/tests/ut/pypto_x/test_qwen35_gdr_decay_gate.py
new file mode 100644
index 000000000..332f58dfc
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_qwen35_gdr_decay_gate.py
@@ -0,0 +1,119 @@
+"""GDR decay 门的回归守卫。
+
+背景：图契约 v2 把 decay 门写成 ``-A_log * softplus(a + dt_bias)``，缺了官方
+``-exp(A_log) * softplus(...)`` 里的 ``exp``（官方
+``transformers/models/qwen3_5/modeling_qwen3_5.py``：``self.A_log =
+nn.Parameter(torch.log(A))``，``g = -self.A_log.float().exp() *
+F.softplus(a.float() + self.dt_bias)``）。后果是 ``exp(g)`` 对多数 head 大于 1，
+GDR 递推状态指数爆炸，整网 prefill 的 logits 与 gold 完全对不上。
+
+本文件把「decay 门必须经过 exp(A_log)」锁成结构契约，并验证 gate 的数值语义。
+"""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+
+from pypto.portable.qwen35 import (
+    build_qwen35_text_decoder_graph,
+    qwen35_text_decoder_manifest,
+)
+
+
+def _gdr_prefixes(program) -> list:
+    return sorted(
+        {
+            operation.outputs[0].name[: -len("_a_log_full")]
+            for operation in program.functions[0].body.operations
+            if operation.name == "broadcast"
+            and operation.outputs
+            and operation.outputs[0].name.endswith("_a_log_full")
+        }
+    )
+
+
+def test_every_gdr_layer_decay_gate_uses_exp_a_log():
+    program = build_qwen35_text_decoder_graph(1, 1, past_length=0, shape_profile="model")
+    operations = list(program.functions[0].body.operations)
+    by_output = {}
+    for operation in operations:
+        for ref in operation.outputs:
+            by_output[ref.name] = operation
+
+    prefixes = _gdr_prefixes(program)
+    assert len(prefixes) == 18, prefixes
+
+    for prefix in prefixes:
+        exp_op = by_output[prefix + "_a_log_exp"]
+        assert exp_op.name == "exp", prefix
+        assert [ref.name for ref in exp_op.inputs] == [prefix + "_a_log_full"], prefix
+
+        neg_op = by_output[prefix + "_negative_a_log"]
+        assert neg_op.name == "neg", prefix
+        assert [ref.name for ref in neg_op.inputs] == [prefix + "_a_log_exp"], prefix
+
+        gate_op = by_output[prefix + "_gate_log_decay"]
+        assert gate_op.name == "mul", prefix
+        assert [ref.name for ref in gate_op.inputs] == [
+            prefix + "_negative_a_log",
+            prefix + "_positive_dt",
+        ], prefix
+
+        dt_op = by_output[prefix + "_positive_dt"]
+        assert dt_op.name == "softplus", prefix
+
+
+def test_decay_gate_never_consumes_raw_a_log():
+    """``-A_log`` 直连是 v2 的缺陷形态，必须彻底消失。"""
+
+    program = build_qwen35_text_decoder_graph(1, 2, past_length=0, shape_profile="model")
+    for operation in program.functions[0].body.operations:
+        if operation.name != "neg":
+            continue
+        names = [ref.name for ref in operation.outputs]
+        if not names[0].endswith("_negative_a_log"):
+            continue
+        source = operation.inputs[0].name
+        assert source.endswith("_a_log_exp"), names[0]
+        assert not source.endswith("_a_log_full"), names[0]
+
+
+def test_graph_contract_version_marks_the_decay_fix():
+    manifest = qwen35_text_decoder_manifest(1, 1, past_length=0)
+    assert manifest["graph_contract_version"] == 3
+
+
+def test_exp_a_log_semantics_match_the_official_formula():
+    """把 gate 的数值语义与官方公式对齐（纯 Python 复算，不依赖任何后端）。"""
+
+    # 一个负 A_log（本模型 [-6.59, 0.26] 区间内）必须让 decay <= 1。
+    a_log = -2.5
+    a = 0.75
+    dt_bias = -1.25
+    softplus = math.log1p(math.exp(-abs(a + dt_bias))) + max(a + dt_bias, 0.0)
+    official = math.exp(-math.exp(a_log) * softplus)
+    buggy = math.exp(-a_log * softplus)
+    assert official <= 1.0
+    assert buggy > 1.0
+    # 状态在官方公式下不会爆炸：连续 8 步纯衰减
+    state = 1.0
+    for _ in range(8):
+        state *= official
+    assert abs(state) <= 1.0
+    state = 1.0
+    for _ in range(8):
+        state *= buggy
+    assert abs(state) > 8.0
+
+
+@pytest.mark.parametrize("steps", (1, 3))
+def test_gate_shape_follows_the_time_axis(steps):
+    program = build_qwen35_text_decoder_graph(1, steps, past_length=0, shape_profile="model")
+    by_output = {}
+    for operation in program.functions[0].body.operations:
+        for ref in operation.outputs:
+            by_output[ref.name] = operation
+    exp_op = by_output["layer_00_a_log_exp"]
+    assert tuple(exp_op.outputs[0].type.shape) == (1, steps, 16)
