+"""Qwen3.5-0.8B M1D portable composites.
+
+Every composite is checked against an independent Python golden, the CPU
+scalar runtime, and the real SVE256 runner under QEMU.  The tests use small
+synthetic tensors only; no model or model weights are loaded.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+from typing import Callable, Iterable, List, Sequence, Tuple
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor, Sve256Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.core_ir import CoreProgram
+from pypto.portable.qwen35 import (
+    QWEN35_08B_SHAPE_METADATA,
+    build_attention_subgraph,
+    build_causal_mask,
+    build_decoder_subgraph,
+    build_gqa_repeat_kv,
+    build_l2_norm,
+    build_rms_norm,
+    build_rope_rotate_half,
+    build_stable_softmax,
+    build_swiglu,
+)
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+SVE_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2"),
+    attributes={"vl_bytes": 32},
+)
+
+
+def _compile_scalar(program: CoreProgram):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _compile_sve(program: CoreProgram, tmp_path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE_TARGET)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+
+
+def _launch(artifact, inputs, outputs, scalars=None, runtime=None):
+    return (runtime or CpuScalarRuntime()).launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+            scalars=scalars or {},
+        )
+    )
+
+
+def _three_way(program, inputs, output_shapes, output_dtypes, scalars, golden, tmp_path):
+    scalar_outputs = [HostTensor.zeros(dtype, shape) for dtype, shape in zip(output_dtypes, output_shapes)]
+    sve_outputs = [HostTensor.zeros(dtype, shape) for dtype, shape in zip(output_dtypes, output_shapes)]
+    _launch(_compile_scalar(program), inputs, scalar_outputs, scalars)
+    _launch(
+        _compile_sve(program, tmp_path),
+        inputs,
+        sve_outputs,
+        scalars,
+        runtime=Sve256Runtime(execution_mode="qemu"),
+    )
+    expected = [HostTensor(dtype, shape, values) for dtype, shape, values in zip(output_dtypes, output_shapes, golden)]
+    for actual, reference in zip(scalar_outputs, expected):
+        _assert_values(actual.flat(), reference.flat(), actual.dtype)
+    for actual, reference in zip(sve_outputs, expected):
+        _assert_values(actual.flat(), reference.flat(), actual.dtype)
+    return scalar_outputs, sve_outputs
+
+
+def _assert_values(actual, expected, dtype):
+    assert len(actual) == len(expected)
+    tolerance = 0.035 if dtype == "bf16" else 2.0e-5
+    for left, right in zip(actual, expected):
+        assert math.isclose(float(left), float(right), rel_tol=tolerance, abs_tol=tolerance), (left, right, dtype)
+
+
+def _rows(values: Sequence[float], shape: Tuple[int, ...]) -> Iterable[List[float]]:
+    width = shape[-1]
+    assert len(values) == _count(shape)
+    for offset in range(0, len(values), width):
+        yield list(values[offset:offset + width])
+
+
+def _silu(value: float) -> float:
+    if value >= 0.0:
+        return value / (1.0 + math.exp(-value))
+    exp_value = math.exp(value)
+    return value * exp_value / (1.0 + exp_value)
+
+
+def _count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_rms_norm_three_way_fp32_accumulation_and_odd_tail(dtype, tmp_path):
+    shape = (2, 3, 9)
+    values = [((index * 7) % 19 - 9) * 0.125 for index in range(_count(shape))]
+    weight_values = [1.0 + 0.03125 * index for index in range(shape[-1])]
+    x = HostTensor(dtype, shape, values)
+    weight = HostTensor(dtype, (shape[-1],), weight_values)
+    epsilon = 0.001
+    golden = []
+    for row in _rows(x.flat(), shape):
+        mean = sum(float(item) * float(item) for item in row) / len(row)
+        scale = 1.0 / math.sqrt(mean + epsilon)
+        golden.extend(scale * float(item) * float(weight_value) for item, weight_value in zip(row, weight.flat()))
+    program = build_rms_norm(shape, dtype)
+    _three_way(
+        program,
+        [x, weight],
+        [shape],
+        [dtype],
+        {"epsilon": epsilon},
+        [golden],
+        tmp_path,
+    )
+
