+def test_composite_programs_are_canonical_and_do_not_embed_tensor_constants():
+    programs = (
+        build_rms_norm((2, 3, 1024)),
+        build_stable_softmax((2, 3, 1024)),
+        build_decoder_subgraph(2, 1024, 2048),
+    )
+    for program in programs:
+        canonical = program.canonical_json()
+        assert canonical == program.canonical_json()
+        decoded = json.loads(canonical)
+        assert "metadata" in decoded
+        assert decoded["metadata"]["model"]["shape_only"] is True
+        assert "values" not in canonical
+        assert "index_map" not in canonical
+        assert len(canonical) < 20000
+        assert all(ref.name for ref in program.functions[0].returns)
