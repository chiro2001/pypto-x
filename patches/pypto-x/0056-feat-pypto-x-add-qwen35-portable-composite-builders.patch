+"""目标无关的 PyPTO-X portable builder。
+
+该包只构造 :mod:`pypto.core_ir`，不导入 CANN、CUDA、ROCm、PyTorch 或模型
+权重。后端通过同一个 ``CoreProgram`` 选择自己的 lowering。
+"""
+
+from .qwen35 import (
+    QWEN35_08B_SHAPE_METADATA,
+    build_attention_subgraph,
+    build_causal_mask,
+    build_decoder_subgraph,
+    build_gqa_repeat_kv,
+    build_l2_norm,
+    build_rms_norm,
+    build_rope_rotate_half,
+    build_stable_softmax,
+    build_swiglu,
+)
+
+__all__ = [
+    "QWEN35_08B_SHAPE_METADATA",
+    "build_attention_subgraph",
+    "build_causal_mask",
+    "build_decoder_subgraph",
+    "build_gqa_repeat_kv",
+    "build_l2_norm",
+    "build_rms_norm",
+    "build_rope_rotate_half",
+    "build_stable_softmax",
+    "build_swiglu",
+]
diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
new file mode 100644
index 000000000..28e8e98b4
--- /dev/null
+++ b/python/pypto/portable/qwen35.py
@@ -0,0 +1,815 @@
+"""Qwen3.5-0.8B 的目标无关 portable composite builders。
+
+这些 builder 只生成 Core IR 的既有 primitive。它们不把模型权重、按元素
+调度或目标指令写入 artifact；所有 tensor 都是显式函数输入，静态 shape、
+dtype、epsilon/mask/index 语义则保存在 CoreType、operation attributes 和
+小型 metadata contract 中。
+
+当前实现的数值契约：
+
+* ``bf16`` 输入先逐元素 cast 到 ``float32``，组合中的累加/数学运算在
+  ``float32`` 中完成，最后按 builder 的 ``output_dtype`` cast 回去；
+* ``float32`` 直接在 ``float32`` 中组合；
+* RMSNorm 使用 ``mean(x*x) + epsilon`` 后 ``rsqrt``；
+* L2Norm 使用 ``sum(x*x) + epsilon`` 后 ``rsqrt``，不隐含 clamp；
+* stable softmax 采用 ``max -> subtract -> exp -> sum -> divide``，并显式
+  broadcast 两个 reduction 结果；
+* RoPE 是纯文本 rotate-half contract，cos/sin 是调用方预计算输入，不宣称
+  视觉 MRoPE；
+* GQA 的 repeat-KV 使用 runtime integer indices 和 portable ``gather``；
+* causal mask 的 bool mask 与 fill value 都是函数输入，host 不预先生成结果。
+
+这不是 fused/vectorized 性能实现。当前后端仍会经过逐 lane libm、host
+broadcast pre-expansion、BF16 layout/indexing scalar fallback 和 Python
+list/wire staging，builder 本身不改变这些事实。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+
+
+_SUPPORTED_DTYPES = frozenset(("bf16", "float32"))
+_SUPPORTED_INDEX_DTYPES = frozenset(("int32", "int64"))
+
+# This is a static shape harness contract, not a loaded model configuration.
+# The dimensions are intentionally kept in metadata only; builders still take
+# their concrete shapes from the caller.
+QWEN35_08B_SHAPE_METADATA = {
+    "model_id": "Qwen/Qwen3.5-0.8B",
+    "contract": "text-only-bf16-w8a8-linear-m1d",
+    "shape_only": True,
+    "hidden_size": 1024,
+    "head_dim": 64,
+    "num_attention_heads": 16,
+    "num_key_value_heads": 8,
+    "num_hidden_layers": 24,
+}
+
+
+def _dtype(value: Any, field: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError("{} must be a string".format(field))
+    value = value.strip().lower()
+    if value == "bfloat16":
+        value = "bf16"
+    if value not in _SUPPORTED_DTYPES:
+        raise ValueError("{} must be 'bf16' or 'float32', got {!r}".format(field, value))
+    return value
+
+
+def _index_dtype(value: Any) -> str:
+    if not isinstance(value, str):
+        raise TypeError("index_dtype must be a string")
+    value = value.strip().lower()
+    if value not in _SUPPORTED_INDEX_DTYPES:
+        raise ValueError("index_dtype must be 'int32' or 'int64', got {!r}".format(value))
+    return value
+
+
+def _shape(value: Sequence[int], field: str, *, rank: Optional[int] = None) -> Tuple[int, ...]:
+    if isinstance(value, (str, bytes)):
+        raise TypeError("{} must be a sequence of non-negative integers".format(field))
+    try:
+        result = tuple(value)
+    except TypeError as exc:
+        raise TypeError("{} must be a sequence of non-negative integers".format(field)) from exc
+    if rank is not None and len(result) != rank:
+        raise ValueError("{} must have rank {}, got {}".format(field, rank, len(result)))
+    for index, dimension in enumerate(result):
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise ValueError("{}[{}] must be a non-negative integer".format(field, index))
+    return result
+
+
+def _require_rank(shape: Tuple[int, ...], field: str, minimum: int) -> None:
+    if len(shape) < minimum:
+        raise ValueError("{} must have rank at least {}".format(field, minimum))
+
+
+def _require_nonempty_reduction(shape: Tuple[int, ...], field: str) -> None:
+    _require_rank(shape, field, 1)
+    if shape[-1] == 0:
+        raise ValueError("{} cannot reduce an empty last axis".format(field))
+
+
+def _output_dtype(dtype: str, output_dtype: Optional[str]) -> str:
+    return dtype if output_dtype is None else _dtype(output_dtype, "output_dtype")
+
+
+def _tensor(dtype: str, shape: Sequence[int]) -> CoreType:
+    return CoreType.tensor(dtype, tuple(shape))
+
+
+def _scalar(dtype: str) -> CoreType:
+    return CoreType.scalar(dtype)
+
+
+class _Builder:
+    """Tiny deterministic Core IR builder used by the public composites."""
+
+    def __init__(self, function_name: str, composite: str, shape: Sequence[int]) -> None:
+        self.function_name = function_name
+        self.composite = composite
+        self.shape = tuple(shape)
+        self.parameters: List[ValueRef] = []
+        self.operations: List[Operation] = []
+        self._names = set()
+
+    def parameter(self, name: str, value_type: CoreType) -> ValueRef:
+        self._reserve(name)
+        value = ValueRef(name, value_type)
+        self.parameters.append(value)
+        return value
+
+    def op(
+        self,
+        name: str,
+        inputs: Iterable[ValueRef],
+        output_specs: Sequence[Tuple[str, CoreType]],
+        attributes: Optional[Mapping[str, Any]] = None,
+    ) -> Tuple[ValueRef, ...]:
+        outputs = tuple(self._value(output_name, value_type) for output_name, value_type in output_specs)
+        operation = Operation(name, tuple(inputs), outputs, attributes=attributes or {})
+        self.operations.append(operation)
+        return outputs
+
+    def _value(self, name: str, value_type: CoreType) -> ValueRef:
+        self._reserve(name)
+        return ValueRef(name, value_type)
+
+    def _reserve(self, name: str) -> None:
+        if name in self._names:
+            raise ValueError("duplicate stable SSA name {!r}".format(name))
+        self._names.add(name)
+
+    def finish(self, returns: Sequence[ValueRef], extra_metadata: Optional[Mapping[str, Any]] = None) -> CoreProgram:
+        return_refs = tuple(returns)
+        metadata: Dict[str, Any] = {
+            "pypto_x": "portable",
+            "composite": self.composite,
+            "contract_version": 1,
+            "model": dict(QWEN35_08B_SHAPE_METADATA),
+            "shape": list(self.shape),
+            "inputs": [_contract(ref) for ref in self.parameters],
+            "outputs": [_contract(ref) for ref in return_refs],
+        }
+        if extra_metadata:
+            metadata.update(dict(extra_metadata))
+        program = CoreProgram(
+            functions=(
+                CoreFunction(
+                    self.function_name,
+                    tuple(self.parameters),
+                    return_refs,
+                    Region(tuple(self.operations)),
+                ),
+            ),
+            metadata=metadata,
+        )
+        program.verify()
+        return program
+
+
+def _contract(ref: ValueRef) -> Mapping[str, Any]:
+    return {
+        "name": ref.name,
+        "kind": ref.type.kind,
+        "dtype": ref.type.dtype,
+        "shape": list(ref.type.shape),
+    }
+
+
+def _as_f32(builder: _Builder, value: ValueRef, dtype: str, prefix: str) -> ValueRef:
+    if dtype == "float32":
+        return value
+    return builder.op(
+        "cast",
+        (value,),
+        ((prefix + "_f32", _tensor("float32", value.type.shape)),),
+        {"dtype": "float32"},
+    )[0]
+
+
+def _cast_from_f32(builder: _Builder, value: ValueRef, output_dtype: str, prefix: str) -> ValueRef:
+    if output_dtype == "float32":
+        # Keep the public result name stable across dtype specializations.
+        # The identity is still an existing portable primitive, not a fused
+        # composite opcode.
+        return builder.op(
+            "identity",
+            (value,),
+            ((prefix, _tensor("float32", value.type.shape)),),
+        )[0]
+    return builder.op(
+        "cast",
+        (value,),
+        ((prefix, _tensor(output_dtype, value.type.shape)),),
+        {"dtype": output_dtype},
+    )[0]
+
+
+def _rms_core(
+    builder: _Builder,
+    x: ValueRef,
+    weight: ValueRef,
+    epsilon: ValueRef,
+    dtype: str,
+    shape: Tuple[int, ...],
+    prefix: str,
+) -> ValueRef:
+    f32 = "float32"
+    x_f32 = _as_f32(builder, x, dtype, prefix + "_x")
+    weight_f32 = _as_f32(builder, weight, dtype, prefix + "_weight")
+    weight_full = builder.op(
+        "broadcast",
+        (weight_f32,),
+        ((prefix + "_weight_full", _tensor(f32, shape)),),
+        {"shape": list(shape)},
+    )[0]
+    squared = builder.op(
+        "mul",
+        (x_f32, x_f32),
+        ((prefix + "_square", _tensor(f32, shape)),),
+    )[0]
+    reduced_shape = shape[:-1] + (1,)
+    mean = builder.op(
+        "reduce_mean",
+        (squared,),
+        ((prefix + "_mean", _tensor(f32, reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    stabilized = builder.op(
+        "add",
+        (mean, epsilon),
+        ((prefix + "_mean_eps", _tensor(f32, reduced_shape)),),
+    )[0]
+    inverse = builder.op(
+        "rsqrt",
+        (stabilized,),
+        ((prefix + "_inverse", _tensor(f32, reduced_shape)),),
+    )[0]
+    inverse_full = builder.op(
+        "broadcast",
+        (inverse,),
+        ((prefix + "_inverse_full", _tensor(f32, shape)),),
+        {"shape": list(shape)},
+    )[0]
+    normalized = builder.op(
+        "mul",
+        (x_f32, inverse_full),
+        ((prefix + "_normalized", _tensor(f32, shape)),),
+    )[0]
+    return builder.op(
+        "mul",
+        (normalized, weight_full),
+        ((prefix + "_scaled", _tensor(f32, shape)),),
+    )[0]
+
+
+def _rope_core(
+    builder: _Builder,
+    x: ValueRef,
+    cos: ValueRef,
+    sin: ValueRef,
+    dtype: str,
+    shape: Tuple[int, ...],
+    prefix: str,
+) -> ValueRef:
+    x_f32 = _as_f32(builder, x, dtype, prefix + "_x")
+    cos_f32 = _as_f32(builder, cos, dtype, prefix + "_cos")
+    sin_f32 = _as_f32(builder, sin, dtype, prefix + "_sin")
+    half = shape[-1] // 2
+    first_shape = shape[:-1] + (half,)
+    first = builder.op(
+        "slice",
+        (x_f32,),
+        ((prefix + "_first", _tensor("float32", first_shape)),),
+        {"starts": [0], "stops": [half], "axes": [-1], "steps": [1]},
+    )[0]
+    second = builder.op(
+        "slice",
+        (x_f32,),
+        ((prefix + "_second", _tensor("float32", first_shape)),),
+        {"starts": [half], "stops": [shape[-1]], "axes": [-1], "steps": [1]},
+    )[0]
+    negative = builder.op(
+        "neg",
+        (second,),
+        ((prefix + "_negative_second", _tensor("float32", first_shape)),),
+    )[0]
+    rotated = builder.op(
+        "concat",
+        (negative, first),
+        ((prefix + "_rotated", _tensor("float32", shape)),),
+        {"axis": -1},
+    )[0]
+    left = builder.op(
+        "mul",
+        (x_f32, cos_f32),
+        ((prefix + "_cos_part", _tensor("float32", shape)),),
+    )[0]
+    right = builder.op(
+        "mul",
+        (rotated, sin_f32),
+        ((prefix + "_sin_part", _tensor("float32", shape)),),
+    )[0]
+    return builder.op(
+        "add",
+        (left, right),
+        ((prefix + "_result", _tensor("float32", shape)),),
+    )[0]
+
+
+def build_rms_norm(
+    shape: Sequence[int], dtype: str = "bf16", output_dtype: Optional[str] = None
+) -> CoreProgram:
+    """Build ``x * rsqrt(mean(x*x) + epsilon) * weight`` over the last axis."""
+
+    shape = _shape(shape, "shape")
+    _require_nonempty_reduction(shape, "shape")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    builder = _Builder("qwen35_rms_norm", "rms_norm", shape)
+    x = builder.parameter("x", _tensor(dtype, shape))
+    weight = builder.parameter("weight", _tensor(dtype, (shape[-1],)))
+    epsilon = builder.parameter("epsilon", _scalar("float32"))
+    scaled = _rms_core(builder, x, weight, epsilon, dtype, shape, "rms")
+    output = _cast_from_f32(builder, scaled, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "formula": "x * rsqrt(mean(x*x,axis=-1,keepdims=True)+epsilon) * weight",
+            "epsilon_semantics": "add_before_rsqrt",
+            "accumulation_dtype": "float32",
+            "fallbacks": ["bf16_cast_lane", "host_broadcast_pre_expansion", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_l2_norm(
+    shape: Sequence[int], dtype: str = "bf16", output_dtype: Optional[str] = None
+) -> CoreProgram:
+    """Build ``x * rsqrt(sum(x*x,axis=-1,keepdims=True) + epsilon)``.
+
+    The epsilon is added before ``rsqrt``.  There is no implicit clamp or
+    ``max(sum, epsilon)`` semantic in this builder.
+    """
+
+    shape = _shape(shape, "shape")
+    _require_nonempty_reduction(shape, "shape")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    builder = _Builder("qwen35_l2_norm", "l2_norm", shape)
+    x = builder.parameter("x", _tensor(dtype, shape))
+    epsilon = builder.parameter("epsilon", _scalar("float32"))
+    x_f32 = _as_f32(builder, x, dtype, "l2_x")
+    square = builder.op("mul", (x_f32, x_f32), (("l2_square", _tensor("float32", shape)),))[0]
+    reduced_shape = shape[:-1] + (1,)
+    total = builder.op(
+        "reduce_sum",
+        (square,),
+        (("l2_sum", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    stabilized = builder.op(
+        "add",
+        (total, epsilon),
+        (("l2_sum_eps", _tensor("float32", reduced_shape)),),
+    )[0]
+    inverse = builder.op(
+        "rsqrt",
+        (stabilized,),
+        (("l2_inverse", _tensor("float32", reduced_shape)),),
+    )[0]
+    inverse_full = builder.op(
+        "broadcast",
+        (inverse,),
+        (("l2_inverse_full", _tensor("float32", shape)),),
+        {"shape": list(shape)},
+    )[0]
+    normalized = builder.op(
+        "mul",
+        (x_f32, inverse_full),
+        (("l2_normalized", _tensor("float32", shape)),),
+    )[0]
+    output = _cast_from_f32(builder, normalized, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "formula": "x * rsqrt(sum(x*x,axis=-1,keepdims=True)+epsilon)",
+            "epsilon_semantics": "add_before_rsqrt_no_clamp",
+            "accumulation_dtype": "float32",
+            "fallbacks": ["bf16_cast_lane", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_swiglu(
+    packed_shape: Sequence[int], dtype: str = "bf16", output_dtype: Optional[str] = None
+) -> CoreProgram:
+    """Build ``silu(gate) * up`` after splitting the packed last axis."""
+
+    packed_shape = _shape(packed_shape, "packed_shape")
+    _require_rank(packed_shape, "packed_shape", 1)
+    if packed_shape[-1] == 0 or packed_shape[-1] % 2:
+        raise ValueError("packed_shape last axis must be a positive even number")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    intermediate = packed_shape[-1] // 2
+    output_shape = packed_shape[:-1] + (intermediate,)
+    builder = _Builder("qwen35_swiglu", "swiglu", packed_shape)
+    packed = builder.parameter("packed", _tensor(dtype, packed_shape))
+    gate, up = builder.op(
+        "split",
+        (packed,),
+        (
+            ("gate", _tensor(dtype, output_shape)),
+            ("up", _tensor(dtype, output_shape)),
+        ),
+        {"sizes": [intermediate, intermediate], "axis": -1},
+    )
+    gate_f32 = _as_f32(builder, gate, dtype, "gate")
+    up_f32 = _as_f32(builder, up, dtype, "up")
+    activated = builder.op(
+        "silu",
+        (gate_f32,),
+        (("gate_silu", _tensor("float32", output_shape)),),
+    )[0]
+    multiplied = builder.op(
+        "mul",
+        (activated, up_f32),
+        (("swiglu_value", _tensor("float32", output_shape)),),
+    )[0]
+    output = _cast_from_f32(builder, multiplied, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "formula": "silu(split(packed,axis=-1)[0]) * split(packed,axis=-1)[1]",
+            "split_axis": -1,
+            "fallbacks": ["split_indexing_compact_descriptor", "scalar_math_lane_fallback:silu", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_stable_softmax(
+    shape: Sequence[int], dtype: str = "bf16", output_dtype: Optional[str] = None
+) -> CoreProgram:
+    """Build stable last-axis softmax with explicit reduction broadcasts."""
+
+    shape = _shape(shape, "shape")
+    _require_nonempty_reduction(shape, "shape")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    builder = _Builder("qwen35_stable_softmax", "stable_softmax", shape)
+    logits = builder.parameter("logits", _tensor(dtype, shape))
+    logits_f32 = _as_f32(builder, logits, dtype, "softmax_logits")
+    reduced_shape = shape[:-1] + (1,)
+    maximum = builder.op(
+        "reduce_max",
+        (logits_f32,),
+        (("softmax_max", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    maximum_full = builder.op(
+        "broadcast",
+        (maximum,),
+        (("softmax_max_full", _tensor("float32", shape)),),
+        {"shape": list(shape)},
+    )[0]
+    shifted = builder.op(
+        "sub",
+        (logits_f32, maximum_full),
+        (("softmax_shifted", _tensor("float32", shape)),),
+    )[0]
+    exponent = builder.op(
+        "exp",
+        (shifted,),
+        (("softmax_exp", _tensor("float32", shape)),),
+    )[0]
+    total = builder.op(
+        "reduce_sum",
+        (exponent,),
+        (("softmax_sum", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    total_full = builder.op(
+        "broadcast",
+        (total,),
+        (("softmax_sum_full", _tensor("float32", shape)),),
+        {"shape": list(shape)},
+    )[0]
+    probabilities = builder.op(
+        "div",
+        (exponent, total_full),
+        (("softmax_probabilities_f32", _tensor("float32", shape)),),
+    )[0]
+    output = _cast_from_f32(builder, probabilities, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "formula": "exp(logits-broadcast(reduce_max(logits)))/broadcast(reduce_sum(exp(...)))",
+            "axis": -1,
+            "stable": True,
+            "accumulation_dtype": "float32",
+            "fallbacks": ["scalar_math_lane_fallback:exp", "host_broadcast_pre_expansion", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_rope_rotate_half(
+    shape: Sequence[int], dtype: str = "bf16", output_dtype: Optional[str] = None
+) -> CoreProgram:
+    """Build text-only RoPE rotate-half with caller-provided cos/sin tensors."""
+
+    shape = _shape(shape, "shape")
+    _require_rank(shape, "shape", 1)
+    if shape[-1] == 0 or shape[-1] % 2:
+        raise ValueError("shape last axis must be a positive even number")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    builder = _Builder("qwen35_rope_rotate_half", "rope_rotate_half", shape)
+    x = builder.parameter("x", _tensor(dtype, shape))
+    cos = builder.parameter("cos", _tensor(dtype, shape))
+    sin = builder.parameter("sin", _tensor(dtype, shape))
+    rotated = _rope_core(builder, x, cos, sin, dtype, shape, "rope")
+    output = _cast_from_f32(builder, rotated, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "formula": "x*cos + concat(-x[...,d/2:],x[...,:d/2])*sin",
+            "contract": "text_only_rotate_half",
+            "visual_mrope": False,
+            "fallbacks": ["scalar_math_not_used", "bf16_cast_lane", "bf16_layout_indexing_fallback", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_gqa_repeat_kv(
+    kv_shape: Sequence[int],
+    query_heads: int,
+    dtype: str = "bf16",
+    index_dtype: str = "int64",
+) -> CoreProgram:
+    """Build runtime-indexed GQA repeat-KV using gather along head axis 1."""
+
+    kv_shape = _shape(kv_shape, "kv_shape")
+    _require_rank(kv_shape, "kv_shape", 2)
+    if kv_shape[1] <= 0:
+        raise ValueError("kv_shape head axis must be positive")
+    if isinstance(query_heads, bool) or not isinstance(query_heads, int) or query_heads <= 0:
+        raise ValueError("query_heads must be a positive integer")
+    if query_heads % kv_shape[1] != 0:
+        raise ValueError("query_heads must be divisible by kv_shape[1]")
+    dtype = _dtype(dtype, "dtype")
+    index_dtype = _index_dtype(index_dtype)
+    output_shape = kv_shape[:1] + (query_heads,) + kv_shape[2:]
+    builder = _Builder("qwen35_gqa_repeat_kv", "gqa_repeat_kv", kv_shape)
+    kv = builder.parameter("kv", _tensor(dtype, kv_shape))
+    head_indices = builder.parameter("head_indices", _tensor(index_dtype, (query_heads,)))
+    output = builder.op(
+        "gather",
+        (kv, head_indices),
+        (("output", _tensor(dtype, output_shape)),),
+        {"axis": 1},
+    )[0]
+    return builder.finish(
+        (output,),
+        {
+            "formula": "gather(kv,head_indices,axis=1)",
+            "axis": 1,
+            "kv_heads": kv_shape[1],
+            "query_heads": query_heads,
+            "repeat_factor": query_heads // kv_shape[1],
+            "indices_runtime": True,
+            "fallbacks": ["bf16_indexing_scalar_lane_fallback", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_causal_mask(
+    shape: Sequence[int], dtype: str = "bf16", output_dtype: Optional[str] = None
+) -> CoreProgram:
+    """Build ``where(bool_mask, logits, fill_value)`` with mask/fill inputs."""
+
+    shape = _shape(shape, "shape")
+    _require_rank(shape, "shape", 2)
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    builder = _Builder("qwen35_causal_mask", "causal_mask", shape)
+    logits = builder.parameter("logits", _tensor(dtype, shape))
+    mask = builder.parameter("causal_mask", _tensor("bool", shape))
+    fill = builder.parameter("fill_value", _scalar(dtype))
+    logits_f32 = _as_f32(builder, logits, dtype, "mask_logits")
+    fill_f32 = fill
+    if dtype != "float32":
+        fill_f32 = builder.op(
+            "cast",
+            (fill,),
+            (("mask_fill_f32", _scalar("float32")),),
+            {"dtype": "float32"},
+        )[0]
+    masked = builder.op(
+        "where",
+        (mask, logits_f32, fill_f32),
+        (("masked_f32", _tensor("float32", shape)),),
+    )[0]
+    output = _cast_from_f32(builder, masked, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "formula": "where(causal_mask,logits,fill_value)",
+            "mask_input": True,
+            "fill_input": True,
+            "host_precomputed_output": False,
+            "fallbacks": ["host_broadcast_pre_expansion", "bf16_where_scalar_lane_fallback", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_decoder_subgraph(
+    rows: int,
+    hidden: int = 1024,
+    intermediate: int = 2048,
+    dtype: str = "bf16",
+    output_dtype: Optional[str] = None,
+) -> CoreProgram:
+    """Build a small ``RMSNorm -> matmul -> split -> SwiGLU`` decoder chain."""
+
+    if isinstance(rows, bool) or not isinstance(rows, int) or rows < 0:
+        raise ValueError("rows must be a non-negative integer")
+    if isinstance(hidden, bool) or not isinstance(hidden, int) or hidden <= 0:
+        raise ValueError("hidden must be a positive integer")
+    if isinstance(intermediate, bool) or not isinstance(intermediate, int) or intermediate <= 0:
+        raise ValueError("intermediate must be a positive integer")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    input_shape = (rows, hidden)
+    projection_shape = (rows, intermediate * 2)
+    split_shape = (rows, intermediate)
+    builder = _Builder("qwen35_decoder_subgraph", "decoder_subgraph", input_shape)
+    x = builder.parameter("x", _tensor(dtype, input_shape))
+    weight = builder.parameter("norm_weight", _tensor(dtype, (hidden,)))
+    epsilon = builder.parameter("epsilon", _scalar("float32"))
+    projection_weight = builder.parameter("projection_weight", _tensor(dtype, (hidden, intermediate * 2)))
+    norm_f32 = _rms_core(builder, x, weight, epsilon, dtype, input_shape, "decoder_norm")
+    projection_weight_f32 = _as_f32(builder, projection_weight, dtype, "decoder_projection_weight")
+    projected = builder.op(
+        "matmul",
+        (norm_f32, projection_weight_f32),
+        (("projected", _tensor("float32", projection_shape)),),
+    )[0]
+    gate, up = builder.op(
+        "split",
+        (projected,),
+        (
+            ("projected_gate", _tensor("float32", split_shape)),
+            ("projected_up", _tensor("float32", split_shape)),
+        ),
+        {"sizes": [intermediate, intermediate], "axis": -1},
+    )
+    activated = builder.op(
+        "silu",
+        (gate,),
+        (("projected_gate_silu", _tensor("float32", split_shape)),),
+    )[0]
+    result_f32 = builder.op(
+        "mul",
+        (activated, up),
+        (("decoder_swiglu", _tensor("float32", split_shape)),),
+    )[0]
+    output = _cast_from_f32(builder, result_f32, output_dtype, "output")
+    return builder.finish(
+        (output,),
+        {
+            "chain": ["rms_norm", "matmul", "split", "silu", "mul"],
+            "hidden": hidden,
+            "intermediate": intermediate,
+            "fallbacks": ["scalar_math_lane_fallback:silu", "split_indexing_compact_descriptor", "python_list_wire_staging"],
+        },
+    )
+
+
+def build_attention_subgraph(
+    rope_shape: Sequence[int],
+    attention_shape: Sequence[int],
+    kv_shape: Sequence[int],
+    query_heads: int,
+    dtype: str = "bf16",
+    index_dtype: str = "int64",
+) -> CoreProgram:
+    """Build connected text-attention branches for RoPE, mask/softmax and GQA.
+
+    The three returned values are deliberately separate outputs: this is a
+    connectivity/contract harness, not a claim that attention score matmul or
+    KV state management is already implemented.
+    """
+
+    rope_shape = _shape(rope_shape, "rope_shape")
+    attention_shape = _shape(attention_shape, "attention_shape")
+    kv_shape = _shape(kv_shape, "kv_shape")
+    _require_rank(rope_shape, "rope_shape", 1)
+    if rope_shape[-1] == 0 or rope_shape[-1] % 2:
+        raise ValueError("rope_shape last axis must be a positive even number")
+    _require_rank(attention_shape, "attention_shape", 2)
+    _require_rank(kv_shape, "kv_shape", 2)
+    if kv_shape[1] <= 0:
+        raise ValueError("kv_shape head axis must be positive")
+    if isinstance(query_heads, bool) or not isinstance(query_heads, int) or query_heads <= 0:
+        raise ValueError("query_heads must be a positive integer")
+    if query_heads % kv_shape[1] != 0:
+        raise ValueError("query_heads must be divisible by kv_shape[1]")
+    dtype = _dtype(dtype, "dtype")
+    index_dtype = _index_dtype(index_dtype)
+    builder = _Builder("qwen35_attention_subgraph", "attention_subgraph", attention_shape)
+    q = builder.parameter("q", _tensor(dtype, rope_shape))
+    cos = builder.parameter("cos", _tensor(dtype, rope_shape))
+    sin = builder.parameter("sin", _tensor(dtype, rope_shape))
+    logits = builder.parameter("logits", _tensor(dtype, attention_shape))
+    mask = builder.parameter("causal_mask", _tensor("bool", attention_shape))
+    fill = builder.parameter("fill_value", _scalar(dtype))
+    kv = builder.parameter("kv", _tensor(dtype, kv_shape))
+    head_indices = builder.parameter("head_indices", _tensor(index_dtype, (query_heads,)))
+    rotary_f32 = _rope_core(builder, q, cos, sin, dtype, rope_shape, "attention_rope")
+    logits_f32 = _as_f32(builder, logits, dtype, "attention_logits")
+    fill_f32 = fill if dtype == "float32" else builder.op(
+        "cast", (fill,), (("attention_fill_f32", _scalar("float32")),), {"dtype": "float32"}
+    )[0]
+    masked = builder.op(
+        "where",
+        (mask, logits_f32, fill_f32),
+        (("attention_masked", _tensor("float32", attention_shape)),),
+    )[0]
+    reduced_shape = attention_shape[:-1] + (1,)
+    maximum = builder.op(
+        "reduce_max",
+        (masked,),
+        (("attention_max", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    maximum_full = builder.op(
+        "broadcast",
+        (maximum,),
+        (("attention_max_full", _tensor("float32", attention_shape)),),
+        {"shape": list(attention_shape)},
+    )[0]
+    shifted = builder.op(
+        "sub",
+        (masked, maximum_full),
+        (("attention_shifted", _tensor("float32", attention_shape)),),
+    )[0]
+    exponent = builder.op(
+        "exp",
+        (shifted,),
+        (("attention_exp", _tensor("float32", attention_shape)),),
+    )[0]
+    total = builder.op(
+        "reduce_sum",
+        (exponent,),
+        (("attention_sum", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    total_full = builder.op(
+        "broadcast",
+        (total,),
+        (("attention_sum_full", _tensor("float32", attention_shape)),),
+        {"shape": list(attention_shape)},
+    )[0]
+    probabilities_f32 = builder.op(
+        "div",
+        (exponent, total_full),
+        (("probabilities_f32", _tensor("float32", attention_shape)),),
+    )[0]
+    probabilities = _cast_from_f32(builder, probabilities_f32, dtype, "probabilities")
+    rotary = _cast_from_f32(builder, rotary_f32, dtype, "rotary_q")
+    repeated = builder.op(
+        "gather",
+        (kv, head_indices),
+        (("repeated_kv", _tensor(dtype, kv_shape[:1] + (query_heads,) + kv_shape[2:])),),
+        {"axis": 1},
+    )[0]
+    return builder.finish(
+        (rotary, probabilities, repeated),
+        {
+            "branches": ["rope_rotate_half", "causal_mask", "stable_softmax", "gqa_repeat_kv"],
+            "attention_score_matmul": False,
+            "kv_state": "external_input_only",
+            "fallbacks": ["scalar_math_lane_fallback:exp", "host_broadcast_pre_expansion", "bf16_indexing_scalar_lane_fallback", "python_list_wire_staging"],
+        },
+    )
+
+
+__all__ = [
+    "QWEN35_08B_SHAPE_METADATA",
+    "build_attention_subgraph",
+    "build_causal_mask",
+    "build_decoder_subgraph",
+    "build_gqa_repeat_kv",
+    "build_l2_norm",
+    "build_rms_norm",
+    "build_rope_rotate_half",
+    "build_stable_softmax",
+    "build_swiglu",
+]
