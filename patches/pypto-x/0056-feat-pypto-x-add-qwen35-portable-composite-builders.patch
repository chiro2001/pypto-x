+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_decoder_subgraph_three_way_connects_norm_matmul_split_swiglu(dtype, tmp_path):
+    rows, hidden, intermediate = 3, 8, 10
+    shape = (rows, hidden)
+    x_values = [((index * 5) % 17 - 8) * 0.1 for index in range(rows * hidden)]
+    norm_values = [1.0 + index * 0.05 for index in range(hidden)]
+    projection_values = [((index * 7) % 23 - 11) * 0.03 for index in range(hidden * intermediate * 2)]
+    x = HostTensor(dtype, shape, x_values)
+    norm_weight = HostTensor(dtype, (hidden,), norm_values)
+    projection = HostTensor(dtype, (hidden, intermediate * 2), projection_values)
+    epsilon = 0.001
+    normalized = []
+    for row in _rows(x.flat(), shape):
+        mean = sum(float(item) * float(item) for item in row) / hidden
+        scale = 1.0 / math.sqrt(mean + epsilon)
+        normalized.extend(scale * float(item) * float(weight) for item, weight in zip(row, norm_weight.flat()))
+    projected = []
+    for row in range(rows):
+        for column in range(intermediate * 2):
+            projected.append(sum(normalized[row * hidden + inner] * float(projection.flat()[inner * intermediate * 2 + column]) for inner in range(hidden)))
+    golden = []
+    for row in _rows(projected, (rows, intermediate * 2)):
+        golden.extend(_silu(float(value)) * float(row[intermediate + index]) for index, value in enumerate(row[:intermediate]))
+    program = build_decoder_subgraph(rows, hidden, intermediate, dtype)
+    assert program.metadata["chain"] == ("rms_norm", "matmul", "split", "silu", "mul")
+    _three_way(
+        program,
+        [x, norm_weight, projection],
+        [(rows, intermediate)],
+        [dtype],
+        {"epsilon": epsilon},
+        [golden],
+        tmp_path,
+    )
