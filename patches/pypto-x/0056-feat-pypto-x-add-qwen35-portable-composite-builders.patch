+def test_qwen35_large_shape_plan_and_artifact_stay_compact(tmp_path):
+    """Use Qwen hidden/intermediate metadata without allocating model tensors."""
+
+    program = build_decoder_subgraph(1, hidden=1024, intermediate=2048, dtype="bf16")
+    scalar_artifact = _compile_scalar(program)
+    sve_artifact = _compile_sve(program, tmp_path)
+    assert len(program.canonical_json()) < 20000
+    assert len(scalar_artifact.payload) < 30000
+    assert sve_artifact.payload is None
+    assert sve_artifact.path is not None
+    large_native_size = Path(sve_artifact.path).stat().st_size
+    assert large_native_size < 2 * 1024 * 1024
+    small_sve = _compile_sve(build_decoder_subgraph(1, hidden=8, intermediate=16, dtype="bf16"), tmp_path / "small")
+    assert small_sve.path is not None
+    small_native_size = Path(small_sve.path).stat().st_size
+    assert large_native_size <= small_native_size * 2
+    assert all("index_map" not in plan.canonical_json() for plan in Sve256Compiler().lower(program, SVE_TARGET).plans)
+    assert program.metadata["model"]["hidden_size"] == 1024
+    assert program.metadata["model"]["shape_only"] is True
