+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_attention_subgraph_three_way_connects_rope_mask_softmax_gqa(dtype, tmp_path):
+    rope_shape = (2, 10)
+    attention_shape = (3, 9)
+    kv_shape = (1, 3, 2, 5)
+    query_heads = 6
+    q = HostTensor(dtype, rope_shape, [((index * 3) % 17 - 8) * 0.1 for index in range(20)])
+    cos = HostTensor(dtype, rope_shape, [math.cos(index / 11.0) for index in range(20)])
+    sin = HostTensor(dtype, rope_shape, [math.sin(index / 13.0) for index in range(20)])
+    logits = HostTensor(dtype, attention_shape, [((index * 5) % 19 - 9) * 0.15 for index in range(27)])
+    mask = HostTensor("bool", attention_shape, [column <= row + 1 for row in range(3) for column in range(9)])
+    kv = HostTensor(dtype, kv_shape, [index * 0.1 - 1.0 for index in range(_count(kv_shape))])
+    indices = HostTensor("int64", (query_heads,), [0, 1, 2, 0, 1, 2])
+    fill = -10000.0
+
+    half = rope_shape[-1] // 2
+    rotary_golden = []
+    for x_row, cos_row, sin_row in zip(_rows(q.flat(), rope_shape), _rows(cos.flat(), rope_shape), _rows(sin.flat(), rope_shape)):
+        rotated = [-float(item) for item in x_row[half:]] + [float(item) for item in x_row[:half]]
+        rotary_golden.extend(
+            float(item) * float(c) + float(r) * float(s)
+            for item, c, s, r in zip(x_row, cos_row, sin_row, rotated)
+        )
+    softmax_golden = []
+    for row in range(attention_shape[0]):
+        masked = [float(logits.flat()[row * attention_shape[1] + column]) if mask.flat()[row * attention_shape[1] + column] else fill for column in range(attention_shape[1])]
+        maximum = max(masked)
+        exponents = [math.exp(value - maximum) for value in masked]
+        total = sum(exponents)
+        softmax_golden.extend(value / total for value in exponents)
+    repeated_golden = []
+    for head in (0, 1, 2, 0, 1, 2):
+        start = head * kv_shape[2] * kv_shape[3]
+        repeated_golden.extend(kv.flat()[start:start + kv_shape[2] * kv_shape[3]])
+    program = build_attention_subgraph(rope_shape, attention_shape, kv_shape, query_heads, dtype)
+    outputs = _three_way(
+        program,
+        [q, cos, sin, logits, mask, kv, indices],
+        [rope_shape, attention_shape, (1, query_heads, 2, 5)],
+        [dtype, dtype, dtype],
+        {"fill_value": fill},
+        [rotary_golden, softmax_golden, repeated_golden],
+        tmp_path,
+    )
+    assert len(outputs[0]) == 3 and len(outputs[1]) == 3
+
