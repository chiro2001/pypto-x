+#!/usr/bin/env bash
+# C7 诊断：heavy 产物后处理（不占锁）：state 对比 + swap 汇总 + 表格 + manifest。
+# usage: postprocess_after_heavy.sh <evidence-dir> <worktree>
+set -uo pipefail
+
+EV=${1:?evidence dir required}
+WT=${2:-/home/chiro/projects/pypto/worktrees/pypto-x/c7-decode-gap-localization}
+RAW="${EV}/raw"
+GOLD=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+OURS_RAW=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-l4-avx512/raw
+mkdir -p "${RAW}"
+
+if [[ -d "${RAW}/gold_states_w8a8" ]]; then
+  python3 "${WT}/tools/diag_c7/compare_states.py" \
+    --ours-raw "${OURS_RAW}" \
+    --gold-dir "${RAW}/gold_states_w8a8" \
+    --gold-reference-dir "${GOLD}" \
+    --gold-fp32-dir "${RAW}/gold_states_float32" \
+    --output "${RAW}/compare_states.json" || true
+fi
+
+if [[ -f "${RAW}/state_swap_experiment.json" ]]; then
+  python3 "${WT}/tools/diag_c7/summarize_swap.py" \
+    --swap "${RAW}/state_swap_experiment.json" \
+    --output "${RAW}/state_swap_summary.json" || true
+fi
+
+python3 "${WT}/tools/diag_c7/analyze_decode_gap.py" \
+  --gold-dir "${GOLD}" --evidence-raw "${OURS_RAW}" \
+  --output "${RAW}/decode_gap_analysis.json"
+python3 "${WT}/tools/diag_c7/render_tables.py" \
+  --analysis "${RAW}/decode_gap_analysis.json" \
+  --output "${RAW}/tables_decode_gap.md"
+python3 "${WT}/tools/diag_c7/state_trajectory_ours.py" \
+  --ours-raw "${OURS_RAW}" \
+  --analysis-json "${RAW}/decode_gap_analysis.json" \
+  --output "${RAW}/state_trajectory_ours.json"
+python3 "${WT}/tools/diag_c7/make_evidence_manifest.py" --evidence-dir "${EV}"
+echo "[c7-postprocess] done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
