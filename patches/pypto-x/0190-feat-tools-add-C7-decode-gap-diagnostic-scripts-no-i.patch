+#!/usr/bin/env bash
+# C7 诊断 heavy 总入口（在 local 锁内顺序执行）：
+#   1) dump gold(HF w8a8/bfloat16/float32) prefill+decode state
+#   2) state 注入自检（gold state -> gold logits 逐位）
+#   3) state swap 归因实验（逐层消融）
+# usage: run_c7_heavy.sh <evidence-dir> <worktree>
+set -uo pipefail
+
+EV=${1:?evidence dir required}
+WT=${2:-/home/chiro/projects/pypto/worktrees/pypto-x/c7-decode-gap-localization}
+VENV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/qwen35-bf16-reference/venv
+ASSETS=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/assets/qwen35-0.8b/2fc06364715b967f1860aea9cf38778875588b17
+GOLD=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+RAW="${EV}/raw"
+LOGS="${EV}/logs"
+mkdir -p "${RAW}" "${LOGS}"
+
+bash "${WT}/tools/diag_c7/run_gold_states_heavy.sh" "${EV}" "${WT}"
+rc=$?
+if [[ ${rc} -ne 0 ]]; then
+  echo "[c7-heavy] gold state dump failed rc=${rc}"
+  exit ${rc}
+fi
+
+COMMON=(
+  --harness "${WT}/tools/qwen35_reference/run_reference.py"
+  --assets-dir "${ASSETS}"
+  --ours-raw /home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-l4-avx512/raw
+  --gold-states-dir "${RAW}/gold_states_w8a8"
+  --gold-reference-dir "${GOLD}"
+  --steps 3 --threads 6 --seed 0 --variants w8a8
+)
+
+echo "[c7-heavy] state injection self-check $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+"${VENV}/bin/python" "${WT}/tools/diag_c7/state_swap_experiment.py" \
+  "${COMMON[@]}" --self-check --out "${RAW}/state_swap_selfcheck.json" \
+  2>&1 | tee "${LOGS}/state_swap_selfcheck.log"
+rc=${PIPESTATUS[0]}
+if [[ ${rc} -ne 0 ]]; then
+  echo "[c7-heavy] self-check failed rc=${rc}"
+  exit ${rc}
+fi
+
+echo "[c7-heavy] state swap experiment $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+"${VENV}/bin/python" "${WT}/tools/diag_c7/state_swap_experiment.py" \
+  "${COMMON[@]}" --out "${RAW}/state_swap_experiment.json" \
+  2>&1 | tee "${LOGS}/state_swap_experiment.log"
+rc=${PIPESTATUS[0]}
+echo "[c7-heavy] state swap experiment exit=${rc} $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+exit ${rc}
