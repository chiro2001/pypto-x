+#!/usr/bin/env python3
+"""C7 诊断：汇总 state_swap_experiment.json（控制台 + 可选 JSON）。"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--swap", required=True)
+    parser.add_argument("--output", default="")
+    args = parser.parse_args()
+    data = json.loads(Path(args.swap).read_text(encoding="utf-8"))
+    summary = {"meta": {key: data.get(key) for key in (
+        "variant", "param_dtype", "gold_states_dir", "generated_at_utc")}, "prompts": {}}
+    print("variant={} param_dtype={} gold_states={}".format(
+        data.get("variant"), data.get("param_dtype"), data.get("gold_states_dir")))
+    for prompt, prompt_data in data.get("prompts", {}).items():
+        print("== {} chain={} ==".format(prompt, prompt_data.get("gold_token_chain")))
+        entry = {"gold_token_chain": prompt_data.get("gold_token_chain"), "configs": {}}
+        for config, config_data in prompt_data.get("configs", {}).items():
+            entry["configs"][config] = []
+            for step in config_data.get("steps", []):
+                total = step["total_gap_C_vs_A"]
+                reflow = step["state_reflow_gap_B_vs_A"]
+                compute = step["compute_gap_C_vs_B"]
+                top = step["per_layer_fix_ranking"][:3]
+                entry["configs"][config].append({
+                    "step_index": step["step_index"],
+                    "token": step["token"],
+                    "total_rel_l2": total.get("rel_l2"), "total_cos": total.get("cosine"),
+                    "reflow_rel_l2": reflow.get("rel_l2"), "reflow_cos": reflow.get("cosine"),
+                    "compute_rel_l2": compute.get("rel_l2"), "compute_cos": compute.get("cosine"),
+                    "top_fix_layers": top,
+                    "baseline_bitwise": step.get("baseline_vs_sequential", {}).get("bitwise_equal"),
+                })
+                print("  {:<8} step{} token={:<7} total(rel={:.5f} cos={:.6f}) "
+                      "state_reflow(rel={:.5f} cos={:.6f}) compute(rel={:.5f}) top_fix={}".format(
+                          config, step["step_index"], step["token"],
+                          total.get("rel_l2") or -1, total.get("cosine") or -1,
+                          reflow.get("rel_l2") or -1, reflow.get("cosine") or -1,
+                          compute.get("rel_l2") or -1,
+                          [(item["layer"], round(item["fix_gain"] or 0, 5)) for item in top]))
+        summary["prompts"][prompt] = entry
+
+    # 跨 step 的层贡献排名（按 fix_gain 求和，只在 steps>=1 上聚合，避免 prefill_next 权重）
+    ranking = {}
+    for prompt, prompt_data in data.get("prompts", {}).items():
+        for config, config_data in prompt_data.get("configs", {}).items():
+            for step in config_data.get("steps", []):
+                if step["step_index"] == 0:
+                    continue
+                for item in step["per_layer_fix"]:
+                    key = (prompt, config, item["layer"])
+                    ranking[key] = ranking.get(key, 0.0) + (item["fix_gain"] or 0.0)
+    top_overall = sorted(ranking.items(), key=lambda kv: -kv[1])[:12]
+    summary["top_layers_sum_over_decode_steps"] = [
+        {"prompt": key[0], "config": key[1], "layer": key[2], "sum_fix_gain": value}
+        for key, value in top_overall]
+    print("== top layers (sum fix_gain over decode steps >=1) ==")
+    for item in summary["top_layers_sum_over_decode_steps"]:
+        print("  {} {} layer_{:02d} sum_fix_gain={:.6f}".format(
+            item["prompt"], item["config"], item["layer"], item["sum_fix_gain"]))
+    if args.output:
+        Path(args.output).write_text(json.dumps(summary, indent=1), encoding="utf-8")
+        print("[summarize_swap] wrote {}".format(args.output))
+
+
+if __name__ == "__main__":
+    main()
