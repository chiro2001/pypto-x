@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# C7 诊断 heavy inner：在 local 锁内 dump gold(HF 参照) 的 prefill/decode state。
+# 由 scripts/resource/run_local_heavy.sh 在锁内调用（本脚本自身不加锁）。
+#
+# usage: run_gold_states_heavy.sh <evidence-dir> [worktree]
+set -uo pipefail
+
+EV=${1:?evidence dir required}
+WT=${2:-/home/chiro/projects/pypto/worktrees/pypto-x/c7-decode-gap-localization}
+VENV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/qwen35-bf16-reference/venv
+ASSETS=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/assets/qwen35-0.8b/2fc06364715b967f1860aea9cf38778875588b17
+GOLD=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-w8a8-reference-gold/reference
+PY="${VENV}/bin/python"
+RAW="${EV}/raw"
+LOGS="${EV}/logs"
+mkdir -p "${RAW}" "${LOGS}"
+
+run_variant() {
+  local variant=$1
+  local out="${RAW}/gold_states_${variant}"
+  if [[ -f "${out}/gold_states_manifest.json" ]]; then
+    echo "[gold-states] skip ${variant} (exists)"
+    return 0
+  fi
+  echo "[gold-states] variant=${variant} start $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "${PY}" "${WT}/tools/diag_c7/dump_gold_states.py" \
+    --harness "${WT}/tools/qwen35_reference/run_reference.py" \
+    --assets-dir "${ASSETS}" \
+    --variant "${variant}" \
+    --out-dir "${out}" \
+    --max-new-tokens 4 --threads 6 --seed 0 \
+    --gold-dir "${GOLD}" \
+    2>&1 | tee "${LOGS}/dump_gold_states_${variant}.log"
+  local status=${PIPESTATUS[0]}
+  echo "[gold-states] variant=${variant} exit=${status} at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  return ${status}
+}
+
+# w8a8 是必需项；C7_VARIANTS 可追加 bfloat16/float32 作为 state 口径参照
+# （锁竞争激烈时默认只跑 w8a8，减少占锁时间）。
+VARIANTS=${C7_VARIANTS:-w8a8}
+run_variant w8a8 || exit $?
+for extra in ${VARIANTS//,/ }; do
+  [[ ${extra} == w8a8 ]] && continue
+  if [[ ${extra} == float32 ]]; then
+    avail=$(awk '/^MemAvailable:/ {printf "%d", $2/1024; exit}' /proc/meminfo)
+    if (( avail < 13000 )); then
+      echo "[gold-states] skip float32 dump: MemAvailable=${avail}MiB < 13000MiB" | tee "${LOGS}/dump_gold_states_float32.skipped"
+      continue
+    fi
+  fi
+  run_variant "${extra}" || echo "[gold-states] warn: ${extra} dump failed (non-fatal)"
+done
+echo "[gold-states] done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
diff --git a/tools/diag_c7/state_swap_experiment.py b/tools/diag_c7/state_swap_experiment.py
new file mode 100644
index 000000000..d20ba9d44
--- /dev/null
+++ b/tools/diag_c7/state_swap_experiment.py
@@ -0,0 +1,439 @@
+#!/usr/bin/env python3
+"""C7 诊断：state 回灌归因实验（oracle state swap，跑在官方 HF w8a8 gold 上）。
+
+问题：decode 的 logits 缺口里，多少来自"我们的 state（conv/GDR/KV）逐步回灌"，
+多少来自"给定相同 state 时的单步计算差异"？
+
+方法（全部在 gold 模型上做，不涉及我们的运行时）：
+  对每个 prompt 的第 j 个 decode step（消耗 gold token j）：
+    * cache 中装入 gold state（step j 的输入 state）→ 前向 → A_j（=gold logits，逐位校验）；
+    * cache 中装入 ours state（同一位置）      → 前向 → B_j；
+    * 逐层消融：ours state 中只把 layer L 换成 gold state → D_j^L；
+    * ours 自己 dump 的 logits C_j（只读既有产物）。
+  于是：
+    ||C_j - A_j||                 = 总缺口（= 判据看到的量）
+    ||B_j - A_j||                 = state 回灌能解释的部分
+    ||C_j - B_j||                 = 相同 state 下的单步计算差异
+    ||D_j^L - A_j|| 相对 B_j 的下降 = layer L 的 state 误差对总缺口的边际贡献
+
+state 语义（双方均为"消耗 token j-1 之后"）：
+  after_prefill -> step_0 -> step_1 -> step_2 -> step_3
+映射：ours layer_XX_causal_conv_new_state / layer_XX_recurrent_step_*_new_state /
+layer_XX_new_k,new_v  <->  HF cache 的 conv_states[0] / recurrent_states[0] / keys,values。
+ours state 以 float32 dump，注入前 cast 到模型 dtype（w8a8 为 bf16），结果中记录该 cast。
+
+只读资产目录（local_files_only=True）；输出 JSON。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import math
+import os
+import random
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+CONFIGS = ("default", "full")
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def cosine(a, b):
+    a = np.asarray(a, dtype=np.float64).reshape(-1)
+    b = np.asarray(b, dtype=np.float64).reshape(-1)
+    na = math.sqrt(float(np.dot(a, a)))
+    nb = math.sqrt(float(np.dot(b, b)))
+    if na == 0.0 or nb == 0.0:
+        return float("nan")
+    return float(np.dot(a, b) / (na * nb))
+
+
+def compare(actual, baseline):
+    actual = np.asarray(actual, dtype=np.float64).reshape(-1)
+    baseline = np.asarray(baseline, dtype=np.float64).reshape(-1)
+    delta = actual - baseline
+    gn = math.sqrt(float(np.dot(baseline, baseline)))
+    return {
+        "cosine": cosine(actual, baseline),
+        "rel_l2": float(math.sqrt(float(np.dot(delta, delta))) / gn) if gn else None,
+        "max_abs": float(np.max(np.abs(delta))),
+    }
+
+
+def ours_snapshot(npz, layer):
+    out = {}
+    conv = npz.get("layer_{:02d}_causal_conv_new_state".format(layer))
+    if conv is not None:
+        out["conv"] = conv
+    recurrent = [key for key in npz
+                 if key.startswith("layer_{:02d}_recurrent_step_".format(layer))
+                 and key.endswith("_new_state")]
+    if len(recurrent) == 1:
+        out["recurrent"] = npz[recurrent[0]]
+    elif len(recurrent) > 1:
+        raise SystemExit("layer {} has {} recurrent states".format(layer, len(recurrent)))
+    key = npz.get("layer_{:02d}_new_k".format(layer))
+    value = npz.get("layer_{:02d}_new_v".format(layer))
+    if key is not None and value is not None:
+        out["k"] = key
+        out["v"] = value
+    return out
+
+
+def gold_snapshot(npz, tag, layer):
+    out = {}
+    for suffix, name in (("conv_state", "conv"), ("recurrent_state", "recurrent"),
+                         ("key_cache", "k"), ("value_cache", "v")):
+        arr = npz.get("{}__layer_{:02d}__{}".format(tag, layer, suffix))
+        if arr is not None:
+            out[name] = arr
+    return out
+
+
+def make_cache(model):
+    from transformers import DynamicCache
+    return DynamicCache(config=model.model.language_model.config)
+
+
+def inject(cache, snapshots, dtype):
+    import torch
+    for index, cache_layer in enumerate(cache.layers):
+        snap = snapshots.get(index, {})
+        if hasattr(cache_layer, "conv_states"):
+            if "conv" in snap:
+                tensor = torch.as_tensor(np.ascontiguousarray(snap["conv"]), dtype=dtype)
+                cache_layer.conv_states[0] = tensor
+                cache_layer.is_conv_states_initialized[0] = True
+                cache_layer.conv_kernel_size[0] = int(tensor.shape[-1])
+            if "recurrent" in snap:
+                cache_layer.recurrent_states[0] = torch.as_tensor(
+                    np.ascontiguousarray(snap["recurrent"]), dtype=dtype)
+                cache_layer.is_recurrent_states_initialized[0] = True
+                cache_layer.has_previous_state[0] = True
+            cache_layer.dtype = dtype
+            cache_layer.device = torch.device("cpu")
+        else:
+            if "k" in snap and "v" in snap:
+                cache_layer.keys = torch.as_tensor(np.ascontiguousarray(snap["k"]), dtype=dtype)
+                cache_layer.values = torch.as_tensor(np.ascontiguousarray(snap["v"]), dtype=dtype)
+                cache_layer.is_initialized = True
+                cache_layer.dtype = dtype
+                cache_layer.device = torch.device("cpu")
+
+
+def measure(model, cache, token_id):
+    import torch
+    with torch.no_grad():
+        out = model(
+            input_ids=torch.tensor([[int(token_id)]], dtype=torch.long),
+            past_key_values=cache,
+            use_cache=True,
+            return_dict=True,
+        )
+    return out.logits[0, -1].to(torch.float32).cpu().numpy().copy()
+
+
+def sequential_gold(model, input_ids, steps):
+    """返回 logits 序列：logits[0]=prefill 末行，logits[j+1]=消耗 token j 之后的输出。"""
+    import torch
+    with torch.no_grad():
+        out = model(input_ids=torch.tensor([list(input_ids)], dtype=torch.long),
+                    use_cache=True, return_dict=True)
+    past = out.past_key_values
+    logits = [out.logits[0, -1].to(torch.float32).cpu().numpy().copy()]
+    tokens = []
+    for _ in range(steps):
+        next_id = int(np.argmax(logits[-1]))
+        tokens.append(next_id)
+        with torch.no_grad():
+            out = model(input_ids=torch.tensor([[next_id]], dtype=torch.long),
+                        past_key_values=past, use_cache=True, return_dict=True)
+        past = out.past_key_values
+        logits.append(out.logits[0, -1].to(torch.float32).cpu().numpy().copy())
+    return logits, tokens
+
+
+def snapshot_inline(past):
+    """从 HF cache 现场抄出 {layer: {conv/recurrent/k/v}}（float32 copy）。"""
+    import torch
+    out = {}
+    for index, cache_layer in enumerate(past.layers):
+        entry = {}
+        conv_states = getattr(cache_layer, "conv_states", None)
+        if conv_states is not None:
+            conv = conv_states.get(0)
+            if conv is not None:
+                entry["conv"] = conv.detach().to(torch.float32).cpu().numpy().copy()
+            recurrent = cache_layer.recurrent_states.get(0)
+            if recurrent is not None:
+                entry["recurrent"] = recurrent.detach().to(torch.float32).cpu().numpy().copy()
+        keys = getattr(cache_layer, "keys", None)
+        values = getattr(cache_layer, "values", None)
+        if keys is not None and keys.numel():
+            entry["k"] = keys.detach().to(torch.float32).cpu().numpy().copy()
+            entry["v"] = values.detach().to(torch.float32).cpu().numpy().copy()
+        out[index] = entry
+    return out
+
+
+def self_check(model, item, param_dtype, steps=3):
+    """注入现场捕获的 gold state，验证 A_j 与顺序前向 logits 逐位一致。"""
+    import torch
+    with torch.no_grad():
+        out = model(input_ids=torch.tensor([list(item["forward_ids"])], dtype=torch.long),
+                    use_cache=True, return_dict=True)
+    past = out.past_key_values
+    logits = [out.logits[0, -1].to(torch.float32).cpu().numpy().copy()]
+    snaps = [snapshot_inline(past)]
+    chain = []
+    for _ in range(steps):
+        next_id = int(np.argmax(logits[-1]))
+        chain.append(next_id)
+        with torch.no_grad():
+            out = model(input_ids=torch.tensor([[next_id]], dtype=torch.long),
+                        past_key_values=past, use_cache=True, return_dict=True)
+        past = out.past_key_values
+        logits.append(out.logits[0, -1].to(torch.float32).cpu().numpy().copy())
+        snaps.append(snapshot_inline(past))
+    checks = []
+    for j in range(steps):
+        cache = make_cache(model)
+        inject(cache, snaps[j], param_dtype)
+        measured = measure(model, cache, chain[j])
+        checks.append({
+            "step": j,
+            "token": int(chain[j]),
+            "bitwise_equal_sequential": bool(np.array_equal(measured, logits[j + 1])),
+            "max_abs_diff": float(np.max(np.abs(measured.astype(np.float64)
+                                             - logits[j + 1].astype(np.float64)))),
+            "cosine": cosine(measured, logits[j + 1]),
+            "layers_captured": len(snaps[j]),
+        })
+    return {"prompt": item["id"], "checks": checks}
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--harness", required=True)
+    parser.add_argument("--assets-dir", required=True)
+    parser.add_argument("--ours-raw", required=True)
+    parser.add_argument("--gold-states-dir", required=True)
+    parser.add_argument("--gold-reference-dir", required=True)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--steps", type=int, default=4)
+    parser.add_argument("--threads", type=int, default=6)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--variants", default="w8a8")
+    parser.add_argument("--max-layers", type=int, default=0, help=">0 时只消融前 N 层（调试用）")
+    parser.add_argument("--self-check", action="store_true",
+                        help="只做注入自检（gold state -> gold logits 逐位），不跑消融")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    harness = load_module("c7_run_reference", os.path.abspath(args.harness))
+    import w8a8_reference  # noqa: F401
+    import torch
+
+    torch.set_num_threads(args.threads)
+    random.seed(args.seed)
+    np.random.seed(args.seed)
+    torch.manual_seed(args.seed)
+
+    from transformers import AutoTokenizer
+
+    tokenizer = AutoTokenizer.from_pretrained(args.assets_dir, local_files_only=True)
+    prompts = harness.encode_prompts(tokenizer, list(PROMPTS))
+    variant = harness.W8A8_VARIANTS[args.variants]
+    model = harness.load_model(args.assets_dir, variant["base_dtype"], "eager")
+    audit = w8a8_reference.apply_fake_quant(model, args.variants)
+    param_dtype = next(model.parameters()).dtype
+    print("[swap] variant={} param_dtype={} quantized={}".format(
+        args.variants, param_dtype, audit["scope"]["quantized_module_count"]), flush=True)
+
+    if args.self_check:
+        report = {"tool": "state_swap_experiment.self_check",
+                  "param_dtype": str(param_dtype),
+                  "variant": args.variants,
+                  "prompts": [self_check(model, prompt, param_dtype, steps=min(3, args.steps))
+                              for prompt in prompts]}
+        out_path = Path(args.out)
+        out_path.parent.mkdir(parents=True, exist_ok=True)
+        out_path.write_text(json.dumps(report, indent=1), encoding="utf-8")
+        ok = all(check["max_abs_diff"] <= 1e-5
+                 for prompt in report["prompts"] for check in prompt["checks"])
+        print("[swap] self-check ok={} -> {}".format(ok, out_path), flush=True)
+        return 0 if ok else 1
+
+    layer_count = len(model.model.language_model.layers)
+    if args.max_layers > 0:
+        layer_count = min(layer_count, args.max_layers)
+
+    ours_raw = Path(args.ours_raw).resolve()
+    gold_states_dir = Path(args.gold_states_dir).resolve()
+    gold_reference_dir = Path(args.gold_reference_dir).resolve()
+
+    result = {
+        "tool": "state_swap_experiment",
+        "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "harness": os.path.abspath(args.harness),
+        "harness_sha256": hashlib.sha256(
+            open(os.path.abspath(args.harness), "rb").read()).hexdigest(),
+        "ours_raw": str(ours_raw),
+        "gold_states_dir": str(gold_states_dir),
+        "gold_reference_dir": str(gold_reference_dir),
+        "param_dtype": str(param_dtype),
+        "variant": args.variants,
+        "fake_quant_scope": audit.get("scope"),
+        "definition": {
+            "A_j": "gold states 注入后前向（=gold logits）",
+            "B_j": "ours states 注入后前向",
+            "C_j": "ours 自己 dump 的 logits",
+            "D_j^L": "ours states，仅 layer L 换成 gold state",
+            "total_gap": "C_j vs A_j",
+            "state_reflow_gap": "B_j vs A_j",
+            "compute_gap_given_state": "C_j vs B_j",
+            "layer_fix_gain": "rel_l2(B_j-A_j) - rel_l2(D_j^L-A_j)（越大说明该层 state 误差贡献越大）",
+        },
+        "prompts": {},
+    }
+
+    for item in prompts:
+        prompt = item["id"]
+        print("[swap] prompt={}".format(prompt), flush=True)
+        gold_states = {}
+        gold_states_path = gold_states_dir / "{}.npz".format(prompt)
+        with np.load(str(gold_states_path), allow_pickle=False) as data:
+            for key in data.files:
+                gold_states[key] = np.asarray(data[key])
+        gold_ref = {}
+        with np.load(str(gold_reference_dir / "w8a8" / "{}.npz".format(prompt)),
+                     allow_pickle=False) as data:
+            for key in data.files:
+                gold_ref[key] = np.asarray(data[key])
+
+        logits_seq, chain = sequential_gold(model, item["forward_ids"], args.steps)
+        print("[swap]   token chain={}".format(chain), flush=True)
+
+        prompt_out = {
+            "gold_token_chain": [int(v) for v in chain],
+            "gold_logits_sequence_validation": [],
+            "configs": {},
+        }
+        # 逐位校验：sequential_gold 的 logits[1..] 必须与既有 gold decode_logits 一致
+        decode_logits_ref = np.asarray(gold_ref["decode_logits"], dtype=np.float32)
+        for j in range(min(args.steps, decode_logits_ref.shape[0])):
+            identical = bool(np.array_equal(logits_seq[j], decode_logits_ref[j]))
+            prompt_out["gold_logits_sequence_validation"].append({
+                "index": j, "bitwise_equal_gold_npz": identical,
+                "max_abs_diff": float(np.max(np.abs(
+                    logits_seq[j].astype(np.float64) - decode_logits_ref[j].astype(np.float64)))),
+            })
+
+        for config in CONFIGS:
+            manifest_path = ours_raw / "ours_manifest_{}.json".format(config)
+            if not manifest_path.is_file():
+                continue
+            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+            entry = manifest["prompts"][prompt]
+            with np.load(entry["prefill_npz"], allow_pickle=False) as data:
+                ours_prefill = {key: np.asarray(data[key]) for key in data.files}
+            ours_decode = {}
+            for past, path in sorted(entry["decode_npz"].items(), key=lambda kv: int(kv[0])):
+                with np.load(path, allow_pickle=False) as data:
+                    ours_decode[int(past)] = {key: np.asarray(data[key]) for key in data.files}
+            decode_pasts = sorted(ours_decode)
+
+            config_out = {"steps": []}
+            for j in range(min(args.steps, len(decode_pasts))):
+                token = int(chain[j])
+                tag_in = "after_prefill" if j == 0 else "step_{}".format(j - 1)
+                ours_snap = {
+                    layer: ours_snapshot(ours_prefill if j == 0 else ours_decode[decode_pasts[j - 1]], layer)
+                    for layer in range(layer_count)
+                }
+                gold_snap = {
+                    layer: gold_snapshot(gold_states, tag_in, layer)
+                    for layer in range(layer_count)
+                }
+                # A_j: gold states
+                cache = make_cache(model)
+                inject(cache, gold_snap, param_dtype)
+                baseline = measure(model, cache, token)
+                baseline_vs_seq = compare(baseline, logits_seq[j + 1])
+                baseline_vs_seq["bitwise_equal"] = bool(np.array_equal(
+                    baseline, logits_seq[j + 1]))
+                # B_j: ours states
+                cache = make_cache(model)
+                inject(cache, ours_snap, param_dtype)
+                ours_swap = measure(model, cache, token)
+                # C_j: ours dump logits（j 步的 dump = 消耗 token j 之后）
+                ours_dump = np.asarray(
+                    ours_decode[decode_pasts[j]]["logits"], dtype=np.float32).reshape(-1)
+                step_entry = {
+                    "step_index": j,
+                    "token": token,
+                    "state_input_tag": tag_in,
+                    "baseline_vs_sequential": baseline_vs_seq,
+                    "total_gap_C_vs_A": compare(ours_dump, baseline),
+                    "state_reflow_gap_B_vs_A": compare(ours_swap, baseline),
+                    "compute_gap_C_vs_B": compare(ours_dump, ours_swap),
+                    "per_layer_fix": [],
+                }
+                reflow_rel = step_entry["state_reflow_gap_B_vs_A"]["rel_l2"]
+                for layer in range(layer_count):
+                    fixed_snap = dict(ours_snap)
+                    fixed_snap[layer] = gold_snap[layer]
+                    cache = make_cache(model)
+                    inject(cache, fixed_snap, param_dtype)
+                    fixed = measure(model, cache, token)
+                    metric = compare(fixed, baseline)
+                    gain = None
+                    if reflow_rel is not None and metric["rel_l2"] is not None:
+                        gain = reflow_rel - metric["rel_l2"]
+                    step_entry["per_layer_fix"].append({
+                        "layer": layer,
+                        "vs_A": metric,
+                        "fix_gain": gain,
+                    })
+                step_entry["per_layer_fix_ranking"] = sorted(
+                    [{"layer": item["layer"], "fix_gain": item["fix_gain"],
+                      "rel_l2_after_fix": item["vs_A"]["rel_l2"],
+                      "cosine_after_fix": item["vs_A"]["cosine"]}
+                     for item in step_entry["per_layer_fix"]],
+                    key=lambda x: (x["fix_gain"] is None, -(x["fix_gain"] or 0.0)))[:8]
+                config_out["steps"].append(step_entry)
+                print("[swap]   {} step{} token={} total_rel={:.5f} reflow_rel={:.5f} "
+                      "compute_rel={:.5f} top_fix={}".format(
+                          config, j, token,
+                          step_entry["total_gap_C_vs_A"]["rel_l2"] or -1,
+                          step_entry["state_reflow_gap_B_vs_A"]["rel_l2"] or -1,
+                          step_entry["compute_gap_C_vs_B"]["rel_l2"] or -1,
+                          step_entry["per_layer_fix_ranking"][:3]), flush=True)
+            prompt_out["configs"][config] = config_out
+        result["prompts"][prompt] = prompt_out
+
+    out_path = Path(args.out)
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    out_path.write_text(json.dumps(result, indent=1), encoding="utf-8")
+    print("[swap] wrote {}".format(out_path), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
