@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# C7 诊断：以 300s 节奏重试获取 local 锁，锁内 dump gold states。
+# 背景运行：nohup tools/diag_c7/wait_and_run_gold_states.sh <evidence-dir> &
+set -uo pipefail
+
+EV=${1:?evidence dir required}
+WT=${2:-/home/chiro/projects/pypto/worktrees/pypto-x/c7-decode-gap-localization}
+RUNNER=/home/chiro/projects/pypto/pypto_x/scripts/resource/run_local_heavy.sh
+mkdir -p "${EV}/logs"
+OUT="${EV}/logs/heavy_gold_states.out"
+echo "[c7-waiter] start $(date -u +%Y-%m-%dT%H:%M:%SZ) pid=$$" | tee -a "${OUT}"
+
+for attempt in $(seq 1 40); do
+  echo "[c7-waiter] attempt ${attempt} $(date -u +%Y-%m-%dT%H:%M:%SZ)" | tee -a "${OUT}"
+  "${RUNNER}" \
+    --task c7-gold-states --agent c7-decode-gap-localization \
+    --min-available-mib 8192 --safety-floor-mib 4096 --max-cpus 6 \
+    --log-file "${EV}/logs/heavy_gold_states_resource.log" \
+    -- bash "${WT}/tools/diag_c7/run_c7_heavy.sh" "${EV}" "${WT}" \
+    >> "${OUT}" 2>&1
+  rc=$?
+  echo "[c7-waiter] attempt ${attempt} rc=${rc} $(date -u +%Y-%m-%dT%H:%M:%SZ)" | tee -a "${OUT}"
+  if [[ ${rc} -eq 0 ]]; then
+    echo "[c7-waiter] SUCCESS" | tee -a "${OUT}"
+    exit 0
+  fi
+  if [[ ${rc} -ne 75 && ${rc} -ne 69 ]]; then
+    echo "[c7-waiter] non-retryable rc=${rc}" | tee -a "${OUT}"
+    exit ${rc}
+  fi
+  sleep 300
+done
+echo "[c7-waiter] gave up after attempts" | tee -a "${OUT}"
+exit 1
