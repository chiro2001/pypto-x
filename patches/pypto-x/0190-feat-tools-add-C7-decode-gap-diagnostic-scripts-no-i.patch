new file mode 100644
index 000000000..d904aea48
--- /dev/null
+++ b/tools/diag_c7/dump_gold_states.py
@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+"""C7 诊断：用官方 HF 参照实现 dump decode 各步的 state（conv / GDR recurrent / KV cache）。
+
+背景：gold 产物 c8-w8a8-reference-gold/reference/w8a8/*.npz 只含 logits 与 hidden，
+不含 decode state，无法直接回答"缺口是否来自 state 回灌"。本脚本在官方
+run_reference.py 的同一条推理路径（同 seed / 同 threads / 同 eager attn /
+同 w8a8 fake-quant）上，逐步抄写 HF Cache 里的 state 张量：
+
+  after_prefill / step_0..step_{N-1}（消耗 token 之后）：
+    * 线性注意力层: cache.layers[i].conv_states[0]        -> ours layer_XX_causal_conv_new_state
+                    cache.layers[i].recurrent_states[0]   -> ours layer_XX_recurrent_step_0_new_state
+    * 全注意力层:   cache.layers[i].keys / .values        -> ours layer_XX_new_k / layer_XX_new_v
+
+同时把 prefill_logits / decode_logits 一并落盘，用于逐位校验"本 dump 与既有
+gold npz 是同一次运行"，校验结果写进 manifest JSON。
+
+只读资产目录（local_files_only=True），不联网、不下载权重；不改判据。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+import platform
+import random
+import sys
+import time
+
+import numpy as np
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def layer_snapshots(model, past, tag, out, dtypes):
+    """把 HF cache 中各层 state 以 float32 numpy copy 写入 out[<tag>__...]。
+
+    注意：torch bf16 张量不能直接 .numpy()，这里统一升级到 float32 保存，
+    原始 dtype 记入 dtypes（bf16 可被 float32 精确表示，无额外精度损失）。
+    """
+    import torch
+    layers = model.model.language_model.layers
+    shapes = {}
+    for index, layer in enumerate(layers):
+        cache_layer = past.layers[index]
+        conv_states = getattr(cache_layer, "conv_states", None)
+        recurrent_states = getattr(cache_layer, "recurrent_states", None)
+        if conv_states is not None:
+            conv = conv_states.get(0)
+            if conv is not None:
+                key = "{}__layer_{:02d}__conv_state".format(tag, index)
+                dtypes[key] = str(conv.dtype)
+                out[key] = conv.detach().to(torch.float32).cpu().numpy().copy()
+                shapes[key] = list(out[key].shape)
+        if recurrent_states is not None:
+            recurrent = recurrent_states.get(0)
+            if recurrent is not None:
+                key = "{}__layer_{:02d}__recurrent_state".format(tag, index)
+                dtypes[key] = str(recurrent.dtype)
+                out[key] = recurrent.detach().to(torch.float32).cpu().numpy().copy()
+                shapes[key] = list(out[key].shape)
+        keys = getattr(cache_layer, "keys", None)
+        values = getattr(cache_layer, "values", None)
+        if keys is not None and hasattr(keys, "numel") and keys.numel():
+            key = "{}__layer_{:02d}__key_cache".format(tag, index)
+            dtypes[key] = str(keys.dtype)
+            out[key] = keys.detach().to(torch.float32).cpu().numpy().copy()
+            shapes[key] = list(out[key].shape)
+        if values is not None and hasattr(values, "numel") and values.numel():
+            key = "{}__layer_{:02d}__value_cache".format(tag, index)
+            dtypes[key] = str(values.dtype)
+            out[key] = values.detach().to(torch.float32).cpu().numpy().copy()
+            shapes[key] = list(out[key].shape)
+    return shapes
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--harness", required=True, help="path to tools/qwen35_reference/run_reference.py")
+    parser.add_argument("--assets-dir", required=True)
+    parser.add_argument("--variant", default="w8a8", help="w8a8 | w8a8_f32ref | float32")
+    parser.add_argument("--out-dir", required=True)
+    parser.add_argument("--max-new-tokens", type=int, default=4)
+    parser.add_argument("--threads", type=int, default=6)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--prompts", default="en_continuation,zh_continuation,chat_zh_user")
+    parser.add_argument("--gold-dir", default="", help="optional: validate decode_logits against gold npz")
+    parser.add_argument("--dry-run", action="store_true")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    out_dir = os.path.abspath(args.out_dir)
+    os.makedirs(out_dir, exist_ok=True)
+
+    harness = load_module("c7_run_reference", os.path.abspath(args.harness))
+    import w8a8_reference  # noqa: F401  (harness 同目录; sys.path 已由 harness 注入)
+
+    torch = harness.torch
+    torch.set_num_threads(args.threads)
+    random.seed(args.seed)
+    np.random.seed(args.seed)
+    torch.manual_seed(args.seed)
+
+    import transformers
+    from transformers import AutoTokenizer
+
+    tokenizer = AutoTokenizer.from_pretrained(args.assets_dir, local_files_only=True)
+    only_ids = [item.strip() for item in args.prompts.split(",") if item.strip()]
+    prompts = harness.encode_prompts(tokenizer, only_ids)
+    print("[dump] prompts: {}".format([(item["id"], item["seq_len"]) for item in prompts]), flush=True)
+    if args.dry_run:
+        print("[dump] dry-run: tokenizer + harness import OK; model NOT loaded")
+        return 0
+
+    variant = harness.W8A8_VARIANTS.get(args.variant)
+    base_dtype = variant["base_dtype"] if variant else harness.dtype_from_name(args.variant)
+    print("[dump] loading base_dtype={} variant={}".format(base_dtype, args.variant), flush=True)
+    start = time.time()
+    model = harness.load_model(args.assets_dir, base_dtype, "eager")
+    audit = None
+    if variant is not None:
+        audit = w8a8_reference.apply_fake_quant(model, args.variant)
+    print("[dump] loaded in %.1fs peak_rss=%.1fMiB" % (time.time() - start, harness.peak_rss_mib()), flush=True)
+
+    manifest = {
+        "tool": "dump_gold_states",
+        "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "variant": args.variant,
+        "assets_dir": args.assets_dir,
+        "harness": os.path.abspath(args.harness),
+        "harness_sha256": sha256_file(os.path.abspath(args.harness)),
+        "threads": args.threads,
+        "seed": args.seed,
+        "max_new_tokens": args.max_new_tokens,
+        "python": sys.version,
+        "platform": platform.platform(),
+        "versions": {"torch": torch.__version__, "transformers": transformers.__version__},
+        "fake_quant_audit": (audit or {}).get("scope"),
+        "runs": [],
+    }
+    for item in prompts:
+        print("[dump] prompt={}".format(item["id"]), flush=True)
+        tensor_ids = torch.tensor([item["forward_ids"]], dtype=torch.long)
+        out = {}
+        dtypes = {}
+        with torch.no_grad():
+            outputs = model(input_ids=tensor_ids, use_cache=True, return_dict=True)
+            past = outputs.past_key_values
+            out["prefill_logits"] = outputs.logits[0].detach().to(torch.float32).cpu().numpy().copy()
+            shapes = layer_snapshots(model, past, "after_prefill", out, dtypes)
+            running_logits = outputs.logits
+            step_ids = []
+            step_logits = []
+            for step in range(args.max_new_tokens):
+                last_logits = running_logits[0, -1].to(torch.float32)
+                next_id = int(torch.argmax(last_logits).item())
+                step_logits.append(last_logits.cpu().numpy().copy())
+                step_ids.append(next_id)
+                step_out = model(
+                    input_ids=torch.tensor([[next_id]], dtype=torch.long),
+                    past_key_values=past,
+                    use_cache=True,
+                    return_dict=True,
+                )
+                past = step_out.past_key_values
+                running_logits = step_out.logits
+                snap = layer_snapshots(model, past, "step_{}".format(step), out, dtypes)
+                shapes.update(snap)
+        out["decode_logits"] = np.stack(step_logits, axis=0)
+        out["decode_token_ids"] = np.asarray(step_ids, dtype=np.int64)
+        out["input_ids"] = np.asarray(item["forward_ids"], dtype=np.int64)
+        npz_path = os.path.join(out_dir, "{}.npz".format(item["id"]))
+        np.savez(npz_path, **out)
+
+        entry = {
+            "prompt": item["id"],
+            "npz": npz_path,
+            "npz_sha256": sha256_file(npz_path),
+            "npz_bytes": os.path.getsize(npz_path),
+            "keys": sorted(out.keys()),
+            "state_shapes": {k: v for k, v in sorted(shapes.items())},
+            "state_dtypes": {k: v for k, v in sorted(dtypes.items())},
+            "decode_token_ids": [int(v) for v in step_ids],
+        }
+        if args.gold_dir:
+            gold_path = os.path.join(args.gold_dir, "w8a8", "{}.npz".format(item["id"]))
+            if os.path.isfile(gold_path):
+                with np.load(gold_path, allow_pickle=False) as gold:
+                    entry["validation_vs_gold"] = {
+                        "gold_npz": gold_path,
+                        "gold_npz_sha256": sha256_file(gold_path),
+                        "decode_logits_bitwise_equal": bool(
+                            np.array_equal(out["decode_logits"], np.asarray(gold["decode_logits"]))),
+                        "decode_logits_max_abs_diff": float(np.max(np.abs(
+                            out["decode_logits"].astype(np.float64)
+                            - np.asarray(gold["decode_logits"], dtype=np.float64)))),
+                        "decode_token_ids_equal": bool(
+                            np.array_equal(out["decode_token_ids"], np.asarray(gold["decode_token_ids"]))),
+                        "prefill_logits_bitwise_equal": bool(
+                            np.array_equal(out["prefill_logits"], np.asarray(gold["prefill_logits"]))),
+                    }
+        print("[dump]   {} keys={} decode_tokens={} {}".format(
+            item["id"], len(out), step_ids,
+            json.dumps(entry.get("validation_vs_gold", {}))), flush=True)
+        manifest["runs"].append(entry)
+
+    manifest_path = os.path.join(out_dir, "gold_states_manifest.json")
+    with open(manifest_path, "w", encoding="utf-8") as handle:
+        json.dump(manifest, handle, ensure_ascii=False, indent=2)
+    print("[dump] wrote {} + {}".format(out_dir, manifest_path), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
