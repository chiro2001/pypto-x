+#!/usr/bin/env python3
+"""C7 诊断：把 decode_gap_analysis.json 渲染成 markdown 表格（raw/tables.md）。"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+
+
+def fmt(value, digits=6):
+    if value is None:
+        return "-"
+    return "{:.{d}f}".format(value, d=digits)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--analysis", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    data = json.loads(Path(args.analysis).read_text(encoding="utf-8"))
+    lines = []
+    lines.append("# C7 decode 缺口：分析表格（由 decode_gap_analysis.json 生成）\n")
+    lines.append("band 来源：`{}` sha256 `{}`\n".format(
+        data["band_source"]["path"], data["band_source"]["sha256"]))
+    lines.append("## 1. 逐步曲线：row0=prefill_next（=gold decode_logits[0]），row1..3=3 个 decode step\n")
+    lines.append("| config | prompt | row | 口径 | ours cos | ours max_abs | 参照自身 cos | 参照自身 max_abs | 误差范数比 ours/参照 | ours-vs-fp32 cos |")
+    lines.append("|---|---|---|---|---|---|---|---|---|---|")
+    for config in ("default", "full"):
+        for prompt in PROMPTS:
+            for row in data["configs"][config]["prompts"][prompt]["rows"]:
+                if "ours" not in row:
+                    continue
+                kind = "prefill_next" if row["row"] == 0 else "decode_step_{}".format(row["row"] - 1)
+                lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
+                    config, prompt, row["row"], kind,
+                    fmt(row["ours"]["cosine"], 8), fmt(row["ours"]["max_abs"], 4),
+                    fmt(row["gold_vs_fp32"]["cosine"], 8), fmt(row["gold_vs_fp32"]["max_abs"], 4),
+                    fmt(row["ours"]["delta_norm"] / row["gold_vs_fp32"]["delta_norm"], 3)
+                    if row["gold_vs_fp32"]["delta_norm"] else "-",
+                    fmt(row["ours_vs_fp32"]["cosine"], 8)))
+
+    lines.append("\n## 2. prefill block 对照（同一批 prompt token）\n")
+    lines.append("| config | prompt | rows | ours cos | ours max_abs | 参照自身 cos | 参照自身 max_abs | 误差范数比 |")
+    lines.append("|---|---|---|---|---|---|---|---|")
+    for config in ("default", "full"):
+        for prompt in PROMPTS:
+            block = data["configs"][config]["prompts"][prompt]["prefill_block"]
+            ours = block["ours_vs_gold"]
+            ref = block["gold_vs_fp32_reference_self"]
+            lines.append("| {} | {} | {} | {} | {} | {} | {} | {} |".format(
+                config, prompt, block["rows"], fmt(ours["cosine"], 8), fmt(ours["max_abs"], 4),
+                fmt(ref["cosine"], 8), fmt(ref["max_abs"], 4),
+                fmt(ours["delta_norm"] / ref["delta_norm"], 3) if ref["delta_norm"] else "-"))
+
+    lines.append("\n## 3. rows0..3 block：误差能量份额与 cosine 门限预算\n")
+    lines.append("| config | prompt | ours cos | 声明 floor | margin | 参照自 cos | 范数比 | cosine 允许的范数比 | 超预算 | max_abs 允许比 | row3 能量份额(ours) |")
+    lines.append("|---|---|---|---|---|---|---|---|---|---|---|")
+    for config in ("default", "full"):
+        for prompt in PROMPTS:
+            block = data["configs"][config]["prompts"][prompt]["blocks"]["rows_0_3"]
+            ours = block["ours_vs_gold"]
+            ref = block["gold_vs_fp32_reference_self"]
+            band = block["declared_key_band"]
+            budget = block["cosine_gate_budget"]
+            energy = block["per_row_error_energy"]
+            lines.append("| {} | {} | {} | {} | {:+0.6f} | {} | {} | {} | {} | {} | {} |".format(
+                config, prompt, fmt(ours["cosine"], 8), fmt(band["cosine_floor"], 8),
+                band["ours_cosine_margin_vs_floor"], fmt(ref["cosine"], 8),
+                fmt(budget["measured_norm_ratio"], 3), fmt(budget["allowed_norm_ratio_cosine"], 5),
+                fmt(budget["ratio_over_budget"], 3), fmt(budget["max_abs_headroom_ratio"], 3),
+                fmt(energy[3]["ours_energy_share"], 3)))
+
+    lines.append("\n## 4. 分布（12 个 decode 行：3 prompt x 4 row）\n")
+    lines.append("| config | 指标 | min | p25 | median | p75 | max |")
+    lines.append("|---|---|---|---|---|---|---|")
+    for config in ("default", "full"):
+        dist = data["distributions"][config]
+        for key, label in (("ours_cos", "ours v gold cos"),
+                           ("ref_self_cos", "参照自身 cos (gold v fp32)"),
+                           ("ours_cos_minus_ref_self_cos", "ours cos - 参照自身 cos"),
+                           ("ours_over_ref_norm", "误差范数比 ours/参照")):
+            item = dist[key]
+            lines.append("| {} | {} | {} | {} | {} | {} | {} |".format(
+                config, label, fmt(item["min"], 6), fmt(item["p25"], 6), fmt(item["median"], 6),
+                fmt(item["p75"], 6), fmt(item["max"], 6)))
+    lines.append("\n## 5. 逐行方向阶梯（orthogonal null = 与 gold 正交的等范数误差）\n")
+    lines.append("| config | prompt | row | floor | ours actual | null(ref 范数) | 通过 | null(ours 范数) | 通过 | 范数比 |")
+    lines.append("|---|---|---|---|---|---|---|---|---|---|")
+    for config in ("default", "full"):
+        for prompt in PROMPTS:
+            for row in data["configs"][config]["prompts"][prompt]["blocks"]["rows_0_3"]["direction_ladder"]["per_row"]:
+                lines.append("| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
+                    config, prompt, row["row"], fmt(row["floor"], 8),
+                    fmt(row["ours_actual_cosine"], 8),
+                    fmt(row["orthogonal_null_ref_norm_cosine"], 8),
+                    "Y" if row["orthogonal_null_ref_norm_passes_floor"] else "N",
+                    fmt(row["orthogonal_null_ours_norm_cosine"], 8),
+                    "Y" if row["orthogonal_null_ours_norm_passes_floor"] else "N",
+                    fmt(row["ours_over_ref_norm"], 3)))
+    output = Path(args.output)
+    output.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    print("[tables] wrote {}".format(output))
+
+
+if __name__ == "__main__":
+    main()
