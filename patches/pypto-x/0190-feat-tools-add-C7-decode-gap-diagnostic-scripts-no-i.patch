index 000000000..64daf6bc0
--- /dev/null
+++ b/tools/diag_c7/state_trajectory_ours.py
@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""C7 诊断（不依赖 gold state）：ours decode state 轨迹自洽性与变化量。
+
+检查项：
+  1. KV cache 前缀不变式：step k 的 cache[:, :, :T_k-1] 必须逐位等于 step k-1 的 cache；
+  2. conv state 滑动窗不变式：prev[:, :, 1:] 必须逐位等于 cur[:, :, :3]；
+  3. 所有 state finite、dtype/shape 稳定；
+  4. 每层/每类 state 的步间相对变化量 ||s_k - s_{k-1}|| / ||s_k||；
+  5. 与 decode logits 的 ours-vs-gold cosine 序列并排（logits 数据可选，来自
+     decode_gap_analysis.json）。
+
+输出 JSON；只读 ours 产物。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import re
+from pathlib import Path
+
+import numpy as np
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+CONFIGS = ("default", "full")
+
+
+def rel_change(a, b):
+    a = np.asarray(a, dtype=np.float64).reshape(-1)
+    b = np.asarray(b, dtype=np.float64).reshape(-1)
+    nb = math.sqrt(float(np.dot(b, b)))
+    return float(math.sqrt(float(np.dot(a - b, a - b))) / nb) if nb else None
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ours-raw", required=True)
+    parser.add_argument("--analysis-json", default="")
+    parser.add_argument("--output", required=True)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    raw = Path(args.ours_raw).resolve()
+    analysis = {}
+    if args.analysis_json:
+        analysis = json.loads(Path(args.analysis_json).read_text(encoding="utf-8"))
+    out = {"tool": "state_trajectory_ours", "ours_raw": str(raw), "configs": {}}
+
+    for config in CONFIGS:
+        manifest_path = raw / "ours_manifest_{}.json".format(config)
+        if not manifest_path.is_file():
+            continue
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        cfg_out = {"prompts": {}}
+        for prompt in PROMPTS:
+            entry = manifest["prompts"][prompt]
+            prefill = dict(np.load(entry["prefill_npz"], allow_pickle=False))
+            pasts = sorted(entry["decode_npz"], key=int)
+            steps = [dict(np.load(entry["decode_npz"][p], allow_pickle=False)) for p in pasts]
+            prompt_out = {"violations": [], "state_change": [], "logits_series": None}
+
+            # 1) KV prefix invariant + 2) conv sliding window
+            for step_index in range(1, len(steps)):
+                prev = steps[step_index - 1]
+                cur = steps[step_index]
+                for key in prev:
+                    if not key.endswith("_new_k") and not key.endswith("_causal_conv_new_state"):
+                        continue
+                    if key not in cur:
+                        prompt_out["violations"].append({"kind": "missing_key", "key": key, "step": step_index})
+                        continue
+                    a = prev[key].astype(np.float64)
+                    b = cur[key].astype(np.float64)
+                    if key.endswith("_new_k"):
+                        if a.shape[2] + 1 != b.shape[2]:
+                            prompt_out["violations"].append({
+                                "kind": "kv_shape", "key": key, "step": step_index,
+                                "prev": list(a.shape), "cur": list(b.shape)})
+                            continue
+                        diff = float(np.max(np.abs(a - b[:, :, :a.shape[2], :])))
+                        if diff != 0.0:
+                            prompt_out["violations"].append({
+                                "kind": "kv_prefix_mismatch", "key": key, "step": step_index,
+                                "max_abs_diff": diff})
+                    else:
+                        diff = float(np.max(np.abs(a[:, :, 1:] - b[:, :, :a.shape[2] - 1])))
+                        if diff != 0.0:
+                            prompt_out["violations"].append({
+                                "kind": "conv_shift_mismatch", "key": key, "step": step_index,
+                                "max_abs_diff": diff})
+
+            # 4) per-state step-to-step relative change (from prefill state to last step)
+            def normalized(entry):
+                out = {}
+                for key, value in entry.items():
+                    match = re.match(r"^(layer_\d+)_recurrent_step_\d+_new_state$", key)
+                    out[match.group(1) + "_recurrent_state" if match else key] = value
+                return out
+            sequence = [normalized(item) for item in [prefill] + steps]
+            for key in sorted(sequence[0]):
+                if key not in sequence[-1]:
+                    continue
+                if key in ("logits", "final_hidden", "position_ids"):
+                    continue
+                values = []
+                finite = True
+                for index in range(1, len(sequence)):
+                    a = sequence[index - 1][key]
+                    b = sequence[index][key]
+                    if a.shape != b.shape:
+                        # KV cache grows: compare the overlapping prefix
+                        n = min(a.shape[2], b.shape[2]) if a.ndim == 4 and b.ndim == 4 else 0
+                        if n == 0:
+                            values.append(None)
+                            continue
+                        change = rel_change(b[:, :, :n, :], a[:, :, :n, :])
+                    else:
+                        change = rel_change(b, a)
+                    values.append(change)
+                    if not (np.all(np.isfinite(a)) and np.all(np.isfinite(b))):
+                        finite = False
+                prompt_out["state_change"].append({
+                    "key": key, "rel_change_per_step": values, "finite": finite,
+                    "absmax_last": float(np.max(np.abs(sequence[-1][key]))),
+                })
+
+            # 5) logits series joined from analysis json
+            if analysis:
+                rows = analysis.get("configs", {}).get(config, {}).get("prompts", {}).get(prompt, {}).get("rows", [])
+                prompt_out["logits_series"] = [
+                    {"row": row["row"], "kind": row["kind"],
+                     "ours_cos": (row.get("ours") or {}).get("cosine"),
+                     "ours_max_abs": (row.get("ours") or {}).get("max_abs"),
+                     "ref_self_cos": (row.get("gold_vs_fp32") or {}).get("cosine")}
+                    for row in rows if "ours" in row]
+            cfg_out["prompts"][prompt] = prompt_out
+        out["configs"][config] = cfg_out
+
+    out_path = Path(args.output)
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    out_path.write_text(json.dumps(out, indent=1), encoding="utf-8")
+    violations = sum(len(item["violations"])
+                     for cfg in out["configs"].values()
+                     for item in cfg["prompts"].values())
+    print("[state_trajectory_ours] wrote {} violations={}".format(out_path, violations))
+    for config, cfg in out["configs"].items():
+        for prompt, item in cfg["prompts"].items():
+            rec = [x for x in item["state_change"] if "recurrent" in x["key"]]
+            conv = [x for x in item["state_change"] if "conv" in x["key"]]
+            def last(values):
+                return None if not values else values[-1]
+            print("[{}] {} violations={} rec_last_rel_change_med={} conv_last={} logits={}".format(
+                config, prompt, len(item["violations"]),
+                None if not rec else float(np.median([last(x["rel_change_per_step"]) or 0 for x in rec])),
+                None if not conv else float(np.median([last(x["rel_change_per_step"]) or 0 for x in conv])),
+                None if not item["logits_series"] else [
+                    None if x["ours_cos"] is None else round(x["ours_cos"], 6)
+                    for x in item["logits_series"]]))
+
+
+if __name__ == "__main__":
+    main()
