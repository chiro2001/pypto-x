+#!/usr/bin/env python3
+"""C7 诊断：decode 缺口的逐步曲线 + 参照自洽性量化（只读 Q3 产物，不重跑模型）。
+
+输入（全部只读）：
+  * gold:  <gold-dir>/band.json, <gold-dir>/w8a8/*.npz, <gold-dir>/float32/*.npz
+  * ours:  <evidence-raw>/ours_manifest_<config>.json 指向的 prefill/decode npz
+           （位于 <evidence-raw>/dumps/<config>/）
+  * Q3 判定: <evidence-raw>/judgment_<config>.json（对照用，不重算判据）
+  * Q3 逐层: <evidence-raw>/hidden_layers_default_en.json（prefill 量级对照）
+
+输出：一个 JSON，包含
+  1) per_row:  每个 prompt/config 的 row0..3 的 ours-vs-gold / gold-vs-fp32 / ours-vs-fp32
+                cosine、max_abs、误差范数、误差方向夹角；
+  2) blocks:   rows0..3（band.json declared key 的行集合）与 rows1..3 的块级三角关系；
+  3) distributions: 12 行（3 prompt x 4 row）的 ours cos 与参照自身 cos 的分位数；
+  4) strictness: 蒙特卡洛零假设：与参照同范数、但误差方向与参照不相关的实现，
+                在 declared-key 块判据下的通过率；
+  5) prefill_ref: 从 Q3 judgment/hidden_layers 直接摘出的 prefill 量级（仅供对比）。
+
+本脚本只依赖 numpy + 标准库；不改判据、不写 band、不执行任何模型代码。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+CONFIGS = ("default", "full")
+COSINE_SLACK = 1e-4
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def load_npz(path: Path) -> dict:
+    with np.load(str(path), allow_pickle=False) as data:
+        return {name: np.asarray(data[name]) for name in data.files}
+
+
+def rows_of(array: np.ndarray) -> np.ndarray:
+    array = np.asarray(array, dtype=np.float64)
+    if array.ndim == 1:
+        return array.reshape(1, -1)
+    return array.reshape(-1, array.shape[-1])
+
+
+def cosine(a: np.ndarray, b: np.ndarray) -> float:
+    a = np.asarray(a, dtype=np.float64).reshape(-1)
+    b = np.asarray(b, dtype=np.float64).reshape(-1)
+    na = math.sqrt(float(np.dot(a, a)))
+    nb = math.sqrt(float(np.dot(b, b)))
+    if na == 0.0 or nb == 0.0:
+        return float("nan")
+    return float(np.dot(a, b) / (na * nb))
+
+
+def vec_stats(actual: np.ndarray, expected: np.ndarray) -> dict:
+    a = np.asarray(actual, dtype=np.float64).reshape(-1)
+    b = np.asarray(expected, dtype=np.float64).reshape(-1)
+    delta = a - b
+    return {
+        "cosine": cosine(a, b),
+        "max_abs": float(np.max(np.abs(delta))) if delta.size else 0.0,
+        "mean_abs": float(np.mean(np.abs(delta))) if delta.size else 0.0,
+        "rms_abs": float(math.sqrt(float(np.mean(delta * delta)))) if delta.size else 0.0,
+        "ours_norm": float(math.sqrt(float(np.dot(a, a)))),
+        "gold_norm": float(math.sqrt(float(np.dot(b, b)))),
+        "delta_norm": float(math.sqrt(float(np.dot(delta, delta)))),
+        "finite_ours": bool(np.all(np.isfinite(a))),
+        "finite_gold": bool(np.all(np.isfinite(b))),
+    }
+
+
+def top2(row: np.ndarray) -> tuple:
+    row = np.asarray(row, dtype=np.float64)
+    top1 = int(np.argmax(row))
+    masked = np.where(np.arange(row.size) == top1, -np.inf, row)
+    top2_token = int(np.argmax(masked))
+    return top1, float(row[top1]), top2_token, float(masked[top2_token])
+
+
+def percentile(values, q):
+    values = [v for v in values if v == v]  # drop NaN
+    if not values:
+        return None
+    return float(np.percentile(np.asarray(values, dtype=np.float64), q))
+
+
+def summarize_values(values) -> dict:
+    values = [float(v) for v in values if v == v]
+    if not values:
+        return {"count": 0}
+    array = np.asarray(values, dtype=np.float64)
+    return {
+        "count": len(values),
+        "min": float(array.min()),
+        "p10": percentile(values, 10),
+        "p25": percentile(values, 25),
+        "median": float(np.median(array)),
+        "p75": percentile(values, 75),
+        "p90": percentile(values, 90),
+        "max": float(array.max()),
+        "mean": float(array.mean()),
+        "std": float(array.std(ddof=0)),
+    }
+
+
+def block_metrics(ours_rows, gold_rows, ref_rows) -> dict:
+    ours = np.vstack(ours_rows)
+    gold = np.vstack(gold_rows)
+    ref = np.vstack(ref_rows)
+    out = {
+        "rows": int(ours.shape[0]),
+        "ours_vs_gold": vec_stats(ours, gold),
+        "gold_vs_fp32_reference_self": vec_stats(ref, gold),
+        "ours_vs_fp32": vec_stats(ours, ref),
+    }
+    out["delta_norm_ratio_ours_over_ref"] = (
+        out["ours_vs_gold"]["delta_norm"] / out["gold_vs_fp32_reference_self"]["delta_norm"]
+        if out["gold_vs_fp32_reference_self"]["delta_norm"] else None
+    )
+    # 逐行误差能量占比（精确分解：block ||Δ||² 的行份额；对 near-orthogonal 行集
+    # 与 block cosine 亏损的份额近似成正比，数值稳定）
+    ours_f = ours.reshape(-1)
+    gold_f = gold.reshape(-1)
+    ref_f = ref.reshape(-1)
+    total_ours_energy = float(np.dot(ours_f - gold_f, ours_f - gold_f))
+    total_ref_energy = float(np.dot(ref_f - gold_f, ref_f - gold_f))
+    per_row = []
+    for i in range(ours.shape[0]):
+        ours_energy = float(np.dot(ours[i] - gold[i], ours[i] - gold[i]))
+        ref_energy = float(np.dot(ref[i] - gold[i], ref[i] - gold[i]))
+        per_row.append({
+            "row": i,
+            "ours_error_energy": ours_energy,
+            "ref_error_energy": ref_energy,
+            "ours_energy_share": (ours_energy / total_ours_energy) if total_ours_energy else None,
+            "ref_energy_share": (ref_energy / total_ref_energy) if total_ref_energy else None,
+            "ours_row_norm_ratio": (math.sqrt(ours_energy) / math.sqrt(ref_energy)) if ref_energy else None,
+        })
+    out["per_row_error_energy"] = per_row
+    out["rows_1_3_error_energy_share_ours"] = (
+        sum(item["ours_error_energy"] for item in per_row[1:]) / total_ours_energy
+        if total_ours_energy else None)
+    out["row0_error_energy_share_ours"] = (
+        per_row[0]["ours_error_energy"] / total_ours_energy if total_ours_energy else None)
+    # 误差方向相关性：δ=ours-gold 与 e=gold-fp32 的 cosine（rows 拼接后）
+    delta = ours_f - gold_f
+    err = ref_f - gold_f
+    out["delta_vs_ref_error_cosine"] = cosine(delta, err)
+    out["delta_vs_ref_error_norm_ratio"] = (
+        math.sqrt(float(np.dot(delta, delta))) / math.sqrt(float(np.dot(err, err)))
+        if float(np.dot(err, err)) else None
+    )
+    return out
+
+
+def direction_ladder(gold_rows, ref_rows, delta_rows, floor):
+    """解析式的"方向阶梯"（替代蒙特卡洛，避免 248k 维采样）：
+
+    固定误差范数 n，问不同误差方向下的 cos(ours, gold)：
+      * 下界（误差与 gold 正交，= 高维独立噪声的典型情形）: ||g||/sqrt(||g||²+n²)
+      * 上界: 1（误差与 gold 同向）
+      * 参考误差方向: ours = gold + e = 2*gold - fp32 的真实 cosine
+      * 实测 ours
+    对 ours / 参照 两种范数各算一遍，即可区分"范数超了"与"方向不相关"。
+    """
+    gold_rows = np.vstack(gold_rows)
+    ref_rows = np.vstack(ref_rows)
+    delta_rows = np.vstack(delta_rows)
+
+    def ladder_one(gold, ref, delta):
+        e = ref - gold
+        gn = float(np.linalg.norm(gold))
+        n_ref = float(np.linalg.norm(e))
+        n_ours = float(np.linalg.norm(delta))
+        return {
+            "gold_norm": gn,
+            "ref_error_norm": n_ref,
+            "ours_error_norm": n_ours,
+            "ours_over_ref_norm": (n_ours / n_ref) if n_ref else None,
+            "ref_actual_cosine": cosine(ref, gold),
+            "ours_actual_cosine": cosine(gold + delta, gold),
+            "orthogonal_null_ref_norm_cosine": gn / math.sqrt(gn * gn + n_ref * n_ref) if gn else None,
+            "orthogonal_null_ours_norm_cosine": gn / math.sqrt(gn * gn + n_ours * n_ours) if gn else None,
+            "ref_direction_ref_norm_cosine": cosine(gold + e / max(n_ref, 1e-30) * n_ref, gold) if n_ref else None,
+            "ref_direction_ours_norm_cosine": (
+                cosine(gold + e / max(n_ref, 1e-30) * n_ours, gold) if n_ref else None),
+            "floor": floor,
+        }
+
+    per_row = []
+    for i in range(gold_rows.shape[0]):
+        row = ladder_one(gold_rows[i], ref_rows[i], delta_rows[i])
+        row["row"] = i
+        row["orthogonal_null_ref_norm_passes_floor"] = bool(
+            row["orthogonal_null_ref_norm_cosine"] >= floor - 1e-12)
+        row["orthogonal_null_ours_norm_passes_floor"] = bool(
+            row["orthogonal_null_ours_norm_cosine"] >= floor - 1e-12)
+        row["ours_actual_passes_floor"] = bool(row["ours_actual_cosine"] >= floor - 1e-12)
+        per_row.append(row)
+    block = ladder_one(gold_rows.reshape(-1), ref_rows.reshape(-1), delta_rows.reshape(-1))
+    block["passes_floor_orthogonal_null_ref_norm"] = bool(
+        block["orthogonal_null_ref_norm_cosine"] >= floor - 1e-12)
+    block["passes_floor_orthogonal_null_ours_norm"] = bool(
+        block["orthogonal_null_ours_norm_cosine"] >= floor - 1e-12)
+    block["ours_actual_passes_floor"] = bool(block["ours_actual_cosine"] >= floor - 1e-12)
+    return {
+        "definition": ("固定误差范数、扫描误差方向的解析界：orthogonal-null = 误差与 gold 正交"
+                       "（高维独立噪声的典型 cosine）；ref-direction = 误差方向与参照自身误差一致；"
+                       "ours-actual = 实测。floor 为对应口径的 cosine 下限（band_cosine - 1e-4）。"),
+        "per_row": per_row,
+        "block": block,
+    }
+
+
+def cosine_gate_norm_budget(band_cosine, floor, ref_error_norm, ours_error_norm):
+    """cosine 门限在"误差近似正交"下等价于一个误差 L2 范数预算。
+
+    cos ≈ 1/sqrt(1+r²)；r_floor = sqrt(1/floor²-1)，r_ref = sqrt(1/band_cos²-1)。
+    allowed_norm_ratio = r_floor/r_ref：门限允许的 ||ours-gold|| / ||gold-fp32|| 上限。
+    """
+    import math as _math
+    if not (0 < floor <= 1) or not (0 < band_cosine <= 1):
+        return None
+    r_floor = _math.sqrt(1.0 / (floor * floor) - 1.0)
+    r_ref = _math.sqrt(1.0 / (band_cosine * band_cosine) - 1.0)
+    return {
+        "allowed_norm_ratio_cosine": (r_floor / r_ref) if r_ref else None,
+        "measured_norm_ratio": (ours_error_norm / ref_error_norm) if ref_error_norm else None,
+        "ratio_over_budget": ((ours_error_norm / ref_error_norm) / (r_floor / r_ref)
+                              if ref_error_norm and r_ref else None),
+        "max_abs_headroom_ratio": None,  # 由调用方填（2*band_max_abs / ref_max_abs）
+    }
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--gold-dir", required=True)
+    parser.add_argument("--evidence-raw", required=True)
+    parser.add_argument("--output", required=True)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    gold_dir = Path(args.gold_dir).resolve()
+    raw = Path(args.evidence_raw).resolve()
+    band_path = gold_dir / "band.json"
+    band = json.loads(band_path.read_text(encoding="utf-8"))
+    band_sha = sha256_file(band_path)
+    result = {
+        "tool": "analyze_decode_gap",
+        "generated_at_utc": __import__("time").strftime("%Y-%m-%dT%H:%M:%SZ", __import__("time").gmtime()),
+        "gold_dir": str(gold_dir),
+        "band_source": {
+            "path": str(band_path),
+            "sha256": band_sha,
+            "definition": band.get("definition"),
+        },
+        "evidence_raw": str(raw),
+        "configs": {},
+    }
+
+    # 直接摘录 Q3 的 prefill 量级（不重算判据）
+    prefill_ref = {"judgments": {}, "hidden_layers_default_en": None}
+    for config in CONFIGS:
+        judgment_path = raw / "judgment_{}.json".format(config)
+        if not judgment_path.is_file():
+            continue
+        judgment = json.loads(judgment_path.read_text(encoding="utf-8"))
+        entry = {}
+        for prompt in PROMPTS:
+            keys = judgment.get("prompts", {}).get(prompt, {}).get("keys", {})
+            pre = keys.get("prefill_logits", {})
+            pre_next = keys.get("prefill_next_logits", {})
+            entry[prompt] = {
+                "prefill_logits": {
+                    "ours_vs_gold_cosine": pre.get("cosine"),
+                    "ours_vs_gold_max_abs": pre.get("max_abs"),
+                    "ref_self_cosine": (pre.get("reference_self_check_vs_fp32") or {}).get("cosine"),
+                    "ref_self_max_abs": (pre.get("reference_self_check_vs_fp32") or {}).get("max_abs"),
+                    "verdict": judgment.get("prompts", {}).get(prompt, {}).get("verdict_prefill_logits"),
+                },
+                "prefill_next_logits": {
+                    "ours_vs_gold_cosine": pre_next.get("cosine"),
+                    "ours_vs_gold_max_abs": pre_next.get("max_abs"),
+                    "ref_self_cosine": (pre_next.get("reference_self_check_vs_fp32") or {}).get("cosine"),
+                    "ref_self_max_abs": (pre_next.get("reference_self_check_vs_fp32") or {}).get("max_abs"),
+                },
+            }
+        prefill_ref["judgments"][config] = entry
+    hidden_path = raw / "hidden_layers_default_en.json"
+    if hidden_path.is_file():
+        hidden = json.loads(hidden_path.read_text(encoding="utf-8"))
+        prefill_ref["hidden_layers_default_en"] = {
+            "path": str(hidden_path),
+            "sha256": sha256_file(hidden_path),
+            "summary": hidden.get("summary") if isinstance(hidden, dict) else None,
+            "per_layer": (hidden.get("per_layer") or hidden.get("layers")) if isinstance(hidden, dict) else None,
+        }
+    result["prefill_ref"] = prefill_ref
+
+    all_rows = []          # 12 行集合，用于分布
+    for config in CONFIGS:
+        manifest_path = raw / "ours_manifest_{}.json".format(config)
+        if not manifest_path.is_file():
+            continue
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        config_result = {"manifest": str(manifest_path), "manifest_sha256": sha256_file(manifest_path),
+                         "prompts": {}}
+        for prompt in PROMPTS:
+            entry = manifest["prompts"][prompt]
+            gold = load_npz(gold_dir / "w8a8" / "{}.npz".format(prompt))
+            fp32 = load_npz(gold_dir / "float32" / "{}.npz".format(prompt))
+            prefill = load_npz(Path(entry["prefill_npz"]))
+            ours_prefill_logits = rows_of(prefill["logits"])
+            gold_decode = rows_of(gold["decode_logits"])
+            fp32_decode = rows_of(fp32["decode_logits"])
+            gold_chain = [int(v) for v in gold["decode_token_ids"]]
+
+            # row0 = 我们 prefill 末行 vs gold prefill_next_logits（= gold decode_logits[0]）
+            gold_row0 = np.asarray(gold["prefill_next_logits"], dtype=np.float64).reshape(1, -1)
+            row0_bitwise = bool(np.array_equal(gold_decode[0], gold_row0[0]))
+            ours_pref_next = ours_prefill_logits[-1:]
+            prefill_argmax = int(np.argmax(ours_pref_next[0]))
+            ours_chain = [prefill_argmax]
+
+            rows = [{
+                "row": 0,
+                "kind": "prefill_next / gold_decode_row0",
+                "ours_source": "{}.logits[-1]".format(Path(entry["prefill_npz"]).name),
+                "input_token": None,
+                "gold_decode_row0_equals_prefill_next_bitwise": row0_bitwise,
+                "ours": vec_stats(ours_pref_next[0], gold_row0[0]),
+                "gold_vs_fp32": vec_stats(fp32_decode[0], gold_row0[0]),
+                "ours_vs_fp32": vec_stats(ours_pref_next[0], fp32_decode[0]),
+                "ours_argmax": prefill_argmax,
+                "gold_argmax": int(np.argmax(gold_row0[0])),
+            }]
+
+            decode_pasts = sorted(int(k) for k in entry.get("decode_npz", {}))
+            for step_index, past in enumerate(decode_pasts):
+                gold_row_index = step_index + 1
+                dump = load_npz(Path(entry["decode_npz"][str(past)]))
+                ours_row = rows_of(dump["logits"])[0]
+                ours_argmax = int(np.argmax(ours_row))
+                ours_input = ours_chain[step_index]
+                gold_input = gold_chain[step_index] if step_index < len(gold_chain) else None
+                comparable = gold_input is not None and ours_input == gold_input
+                ours_chain.append(ours_argmax)
+                item = {
+                    "row": gold_row_index,
+                    "kind": "decode_step_{}".format(step_index),
+                    "past_length": past,
+                    "ours_source": Path(entry["decode_npz"][str(past)]).name,
+                    "ours_input_token": ours_input,
+                    "gold_input_token": gold_input,
+                    "input_comparable": comparable,
+                    "ours_argmax": ours_argmax,
+                }
+                if gold_row_index < gold_decode.shape[0]:
+                    item["ours"] = vec_stats(ours_row, gold_decode[gold_row_index])
+                    item["gold_vs_fp32"] = vec_stats(fp32_decode[gold_row_index], gold_decode[gold_row_index])
+                    item["ours_vs_fp32"] = vec_stats(ours_row, fp32_decode[gold_row_index])
+                    item["gold_argmax"] = int(np.argmax(gold_decode[gold_row_index]))
+                    item["gold_top2_margin"] = (
+                        top2(gold_decode[gold_row_index])[1] - top2(gold_decode[gold_row_index])[3]
+                    )
+                else:
+                    item["status"] = "not_covered_by_gold_decode_logits"
+                    item["ours_only"] = {
+                        "absmax": float(np.max(np.abs(ours_row))),
+                        "norm": float(np.linalg.norm(ours_row)),
+                    }
+                rows.append(item)
+            gold_prefill = rows_of(gold["prefill_logits"])
+            fp32_prefill = rows_of(fp32["prefill_logits"])
+            ours_prefill_rows = rows_of(prefill["logits"])
+            prefill_block = block_metrics(ours_prefill_rows, gold_prefill, fp32_prefill)
+            prefill_block["per_position"] = []
+            for position in range(ours_prefill_rows.shape[0]):
+                o = vec_stats(ours_prefill_rows[position], gold_prefill[position])
+                r = vec_stats(fp32_prefill[position], gold_prefill[position])
+                prefill_block["per_position"].append({
+                    "position": position,
+                    "ours_cosine": o["cosine"],
