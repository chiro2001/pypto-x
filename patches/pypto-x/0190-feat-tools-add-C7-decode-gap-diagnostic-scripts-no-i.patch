+#!/usr/bin/env python3
+"""C7 诊断：ours decode state vs gold(HF w8a8) decode state 逐步对比。
+
+输入：
+  * --ours-raw  <c8-l4-avx512/raw>（ours_manifest_{default,full}.json + dumps）
+  * --gold-dir  <...>/c7-decode-gap-localization/raw/gold_states_w8a8（dump_gold_states.py 产物）
+可选：
+  * --gold-fp32-dir  gold_states_float32（参照自身 state 不确定性 = w8a8 vs float32）
+
+输出 JSON：
+  * per prompt/config/layer/state/step：shape、dtype、max_abs、mean_abs、rms、rel_l2、
+    cosine、是否 finite、是否逐位一致（gold cast float32 后）；
+  * per step 聚合：state 输入误差（上一步输出）与 logits 误差的对应；
+  * 误差趋势：after_prefill -> step_0..3 的 rel_l2 序列（判断 state 误差是否累积）；
+  * 与参照自身 state 不确定性（fp32 需要 --gold-fp32-dir）的比值。
+
+state 语义映射（双方都是"消耗当前 token 之后"的 state）：
+  ours layer_XX_causal_conv_new_state        <-> gold layer_XX conv_state
+  ours layer_XX_recurrent_step_{s}_new_state <-> gold layer_XX recurrent_state
+  ours layer_XX_new_k / layer_XX_new_v       <-> gold layer_XX key_cache / value_cache
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import re
+from pathlib import Path
+
+import numpy as np
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+CONFIGS = ("default", "full")
+TAGS = ("after_prefill", "step_0", "step_1", "step_2", "step_3")
+GOLD_KIND = {
+    "conv_state": "conv",
+    "recurrent_state": "recurrent",
+    "key_cache": "key",
+    "value_cache": "value",
+}
+OURS_KIND = {
+    "conv": "causal_conv_new_state",
+    "recurrent": None,   # 由 regex 匹配 recurrent_step_*_new_state
+    "key": "new_k",
+    "value": "new_v",
+}
+
+
+def load_npz(path):
+    with np.load(str(path), allow_pickle=False) as data:
+        return {name: np.asarray(data[name]) for name in data.files}
+
+
+def cosine(a, b):
+    a = np.asarray(a, dtype=np.float64).reshape(-1)
+    b = np.asarray(b, dtype=np.float64).reshape(-1)
+    na = math.sqrt(float(np.dot(a, a)))
+    nb = math.sqrt(float(np.dot(b, b)))
+    if na == 0.0 or nb == 0.0:
+        return float("nan")
+    return float(np.dot(a, b) / (na * nb))
+
+
+def compare(ours, gold):
+    ours = np.asarray(ours)
+    gold = np.asarray(gold)
+    out = {
+        "ours_shape": list(ours.shape),
+        "gold_shape": list(gold.shape),
+        "ours_dtype": str(ours.dtype),
+        "gold_dtype": str(gold.dtype),
+    }
+    if ours.shape != gold.shape:
+        out["status"] = "shape_mismatch"
+        return out
+    a = ours.astype(np.float64).reshape(-1)
+    b = gold.astype(np.float64).reshape(-1)
+    delta = a - b
+    gn = math.sqrt(float(np.dot(b, b)))
+    out.update({
+        "status": "ok",
+        "finite_ours": bool(np.all(np.isfinite(a))),
+        "finite_gold": bool(np.all(np.isfinite(b))),
+        "max_abs": float(np.max(np.abs(delta))) if delta.size else 0.0,
+        "mean_abs": float(np.mean(np.abs(delta))) if delta.size else 0.0,
+        "rms_abs": float(math.sqrt(float(np.mean(delta * delta)))) if delta.size else 0.0,
+        "rel_l2": float(math.sqrt(float(np.dot(delta, delta))) / gn) if gn else None,
+        "cosine": cosine(a, b),
+        "ours_absmax": float(np.max(np.abs(a))) if a.size else 0.0,
+        "gold_absmax": float(np.max(np.abs(b))) if b.size else 0.0,
+    })
+    try:
+        out["bitwise_equal_float32_cast"] = bool(
+            np.array_equal(ours.astype(np.float32), gold.astype(np.float32)))
+    except Exception:  # pragma: no cover
+        out["bitwise_equal_float32_cast"] = None
+    return out
+
+
+def find_ours_key(keys, layer, kind):
+    if kind == "conv":
+        name = "layer_{:02d}_causal_conv_new_state".format(layer)
+        return name if name in keys else None
+    if kind in ("key", "value"):
+        name = "layer_{:02d}_{}".format(layer, OURS_KIND[kind])
+        return name if name in keys else None
+    pattern = re.compile(r"^layer_{:02d}_recurrent_step_\d+_new_state$".format(layer))
+    matches = [key for key in keys if pattern.match(key)]
+    return matches[0] if len(matches) == 1 else None
+
+
+def summarize_values(values):
+    values = [float(v) for v in values if v is not None and v == v]
+    if not values:
+        return {"count": 0}
+    arr = np.asarray(values, dtype=np.float64)
+    return {
+        "count": len(values),
+        "min": float(arr.min()),
+        "median": float(np.median(arr)),
+        "mean": float(arr.mean()),
+        "max": float(arr.max()),
+    }
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ours-raw", required=True)
+    parser.add_argument("--gold-dir", required=True)
+    parser.add_argument("--gold-reference-dir", default="",
+                        help="既有 gold reference 目录（w8a8/*.npz，用于对照 logits）")
+    parser.add_argument("--gold-fp32-dir", default="")
+    parser.add_argument("--output", required=True)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    raw = Path(args.ours_raw).resolve()
+    gold_dir = Path(args.gold_dir).resolve()
+    gold_fp32_dir = Path(args.gold_fp32_dir).resolve() if args.gold_fp32_dir else None
+    gold_reference_dir = Path(args.gold_reference_dir).resolve() if args.gold_reference_dir else None
+    result = {
+        "tool": "compare_states",
+        "gold_dir": str(gold_dir),
+        "ours_raw": str(raw),
+        "tags": list(TAGS),
+        "gold_reference_dir": str(gold_reference_dir) if gold_reference_dir else None,
+        "configs": {},
+    }
+
+    # 先列出 gold 各 tag 有哪些 layer/kind（形状表）
+    for config in CONFIGS:
+        manifest_path = raw / "ours_manifest_{}.json".format(config)
+        if not manifest_path.is_file():
+            continue
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        config_out = {"manifest": str(manifest_path), "prompts": {}}
+        for prompt in PROMPTS:
+            entry = manifest["prompts"][prompt]
+            gold_path = gold_dir / "{}.npz".format(prompt)
+            if not gold_path.is_file():
+                config_out["prompts"][prompt] = {"status": "gold_states_missing", "path": str(gold_path)}
+                continue
+            gold = load_npz(gold_path)
+            ours_prefill = load_npz(Path(entry["prefill_npz"]))
+            decode_npz = {int(k): Path(v) for k, v in entry["decode_npz"].items()}
+            decode_pasts = sorted(decode_npz)
+            ours_steps = {tag: ours_prefill for tag in ("after_prefill",)}
+            for step_index, past in enumerate(decode_pasts):
+                ours_steps["step_{}".format(step_index)] = load_npz(decode_npz[past])
+
+            prompt_out = {"rows": [], "layers": {}, "step_summary": [], "gold_validation": None}
+            # 记录 dump 与既有 gold logits 的逐位校验（如果 manifest 里有）
+            gold_manifest = gold_dir / "gold_states_manifest.json"
+            if gold_manifest.is_file():
+                gm = json.loads(gold_manifest.read_text(encoding="utf-8"))
+                for run in gm.get("runs", []):
+                    if run.get("prompt") == prompt:
+                        prompt_out["gold_validation"] = run.get("validation_vs_gold")
+
+            layer_indices = sorted({int(re.match(r"after_prefill__layer_(\d+)__", key).group(1))
+                                    for key in gold if key.startswith("after_prefill__layer_")})
+            for layer in layer_indices:
+                layer_out = {}
+                for gold_kind, ours_kind in GOLD_KIND.items():
+                    kind_entry = {"steps": {}}
+                    for tag in TAGS:
+                        gold_key = "{}__layer_{:02d}__{}".format(tag, layer, gold_kind)
+                        if gold_key not in gold:
+                            continue
+                        ours_key = find_ours_key(ours_steps.get(tag, {}), layer, ours_kind)
+                        if ours_key is None:
+                            kind_entry["steps"][tag] = {
+                                "status": "ours_key_missing",
+                                "gold_key": gold_key,
+                                "ours_expected_kind": ours_kind,
+                            }
+                            continue
+                        kind_entry["steps"][tag] = compare(ours_steps[tag][ours_key], gold[gold_key])
+                        kind_entry["steps"][tag]["ours_key"] = ours_key
+                        kind_entry["steps"][tag]["gold_key"] = gold_key
+                    if kind_entry["steps"]:
+                        ok_steps = [s for s in kind_entry["steps"].values() if s.get("status") == "ok"]
+                        kind_entry["trend_rel_l2"] = [
+                            kind_entry["steps"][tag].get("rel_l2") for tag in TAGS
+                            if tag in kind_entry["steps"] and kind_entry["steps"][tag].get("status") == "ok"]
+                        kind_entry["trend_max_abs"] = [
+                            kind_entry["steps"][tag].get("max_abs") for tag in TAGS
+                            if tag in kind_entry["steps"] and kind_entry["steps"][tag].get("status") == "ok"]
+                        kind_entry["trend_ours_gold_cosine"] = [
+                            kind_entry["steps"][tag].get("cosine") for tag in TAGS
+                            if tag in kind_entry["steps"] and kind_entry["steps"][tag].get("status") == "ok"]
+                        kind_entry["steps_ok"] = len(ok_steps)
+                    layer_out[gold_kind] = kind_entry
+                prompt_out["layers"]["layer_{:02d}".format(layer)] = layer_out
+
+            # step 级汇总：state 误差（上一步输出=本步输入）vs 本步 logits ours-vs-gold
+            ours_prefill_logits = np.asarray(ours_prefill["logits"], dtype=np.float64)
+            ours_next = ours_prefill_logits.reshape(-1, ours_prefill_logits.shape[-1])[-1]
+            gold_logits = None
+            if gold_reference_dir is not None:
+                gold_npz_path = gold_reference_dir / "w8a8" / "{}.npz".format(prompt)
+                if gold_npz_path.is_file():
+                    gold_logits = load_npz(gold_npz_path)
+            for step_index in range(len(decode_pasts) + 1):
+                tag_in = "after_prefill" if step_index == 0 else "step_{}".format(step_index - 1)
+                rel_l2_values = []
+                max_abs_values = []
+                for layer in layer_indices:
+                    for gold_kind in GOLD_KIND:
+                        step = prompt_out["layers"]["layer_{:02d}".format(layer)][gold_kind]["steps"].get(tag_in)
+                        if step and step.get("status") == "ok":
+                            rel_l2_values.append(step["rel_l2"])
+                            max_abs_values.append(step["max_abs"])
+                logits_metric = None
+                if gold_logits is not None:
+                    if step_index == 0:
+                        ours_row = ours_next
+                        gold_row = np.asarray(gold_logits["prefill_next_logits"], dtype=np.float64)
+                    elif step_index <= len(decode_pasts):
+                        path = decode_npz[decode_pasts[step_index - 1]]
+                        ours_row = np.asarray(load_npz(path)["logits"], dtype=np.float64).reshape(-1)
+                        if step_index < gold_logits["decode_logits"].shape[0]:
+                            gold_row = np.asarray(gold_logits["decode_logits"][step_index], dtype=np.float64)
+                        else:
+                            gold_row = None
+                    else:
+                        gold_row = None
+                    if gold_row is not None:
+                        delta = ours_row - gold_row
+                        gn = float(np.linalg.norm(gold_row))
+                        logits_metric = {
+                            "cosine": cosine(ours_row, gold_row),
+                            "rel_l2": float(np.linalg.norm(delta) / gn) if gn else None,
+                            "max_abs": float(np.max(np.abs(delta))),
+                        }
+                prompt_out["step_summary"].append({
+                    "step_index": step_index,
+                    "state_input_tag": tag_in,
+                    "state_rel_l2": summarize_values(rel_l2_values),
+                    "state_max_abs": summarize_values(max_abs_values),
+                    "logits_ours_vs_gold": logits_metric,
+                })
+            config_out["prompts"][prompt] = prompt_out
+        result["configs"][config] = config_out
+
+    # 参照自身 state 不确定性（可选）：w8a8 gold state vs float32 gold state
+    if gold_fp32_dir is not None:
+        ref_uncertainty = {}
+        for prompt in PROMPTS:
+            a_path = gold_dir / "{}.npz".format(prompt)
+            b_path = gold_fp32_dir / "{}.npz".format(prompt)
+            if not (a_path.is_file() and b_path.is_file()):
+                continue
+            a = load_npz(a_path)
+            b = load_npz(b_path)
+            entries = {}
+            for tag in TAGS:
+                rel_l2_values = []
+                max_abs_values = []
+                cosines = []
+                for key in sorted(a):
+                    if not key.startswith(tag + "__"):
+                        continue
+                    if key not in b:
+                        continue
+                    cmp = compare(a[key], b[key])
+                    if cmp.get("status") == "ok":
+                        rel_l2_values.append(cmp["rel_l2"])
+                        max_abs_values.append(cmp["max_abs"])
+                        cosines.append(cmp["cosine"])
+                entries[tag] = {
+                    "state_rel_l2": summarize_values(rel_l2_values),
+                    "state_max_abs": summarize_values(max_abs_values),
+                    "state_cosine": summarize_values(cosines),
+                    "key_count": len(rel_l2_values),
+                }
+            ref_uncertainty[prompt] = entries
+        result["reference_self_state_uncertainty_w8a8_vs_fp32"] = {
+            "gold_a": str(gold_dir),
+            "gold_b": str(gold_fp32_dir),
+            "per_prompt": ref_uncertainty,
+        }
+
+    out_path = Path(args.output)
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    out_path.write_text(json.dumps(result, indent=1), encoding="utf-8")
+    print("[compare_states] wrote {}".format(out_path))
+    for config, item in result["configs"].items():
+        for prompt, data in item["prompts"].items():
+            if data.get("status"):
+                print("[{}] {}: {}".format(config, prompt, data["status"]))
+                continue
+            for step in data["step_summary"]:
+                lm = step["logits_ours_vs_gold"] or {}
+                print("[{}] {} step{} state_rel_l2 med={} max={} | logits cos={} rel_l2={}".format(
+                    config, prompt, step["step_index"],
+                    step["state_rel_l2"].get("median"), step["state_rel_l2"].get("max"),
+                    None if lm.get("cosine") is None else round(lm["cosine"], 8),
+                    None if lm.get("rel_l2") is None else round(lm["rel_l2"], 6)))
+
+
+if __name__ == "__main__":
+    main()
