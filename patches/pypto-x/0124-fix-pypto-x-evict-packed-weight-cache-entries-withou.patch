From d5cdb8518f32f3e4063c516be9afe270c790cef7 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Fri, 11 Sep 2026 05:53:51 +0800
Subject: [PATCH 124/258] fix(pypto-x): evict packed-weight cache entries
 without dict.popitem(last=)

The opt-in cross-launch cache is byte-bounded, but the eviction helper used
OrderedDict.popitem(last=False) on a plain dict, so the first cache overflow
raised "dict.popitem() takes no keyword arguments" inside a packed matmul.
Evict the oldest key explicitly and add a focused byte-budget regression test.
---
 python/pypto/backends/cpu/x86/avx512.py                |  5 +++--
 python/tests/ut/pypto_x/test_cpu_avx512_packed_gemm.py | 27 +++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/python/pypto/backends/cpu/x86/avx512.py b/python/pypto/backends/cpu/x86/avx512.py
index 2a300d527..7ec5e3e74 100644
--- a/python/pypto/backends/cpu/x86/avx512.py
+++ b/python/pypto/backends/cpu/x86/avx512.py
@@ -315,13 +315,14 @@ def _packed_weight_cache_evict(size: int) -> None:
     """Evict oldest entries until ``size`` bytes fit inside the byte budget."""
 
     global _PACKED_WEIGHT_CACHE_BYTES
-    _PACKED_WEIGHT_CACHE_STATS["evictions"] += 1
     while _PACKED_WEIGHT_CACHE and (
         len(_PACKED_WEIGHT_CACHE) >= _PACKED_WEIGHT_CACHE_MAX_ENTRIES
         or _PACKED_WEIGHT_CACHE_BYTES + size > _PACKED_WEIGHT_CACHE_MAX_BYTES
     ):
-        _, evicted = _PACKED_WEIGHT_CACHE.popitem(last=False)
+        oldest = next(iter(_PACKED_WEIGHT_CACHE))
+        evicted = _PACKED_WEIGHT_CACHE.pop(oldest)
         _PACKED_WEIGHT_CACHE_BYTES -= int(evicted.get("bytes", 0))
+        _PACKED_WEIGHT_CACHE_STATS["evictions"] += 1
         if not _PACKED_WEIGHT_CACHE:
             break
 
diff --git a/python/tests/ut/pypto_x/test_cpu_avx512_packed_gemm.py b/python/tests/ut/pypto_x/test_cpu_avx512_packed_gemm.py
index 6e9bb09a5..18bb092d4 100644
--- a/python/tests/ut/pypto_x/test_cpu_avx512_packed_gemm.py
+++ b/python/tests/ut/pypto_x/test_cpu_avx512_packed_gemm.py
@@ -455,6 +455,33 @@ def test_packed_weight_cache_is_opt_in_and_invalidates(tmp_path):
     assert runtime.packed_weight_cache_stats()["entries"] == 0
 
 
+def test_packed_weight_cache_byte_budget_evicts_instead_of_growing(tmp_path, monkeypatch):
+    runtime_module.clear_packed_weight_cache()
+    monkeypatch.setattr(runtime_module, "_PACKED_WEIGHT_CACHE_MAX_BYTES", 1024)
+    runtime = Avx512Runtime(packed_weight_cache=True)
+    before = runtime.packed_weight_cache_stats()
+    for k, n in ((64, 64), (64, 128), (128, 64)):
+        program = _make_shapes_program(((5, k, n),), "float32", derive=False)
+        _, _, artifact = _compile(
+            program, _target("avx512f", "fma"), tmp_path / "evict_{}_{}".format(k, n)
+        )
+        inputs = [
+            HostTensor("float32", (5, k), _values(5 * k)),
+            HostTensor("float32", (k, n), _values(k * n, 0.25)),
+        ]
+        _run(
+            artifact,
+            inputs,
+            [HostTensor.zeros("float32", (5, n))],
+            runtime=runtime,
+        )
+    after = runtime.packed_weight_cache_stats()
+    assert after["evictions"] - before["evictions"] >= 2
+    assert after["entries"] <= 1
+    runtime.clear_packed_weight_cache()
+    assert runtime.packed_weight_cache_stats()["entries"] == 0
+
+
 def test_packed_dispatch_prefers_parameter_chains_on_the_qwen_graph():
     # The real decoder graph lowers to 187 packed rank-2 matmuls and no legacy
     # rank-2 matmul; batched attention matmuls keep their own declared mode.
