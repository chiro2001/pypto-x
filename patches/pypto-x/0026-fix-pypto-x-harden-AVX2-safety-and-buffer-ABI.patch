+def _array_interface_buffer(
+    storage: Any,
+    descriptor: TensorDesc,
+    expected_dtype: str,
+    context: str,
+) -> Optional[_NativeBuffer]:
+    """Validate and expose a C-contiguous ``__array_interface__`` buffer."""
+
+    interface = getattr(storage, "__array_interface__", None)
+    if not isinstance(interface, Mapping):
+        return None
+    shape = interface.get("shape")
+    if shape is None:
+        raise CpuAvx2ExecutionError("{} array interface must provide shape".format(context))
+    try:
+        actual_shape = tuple(int(dimension) for dimension in shape)
+    except (TypeError, ValueError) as exc:
+        raise CpuAvx2ExecutionError("{} array interface shape is invalid".format(context)) from exc
+    if actual_shape != descriptor.shape:
+        raise CpuAvx2ExecutionError(
+            "{} array interface shape {} does not match descriptor {}".format(
+                context, actual_shape, descriptor.shape
+            )
+        )
+    typestr = interface.get("typestr")
+    if not isinstance(typestr, str) or len(typestr) < 2:
+        raise CpuAvx2ExecutionError("{} array interface typestr is missing".format(context))
+    try:
+        itemsize = int(typestr[2:])
+    except ValueError as exc:
+        raise CpuAvx2ExecutionError("{} array interface itemsize is invalid".format(context)) from exc
+    kind = typestr[1]
+    if expected_dtype == "float32":
+        dtype_match = kind == "f" and itemsize == 4
+    else:
+        # NumPy has no universally available BF16 dtype.  Accept uint16 or
+        # a two-byte void representation, but never silently reinterpret f32.
+        dtype_match = kind in ("u", "V") and itemsize == 2
+    if not dtype_match:
+        raise CpuAvx2ExecutionError(
+            "{} array interface dtype {} does not match {}".format(context, typestr, expected_dtype)
+        )
+    expected_strides = _contiguous_byte_strides(actual_shape, itemsize)
+    strides = interface.get("strides")
+    if strides is not None:
+        try:
+            actual_strides = tuple(int(stride) for stride in strides)
+        except (TypeError, ValueError) as exc:
+            raise CpuAvx2ExecutionError("{} array interface strides are invalid".format(context)) from exc
+        if actual_strides != expected_strides:
+            raise CpuAvx2ExecutionError("{} array interface must be C-contiguous".format(context))
+    data = interface.get("data")
+    if not isinstance(data, (tuple, list)) or not data:
+        raise CpuAvx2ExecutionError("{} array interface data is missing".format(context))
+    try:
+        address = int(data[0] or 0)
+    except (TypeError, ValueError) as exc:
+        raise CpuAvx2ExecutionError("{} array interface address is invalid".format(context)) from exc
+    actual_readonly = bool(data[1]) if len(data) > 1 else False
+    if actual_readonly and not descriptor.readonly:
+        raise CpuAvx2ExecutionError("{} array interface is read-only but descriptor is writable".format(context))
+    count = descriptor.element_count
+    if count and address == 0:
+        raise CpuAvx2ExecutionError("{} array interface has a null address".format(context))
+    pointer = ctypes.cast(address, _pointer(expected_dtype))
+    return _NativeBuffer(expected_dtype, count, pointer, storage, True)
+
+
+def _contiguous_byte_strides(shape: Sequence[int], itemsize: int) -> Tuple[int, ...]:
+    strides = [itemsize] * len(shape)
+    running = itemsize
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
