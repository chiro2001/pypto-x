+def test_cache_key_isolated_by_fma_and_target(tmp_path):
+    program = _add_program()
+    _, _, no_fma = _compile(program, _target("avx2"), tmp_path / "no-fma")
+    _, _, with_fma = _compile(program, _target("avx2", "fma"), tmp_path / "fma")
+    assert no_fma.cache_key != with_fma.cache_key
+    assert no_fma.content_digest != with_fma.content_digest
+    _, _, same_target_other_dir = _compile(program, _target("avx2"), tmp_path / "other-dir")
+    assert no_fma.cache_key == same_target_other_dir.cache_key
