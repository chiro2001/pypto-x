+def test_objdump_has_ymm_and_no_zmm(tmp_path):
+    _, _, artifact = _compile(_add_program(shape=(19,)), _target("avx2", "fma"), tmp_path)
+    objdump = shutil.which("objdump")
+    if objdump is None:
+        pytest.skip("GNU objdump is unavailable")
+    result = subprocess.run([objdump, "-d", artifact.path], stdout=subprocess.PIPE, text=True, check=True)
+    text = result.stdout.lower()
+    assert "ymm" in text
+    assert "zmm" not in text
+    assert "avx512" not in text
