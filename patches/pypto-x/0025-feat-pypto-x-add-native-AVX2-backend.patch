+def test_bf16_reduction_and_matmul_match_scalar(tmp_path):
+    input_type = CoreType.tensor("bf16", (2, 3, 5))
+    reduced_type = CoreType.tensor("bf16", (2, 5))
+    source = ValueRef("source", input_type)
+    reduced = ValueRef("reduced", reduced_type)
