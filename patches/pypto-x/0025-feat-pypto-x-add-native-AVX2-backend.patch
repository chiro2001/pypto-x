+
+_NATIVE_SOURCE = r'''
+#include <immintrin.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef PTX_USE_FMA
+#define PTX_USE_FMA 0
+#endif
+
+static inline __m256 ptx_binary_f32(int op, __m256 a, __m256 b) {
+    if (op == 0) return _mm256_add_ps(a, b);
+    if (op == 1) return _mm256_sub_ps(a, b);
+    if (op == 2) return _mm256_mul_ps(a, b);
+    return _mm256_div_ps(a, b);
+}
+
+static inline __m256 ptx_accumulate(__m256 a, __m256 b, __m256 acc) {
+#if PTX_USE_FMA
+    return _mm256_fmadd_ps(a, b, acc);
+#else
+    return _mm256_add_ps(_mm256_mul_ps(a, b), acc);
+#endif
+}
+
+static inline float ptx_bf16_to_f32(uint16_t value) {
+    union { uint32_t bits; float value; } converted;
+    converted.bits = ((uint32_t)value) << 16;
+    return converted.value;
+}
+
+static inline uint16_t ptx_f32_to_bf16(float value) {
+    union { uint32_t bits; float value; } converted;
+    uint32_t rounding;
+    converted.value = value;
+    if ((converted.bits & 0x7f800000U) == 0x7f800000U) {
+        return (uint16_t)(converted.bits >> 16);
+    }
+    rounding = 0x7fffU + ((converted.bits >> 16) & 1U);
+    return (uint16_t)((converted.bits + rounding) >> 16);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_copy_f32(const float *input, float *output, size_t n) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        _mm256_storeu_ps(output + i, _mm256_loadu_ps(input + i));
+    }
+    for (; i < n; ++i) output[i] = input[i];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_neg_f32(const float *input, float *output, size_t n) {
+    size_t i = 0;
+    const __m256 zero = _mm256_setzero_ps();
+    for (; i + 8 <= n; i += 8) {
+        _mm256_storeu_ps(output + i, _mm256_sub_ps(zero, _mm256_loadu_ps(input + i)));
+    }
+    for (; i < n; ++i) output[i] = -input[i];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_binary_f32(int op, const float *left, int left_scalar,
+                         const float *right, int right_scalar,
+                         float *output, size_t n) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        __m256 a = left_scalar ? _mm256_set1_ps(left[0]) : _mm256_loadu_ps(left + i);
+        __m256 b = right_scalar ? _mm256_set1_ps(right[0]) : _mm256_loadu_ps(right + i);
+        _mm256_storeu_ps(output + i, ptx_binary_f32(op, a, b));
+    }
+    for (; i < n; ++i) {
+        float a = left_scalar ? left[0] : left[i];
+        float b = right_scalar ? right[0] : right[i];
+        if (op == 0) output[i] = a + b;
+        else if (op == 1) output[i] = a - b;
+        else if (op == 2) output[i] = a * b;
+        else output[i] = a / b;
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_copy_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0;
+    float in[8], out[8];
+    for (; i + 8 <= n; i += 8) {
+        size_t lane;
+        for (lane = 0; lane < 8; ++lane) in[lane] = ptx_bf16_to_f32(input[i + lane]);
+        _mm256_storeu_ps(out, _mm256_loadu_ps(in));
+        for (lane = 0; lane < 8; ++lane) output[i + lane] = ptx_f32_to_bf16(out[lane]);
+    }
+    for (; i < n; ++i) output[i] = input[i];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_neg_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0;
+    float in[8], out[8];
+    const __m256 zero = _mm256_setzero_ps();
+    for (; i + 8 <= n; i += 8) {
+        size_t lane;
+        for (lane = 0; lane < 8; ++lane) in[lane] = ptx_bf16_to_f32(input[i + lane]);
+        _mm256_storeu_ps(out, _mm256_sub_ps(zero, _mm256_loadu_ps(in)));
+        for (lane = 0; lane < 8; ++lane) output[i + lane] = ptx_f32_to_bf16(out[lane]);
+    }
+    for (; i < n; ++i) output[i] = ptx_f32_to_bf16(-ptx_bf16_to_f32(input[i]));
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_binary_bf16(int op, const uint16_t *left, int left_scalar,
+                          const uint16_t *right, int right_scalar,
+                          uint16_t *output, size_t n) {
+    size_t i = 0;
+    float a_values[8], b_values[8], result[8];
+    for (; i + 8 <= n; i += 8) {
+        size_t lane;
+        for (lane = 0; lane < 8; ++lane) {
+            a_values[lane] = ptx_bf16_to_f32(left_scalar ? left[0] : left[i + lane]);
+            b_values[lane] = ptx_bf16_to_f32(right_scalar ? right[0] : right[i + lane]);
+        }
+        _mm256_storeu_ps(result, ptx_binary_f32(op, _mm256_loadu_ps(a_values), _mm256_loadu_ps(b_values)));
+        for (lane = 0; lane < 8; ++lane) output[i + lane] = ptx_f32_to_bf16(result[lane]);
+    }
+    for (; i < n; ++i) {
+        float a = ptx_bf16_to_f32(left_scalar ? left[0] : left[i]);
+        float b = ptx_bf16_to_f32(right_scalar ? right[0] : right[i]);
+        float value = op == 0 ? a + b : (op == 1 ? a - b : (op == 2 ? a * b : a / b));
+        output[i] = ptx_f32_to_bf16(value);
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_reduce_sum_f32(const float *input, float *output, size_t n) {
+    size_t i = 0;
+    float lanes[8];
+    __m256 accumulator = _mm256_setzero_ps();
+    for (; i + 8 <= n; i += 8) accumulator = _mm256_add_ps(accumulator, _mm256_loadu_ps(input + i));
+    _mm256_storeu_ps(lanes, accumulator);
+    *output = lanes[0] + lanes[1] + lanes[2] + lanes[3] + lanes[4] + lanes[5] + lanes[6] + lanes[7];
+    for (; i < n; ++i) *output += input[i];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_reduce_max_f32(const float *input, float *output, size_t n) {
+    size_t i = 0;
+    float lanes[8];
+    __m256 accumulator;
+    if (n == 0) return;
+    if (n < 8) {
+        *output = input[0];
+        for (i = 1; i < n; ++i) if (input[i] > *output) *output = input[i];
+        return;
+    }
+    accumulator = _mm256_loadu_ps(input);
+    i = 8;
+    for (; i + 8 <= n; i += 8) accumulator = _mm256_max_ps(accumulator, _mm256_loadu_ps(input + i));
+    _mm256_storeu_ps(lanes, accumulator);
+    *output = lanes[0];
+    for (i = 1; i < 8 && i < n; ++i) if (lanes[i] > *output) *output = lanes[i];
+    for (; i < n; ++i) if (input[i] > *output) *output = input[i];
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_reduce_sum_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float values[8], lanes[8];
+    __m256 accumulator = _mm256_setzero_ps();
+    for (; i + 8 <= n; i += 8) {
+        for (lane = 0; lane < 8; ++lane) values[lane] = ptx_bf16_to_f32(input[i + lane]);
+        accumulator = _mm256_add_ps(accumulator, _mm256_loadu_ps(values));
+    }
+    _mm256_storeu_ps(lanes, accumulator);
+    for (lane = 1; lane < 8; ++lane) lanes[0] += lanes[lane];
+    for (; i < n; ++i) lanes[0] += ptx_bf16_to_f32(input[i]);
+    *output = ptx_f32_to_bf16(lanes[0]);
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_reduce_max_bf16(const uint16_t *input, uint16_t *output, size_t n) {
+    size_t i = 0, lane;
+    float values[8], lanes[8];
+    __m256 accumulator;
+    if (n == 0) return;
+    for (lane = 0; lane < 8; ++lane) values[lane] = lane < n ? ptx_bf16_to_f32(input[lane]) : values[0];
+    accumulator = _mm256_loadu_ps(values);
+    i = n < 8 ? n : 8;
+    for (; i + 8 <= n; i += 8) {
+        for (lane = 0; lane < 8; ++lane) values[lane] = ptx_bf16_to_f32(input[i + lane]);
+        accumulator = _mm256_max_ps(accumulator, _mm256_loadu_ps(values));
+    }
+    _mm256_storeu_ps(lanes, accumulator);
+    *output = ptx_f32_to_bf16(lanes[0]);
+    for (lane = 1; lane < 8; ++lane) if (lanes[lane] > ptx_bf16_to_f32(*output)) *output = ptx_f32_to_bf16(lanes[lane]);
+    for (; i < n; ++i) {
+        float value = ptx_bf16_to_f32(input[i]);
+        if (value > ptx_bf16_to_f32(*output)) *output = input[i];
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_matmul_f32(const float *left, const float *right, float *output,
+                         size_t m, size_t k, size_t n) {
+    size_t row, inner, column;
+    for (row = 0; row < m; ++row) {
+        for (column = 0; column + 8 <= n; column += 8) {
+            __m256 accumulator = _mm256_setzero_ps();
+            for (inner = 0; inner < k; ++inner) {
+                __m256 a = _mm256_set1_ps(left[row * k + inner]);
+                __m256 b = _mm256_loadu_ps(right + inner * n + column);
+                accumulator = ptx_accumulate(a, b, accumulator);
+            }
+            _mm256_storeu_ps(output + row * n + column, accumulator);
+        }
+        for (; column < n; ++column) {
+            float accumulator = 0.0f;
+            for (inner = 0; inner < k; ++inner) accumulator += left[row * k + inner] * right[inner * n + column];
+            output[row * n + column] = accumulator;
+        }
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_matmul_bf16(const uint16_t *left, const uint16_t *right, uint16_t *output,
+                          size_t m, size_t k, size_t n) {
+    size_t row, inner, column, lane;
+    float left_values[8], right_values[8], result[8];
+    for (row = 0; row < m; ++row) {
+        for (column = 0; column + 8 <= n; column += 8) {
+            __m256 accumulator = _mm256_setzero_ps();
+            for (inner = 0; inner < k; ++inner) {
+                float left_value = ptx_bf16_to_f32(left[row * k + inner]);
+                for (lane = 0; lane < 8; ++lane) right_values[lane] = ptx_bf16_to_f32(right[inner * n + column + lane]);
+                accumulator = ptx_accumulate(_mm256_set1_ps(left_value), _mm256_loadu_ps(right_values), accumulator);
+            }
+            _mm256_storeu_ps(result, accumulator);
+            for (lane = 0; lane < 8; ++lane) output[row * n + column + lane] = ptx_f32_to_bf16(result[lane]);
+        }
+        for (; column < n; ++column) {
+            float accumulator = 0.0f;
+            for (inner = 0; inner < k; ++inner) {
+                accumulator += ptx_bf16_to_f32(left[row * k + inner]) * ptx_bf16_to_f32(right[inner * n + column]);
+            }
+            output[row * n + column] = ptx_f32_to_bf16(accumulator);
+        }
+    }
+}
+'''
+
+
+class Avx2CompileError(RuntimeError):
+    """Clang could not produce an AVX2 shared object."""
+
+
+def _plain_mapping(value: Mapping[str, Any]) -> dict:
+    if not isinstance(value, Mapping):
+        raise TypeError("metadata must be a mapping")
+    return {key: _plain_value(item) for key, item in value.items()}
+
+
+def _plain_value(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [_plain_value(item) for item in value]
+    if isinstance(value, list):
+        return [_plain_value(item) for item in value]
+    return value
+
+
+def _cacheable_extra(value: Mapping[str, Any]) -> dict:
+    """Drop filesystem locations which must not enter a stable cache key."""
+
+    volatile = frozenset(("build_dir", "tmp_dir", "artifact_dir", "source_path", "output_path"))
+    return {key: _plain_value(item) for key, item in value.items() if key not in volatile}
+
+
+def _build_directory(options: Optional[CompileOptions]) -> Path:
+    extra = {} if options is None else mapping_copy(options.extra)
+    selected = extra.get("build_dir") or os.environ.get("PYPTO_X_AVX2_BUILD_DIR")
+    if selected is None:
+        selected = os.path.join(os.environ.get("TMPDIR", "/tmp"), "pypto-x-avx2")
+    path = Path(os.fspath(selected)).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    (path / "tmp").mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _compile_native(target_ir: Avx2Program, options: Optional[CompileOptions]) -> tuple:
+    extra = {} if options is None else mapping_copy(options.extra)
+    compiler = str(extra.get("clang") or os.environ.get("CC") or "clang")
+    compiler_path = shutil.which(compiler) or compiler
+    if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
+        raise Avx2CompileError("Clang compiler {!r} was not found".format(compiler))
+    build_dir = _build_directory(options)
+    source = ("#define PTX_USE_FMA {}\n".format(1 if target_ir.use_fma else 0)) + _NATIVE_SOURCE
+    source_digest = hashlib.sha256(source.encode("utf-8")).hexdigest()
+    stem = "pypto_x_avx2_{}".format(source_digest[:20])
+    source_path = build_dir / (stem + ".c")
+    output_path = build_dir / (stem + ".so")
+    source_path.write_text(source, encoding="utf-8")
+    command = [
+        compiler_path,
+        "-shared",
+        "-fPIC",
+        "-O2",
+        "-std=c99",
+        "-mavx2",
+    ]
+    if target_ir.use_fma:
+        command.append("-mfma")
+    command.extend([str(source_path), "-o", str(output_path)])
+    environment = dict(os.environ)
+    environment["TMPDIR"] = str(build_dir / "tmp")
+    result = subprocess.run(
+        command,
+        cwd=str(build_dir),
+        env=environment,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        universal_newlines=True,
+        check=False,
+    )
+    if result.returncode != 0 or not output_path.is_file():
+        raise Avx2CompileError(
+            "Clang AVX2 compilation failed ({}): {}".format(
+                result.returncode, (result.stderr or result.stdout).strip()
+            )
+        )
+    version_result = subprocess.run(
+        [compiler_path, "--version"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    triple_result = subprocess.run(
+        [compiler_path, "-print-target-triple"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    compiler_version = (version_result.stdout.splitlines() or [compiler_path])[0].strip()
+    target_triple = triple_result.stdout.strip() or "unknown"
+    normalized_command = [Path(compiler_path).name]
+    normalized_command.extend(command[1:-3])
+    normalized_command.extend([source_path.name, "-o", output_path.name])
+    return output_path, source_digest, compiler_path, compiler_version, target_triple, tuple(normalized_command)
+
+
+class Avx2Compiler:
+    """Lower and compile a validated AVX2 program with Clang."""
+
+    name = AVX2_BACKEND
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> Avx2Program:
+        return lower_avx2(program, target)
+
+    def compile(self, target_ir: Avx2Program, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, Avx2Program):
+            raise TypeError("AVX2 compile() requires Avx2Program from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        target_ir.validate()
+        output_path, source_digest, compiler_path, compiler_version, target_triple, command = _compile_native(
+            target_ir, options
+        )
+        program_json = target_ir.program.canonical_json()
+        program_data = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        plan_data = _plain_mapping(target_ir.vector_program.to_dict())
+        plan_digest = target_ir.plan_digest
+        target_data = _plain_mapping(target_ir.target.to_dict())
+        native_digest = sha256_bytes(output_path.read_bytes())
+        metadata = {
+            "backend": AVX2_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "lowering_version": AVX2_LOWERING_VERSION,
+            "plan_version": plan_data["plan_version"],
+            "entrypoint": target_ir.entrypoint,
+            "program": program_data,
+            "program_digest": program_digest,
+            "vector_plan": plan_data,
+            "plan_digest": plan_digest,
+            "target_digest": sha256_text(target_data),
+            "required_features": list(target_ir.required_features.features),
+            "required_feature_source": target_ir.required_features.source,
+            "native_isa": "avx2",
+            "native_format": "elf-shared-object",
+            "native_digest": native_digest,
+            "native_source_digest": source_digest,
+            "compiler": Path(compiler_path).name,
+            "compiler_version": compiler_version,
+            "compiler_target_triple": target_triple,
+            "compile_command": list(command),
+            "use_fma": target_ir.use_fma,
+        }
+        if options is not None:
+            option_metadata = _plain_mapping(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError(
+                    "compile option metadata uses reserved AVX2 keys: {}".format(", ".join(sorted(reserved)))
+                )
+            metadata.update(option_metadata)
+            metadata["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "extra": _cacheable_extra(mapping_copy(options.extra)),
+            }
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            path=str(output_path),
+            metadata=metadata,
+        )
+        artifact.validate()
+        if artifact.content_digest != native_digest:
+            raise Avx2CompileError("native artifact digest changed while packaging")
+        return artifact
+
+
+CPUAVX2Compiler = Avx2Compiler
+CPUAvx2Compiler = Avx2Compiler
+
+
+def compile_cpu_avx2(
+    program: CoreProgram,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None,
+) -> Artifact:
+    compiler = Avx2Compiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION",
+    "AVX2_BACKEND",
+    "Avx2CompileError",
+    "Avx2Compiler",
+    "CPUAVX2Compiler",
+    "CPUAvx2Compiler",
+    "DEFAULT_ARTIFACT_FORMAT",
+    "compile_cpu_avx2",
+]
