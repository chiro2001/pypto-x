@@ -0,0 +1,755 @@
+"""Native AVX2 runtime with scalar differential semantics.
+
+The runtime deliberately keeps the public ABI vendor-neutral.  Python
+buffers are marshalled to the generated shared object, while an integer
+``TensorDesc.address`` is passed directly so unaligned host buffers exercise
+the native ``loadu``/``storeu`` paths as well.
+"""
+
+from __future__ import annotations
+
+import ctypes
+from dataclasses import dataclass
+import hashlib
+import math
+import struct
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, LaunchRequest, TensorDesc
+from pypto.compiler.artifact import Artifact
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import (
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    flatten_values,
+    static_shape,
+)
+from pypto.lowering.cpu.x86.avx2 import (
+    AVX2_BACKEND,
+    AVX2_LOWERING_VERSION,
+    Avx2Capability,
+    Avx2Program,
+    lower_avx2,
+)
+from pypto.lowering.cpu.x86.avx2 import capabilities as _capabilities
+from pypto.lowering.cpu.vector import (
+    VECTOR_PLAN_VERSION,
+    CpuFeatureContract,
+    CpuFeatureSet,
+    CpuVectorFeatureMismatchError,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_text
+
+from ..tensor import FlatBuffer, HostTensor, _cast_value
+
+
+class CpuAvx2RuntimeError(RuntimeError):
+    """Base class for AVX2 runtime failures."""
+
+
+class CpuAvx2UnavailableError(CpuAvx2RuntimeError):
+    """The host cannot safely execute the requested AVX2 artifact."""
+
+    def __init__(self, status: Availability):
+        self.status = status
+        super().__init__(status.reason or "AVX2 runtime is unavailable")
+
+
+class CpuAvx2ArtifactError(CpuAvx2RuntimeError):
+    """An immutable artifact, plan, or native module failed validation."""
+
+
+class CpuAvx2ExecutionError(CpuAvx2RuntimeError):
+    """A launch request or native operation is invalid."""
+
+
+@dataclass(frozen=True)
+class _NativeBuffer:
+    dtype: str
+    count: int
+    pointer: Any
+    owner: Any = None
+    direct: bool = False
+
+
+@dataclass(frozen=True)
+class _RuntimeValue:
+    type: CoreType
+    buffer: _NativeBuffer
+
+
+@dataclass(frozen=True)
+class LoadedAvx2Artifact:
+    artifact: Artifact
+    target_ir: Avx2Program
+    feature_contract: CpuFeatureContract
+    module: Any
+
+    @property
+    def contract(self) -> CpuFeatureContract:
+        return self.feature_contract
+
+
+_CTYPE = {"float32": ctypes.c_float, "bf16": ctypes.c_uint16}
+_POINTER = {dtype: ctypes.POINTER(ctype) for dtype, ctype in _CTYPE.items()}
+
+
+def _ctype(dtype: str):
+    try:
+        return _CTYPE[canonical_dtype(dtype)]
+    except KeyError as exc:
+        raise CpuAvx2ExecutionError("AVX2 native runtime does not support dtype {!r}".format(dtype)) from exc
+
+
+def _pointer(dtype: str):
+    return _POINTER[canonical_dtype(dtype)]
+
+
+def _native_suffix(dtype: str) -> str:
+    return "f32" if canonical_dtype(dtype) == "float32" else "bf16"
+
+
+def _bf16_bits(value: Any) -> int:
+    number = float(value)
+    if not math.isfinite(number):
+        bits = struct.unpack("<I", struct.pack("<f", number))[0]
+        return (bits >> 16) & 0xFFFF
+    bits = struct.unpack("<I", struct.pack("<f", number))[0]
+    rounding = 0x7FFF + ((bits >> 16) & 1)
+    return ((bits + rounding) >> 16) & 0xFFFF
+
+
+def _bf16_value(bits: int) -> float:
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+def _address_value(value: Any) -> Optional[int]:
+    if isinstance(value, int) and not isinstance(value, bool):
+        return value
+    if isinstance(value, ctypes.c_void_p):
+        return value.value
+    return None
+
+
+def _flat_storage(storage: Any, context: str) -> List[Any]:
+    if isinstance(storage, HostTensor):
+        return list(storage.data)
+    if isinstance(storage, FlatBuffer):
+        return list(storage.data)
+    if isinstance(storage, (str, bytes, bytearray, Mapping)) or storage is None:
+        raise CpuAvx2ExecutionError("{} storage must be a flat sequence".format(context))
+    if isinstance(storage, (list, tuple)):
+        return list(flatten_values(storage))
+    if hasattr(storage, "data") and isinstance(storage.data, (list, tuple)):
+        return list(storage.data)
+    try:
+        return [storage[index] for index in range(len(storage))]
+    except (TypeError, IndexError, KeyError, AttributeError) as exc:
+        raise CpuAvx2ExecutionError("{} storage must support flat sequence access".format(context)) from exc
+
+
+def _buffer_from_values(dtype: str, values: Sequence[Any], context: str) -> _NativeBuffer:
+    dtype = canonical_dtype(dtype)
+    ctype = _ctype(dtype)
+    try:
+        array = (ctype * len(values))()
+        for index, value in enumerate(values):
+            array[index] = _bf16_bits(value) if dtype == "bf16" else float(value)
+    except (TypeError, ValueError, OverflowError, struct.error) as exc:
+        raise CpuAvx2ExecutionError("{} contains an invalid {} value".format(context, dtype)) from exc
+    return _NativeBuffer(dtype, len(values), ctypes.cast(array, _pointer(dtype)), array, False)
+
+
+def _buffer_from_raw(dtype: str, values: Sequence[Any], context: str) -> _NativeBuffer:
+    dtype = canonical_dtype(dtype)
+    if dtype == "bf16":
+        ctype = _ctype(dtype)
+        try:
+            array = (ctype * len(values))(*[int(value) & 0xFFFF for value in values])
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise CpuAvx2ExecutionError("{} contains invalid BF16 bits".format(context)) from exc
+        return _NativeBuffer(dtype, len(values), ctypes.cast(array, _pointer(dtype)), array, False)
+    return _buffer_from_values(dtype, values, context)
+
+
+def _buffer_from_descriptor(descriptor: TensorDesc, value_type: CoreType, context: str) -> _NativeBuffer:
+    expected_dtype = canonical_dtype(value_type.dtype)
+    descriptor_dtype = canonical_dtype(descriptor.dtype)
+    expected_shape = static_shape(value_type, context)
+    if descriptor_dtype != expected_dtype or descriptor.shape != expected_shape:
+        raise CpuAvx2ExecutionError(
+            "{} descriptor dtype/shape ({}, {}) does not match expected ({}, {})".format(
+                context, descriptor.dtype, descriptor.shape, expected_dtype, expected_shape
+            )
+        )
+    address = _address_value(descriptor.address)
+    if address is not None:
+        if address == 0:
+            raise CpuAvx2ExecutionError("{} descriptor address must not be null".format(context))
+        pointer = ctypes.cast(address, _pointer(expected_dtype))
+        return _NativeBuffer(expected_dtype, descriptor.element_count, pointer, None, True)
+    storage = descriptor.storage
+    array_interface = getattr(storage, "__array_interface__", None)
+    if isinstance(array_interface, Mapping):
+        data = array_interface.get("data")
+        if isinstance(data, (tuple, list)) and data and data[0]:
+            pointer = ctypes.cast(int(data[0]), _pointer(expected_dtype))
+            return _NativeBuffer(expected_dtype, descriptor.element_count, pointer, storage, True)
+    if isinstance(storage, ctypes.Array):
+        pointer = ctypes.cast(ctypes.addressof(storage), _pointer(expected_dtype))
+        return _NativeBuffer(expected_dtype, descriptor.element_count, pointer, storage, True)
+    values = _flat_storage(storage, context)
+    expected_count = element_count(expected_shape)
+    if len(values) != expected_count:
+        raise CpuAvx2ExecutionError(
+            "{} storage length {} does not match expected {}".format(context, len(values), expected_count)
+        )
+    return _buffer_from_values(expected_dtype, values, context)
+
+
+def _buffer_values(buffer: _NativeBuffer) -> List[Any]:
+    if buffer.dtype == "bf16":
+        return [_bf16_value(buffer.pointer[index]) for index in range(buffer.count)]
+    return [float(buffer.pointer[index]) for index in range(buffer.count)]
+
+
+def _buffer_raw(buffer: _NativeBuffer) -> List[Any]:
+    if buffer.dtype == "bf16":
+        return [int(buffer.pointer[index]) & 0xFFFF for index in range(buffer.count)]
+    return [float(buffer.pointer[index]) for index in range(buffer.count)]
+
+
+def _write_descriptor(descriptor: TensorDesc, buffer: _NativeBuffer, value_type: CoreType, context: str) -> None:
+    if descriptor.readonly:
+        raise CpuAvx2ExecutionError("{} output descriptor is read-only".format(context))
+    expected_dtype = canonical_dtype(value_type.dtype)
+    expected_shape = static_shape(value_type, context)
+    if canonical_dtype(descriptor.dtype) != expected_dtype or descriptor.shape != expected_shape:
+        raise CpuAvx2ExecutionError("{} output descriptor dtype/shape mismatch".format(context))
+    if descriptor.address is not None:
+        destination = _buffer_from_descriptor(descriptor, value_type, context)
+        if destination.count:
+            ctypes.memmove(
+                ctypes.addressof(destination.pointer.contents),
+                ctypes.addressof(buffer.pointer.contents),
+                destination.count * ctypes.sizeof(_ctype(expected_dtype)),
+            )
+        return
+    storage = descriptor.storage
+    if isinstance(storage, ctypes.Array):
+        destination = _buffer_from_descriptor(descriptor, value_type, context)
+        if destination.count:
+            ctypes.memmove(
+                ctypes.addressof(destination.pointer.contents),
+                ctypes.addressof(buffer.pointer.contents),
+                destination.count * ctypes.sizeof(_ctype(expected_dtype)),
+            )
+        return
+    values = _buffer_values(buffer)
+    if isinstance(storage, HostTensor):
+        if storage.dtype != expected_dtype or storage.shape != expected_shape:
+            raise CpuAvx2ExecutionError("{} HostTensor metadata mismatch".format(context))
+        storage.data[:] = [_cast_value(value, expected_dtype) for value in values]
+        return
+    if isinstance(storage, FlatBuffer):
+        destination = storage.data
+    elif isinstance(storage, list):
+        destination = storage
+    elif hasattr(storage, "data") and isinstance(storage.data, list):
+        destination = storage.data
+    else:
+        destination = storage
+    try:
+        if len(destination) != len(values):
+            raise CpuAvx2ExecutionError("{} output storage length mismatch".format(context))
+        for index, value in enumerate(values):
+            destination[index] = _cast_value(value, expected_dtype)
+    except (TypeError, IndexError, AttributeError) as exc:
+        raise CpuAvx2ExecutionError("{} output storage is not mutable".format(context)) from exc
+
+
+def _symbol(module: Any, name: str, argument_types: Sequence[Any]) -> Any:
+    try:
+        function = getattr(module, name)
+    except AttributeError as exc:
+        raise CpuAvx2ArtifactError("native AVX2 artifact is missing symbol {!r}".format(name)) from exc
+    function.argtypes = list(argument_types)
+    function.restype = None
+    return function
+
+
+def _call_copy(module: Any, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx2_copy_{}".format(_native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), ctypes.c_size_t],
+    )
+    function(source.pointer, destination.pointer, source.count)
+
+
+def _call_unary(module: Any, name: str, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx2_{}_{}".format(name, _native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), ctypes.c_size_t],
+    )
+    function(source.pointer, destination.pointer, source.count)
+
+
+def _call_binary(
+    module: Any,
+    name: str,
+    dtype: str,
+    left: _NativeBuffer,
+    left_scalar: bool,
+    right: _NativeBuffer,
+    right_scalar: bool,
+    destination: _NativeBuffer,
+) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx2_binary_{}".format(_native_suffix(dtype)),
+        [ctypes.c_int, _pointer(dtype), ctypes.c_int, _pointer(dtype), ctypes.c_int, _pointer(dtype), ctypes.c_size_t],
+    )
+    operation_code = {"add": 0, "sub": 1, "mul": 2, "div": 3}[name]
+    function(
+        operation_code,
+        left.pointer,
+        int(left_scalar),
+        right.pointer,
+        int(right_scalar),
+        destination.pointer,
+        destination.count,
+    )
+
+
+def _call_reduce(module: Any, name: str, dtype: str, source: _NativeBuffer, destination: _NativeBuffer) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx2_{}_{}".format(name, _native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), ctypes.c_size_t],
+    )
+    function(source.pointer, destination.pointer, source.count)
+
+
+def _call_matmul(
+    module: Any,
+    dtype: str,
+    left: _NativeBuffer,
+    right: _NativeBuffer,
+    destination: _NativeBuffer,
+    m: int,
+    k: int,
+    n: int,
+) -> None:
+    function = _symbol(
+        module,
+        "ptx_avx2_matmul_{}".format(_native_suffix(dtype)),
+        [_pointer(dtype), _pointer(dtype), _pointer(dtype), ctypes.c_size_t, ctypes.c_size_t, ctypes.c_size_t],
+    )
+    function(left.pointer, right.pointer, destination.pointer, m, k, n)
+
+
+def _unravel(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
+    if not shape:
+        return ()
+    coordinates = [0] * len(shape)
+    remainder = index
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension == 0:
+            return tuple(coordinates)
+        coordinates[axis] = remainder % dimension
+        remainder //= dimension
+    return tuple(coordinates)
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _find_function(program: CoreProgram, entrypoint: str) -> CoreFunction:
+    for function in program.functions:
+        if function.name == entrypoint:
+            return function
+    raise CpuAvx2ExecutionError("entrypoint {!r} is not present in CoreProgram".format(entrypoint))
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _decode_artifact(artifact: Artifact, available: CpuFeatureSet, capability: Avx2Capability) -> LoadedAvx2Artifact:
+    if not isinstance(artifact, Artifact):
+        raise CpuAvx2ArtifactError("AVX2 runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CpuAvx2ArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.path is None:
+        raise CpuAvx2ArtifactError("AVX2 artifact must reference a native shared object path")
+    metadata = mapping_copy(artifact.metadata)
+    if metadata.get("backend") != AVX2_BACKEND:
+        raise CpuAvx2ArtifactError("artifact backend metadata is not cpu.avx2")
+    if metadata.get("native_isa") != "avx2" or metadata.get("native_format") != "elf-shared-object":
+        raise CpuAvx2ArtifactError("artifact native format is not an AVX2 shared object")
+    with open(artifact.path, "rb") as native_file:
+        actual_digest = hashlib.sha256(native_file.read()).hexdigest()
+    if actual_digest != artifact.content_digest or metadata.get("native_digest") != actual_digest:
+        raise CpuAvx2ArtifactError("native artifact content digest mismatch")
+    if metadata.get("entrypoint") != artifact.entrypoint:
+        raise CpuAvx2ArtifactError("AVX2 artifact entrypoint mismatch")
+    if metadata.get("artifact_payload_version") != 1:
+        raise CpuAvx2ArtifactError("unsupported AVX2 artifact payload version")
+    if metadata.get("lowering_version") != AVX2_LOWERING_VERSION:
+        raise CpuAvx2ArtifactError("unsupported AVX2 lowering version")
+    program_data = metadata.get("program")
+    plan_data = metadata.get("vector_plan")
+    if not isinstance(program_data, Mapping) or not isinstance(plan_data, Mapping):
+        raise CpuAvx2ArtifactError("AVX2 artifact is missing CoreProgram/vector plan metadata")
+    required_data = plan_data.get("required_features")
+    if not isinstance(required_data, Mapping):
+        raise CpuAvx2ArtifactError("AVX2 required_features metadata is invalid")
+    required = CpuFeatureSet(
+        required_data.get("features", ()),
+        source=required_data.get("source", metadata.get("required_feature_source", "artifact")),
+    )
+    try:
+        program = CoreProgram.from_dict(program_data)
+        target_ir = lower_avx2(
+            program,
+            artifact.target,
+            plan_data.get("entrypoint"),
+            lane_count=plan_data.get("lane_count"),
+            tail_policy=plan_data.get("tail_policy"),
+            required_features=required,
+            specialization=plan_data.get("specialization", {}),
+            use_fma=metadata.get("use_fma", False),
+        )
+    except Exception as exc:
+        raise CpuAvx2ArtifactError("AVX2 artifact CoreProgram/plan is invalid: {}".format(exc)) from exc
+    if target_ir.vector_program.to_dict() != dict(plan_data):
+        raise CpuAvx2ArtifactError("AVX2 vector plan metadata mismatch")
+    program_digest = hashlib.sha256(program.canonical_json().encode("utf-8")).hexdigest()
+    if metadata.get("program_digest") != program_digest:
+        raise CpuAvx2ArtifactError("AVX2 program digest mismatch")
+    if metadata.get("plan_digest") != target_ir.plan_digest:
+        raise CpuAvx2ArtifactError("AVX2 plan digest mismatch")
+    if metadata.get("target_digest") != sha256_text(artifact.target.to_dict()):
+        raise CpuAvx2ArtifactError("AVX2 target digest mismatch")
+    if tuple(metadata.get("required_features", ())) != tuple(required.features):
+        raise CpuAvx2ArtifactError("AVX2 required feature metadata mismatch")
+    if metadata.get("required_feature_source") != required.source:
+        raise CpuAvx2ArtifactError("AVX2 required feature source mismatch")
+    mismatch = CpuFeatureContract(required, available)
+    try:
+        mismatch.validate()
+    except CpuVectorFeatureMismatchError:
+        raise
+    try:
+        module = ctypes.CDLL(artifact.path)
+    except OSError as exc:
+        raise CpuAvx2ArtifactError("could not load AVX2 shared object: {}".format(exc)) from exc
+    return LoadedAvx2Artifact(artifact, target_ir, mismatch, module)
+
+
+class Avx2Runtime:
+    """AVX2 runtime using a CPUID-gated Clang shared object."""
+
+    name = AVX2_BACKEND
+
+    def __init__(
+        self,
+        available_features: Any = None,
+        capability: Optional[Avx2Capability] = None,
+        probe_directory: Optional[str] = None,
+    ) -> None:
+        if capability is not None and available_features is not None:
+            raise ValueError("capability and available_features are aliases; pass only one")
+        if capability is None and available_features is None:
+            try:
+                capability = _capabilities.probe_avx2_capabilities(directory=probe_directory)
+            except Exception as exc:
+                capability = Avx2Capability(
+                    False,
+                    (),
+                    "cpuid+osxsave+xgetbv",
+                    "probe_failed",
+                    str(exc),
+                    "clang",
+                    "unknown",
+                    0,
+                    0,
+                    0,
+                    0,
+                    0,
+                    False,
+                    False,
+                    False,
+                    False,
+                    False,
+                    False,
+                )
+        elif capability is None:
+            capability = Avx2Capability.injected_capability(available_features, source="injected")
+        self.capability = capability
+        self.available_features = CpuFeatureSet(capability.features, source=capability.source)
+        if capability.available:
+            self._status = Availability.yes(self.name)
+        else:
+            self._status = Availability.no(
+                self.name,
+                capability.reason or "AVX2 CPUID/XGETBV capability is unavailable",
+                capability.reason_code or "missing_cpu_features",
+                capability.to_dict(),
+            )
+
+    def availability(self) -> Availability:
+        return self._status
+
+    def is_available(self) -> bool:
+        return self._status.available
+
+    def load(self, artifact: Artifact, available_features: Any = None) -> LoadedAvx2Artifact:
+        if not self.is_available():
+            raise CpuAvx2UnavailableError(self._status)
+        available = self.available_features if available_features is None else CpuFeatureSet(
+            available_features, source="injected"
+        )
+        return _decode_artifact(artifact, available, self.capability)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, LaunchRequest):
+            raise CpuAvx2ExecutionError("workspace_size requires LaunchRequest")
+        self.load(request.artifact)
+        return 0
+
+    def launch(self, request: LaunchRequest) -> Tuple[Any, ...]:
+        if not isinstance(request, LaunchRequest):
+            raise CpuAvx2ExecutionError("AVX2 launch requires LaunchRequest")
+        if not self.is_available():
+            raise CpuAvx2UnavailableError(self._status)
+        try:
+            request.validate()
+        except Exception as exc:
+            raise CpuAvx2ExecutionError("invalid LaunchRequest: {}".format(exc)) from exc
+        loaded = self.load(request.artifact)
+        target = loaded.target_ir.target
+        if target.kind != "cpu" or not target.triple.startswith(("x86_64", "amd64")):
+            raise CpuAvx2ExecutionError("AVX2 artifact target must be x86_64 CPU")
+        for descriptor in request.inputs + request.outputs:
+            if descriptor.device != "cpu":
+                raise CpuAvx2ExecutionError("AVX2 requires cpu tensor descriptors")
+            if descriptor.strides != _contiguous_strides(descriptor.shape):
+                raise CpuAvx2ExecutionError("AVX2 requires contiguous tensor descriptors")
+        function = _find_function(loaded.target_ir.program, loaded.target_ir.entrypoint)
+        tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+        tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+        if len(request.inputs) != len(tensor_parameters):
+            raise CpuAvx2ExecutionError("AVX2 input tensor count does not match function")
+        if len(request.outputs) != len(tensor_returns):
+            raise CpuAvx2ExecutionError("AVX2 output tensor count does not match function")
+        for descriptor in request.outputs:
+            if descriptor.readonly:
+                raise CpuAvx2ExecutionError("AVX2 output descriptor is read-only")
+        environment: Dict[str, _RuntimeValue] = {}
+        input_index = 0
+        for parameter in function.parameters:
+            if _is_tensor(parameter.type):
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _buffer_from_descriptor(request.inputs[input_index], parameter.type, parameter.name),
+                )
+                input_index += 1
+            elif _is_scalar(parameter.type):
+                if parameter.name not in request.scalars:
+                    raise CpuAvx2ExecutionError("missing scalar input {!r}".format(parameter.name))
+                environment[parameter.name] = _RuntimeValue(
+                    parameter.type,
+                    _buffer_from_values(
+                        canonical_dtype(parameter.type.dtype),
+                        [request.scalars[parameter.name]],
+                        parameter.name,
+                    ),
+                )
+            else:
+                raise CpuAvx2ExecutionError("unsupported parameter kind {!r}".format(parameter.type.kind))
+        if len(loaded.target_ir.plans) != len(function.body.operations):
+            raise CpuAvx2ArtifactError("AVX2 plan count does not match operation count")
+        for operation, plan in zip(function.body.operations, loaded.target_ir.plans):
+            self._execute_operation(operation, plan, environment, loaded.module)
+        results: List[Any] = []
+        output_index = 0
+        for result_ref in function.returns:
+            if result_ref.name not in environment:
+                raise CpuAvx2ExecutionError("return value {!r} was not produced".format(result_ref.name))
+            result = environment[result_ref.name]
+            if _is_tensor(result_ref.type):
+                descriptor = request.outputs[output_index]
+                _write_descriptor(descriptor, result.buffer, result_ref.type, result_ref.name)
+                results.append(descriptor.storage)
+                output_index += 1
+            else:
+                values = _buffer_values(result.buffer)
+                results.append(values[0] if values else None)
+        return tuple(results)
+
+    def _execute_operation(
+        self,
+        operation: Operation,
+        plan: Any,
+        environment: Dict[str, _RuntimeValue],
+        module: Any,
+    ) -> None:
+        name = canonical_operation_name(operation.name)
+        if plan.operation != name:
+            raise CpuAvx2ArtifactError("AVX2 operation does not match vector plan")
+        inputs = []
+        for ref in operation.inputs:
+            if ref.name not in environment:
+                raise CpuAvx2ExecutionError("AVX2 input {!r} is unavailable".format(ref.name))
+            inputs.append(environment[ref.name])
+        output_ref = operation.outputs[0]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        try:
+            if name == "constant":
+                raw = operation.attributes.get("value", operation.attributes.get("values"))
+                values = [raw] if _is_scalar(output_ref.type) else list(flatten_values(raw))
+                environment[output_ref.name] = _RuntimeValue(
+                    output_ref.type, _buffer_from_values(dtype, values, output_ref.name)
+                )
+            elif name == "identity":
+                source = inputs[0].buffer
+                destination = _buffer_from_values(dtype, [0] * source.count, output_ref.name)
+                _call_copy(module, dtype, source, destination)
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            elif name in ("add", "sub", "mul", "div"):
+                left, right = inputs
+                if name == "div" and any(value == 0 for value in _buffer_values(right.buffer)):
+                    raise CpuAvx2ExecutionError("division by zero")
+                destination = _buffer_from_values(dtype, [0] * plan.element_count, output_ref.name)
+                _call_binary(
+                    module,
+                    name,
+                    dtype,
+                    left.buffer,
+                    _is_scalar(left.type),
+                    right.buffer,
+                    _is_scalar(right.type),
+                    destination,
+                )
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            elif name == "neg":
+                source = inputs[0].buffer
+                destination = _buffer_from_values(dtype, [0] * plan.element_count, output_ref.name)
+                _call_unary(module, "neg", dtype, source, destination)
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            elif name in ("reduce_sum", "reduce_max"):
+                result = self._execute_reduction(name, inputs[0], output_ref.type, plan, module, output_ref.name)
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, result)
+            elif name == "matmul":
+                matmul = plan.matmul
+                destination = _buffer_from_values(dtype, [0] * matmul.output_elements, output_ref.name)
+                _call_matmul(
+                    module,
+                    dtype,
+                    inputs[0].buffer,
+                    inputs[1].buffer,
+                    destination,
+                    matmul.m,
+                    matmul.k,
+                    matmul.n,
+                )
+                environment[output_ref.name] = _RuntimeValue(output_ref.type, destination)
+            else:
+                raise CpuAvx2ExecutionError("AVX2 operation {!r} is unsupported".format(operation.name))
+        except CpuAvx2RuntimeError:
+            raise
+        except (TypeError, ValueError, OverflowError, ZeroDivisionError) as exc:
+            raise CpuAvx2ExecutionError("AVX2 operation {} failed: {}".format(name, exc)) from exc
+
+    def _execute_reduction(
+        self,
+        name: str,
+        value: _RuntimeValue,
+        output_type: CoreType,
+        plan: Any,
+        module: Any,
+        context: str,
+    ) -> _NativeBuffer:
+        reduction = plan.reduction
+        input_shape = reduction.input_shape
+        output_shape = reduction.output_shape
+        input_values = _buffer_raw(value.buffer)
+        if len(input_values) != element_count(input_shape):
+            raise CpuAvx2ExecutionError("{} reduction input length mismatch".format(context))
+        output = _buffer_from_values(canonical_dtype(output_type.dtype), [0] * reduction.output_elements, context)
+        for output_index in range(reduction.output_elements):
+            output_coords = _unravel(output_index, output_shape)
+            candidates = []
+            for input_index in range(len(input_values)):
+                input_coords = _unravel(input_index, input_shape)
+                if reduction.keepdims:
+                    projected = tuple(
+                        0 if axis in reduction.axes else input_coords[axis]
+                        for axis in range(len(input_shape))
+                    )
+                else:
+                    projected = tuple(
+                        input_coords[axis]
+                        for axis in range(len(input_shape))
+                        if axis not in reduction.axes
+                    )
+                if projected == output_coords:
+                    candidates.append(input_values[input_index])
+            if len(candidates) != reduction.reduction_size:
+                raise CpuAvx2ExecutionError("{} reduction group length mismatch".format(context))
+            if not candidates:
+                if name == "reduce_sum":
+                    if output.dtype == "bf16":
+                        output.pointer[output_index] = _bf16_bits(0.0)
+                    else:
+                        output.pointer[output_index] = 0.0
+                    continue
+                raise CpuAvx2ExecutionError("reduce_max has an empty reduction group")
+            group = _buffer_from_raw(value.buffer.dtype, candidates, context + ".group")
+            result = _buffer_from_values(output.dtype, [0], context + ".result")
+            _call_reduce(module, name, output.dtype, group, result)
+            output.pointer[output_index] = result.pointer[0]
+        return output
+
+
+CpuAvx2Backend = Avx2Runtime
+CPUAVX2Runtime = Avx2Runtime
+CPUAvx2Runtime = Avx2Runtime
+CpuAvx2FeatureMismatchError = CpuVectorFeatureMismatchError
+
+
+def launch_avx2(request: LaunchRequest, available_features: Any = None) -> Tuple[Any, ...]:
+    return Avx2Runtime(available_features).launch(request)
+
+
+__all__ = [
+    "Avx2Runtime",
+    "CPUAVX2Runtime",
+    "CPUAvx2Runtime",
+    "CpuAvx2ArtifactError",
+    "CpuAvx2Backend",
+    "CpuAvx2ExecutionError",
+    "CpuAvx2FeatureMismatchError",
+    "CpuAvx2RuntimeError",
+    "CpuAvx2UnavailableError",
+    "LoadedAvx2Artifact",
+    "launch_avx2",
+]
