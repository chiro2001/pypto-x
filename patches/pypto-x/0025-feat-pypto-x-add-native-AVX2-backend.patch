+"""AVX2 host capability probing for PyPTO-X.
+
+The probe intentionally does not inspect ``/proc/cpuinfo``.  It uses a tiny
+Clang-built helper which executes CPUID and, only after CPUID advertises
+OSXSAVE, XGETBV.  This keeps the Python layer portable and makes the result
+injectable in tests without ever executing an AVX2 artifact on an unknown
+host.
+"""
+
+from __future__ import annotations
+
+import ctypes
+from dataclasses import dataclass
+from functools import lru_cache
+import os
+from pathlib import Path
+import shutil
+import subprocess
+from typing import Any, Mapping, Optional, Tuple
+
+
+_PROBE_SOURCE = r'''
+#include <stdint.h>
+
+static void ptx_cpuid(uint32_t leaf, uint32_t subleaf,
+                      uint32_t *eax, uint32_t *ebx,
+                      uint32_t *ecx, uint32_t *edx) {
+#if defined(__x86_64__) || defined(__i386__)
+    uint32_t a, b, c, d;
+    __asm__ volatile("cpuid"
+                     : "=a"(a), "=b"(b), "=c"(c), "=d"(d)
+                     : "a"(leaf), "c"(subleaf));
+    *eax = a;
+    *ebx = b;
+    *ecx = c;
+    *edx = d;
+#else
+    (void)leaf; (void)subleaf;
+    *eax = 0; *ebx = 0; *ecx = 0; *edx = 0;
+#endif
+}
+
+static uint64_t ptx_xgetbv0(void) {
+#if defined(__x86_64__) || defined(__i386__)
+    uint32_t eax, edx;
+    __asm__ volatile(".byte 0x0f, 0x01, 0xd0"
+                     : "=a"(eax), "=d"(edx) : "c"(0));
+    return ((uint64_t)edx << 32) | eax;
+#else
+    return 0;
+#endif
+}
+
+/* out[0..8] = max leaf, leaf1 ECX/EDX, leaf7 EBX, xcr0,
+ *             osxsave, xgetbv_valid, avx, avx2, fma. */
+void ptx_probe(uint64_t *out) {
+    uint32_t max_leaf, eax, ebx, ecx, edx;
+    uint64_t xcr0 = 0;
+    uint32_t osxsave = 0, xgetbv_valid = 0;
+    uint32_t avx = 0, avx2 = 0, fma = 0;
+    ptx_cpuid(0, 0, &max_leaf, &ebx, &ecx, &edx);
+    out[0] = max_leaf;
+    out[1] = out[2] = out[3] = out[4] = 0;
+    out[5] = out[6] = out[7] = out[8] = 0;
+    if (max_leaf >= 1) {
+        ptx_cpuid(1, 0, &eax, &ebx, &ecx, &edx);
+        out[1] = ecx;
+        out[2] = edx;
+        osxsave = (ecx >> 27) & 1U;
+        avx = (ecx >> 28) & 1U;
+        fma = (ecx >> 12) & 1U;
+        out[5] = osxsave;
+        if (osxsave) {
+            xcr0 = ptx_xgetbv0();
+            xgetbv_valid = 1;
+        }
+    }
+    out[4] = xcr0;
+    out[6] = xgetbv_valid;
+    if (max_leaf >= 7) {
+        ptx_cpuid(7, 0, &eax, &ebx, &ecx, &edx);
+        out[3] = ebx;
+        avx2 = (ebx >> 5) & 1U;
+    }
+    out[7] = avx;
+    out[8] = avx2;
+    out[9] = fma;
+}
+'''
+
+
+class Avx2ProbeError(RuntimeError):
+    """The host capability probe could not be built or executed."""
+
+
+@dataclass(frozen=True)
+class Avx2Capability:
+    """A structured CPUID/XGETBV result.
+
+    ``available`` means that the minimum AVX2 execution contract (AVX, AVX2,
+    OSXSAVE and XMM/YMM state support) is satisfied.  FMA is deliberately a
+    separate feature because an artifact must opt into it explicitly.
+    """
+
+    available: bool
+    features: Tuple[str, ...]
+    source: str
+    reason_code: Optional[str]
+    reason: Optional[str]
+    compiler: str
+    target_triple: str
+    max_basic_leaf: int
+    leaf1_ecx: int
+    leaf1_edx: int
+    leaf7_ebx: int
+    xcr0: int
+    osxsave: bool
+    xgetbv_valid: bool
+    avx: bool
+    avx2: bool
+    fma: bool
+    injected: bool = False
+
+    @property
+    def ymm_state(self) -> bool:
+        return bool(self.osxsave and self.xgetbv_valid and (self.xcr0 & 0x6) == 0x6)
+
+    @property
+    def zmm_state(self) -> bool:
+        return bool(self.ymm_state and (self.xcr0 & 0xE0) == 0xE0)
+
+    @classmethod
+    def injected_capability(
+        cls,
+        features: Any = ("avx", "avx2", "fma", "osxsave", "ymm"),
+        source: str = "injected",
+    ) -> "Avx2Capability":
+        if isinstance(features, str):
+            features = (features,)
+        names = tuple(sorted({str(value).strip().lower() for value in features if str(value).strip()}))
+        avx = "avx" in names or "avx2" in names
+        avx2 = "avx2" in names
+        fma = "fma" in names
+        osxsave = "osxsave" in names
+        ymm = "ymm" in names
+        available = avx and avx2 and osxsave and ymm
+        return cls(
+            available,
+            names,
+            source,
+            None if available else "missing_cpu_features",
+            None if available else "injected capability lacks AVX2/YMM support",
+            "injected",
+            "injected",
+            7 if avx2 else 0,
+            0,
+            0,
+            1 << 5 if avx2 else 0,
+            0x6 if ymm else 0,
+            osxsave,
+            ymm,
+            avx,
+            avx2,
+            fma,
+            True,
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "available": self.available,
+            "features": list(self.features),
+            "source": self.source,
+            "reason_code": self.reason_code,
+            "reason": self.reason,
+            "compiler": self.compiler,
+            "target_triple": self.target_triple,
+            "max_basic_leaf": self.max_basic_leaf,
+            "leaf1_ecx": self.leaf1_ecx,
+            "leaf1_edx": self.leaf1_edx,
+            "leaf7_ebx": self.leaf7_ebx,
+            "xcr0": self.xcr0,
+            "osxsave": self.osxsave,
+            "xgetbv_valid": self.xgetbv_valid,
+            "ymm_state": self.ymm_state,
+            "zmm_state": self.zmm_state,
+            "avx": self.avx,
+            "avx2": self.avx2,
+            "fma": self.fma,
+            "injected": self.injected,
+        }
+
+
+def _plain_output(values: Any) -> Tuple[int, ...]:
+    return tuple(int(values[index]) for index in range(10))
+
+
+def _tool_info(compiler: str) -> Tuple[str, str]:
+    version = subprocess.run(
+        [compiler, "--version"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    ).stdout.splitlines()
+    triple_result = subprocess.run(
+        [compiler, "-print-target-triple"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    compiler_text = version[0].strip() if version else compiler
+    triple = triple_result.stdout.strip() or "unknown"
+    return compiler_text, triple
+
+
+def _probe_directory(directory: Optional[Any]) -> Path:
+    selected = directory or os.environ.get("PYPTO_X_AVX2_PROBE_DIR")
+    if selected is None:
+        selected = os.environ.get("TMPDIR")
+    if selected is None:
+        selected = os.path.join(os.path.abspath(os.path.expanduser("~")), ".cache", "pypto-x", "avx2-probe")
+    path = Path(os.fspath(selected)).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _build_probe(compiler: str, directory: Path) -> Path:
+    source_path = directory / "cpuid_probe.c"
+    output_path = directory / "cpuid_probe.so"
+    source_path.write_text(_PROBE_SOURCE, encoding="utf-8")
+    temporary = directory / "tmp"
+    temporary.mkdir(parents=True, exist_ok=True)
+    env = dict(os.environ)
+    env["TMPDIR"] = str(temporary)
+    command = [compiler, "-shared", "-fPIC", "-O2", "-std=c99", str(source_path), "-o", str(output_path)]
+    result = subprocess.run(
+        command,
+        cwd=str(directory),
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        universal_newlines=True,
+        check=False,
+    )
+    if result.returncode != 0 or not output_path.is_file():
+        raise Avx2ProbeError(
+            "CPUID/XGETBV probe compilation failed: {}".format((result.stderr or result.stdout).strip())
+        )
+    return output_path
+
+
+def _run_probe(compiler: str, directory: Optional[Any]) -> Avx2Capability:
+    compiler_path = shutil.which(compiler) or compiler
+    if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
+        raise Avx2ProbeError("Clang compiler {!r} was not found".format(compiler))
+    compiler_text, triple = _tool_info(compiler_path)
+    output_path = _build_probe(compiler_path, _probe_directory(directory))
+    library = ctypes.CDLL(str(output_path))
+    function = library.ptx_probe
+    function.argtypes = [ctypes.POINTER(ctypes.c_uint64)]
+    function.restype = None
+    values = (ctypes.c_uint64 * 10)()
+    function(values)
+    max_leaf, leaf1_ecx, leaf1_edx, leaf7_ebx, xcr0, osxsave, xgetbv_valid, avx, avx2, fma = _plain_output(values)
+    ymm = bool(osxsave and xgetbv_valid and (xcr0 & 0x6) == 0x6)
+    features = []
+    if avx:
+        features.append("avx")
+    if avx2:
+        features.append("avx2")
+    if fma:
+        features.append("fma")
+    if osxsave:
+        features.append("osxsave")
+    if ymm:
+        features.append("ymm")
+    available = bool(avx and avx2 and ymm)
+    reason = None if available else "CPUID/XGETBV did not provide AVX2 with OS YMM state"
+    return Avx2Capability(
+        available,
+        tuple(features),
+        "cpuid+osxsave+xgetbv",
+        None if available else "missing_cpu_features",
+        reason,
+        compiler_text,
+        triple,
+        max_leaf,
+        leaf1_ecx,
+        leaf1_edx,
+        leaf7_ebx,
+        xcr0,
+        bool(osxsave),
+        bool(xgetbv_valid),
+        bool(avx),
+        bool(avx2),
+        bool(fma),
+        False,
+    )
+
+
+@lru_cache(maxsize=4)
+def probe_avx2_capabilities(compiler: str = "clang", directory: Optional[str] = None) -> Avx2Capability:
+    """Probe real x86 capability using CPUID and XGETBV.
+
+    The cache is keyed by compiler and directory so unit tests can select an
+    isolated build location.  No Linux flag file is consulted.
+    """
+
+    return _run_probe(compiler, directory)
+
+
+probe_avx2 = probe_avx2_capabilities
+
+
+__all__ = ["Avx2Capability", "Avx2ProbeError", "probe_avx2", "probe_avx2_capabilities"]
