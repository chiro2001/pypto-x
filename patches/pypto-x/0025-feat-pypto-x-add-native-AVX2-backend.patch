+"""W3 AVX2 native compiler/runtime tests.
+
+The tests keep imports isolated from the upstream native initializer and use
+only the standard library plus pytest.  Native build output is directed to a
+pytest-owned temporary directory; the production task also records a host
+smoke and an objdump report outside the source worktree.
+"""
+
+from __future__ import annotations
+
+import ctypes
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import types
+
+import pytest
+
+
+def _imports():
+    package_root = Path(__file__).parents[3] / "pypto"
+    saved = {name: module for name, module in sys.modules.items() if name == "pypto" or name.startswith("pypto.")}
+    for name in list(saved):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    sys.modules["pypto"] = package
+    try:
+        from pypto.abi import LaunchRequest, TensorDesc
+        from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+        from pypto.backends.cpu.x86 import Avx2Runtime, CpuAvx2ArtifactError, CpuAvx2ExecutionError
+        from pypto.compiler import CompileOptions
+        from pypto.compiler.targets.cpu import CpuScalarCompiler
+        from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+        from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+        from pypto.lowering.cpu.x86.avx2 import Avx2Capability, Avx2UnsupportedError, lower_avx2
+        from pypto.target import TargetSpec
+        return locals()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved)
+
+
+_C = _imports()
+LaunchRequest = _C["LaunchRequest"]
+TensorDesc = _C["TensorDesc"]
+CpuScalarRuntime = _C["CpuScalarRuntime"]
+HostTensor = _C["HostTensor"]
+Avx2Runtime = _C["Avx2Runtime"]
+CpuAvx2ArtifactError = _C["CpuAvx2ArtifactError"]
+CpuAvx2ExecutionError = _C["CpuAvx2ExecutionError"]
+CompileOptions = _C["CompileOptions"]
+CpuScalarCompiler = _C["CpuScalarCompiler"]
+Avx2Compiler = _C["Avx2Compiler"]
+CoreFunction = _C["CoreFunction"]
+CoreProgram = _C["CoreProgram"]
+CoreType = _C["CoreType"]
+Operation = _C["Operation"]
+Region = _C["Region"]
+ValueRef = _C["ValueRef"]
+Avx2Capability = _C["Avx2Capability"]
+Avx2UnsupportedError = _C["Avx2UnsupportedError"]
+lower_avx2 = _C["lower_avx2"]
+TargetSpec = _C["TargetSpec"]
+
+
+def _program(name, parameters, returns, operations):
+    return CoreProgram(functions=(CoreFunction(name, parameters, returns, Region(tuple(operations))),))
+
+
+def _target(*features, use_fma=None):
+    attributes = {"lane_count": 8}
+    if use_fma is not None:
+        attributes["use_fma"] = use_fma
+    return TargetSpec("cpu", "x86_64-linux-gnu", features=features, attributes=attributes)
+
+
+def _add_program(dtype="float32", shape=(11,)):
+    value_type = CoreType.tensor(dtype, shape)
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    return _program("add", (left, right), (output,), (Operation("add", (left, right), (output,)),))
+
+
+def _compile(program, target, tmp_path):
+    compiler = Avx2Compiler()
+    options = CompileOptions(extra={"build_dir": str(tmp_path / "native")})
+    target_ir = compiler.lower(program, target)
+    return compiler, target_ir, compiler.compile(target_ir, options)
+
+
+def _runtime():
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2/YMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _run(artifact, inputs, output, runtime=None):
+    (runtime or _runtime()).launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[output.descriptor()],
+        )
+    )
+
+
+def test_cpuid_xgetbv_probe_has_structured_host_result():
+    runtime = Avx2Runtime()
+    status = runtime.availability().to_dict()
+    assert "details" in status
+    assert runtime.capability.source in ("cpuid+osxsave+xgetbv", "injected")
+    if runtime.capability.source == "cpuid+osxsave+xgetbv":
+        assert "proc" not in runtime.capability.source
+        assert runtime.capability.compiler
+        assert runtime.capability.target_triple
+        assert isinstance(runtime.capability.xcr0, int)
+
+
+@pytest.mark.parametrize("length", (0, 1, 7, 8, 9, 19))
+def test_elementwise_lengths_differential_against_scalar(length, tmp_path):
+    program = _add_program(shape=(length,))
+    target = _target("avx2", "fma")
+    compiler, _, artifact = _compile(program, target, tmp_path)
+    runtime = _runtime()
+    left = HostTensor("float32", (length,), [float(index) for index in range(length)])
+    right = HostTensor("float32", (length,), [1.25] * length)
+    avx_output = HostTensor.zeros("float32", (length,))
+    _run(artifact, [left, right], avx_output, runtime)
+    scalar_target = TargetSpec("cpu", "x86_64-linux-gnu")
+    scalar_compiler = CpuScalarCompiler()
+    scalar_artifact = scalar_compiler.compile(
+        scalar_compiler.lower(program, scalar_target),
+    )
+    scalar_output = HostTensor.zeros("float32", (length,))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            scalar_artifact,
+            inputs=[left.descriptor(readonly=True), right.descriptor(readonly=True)],
+            outputs=[scalar_output.descriptor()],
+        )
+    )
+    assert avx_output.flat() == scalar_output.flat()
+    assert artifact.metadata["native_isa"] == "avx2"
+    assert compiler.lower(program, target).lane_count == 8
+
+
+def test_non_aligned_float32_addresses_use_safe_load_store(tmp_path):
+    program = _add_program(shape=(9,))
+    _, _, artifact = _compile(program, _target("avx2"), tmp_path)
+    runtime = _runtime()
+    raw_left = (ctypes.c_ubyte * (9 * 4 + 1))()
+    raw_right = (ctypes.c_ubyte * (9 * 4 + 1))()
+    raw_output = (ctypes.c_ubyte * (9 * 4 + 1))()
+    left_address = ctypes.addressof(raw_left) + 1
+    right_address = ctypes.addressof(raw_right) + 1
+    output_address = ctypes.addressof(raw_output) + 1
+    left_pointer = ctypes.cast(left_address, ctypes.POINTER(ctypes.c_float))
+    right_pointer = ctypes.cast(right_address, ctypes.POINTER(ctypes.c_float))
+    output_pointer = ctypes.cast(output_address, ctypes.POINTER(ctypes.c_float))
+    for index in range(9):
+        left_pointer[index] = float(index)
+        right_pointer[index] = 2.0
+        output_pointer[index] = -1.0
+    request = LaunchRequest(
+        artifact,
+        inputs=[
+            TensorDesc("float32", (9,), address=left_address, readonly=True),
+            TensorDesc("float32", (9,), address=right_address, readonly=True),
+        ],
+        outputs=[TensorDesc("float32", (9,), address=output_address)],
+    )
+    runtime.launch(request)
+    assert [output_pointer[index] for index in range(9)] == [float(index + 2) for index in range(9)]
+
+
+def test_bf16_round_to_nearest_even_and_fp32_accumulation(tmp_path):
+    value_type = CoreType.tensor("bf16", (9,))
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    program = _program("mul", (left, right), (output,), (Operation("mul", (left, right), (output,)),))
