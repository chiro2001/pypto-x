--- /dev/null
+++ b/python/pypto/lowering/cpu/x86/avx2/lowering.py
@@ -0,0 +1,213 @@
+"""AVX2 target lowering built on the ISA-neutral CPU vector plan."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu import canonical_dtype
+from pypto.lowering.cpu.vector import (
+    CpuFeatureSet,
+    CpuVectorProgram,
+    lower_cpu_vector,
+)
+from pypto.target import TargetSpec
+
+
+AVX2_BACKEND = "cpu.avx2"
+AVX2_LOWERING_VERSION = 1
+AVX2_LANE_COUNT = 8
+_ISA_FEATURES = frozenset(("avx", "avx2", "fma", "osxsave", "ymm"))
+
+
+class Avx2Error(ValueError):
+    """Base class for AVX2 lowering errors."""
+
+
+class Avx2ValidationError(Avx2Error):
+    """The target or vector plan violates the AVX2 contract."""
+
+
+class Avx2UnsupportedError(Avx2Error):
+    """The validated scalar subset is not implemented by AVX2."""
+
+
+def _feature_values(value: Any) -> tuple:
+    if isinstance(value, CpuFeatureSet):
+        return value.features
+    if value is None:
+        return ()
+    if isinstance(value, str):
+        return (value.strip().lower(),)
+    try:
+        return tuple(str(item).strip().lower() for item in value if str(item).strip())
+    except TypeError as exc:
+        raise Avx2ValidationError("required_features must be a feature sequence") from exc
+
+
+def _target_lane_count(target: TargetSpec) -> Optional[int]:
+    for key in ("lane_count", "vector_lanes", "vector_lane_count", "vector_block_elements", "vector_width"):
+        if key in target.attributes:
+            value = target.attributes[key]
+            if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+                raise Avx2ValidationError("target.attributes[{}] must be a positive integer".format(key))
+            return value
+    return None
+
+
+def _use_fma(target: TargetSpec, requested: Optional[bool]) -> bool:
+    if requested is not None:
+        if not isinstance(requested, bool):
+            raise Avx2ValidationError("use_fma must be bool")
+        return requested
+    attribute = target.attributes.get("use_fma")
+    if attribute is not None:
+        if not isinstance(attribute, bool):
+            raise Avx2ValidationError("target.attributes[use_fma] must be bool")
+        return attribute
+    return "fma" in target.features
+
+
+@dataclass(frozen=True)
+class Avx2Program:
+    """Validated AVX2 target IR plus its vector-common plan."""
+
+    vector_program: CpuVectorProgram
+    use_fma: bool
+    lowering_version: int = AVX2_LOWERING_VERSION
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.vector_program, CpuVectorProgram):
+            raise Avx2ValidationError("AVX2 program requires CpuVectorProgram")
+        if not isinstance(self.use_fma, bool):
+            raise Avx2ValidationError("AVX2 use_fma must be bool")
+        if self.lowering_version != AVX2_LOWERING_VERSION:
+            raise Avx2ValidationError("unsupported AVX2 lowering version {!r}".format(self.lowering_version))
+        if self.vector_program.target.kind != "cpu":
+            raise Avx2ValidationError("AVX2 target requires kind='cpu'")
+        if not self.vector_program.target.triple.startswith(("x86_64", "amd64")):
+            raise Avx2ValidationError("AVX2 target requires an x86_64 triple")
+        if self.vector_program.lane_count != AVX2_LANE_COUNT:
+            raise Avx2ValidationError("AVX2 requires {} float32 lanes".format(AVX2_LANE_COUNT))
+        required = set(self.vector_program.required_features.features)
+        if "avx2" not in required:
+            raise Avx2ValidationError("AVX2 vector plan must require avx2")
+        if self.use_fma and "fma" not in required:
+            raise Avx2ValidationError("FMA artifact must declare the fma feature")
+        for plan in self.vector_program.plans:
+            if canonical_dtype(plan.dtype) not in ("float32", "bf16"):
+                raise Avx2UnsupportedError(
+                    "AVX2 supports float32 and bf16 plans, got {!r}".format(plan.dtype)
+                )
+
+    @property
+    def program(self) -> CoreProgram:
+        return self.vector_program.program
+
+    @property
+    def target(self) -> TargetSpec:
+        return self.vector_program.target
+
+    @property
+    def entrypoint(self) -> str:
+        return self.vector_program.entrypoint
+
+    @property
+    def required_features(self) -> CpuFeatureSet:
+        return self.vector_program.required_features
+
+    @property
+    def lane_count(self) -> int:
+        return self.vector_program.lane_count
+
+    @property
+    def plans(self):
+        return self.vector_program.plans
+
+    @property
+    def plan_digest(self) -> str:
+        return self.vector_program.plan_digest
+
+    def validate(self) -> "Avx2Program":
+        self.vector_program.validate()
+        Avx2Program(self.vector_program, self.use_fma, self.lowering_version)
+        return self
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "backend": AVX2_BACKEND,
+            "lowering_version": self.lowering_version,
+            "use_fma": self.use_fma,
+            "vector_plan": self.vector_program.to_dict(),
+        }
+
+
+def lower_avx2(
+    program: CoreProgram,
+    target: TargetSpec,
+    entrypoint: Optional[str] = None,
+    *,
+    lane_count: Optional[int] = None,
+    tail_policy: Any = None,
+    required_features: Any = None,
+    specialization: Optional[Mapping[str, Any]] = None,
+    use_fma: Optional[bool] = None,
+) -> Avx2Program:
+    """Lower Core IR through vector-common and constrain it to AVX2."""
+
+    if not isinstance(target, TargetSpec):
+        raise Avx2ValidationError("AVX2 lowering requires TargetSpec")
+    if target.kind != "cpu":
+        raise Avx2ValidationError("AVX2 target requires kind='cpu', got {!r}".format(target.kind))
+    if not target.triple.startswith(("x86_64", "amd64")):
+        raise Avx2ValidationError("AVX2 target requires an x86_64 triple, got {!r}".format(target.triple))
+    selected_lanes = _target_lane_count(target) if lane_count is None else lane_count
+    if selected_lanes is not None and selected_lanes != AVX2_LANE_COUNT:
+        raise Avx2ValidationError("AVX2 requires lane_count={} (got {!r})".format(AVX2_LANE_COUNT, selected_lanes))
+    fma = _use_fma(target, use_fma)
+    explicit = _feature_values(required_features)
+    unsupported = sorted(set(explicit).difference(_ISA_FEATURES))
+    if unsupported:
+        raise Avx2UnsupportedError("AVX2 lowering received unsupported features: {}".format(", ".join(unsupported)))
+    if isinstance(required_features, CpuFeatureSet):
+        required = required_features
+    else:
+        features = list(explicit)
+        if "avx2" not in features:
+            features.append("avx2")
+        if fma and "fma" not in features:
+            features.append("fma")
+        required = CpuFeatureSet(tuple(features), source="compiler")
+    if "avx2" not in set(required.features) and "avx2" not in set(target.features):
+        raise Avx2ValidationError("AVX2 lowering could not establish the avx2 feature")
+    if fma and "fma" not in set(required.features) and "fma" not in set(target.features):
+        raise Avx2ValidationError("FMA lowering could not establish the fma feature")
+    vector_program = lower_cpu_vector(
+        program,
+        target,
+        entrypoint,
+        lane_count=AVX2_LANE_COUNT,
+        tail_policy=tail_policy,
+        required_features=required,
+        specialization=specialization,
+    )
+    result = Avx2Program(vector_program, fma)
+    result.validate()
+    return result
+
+
+lower = lower_avx2
+
+
+__all__ = [
+    "AVX2_BACKEND",
+    "AVX2_LANE_COUNT",
+    "AVX2_LOWERING_VERSION",
+    "Avx2Error",
+    "Avx2Program",
+    "Avx2UnsupportedError",
+    "Avx2ValidationError",
+    "lower",
+    "lower_avx2",
+]
