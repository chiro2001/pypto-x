+                outputs=[HostTensor.zeros("float32", (11,)).descriptor(readonly=True)],
+            )
+        )
+    wrong_target = TargetSpec("cuda", "x86_64-linux-gnu")
+    with pytest.raises(Exception):
+        lower_avx2(program, wrong_target)
+
