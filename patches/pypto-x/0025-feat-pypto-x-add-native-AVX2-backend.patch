+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            scalar_matmul_artifact,
+            inputs=[
+                HostTensor("bf16", (2, 3), left_values).descriptor(readonly=True),
+                HostTensor("bf16", (3, 9), right_values).descriptor(readonly=True),
+            ],
+            outputs=[scalar_matmul.descriptor()],
