Subject: [PATCH 199/250] tools: add A3 RSS sample summarizer

---
 tools/sve256_liveness_evidence/analyze_rss.py | 69 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/tools/sve256_liveness_evidence/analyze_rss.py b/tools/sve256_liveness_evidence/analyze_rss.py
new file mode 100644
index 000000000..08dfc5a33
--- /dev/null
+++ b/tools/sve256_liveness_evidence/analyze_rss.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""Summarise the A3 /proc/<pid>/status RSS samplers for both A/B legs."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from pathlib import Path
+
+ROW = re.compile(r"^(?P<ts>\S+) rss_kib=(?P<rss>\d+) hwm_kib=(?P<hwm>\d+)")
+
+
+def parse(path: Path):
+    samples = []
+    for line in path.read_text().splitlines():
+        match = ROW.match(line.strip())
+        if match:
+            samples.append(
+                {
+                    "ts": match.group("ts"),
+                    "rss_kib": int(match.group("rss")),
+                    "hwm_kib": int(match.group("hwm")),
+                }
+            )
+    return samples
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--disabled", required=True, type=Path)
+    parser.add_argument("--enabled", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--baseline-rss-mib", type=int, default=68218)
+    args = parser.parse_args()
+
+    result = {
+        "metric": "VmRSS/VmHWM from /proc/<pid>/status, sampled every 5 s",
+        "recorded_baseline_rss_mib": args.baseline_rss_mib,
+        "legs": {},
+    }
+    for label, path in (("disabled", args.disabled), ("enabled", args.enabled)):
+        samples = parse(path)
+        if not samples:
+            raise SystemExit("no samples parsed from {}".format(path))
+        hwm_peak = max(item["hwm_kib"] for item in samples)
+        rss_peak = max(item["rss_kib"] for item in samples)
+        result["legs"][label] = {
+            "samples": len(samples),
+            "first_ts": samples[0]["ts"],
+            "last_ts": samples[-1]["ts"],
+            "vmhwm_peak_kib": hwm_peak,
+            "vmhwm_peak_mib": round(hwm_peak / 1024),
+            "vmrss_peak_kib": rss_peak,
+            "vmrss_peak_mib": round(rss_peak / 1024),
+            "vmrss_median_mib": round(sorted(item["rss_kib"] for item in samples)[len(samples) // 2] / 1024),
+        }
+    disabled = result["legs"]["disabled"]["vmhwm_peak_mib"]
+    enabled = result["legs"]["enabled"]["vmhwm_peak_mib"]
+    result["delta_mib"] = disabled - enabled
+    result["reduction_ratio"] = round(disabled / enabled, 3) if enabled else None
+    result["vs_recorded_baseline_delta_mib"] = enabled - args.baseline_rss_mib
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2, ensure_ascii=False) + "\n")
+    print(json.dumps(result, indent=2, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
