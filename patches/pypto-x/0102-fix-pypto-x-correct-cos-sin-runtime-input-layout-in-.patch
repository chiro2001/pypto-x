+++ b/python/tests/ut/pypto_x/test_qwen35_weighted_driver_rope_layout.py
@@ -0,0 +1,148 @@
+"""qwen35_weighted_execution_driver.rope_bits_for_positions 的布局契约回归测试。
+
+运行时输入 ``cos``/``sin`` 的 schema 是 ``(batch, heads, steps, rotary_dim)``：
+
+* 图内 q 侧把 cos/sin 与 ``(batch, heads, steps, rotary_dim)`` 的 q/k 逐元素相乘；
+* k 侧 ``cos_k = slice(cos, axes=[1], 0:kv_heads)``，axis=1 就是 head。
+
+因此扁平 buffer 必须是 ``[head][position][column]``。历史缺陷按
+``[position][head][column]`` 写入，T≠heads 时图会把 ``(h, t)`` 读到
+``floor((T*h+t)/heads)`` 位置的表（T=18 时位置表整体错位），是 chat(T=18)
+"累积分裂"的根因。本测试不依赖仓外真权重证据，用自造 rope 目录钉住契约。
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import math
+import struct
+from pathlib import Path
+
+import pytest
+
+np = pytest.importorskip("numpy")
+
+DRIVER_PATH = Path(__file__).resolve().parent / "qwen35_weighted_execution_driver.py"
+
+
+def _load_driver():
+    spec = importlib.util.spec_from_file_location(
+        "qwen35_weighted_execution_driver_rope_layout_test", str(DRIVER_PATH)
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _bf16_bits(value: float) -> int:
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return bits >> 16
+    rounding = 0x7FFF + ((bits >> 16) & 1)
+    return ((bits + rounding) & 0xFFFF0000) >> 16
+
+
+def _make_rope_dir(path: Path, prompt: str, steps: int, heads: int = 8, rotary_dim: int = 64):
+    path.mkdir(parents=True, exist_ok=True)
+    summary = {
+        # 与真模型一致的 32 个 inv_freq；数值本身不影响布局断言。
+        "inv_freq": [1.0 / (10_000_000.0 ** (index / 64.0)) for index in range(0, 64, 2)],
+        "rope_type": "default",
+        "attention_scaling": 1.0,
+        "mrope_section": [11, 11, 10],
+    }
+    (path / "rope_summary.json").write_text(json.dumps(summary), encoding="utf-8")
+
+    rng = np.random.default_rng(20260910)
+    # 取 bf16 可精确表示的格点值（1/64 的整数倍），避免测试里的舍入噪声。
+    rows = np.round(rng.uniform(-1.0, 1.0, size=(steps, rotary_dim)) * 64.0) / 64.0
+    cos_head = rows.astype(np.float32)
+    sin_head = np.round(rng.uniform(-1.0, 1.0, size=(steps, rotary_dim)) * 64.0) / 64.0
+    sin_head = sin_head.astype(np.float32)
+    cos_export = np.repeat(cos_head[None, :, :], heads, axis=0)[None, ...]
+    sin_export = np.repeat(sin_head[None, :, :], heads, axis=0)[None, ...]
+    np.savez(
+        path / "{}.npz".format(prompt),
+        cos_fp32=cos_export,
+        sin_fp32=sin_export,
+        cos_bf16=cos_export,
+        sin_bf16=sin_export,
+        input_ids=np.arange(steps, dtype=np.int64),
+    )
+    return cos_export, sin_export, summary
+
+
+def test_rope_buffer_is_head_major(tmp_path):
+    driver = _load_driver()
+    prompt = "fixture_prompt"
+    heads, steps = 8, 18
+    cos_export, sin_export, _ = _make_rope_dir(tmp_path, prompt, steps, heads)
+
+    cos_bits, sin_bits, info = driver.rope_bits_for_positions(
+        tmp_path, prompt, list(range(steps)), heads=heads
+    )
+    assert len(cos_bits) == heads * steps * 64
+    assert len(sin_bits) == heads * steps * 64
+    assert info["exported_positions"] == list(range(steps))
+    assert info["recomputed_positions"] == []
+
+    # schema 顺序：[head][position][column]
+    got = np.asarray(cos_bits, dtype=np.uint16).reshape(heads, steps, 64)
+    for head in range(heads):
+        for position in range(steps):
+            for column in range(64):
+                assert int(got[head, position, column]) == _bf16_bits(
+                    float(cos_export[0, head, position, column])
+                )
+    got_sin = np.asarray(sin_bits, dtype=np.uint16).reshape(heads, steps, 64)
+    for head in range(heads):
+        for position in range(steps):
+            for column in range(64):
+                assert int(got_sin[head, position, column]) == _bf16_bits(
+                    float(sin_export[0, head, position, column])
+                )
+
+    # 回归护栏：steps != heads 时，position-major 的解释必须与导出不同。
+    wrong = np.asarray(cos_bits, dtype=np.uint16).reshape(steps, heads, 64)
+    wrong_values = (wrong.astype(np.uint32) << 16).view(np.float32)
+    assert not np.array_equal(wrong_values, cos_export[0])
+
+
+def test_rope_recomputed_positions_land_in_head_major_slots(tmp_path):
+    driver = _load_driver()
+    prompt = "fixture_prompt"
+    heads, exported_steps = 8, 5
+    _make_rope_dir(tmp_path, prompt, exported_steps, heads)
+    positions = list(range(exported_steps + 3))
+    cos_bits, sin_bits, info = driver.rope_bits_for_positions(
+        tmp_path, prompt, positions, heads=heads
+    )
+    assert info["exported_positions"] == list(range(exported_steps))
+    assert info["recomputed_positions"] == [exported_steps, exported_steps + 1, exported_steps + 2]
+
+    table = driver.rope_tables(tmp_path, positions)
+    got = np.asarray(cos_bits, dtype=np.uint16).reshape(heads, len(positions), 64)
+    for head in range(heads):
+        for index in range(exported_steps, len(positions)):
+            for column in range(64):
+                expected = _bf16_bits(float(table["cos_rows"][index][column]))
+                assert int(got[head, index, column]) == expected
+
+
+def test_rope_single_decode_position_is_layout_agnostic(tmp_path):
+    driver = _load_driver()
+    prompt = "fixture_prompt"
+    heads, exported_steps = 8, 5
+    _make_rope_dir(tmp_path, prompt, exported_steps, heads)
+    positions = [exported_steps + 1]
+    cos_bits, sin_bits, info = driver.rope_bits_for_positions(
+        tmp_path, prompt, positions, heads=heads
+    )
+    assert info["recomputed_positions"] == positions
+    table = driver.rope_tables(tmp_path, positions)
+    got = np.asarray(cos_bits, dtype=np.uint16).reshape(heads, 1, 64)
+    for head in range(heads):
+        for column in range(64):
+            expected = _bf16_bits(float(table["cos_rows"][0][column]))
+            assert int(got[head, 0, column]) == expected
