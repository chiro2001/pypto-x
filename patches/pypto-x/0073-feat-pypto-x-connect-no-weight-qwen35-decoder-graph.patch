+        all_values.update({ref.name: ref for ref in operation.outputs})
+    returns = (logits, final_hidden, position_ids) + tuple(all_values[name] for name in state_outputs)
+    program = builder.finish(returns, extra)
+    # Finish() already verifies the direct operation body; retain a compact
+    # return contract for launchers and independent graph auditors.
+    return program
+
+
+def qwen35_text_decoder_structural_manifest(
+    batch: int,
+    steps: int,
+    past_length: int = 0,
+    *,
+    dtype: str = "bf16",
+    query_heads: int = 8,
+    index_dtype: str = "int64",
+) -> Mapping[str, Any]:
+    """Compatibility manifest for the pre-M1I identity shell.
+
+    This API is intentionally explicit and is never selected by
+    :func:`build_qwen35_text_decoder_graph`.  It exists only for consumers
+    that need to audit the old shape/state manifest without pretending it is
+    executable model connectivity.
+    """
+
+    batch = _positive_or_zero_int(batch, "batch", allow_zero=False)
+    steps = _positive_or_zero_int(steps, "steps", allow_zero=True)
+    past_length = _positive_or_zero_int(past_length, "past_length", allow_zero=True)
+    query_heads = _positive_or_zero_int(query_heads, "query_heads", allow_zero=False)
+    dtype = _dtype(dtype, "dtype")
+    index_dtype = _qwen35_index_dtype(index_dtype)
+    total = past_length + steps
+    if total > (1 << 63) - 1:
+        raise ValueError("past_length + steps overflows signed int64")
+    model = QWEN35_08B_SHAPE_METADATA
+    layers = []
+    for index in range(model["num_hidden_layers"]):
+        is_full = index in model["full_attention_indices_zero_based"]
+        if is_full:
+            layers.append(
+                {
+                    "index": index,
+                    "kind": "full_attention",
+                    "route": "full_attention",
+                    "attention_input_shape": [batch, query_heads, steps, model["head_dim"]],
+                    "causal_mask_shape": [batch, query_heads, steps, total],
+                    "kv_state_inputs": {
+                        "prior_k": [batch, model["num_key_value_heads"], past_length, model["head_dim"]],
+                        "prior_v": [batch, model["num_key_value_heads"], past_length, model["head_dim"]],
+                    },
+                    "kv_state_outputs": {
+                        "new_k": [batch, model["num_key_value_heads"], total, model["head_dim"]],
+                        "new_v": [batch, model["num_key_value_heads"], total, model["head_dim"]],
+                    },
+                    "state_semantics": "functional_pure_ssa_output",
+                    "implemented_branch": "m1f_functional_attention_kv",
+                }
+            )
+        else:
+            layers.append(
+                {
+                    "index": index,
+                    "kind": "gdr",
+                    "route": "linear_attention",
+                    "conv_state_input": [
+                        batch,
+                        model["linear_num_key_heads"] * 3 * model["linear_key_head_dim"],
+                        model["linear_conv_kernel_dim"],
+                    ],
+                    "conv_state_output": [
+                        batch,
+                        model["linear_num_key_heads"] * 3 * model["linear_key_head_dim"],
+                        model["linear_conv_kernel_dim"],
+                    ],
+                    "recurrent_state_input": [
+                        batch,
+                        model["linear_num_value_heads"],
+                        model["linear_key_head_dim"],
+                        model["linear_value_head_dim"],
+                    ],
+                    "recurrent_state_output": [
+                        batch,
+                        model["linear_num_value_heads"],
+                        model["linear_key_head_dim"],
+                        model["linear_value_head_dim"],
+                    ],
+                    "state_semantics": "functional_pure_ssa_output",
+                    "implemented_branch": "m1e_conv_state+m1g_gdr_recurrent_state",
+                }
+            )
+    return {
+        "model_id": model["model_id"],
+        "revision": model["revision"],
+        "graph_kind": "text_decoder_structural_no_weight",
+        "graph_contract_version": 1,
+        "weights_embedded": False,
+        "weight_execution": False,
+        "parameter_storage": "not_materialized; typed_buffer_or_mmap_required",
+        "parameter_count_estimate": "approximately_873m; shape_only",
+        "dtype": dtype,
+        "batch": batch,
+        "steps": steps,
+        "past_length": past_length,
+        "total_length": total,
+        "hidden_input_shape": [batch, steps, model["hidden_size"]],
+        "hidden_output_shape": [batch, steps, model["hidden_size"]],
+        "position_ids_shape": [batch, steps],
+        "position_ids_dtype": index_dtype,
+        "causal_mask_shape": [batch, query_heads, steps, total],
+        "causal_mask_rule": "key_position <= query_position",
+        "num_hidden_layers": len(layers),
+        "gdr_layer_indices": [item["index"] for item in layers if item["kind"] == "gdr"],
+        "full_attention_layer_indices": [item["index"] for item in layers if item["kind"] == "full_attention"],
+        "layers": layers,
+        "state_interfaces": {
+            "gdr": ["conv_state", "recurrent_state"],
+            "full_attention": ["prior_k", "prior_v", "new_k", "new_v"],
+        },
+        "branch_execution": {
+            "gdr": "small_branch_graphs_only_until_typed_state_abi",
+            "full_attention": "small_branch_graphs_only_until_typed_kv_abi",
+            "whole_model": "structural_manifest_only",
+        },
+        "identity_shell": True,
+        "visual_encoder": "excluded_by_mvp",
+        "host_mutation": False,
+    }
+
+
+def build_qwen35_text_decoder_structural_shell(
+    batch: int,
+    steps: int,
+    past_length: int = 0,
+    *,
+    dtype: str = "bf16",
+    query_heads: int = 8,
+    index_dtype: str = "int64",
+) -> CoreProgram:
+    """Build the explicitly named legacy identity shell for compatibility."""
+
+    manifest = qwen35_text_decoder_structural_manifest(
+        batch,
+        steps,
+        past_length,
+        dtype=dtype,
+        query_heads=query_heads,
+        index_dtype=index_dtype,
+    )
+    input_shape = tuple(manifest["hidden_input_shape"])
+    builder = _Builder("qwen35_text_decoder_structural", "text_decoder_structural_no_weight", input_shape)
+    hidden_states = builder.parameter("hidden_states", _tensor(dtype, input_shape))
+    position_ids = builder.parameter(
+        "position_ids",
+        _tensor(manifest["position_ids_dtype"], tuple(manifest["position_ids_shape"])),
+    )
+    causal_mask = builder.parameter(
+        "causal_mask",
+        _tensor("bool", tuple(manifest["causal_mask_shape"])),
+    )
+    output = builder.op(
+        "identity",
+        (hidden_states,),
+        (("output", _tensor(dtype, input_shape)),),
+    )[0]
+    extra = dict(manifest)
+    extra.update(
+        {
+            "control_inputs": [
+                {
+                    "name": "position_ids",
+                    "shape": list(manifest["position_ids_shape"]),
+                    "dtype": manifest["position_ids_dtype"],
+                },
+                {"name": "causal_mask", "shape": list(manifest["causal_mask_shape"]), "dtype": "bool"},
+            ],
+            "executable_operations": ["identity"],
+            "whole_model_execution": "not_claimed",
+        }
+    )
+    return builder.finish((output,), extra)
+
+
+def _repeat_kv_heads(
+    builder: _Builder,
+    value: ValueRef,
+    query_heads: int,
+    kv_heads: int,
+    prefix: str,
+) -> ValueRef:
+    """Repeat KV heads with shape/layout primitives and no integer index ABI.
+
+    A constant integer index tensor would be a target-specific host-reference
+    plan on SVE/GPU.  Explicit slice/concat repetition keeps the GQA mapping
+    entirely in the portable graph and preserves the fixed repeat-interleave
+    semantics for both the model and synthetic profiles.
+    """
+
+    if query_heads % kv_heads:
+        raise ValueError("query_heads must be divisible by kv_heads")
+    repeat = query_heads // kv_heads
+    batch, _heads, sequence, head_dim = value.type.shape
+    chunks = []
+    for head in range(kv_heads):
+        one = builder.op(
+            "slice",
+            (value,),
+            (("{}_source_{}".format(prefix, head), _tensor(value.type.dtype, (batch, 1, sequence, head_dim))),),
+            {"starts": [head], "stops": [head + 1], "axes": [1], "steps": [1]},
+        )[0]
+        chunks.extend([one] * repeat)
+    return builder.op(
+        "concat",
+        tuple(chunks),
+        ((prefix, _tensor(value.type.dtype, (batch, query_heads, sequence, head_dim))),),
+        {"axis": 1},
+    )[0]
+
+
+def _append_full_attention_graph(
+    builder: _Builder,
+    hidden: ValueRef,
+    prior_k: ValueRef,
+    prior_v: ValueRef,
+    q_weight: ValueRef,
+    k_weight: ValueRef,
+    v_weight: ValueRef,
+    o_weight: ValueRef,
+    q_norm_weight: ValueRef,
+    k_norm_weight: ValueRef,
+    cos: ValueRef,
+    sin: ValueRef,
+    causal_mask: ValueRef,
+    qk_scale: ValueRef,
+    fill_value: ValueRef,
+    qk_epsilon: ValueRef,
+    dtype: str,
+    input_shape: Tuple[int, ...],
+    batch: int,
+    steps: int,
+    past_length: int,
+    query_heads: int,
+    kv_heads: int,
+    head_dim: int,
+    rotary_dim: int,
+    prefix: str,
+) -> Tuple[ValueRef, ValueRef, ValueRef]:
+    """Append one Qwen full-attention block and functional KV transition."""
+
+    total = past_length + steps
+    query_packed = _linear_projection(
+        builder,
+        hidden,
+        q_weight,
+        dtype,
+        dtype,
+        input_shape,
+        query_heads * head_dim * 2,
+        prefix + "_q_projection",
+        weight_dtype=dtype,
+    )
+    query_packed = _reshape(
+        builder,
+        query_packed,
+        (batch, steps, query_heads, 2 * head_dim),
+        prefix + "_q_gate_packed",
+    )
+    query_raw, gate_raw = builder.op(
+        "split",
+        (query_packed,),
+        (
+            (prefix + "_query_raw", _tensor(dtype, (batch, steps, query_heads, head_dim))),
+            (prefix + "_output_gate_raw", _tensor(dtype, (batch, steps, query_heads, head_dim))),
+        ),
+        {"sizes": [head_dim, head_dim], "axis": -1},
+    )
+    query = _transpose(builder, query_raw, (0, 2, 1, 3), prefix + "_query_heads")
+    output_gate = _transpose(builder, gate_raw, (0, 2, 1, 3), prefix + "_output_gate")
+    query_norm = _rms_core(
+        builder,
+        query,
+        q_norm_weight,
+        qk_epsilon,
+        dtype,
+        (batch, query_heads, steps, head_dim),
+        prefix + "_q_norm",
+    )
+    cos_f32 = _as_f32(builder, cos, dtype, prefix + "_cos")
+    sin_f32 = _as_f32(builder, sin, dtype, prefix + "_sin")
+    query_rotated = _rope_core(
+        builder,
+        query_norm,
+        cos_f32,
+        sin_f32,
+        "float32",
+        (batch, query_heads, steps, head_dim),
+        rotary_dim,
+        prefix + "_q_rope",
+    )
+
+    current_k = _linear_projection(
+        builder,
+        hidden,
+        k_weight,
+        dtype,
+        dtype,
+        input_shape,
+        kv_heads * head_dim,
+        prefix + "_k_projection",
+        weight_dtype=dtype,
+    )
+    current_k = _reshape(builder, current_k, (batch, steps, kv_heads, head_dim), prefix + "_k_time")
+    current_k = _transpose(builder, current_k, (0, 2, 1, 3), prefix + "_k_heads")
+    current_k = _rms_core(
+        builder,
+        current_k,
+        k_norm_weight,
+        qk_epsilon,
+        dtype,
+        (batch, kv_heads, steps, head_dim),
+        prefix + "_k_norm",
+    )
+    cos_k = builder.op(
+        "slice",
+        (cos_f32,),
+        ((prefix + "_cos_k", _tensor("float32", (batch, kv_heads, steps, rotary_dim))),),
+        {"starts": [0], "stops": [kv_heads], "axes": [1], "steps": [1]},
+    )[0]
+    sin_k = builder.op(
+        "slice",
+        (sin_f32,),
+        ((prefix + "_sin_k", _tensor("float32", (batch, kv_heads, steps, rotary_dim))),),
+        {"starts": [0], "stops": [kv_heads], "axes": [1], "steps": [1]},
+    )[0]
+    current_k = _rope_core(
+        builder,
+        current_k,
+        cos_k,
+        sin_k,
+        "float32",
+        (batch, kv_heads, steps, head_dim),
+        rotary_dim,
+        prefix + "_k_rope",
+    )
+    current_k = _cast_from_f32(builder, current_k, dtype, prefix + "_current_k")
+
+    current_v = _linear_projection(
+        builder,
+        hidden,
+        v_weight,
+        dtype,
+        dtype,
+        input_shape,
+        kv_heads * head_dim,
+        prefix + "_v_projection",
+        weight_dtype=dtype,
+    )
+    current_v = _reshape(builder, current_v, (batch, steps, kv_heads, head_dim), prefix + "_v_time")
+    current_v = _transpose(builder, current_v, (0, 2, 1, 3), prefix + "_v_heads")
+    new_k = builder.op(
+        "concat",
+        (prior_k, current_k),
+        ((prefix + "_new_k", _tensor(dtype, (batch, kv_heads, total, head_dim))),),
+        {"axis": 2},
+    )[0]
+    new_v = builder.op(
+        "concat",
+        (prior_v, current_v),
+        ((prefix + "_new_v", _tensor(dtype, (batch, kv_heads, total, head_dim))),),
+        {"axis": 2},
+    )[0]
+    repeated_k = _repeat_kv_heads(builder, new_k, query_heads, kv_heads, prefix + "_gqa_k")
+    repeated_v = _repeat_kv_heads(builder, new_v, query_heads, kv_heads, prefix + "_gqa_v")
+    query_f32 = query_rotated
+    key_f32 = _as_f32(builder, repeated_k, dtype, prefix + "_k_cache_f32")
+    key_t = _transpose(builder, key_f32, (0, 1, 3, 2), prefix + "_k_cache_transposed")
+    logits = builder.op(
+        "matmul",
+        (query_f32, key_t),
+        ((prefix + "_qk_logits", _tensor("float32", (batch, query_heads, steps, total))),),
+    )[0]
+    scaled = builder.op(
+        "mul",
+        (logits, qk_scale),
+        ((prefix + "_qk_scaled", _tensor("float32", (batch, query_heads, steps, total))),),
+    )[0]
+    masked = builder.op(
+        "where",
+        (causal_mask, scaled, fill_value),
+        ((prefix + "_masked_logits", _tensor("float32", (batch, query_heads, steps, total))),),
+    )[0]
+    reduced_shape = (batch, query_heads, steps, 1)
+    maximum = builder.op(
+        "reduce_max",
+        (masked,),
+        ((prefix + "_softmax_max", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    maximum_full = builder.op(
+        "broadcast",
+        (maximum,),
+        ((prefix + "_softmax_max_full", _tensor("float32", (batch, query_heads, steps, total))),),
+        {"shape": [batch, query_heads, steps, total]},
+    )[0]
+    shifted = builder.op(
+        "sub",
+        (masked, maximum_full),
+        ((prefix + "_softmax_shifted", _tensor("float32", (batch, query_heads, steps, total))),),
+    )[0]
+    exponent = builder.op(
+        "exp",
+        (shifted,),
+        ((prefix + "_softmax_exp", _tensor("float32", (batch, query_heads, steps, total))),),
+    )[0]
+    total_exp = builder.op(
+        "reduce_sum",
+        (exponent,),
+        ((prefix + "_softmax_sum", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    total_full = builder.op(
+        "broadcast",
+        (total_exp,),
+        ((prefix + "_softmax_sum_full", _tensor("float32", (batch, query_heads, steps, total))),),
+        {"shape": [batch, query_heads, steps, total]},
+    )[0]
+    probabilities = builder.op(
+        "div",
+        (exponent, total_full),
+        ((prefix + "_probabilities", _tensor("float32", (batch, query_heads, steps, total))),),
+    )[0]
+    value_f32 = _as_f32(builder, repeated_v, dtype, prefix + "_v_cache_f32")
+    context = builder.op(
+        "matmul",
+        (probabilities, value_f32),
+        ((prefix + "_context", _tensor("float32", (batch, query_heads, steps, head_dim))),),
+    )[0]
+    gate_sigmoid = builder.op(
+        "sigmoid",
+        (_as_f32(builder, output_gate, dtype, prefix + "_output_gate_f32"),),
+        ((prefix + "_output_gate_sigmoid", _tensor("float32", (batch, query_heads, steps, head_dim))),),
+    )[0]
+    gated_context = builder.op(
+        "mul",
+        (context, gate_sigmoid),
+        ((prefix + "_gated_context", _tensor("float32", (batch, query_heads, steps, head_dim))),),
+    )[0]
+    merged = _transpose(builder, gated_context, (0, 2, 1, 3), prefix + "_merged_heads")
+    merged = _reshape(builder, merged, (batch, steps, query_heads * head_dim), prefix + "_merged")
+    output = _linear_projection(
+        builder,
+        merged,
+        o_weight,
+        "float32",
+        dtype,
+        (batch, steps, query_heads * head_dim),
+        hidden.type.shape[-1],
+        prefix + "_o_projection",
+        weight_dtype=dtype,
+    )
+    return output, new_k, new_v
+
+
+def _append_gdr_graph(
+    builder: _Builder,
+    hidden: ValueRef,
+    prior_conv_state: ValueRef,
+    prior_recurrent_state: ValueRef,
+    qkv_weight: ValueRef,
+    z_weight: ValueRef,
+    b_weight: ValueRef,
+    a_weight: ValueRef,
+    conv_weight: ValueRef,
+    a_log_weight: ValueRef,
+    dt_bias_weight: ValueRef,
+    norm_weight: ValueRef,
+    out_weight: ValueRef,
+    scale: ValueRef,
+    epsilon: ValueRef,
+    dtype: str,
+    input_shape: Tuple[int, ...],
+    batch: int,
+    steps: int,
+    key_heads: int,
+    value_heads: int,
+    key_dim: int,
+    value_dim: int,
+    kernel: int,
+    conv_channels: int,
+    prefix: str,
+) -> Tuple[ValueRef, ValueRef, ValueRef]:
+    """Append the connected GDR projection/conv/recurrence/out path."""
+
+    mixed = _linear_projection(
+        builder,
+        hidden,
+        qkv_weight,
+        dtype,
+        dtype,
+        input_shape,
+        2 * key_heads * key_dim + value_heads * value_dim,
+        prefix + "_in_proj_qkv",
+        weight_dtype=dtype,
+    )
+    mixed = _reshape(
+        builder,
+        mixed,
+        (batch, steps, 2 * key_heads * key_dim + value_heads * value_dim),
+        prefix + "_qkv_time",
+    )
+    mixed = _transpose(builder, mixed, (0, 2, 1), prefix + "_qkv_conv_input")
+    conv_weight_2d = _reshape(builder, conv_weight, (conv_channels, kernel), prefix + "_conv_weight_2d")
+    conv_output, new_conv_state = _append_causal_conv1d_state(
+        builder,
+        mixed,
+        prior_conv_state,
+        conv_weight_2d,
+        dtype,
+        dtype,
+        batch,
+        conv_channels,
+        steps,
+        kernel,
+        prefix + "_causal_conv",
+    )
+    conv_time = _transpose(builder, conv_output, (0, 2, 1), prefix + "_conv_time")
+    q_raw, k_raw, v_raw = builder.op(
+        "split",
+        (conv_time,),
+        (
+            (prefix + "_q_raw", _tensor(dtype, (batch, steps, key_heads * key_dim))),
+            (prefix + "_k_raw", _tensor(dtype, (batch, steps, key_heads * key_dim))),
+            (prefix + "_v_raw", _tensor(dtype, (batch, steps, value_heads * value_dim))),
+        ),
+        {"sizes": [key_heads * key_dim, key_heads * key_dim, value_heads * value_dim], "axis": -1},
+    )
+    query = _reshape(builder, q_raw, (batch, steps, key_heads, key_dim), prefix + "_q")
+    key = _reshape(builder, k_raw, (batch, steps, key_heads, key_dim), prefix + "_k")
+    value = _reshape(builder, v_raw, (batch, steps, value_heads, value_dim), prefix + "_v")
+    query = _l2_core(builder, query, epsilon, dtype, (batch, steps, key_heads, key_dim), prefix + "_q_l2")
+    key = _l2_core(builder, key, epsilon, dtype, (batch, steps, key_heads, key_dim), prefix + "_k_l2")
+    z = _linear_projection(
+        builder,
+        hidden,
+        z_weight,
+        dtype,
+        dtype,
+        input_shape,
+        value_heads * value_dim,
+        prefix + "_in_proj_z",
+        weight_dtype=dtype,
+    )
+    z = _reshape(builder, z, (batch, steps, value_heads, value_dim), prefix + "_z")
+    b = _linear_projection(
+        builder,
+        hidden,
+        b_weight,
+        dtype,
+        dtype,
+        input_shape,
+        value_heads,
+        prefix + "_in_proj_b",
+        weight_dtype=dtype,
+    )
+    a = _linear_projection(
+        builder,
+        hidden,
+        a_weight,
+        dtype,
+        dtype,
+        input_shape,
+        value_heads,
+        prefix + "_in_proj_a",
+        weight_dtype=dtype,
+    )
+    beta_f32 = builder.op(
+        "sigmoid",
+        (_as_f32(builder, b, dtype, prefix + "_beta_input"),),
+        ((prefix + "_beta_f32", _tensor("float32", (batch, steps, value_heads))),),
+    )[0]
+    beta = builder.op(
+        "cast",
+        (beta_f32,),
+        ((prefix + "_beta", _tensor(dtype, (batch, steps, value_heads))),),
+        {"dtype": dtype},
+    )[0]
+    a_f32 = _as_f32(builder, a, dtype, prefix + "_a_f32")
+    a_log_f32 = builder.op(
+        "broadcast",
+        (_as_f32(builder, a_log_weight, dtype, prefix + "_a_log_f32"),),
+        ((prefix + "_a_log_full", _tensor("float32", (batch, steps, value_heads))),),
+        {"shape": [batch, steps, value_heads]},
+    )[0]
+    dt_bias_f32 = builder.op(
+        "broadcast",
+        (_as_f32(builder, dt_bias_weight, dtype, prefix + "_dt_bias_f32"),),
+        ((prefix + "_dt_bias_full", _tensor("float32", (batch, steps, value_heads))),),
+        {"shape": [batch, steps, value_heads]},
+    )[0]
+    a_plus_dt = builder.op(
+        "add",
+        (a_f32, dt_bias_f32),
+        ((prefix + "_a_plus_dt", _tensor("float32", (batch, steps, value_heads))),),
+    )[0]
+    positive_dt = builder.op(
+        "softplus",
+        (a_plus_dt,),
+        ((prefix + "_positive_dt", _tensor("float32", (batch, steps, value_heads))),),
+    )[0]
+    neg_a_log = builder.op(
+        "neg",
+        (a_log_f32,),
+        ((prefix + "_negative_a_log", _tensor("float32", (batch, steps, value_heads))),),
+    )[0]
+    gate_log = builder.op(
+        "mul",
+        (neg_a_log, positive_dt),
+        ((prefix + "_gate_log_decay", _tensor("float32", (batch, steps, value_heads))),),
+    )[0]
+    # The existing functional recurrent builder has the fixed Qwen BF16
+    # q/k/v ABI.  Keep the L2 normalization in FP32, then make that ABI cast
+    # explicit instead of allowing a transpose to silently change dtype.
+    query_bf16 = _cast_from_f32(builder, query, dtype, prefix + "_q_norm_bf16")
+    key_bf16 = _cast_from_f32(builder, key, dtype, prefix + "_k_norm_bf16")
+    core_output, new_recurrent_state = _gdr_recurrent_inline(
+        builder,
+        query_bf16,
+        key_bf16,
+        value,
+        gate_log,
+        beta,
+        prior_recurrent_state,
+        scale,
+        batch,
+        steps,
+        value_heads,
+        key_dim,
+        value_dim,
+        prefix + "_recurrent",
+    )
+    core_f32 = _as_f32(builder, core_output, "bf16", prefix + "_core_output_f32")
+    gated_norm = _rms_gated_core(
+        builder,
+        core_f32,
+        norm_weight,
+        epsilon,
+        dtype,
+        (batch, steps, value_heads, value_dim),
+        prefix + "_gated_norm",
+    )
+    z_gate = builder.op(
+        "silu",
+        (_as_f32(builder, z, dtype, prefix + "_z_f32"),),
+        ((prefix + "_z_gate", _tensor("float32", (batch, steps, value_heads, value_dim))),),
+    )[0]
+    gated = builder.op(
+        "mul",
+        (gated_norm, z_gate),
+        ((prefix + "_gated_core", _tensor("float32", (batch, steps, value_heads, value_dim))),),
+    )[0]
+    merged = _reshape(builder, gated, (batch, steps, value_heads * value_dim), prefix + "_merged")
+    output = _linear_projection(
+        builder,
+        merged,
+        out_weight,
+        "float32",
+        dtype,
+        (batch, steps, value_heads * value_dim),
+        hidden.type.shape[-1],
+        prefix + "_out_projection",
+        weight_dtype=dtype,
+    )
+    return output, new_conv_state, new_recurrent_state
+
+
+def _gdr_recurrent_inline(
+    builder: _Builder,
+    query: ValueRef,
+    key: ValueRef,
+    value: ValueRef,
+    gate: ValueRef,
+    beta: ValueRef,
+    prior_state: ValueRef,
+    scale: ValueRef,
+    batch: int,
+    steps: int,
+    heads: int,
+    key_dim: int,
+    value_dim: int,
+    prefix: str,
+) -> Tuple[ValueRef, ValueRef]:
+    """Use the existing sequential GDR primitive composition in this graph."""
+
+    state = prior_state
+    outputs = []
+    for time_index in range(steps):
+        output, state = _gdr_step(
+            builder,
+            query,
+            key,
+            value,
+            gate,
+            beta,
+            state,
+            scale,
+            batch,
+            heads,
+            key_dim,
+            value_dim,
+            time_index,
+            "{}_step_{}".format(prefix, time_index),
+        )
+        outputs.append(output)
+    if len(outputs) == 1:
+        output = outputs[0]
+    else:
+        output = builder.op(
+            "concat",
+            tuple(outputs),
+            ((prefix + "_output", _tensor("bf16", (batch, steps, heads, value_dim))),),
+            {"axis": 1},
+        )[0]
+    return output, state
 
 
