+"""M1I no-weight full Qwen3.5 decoder connectivity tests.
+
+The synthetic profile is deliberately tiny; it validates SSA/dataflow and
+state carry without loading a checkpoint.  The real profile is audited as a
+graph/manifest only.  It is never lowered in this test process: a lowerer is
+allowed to build target-owned plans, but must not be asked to materialize a
+4096-token/0.8B plan in the same process as other backends.
+"""
+
+from __future__ import annotations
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+from pypto.compiler.targets.gpu import GpuCompiler
+from pypto.portable.qwen35 import (
+    build_qwen35_text_decoder_graph,
+    build_qwen35_text_decoder_structural_shell,
+    qwen35_text_decoder_manifest,
+    qwen35_text_decoder_structural_manifest,
+)
+from pypto.target import TargetSpec
+
+
+def _compile_scalar(program):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+
+
+def _synthetic_launch(program):
+    parameters = program.functions[0].parameters
+    inputs = []
+    for ref in parameters:
+        shape = tuple(ref.type.shape)
+        if ref.name == "input_ids":
+            inputs.append(HostTensor("int64", shape, [0] * _count(shape)))
+        elif ref.name == "cos":
+            inputs.append(HostTensor("bf16", shape, [1.0] * _count(shape)))
+        elif ref.name == "sin":
+            inputs.append(HostTensor("bf16", shape, [0.0] * _count(shape)))
+        elif ref.type.dtype == "float32":
+            inputs.append(HostTensor("float32", shape, [0.0] * _count(shape)))
+        else:
+            # Nonzero synthetic weights make projection/state edges observable;
+            # prior state buffers remain zero so the carry contract is clear.
+            value = 0.0 if "state_in" in ref.name or "prior_" in ref.name else 0.01
+            inputs.append(HostTensor("bf16", shape, [value] * _count(shape)))
+    outputs = [HostTensor(ref.type.dtype, tuple(ref.type.shape)) for ref in program.functions[0].returns]
+    return inputs, outputs
+
+
+def _count(shape):
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+def test_full_manifest_parameter_and_route_contract():
+    manifest = qwen35_text_decoder_manifest(1, 1, past_length=4096)
+    assert manifest["graph_kind"] == "text_decoder_full_no_weight"
+    assert manifest["graph_contract_version"] == 2
+    assert manifest["weights_embedded"] is False
+    assert manifest["weight_execution"] is False
+    assert manifest["parameter_byte_count"] < (1 << 64)
+    assert manifest["tied_weight"]["storage_count"] == 1
+    assert len(manifest["parameter_manifest"]) == manifest["parameter_storage_count"]
+    assert len(manifest["layers"]) == 24
+    assert len(manifest["gdr_layer_indices"]) == 18
+    assert manifest["full_attention_layer_indices"] == [3, 7, 11, 15, 19, 23]
+    assert manifest["layers"][0]["state_semantics"] == "functional_pure_ssa_output"
+    assert manifest["layers"][3]["kv_state_outputs"]["new_k"] == [1, 2, 4097, 256]
+
+
+def test_model_profile_has_complete_layer_ssa_connectivity_without_weights():
+    program = build_qwen35_text_decoder_graph(1, 1, past_length=4096)
+    function = program.functions[0]
+    output_names = {value.name for operation in function.body.operations for value in operation.outputs}
+    parameter_names = {value.name for value in function.parameters}
+    metadata = program.metadata
+
+    assert len(metadata["layer_routes"]) == 24
+    assert [item["index"] for item in metadata["layer_routes"]] == list(range(24))
+    assert [item["kind"] for item in metadata["layer_routes"]].count("gdr") == 18
+    assert [item["kind"] for item in metadata["layer_routes"]].count("full_attention") == 6
+    assert metadata["layer_hidden_inputs"][0] == "hidden_input"
+    assert metadata["layer_hidden_inputs"][1:] == metadata["layer_hidden_outputs"][:-1]
+    assert len(metadata["layer_hidden_outputs"]) == 24
+    assert len(set(metadata["layer_hidden_outputs"])) == 24
+    assert all(name in output_names for name in metadata["layer_hidden_outputs"])
+    assert metadata["def_use_connectivity"]["logits"] in output_names
+    assert metadata["def_use_connectivity"]["final_hidden"] in output_names
+    assert metadata["def_use_connectivity"]["logits_depends_on_all_layers"] is True
+    assert all(name in parameter_names for name in metadata["state_input_names"])
+    assert all(name in output_names for name in metadata["state_output_names"])
+    assert any(
+        operation.name == "silu" and operation.outputs[0].name.endswith("_z_gate")
+        for operation in function.body.operations
+    )
+    assert any(
+        operation.name == "reduce_mean" and "_gated_norm_mean" in operation.outputs[0].name
+        for operation in function.body.operations
+    )
+    assert {value.name for value in function.returns} >= {
+        metadata["def_use_connectivity"]["logits"],
+        metadata["def_use_connectivity"]["final_hidden"],
+    }
+    assert len(metadata["state_output_names"]) == 48
+    assert all(
+        value.name.endswith(("_weight", "_state_in", "_prior_k", "_prior_v", "_A_log", "_dt_bias"))
+        or value.name in {
+            "input_ids", "cos", "sin", "embedding_lm_head_shared_weight", "final_norm_weight",
+        }
+        for value in function.parameters
+    )
+    assert all("values" not in operation.attributes for operation in function.body.operations)
+
+
+def test_model_profile_builds_compact_for_decode_cache_lengths():
+    for past in (0, 4096):
+        program = build_qwen35_text_decoder_graph(1, 1, past_length=past)
+        assert len(program.functions[0].body.operations) < 6000
+        assert len(program.canonical_json()) < 3_000_000
+        assert program.metadata["identity_shell"] is False
+        assert program.metadata["no_embedded_weight_values"] is True
+        assert program.metadata["no_state_allocation"] is True
+        assert "identity" not in program.metadata["executable_operations"]
+
+
+def test_synthetic_full_graph_executes_and_returns_functional_state():
+    program = build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test")
+    artifact = _compile_scalar(program)
+    inputs, outputs = _synthetic_launch(program)
+    state_snapshots = {
+        ref.name: tuple(inputs[index].flat())
+        for index, ref in enumerate(program.functions[0].parameters)
+        if ref.name.endswith(("_state_in", "_prior_k", "_prior_v"))
+    }
+    result = CpuScalarRuntime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+        )
+    )
+    assert result is not None
+    assert outputs[0].shape == (1, 1, 32)
+    assert outputs[2].tolist() == [[0]]
+    assert len(program.metadata["state_output_names"]) == 48
+    assert all(value == value for value in outputs[0].flat())
+    for index, ref in enumerate(program.functions[0].parameters):
+        if ref.name in state_snapshots:
+            assert tuple(inputs[index].flat()) == state_snapshots[ref.name]
+
+
+def test_synthetic_lowering_is_compact_and_backend_local():
+    """Exercise target-owned plans only on the bounded synthetic profile."""
+
+    program = build_qwen35_text_decoder_graph(1, 1, shape_profile="synthetic_test")
+    vector = CpuVectorCompiler()
+    vector_ir = vector.lower(
+        program,
+        TargetSpec(
+            "cpu", "x86_64-linux-gnu",
+            attributes={"lane_count": 4, "specialization": {"compact_iteration": True}},
+        ),
+    )
+    assert len(vector_ir.plans) == len(program.functions[0].body.operations)
+    assert all(plan.iteration.compact for plan in vector_ir.plans)
+    sve = Sve256Compiler()
+    sve_ir = sve.lower(
+        program,
+        TargetSpec("cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32}),
+    )
+    assert len(sve_ir.vector_program.plans) == len(program.functions[0].body.operations)
+    gpu = GpuCompiler()
+    gpu_ir = gpu.lower(program, TargetSpec("gpu", "gpu"))
+    assert len(gpu_ir.plans) == len(program.functions[0].body.operations)
+
+
+def test_structural_shell_is_explicit_compatibility_only():
+    old = qwen35_text_decoder_structural_manifest(1, 2, past_length=4)
+    shell = build_qwen35_text_decoder_structural_shell(1, 2, past_length=4)
+    assert old["graph_kind"] == "text_decoder_structural_no_weight"
+    assert old["identity_shell"] is True
+    assert shell.metadata["whole_model_execution"] == "not_claimed"
+    assert shell.functions[0].body.operations[0].name == "identity"
