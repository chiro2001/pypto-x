+def _rms_gated_core(
+    builder: _Builder,
+    x: ValueRef,
+    weight: ValueRef,
+    epsilon: ValueRef,
+    dtype: str,
+    shape: Tuple[int, ...],
+    prefix: str,
+) -> ValueRef:
+    """Build Qwen3.5's post-GDR ``RMSNormGated`` body.
+
+    The checkpoint's gated norm stores a direct scale initialized to one.  It
+    therefore differs from the decoder RMSNorm delta convention above: the
+    scale is multiplied directly, and the gate is applied as ``silu(z)``
+    after normalization.
+    """
+
+    f32 = "float32"
+    x_f32 = x if x.type.dtype == "float32" else _as_f32(builder, x, dtype, prefix + "_x")
+    squared = builder.op(
+        "mul",
+        (x_f32, x_f32),
+        ((prefix + "_square", _tensor(f32, shape)),),
+    )[0]
+    reduced_shape = shape[:-1] + (1,)
+    mean = builder.op(
+        "reduce_mean",
+        (squared,),
+        ((prefix + "_mean", _tensor(f32, reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    stabilized = builder.op(
+        "add",
+        (mean, epsilon),
+        ((prefix + "_mean_eps", _tensor(f32, reduced_shape)),),
+    )[0]
+    inverse = builder.op(
+        "rsqrt",
+        (stabilized,),
+        ((prefix + "_inverse", _tensor(f32, reduced_shape)),),
+    )[0]
+    inverse_full = builder.op(
+        "broadcast",
+        (inverse,),
+        ((prefix + "_inverse_full", _tensor(f32, shape)),),
+        {"shape": list(shape)},
+    )[0]
+    normalized = builder.op(
+        "mul",
+        (x_f32, inverse_full),
+        ((prefix + "_normalized", _tensor(f32, shape)),),
+    )[0]
+    weight_f32 = _as_f32(builder, weight, dtype, prefix + "_weight")
+    weight_full = builder.op(
+        "broadcast",
+        (weight_f32,),
+        ((prefix + "_weight_full", _tensor(f32, shape)),),
+        {"shape": list(shape)},
+    )[0]
+    return builder.op(
+        "mul",
+        (normalized, weight_full),
+        ((prefix + "_scaled", _tensor(f32, shape)),),
+    )[0]
+
+
