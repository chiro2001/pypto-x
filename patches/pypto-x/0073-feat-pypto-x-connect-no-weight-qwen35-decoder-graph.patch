+def _constant_scalar(builder: _Builder, name: str, value: float, dtype: str = "float32") -> ValueRef:
+    """Emit a small scalar constant used by a composite.
+
+    Constants are deliberately limited to numerical policy values (epsilon,
+    scale and mask fill).  Model parameters are never represented by a
+    ``constant`` operation; they remain explicit function parameters.
+    """
+
+    return builder.op(
+        "constant",
+        (),
+        ((name, _scalar(dtype)),),
+        {"value": value},
+    )[0]
+
+
+def _reshape(builder: _Builder, value: ValueRef, shape: Sequence[int], name: str) -> ValueRef:
+    """Emit a checked logical reshape while keeping stable SSA names."""
+
+    result_shape = tuple(shape)
+    return builder.op(
+        "reshape",
+        (value,),
+        ((name, _tensor(value.type.dtype, result_shape)),),
+        {"shape": list(result_shape)},
+    )[0]
+
+
+def _transpose(builder: _Builder, value: ValueRef, permutation: Sequence[int], name: str) -> ValueRef:
+    """Emit an explicit permutation; no implicit matmul transpose is used."""
+
+    permutation = tuple(permutation)
+    input_shape = tuple(value.type.shape)
+    output_shape = tuple(input_shape[index] for index in permutation)
+    return builder.op(
+        "transpose",
+        (value,),
+        ((name, _tensor(value.type.dtype, output_shape)),),
+        {"permutation": list(permutation)},
+    )[0]
+
+
+def _l2_core(
+    builder: _Builder,
+    x: ValueRef,
+    epsilon: ValueRef,
+    dtype: str,
+    shape: Tuple[int, ...],
+    prefix: str,
+) -> ValueRef:
+    """Build the Qwen GDR query/key L2 normalization in portable primitives."""
+
+    x_f32 = _as_f32(builder, x, dtype, prefix + "_x")
+    square = builder.op(
+        "mul",
+        (x_f32, x_f32),
+        ((prefix + "_square", _tensor("float32", shape)),),
+    )[0]
+    reduced_shape = shape[:-1] + (1,)
+    total = builder.op(
+        "reduce_sum",
+        (square,),
+        ((prefix + "_sum", _tensor("float32", reduced_shape)),),
+        {"axis": -1, "keepdims": True},
+    )[0]
+    stabilized = builder.op(
+        "add",
+        (total, epsilon),
+        ((prefix + "_sum_eps", _tensor("float32", reduced_shape)),),
+    )[0]
+    inverse = builder.op(
+        "rsqrt",
+        (stabilized,),
+        ((prefix + "_inverse", _tensor("float32", reduced_shape)),),
+    )[0]
+    inverse_full = builder.op(
+        "broadcast",
+        (inverse,),
+        ((prefix + "_inverse_full", _tensor("float32", shape)),),
+        {"shape": list(shape)},
+    )[0]
+    return builder.op(
+        "mul",
+        (x_f32, inverse_full),
+        ((prefix + "_normalized", _tensor("float32", shape)),),
+    )[0]
+
+
+def _linear_projection(
+    builder: _Builder,
+    x: ValueRef,
+    weight: ValueRef,
+    input_dtype: str,
+    output_dtype: str,
+    input_shape: Tuple[int, ...],
+    output_features: int,
+    prefix: str,
+    weight_dtype: Optional[str] = None,
+) -> ValueRef:
+    """Build ``x @ weight.T`` for a model weight stored as ``[out,in]``.
+
+    The Qwen/Gym parameter contract stores linear weights in PyTorch layout.
+    Making the transpose an explicit Core operation keeps the graph portable
+    and makes the parameter's layout auditable by each target lowering.
+    """
+
+    rows = 1
+    for dimension in input_shape[:-1]:
+        rows *= dimension
+    input_width = input_shape[-1]
+    x_flat = _reshape(
+        builder,
+        _as_f32(builder, x, input_dtype, prefix + "_input_f32"),
+        (rows, input_width),
+        prefix + "_input_flat",
+    )
+    weight_f32 = _as_f32(builder, weight, weight_dtype or input_dtype, prefix + "_weight_f32")
+    weight_t = _transpose(builder, weight_f32, (1, 0), prefix + "_weight_t")
+    projected_f32 = builder.op(
+        "matmul",
+        (x_flat, weight_t),
+        ((prefix + "_projected_f32", _tensor("float32", (rows, output_features))),),
+    )[0]
+    projected = _cast_from_f32(builder, projected_f32, output_dtype, prefix + "_projected")
+    return _reshape(builder, projected, input_shape[:-1] + (output_features,), prefix + "_output")
+
+
+def _checked_element_count(shape: Sequence[int], field: str) -> int:
+    result = 1
+    for index, dimension in enumerate(shape):
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise ValueError("{}[{}] must be a non-negative integer".format(field, index))
+        if dimension and result > _UINT64_MAX // dimension:
+            raise ValueError("{} element count exceeds uint64".format(field))
+        result *= dimension
+    return result
+
+
+def _decoder_parameter_entry(
+    name: str,
+    shape: Sequence[int],
+    dtype: str,
+    *,
+    count: int = 1,
+    aliases: Sequence[str] = (),
+    storage_id: Optional[str] = None,
+) -> Mapping[str, Any]:
+    """Return a compact, uint64-checked parameter manifest entry."""
+
+    elements = _checked_element_count(shape, name)
+    if dtype not in _DTYPE_BYTES:
+        raise ValueError("unsupported parameter dtype {!r}".format(dtype))
+    if isinstance(count, bool) or not isinstance(count, int) or count <= 0:
+        raise ValueError("{} count must be positive".format(name))
+    if elements > _UINT64_MAX // count:
+        raise ValueError("{} element count exceeds uint64".format(name))
+    total_elements = elements * count
+    bytes_per_tensor = elements * _DTYPE_BYTES[dtype]
+    if bytes_per_tensor > _UINT64_MAX // count:
+        raise ValueError("{} storage bytes exceed uint64".format(name))
+    storage_bytes = bytes_per_tensor * count
+    return {
+        "name": name,
+        "storage_id": storage_id or name,
+        "shape": list(shape),
+        "dtype": dtype,
+        "count": count,
+        "elements_per_tensor": elements,
+        "parameter_elements": total_elements,
+        "storage_bytes": storage_bytes,
+        "aliases": list(aliases),
+    }
+
+
+def _decoder_shape_profile(shape_profile: str, query_heads: int) -> Mapping[str, int]:
+    """Resolve the fixed model profile or an explicitly test-only small profile."""
+
+    if not isinstance(shape_profile, str):
+        raise TypeError("shape_profile must be a string")
+    profile = shape_profile.strip().lower().replace("-", "_")
+    if profile in ("model", "fixed", "qwen35_08b", "qwen3_5_0_8b"):
+        if query_heads != QWEN35_08B_SHAPE_METADATA["num_attention_heads"]:
+            raise ValueError("fixed Qwen3.5 profile requires query_heads=8")
+        model = QWEN35_08B_SHAPE_METADATA
+        return {
+            "hidden": int(model["hidden_size"]),
+            "intermediate": int(model["intermediate_size"]),
+            "vocab": 248320,
+            "query_heads": 8,
+            "kv_heads": int(model["num_key_value_heads"]),
+            "head_dim": int(model["head_dim"]),
+            "rotary_dim": int(model["rotary_dim"]),
+            "linear_key_heads": int(model["linear_num_key_heads"]),
+            "linear_value_heads": int(model["linear_num_value_heads"]),
+            "linear_key_dim": int(model["linear_key_head_dim"]),
+            "linear_value_dim": int(model["linear_value_head_dim"]),
+            "conv_kernel": int(model["linear_conv_kernel_dim"]),
+        }
+    if profile in ("test", "synthetic", "synthetic_test", "test_only"):
+        # This is intentionally tiny but preserves every fixed route and all
+        # 24 layers.  It must never be used as the real-model profile.
+        if query_heads == 8:
+            query_heads = 2
+        if query_heads <= 0 or query_heads % 1:
+            raise ValueError("test shape profile requires positive query_heads")
+        return {
+            "hidden": 8,
+            "intermediate": 16,
+            "vocab": 32,
+            "query_heads": int(query_heads),
+            "kv_heads": 1,
+            "head_dim": 4,
+            "rotary_dim": 2,
+            "linear_key_heads": 2,
+            "linear_value_heads": 2,
+            "linear_key_dim": 2,
+            "linear_value_dim": 2,
+            "conv_kernel": 4,
+        }
+    raise ValueError(
+        "unknown shape_profile {!r}; use 'model' or the explicit test-only 'synthetic_test' profile".format(
+            shape_profile
+        )
+    )
+
+
+def _decoder_parameter_manifest(profile: Mapping[str, int], dtype: str) -> Tuple[Mapping[str, Any], ...]:
+    """Return one entry per unique storage class, with per-layer counts."""
+
+    h = profile["hidden"]
+    i = profile["intermediate"]
+    v = profile["vocab"]
+    qh = profile["query_heads"]
+    kvh = profile["kv_heads"]
+    d = profile["head_dim"]
+    nk = profile["linear_key_heads"]
+    nv = profile["linear_value_heads"]
+    dk = profile["linear_key_dim"]
+    dv = profile["linear_value_dim"]
+    c = 2 * nk * dk + nv * dv
+    return (
+        _decoder_parameter_entry(
+            "embedding_lm_head_shared_weight",
+            (v, h),
+            dtype,
+            aliases=("embedding.weight", "lm_head.weight"),
+            storage_id="embedding_lm_head_shared_weight",
+        ),
+        _decoder_parameter_entry("layers.*.input_layernorm.weight", (h,), dtype, count=24),
+        _decoder_parameter_entry("layers.*.post_attention_layernorm.weight", (h,), dtype, count=24),
+        _decoder_parameter_entry("final_norm.weight", (h,), dtype),
+        _decoder_parameter_entry("layers.*.mlp.gate_proj.weight", (i, h), dtype, count=24),
+        _decoder_parameter_entry("layers.*.mlp.up_proj.weight", (i, h), dtype, count=24),
+        _decoder_parameter_entry("layers.*.mlp.down_proj.weight", (h, i), dtype, count=24),
+        _decoder_parameter_entry(
+            "layers.full_attention.*.q_proj.weight", (qh * d * 2, h), dtype, count=6
+        ),
+        _decoder_parameter_entry("layers.full_attention.*.k_proj.weight", (kvh * d, h), dtype, count=6),
+        _decoder_parameter_entry("layers.full_attention.*.v_proj.weight", (kvh * d, h), dtype, count=6),
+        _decoder_parameter_entry("layers.full_attention.*.o_proj.weight", (h, qh * d), dtype, count=6),
+        _decoder_parameter_entry("layers.full_attention.*.q_norm.weight", (d,), dtype, count=6),
+        _decoder_parameter_entry("layers.full_attention.*.k_norm.weight", (d,), dtype, count=6),
+        _decoder_parameter_entry(
+            "layers.linear_attention.*.in_proj_qkv.weight",
+            (2 * nk * dk + nv * dv, h),
+            dtype,
+            count=18,
+        ),
+        _decoder_parameter_entry("layers.linear_attention.*.in_proj_z.weight", (nv * dv, h), dtype, count=18),
+        _decoder_parameter_entry("layers.linear_attention.*.in_proj_b.weight", (nv, h), dtype, count=18),
+        _decoder_parameter_entry("layers.linear_attention.*.in_proj_a.weight", (nv, h), dtype, count=18),
+        _decoder_parameter_entry(
+            "layers.linear_attention.*.conv1d.weight", (c, 1, profile["conv_kernel"]), dtype, count=18
+        ),
+        _decoder_parameter_entry("layers.linear_attention.*.A_log", (nv,), dtype, count=18),
+        _decoder_parameter_entry("layers.linear_attention.*.dt_bias", (nv,), dtype, count=18),
+        _decoder_parameter_entry("layers.linear_attention.*.norm.weight", (dv,), dtype, count=18),
+        _decoder_parameter_entry("layers.linear_attention.*.out_proj.weight", (h, nv * dv), dtype, count=18),
+    )
+
+
+def _manifest_bytes(entries: Sequence[Mapping[str, Any]]) -> Tuple[int, int]:
+    total_elements = 0
+    total_bytes = 0
+    for entry in entries:
+        elements = int(entry["parameter_elements"])
+        bytes_value = int(entry["storage_bytes"])
+        if total_elements > _UINT64_MAX - elements or total_bytes > _UINT64_MAX - bytes_value:
+            raise ValueError("decoder parameter manifest exceeds uint64")
+        total_elements += elements
+        total_bytes += bytes_value
+    return total_elements, total_bytes
