+def test_ptx_tail_and_codes_row_base_arithmetic_is_pinned():
+    """Pin the two PTX address bugs the first RTX 5080 run exposed.
+
+    * qmatmul's widening K tail must use ``(k4*4 + j) * n`` for the right
+      operand, not ``j * n``;
+    * the quantize kernel's int8 codes row base must be ``row * k`` bytes,
+      not ``row`` bytes.
+    """
+
+    _, qmatmul_ir = _compile(_qmatmul_program((2, 7), (7, 3)))
+    for left_offset in (4, 5, 6):
+        assert "ld.global.s8 %r30, [%rd8+{}];".format(left_offset) in qmatmul_ir.ptx
+    for right_offset in (12, 15, 18):
+        assert "ld.global.s8 %r32, [%rd9+{}];".format(right_offset) in qmatmul_ir.ptx
+    _, quantize_ir = _compile(_quantize_program((3, 5)))
+    assert "mul.lo.u64 %rd13, %rd0, %rd10;" in quantize_ir.ptx
