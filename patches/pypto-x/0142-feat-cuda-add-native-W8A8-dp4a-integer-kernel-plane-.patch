+"""CUDA W8A8 integer kernel plane: contract 0002 C6 / R6 evidence (local leg).
+
+Scope of this module:
+
+* the four frozen C1 opcodes lower through the CUDA W8A8 target plane and the
+  emitted PTX carries the native ``dp4a.s32.s32`` main loop plus the explicit
+  widening K tail, the payload/marker/kernel-version gates and no ``sm_120``
+  hardcoding;
+* capability declarations travel through ``CapabilitySet`` and are gated by a
+  real Driver API device probe; injected low-capability devices and missing
+  drivers fail closed;
+* every runtime target entry point matches the C1 portable integer golden
+  bit-for-bit through the runtime marshalling layer (a deterministic fake
+  driver executes the kernels with the portable golden on the host; the real
+  RTX 5080 device leg is ``cuda_w8a8_device_validation.py``);
+* artifact tampering, old payload versions and cross-plane artifacts fail
+  closed.
+
+The local fake driver never pretends to be hardware: it records the launch and
+executes the same portable golden the kernels implement, so it pins argument
+marshalling, shape validation and runtime gating.  The on-device script pins
+the actual PTX/SASS semantics.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import random
+import struct
+
+import pytest
+
+from pypto.backends.cuda import (
+    CudaArtifactError,
+    CudaRuntime,
+    CudaW8A8ArtifactError,
+    CudaW8A8ExecutionError,
+    CudaW8A8QuantizeResult,
+    probe_cuda_w8a8_availability,
+)
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import Artifact
+from pypto.compiler.targets.cuda import CudaPtxCompiler
+from pypto.compiler.targets.cuda_w8a8 import (
+    CUDA_W8A8_ARTIFACT_FORMAT,
+    CUDA_W8A8_BACKEND,
+    CUDA_W8A8_KERNEL_VERSION,
+    CUDA_W8A8_MARKER,
+    CUDA_W8A8_PAYLOAD_VERSION,
+    CUDA_W8A8_PTX_TARGET,
+    CudaW8A8Compiler,
+    CudaW8A8UnavailableError,
+    CudaW8A8UnsupportedError,
+    CudaW8A8ValidationError,
+    decode_cuda_w8a8_artifact,
+    render_w8a8_ptx,
+    w8a8_artifact_is_native,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import (
+    W8A8_DEQUANTIZE_OPCODE,
+    W8A8_EPILOGUE_OPCODE,
+    W8A8_MAX_ACCUMULATOR_K,
+    W8A8_QMATMUL_OPCODE,
+    W8A8_QUANTIZE_OPCODE,
+)
+from pypto.lowering.gpu.cuda_w8a8 import (
+    CUDA_W8A8_CAPABILITY,
+    CUDA_W8A8_FORBIDDEN_MATRIX_CAPABILITIES,
+    CUDA_W8A8_MATRIX_CAPABILITY,
+    CUDA_W8A8_MIN_PTX_TARGET_SM,
+    CudaW8A8Device,
+    cuda_w8a8_capabilities,
+)
+from pypto.portable.qwen35_w8a8_scheme import (
+    OPCODE_DEQUANTIZE_EPILOGUE_BF16,
+    OPCODE_DEQUANTIZE_S8,
+    OPCODE_QMATMUL_S8S8_S32,
+    OPCODE_QUANTIZE_PER_TOKEN_S8,
+    W8A8QuantizationError,
+    W8A8SchemeError,
+    dequantize_epilogue_bf16,
+    dequantize_s8,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+from pypto.target import TargetSpec, UnsupportedCapabilityError
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral")
+DEVICE_SM120 = CudaW8A8Device(0, "fake-sm120", 12, 0)
+
+
+def _program(parameters, returns, operations, name="main"):
+    return CoreProgram(
+        functions=(CoreFunction(name, tuple(parameters), tuple(returns), Region(tuple(operations))),)
+    )
+
+
+def _tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, shape))
+
+
+def _qmatmul_program(left_shape, right_shape, output_shape=None):
+    left = _tensor("left", "int8", left_shape)
+    right = _tensor("right", "int8", right_shape)
+    if output_shape is None:
+        output_shape = left_shape[:-2] + (left_shape[-2], right_shape[-1])
+    output = _tensor("output", "int32", output_shape)
+    return _program(
+        (left, right),
+        (output,),
+        (Operation(W8A8_QMATMUL_OPCODE, (left, right), (output,)),),
+    )
+
+
+def _dequantize_program(codes_shape, rows):
+    codes = _tensor("codes", "int8", codes_shape)
+    scales = _tensor("scales", "float32", (rows,))
+    output = _tensor("output", "float32", codes_shape)
+    return _program(
+        (codes, scales),
+        (output,),
+        (Operation(W8A8_DEQUANTIZE_OPCODE, (codes, scales), (output,)),),
+    )
+
+
+def _epilogue_program(shape):
+    rows, columns = shape
+    accumulator = _tensor("accumulator", "int32", shape)
+    row_scales = _tensor("row_scales", "float32", (rows,))
+    column_scales = _tensor("column_scales", "float32", (columns,))
+    output = _tensor("output", "bf16", shape)
+    return _program(
+        (accumulator, row_scales, column_scales),
+        (output,),
+        (
+            Operation(
+                W8A8_EPILOGUE_OPCODE,
+                (accumulator, row_scales, column_scales),
+                (output,),
+            ),
+        ),
+    )
+
+
+def _quantize_program(shape, dtype="float32"):
+    values = _tensor("values", dtype, shape)
+    codes = _tensor("codes", "int8", shape)
+    scales = _tensor("scales", "float32", (shape[0],))
+    return _program(
+        (values,),
+        (codes, scales),
+        (Operation(W8A8_QUANTIZE_OPCODE, (values,), (codes, scales)),),
+    )
+
+
+def _compile(program, device=DEVICE_SM120, options=None):
+    compiler = CudaW8A8Compiler(device=device)
+    target_ir = compiler.lower(program, TARGET)
+    artifact = compiler.compile(target_ir, options)
+    return artifact, target_ir
+
+
+def _flat(values):
+    if isinstance(values, (list, tuple)):
+        result = []
+        for item in values:
+            result.extend(_flat(item))
+        return result
+    return [values]
+
+
+# ---------------------------------------------------------------------------
+# Deterministic fake driver: executes the portable golden on the host
+# ---------------------------------------------------------------------------
+
+
+class _FakeDeviceInfo:
+    def __init__(self, index, name, major, minor, total_memory=16 * 1024**3):
+        self.index = index
+        self.name = name
+        self.major = major
+        self.minor = minor
+        self.total_memory = total_memory
+
+    def to_dict(self):
+        return {
+            "index": self.index,
+            "name": self.name,
+            "compute_capability": "{}.{}".format(self.major, self.minor),
+            "major": self.major,
+            "minor": self.minor,
+            "total_memory": self.total_memory,
+        }
+
+
+class _FakeModule:
+    def __init__(self, name):
+        self.name = name
+        self.info_log = "fake jit info"
+        self.error_log = ""
+        self._closed = False
+
+    def get_function(self, name):
+        if self._closed:
+            raise RuntimeError("module is closed")
+        return name
+
+    def close(self):
+        self._closed = True
+
+
+class FakeCudaDriver:
+    """Small Driver API double that executes kernels with portable goldens."""
+
+    def __init__(self, major=12, minor=0, name="fake-sm120", fail_device_info=False):
+        self.major = major
+        self.minor = minor
+        self.name = name
+        self.fail_device_info = fail_device_info
+        self.buffers = {}
+        self.next_pointer = 0x100000
+        self.module_loads = 0
+        self.launches = []
+        self.active_operation = None
+        self.context_creates = 0
+        self.synchronizes = 0
+
+    # Driver API surface -------------------------------------------------
+    def device_info(self, index=0):
+        if self.fail_device_info:
+            raise RuntimeError("device probe refused")
+        return _FakeDeviceInfo(index, self.name, self.major, self.minor)
+
+    def context_create(self, index=0):
+        self.context_creates += 1
+        return _FakeContext()
+
+    def context_synchronize(self):
+        self.synchronizes += 1
+
+    def events_available(self):
+        return False
+
+    def module_load_data(self, ptx):
+        self.module_loads += 1
+        return _FakeModule(ptx)
+
+    def mem_alloc(self, size):
+        size = max(1, int(size))
+        pointer = self.next_pointer
+        self.next_pointer += max(16, size)
+        self.buffers[pointer] = bytearray(size)
+        return pointer
+
+    def mem_free(self, pointer):
+        self.buffers.pop(int(pointer), None)
+
+    def _resolve(self, address):
+        address = int(address)
+        for base, buffer in self.buffers.items():
+            if base <= address < base + len(buffer):
+                return buffer, address - base
+        raise KeyError("fake CUDA address is not allocated: {}".format(address))
+
+    def memcpy_htod(self, pointer, data):
+        raw = bytes(data)
+        buffer, offset = self._resolve(pointer)
+        if offset + len(raw) > len(buffer):
+            raise RuntimeError("fake CUDA host-to-device copy exceeds allocation")
+        buffer[offset : offset + len(raw)] = raw
+
+    def memcpy_dtoh(self, pointer, size):
+        buffer, offset = self._resolve(pointer)
+        return bytes(buffer[offset : offset + int(size)])
+
+    def launch_kernel(self, function, grid, block, parameters, stream=None, shared_memory=0):
+        operation = self.active_operation
+        if operation is None:
+            raise AssertionError("fake driver needs active_operation for {}" .format(function))
+        pointers = [int(parameter) for parameter in parameters]
+        self.launches.append((function, tuple(grid), tuple(block), pointers))
+        if operation.operation == W8A8_QMATMUL_OPCODE:
+            self._emulate_qmatmul(operation, pointers)
+        elif operation.operation == W8A8_DEQUANTIZE_OPCODE:
+            self._emulate_dequantize(operation, pointers)
+        elif operation.operation == W8A8_EPILOGUE_OPCODE:
+            self._emulate_epilogue(operation, pointers)
+        elif operation.operation == W8A8_QUANTIZE_OPCODE:
+            self._emulate_quantize(operation, pointers)
+        else:  # pragma: no cover - guarded by the compiler
+            raise AssertionError("unsupported fake kernel {}".format(operation.operation))
+
+    # Emulation ----------------------------------------------------------
+    _FORMAT_ITEMSIZE = {"b": 1, "H": 2, "i": 4, "f": 4}
+
+    def _read(self, pointer, count, fmt):
+        raw = self.memcpy_dtoh(pointer, count * self._FORMAT_ITEMSIZE[fmt])
+        return struct.unpack("<{}{}".format(count, fmt), raw)
+
+    def _write(self, pointer, fmt, values):
+        raw = struct.pack("<{}".format(fmt), *values)
+        buffer, offset = self._resolve(pointer)
+        buffer[offset : offset + len(raw)] = raw
+
+    def _emulate_qmatmul(self, operation, pointers):
+        left = list(self._read(pointers[0], _count(operation.left_shape), "b"))
+        right = list(self._read(pointers[1], _count(operation.right_shape), "b"))
+        result = qmatmul_s8s8_s32(
+            left,
+            right,
+            left_shape=operation.left_shape,
+            right_shape=operation.right_shape,
+        )
+        self._write(pointers[2], "{}i".format(len(result.values)), result.values)
+
+    def _emulate_dequantize(self, operation, pointers):
+        total = _count(operation.codes_shape)
+        codes = list(self._read(pointers[0], total, "b"))
+        scales = list(self._read(pointers[1], operation.rows, "f"))
+        values = dequantize_s8(codes, scales, shape=operation.codes_shape)
+        self._write(pointers[2], "{}f".format(total), values)
+
+    def _emulate_epilogue(self, operation, pointers):
+        total = operation.rows * operation.columns
+        accumulator = list(self._read(pointers[0], total, "i"))
+        row_scales = list(self._read(pointers[1], operation.rows, "f"))
+        column_scales = list(self._read(pointers[2], operation.columns, "f"))
+        try:
+            result = dequantize_epilogue_bf16(
+                accumulator, row_scales, column_scales, shape=operation.accumulator_shape
+            )
+        except W8A8SchemeError:
+            self._write(pointers[4], "i", (1,))
+            return
+        self._write(pointers[3], "{}H".format(total), result.bf16_bits)
+
+    def _emulate_quantize(self, operation, pointers):
+        rows, k = operation.rows, operation.k
+        total = rows * k
+        values = list(self._read(pointers[0], total, "f"))
+        codes = [0] * total
+        scales = [1.0] * rows
+        saturation = 0
+        for row in range(rows):
+            row_values = values[row * k : (row + 1) * k]
+            try:
+                result = quantize_per_token_s8(row_values, shape=(1, k))
+            except W8A8QuantizationError as exc:
+                self._write(pointers[4] + row * 4, "i", (1 if "NaN/Inf" in str(exc) else 2,))
+                continue
+            codes[row * k : (row + 1) * k] = list(result.codes)
+            scales[row] = result.scales[0]
+            saturation += result.saturation_count
+        self._write(pointers[1], "{}b".format(total), codes)
+        self._write(pointers[2], "{}f".format(rows), scales)
+        self._write(pointers[3], "{}i".format(rows), [saturation] + [0] * (rows - 1))
+
+
+class _FakeContext:
+    def __init__(self):
+        self._closed = False
+
+    def close(self):
+        self._closed = True
+
+
+def _count(shape):
+    result = 1
+    for dimension in shape:
+        result *= int(dimension)
+    return result
+
+
+
+
+def _device(major, minor, name=None):
+    return CudaW8A8Device(0, name or "fake-sm{}{}".format(major, minor), major, minor)
+
