+def test_artifact_capability_plan_and_ptx_tamper_fails_closed():
+    artifact, _ = _compile(_qmatmul_program((2, 3), (3, 4)))
+    runtime = _tamper_entry(artifact)
+
+    def flip_capability(decoded):
+        decoded["capability"]["digest"] = "0" * 64
+
+    with pytest.raises(CudaW8A8ArtifactError):
+        runtime.run_w8a8_qmatmul(_resigned(artifact, flip_capability), [0] * 6, [0] * 12)
+
+    def flip_matrix(decoded):
+        decoded["capability"]["matrix_capabilities"] = ["s8s8_s32_vnni_dpbusd"]
+
+    with pytest.raises(CudaW8A8ArtifactError):
+        runtime.run_w8a8_qmatmul(_resigned(artifact, flip_matrix), [0] * 6, [0] * 12)
+
+    def flip_plan(decoded):
+        decoded["plan"][0]["k"] = 5
+
+    with pytest.raises(CudaW8A8ArtifactError):
+        runtime.run_w8a8_qmatmul(_resigned(artifact, flip_plan), [0] * 6, [0] * 12)
