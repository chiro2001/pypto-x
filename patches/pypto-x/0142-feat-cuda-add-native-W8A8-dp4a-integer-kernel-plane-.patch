+    def flip_ptx(decoded):
+        decoded["ptx"] = decoded["ptx"].replace("dp4a.s32.s32", "mad.lo.s32")
+        decoded["ptx_digest"] = hashlib.sha256(decoded["ptx"].encode("utf-8")).hexdigest()
