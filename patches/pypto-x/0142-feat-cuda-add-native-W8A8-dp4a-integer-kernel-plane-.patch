+        CudaW8A8ExecutionError,
+        match="overflow",
+    )
+
+    # d) quantize_per_token_s8.
+    validator.quantize_case(
+        "quantize_random_49",
+        (4, 9),
+        [rng.uniform(-100.0, 100.0) for _ in range(36)],
+    )
+    validator.quantize_case(
+        "quantize_random_316",
+        (3, 16),
+        [rng.uniform(-100.0, 100.0) for _ in range(48)],
+    )
+    validator.quantize_case(
+        "quantize_random_27",
+        (2, 7),
+        [rng.uniform(-100.0, 100.0) for _ in range(14)],
+    )
+    validator.quantize_case(
+        "quantize_all_zero_and_rne_ties",
+        (5, 2),
+        [0.0, 0.0, 0.5, 127.0, 1.5, 127.0, -0.5, 127.0, 2.5, 127.0],
+    )
+    validator.quantize_case(
+        "quantize_saturation",
+        (2, 4),
+        [127.0, 126.9, -127.0, -126.9, 3.4e38, 1.0, -3.4e38, 1.0],
+    )
+    validator.quantize_case(
+        "quantize_bf16_input",
+        (1, 3),
+        [1.0009765625, 2.001953125, -3.0],
+        dtype="bf16",
+    )
+    validator.quantize_case(
+        "quantize_k_133144",
+        (1, 133144),
+        [float((index % 255) - 127) for index in range(133144)],
+    )
+    validator.expect_error(
+        "quantize_nan_inf",
+        lambda: runtime.run_w8a8_quantize_per_token_s8(
+            _compile_only(compiler, _quantize_program((2, 3))),
+            [1.0, 2.0, 3.0, 4.0, float("nan"), 6.0],
+        ),
+        CudaW8A8ExecutionError,
+        match="NaN/Inf",
+    )
+    validator.expect_error(
+        "quantize_scale_underflow",
+        lambda: runtime.run_w8a8_quantize_per_token_s8(
+            _compile_only(compiler, _quantize_program((2, 3))),
+            [1.0e-45, 0.0, 0.0, 1.0, 1.0, 1.0],
+        ),
+        CudaW8A8ExecutionError,
+        match="underflow",
+    )
+
+    # e) deterministic fuzz across tails, non-multiple-of-8/16 shapes and
+    # batch ranks, followed by a mixed four-opcode artifact.
+    fuzz_shapes = [
+        ((1, 1), (1, 1)),
+        ((1, 2), (2, 3)),
+        ((3, 4), (4, 2)),
+        ((5, 5), (5, 5)),
+        ((7, 8), (8, 9)),
+        ((9, 15), (15, 17)),
+        ((16, 17), (17, 16)),
+        ((2, 3, 5), (2, 5, 7)),
+        ((2, 2, 7, 4), (2, 2, 4, 5)),
+        ((1, 1, 1, 9), (1, 1, 9, 3)),
+    ]
+    fuzz_shapes.extend(
+        (
+            ((64, 33), (33, 64)),
+            ((130, 9), (9, 5)),
+        )
+    )
+    for index, (left_shape, right_shape) in enumerate(fuzz_shapes):
+        left = [rng.randint(-127, 127) for _ in range(_count(left_shape))]
+        right = [rng.randint(-127, 127) for _ in range(_count(right_shape))]
+        validator.qmatmul_case("qmatmul_fuzz_{}".format(index), left_shape, right_shape, left, right)
+    for index, shape in enumerate(((1, 1), (7, 1), (1, 17), (5, 33), (40, 33), (2, 3, 5))):
+        rows = _count(shape[:-1])
+        codes = [rng.randint(-127, 127) for _ in range(_count(shape))]
+        scales = [rng.choice((0.0, -0.0, 1.0e-45, 1.0e-3, 2.0, 1.0e30)) for _ in range(rows)]
+        validator.dequantize_case("dequantize_fuzz_{}".format(index), shape, codes, scales)
+    for index, shape in enumerate(((1, 1), (2, 17), (5, 1), (3, 8), (37, 21))):
+        rows, columns = shape
+        validator.epilogue_case(
+            "epilogue_fuzz_{}".format(index),
+            shape,
+            [rng.randint(-(2**31), 2**31 - 1) for _ in range(rows * columns)],
+            [rng.choice((0.0, -0.0, 1.0e-45, 1.0e-3, 0.5)) for _ in range(rows)],
+            [rng.choice((0.0, -0.0, 1.0e-45, 1.0e-3, 2.0)) for _ in range(columns)],
+        )
+    for index, shape in enumerate(((1, 1), (7, 1), (1, 17), (5, 33), (200, 5))):
+        values = [rng.uniform(-100.0, 100.0) for _ in range(_count(shape))]
+        validator.quantize_case("quantize_fuzz_{}".format(index), shape, values)
+
+    # Mixed artifact: one CoreProgram containing all four opcodes; each target
+    # entry point must select its own compiled kernel from the same artifact.
+    mixed_values = _tensor("values", "float32", (2, 4))
+    mixed_codes = _tensor("codes", "int8", (2, 4))
+    mixed_scales = _tensor("scales", "float32", (2,))
+    mixed_dequant = _tensor("dequantized", "float32", (2, 4))
+    mixed_left = _tensor("left", "int8", (2, 4))
+    mixed_right = _tensor("right", "int8", (4, 3))
+    mixed_output = _tensor("output", "int32", (2, 3))
+    mixed_accumulator = _tensor("accumulator", "int32", (2, 3))
+    mixed_row = _tensor("row", "float32", (2,))
+    mixed_col = _tensor("col", "float32", (3,))
+    mixed_bf16 = _tensor("bf16", "bf16", (2, 3))
+    mixed_program = _program(
+        (mixed_values, mixed_left, mixed_right, mixed_accumulator, mixed_row, mixed_col),
+        (mixed_codes, mixed_scales, mixed_dequant, mixed_output, mixed_bf16),
+        (
+            Operation("quantize_per_token_s8", (mixed_values,), (mixed_codes, mixed_scales)),
+            Operation("dequantize_s8", (mixed_codes, mixed_scales), (mixed_dequant,)),
+            Operation("qmatmul_s8s8_s32", (mixed_left, mixed_right), (mixed_output,)),
+            Operation(
+                "dequantize_epilogue_bf16",
+                (mixed_accumulator, mixed_row, mixed_col),
+                (mixed_bf16,),
+            ),
+        ),
+    )
+    mixed_artifact = _compile_only(compiler, mixed_program)
+    mixed_values_host = [rng.uniform(-50.0, 50.0) for _ in range(8)]
+    mixed_left_host = [rng.randint(-127, 127) for _ in range(8)]
+    mixed_right_host = [rng.randint(-127, 127) for _ in range(12)]
+    mixed_accumulator_host = [rng.randint(-100000, 100000) for _ in range(6)]
+    mixed_row_host = [0.5, 1.5]
+    mixed_col_host = [0.25, 0.5, 0.75]
+    mixed_quant = runtime.run_w8a8_quantize_per_token_s8(
+        mixed_artifact, mixed_values_host, shape=(2, 4)
+    )
+    expected_quant = quantize_per_token_s8([_f32(value) for value in mixed_values_host], shape=(2, 4))
+    mixed_dequantized = runtime.run_w8a8_dequantize_s8(
+        mixed_artifact, mixed_quant.codes, mixed_quant.scales, shape=(2, 4)
+    )
+    expected_dequantized = dequantize_s8(
+        expected_quant.codes, list(expected_quant.scales), shape=(2, 4)
+    )
+    mixed_matmul = runtime.run_w8a8_qmatmul(mixed_artifact, mixed_left_host, mixed_right_host)
+    expected_matmul = qmatmul_s8s8_s32(
+        mixed_left_host, mixed_right_host, left_shape=(2, 4), right_shape=(4, 3)
+    )
+    mixed_epilogue = runtime.run_w8a8_dequantize_epilogue_bf16(
+        mixed_artifact, mixed_accumulator_host, mixed_row_host, mixed_col_host
+    )
+    expected_epilogue = dequantize_epilogue_bf16(
+        mixed_accumulator_host, mixed_row_host, mixed_col_host, shape=(2, 3)
+    )
+    if (
+        tuple(mixed_quant.codes) == tuple(expected_quant.codes)
+        and all(_f32_equal(a, b) for a, b in zip(mixed_quant.scales, expected_quant.scales))
+        and all(_f32_equal(a, b) for a, b in zip(mixed_dequantized, expected_dequantized))
+        and tuple(mixed_matmul) == tuple(expected_matmul.values)
+        and all(_bf16_bits_equal(a, b) for a, b in zip(mixed_epilogue, expected_epilogue.bf16_bits))
+    ):
+        validator.checks.append(
+            {"check": "mixed_four_opcode_artifact", "detail": "all four target entry points match"}
+        )
+    else:
+        validator.mismatches.append(
+            {
+                "check": "mixed_four_opcode_artifact",
+                "expected": {
+                    "codes": list(expected_quant.codes),
+                    "matmul": list(expected_matmul.values),
+                    "epilogue": list(expected_epilogue.bf16_bits),
+                },
+                "actual": {
+                    "codes": list(mixed_quant.codes),
+                    "matmul": list(mixed_matmul),
+                    "epilogue": list(mixed_epilogue),
+                },
+            }
+        )
+
+    report = {
+        "device": info.to_dict() if hasattr(info, "to_dict") else info,
+        "w8a8_probe": probe,
+        "checks": validator.checks,
+        "mismatches": validator.mismatches,
+        "status": "PASS" if not validator.mismatches else "FAIL",
+    }
+    print(json.dumps(report, indent=2, ensure_ascii=False))
+    return 0 if not validator.mismatches else 1
+
+
+def _compile_only(compiler, program):
+    target_ir = compiler.lower(program, TARGET)
+    return compiler.compile(target_ir)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
