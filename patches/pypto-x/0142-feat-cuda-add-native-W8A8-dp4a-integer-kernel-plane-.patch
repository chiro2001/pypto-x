index 000000000..ab53817be
--- /dev/null
+++ b/python/pypto/compiler/targets/cuda_w8a8.py
@@ -0,0 +1,1290 @@
+"""CUDA W8A8 integer kernel plane (contract 0002 C6 / R6).
+
+This module is deliberately separate from :mod:`pypto.compiler.targets.cuda`
+(the float/bf16 CUDA plane).  The W8A8 plane consumes only the four frozen C1
+opcodes and emits a dedicated PTX correctness kernel per operation:
+
+* ``qmatmul_s8s8_s32``            native ``dp4a.s32.s32`` main loop with an
+                                  explicit widening (``cvt.s32.s8`` +
+                                  ``mad.lo.s32``) K tail;
+* ``quantize_per_token_s8``       per-row absmax, double-precision division,
+                                  RNE ties-to-even, clamp/saturation count,
+                                  NaN/Inf and scale-underflow fail-closed;
+* ``dequantize_s8``               int8 x fp32 -> fp32;
+* ``dequantize_epilogue_bf16``    single-rounding fp32 epilogue with the
+                                  project's RNE bf16 bit rule implemented
+                                  explicitly (so NaN payloads match).
+
+Three independent gates protect the artifact (mirroring C3/C4/C5):
+
+1. **payload version** ``CUDA_W8A8_PAYLOAD_VERSION == 3``; the float CUDA
+   plane is payload 2 and can never be reinterpreted as W8A8 (and vice
+   versa);
+2. **PTX marker** ``pypto-x.cuda.w8a8:1`` embedded in the PTX text and in the
+   metadata, re-rendered and re-checked on every decode;
+3. **kernel version** ``CUDA_W8A8_KERNEL_VERSION == 1`` carried in both
+   payload and metadata.
+
+The capability gate is a real device probe (see
+:mod:`pypto.backends.cuda.capabilities`); this module only accepts a probed
+:class:`~pypto.lowering.gpu.cuda_w8a8.CudaW8A8Device`.  No BF16 fallback
+exists inside the W8A8 path.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram, CoreType, Operation, ValueRef
+from pypto.lowering.cpu import (
+    CpuScalarError,
+    W8A8_DEQUANTIZE_OPCODE,
+    W8A8_EPILOGUE_OPCODE,
+    W8A8_MAX_ACCUMULATOR_K,
+    W8A8_QMATMUL_OPCODE,
+    W8A8_QUANTIZE_OPCODE,
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    static_shape,
+    validate_program,
+)
+from pypto.lowering.gpu.cuda_w8a8 import (
+    CUDA_W8A8_CAPABILITY,
+    CUDA_W8A8_COMPENSATION,
+    CUDA_W8A8_FORBIDDEN_MATRIX_CAPABILITIES,
+    CUDA_W8A8_MATRIX_CAPABILITY,
+    CudaW8A8Device,
+    CudaW8A8UnavailableError,
+    cuda_w8a8_capabilities,
+    cuda_w8a8_capability_metadata,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import frozen_mapping, mapping_copy, sha256_text
+
+from .cuda import (
+    CUDA_PTX_VERSION,
+    _SUPPORTED_PTX_VERSIONS,
+    _validate_ptx_target,
+    _validate_ptx_version,
+)
+
+
+CUDA_W8A8_BACKEND = "cuda.ptx.w8a8"
+CUDA_W8A8_ARTIFACT_FORMAT = "pypto-x.cuda.w8a8.ptx"
+#: Layer 1: payload version.  The float CUDA plane is payload 2; W8A8 is 3.
+CUDA_W8A8_PAYLOAD_VERSION = 3
+#: Layer 2: human- and machine-readable marker embedded in PTX and metadata.
+CUDA_W8A8_MARKER = "pypto-x.cuda.w8a8:1"
+#: Layer 3: W8A8 kernel contract version.
+CUDA_W8A8_KERNEL_VERSION = 1
+CUDA_W8A8_LOWERING_VERSION = 1
+CUDA_W8A8_PLAN_VERSION = 1
+#: The W8A8 module targets the CUDA 13.x toolkit floor (Turing, sm_75), which
+#: is also the smallest target that supports ``dp4a`` in that toolchain.
+CUDA_W8A8_PTX_TARGET = "sm_75"
+#: Block size for the W8A8 kernels (one-dimensional launch).
+CUDA_W8A8_BLOCK = 128
+
+W8A8_QMATMUL_MODE = "native_cuda_w8a8_qmatmul_dp4a"
+W8A8_QUANTIZE_MODE = "native_cuda_w8a8_quantize_per_token_s8"
+W8A8_DEQUANTIZE_MODE = "native_cuda_w8a8_dequantize_s8"
+W8A8_EPILOGUE_MODE = "native_cuda_w8a8_epilogue_bf16"
+W8A8_MODES = frozenset((W8A8_QMATMUL_MODE, W8A8_QUANTIZE_MODE, W8A8_DEQUANTIZE_MODE, W8A8_EPILOGUE_MODE))
+
+_KERNEL_SUFFIX = {
+    W8A8_QMATMUL_OPCODE: "qmatmul_s8s8_s32",
+    W8A8_QUANTIZE_OPCODE: "quantize_per_token_s8",
+    W8A8_DEQUANTIZE_OPCODE: "dequantize_s8",
+    W8A8_EPILOGUE_OPCODE: "dequantize_epilogue_bf16",
+}
+_MODE_BY_OPCODE = {
+    W8A8_QMATMUL_OPCODE: W8A8_QMATMUL_MODE,
+    W8A8_QUANTIZE_OPCODE: W8A8_QUANTIZE_MODE,
+    W8A8_DEQUANTIZE_OPCODE: W8A8_DEQUANTIZE_MODE,
+    W8A8_EPILOGUE_OPCODE: W8A8_EPILOGUE_MODE,
+}
+_PTX_MARKER_LINE = "// pypto-x.cuda.w8a8 marker: {}".format(CUDA_W8A8_MARKER)
+_PTX_KERNEL_VERSION_LINE = "// pypto-x.cuda.w8a8 kernel version: {}".format(CUDA_W8A8_KERNEL_VERSION)
+_ENTRY_NAME_RE = re.compile(r"^\.visible \.entry ([A-Za-z_][A-Za-z0-9_]*)\(", re.MULTILINE)
+
+
+class CudaW8A8Error(ValueError):
+    """Base error for the CUDA W8A8 target plane."""
+
+
+class CudaW8A8ValidationError(CudaW8A8Error):
+    """A Core IR program is outside the frozen W8A8 contract."""
+
+
+class CudaW8A8UnsupportedError(CudaW8A8Error):
+    """The program is valid Core IR but not lowerable by the CUDA W8A8 plane."""
+
+
+class CudaW8A8ArtifactError(CudaW8A8Error):
+    """A malformed, tampered or incompatible W8A8 artifact."""
+
+
+def _plain(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain(item) for item in value]
+    return value
+
+
+def _shape_product(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= int(dimension)
+    return result
+
+
+@dataclass(frozen=True)
+class CudaW8A8OperationPlan:
+    """One validated W8A8 operation and the static shapes it was compiled for."""
+
+    operation_index: int
+    operation: str
+    kernel: str
+    mode: str
+    input_names: Tuple[str, ...]
+    output_names: Tuple[str, ...]
+    left_dtype: str = ""
+    right_dtype: str = ""
+    output_dtype: str = ""
+    input_dtype: str = ""
+    codes_dtype: str = ""
+    scales_dtype: str = ""
+    accumulator_dtype: str = ""
+    row_scales_dtype: str = ""
+    column_scales_dtype: str = ""
+    m: int = 0
+    k: int = 0
+    n: int = 0
+    rows: int = 0
+    columns: int = 0
+    batch_shape: Tuple[int, ...] = ()
+    left_shape: Tuple[int, ...] = ()
+    right_shape: Tuple[int, ...] = ()
+    output_shape: Tuple[int, ...] = ()
+    input_shape: Tuple[int, ...] = ()
+    codes_shape: Tuple[int, ...] = ()
+    scales_shape: Tuple[int, ...] = ()
+    accumulator_shape: Tuple[int, ...] = ()
+    row_scales_shape: Tuple[int, ...] = ()
+    column_scales_shape: Tuple[int, ...] = ()
+    output_names_order: Tuple[str, ...] = ()
+    compensation: str = ""
+
+    def to_dict(self) -> Mapping[str, Any]:
+        result: dict = {}
+        for name in self.__dataclass_fields__:
+            value = getattr(self, name)
+            if isinstance(value, tuple):
+                value = list(value)
+            result[name] = value
+        return result
+
+    @classmethod
+    def from_dict(cls, value: Any) -> "CudaW8A8OperationPlan":
+        if not isinstance(value, Mapping):
+            raise CudaW8A8ArtifactError("W8A8 plan entry must be an object")
+        expected = set(cls.__dataclass_fields__)
+        if set(value) != expected:
+            raise CudaW8A8ArtifactError("W8A8 plan entry has unknown or missing fields")
+        fields = {}
+        for name in expected:
+            item = value[name]
+            if name in (
+                "input_names",
+                "output_names",
+                "output_names_order",
+                "batch_shape",
+                "left_shape",
+                "right_shape",
+                "output_shape",
+                "input_shape",
+                "codes_shape",
+                "scales_shape",
+                "accumulator_shape",
+                "row_scales_shape",
+                "column_scales_shape",
+            ):
+                if not isinstance(item, (list, tuple)):
+                    raise CudaW8A8ArtifactError("W8A8 plan entry {!r} must be a sequence".format(name))
+                item = tuple(int(part) if isinstance(part, int) and not isinstance(part, bool) else part for part in item)
+            elif name in ("operation_index", "m", "k", "n", "rows", "columns"):
+                if isinstance(item, bool) or not isinstance(item, int):
+                    raise CudaW8A8ArtifactError("W8A8 plan entry {!r} must be an integer".format(name))
+            elif name in ("operation", "kernel", "mode", "compensation") or name.endswith("_dtype"):
+                if not isinstance(item, str):
+                    raise CudaW8A8ArtifactError("W8A8 plan entry {!r} must be a string".format(name))
+            fields[name] = item
+        plan = cls(**fields)
+        return plan.validate()
+
+    def validate(self) -> "CudaW8A8OperationPlan":
+        if self.operation not in _MODE_BY_OPCODE:
+            raise CudaW8A8ArtifactError("unknown W8A8 operation {!r}".format(self.operation))
+        if self.mode != _MODE_BY_OPCODE[self.operation]:
+            raise CudaW8A8ArtifactError("W8A8 plan mode does not match the operation")
+        if not self.kernel.startswith("px_w8a8_op{}_".format(self.operation_index)):
+            raise CudaW8A8ArtifactError("W8A8 kernel symbol does not match the operation index")
+        if self.compensation != CUDA_W8A8_COMPENSATION:
+            raise CudaW8A8ArtifactError("W8A8 plan compensation token mismatch")
+        if len(self.input_names) == 0 or len(self.output_names) == 0:
+            raise CudaW8A8ArtifactError("W8A8 plan entry requires input and output names")
+        return self
+
+
+def _operation_bindings(operation: Operation) -> Tuple[Mapping[str, Any], ...]:
+    bindings = []
+    for ref in operation.inputs:
+        bindings.append(
+            {
+                "name": ref.name,
+                "kind": "tensor",
+                "dtype": canonical_dtype(ref.type.dtype),
+                "role": "input",
+            }
+        )
+    for ref in operation.outputs:
+        bindings.append(
+            {
+                "name": ref.name,
+                "kind": "tensor",
+                "dtype": canonical_dtype(ref.type.dtype),
+                "role": "output",
+            }
+        )
+    return tuple(bindings)
+
+
+def _tensor(name: str, dtype: str, shape: Sequence[int]) -> ValueRef:
+    return ValueRef(name, CoreType.tensor(dtype, tuple(int(dimension) for dimension in shape)))
+
+
+def _plan_for_operation(program: CoreProgram, operation: Operation, index: int) -> CudaW8A8OperationPlan:
+    name = canonical_operation_name(operation.name)
+    if name not in _MODE_BY_OPCODE:
+        raise CudaW8A8UnsupportedError(
+            "CUDA W8A8 plane does not implement operation {!r}".format(operation.name)
+        )
+    kernel = "px_w8a8_op{}_{}".format(index, _KERNEL_SUFFIX[name])
+    input_names = tuple(ref.name for ref in operation.inputs)
+    output_names = tuple(ref.name for ref in operation.outputs)
+    common = {
+        "operation_index": index,
+        "operation": name,
+        "kernel": kernel,
+        "mode": _MODE_BY_OPCODE[name],
+        "input_names": input_names,
+        "output_names": output_names,
+        "compensation": CUDA_W8A8_COMPENSATION,
+    }
+    if name == W8A8_QMATMUL_OPCODE:
+        left_shape = static_shape(operation.inputs[0].type, "w8a8 qmatmul left")
+        right_shape = static_shape(operation.inputs[1].type, "w8a8 qmatmul right")
+        output_shape = static_shape(operation.outputs[0].type, "w8a8 qmatmul output")
+        m, k = left_shape[-2], left_shape[-1]
+        n = right_shape[-1]
+        return CudaW8A8OperationPlan(
+            **common,
+            left_dtype=canonical_dtype(operation.inputs[0].type.dtype),
+            right_dtype=canonical_dtype(operation.inputs[1].type.dtype),
+            output_dtype=canonical_dtype(operation.outputs[0].type.dtype),
+            m=int(m),
+            k=int(k),
+            n=int(n),
+            batch_shape=tuple(int(dimension) for dimension in left_shape[:-2]),
+            left_shape=tuple(int(dimension) for dimension in left_shape),
+            right_shape=tuple(int(dimension) for dimension in right_shape),
+            output_shape=tuple(int(dimension) for dimension in output_shape),
+        )
+    if name == W8A8_QUANTIZE_OPCODE:
+        input_shape = static_shape(operation.inputs[0].type, "w8a8 quantize input")
+        codes_shape = static_shape(operation.outputs[0].type, "w8a8 quantize codes")
+        scales_shape = static_shape(operation.outputs[1].type, "w8a8 quantize scales")
+        rows, k = input_shape
+        return CudaW8A8OperationPlan(
+            **common,
+            input_dtype=canonical_dtype(operation.inputs[0].type.dtype),
+            codes_dtype=canonical_dtype(operation.outputs[0].type.dtype),
+            scales_dtype=canonical_dtype(operation.outputs[1].type.dtype),
+            rows=int(rows),
+            k=int(k),
+            input_shape=tuple(int(dimension) for dimension in input_shape),
+            codes_shape=tuple(int(dimension) for dimension in codes_shape),
+            scales_shape=tuple(int(dimension) for dimension in scales_shape),
+        )
+    if name == W8A8_DEQUANTIZE_OPCODE:
+        codes_shape = static_shape(operation.inputs[0].type, "w8a8 dequantize codes")
+        scales_shape = static_shape(operation.inputs[1].type, "w8a8 dequantize scales")
+        output_shape = static_shape(operation.outputs[0].type, "w8a8 dequantize output")
+        k = codes_shape[-1]
+        rows = element_count(codes_shape[:-1]) if len(codes_shape) > 1 else 1
+        return CudaW8A8OperationPlan(
+            **common,
+            codes_dtype=canonical_dtype(operation.inputs[0].type.dtype),
+            scales_dtype=canonical_dtype(operation.inputs[1].type.dtype),
+            output_dtype=canonical_dtype(operation.outputs[0].type.dtype),
+            rows=int(rows),
+            k=int(k),
+            codes_shape=tuple(int(dimension) for dimension in codes_shape),
+            scales_shape=tuple(int(dimension) for dimension in scales_shape),
+            output_shape=tuple(int(dimension) for dimension in output_shape),
+        )
+    # dequantize_epilogue_bf16
+    accumulator_shape = static_shape(operation.inputs[0].type, "w8a8 epilogue accumulator")
+    row_scales_shape = static_shape(operation.inputs[1].type, "w8a8 epilogue row scales")
+    column_scales_shape = static_shape(operation.inputs[2].type, "w8a8 epilogue column scales")
+    output_shape = static_shape(operation.outputs[0].type, "w8a8 epilogue output")
+    rows, columns = accumulator_shape
+    return CudaW8A8OperationPlan(
+        **common,
+        accumulator_dtype=canonical_dtype(operation.inputs[0].type.dtype),
+        row_scales_dtype=canonical_dtype(operation.inputs[1].type.dtype),
+        column_scales_dtype=canonical_dtype(operation.inputs[2].type.dtype),
+        output_dtype=canonical_dtype(operation.outputs[0].type.dtype),
+        rows=int(rows),
+        columns=int(columns),
+        accumulator_shape=tuple(int(dimension) for dimension in accumulator_shape),
+        row_scales_shape=tuple(int(dimension) for dimension in row_scales_shape),
+        column_scales_shape=tuple(int(dimension) for dimension in column_scales_shape),
+        output_shape=tuple(int(dimension) for dimension in output_shape),
+    )
+
+
+def _plan_digest(operations: Sequence[CudaW8A8OperationPlan]) -> str:
+    payload = [operation.to_dict() for operation in operations]
+    return sha256_text(payload)
+
+
+# ---------------------------------------------------------------------------
+# PTX rendering
+# ---------------------------------------------------------------------------
+
+_PREAMBLE = """    .reg .pred %p<16>;
+    .reg .b32 %r<64>;
+    .reg .b64 %rd<64>;
+    .reg .f32 %f<32>;
+    .reg .f64 %fd<32>;
+    .reg .b16 %rs<8>;"""
+
+_THREAD_INDEX = """    mov.u32 %r0, %ctaid.x;
+    mov.u32 %r1, %ntid.x;
+    mov.u32 %r2, %tid.x;
+    mad.lo.u32 %r3, %r0, %r1, %r2;
+    cvt.u64.u32 %rd0, %r3;"""
+
+
+def _render_kernel_header(kernel: str, params: int) -> str:
+    lines = [".visible .entry {}(".format(kernel)]
+    declarations = ["    .param .u64 p{}".format(index) for index in range(params)]
+    lines.append(",\n".join(declarations))
+    lines.append(") {")
+    lines.append(_PREAMBLE)
+    lines.append(_THREAD_INDEX)
+    return "\n".join(lines)
+
+
+def _render_qmatmul(plan: CudaW8A8OperationPlan) -> str:
+    m, k, n = plan.m, plan.k, plan.n
+    batch = _shape_product(plan.batch_shape)
+    total = batch * m * n
+    k4 = k // 4
+    tail = k % 4
+    lines = [_render_kernel_header(plan.kernel, 3)]
+    lines.append("    ld.param.u64 %rd1, [p0];")
+    lines.append("    ld.param.u64 %rd2, [p1];")
+    lines.append("    ld.param.u64 %rd3, [p2];")
+    lines.append("    setp.ge.u64 %p0, %rd0, {};".format(total))
+    lines.append("    @%p0 bra DONE;")
+    lines.append("    mov.u64 %rd10, {};".format(m * n))
+    lines.append("    div.u64 %rd5, %rd0, %rd10;")
+    lines.append("    rem.u64 %rd11, %rd0, %rd10;")
+    lines.append("    mov.u64 %rd12, {};".format(n))
+    lines.append("    div.u64 %rd6, %rd11, %rd12;")
+    lines.append("    rem.u64 %rd7, %rd11, %rd12;")
+    # left row base = (batch * m + row) * k
+    lines.append("    mov.u64 %rd13, {};".format(m))
+    lines.append("    mul.lo.u64 %rd14, %rd5, %rd13;")
+    lines.append("    add.u64 %rd14, %rd14, %rd6;")
+    lines.append("    mov.u64 %rd15, {};".format(k))
+    lines.append("    mul.lo.u64 %rd14, %rd14, %rd15;")
+    lines.append("    add.u64 %rd8, %rd1, %rd14;")
+    # right column base = batch * k * n + col
+    lines.append("    mov.u64 %rd16, {};".format(k * n))
+    lines.append("    mul.lo.u64 %rd17, %rd5, %rd16;")
+    lines.append("    add.u64 %rd17, %rd17, %rd7;")
+    lines.append("    add.u64 %rd9, %rd2, %rd17;")
+    lines.append("    mov.u32 %r4, 0;")
+    lines.append("    mov.u64 %rd20, 0;")
+    lines.append("    mov.u64 %rd21, {};".format(k4))
+    lines.append("    mov.u64 %rd22, {};".format(4 * n))
+    lines.append("MAIN:")
+    lines.append("    setp.ge.u64 %p1, %rd20, %rd21;")
+    lines.append("    @%p1 bra TAIL;")
+    lines.append("    mul.lo.u64 %rd23, %rd20, 4;")
+    lines.append("    add.u64 %rd24, %rd8, %rd23;")
+    lines.append("    mul.lo.u64 %rd25, %rd20, %rd22;")
+    lines.append("    add.u64 %rd26, %rd9, %rd25;")
+    for index, offset in enumerate((0, 1, 2, 3)):
+        lines.append("    ld.global.u8 %r{}, [%rd24+{}];".format(10 + index, offset))
+    for index, offset in ((1, 8), (2, 16), (3, 24)):
+        lines.append("    shl.b32 %r{}, %r{}, {};".format(10 + index, 10 + index, offset))
+        lines.append("    or.b32 %r10, %r10, %r{};".format(10 + index))
+    for index, offset in enumerate((0, n, 2 * n, 3 * n)):
+        lines.append("    ld.global.u8 %r{}, [%rd26+{}];".format(20 + index, offset))
+    for index, offset in ((1, 8), (2, 16), (3, 24)):
+        lines.append("    shl.b32 %r{}, %r{}, {};".format(20 + index, 20 + index, offset))
+        lines.append("    or.b32 %r20, %r20, %r{};".format(20 + index))
+    lines.append("    dp4a.s32.s32 %r4, %r10, %r20, %r4;")
+    lines.append("    add.u64 %rd20, %rd20, 1;")
+    lines.append("    bra MAIN;")
+    lines.append("TAIL:")
+    for index in range(tail):
+        left_offset = k4 * 4 + index
+        right_offset = (k4 * 4 + index) * n
+        lines.append("    ld.global.s8 %r30, [%rd8+{}];".format(left_offset))
+        lines.append("    cvt.s32.s8 %r31, %r30;")
+        lines.append("    ld.global.s8 %r32, [%rd9+{}];".format(right_offset))
+        lines.append("    cvt.s32.s8 %r33, %r32;")
+        lines.append("    mad.lo.s32 %r4, %r31, %r33, %r4;")
+    lines.append("    mul.lo.u64 %rd27, %rd0, 4;")
+    lines.append("    add.u64 %rd28, %rd3, %rd27;")
+    lines.append("    st.global.u32 [%rd28], %r4;")
+    lines.append("DONE:")
+    lines.append("    ret;")
+    lines.append("}")
+    return "\n".join(lines)
+
+
+def _render_dequantize(plan: CudaW8A8OperationPlan) -> str:
+    rows, k = plan.rows, plan.k
+    total = rows * k
+    lines = [_render_kernel_header(plan.kernel, 3)]
+    lines.append("    ld.param.u64 %rd1, [p0];")
+    lines.append("    ld.param.u64 %rd2, [p1];")
+    lines.append("    ld.param.u64 %rd3, [p2];")
+    lines.append("    setp.ge.u64 %p0, %rd0, {};".format(total))
+    lines.append("    @%p0 bra DONE;")
+    lines.append("    mov.u64 %rd10, {};".format(k))
+    lines.append("    div.u64 %rd6, %rd0, %rd10;")
+    lines.append("    add.u64 %rd11, %rd1, %rd0;")
+    lines.append("    ld.global.s8 %r10, [%rd11];")
+    lines.append("    cvt.s32.s8 %r11, %r10;")
+    lines.append("    cvt.rn.f32.s32 %f0, %r11;")
+    lines.append("    mul.lo.u64 %rd12, %rd6, 4;")
+    lines.append("    add.u64 %rd13, %rd2, %rd12;")
+    lines.append("    ld.global.f32 %f1, [%rd13];")
+    lines.append("    mul.rn.f32 %f2, %f0, %f1;")
+    lines.append("    mul.lo.u64 %rd14, %rd0, 4;")
+    lines.append("    add.u64 %rd15, %rd3, %rd14;")
+    lines.append("    st.global.f32 [%rd15], %f2;")
+    lines.append("DONE:")
+    lines.append("    ret;")
+    lines.append("}")
+    return "\n".join(lines)
+
+
+def _render_epilogue(plan: CudaW8A8OperationPlan) -> str:
+    rows, columns = plan.rows, plan.columns
+    total = rows * columns
+    lines = [_render_kernel_header(plan.kernel, 5)]
+    lines.append("    ld.param.u64 %rd1, [p0];")
+    lines.append("    ld.param.u64 %rd2, [p1];")
+    lines.append("    ld.param.u64 %rd3, [p2];")
+    lines.append("    ld.param.u64 %rd4, [p3];")
+    lines.append("    ld.param.u64 %rd5, [p4];")
+    lines.append("    setp.ge.u64 %p0, %rd0, {};".format(total))
+    lines.append("    @%p0 bra DONE;")
+    lines.append("    mov.u64 %rd10, {};".format(columns))
+    lines.append("    div.u64 %rd6, %rd0, %rd10;")
+    lines.append("    rem.u64 %rd7, %rd0, %rd10;")
+    lines.append("    mul.lo.u64 %rd11, %rd0, 4;")
+    lines.append("    add.u64 %rd12, %rd1, %rd11;")
+    lines.append("    ld.global.s32 %r10, [%rd12];")
+    lines.append("    cvt.rn.f32.s32 %f0, %r10;")
+    lines.append("    mul.lo.u64 %rd13, %rd6, 4;")
+    lines.append("    add.u64 %rd14, %rd2, %rd13;")
+    lines.append("    ld.global.f32 %f1, [%rd14];")
+    lines.append("    mul.lo.u64 %rd15, %rd7, 4;")
+    lines.append("    add.u64 %rd16, %rd3, %rd15;")
+    lines.append("    ld.global.f32 %f2, [%rd16];")
+    lines.append("    mul.rn.f32 %f3, %f1, %f2;")
+    lines.append("    mul.rn.f32 %f4, %f0, %f3;")
+    # Overflow fail-closed flag: only a finite-operand product that becomes
+    # infinite is an error; infinite/NaN scales pass through like the golden.
+    lines.append("    testp.infinite.f32 %p1, %f4;")
+    lines.append("    testp.infinite.f32 %p2, %f1;")
+    lines.append("    testp.infinite.f32 %p3, %f2;")
+    lines.append("    or.pred %p2, %p2, %p3;")
+    lines.append("    and.pred %p1, %p1, !%p2;")
+    lines.append("    @%p1 st.global.u32 [%rd5], 1;")
+    # Explicit RNE bf16 conversion (matches portable bf16_rne_bits, including
+    # NaN quieting and the exponent-all-ones special case).
+    lines.append("    mov.b32 %r12, %f4;")
+    lines.append("    and.b32 %r13, %r12, 0x7F800000;")
+    lines.append("    setp.eq.u32 %p4, %r13, 0x7F800000;")
+    lines.append("    @%p4 bra NANPATH;")
+    lines.append("    shr.u32 %r14, %r12, 16;")
+    lines.append("    and.b32 %r14, %r14, 1;")
+    lines.append("    add.u32 %r15, %r12, 0x7FFF;")
+    lines.append("    add.u32 %r15, %r15, %r14;")
+    lines.append("    shr.u32 %r16, %r15, 16;")
+    lines.append("    and.b32 %r16, %r16, 0xFFFF;")
+    lines.append("    bra BF16DONE;")
+    lines.append("NANPATH:")
+    lines.append("    shr.u32 %r17, %r12, 16;")
+    lines.append("    and.b32 %r18, %r12, 0x007FFFFF;")
+    lines.append("    setp.eq.u32 %p5, %r18, 0;")
+    lines.append("    @%p5 bra NANZERO;")
+    lines.append("    or.b32 %r16, %r17, 0x0040;")
+    lines.append("    bra BF16DONE;")
+    lines.append("NANZERO:")
+    lines.append("    mov.u32 %r16, %r17;")
+    lines.append("BF16DONE:")
+    lines.append("    mul.lo.u64 %rd17, %rd0, 2;")
+    lines.append("    add.u64 %rd18, %rd4, %rd17;")
+    lines.append("    st.global.u16 [%rd18], %r16;")
+    lines.append("DONE:")
+    lines.append("    ret;")
+    lines.append("}")
+    return "\n".join(lines)
+
+
+def _render_quantize(plan: CudaW8A8OperationPlan) -> str:
+    rows, k = plan.rows, plan.k
+    lines = [_render_kernel_header(plan.kernel, 5)]
+    lines.append("    ld.param.u64 %rd1, [p0];")
+    lines.append("    ld.param.u64 %rd2, [p1];")
+    lines.append("    ld.param.u64 %rd3, [p2];")
+    lines.append("    ld.param.u64 %rd4, [p3];")
+    lines.append("    ld.param.u64 %rd5, [p4];")
+    lines.append("    setp.ge.u64 %p0, %rd0, {};".format(rows))
+    lines.append("    @%p0 bra DONE;")
+    # Row base addresses.
+    lines.append("    mov.u64 %rd10, {};".format(k))
+    lines.append("    mul.lo.u64 %rd11, %rd0, %rd10;")
+    lines.append("    mul.lo.u64 %rd11, %rd11, 4;")
+    lines.append("    add.u64 %rd12, %rd1, %rd11;")
+    # codes row base: row * k int8 elements (NOT row bytes).
+    lines.append("    mul.lo.u64 %rd13, %rd0, %rd10;")
+    lines.append("    add.u64 %rd13, %rd2, %rd13;")
+    lines.append("    mul.lo.u64 %rd14, %rd0, 4;")
+    lines.append("    add.u64 %rd15, %rd3, %rd14;")
+    lines.append("    add.u64 %rd16, %rd4, %rd14;")
+    lines.append("    add.u64 %rd17, %rd5, %rd14;")
+    # Pass 1: absmax + NaN/Inf detection.
+    lines.append("    mov.f32 %f0, 0f00000000;")
+    lines.append("    mov.u64 %rd20, 0;")
+    lines.append("    mov.u32 %r20, 0;")
+    lines.append("    mov.u64 %rd21, {};".format(k))
+    lines.append("ABSLOOP:")
+    lines.append("    setp.ge.u64 %p1, %rd20, %rd21;")
+    lines.append("    @%p1 bra ABSDONE;")
+    lines.append("    mul.lo.u64 %rd22, %rd20, 4;")
+    lines.append("    add.u64 %rd23, %rd12, %rd22;")
+    lines.append("    ld.global.f32 %f1, [%rd23];")
+    lines.append("    testp.finite.f32 %p2, %f1;")
+    lines.append("    not.pred %p2, %p2;")
+    lines.append("    @%p2 mov.u32 %r20, 1;")
+    lines.append("    abs.f32 %f2, %f1;")
+    lines.append("    max.f32 %f0, %f0, %f2;")
+    lines.append("    add.u64 %rd20, %rd20, 1;")
+    lines.append("    bra ABSLOOP;")
+    lines.append("ABSDONE:")
+    lines.append("    setp.ne.u32 %p3, %r20, 0;")
+    lines.append("    @%p3 bra BAD;")
+    lines.append("    setp.eq.f32 %p4, %f0, 0f00000000;")
+    lines.append("    @%p4 bra ZEROROW;")
+    lines.append("    div.rn.f32 %f3, %f0, 0f42FE0000;")
+    lines.append("    setp.eq.f32 %p5, %f3, 0f00000000;")
+    lines.append("    @%p5 bra UNDERFLOW;")
+    lines.append("    st.global.f32 [%rd15], %f3;")
+    # Pass 2: double-precision ratio + RNE ties-to-even + clamp/saturation.
+    lines.append("    mov.u64 %rd20, 0;")
+    lines.append("    mov.u32 %r21, 0;")
+    lines.append("    cvt.f64.f32 %fd1, %f3;")
+    lines.append("QUANTLOOP:")
+    lines.append("    setp.ge.u64 %p1, %rd20, %rd21;")
+    lines.append("    @%p1 bra QUANTDONE;")
+    lines.append("    mul.lo.u64 %rd22, %rd20, 4;")
+    lines.append("    add.u64 %rd23, %rd12, %rd22;")
+    lines.append("    ld.global.f32 %f1, [%rd23];")
+    lines.append("    cvt.f64.f32 %fd0, %f1;")
+    lines.append("    div.rn.f64 %fd2, %fd0, %fd1;")
+    lines.append("    min.f64 %fd2, %fd2, 0d4069000000000000;")
+    lines.append("    max.f64 %fd2, %fd2, 0dC069000000000000;")
+    lines.append("    cvt.rni.s32.f64 %r30, %fd2;")
+    lines.append("    setp.gt.s32 %p2, %r30, 127;")
+    lines.append("    setp.lt.s32 %p3, %r30, -127;")
+    lines.append("    @%p2 add.u32 %r21, %r21, 1;")
+    lines.append("    @%p3 add.u32 %r21, %r21, 1;")
+    lines.append("    min.s32 %r30, %r30, 127;")
+    lines.append("    max.s32 %r30, %r30, -127;")
+    lines.append("    add.u64 %rd24, %rd13, %rd20;")
+    lines.append("    st.global.u8 [%rd24], %r30;")
+    lines.append("    add.u64 %rd20, %rd20, 1;")
+    lines.append("    bra QUANTLOOP;")
+    lines.append("QUANTDONE:")
+    lines.append("    st.global.u32 [%rd16], %r21;")
+    lines.append("    bra DONE;")
+    # All-zero row: scale 1.0, codes 0, saturation 0.
+    lines.append("ZEROROW:")
+    lines.append("    st.global.f32 [%rd15], 0f3F800000;")
+    lines.append("    mov.u64 %rd20, 0;")
+    lines.append("ZEROLOOP:")
+    lines.append("    setp.ge.u64 %p1, %rd20, %rd21;")
+    lines.append("    @%p1 bra ZERODONE;")
+    lines.append("    add.u64 %rd24, %rd13, %rd20;")
+    lines.append("    st.global.u8 [%rd24], 0;")
+    lines.append("    add.u64 %rd20, %rd20, 1;")
+    lines.append("    bra ZEROLOOP;")
+    lines.append("ZERODONE:")
+    lines.append("    st.global.u32 [%rd16], 0;")
+    lines.append("    bra DONE;")
+    lines.append("BAD:")
+    lines.append("    st.global.u32 [%rd17], 1;")
+    lines.append("    bra DONE;")
+    lines.append("UNDERFLOW:")
+    lines.append("    st.global.u32 [%rd17], 2;")
+    lines.append("DONE:")
+    lines.append("    ret;")
+    lines.append("}")
+    return "\n".join(lines)
+
+
+_RENDERERS = {
+    W8A8_QMATMUL_OPCODE: _render_qmatmul,
+    W8A8_QUANTIZE_OPCODE: _render_quantize,
+    W8A8_DEQUANTIZE_OPCODE: _render_dequantize,
+    W8A8_EPILOGUE_OPCODE: _render_epilogue,
+}
+
+
+def render_w8a8_ptx(
+    operations: Sequence[CudaW8A8OperationPlan],
+    ptx_target: str = CUDA_W8A8_PTX_TARGET,
+    ptx_version: str = CUDA_PTX_VERSION,
+) -> str:
+    """Render deterministic W8A8 PTX for validated operation plans."""
+
+    ptx_target = _validate_ptx_target(ptx_target)
+    ptx_version = _validate_ptx_version(ptx_version)
+    if ptx_version not in _SUPPORTED_PTX_VERSIONS:
+        raise CudaW8A8Error(
+            "unsupported W8A8 PTX version {!r}; supported: {}".format(
+                ptx_version, ", ".join(sorted(_SUPPORTED_PTX_VERSIONS))
+            )
+        )
+    blocks = []
+    for operation in operations:
+        renderer = _RENDERERS.get(operation.operation)
+        if renderer is None:
+            raise CudaW8A8UnsupportedError(
+                "no CUDA W8A8 PTX renderer for {!r}".format(operation.operation)
+            )
+        blocks.append(renderer(operation))
+    header = (
+        ".version {}\n.target {}\n.address_size 64\n\n"
+        "{}\n{}\n\n".format(ptx_version, ptx_target, _PTX_MARKER_LINE, _PTX_KERNEL_VERSION_LINE)
+    )
+    return header + "\n\n".join(blocks) + "\n"
+
+
+# ---------------------------------------------------------------------------
+# Validated target IR and artifact
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class CudaW8A8Program:
+    """CUDA W8A8 target IR: immutable PTX plus its probed capability record."""
+
+    program: CoreProgram
+    target: TargetSpec
+    ptx: str
+    ptx_target: str
+    ptx_version: str
+    device: Mapping[str, Any]
+    capability: Mapping[str, Any]
+    operations: Tuple[CudaW8A8OperationPlan, ...]
+    bindings: Tuple[Tuple[Mapping[str, Any], ...], ...]
+
+    @property
+    def entrypoint(self) -> str:
+        return self.program.functions[0].name
+
+    @property
+    def plan_digest(self) -> str:
+        return _plan_digest(self.operations)
+
+    def operation_by_opcode(self, opcode: str) -> CudaW8A8OperationPlan:
+        for operation in self.operations:
+            if operation.operation == opcode:
+                return operation
+        raise CudaW8A8UnsupportedError(
+            "artifact does not contain a compiled {!r} operation".format(opcode)
+        )
+
+    def validate(self) -> "CudaW8A8Program":
+        _validate_ptx_target(self.ptx_target)
+        _validate_ptx_version(self.ptx_version)
+        if self.ptx_target != CUDA_W8A8_PTX_TARGET:
+            raise CudaW8A8ArtifactError("W8A8 PTX target must be {!r}".format(CUDA_W8A8_PTX_TARGET))
+        if self.ptx_version not in _SUPPORTED_PTX_VERSIONS:
+            raise CudaW8A8ArtifactError("unsupported W8A8 PTX version")
+        if _PTX_MARKER_LINE not in self.ptx or _PTX_KERNEL_VERSION_LINE not in self.ptx:
+            raise CudaW8A8ArtifactError("W8A8 PTX marker/kernel version is missing")
+        expected_ptx = render_w8a8_ptx(self.operations, self.ptx_target, self.ptx_version)
+        if self.ptx != expected_ptx:
+            raise CudaW8A8ArtifactError("W8A8 PTX does not match the canonical plan")
+        entry_names = _ENTRY_NAME_RE.findall(self.ptx)
+        expected_names = [operation.kernel for operation in self.operations]
+        if entry_names != expected_names:
+            raise CudaW8A8ArtifactError("W8A8 PTX entry names do not match the plan")
+        if self.capability.get("matrix_kind") != CUDA_W8A8_MATRIX_CAPABILITY:
+            raise CudaW8A8ArtifactError("W8A8 artifact declares an unexpected matrix kind")
+        if self.capability.get("digest") != CUDA_W8A8_CAPABILITY.fingerprint:
+            raise CudaW8A8ArtifactError("W8A8 artifact capability digest mismatch")
+        if self.capability.get("kernel_version") not in (None, CUDA_W8A8_KERNEL_VERSION):
+            raise CudaW8A8ArtifactError("W8A8 artifact capability kernel version mismatch")
+        if self.capability.get("compensation") != CUDA_W8A8_COMPENSATION:
+            raise CudaW8A8ArtifactError("W8A8 artifact compensation token mismatch")
+        declared_matrix = tuple(self.capability.get("matrix_capabilities", ()))
+        if declared_matrix != (CUDA_W8A8_MATRIX_CAPABILITY,):
+            raise CudaW8A8ArtifactError("W8A8 capability must declare exactly the dp4a matrix kind")
+        for forbidden in CUDA_W8A8_FORBIDDEN_MATRIX_CAPABILITIES:
+            if forbidden in declared_matrix:
+                raise CudaW8A8ArtifactError(
+                    "W8A8 capability declares a forbidden matrix kind {!r}".format(forbidden)
+                )
+        # Re-derive the plan from the Core IR to keep plan and program aligned.
+        function = self.program.functions[0]
+        rebuilt = tuple(
+            _plan_for_operation(self.program, operation, index)
+            for index, operation in enumerate(function.body.operations)
+        )
+        if rebuilt != self.operations:
+            raise CudaW8A8ArtifactError("W8A8 plan does not match the Core IR program")
+        if self.bindings != tuple(_operation_bindings(operation) for operation in function.body.operations):
+            raise CudaW8A8ArtifactError("W8A8 bindings do not match the Core IR program")
+        return self
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "cuda_w8a8_lowering_version": CUDA_W8A8_LOWERING_VERSION,
+            "cuda_w8a8_plan_version": CUDA_W8A8_PLAN_VERSION,
+            "ptx_target": self.ptx_target,
+            "ptx_version": self.ptx_version,
+            "device": mapping_copy(self.device),
+            "capability": mapping_copy(self.capability),
+            "operations": [operation.to_dict() for operation in self.operations],
+            "ptx_digest": hashlib.sha256(self.ptx.encode("utf-8")).hexdigest(),
+            "plan_digest": self.plan_digest,
+            "bindings": [[mapping_copy(binding) for binding in group] for group in self.bindings],
+        }
+
+
+class CudaW8A8Compiler:
+    """Compiler facade for the CUDA W8A8 integer kernel plane.
+
+    A real device probe is mandatory: either a probe-derived ``device`` or a
+    ``driver`` from which the probe is taken.  Without one, lowering fails
+    closed with :class:`CudaW8A8UnavailableError` instead of emitting an
+    artifact for an assumed device.
+    """
+
+    name = CUDA_W8A8_BACKEND
+
+    def __init__(
+        self,
+        driver: Any = None,
+        device_index: int = 0,
+        device: Any = None,
+        ptx_version: str = CUDA_PTX_VERSION,
+    ) -> None:
+        _validate_ptx_version(ptx_version)
+        self.driver = driver
+        self.device_index = int(device_index)
+        self.device = device
+        self.ptx_version = ptx_version
+
+    def probe_device(self) -> CudaW8A8Device:
+        if self.device is not None:
+            if isinstance(self.device, CudaW8A8Device):
+                return self.device
+            return CudaW8A8Device(
+                index=getattr(self.device, "index", 0),
+                name=getattr(self.device, "name", "unknown"),
+                major=getattr(self.device, "major"),
+                minor=getattr(self.device, "minor"),
+                total_memory=getattr(self.device, "total_memory", 0),
+            )
+        if self.driver is None:
+            raise CudaW8A8UnavailableError(
+                "CUDA W8A8 lowering requires a real probed device (driver or device info)"
+            )
+        # Function-level import keeps the compiler -> backend import direction
+        # one-way and avoids an import cycle with pypto.backends.cuda.
+        from pypto.backends.cuda.capabilities import probe_cuda_w8a8_device
+
+        return probe_cuda_w8a8_device(self.driver, self.device_index)
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> CudaW8A8Program:
+        if not isinstance(program, CoreProgram):
+            raise TypeError("CUDA W8A8 lower() requires CoreProgram")
+        if not isinstance(target, TargetSpec):
+            raise TypeError("CUDA W8A8 lower() requires TargetSpec")
+        if target.kind != "gpu":
+            raise CudaW8A8UnsupportedError(
+                "CUDA W8A8 lowering requires a 'gpu' TargetSpec, got {!r}".format(target.kind)
+            )
+        try:
+            validate_program(program)
+        except CpuScalarError as exc:
+            raise CudaW8A8ValidationError("Core program is outside the W8A8 contract: {}".format(exc)) from exc
+        device = self.probe_device()
+        capabilities = cuda_w8a8_capabilities(device, target=target.key)
+        functions = {function.name: function for function in program.functions}
+        entrypoint = target.attributes.get("entrypoint", program.functions[0].name)
+        if not isinstance(entrypoint, str) or entrypoint not in functions:
+            raise CudaW8A8UnsupportedError("CUDA W8A8 entrypoint {!r} is not in the CoreProgram".format(entrypoint))
+        if functions[entrypoint] is not program.functions[0]:
+            raise CudaW8A8UnsupportedError("CUDA W8A8 artifact supports a single entrypoint function")
+        function = functions[entrypoint]
+        operations = tuple(
+            _plan_for_operation(program, operation, index)
+            for index, operation in enumerate(function.body.operations)
+        )
+        for operation in operations:
+            if operation.operation == W8A8_QMATMUL_OPCODE:
+                if operation.k > W8A8_MAX_ACCUMULATOR_K:
+                    raise CudaW8A8UnsupportedError(
+                        "CUDA {} K={} exceeds the INT32 accumulation limit {} (Q5)".format(
+                            W8A8_QMATMUL_OPCODE, operation.k, W8A8_MAX_ACCUMULATOR_K
+                        )
+                    )
+                if operation.m == 0 or operation.n == 0 or operation.k == 0 or any(
+                    dimension == 0 for dimension in operation.batch_shape
+                ):
+                    # The C1 golden cannot represent zero-size operands; refuse
+                    # rather than inventing an empty-output convention.
+                    raise CudaW8A8UnsupportedError(
+                        "CUDA {} rejects zero-size operands {} x {}".format(
+                            W8A8_QMATMUL_OPCODE, operation.left_shape, operation.right_shape
+                        )
+                    )
+        ptx = render_w8a8_ptx(operations, CUDA_W8A8_PTX_TARGET, self.ptx_version)
+        capability = cuda_w8a8_capability_metadata(device, target=target.key)
+        capability = dict(capability)
+        capability["kernel_version"] = CUDA_W8A8_KERNEL_VERSION
+        capability["hardware_dp4a"] = device.dp4a
+        capability["hardware_imma_s8"] = device.imma_s8
+        capability["capabilities"] = {
+            "dtypes": list(capabilities.dtypes),
+            "matrix_capabilities": list(capabilities.matrix_capabilities),
+            "digest": capabilities.fingerprint,
+        }
+        bindings = tuple(_operation_bindings(operation) for operation in function.body.operations)
+        return CudaW8A8Program(
+            program=program,
+            target=target,
+            ptx=ptx,
+            ptx_target=CUDA_W8A8_PTX_TARGET,
+            ptx_version=self.ptx_version,
+            device=frozen_mapping(device.to_dict()),
+            capability=frozen_mapping(capability),
+            operations=operations,
+            bindings=bindings,
+        )
+
+    def compile(self, target_ir: CudaW8A8Program, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, CudaW8A8Program):
+            raise TypeError("CUDA W8A8 compile() requires CudaW8A8Program from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        target_ir.validate()
+        program_json = target_ir.program.canonical_json()
+        program_data = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        target_data = target_ir.target.to_dict()
+        ptx_digest = hashlib.sha256(target_ir.ptx.encode("utf-8")).hexdigest()
+        plan_data = [operation.to_dict() for operation in target_ir.operations]
+        plan_digest = _plan_digest(target_ir.operations)
+        envelope = {
+            "artifact_payload_version": CUDA_W8A8_PAYLOAD_VERSION,
+            "backend": CUDA_W8A8_BACKEND,
+            "cuda_w8a8_marker": CUDA_W8A8_MARKER,
+            "cuda_w8a8_kernel_version": CUDA_W8A8_KERNEL_VERSION,
+            "cuda_w8a8_lowering_version": CUDA_W8A8_LOWERING_VERSION,
+            "cuda_w8a8_plan_version": CUDA_W8A8_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "target": target_data,
+            "program": program_data,
+            "program_digest": program_digest,
+            "plan": plan_data,
+            "plan_digest": plan_digest,
+            "ptx": target_ir.ptx,
+            "ptx_digest": ptx_digest,
+            "ptx_target": target_ir.ptx_target,
+            "ptx_version": target_ir.ptx_version,
+            "device": _plain(target_ir.device),
+            "capability": _plain(target_ir.capability),
+            "bindings": _plain(target_ir.bindings),
+        }
+        if options is not None:
+            envelope["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "metadata": _plain(options.metadata),
+                "extra": _plain(options.extra),
+            }
+        payload = json.dumps(
+            envelope, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")
+        ).encode("utf-8")
+        payload_digest = hashlib.sha256(payload).hexdigest()
+        metadata = {
+            "backend": CUDA_W8A8_BACKEND,
+            "artifact_payload_version": CUDA_W8A8_PAYLOAD_VERSION,
+            "cuda_w8a8_marker": CUDA_W8A8_MARKER,
+            "cuda_w8a8_kernel_version": CUDA_W8A8_KERNEL_VERSION,
+            "cuda_w8a8_lowering_version": CUDA_W8A8_LOWERING_VERSION,
+            "cuda_w8a8_plan_version": CUDA_W8A8_PLAN_VERSION,
+            "entrypoint": target_ir.entrypoint,
+            "program_digest": program_digest,
+            "plan_digest": plan_digest,
+            "ptx_digest": ptx_digest,
+            "payload_digest": payload_digest,
+            "target_digest": sha256_text(target_data),
+            "ptx_target": target_ir.ptx_target,
+            "ptx_version": target_ir.ptx_version,
+            "device": _plain(target_ir.device),
+            "capability": _plain(target_ir.capability),
+            "bindings": _plain(target_ir.bindings),
+            "dtypes": sorted(
+                set(
+                    dtype
+                    for operation in target_ir.operations
+                    for dtype in (
+                        operation.left_dtype,
+                        operation.right_dtype,
+                        operation.input_dtype,
+                        operation.codes_dtype,
+                        operation.scales_dtype,
+                        operation.accumulator_dtype,
+                        operation.row_scales_dtype,
+                        operation.column_scales_dtype,
+                        operation.output_dtype,
+                    )
+                    if dtype
+                )
+            ),
+            "w8a8_kernel_operations": [operation.operation for operation in target_ir.operations],
+            "w8a8_operations": plan_data,
+        }
+        if options is not None:
+            option_metadata = _plain(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError(
+                    "compile option metadata uses reserved CUDA W8A8 keys: {}".format(
+                        ", ".join(sorted(reserved))
+                    )
+                )
+            metadata.update(option_metadata)
+            metadata["compile_options"] = envelope["compile_options"]
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = CUDA_W8A8_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            payload=payload,
+            metadata=metadata,
+        )
+        artifact.validate()
+        return artifact
+
+
+def compile_cuda_w8a8(
+    program: CoreProgram, target: TargetSpec, options: Optional[CompileOptions] = None, **kwargs: Any
+) -> Artifact:
+    compiler = CudaW8A8Compiler(**kwargs)
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+def _required_envelope() -> set:
+    return {
+        "artifact_payload_version",
+        "backend",
+        "cuda_w8a8_marker",
+        "cuda_w8a8_kernel_version",
+        "cuda_w8a8_lowering_version",
+        "cuda_w8a8_plan_version",
+        "entrypoint",
+        "target",
+        "program",
+        "program_digest",
+        "plan",
+        "plan_digest",
+        "ptx",
+        "ptx_digest",
+        "ptx_target",
+        "ptx_version",
+        "device",
+        "capability",
+        "bindings",
+    }
+
+
+def decode_cuda_w8a8_artifact(artifact: Artifact) -> CudaW8A8Program:
+    """Strictly decode and re-derive every CUDA W8A8 artifact field."""
+
+    if not isinstance(artifact, Artifact):
+        raise CudaW8A8ArtifactError("CUDA W8A8 runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CudaW8A8ArtifactError("artifact validation failed: {}".format(exc)) from exc
+    if artifact.payload is None:
+        raise CudaW8A8ArtifactError("CUDA W8A8 artifact requires an inline payload")
+    try:
+        decoded = json.loads(bytes(artifact.payload).decode("utf-8"))
+    except Exception as exc:
+        raise CudaW8A8ArtifactError("CUDA W8A8 payload is not UTF-8 JSON") from exc
+    if (
+        not isinstance(decoded, dict)
+        or set(decoded) - (_required_envelope() | {"compile_options"})
+        or not _required_envelope().issubset(decoded)
+    ):
+        raise CudaW8A8ArtifactError("CUDA W8A8 payload has unknown or missing fields")
+    canonical = json.dumps(
+        decoded, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")
+    ).encode("utf-8")
+    if canonical != bytes(artifact.payload):
+        raise CudaW8A8ArtifactError("CUDA W8A8 payload is not canonical JSON")
+    metadata = mapping_copy(artifact.metadata)
+    required_metadata = {
+        "backend",
+        "artifact_payload_version",
+        "cuda_w8a8_marker",
+        "cuda_w8a8_kernel_version",
+        "cuda_w8a8_lowering_version",
+        "cuda_w8a8_plan_version",
+        "entrypoint",
+        "program_digest",
+        "plan_digest",
+        "ptx_digest",
+        "payload_digest",
+        "target_digest",
+        "ptx_target",
+        "ptx_version",
+        "device",
+        "capability",
+        "bindings",
+        "dtypes",
+        "w8a8_kernel_operations",
+        "w8a8_operations",
+    }
+    if not required_metadata.issubset(metadata):
+        raise CudaW8A8ArtifactError("CUDA W8A8 artifact metadata is missing required fields")
+    option_metadata = {}
+    if "compile_options" in decoded:
+        options = decoded["compile_options"]
+        if not isinstance(options, dict) or set(options) != {
+            "artifact_format",
+            "abi_version",
+            "metadata",
+            "extra",
+        }:
+            raise CudaW8A8ArtifactError("CUDA W8A8 compile options are malformed")
+        if not isinstance(options["metadata"], dict) or not isinstance(options["extra"], dict):
+            raise CudaW8A8ArtifactError("CUDA W8A8 compile option metadata/extra must be objects")
+        option_metadata = options["metadata"]
+    allowed_metadata = required_metadata | {"compile_options"} | set(option_metadata)
+    if set(metadata) - allowed_metadata:
+        raise CudaW8A8ArtifactError("CUDA W8A8 artifact metadata has unknown fields")
+    for key, value in option_metadata.items():
+        if metadata.get(key) != value:
+            raise CudaW8A8ArtifactError("CUDA W8A8 option metadata does not match payload")
+    payload_digest = hashlib.sha256(bytes(artifact.payload)).hexdigest()
+    if metadata.get("payload_digest") != payload_digest or artifact.content_digest != payload_digest:
+        raise CudaW8A8ArtifactError("CUDA W8A8 payload digest mismatch")
+    if decoded["backend"] != CUDA_W8A8_BACKEND or metadata["backend"] != CUDA_W8A8_BACKEND:
+        raise CudaW8A8ArtifactError("CUDA W8A8 backend mismatch")
+    if (
+        decoded["artifact_payload_version"] != CUDA_W8A8_PAYLOAD_VERSION
+        or metadata["artifact_payload_version"] != CUDA_W8A8_PAYLOAD_VERSION
+    ):
+        raise CudaW8A8ArtifactError("unsupported CUDA W8A8 artifact payload version")
+    if (
+        decoded["cuda_w8a8_kernel_version"] != CUDA_W8A8_KERNEL_VERSION
+        or metadata["cuda_w8a8_kernel_version"] != CUDA_W8A8_KERNEL_VERSION
+    ):
+        raise CudaW8A8ArtifactError("unsupported CUDA W8A8 kernel version")
+    if (
+        decoded["cuda_w8a8_marker"] != CUDA_W8A8_MARKER
+        or metadata["cuda_w8a8_marker"] != CUDA_W8A8_MARKER
+    ):
+        raise CudaW8A8ArtifactError("CUDA W8A8 marker mismatch")
+    if (
+        decoded["cuda_w8a8_lowering_version"] != CUDA_W8A8_LOWERING_VERSION
+        or metadata["cuda_w8a8_lowering_version"] != CUDA_W8A8_LOWERING_VERSION
+    ):
+        raise CudaW8A8ArtifactError("unsupported CUDA W8A8 lowering version")
+    if (
+        decoded["cuda_w8a8_plan_version"] != CUDA_W8A8_PLAN_VERSION
+        or metadata["cuda_w8a8_plan_version"] != CUDA_W8A8_PLAN_VERSION
+    ):
+        raise CudaW8A8ArtifactError("unsupported CUDA W8A8 plan version")
+    if decoded["target"] != artifact.target.to_dict() or metadata["target_digest"] != sha256_text(decoded["target"]):
+        raise CudaW8A8ArtifactError("CUDA W8A8 artifact target mismatch")
+    if decoded["entrypoint"] != artifact.entrypoint or metadata["entrypoint"] != artifact.entrypoint:
+        raise CudaW8A8ArtifactError("CUDA W8A8 artifact entrypoint mismatch")
+    if metadata["w8a8_operations"] != decoded["plan"]:
+        raise CudaW8A8ArtifactError("CUDA W8A8 plan metadata mismatch")
+    if list(metadata["w8a8_kernel_operations"]) != [
+        entry["operation"] for entry in decoded["plan"]
+    ]:
+        raise CudaW8A8ArtifactError("CUDA W8A8 kernel operation metadata mismatch")
+    operations = tuple(CudaW8A8OperationPlan.from_dict(entry) for entry in decoded["plan"])
+    plan_digest = _plan_digest(operations)
+    if decoded["plan_digest"] != plan_digest or metadata["plan_digest"] != plan_digest:
+        raise CudaW8A8ArtifactError("CUDA W8A8 plan digest mismatch")
+    program = CoreProgram.from_dict(decoded["program"])
+    program_json = program.canonical_json()
+    program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+    if (
+        decoded["program"] != program.to_dict()
+        or decoded["program_digest"] != program_digest
+        or metadata["program_digest"] != program_digest
+    ):
+        raise CudaW8A8ArtifactError("CUDA W8A8 program digest mismatch")
+    ptx = decoded["ptx"]
+    if not isinstance(ptx, str):
+        raise CudaW8A8ArtifactError("CUDA W8A8 payload PTX must be a string")
+    ptx_digest = hashlib.sha256(ptx.encode("utf-8")).hexdigest()
+    if decoded["ptx_digest"] != ptx_digest or metadata["ptx_digest"] != ptx_digest:
+        raise CudaW8A8ArtifactError("CUDA W8A8 PTX digest mismatch")
+    try:
+        expected_ptx = render_w8a8_ptx(operations, decoded["ptx_target"], decoded["ptx_version"])
+    except CudaW8A8Error as exc:
+        raise CudaW8A8ArtifactError("CUDA W8A8 PTX header is invalid: {}".format(exc)) from exc
+    if ptx != expected_ptx:
+        raise CudaW8A8ArtifactError("CUDA W8A8 PTX does not match the canonical plan")
+    expected_bindings = tuple(_operation_bindings(operation) for operation in program.functions[0].body.operations)
+    decoded_bindings = tuple(
+        tuple(frozen_mapping(binding) for binding in group) for group in decoded["bindings"]
+    )
+    if decoded_bindings != expected_bindings:
+        raise CudaW8A8ArtifactError("CUDA W8A8 kernel bindings do not match Core IR")
+    if (
+        metadata["ptx_target"] != decoded["ptx_target"]
+        or metadata["ptx_version"] != decoded["ptx_version"]
+        or decoded["ptx_target"] != CUDA_W8A8_PTX_TARGET
+    ):
+        raise CudaW8A8ArtifactError("CUDA W8A8 PTX target metadata mismatch")
+    if metadata["device"] != decoded["device"] or metadata["capability"] != decoded["capability"]:
+        raise CudaW8A8ArtifactError("CUDA W8A8 device/capability metadata mismatch")
+    if metadata["dtypes"] != sorted(
+        set(
+            dtype
+            for operation in operations
+            for dtype in (
+                operation.left_dtype,
+                operation.right_dtype,
+                operation.input_dtype,
+                operation.codes_dtype,
+                operation.scales_dtype,
+                operation.accumulator_dtype,
+                operation.row_scales_dtype,
+                operation.column_scales_dtype,
+                operation.output_dtype,
+            )
+            if dtype
+        )
+    ):
+        raise CudaW8A8ArtifactError("CUDA W8A8 dtype metadata mismatch")
+    if "compile_options" in decoded:
+        options = decoded["compile_options"]
+        if (
+            metadata.get("compile_options") != options
+            or artifact.format != options["artifact_format"]
+            or artifact.abi_version != options["abi_version"]
+        ):
+            raise CudaW8A8ArtifactError("CUDA W8A8 artifact format/ABI options mismatch")
+    elif artifact.format != CUDA_W8A8_ARTIFACT_FORMAT or artifact.abi_version != ABI_VERSION:
+        raise CudaW8A8ArtifactError("CUDA W8A8 artifact format/ABI mismatch")
+    decoded_program = CudaW8A8Program(
+        program,
+        artifact.target,
+        ptx,
+        decoded["ptx_target"],
+        decoded["ptx_version"],
+        frozen_mapping(decoded["device"]),
+        frozen_mapping(decoded["capability"]),
+        operations,
+        decoded_bindings,
+    )
+    try:
+        decoded_program.validate()
+    except CudaW8A8Error as exc:
+        raise CudaW8A8ArtifactError("CUDA W8A8 target IR validation failed: {}".format(exc)) from exc
+    return decoded_program
+
+
+def w8a8_artifact_is_native(artifact: Any) -> bool:
+    """Return whether ``artifact`` is a CUDA W8A8 artifact by marker/backend."""
+
+    if not isinstance(artifact, Artifact):
+        return False
+    metadata = artifact.metadata if isinstance(artifact.metadata, Mapping) else {}
+    return (
+        metadata.get("backend") == CUDA_W8A8_BACKEND
+        and metadata.get("cuda_w8a8_marker") == CUDA_W8A8_MARKER
+        and metadata.get("artifact_payload_version") == CUDA_W8A8_PAYLOAD_VERSION
+        and metadata.get("cuda_w8a8_kernel_version") == CUDA_W8A8_KERNEL_VERSION
+    )
+
+
+__all__ = [
+    "CUDA_W8A8_ARTIFACT_FORMAT",
+    "CUDA_W8A8_BACKEND",
+    "CUDA_W8A8_BLOCK",
+    "CUDA_W8A8_KERNEL_VERSION",
+    "CUDA_W8A8_LOWERING_VERSION",
+    "CUDA_W8A8_MARKER",
+    "CUDA_W8A8_PAYLOAD_VERSION",
+    "CUDA_W8A8_PLAN_VERSION",
+    "CUDA_W8A8_PTX_TARGET",
+    "CudaW8A8ArtifactError",
+    "CudaW8A8Compiler",
+    "CudaW8A8Error",
+    "CudaW8A8OperationPlan",
+    "CudaW8A8Program",
+    "CudaW8A8UnsupportedError",
+    "CudaW8A8ValidationError",
+    "W8A8_DEQUANTIZE_MODE",
+    "W8A8_EPILOGUE_MODE",
+    "W8A8_MODES",
+    "W8A8_QMATMUL_MODE",
+    "W8A8_QUANTIZE_MODE",
+    "compile_cuda_w8a8",
+    "decode_cuda_w8a8_artifact",
+    "render_w8a8_ptx",
+    "w8a8_artifact_is_native",
+]
