+def _resigned(artifact, mutate):
+    decoded = json.loads(bytes(artifact.payload).decode("utf-8"))
+    mutate(decoded)
+    payload = json.dumps(
+        decoded, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")
+    ).encode("utf-8")
+    metadata = dict(artifact.metadata)
+    metadata["payload_digest"] = hashlib.sha256(payload).hexdigest()
+    if "artifact_payload_version" in decoded:
+        metadata["artifact_payload_version"] = decoded["artifact_payload_version"]
+    if "cuda_w8a8_kernel_version" in decoded:
+        metadata["cuda_w8a8_kernel_version"] = decoded["cuda_w8a8_kernel_version"]
+    if "cuda_w8a8_marker" in decoded:
+        metadata["cuda_w8a8_marker"] = decoded["cuda_w8a8_marker"]
+    if "capability" in decoded:
+        metadata["capability"] = copy.deepcopy(decoded["capability"])
+    if "plan" in decoded:
+        metadata["w8a8_operations"] = copy.deepcopy(decoded["plan"])
+    if "ptx_digest" in decoded:
+        metadata["ptx_digest"] = decoded["ptx_digest"]
+    if "plan_digest" in decoded:
+        metadata["plan_digest"] = decoded["plan_digest"]
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=payload,
+        metadata=metadata,
+    )
+
+
+def _tamper_entry(artifact):
+    driver = FakeCudaDriver()
+    target_ir = decode_cuda_w8a8_artifact(artifact)
+    driver.active_operation = target_ir.operations[0]
+    return CudaRuntime(driver=driver)
+
