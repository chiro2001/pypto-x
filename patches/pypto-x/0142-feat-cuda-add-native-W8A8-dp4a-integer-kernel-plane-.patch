+def test_quantize_all_zero_rows_and_rne_ties():
+    # Rows 1-4 use absmax=127.0 so the float32 scale is exactly 1.0 and the
+    # ratios hit exact RNE ties: rne(0.5)=0, rne(1.5)=2, rne(-0.5)=0,
+    # rne(2.5)=2 (ties-to-even), each row also containing the 127.0 code.
+    shape = (5, 2)
+    values = [0.0, 0.0, 0.5, 127.0, 1.5, 127.0, -0.5, 127.0, 2.5, 127.0]
+    f32_values = [struct.unpack("<f", struct.pack("<f", value))[0] for value in values]
+    expected = quantize_per_token_s8(f32_values, shape=shape)
+    artifact, target_ir = _compile(_quantize_program(shape))
+    driver = FakeCudaDriver()
+    driver.active_operation = target_ir.operations[0]
+    result = CudaRuntime(driver=driver).run_w8a8_quantize_per_token_s8(artifact, values)
+    assert tuple(result.codes) == tuple(expected.codes)
+    assert tuple(result.scales) == tuple(expected.scales)
+    assert result.codes[:2] == (0, 0)
+    assert result.scales[0] == 1.0
+    assert result.codes[2:10] == (0, 127, 2, 127, 0, 127, 2, 127)
