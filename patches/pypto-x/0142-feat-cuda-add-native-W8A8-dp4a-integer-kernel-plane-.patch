+# ---------------------------------------------------------------------------
+# CUDA W8A8 argument marshalling (C6)
+# ---------------------------------------------------------------------------
+
+
+def _w8a8_flat(values: Any, context: str) -> list:
+    """Flatten a nested/standard sequence with the shared Core IR helper."""
+
+    if isinstance(values, (str, bytes, bytearray, Mapping)):
+        raise CudaW8A8ExecutionError("{} must be a numeric sequence".format(context))
+    if hasattr(values, "data") and isinstance(getattr(values, "data"), (list, tuple)):
+        values = values.data
+    flat = list(flatten_values(values))
+    if not flat:
+        raise CudaW8A8ExecutionError("{} must not be empty".format(context))
+    return flat
+
+
+def _w8a8_int_codes(values: Sequence[Any], context: str) -> list:
+    codes = []
+    for index, value in enumerate(values):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise CudaW8A8ExecutionError(
+                "{}[{}] must be an integer int8 code".format(context, index)
+            )
+        if value < -127 or value > 127:
+            raise CudaW8A8ExecutionError(
+                "{}[{}]={} outside [-127, 127]; the reserved -128 code point is refused "
+                "(contract 0002 section 1.1)".format(context, index, value)
+            )
+        codes.append(value)
+    return codes
+
+
+def _w8a8_real_values(values: Sequence[Any], context: str) -> list:
+    result = []
+    for index, value in enumerate(values):
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            raise CudaW8A8ExecutionError("{}[{}] must be a real number".format(context, index))
+        number = float(value)
+        try:
+            result.append(struct.unpack("<f", struct.pack("<f", number))[0])
+        except (OverflowError, TypeError, ValueError) as exc:
+            raise CudaW8A8ExecutionError(
+                "{}[{}] cannot be represented as float32".format(context, index)
+            ) from exc
+    return result
+
+
+def _w8a8_scales(values: Any, expected: int, context: str) -> list:
+    flat = _w8a8_flat(values, context)
+    if len(flat) != expected:
+        raise CudaW8A8ExecutionError(
+            "{} expects {} scales, got {}".format(context, expected, len(flat))
+        )
+    return _w8a8_real_values(flat, context)
+
+
+def _w8a8_bf16_to_f32(values: Sequence[Any], context: str) -> list:
+    result = []
+    for index, value in enumerate(values):
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            raise CudaW8A8ExecutionError("{}[{}] must be a real number".format(context, index))
+        number = float(value)
+        try:
+            bits = _bf16_bits(number)
+        except (OverflowError, TypeError, ValueError) as exc:
+            raise CudaW8A8ExecutionError(
+                "{}[{}] cannot be rounded to bfloat16".format(context, index)
+            ) from exc
+        result.append(struct.unpack("<f", struct.pack("<I", bits << 16))[0])
+    return result
+
+
 def _is_tensor(value_type: CoreType) -> bool:
     return value_type.kind in ("tensor", "view", "tile")
 
@@ -659,6 +790,354 @@ class CudaRuntime:
                 except Exception:
                     pass
 
+    # ------------------------------------------------------------------
+    # CUDA W8A8 target entry points (contract 0002 C6)
+    # ------------------------------------------------------------------
+
+    def probe_w8a8_device(self) -> Dict[str, Any]:
+        """Return the real device facts used by the W8A8 capability gate."""
+
+        return dict(self._probe_w8a8_device().to_dict())
+
+    def _probe_w8a8_device(self):
+        if self.driver is None:
+            raise CudaW8A8UnavailableError(
+                self._driver_error or "CUDA Driver API unavailable for the W8A8 plane"
+            )
+        from .capabilities import probe_cuda_w8a8_device
+
+        return probe_cuda_w8a8_device(self.driver, self.device_index)
+
+    def _load_w8a8(self, artifact: Any) -> CudaW8A8Program:
+        try:
+            loaded = decode_cuda_w8a8_artifact(artifact)
+        except _CudaW8A8TargetArtifactError as exc:
+            raise CudaW8A8ArtifactError(str(exc)) from exc
+        except Exception as exc:
+            raise CudaW8A8ArtifactError(
+                "CUDA W8A8 artifact validation failed: {}".format(exc)
+            ) from exc
+        if loaded.ptx_target != CUDA_W8A8_PTX_TARGET:
+            raise CudaW8A8ArtifactError(
+                "CUDA W8A8 artifact PTX target {!r} is not {!r}".format(
+                    loaded.ptx_target, CUDA_W8A8_PTX_TARGET
+                )
+            )
+        probed = self._probe_w8a8_device()
+        try:
+            verify_cuda_w8a8_capability_metadata(loaded.capability, probed)
+        except CudaW8A8UnavailableError as exc:
+            raise CudaW8A8ArtifactError(
+                "CUDA W8A8 capability metadata does not match the real probe: {}".format(exc)
+            ) from exc
+        min_sm = loaded.capability.get("min_sm")
+        if isinstance(min_sm, bool) or not isinstance(min_sm, int):
+            raise CudaW8A8ArtifactError("CUDA W8A8 artifact has no valid min_sm gate")
+        if probed.sm < min_sm:
+            raise CudaW8A8UnavailableError(
+                "probed device {} (sm_{}) is below the artifact requirement sm_{}".format(
+                    probed.name, probed.sm, min_sm
+                )
+            )
+        if not probed.dp4a or not probed.supports_w8a8_module:
+            raise CudaW8A8UnavailableError(
+                "probed device {} (sm_{}) lacks the dp4a W8A8 capability".format(
+                    probed.name, probed.sm
+                )
+            )
+        return loaded
+
+    @staticmethod
+    def _w8a8_plan(loaded: CudaW8A8Program, opcode: str):
+        try:
+            return loaded.operation_by_opcode(opcode)
+        except Exception as exc:
+            raise CudaW8A8ExecutionError(
+                "artifact has no compiled {!r} operation".format(opcode)
+            ) from exc
+
+    @staticmethod
+    def _w8a8_requested_shape(provided: Any, compiled: Sequence[int], context: str) -> Tuple[int, ...]:
+        if provided is None:
+            return tuple(int(dimension) for dimension in compiled)
+        if isinstance(provided, (str, bytes, bytearray)) or not isinstance(provided, (list, tuple)):
+            raise CudaW8A8ExecutionError("{} must be a shape sequence".format(context))
+        shape = []
+        for index, dimension in enumerate(provided):
+            if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+                raise CudaW8A8ExecutionError(
+                    "{}[{}] must be a non-negative integer".format(context, index)
+                )
+            shape.append(int(dimension))
+        shape = tuple(shape)
+        if shape != tuple(int(dimension) for dimension in compiled):
+            raise CudaW8A8ExecutionError(
+                "{} {} does not match the compiled W8A8 plan {}".format(
+                    context, shape, tuple(compiled)
+                )
+            )
+        return shape
+
+    @contextmanager
+    def _w8a8_allocations(self, sizes: Sequence[int]):
+        self._ensure_context()
+        pointers = []
+        try:
+            for size in sizes:
+                pointers.append(self.driver.mem_alloc(max(1, int(size))))
+            yield tuple(pointers)
+        finally:
+            for pointer in reversed(pointers):
+                try:
+                    self.driver.mem_free(pointer)
+                except Exception:
+                    pass
+
+    def _w8a8_launch(self, loaded: CudaW8A8Program, kernel: str, parameters: Sequence[Any], count: int) -> None:
+        if count <= 0:
+            raise CudaW8A8ExecutionError("CUDA W8A8 kernel {} has an empty launch domain".format(kernel))
+        block = CUDA_W8A8_BLOCK
+        grid = ((count + block - 1) // block, 1, 1)
+        self._ensure_context()
+        module = None
+        try:
+            module = self.driver.module_load_data(loaded.ptx)
+            handle = module.get_function(kernel)
+            self.driver.launch_kernel(handle, grid, (block, 1, 1), list(parameters), None, 0)
+            self.driver.context_synchronize()
+        except CudaW8A8RuntimeError:
+            raise
+        except Exception as exc:
+            raise CudaW8A8ExecutionError(
+                "CUDA W8A8 kernel {} launch failed: {}".format(kernel, exc)
+            ) from exc
+        finally:
+            if module is not None:
+                try:
+                    module.close()
+                except Exception:
+                    pass
+
+    def run_w8a8_qmatmul(
+        self,
+        artifact: Any,
+        left: Any,
+        right: Any,
+        *,
+        left_shape: Optional[Sequence[int]] = None,
+        right_shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[int, ...]:
+        """Run the native ``qmatmul_s8s8_s32`` dp4a kernel (R6)."""
+
+        loaded = self._load_w8a8(artifact)
+        plan = self._w8a8_plan(loaded, W8A8_QMATMUL_OPCODE)
+        self._w8a8_requested_shape(left_shape, plan.left_shape, "qmatmul.left_shape")
+        self._w8a8_requested_shape(right_shape, plan.right_shape, "qmatmul.right_shape")
+        if plan.k > W8A8_MAX_ACCUMULATOR_K:
+            raise CudaW8A8ExecutionError(
+                "CUDA {} K={} exceeds the INT32 accumulation limit {}".format(
+                    W8A8_QMATMUL_OPCODE, plan.k, W8A8_MAX_ACCUMULATOR_K
+                )
+            )
+        left_flat = _w8a8_flat(left, "qmatmul.left")
+        right_flat = _w8a8_flat(right, "qmatmul.right")
+        if len(left_flat) != element_count(plan.left_shape):
+            raise CudaW8A8ExecutionError("qmatmul.left storage length does not match its shape")
+        if len(right_flat) != element_count(plan.right_shape):
+            raise CudaW8A8ExecutionError("qmatmul.right storage length does not match its shape")
+        left_codes = _w8a8_int_codes(left_flat, "qmatmul.left")
+        right_codes = _w8a8_int_codes(right_flat, "qmatmul.right")
+        batch_count = 1
+        for dimension in plan.batch_shape:
+            batch_count *= int(dimension)
+        total = batch_count * plan.m * plan.n
+        if total == 0:
+            # The C1 golden rejects zero-size operands ("shape ... does not
+            # match 0 flattened elements"), so an empty launch domain is
+            # fail-closed instead of being silently treated as empty output.
+            raise CudaW8A8ExecutionError(
+                "CUDA {} has an empty launch domain; the C1 golden rejects "
+                "zero-size operands".format(W8A8_QMATMUL_OPCODE)
+            )
+        left_bytes = _pack("int8", left_codes)
+        right_bytes = _pack("int8", right_codes)
+        with self._w8a8_allocations(
+            (len(left_bytes), len(right_bytes), total * 4)
+        ) as (left_pointer, right_pointer, output_pointer):
+            self.driver.memcpy_htod(left_pointer, left_bytes)
+            self.driver.memcpy_htod(right_pointer, right_bytes)
+            self._w8a8_launch(
+                loaded,
+                plan.kernel,
+                (left_pointer, right_pointer, output_pointer),
+                total,
+            )
+            raw = self.driver.memcpy_dtoh(output_pointer, total * 4)
+        return tuple(int(value) for value in _unpack("int32", raw))
+
+    def run_w8a8_dequantize_s8(
+        self,
+        artifact: Any,
+        codes: Any,
+        scales: Sequence[float],
+        *,
+        shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[float, ...]:
+        """Run the native CUDA ``dequantize_s8`` diagnostic primitive."""
+
+        loaded = self._load_w8a8(artifact)
+        plan = self._w8a8_plan(loaded, W8A8_DEQUANTIZE_OPCODE)
+        self._w8a8_requested_shape(shape, plan.codes_shape, "dequantize_s8.shape")
+        codes_flat = _w8a8_flat(codes, "dequantize_s8.codes")
+        if len(codes_flat) != element_count(plan.codes_shape):
+            raise CudaW8A8ExecutionError("dequantize_s8.codes storage length does not match its shape")
+        code_values = _w8a8_int_codes(codes_flat, "dequantize_s8.codes")
+        scale_values = _w8a8_scales(scales, plan.rows, "dequantize_s8.scales")
+        total = plan.rows * plan.k
+        with self._w8a8_allocations((total, plan.rows * 4, total * 4)) as (
+            codes_pointer,
+            scales_pointer,
+            output_pointer,
+        ):
+            self.driver.memcpy_htod(codes_pointer, _pack("int8", code_values))
+            self.driver.memcpy_htod(scales_pointer, _pack("float32", scale_values))
+            self._w8a8_launch(
+                loaded,
+                plan.kernel,
+                (codes_pointer, scales_pointer, output_pointer),
+                total,
+            )
+            raw = self.driver.memcpy_dtoh(output_pointer, total * 4)
+        return tuple(float(value) for value in _unpack("float32", raw))
+
+    def run_w8a8_quantize_per_token_s8(
+        self,
+        artifact: Any,
+        values: Any,
+        *,
+        shape: Optional[Sequence[int]] = None,
+        dtype: str = "float32",
+    ) -> CudaW8A8QuantizeResult:
+        """Run the native CUDA dynamic per-token quantizer (Q1-Q6)."""
+
+        loaded = self._load_w8a8(artifact)
+        plan = self._w8a8_plan(loaded, W8A8_QUANTIZE_OPCODE)
+        self._w8a8_requested_shape(shape, plan.input_shape, "quantize_per_token_s8.shape")
+        normalized_dtype = canonical_dtype(dtype)
+        if normalized_dtype not in ("float32", "bf16"):
+            raise CudaW8A8ExecutionError(
+                "CUDA quantize_per_token_s8 requires float32 or bf16 input, got {!r}".format(dtype)
+            )
+        if plan.k > W8A8_MAX_ACCUMULATOR_K:
+            raise CudaW8A8ExecutionError(
+                "CUDA {} K={} exceeds the INT32 accumulation limit {}".format(
+                    W8A8_QUANTIZE_OPCODE, plan.k, W8A8_MAX_ACCUMULATOR_K
+                )
+            )
+        flat = _w8a8_flat(values, "quantize_per_token_s8.values")
+        if len(flat) != element_count(plan.input_shape):
+            raise CudaW8A8ExecutionError(
+                "quantize_per_token_s8.values storage length does not match its shape"
+            )
+        if normalized_dtype == "bf16":
+            f32_values = _w8a8_bf16_to_f32(flat, "quantize_per_token_s8.values")
+        else:
+            f32_values = _w8a8_real_values(flat, "quantize_per_token_s8.values")
+        total = plan.rows * plan.k
+        zero_status = b"\0" * (plan.rows * 4)
+        with self._w8a8_allocations(
+            (total * 4, total, plan.rows * 4, plan.rows * 4, plan.rows * 4)
+        ) as (values_pointer, codes_pointer, scales_pointer, saturation_pointer, status_pointer):
+            self.driver.memcpy_htod(values_pointer, _pack("float32", f32_values))
+            self.driver.memcpy_htod(status_pointer, zero_status)
+            self._w8a8_launch(
+                loaded,
+                plan.kernel,
+                (values_pointer, codes_pointer, scales_pointer, saturation_pointer, status_pointer),
+                plan.rows,
+            )
+            status = _unpack("int32", self.driver.memcpy_dtoh(status_pointer, plan.rows * 4))
+            if any(int(value) != 0 for value in status):
+                codes = set(int(value) for value in status)
+                if 1 in codes:
+                    raise CudaW8A8ExecutionError(
+                        "CUDA quantize_per_token_s8 input contains NaN/Inf; refusing to "
+                        "produce an artifact (Q2)"
+                    )
+                raise CudaW8A8ExecutionError(
+                    "CUDA quantize_per_token_s8 hit a non-zero float32 scale underflow; "
+                    "refusing to quantize (contract 0002 section 6)"
+                )
+            raw_codes = self.driver.memcpy_dtoh(codes_pointer, total)
+            raw_scales = self.driver.memcpy_dtoh(scales_pointer, plan.rows * 4)
+            raw_saturation = self.driver.memcpy_dtoh(saturation_pointer, plan.rows * 4)
+        saturation = sum(int(value) for value in _unpack("int32", raw_saturation))
+        return CudaW8A8QuantizeResult(
+            codes=tuple(int(value) for value in _unpack("int8", raw_codes)),
+            scales=tuple(float(value) for value in _unpack("float32", raw_scales)),
+            saturation_count=saturation,
+            rows=plan.rows,
+            k=plan.k,
+            dtype=normalized_dtype,
+        )
+
+    def run_w8a8_dequantize_epilogue_bf16(
+        self,
+        artifact: Any,
+        accumulator: Any,
+        row_scales: Sequence[float],
+        column_scales: Sequence[float],
+        *,
+        shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[int, ...]:
+        """Run the native CUDA single-rounding BF16 epilogue, returning bits."""
+
+        loaded = self._load_w8a8(artifact)
+        plan = self._w8a8_plan(loaded, W8A8_EPILOGUE_OPCODE)
+        self._w8a8_requested_shape(shape, plan.accumulator_shape, "dequantize_epilogue_bf16.shape")
+        accumulator_flat = _w8a8_flat(accumulator, "dequantize_epilogue_bf16.accumulator")
+        if len(accumulator_flat) != plan.rows * plan.columns:
+            raise CudaW8A8ExecutionError(
+                "dequantize_epilogue_bf16.accumulator storage length does not match its shape"
+            )
+        accumulators = []
+        for index, value in enumerate(accumulator_flat):
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise CudaW8A8ExecutionError(
+                    "dequantize_epilogue_bf16.accumulator[{}] must be an integer".format(index)
+                )
+            if value < -(2**31) or value > 2**31 - 1:
+                raise CudaW8A8ExecutionError(
+                    "dequantize_epilogue_bf16.accumulator[{}] outside INT32 range".format(index)
+                )
+            accumulators.append(value)
+        row_scale_values = _w8a8_scales(row_scales, plan.rows, "dequantize_epilogue_bf16.row_scales")
+        column_scale_values = _w8a8_scales(
+            column_scales, plan.columns, "dequantize_epilogue_bf16.column_scales"
+        )
+        total = plan.rows * plan.columns
+        with self._w8a8_allocations(
+            (total * 4, plan.rows * 4, plan.columns * 4, total * 2, 4)
+        ) as (accumulator_pointer, row_pointer, column_pointer, output_pointer, status_pointer):
+            self.driver.memcpy_htod(accumulator_pointer, _pack("int32", accumulators))
+            self.driver.memcpy_htod(row_pointer, _pack("float32", row_scale_values))
+            self.driver.memcpy_htod(column_pointer, _pack("float32", column_scale_values))
+            self.driver.memcpy_htod(status_pointer, b"\0\0\0\0")
+            self._w8a8_launch(
+                loaded,
+                plan.kernel,
+                (accumulator_pointer, row_pointer, column_pointer, output_pointer, status_pointer),
+                total,
+            )
+            status = _unpack("int32", self.driver.memcpy_dtoh(status_pointer, 4))
+            if status and int(status[0]) != 0:
+                raise CudaW8A8ExecutionError(
+                    "CUDA dequantize_epilogue_bf16 product overflows binary32; refusing to "
+                    "round (fail-closed, contract 0002 section 6)"
+                )
+            raw = self.driver.memcpy_dtoh(output_pointer, total * 2)
+        return tuple(int(value) for value in _unpack("uint16", raw))
