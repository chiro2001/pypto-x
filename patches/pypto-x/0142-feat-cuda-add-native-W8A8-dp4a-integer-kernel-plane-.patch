+def test_quantize_bf16_input_rounds_before_quantizing():
+    shape = (1, 3)
+    raw = [1.0009765625, 2.001953125, -3.0]
+    rounded = [
+        struct.unpack("<f", struct.pack("<I", _bf16_bits(value) << 16))[0] for value in raw
+    ]
+    expected = quantize_per_token_s8(rounded, shape=shape)
+    artifact, target_ir = _compile(_quantize_program(shape, dtype="bf16"))
+    driver = FakeCudaDriver()
+    driver.active_operation = target_ir.operations[0]
+    result = CudaRuntime(driver=driver).run_w8a8_quantize_per_token_s8(
+        artifact, raw, dtype="bf16"
+    )
+    assert tuple(result.codes) == tuple(expected.codes)
+    assert tuple(result.scales) == tuple(expected.scales)
+    assert result.dtype == "bf16"
+    with pytest.raises(CudaW8A8ExecutionError):
+        CudaRuntime(driver=driver).run_w8a8_quantize_per_token_s8(artifact, raw, dtype="int8")
+
+
+def _bf16_bits(value):
+    raw = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    upper = raw >> 16
+    lower = raw & 0xFFFF
+    if lower > 0x8000 or (lower == 0x8000 and (upper & 1)):
+        upper += 1
+    return upper & 0xFFFF
+
