--- /dev/null
+++ b/python/pypto/backends/cuda/capabilities.py
@@ -0,0 +1,82 @@
+"""Real CUDA device probe for the W8A8 integer plane (contract 0002 C6).
+
+The probe always goes through the CUDA Driver API (the same header-free
+adapter the runtime uses) and never reads a hardcoded table of device names
+or compute capabilities.  A missing driver, a failed device query or a device
+without ``dp4a`` is reported as :class:`CudaW8A8UnavailableError` /
+:class:`~pypto.target.UnsupportedCapabilityError`; there is no BF16 fallback
+inside the W8A8 path.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+from pypto.lowering.gpu.cuda_w8a8 import CudaW8A8Device, CudaW8A8UnavailableError
+
+
+def _field(value: Any, name: str, default: Any = None) -> Any:
+    if isinstance(value, dict):
+        return value.get(name, default)
+    return getattr(value, name, default)
+
+
+def probe_cuda_w8a8_device(driver: Any = None, device_index: int = 0) -> CudaW8A8Device:
+    """Query the real device compute capability through the Driver API.
+
+    ``driver`` may be a :class:`pypto.backends.cuda.driver.CudaDriver` or any
+    test double exposing the same ``device_info(index)`` method.  Passing
+    ``None`` constructs the real Driver adapter; if the driver library is not
+    present the probe fails closed.
+    """
+
+    if driver is None:
+        from .driver import CudaDriver, CudaDriverUnavailable
+
+        try:
+            driver = CudaDriver()
+        except CudaDriverUnavailable as exc:
+            raise CudaW8A8UnavailableError(
+                "CUDA W8A8 device probe failed: {}".format(exc)
+            ) from exc
+    try:
+        info = driver.device_info(int(device_index))
+    except Exception as exc:
+        raise CudaW8A8UnavailableError(
+            "CUDA W8A8 device probe failed: {}".format(exc)
+        ) from exc
+    major = _field(info, "major")
+    minor = _field(info, "minor")
+    if major is None or minor is None:
+        raise CudaW8A8UnavailableError(
+            "CUDA W8A8 device probe returned no compute capability"
+        )
+    return CudaW8A8Device(
+        index=_field(info, "index", device_index),
+        name=_field(info, "name", "unknown"),
+        major=major,
+        minor=minor,
+        total_memory=_field(info, "total_memory", 0),
+        source="cuda_driver_device_info",
+    )
+
+
+def probe_cuda_w8a8_availability(driver: Any = None, device_index: int = 0) -> Optional[str]:
+    """Return ``None`` when the probe passes, else a fail-closed reason."""
+
+    try:
+        device = probe_cuda_w8a8_device(driver, device_index)
+    except CudaW8A8UnavailableError as exc:
+        return str(exc)
+    if not device.dp4a:
+        return "device {} ({}) lacks dp4a (sm_{} < sm_{})".format(
+            device.name, device.compute_capability, device.sm, 61
+        )
+    if not device.supports_w8a8_module:
+        return "device {} (sm_{}) cannot load the CUDA W8A8 sm_75 module".format(
+            device.name, device.sm
+        )
+    return None
+
+
+__all__ = ["probe_cuda_w8a8_availability", "probe_cuda_w8a8_device"]
