index 000000000..a0a05d23b
--- /dev/null
+++ b/python/pypto/lowering/gpu/cuda_w8a8.py
@@ -0,0 +1,265 @@
+"""NVIDIA CUDA W8A8 capability probing for PyPTO-X (contract 0002 C6 / R6).
+
+The CUDA W8A8 plane is gated by a *real* device probe.  The probe reads the
+device compute capability through the CUDA Driver API (see
+:mod:`pypto.backends.cuda.capabilities`) and derives whether the native signed
+byte dot-product instruction ``dp4a`` (PTX ``dp4a.s32.s32``, SASS
+``IDP.4A.S8.S8``) can be emitted.  Nothing here assumes ``sm_120`` or any other
+compute capability: the capability kind is computed from the probed
+``major``/``minor`` pair, and an unavailable or insufficient device raises
+:class:`~pypto.target.UnsupportedCapabilityError` naming the missing matrix
+kind.  There is no ``bf16`` fallback inside the W8A8 path (contract section 6).
+
+Integer matrix-multiply extensions that are *probed but deliberately unused*
+by C6 (``imma_s8`` / ``mma.m16n8k32``) are reported so the evidence can
+distinguish "not available" from "available but not used", exactly like the
+SVE256 C5 probe reports ``sve2``/``i8mm`` without claiming them.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping
+
+from pypto.target import CapabilitySet as _CapabilitySet
+from pypto.target import UnsupportedCapabilityError as _UnsupportedCapabilityError
+
+
+#: Matrix kind actually emitted by C6: packed signed-byte dot product
+#: (``dp4a.s32.s32``) with an int32 accumulator.
+CUDA_W8A8_MATRIX_CAPABILITY = "s8s8_s32_dp4a"
+#: ISA token copied into artifact metadata (stable, machine-checkable).
+CUDA_W8A8_ISA = "dp4a.s32.s32"
+#: The K tail (K % 4) and any scalar path use explicit widening
+#: (``cvt.s32.s8`` + ``mad.lo.s32``); this is an implementation detail of the
+#: same kernel, not a second matrix capability.
+CUDA_W8A8_COMPENSATION = "none_signed_dp4a_no_zero_point"
+
+#: ``dp4a`` was introduced with compute capability 6.1 (PTX ISA: sm_61+).
+CUDA_W8A8_DP4A_MIN_SM = 61
+#: ``mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32`` requires sm_75+
+#: (contract 0002 section 4 M4-d).  C6 probes it and deliberately does not
+#: emit it.
+CUDA_W8A8_IMMA_MIN_SM = 75
+#: The C6 PTX module is emitted with ``.target sm_75`` (the CUDA 13.x toolkit
+#: floor) so a driver JIT for any supported Turing-or-newer device can load
+#: it.  ``dp4a`` itself only needs sm_61, so the probe-derived requirement is
+#: ``dp4a and sm >= 75``; a device that cannot load this module fails closed
+#: rather than falling back to a different precision.
+CUDA_W8A8_MIN_PTX_TARGET_SM = 75
+
+#: Matrix kinds that must stay absent from the C6 declaration.  C6 emits a
+#: signed ``dp4a`` plane only; it never claims a widening matrix kind, VNNI,
+#: imma/mma or any dot-product extension.
+CUDA_W8A8_FORBIDDEN_MATRIX_CAPABILITIES = (
+    "s8s8_s32_widening",
+    "s8s8_s32_vnni_dpbusd",
+    "imma_m16n8k32",
+    "mma_s8",
+    "int8_dot_product",
+)
+
+#: Probe-gated W8A8 declaration for the CUDA target.  The matrix kind names
+#: the concrete native mechanism (packed s8 ``dp4a`` with an int32
+#: accumulator); dtypes cover the four C6 opcodes (int8 codes, int32
+#: accumulator, fp32 scales, bf16 epilogue output).
+CUDA_W8A8_CAPABILITY = _CapabilitySet(
+    dtypes=("int8", "int32", "float32", "bf16"),
+    matrix_capabilities=(CUDA_W8A8_MATRIX_CAPABILITY,),
+)
+
+
+class CudaW8A8UnavailableError(RuntimeError):
+    """The CUDA W8A8 plane cannot be used on this host/device (fail-closed)."""
+
+
+def _as_int(value: Any, field: str) -> int:
+    if isinstance(value, bool):
+        raise CudaW8A8UnavailableError("{} must be an integer compute capability component".format(field))
+    try:
+        return int(value)
+    except (TypeError, ValueError) as exc:
+        raise CudaW8A8UnavailableError("{} is not an integer".format(field)) from exc
+
+
+@dataclass(frozen=True)
+class CudaW8A8Device:
+    """Structured result of the real CUDA device probe.
+
+    ``major``/``minor`` are the compute capability components reported by the
+    Driver API.  ``dp4a`` and ``imma_s8`` are *derived* from them; no artifact
+    hardcodes a device name or an ``sm_120`` availability guess.
+    """
+
+    index: int
+    name: str
+    major: int
+    minor: int
+    total_memory: int = 0
+    source: str = "cuda_driver_device_info"
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "index", _as_int(self.index, "device.index"))
+        object.__setattr__(self, "major", _as_int(self.major, "device.major"))
+        object.__setattr__(self, "minor", _as_int(self.minor, "device.minor"))
+        if self.major < 0 or self.minor < 0:
+            raise CudaW8A8UnavailableError("compute capability components must be non-negative")
+        if not isinstance(self.name, str):
+            object.__setattr__(self, "name", str(self.name))
+        object.__setattr__(self, "total_memory", _as_int(self.total_memory, "device.total_memory"))
+
+    @property
+    def sm(self) -> int:
+        """Compute capability as ``major * 10 + minor`` (for example 61, 120)."""
+
+        return self.major * 10 + self.minor
+
+    @property
+    def compute_capability(self) -> str:
+        return "{}.{}".format(self.major, self.minor)
+
+    @property
+    def dp4a(self) -> bool:
+        """Whether ``dp4a.s32.s32`` (s8 x s8 -> s32) is available."""
+
+        return self.sm >= CUDA_W8A8_DP4A_MIN_SM
+
+    @property
+    def imma_s8(self) -> bool:
+        """Whether ``mma.m16n8k32`` with s8 inputs is available (unused by C6)."""
+
+        return self.sm >= CUDA_W8A8_IMMA_MIN_SM
+
+    @property
+    def supports_w8a8_module(self) -> bool:
+        """Whether the probed device can load the C6 ``sm_75`` PTX module."""
+
+        return self.sm >= CUDA_W8A8_MIN_PTX_TARGET_SM
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "index": self.index,
+            "name": self.name,
+            "compute_capability": self.compute_capability,
+            "major": self.major,
+            "minor": self.minor,
+            "sm": self.sm,
+            "total_memory": self.total_memory,
+            "dp4a": self.dp4a,
+            "imma_s8": self.imma_s8,
+            "supports_w8a8_module": self.supports_w8a8_module,
+            "source": self.source,
+        }
+
+
+def _coerce_device(device: Any) -> CudaW8A8Device:
+    if isinstance(device, CudaW8A8Device):
+        return device
+    if isinstance(device, Mapping):
+        return CudaW8A8Device(
+            index=device.get("index", 0),
+            name=device.get("name", "unknown"),
+            major=device.get("major"),
+            minor=device.get("minor"),
+            total_memory=device.get("total_memory", 0),
+            source=device.get("source", "injected_device_mapping"),
+        )
+    if hasattr(device, "major") and hasattr(device, "minor"):
+        return CudaW8A8Device(
+            index=getattr(device, "index", 0),
+            name=getattr(device, "name", "unknown"),
+            major=getattr(device, "major"),
+            minor=getattr(device, "minor"),
+            total_memory=getattr(device, "total_memory", 0),
+            source="driver_device_info",
+        )
+    raise CudaW8A8UnavailableError(
+        "CUDA W8A8 requires a real probed device (got {!r})".format(type(device).__name__)
+    )
+
+
+def cuda_w8a8_capabilities(
+    device: Any,
+    *,
+    target: Any = None,
+) -> _CapabilitySet:
+    """Return the probe-gated CUDA W8A8 declaration.
+
+    This is the single gate used by the compiler, the artifact metadata and
+    the runtime entry points.  A missing device, a device without ``dp4a`` or
+    a device that cannot load the C6 PTX module raises
+    :class:`UnsupportedCapabilityError` naming the missing matrix kind; no
+    BF16 fallback exists inside the W8A8 path (contract 0002 section 6).
+    """
+
+    target_name = target if target is not None else "cuda.ptx.w8a8"
+    if device is None:
+        raise _UnsupportedCapabilityError("matrix_capability", CUDA_W8A8_MATRIX_CAPABILITY, target_name)
+    try:
+        probed = _coerce_device(device)
+    except CudaW8A8UnavailableError:
+        raise
+    if not probed.dp4a or not probed.supports_w8a8_module:
+        raise _UnsupportedCapabilityError(
+            "matrix_capability", CUDA_W8A8_MATRIX_CAPABILITY, target_name
+        )
+    CUDA_W8A8_CAPABILITY.require("matrix", CUDA_W8A8_MATRIX_CAPABILITY, target_name)
+    for dtype in ("int8", "int32", "float32", "bf16"):
+        CUDA_W8A8_CAPABILITY.require("dtype", dtype, target_name)
+    return CUDA_W8A8_CAPABILITY
+
+
+def cuda_w8a8_capability_metadata(device: Any, *, target: Any = None) -> Mapping[str, Any]:
+    """Canonical artifact metadata block for the probed W8A8 capability."""
+
+    probed = _coerce_device(device)
+    declaration = cuda_w8a8_capabilities(probed, target=target)
+    return {
+        "dtypes": list(declaration.dtypes),
+        "matrix_capabilities": list(declaration.matrix_capabilities),
+        "digest": declaration.fingerprint,
+        "matrix_kind": CUDA_W8A8_MATRIX_CAPABILITY,
+        "isa": CUDA_W8A8_ISA,
+        "compensation": CUDA_W8A8_COMPENSATION,
+        "min_sm": CUDA_W8A8_MIN_PTX_TARGET_SM,
+        "dp4a": probed.dp4a,
+        "imma_s8": probed.imma_s8,
+        "forbidden_matrix_capabilities": list(CUDA_W8A8_FORBIDDEN_MATRIX_CAPABILITIES),
+    }
+
+
+def verify_cuda_w8a8_capability_metadata(declared: Any, device: Any, *, target: Any = None) -> Mapping[str, Any]:
+    """Fail-closed check that artifact metadata matches a fresh real probe."""
+
+    if not isinstance(declared, Mapping):
+        raise CudaW8A8UnavailableError("CUDA W8A8 capability metadata is missing")
+    expected = cuda_w8a8_capability_metadata(device, target=target)
+    for key in ("dtypes", "matrix_capabilities", "digest", "matrix_kind", "isa"):
+        actual_value = declared.get(key)
+        expected_value = expected[key]
+        if isinstance(expected_value, (list, tuple)):
+            matches = list(actual_value) == list(expected_value)
+        else:
+            matches = actual_value == expected_value
+        if not matches:
+            raise CudaW8A8UnavailableError(
+                "CUDA W8A8 capability metadata {!r} does not match the real probe".format(key)
+            )
+    return expected
+
+
+__all__ = [
+    "CUDA_W8A8_CAPABILITY",
+    "CUDA_W8A8_COMPENSATION",
+    "CUDA_W8A8_DP4A_MIN_SM",
+    "CUDA_W8A8_FORBIDDEN_MATRIX_CAPABILITIES",
+    "CUDA_W8A8_IMMA_MIN_SM",
+    "CUDA_W8A8_ISA",
+    "CUDA_W8A8_MATRIX_CAPABILITY",
+    "CUDA_W8A8_MIN_PTX_TARGET_SM",
+    "CudaW8A8Device",
+    "CudaW8A8UnavailableError",
+    "cuda_w8a8_capabilities",
+    "cuda_w8a8_capability_metadata",
+    "verify_cuda_w8a8_capability_metadata",
+]
diff --git a/python/tests/ut/pypto_x/cuda_w8a8_device_validation.py b/python/tests/ut/pypto_x/cuda_w8a8_device_validation.py
new file mode 100644
index 000000000..8f143defa
--- /dev/null
+++ b/python/tests/ut/pypto_x/cuda_w8a8_device_validation.py
@@ -0,0 +1,593 @@
+"""Weight-free CUDA W8A8 device validation driver (contract 0002 C6 / R6).
+
+Run on the RTX 5080 (GamePC/WSL2):
+
+    PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=python python3 \
+        python/tests/ut/pypto_x/cuda_w8a8_device_validation.py
+
+The driver compiles the four frozen C1 opcodes through ``CudaW8A8Compiler``
+with the *real* Driver API probe, executes the PTX kernels on the device and
+compares every result against the portable C1 golden bit-for-bit (NaN payloads
+are compared with the same NaN-equivalence rule the C3/C4/C5 evidence uses).
+It prints one JSON report to stdout and exits non-zero on any mismatch.
+"""
+
+from __future__ import annotations
+
+import json
+import random
+import struct
+import sys
+
+from pypto.backends.cuda import (
+    CudaDriver,
+    CudaRuntime,
+    CudaW8A8ExecutionError,
+)
+from pypto.compiler.targets.cuda_w8a8 import CudaW8A8Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35_w8a8_scheme import (
+    dequantize_epilogue_bf16,
+    dequantize_s8,
+    qmatmul_s8s8_s32,
+    quantize_per_token_s8,
+)
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral")
+
+
+def _program(parameters, returns, operations, name="main"):
+    return CoreProgram(
+        functions=(CoreFunction(name, tuple(parameters), tuple(returns), Region(tuple(operations))),)
+    )
+
+
+def _tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, shape))
+
+
+def _qmatmul_program(left_shape, right_shape):
+    left = _tensor("left", "int8", left_shape)
+    right = _tensor("right", "int8", right_shape)
+    output = _tensor("output", "int32", left_shape[:-2] + (left_shape[-2], right_shape[-1]))
+    return _program((left, right), (output,), (Operation("qmatmul_s8s8_s32", (left, right), (output,)),))
+
+
+def _dequantize_program(shape, rows):
+    codes = _tensor("codes", "int8", shape)
+    scales = _tensor("scales", "float32", (rows,))
+    output = _tensor("output", "float32", shape)
+    return _program((codes, scales), (output,), (Operation("dequantize_s8", (codes, scales), (output,)),))
+
+
+def _epilogue_program(shape):
+    rows, columns = shape
+    accumulator = _tensor("accumulator", "int32", shape)
+    row_scales = _tensor("row_scales", "float32", (rows,))
+    column_scales = _tensor("column_scales", "float32", (columns,))
+    output = _tensor("output", "bf16", shape)
+    return _program(
+        (accumulator, row_scales, column_scales),
+        (output,),
+        (Operation("dequantize_epilogue_bf16", (accumulator, row_scales, column_scales), (output,)),),
+    )
+
+
+def _quantize_program(shape, dtype="float32"):
+    values = _tensor("values", dtype, shape)
+    codes = _tensor("codes", "int8", shape)
+    scales = _tensor("scales", "float32", (shape[0],))
+    return _program((values,), (codes, scales), (Operation("quantize_per_token_s8", (values,), (codes, scales)),))
+
+
+def _f32(value):
+    return struct.unpack("<f", struct.pack("<f", float(value)))[0]
+
+
+def _f32_bits(value):
+    return struct.pack("<f", value)
+
+
+def _is_f32_nan(value) -> bool:
+    bits = struct.unpack("<I", _f32_bits(value))[0]
+    return (bits & 0x7F800000) == 0x7F800000 and bool(bits & 0x007FFFFF)
+
+
+def _f32_equal(left, right) -> bool:
+    if _f32_bits(left) == _f32_bits(right):
+        return True
+    return _is_f32_nan(left) and _is_f32_nan(right)
+
+
+def _is_bf16_nan(bits: int) -> bool:
+    return (bits & 0x7F80) == 0x7F80 and bool(bits & 0x007F)
+
+
+def _bf16_bits_equal(left: int, right: int) -> bool:
+    if left == right:
+        return True
+    return _is_bf16_nan(left) and _is_bf16_nan(right)
+
+
+def _count(shape):
+    result = 1
+    for dimension in shape:
+        result *= int(dimension)
+    return result
+
+
+class Validator:
+    def __init__(self, compiler, runtime):
+        self.compiler = compiler
+        self.runtime = runtime
+        self.checks = []
+        self.mismatches = []
+
+    def _compile(self, program):
+        target_ir = self.compiler.lower(program, TARGET)
+        return self.compiler.compile(target_ir), target_ir
+
+    def check(self, name, function):
+        try:
+            detail = function()
+        except Exception as exc:  # expected-failure checks raise ValueError
+            self.mismatches.append({"check": name, "error": "{}: {}".format(type(exc).__name__, exc)})
+            return False
+        self.checks.append({"check": name, "detail": detail})
+        return True
+
+    def expect_error(self, name, function, expected, match=None):
+        try:
+            function()
+        except Exception as exc:
+            message = "{}: {}".format(type(exc).__name__, exc)
+            ok = isinstance(exc, expected) and (match is None or match in message)
+            self.checks.append(
+                {
+                    "check": name,
+                    "detail": "expected {} ({})".format(expected.__name__, message),
+                    "passed": ok,
+                }
+            )
+            if not ok:
+                self.mismatches.append({"check": name, "unexpected_error": message})
+            return ok
+        self.mismatches.append({"check": name, "error": "expected {}, nothing raised".format(expected.__name__)})
+        return False
+
+    # -- qmatmul ---------------------------------------------------------
+    def qmatmul_case(self, name, left_shape, right_shape, left, right):
+        artifact, target_ir = self._compile(_qmatmul_program(left_shape, right_shape))
+        expected = qmatmul_s8s8_s32(
+            left, right, left_shape=left_shape, right_shape=right_shape
+        )
+        actual = self.runtime.run_w8a8_qmatmul(
+            artifact, left, right, left_shape=left_shape, right_shape=right_shape
+        )
+        if tuple(actual) != tuple(expected.values):
+            self.mismatches.append(
+                {
+                    "check": name,
+                    "expected": list(expected.values)[:16],
+                    "actual": list(actual)[:16],
+                }
+            )
+            return False
+        self.checks.append(
+            {
+                "check": name,
+                "detail": "{} values bit-exact, k={}".format(len(actual), left_shape[-1]),
+            }
+        )
+        return True
+
+    # -- dequantize ------------------------------------------------------
+    def dequantize_case(self, name, shape, codes, scales):
+        artifact, _ = self._compile(_dequantize_program(shape, _count(shape[:-1]) if len(shape) > 1 else 1))
+        expected = dequantize_s8(codes, [_f32(value) for value in scales], shape=shape)
+        actual = self.runtime.run_w8a8_dequantize_s8(artifact, codes, scales, shape=shape)
+        if len(actual) != len(expected) or not all(
+            _f32_equal(a, b) for a, b in zip(actual, expected)
+        ):
+            self.mismatches.append({"check": name, "expected": list(expected)[:16], "actual": list(actual)[:16]})
+            return False
+        self.checks.append({"check": name, "detail": "{} values match (NaN-equivalent)".format(len(actual))})
+        return True
+
+    # -- epilogue --------------------------------------------------------
+    def epilogue_case(self, name, shape, accumulator, row_scales, column_scales):
+        artifact, _ = self._compile(_epilogue_program(shape))
+        rows, columns = shape
+        expected = dequantize_epilogue_bf16(
+            accumulator,
+            [_f32(value) for value in row_scales],
+            [_f32(value) for value in column_scales],
+            shape=shape,
+        )
+        actual = self.runtime.run_w8a8_dequantize_epilogue_bf16(
+            artifact, accumulator, row_scales, column_scales, shape=shape
+        )
+        if len(actual) != len(expected.bf16_bits) or not all(
+            _bf16_bits_equal(a, b) for a, b in zip(actual, expected.bf16_bits)
+        ):
+            self.mismatches.append(
+                {
+                    "check": name,
+                    "expected": list(expected.bf16_bits)[:16],
+                    "actual": list(actual)[:16],
+                }
+            )
+            return False
+        self.checks.append({"check": name, "detail": "{} bf16 values match".format(len(actual))})
+        return True
+
+    # -- quantize --------------------------------------------------------
+    def quantize_case(self, name, shape, values, dtype="float32"):
+        artifact, _ = self._compile(_quantize_program(shape, dtype=dtype))
+        if dtype == "bf16":
+            rounded = [_f32_from_bf16(_bf16_bits(value)) for value in values]
+        else:
+            rounded = [_f32(value) for value in values]
+        expected = quantize_per_token_s8(rounded, shape=shape)
+        actual = self.runtime.run_w8a8_quantize_per_token_s8(artifact, values, shape=shape, dtype=dtype)
+        if (
+            tuple(actual.codes) != tuple(expected.codes)
+            or not all(_f32_equal(a, b) for a, b in zip(actual.scales, expected.scales))
+            or actual.saturation_count != expected.saturation_count
+        ):
+            self.mismatches.append(
+                {
+                    "check": name,
+                    "expected_codes": list(expected.codes)[:16],
+                    "actual_codes": list(actual.codes)[:16],
+                    "expected_scales": list(expected.scales),
+                    "actual_scales": list(actual.scales),
+                }
+            )
+            return False
+        self.checks.append(
+            {
+                "check": name,
+                "detail": "{}x{} codes+scales+sat({}) match".format(shape[0], shape[1], actual.saturation_count),
+            }
+        )
+        return True
+
+
+def _bf16_bits(value):
+    raw = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    upper = raw >> 16
+    lower = raw & 0xFFFF
+    if lower > 0x8000 or (lower == 0x8000 and (upper & 1)):
+        upper += 1
+    return upper & 0xFFFF
+
+
+def _f32_from_bf16(bits):
+    return struct.unpack("<f", struct.pack("<I", bits << 16))[0]
+
+
+def main():
+    driver = CudaDriver()
+    info = driver.device_info()
+    compiler = CudaW8A8Compiler(driver=driver)
+    runtime = CudaRuntime(driver=driver)
+    probe = runtime.probe_w8a8_device()
+    validator = Validator(compiler, runtime)
+    rng = random.Random(20260911)
+
+    # a) qmatmul: rank 2/3/4, batch prefixes, tails, extremes, K bound.
+    validator.qmatmul_case(
+        "qmatmul_rank2_basic",
+        (2, 3),
+        (3, 4),
+        [rng.randint(-127, 127) for _ in range(6)],
+        [rng.randint(-127, 127) for _ in range(12)],
+    )
+    validator.qmatmul_case(
+        "qmatmul_rank3_batch",
+        (2, 2, 3),
+        (2, 3, 4),
+        [rng.randint(-127, 127) for _ in range(12)],
+        [rng.randint(-127, 127) for _ in range(24)],
+    )
+    validator.qmatmul_case(
+        "qmatmul_rank4_batch",
+        (2, 1, 4, 5),
+        (2, 1, 5, 6),
+        [rng.randint(-127, 127) for _ in range(40)],
+        [rng.randint(-127, 127) for _ in range(60)],
+    )
+    validator.qmatmul_case(
+        "qmatmul_k_tail_7",
+        (3, 7),
+        (7, 5),
+        [rng.randint(-127, 127) for _ in range(21)],
+        [rng.randint(-127, 127) for _ in range(35)],
+    )
+    validator.qmatmul_case(
+        "qmatmul_k_tail_9_m1n1",
+        (1, 9),
+        (9, 1),
+        [rng.randint(-127, 127) for _ in range(9)],
+        [rng.randint(-127, 127) for _ in range(9)],
+    )
+    validator.qmatmul_case(
+        "qmatmul_signed_extremes",
+        (2, 4),
+        (4, 3),
+        [127, -127, 127, -127, -127, 127, -127, 127],
+        [127, -127, 0, -127, 127, 0, 127, 127, -127, -127, 127, 0],
+    )
+    # K upper bound: every product is 127*127, so the int32 accumulator ends
+    # one step below INT32_MAX (133144*16129 = 2,147,466,376).
+    k = 133144
+    validator.qmatmul_case(
+        "qmatmul_k_upper_bound_int32_extreme",
+        (1, k),
+        (k, 1),
+        [127] * k,
+        [127] * k,
+    )
+    validator.qmatmul_case(
+        "qmatmul_k_upper_bound_int32_negative_extreme",
+        (1, k),
+        (k, 1),
+        [-127] * k,
+        [127] * k,
+    )
+    validator.expect_error(
+        "qmatmul_reserved_minus_128",
+        lambda: runtime.run_w8a8_qmatmul(
+            _compile_only(compiler, _qmatmul_program((1, 2), (2, 1))), [-128, 1], [3, 4]
+        ),
+        CudaW8A8ExecutionError,
+        match="reserved -128",
+    )
+
+    # b) dequantize_s8.
+    validator.dequantize_case(
+        "dequantize_rank2",
+        (3, 5),
+        [rng.randint(-127, 127) for _ in range(15)],
+        [rng.uniform(-2.0, 2.0) for _ in range(3)],
+    )
+    validator.dequantize_case(
+        "dequantize_rank3",
+        (2, 3, 4),
+        [rng.randint(-127, 127) for _ in range(24)],
+        [rng.uniform(-2.0, 2.0) for _ in range(6)],
+    )
+    validator.dequantize_case(
+        "dequantize_special_scales",
+        (2, 3),
+        [-127, 0, 127, 1, -1, 5],
+        [0.0, float("inf")],
+    )
+
+    # c) epilogue.
+    validator.epilogue_case(
+        "epilogue_random",
+        (3, 5),
+        [rng.randint(-(2**31), 2**31 - 1) for _ in range(15)],
+        [rng.uniform(1e-3, 1.0) for _ in range(3)],
+        [rng.uniform(1e-3, 1.0) for _ in range(5)],
+    )
+    validator.epilogue_case(
+        "epilogue_int32_extremes_special_scales",
+        (3, 4),
+        [-(2**31), 2**31 - 1, 0, 1, -1, 123456789, -(2**31), 2**31 - 1, 7, -7, 0, 0],
+        [float("inf"), 1e-3, float("nan")],
+        [0.5, 1.5, 2.5, 3.5],
+    )
+    validator.expect_error(
+        "epilogue_binary32_overflow",
+        lambda: runtime.run_w8a8_dequantize_epilogue_bf16(
+            _compile_only(compiler, _epilogue_program((1, 4))),
+            [2**31 - 1] * 4,
+            [3.0e38],
+            [3.0e38] * 4,
