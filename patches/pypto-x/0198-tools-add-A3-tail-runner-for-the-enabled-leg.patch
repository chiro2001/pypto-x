From 77fd0700fa70cef9b5a806f27ff10ad439c38d3d Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 02:53:31 +0800
Subject: [PATCH 198/254] tools: add A3 tail runner for the enabled leg

The first window pass completed the disabled leg and aborted before the
enabled leg because the running run_a3_window.sh was replaced mid-read by
its git-synced copy.  The tail runner is a separate file and records the
enabled leg, discipline and manifest only.
---
 tools/sve256_liveness_evidence/fetch_results.sh       |  2 +-
 tools/sve256_liveness_evidence/run_a3_tail_enabled.sh | 92 +++++++++++++++++++++++++++++++++++++++
 tools/sve256_liveness_evidence/run_a3_window.sh       |  2 +-
 3 files changed, 94 insertions(+), 2 deletions(-)

diff --git a/tools/sve256_liveness_evidence/fetch_results.sh b/tools/sve256_liveness_evidence/fetch_results.sh
index b957660e9..e7c220147 100755
--- a/tools/sve256_liveness_evidence/fetch_results.sh
+++ b/tools/sve256_liveness_evidence/fetch_results.sh
@@ -10,9 +10,9 @@ A3_HOME=/home/l00886679
 A3_ROOT=pypto-x-a3/sve256-liveness-release
 
 mkdir -p "${EV}/raw/a3" "${EV}/logs/a3"
+ssh -o BatchMode=yes "${A3}" "cd ${A3_HOME}/${A3_ROOT} && sha256sum -c raw/sha256sums.txt >/dev/null 2>&1 && echo '[fetch] remote raw manifest verified' || echo '[fetch] WARNING: remote raw manifest mismatch'"
 scp -q -o BatchMode=yes -r "${A3}:${A3_HOME}/${A3_ROOT}/raw/." "${EV}/raw/a3/"
 scp -q -o BatchMode=yes -r "${A3}:${A3_HOME}/${A3_ROOT}/logs/." "${EV}/logs/a3/"
 ssh -o BatchMode=yes "${A3}" "du -sb ${A3_HOME}/${A3_ROOT}/raw ${A3_HOME}/${A3_ROOT}/logs ${A3_HOME}/${A3_ROOT}" \
   > "${EV}/logs/a3/a3_dump_inventory.txt" 2>&1
 echo "[fetch] raw files=$(find "${EV}/raw/a3" -type f | wc -l) log files=$(find "${EV}/logs/a3" -type f | wc -l)"
-(cd "${EV}/raw/a3" && sha256sum -c sha256sums.txt >/dev/null 2>&1 && echo "[fetch] remote manifest verified") || echo "[fetch] WARNING: remote manifest mismatch"
diff --git a/tools/sve256_liveness_evidence/run_a3_tail_enabled.sh b/tools/sve256_liveness_evidence/run_a3_tail_enabled.sh
new file mode 100755
index 000000000..e1d4a9f66
--- /dev/null
+++ b/tools/sve256_liveness_evidence/run_a3_tail_enabled.sh
@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+# sve256-liveness-release: tail of the A3 window.  Runs ON a3-21.
+#
+# The first window pass completed the release-disabled leg (JSON PASS,
+# rss_peak=68224 MiB) and then aborted with a bash syntax error because the
+# running script file was replaced by a git-synced copy mid-read.  This tail
+# script runs only the release-enabled leg with identical inputs/flags/cpus,
+# then the discipline check and the manifest -- from a NEW file, so the
+# overwritten-mid-run hazard cannot repeat.
+set -u
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PY="${HOME}/pypto-x-a3/envs/pypto-x-c8/bin/python"
+DRIVER="${ROOT}/src/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py"
+ASSET="${HOME}/models/Qwen3.5-0.8B"
+RAW="${ROOT}/raw"
+LOGS="${ROOT}/logs"
+WORK="${ROOT}/work"
+TMP="${ROOT}/tmp"
+CPUS=320,322,324,326,328,330,332,334
+mkdir -p "${RAW}" "${LOGS}" "${WORK}" "${TMP}"
+
+export PYTHONPATH="${ROOT}/src/python"
+export PYPTO_X_PORTABLE_ONLY=1
+export TMPDIR="${TMP}"
+export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8
+export OMP_PROC_BIND=close OMP_PLACES=cores
+
+start_sampler() {
+  local pid="$1" out="$2"
+  (
+    echo "# pid=${pid} started_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+    while kill -0 "${pid}" 2>/dev/null; do
+      local ts mem
+      ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
+      mem=$(awk '/^VmRSS:/{rss=$2} /^VmHWM:/{hwm=$2} END{printf "rss_kib=%s hwm_kib=%s", rss, hwm}' "/proc/${pid}/status" 2>/dev/null)
+      echo "${ts} ${mem}"
+      sleep 5
+    done
+  ) > "${out}" 2>&1 &
+  echo $!
+}
+
+run_leg() {
+  local label="$1"; shift
+  local out="${RAW}/liveness_ab_release_${label}.json"
+  local progress="${RAW}/liveness_ab_release_${label}.progress.log"
+  local log="${LOGS}/liveness_ab_release_${label}.log"
+  local samples="${RAW}/rss_${label}.samples"
+  local leg_work="${WORK}/liveness_ab_release_${label}"
+  rm -f "${out}" "${progress}" "${log}" "${samples}"
+  mkdir -p "${leg_work}"
+  echo "[leg:${label}] start=$(date -u '+%Y-%m-%dT%H:%M:%SZ') cpus=${CPUS}"
+  taskset -c "${CPUS}" "${PY}" "${DRIVER}" \
+    --stage s3 --backend sve256 --precision bf16 \
+    --prompt en_continuation --steps 5 --decode-steps 4 \
+    --asset-dir "${ASSET}" --reference-dir "${ROOT}/refmin" --rope-dir "${ROOT}/rope" \
+    --skip-gold-alignment --no-watchdog \
+    --output "${out}" --progress "${progress}" --work-dir "${leg_work}" \
+    "$@" \
+    > "${log}" 2>&1 &
+  local pid=$!
+  echo "${pid}" > "${RAW}/liveness_ab_release_${label}.pid"
+  local sampler
+  sampler=$(start_sampler "${pid}" "${samples}")
+  wait "${pid}"
+  local rc=$?
+  wait "${sampler}" 2>/dev/null
+  echo "[leg:${label}] exit=${rc} end=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  tail -2 "${log}"
+  return "${rc}"
+}
+
+leg_b_rc=0
+run_leg enabled || leg_b_rc=$?
+
+{
+  echo "== discipline (tail) =="
+  date -u '+finished_utc=%Y-%m-%dT%H:%M:%SZ'
+  echo "leg_disabled_exit=0(JSON PASS) leg_enabled_exit=${leg_b_rc}"
+  echo "write_path_only=${ROOT}"
+  echo "cpus_used=${CPUS} concurrency=1 case x 8 threads (no HT)"
+  echo "-- own processes still alive (must be none) --"
+  ps -u "$(whoami)" -o pid,psr,nlwp,pcpu,rss,args | grep -E "qwen35_weighted_execution_driver|test_w8a8_sve256|test_cpu_sve256" | grep -v grep || echo "NO_RESIDUE"
+  echo "-- NPU: this script never invokes npu-smi / ACL / torch_npu; no ASCEND device env is set --"
+  [[ -z "${ASCEND_RT_VISIBLE_DEVICES:-}" ]] && echo "ASCEND_RT_VISIBLE_DEVICES=unset"
+  echo "-- tree size --"
+  du -sb "${ROOT}" 2>/dev/null
+} > "${LOGS}/discipline_check.txt" 2>&1
+
+( cd "${ROOT}" && find raw logs -type f ! -name 'sha256sums.txt' -print0 | sort -z | xargs -0 sha256sum > raw/sha256sums.txt )
+echo "[tail] done rc_enabled=${leg_b_rc}"
diff --git a/tools/sve256_liveness_evidence/run_a3_window.sh b/tools/sve256_liveness_evidence/run_a3_window.sh
index 7856d6360..5779527d1 100755
--- a/tools/sve256_liveness_evidence/run_a3_window.sh
+++ b/tools/sve256_liveness_evidence/run_a3_window.sh
@@ -154,5 +154,5 @@ run_leg enabled || leg_b_rc=$?
   du -sb "${ROOT}" 2>/dev/null
 } > "${LOGS}/discipline_check.txt" 2>&1
 
-( cd "${ROOT}" && find raw logs -type f -print0 | sort -z | xargs -0 sha256sum > raw/sha256sums.txt 2>/dev/null )
+( cd "${ROOT}" && find raw logs -type f ! -name 'sha256sums.txt' -print0 | sort -z | xargs -0 sha256sum > raw/sha256sums.txt )
 echo "[window] done rc_disabled=${leg_a_rc} rc_enabled=${leg_b_rc}"
