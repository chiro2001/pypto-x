+# ---------------------------------------------------------------------------
+# 0042 item 1b2: fallback chain structure on a genuine AOCL fallback report
+# ---------------------------------------------------------------------------
+def _fallback_report():
+    capability = _capability()
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="portable_only"),
+        resources=ResourcePolicy(max_threads="auto"),
+    )
+    plan = plan_matmul(_SHAPE_A, _SHAPE_B, "float32", policy, capability=capability).plan
+    original = providers_module.PROVIDERS[AOCL_LPGEMM_F32_PROVIDER_ID]
+
+    class UnavailableAtRuntime:
+        provider_id = AOCL_LPGEMM_F32_PROVIDER_ID
+        version = original.version
+        implementation = original.implementation
+        numeric_class = original.numeric_class
+
+        def execute(self, plan, left, right, output, capability):
+            raise ProviderUnavailableError(
+                "simulated runtime unavailability",
+                field="capability.providers",
+                requested=self.provider_id,
+                available=[],
+                reason="provider_capability_unavailable:library_not_found",
+            )
+
+    providers_module.PROVIDERS[AOCL_LPGEMM_F32_PROVIDER_ID] = UnavailableAtRuntime()
+    try:
+        left, right = _tensors("float32")
+        _, report = execute_matmul_plan(plan, left, right, capability=capability)
+    finally:
+        providers_module.PROVIDERS[AOCL_LPGEMM_F32_PROVIDER_ID] = original
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def test_u2a_genuine_fallback_report_still_validates():
+    document = _fallback_report()
+    validate_report_schema(document)
+    assert document["dispatch"]["provider_declared"] == AOCL_LPGEMM_F32_PROVIDER_ID
+    assert document["dispatch"]["provider_invoked"] == "portable"
+    assert document["resolution"]["fallback_chain"] == [AOCL_LPGEMM_F32_PROVIDER_ID, "portable"]
+    assert document["dispatch"]["chain_position"] == 1
+
+
+@pytest.mark.parametrize(
+    "label,mutate",
+    (
+        (
+            "empty_chain",
+            lambda d: (
+                d["resolution"].update(fallback_chain=[]),
+                d["resolved_policy"]["fallback"].update(chain=[]),
+            ),
+        ),
+        (
+            "duplicate_chain",
+            lambda d: (
+                d["resolution"].update(fallback_chain=[AOCL_LPGEMM_F32_PROVIDER_ID, AOCL_LPGEMM_F32_PROVIDER_ID]),
+                d["resolved_policy"]["fallback"].update(
+                    chain=[AOCL_LPGEMM_F32_PROVIDER_ID, AOCL_LPGEMM_F32_PROVIDER_ID]
+                ),
+            ),
+        ),
+        (
+            "chain0_not_declared",
+            lambda d: (
+                d["resolution"].update(fallback_chain=["portable"]),
+                d["resolved_policy"]["fallback"].update(chain=["portable"]),
+            ),
+        ),
+        (
+            "chain_position_wrong",
+            lambda d: d["dispatch"].update(chain_position=0),
+        ),
+        (
+            "chain_position_out_of_range",
+            lambda d: d["dispatch"].update(chain_position=99),
+        ),
+    ),
+)
+def test_u2a_fallback_chain_structure_is_refused(label, mutate):
+    del label
+    document = _fallback_report()
+    mutate(document)
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(document)
+    assert getattr(excinfo.value, "code", None) == "REPORT_SCHEMA_INVALID"
