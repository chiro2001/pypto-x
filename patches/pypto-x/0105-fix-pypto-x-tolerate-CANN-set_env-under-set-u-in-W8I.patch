From c7185e0d4851648699c300d81ca34806b0a1d4df Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Thu, 10 Sep 2026 21:33:49 +0800
Subject: [PATCH 105/258] fix(pypto-x): tolerate CANN set_env under set -u in
 W8I orchestrator

---
 tools/a2_vllm_ascend_profiling/run_a2_profiling.sh | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh b/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
index 0f3c89e98..651794c66 100755
--- a/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
+++ b/tools/a2_vllm_ascend_profiling/run_a2_profiling.sh
@@ -46,6 +46,8 @@ fi
 mkdir -p "$WORKDIR" "$LOGS" "$TRACES"
 
 # ---- CANN / ATB 环境（与 W8H 一致的加载顺序）----
+# 注意：CANN/ATB 的 set_env.sh 会引用未定义变量，需临时关掉 set -u。
+set +u
 # shellcheck disable=SC1091
 source /usr/local/Ascend/ascend-toolkit/set_env.sh
 export PATH="$(dirname "$PYTHON"):${PATH}"
@@ -53,6 +55,7 @@ if [[ -f /usr/local/Ascend/nnal/atb/set_env.sh ]]; then
     # shellcheck disable=SC1091
     source /usr/local/Ascend/nnal/atb/set_env.sh
 fi
+set -u
 # W8H 固化：spawn 避免 fork 后无法 re-initialize NPU；tokenizer/权重一律本地。
 export VLLM_WORKER_MULTIPROC_METHOD=spawn
 export HF_HUB_OFFLINE=1
