+def test_scalar_operand_regions_round_trip(tmp_path):
+    for name, (program, scalar_positions) in _scalar_region_cases().items():
+        plan = plan_region(program)
+        document = plan.to_dict()
+        request = document["operations"][0]["request"]
+        for position in scalar_positions:
+            assert request["inputs"][position]["kind"] == "scalar", name
+            assert request["inputs"][position]["shape"] == [], name
+        entry_kinds = [
+            item["kind"] for item in document["boundary_signature"]["entry_inputs"]
+        ]
+        assert "scalar" in entry_kinds, name
+
+        assert validate_region_plan(
+            document, policy=plan.policy, re_resolve=False
+        ) == document, name
+        assert plan.validate() is plan, name
+        path = tmp_path / ("%s.json" % name)
+        path.write_text(canonical_json(document) + "\n", encoding="utf-8")
+        loaded = load_region_plan(path, capability=plan.capability)
+        assert loaded.digest == plan.digest, name
+        explanation = explain_region_plan(document, capability=plan.capability)
+        assert explanation.to_dict()["region_plan_digest"] == plan.digest, name
+
