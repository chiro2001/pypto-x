+def _scalar_region_cases():
+    cond = _ref("cond", "bool", (2, 3))
+    x = _ref("x", "float32", (2, 3))
+    fill = _scalar("fill", "float32")
+    w = _ref("w", "float32", (2, 3))
+    where_program = _program(
+        (cond, x, fill),
+        (_op("where", (cond, x, fill), (w,)),),
+        (w,),
+    )
+    a = _ref("a", "float32", (2, 3))
+    s = _scalar("s", "float32")
+    y = _ref("y", "float32", (2, 3))
+    add_program = _program(
+        (a, s), (_op("add", (a, s), (y,)),), (y,)
+    )
+    mul_program = _program(
+        (s, a), (_op("mul", (s, a), (y,)),), (y,)
+    )
+    return {
+        "where_scalar_fill": (where_program, [2]),
+        "add_scalar_right": (add_program, [1]),
+        "mul_scalar_left": (mul_program, [0]),
+    }
+
