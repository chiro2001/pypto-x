+def test_gdr_prefill_decode_state_carry_scalar_vector_sve(tmp_path):
+    steps = 2
+    inputs = _small_inputs(steps)
+    expected_output, expected_state = _golden(inputs, steps, scale=0.75)
+    snapshots = [tuple(item.flat()) for item in inputs]
+    program = _small_program(steps)
+
+    scalar_output = HostTensor.zeros("bf16", (1, steps, 2, 2))
+    scalar_state = HostTensor.zeros("float32", (1, 2, 3, 2))
+    _launch(_compile_scalar(program), inputs, [scalar_output, scalar_state], CpuScalarRuntime(), scale=0.75)
+    _assert_close(scalar_output.flat(), HostTensor("bf16", scalar_output.shape, expected_output).flat())
+    _assert_close(scalar_state.flat(), expected_state, tolerance=2.0e-5)
+
+    vector_output = HostTensor.zeros("bf16", scalar_output.shape)
+    vector_state = HostTensor.zeros("float32", scalar_state.shape)
+    _launch(_compile_vector(program), inputs, [vector_output, vector_state], CpuVectorRuntime(), scale=0.75)
+    _assert_close(vector_output.flat(), scalar_output.flat())
+    _assert_close(vector_state.flat(), scalar_state.flat(), tolerance=2.0e-5)
+
+    sve_output = HostTensor.zeros("bf16", scalar_output.shape)
+    sve_state = HostTensor.zeros("float32", scalar_state.shape)
+    sve_artifact = _compile_sve(program, tmp_path / "prefill")
+    assert sve_artifact.metadata["batched_matmul_fallback"] == "host_batch_loop_rank2_runner"
+    _launch(
+        sve_artifact,
+        inputs,
+        [sve_output, sve_state],
+        Sve256Runtime(execution_mode="qemu"),
+        scale=0.75,
+    )
+    _assert_close(sve_output.flat(), scalar_output.flat())
+    _assert_close(sve_state.flat(), scalar_state.flat(), tolerance=2.0e-5)
+    assert [tuple(item.flat()) for item in inputs] == snapshots
+
+    # Two static T=1 graphs must equal one T=2 graph, including the explicit
+    # state carry.  This is the decode/prefill equivalence requirement.
+    decode_program = _small_program(1)
+    decode_artifact = _compile_scalar(decode_program)
+    decode_state = inputs[-1]
+    decode_outputs = []
+    for time_index in range(steps):
+        one_inputs = [
+            HostTensor("bf16", (1, 1, 2, 3), list(inputs[0].flat()[time_index * 6 : (time_index + 1) * 6])),
+            HostTensor("bf16", (1, 1, 2, 3), list(inputs[1].flat()[time_index * 6 : (time_index + 1) * 6])),
+            HostTensor("bf16", (1, 1, 2, 2), list(inputs[2].flat()[time_index * 4 : (time_index + 1) * 4])),
+            HostTensor("float32", (1, 1, 2), list(inputs[3].flat()[time_index * 2 : (time_index + 1) * 2])),
+            HostTensor("float32", (1, 1, 2), list(inputs[4].flat()[time_index * 2 : (time_index + 1) * 2])),
+            decode_state,
+        ]
+        one_output = HostTensor.zeros("bf16", (1, 1, 2, 2))
+        one_state = HostTensor.zeros("float32", (1, 2, 3, 2))
+        _launch(decode_artifact, one_inputs, [one_output, one_state], CpuScalarRuntime(), scale=0.75)
+        decode_outputs.extend(one_output.flat())
+        decode_state = one_state
+    _assert_close(decode_outputs, scalar_output.flat())
+    _assert_close(decode_state.flat(), scalar_state.flat(), tolerance=2.0e-5)
+
