+# ---------------------------------------------------------------------------
+# Gated DeltaNet recurrent matrix state
+# ---------------------------------------------------------------------------
+
+
+def _gdr_time_slice(
+    builder: _Builder,
+    value: ValueRef,
+    time_index: int,
+    output_shape: Tuple[int, ...],
+    prefix: str,
+) -> ValueRef:
+    """Select one static time row from a Qwen GDR input.
+
+    The recurrent reference intentionally uses static SSA unrolling.  A
+    ``slice`` therefore preserves the input buffer as read-only and makes the
+    decode and chunk paths use exactly the same graph construction.
+    """
+
+    return builder.op(
+        "slice",
+        (value,),
+        ((prefix, _tensor(value.type.dtype, output_shape)),),
+        {
+            "starts": [time_index],
+            "stops": [time_index + 1],
+            "axes": [1],
+            "steps": [1],
+        },
+    )[0]
+
+
+def _gdr_step(
+    builder: _Builder,
+    query: ValueRef,
+    key: ValueRef,
+    value: ValueRef,
+    gate: ValueRef,
+    beta: ValueRef,
+    state: ValueRef,
+    scale: ValueRef,
+    batch: int,
+    heads: int,
+    key_dim: int,
+    value_dim: int,
+    time_index: int,
+    prefix: str,
+) -> Tuple[ValueRef, ValueRef]:
+    """Append one sequential GDR recurrence step to ``builder``.
+
+    State uses the upstream Qwen layout ``[B, H, K, V]``.  The rank-4
+    matmuls below are deliberately ordinary Core ``matmul`` operations:
+
+    * ``k[1,K] @ state[K,V]`` predicts the value;
+    * ``(beta*k)[K,1] @ delta[1,V]`` is the rank-one update;
+    * ``q[1,K] @ new_state[K,V]`` emits the updated-state output.
+
+    All operands entering these operations are FP32, while the public q/k/v
+    contract remains BF16.  ``state`` is never mutated; each operation
+    creates the next SSA value.
+    """
+
+    row_q_shape = (batch, heads, 1, key_dim)
+    row_v_shape = (batch, heads, 1, value_dim)
+    gate_shape = (batch, heads, 1)
+    gate_4d_shape = (batch, heads, 1, 1)
+    state_shape = (batch, heads, key_dim, value_dim)
+    beta_k_shape = row_q_shape
+    beta_k_transposed_shape = (batch, heads, key_dim, 1)
+
+    # Inputs are [B,T,H,D] / [B,T,H].  Slice one time row and transpose to
+    # [B,H,1,D], so each rank-4 matmul has an exact equal batch prefix.
+    q_t = _gdr_time_slice(
+        builder, query, time_index, (batch, 1, heads, key_dim), prefix + "_q_slice"
+    )
+    k_t = _gdr_time_slice(
+        builder, key, time_index, (batch, 1, heads, key_dim), prefix + "_k_slice"
+    )
+    v_t = _gdr_time_slice(
+        builder, value, time_index, (batch, 1, heads, value_dim), prefix + "_v_slice"
+    )
+    g_t = _gdr_time_slice(
+        builder, gate, time_index, (batch, 1, heads), prefix + "_g_slice"
+    )
+    beta_t = _gdr_time_slice(
+        builder, beta, time_index, (batch, 1, heads), prefix + "_beta_slice"
+    )
+    q_t = builder.op(
+        "transpose",
+        (q_t,),
+        ((prefix + "_q", _tensor("bf16", row_q_shape)),),
+        {"permutation": [0, 2, 1, 3]},
+    )[0]
+    k_t = builder.op(
+        "transpose",
+        (k_t,),
+        ((prefix + "_k", _tensor("bf16", row_q_shape)),),
+        {"permutation": [0, 2, 1, 3]},
+    )[0]
+    v_t = builder.op(
+        "transpose",
+        (v_t,),
+        ((prefix + "_v", _tensor("bf16", row_v_shape)),),
+        {"permutation": [0, 2, 1, 3]},
+    )[0]
+    g_t = builder.op(
+        "transpose",
+        (g_t,),
+        ((prefix + "_g", _tensor("float32", gate_shape)),),
+        {"permutation": [0, 2, 1]},
+    )[0]
+    beta_t = builder.op(
+        "transpose",
+        (beta_t,),
+        ((prefix + "_beta", _tensor("float32", gate_shape)),),
+        {"permutation": [0, 2, 1]},
+    )[0]
+
+    q_f32 = _as_f32(builder, q_t, "bf16", prefix + "_q")
+    k_f32 = _as_f32(builder, k_t, "bf16", prefix + "_k")
+    v_f32 = _as_f32(builder, v_t, "bf16", prefix + "_v")
+    decay = builder.op(
+        "exp",
+        (g_t,),
+        ((prefix + "_decay", _tensor("float32", gate_shape)),),
+    )[0]
+    decay_4d = builder.op(
+        "reshape",
+        (decay,),
+        ((prefix + "_decay_4d", _tensor("float32", gate_4d_shape)),),
+        {"shape": list(gate_4d_shape)},
+    )[0]
+    decay_full = builder.op(
+        "broadcast",
+        (decay_4d,),
+        ((prefix + "_decay_full", _tensor("float32", state_shape)),),
+        {"shape": list(state_shape)},
+    )[0]
+    decayed_state = builder.op(
+        "mul",
+        (state, decay_full),
+        ((prefix + "_decayed_state", _tensor("float32", state_shape)),),
+    )[0]
+
+    predicted = builder.op(
+        "matmul",
+        (k_f32, decayed_state),
+        ((prefix + "_predicted", _tensor("float32", row_v_shape)),),
+    )[0]
+    delta = builder.op(
+        "sub",
+        (v_f32, predicted),
+        ((prefix + "_delta", _tensor("float32", row_v_shape)),),
+    )[0]
+    beta_4d = builder.op(
+        "reshape",
+        (beta_t,),
+        ((prefix + "_beta_4d", _tensor("float32", gate_4d_shape)),),
+        {"shape": list(gate_4d_shape)},
+    )[0]
+    beta_full = builder.op(
+        "broadcast",
+        (beta_4d,),
+        ((prefix + "_beta_full", _tensor("float32", beta_k_shape)),),
+        {"shape": list(beta_k_shape)},
+    )[0]
+    beta_key = builder.op(
+        "mul",
+        (k_f32, beta_full),
+        ((prefix + "_beta_key", _tensor("float32", beta_k_shape)),),
+    )[0]
+    beta_key_transposed = builder.op(
+        "transpose",
+        (beta_key,),
+        ((prefix + "_beta_key_t", _tensor("float32", beta_k_transposed_shape)),),
+        {"permutation": [0, 1, 3, 2]},
+    )[0]
+    update = builder.op(
+        "matmul",
+        (beta_key_transposed, delta),
+        ((prefix + "_update", _tensor("float32", state_shape)),),
+    )[0]
+    new_state = builder.op(
+        "add",
+        (decayed_state, update),
+        ((prefix + "_new_state", _tensor("float32", state_shape)),),
+    )[0]
+    output_f32 = builder.op(
+        "matmul",
+        (q_f32, new_state),
+        ((prefix + "_output_f32", _tensor("float32", row_v_shape)),),
+    )[0]
+    scaled = builder.op(
+        "mul",
+        (output_f32, scale),
+        ((prefix + "_scaled", _tensor("float32", row_v_shape)),),
+    )[0]
+    output_bf16 = builder.op(
+        "cast",
+        (scaled,),
+        ((prefix + "_output", _tensor("bf16", row_v_shape)),),
+        {"dtype": "bf16"},
+    )[0]
+    output_time = builder.op(
+        "transpose",
+        (output_bf16,),
+        ((prefix + "_output_time", _tensor("bf16", (batch, 1, heads, value_dim))),),
+        {"permutation": [0, 2, 1, 3]},
+    )[0]
+    return output_time, new_state
+
+
+def _build_gdr_recurrent_state(
+    batch: int,
+    steps: int,
+    heads: int,
+    key_dim: int,
+    value_dim: int,
+    *,
+    function_name: str,
+    composite: str,
+) -> CoreProgram:
+    """Internal static-unroll builder used by the fixed Qwen public wrapper."""
+
+    input_shape = (batch, steps, heads, key_dim)
+    gate_shape = (batch, steps, heads)
+    state_shape = (batch, heads, key_dim, value_dim)
+    builder = _Builder(function_name, composite, input_shape)
+    query = builder.parameter("query", _tensor("bf16", input_shape))
+    key = builder.parameter("key", _tensor("bf16", input_shape))
+    value = builder.parameter("value", _tensor("bf16", (batch, steps, heads, value_dim)))
+    gate = builder.parameter("gate", _tensor("float32", gate_shape))
+    beta = builder.parameter("beta", _tensor("float32", gate_shape))
+    prior_state = builder.parameter("prior_state", _tensor("float32", state_shape))
+    scale = builder.parameter("scale", _scalar("float32"))
+
+    state = prior_state
+    outputs = []
+    for time_index in range(steps):
+        output, state = _gdr_step(
+            builder,
+            query,
+            key,
+            value,
+            gate,
+            beta,
+            state,
+            scale,
+            batch,
+            heads,
+            key_dim,
+            value_dim,
+            time_index,
+            "step_{}".format(time_index),
+        )
+        outputs.append(output)
+
+    if len(outputs) == 1:
+        output = outputs[0]
+    else:
+        output = builder.op(
+            "concat",
+            tuple(outputs),
+            (("output_concat", _tensor("bf16", (batch, steps, heads, value_dim))),),
+            {"axis": 1},
+        )[0]
+    output = builder.op(
+        "identity",
+        (output,),
+        (("output", _tensor("bf16", (batch, steps, heads, value_dim))),),
+    )[0]
+    new_state = builder.op(
+        "identity",
+        (state,),
+        (("new_state", _tensor("float32", state_shape)),),
+    )[0]
+    return builder.finish(
+        (output, new_state),
+        {
+            "formula": "S_t=exp(g_t)*S_(t-1)+(beta_t*k_t) outer (v_t-k_t^T*(exp(g_t)*S_(t-1))); o_t=scale*q_t^T*S_t",
+            "state_layout": "[B,H,K,V] with K before V",
+            "state_layout_axes": ["batch", "value_head", "key_dim", "value_dim"],
+            "state_input_dtype": "float32",
+            "state_output_dtype": "float32",
+            "qkv_input_dtype": "bf16",
+            "gate_dtype": "float32",
+            "beta_dtype": "float32",
+            "gate_semantics": "log_space_increment; exp applied once per token",
+            "beta_semantics": "post_sigmoid_delta_scale",
+            "qk_contract": "q_and_k_are_l2_normalized_by_upstream",
+            "scale_semantics": "runtime_float32_scalar_applied_after_updated_state_matmul",
+            "state_semantics": "functional_pure_ssa_output",
+            "prefill_decode_shared_graph": True,
+            "unroll": "static_sequential_reference",
+            "chunk_mode": "sequential_correctness_reference; no_fused_chunk_or_wy_inverse",
+            "matmul_contract": "rank4_equal_prefix_batched_matmul",
+            "sve_batched_matmul": "host_batch_loop_rank2_runner",
+            "avx2_avx512_batched_matmul": "explicit_rejection",
+            "accumulation_dtype": "float32",
+            "fixed_qwen_shape": {
+                "heads": 16,
+                "key_dim": 128,
+                "value_dim": 128,
+            },
+            "fallbacks": [
+                "primitive_composition_not_fused",
+                "static_time_unroll",
+                "sve_batched_matmul_host_batch_loop_rank2_runner",
+                "avx2_avx512_batched_matmul_explicit_rejection",
+                "scalar_math_lane_fallback:exp",
+                "host_broadcast_pre_expansion",
+                "python_list_wire_staging",
+            ],
+        },
+    )
+
+
+def build_qwen35_gdr_recurrent_state(
+    batch: int,
+    steps: int,
+    dtype: str = "bf16",
+    output_dtype: Optional[str] = None,
+) -> CoreProgram:
+    """Build Qwen3.5-0.8B's fixed BF16 GDR recurrent matrix transition.
+
+    Public shapes are intentionally fixed to the Qwen linear-attention
+    contract: q/k/v ``[B,T,16,128]``, gate/beta ``[B,T,16]``, and state
+    ``[B,16,128,128]``.  ``scale`` is an explicit FP32 scalar LaunchRequest
+    input (the model normally supplies ``128**-0.5``).  Both ``T=1`` decode
+    and ``T>1`` prefill/chunk use the same static sequential SSA graph.
+    """
+
+    if isinstance(batch, bool) or not isinstance(batch, int) or batch <= 0:
+        raise ValueError("batch must be a positive integer")
+    if isinstance(steps, bool) or not isinstance(steps, int) or steps <= 0:
+        raise ValueError("steps must be a positive integer")
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    if dtype != "bf16" or output_dtype != "bf16":
+        raise ValueError("Qwen3.5 GDR recurrent state requires BF16 q/k/v and BF16 output")
+    return _build_gdr_recurrent_state(
+        batch,
+        steps,
+        QWEN35_08B_SHAPE_METADATA["linear_num_value_heads"],
+        QWEN35_08B_SHAPE_METADATA["linear_key_head_dim"],
+        QWEN35_08B_SHAPE_METADATA["linear_value_head_dim"],
+        function_name="qwen35_gdr_recurrent_state",
+        composite="gdr_recurrent_state",
+    )
+
+
+# Descriptive short spelling for callers that use the operator name rather
+# than the model-prefixed name.  The public Qwen wrapper remains fixed-shape.
+build_gated_delta_recurrent_state = build_qwen35_gdr_recurrent_state
+build_qwen35_gated_delta_recurrent_state = build_qwen35_gdr_recurrent_state
+
+
 # Short spelling kept for callers that do not need the model prefix.
 build_attention_kv_cache = build_qwen35_attention_kv_cache
 
@@ -1473,8 +1830,11 @@ __all__ = [
     "build_causal_conv1d_state",
     "build_decoder_subgraph",
