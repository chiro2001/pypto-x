diff --git a/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py b/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py
new file mode 100644
index 000000000..ed3823728
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_qwen35_sve256_gdr_state.py
@@ -0,0 +1,378 @@
+"""Qwen3.5 M1G functional Gated DeltaNet recurrent-state closure.
+
+The public builder is fixed to the Qwen3.5-0.8B linear-attention contract
+(``H=16, K=V=128``).  The tests use the private small-shape construction
+helper for scalar/vector/SVE differential execution so that correctness tests
+remain bounded; a fixed-shape SVE decode is also executed and a fixed-shape
+chunk is compiled.  All tensors are synthetic and no model weights are read.
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Iterable, List, Sequence, Tuple
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.backends.cpu.aarch64.sve256 import Sve256Runtime
+from pypto.backends.cpu.vector import CpuVectorRuntime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.compiler.targets.cpu_vector import CpuVectorCompiler
+from pypto.core_ir import CoreProgram
+from pypto.portable.qwen35 import (
+    QWEN35_08B_SHAPE_METADATA,
+    _build_gdr_recurrent_state,
+    build_qwen35_gdr_recurrent_state,
+)
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+VECTOR_TARGET = TargetSpec(
+    "cpu",
+    "x86_64-linux-gnu",
+    attributes={"lane_count": 4, "specialization": {"compact_iteration": True}},
+)
+SVE_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2"),
+    attributes={"vl_bytes": 32},
+)
+
+
+def _count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+def _small_program(steps: int = 2) -> CoreProgram:
+    return _build_gdr_recurrent_state(
+        1,
+        steps,
+        2,
+        3,
+        2,
+        function_name="test_qwen35_gdr_recurrent_state",
+        composite="test_gdr_recurrent_state",
+    )
+
+
+def _small_inputs(steps: int = 2):
+    # Values are intentionally asymmetric across heads and time so that a
+    # wrong transpose, state axis, or token ordering cannot pass by symmetry.
+    q = HostTensor(
+        "bf16",
+        (1, steps, 2, 3),
+        [
+            0.10,
+            0.20,
+            0.30,
+            0.40,
+            0.50,
+            0.60,
+            0.70,
+            0.80,
+            0.90,
+            1.00,
+            1.10,
+            1.20,
+        ][: steps * 2 * 3],
+    )
+    k = HostTensor(
+        "bf16",
+        (1, steps, 2, 3),
+        [
+            0.20,
+            0.10,
+            0.40,
+            0.30,
+            0.60,
+            0.50,
+            0.80,
+            0.70,
+            1.00,
+            0.90,
+            1.20,
+            1.10,
+        ][: steps * 2 * 3],
+    )
+    v = HostTensor(
+        "bf16",
+        (1, steps, 2, 2),
+        [
+            1.00,
+            2.00,
+            3.00,
+            4.00,
+            5.00,
+            6.00,
+            7.00,
+            8.00,
+        ][: steps * 2 * 2],
+    )
+    gate = HostTensor(
+        "float32",
+        (1, steps, 2),
+        [-0.10, -0.20, -0.30, -0.40][: steps * 2],
+    )
+    beta = HostTensor(
+        "float32",
+        (1, steps, 2),
+        [0.50, 0.60, 0.70, 0.80][: steps * 2],
+    )
+    prior = HostTensor(
+        "float32",
+        (1, 2, 3, 2),
+        [0.25, -0.50, 1.00, -1.50, 2.00, -2.50, 3.00, -3.50, 4.00, -4.50, 5.00, -5.50],
+    )
+    return [q, k, v, gate, beta, prior]
+
+
+def _golden(inputs, steps: int, scale: float) -> Tuple[List[float], List[float]]:
+    query, key, value, gate, beta, prior = inputs
+    q_values = query.flat()
+    k_values = key.flat()
+    v_values = value.flat()
+    g_values = gate.flat()
+    beta_values = beta.flat()
+    state_values = [float(item) for item in prior.flat()]
+    output: List[float] = []
+    heads, key_dim, value_dim = 2, 3, 2
+    for time_index in range(steps):
+        for head in range(heads):
+            gate_index = time_index * heads + head
+            decay = math.exp(float(g_values[gate_index]))
+            for key_index in range(key_dim):
+                for value_index in range(value_dim):
+                    state_index = (head * key_dim + key_index) * value_dim + value_index
+                    state_values[state_index] *= decay
+
+            predicted = []
+            for value_index in range(value_dim):
+                predicted.append(
+                    sum(
+                        float(k_values[(time_index * heads + head) * key_dim + key_index])
+                        * state_values[(head * key_dim + key_index) * value_dim + value_index]
+                        for key_index in range(key_dim)
+                    )
+                )
+            delta = [
+                float(v_values[(time_index * heads + head) * value_dim + value_index]) - predicted[value_index]
+                for value_index in range(value_dim)
+            ]
+            beta_value = float(beta_values[gate_index])
+            for key_index in range(key_dim):
+                key_value = float(k_values[(time_index * heads + head) * key_dim + key_index])
+                for value_index in range(value_dim):
+                    state_index = (head * key_dim + key_index) * value_dim + value_index
+                    state_values[state_index] += beta_value * key_value * delta[value_index]
+
+            for value_index in range(value_dim):
+                output.append(
+                    scale
+                    * sum(
+                        float(q_values[(time_index * heads + head) * key_dim + key_index])
+                        * state_values[(head * key_dim + key_index) * value_dim + value_index]
+                        for key_index in range(key_dim)
+                    )
+                )
+    return output, state_values
+
+
+def _compile_scalar(program: CoreProgram):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _compile_vector(program: CoreProgram):
+    compiler = CpuVectorCompiler()
+    return compiler.compile(compiler.lower(program, VECTOR_TARGET))
+
+
+def _compile_sve(program: CoreProgram, tmp_path: Path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE_TARGET)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+
+
+def _launch(artifact, inputs, outputs, runtime, scale: float = 1.0):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+            scalars={"scale": scale},
+        )
+    )
+
+
+def _assert_close(actual: Iterable[float], expected: Iterable[float], tolerance: float = 0.04):
+    actual = list(actual)
+    expected = list(expected)
+    assert len(actual) == len(expected)
+    for left, right in zip(actual, expected):
+        assert math.isclose(float(left), float(right), rel_tol=tolerance, abs_tol=tolerance), (left, right)
+
+
+def test_gdr_contract_is_fixed_and_functional_ssa():
+    program = build_qwen35_gdr_recurrent_state(1, 1)
+    function = program.functions[0]
+    assert [ref.name for ref in function.returns] == ["output", "new_state"]
+    assert [ref.type.shape for ref in function.returns] == [(1, 1, 16, 128), (1, 16, 128, 128)]
+    assert [ref.type.dtype for ref in function.returns] == ["bf16", "float32"]
+    assert program.metadata["state_layout"] == "[B,H,K,V] with K before V"
+    assert program.metadata["state_semantics"] == "functional_pure_ssa_output"
+    assert program.metadata["prefill_decode_shared_graph"] is True
+    assert program.metadata["chunk_mode"].startswith("sequential_correctness_reference")
+    assert program.metadata["avx2_avx512_batched_matmul"] == "explicit_rejection"
+    assert "gdr_recurrent_state" not in {operation.name for operation in function.body.operations}
+
+    with pytest.raises(ValueError, match="positive integer"):
+        build_qwen35_gdr_recurrent_state(0, 1)
+    with pytest.raises(ValueError, match="positive integer"):
+        build_qwen35_gdr_recurrent_state(1, 0)
+    with pytest.raises(ValueError, match="requires BF16"):
+        build_qwen35_gdr_recurrent_state(1, 1, dtype="float32")
+
