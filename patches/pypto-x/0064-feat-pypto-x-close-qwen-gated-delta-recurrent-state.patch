+def test_gdr_fixed_qwen_decode_executes_and_chunk_compiles_sve(tmp_path):
+    decode = build_qwen35_gdr_recurrent_state(1, 1)
+    assert decode.functions[0].parameters[0].type.shape == (1, 1, 16, 128)
+    assert decode.functions[0].parameters[5].type.shape == (1, 16, 128, 128)
+    zero_qkv = [HostTensor.zeros("bf16", (1, 1, 16, 128)) for _ in range(3)]
+    gate = HostTensor.zeros("float32", (1, 1, 16))
+    beta = HostTensor.zeros("float32", (1, 1, 16))
+    prior = HostTensor.zeros("float32", (1, 16, 128, 128))
+    output = HostTensor.zeros("bf16", (1, 1, 16, 128))
+    state = HostTensor.zeros("float32", (1, 16, 128, 128))
+    artifact = _compile_sve(decode, tmp_path / "fixed_decode")
+    _launch(
+        artifact,
+        zero_qkv + [gate, beta, prior],
+        [output, state],
+        Sve256Runtime(execution_mode="qemu"),
+        scale=1.0 / math.sqrt(128.0),
+    )
+    assert all(float(value) == 0.0 for value in output.flat())
+    assert all(float(value) == 0.0 for value in state.flat())
+
+    chunk = build_qwen35_gdr_recurrent_state(1, 2)
+    chunk_ir = Sve256Compiler().lower(chunk, SVE_TARGET)
+    assert all(plan.iteration.compact for plan in chunk_ir.plans)
+    _compile_sve(chunk, tmp_path / "fixed_chunk")
+
