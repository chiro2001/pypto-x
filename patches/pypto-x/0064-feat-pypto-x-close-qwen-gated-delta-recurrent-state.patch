+def test_gdr_zero_decay_and_zero_beta_are_identity_state_update():
+    program = _small_program(1)
+    inputs = _small_inputs(1)
+    # Keep state nonzero while exp(g)=1 and beta=0: state must be carried
+    # exactly and output must be q @ prior_state times scale.
+    inputs[3] = HostTensor("float32", (1, 1, 2), [0.0, 0.0])
+    inputs[4] = HostTensor("float32", (1, 1, 2), [0.0, 0.0])
+    output = HostTensor.zeros("bf16", (1, 1, 2, 2))
+    state = HostTensor.zeros("float32", (1, 2, 3, 2))
+    _launch(_compile_scalar(program), inputs, [output, state], CpuScalarRuntime(), scale=1.0)
+    assert state.flat() == inputs[-1].flat()
+    expected = []
+    for head in range(2):
+        for value_index in range(2):
+            expected.append(
+                sum(
+                    float(inputs[0].flat()[head * 3 + key_index])
+                    * float(inputs[-1].flat()[(head * 3 + key_index) * 2 + value_index])
+                    for key_index in range(3)
+                )
+            )
+    _assert_close(output.flat(), HostTensor("bf16", output.shape, expected).flat())
+
