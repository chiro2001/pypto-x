+def test_gdr_runtime_rejects_state_shape_and_dtype():
+    program = _small_program(1)
+    artifact = _compile_scalar(program)
+    inputs = _small_inputs(1)
+    output = HostTensor.zeros("bf16", (1, 1, 2, 2))
+    bad_shape = HostTensor.zeros("float32", (1, 2, 3, 1))
+    with pytest.raises(Exception, match="descriptor dtype/shape"):
+        _launch(artifact, inputs[:-1] + [bad_shape], [output, HostTensor.zeros("float32", (1, 2, 3, 2))], CpuScalarRuntime())
+    bad_dtype = HostTensor.zeros("bf16", (1, 2, 3, 2))
+    with pytest.raises(Exception, match="descriptor dtype/shape"):
+        _launch(artifact, inputs[:-1] + [bad_dtype], [output, HostTensor.zeros("float32", (1, 2, 3, 2))], CpuScalarRuntime())
