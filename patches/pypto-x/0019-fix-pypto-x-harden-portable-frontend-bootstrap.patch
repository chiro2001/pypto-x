     result["differential_passed"] = report.passed
+    result["differential_reference_dtype"] = report.reference_dtype
+    result["differential_actual_dtype"] = report.actual_dtype
 except BaseException as exc:
     result["failure"] = "{}: {}".format(type(exc).__name__, exc)
 
@@ -211,14 +223,22 @@ def test_portable_subprocess_bootstraps_public_modules_without_native_dependenci
     assert result["returncode"] == 0, result
     assert result.get("failure") is None, result
     assert result["portable_marker"] is True
