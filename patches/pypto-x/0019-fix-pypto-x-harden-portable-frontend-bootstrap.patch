Subject: [PATCH 019/235] fix(pypto-x): harden portable frontend bootstrap

---
 python/pypto/__init__.py                           |  2 ++
 python/pypto/frontend/__init__.py                  | 16 ++++++++++------
 python/tests/ut/pypto_x/test_portable_bootstrap.py | 24 ++++++++++++++++++++++--
 3 files changed, 34 insertions(+), 8 deletions(-)

diff --git a/python/pypto/__init__.py b/python/pypto/__init__.py
index 2f415d620..8a6e829f3 100644
--- a/python/pypto/__init__.py
+++ b/python/pypto/__init__.py
@@ -37,6 +37,8 @@ if _os.environ.get("PYPTO_X_PORTABLE_ONLY") == "1":
             "Function",
             "jit",
             "from_torch",
+            "DT_FP32",
+            "DT_BF16",
         }:
             raise RuntimeError(_PORTABLE_ONLY_ERROR)
         raise AttributeError("module 'pypto' has no attribute {!r}".format(name))
diff --git a/python/pypto/frontend/__init__.py b/python/pypto/frontend/__init__.py
index bc7420599..b4466986a 100644
--- a/python/pypto/frontend/__init__.py
+++ b/python/pypto/frontend/__init__.py
@@ -64,10 +64,14 @@ parser.entry : Entry points and wrapper classes
 parser.parser : Main parser implementation
 """
 
-import os as _os
+import sys as _sys
 
 
-if _os.environ.get("PYPTO_X_PORTABLE_ONLY") == "1":
+_PORTABLE_ONLY = bool(getattr(_sys.modules.get("pypto"), "__portable_only__", False))
+del _sys
+
+
+if _PORTABLE_ONLY:
     # Do not import ``parser`` or ``symbolic_scalar``: both belong to the
     # classic native Tensor frontend and may pull in CANN dependencies.
     __portable_only__ = True
@@ -90,11 +94,11 @@ else:
 
 
     def dynamic(name: str) -> SymbolicScalar:
-        """Create a dynamic (symbolic) dimension for dynamic tensor shapes.
+        """Create a dynamic (symbolic) dimension for tensor shapes.
 
         This function creates a symbolic scalar that can be used to define
-        dynamic dimensions in tensor shapes. The symbolic scalar represents a
-        runtime value that is not known at compile time and will be bound
+        dynamic dimensions in tensor shapes. The symbolic scalar represents
+        a runtime value that is not known at compile time and will be bound
         to concrete values when the kernel is first invoked.
 
         Dynamic dimensions enable writing kernels that work with variable-sized
@@ -140,4 +144,4 @@ else:
         return SymbolicScalar(name)
 
 
-del _os
+del _PORTABLE_ONLY
