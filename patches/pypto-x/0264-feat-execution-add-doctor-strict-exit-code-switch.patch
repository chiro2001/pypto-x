From 7378aa9434e08130c30400d4972a9864bc0a723d Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sun, 13 Sep 2026 12:26:20 +0800
Subject: [PATCH 264/274] feat(execution): add doctor --strict exit-code switch

task=u3-discovery
follow-up to f742ad840:

- doctor stays a fact report by default: exit 0 even when fail_closed=true,
  with the conditions listed in fail_closed_checks/summary;
- --strict exits 2 when fail_closed=true (report still printed/parseable),
  documented in --help;
- regression: injected missing-pin snapshot -> default rc=0, --strict rc=2.
---
 python/pypto/execution/cli.py                       | 13 ++++++++++++-
 python/tests/ut/pypto_x/test_execution_discovery.py | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/python/pypto/execution/cli.py b/python/pypto/execution/cli.py
index 87697bdf5..d562e5d4a 100644
--- a/python/pypto/execution/cli.py
+++ b/python/pypto/execution/cli.py
@@ -2,7 +2,7 @@
 
 Supported entry points::
 
-    python -m pypto.execution.cli doctor [--json]
+    python -m pypto.execution.cli doctor [--json] [--strict]
     python -m pypto.execution.cli explain --op matmul --left 2,3 --right 3,4 \
         --dtype float32 [--policy policy.json] [--snapshot snapshot.json] [--json]
     python -m pypto.execution.cli explain --plan plan.json [--json]
@@ -19,6 +19,10 @@ All three commands are read-only with respect to execution state: ``doctor``
 probes only pinned artifacts, ``explain`` and ``plan`` never execute a
 provider.  Structured failures exit with status 1 and print the
 ``ExecutionError.to_dict()`` payload under ``--json``.
+
+``doctor`` always reports the fail-closed conditions and exits 0 by
+default (a missing optional pinned artifact is a fact, not a usage error).
+With ``--strict`` it exits 2 when the report carries ``fail_closed=true``.
 """
 
 from __future__ import annotations
@@ -71,6 +75,11 @@ def build_parser() -> argparse.ArgumentParser:
 
     doctor_cmd = sub.add_parser("doctor", parents=[common], help="report host, contract, provider and pin facts")
     doctor_cmd.add_argument("--snapshot", default=None, help="report on an imported capability snapshot instead of the local probe")
+    doctor_cmd.add_argument(
+        "--strict",
+        action="store_true",
+        help="exit with status 2 when the report has fail_closed=true (default: exit 0, report only)",
+    )
 
     explain_cmd = sub.add_parser("explain", parents=[common], help="explain the resolver decision")
     source = explain_cmd.add_mutually_exclusive_group()
@@ -178,6 +187,8 @@ def main(argv: Optional[Sequence[str]] = None) -> int:
         if command == "doctor":
             report = doctor(capability=_load_snapshot(getattr(args, "snapshot", None)))
             _print_document(report.to_dict(), report.summary, as_json)
+            if getattr(args, "strict", False) and report.fail_closed:
+                return 2
             return 0
         if command == "explain":
             policy = _load_policy(getattr(args, "policy", None))
diff --git a/python/tests/ut/pypto_x/test_execution_discovery.py b/python/tests/ut/pypto_x/test_execution_discovery.py
index 1072d96f3..dd0ca8a0c 100644
--- a/python/tests/ut/pypto_x/test_execution_discovery.py
+++ b/python/tests/ut/pypto_x/test_execution_discovery.py
@@ -570,6 +570,39 @@ def test_cli_fails_closed_with_structured_error(tmp_path):
     assert error["code"] == ARTIFACT_MISMATCH
 
 
+def test_cli_doctor_strict_exit_code_for_fail_closed_reports(tmp_path):
+    host = _host_snapshot()
+    injected = _replace_provider(
+        host,
+        AOCL_LPGEMM_BF16_PROVIDER_ID,
+        available=False,
+        reason="library_not_found",
+        library=dict(host.provider(AOCL_LPGEMM_BF16_PROVIDER_ID).library),
+    )
+    snapshot_path = tmp_path / "snapshot.json"
+    snapshot_path.write_text(json.dumps(export_capability_snapshot(injected)), encoding="utf-8")
+
+    # Default: doctor is a fact report, so a fail-closed condition exits 0.
+    default = _run_cli("doctor", "--snapshot", str(snapshot_path), "--json", cwd=tmp_path)
+    assert default.returncode == 0, default.stderr
+    default_document = json.loads(default.stdout)
+    assert default_document["fail_closed"] is True
+
+    # --strict promotes a fail-closed report to exit status 2.
+    strict = _run_cli(
+        "doctor", "--snapshot", str(snapshot_path), "--strict", "--json", cwd=tmp_path
+    )
+    assert strict.returncode == 2, strict.stderr
+    strict_document = json.loads(strict.stdout)
+    assert strict_document["fail_closed"] is True
+    assert strict_document["digest"] == default_document["digest"]
+
+    help_result = _run_cli("doctor", "--help", cwd=tmp_path)
+    assert help_result.returncode == 0
+    assert "fail_closed" in help_result.stdout
+    assert "status 2" in help_result.stdout
+
+
