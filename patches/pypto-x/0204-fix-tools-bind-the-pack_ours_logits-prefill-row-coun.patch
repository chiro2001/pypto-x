From 2ad9bf04f33b83970c45b3c8dd4d4576aaf47606 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 04:26:33 +0800
Subject: [PATCH 204/256] fix(tools): bind the pack_ours_logits prefill row
 count from the arrays dict
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The final per-prompt print referenced a bare ``logits`` that no longer
exists in that scope (the npz context managers are closed and the data was
copied into ``arrays``), so the script raised NameError at the end of the
first prompt after it had already written that prompt's files.

Bind the count from ``arrays["logits"].shape[0]`` — the same array that was
just saved — and leave the rest of the diagnostic line untouched.
Negative control: running the pre-fix file on a synthetic three-row prefill
raises NameError; the fixed file exits 0 and reports prefill_rows=3.
---
 tools/c8_sve256_a3/pack_ours_logits.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/c8_sve256_a3/pack_ours_logits.py b/tools/c8_sve256_a3/pack_ours_logits.py
index fb0a5e424..c3df607df 100755
--- a/tools/c8_sve256_a3/pack_ours_logits.py
+++ b/tools/c8_sve256_a3/pack_ours_logits.py
@@ -63,7 +63,7 @@ def main() -> int:
             total += decode_target.stat().st_size
             count += 1
         print("[pack] {} prefill_rows={} decode_rows={} bytes={}".format(
-            prompt, logits.shape[0], count, target.stat().st_size))
+            prompt, arrays["logits"].shape[0], count, target.stat().st_size))
     print("[pack] total_bytes={} (out={})".format(total, out))
     return 0
 
