+def _old_vector_v1_artifact(artifact):
+    """Construct a serialized pre-M1F vector artifact for rejection tests."""
+
+    envelope = json.loads(artifact.payload.decode("utf-8"))
+    envelope["plan_version"] = 1
+    envelope["vector_plan"]["plan_version"] = 1
+    for plan in envelope["vector_plan"].get("plans", ()):
+        matmul = plan.get("matmul")
+        if isinstance(matmul, dict):
+            matmul.pop("batch_shape", None)
+    payload = json.dumps(
+        envelope,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    metadata = dict(artifact.metadata)
+    metadata["plan_version"] = 1
+    metadata["payload_digest"] = hashlib.sha256(payload).hexdigest()
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=payload,
+        metadata=metadata,
+    )
+
