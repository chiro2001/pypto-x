diff --git a/python/tests/framework_torch/test_torch_linear_correctness.py b/python/tests/framework_torch/test_torch_linear_correctness.py
index 354e04123..7bd818713 100644
--- a/python/tests/framework_torch/test_torch_linear_correctness.py
+++ b/python/tests/framework_torch/test_torch_linear_correctness.py
@@ -329,16 +329,17 @@ def test_pack_weight_uses_the_native_tile_layout(fresh_caches, monkeypatch):
     for nb in range(num_nb):
         for kb in range(num_kb):
             block = reference[(nb * num_kb + kb) * 64 * 64 : (nb * num_kb + kb + 1) * 64 * 64]
-            block = block.reshape(64, 64)
-            for kk in range(64):
-                kk_global = kb * 64 + kk
-                if kk_global >= k:
-                    break
-                for nn in range(64):
-                    nn_global = nb * 64 + nn
-                    if nn_global >= n:
-                        break
-                    block[kk, nn] = bits[nn_global, kk_global]
+            nt = min(64, n - nb * 64)
+            kt = min(64, k - kb * 64)
+            # bf16 blocks interleave k pairs for _mm512_dpbf16_ps: the 32-bit
+            # group (2*nn, 2*nn+1) holds W[nn, k_even] / W[nn, k_odd].
+            for pair in range(32):
+                k_even, k_odd = 2 * pair, 2 * pair + 1
+                for nn in range(nt):
+                    if k_even < kt:
+                        block[pair * 128 + 2 * nn] = bits[nb * 64 + nn, kb * 64 + k_even]
+                    if k_odd < kt:
+                        block[pair * 128 + 2 * nn + 1] = bits[nb * 64 + nn, kb * 64 + k_odd]
     assert np.array_equal(parsed.payload, reference)
     # The tile payload is padded to whole 64x64 blocks, so it cannot be the
     # plain (K, N) transpose J1 stored (17 * 130 = 2210 vs 3 * 64 * 64).
