+def _require_type(data: Mapping[str, Any], path: str, types: Any, allow_none: bool = False) -> Any:
+    value = _walk(data, path)
+    if value is None and allow_none:
+        return None
+    bool_mismatch = isinstance(value, bool) and types is not bool
+    if bool_mismatch or not isinstance(value, types):
+        raise ArtifactMismatchError(
+            "execution plan field {!r} has the wrong type".format(path),
+            field="plan." + path,
+            requested=type(value).__name__,
+            available=[item.__name__ if hasattr(item, "__name__") else str(item) for item in types]
+            if isinstance(types, tuple)
+            else [getattr(types, "__name__", str(types))],
+            reason="plan_field_wrong_type",
+        )
+    return value
+
+
+def _require_string(data: Mapping[str, Any], path: str) -> str:
+    value = _require_type(data, path, str)
+    if not value.strip():
+        raise ArtifactMismatchError(
+            "execution plan field {!r} must not be empty".format(path),
+            field="plan." + path,
+            requested=value,
+            reason="plan_field_empty",
+        )
+    return value
+
+
+def _require_sha256(data: Mapping[str, Any], path: str, allow_none: bool = False) -> Any:
+    value = _walk(data, path)
+    if value is None and allow_none:
+        return None
+    if not isinstance(value, str) or not value.startswith("sha256:"):
+        raise ArtifactMismatchError(
+            "execution plan field {!r} must be a sha256: string".format(path),
+            field="plan." + path,
+            requested=value,
+            reason="plan_digest_field_invalid",
+        )
+    return value
+
+
+def _require_shape(data: Mapping[str, Any], path: str) -> None:
+    value = _walk(data, path)
+    if not isinstance(value, list):
+        raise ArtifactMismatchError(
+            "execution plan field {!r} must be a list of static dimensions".format(path),
+            field="plan." + path,
+            requested=value,
+            reason="plan_shape_field_invalid",
+        )
+    for index, dimension in enumerate(value):
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise ArtifactMismatchError(
+                "execution plan field {!r}[{}] must be a non-negative integer".format(path, index),
+                field="plan.{}.{}".format(path, index),
+                requested=dimension,
+                reason="plan_shape_field_invalid",
+            )
+
