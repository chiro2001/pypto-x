+def test_policy_from_dict_requires_the_registered_schema_version():
+    document = ExecutionPolicy().to_dict()
+    for broken in (999, 1.5, "1", True, None):
+        candidate = dict(document)
+        if broken is None:
+            candidate.pop("schema_version", None)
+        else:
+            candidate["schema_version"] = broken
+        details = _assert_failure(
+            POLICY_INVALID_VALUE,
+            lambda candidate=candidate: policy_from_dict(candidate),
+        )
+        assert details["field"] == "schema_version"
+        assert details["available"] == 1
+    assert policy_from_dict(document).digest == ExecutionPolicy().digest
+
