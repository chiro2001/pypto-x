+def test_output_must_not_alias_input_storage():
+    left = HostTensor("float32", (2, 2), [1, 2, 3, 4])
+    right = HostTensor("float32", (2, 2), [1, 0, 0, 1])
+    for label, target in (("left", left), ("right", right)):
+        details = _assert_failure(
+            OP_CONTRACT_INVALID,
+            lambda target=target: execute_matmul(
+                left, right, ExecutionPolicy.portable(), output=target
+            ),
+        )
+        assert details["reason"] == "output_input_alias"
+        assert details["requested"]["alias"] == label
+    assert left.tolist() == [[1.0, 2.0], [3.0, 4.0]]
+
+    shared = HostTensor("float32", (2, 2), [9, 9, 9, 9])
+    shared.data = left.data
+    details = _assert_failure(
+        OP_CONTRACT_INVALID,
+        lambda: execute_matmul(left, right, ExecutionPolicy.portable(), output=shared),
+    )
+    assert details["reason"] == "output_input_alias"
+    assert details["requested"]["same_storage"] is True
