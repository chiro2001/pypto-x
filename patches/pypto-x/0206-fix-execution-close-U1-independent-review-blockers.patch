+def test_fabricated_targets_never_execute_and_leave_output_untouched():
+    left = _tensor("float32", (2, 2), seed=1)
+    right = _tensor("float32", (2, 2), seed=2)
+    for target in ("aarch64-linux-gnu", "cuda-linux", "riscv64-unknown"):
+        output = HostTensor("float32", (2, 2), [9, 9, 9, 9])
+        details = _assert_failure(
+            CAPABILITY_UNAVAILABLE,
+            lambda target=target: execute_matmul(
+                left, right, ExecutionPolicy(target=target), output=output
+            ),
+        )
+        assert details["reason"] == "target_not_available_on_host"
+        assert output.tolist() == [[9.0, 9.0], [9.0, 9.0]]
+        assert left.tolist() == _tensor("float32", (2, 2), seed=1).tolist()
+
+    output, report = execute_matmul(left, right, ExecutionPolicy(target=host_triple()))
+    payload = report.to_dict()
+    assert payload["resolved"]["target"]["triple"] == host_triple()
+    assert payload["capability"]["triple"] == host_triple()
+
