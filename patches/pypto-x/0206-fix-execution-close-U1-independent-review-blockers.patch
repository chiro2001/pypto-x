+    _require_type(fallback, "mode", str)
+    chain = _require_type(fallback, "chain", list)
+    if not chain or not all(isinstance(item, str) and item for item in chain):
+        raise ArtifactMismatchError(
+            "execution plan fallback.chain must be a non-empty list of provider ids",
+            field="plan.fallback.chain",
+            requested=chain,
+            reason="plan_fallback_chain_invalid",
+        )
+    if chain[0] != _walk(data, "selected.provider"):
+        raise ArtifactMismatchError(
+            "execution plan fallback.chain must start with the selected provider",
+            field="plan.fallback.chain",
+            requested=chain,
+            available=_walk(data, "selected.provider"),
+            reason="plan_fallback_chain_invalid",
+        )
+    _require_type(fallback, "events", list)
+    _require_type(fallback, "degraded", bool)
+    _require_type(data, "resolution.rules", list)
+    _require_type(data, "resolution.tie_break", list)
