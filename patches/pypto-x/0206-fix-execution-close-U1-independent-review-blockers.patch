+def _verify_artifact_declaration(plan: ExecutionPlan, definition: Any, artifact: Any, provider: Any) -> None:
+    declared = plan.artifact_versions
+    actual = {
+        "contract_version": definition.contract_version,
+        "lowering_version": int(artifact.metadata["lowering_version"]),
+        "runner_version": int(provider.runner_version),
+        "wire_version": int(artifact.metadata["artifact_payload_version"]),
+        "provider_version": provider.version,
