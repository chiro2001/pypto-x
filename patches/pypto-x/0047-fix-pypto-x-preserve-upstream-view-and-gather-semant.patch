+@pytest.mark.parametrize(
+    ("callee", "operation_name"),
+    (
+        (_wrapped_upstream_view, "pypto.operation.view"),
+        (_wrapped_upstream_gather, "pypto.op.indexing.gather"),
+    ),
+)
+def test_m1b_does_not_reinterpret_incompatible_upstream_operations(callee, operation_name):
+    result = FakeValue(1, CoreType.tensor("DT_FP32", (2,)))
+    body = FakeBlock(id=0, args=(), calls=[FakeCall(result, callee)], result=result, jump="RETURN")
+    program = BRIDGE.export_pil_function(FakeFunction("incompatible", body))
+    operation = program.functions[0].body.operations[0]
+    assert operation.name == operation_name
+    assert operation.effect is Effect.READ_WRITE
+    assert any(item["kind"] == "unknown_effect" for item in program.metadata["diagnostics"])
+
