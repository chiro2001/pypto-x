index 000000000..6c8a1fbeb
--- /dev/null
+++ b/scripts/vendor/q8b/a3_run_onednn.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+# Q8b aarch64 leg: build + run the oneDNN 3.12 probe and the torch/oneDNN-ACL
+# int8 check on A3.  Conda env onednn312 is aarch64 conda-forge (no ACL dep);
+# torch 2.14's bundled oneDNN does carry gemm:acl symbols -> both are reported.
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=/dev/null
+source "$HERE/a3_env.sh"
+q8b_mkdirs
+CONDA="$Q8B_CONDA_ENV"
+BIN="$Q8B_INSTALL/onednn_probe"
+
+g++ -O2 -std=c++17 -I"$CONDA/include" -L"$CONDA/lib" -Wl,-rpath,"$CONDA/lib" \
+    "$HERE/a3_onednn_probe.cpp" -ldnnl -o "$BIN"
+
+CPUS="$(q8b_pick_cpus 8)"
+{
+    echo "== oneDNN conda build facts =="
+    ls -la "$CONDA/lib/libdnnl.so.3.12"
+    sha256sum "$CONDA/lib/libdnnl.so.3.12"
+    echo "== gemm:acl strings in conda lib =="
+    strings -a "$CONDA/lib/libdnnl.so.3.12" | grep -c 'gemm:acl' || true
+    echo "== probe stdout =="
+} > "$Q8B_RAW/onednn-probe.stdout.txt"
+taskset -c "$CPUS" env OMP_NUM_THREADS=8 OMP_PROC_BIND=close OMP_PLACES=cores \
+    LD_LIBRARY_PATH="$CONDA/lib" DNNL_VERBOSE=1 "$BIN" \
+    >> "$Q8B_RAW/onednn-probe.stdout.txt" 2> "$Q8B_RAW/onednn-probe.stderr.txt"
+
+{
+    echo "== torch $(  "$Q8B_A3_PY" -c 'import torch;print(torch.__version__)' ) =="
+    echo "== gemm:acl strings in torch libtorch_cpu.so =="
+    T="$("$Q8B_A3_PY" -c 'import torch,os;print(os.path.join(os.path.dirname(torch.__file__),"lib","libtorch_cpu.so"))')"
+    strings -a "$T" | grep -c 'gemm:acl' || true
+} > "$Q8B_RAW/torch-acl-int8.txt" 2>&1
+taskset -c "$CPUS" env OMP_NUM_THREADS=8 LD_LIBRARY_PATH="$CONDA/lib" DNNL_VERBOSE=1 \
+    "$Q8B_A3_PY" - >> "$Q8B_RAW/torch-acl-int8.txt" 2>&1 <<'PY'
+import torch
+a = torch.randint(-127, 127, (5, 1024), dtype=torch.int8)
+b = torch.randint(-127, 127, (1024, 64), dtype=torch.int8)
+c = torch._int_mm(a, b)
+print("torch._int_mm dtype", c.dtype, "shape", tuple(c.shape), "sum", int(c.abs().sum()))
+print("mkldnn available", torch.backends.mkldnn.is_available())
+PY
+echo "onednn probe done"
