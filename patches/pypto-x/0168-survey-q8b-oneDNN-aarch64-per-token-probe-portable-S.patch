+/* Q8b aarch64 leg: raw benchmark of our portable SVE256 widening qmatmul kernel.
+ *
+ * The kernel body is extracted verbatim from
+ *   python/pypto/compiler/targets/cpu_sve256.py::_NATIVE_SOURCE
+ * (function ptx_sve256_qmatmul_s8s8_s32) by a3_build_sve256_bench.sh; the
+ * runner's own main() is renamed out of the way at compile time, so this is
+ * the shipped portable kernel, not a reimplementation.
+ *
+ * Usage: sve256_bench <m> <k> <n> <rounds> <iters> <json>
+ * Single process, single thread: the shipped kernel is a scalar-widening SVE
+ * kernel; this is the portable control column, not an 8-thread vendor run.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+extern void ptx_sve256_qmatmul_s8s8_s32(const int8_t *left, const int8_t *right, int32_t *output,
+                                        uint64_t m, uint64_t k, uint64_t n);
+
+static double now_ms(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+static int cmp_double(const void *a, const void *b) {
+    double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+
+int main(int argc, char **argv) {
+    if (argc != 7) {
+        fprintf(stderr, "usage: %s m k n rounds iters json\n", argv[0]);
+        return 2;
+    }
+    uint64_t m = strtoull(argv[1], NULL, 10), k = strtoull(argv[2], NULL, 10),
+             n = strtoull(argv[3], NULL, 10);
+    int rounds = atoi(argv[4]), iters = atoi(argv[5]);
+    const char *jpath = argv[6];
+
+    int8_t *left = malloc(m * k);
+    int8_t *right = malloc(k * n);
+    int32_t *out = malloc(m * n * sizeof(int32_t));
+    for (uint64_t i = 0; i < m * k; i++) left[i] = (int8_t)((i * 7 + 1) % 255 - 127);
+    for (uint64_t i = 0; i < k * n; i++) right[i] = (int8_t)((i * 13 + 3) % 255 - 127);
+    memset(out, 0, m * n * sizeof(int32_t));
+
+    double *ms = malloc(sizeof(double) * rounds);
+    for (int r = 0; r < rounds; r++) {
+        double t0 = now_ms();
+        for (int it = 0; it < iters; it++)
+            ptx_sve256_qmatmul_s8s8_s32(left, right, out, m, k, n);
+        double t1 = now_ms();
+        ms[r] = (t1 - t0) / iters;
+    }
+    double *sorted = malloc(sizeof(double) * rounds);
+    memcpy(sorted, ms, sizeof(double) * rounds);
+    qsort(sorted, rounds, sizeof(double), cmp_double);
+    double median = (rounds % 2) ? sorted[rounds / 2]
+                                 : 0.5 * (sorted[rounds / 2 - 1] + sorted[rounds / 2]);
+
+    int64_t checksum = 0;
+    for (uint64_t i = 0; i < m * n; i++) checksum += (int64_t)out[i] * (int64_t)((i % 17) + 1);
+    FILE *f = fopen(jpath, "w");
+    fprintf(f, "{\"probe\":\"q8b-sve256-raw-bench\",\"m\":%llu,\"k\":%llu,\"n\":%llu,"
+               "\"rounds\":%d,\"iters\":%d,\"threads\":1,\"median_ms\":%.6f,\"min_ms\":%.6f,"
+               "\"rounds_ms\":[",
+            (unsigned long long)m, (unsigned long long)k, (unsigned long long)n, rounds, iters,
+            median, sorted[0]);
+    for (int r = 0; r < rounds; r++) fprintf(f, "%s%.6f", r ? "," : "", ms[r]);
+    fprintf(f, "],\"checksum\":%lld}\n", (long long)checksum);
+    fclose(f);
+    printf("m=%llu k=%llu n=%llu median_ms=%.6f checksum=%lld\n", (unsigned long long)m,
+           (unsigned long long)k, (unsigned long long)n, median, (long long)checksum);
+    free(left); free(right); free(out); free(ms); free(sorted);
+    return 0;
+}
