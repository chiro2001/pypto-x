@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# Q8b aarch64 leg: build + run the portable SVE256 widening qmatmul control.
+# The kernel source is extracted verbatim from the repository file shipped in
+# this worktree (no reimplementation); the runner main() is renamed.
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=/dev/null
+source "$HERE/a3_env.sh"
+q8b_mkdirs
+
+REPO_PY="${Q8B_REPO_PY:-/home/chiro/projects/pypto/worktrees/pypto-x/vendor-gemm-survey-2/python/pypto/compiler/targets/cpu_sve256.py}"
+if [ ! -f "$REPO_PY" ]; then echo "missing $REPO_PY" >&2; exit 1; fi
+OUT="$Q8B_INSTALL/sve256_bench"
+python3 - "$REPO_PY" "$Q8B_TMP/cpu_sve256_native.c" <<'PY'
+import re, sys
+src = open(sys.argv[1]).read()
+m = re.search(r"_NATIVE_SOURCE = r'''(.*?)'''", src, re.S)
+assert m, "could not extract _NATIVE_SOURCE"
+open(sys.argv[2], "w").write(m.group(1))
+print("extracted", len(m.group(1)), "bytes")
+PY
+sha256sum "$Q8B_TMP/cpu_sve256_native.c" | tee "$Q8B_LOGS/sve256-kernel-sha256.txt"
+
+CC=cc
+$CC -O2 -std=c99 -march=armv8.2-a+sve -msve-vector-bits=scalable \
+    -Dmain=ptx_sve256_runner_main -c "$Q8B_TMP/cpu_sve256_native.c" -o "$Q8B_TMP/cpu_sve256_native.o"
+$CC -O2 -std=c99 -march=armv8.2-a+sve -msve-vector-bits=scalable \
+    "$HERE/sve256_bench.c" "$Q8B_TMP/cpu_sve256_native.o" -lm -o "$OUT"
+
+mkdir -p "$Q8B_RAW/sve256-bench"
+CPUS="$(q8b_pick_cpus 1)"
+SHAPES=(
+  "1024 32" "1024 5120" "1024 7168" "1024 8192" "2048 1024" "3584 1024"
+)
+for mv in 1 5; do
+  for shape in "${SHAPES[@]}"; do
+    read -r k n <<<"$shape"
+    cell=$((mv * k * n))
+    iters=$((30000000 / (cell > 0 ? cell : 1)))
+    [ "$iters" -lt 2 ] && iters=2
+    [ "$iters" -gt 50 ] && iters=50
+    taskset -c "$CPUS" "$OUT" "$mv" "$k" "$n" 3 "$iters" "$Q8B_RAW/sve256-bench/m${mv}_k${k}_n${n}.json" \
+      | tee -a "$Q8B_LOGS/sve256-bench.log"
+  done
+done
+echo "sve256 control done"
