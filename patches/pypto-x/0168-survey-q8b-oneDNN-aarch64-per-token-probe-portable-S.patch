diff --git a/scripts/vendor/q8b/a3_onednn_probe.cpp b/scripts/vendor/q8b/a3_onednn_probe.cpp
new file mode 100644
index 000000000..9709bb001
--- /dev/null
+++ b/scripts/vendor/q8b/a3_onednn_probe.cpp
@@ -0,0 +1,82 @@
+// Q8b aarch64 leg: oneDNN 3.12 int8 matmul + scale-granularity probe (A3).
+// Build (conda env provided by a3_run_onednn.sh):
+//   g++ -O2 -std=c++17 -I$CONDA/include -L$CONDA/lib -ldnnl -Wl,-rpath,$CONDA/lib \
+//       a3_onednn_probe.cpp -o onednn_probe
+// Each case prints whether primitive creation succeeded, the chosen
+// implementation name, and DNNL_VERBOSE exec lines to stderr.
+#include <dnnl.hpp>
+#include <cstdint>
+#include <cstdio>
+#include <unordered_map>
+#include <vector>
+
+using namespace dnnl;
+
+static void case_matmul(const char *name, const memory::desc &src_md, const memory::desc &wei_md,
+                        const memory::desc &dst_md, int src_scale_mask, int wei_scale_mask,
+                        int src_zp_mask, int wei_zp_mask, bool runtime_scales) {
+    engine eng(engine::kind::cpu, 0);
+    stream s(eng);
+    printf("\n-- %s --\n", name);
+    fflush(stdout);
+    try {
+        primitive_attr attr;
+        if (src_scale_mask >= 0) attr.set_scales_mask(DNNL_ARG_SRC, src_scale_mask);
+        if (wei_scale_mask >= 0) attr.set_scales_mask(DNNL_ARG_WEIGHTS, wei_scale_mask);
+        if (src_zp_mask >= 0) attr.set_zero_points_mask(DNNL_ARG_SRC, src_zp_mask);
+        if (wei_zp_mask >= 0) attr.set_zero_points_mask(DNNL_ARG_WEIGHTS, wei_zp_mask);
+        matmul::primitive_desc pd(eng, src_md, wei_md, dst_md, attr);
+        printf("  primitive_desc: OK impl_info_str=%s\n", pd.impl_info_str());
+        auto prim = matmul(pd);
+        std::vector<int8_t> a(pd.src_desc().get_size()), b(pd.weights_desc().get_size());
+        for (size_t i = 0; i < a.size(); i++) a[i] = (int8_t)((i * 7) % 117 - 58);
+        for (size_t i = 0; i < b.size(); i++) b[i] = (int8_t)((i * 13) % 117 - 58);
+        memory src_mem(pd.src_desc(), eng, a.data());
+        memory wei_mem(pd.weights_desc(), eng, b.data());
+        memory dst_mem(pd.dst_desc(), eng);
+        std::vector<float> ones(256, 1.0f);
+        memory src_scales_mem(memory::desc(memory::dims{(int64_t)pd.src_desc().get_dims()[0]}, memory::data_type::f32, memory::format_tag::x),
+                              eng, ones.data());
+        memory wei_scales_mem(memory::desc(memory::dims{(int64_t)pd.weights_desc().get_dims()[1]}, memory::data_type::f32, memory::format_tag::x),
+                              eng, ones.data());
+        std::vector<int32_t> zps(256, 0);
+        memory src_zp_mem(memory::desc(memory::dims{(int64_t)pd.src_desc().get_dims()[0]}, memory::data_type::s32, memory::format_tag::x),
+                          eng, zps.data());
+        memory wei_zp_mem(memory::desc(memory::dims{(int64_t)pd.weights_desc().get_dims()[1]}, memory::data_type::s32, memory::format_tag::x),
+                          eng, zps.data());
+        std::unordered_map<int, memory> args = {
+            {DNNL_ARG_SRC, src_mem}, {DNNL_ARG_WEIGHTS, wei_mem}, {DNNL_ARG_DST, dst_mem}};
+        if (src_scale_mask >= 0) args.insert({DNNL_ARG_ATTR_SCALES | DNNL_ARG_SRC, src_scales_mem});
+        if (wei_scale_mask >= 0) args.insert({DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, wei_scales_mem});
+        if (src_zp_mask >= 0) args.insert({DNNL_ARG_ATTR_ZERO_POINTS | DNNL_ARG_SRC, src_zp_mem});
+        if (wei_zp_mask >= 0) args.insert({DNNL_ARG_ATTR_ZERO_POINTS | DNNL_ARG_WEIGHTS, wei_zp_mem});
+        prim.execute(s, args);
+        s.wait();
+        printf("  execute: OK dst_dtype=0x%x\n", (unsigned)pd.dst_desc().get_data_type());
+    } catch (const dnnl::error &e) {
+        printf("  DNNL_ERROR status=%d message=%s\n", (int)e.status, e.message);
+    } catch (const std::exception &e) {
+        printf("  EXCEPTION %s\n", e.what());
+    }
+    fflush(stdout);
+}
+
+int main() {
+    const int M = 5, K = 1024, N = 64;
+    memory::desc src8({M, K}, memory::data_type::s8, memory::format_tag::ab);
+    memory::desc wei8({K, N}, memory::data_type::s8, memory::format_tag::ab);
+    memory::desc dst32({M, N}, memory::data_type::s32, memory::format_tag::ab);
+    memory::desc dstf32({M, N}, memory::data_type::f32, memory::format_tag::ab);
+    memory::desc dstbf16({M, N}, memory::data_type::bf16, memory::format_tag::ab);
+    memory::desc srcu8({M, K}, memory::data_type::u8, memory::format_tag::ab);
+
+    printf("oneDNN version=%d.%d.%d\n", DNNL_VERSION_MAJOR, DNNL_VERSION_MINOR, DNNL_VERSION_PATCH);
+    case_matmul("s8xs8->s32 no scales/zp", src8, wei8, dst32, -1, -1, -1, -1, false);
+    case_matmul("s8xs8->f32 src per-tensor + wei per-column", src8, wei8, dstf32, 0, 1 << 1, -1, -1, false);
+    case_matmul("s8xs8->f32 src per-TOKEN(M) + wei per-column", src8, wei8, dstf32, 1 << 0, 1 << 1, -1, -1, false);
+    case_matmul("s8xs8->f32 src per-TOKEN(M) + wei per-tensor", src8, wei8, dstf32, 1 << 0, 0, -1, -1, false);
+    case_matmul("s8xs8->bf16 src per-TOKEN(M) + wei per-column", src8, wei8, dstbf16, 1 << 0, 1 << 1, -1, -1, false);
+    case_matmul("u8xs8->f32 src per-tensor + wei per-column", srcu8, wei8, dstf32, 0, 1 << 1, -1, -1, false);
+    case_matmul("s8xs8->s32 with src per-token zp", src8, wei8, dst32, -1, -1, 1 << 0, -1, false);
+    return 0;
+}
