-def _rate_calibration(driver, function, plan, parameters, gap_seconds, rounds):
-    """Measure the platform cuEvent clock rate against the host wall clock.
+def _rate_calibration(driver, gap_seconds, rounds):
+    """Measure the platform cuEvent clock rate with a kernel-free host gap.
 
-    Each round puts two kernels around a known host ``time.sleep`` gap inside a
-    single event pair.  The host wall span of that known interval divided by
-    the event span is the timer's rate relative to wall time; on the RTX 5080
-    WSL2 host this is ~1.06 (the device event clock runs ~6% slow), so the gate
+    Each round records a start event, sleeps for a known host interval, records
+    the stop event and synchronizes.  With no kernel inside the span the rate
+    is not coupled to workload time: the host wall span divided by the event
+    span is the timer's rate relative to wall time.  On the RTX 5080 WSL2 host
+    this is ~1.06 (the device event clock runs ~6% slow), so the gate
     calibrates it in-run instead of pretending raw equality.
     """
 
