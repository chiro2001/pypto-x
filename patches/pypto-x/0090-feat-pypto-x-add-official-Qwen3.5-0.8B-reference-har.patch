+                if generate_check["step_logits"]:
+                    entry["decode_vs_generate_logits"] = diff_stats(
+                        result["decode_logits"], np.stack(generate_check["step_logits"], axis=0)
+                    )
+            meta["runs"].append(entry)
+            print("[ref]   prefill=%.2fs decode=%.2fs peak_rss=%.0fMiB tokens=%s" %
+                  (result["prefill_seconds"], result["decode_seconds"],
+                   peak_rss_mib(), entry["decode_token_ids"]), flush=True)
+
+        del model
+        gc.collect()
+
+    # float32 与 bf16 的数值差异
+    if "float32" in collected and "bfloat16" in collected:
+        for item in prompts:
+            pid = item["id"]
+            if pid not in collected["float32"] or pid not in collected["bfloat16"]:
+                continue
+            main = collected["float32"][pid]
+            control = collected["bfloat16"][pid]
+            stats = {
+                "prefill_logits": diff_stats(main["prefill_logits"], control["prefill_logits"]),
+                "prefill_next_logits": diff_stats(main["prefill_next_logits"],
+                                                  control["prefill_next_logits"]),
+                "decode_logits": diff_stats(main["decode_logits"], control["decode_logits"]),
+                "decode_token_ids_equal": bool(
+                    np.array_equal(main["decode_token_ids"], control["decode_token_ids"])
+                ),
+                "prefill_argmax_last_equal": bool(
+                    int(np.argmax(main["prefill_next_logits"])) ==
+                    int(np.argmax(control["prefill_next_logits"]))
+                ),
+            }
+            meta["comparisons"][pid] = stats
+            print("[ref] compare %s prefill_max_abs=%.6g decode_tokens_equal=%s" %
+                  (pid, stats["prefill_logits"]["max_abs"],
+                   stats["decode_token_ids_equal"]), flush=True)
+
+    # hidden states 一致性：hook 收集 vs 官方 output_hidden_states
+    for item in prompts:
+        pid = item["id"]
+        if "float32" not in collected or pid not in collected["float32"]:
+            continue
+        main = collected["float32"][pid]
+        layers = main.get("hidden_states_layers")
+        official = main.get("hidden_states_official")
+        if layers is None or official is None:
+            continue
+        n_common = min(layers.shape[0], official.shape[0] - 1)
+        stats = diff_stats(layers[:n_common], official[:n_common])
+        meta["comparisons"].setdefault(pid, {})["hidden_states_hook_vs_official"] = stats
+        meta["comparisons"][pid]["hidden_states_shape"] = list(layers.shape)
+        meta["comparisons"][pid]["hidden_states_official_shape"] = list(official.shape)
+        if main.get("last_hidden_state") is not None:
+            meta["comparisons"][pid]["last_hidden_state_vs_official_tail"] = diff_stats(
+                main["last_hidden_state"], official[-1]
+            )
+
+    meta_path = os.path.join(out_dir, "meta.json")
+    with open(meta_path, "w", encoding="utf-8") as handle:
+        json.dump(meta, handle, ensure_ascii=False, indent=2)
+
+    # 汇总索引
+    files = []
+    for root, _dirs, names in os.walk(out_dir):
+        for name in sorted(names):
+            if name == "index.json":
+                continue
+            path = os.path.join(root, name)
+            files.append({
+                "path": os.path.relpath(path, out_dir),
+                "bytes": os.path.getsize(path),
+                "sha256": sha256_file(path),
+            })
+    index = {
+        "task": meta["task"],
+        "generated_at": meta["generated_at"],
+        "model": {
+            "repo_id": "Qwen/Qwen3.5-0.8B",
+            "revision": DEFAULT_REVISION,
+            "architectures": ["Qwen3_5ForConditionalGeneration"],
+            "modality": "text-only (vision encoder not exercised)",
+        },
+        "versions": meta["versions"],
+        "runtime": meta["runtime"],
+        "tokenizer": meta["tokenizer"],
+        "prompts": [
+            {
+                "id": item["id"],
+                "kind": item["kind"],
+                "text": item["text"],
+                "forward_ids": item["forward_ids"],
+                "ids_no_special": item["ids_no_special"],
+                "ids_with_special": item["ids_with_special"],
+                "forward_ids_variant": item["forward_ids_variant"],
+                "seq_len": item["seq_len"],
