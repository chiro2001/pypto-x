+#!/usr/bin/env bash
+# 为 Qwen3.5-0.8B 官方参考（gold）harness 准备独立 venv。
+#
+# 设计要点：
+#   * 只安装 CPU 版 torch（download.pytorch.org/whl/cpu），避免拉入 CUDA 运行时。
+#   * 绝不安装到 /home/chiro/miniforge3 base 环境，所有包只进本 venv。
+#   * 可重入：venv 已存在时只补装缺失包。
+#
+# 用法：
+#   tools/qwen35_reference/setup_venv.sh <venv-dir>
+#
+# 可用环境变量覆盖：
+#   PYPTO_X_PYPI_MIRROR  非 torch 包的 PyPI 源（默认清华镜像）
+#   PYPTO_X_TORCH_INDEX  torch CPU wheel 源（默认 download.pytorch.org/whl/cpu）
+#   PYPTO_X_TORCH_PIN    torch 版本 pin（默认 torch==2.14.0+cpu）
+set -euo pipefail
+
+VENV_DIR=${1:?usage: setup_venv.sh <venv-dir>}
+PYPI_MIRROR=${PYPTO_X_PYPI_MIRROR:-https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple}
+TORCH_INDEX=${PYPTO_X_TORCH_INDEX:-https://download.pytorch.org/whl/cpu}
+TORCH_PIN=${PYPTO_X_TORCH_PIN:-torch==2.14.0+cpu}
+
+if [[ ! -x ${VENV_DIR}/bin/python ]]; then
+  echo "[setup] creating venv: ${VENV_DIR}"
+  python3 -m venv "${VENV_DIR}"
+fi
+PY=${VENV_DIR}/bin/python
+
+echo "[setup] base interpreter: $("${PY}" -VV)"
+"${PY}" -m pip install --upgrade pip
+
+echo "[setup] installing ${TORCH_PIN} from ${TORCH_INDEX}"
+"${PY}" -m pip install \
+  --index-url "${TORCH_INDEX}" \
+  --extra-index-url "${PYPI_MIRROR}" \
+  "${TORCH_PIN}"
+
+echo "[setup] installing transformers/safetensors/tokenizers/numpy from ${PYPI_MIRROR}"
+"${PY}" -m pip install \
+  --index-url "${PYPI_MIRROR}" \
+  transformers safetensors tokenizers numpy
+
+echo "[setup] pip freeze:"
+"${PY}" -m pip freeze
