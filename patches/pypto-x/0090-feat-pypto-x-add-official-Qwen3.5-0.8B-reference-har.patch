+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Qwen3.5-0.8B 官方参考（gold）harness。
+
+用途
+----
+用官方 transformers 实现，在固定 revision、固定 prompt 上产出确定性参考输出，
+供 PyPTO-X 后续带权对齐使用。本脚本只做纯文本前向，不触碰视觉编码器。
+
+硬约束
+------
+* 权重只从本地资产目录加载（``local_files_only=True``），不联网拉权重。
+* ``model.eval()`` + ``torch.no_grad()``，固定线程数、固定 seed，无采样（greedy）。
+* 主参考为 float32（从 bf16 权重上采样）；另存 bf16 原始 dtype 的 logits 作为对照。
+
+产出（写入 ``--out-dir``）
+--------------------------
+* ``<dtype>/<prompt_id>.npz``  该 dtype 下该 prompt 的全部张量
+* ``ids.json``                 prompt 文本、token ids、变体编码
+* ``meta.json``                版本、环境、逐阶段耗时与峰值 RSS
+* ``index.json``               汇总索引（含产物 sha256 清单）
+
+语法约束：本文件必须通过 Python 3.7 AST 门槛，不使用 3.8+ 专属语法。
+"""
+
+import argparse
+import gc
+import hashlib
+import json
+import os
+import platform
+import random
+import resource
+import sys
+import time
+
+import numpy as np
+import torch
+
+
+DEFAULT_ASSETS_DIR = (
+    "/home/chiro/projects/pypto/worktrees/_meta/pypto-x/assets/qwen35-0.8b/"
+    "2fc06364715b967f1860aea9cf38778875588b17"
+)
+DEFAULT_REVISION = "2fc06364715b967f1860aea9cf38778875588b17"
+
+# 固定 prompt 集合。raw_text 走纯文本续写；chat_template 走官方对话模板。
+PROMPTS = (
+    {
+        "id": "en_continuation",
+        "kind": "raw_text",
+        "text": "The capital of France is",
+    },
+    {
+        "id": "zh_continuation",
+        "kind": "raw_text",
+        "text": "请用一句话解释什么是张量并行。",
+    },
+    {
+        "id": "chat_zh_user",
+        "kind": "chat_template",
+        "messages": ({"role": "user", "content": "你好，请介绍一下你自己。"},),
+        "add_generation_prompt": True,
+        "enable_thinking": False,
+    },
+)
+
+
+def now_iso():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def sha256_file(path, chunk_size=1 << 20):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        while True:
+            block = handle.read(chunk_size)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def peak_rss_mib():
+    # Linux 上 ru_maxrss 单位是 KiB。
+    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0
+
+
+def to_numpy_f32(tensor):
+    return tensor.detach().to(torch.float32).cpu().numpy()
+
+
+class LayerRecorder(object):
+    """用 forward hook 逐层记录 decoder layer 的输入与输出。
+
+    记录的是官方实现的原始张量：``inputs[0]`` 是 ``embed_tokens`` 的输出，
+    ``outputs[i]`` 是第 i 层 decoder layer 的输出（尚未做 final RMSNorm）。
+    """
+
+    def __init__(self):
+        self.inputs = {}
+        self.outputs = {}
+        self.handles = []
+
+    def attach(self, layers):
+        for index, layer in enumerate(layers):
+            self.handles.append(
+                layer.register_forward_pre_hook(self._make_pre(index), with_kwargs=True)
+            )
+            self.handles.append(
+                layer.register_forward_hook(self._make_post(index), with_kwargs=True)
+            )
+
+    def detach(self):
+        for handle in self.handles:
+            handle.remove()
+        self.handles = []
+
+    def _make_pre(self, index):
+        def hook(module, args, kwargs):
+            hidden = kwargs.get("hidden_states")
+            if hidden is None and args:
+                hidden = args[0]
+            self.inputs[index] = self._to_numpy(hidden)
+
+        return hook
+
+    def _make_post(self, index):
+        def hook(module, args, kwargs, output):
+            self.outputs[index] = self._to_numpy(output)
+
+        return hook
+
+    @staticmethod
+    def _to_numpy(tensor):
+        array = tensor.detach().to(torch.float32).cpu().numpy()
+        # 本 harness 固定 batch_size=1，去掉 batch 维，便于与官方 output_hidden_states 对齐。
+        if array.ndim == 3 and array.shape[0] == 1:
+            array = array[0]
+        return array
+
+    def stacked_layers(self):
+        """返回 [embedding, layer0_out, ..., layerN_out]，shape [N+1, seq, hidden]。"""
+        if not self.outputs:
+            return None
+        layer_ids = sorted(self.outputs)
+        frames = [self.inputs[layer_ids[0]]]
+        for layer_id in layer_ids:
+            frames.append(self.outputs[layer_id])
+        return np.stack(frames, axis=0)
+
+
+def parse_args(argv):
+    parser = argparse.ArgumentParser(description="Qwen3.5-0.8B 官方参考 harness")
+    parser.add_argument("--assets-dir", default=DEFAULT_ASSETS_DIR)
+    parser.add_argument("--out-dir", required=True)
+    parser.add_argument("--dtypes", default="float32,bfloat16",
+                        help="逗号分隔；float32 为主参考，bfloat16 为原始 dtype 对照")
+    parser.add_argument("--max-new-tokens", type=int, default=4)
+    parser.add_argument("--threads", type=int, default=6)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--attn-implementation", default="eager")
+    parser.add_argument("--skip-generate-check", action="store_true",
+                        help="跳过与 model.generate 的交叉校验")
+    parser.add_argument("--only-prompts", default="",
+                        help="逗号分隔的 prompt id 子集（调试用）")
+    return parser.parse_args(argv)
+
+
+def dtype_from_name(name):
+    if name == "float32":
+        return torch.float32
+    if name == "bfloat16":
+        return torch.bfloat16
+    if name == "float16":
+        return torch.float16
+    raise ValueError("unsupported dtype: %s" % name)
+
+
+def encode_prompts(tokenizer, only_ids):
+    encoded = []
+    for spec in PROMPTS:
+        if only_ids and spec["id"] not in only_ids:
+            continue
+        item = {"id": spec["id"], "kind": spec["kind"]}
+        if spec["kind"] == "raw_text":
+            item["text"] = spec["text"]
+            item["template_kwargs"] = {}
+        else:
+            text = tokenizer.apply_chat_template(
+                list(spec["messages"]),
+                tokenize=False,
+                add_generation_prompt=spec["add_generation_prompt"],
+                enable_thinking=spec["enable_thinking"],
+            )
+            item["text"] = text
+            item["template_kwargs"] = {
+                "add_generation_prompt": spec["add_generation_prompt"],
+                "enable_thinking": spec["enable_thinking"],
+            }
+        plain = tokenizer(item["text"], add_special_tokens=False)
+        special = tokenizer(item["text"], add_special_tokens=True)
+        item["ids_no_special"] = list(plain["input_ids"])
+        item["ids_with_special"] = list(special["input_ids"])
+        item["forward_ids_variant"] = "add_special_tokens=False"
+        item["forward_ids"] = list(plain["input_ids"])
+        item["decoded_forward_ids"] = tokenizer.decode(item["forward_ids"],
+                                                       skip_special_tokens=False)
+        item["seq_len"] = len(item["forward_ids"])
+        encoded.append(item)
+    return encoded
+
+
+def load_model(assets_dir, dtype, attn_implementation):
+    from transformers import Qwen3_5ForConditionalGeneration
+
+    kwargs = {
+        "local_files_only": True,
+        "attn_implementation": attn_implementation,
+    }
+    try:
+        model = Qwen3_5ForConditionalGeneration.from_pretrained(
+            assets_dir, dtype=dtype, **kwargs
+        )
+    except TypeError:
+        # 兼容旧参数名；记录到 meta 由调用方观察。
+        model = Qwen3_5ForConditionalGeneration.from_pretrained(
+            assets_dir, torch_dtype=dtype, **kwargs
+        )
+    model.eval()
+    return model
+
+
+def run_one_prompt(model, input_ids, max_new_tokens, want_hidden):
+    """返回该 prompt 在该模型上的 prefill 与 greedy decode 结果。"""
+    tensor_ids = torch.tensor([input_ids], dtype=torch.long)
+    result = {}
+    recorder = LayerRecorder()
+
+    if want_hidden:
+        recorder.attach(model.model.language_model.layers)
+    start = time.time()
+    with torch.no_grad():
+        outputs = model(
+            input_ids=tensor_ids,
+            output_hidden_states=want_hidden,
+            use_cache=True,
+            return_dict=True,
+        )
+    result["prefill_seconds"] = time.time() - start
+    recorder.detach()
+
+    prefill_logits = to_numpy_f32(outputs.logits[0])
+    result["prefill_logits"] = prefill_logits
+    result["prefill_next_logits"] = prefill_logits[-1].copy()
+
+    if want_hidden:
+        result["hidden_states_layers"] = recorder.stacked_layers()
+        official = outputs.hidden_states
+        # 注意：Qwen3_5ForConditionalGeneration 返回 Qwen3_5CausalLMOutputWithPast，
+        # 没有 last_hidden_state 字段。官方 capture_outputs 在 tie_last_hidden_states=True
+        # 时会把 hidden_states 的最后一项覆盖为 language model 的 last_hidden_state（final
+        # RMSNorm 之后），因此这里直接取 hidden_states[-1]。
+        if official is None:
+            result["hidden_states_official"] = None
+            result["last_hidden_state"] = None
+        else:
+            result["hidden_states_official"] = np.stack(
+                [to_numpy_f32(item[0]) for item in official], axis=0
+            )
+            result["last_hidden_state"] = to_numpy_f32(official[-1][0])
+
+    # greedy decode：手动增量前向，保证每一步 logits 都被完整记录。
+    past = outputs.past_key_values
+    running_logits = outputs.logits
+    step_logits = []
+    step_ids = []
+    start = time.time()
+    with torch.no_grad():
+        for _ in range(max_new_tokens):
+            last_logits = running_logits[0, -1].to(torch.float32)
+            next_id = int(torch.argmax(last_logits).item())
+            step_logits.append(last_logits.cpu().numpy())
+            step_ids.append(next_id)
+            step_out = model(
+                input_ids=torch.tensor([[next_id]], dtype=torch.long),
+                past_key_values=past,
+                use_cache=True,
+                return_dict=True,
+            )
+            past = step_out.past_key_values
+            running_logits = step_out.logits
+    result["decode_seconds"] = time.time() - start
+    result["decode_logits"] = np.stack(step_logits, axis=0)
+    result["decode_token_ids"] = np.asarray(step_ids, dtype=np.int64)
+    del outputs, past, running_logits
+    return result
+
+
+def run_generate_check(model, input_ids, max_new_tokens):
+    """用官方 generate（greedy）交叉校验手动增量路径。"""
+    tensor_ids = torch.tensor([input_ids], dtype=torch.long)
+    with torch.no_grad():
+        generated = model.generate(
+            input_ids=tensor_ids,
+            do_sample=False,
+            max_new_tokens=max_new_tokens,
+            min_new_tokens=max_new_tokens,
+            output_scores=True,
+            return_dict_in_generate=True,
+        )
+    scores = []
+    if generated.scores is not None:
+        scores = [to_numpy_f32(step[0]) for step in generated.scores]
+    new_ids = generated.sequences[0, tensor_ids.shape[1]:].tolist()
+    del generated
+    return {"token_ids": new_ids, "step_logits": scores}
+
+
+def row_argmax(array):
+    arr = np.asarray(array, dtype=np.float64)
+    if arr.ndim == 1:
+        return np.asarray([int(np.argmax(arr))])
+    return np.argmax(arr, axis=-1)
+
+
+def diff_stats(reference, candidate):
+    """返回两个等形状数组的差异统计。
+
+    只在双方都有限的位置上计算数值差异；``nonfinite_mismatch_count`` 单独报告，
+    用于识别 ``generate`` 中 ``MinNewTokensLengthLogitsProcessor`` 把 eos logit
+    置为 -inf 这类刻意构造的差异。
+    """
+    ref = np.asarray(reference, dtype=np.float64)
+    cand = np.asarray(candidate, dtype=np.float64)
+    if ref.shape != cand.shape:
+        return {"shape_mismatch": [list(ref.shape), list(cand.shape)]}
+    finite = np.isfinite(ref) & np.isfinite(cand)
+    stats = {
+        "elements": int(ref.size),
+        "finite_elements": int(finite.sum()),
+        "nonfinite_mismatch_count": int((~finite).sum()),
+        "row_argmax_equal": bool(np.array_equal(row_argmax(ref), row_argmax(cand))),
+    }
+    if finite.any():
+        diff = np.abs(ref[finite] - cand[finite])
+        denom = np.maximum(np.abs(ref[finite]), 1e-12)
+        stats["max_abs"] = float(diff.max())
+        stats["mean_abs"] = float(diff.mean())
+        stats["max_rel"] = float((diff / denom).max())
+    if stats["nonfinite_mismatch_count"]:
+        if stats["nonfinite_mismatch_count"] <= 8:
+            stats["nonfinite_mismatch_positions"] = [
+                [int(x) for x in pos] for pos in np.argwhere(~finite)
+            ]
+        stats["nonfinite_note"] = (
+            "generate 使用 min_new_tokens 时 MinNewTokensLengthLogitsProcessor 会把 "
+            "eos logit 置为 -inf；手工 greedy 路径不做该处理，属预期差异"
+        )
+    return stats
+
+
+def main(argv=None):
+    args = parse_args(argv if argv is not None else sys.argv[1:])
+    out_dir = os.path.abspath(args.out_dir)
+    os.makedirs(out_dir, exist_ok=True)
+
+    torch.set_num_threads(args.threads)
+    random.seed(args.seed)
+    np.random.seed(args.seed)
+    torch.manual_seed(args.seed)
+
+    import transformers
+
+    from transformers import AutoTokenizer
+
+    dtype_names = [item.strip() for item in args.dtypes.split(",") if item.strip()]
+    only_ids = [item.strip() for item in args.only_prompts.split(",") if item.strip()]
+
+    print("[ref] assets_dir=%s" % args.assets_dir, flush=True)
+    print("[ref] out_dir=%s" % out_dir, flush=True)
+    print("[ref] dtypes=%s threads=%d seed=%d attn=%s" %
+          (dtype_names, args.threads, args.seed, args.attn_implementation), flush=True)
+
+    tokenizer = AutoTokenizer.from_pretrained(args.assets_dir, local_files_only=True)
+    prompts = encode_prompts(tokenizer, only_ids)
+    for item in prompts:
+        print("[ref] prompt %s kind=%s len=%d ids=%s" %
+              (item["id"], item["kind"], item["seq_len"], item["forward_ids"]), flush=True)
+
+    ids_path = os.path.join(out_dir, "ids.json")
+    with open(ids_path, "w", encoding="utf-8") as handle:
+        json.dump({"prompts": prompts}, handle, ensure_ascii=False, indent=2)
+
+    meta = {
+        "task": "qwen35-bf16-reference",
+        "generated_at": now_iso(),
+        "assets_dir": args.assets_dir,
+        "revision": DEFAULT_REVISION,
+        "python": sys.version,
+        "platform": platform.platform(),
+        "versions": {
+            "torch": torch.__version__,
+            "transformers": transformers.__version__,
+            "numpy": np.__version__,
+        },
+        "runtime": {
+            "torch_num_threads": torch.get_num_threads(),
+            "seed": args.seed,
+            "device": "cpu",
+            "attn_implementation": args.attn_implementation,
+            "max_new_tokens": args.max_new_tokens,
+            "dtypes": dtype_names,
+        },
+        "runs": [],
+        "comparisons": {},
+        "notes": [
+            "纯文本前向：只传 input_ids，不传 pixel_values / image_grid_thw；视觉编码器未参与计算。",
+            "attention 实现固定为 eager，不使用 sdpa / flash-attention，保证逐层对齐走教科书数学路径。",
+            "hidden_states_layers 由 forward hook 采集：索引 0 是 embed_tokens 输出，索引 i+1 是第 i 层 decoder layer 输出（尚未 final RMSNorm）。",
+            "hidden_states_official 是官方 output_hidden_states 元组；受 capture_outputs(tie_last_hidden_states=True) 影响，其最后一项被替换为 final RMSNorm 之后的 last_hidden_state。",
+            "主参考 float32 由 bf16 权重在加载时上采样得到；bfloat16 目录是原始 dtype 对照。",
+            "greedy decode 由手工增量前向完成，并用官方 model.generate(do_sample=False) 交叉校验。",
+        ],
+    }
+    try:
+        import safetensors
+        import tokenizers
+        meta["versions"]["safetensors"] = safetensors.__version__
+        meta["versions"]["tokenizers"] = tokenizers.__version__
+    except Exception as exc:  # noqa: BLE001 - 版本信息缺失不应中断主流程
+        meta["notes"].append("version probe failed: %s" % exc)
+
+    import importlib.util
+    for module_name in ("causal_conv1d", "fla"):
+        installed = importlib.util.find_spec(module_name) is not None
+        meta["notes"].append(
+            "optional accelerated kernel %s installed=%s (缺省时官方回退到参考 PyTorch 实现)"
+            % (module_name, installed)
+        )
+
+    tokenizer_class = tokenizer.__class__.__name__
+    meta["tokenizer"] = {
+        "class": tokenizer_class,
+        "bos_token": str(tokenizer.bos_token),
+        "eos_token": str(tokenizer.eos_token),
+        "pad_token": str(tokenizer.pad_token),
+        "add_bos_token": bool(getattr(tokenizer, "add_bos_token", False)),
+    }
+    print("[ref] tokenizer=%s eos=%s" % (tokenizer_class, tokenizer.eos_token), flush=True)
+
+    collected = {}
+    for dtype_name in dtype_names:
+        dtype = dtype_from_name(dtype_name)
+        want_hidden = dtype == torch.float32
+        print("[ref] === loading model dtype=%s ===" % dtype_name, flush=True)
+        start = time.time()
+        model = load_model(args.assets_dir, dtype, args.attn_implementation)
+        load_seconds = time.time() - start
+        resolved_attn = getattr(model.config, "_attn_implementation", None)
+        observed_param_dtype = str(next(model.parameters()).dtype)
+        if "model_config" not in meta:
+            text_cfg = model.config.text_config
+            meta["model_config"] = {
+                "model_type": model.config.model_type,
+                "architectures": list(model.config.architectures or []),
+                "tie_word_embeddings": bool(getattr(model.config, "tie_word_embeddings", False)),
+                "text": {
+                    "hidden_size": text_cfg.hidden_size,
+                    "intermediate_size": text_cfg.intermediate_size,
+                    "num_hidden_layers": text_cfg.num_hidden_layers,
+                    "num_attention_heads": text_cfg.num_attention_heads,
+                    "num_key_value_heads": text_cfg.num_key_value_heads,
+                    "head_dim": text_cfg.head_dim,
+                    "vocab_size": text_cfg.vocab_size,
+                    "rms_norm_eps": text_cfg.rms_norm_eps,
+                    "layer_types": list(text_cfg.layer_types),
+                    "full_attention_interval": getattr(text_cfg, "full_attention_interval", None),
+                    "linear_num_key_heads": getattr(text_cfg, "linear_num_key_heads", None),
+                    "linear_num_value_heads": getattr(text_cfg, "linear_num_value_heads", None),
+                    "linear_key_head_dim": getattr(text_cfg, "linear_key_head_dim", None),
+                    "linear_value_head_dim": getattr(text_cfg, "linear_value_head_dim", None),
+                    "linear_conv_kernel_dim": getattr(text_cfg, "linear_conv_kernel_dim", None),
+                    "rope_parameters": dict(getattr(text_cfg, "rope_parameters", {}) or {}),
+                    "mamba_ssm_dtype": getattr(text_cfg, "mamba_ssm_dtype", None),
+                },
+            }
+        print("[ref] loaded in %.1fs attn=%s params_dtype=%s peak_rss=%.1fMiB" %
+              (load_seconds, resolved_attn, observed_param_dtype, peak_rss_mib()), flush=True)
+        dtype_dir = os.path.join(out_dir, dtype_name)
+        os.makedirs(dtype_dir, exist_ok=True)
+        collected[dtype_name] = {}
+
+        for item in prompts:
+            print("[ref] running dtype=%s prompt=%s" % (dtype_name, item["id"]), flush=True)
+            run_start = time.time()
+            result = run_one_prompt(model, item["forward_ids"],
+                                    args.max_new_tokens, want_hidden)
+            generate_check = None
+            if not args.skip_generate_check:
+                generate_check = run_generate_check(model, item["forward_ids"],
+                                                    args.max_new_tokens)
+            payload = {
+                "input_ids": np.asarray(item["forward_ids"], dtype=np.int64),
+                "prefill_logits": result["prefill_logits"],
+                "prefill_next_logits": result["prefill_next_logits"],
+                "decode_logits": result["decode_logits"],
+                "decode_token_ids": result["decode_token_ids"],
+            }
+            if want_hidden and result.get("hidden_states_layers") is not None:
+                payload["hidden_states_layers"] = result["hidden_states_layers"]
+                if result.get("last_hidden_state") is not None:
+                    payload["last_hidden_state"] = result["last_hidden_state"]
+                if result.get("hidden_states_official") is not None:
+                    payload["hidden_states_official"] = result["hidden_states_official"]
+            if generate_check is not None and generate_check["step_logits"]:
+                payload["generate_logits"] = np.stack(generate_check["step_logits"], axis=0)
+                payload["generate_token_ids"] = np.asarray(generate_check["token_ids"],
+                                                           dtype=np.int64)
+            npz_path = os.path.join(dtype_dir, "%s.npz" % item["id"])
+            np.savez(npz_path, **payload)
+            collected[dtype_name][item["id"]] = payload
+
+            entry = {
+                "dtype": dtype_name,
+                "prompt_id": item["id"],
+                "seq_len": item["seq_len"],
+                "param_dtype": observed_param_dtype,
+                "attn_implementation": resolved_attn,
+                "npz": os.path.relpath(npz_path, out_dir),
+                "npz_bytes": os.path.getsize(npz_path),
+                "load_seconds": round(load_seconds, 3),
+                "prefill_seconds": round(result["prefill_seconds"], 3),
+                "decode_seconds": round(result["decode_seconds"], 3),
+                "total_seconds": round(time.time() - run_start, 3),
+                "peak_rss_mib": round(peak_rss_mib(), 1),
+                "decode_token_ids": [int(x) for x in result["decode_token_ids"]],
+            }
+            if generate_check is not None:
+                entry["generate_token_ids"] = [int(x) for x in generate_check["token_ids"]]
+                entry["decode_matches_generate"] = bool(
