+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""记录 Qwen3.5-0.8B 在官方 transformers 下的权重装载信息。
+
+用途：为 PyPTO-X 的带权对齐提供「官方实现到底装了哪些权重」的独立证据，
+包括 missing / unexpected / mismatched keys、tied weights 与参数统计。
+
+只使用本地资产目录（``local_files_only=True``），不做前向推理。
+
+语法约束：本文件必须通过 Python 3.7 AST 门槛。
+"""
+
+import argparse
+import json
+import sys
+import time
+
+import torch
+
+
+DEFAULT_ASSETS_DIR = (
+    "/home/chiro/projects/pypto/worktrees/_meta/pypto-x/assets/qwen35-0.8b/"
+    "2fc06364715b967f1860aea9cf38778875588b17"
+)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Qwen3.5-0.8B 权重装载信息")
+    parser.add_argument("--assets-dir", default=DEFAULT_ASSETS_DIR)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--dtype", default="float32")
+    parser.add_argument("--attn-implementation", default="eager")
+    parser.add_argument("--threads", type=int, default=6)
+    args = parser.parse_args(argv if argv is not None else sys.argv[1:])
+
+    torch.set_num_threads(args.threads)
+    dtype = torch.float32 if args.dtype == "float32" else torch.bfloat16
+
+    import transformers
+    from transformers import Qwen3_5ForConditionalGeneration
+
+    report = {
+        "assets_dir": args.assets_dir,
+        "dtype": args.dtype,
+        "attn_implementation": args.attn_implementation,
+        "torch": torch.__version__,
+        "transformers": transformers.__version__,
+        "torch_num_threads": torch.get_num_threads(),
+    }
+    started = time.time()
+    try:
+        model, info = Qwen3_5ForConditionalGeneration.from_pretrained(
+            args.assets_dir,
+            dtype=dtype,
+            local_files_only=True,
+            attn_implementation=args.attn_implementation,
+            output_loading_info=True,
+        )
+        report["loading_info"] = {
+            key: sorted(value) if isinstance(value, (list, tuple, set)) else value
+            for key, value in info.items()
+        }
+        report["status"] = "ok"
+    except Exception as exc:  # noqa: BLE001 - 需要把失败原文写入证据
+        report["status"] = "failed"
+        report["error"] = "%s: %s" % (type(exc).__name__, exc)
+        with open(args.out, "w", encoding="utf-8") as handle:
+            json.dump(report, handle, ensure_ascii=False, indent=2)
+        raise
+    report["load_seconds"] = round(time.time() - started, 3)
+
+    named = dict(model.named_parameters())
+    tied = {
+        "lm_head.weight": model.lm_head.weight.data_ptr()
+        == model.model.language_model.embed_tokens.weight.data_ptr(),
+        "tie_word_embeddings_config": bool(model.config.tie_word_embeddings),
+    }
+    report["tied_weights"] = tied
+    report["parameter_count"] = int(sum(p.numel() for p in model.parameters()))
+    report["named_parameter_tensors"] = len(named)
+    report["state_dict_tensors"] = len(model.state_dict())
+    report["dtypes_observed"] = sorted({str(p.dtype) for p in model.parameters()})
+    report["layer_types"] = list(model.config.text_config.layer_types)
+    report["has_visual"] = hasattr(model.model, "visual")
+    report["has_mtp"] = any(key.startswith("mtp.") for key in model.state_dict())
+
+    with open(args.out, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, ensure_ascii=False, indent=2)
+    print("[loading] wrote %s status=%s" % (args.out, report["status"]), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
