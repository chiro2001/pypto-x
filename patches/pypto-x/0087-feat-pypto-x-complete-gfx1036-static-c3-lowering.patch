+def _c3_validate_math(operation: Operation, name: str) -> None:
+    if len(operation.inputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires one input".format(name))
+    output = _c2_one_output(operation, name)
+    input_ref = operation.inputs[0]
+    if not (_is_tensor(input_ref.type) or input_ref.type.kind == "scalar"):
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires tensor/scalar input".format(name))
+    if not (_is_tensor(output.type) or output.type.kind == "scalar"):
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires tensor/scalar output".format(name))
+    input_dtype, input_shape = _c2_storage_ref(input_ref, "{} input".format(name))
+    output_dtype, output_shape = _c2_storage_ref(output, "{} output".format(name))
+    if input_dtype not in _C2_FLOAT_DTYPES or input_dtype != output_dtype:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires matching FP32/BF16 storage".format(name))
+    if input_ref.type.kind != output.type.kind or input_shape != output_shape:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires matching input/output kind and shape".format(name))
