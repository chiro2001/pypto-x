+#!/usr/bin/env python3
+"""Full Qwen3.5 AMD gfx1036 C3 static-lowering evidence.
+
+This driver performs one complete ``AmdgpuStaticCompiler.lower`` call for the
+fixed no-weight Qwen profile.  It intentionally does not compile/link the
+4,532-kernel LLVM module, allocate checkpoint bytes, or invoke HIP.  Run the
+driver through ``run_local_heavy.sh`` with the task-specific 4 GiB/4 CPU
+limits; the wrapper owns the resource admission and runtime monitor.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import resource
+import time
+from collections import Counter
+from pathlib import Path
+
+from pypto.backends.hip import probe_amd_hip_runtime
+from pypto.compiler.targets.hip import AmdgpuStaticCompiler
+from pypto.lowering.cpu import canonical_operation_name
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.target import AMDGCN_PROCESSOR, AMDGCN_TRIPLE, AMD_IGPU_GFX1036
+
+
+def build_report(batch: int, steps: int, past_length: int):
+    program = build_qwen35_text_decoder_graph(batch, steps, past_length=past_length)
+    operations = tuple(program.functions[0].body.operations)
+    counts = Counter(canonical_operation_name(operation.name) for operation in operations)
+    compiler = AmdgpuStaticCompiler()
+    started = time.monotonic()
+    lowered = compiler.lower(program, AMD_IGPU_GFX1036)
+    elapsed = time.monotonic() - started
+    plans = tuple(lowered.gpu_program.plans)
+    ir_bytes = len(lowered.llvm_ir.encode("utf-8"))
+    max_complexity = max((len(plan.canonical_json()) for plan in plans), default=0)
+    rss_mib = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024.0
+    runtime = probe_amd_hip_runtime()
+    return {
+        "audit": "qwen35-text-decoder-amd-gfx1036-static-c3-full-lower",
+        "static_only": True,
+        "weights_loaded": False,
+        "native_kernels_generated": False,
+        "native_execution_claim": False,
+        "profile": {"batch": batch, "steps": steps, "past_length": past_length},
+        "target": {
+            "name": "amd-igpu-gfx1036",
+            "processor": AMDGCN_PROCESSOR,
+            "triple": AMDGCN_TRIPLE,
+            "runtime_status": runtime.to_dict(),
+        },
+        "operation_total": len(operations),
+        "plan_total": len(plans),
+        "kernel_total": len(plans),
+        "canonical_operation_counts": dict(sorted(counts.items())),
+        "static_lower_complete": len(plans) == len(operations),
+        "llvm_ir_bytes": ir_bytes,
+        "descriptor_complexity": {
+            "plan_storage": "O(rank+segments)",
+            "max_operation_ir_bytes": max_complexity,
+            "numel_expanded_metadata": False,
+        },
+        "resource": {
+            "lower_seconds": elapsed,
+            "max_rss_mib": rss_mib,
+        },
+        "notes": [
+            "This is one full compiler.lower call; no per-operation substitution is used.",
+            "No LLVM object/link step is performed for the full graph.",
+            "Runtime remains BLOCKED_DEVICE because WSL has no /dev/kfd/HIP/HSA runtime.",
+        ],
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--batch", type=int, default=1)
+    parser.add_argument("--steps", type=int, default=1)
+    parser.add_argument("--past-length", type=int, default=4096)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    report = build_report(args.batch, args.steps, args.past_length)
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({
+        key: report[key]
+        for key in ("operation_total", "plan_total", "kernel_total", "static_lower_complete", "llvm_ir_bytes", "resource")
+    }, ensure_ascii=False, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
