+def test_c3_representative_objects_have_no_unresolved_symbols(operation, tmp_path):
+    _compiler, _target_ir, artifact = _compile(operation)
+    object_bytes = base64.b64decode(_payload(artifact)["object_b64"])
+    object_path = tmp_path / "kernel.o"
+    object_path.write_bytes(object_bytes)
