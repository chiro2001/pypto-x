@@ -0,0 +1,218 @@
+"""C3 static AMDGPU gfx1036 math/reduction/matmul contract tests.
+
+The tests stop at LLVM/ELF evidence.  They do not claim that the GamePC
+integrated GPU has a Linux HIP runtime; that runtime remains BLOCKED_DEVICE.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import subprocess
+
+import pytest
+
+from pypto.compiler import Artifact
+from pypto.compiler.targets.hip import (
+    AMDGPU_LLVM_IR_VERSION,
+    AMDGPU_LOWERING_VERSION,
+    AmdgpuArtifactError,
+    AmdgpuStaticCompiler,
+    AmdgpuUnsupportedError,
+    decode_amdgpu_artifact,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import AMD_IGPU_GFX1036
+
+
+def _tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, tuple(shape)))
+
+
+def _program(operation):
+    seen = set()
+    parameters = []
+    for ref in operation.inputs:
+        if ref.name not in seen:
+            seen.add(ref.name)
+            parameters.append(ref)
+    return CoreProgram(
+        functions=(CoreFunction("main", tuple(parameters), operation.outputs, Region((operation,))),)
+    )
+
+
+def _compile(operation):
+    compiler = AmdgpuStaticCompiler()
+    target_ir = compiler.lower(_program(operation), AMD_IGPU_GFX1036)
+    return compiler, target_ir, compiler.compile(target_ir)
+
+
+def _payload(artifact):
+    return json.loads(bytes(artifact.payload).decode("utf-8"))
+
+
+def _tamper_version(base, **updates):
+    payload = _payload(base)
+    payload.update(updates)
+    encoded = json.dumps(payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode(
+        "utf-8"
+    )
+    metadata = dict(base.metadata)
+    metadata["payload_digest"] = hashlib.sha256(encoded).hexdigest()
+    return Artifact(
+        format=base.format,
+        entrypoint=base.entrypoint,
+        target=base.target,
+        abi_version=base.abi_version,
+        payload=encoded,
+        metadata=metadata,
+    )
+
+
+@pytest.mark.parametrize("name", ("exp", "rsqrt", "sigmoid", "silu", "softplus"))
+def test_c3_math_has_explicit_edge_classification_and_no_device_library(name):
+    source = _tensor("source", "float32", (7,))
+    output = _tensor("output", "float32", (7,))
+    _compiler, _target_ir, artifact = _compile(Operation(name, (source,), (output,)))
+    ir = _payload(artifact)["llvm_ir"]
+    assert "fcmp uno float" in ir
+    assert "@llvm.exp" not in ir
+    assert "@llvm.sqrt" not in ir
+    assert "@llvm.log" not in ir
+    assert "store float" in ir
+    if name == "exp":
+        assert "fptosi float" in ir
+        assert "2139095040" in ir  # explicit +Inf bit pattern
+    if name == "rsqrt":
+        assert "1597463007" in ir  # explicit Quake-style finite seed
+        assert "8388607" in ir  # NaN/Inf mantissa classification
+    if name in ("sigmoid", "silu"):
+        assert "fdiv float" in ir
+    if name == "softplus":
+        assert "log1p" in ir
+
+
+def test_c3_math_bf16_storage_uses_f32_arithmetic_and_rne_store():
+    source = _tensor("source", "bf16", (5,))
+    output = _tensor("output", "bf16", (5,))
+    _compiler, _target_ir, artifact = _compile(Operation("softplus", (source,), (output,)))
+    ir = _payload(artifact)["llvm_ir"]
+    assert "zext i16" in ir and "bitcast i32" in ir
+    assert "store i16" in ir
+    assert "fcmp uno float" in ir
+
+
+@pytest.mark.parametrize(
+    "name,shape,output_shape,attributes",
+    (
+        ("reduce_sum", (2, 3, 4), (2, 4), {"axis": 1}),
+        ("reduce_max", (2, 3, 4), (2, 1, 1), {"axes": (1, 2), "keepdims": True}),
+        ("reduce_mean", (2, 3, 4), (), {"axes": (0, 1, 2)}),
+    ),
+)
+def test_c3_reduction_is_compact_rank_descriptor_and_all_negative_max_safe(
+    name, shape, output_shape, attributes
+):
+    source = _tensor("source", "float32", shape)
+    output = _tensor("output", "float32", output_shape)
+    _compiler, target_ir, artifact = _compile(Operation(name, (source,), (output,), attributes))
+    ir = _payload(artifact)["llvm_ir"]
+    assert target_ir.gpu_program.plans[0].reduction.reduction_size > 0
+    assert "phi i64" in ir and "phi float" in ir
+    assert "udiv i64" in ir and "urem i64" in ir
+    assert len(ir) < 12000
+    if name == "reduce_max":
+        assert "4286578688" in ir  # -Inf accumulator, not zero
+        assert "fcmp ogt float" in ir
+    if name == "reduce_mean":
+        assert "fdiv float" in ir
+
+
+def test_c3_reduction_rejects_empty_domain_and_invalid_keepdims():
+    source = _tensor("source", "float32", (2, 0, 3))
+    output = _tensor("output", "float32", (2, 3))
+    with pytest.raises(AmdgpuUnsupportedError, match="empty|zero-sized"):
+        AmdgpuStaticCompiler().lower(
+            _program(Operation("reduce_sum", (source,), (output,), {"axis": 1})), AMD_IGPU_GFX1036
+        )
+    source = _tensor("source", "float32", (2, 3))
+    output = _tensor("output", "float32", (2,))
+    with pytest.raises(AmdgpuUnsupportedError, match="keepdims"):
+        AmdgpuStaticCompiler().lower(
+            _program(Operation("reduce_sum", (source,), (output,), {"axis": 1, "keepdims": 1})), AMD_IGPU_GFX1036
+        )
+
+
+@pytest.mark.parametrize(
+    "left_shape,right_shape,output_shape",
+    (
+        ((2, 3), (3, 4), (2, 4)),
+        ((2, 2, 3), (2, 3, 4), (2, 2, 4)),
+        ((2, 2, 2, 3), (2, 2, 3, 4), (2, 2, 2, 4)),
+        ((2, 2, 0), (2, 0, 4), (2, 2, 4)),
+    ),
+)
+def test_c3_matmul_supports_rank_2_to_4_exact_batch_and_k_zero(left_shape, right_shape, output_shape):
+    left = _tensor("left", "bf16", left_shape)
+    right = _tensor("right", "bf16", right_shape)
+    output = _tensor("output", "bf16", output_shape)
+    _compiler, target_ir, artifact = _compile(Operation("matmul", (left, right), (output,)))
+    ir = _payload(artifact)["llvm_ir"]
+    plan = target_ir.gpu_program.plans[0].matmul
+    assert plan is not None
+    assert plan.batch_shape == left_shape[:-2]
+    assert "matmul_batch" in ir and "matmul_k" in ir
+    assert "fadd float" in ir
