+def _emit_f32_from_bits(builder: _IRBuilder, bits: int, prefix: str = "f32bits") -> str:
+    """Materialise an f32 constant without a device-library dependency."""
+
+    raw = builder.temp(prefix + "_raw")
+    value = builder.temp(prefix)
+    builder.line("  {} = add i32 0, {}".format(raw, int(bits) & 0xFFFFFFFF))
+    builder.line("  {} = bitcast i32 {} to float".format(value, raw))
+    return value
+
+
+def _llvm_f32_exact_literal(value: Any) -> str:
+    """Return a decimal literal that is exactly representable as f32."""
+
+    rounded = struct.unpack("<f", struct.pack("<f", float(value)))[0]
+    return repr(rounded)
+
+
+def _emit_exp_f32(builder: _IRBuilder, value: str) -> str:
+    """Emit a finite, explicit expf approximation in LLVM IR.
+
+    The implementation deliberately avoids ``llvm.exp.*`` and libc/device
+    library calls.  Range reduction is to ``[-ln(2), ln(2)]`` followed by an
+    eighth-order Taylor polynomial and an explicitly constructed power of two.
+    Inputs outside the finite f32 range are handled before ``fptosi`` so the
+    generated IR never converts NaN/Inf or an out-of-range value to an integer.
+    """
+
+    nan = builder.temp("exp_nan")
+    safe = builder.temp("exp_safe")
+    low = builder.temp("exp_low")
+    high = builder.temp("exp_high")
+    bounded_low = builder.temp("exp_bounded_low")
+    bounded = builder.temp("exp_bounded")
+    scaled = builder.temp("exp_scaled")
+    exponent = builder.temp("exp_exponent")
+    exponent_f32 = builder.temp("exp_exponent_f32")
+    reduced = builder.temp("exp_reduced")
+    builder.line("  {} = fcmp uno float {}, {}".format(nan, value, value))
+    builder.line(
+        "  {} = select i1 {}, float {}, float {}".format(
+            safe, nan, _llvm_f32_literal(0.0), value
+        )
+    )
+    low_bound = _llvm_f32_literal(-103.97208404541016)
+    high_bound = _llvm_f32_literal(88.72283935546875)
+    builder.line("  {} = fcmp olt float {}, {}".format(low, safe, low_bound))
+    builder.line("  {} = fcmp ogt float {}, {}".format(high, safe, high_bound))
+    builder.line(
+        "  {} = select i1 {}, float {}, float {}".format(
+            bounded_low, low, low_bound, safe
+        )
+    )
+    builder.line(
+        "  {} = select i1 {}, float {}, float {}".format(
+            bounded, high, high_bound, bounded_low
+        )
+    )
+    builder.line(
+        "  {} = fmul float {}, {}".format(
+            scaled, bounded, _llvm_f32_literal(1.4426950408889634)
+        )
+    )
+    # bounded is within [-104, 89], so this conversion is defined and the
+    # integer range is small enough for the bit-level scale construction.
+    builder.line("  {} = fptosi float {} to i32".format(exponent, scaled))
+    builder.line("  {} = sitofp i32 {} to float".format(exponent_f32, exponent))
+    reduced_scale_mul = builder.temp("exp_reduced_scale_mul")
+    builder.line(
+        "  {} = fmul float {}, {}".format(
+            reduced_scale_mul, exponent_f32, _llvm_f32_literal(0.6931471805599453)
+        )
+    )
+    builder.line("  {} = fsub float {}, {}".format(reduced, bounded, reduced_scale_mul))
+
+    # Horner form for exp(reduced).  Keeping every operation explicit makes
+    # the IR auditable and prevents fast-math flags from changing edge cases.
+    polynomial = _llvm_f32_exact_literal(1.0 / 40320.0)
+    for coefficient in (
+        1.0 / 5040.0,
+        1.0 / 720.0,
+        1.0 / 120.0,
+        1.0 / 24.0,
+        1.0 / 6.0,
+        0.5,
+        1.0,
+    ):
+        multiplied = builder.temp("exp_poly_mul")
+        updated = builder.temp("exp_poly")
+        builder.line("  {} = fmul float {}, {}".format(multiplied, reduced, polynomial))
+        builder.line("  {} = fadd float {}, {}".format(updated, multiplied, _llvm_f32_exact_literal(coefficient)))
+        polynomial = updated
+    multiplied = builder.temp("exp_poly_mul")
+    finite = builder.temp("exp_finite")
+    builder.line("  {} = fmul float {}, {}".format(multiplied, reduced, polynomial))
+    builder.line("  {} = fadd float {}, {}".format(finite, multiplied, _llvm_f32_literal(1.0)))
+
+    normal = builder.temp("exp_normal")
+    exponent_plus = builder.temp("exp_exponent_plus")
+    exponent_plus_safe = builder.temp("exp_exponent_plus_safe")
+    normal_bits = builder.temp("exp_normal_bits")
+    builder.line("  {} = icmp sge i32 {}, -126".format(normal, exponent))
+    builder.line("  {} = add i32 {}, 127".format(exponent_plus, exponent))
+    builder.line(
+        "  {} = select i1 {}, i32 {}, i32 0".format(
+            exponent_plus_safe, normal, exponent_plus
+        )
+    )
+    builder.line("  {} = shl i32 {}, 23".format(normal_bits, exponent_plus_safe))
+
+    sub_shift = builder.temp("exp_sub_shift")
+    sub_below = builder.temp("exp_sub_below")
+    sub_above = builder.temp("exp_sub_above")
+    sub_shift_safe_low = builder.temp("exp_sub_shift_safe_low")
+    sub_shift_safe = builder.temp("exp_sub_shift_safe")
+    sub_bits = builder.temp("exp_sub_bits")
+    one = builder.temp("exp_one")
+    builder.line("  {} = add i32 {}, 149".format(sub_shift, exponent))
+    builder.line("  {} = icmp slt i32 {}, -149".format(sub_below, exponent))
+    builder.line("  {} = icmp sgt i32 {}, -127".format(sub_above, exponent))
+    builder.line(
+        "  {} = select i1 {}, i32 0, i32 {}".format(
+            sub_shift_safe_low, sub_below, sub_shift
+        )
+    )
+    builder.line(
+        "  {} = select i1 {}, i32 0, i32 {}".format(
+            sub_shift_safe, sub_above, sub_shift_safe_low
+        )
+    )
+    builder.line("  {} = add i32 0, 1".format(one))
+    builder.line("  {} = shl i32 {}, {}".format(sub_bits, one, sub_shift_safe))
+    scale_bits = builder.temp("exp_scale_bits")
+    scale = builder.temp("exp_scale")
+    builder.line("  {} = select i1 {}, i32 {}, i32 {}".format(scale_bits, normal, normal_bits, sub_bits))
+    builder.line("  {} = bitcast i32 {} to float".format(scale, scale_bits))
+    scaled_finite = builder.temp("exp_scaled_finite")
+    builder.line("  {} = fmul float {}, {}".format(scaled_finite, finite, scale))
+    zero = _llvm_f32_literal(0.0)
+    infinity = _emit_f32_from_bits(builder, 0x7F800000, "exp_inf")
+    bounded_result = builder.temp("exp_bounded_result")
+    high_result = builder.temp("exp_high_result")
+    result = builder.temp("exp_result")
+    builder.line("  {} = select i1 {}, float {}, float {}".format(bounded_result, low, zero, scaled_finite))
+    builder.line("  {} = select i1 {}, float {}, float {}".format(high_result, high, infinity, bounded_result))
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result, nan, value, high_result))
+    return result
+
+
+def _emit_log1p_nonnegative_f32(builder: _IRBuilder, value: str) -> str:
+    """Compute log(1+x), x in [0, 1], with an explicit atanh series."""
+
+    denominator = builder.temp("log1p_denominator")
+    ratio = builder.temp("log1p_ratio")
+    builder.line("  {} = fadd float {}, {}".format(denominator, value, _llvm_f32_literal(2.0)))
+    builder.line("  {} = fdiv float {}, {}".format(ratio, value, denominator))
+    # log(1+x) = 2 * (t + t^3/3 + ...), t=x/(2+x).  For x<=1 the
+    # geometric convergence is fast and needs no external math routine.
+    result = builder.temp("log1p_result")
+    builder.line("  {} = fadd float {}, {}".format(result, ratio, _llvm_f32_literal(0.0)))
+    power = ratio
+    for denominator_value in (3.0, 5.0, 7.0, 9.0, 11.0, 13.0, 15.0, 17.0):
+        square = builder.temp("log1p_square")
+        power_next = builder.temp("log1p_power")
+        term = builder.temp("log1p_term")
+        updated = builder.temp("log1p_sum")
+        builder.line("  {} = fmul float {}, {}".format(square, ratio, ratio))
+        builder.line("  {} = fmul float {}, {}".format(power_next, power, square))
+        builder.line("  {} = fdiv float {}, {}".format(term, power_next, _llvm_f32_literal(denominator_value)))
+        builder.line("  {} = fadd float {}, {}".format(updated, result, term))
+        result = updated
+        power = power_next
+    doubled = builder.temp("log1p_doubled")
+    builder.line("  {} = fmul float {}, {}".format(doubled, result, _llvm_f32_literal(2.0)))
+    return doubled
+
+
+def _emit_rsqrt_f32(builder: _IRBuilder, value: str) -> str:
+    """Emit a total rsqrt path with explicit zero/negative handling."""
+
+    nan = builder.temp("rsqrt_nan")
+    bits = builder.temp("rsqrt_bits")
+    sign = builder.temp("rsqrt_sign")
+    exponent = builder.temp("rsqrt_exponent")
+    mantissa = builder.temp("rsqrt_mantissa")
+    is_inf = builder.temp("rsqrt_inf")
+    negative = builder.temp("rsqrt_negative")
+    zero = builder.temp("rsqrt_zero")
+    finite_positive = builder.temp("rsqrt_finite_positive")
+    safe = builder.temp("rsqrt_safe")
+    builder.line("  {} = fcmp uno float {}, {}".format(nan, value, value))
+    builder.line("  {} = bitcast float {} to i32".format(bits, value))
+    builder.line("  {} = and i32 {}, -2147483648".format(sign, bits))
+    builder.line("  {} = and i32 {}, 2139095040".format(exponent, bits))
+    builder.line("  {} = and i32 {}, 8388607".format(mantissa, bits))
+    exponent_full = builder.temp("rsqrt_exponent_full")
+    mantissa_nonzero = builder.temp("rsqrt_mantissa_nonzero")
+    builder.line("  {} = icmp eq i32 {}, 2139095040".format(exponent_full, exponent))
+    builder.line("  {} = icmp ne i32 {}, 0".format(mantissa_nonzero, mantissa))
+    mantissa_zero = builder.temp("rsqrt_mantissa_zero")
+    builder.line("  {} = xor i1 {}, true".format(mantissa_zero, mantissa_nonzero))
+    builder.line("  {} = and i1 {}, {}".format(is_inf, exponent_full, mantissa_zero))
+    builder.line("  {} = icmp ne i32 {}, 0".format(negative, sign))
+    builder.line("  {} = fcmp oeq float {}, {}".format(zero, value, _llvm_f32_literal(0.0)))
+    positive = builder.temp("rsqrt_positive")
+    builder.line("  {} = fcmp ogt float {}, {}".format(positive, value, _llvm_f32_literal(0.0)))
+    not_inf = builder.temp("rsqrt_not_inf")
+    builder.line("  {} = xor i1 {}, true".format(not_inf, is_inf))
+    builder.line("  {} = and i1 {}, {}".format(finite_positive, positive, not_inf))
+    builder.line("  {} = select i1 {}, float {}, float {}".format(safe, finite_positive, value, _llvm_f32_literal(1.0)))
+
+    safe_bits = builder.temp("rsqrt_safe_bits")
+    shifted = builder.temp("rsqrt_shifted")
+    magic = builder.temp("rsqrt_magic")
+    estimate = builder.temp("rsqrt_estimate")
+    builder.line("  {} = bitcast float {} to i32".format(safe_bits, safe))
+    builder.line("  {} = lshr i32 {}, 1".format(shifted, safe_bits))
+    builder.line("  {} = sub i32 1597463007, {}".format(magic, shifted))
+    builder.line("  {} = bitcast i32 {} to float".format(estimate, magic))
+    current = estimate
+    for _ in range(3):
+        square = builder.temp("rsqrt_square")
+        product = builder.temp("rsqrt_product")
+        half_product = builder.temp("rsqrt_half_product")
+        correction = builder.temp("rsqrt_correction")
+        updated = builder.temp("rsqrt_updated")
+        builder.line("  {} = fmul float {}, {}".format(square, current, current))
+        builder.line("  {} = fmul float {}, {}".format(product, safe, square))
+        builder.line("  {} = fmul float {}, {}".format(half_product, product, _llvm_f32_literal(0.5)))
+        builder.line("  {} = fsub float {}, {}".format(correction, _llvm_f32_literal(1.5), half_product))
+        builder.line("  {} = fmul float {}, {}".format(updated, current, correction))
+        current = updated
+    qnan = _emit_f32_from_bits(builder, 0x7FC00000, "rsqrt_qnan")
+    signed_infinity_bits = builder.temp("rsqrt_signed_inf_bits")
+    signed_infinity = builder.temp("rsqrt_signed_inf")
+    builder.line("  {} = or i32 2139095040, {}".format(signed_infinity_bits, sign))
+    builder.line("  {} = bitcast i32 {} to float".format(signed_infinity, signed_infinity_bits))
+    negative_nonzero = builder.temp("rsqrt_negative_nonzero")
+    builder.line("  {} = and i1 {}, true".format(negative_nonzero, negative))
+    result_non_nan = builder.temp("rsqrt_result_non_nan")
+    result_not_negative = builder.temp("rsqrt_result_not_negative")
+    result_not_zero = builder.temp("rsqrt_result_not_zero")
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result_non_nan, negative_nonzero, qnan, current))
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result_not_negative, zero, signed_infinity, result_non_nan))
+    # For nonzero negative values, negative_nonzero selects qNaN.  For zero,
+    # the signed infinity result must win; positive zero also receives +Inf.
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result_not_zero, zero, signed_infinity, result_not_negative))
+    # Materialise the complement once so negative infinity remains an invalid
+    # negative input while positive infinity maps to zero.
+    positive_inf = builder.temp("rsqrt_positive_inf")
+    not_negative = builder.temp("rsqrt_not_negative")
+    builder.line("  {} = xor i1 {}, true".format(not_negative, negative))
+    builder.line("  {} = and i1 {}, {}".format(positive_inf, is_inf, not_negative))
+    result_inf = builder.temp("rsqrt_result_inf")
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result_inf, positive_inf, _llvm_f32_literal(0.0), result_not_zero))
+    result = builder.temp("rsqrt_result")
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result, nan, value, result_inf))
+    return result
+
+
+def _emit_sigmoid_f32(builder: _IRBuilder, value: str) -> str:
+    nan = builder.temp("sigmoid_nan")
+    nonnegative = builder.temp("sigmoid_nonnegative")
+    negated = builder.temp("sigmoid_negated")
+    builder.line("  {} = fcmp uno float {}, {}".format(nan, value, value))
+    builder.line("  {} = fcmp oge float {}, {}".format(nonnegative, value, _llvm_f32_literal(0.0)))
+    builder.line("  {} = fsub float {}, {}".format(negated, _llvm_f32_literal(0.0), value))
+    positive_exp = _emit_exp_f32(builder, negated)
+    negative_exp = _emit_exp_f32(builder, value)
+    positive_denominator = builder.temp("sigmoid_positive_denominator")
+    negative_denominator = builder.temp("sigmoid_negative_denominator")
+    positive_result = builder.temp("sigmoid_positive_result")
+    negative_result = builder.temp("sigmoid_negative_result")
+    selected = builder.temp("sigmoid_selected")
+    result = builder.temp("sigmoid_result")
+    builder.line("  {} = fadd float {}, {}".format(positive_denominator, _llvm_f32_literal(1.0), positive_exp))
+    builder.line("  {} = fadd float {}, {}".format(negative_denominator, _llvm_f32_literal(1.0), negative_exp))
+    builder.line("  {} = fdiv float {}, {}".format(positive_result, _llvm_f32_literal(1.0), positive_denominator))
+    builder.line("  {} = fdiv float {}, {}".format(negative_result, negative_exp, negative_denominator))
+    builder.line("  {} = select i1 {}, float {}, float {}".format(selected, nonnegative, positive_result, negative_result))
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result, nan, value, selected))
+    return result
+
+
+def _emit_math_c3(builder: _IRBuilder, operation: Operation, index: str) -> None:
+    name = canonical_operation_name(operation.name)
+    dtype = canonical_dtype(operation.outputs[0].type.dtype)
+    input_shape = _value_shape(operation.inputs[0].type, "{} input".format(name))
+    output_shape = _value_shape(operation.outputs[0].type, "{} output".format(name))
+    source_index = _emit_broadcast_index(builder, index, input_shape, output_shape)
+    value = _emit_load_f32(builder, "%arg0", source_index, dtype)
+    if name == "exp":
+        result = _emit_exp_f32(builder, value)
+    elif name == "rsqrt":
+        result = _emit_rsqrt_f32(builder, value)
+    elif name == "sigmoid":
+        result = _emit_sigmoid_f32(builder, value)
+    elif name == "silu":
+        sigmoid = _emit_sigmoid_f32(builder, value)
+        result = builder.temp("silu_result")
+        builder.line("  {} = fmul float {}, {}".format(result, value, sigmoid))
+    elif name == "softplus":
+        nan = builder.temp("softplus_nan")
+        negative = builder.temp("softplus_negative")
+        negated = builder.temp("softplus_negated")
+        absolute = builder.temp("softplus_absolute")
+        positive_part = builder.temp("softplus_positive_part")
+        builder.line("  {} = fcmp uno float {}, {}".format(nan, value, value))
+        builder.line("  {} = fcmp olt float {}, {}".format(negative, value, _llvm_f32_literal(0.0)))
+        builder.line("  {} = fsub float {}, {}".format(negated, _llvm_f32_literal(0.0), value))
+        builder.line("  {} = select i1 {}, float {}, float {}".format(absolute, negative, negated, value))
+        neg_absolute = builder.temp("softplus_neg_absolute")
+        builder.line("  {} = fsub float {}, {}".format(neg_absolute, _llvm_f32_literal(0.0), absolute))
+        exponential = _emit_exp_f32(builder, neg_absolute)
+        logarithm = _emit_log1p_nonnegative_f32(builder, exponential)
+        builder.line("  {} = select i1 {}, float {}, float {}".format(positive_part, negative, _llvm_f32_literal(0.0), value))
+        combined = builder.temp("softplus_combined")
+        result = builder.temp("softplus_result")
+        builder.line("  {} = fadd float {}, {}".format(combined, positive_part, logarithm))
+        builder.line("  {} = select i1 {}, float {}, float {}".format(result, nan, value, combined))
+    else:
+        raise AmdgpuUnsupportedError("static AMDGPU math emitter has no operation {!r}".format(name))
+    _emit_store_f32(builder, "%arg1", index, dtype, result)
+
+
