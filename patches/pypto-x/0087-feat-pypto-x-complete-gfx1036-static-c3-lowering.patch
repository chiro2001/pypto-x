@@ -0,0 +1,287 @@
+#!/usr/bin/env python3
+"""Independent C3 LLVM/object/oracle audit for AMD gfx1036 static lowering."""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import subprocess
+import tempfile
+from pathlib import Path
+
+from pypto.backends.hip import probe_amd_hip_runtime
+from pypto.compiler import Artifact
+from pypto.compiler.targets.hip import (
+    AMDGPU_LLVM_IR_VERSION,
+    AMDGPU_LOWERING_VERSION,
+    AmdgpuArtifactError,
+    AmdgpuStaticCompiler,
+    decode_amdgpu_artifact,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import AMDGCN_PROCESSOR, AMDGCN_TRIPLE, AMD_IGPU_GFX1036
+
+
+def _tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, tuple(shape)))
+
+
+def _product(values):
+    result = 1
+    for value in values:
+        result *= int(value)
+    return result
+
+
+def _program(operation):
+    seen = set()
+    parameters = []
+    for ref in operation.inputs:
+        if ref.name not in seen:
+            seen.add(ref.name)
+            parameters.append(ref)
+    return CoreProgram(
+        functions=(CoreFunction("main", tuple(parameters), operation.outputs, Region((operation,))),)
+    )
+
+
+def _compile(operation):
+    compiler = AmdgpuStaticCompiler()
+    target_ir = compiler.lower(_program(operation), AMD_IGPU_GFX1036)
+    return compiler, target_ir, compiler.compile(target_ir)
+
+
+def _payload(artifact):
+    return json.loads(bytes(artifact.payload).decode("utf-8"))
+
+
+def _object_evidence(artifact):
+    object_bytes = base64.b64decode(_payload(artifact)["object_b64"])
+    with tempfile.NamedTemporaryFile(prefix="pypto-x-c3-", suffix=".o") as handle:
+        handle.write(object_bytes)
+        handle.flush()
+        nm = subprocess.run(["llvm-nm", "-u", handle.name], check=True, capture_output=True, text=True)
+        objdump = subprocess.run(["llvm-objdump", "-d", handle.name], check=True, capture_output=True, text=True)
+        readobj = subprocess.run(["llvm-readobj", "-h", handle.name], check=True, capture_output=True, text=True)
+    return {
+        "unresolved_symbols": tuple(line for line in nm.stdout.splitlines() if line.strip()),
+        "objdump_has_text": ".text" in objdump.stdout and "v_" in objdump.stdout,
+        "readobj_format": "elf64-amdgpu" in readobj.stdout,
+        "readobj_gfx1036": "GFX1036" in readobj.stdout.upper(),
+    }
+
+
+def _rebuild_version(base, **updates):
+    payload = _payload(base)
+    payload.update(updates)
+    encoded = json.dumps(payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode(
+        "utf-8"
+    )
+    metadata = dict(base.metadata)
+    metadata["payload_digest"] = hashlib.sha256(encoded).hexdigest()
+    return Artifact(
+        format=base.format,
+        entrypoint=base.entrypoint,
+        target=base.target,
+        abi_version=base.abi_version,
+        payload=encoded,
+        metadata=metadata,
+    )
+
+
+def _matmul_oracle(left_shape, right_shape):
+    batch_shape = left_shape[:-2]
+    m, k = left_shape[-2:]
+    n = right_shape[-1]
+    left = [float(index + 1) for index in range(_product(left_shape))]
+    right = [float(1 + (index % 7)) for index in range(_product(right_shape))]
+    matrix = m * n
+    left_matrix = m * k
+    right_matrix = k * n
+    values = []
+    for output_index in range(_product(batch_shape) * matrix):
+        batch, matrix_index = divmod(output_index, matrix)
+        row, col = divmod(matrix_index, n)
+        values.append(
+            sum(
+                left[batch * left_matrix + row * k + counter]
+                * right[batch * right_matrix + counter * n + col]
+                for counter in range(k)
+            )
+        )
+    return values
+
+
+def _reduction_oracle(shape, axes, keepdims):
+    output_shape = []
+    for axis, dimension in enumerate(shape):
+        if axis in axes:
+            if keepdims:
+                output_shape.append(1)
+        else:
+            output_shape.append(dimension)
+    output_count = _product(output_shape) if output_shape else 1
+    input_strides = []
+    running = 1
+    for dimension in reversed(shape):
+        input_strides.append(running)
+        running *= dimension
+    input_strides.reverse()
+    reduction_domain = _product(shape[axis] for axis in axes) if axes else 1
+    domains = []
+    for output_index in range(output_count):
+        remaining = output_index
+        coordinates = [0] * len(output_shape)
+        for axis in range(len(output_shape) - 1, -1, -1):
+            coordinates[axis] = remaining % output_shape[axis]
+            remaining //= output_shape[axis]
+        cursor = 0
+        input_base = [0] * len(shape)
+        for axis in range(len(shape)):
+            if axis in axes:
+                continue
+            input_base[axis] = coordinates[axis] if keepdims else coordinates[cursor]
+            cursor += 1
+        flattened = []
+        for reduction_index in range(reduction_domain):
+            remainder = reduction_index
+            for reduced_axis_position, axis in enumerate(reversed(axes)):
+                dimension = shape[axis]
+                coordinate = remainder % dimension
+                remainder //= dimension
+                input_base[axis] = coordinate
+            flattened.append(sum(coordinate * stride for coordinate, stride in zip(input_base, input_strides)))
+        domains.append(flattened)
+    return output_shape, domains
+
+
+def build_report():
+    compiler = AmdgpuStaticCompiler()
+    records = {}
+    math_edges = {
+        "nan": "NaN preserved/quieted by ordered-unordered guard",
+        "+inf": "+Inf maps to +Inf for exp/softplus and one for sigmoid",
+        "-inf": "-Inf maps to zero for exp/sigmoid/softplus",
+        "+0": "positive zero has finite exp/sigmoid/softplus result",
+        "-0": "signed zero is classified before rsqrt zero handling",
+        "negative_rsqrt": "finite negative rsqrt maps to canonical qNaN",
+    }
+    for name in ("exp", "rsqrt", "sigmoid", "silu", "softplus"):
+        source = _tensor("source", "float32", (7,))
+        output = _tensor("output", "float32", (7,))
+        _compiler, target_ir, artifact = _compile(Operation(name, (source,), (output,)))
+        ir = _payload(artifact)["llvm_ir"]
+        evidence = _object_evidence(artifact)
+        decode_amdgpu_artifact(artifact)
+        records[name] = {
+            "llvm_ir_bytes": len(ir.encode("utf-8")),
+            "object_bytes": len(base64.b64decode(_payload(artifact)["object_b64"])),
+            "unresolved_symbols": list(evidence["unresolved_symbols"]),
+            "objdump_has_text": evidence["objdump_has_text"],
+            "readobj_format": evidence["readobj_format"],
+            "readobj_gfx1036": evidence["readobj_gfx1036"],
+            "has_unordered_guard": "fcmp uno float" in ir,
+            "has_external_math_declaration": any(token in ir for token in ("@llvm.exp", "@llvm.sqrt", "@llvm.log")),
+            "plan_kind": target_ir.gpu_program.plans[0].plan_kind,
+        }
+
+    reduction_cases = {
+        "sum_axis_1": ("reduce_sum", (2, 3, 4), (2, 4), {"axis": 1}),
+        "max_axes_1_2_keep": ("reduce_max", (2, 3, 4), (2, 1, 1), {"axes": (1, 2), "keepdims": True}),
+        "mean_all": ("reduce_mean", (2, 3, 4), (), {"axes": (0, 1, 2)}),
+    }
+    reductions = {}
+    for key, (name, shape, output_shape, attributes) in reduction_cases.items():
+        source = _tensor("source", "float32", shape)
+        output = _tensor("output", "float32", output_shape)
+        _compiler, target_ir, artifact = _compile(Operation(name, (source,), (output,), attributes))
+        ir = _payload(artifact)["llvm_ir"]
+        decode_amdgpu_artifact(artifact)
+        oracle_shape, domains = _reduction_oracle(shape, tuple(attributes.get("axes", (attributes.get("axis"),))), bool(attributes.get("keepdims", False)))
+        evidence = _object_evidence(artifact)
+        reductions[key] = {
+            "oracle_output_shape": oracle_shape,
+            "oracle_first_domain": domains[0],
+            "llvm_index_tokens": {token: token in ir for token in ("udiv i64", "urem i64", "phi i64", "phi float")},
+            "unresolved_symbols": list(evidence["unresolved_symbols"]),
+            "objdump_has_text": evidence["objdump_has_text"],
+            "readobj_format": evidence["readobj_format"],
+            "readobj_gfx1036": evidence["readobj_gfx1036"],
+            "llvm_ir_bytes": len(ir.encode("utf-8")),
+        }
+
+    matmul_cases = {
+        "rank2_asymmetric": ((2, 3), (3, 4), (2, 4)),
+        "rank3_asymmetric": ((2, 3, 5), (2, 5, 4), (2, 3, 4)),
+        "rank4_asymmetric": ((2, 2, 3, 5), (2, 2, 5, 4), (2, 2, 3, 4)),
+        "rank3_k_zero": ((2, 3, 0), (2, 0, 4), (2, 3, 4)),
+    }
+    matmuls = {}
+    for key, (left_shape, right_shape, output_shape) in matmul_cases.items():
+        left = _tensor("left", "float32", left_shape)
+        right = _tensor("right", "float32", right_shape)
+        output = _tensor("output", "float32", output_shape)
+        _compiler, target_ir, artifact = _compile(Operation("matmul", (left, right), (output,)))
+        ir = _payload(artifact)["llvm_ir"]
+        decode_amdgpu_artifact(artifact)
+        evidence = _object_evidence(artifact)
+        oracle = _matmul_oracle(left_shape, right_shape)
+        matmuls[key] = {
+            "oracle_output_sample": oracle[: min(4, len(oracle))],
+            "k": left_shape[-1],
+            "batch_shape": list(left_shape[:-2]),
+            "llvm_index_tokens": {token: token in ir for token in ("matmul_batch", "udiv i64", "urem i64", "matmul_k")},
+            "unresolved_symbols": list(evidence["unresolved_symbols"]),
+            "objdump_has_text": evidence["objdump_has_text"],
+            "readobj_format": evidence["readobj_format"],
+            "readobj_gfx1036": evidence["readobj_gfx1036"],
+            "llvm_ir_bytes": len(ir.encode("utf-8")),
+        }
+
+    source = _tensor("source", "float32", (5,))
+    output = _tensor("output", "float32", (5,))
+    _compiler, _target_ir, base = _compile(Operation("identity", (source,), (output,)))
+    rejected_versions = 0
+    for updates in (
+        {"artifact_payload_version": 1},
+        {"artifact_payload_version": 2},
+        {"amdgpu_lowering_version": 1},
+        {"amdgpu_lowering_version": 2},
+        {"llvm_ir_version": "llvm.amdgcn.v1"},
+        {"llvm_ir_version": "llvm.amdgcn.v2"},
+    ):
+        try:
+            decode_amdgpu_artifact(_rebuild_version(base, **updates))
+        except AmdgpuArtifactError:
+            rejected_versions += 1
+    return {
+        "audit": "amd-gfx1036-static-c3-independent-validation",
+        "target": {"processor": AMDGCN_PROCESSOR, "triple": AMDGCN_TRIPLE},
+        "version": {"amdgpu_lowering": AMDGPU_LOWERING_VERSION, "llvm_ir": AMDGPU_LLVM_IR_VERSION},
+        "math_edge_oracle": math_edges,
+        "math": records,
+        "reduction": reductions,
+        "matmul": matmuls,
+        "old_v1_v2_rejected": rejected_versions == 6,
+        "old_version_rejection_count": rejected_versions,
+        "runtime": probe_amd_hip_runtime().to_dict(),
+        "static_only": True,
+        "native_execution_claim": False,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    report = build_report()
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"pass": report["old_v1_v2_rejected"], "output": str(output)}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
