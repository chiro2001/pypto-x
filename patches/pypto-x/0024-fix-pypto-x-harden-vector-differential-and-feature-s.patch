+def test_feature_source_is_idempotent_across_artifact_decode_and_relower():
+    target = TargetSpec(
+        "cpu",
+        "x86_64-linux-gnu",
+        features=("avx2",),
+        attributes={"lane_count": 4},
+    )
+    required = CpuFeatureSet(("fma",), source="compiler+target")
+    compiler = CpuVectorCompiler()
+    target_ir = lower_cpu_vector(_add_program(), target, required_features=required)
+    assert target_ir.required_features.source == "compiler+target"
+    artifact = compiler.compile(target_ir)
+    loaded = CpuVectorRuntime(
