diff --git a/python/pypto/lowering/cpu/vector/plan.py b/python/pypto/lowering/cpu/vector/plan.py
index 84269a2c2..9a1e1659f 100644
--- a/python/pypto/lowering/cpu/vector/plan.py
+++ b/python/pypto/lowering/cpu/vector/plan.py
@@ -116,6 +116,23 @@ def _normalise_names(values: Any, field: str) -> Tuple[str, ...]:
     return tuple(sorted(names))
 
 
+def _combine_feature_sources(*sources: str) -> str:
+    """Return a canonical, idempotent ``+``-joined source description."""
+
+    tokens = set()
+    for source in sources:
+        if not isinstance(source, str):
+            raise CpuVectorValidationError("feature source must be a string")
+        for token in source.split("+"):
+            token = token.strip().lower()
+            if token:
+                tokens.add(token)
+    if not tokens:
+        return "target"
+    priority = {"compiler": 0, "target": 1}
+    return "+".join(sorted(tokens, key=lambda token: (priority.get(token, 2), token)))
+
+
 @dataclass(frozen=True, init=False)
 class CpuFeatureSet:
     """Immutable, injected CPU capability names.
@@ -633,16 +650,14 @@ def _target_required_features(target: TargetSpec, required: Any) -> CpuFeatureSe
     ).features
     if required is None:
         explicit_features = ()
-        source = "target"
+        source = _combine_feature_sources("target")
     elif isinstance(required, CpuFeatureSet):
         explicit_features = required.features
-        source = required.source
+        source = _combine_feature_sources(required.source, "target")
     else:
         explicit_features = CpuFeatureSet(required, source="compiler").features
-        source = "compiler"
+        source = _combine_feature_sources("compiler", "target")
     combined = target_features + attribute_features + explicit_features
-    if explicit_features and source != "target":
-        source = source + "+target"
     return CpuFeatureSet(combined, source=source)
 
 
