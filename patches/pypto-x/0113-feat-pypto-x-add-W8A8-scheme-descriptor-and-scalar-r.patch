+@dataclass(frozen=True)
+class QuantizedTensorDesc:
+    """W8A8-linear 量化张量的目标无关描述符（契约 §3.3）。
+
+    只描述公共语义：signed INT8、对称 zero-point=0、FP32 scale。物理
+    packing（VNNI/SDOT/dp4a 等）不属于公共 IR，因此这里没有相关字段。
+
+    ``granularity="per_group"`` 在本期显式拒绝（fail-closed）：描述符预留了
+    ``group_size`` 字段，但后端 kernel 尚未实现，静默接受会产生“描述符支持
+    但运行时没有实现”的路径。
+    """
+
+    signed: bool = True
+    bits: int = 8
+    axis: int = 0
+    granularity: str = "per_output_channel"
+    group_size: Optional[int] = None
+    scale_dtype: str = "float32"
+    zero_point_policy: str = "fixed_zero"
+    logical_layout: str = QUANTIZED_WEIGHT_LOGICAL_LAYOUT
+
+    def __post_init__(self) -> None:
+        if self.signed is not True:
+            raise CoreIRValidationError("QuantizedTensorDesc 只支持 signed 量化")
+        if isinstance(self.bits, bool) or self.bits != 8:
+            raise CoreIRValidationError("QuantizedTensorDesc 只支持 8-bit 量化")
+        if isinstance(self.axis, bool) or self.axis not in (0, -1):
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc.axis 只能是 0（weight per-output-channel）或 -1（activation per-row）"
+            )
+        if not isinstance(self.granularity, str) or self.granularity not in _QUANTIZED_GRANULARITIES:
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc.granularity 必须是 per_output_channel 或 per_group"
+            )
+        if self.granularity == "per_group":
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc per_group 本期显式拒绝（fail-closed）：group_size 仅预留字段，后端未实现"
+            )
+        if self.group_size is not None:
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc.group_size 仅对 per_group 有意义；本期 per_output_channel 必须为 None"
+            )
+        if not isinstance(self.scale_dtype, str) or self.scale_dtype not in _QUANTIZED_SCALE_DTYPES:
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc.scale_dtype 必须是 float32；BF16 scale 本期显式拒绝"
+            )
+        if self.zero_point_policy not in _QUANTIZED_ZERO_POINT_POLICIES:
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc.zero_point_policy 必须是 fixed_zero（非对称量化不在本期范围）"
+            )
+        if self.logical_layout not in _QUANTIZED_LOGICAL_LAYOUTS:
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc.logical_layout 必须是 {} 或 {}".format(
+                    QUANTIZED_WEIGHT_LOGICAL_LAYOUT, QUANTIZED_ACTIVATION_LOGICAL_LAYOUT
+                )
+            )
+        if self.axis == 0 and self.logical_layout != QUANTIZED_WEIGHT_LOGICAL_LAYOUT:
+            raise CoreIRValidationError(
+                "QuantizedTensorDesc axis=0（per-output-channel）必须搭配 out_in_rowmajor"
+            )
+        if self.axis == -1 and self.logical_layout != QUANTIZED_ACTIVATION_LOGICAL_LAYOUT:
+            raise CoreIRValidationError("QuantizedTensorDesc axis=-1（per-row）必须搭配 row_then_k")
+
+    @classmethod
+    def weight_per_output_channel(cls) -> "QuantizedTensorDesc":
+        """Weight per-output-channel 冻结默认值。"""
+
+        return cls()
+
+    @classmethod
+    def activation_per_row(cls) -> "QuantizedTensorDesc":
+        """Activation 动态 per-row（仅诊断用途）。"""
+
+        return cls(axis=-1, logical_layout=QUANTIZED_ACTIVATION_LOGICAL_LAYOUT)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "signed": self.signed,
+            "bits": self.bits,
+            "axis": self.axis,
+            "granularity": self.granularity,
+            "group_size": self.group_size,
+            "scale_dtype": self.scale_dtype,
+            "zero_point_policy": self.zero_point_policy,
+            "logical_layout": self.logical_layout,
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "QuantizedTensorDesc":
+        data = _ensure_mapping(value, "QuantizedTensorDesc")
+        fields = (
+            "signed",
+            "bits",
+            "axis",
+            "granularity",
+            "group_size",
+            "scale_dtype",
+            "zero_point_policy",
+            "logical_layout",
+        )
+        _ensure_keys(data, fields, "QuantizedTensorDesc")
+        unknown = [key for key in data if key not in fields]
+        if unknown:
+            raise CoreIRSerializationError(
+                "QuantizedTensorDesc 含未知字段: {}".format(", ".join(sorted(unknown)))
+            )
+        return cls(
+            signed=data["signed"],
+            bits=data["bits"],
+            axis=data["axis"],
+            granularity=data["granularity"],
+            group_size=data["group_size"],
+            scale_dtype=data["scale_dtype"],
+            zero_point_policy=data["zero_point_policy"],
+            logical_layout=data["logical_layout"],
+        )
+
