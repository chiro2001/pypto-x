--- /dev/null
+++ b/python/pypto/portable/qwen35_w8a8_scheme.py
@@ -0,0 +1,518 @@
+"""W8A8-linear 量化 scheme 的 scalar reference golden（契约 §1.4 / §3.3）。
+
+本模块是 4 个公共 opcode 的**纯 Python、无后端**参考实现，用于在下沉到
+AVX2/AVX-512/SVE/CUDA 之前冻结整数 golden：
+
+* ``quantize_per_token_s8``     动态 per-row absmax 量化，产出 int8 + fp32 scale；
+* ``dequantize_s8``             诊断用 int8 + fp32 scale -> fp32；
+* ``qmatmul_s8s8_s32``          INT8×INT8->INT32，与 portable matmul 相同的 equal-prefix batch 规则；
+* ``dequantize_epilogue_bf16``  INT32 + (s_a ⊗ s_w) -> BF16，单次 RNE 舍入。
+
+边界规则（契约 §1.4，全部 fail-closed）：
+
+* Q1 整行全零：``s = 1.0``、``q = 0``，不得产生 NaN/Inf；
+* Q2 行内 NaN/Inf：显式抛错，不静默 clamp；
+* Q3 饱和：``q`` clamp 到 ``[-127, 127]``，饱和计数作为返回值/artifact 字段上报；
+* Q4 RNE：ties-to-even，与既有 BF16 RNE（``float32_bits_to_bfloat16_bits``）同一规则；
+* Q5 K 上限：``K <= floor((2^31-1)/(127*127)) = 133144``，超过显式拒绝；
+* Q6 非 2-D 输入：先 reshape 到 ``[rows, K]``，量化只在 2-D 视图上定义。
+
+Q5 对**符号 shape**（``str`` 维）的 fail-closed 口径：标量参考实现只接受具体
+整数维；``K`` 仍是符号时无法静态证明 ``K <= 133144``，因此直接拒绝，不允许
+“先放行、等运行时溢出”。图构建器必须在 K 具体化后调用本实现（静态拒绝
+优先），后端运行时对动态 K 再做一次同样上限的检查。
+
+本模块不依赖 numpy，也不需要任何设备 runtime。
+"""
+
+from __future__ import annotations
+
+import math
+import struct
+from dataclasses import dataclass
+from typing import Any, Iterable, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.portable.qwen35_weight_layout import float32_bits_to_bfloat16_bits
+
+
+W8A8_SCHEME = "w8a8_linear"
+QUANT_BITS = 8
+QUANT_MIN = -127
+QUANT_MAX = 127
+ZERO_POINT = 0
+SCALE_DTYPE = "float32"
+
+# floor((2**31 - 1) / (127 * 127)) == 133144（契约 §1.4 Q5 / §1.5）。
+MAX_ACCUMULATOR_K = (2**31 - 1) // (QUANT_MAX * QUANT_MAX)
+INT32_MAX = 2**31 - 1
+
+OPCODE_QUANTIZE_PER_TOKEN_S8 = "quantize_per_token_s8"
+OPCODE_DEQUANTIZE_S8 = "dequantize_s8"
+OPCODE_QMATMUL_S8S8_S32 = "qmatmul_s8s8_s32"
+OPCODE_DEQUANTIZE_EPILOGUE_BF16 = "dequantize_epilogue_bf16"
+
+_F32 = struct.Struct("<f")
+_F32_BITS = struct.Struct("<I")
+
+
+class W8A8SchemeError(ValueError):
+    """W8A8 标量参考实现的输入违反冻结 scheme。"""
+
+
+class W8A8QuantizationError(W8A8SchemeError):
+    """量化 fail-closed：NaN/Inf、scale 下溢或 K 超上限。"""
+
+
+def float32_round(value: float) -> float:
+    """把 Python float 舍入到 IEEE-754 binary32，返回其精确 double 表示。"""
+
+    try:
+        return _F32.unpack(_F32.pack(float(value)))[0]
+    except (OverflowError, TypeError, ValueError) as exc:
+        raise W8A8SchemeError("value cannot be represented as float32") from exc
+
+
+def rne_float_to_int(value: float) -> int:
+    """round-to-nearest-even 的 float->int（Q4）。
+
+    与既有 BF16 RNE 使用同一 ties-to-even 规则：``rne(0.5)=0``、
+    ``rne(1.5)=2``、``rne(-0.5)=0``、``rne(2.5)=2``、``rne(3.5)=4``。
+    """
+
+    if not math.isfinite(value):
+        raise W8A8SchemeError("rne_float_to_int requires a finite value")
+    floor = math.floor(value)
+    fraction = value - floor
+    if fraction < 0.5:
+        return floor
+    if fraction > 0.5:
+        return floor + 1
+    # 恰好 0.5：向偶数取整（ties-to-even）。
+    return floor if floor % 2 == 0 else floor + 1
+
+
+def bf16_rne_bits(value: float) -> int:
+    """FP32 -> BF16 的 RNE 位模式，复用既有 BF16 RNE 实现（Q4 / R4）。"""
+
+    as_float32 = float32_round(value)
+    raw = _F32_BITS.unpack(_F32.pack(as_float32))[0]
+    return float32_bits_to_bfloat16_bits(raw)
+
+
+def _is_sequence(value: Any) -> bool:
+    return isinstance(value, (list, tuple))
+
+
+def _nested_from_flat(flat: Sequence[Any], shape: Sequence[int]) -> Tuple[Any, int]:
+    """把 row-major 一维序列还原成 shape 对应的规则嵌套 tuple。"""
+
+    if len(shape) == 1:
+        return tuple(flat[: shape[0]]), shape[0]
+    items = []
+    offset = 0
+    for _ in range(shape[0]):
+        item, consumed = _nested_from_flat(flat[offset:], shape[1:])
+        items.append(item)
+        offset += consumed
+    return tuple(items), offset
+
+
+def _flatten_nested(values: Any, context: str) -> Tuple[Tuple[Any, ...], Tuple[int, ...]]:
+    """把规则嵌套序列压平成 row-major 一维并返回 shape。"""
+
+    if _is_sequence(values):
+        if not values:
+            return (), (0,)
+        children = []
+        child_shape: Optional[Tuple[int, ...]] = None
+        for index, item in enumerate(values):
+            flat, shape = _flatten_nested(item, "{}[{}]".format(context, index))
+            if child_shape is None:
+                child_shape = shape
+            elif shape != child_shape:
+                raise W8A8SchemeError("{} is ragged: {} != {}".format(context, shape, child_shape))
+            children.append(flat)
+        assert child_shape is not None
+        combined: List[Any] = []
+        for flat in children:
+            combined.extend(flat)
+        return tuple(combined), (len(values),) + child_shape
+    return (values,), ()
+
+
+def _as_flat(values: Sequence[Any], shape: Optional[Sequence[int]], context: str) -> Tuple[Tuple[Any, ...], Tuple[int, ...]]:
+    if isinstance(values, (str, bytes)):
+        raise W8A8SchemeError("{} must be a numeric sequence".format(context))
+    flat, inferred = _flatten_nested(values, context)
+    if shape is not None:
+        try:
+            declared = tuple(int(dimension) for dimension in shape)
+        except (TypeError, ValueError) as exc:
+            raise W8A8SchemeError("{} shape must be a sequence of integers".format(context)) from exc
+        for index, dimension in enumerate(declared):
+            if isinstance(dimension, bool) or dimension < 0:
+                raise W8A8SchemeError("{} shape[{}] must be a non-negative integer".format(context, index))
+        if math.prod(declared) != len(flat):
+            raise W8A8SchemeError(
+                "{} shape {} does not match {} flattened elements".format(context, declared, len(flat))
+            )
+        return flat, declared
+    return flat, inferred
+
+
+def _checked_number(value: Any, context: str) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise W8A8SchemeError("{} must be a real number".format(context))
+    number = float(value)
+    if math.isnan(number) or math.isinf(number):
+        raise W8A8QuantizationError("{} contains NaN/Inf; quantize_per_token_s8 fails closed (Q2)".format(context))
+    return number
+
+
+@dataclass(frozen=True)
+class QuantizePerTokenResult:
+    """``quantize_per_token_s8`` 的 artifact 字段（含饱和计数）。"""
+
+    codes: Tuple[int, ...]
+    scales: Tuple[float, ...]
+    saturation_count: int
+    rows: int
+    k: int
+
+    def code_rows(self) -> Tuple[Tuple[int, ...], ...]:
+        return tuple(tuple(self.codes[row * self.k : (row + 1) * self.k]) for row in range(self.rows))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "opcode": OPCODE_QUANTIZE_PER_TOKEN_S8,
+            "rows": self.rows,
+            "k": self.k,
+            "codes": list(self.codes),
+            "scales": list(self.scales),
+            "saturation_count": self.saturation_count,
+            "scheme": W8A8_SCHEME,
+            "zero_point": ZERO_POINT,
+            "scale_dtype": SCALE_DTYPE,
+        }
+
+
+@dataclass(frozen=True)
+class ClampedInt8Result:
+    """``clamp_rne_int8`` 的结果：饱和计数与 clamp 后的码点。"""
+
+    codes: Tuple[int, ...]
+    saturation_count: int
+
+
+def clamp_rne_int8(ratios: Iterable[float]) -> ClampedInt8Result:
+    """把已缩放的 ratio 经 RNE 取整并 clamp 到 ``[-127, 127]``，统计饱和次数。
+
+    ``quantize_per_token_s8`` 每行都通过本函数产生码点；饱和计数是 artifact
+    必填字段（Q3）。由于 per-token absmax 是行内最大值，正常输入下 ratio 的
+    绝对值不超过约 127（仅受 FP32 scale 舍入影响），因此饱和计数通常为 0；
+    该函数保证一旦发生 clamp 就一定计数，绝不静默。
+    """
+
+    codes: List[int] = []
+    saturation_count = 0
+    for ratio in ratios:
+        quantized = rne_float_to_int(float(ratio))
+        if quantized < QUANT_MIN:
+            quantized = QUANT_MIN
+            saturation_count += 1
+        elif quantized > QUANT_MAX:
+            quantized = QUANT_MAX
+            saturation_count += 1
+        codes.append(quantized)
+    return ClampedInt8Result(tuple(codes), saturation_count)
+
+
+def quantize_per_token_s8(
+    values: Sequence[Any],
+    *,
+    shape: Optional[Sequence[int]] = None,
+) -> QuantizePerTokenResult:
+    """动态 per-row absmax 对称量化：``tensor[bf16/fp32] -> int8[rows,K] + fp32[rows]``。
+
+    ``values`` 可以是任意 rank 的规则嵌套序列（Q6：先 reshape 到
+    ``[prod(leading), last]``），也可以给出一维序列加显式 ``shape``。
+    """
+
+    flat, declared_shape = _as_flat(values, shape, "quantize_per_token_s8.values")
+    if len(declared_shape) == 0:
+        raise W8A8SchemeError("quantize_per_token_s8 requires at least a 1-D input")
+    k = declared_shape[-1]
+    rows = math.prod(declared_shape[:-1]) if len(declared_shape) > 1 else 1
+    if k == 0 or rows == 0:
+        raise W8A8SchemeError("quantize_per_token_s8 requires non-empty [rows, K]")
+    if k > MAX_ACCUMULATOR_K:
+        raise W8A8QuantizationError(
+            "K={} exceeds INT32 accumulation limit {} (Q5); INT64 accumulation is out of scope".format(
+                k, MAX_ACCUMULATOR_K
+            )
+        )
+    numbers = tuple(
+        _checked_number(value, "quantize_per_token_s8.values[{}]".format(index))
+        for index, value in enumerate(flat)
+    )
+
+    codes: List[int] = []
+    scales: List[float] = []
+    saturation_count = 0
+    for row in range(rows):
+        row_values = numbers[row * k : (row + 1) * k]
+        absmax = max(abs(value) for value in row_values)
+        if absmax == 0.0:
+            # Q1：整行全零 -> s=1.0、q=0，绝不产生 NaN/Inf。
+            scales.append(float32_round(1.0))
+            codes.extend([0] * k)
+            continue
+        scale = float32_round(absmax / float(QUANT_MAX))
+        if scale == 0.0:
+            # scale 下溢（§6 “scale=0 且非全零行”）：fail-closed，不产出 artifact。
+            raise W8A8QuantizationError(
+                "row {} absmax={!r} underflows float32 scale; refusing to quantize".format(row, absmax)
+            )
+        scales.append(scale)
+        row_result = clamp_rne_int8(value / scale for value in row_values)
+        codes.extend(row_result.codes)
+        saturation_count += row_result.saturation_count
+    return QuantizePerTokenResult(tuple(codes), tuple(scales), saturation_count, rows, k)
+
+
+def dequantize_s8(
+    codes: Sequence[Any],
+    scales: Sequence[float],
+    *,
+    shape: Optional[Sequence[int]] = None,
+) -> Tuple[float, ...]:
+    """``int8[..,K] + fp32[..] -> fp32``（诊断/单测用），返回 row-major 一维。"""
+
+    flat, declared_shape = _as_flat(codes, shape, "dequantize_s8.codes")
+    if len(declared_shape) < 1:
+        raise W8A8SchemeError("dequantize_s8 requires at least a 1-D input")
+    k = declared_shape[-1]
+    rows = math.prod(declared_shape[:-1]) if len(declared_shape) > 1 else 1
+    if k == 0 or rows == 0:
+        raise W8A8SchemeError("dequantize_s8 requires non-empty [rows, K]")
+    if len(scales) != rows:
+        raise W8A8SchemeError("dequantize_s8 expects {} per-row scales, got {}".format(rows, len(scales)))
+    scale_values = tuple(float32_round(float(scale)) for scale in scales)
+    output: List[float] = []
+    for row in range(rows):
+        scale = scale_values[row]
+        for column in range(k):
+            code = flat[row * k + column]
+            if isinstance(code, bool) or not isinstance(code, int):
+                raise W8A8SchemeError("dequantize_s8 codes must be integers")
+            if code < QUANT_MIN or code > QUANT_MAX:
+                raise W8A8SchemeError(
+                    "dequantize_s8 code {} outside [{}, {}]".format(code, QUANT_MIN, QUANT_MAX)
+                )
+            output.append(float32_round(code * scale))
+    return tuple(output)
+
+
+@dataclass(frozen=True)
+class QMatmulResult:
+    """``qmatmul_s8s8_s32`` 的 INT32 输出（row-major）与 batch 形状。"""
+
+    values: Tuple[int, ...]
+    shape: Tuple[int, ...]
+    batch_shape: Tuple[int, ...]
+    k: int
+
+    def grid(self) -> Tuple[Any, ...]:
+        """返回与输出 shape 一致的嵌套 tuple（batch 前缀 + (M, N)）。"""
+
+        return _nested_from_flat(self.values, self.shape)[0]
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "opcode": OPCODE_QMATMUL_S8S8_S32,
+            "shape": list(self.shape),
+            "batch_shape": list(self.batch_shape),
+            "k": self.k,
+            "accumulator_dtype": "int32",
+            "values": list(self.values),
+        }
+
+
+def _validate_int_codes(flat: Sequence[Any], context: str) -> None:
+    for index, code in enumerate(flat):
+        if isinstance(code, bool) or not isinstance(code, int):
+            raise W8A8SchemeError("{}[{}] must be an integer code".format(context, index))
+        if code < QUANT_MIN or code > QUANT_MAX:
+            raise W8A8SchemeError(
+                "{}[{}]={} outside [{}, {}]".format(context, index, code, QUANT_MIN, QUANT_MAX)
+            )
+
+
+def qmatmul_s8s8_s32(
+    left: Sequence[Any],
+    right: Sequence[Any],
+    *,
+    left_shape: Optional[Sequence[int]] = None,
+    right_shape: Optional[Sequence[int]] = None,
+) -> QMatmulResult:
+    """INT8×INT8->INT32，equal-prefix rank-2/3/4 batch 规则（与 portable matmul 一致）。
+
+    批前缀必须逐位相同，不做 NumPy 广播；K 上限复用 Q5。
+    """
+
+    left_flat, left_declared = _as_flat(left, left_shape, "qmatmul_s8s8_s32.left")
+    right_flat, right_declared = _as_flat(right, right_shape, "qmatmul_s8s8_s32.right")
+    if len(left_declared) != len(right_declared):
+        raise W8A8SchemeError("qmatmul_s8s8_s32 operands must have equal rank")
+    if len(left_declared) not in (2, 3, 4):
+        raise W8A8SchemeError("qmatmul_s8s8_s32 operands must have rank 2, 3, or 4")
+    if left_declared[:-2] != right_declared[:-2]:
+        raise W8A8SchemeError("qmatmul_s8s8_s32 operands must have identical batch prefixes")
+    if left_declared[-1] != right_declared[-2]:
+        raise W8A8SchemeError(
+            "qmatmul_s8s8_s32 reduction dimensions {} and {} do not match".format(
+                left_declared[-1], right_declared[-2]
+            )
+        )
+    _validate_int_codes(left_flat, "qmatmul_s8s8_s32.left")
+    _validate_int_codes(right_flat, "qmatmul_s8s8_s32.right")
+    batch_shape = left_declared[:-2]
+    m, k = left_declared[-2], left_declared[-1]
+    n = right_declared[-1]
+    if k > MAX_ACCUMULATOR_K:
+        raise W8A8QuantizationError(
+            "qmatmul_s8s8_s32 K={} exceeds INT32 accumulation limit {} (Q5)".format(k, MAX_ACCUMULATOR_K)
+        )
+    batch_count = math.prod(batch_shape) if batch_shape else 1
+    values: List[int] = []
+    for batch in range(batch_count):
+        left_base = batch * m * k
+        right_base = batch * k * n
+        for row in range(m):
+            for column in range(n):
+                accumulator = 0
+                for index in range(k):
+                    accumulator += left_flat[left_base + row * k + index] * right_flat[right_base + index * n + column]
+                values.append(accumulator)
+    return QMatmulResult(tuple(values), left_declared[:-2] + (m, n), batch_shape, k)
+
+
+@dataclass(frozen=True)
+class DequantizeEpilogueResult:
+    """``dequantize_epilogue_bf16`` 的单次舍入输入与输出。"""
+
+    fp32_values: Tuple[float, ...]
+    bf16_bits: Tuple[int, ...]
+    rows: int
+    columns: int
+
+    def value_rows(self) -> Tuple[Tuple[float, ...], ...]:
+        return tuple(
+            tuple(self.fp32_values[row * self.columns : (row + 1) * self.columns])
+            for row in range(self.rows)
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "opcode": OPCODE_DEQUANTIZE_EPILOGUE_BF16,
+            "rows": self.rows,
+            "columns": self.columns,
+            "fp32_values": list(self.fp32_values),
+            "bf16_bits": list(self.bf16_bits),
+            "rounding": "rne_bf16_single_cast",
+        }
+
+
+def dequantize_epilogue_bf16(
+    accumulator: Sequence[Any],
+    row_scales: Sequence[float],
+    column_scales: Sequence[float],
+    *,
+    shape: Optional[Sequence[int]] = None,
+) -> DequantizeEpilogueResult:
+    """``int32[m,n] + fp32[m] + fp32[n] -> bf16[m,n]``，FP32 乘完单次 RNE cast（R4）。
+
+    ``fp32_values`` 保存“FP32 乘完”的中间值，``bf16_bits`` 保存单次 RNE 后的
+    BF16 位模式；两者共同使“与 FP32 乘完再单次 cast 逐位一致”可差分验证。
+    """
+
+    flat, declared_shape = _as_flat(accumulator, shape, "dequantize_epilogue_bf16.accumulator")
+    if len(declared_shape) != 2:
+        raise W8A8SchemeError("dequantize_epilogue_bf16 requires a rank-2 int32 accumulator")
+    rows, columns = declared_shape
+    if rows == 0 or columns == 0:
+        raise W8A8SchemeError("dequantize_epilogue_bf16 requires non-empty [m, n]")
+    if len(row_scales) != rows:
+        raise W8A8SchemeError(
+            "dequantize_epilogue_bf16 expects {} row scales, got {}".format(rows, len(row_scales))
+        )
+    if len(column_scales) != columns:
+        raise W8A8SchemeError(
+            "dequantize_epilogue_bf16 expects {} column scales, got {}".format(columns, len(column_scales))
+        )
+    row_scale_values = tuple(float32_round(float(scale)) for scale in row_scales)
+    column_scale_values = tuple(float32_round(float(scale)) for scale in column_scales)
+    fp32_values: List[float] = []
+    bf16_bits: List[int] = []
+    for row in range(rows):
+        for column in range(columns):
+            value = flat[row * columns + column]
+            if isinstance(value, bool) or not isinstance(value, int):
+                raise W8A8SchemeError("dequantize_epilogue_bf16 accumulator must be INT32 integers")
+            if value < -INT32_MAX - 1 or value > INT32_MAX:
+                raise W8A8SchemeError("dequantize_epilogue_bf16 accumulator outside INT32 range")
+            # FP32 域：int32 -> fp32，乘 (s_a[r] * s_w[o])，再乘，全程 binary32。
+            scaled = float32_round(row_scale_values[row] * column_scale_values[column])
+            product = float32_round(float32_round(float(value)) * scaled)
+            fp32_values.append(product)
+            bf16_bits.append(bf16_rne_bits(product))
+    return DequantizeEpilogueResult(tuple(fp32_values), tuple(bf16_bits), rows, columns)
+
+
+SCALAR_REFERENCE_OPCODES: Mapping[str, Any] = {
+    OPCODE_QUANTIZE_PER_TOKEN_S8: quantize_per_token_s8,
+    OPCODE_DEQUANTIZE_S8: dequantize_s8,
+    OPCODE_QMATMUL_S8S8_S32: qmatmul_s8s8_s32,
+    OPCODE_DEQUANTIZE_EPILOGUE_BF16: dequantize_epilogue_bf16,
+}
+
+
+def scalar_reference(opcode: str) -> Any:
+    """按 opcode 名返回 scalar reference 实现（未注册即 fail-closed）。"""
+
+    try:
+        return SCALAR_REFERENCE_OPCODES[opcode]
+    except KeyError as exc:
+        raise W8A8SchemeError("no scalar reference registered for opcode {!r}".format(opcode)) from exc
+
+
+__all__ = [
+    "ClampedInt8Result",
+    "DequantizeEpilogueResult",
+    "INT32_MAX",
+    "MAX_ACCUMULATOR_K",
+    "OPCODE_DEQUANTIZE_EPILOGUE_BF16",
+    "OPCODE_DEQUANTIZE_S8",
+    "OPCODE_QMATMUL_S8S8_S32",
+    "OPCODE_QUANTIZE_PER_TOKEN_S8",
+    "QUANT_BITS",
+    "QUANT_MAX",
+    "QUANT_MIN",
+    "QMatmulResult",
+    "QuantizePerTokenResult",
+    "SCALAR_REFERENCE_OPCODES",
+    "SCALE_DTYPE",
+    "W8A8QuantizationError",
+    "W8A8SchemeError",
+    "W8A8_SCHEME",
+    "ZERO_POINT",
+    "bf16_rne_bits",
+    "clamp_rne_int8",
+    "dequantize_epilogue_bf16",
+    "dequantize_s8",
+    "float32_round",
+    "qmatmul_s8s8_s32",
+    "quantize_per_token_s8",
+    "rne_float_to_int",
+    "scalar_reference",
+]
