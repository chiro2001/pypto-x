diff --git a/python/tests/ut/pypto_x/test_cpu_avx512_launch_validation_memo.py b/python/tests/ut/pypto_x/test_cpu_avx512_launch_validation_memo.py
new file mode 100644
index 000000000..4c9117573
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_cpu_avx512_launch_validation_memo.py
@@ -0,0 +1,241 @@
+"""N4.0: per-launch AVX-512 validation dedup must not weaken fail-closed checks.
+
+The launch path validates the primary artifact metadata in ``launch()`` and
+again in ``_decode_artifact()`` (plus once per fallback candidate).  N4.0
+memoizes that work inside a single ``launch()`` call only.  These tests pin:
+
+* the digest memo reuses a verified digest inside one launch and still
+  recomputes (and rejects) a changed declared ``program_digest``;
+* every new launch re-validates: replacing ``artifact.metadata`` after a
+  successful launch is rejected by the next launch;
+* tampered program/version metadata is rejected on every launch, including a
+  repeated launch with the same artifact object;
+* repeated launches produce bit-identical output.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cpu.x86 import Avx512Runtime, CpuAvx512ArtifactError
+from pypto.backends.cpu.x86 import avx512 as runtime_module
+from pypto.compiler import Artifact, CompileOptions
+from pypto.compiler.targets.cpu_avx2 import Avx2Compiler
+from pypto.compiler.targets.cpu_avx512 import Avx512Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy
+
+
+AVX512_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16}
+)
+AVX2_TARGET = TargetSpec(
+    "cpu", "x86_64-linux-gnu", features=("avx2",), attributes={"lane_count": 8}
+)
+SHAPE = (17,)
+
+
+def _program(operation="add", shape=SHAPE):
+    value_type = CoreType.tensor("float32", shape)
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    inputs = (left,) if operation == "neg" else (left, right)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                operation,
+                inputs,
+                (output,),
+                Region((Operation(operation, inputs, (output,)),)),
+            ),
+        )
+    )
+
+
+def _compile_avx512(program, tmp_path, name="native"):
+    compiler = Avx512Compiler()
+    target_ir = compiler.lower(program, AVX512_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx512", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+    return target_ir, artifact
+
+
+def _compile_avx2(program, tmp_path, name="fallback-avx2"):
+    compiler = Avx2Compiler()
+    return compiler.compile(
+        compiler.lower(program, AVX2_TARGET),
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+
+
+def _runtime():
+    runtime = Avx512Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX-512/ZMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _left(shape=SHAPE):
+    return HostTensor("float32", shape, [float(index) for index in range(shape[0])])
+
+
+def _launch(runtime, artifact, shape=SHAPE, fallback=None):
+    output = HostTensor.zeros("float32", shape)
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_left(shape).descriptor(readonly=True), _left(shape).descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        ),
+        fallback_artifact=fallback,
+    )
+    return output
+
+
+def _output_bytes(tensor):
+    return struct.pack("<%df" % len(tensor.data), *tensor.data)
+
+
+def test_digest_memo_reuses_verified_digest_and_rechecks_declared_digest(tmp_path, monkeypatch):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    memo = runtime_module._LaunchValidationMemo()
+    first = runtime_module._program_digest_from_metadata(
+        mapping_copy(artifact.metadata), "primary artifact", memo=memo, artifact=artifact
+    )
+    assert first == artifact.metadata["program_digest"]
+
+    real_core_program = runtime_module.CoreProgram
+    calls = {"count": 0}
+
+    class CountingCoreProgram:
+        @staticmethod
+        def from_dict(payload):
+            calls["count"] += 1
+            return real_core_program.from_dict(payload)
+
+    monkeypatch.setattr(runtime_module, "CoreProgram", CountingCoreProgram)
+    second = runtime_module._program_digest_from_metadata(
+        mapping_copy(artifact.metadata), "primary artifact", memo=memo, artifact=artifact
+    )
+    assert second == first
+    assert calls["count"] == 0, "memo hit must not rebuild the CoreProgram"
+
+    tampered = mapping_copy(artifact.metadata)
+    tampered["program_digest"] = "0" * 64
+    with pytest.raises(CpuAvx512ArtifactError, match="CoreProgram digest is inconsistent"):
+        runtime_module._program_digest_from_metadata(
+            tampered, "primary artifact", memo=memo, artifact=artifact
+        )
+    assert calls["count"] == 1, "changed declared digest must miss the memo and recompute"
+
+
+def test_primary_validation_runs_once_per_launch_and_metadata_replacement_is_rejected(
+    tmp_path, monkeypatch
+):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    real_validate = runtime_module._validate_primary_semantics
+    calls = []
+
+    def counting(artifact_arg, metadata_arg):
+        calls.append(artifact_arg)
+        return real_validate(artifact_arg, metadata_arg)
+
+    monkeypatch.setattr(runtime_module, "_validate_primary_semantics", counting)
+    runtime = _runtime()
+
+    first = _output_bytes(_launch(runtime, artifact))
+    assert len(calls) == 1, "one launch must run the semantic validation exactly once"
+
+    second = _output_bytes(_launch(runtime, artifact))
+    assert len(calls) == 2, "each launch must re-run the semantic validation"
+    assert first == second
+
+    # Replace the frozen metadata mapping after a successful launch: identity
+    # changed, so the next launch must validate from scratch and reject.
+    tampered = dict(artifact.metadata)
+    tampered["plan_version"] = 2
+    object.__setattr__(artifact, "metadata", tampered)
+    with pytest.raises(CpuAvx512ArtifactError, match="unsupported CPU vector plan version"):
+        _launch(runtime, artifact)
+
+
+@pytest.mark.parametrize(
+    "tamper, message",
+    [
+        ("program_digest", "CoreProgram digest is inconsistent"),
+        ("program", "CoreProgram digest is inconsistent"),
+        ("lowering_version", "unsupported AVX-512 lowering version"),
+        ("artifact_payload_version", "unsupported AVX-512 artifact payload version"),
+        ("plan_version", "unsupported CPU vector plan version"),
+        ("required_features", "required_features omit AVX/ZMM safety fields"),
+    ],
+)
+def test_tampered_metadata_is_rejected_on_every_launch(tmp_path, tamper, message):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    metadata = dict(artifact.metadata)
+    if tamper == "program_digest":
+        metadata["program_digest"] = "f" * 64
+    elif tamper == "program":
+        _, other = _compile_avx512(_program(operation="neg"), tmp_path, name="other")
+        metadata["program"] = mapping_copy(other.metadata)["program"]
+    elif tamper == "required_features":
+        plan_data = dict(metadata["vector_plan"])
+        required = dict(plan_data["required_features"])
+        required["features"] = tuple(
+            feature for feature in required["features"] if feature != "avx512f"
+        )
+        plan_data["required_features"] = required
+        metadata["vector_plan"] = plan_data
+        metadata["required_features"] = required["features"]
+    else:
+        metadata[tamper] = int(metadata[tamper]) + 1
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=metadata,
+    )
+    for _ in range(2):
+        with pytest.raises(CpuAvx512ArtifactError, match=message):
+            _launch(runtime, tampered)
+
+
+def test_fallback_candidate_reuses_primary_validation_memo(tmp_path, monkeypatch):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    fallback = _compile_avx2(_program(), tmp_path)
+    real_validate = runtime_module._validate_primary_semantics
+    calls = []
+
+    def counting(artifact_arg, metadata_arg):
+        calls.append(artifact_arg)
+        return real_validate(artifact_arg, metadata_arg)
+
+    monkeypatch.setattr(runtime_module, "_validate_primary_semantics", counting)
+    _launch(_runtime(), artifact, fallback=fallback)
+    assert len(calls) == 1, "fallback loop must not re-run primary semantic validation"
+
+
+def test_repeated_launches_are_bit_identical(tmp_path):
+    _, artifact = _compile_avx512(_program(), tmp_path)
+    runtime = _runtime()
+    digests = set()
+    for _ in range(3):
+        output = _launch(runtime, artifact)
+        digests.add(hashlib.sha256(_output_bytes(output)).hexdigest())
+    assert len(digests) == 1
