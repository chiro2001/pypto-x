+class _LaunchValidationMemo:
+    """Per-launch dedup for AVX-512 primary-artifact metadata validation (N4.0).
+
+    ``launch()`` validates the primary artifact and then ``_decode_artifact()``
+    validates it again before mapping the ELF; each fallback candidate also
+    re-validates the primary.  One memo instance is created per launch call and
+    dropped when that call returns, so a metadata, version or digest mismatch
+    is still rejected by every launch.
+
+    Entries are keyed by ``id(artifact)`` and hold a strong reference to the
+    immutable ``artifact.metadata`` mapping that was validated.  A cached
+    entry is only reused while that exact mapping object is still attached to
+    the artifact (identity check), so replacing the mapping (for example via
+    ``object.__setattr__``) forces a full re-validation.
+
+    Digest entries additionally re-check the declared ``program_digest`` on
+    every hit; a tampered digest string misses the memo and is recomputed,
+    which restores the fail-closed rejection.  All callers pass
+    ``mapping_copy(artifact.metadata)`` together with the exact artifact it
+    came from, so the identity key always denotes the same frozen program
+    graph (``Artifact`` and its deeply frozen metadata are immutable).
+    """
+
+    __slots__ = ("digests", "primary")
+
+    def __init__(self) -> None:
+        #: id(artifact) -> (artifact.metadata, verified digest)
+        self.digests: Dict[int, Tuple[Any, str]] = {}
+        #: id(artifact) -> artifact.metadata (validated this launch)
+        self.primary: Dict[int, Any] = {}
+
