diff --git a/python/pypto/backends/cpu/aarch64/sve256.py b/python/pypto/backends/cpu/aarch64/sve256.py
index ffab8b4c9..281d06d0c 100644
--- a/python/pypto/backends/cpu/aarch64/sve256.py
+++ b/python/pypto/backends/cpu/aarch64/sve256.py
@@ -296,8 +296,19 @@ def _decode_artifact(artifact: Artifact, available: CpuFeatureSet) -> LoadedSve2
             raise CpuSve256ArtifactError("SVE256 compile command is missing {}".format(required_flag))
     if "neon" in command_text.lower():
         raise CpuSve256ArtifactError("SVE256 compile command contains forbidden NEON lowering")
-    if not str(compile_command[0]).lower().startswith(("aarch64", "clang", "gcc")):
-        raise CpuSve256ArtifactError("SVE256 compiler metadata is not an AArch64 compiler")
+    command_compiler = Path(str(compile_command[0])).name
+    metadata_compiler = metadata.get("compiler")
+    if not isinstance(metadata_compiler, str) or not metadata_compiler:
+        raise CpuSve256ArtifactError("SVE256 compiler metadata is missing")
+    if metadata_compiler != command_compiler:
+        raise CpuSve256ArtifactError(
+            "SVE256 compiler metadata disagrees with compile command"
+        )
+    compiler_triple = metadata.get("compiler_target_triple")
+    if not isinstance(compiler_triple, str) or not _is_little_linux_aarch64(compiler_triple):
+        raise CpuSve256ArtifactError(
+            "SVE256 compiler target triple is not little-endian Linux AArch64"
+        )
     if metadata.get("entrypoint") != artifact.entrypoint:
         raise CpuSve256ArtifactError("SVE256 artifact entrypoint mismatch")
     if metadata.get("artifact_payload_version") != 1:
diff --git a/python/tests/ut/pypto_x/test_cpu_sve256.py b/python/tests/ut/pypto_x/test_cpu_sve256.py
index dbd424a7f..93547c930 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256.py
@@ -820,6 +820,58 @@ def test_sve_artifact_digest_metadata_and_hardlink_protection(tmp_path):
     with pytest.raises(CpuSve256ArtifactError, match="source marker"):
         Sve256Runtime(execution_mode="qemu").load(marker_artifact)
 
+
+def test_sve_native_cc_compiler_metadata_cross_check(tmp_path):
+    _, _, artifact = _compile(_elementwise(), tmp_path)
+    original = Path(artifact.path).read_bytes()
+    metadata = dict(artifact.metadata)
+    command = list(metadata["compile_command"])
+    command[0] = "cc"
+    metadata["compiler"] = "cc"
+    metadata["compiler_target_triple"] = "aarch64-linux-gnu"
+    metadata["compile_command"] = command
+    native_cc_artifact = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=metadata,
+    )
+    Sve256Runtime(execution_mode="qemu").load(native_cc_artifact)
+
+    for field, value in (
+        ("compiler", "aarch64-linux-gnu-gcc"),
+        ("compiler_target_triple", "x86_64-linux-gnu"),
+    ):
+        tampered = dict(metadata)
+        tampered[field] = value
+        if field == "compiler":
+            tampered["compile_command"] = tuple(["cc"] + list(command[1:]))
+        bad = Artifact(
+            format=artifact.format,
+            entrypoint=artifact.entrypoint,
+            target=artifact.target,
+            abi_version=artifact.abi_version,
+            path=artifact.path,
+            metadata=tampered,
+        )
+        with pytest.raises(CpuSve256ArtifactError, match="compiler|triple"):
+            Sve256Runtime(execution_mode="qemu").load(bad)
+
+    command_tampered = dict(metadata)
+    command_tampered["compile_command"] = tuple(["clang"] + list(command[1:]))
+    bad_command = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=command_tampered,
+    )
+    with pytest.raises(CpuSve256ArtifactError, match="compiler metadata"):
+        Sve256Runtime(execution_mode="qemu").load(bad_command)
+
     embedded_path = tmp_path / "embedded-marker.elf"
     embedded_bytes = original.replace(
         artifact.metadata["native_source_digest"].encode("ascii"), b"0" * 64, 1
