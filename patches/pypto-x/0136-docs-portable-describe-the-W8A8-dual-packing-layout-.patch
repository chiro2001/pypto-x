From: Chiro <chiro2001@163.com>
Date: Fri, 11 Sep 2026 20:05:17 +0800
Subject: [PATCH 136/257] docs(portable): describe the W8A8 dual-packing layout
 contract

---
 python/pypto/portable/qwen35_weight_layout.py | 28 +++++++++++++++++++++-------
 1 file changed, 21 insertions(+), 7 deletions(-)

diff --git a/python/pypto/portable/qwen35_weight_layout.py b/python/pypto/portable/qwen35_weight_layout.py
index af47c8ca7..c354b6cba 100644
--- a/python/pypto/portable/qwen35_weight_layout.py
+++ b/python/pypto/portable/qwen35_weight_layout.py
@@ -1,9 +1,9 @@
 """Qwen3.5-0.8B 真实权重的 storage-relative packed layout。
 
 该模块把 :func:`pypto.portable.runtime_binding.build_packed_layout` 冻结的
-368 个 region（320 文本参数 + 48 状态）与 :mod:`pypto.portable.qwen35_weight_map`
-得到的官方 checkpoint file offset 合并成一份可复现、无重叠、无歧义空洞的
-JSON 描述。
+region（BF16 路径 368 = 320 文本参数 + 48 状态；W8A8 默认 518 / 全开 556）
+与 :mod:`pypto.portable.qwen35_weight_map` 得到的官方 checkpoint file offset
+合并成一份可复现、无重叠、无歧义空洞的 JSON 描述。
 
 region 的 ``offset`` 是 **storage-relative** packed 偏移（M1J 冻结契约，64 字节
 对齐）；``source.file_offset`` 是该参数在 safetensors 文件中的真实绝对偏移。
@@ -14,9 +14,16 @@ region 的 ``offset`` 是 **storage-relative** packed 偏移（M1J 冻结契约
 
 * 相邻 region 的 ``offset`` 必须恰好等于 ``align_up(previous_end, alignment)``，
   因此既无重叠，也不存在未被记录的 padding；
-* 所有 parameter region 必须各自绑定唯一一个官方张量，且官方 file 区间两两不重叠；
-* dtype 与契约不一致的 region 会被标记 ``requires_dtype_conversion=true``，
-  由调用方决定是否转换，本模块不静默改写契约 dtype。
+* 所有 parameter/quant_weight region 必须各自绑定唯一一个官方张量，且官方
+  file 区间两两不重叠；**唯一例外**是契约 §3.4 的 tied lm_head 双 packing：
+  两个 region 必须引用完全相同的、登记过的 file 区间，且 scale region 没有
+  独立来源（``derived_from`` 指向对应 int8 region）；
+* dtype 与契约不一致的浮点 region 会被标记 ``requires_dtype_conversion=true``，
+  由调用方决定是否转换，本模块不静默改写契约 dtype；
+* W8A8 int8 region 标记 ``quantized=true``：其字节由
+  :mod:`pypto.portable.qwen35_w8a8_weight` 的 C1 scheme 在内存中生成，
+  不得走 :func:`convert_region_bytes` 的字节 cast；scale region 由
+  ingestion 在内存中派生，不占 checkpoint 来源。
 
 **精度边界**：Qwen3.5-0.8B checkpoint 的 ``linear_attn.A_log`` 与
 ``linear_attn.norm.weight`` 是 F32，而冻结契约要求全部 320 个参数为 bf16。
@@ -310,7 +317,14 @@ def build_weight_layout(
     *,
     alignment: int = DEFAULT_PACK_ALIGNMENT,
 ) -> WeightLayout:
-    """把冻结的 packed layout 与真实 checkpoint offset 合并成可审计 layout。"""
+    """把冻结的 packed layout 与真实 checkpoint offset 合并成可审计 layout。
+
+    BF16 路径保持 v1 JSON/digest 逐字节不变；W8A8 路径额外登记
+    ``quantized``/``derived_from`` 与 ``quantized_region_count`` /
+    ``quant_scale_region_count`` / ``shared_source_tensors``，并允许登记过的
+    tied lm_head 双 packing 共享同一来源区间。本函数只读 header/offset，
+    不读取权重字节。
+    """
 
     if not isinstance(schema, BindingSchema):
         raise WeightLayoutError("schema must be a BindingSchema")
