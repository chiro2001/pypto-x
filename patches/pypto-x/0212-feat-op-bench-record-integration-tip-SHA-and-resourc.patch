From 7cce0c1f181bf7494134055f1e2d24382a64c0a6 Mon Sep 17 00:00:00 2001
From: op-bench-framework <op-bench-framework@pypto-x.local>
Date: Sat, 12 Sep 2026 04:36:40 +0800
Subject: [PATCH 212/235] feat(op-bench): record integration tip SHA and
 resource-lock log path in every report

---
 python/pypto/op_bench/cli.py     |  4 ++++
 python/pypto/op_bench/runner.py  | 22 ++++++++++++++++++++++
 python/pypto/op_bench/schema.py  |  7 +++++++
 scripts/perf/op_bench_x86_run.sh |  4 ++++
 4 files changed, 37 insertions(+)

diff --git a/python/pypto/op_bench/cli.py b/python/pypto/op_bench/cli.py
index 48c6d6ce8..1b43756bf 100644
--- a/python/pypto/op_bench/cli.py
+++ b/python/pypto/op_bench/cli.py
@@ -60,6 +60,8 @@ def build_parser() -> argparse.ArgumentParser:
     run.add_argument("--repeat", type=int, default=1, help="repeat the whole run N times for reproducibility")
     run.add_argument("--case-filter", type=_csv, action="append", default=None, help="only run cases whose case_id contains one of these substrings (repeatable)")
     run.add_argument("--repo-root", default="")
+    run.add_argument("--integration-tip", default="", help="integration tip SHA the worktree is based on")
+    run.add_argument("--lock-log", default="", help="resource-lock/monitor log path for this run")
 
     self_test = sub.add_parser("selftest", help="run the light schema/error-injection self-test")
     self_test.add_argument("--out", default="")
@@ -127,6 +129,8 @@ def main(argv: Optional[Sequence[str]] = None) -> int:
         repeat=args.repeat,
         repo_root=args.repo_root,
         aocl_library=args.aocl_lib,
+        integration_tip=args.integration_tip,
+        lock_log=args.lock_log,
     )
     try:
         report = run_and_write(config)
diff --git a/python/pypto/op_bench/runner.py b/python/pypto/op_bench/runner.py
index 847ca4243..740218d52 100644
--- a/python/pypto/op_bench/runner.py
+++ b/python/pypto/op_bench/runner.py
@@ -90,6 +90,8 @@ class RunConfig:
     repeat: int = 1
     repo_root: str = ""
     aocl_library: Optional[str] = None
+    integration_tip: str = ""
+    lock_log: str = ""
 
     def validate(self) -> None:
         for suite in self.suites:
@@ -266,6 +268,7 @@ def run_report(config: RunConfig) -> Mapping[str, Any]:
         "generated_at_utc": _utc_now(),
         "clock": _clock_block(config),
         "commit": _git_provenance(repo_root),
+        "integration_tip": _integration_tip(repo_root, config),
         "host_fingerprint": _host_fingerprint(environment),
         "library_versions": [
             {
@@ -927,6 +930,8 @@ def _run_config_dict(config: RunConfig) -> Mapping[str, Any]:
         "inject_unavailable": list(config.inject_unavailable),
         "repeat": config.repeat,
         "case_filter": list(config.case_filter),
+        "integration_tip": config.integration_tip,
+        "lock_log": config.lock_log,
     }
 
 
@@ -985,6 +990,23 @@ def _git_provenance(repo_root: str) -> Mapping[str, Any]:
     }
 
 
+def _integration_tip(repo_root: str, config: RunConfig) -> Mapping[str, Any]:
+    if config.integration_tip:
+        return {"sha": config.integration_tip, "source": "run config"}
+    try:
+        value = subprocess.run(
+            ["git", "rev-parse", "port/pypto-x-integration"],
+            cwd=repo_root, capture_output=True, text=True, timeout=10,
+        ).stdout.strip()
+    except (OSError, subprocess.SubprocessError):
+        value = ""
+    return {
+        "sha": value or "unknown",
+        "source": "git rev-parse port/pypto-x-integration",
+        "note": "integration tip the worktree branch was based on (base field of the task startup)",
+    }
+
+
 def _find_repo_root() -> str:
     here = os.path.dirname(os.path.abspath(__file__))
     for _ in range(8):
diff --git a/python/pypto/op_bench/schema.py b/python/pypto/op_bench/schema.py
index a6b289923..ef26f17c8 100644
--- a/python/pypto/op_bench/schema.py
+++ b/python/pypto/op_bench/schema.py
@@ -147,6 +147,7 @@ REPORT_SCHEMA: Mapping[str, Any] = {
         "generated_at_utc",
         "clock",
         "commit",
+        "integration_tip",
         "host_fingerprint",
         "library_versions",
         "provider_registry_state",
@@ -176,6 +177,12 @@ REPORT_SCHEMA: Mapping[str, Any] = {
             "properties": {"sha": _STRING, "branch": _STRING, "dirty": {"type": "boolean"}},
             "additionalProperties": True,
         },
+        "integration_tip": {
+            "type": "object",
+            "required": ["sha", "source"],
+            "properties": {"sha": _STRING, "source": _STRING},
+            "additionalProperties": True,
+        },
         "host_fingerprint": {
             "type": "object",
             "required": ["digest", "cpu_model", "nproc_online", "cpu_affinity", "virtualization"],
diff --git a/scripts/perf/op_bench_x86_run.sh b/scripts/perf/op_bench_x86_run.sh
index aaf71eaca..6224383dc 100755
--- a/scripts/perf/op_bench_x86_run.sh
+++ b/scripts/perf/op_bench_x86_run.sh
@@ -17,6 +17,8 @@ Q8_MATRIX="$EVIDENCE/../../vendor-gemm-survey/raw/vendor-gemm-matrix.json"
 Q8_TABLE="$EVIDENCE/../../w8j-vllm-injection/raw/shape-ratio-table.json"
 THREADS="${OP_BENCH_THREADS:-6}"
 BIND="${OP_BENCH_BIND:-0-5}"
+INTEGRATION_TIP="$(git -C "$WORKTREE" rev-parse port/pypto-x-integration 2>/dev/null || echo unknown)"
+LOCK_LOG="${OP_BENCH_LOCK_LOG:-$EVIDENCE/logs/x86/run_local_heavy.log}"
 export OMP_NUM_THREADS="$THREADS"
 export OMP_DYNAMIC=FALSE
 
@@ -42,6 +44,7 @@ run_phase main \
         --threads "$THREADS" --bind "$BIND" \
         --rounds auto --case-budget-seconds 20 --min-rounds 3 --iters 100 --warmup 5 \
         --q8-vendor-matrix "$Q8_MATRIX" --q8-ratio-table "$Q8_TABLE" \
+        --integration-tip "$INTEGRATION_TIP" --lock-log "$LOCK_LOG" \
         --tag q9-x86-model-boundary \
         --out "$RAW/main"
 
@@ -53,6 +56,7 @@ run_phase repro \
         --threads "$THREADS" --bind "$BIND" \
         --rounds 21 --warmup 5 --iters 100 \
         --repeat 2 \
+        --integration-tip "$INTEGRATION_TIP" --lock-log "$LOCK_LOG" \
         --tag q9-x86-repro \
         --out "$RAW/repro"
 
