+#!/usr/bin/env python3
+"""Summarise the fetched A3 C8/Q5 window into compact, auditable JSON.
+
+Inputs (all local, produced by fetch_results.sh):
+
+    raw/a3/bf16/<prompt>.json             driver stage-s3 evidence (per launch)
+    raw/a3/bf16/<prompt>.progress.log     per-op progress (mode/timing/RSS)
+    raw/a3/w8a8_repro/en_default.json     A3-side W8A8 lowering failure
+    raw/a3/gap_probe_a3.json              A3-side static lowering probe
+    logs/a3/env_evidence.log              A3 host/SVE/cc facts
+
+Output: raw/a3_summary.json
+
+This summary is diagnostic only: the bf16 run is NOT an L4 verdict and the
+numbers are not performance gates.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from pathlib import Path
+from typing import Any, Dict, List, Mapping
+
+PROMPTS = ("en_continuation", "zh_continuation", "chat_zh_user")
+STEPS = {"en_continuation": 5, "zh_continuation": 8, "chat_zh_user": 18}
+
+
+def load_json(path: Path) -> Any:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def parse_progress(path: Path) -> Mapping[str, Any]:
+    stages: Dict[str, Dict[str, Any]] = {}
+    peak_rss = 0
+    current_stage = "unknown"
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            item = json.loads(line)
+        except json.JSONDecodeError:
+            continue
+        rss = item.get("rss_mib")
+        if isinstance(rss, (int, float)):
+            peak_rss = max(peak_rss, int(rss))
+        if item.get("kind") == "stage-start":
+            current_stage = str(item.get("stage") or "unknown")
+            stages.setdefault(current_stage, {"ops": 0, "first_t": None, "last_t": None})
+            continue
+        if item.get("kind") != "op":
+            continue
+        entry = stages.setdefault(current_stage, {"ops": 0, "first_t": None, "last_t": None})
+        entry["ops"] += 1
+        t = item.get("t")
+        if isinstance(t, (int, float)):
+            if entry["first_t"] is None:
+                entry["first_t"] = float(t)
+            entry["last_t"] = float(t)
+    for entry in stages.values():
+        first, last = entry["first_t"], entry["last_t"]
+        entry["wall_seconds_progress"] = round(last - first, 3) if first and last else None
+    return {"stages": stages, "peak_rss_mib": peak_rss or None}
+
+
+def census_fields(record: Mapping[str, Any]) -> Mapping[str, Any]:
+    census = record.get("execution_mode_census") or {}
+    return {
+        "executed_operations": census.get("executed_operations"),
+        "boundary_totals": census.get("boundary_totals"),
+        "mode_totals": census.get("mode_totals"),
+        "scalar_lane_operations": census.get("scalar_lane_operations"),
+        "by_operation": census.get("by_operation"),
+    }
+
+
+def host_operations(census: Mapping[str, Any]) -> Mapping[str, Any]:
+    out = {}
+    for name, entry in (census.get("by_operation") or {}).items():
+        boundary = entry.get("boundary")
+        if boundary in ("host_boundary", "host_reference"):
+            out[name] = {"boundary": boundary, "count": entry.get("count"),
+                         "modes": entry.get("modes")}
+    return out
+
+
+def summarise_prompt(prompt: str, raw_dir: Path) -> Mapping[str, Any]:
+    driver_path = raw_dir / "bf16" / "{}.json".format(prompt)
+    progress_path = raw_dir / "bf16" / "{}.progress.log".format(prompt)
+    driver = load_json(driver_path)
+    progress = parse_progress(progress_path) if progress_path.is_file() else {}
+    prefill = census_fields(driver)
+    decode_steps: List[Mapping[str, Any]] = []
+    for step in driver.get("decode_steps") or []:
+        decode_steps.append({
+            "decode_step": step.get("decode_step"),
+            "position": step.get("position"),
+            "input_token": step.get("input_token"),
+            "argmax_token": step.get("argmax_token"),
+            "status": step.get("status"),
+            "launch_seconds": step.get("launch_seconds"),
+            "compile_seconds": (step.get("compile") or {}).get("compile_seconds"),
+            "executed_operations": step.get("operation_total"),
+            "boundary_totals": census_fields(step).get("boundary_totals"),
+            "peak_rss_mib": step.get("rss_peak_mib"),
+            "launch_error": step.get("launch_error"),
+            "outputs_sha256": {
+                name: entry.get("raw_sha256")
+                for name, entry in (step.get("outputs") or {}).items()
+            },
+        })
+    chain = ([driver.get("prefill_next_token")] +
+             [item.get("argmax_token") for item in driver.get("decode_steps") or []])
+    boundary_totals: Dict[str, int] = {}
+    for source in [prefill] + [census_fields(item) for item in driver.get("decode_steps") or []]:
+        for key, value in (source.get("boundary_totals") or {}).items():
+            boundary_totals[key] = boundary_totals.get(key, 0) + int(value)
+    total_ops = sum(boundary_totals.values())
+    return {
+        "prompt": prompt,
+        "steps": STEPS[prompt],
+        "status": driver.get("status"),
+        "launch_error": driver.get("launch_error"),
+        "wall_seconds": driver.get("wall_seconds"),
+        "prefill": {
+            "launch_seconds": driver.get("launch_seconds"),
+            "compile_seconds": (driver.get("compile") or {}).get("compile_seconds"),
+            "lower_seconds": (driver.get("compile") or {}).get("lower_seconds"),
+            "plan_count": (driver.get("compile") or {}).get("plan_count"),
+            "operation_total": driver.get("operation_total"),
+            "rss_peak_mib": driver.get("rss_peak_mib"),
+            "all_outputs_finite": driver.get("all_outputs_finite"),
+            "census": prefill,
+            "outputs_sha256": {
+                name: entry.get("raw_sha256")
+                for name, entry in (driver.get("outputs") or {}).items()
+            },
+        },
+        "decode_steps": decode_steps,
+        "token_chain": chain,
+        "executed_boundary_totals_all_launches": dict(sorted(boundary_totals.items())),
+        "host_operations": host_operations(prefill),
+        "progress": progress,
+        "not_l4": True,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--evidence-dir", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    ev = Path(args.evidence_dir).resolve()
+    raw = ev / "raw" / "a3"
+
+    summary: Dict[str, Any] = {
+        "stage": "a3_c8_q5_summary",
+        "not_l4": True,
+        "note": ("bf16 whole-net SVE256 link diagnostic only: no L4/accuracy/"
+                 "performance verdict"),
+        "prompts": {},
+    }
+    for prompt in PROMPTS:
+        if (raw / "bf16" / "{}.json".format(prompt)).is_file():
+            summary["prompts"][prompt] = summarise_prompt(prompt, raw)
+    w8a8 = raw / "w8a8_repro" / "en_default.json"
+    if w8a8.is_file():
+        payload = load_json(w8a8)
+        summary["w8a8_repro_on_a3"] = {
+            "status": payload.get("status"),
+            "error": payload.get("error"),
+            "wall_seconds": payload.get("wall_seconds"),
+            "started_at": payload.get("started_at"),
+        }
+    probe = raw / "gap_probe_a3.json"
+    if probe.is_file():
+        payload = load_json(probe)
+        summary["gap_probe_on_a3"] = {
+            "whole_net_w8a8": {
+                key: {
+                    "lower_sve256": value.get("lower_sve256"),
+                    "lower_error": value.get("lower_error"),
+                    "first_violation_operation": value.get("first_violation_operation"),
+                    "shadow_violation_operations": value.get("shadow_violation_operations"),
+                    "int8_transpose_bytes_positive": (
+                        (value.get("plan_census") or {}).get("int8_transpose_bytes_positive")),
+                }
+                for key, value in (payload.get("whole_net_w8a8") or {}).items()
+            },
+            "whole_net_bf16": {
+                key: {"lower_sve256": value.get("lower_sve256")}
+                for key, value in (payload.get("whole_net_bf16") or {}).items()
+            },
+            "minimal_repro": payload.get("minimal_repro"),
+            "code_facts": payload.get("code_facts"),
+        }
+    env = ev / "logs" / "a3" / "env_evidence.log"
+    if env.is_file():
+        summary["a3_env_evidence_text"] = env.read_text(encoding="utf-8", errors="replace")
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(summary, indent=2, sort_keys=True, default=str) + "\n",
+                                 encoding="utf-8")
+    print("[summary] wrote {} (prompts={})".format(
+        args.output, len(summary["prompts"])))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
