index 000000000..c94e24b72
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_execution_report_cross_block.py
@@ -0,0 +1,102 @@
+"""Report-only cross-block must-reject regressions (0042 follow-up).
+
+The view-mode/U2a verifier found four report-internal ground-truth pairs that
+were not cross-checked, plus fields whose truth is not present in the report:
+
+* ``resolution.capability_digest`` vs ``capability.snapshot_digest``;
+* ``resolution.contract_digest`` vs ``resolved.contract.digest``;
+* ``dispatch.provider_declared`` vs ``resolved.provider`` / invoked provider;
+* ``dispatch.fallback_used`` vs ``resolution.fallback_used``.
+
+Two fields the earlier boundary list assumed had no report-local truth are in
+fact derivable and are now must-reject too:
+
+* ``guarantees.accumulation`` from the registered OpDefinition contract and
+  ``request.dtype``;
+* ``guarantees.exactness_basis`` from the invoked provider family
+  (portable -> contract_and_order, vendor -> provider_version_threads_and_order).
+
+These tests use the portable path only, so they run without the AOCL artifact.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from pypto.execution import (
+    ExecutionPolicy,
+    execute_matmul,
+    validate_report_schema,
+)
+from pypto.backends.cpu import HostTensor
+
+
+def _report_document():
+    left = HostTensor("float32", (2, 4), [float(index + 1) for index in range(8)])
+    right = HostTensor("float32", (4, 4), [0.5] * 16)
+    _, report = execute_matmul(left, right, ExecutionPolicy())
+    return json.loads(json.dumps(report.to_dict()))
+
+
+@pytest.mark.parametrize(
+    "name,mutate",
+    (
+        (
+            "resolution_capability_digest",
+            lambda d: d["resolution"].update(capability_digest="sha256:" + "0" * 64),
+        ),
+        (
+            "resolution_contract_digest",
+            lambda d: d["resolution"].update(contract_digest="sha256:" + "1" * 64),
+        ),
+        (
+            "dispatch_provider_declared",
+            lambda d: d["dispatch"].update(provider_declared="vendor:onednn"),
+        ),
+        (
+            "dispatch_fallback_used",
+            lambda d: d["dispatch"].update(fallback_used=not d["dispatch"]["fallback_used"]),
+        ),
+    ),
+)
+def test_report_cross_block_forgeries_are_refused(name, mutate):
+    document = _report_document()
+    mutate(document)
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(document)
+    assert getattr(excinfo.value, "code", None) == "REPORT_SCHEMA_INVALID"
+
+
+@pytest.mark.parametrize(
+    "field,value,expected_reason",
+    (
+        ("accumulation", "forged_accumulation", "report_accumulation_not_reconciled"),
+        ("exactness_basis", "forged_basis", "report_exactness_basis_not_reconciled"),
+    ),
+)
+def test_report_contract_derived_guarantees_are_refused(field, value, expected_reason):
+    document = _report_document()
+    document["guarantees"][field] = value
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(document)
+    error = excinfo.value
+    assert getattr(error, "code", None) == "REPORT_SCHEMA_INVALID"
+    assert error.reason == expected_reason
+    assert any(item["field"] == "guarantees." + field for item in error.details.get("errors", []))
+
+
+def test_report_cross_block_preserves_genuine_report():
+    document = _report_document()
+    # A genuine report must still validate: the new checks only add refusals.
+    validate_report_schema(document)
+    assert document["resolution"]["capability_digest"] == document["capability"]["snapshot_digest"]
+    assert document["resolution"]["contract_digest"] == document["resolved"]["contract"]["digest"]
+    assert (
+        document["dispatch"]["provider_declared"]
+        == document["resolved"]["provider"]
+        == document["dispatch"]["provider_invoked"]
+    )
+    assert bool(document["dispatch"]["fallback_used"]) == bool(document["resolution"]["fallback_used"])
+    assert document["guarantees"]["exactness_basis"] == "contract_and_order"
