+def _compose_name(name: str, rename: Mapping[str, str]) -> str:
+    """Rewrite one sub-program SSA name with the longest matching rule.
+
+    ``rename`` maps either a complete value name or a name prefix to its
+    replacement (``{"rms_": "decoder_norm_"}``).  The longest matching key
+    wins, so an exact name always overrides a prefix rule.
+    """
+
+    best = None
+    for key in rename:
+        if (name == key or name.startswith(key)) and (best is None or len(key) > len(best)):
+            best = key
+    if best is None:
+        return name
+    return rename[best] + name[len(best):]
+
+
+def _compose_program(
+    builder: _Builder,
+    program: CoreProgram,
+    bindings: Mapping[str, ValueRef],
+    returns: Optional[Sequence[str]] = None,
+    rename: Optional[Mapping[str, str]] = None,
+) -> Tuple[ValueRef, ...]:
+    """Inline a sub-program's pure dataflow into ``builder`` (composition).
+
+    This is the composition primitive shared by every public composite that is
+    built out of smaller composites.  It performs a checked, dead-code-free
+    splice of the sub-program's operation DAG:
+
+    * every sub-function parameter must be bound to a parent ``ValueRef`` with
+      the identical ``CoreType``; parameters are never re-declared, so the
+      parent's public signature is unchanged;
+    * ``returns`` selects internal value names of the sub-program (defaults to
+      the sub-program's own returns) and only the operations reachable from
+      those values are emitted, in the sub-program's original order;
+    * ``rename`` rewrites emitted SSA names so a composed copy can meet the
+      parent's own naming contract or be instantiated more than once without a
+      duplicate-name error.  Collisions that are not resolved by ``rename``
+      fail loudly through ``_Builder._reserve``.
+
+    The emitted operations keep their opcode, operand order, attributes,
+    effect and output dtypes/shapes byte-for-byte.  A composition that is
+    numerically equivalent but not IR-identical is therefore impossible to
+    hide here.
+    """
+
+    if len(program.functions) != 1:
+        raise ValueError("composed program must contain exactly one function")
+    function = program.functions[0]
+    if function.body.blocks:
+        raise ValueError("composed function must use a direct operation region")
+    rename = dict(rename or {})
+
+    parameters = {ref.name: ref for ref in function.parameters}
+    resolvable: Dict[str, ValueRef] = {}
+    for name, ref in parameters.items():
+        if name not in bindings:
+            raise ValueError(
+                "composed parameter {!r} of {!r} has no parent binding".format(name, function.name)
+            )
+        bound = bindings[name]
+        if not isinstance(bound, ValueRef):
+            raise ValueError("binding for {!r} must be a ValueRef".format(name))
+        if bound.type != ref.type:
+            raise ValueError(
+                "binding for {!r} has type {} but the composite expects {}".format(
+                    name, bound.type.to_dict(), ref.type.to_dict()
+                )
+            )
+        resolvable[name] = bound
+
+    producers: Dict[str, Operation] = {}
+    for operation in function.body.operations:
+        for output in operation.outputs:
+            if output.name in producers:
+                raise ValueError(
+                    "composed function {!r} produces SSA name {!r} twice".format(
+                        function.name, output.name
+                    )
+                )
+            producers[output.name] = operation
+
+    selected = list(function.returns if returns is None else returns)
+    selected_names = [ref.name for ref in selected] if all(
+        isinstance(item, ValueRef) for item in selected
+    ) else list(selected)
+    for name in selected_names:
+        if name not in resolvable and name not in producers:
+            raise ValueError(
+                "composed value {!r} is neither a parameter nor an operation output".format(name)
+            )
+
+    needed: set = set()
+    pending = [name for name in selected_names if name in producers]
+    while pending:
+        name = pending.pop()
+        if name in needed:
+            continue
+        needed.add(name)
+        for input_ref in producers[name].inputs:
+            if input_ref.name in producers and input_ref.name not in needed:
+                pending.append(input_ref.name)
+
+    emitted: Dict[str, ValueRef] = {}
+    for operation in function.body.operations:
+        if not any(output.name in needed for output in operation.outputs):
+            continue
+        inputs = []
+        for input_ref in operation.inputs:
+            if input_ref.name in resolvable:
+                inputs.append(resolvable[input_ref.name])
+            elif input_ref.name in emitted:
+                inputs.append(emitted[input_ref.name])
+            else:
+                raise ValueError(
+                    "composed operation {!r} reads value {!r} that was not emitted".format(
+                        operation.name, input_ref.name
+                    )
+                )
+        output_specs = [
+            (_compose_name(output.name, rename), output.type) for output in operation.outputs
+        ]
+        if operation.effect.value != "pure":
+            raise ValueError("composed operation {!r} is not pure".format(operation.name))
+        if operation.regions:
+            raise ValueError("composed operation {!r} carries nested regions".format(operation.name))
+        new_outputs = builder.op(
+            operation.name,
+            tuple(inputs),
+            output_specs,
+            attributes=dict(operation.attributes),
+        )
+        for old, new in zip(operation.outputs, new_outputs):
+            emitted[old.name] = new
+
+    results = []
+    for name in selected_names:
+        results.append(resolvable[name] if name in resolvable else emitted[name])
+    return tuple(results)
+
+
