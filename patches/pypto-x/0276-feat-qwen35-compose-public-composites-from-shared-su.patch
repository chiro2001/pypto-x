+@pytest.mark.parametrize("label", sorted(FROZEN_DIGESTS))
+def test_frozen_ir_digest(label):
+    """Every composed program keeps the pre-refactor canonical digest."""
+
+    if label == "position_control.2x3.p7.h8.int32":
+        program = build_qwen35_position_control(2, 3, past_length=7, index_dtype="int32")
+    elif label == "causal_conv1d_state.bf16.2x6x5":
+        program = build_causal_conv1d_state((2, 6, 5), "bf16")
+    elif label == "gated_delta_conv_state.bf16.1x5.h8.c12":
+        program = build_qwen35_gated_delta_conv_state(1, 5, hidden=8, channels=12)
+    elif label == "decoder_subgraph.bf16.2x8.i10":
+        program = build_decoder_subgraph(2, hidden=8, intermediate=10)
+    elif label == "attention_kv_cache.bf16.b1.decode_t1_past5":
+        program = build_attention_kv_cache(
+            (1, 8, 1, 256),
+            (1, 2, 5, 256),
+            (1, 2, 5, 256),
+            (1, 2, 1, 256),
+            (1, 2, 1, 256),
+        )
+    elif label == "attention_subgraph.f32":
+        program = build_attention_subgraph(
+            (1, 4, 2, 4),
+            (1, 4, 2, 5),
+            (1, 2, 4, 4),
+            query_heads=4,
+            dtype="float32",
+            index_dtype="int32",
+            rotary_dim=2,
+        )
+    elif label == "text_decoder.synthetic.b2.t3":
+        program = build_qwen35_text_decoder_graph(2, 3, shape_profile="synthetic_test")
+    else:  # pragma: no cover - keeps the dispatch exhaustive
+        raise AssertionError("unhandled frozen digest label {!r}".format(label))
+    assert _canonical_sha256(program) == FROZEN_DIGESTS[label]
