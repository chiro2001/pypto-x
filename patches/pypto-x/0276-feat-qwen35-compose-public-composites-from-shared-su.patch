+def test_decoder_graph_layer_reuses_shared_composites():
+    graph = build_qwen35_text_decoder_graph(2, 3, shape_profile="synthetic_test")
+    profile = qwen35._decoder_shape_profile("synthetic_test", 8)
+    batch, steps = 2, 3
+    qh, kvh, d = profile["query_heads"], profile["kv_heads"], profile["head_dim"]
+    rotary = profile["rotary_dim"]
+    prefix = "layer_03"  # full-attention layer (indices 3/7/11/15/19/23)
+    rms_q = build_rms_norm((batch, qh, steps, d), "bf16", output_dtype="float32")
+    rope_q = build_rope_rotate_half(
+        (batch, qh, steps, d), "float32", output_dtype="float32", rotary_dim=rotary
+    )
+    mask = build_causal_mask((batch, qh, steps, steps), "float32")
+    softmax = build_stable_softmax((batch, qh, steps, steps), "float32", output_dtype="float32")
+    assert_embedded(
+        graph, rms_q, {"x": None, "weight": None, "epsilon": None},
+        ("rms_scaled",), {"rms_": prefix + "_q_norm_"},
+    )
+    assert_embedded(
+        graph, rope_q, {"x": None, "cos": None, "sin": None},
+        (qwen35._rope_core_result_name((batch, qh, steps, d), rotary, "rope"),),
+        {"rope_": prefix + "_q_rope_"},
+    )
+    assert_embedded(
+        graph, mask, {"logits": None, "causal_mask": None, "fill_value": None},
+        ("masked_f32",), {"masked_f32": prefix + "_masked_logits"},
+    )
+    assert_embedded(
+        graph, softmax, {"logits": None},
+        ("softmax_probabilities_f32",),
+        {"softmax_probabilities_f32": prefix + "_probabilities", "softmax_": prefix + "_softmax_"},
+    )
+    qk = build_batched_matmul((batch, qh, steps, d), (batch, qh, d, steps), "float32")
+    pv = build_batched_matmul((batch, qh, steps, steps), (batch, qh, steps, d), "float32")
+    assert_embedded(
+        graph, qk, {"left": None, "right": None}, ("output",),
+        {"output": prefix + "_qk_logits"},
+    )
+    assert_embedded(
+        graph, pv, {"left": None, "right": None}, ("output",),
+        {"output": prefix + "_context"},
+    )
+    prefix = "layer_00"  # GDR layer
+    l2 = build_l2_norm(
+        (batch, steps, profile["linear_key_heads"], profile["linear_key_dim"]),
+        "bf16",
+        output_dtype="float32",
+    )
+    conv = build_causal_conv1d_state(
+        (batch, 2 * profile["linear_key_heads"] * profile["linear_key_dim"]
+         + profile["linear_value_heads"] * profile["linear_value_dim"], steps),
+        "bf16",
+    )
+    assert_embedded(
+        graph, l2, {"x": None, "epsilon": None}, ("l2_normalized",),
+        {"l2_": prefix + "_q_l2_"},
+    )
+    assert_embedded(
+        graph, conv, {"mixed_qkv": None, "prior_state": None, "weight": None},
+        ("conv_output", "conv_new_state"), {"conv_": prefix + "_causal_conv_"},
+    )
