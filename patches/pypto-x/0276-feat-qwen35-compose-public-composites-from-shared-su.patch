+"""Qwen3.5 composite composition relations (batch 0048 slice A).
+
+These tests pin two things:
+
+1. the large composites are *structurally assembled* from the public small
+   composites, i.e. an exact copy of the selected sub-program dataflow can be
+   found in the parent program (same opcode, operand order, dtypes/shapes and
+   attributes, only SSA names rewritten by the documented ``rename`` rules);
+2. the composed programs keep the frozen pre-refactor IR digest byte-for-byte.
+
+The digest pins are the composition-equivalence oracle: any change that alters
+an operation, an operand, an attribute or the emission order fails here even
+when the numerical behaviour would still be inside tolerance.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+import pytest
+
+from pypto.core_ir import CoreFunction, CoreProgram, Operation
+from pypto.portable import qwen35
+from pypto.portable.qwen35 import (
+    build_attention_kv_cache,
+    build_batched_matmul,
+    build_attention_subgraph,
+    build_causal_conv1d_state,
+    build_causal_mask,
+    build_causal_mask_from_positions,
+    build_decoder_subgraph,
+    build_gqa_repeat_kv,
+    build_l2_norm,
+    build_position_ids,
+    build_qwen35_attention_kv_cache,
+    build_qwen35_gated_delta_conv_state,
+    build_qwen35_position_control,
+    build_qwen35_text_decoder_graph,
+    build_rms_norm,
+    build_rope_rotate_half,
+    build_stable_softmax,
+    build_swiglu,
+)
+
+# Frozen pre-refactor canonical digests (see contract 0018 §5).  The symbol
+# names are the labels of the batch-0048 baseline snapshot.
+FROZEN_DIGESTS = {
+    "position_control.2x3.p7.h8.int32": (
+        "1af2109e130b385a18ac15441721a6f9b11d20e2e34ec684fb9a7dd03046b848"
+    ),
+    "causal_conv1d_state.bf16.2x6x5": (
+        "00f62d13d92ad525b904c60230f50a71ca2c6749033b5be21ee4907db844fd8f"
+    ),
+    "gated_delta_conv_state.bf16.1x5.h8.c12": (
+        "713b701c6106abe1717453b5a2e6dd6eef008f8c11d6af5f117fd02740f07a89"
+    ),
+    "decoder_subgraph.bf16.2x8.i10": (
+        "33708c0d3401e74886733b5a75f52c8891dfc840dae31ba212e21e4ad1cc9bf8"
+    ),
+    "attention_kv_cache.bf16.b1.decode_t1_past5": (
+        "aa2bc3f16c6aa1a15a3a605e6865a94e47fac000b555ea278a3cf2371cb45db6"
+    ),
+    "attention_subgraph.f32": (
+        "3e0dc93ba7c477fd245e3a2cc34a5b8c6b02af333abfc7502777c76692b29400"
+    ),
+    "text_decoder.synthetic.b2.t3": (
+        "bd47d35bf9e9acdc2561a6e02be0639290231ba420469cc24644582726fc9eb4"
+    ),
+}
+
+
+def _canonical_sha256(program: CoreProgram) -> str:
+    return hashlib.sha256(program.canonical_json().encode("utf-8")).hexdigest()
+
+
+def _reachable_operations(
+    function: CoreFunction, selected: Sequence[str]
+) -> List[Operation]:
+    """Operations of ``function`` reachable from ``selected`` (program order)."""
+
+    producers: Dict[str, Operation] = {}
+    for operation in function.body.operations:
+        for output in operation.outputs:
+            producers[output.name] = operation
+    needed: set = set()
+    pending = [name for name in selected if name in producers]
+    while pending:
+        name = pending.pop()
+        if name in needed:
+            continue
+        needed.add(name)
+        for input_ref in producers[name].inputs:
+            if input_ref.name in producers and input_ref.name not in needed:
+                pending.append(input_ref.name)
+    return [
+        operation
+        for operation in function.body.operations
+        if any(output.name in needed for output in operation.outputs)
+    ]
+
+
+def _rename(name: str, rules: Mapping[str, str]) -> str:
+    best: Optional[str] = None
+    for key in rules:
+        if (name == key or name.startswith(key)) and (
+            best is None or len(key) > len(best)
+        ):
+            best = key
+    if best is None:
+        return name
+    return rules[best] + name[len(best):]
+
+
+def _expected_operation(
+    operation: Operation,
+    bindings: Mapping[str, Optional[str]],
+    rules: Mapping[str, str],
+) -> Dict[str, Any]:
+    inputs = []
+    for input_ref in operation.inputs:
+        if input_ref.name in bindings:
+            inputs.append((bindings[input_ref.name], input_ref.type.to_dict()))
+        else:
+            inputs.append((_rename(input_ref.name, rules), input_ref.type.to_dict()))
+    outputs = [
+        (_rename(output.name, rules), output.type.to_dict())
+        for output in operation.outputs
+    ]
+    return {
+        "name": operation.name,
+        "inputs": inputs,
+        "outputs": outputs,
+        "attributes": dict(operation.attributes),
+        "effect": operation.effect.value,
+    }
+
+
+def _actual_operation(operation: Operation) -> Dict[str, Any]:
+    return {
+        "name": operation.name,
+        "inputs": [(ref.name, ref.type.to_dict()) for ref in operation.inputs],
+        "outputs": [(ref.name, ref.type.to_dict()) for ref in operation.outputs],
+        "attributes": dict(operation.attributes),
+        "effect": operation.effect.value,
+    }
+
+
+def _matches(expected: Dict[str, Any], actual: Dict[str, Any]) -> bool:
+    if expected["name"] != actual["name"] or expected["effect"] != actual["effect"]:
+        return False
+    if expected["attributes"] != actual["attributes"]:
+        return False
+    if len(expected["inputs"]) != len(actual["inputs"]):
+        return False
+    for (name, dtype), (actual_name, actual_dtype) in zip(
+        expected["inputs"], actual["inputs"]
+    ):
+        if dtype != actual_dtype:
+            return False
+        if name is not None and name != actual_name:
+            return False
+    if len(expected["outputs"]) != len(actual["outputs"]):
+        return False
+    for (name, dtype), (actual_name, actual_dtype) in zip(
+        expected["outputs"], actual["outputs"]
+    ):
+        if dtype != actual_dtype or name != actual_name:
+            return False
+    return True
+
+
+def assert_embedded(
+    parent: CoreProgram,
+    child: CoreProgram,
+    bindings: Mapping[str, Optional[str]],
+    selected: Sequence[str],
+    rename: Optional[Mapping[str, str]] = None,
+) -> int:
+    """Assert an exact child dataflow window exists inside ``parent``."""
+
+    rules = dict(rename or {})
+    child_function = child.functions[0]
+    expected = [
+        _expected_operation(operation, bindings, rules)
+        for operation in _reachable_operations(child_function, selected)
+    ]
+    assert expected, "selected values {!r} reach no operation".format(tuple(selected))
+    parent_ops = list(parent.functions[0].body.operations)
+    found = None
+    for start in range(len(parent_ops) - len(expected) + 1):
+        window = parent_ops[start:start + len(expected)]
+        if all(
+            _matches(want, _actual_operation(got))
+            for want, got in zip(expected, window)
+        ):
+            if found is not None:
+                raise AssertionError("ambiguous embedded window for {}".format(selected))
+            found = start
+    assert found is not None, "child dataflow {} not found in parent".format(selected)
+    return found
+
+
+def test_position_control_is_exactly_position_ids_plus_causal_mask():
+    parent = build_qwen35_position_control(2, 3, past_length=7, index_dtype="int32")
+    positions = build_position_ids(2, 3, past_length=7, index_dtype="int32")
+    mask = build_causal_mask_from_positions(
+        2, 3, past_length=7, index_dtype="int32"
+    )
+    parent_ops = [operation.name for operation in parent.functions[0].body.operations]
+    child_ops = [
+        operation.name
+        for operation in positions.functions[0].body.operations
+    ] + [operation.name for operation in mask.functions[0].body.operations]
+    assert parent_ops == child_ops == ["iota", "iota", "iota", "compare"]
+    assert_embedded(parent, positions, {}, ("position_ids",))
+    assert_embedded(parent, mask, {}, ("causal_mask",))
+    assert [ref.name for ref in parent.functions[0].returns] == [
+        "position_ids",
+        "causal_mask",
+    ]
+
+
+def test_gated_delta_conv_state_reuses_causal_conv1d_state():
+    parent = build_qwen35_gated_delta_conv_state(1, 5, hidden=8, channels=12)
+    child = build_causal_conv1d_state((1, 12, 5))
+    start = assert_embedded(
+        parent,
+        child,
+        {
+            "mixed_qkv": "mixed_qkv",
+            "prior_state": "prior_state",
+            "weight": "conv_weight",
+        },
+        ("conv_output", "conv_new_state"),
+    )
+    # The prologue must be the in-projection path only; the whole conv tail is
+    # the composed child.
+    assert len(parent.functions[0].body.operations) == start + len(
+        child.functions[0].body.operations
+    )
+
