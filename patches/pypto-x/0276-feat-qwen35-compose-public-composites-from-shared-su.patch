+def test_attention_kv_cache_reuses_gqa_causal_mask_and_softmax():
+    parent = build_qwen35_attention_kv_cache(
+        (1, 8, 1, 256),
+        (1, 2, 5, 256),
+        (1, 2, 5, 256),
+        (1, 2, 1, 256),
+        (1, 2, 1, 256),
+    )
+    repeat_k = build_gqa_repeat_kv((1, 2, 6, 256), 8)
