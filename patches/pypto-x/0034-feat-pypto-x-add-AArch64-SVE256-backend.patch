+def _program(name, parameters, returns, operations):
+    return CoreProgram(functions=(CoreFunction(name, parameters, returns, Region(tuple(operations))),))
+
+
+def _target(*features, **attributes):
+    attributes = dict(attributes)
+    attributes.setdefault("vl_bytes", 32)
+    return TargetSpec("cpu", "aarch64-linux-gnu", features=features or ("sve",), attributes=attributes)
+
+
+def _elementwise(dtype="float32", shape=(19,), operation="add"):
+    value_type = CoreType.tensor(dtype, shape)
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    inputs = (left,) if operation == "neg" else (left, right)
+    return _program(operation, inputs, (output,), (Operation(operation, inputs, (output,)),))
+
+
+def _reduction(dtype, input_shape, output_shape, operation, attributes):
+    input_type = CoreType.tensor(dtype, input_shape)
+    output_type = CoreType.tensor(dtype, output_shape)
+    source = ValueRef("source", input_type)
+    output = ValueRef("output", output_type)
+    return _program(
+        operation,
+        (source,),
+        (output,),
+        (Operation(operation, (source,), (output,), attributes=attributes),),
+    )
+
+
+def _matmul(dtype, left_shape, right_shape):
+    left_type = CoreType.tensor(dtype, left_shape)
+    right_type = CoreType.tensor(dtype, right_shape)
+    output_type = CoreType.tensor(dtype, (left_shape[0], right_shape[1]))
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("output", output_type)
+    return _program(
+        "matmul",
+        (left, right),
+        (output,),
+        (Operation("matmul", (left, right), (output,)),),
+    )
+
+
+def _compile(program, tmp_path, target=None):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, target or _target("sve", "sve2"))
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+    return compiler, target_ir, artifact
+
+
+def _run(artifact, inputs, output, runtime=None):
+    (runtime or Sve256Runtime(execution_mode="qemu")).launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[output.descriptor()],
+        )
+    )
+
+
+def _scalar_run(program, inputs, output):
+    compiler = CpuScalarCompiler()
+    artifact = compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[value.descriptor(readonly=True) for value in inputs],
+            outputs=[output.descriptor()],
+        )
+    )
+
+
+def _bf16_bits(value):
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return (bits >> 16) & 0xFFFF
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
