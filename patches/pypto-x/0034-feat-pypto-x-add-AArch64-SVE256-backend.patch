@@ -0,0 +1,678 @@
+"""AArch64 SVE256 compiler and executable runner for PyPTO-X.
+
+The compiler emits an AArch64 ELF executable.  It is intentionally paired
+with a small stdin/stdout runner protocol: x86 hosts must never try to load an
+AArch64 ELF through ``ctypes``.  The runtime selects either direct native
+execution on AArch64 or an explicit QEMU execution mode.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import tempfile
+from typing import Any, Mapping, Optional
+
+from pypto.compiler.api import CompileOptions
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu.aarch64.sve import (
+    SVE256_BACKEND,
+    SVE256_LOWERING_VERSION,
+    Sve256Program,
+    lower_sve256,
+)
+from pypto.target import TargetSpec
+from pypto.target._utils import mapping_copy, sha256_bytes, sha256_text
+
+
+ARTIFACT_PAYLOAD_VERSION = 1
+DEFAULT_ARTIFACT_FORMAT = "pypto-x.cpu.sve256"
+RUNNER_PROTOCOL = "pypto-x.cpu.sve256.runner.v1"
+
+
+_NATIVE_SOURCE = r'''
+#include <arm_sve.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define PTX_MAGIC 0x56535850U /* little-endian bytes: PXSV */
+#define PTX_VERSION 1U
+#define PTX_STATUS_OK 0U
+#define PTX_STATUS_BAD_REQUEST 2U
+#define PTX_STATUS_RUNTIME 3U
+
+enum { PTX_COPY = 0, PTX_NEG = 1, PTX_ADD = 2, PTX_SUB = 3,
+       PTX_MUL = 4, PTX_DIV = 5, PTX_REDUCE_SUM = 6,
+       PTX_REDUCE_MAX = 7, PTX_MATMUL = 8 };
+
+typedef struct {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t operation;
+    uint32_t dtype;
+    uint32_t reserved;
+    uint32_t reserved2;
+    uint64_t count;
+    uint64_t m;
+    uint64_t k;
+    uint64_t n;
+} PtxRequest;
+
+typedef struct {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t status;
+    uint32_t dtype;
+    uint64_t count;
+} PtxResponse;
+
+static int read_all(unsigned char **out, size_t *size) {
+    size_t capacity = 4096, used = 0;
+    unsigned char *data = (unsigned char *)malloc(capacity);
+    if (!data) return -1;
+    for (;;) {
+        ssize_t got;
+        if (used == capacity) {
+            unsigned char *next;
+            capacity *= 2;
+            next = (unsigned char *)realloc(data, capacity);
+            if (!next) { free(data); return -1; }
+            data = next;
+        }
+        got = read(STDIN_FILENO, data + used, capacity - used);
+        if (got == 0) break;
+        if (got < 0) {
+            if (errno == EINTR) continue;
+            free(data); return -1;
+        }
+        used += (size_t)got;
+    }
+    *out = data;
+    *size = used;
+    return 0;
+}
+
+static int write_all(const void *source, size_t size) {
+    const unsigned char *data = (const unsigned char *)source;
+    while (size) {
+        ssize_t written = write(STDOUT_FILENO, data, size);
+        if (written < 0) {
+            if (errno == EINTR) continue;
+            return -1;
+        }
+        data += (size_t)written;
+        size -= (size_t)written;
+    }
+    return 0;
+}
+
+static inline uint16_t ptx_f32_to_bf16(float value) {
+    union { uint32_t bits; float value; } converted;
+    uint32_t rounding;
+    converted.value = value;
+    if ((converted.bits & 0x7f800000U) == 0x7f800000U)
+        return (uint16_t)(converted.bits >> 16);
+    rounding = 0x7fffU + ((converted.bits >> 16) & 1U);
+    return (uint16_t)((converted.bits + rounding) >> 16);
+}
+
+static inline float ptx_bf16_to_f32(uint16_t value) {
+    union { uint32_t bits; float value; } converted;
+    converted.bits = ((uint32_t)value) << 16;
+    return converted.value;
+}
+
+static inline svfloat32_t ptx_binary(int operation, svbool_t pg,
+                                     svfloat32_t left, svfloat32_t right) {
+    if (operation == PTX_ADD) return svadd_m(pg, left, right);
+    if (operation == PTX_SUB) return svsub_m(pg, left, right);
+    if (operation == PTX_MUL) return svmul_m(pg, left, right);
+    return svdiv_m(pg, left, right);
+}
+
+static void ptx_copy_f32(const float *input, float *output, uint64_t count) {
+    uint64_t index = 0;
+    while (index < count) {
+        svbool_t pg = svwhilelt_b32(index, count);
+        svfloat32_t value = svld1(pg, input + index);
+        svst1(pg, output + index, value);
+        index += svcntw();
+    }
+}
+
+static void ptx_neg_f32(const float *input, float *output, uint64_t count) {
+    uint64_t index = 0;
+    svfloat32_t zero = svdup_n_f32(0.0f);
+    while (index < count) {
+        svbool_t pg = svwhilelt_b32(index, count);
+        svfloat32_t value = svld1(pg, input + index);
+        svst1(pg, output + index, svsub_m(pg, zero, value));
+        index += svcntw();
+    }
+}
+
+static void ptx_binary_f32(int operation, const float *left,
+                           const float *right, float *output, uint64_t count) {
+    uint64_t index = 0;
+    while (index < count) {
+        svbool_t pg = svwhilelt_b32(index, count);
+        svfloat32_t a = svld1(pg, left + index);
+        svfloat32_t b = svld1(pg, right + index);
+        svst1(pg, output + index, ptx_binary(operation, pg, a, b));
+        index += svcntw();
+    }
+}
+
+static float ptx_reduce_f32(int operation, const float *input, uint64_t count) {
+    uint64_t index = 0;
+    svfloat32_t accumulator = operation == PTX_REDUCE_MAX
+        ? svdup_n_f32(-INFINITY) : svdup_n_f32(0.0f);
+    while (index < count) {
+        svbool_t pg = svwhilelt_b32(index, count);
+        svfloat32_t value = svld1(pg, input + index);
+        if (operation == PTX_REDUCE_MAX)
+            accumulator = svmax_m(pg, accumulator, value);
+        else
+            accumulator = svadd_m(pg, accumulator, value);
+        index += svcntw();
+    }
+    if (operation == PTX_REDUCE_MAX)
+        return svmaxv(svptrue_b32(), accumulator);
+    return svaddv(svptrue_b32(), accumulator);
+}
+
+static void ptx_matmul_f32(const float *left, const float *right,
+                           float *output, uint64_t m, uint64_t k, uint64_t n) {
+    uint64_t row;
+    for (row = 0; row < m; ++row) {
+        uint64_t column = 0;
+        while (column < n) {
+            uint64_t inner;
+            svbool_t pg = svwhilelt_b32(column, n);
+            svfloat32_t accumulator = svdup_n_f32(0.0f);
+            for (inner = 0; inner < k; ++inner) {
+                svfloat32_t a = svdup_n_f32(left[row * k + inner]);
+                svfloat32_t b = svld1(pg, right + inner * n + column);
+                accumulator = svadd_m(pg, accumulator, svmul_m(pg, a, b));
+            }
+            svst1(pg, output + row * n + column, accumulator);
+            column += svcntw();
+        }
+    }
+}
+
+static int ptx_run(const PtxRequest *request, const unsigned char *payload,
+                   unsigned char *result) {
+    uint64_t count = request->count;
+    size_t item_size = request->dtype == 0 ? sizeof(float) : sizeof(uint16_t);
+    if (request->dtype > 1) return PTX_STATUS_BAD_REQUEST;
+    if (request->operation == PTX_MATMUL) {
+        uint64_t left_count = request->m * request->k;
+        uint64_t right_count = request->k * request->n;
+        if (request->m && left_count / request->m != request->k) return PTX_STATUS_BAD_REQUEST;
+        if (request->k && right_count / request->k != request->n) return PTX_STATUS_BAD_REQUEST;
+        if (request->dtype == 0) {
+            ptx_matmul_f32((const float *)payload,
+                           (const float *)(payload + left_count * item_size),
+                           (float *)result, request->m, request->k, request->n);
+        } else {
+            float *left = (float *)malloc(left_count * sizeof(float));
+            float *right = (float *)malloc(right_count * sizeof(float));
+            float *output = (float *)malloc(count * sizeof(float));
+            uint64_t index;
+            if (!left || !right || !output) { free(left); free(right); free(output); return PTX_STATUS_RUNTIME; }
+            for (index = 0; index < left_count; ++index)
+                left[index] = ptx_bf16_to_f32(((const uint16_t *)payload)[index]);
+            for (index = 0; index < right_count; ++index)
+                right[index] = ptx_bf16_to_f32(((const uint16_t *)payload)[left_count + index]);
+            ptx_matmul_f32(left, right, output, request->m, request->k, request->n);
+            for (index = 0; index < count; ++index) ((uint16_t *)result)[index] = ptx_f32_to_bf16(output[index]);
+            free(left); free(right); free(output);
+        }
+        return PTX_STATUS_OK;
+    }
+    if (request->operation == PTX_REDUCE_SUM || request->operation == PTX_REDUCE_MAX) {
+        if (count == 0 && request->operation == PTX_REDUCE_MAX) return PTX_STATUS_BAD_REQUEST;
+        if (request->dtype == 0) {
+            *(float *)result = ptx_reduce_f32(request->operation, (const float *)payload, count);
+        } else {
+            float *values = (float *)malloc(count * sizeof(float));
+            uint64_t index;
+            float reduced;
+            if (count && !values) return PTX_STATUS_RUNTIME;
+            for (index = 0; index < count; ++index) values[index] = ptx_bf16_to_f32(((const uint16_t *)payload)[index]);
+            if (request->operation == PTX_REDUCE_SUM) {
+                /* Keep the BF16 reference contract deterministic: convert
+                 * each input to FP32, accumulate in FP32 order, and round
+                 * once at the output boundary. */
+                reduced = 0.0f;
+                for (index = 0; index < count; ++index) reduced += values[index];
+            } else {
+                reduced = ptx_reduce_f32(request->operation, values, count);
+            }
+            *(uint16_t *)result = ptx_f32_to_bf16(reduced);
+            free(values);
+        }
+        return PTX_STATUS_OK;
+    }
+    if (request->operation == PTX_COPY) {
+        if (request->dtype == 0) ptx_copy_f32((const float *)payload, (float *)result, count);
+        else {
+            float *values = (float *)malloc(count * sizeof(float));
+            uint64_t index;
+            if (count && !values) return PTX_STATUS_RUNTIME;
+            for (index = 0; index < count; ++index) values[index] = ptx_bf16_to_f32(((const uint16_t *)payload)[index]);
+            ptx_copy_f32(values, values, count);
+            for (index = 0; index < count; ++index) ((uint16_t *)result)[index] = ptx_f32_to_bf16(values[index]);
+            free(values);
+        }
+        return PTX_STATUS_OK;
+    }
+    if (request->operation == PTX_NEG ||
+        request->operation == PTX_ADD || request->operation == PTX_SUB ||
+        request->operation == PTX_MUL || request->operation == PTX_DIV) {
+        const unsigned char *second = payload + count * item_size;
+        if (request->dtype == 0) {
+            if (request->operation == PTX_NEG) ptx_neg_f32((const float *)payload, (float *)result, count);
+            else ptx_binary_f32(request->operation, (const float *)payload,
+                                (const float *)second, (float *)result, count);
+        } else {
+            float *left = (float *)malloc(count * sizeof(float));
+            float *right = (float *)malloc(count * sizeof(float));
+            float *output = (float *)malloc(count * sizeof(float));
+            uint64_t index;
+            if ((count && !left) || (count && !right) || (count && !output)) {
+                free(left); free(right); free(output); return PTX_STATUS_RUNTIME;
+            }
+            for (index = 0; index < count; ++index) {
+                left[index] = ptx_bf16_to_f32(((const uint16_t *)payload)[index]);
+                if (request->operation != PTX_NEG)
+                    right[index] = ptx_bf16_to_f32(((const uint16_t *)second)[index]);
+            }
+            if (request->operation == PTX_NEG) ptx_neg_f32(left, output, count);
+            else ptx_binary_f32(request->operation, left, right, output, count);
+            for (index = 0; index < count; ++index) ((uint16_t *)result)[index] = ptx_f32_to_bf16(output[index]);
+            free(left); free(right); free(output);
+        }
+        return PTX_STATUS_OK;
+    }
+    return PTX_STATUS_BAD_REQUEST;
+}
+
+/* The QEMU runner normally marshals through stdin/stdout, so it cannot pass
+ * the caller's raw host pointer alignment into the AArch64 process.  Keep a
+ * tiny native guarded-buffer check in the ELF itself for the unaligned and
+ * canary contract. */
+static int ptx_guarded_self_test(void) {
+    enum { count = 19 };
+    unsigned char left_raw[count * sizeof(float) + 2];
+    unsigned char right_raw[count * sizeof(float) + 2];
+    unsigned char output_raw[count * sizeof(float) + 2];
+    float *left = (float *)(left_raw + 1);
+    float *right = (float *)(right_raw + 1);
+    float *output = (float *)(output_raw + 1);
+    int index;
+    left_raw[0] = 0xa5; left_raw[sizeof(left_raw) - 1] = 0x5a;
+    right_raw[0] = 0xa5; right_raw[sizeof(right_raw) - 1] = 0x5a;
+    output_raw[0] = 0xa5; output_raw[sizeof(output_raw) - 1] = 0x5a;
+    for (index = 0; index < count; ++index) {
+        left[index] = (float)index;
+        right[index] = 2.0f;
+        output[index] = -1.0f;
+    }
+    ptx_binary_f32(PTX_ADD, left, right, output, count);
+    if (left_raw[0] != 0xa5 || left_raw[sizeof(left_raw) - 1] != 0x5a ||
+        right_raw[0] != 0xa5 || right_raw[sizeof(right_raw) - 1] != 0x5a ||
+        output_raw[0] != 0xa5 || output_raw[sizeof(output_raw) - 1] != 0x5a)
+        return 1;
+    for (index = 0; index < count; ++index)
+        if (output[index] != (float)(index + 2)) return 2;
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    unsigned char *input = NULL;
+    size_t input_size = 0;
+    PtxRequest request;
+    PtxResponse response;
+    size_t item_size;
+    uint64_t output_count;
+    size_t payload_offset = sizeof(PtxRequest);
+    size_t payload_size;
+    size_t result_size;
+    unsigned char *result = NULL;
+    int status;
+    if (argc == 2 && strcmp(argv[1], "--guarded-self-test") == 0)
+        return ptx_guarded_self_test();
+    if (read_all(&input, &input_size) != 0 || input_size < sizeof(PtxRequest)) return 10;
+    memcpy(&request, input, sizeof(request));
+    if (request.magic != PTX_MAGIC || request.version != PTX_VERSION || request.reserved || request.reserved2) {
+        free(input); return 11;
+    }
+    item_size = request.dtype == 0 ? sizeof(float) : sizeof(uint16_t);
+    if (request.operation == PTX_MATMUL) output_count = request.m * request.n;
+    else if (request.operation == PTX_REDUCE_SUM || request.operation == PTX_REDUCE_MAX) output_count = 1;
+    else output_count = request.count;
+    if (request.operation == PTX_MATMUL)
+        payload_size = (size_t)(request.m * request.k + request.k * request.n) * item_size;
+    else if (request.operation == PTX_NEG || request.operation == PTX_COPY ||
+             request.operation == PTX_REDUCE_SUM || request.operation == PTX_REDUCE_MAX)
+        payload_size = (size_t)request.count * item_size;
+    else
+        payload_size = (size_t)request.count * item_size * 2;
+    if (payload_offset > input_size || payload_size > input_size - payload_offset) {
+        free(input); return 12;
+    }
+    result_size = (size_t)output_count * item_size;
+    result = result_size ? (unsigned char *)malloc(result_size) : NULL;
+    if (result_size && !result) { free(input); return 13; }
+    status = ptx_run(&request, input + payload_offset, result);
+    response.magic = PTX_MAGIC;
+    response.version = PTX_VERSION;
+    response.status = (uint32_t)status;
+    response.dtype = request.dtype;
+    response.count = output_count;
+    if (write_all(&response, sizeof(response)) != 0 ||
+        (status == PTX_STATUS_OK && result_size && write_all(result, result_size) != 0)) {
+        free(result); free(input); return 14;
+    }
+    free(result);
+    free(input);
+    return status == PTX_STATUS_OK ? 0 : 15;
+}
+'''
+
+
+class Sve256CompileError(RuntimeError):
+    """The AArch64 compiler could not produce an SVE256 ELF."""
+
+
+def _plain_value(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _plain_value(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain_value(item) for item in value]
+    return value
+
+
+def _plain_mapping(value: Mapping[str, Any]) -> dict:
+    if not isinstance(value, Mapping):
+        raise TypeError("metadata must be a mapping")
+    return {key: _plain_value(item) for key, item in value.items()}
+
+
+def _cacheable_extra(value: Mapping[str, Any]) -> dict:
+    volatile = frozenset(("build_dir", "tmp_dir", "artifact_dir", "source_path", "output_path"))
+    return {key: _plain_value(item) for key, item in value.items() if key not in volatile}
+
+
+def _build_directory(options: Optional[CompileOptions]) -> Path:
+    extra = {} if options is None else mapping_copy(options.extra)
+    selected = extra.get("build_dir") or os.environ.get("PYPTO_X_SVE256_BUILD_DIR")
+    if selected is None:
+        selected = tempfile.mkdtemp(prefix="pypto-x-sve256-", dir=os.environ.get("TMPDIR") or None)
+    path = Path(os.fspath(selected)).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    (path / "tmp").mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _artifact_directory(options: Optional[CompileOptions], build_dir: Path) -> Path:
+    extra = {} if options is None else mapping_copy(options.extra)
+    selected = extra.get("artifact_dir") or os.environ.get("PYPTO_X_SVE256_ARTIFACT_DIR")
+    path = Path(os.fspath(selected or (build_dir / "artifacts"))).resolve()
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+def _read_and_lock_existing_artifact(path: Path) -> Optional[bytes]:
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(str(path), os.O_RDONLY | nofollow)
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise Sve256CompileError(
+            "content-addressed SVE artifact path is not safe: {} ({})".format(path, exc)
+        ) from exc
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
+            raise Sve256CompileError(
+                "content-addressed SVE artifact must be a single-link regular file: {}".format(path)
+            )
+        chunks = []
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        os.fchmod(descriptor, 0o555)
+        return b"".join(chunks)
+    finally:
+        os.close(descriptor)
+
+
+def _native_source(target_ir: Sve256Program) -> tuple:
+    contract = "pypto-x.cpu.sve256.native.v1\n{}\nvariant={}\nvl_bytes=32\n".format(
+        _NATIVE_SOURCE, target_ir.native_variant
+    )
+    digest = hashlib.sha256(contract.encode("utf-8")).hexdigest()
+    return _NATIVE_SOURCE, digest
+
+
+def _compiler_info(compiler_path: str) -> tuple:
+    version_result = subprocess.run(
+        [compiler_path, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        universal_newlines=True, check=False,
+    )
+    version = (version_result.stdout.splitlines() or [compiler_path])[0].strip()
+    triple_result = subprocess.run(
+        [compiler_path, "-dumpmachine"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        universal_newlines=True, check=False,
+    )
+    triple = triple_result.stdout.strip() or "unknown"
+    if not triple.lower().startswith(("aarch64", "arm64")):
+        raise Sve256CompileError("compiler target triple {!r} is not AArch64".format(triple))
+    return version, triple
+
+
+def _compile_native(target_ir: Sve256Program, options: Optional[CompileOptions]) -> tuple:
+    extra = {} if options is None else mapping_copy(options.extra)
+    compiler = str(extra.get("aarch64_compiler") or extra.get("compiler") or "aarch64-linux-gnu-gcc")
+    compiler_path = shutil.which(compiler) or compiler
+    if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
+        raise Sve256CompileError("AArch64 compiler {!r} was not found".format(compiler))
+    compiler_version, target_triple = _compiler_info(compiler_path)
+    build_dir = _build_directory(options)
+    artifact_dir = _artifact_directory(options, build_dir)
+    source, source_digest = _native_source(target_ir)
+    stem = "pypto_x_sve256_{}".format(source_digest[:20])
+    invocation = Path(tempfile.mkdtemp(prefix=stem + "-", dir=str(build_dir / "tmp")))
+    source_path = invocation / (stem + ".c")
+    temporary_output = invocation / (stem + ".elf")
+    native_flags = (
+        "-static", "-O2", "-std=c99", "-march=armv8.2-a+sve", "-msve-vector-bits=256"
+    )
+    command = [compiler_path] + list(native_flags) + [str(source_path), "-o", str(temporary_output)]
+    try:
+        source_path.write_text(source, encoding="utf-8")
+        environment = dict(os.environ)
+        environment["TMPDIR"] = str(build_dir / "tmp")
+        result = subprocess.run(
+            command, cwd=str(invocation), env=environment, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE, universal_newlines=True, check=False,
+        )
+        if result.returncode != 0 or not temporary_output.is_file():
+            raise Sve256CompileError(
+                "AArch64 SVE256 compilation failed ({}): {}".format(
+                    result.returncode, (result.stderr or result.stdout).strip()
+                )
+            )
+        native_bytes = temporary_output.read_bytes()
+    finally:
+        shutil.rmtree(str(invocation), ignore_errors=True)
+    native_digest = sha256_bytes(native_bytes)
+    output_path = artifact_dir / ("pypto_x_sve256_{}.elf".format(native_digest))
+    existing = _read_and_lock_existing_artifact(output_path)
+    if existing is not None:
+        if existing != native_bytes:
+            raise Sve256CompileError("content-addressed SVE artifact path contains different bytes")
+    else:
+        descriptor, temporary_name = tempfile.mkstemp(prefix=output_path.name + ".tmp.", dir=str(artifact_dir))
+        os.close(descriptor)
+        publication = Path(temporary_name)
+        try:
+            publication.write_bytes(native_bytes)
+            os.chmod(str(publication), 0o555)
+            existing = _read_and_lock_existing_artifact(output_path)
+            if existing is not None:
+                if existing != native_bytes:
+                    raise Sve256CompileError("content-addressed SVE publication raced with different bytes")
+            else:
+                os.replace(str(publication), str(output_path))
+        finally:
+            if publication.exists():
+                publication.unlink()
+    normalized = [Path(compiler_path).name]
+    normalized.extend(list(native_flags))
+    normalized.extend([source_path.name, "-o", output_path.name])
+    return (
+        output_path, source_digest, native_digest, compiler_path, compiler_version,
+        target_triple, tuple(normalized), native_flags,
+    )
+
+
+class Sve256Compiler:
+    """Lower and compile an SVE256 program with an AArch64 compiler."""
+
+    name = SVE256_BACKEND
+
+    def lower(self, program: CoreProgram, target: TargetSpec) -> Sve256Program:
+        return lower_sve256(program, target)
+
+    def compile(self, target_ir: Sve256Program, options: Optional[CompileOptions] = None) -> Artifact:
+        if not isinstance(target_ir, Sve256Program):
+            raise TypeError("SVE256 compile() requires Sve256Program from lower()")
+        if options is not None and not isinstance(options, CompileOptions):
+            raise TypeError("options must be CompileOptions")
+        if options is not None and options.artifact_format != DEFAULT_ARTIFACT_FORMAT:
+            raise Sve256CompileError(
+                "SVE256 compiler requires artifact format {!r}, got {!r}".format(
+                    DEFAULT_ARTIFACT_FORMAT, options.artifact_format
+                )
+            )
+        if options is not None and options.abi_version != ABI_VERSION:
+            raise Sve256CompileError("SVE256 compiler requires ABI {!r}".format(ABI_VERSION))
+        target_ir.validate()
+        (
+            output_path, source_digest, native_digest, compiler_path,
+            compiler_version, target_triple, command, native_flags,
+        ) = _compile_native(target_ir, options)
+        program_json = target_ir.program.canonical_json()
+        program_data = json.loads(program_json)
+        program_digest = hashlib.sha256(program_json.encode("utf-8")).hexdigest()
+        plan_data = _plain_mapping(target_ir.vector_program.to_dict())
+        metadata = {
+            "backend": SVE256_BACKEND,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "lowering_version": SVE256_LOWERING_VERSION,
+            "plan_version": plan_data["plan_version"],
+            "entrypoint": target_ir.entrypoint,
+            "program": program_data,
+            "program_digest": program_digest,
+            "vector_plan": plan_data,
+            "plan_digest": target_ir.plan_digest,
+            "target_digest": sha256_text(target_ir.target.to_dict()),
+            "required_features": list(target_ir.required_features.features),
+            "required_feature_source": target_ir.required_features.source,
+            "native_isa": "sve",
+            "native_format": "elf-executable",
+            "native_digest": native_digest,
+            "native_source_digest": source_digest,
+            "native_variant": target_ir.native_variant,
+            "native_flags": list(native_flags),
+            "compiler": Path(compiler_path).name,
+            "compiler_version": compiler_version,
+            "compiler_target_triple": target_triple,
+            "compile_command": list(command),
+            "runner_protocol": RUNNER_PROTOCOL,
+            "target_vl_bytes": 32,
+            "emitting_features": ["sve"],
+            "sve2_required": False,
+            "execution_modes": ["native", "qemu"],
+            "guarded_buffer_self_test": True,
+        }
+        if options is not None:
+            option_metadata = _plain_mapping(options.metadata)
+            reserved = set(metadata).intersection(option_metadata)
+            if reserved:
+                raise ValueError(
+                    "compile option metadata uses reserved SVE256 keys: {}".format(
+                        ", ".join(sorted(reserved))
+                    )
+                )
+            metadata.update(option_metadata)
+            metadata["compile_options"] = {
+                "artifact_format": options.artifact_format,
+                "abi_version": options.abi_version,
+                "extra": _cacheable_extra(mapping_copy(options.extra)),
+            }
+            artifact_format = options.artifact_format
+            abi_version = options.abi_version
+        else:
+            artifact_format = DEFAULT_ARTIFACT_FORMAT
+            abi_version = ABI_VERSION
+        artifact = Artifact(
+            format=artifact_format,
+            entrypoint=target_ir.entrypoint,
+            target=target_ir.target,
+            abi_version=abi_version,
+            path=str(output_path),
+            metadata=metadata,
+        )
+        artifact.validate()
+        if artifact.content_digest != native_digest:
+            raise Sve256CompileError("native artifact digest changed while packaging")
+        return artifact
+
+
+CPUSVE256Compiler = Sve256Compiler
+CPUSve256Compiler = Sve256Compiler
+SVE256Compiler = Sve256Compiler
+CpuSVE256Compiler = Sve256Compiler
+
+
+def compile_cpu_sve256(
+    program: CoreProgram,
+    target: TargetSpec,
+    options: Optional[CompileOptions] = None,
+) -> Artifact:
+    compiler = Sve256Compiler()
+    return compiler.compile(compiler.lower(program, target), options)
+
+
+__all__ = [
+    "ARTIFACT_PAYLOAD_VERSION",
+    "CPUSVE256Compiler",
+    "CPUSve256Compiler",
+    "CpuSVE256Compiler",
+    "DEFAULT_ARTIFACT_FORMAT",
+    "RUNNER_PROTOCOL",
+    "Sve256CompileError",
+    "Sve256Compiler",
+    "SVE256Compiler",
+    "compile_cpu_sve256",
+]
