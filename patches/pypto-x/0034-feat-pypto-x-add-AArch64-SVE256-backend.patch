+    with pytest.raises(CpuSve256ArtifactError, match="only sve and vl256"):
+        Sve256Runtime(execution_mode="qemu").load(artifact)
+
+    _, _, artifact = _compile(_elementwise(), tmp_path / "missing")
+    unavailable = Sve256Capability.injected_capability(())
+    monkeypatch.setattr(capabilities_module, "probe_sve256_capabilities", lambda **kwargs: unavailable)
+    runtime = Sve256Runtime(capability=unavailable, execution_mode="qemu")
+    with pytest.raises(CpuSve256UnavailableError):
+        runtime.launch(
+            LaunchRequest(
+                artifact,
+                inputs=[
+                    HostTensor("float32", (19,), [1.0] * 19).descriptor(readonly=True),
+                    HostTensor("float32", (19,), [2.0] * 19).descriptor(readonly=True),
+                ],
+                outputs=[HostTensor.zeros("float32", (19,)).descriptor()],
+            )
+        )
+
+
+def test_sve_objdump_proves_predicated_sve_and_no_neon(tmp_path):
+    _, _, artifact = _compile(_elementwise(shape=(19,)), tmp_path)
+    objdump = shutil.which("aarch64-linux-gnu-objdump")
+    if objdump is None:
+        pytest.skip("AArch64 objdump is unavailable")
+    result = subprocess.run(
+        [objdump, "-d", artifact.path], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        universal_newlines=True, check=True,
+    )
+    text = result.stdout.lower()
+    assert "whilelo" in text
+    assert "z" in text
+    assert "p" in text
+    assert "neon" not in text
+
