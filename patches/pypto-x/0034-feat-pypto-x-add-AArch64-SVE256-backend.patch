+def test_sve_non_aligned_raw_descriptor_and_canary_are_safe(tmp_path):
+    program = _elementwise(shape=(19,))
+    _, _, artifact = _compile(program, tmp_path)
+    raw_left = (ctypes.c_ubyte * (19 * 4 + 2))()
+    raw_right = (ctypes.c_ubyte * (19 * 4 + 2))()
+    raw_output = (ctypes.c_ubyte * (19 * 4 + 2))()
+    left_address = ctypes.addressof(raw_left) + 1
+    right_address = ctypes.addressof(raw_right) + 1
+    output_address = ctypes.addressof(raw_output) + 1
+    left = ctypes.cast(left_address, ctypes.POINTER(ctypes.c_float))
+    right = ctypes.cast(right_address, ctypes.POINTER(ctypes.c_float))
+    output = ctypes.cast(output_address, ctypes.POINTER(ctypes.c_float))
+    raw_output[0] = 0xA5
+    raw_output[-1] = 0x5A
+    for index in range(19):
+        left[index] = float(index)
+        right[index] = 2.0
+        output[index] = -1.0
+    Sve256Runtime(execution_mode="qemu").launch(
+        LaunchRequest(
+            artifact,
+            inputs=[
+                TensorDesc("float32", (19,), address=left_address, readonly=True),
+                TensorDesc("float32", (19,), address=right_address, readonly=True),
+            ],
+            outputs=[TensorDesc("float32", (19,), address=output_address)],
+        )
