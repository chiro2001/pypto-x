diff --git a/python/pypto/lowering/cpu/aarch64/sve/capabilities.py b/python/pypto/lowering/cpu/aarch64/sve/capabilities.py
new file mode 100644
index 000000000..0236ed1cb
--- /dev/null
+++ b/python/pypto/lowering/cpu/aarch64/sve/capabilities.py
@@ -0,0 +1,338 @@
+"""AArch64 SVE/SVE2 capability probing for PyPTO-X.
+
+The probe uses Linux ``getauxval`` and ``prctl(PR_SVE_GET_VL)`` on the
+target.  On an x86 development host the same AArch64 probe is cross-compiled
+and executed by QEMU.  No host ``/proc/cpuinfo`` flags are consulted.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import lru_cache
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import subprocess
+import tempfile
+from typing import Any, Mapping, Optional, Tuple
+
+
+SVE256_VL_BYTES = 32
+SVE_HWCAP_BIT = 1 << 22
+SVE2_HWCAP2_BIT = 1 << 1
+
+
+_PROBE_SOURCE = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/auxv.h>
+#include <sys/prctl.h>
+
+#ifndef HWCAP_SVE
+#define HWCAP_SVE (1UL << 22)
+#endif
+#ifndef HWCAP2_SVE2
+#define HWCAP2_SVE2 (1UL << 1)
+#endif
+#ifndef PR_SVE_GET_VL
+#define PR_SVE_GET_VL 51
+#endif
+#ifndef PR_SVE_VL_LEN_MASK
+#define PR_SVE_VL_LEN_MASK 0xffff
+#endif
+
+int main(void) {
+    unsigned long hwcap = getauxval(AT_HWCAP);
+    unsigned long hwcap2 = getauxval(AT_HWCAP2);
+    int raw_vl = prctl(PR_SVE_GET_VL);
+    int vl = raw_vl < 0 ? -1 : (raw_vl & PR_SVE_VL_LEN_MASK);
+    printf("{\"hwcap\":%lu,\"hwcap2\":%lu,\"sve\":%d,\"sve2\":%d,\"vl_bytes\":%d}\n",
+           hwcap, hwcap2, (hwcap & HWCAP_SVE) != 0,
+           (hwcap2 & HWCAP2_SVE2) != 0, vl);
+    return 0;
+}
+'''
+
+
+class Sve256ProbeError(RuntimeError):
+    """The AArch64 capability probe could not be built or executed."""
+
+
+def _normalise_features(value: Any) -> Tuple[str, ...]:
+    if isinstance(value, str):
+        value = (value,)
+    try:
+        names = {str(item).strip().lower().replace("-", "_") for item in (value or ())}
+    except TypeError as exc:
+        raise ValueError("SVE capability features must be a sequence") from exc
+    aliases = {"sve_256": "sve256", "vl_256": "vl256", "sve_vl_256": "vl256"}
+    return tuple(sorted(aliases.get(name, name) for name in names if name))
+
+
+@dataclass(frozen=True)
+class Sve256Capability:
+    """Structured result of the AArch64 SVE probe.
+
+    ``available`` means that SVE is present and the process vector length is
+    exactly 32 bytes.  SVE2 is reported independently and is deliberately not
+    folded into the SVE256 required feature contract.
+    """
+
+    available: bool
+    features: Tuple[str, ...]
+    source: str
+    reason_code: Optional[str]
+    reason: Optional[str]
+    compiler: str
+    target_triple: str
+    hwcap: int
+    hwcap2: int
+    vl_bytes: int
+    sve: bool
+    sve2: bool
+    emulated: bool = False
+    execution_mode: str = "native"
+    injected: bool = False
+
+    @property
+    def vector_length_bytes(self) -> int:
+        return self.vl_bytes
+
+    @property
+    def actual_vl_bytes(self) -> int:
+        return self.vl_bytes
+
+    @property
+    def native(self) -> bool:
+        return not self.emulated
+
+    @property
+    def sve256(self) -> bool:
+        return bool(self.sve and self.vl_bytes == SVE256_VL_BYTES)
+
+    @property
+    def available_features(self) -> Tuple[str, ...]:
+        return self.features
+
+    @classmethod
+    def injected_capability(
+        cls,
+        features: Any = ("sve", "vl256"),
+        *,
+        vl_bytes: int = SVE256_VL_BYTES,
+        sve2: Optional[bool] = None,
+        emulated: bool = False,
+        source: str = "injected",
+    ) -> "Sve256Capability":
+        names = set(_normalise_features(features))
+        sve = "sve" in names or "sve256" in names
+        if "sve256" in names:
+            names.add("sve")
+        if vl_bytes == SVE256_VL_BYTES:
+            names.add("vl256")
+        has_sve2 = "sve2" in names if sve2 is None else bool(sve2)
+        if has_sve2:
+            names.add("sve2")
+        available = bool(sve and vl_bytes == SVE256_VL_BYTES)
+        return cls(
+            available,
+            tuple(sorted(names)),
+            source,
+            None if available else ("missing_cpu_features" if not sve else "unsupported_vector_length"),
+            None if available else (
+                "injected capability lacks SVE" if not sve else
+                "injected SVE vector length is not 32 bytes"
+            ),
+            "injected",
+            "aarch64-linux-gnu",
+            SVE_HWCAP_BIT if sve else 0,
+            SVE2_HWCAP2_BIT if has_sve2 else 0,
+            int(vl_bytes),
+            sve,
+            has_sve2,
+            bool(emulated),
+            "qemu" if emulated else "native",
+            True,
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "available": self.available,
+            "features": list(self.features),
+            "source": self.source,
+            "reason_code": self.reason_code,
+            "reason": self.reason,
+            "compiler": self.compiler,
+            "target_triple": self.target_triple,
+            "hwcap": self.hwcap,
+            "hwcap2": self.hwcap2,
+            "vl_bytes": self.vl_bytes,
+            "vector_length_bytes": self.vl_bytes,
+            "sve": self.sve,
+            "sve2": self.sve2,
+            "emulated": self.emulated,
+            "execution_mode": self.execution_mode,
+            "injected": self.injected,
+        }
+
+
+def _host_is_aarch64() -> bool:
+    return platform.machine().lower() in ("aarch64", "arm64")
+
+
+def _tool_info(compiler: str) -> Tuple[str, str]:
+    result = subprocess.run(
+        [compiler, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        universal_newlines=True, check=False,
+    )
+    version = (result.stdout.splitlines() or [compiler])[0].strip()
+    triple_result = subprocess.run(
+        [compiler, "-dumpmachine"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        universal_newlines=True, check=False,
+    )
+    triple = triple_result.stdout.strip() or "unknown"
+    return version, triple
+
+
+def _run_probe(
+    compiler: str,
+    directory: Optional[Any],
+    execution_mode: str,
+    qemu_cpu: str,
+    sysroot: Optional[str],
+    qemu: str,
+) -> Sve256Capability:
+    if execution_mode not in ("native", "qemu"):
+        raise Sve256ProbeError("execution_mode must be 'native' or 'qemu'")
+    if execution_mode == "native" and not _host_is_aarch64():
+        raise Sve256ProbeError("native SVE probe requires an AArch64 host")
+    compiler_path = shutil.which(compiler) or compiler
+    if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
+        raise Sve256ProbeError("AArch64 compiler {!r} was not found".format(compiler))
+    version, triple = _tool_info(compiler_path)
+    if not triple.lower().startswith(("aarch64", "arm64")):
+        raise Sve256ProbeError("compiler target triple {!r} is not AArch64".format(triple))
+    root = Path(directory).resolve() if directory is not None else Path(
+        tempfile.mkdtemp(prefix="pypto-x-sve-probe-")
+    ).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    invocation = Path(tempfile.mkdtemp(prefix="probe-", dir=str(root)))
+    source = invocation / "feature_probe.c"
+    binary = invocation / "feature_probe"
+    try:
+        source.write_text(_PROBE_SOURCE, encoding="utf-8")
+        command = [compiler_path, "-O2", "-std=c99", "-march=armv8.2-a+sve"]
+        if sysroot:
+            command.insert(1, "--sysroot={}".format(sysroot))
+        command.extend([str(source), "-o", str(binary)])
+        result = subprocess.run(command, cwd=str(invocation), stdout=subprocess.PIPE,
+                                stderr=subprocess.PIPE, universal_newlines=True, check=False)
+        if result.returncode != 0 or not binary.is_file():
+            raise Sve256ProbeError("AArch64 probe compilation failed: {}".format(
+                (result.stderr or result.stdout).strip()))
+        if execution_mode == "native":
+            run_command = [str(binary)]
+        else:
+            qemu_path = shutil.which(qemu) or qemu
+            if not shutil.which(qemu_path) and not Path(qemu_path).is_file():
+                raise Sve256ProbeError("qemu-aarch64 was not found")
+            if not sysroot:
+                sysroot = "/usr/aarch64-linux-gnu"
+            run_command = [qemu_path, "-L", sysroot, str(binary)]
+            if qemu_cpu:
+                run_command = [qemu_path, "-L", sysroot, "-cpu", qemu_cpu, str(binary)]
+        result = subprocess.run(run_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                universal_newlines=True, check=False)
+        if result.returncode != 0:
+            raise Sve256ProbeError("AArch64 probe execution failed ({}): {}".format(
+                result.returncode, (result.stderr or result.stdout).strip()))
+        try:
+            values = json.loads(result.stdout.strip().splitlines()[-1])
+        except (ValueError, IndexError, TypeError) as exc:
+            raise Sve256ProbeError("AArch64 probe returned malformed output") from exc
+    finally:
+        # The caller's directory remains available for logs; generated probe
+        # files are deliberately not shared between concurrent callers.
+        shutil.rmtree(str(invocation), ignore_errors=True)
+    hwcap = int(values.get("hwcap", 0))
+    hwcap2 = int(values.get("hwcap2", 0))
+    sve = bool(values.get("sve", bool(hwcap & SVE_HWCAP_BIT)))
+    sve2 = bool(values.get("sve2", bool(hwcap2 & SVE2_HWCAP2_BIT)))
+    vl_bytes = int(values.get("vl_bytes", -1))
+    features = set()
+    if sve:
+        features.add("sve")
+    if sve2:
+        features.add("sve2")
+    if vl_bytes == SVE256_VL_BYTES:
+        features.add("vl256")
+    available = bool(sve and vl_bytes == SVE256_VL_BYTES)
+    if not sve:
+        reason_code = "missing_cpu_features"
+        reason = "AArch64 HWCAP_SVE is unavailable"
+    elif vl_bytes != SVE256_VL_BYTES:
+        reason_code = "unsupported_vector_length"
+        reason = "SVE vector length is {} bytes; SVE256 requires 32".format(vl_bytes)
+    else:
+        reason_code = None
+        reason = None
+    return Sve256Capability(
+        available,
+        tuple(sorted(features)),
+        "getauxval+prctl" + ("+qemu" if execution_mode == "qemu" else ""),
+        reason_code,
+        reason,
+        version,
+        triple,
+        hwcap,
+        hwcap2,
+        vl_bytes,
+        sve,
+        sve2,
+        execution_mode == "qemu",
+        execution_mode,
+        False,
+    )
+
+
+@lru_cache(maxsize=16)
+def probe_sve256_capabilities(
+    compiler: Optional[str] = None,
+    directory: Optional[str] = None,
+    execution_mode: str = "auto",
+    qemu_cpu: Optional[str] = None,
+    sysroot: Optional[str] = None,
+    qemu: str = "qemu-aarch64",
+) -> Sve256Capability:
+    """Probe SVE/SVE2 and actual VL, selecting native or QEMU explicitly."""
+
+    mode = execution_mode.strip().lower() if isinstance(execution_mode, str) else execution_mode
+    if mode == "auto":
+        mode = "native" if _host_is_aarch64() else "qemu"
+    if mode not in ("native", "qemu"):
+        raise Sve256ProbeError("execution_mode must be 'auto', 'native', or 'qemu'")
+    if compiler is None:
+        compiler = "cc" if mode == "native" else "aarch64-linux-gnu-gcc"
+    if qemu_cpu is None:
+        qemu_cpu = os.environ.get("PYPTO_X_SVE_QEMU_CPU", "max,sve256=on")
+    if sysroot is None and mode == "qemu":
+        sysroot = os.environ.get("PYPTO_X_AARCH64_SYSROOT", "/usr/aarch64-linux-gnu")
+    return _run_probe(compiler, directory, mode, qemu_cpu, sysroot, qemu)
+
+
+probe_sve256 = probe_sve256_capabilities
+probe_sve_capabilities = probe_sve256_capabilities
+SVE256Capability = Sve256Capability
+
+
+__all__ = [
+    "SVE256_VL_BYTES",
+    "Sve256Capability",
+    "SVE256Capability",
+    "Sve256ProbeError",
+    "probe_sve256",
+    "probe_sve256_capabilities",
+    "probe_sve_capabilities",
+]
diff --git a/python/pypto/lowering/cpu/aarch64/sve/lowering.py b/python/pypto/lowering/cpu/aarch64/sve/lowering.py
new file mode 100644
index 000000000..57b524045
--- /dev/null
+++ b/python/pypto/lowering/cpu/aarch64/sve/lowering.py
@@ -0,0 +1,315 @@
+"""SVE256 lowering on top of the ISA-neutral CPU vector plan."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from pypto.core_ir import CoreProgram
+from pypto.lowering.cpu import canonical_dtype
+from pypto.lowering.cpu.vector import (
+    CpuFeatureSet,
+    CpuVectorProgram,
+    TailPolicy,
+    lower_cpu_vector,
+)
+from pypto.target import TargetSpec
+
+from .capabilities import Sve256Capability, probe_sve256_capabilities
+
+
+SVE256_BACKEND = "cpu.aarch64.sve256"
+SVE256_LOWERING_VERSION = 1
+SVE256_LANE_COUNT = 8
+SVE256_TAIL_POLICY = TailPolicy.MASKED
+SVE256_REQUIRED_FEATURES = frozenset(("sve", "vl256"))
+SVE_BACKEND = SVE256_BACKEND
+SVE_LANE_COUNT = SVE256_LANE_COUNT
+SVE_LOWERING_VERSION = SVE256_LOWERING_VERSION
+_TARGET_FEATURES = frozenset(("sve", "sve2", "sve256", "vl256", "sve_vl_256"))
+
+
+class Sve256Error(ValueError):
+    """Base class for SVE256 lowering errors."""
+
+
+class Sve256ValidationError(Sve256Error):
+    """The target or vector plan violates the SVE256 contract."""
+
+
+class Sve256UnsupportedError(Sve256Error):
+    """The validated scalar subset is not implemented by SVE256."""
+
+
+def _canonical_feature(value: Any) -> str:
+    name = str(value).strip().lower().replace("-", "_")
+    return {
+        "sve_256": "sve256",
+        "sve_vl_256": "vl256",
+        "vl_256": "vl256",
+    }.get(name, name)
+
+
+def _features(value: Any) -> tuple:
+    if isinstance(value, str):
+        value = (value,)
+    try:
+        return tuple(sorted({_canonical_feature(item) for item in (value or ()) if str(item).strip()}))
+    except TypeError as exc:
+        raise Sve256ValidationError("features must be a sequence") from exc
+
+
+def _target_lane_count(target: TargetSpec) -> Optional[int]:
+    for key in ("lane_count", "vector_lanes", "vector_lane_count", "vector_block_elements", "vector_width"):
+        if key in target.attributes:
+            value = target.attributes[key]
+            if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+                raise Sve256ValidationError(
+                    "target.attributes[{}] must be a positive integer".format(key)
+                )
+            return value
+    return None
+
+
+def _target_vl_bytes(target: TargetSpec) -> Optional[int]:
+    for key in ("sve_vl_bytes", "vector_length_bytes", "vl_bytes"):
+        if key in target.attributes:
+            value = target.attributes[key]
+            if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+                raise Sve256ValidationError(
+                    "target.attributes[{}] must be a positive integer".format(key)
+                )
+            return value
+    return None
+
+
+def _normalised_target(target: TargetSpec) -> TargetSpec:
+    # ``sve2`` is intentionally retained only by the capability probe.  It is
+    # not an emitted feature of this first SVE lowering, so it must not flow
+    # into the ISA-neutral plan's required feature set.
+    features = tuple(sorted({
+        "sve" if item in ("sve256", "sve_vl_256") else
+        "vl256" if item == "sve_256" else item
+        for item in _features(target.features)
+        if item != "sve2"
+    }))
+    if "sve" not in features:
+        features = tuple(sorted(set(features).union(("sve",))))
+    if "vl256" not in features:
+        features = tuple(sorted(set(features).union(("vl256",))))
+    if features == tuple(target.features):
+        return target
+    return TargetSpec(
+        target.kind,
+        target.triple,
+        features=features,
+        device=target.device,
+        abi=target.abi,
+        attributes=target.attributes,
+    )
+
+
+def _feature_values(value: Any) -> tuple:
+    if isinstance(value, CpuFeatureSet):
+        return tuple(_canonical_feature(item) for item in value.features)
+    if value is None:
+        return ()
+    return _features(value)
+
+
+def _required_features(required: Any) -> CpuFeatureSet:
+    """Return only features emitted by this target.
+
+    ``sve2`` is a capability observation, not an emitted requirement: the
+    first SVE256 lowering uses ordinary SVE FP32/predicate instructions.
+    """
+
+    explicit = set(_feature_values(required))
+    unsupported = explicit.difference(_TARGET_FEATURES)
+    if unsupported:
+        raise Sve256UnsupportedError(
+            "SVE256 lowering received unknown features: {}".format(
+                ", ".join(sorted(unsupported))
+            )
+        )
+    explicit.discard("sve2")
+    explicit.discard("sve256")
+    explicit.discard("sve_vl_256")
+    explicit.add("sve")
+    explicit.add("vl256")
+    source = required.source if isinstance(required, CpuFeatureSet) else "compiler"
+    source_tokens = set(token.strip().lower() for token in source.split("+") if token.strip())
+    source_tokens.update(("compiler", "target"))
+    source = "+".join(sorted(source_tokens, key=lambda item: (0 if item == "compiler" else 1, item)))
+    return CpuFeatureSet(tuple(sorted(explicit)), source=source)
+
+
+@dataclass(frozen=True)
+class Sve256Program:
+    """Validated SVE256 target IR and shared vector-common plan."""
+
+    vector_program: CpuVectorProgram
+    lowering_version: int = SVE256_LOWERING_VERSION
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.vector_program, CpuVectorProgram):
+            raise Sve256ValidationError("SVE256 program requires CpuVectorProgram")
+        if self.lowering_version != SVE256_LOWERING_VERSION:
+            raise Sve256ValidationError(
+                "unsupported SVE256 lowering version {!r}".format(self.lowering_version)
+            )
+        target = self.vector_program.target
+        if target.kind != "cpu":
+            raise Sve256ValidationError("SVE256 target requires kind='cpu'")
+        if not target.triple.startswith(("aarch64", "arm64")):
+            raise Sve256ValidationError("SVE256 target requires an AArch64 triple")
+        if self.vector_program.lane_count != SVE256_LANE_COUNT:
+            raise Sve256ValidationError("SVE256 requires 8 float32 lanes")
+        if self.vector_program.tail_policy != SVE256_TAIL_POLICY:
+            raise Sve256ValidationError("SVE256 requires predicate-masked tails")
+        vl_bytes = _target_vl_bytes(target)
+        if vl_bytes is not None and vl_bytes != 32:
+            raise Sve256ValidationError("SVE256 target requires actual VL=32 bytes")
+        required = set(self.vector_program.required_features.features)
+        if required != set(SVE256_REQUIRED_FEATURES):
+            raise Sve256ValidationError(
+                "SVE256 required_features must be exactly sve+vl256, got {}".format(
+                    ",".join(sorted(required))
+                )
+            )
+        for plan in self.vector_program.plans:
+            if canonical_dtype(plan.dtype) not in ("float32", "bf16"):
+                raise Sve256UnsupportedError(
+                    "SVE256 supports float32 and bf16 plans, got {!r}".format(plan.dtype)
+                )
+
+    @property
+    def program(self) -> CoreProgram:
+        return self.vector_program.program
+
+    @property
+    def target(self) -> TargetSpec:
+        return self.vector_program.target
+
+    @property
+    def entrypoint(self) -> str:
+        return self.vector_program.entrypoint
+
+    @property
+    def required_features(self) -> CpuFeatureSet:
+        return self.vector_program.required_features
+
+    @property
+    def lane_count(self) -> int:
+        return self.vector_program.lane_count
+
+    @property
+    def tail_policy(self) -> TailPolicy:
+        return self.vector_program.tail_policy
+
+    @property
+    def plans(self):
+        return self.vector_program.plans
+
+    @property
+    def plan_digest(self) -> str:
+        return self.vector_program.plan_digest
+
+    @property
+    def native_variant(self) -> str:
+        return "sve256"
+
+    @property
+    def use_sve2(self) -> bool:
+        return False
+
+    def validate(self) -> "Sve256Program":
+        self.vector_program.validate()
+        Sve256Program(self.vector_program, self.lowering_version)
+        return self
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "backend": SVE256_BACKEND,
+            "lowering_version": self.lowering_version,
+            "native_variant": self.native_variant,
+            "actual_vl_bytes": 32,
+            "emitting_features": ["sve"],
+            "vector_plan": self.vector_program.to_dict(),
+        }
+
+
+def lower_sve256(
+    program: CoreProgram,
+    target: TargetSpec,
+    entrypoint: Optional[str] = None,
+    *,
+    lane_count: Optional[int] = None,
+    tail_policy: Any = None,
+    required_features: Any = None,
+    specialization: Optional[Mapping[str, Any]] = None,
+) -> Sve256Program:
+    """Lower Core IR to an SVE256 predicate-masked vector plan."""
+
+    if not isinstance(target, TargetSpec):
+        raise Sve256ValidationError("SVE256 lowering requires TargetSpec")
+    if target.kind != "cpu":
+        raise Sve256ValidationError("SVE256 target requires kind='cpu'")
+    if not target.triple.startswith(("aarch64", "arm64")):
+        raise Sve256ValidationError("SVE256 target requires an AArch64 triple")
+    declared = set(_features(target.features))
+    unknown = sorted(declared.difference(_TARGET_FEATURES))
+    if unknown:
+        raise Sve256UnsupportedError(
+            "SVE256 lowering received unknown target features: {}".format(", ".join(unknown))
+        )
+    target = _normalised_target(target)
+    selected_lanes = _target_lane_count(target) if lane_count is None else lane_count
+    if selected_lanes is not None and selected_lanes != SVE256_LANE_COUNT:
+        raise Sve256ValidationError(
+            "SVE256 requires lane_count=8 (got {!r})".format(selected_lanes)
+        )
+    vl_bytes = _target_vl_bytes(target)
+    if vl_bytes is not None and vl_bytes != 32:
+        raise Sve256ValidationError("SVE256 requires target VL bytes=32")
+    selected_tail = tail_policy
+    if selected_tail is None:
+        selected_tail = target.attributes.get("tail_policy", SVE256_TAIL_POLICY.value)
+    if selected_tail not in (SVE256_TAIL_POLICY, SVE256_TAIL_POLICY.value, "mask", "predicate"):
+        raise Sve256ValidationError("SVE256 requires tail_policy='masked'")
+    required = _required_features(required_features if required_features is not None else target.features)
+    vector_program = lower_cpu_vector(
+        program,
+        target,
+        entrypoint,
+        lane_count=SVE256_LANE_COUNT,
+        tail_policy=SVE256_TAIL_POLICY,
+        required_features=required,
+        specialization=specialization,
+    )
+    result = Sve256Program(vector_program)
+    result.validate()
+    return result
+
+
+lower = lower_sve256
+
+
+__all__ = [
+    "SVE256_BACKEND",
+    "SVE256_LANE_COUNT",
+    "SVE256_LOWERING_VERSION",
+    "SVE256_REQUIRED_FEATURES",
+    "SVE256_TAIL_POLICY",
+    "SVE_BACKEND",
+    "SVE_LANE_COUNT",
+    "SVE_LOWERING_VERSION",
+    "Sve256Capability",
+    "Sve256Error",
+    "Sve256Program",
+    "Sve256UnsupportedError",
+    "Sve256ValidationError",
+    "lower",
+    "lower_sve256",
+    "probe_sve256_capabilities",
+]
