+"""Explicit native/QEMU SVE256 runtime for the shared LaunchRequest ABI."""
+
+from __future__ import annotations
+
+import ctypes
+from dataclasses import dataclass
+import hashlib
+import math
+import os
+from pathlib import Path
+import platform
+import shutil
+import struct
+import subprocess
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.abi import Availability, LaunchRequest, TensorDesc
+from pypto.compiler.artifact import ABI_VERSION, Artifact
+from pypto.compiler.targets.cpu_sve256 import (
+    DEFAULT_ARTIFACT_FORMAT,
+    RUNNER_PROTOCOL,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation
+from pypto.lowering.cpu import (
+    canonical_dtype,
+    canonical_operation_name,
+    element_count,
+    flatten_values,
+    static_shape,
+)
+from pypto.lowering.cpu.aarch64.sve import (
+    SVE256_BACKEND,
+    SVE256_LANE_COUNT,
+    SVE256_LOWERING_VERSION,
+    Sve256Capability,
+    Sve256Program,
+    lower_sve256,
+)
+from pypto.lowering.cpu.aarch64.sve import capabilities as _capabilities
+from pypto.lowering.cpu.vector import (
+    CpuFeatureContract,
+    CpuFeatureSet,
+    CpuVectorFeatureMismatchError,
+    FeatureMismatch,
+)
+from pypto.target._utils import mapping_copy, sha256_text
+
+from ..tensor import FlatBuffer, HostTensor, _cast_value
+
+
+class CpuSve256RuntimeError(RuntimeError):
+    """Base class for SVE256 runtime failures."""
+
+
+class CpuSve256UnavailableError(CpuSve256RuntimeError):
+    """The selected native/QEMU execution contract is unavailable."""
+
+    def __init__(self, status: Availability):
+        self.status = status
+        super().__init__(status.reason or "SVE256 runtime is unavailable")
+
+
+class CpuSve256ArtifactError(CpuSve256RuntimeError):
+    """An immutable SVE256 artifact, plan, or ELF failed validation."""
+
+
+class CpuSve256ExecutionError(CpuSve256RuntimeError):
+    """A launch request or runner operation is invalid."""
+
+
+class CpuSve256FeatureMismatchError(CpuVectorFeatureMismatchError):
+    """The artifact requires SVE256 features absent from the probe."""
+
+    def __init__(self, mismatch: Any):
+        self.mismatch = mismatch
+        self.status = Availability.no(
+            SVE256_BACKEND,
+            "required SVE256 artifact features are unavailable",
+            "missing_cpu_features",
+            mismatch.to_dict(),
+        )
+        super().__init__(mismatch)
+
+
+@dataclass(frozen=True)
+class LoadedSve256Artifact:
+    artifact: Artifact
+    target_ir: Sve256Program
+    feature_contract: CpuFeatureContract
+    execution_mode: str
+
+    @property
+    def contract(self) -> CpuFeatureContract:
+        return self.feature_contract
+
+    @property
+    def runner(self) -> str:
+        return str(self.artifact.path)
+
+
+_WIRE_REQUEST = struct.Struct("<6I4Q")
+_WIRE_RESPONSE = struct.Struct("<4IQ")
+_WIRE_MAGIC = b"PXSV"
+_WIRE_VERSION = 1
+_OP_CODES = {
+    "identity": 0,
+    "neg": 1,
+    "add": 2,
+    "sub": 3,
+    "mul": 4,
+    "div": 5,
+    "reduce_sum": 6,
+    "reduce_max": 7,
+    "matmul": 8,
+}
+_DTYPE_CODES = {"float32": 0, "bf16": 1}
+_CTYPE = {"float32": ctypes.c_float, "bf16": ctypes.c_uint16}
+
+
+def _bf16_bits(value: Any) -> int:
+    number = float(value)
+    bits = struct.unpack("<I", struct.pack("<f", number))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        return (bits >> 16) & 0xFFFF
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def _bf16_value(bits: int) -> float:
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+def _is_tensor(value_type: CoreType) -> bool:
+    return value_type.kind in ("tensor", "view", "tile")
+
+
+def _is_scalar(value_type: CoreType) -> bool:
+    return value_type.kind == "scalar"
+
+
+def _find_function(program: CoreProgram, name: str) -> CoreFunction:
+    for function in program.functions:
+        if function.name == name:
+            return function
+    raise CpuSve256ArtifactError("SVE256 entrypoint {!r} is missing".format(name))
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _unravel(index: int, shape: Sequence[int]) -> Tuple[int, ...]:
+    result = [0] * len(shape)
+    remaining = index
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension:
+            result[axis] = remaining % dimension
+            remaining //= dimension
+    return tuple(result)
+
+
+def _read_native_bytes(path: str) -> bytes:
+    nofollow = getattr(os, "O_NOFOLLOW", 0)
+    if Path(path).is_symlink():
+        raise CpuSve256ArtifactError("SVE256 ELF path must not be a symlink")
+    try:
+        descriptor = os.open(path, os.O_RDONLY | nofollow)
+    except OSError as exc:
+        raise CpuSve256ArtifactError("SVE256 ELF cannot be opened safely: {}".format(exc)) from exc
+    try:
+        metadata = os.fstat(descriptor)
+        if not os.path.isfile(path) or metadata.st_nlink != 1:
+            raise CpuSve256ArtifactError("SVE256 ELF must be a single-link regular file")
+        chunks = []
+        while True:
+            chunk = os.read(descriptor, 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        return b"".join(chunks)
+    finally:
+        os.close(descriptor)
+
+
+def _string_sequence(value: Any, context: str) -> Tuple[str, ...]:
+    if not isinstance(value, (list, tuple)):
+        raise CpuSve256ArtifactError("{} must be a sequence of strings".format(context))
+    if any(not isinstance(item, str) or not item.strip() for item in value):
+        raise CpuSve256ArtifactError("{} must be a sequence of strings".format(context))
+    return tuple(value)
+
+
+def _program_digest_from_metadata(metadata: Mapping[str, Any], context: str) -> str:
+    value = metadata.get("program_digest")
+    if not isinstance(value, str) or len(value) != 64:
+        raise CpuSve256ArtifactError("{} CoreProgram digest is missing".format(context))
+    return value
+
+
+def _validate_primary_artifact(artifact: Artifact) -> Mapping[str, Any]:
+    if not isinstance(artifact, Artifact):
+        raise CpuSve256ArtifactError("SVE256 runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CpuSve256ArtifactError("primary artifact validation failed: {}".format(exc)) from exc
+    if artifact.path is None:
+        raise CpuSve256ArtifactError("SVE256 artifact must reference an AArch64 ELF executable")
+    if artifact.format != DEFAULT_ARTIFACT_FORMAT or artifact.abi_version != ABI_VERSION:
+        raise CpuSve256ArtifactError("SVE256 artifact format or ABI is unsupported")
+    if artifact.target.kind != "cpu" or not artifact.target.triple.startswith(("aarch64", "arm64")):
+        raise CpuSve256ArtifactError("SVE256 artifact target must be AArch64 CPU")
+    metadata = mapping_copy(artifact.metadata)
+    if metadata.get("backend") != SVE256_BACKEND:
+        raise CpuSve256ArtifactError("SVE256 artifact backend metadata is invalid")
+    if metadata.get("native_isa") != "sve" or metadata.get("native_format") != "elf-executable":
+        raise CpuSve256ArtifactError("SVE256 artifact native format is invalid")
+    if metadata.get("runner_protocol") != RUNNER_PROTOCOL:
+        raise CpuSve256ArtifactError("SVE256 runner protocol is unsupported")
+    if metadata.get("target_vl_bytes") != 32:
+        raise CpuSve256ArtifactError("SVE256 artifact VL contract is not 32 bytes")
+    if metadata.get("sve2_required"):
+        raise CpuSve256ArtifactError("SVE2 is not an emitted SVE256 requirement")
+    if metadata.get("emitting_features") != ["sve"]:
+        raise CpuSve256ArtifactError("SVE256 emitting feature marker is invalid")
+    required = set(_string_sequence(metadata.get("required_features"), "required_features"))
+    if required != {"sve", "vl256"}:
+        raise CpuSve256ArtifactError("SVE256 required_features must contain only sve and vl256")
+    _program_digest_from_metadata(metadata, "primary artifact")
+    return metadata
+
+
+def _decode_artifact(artifact: Artifact, available: CpuFeatureSet) -> LoadedSve256Artifact:
+    metadata = _validate_primary_artifact(artifact)
+    native_bytes = _read_native_bytes(artifact.path)
+    actual_digest = hashlib.sha256(native_bytes).hexdigest()
+    if actual_digest != artifact.content_digest or metadata.get("native_digest") != actual_digest:
+        raise CpuSve256ArtifactError("SVE256 ELF content digest mismatch")
+    compile_command = metadata.get("compile_command")
+    if not isinstance(compile_command, (list, tuple)) or not compile_command:
+        raise CpuSve256ArtifactError("SVE256 compile_command metadata is missing")
+    command_text = " ".join(str(item) for item in compile_command)
+    for required_flag in ("-march=armv8.2-a+sve", "-msve-vector-bits=256"):
+        if required_flag not in compile_command:
+            raise CpuSve256ArtifactError("SVE256 compile command is missing {}".format(required_flag))
+    if "neon" in command_text.lower():
+        raise CpuSve256ArtifactError("SVE256 compile command contains forbidden NEON lowering")
+    if not str(compile_command[0]).lower().startswith(("aarch64", "clang", "gcc")):
+        raise CpuSve256ArtifactError("SVE256 compiler metadata is not an AArch64 compiler")
+    if metadata.get("entrypoint") != artifact.entrypoint:
+        raise CpuSve256ArtifactError("SVE256 artifact entrypoint mismatch")
+    if metadata.get("artifact_payload_version") != 1:
+        raise CpuSve256ArtifactError("unsupported SVE256 artifact payload version")
+    if metadata.get("lowering_version") != SVE256_LOWERING_VERSION:
+        raise CpuSve256ArtifactError("unsupported SVE256 lowering version")
+    program_data = metadata.get("program")
+    plan_data = metadata.get("vector_plan")
+    if not isinstance(program_data, Mapping) or not isinstance(plan_data, Mapping):
+        raise CpuSve256ArtifactError("SVE256 artifact is missing CoreProgram/vector plan metadata")
+    required_data = plan_data.get("required_features")
+    if not isinstance(required_data, Mapping):
+        raise CpuSve256ArtifactError("SVE256 plan required_features metadata is invalid")
+    required = CpuFeatureSet(
+        required_data.get("features", ()),
+        source=required_data.get("source", metadata.get("required_feature_source", "artifact")),
+    )
+    if set(required.features) != {"sve", "vl256"}:
+        raise CpuSve256ArtifactError("SVE256 plan required_features contain an unexpected feature")
+    try:
+        program = CoreProgram.from_dict(program_data)
+        target_ir = lower_sve256(
+            program,
+            artifact.target,
+            plan_data.get("entrypoint"),
+            lane_count=plan_data.get("lane_count"),
+            tail_policy=plan_data.get("tail_policy"),
+            required_features=required,
+            specialization=plan_data.get("specialization", {}),
+        )
+    except Exception as exc:
+        raise CpuSve256ArtifactError("SVE256 CoreProgram/plan is invalid: {}".format(exc)) from exc
+    if target_ir.vector_program.to_dict() != dict(plan_data):
+        raise CpuSve256ArtifactError("SVE256 vector plan metadata mismatch")
+    program_digest = hashlib.sha256(program.canonical_json().encode("utf-8")).hexdigest()
+    if metadata.get("program_digest") != program_digest:
+        raise CpuSve256ArtifactError("SVE256 program digest mismatch")
+    if metadata.get("plan_digest") != target_ir.plan_digest:
+        raise CpuSve256ArtifactError("SVE256 plan digest mismatch")
+    if metadata.get("target_digest") != sha256_text(artifact.target.to_dict()):
+        raise CpuSve256ArtifactError("SVE256 target digest mismatch")
+    if tuple(metadata.get("required_features", ())) != tuple(required.features):
+        raise CpuSve256ArtifactError("SVE256 required feature metadata mismatch")
+    if metadata.get("required_feature_source") != required.source:
+        raise CpuSve256ArtifactError("SVE256 required feature source mismatch")
+    if metadata.get("native_variant") != target_ir.native_variant:
+        raise CpuSve256ArtifactError("SVE256 native variant marker mismatch")
+    # Recreate the compiler's source contract so metadata cannot be changed to
+    # point an otherwise valid ELF at a different lowering/source variant.
+    from pypto.compiler.targets.cpu_sve256 import _native_source
+    _, expected_source_digest = _native_source(target_ir)
+    if metadata.get("native_source_digest") != expected_source_digest:
+        raise CpuSve256ArtifactError("SVE256 native source marker mismatch")
+    expected_flags = ("-static", "-O2", "-std=c99", "-march=armv8.2-a+sve", "-msve-vector-bits=256")
+    native_flags = metadata.get("native_flags")
+    if not isinstance(native_flags, (list, tuple)) or tuple(native_flags) != expected_flags:
+        raise CpuSve256ArtifactError("SVE256 native_flags metadata disagrees with variant")
+    if compile_command[-1] != Path(artifact.path).name:
+        raise CpuSve256ArtifactError("SVE256 compile command is not bound to artifact path")
+    mismatch = CpuFeatureContract(required, available)
+    try:
+        mismatch.validate()
+    except CpuVectorFeatureMismatchError as exc:
+        raise CpuSve256FeatureMismatchError(exc.mismatch) from exc
+    return LoadedSve256Artifact(artifact, target_ir, mismatch, "unknown")
+
+
+def _storage_values(descriptor: TensorDesc, dtype: str, context: str) -> List[Any]:
+    storage = descriptor.storage
+    count = descriptor.element_count
+    if storage is None:
+        raise CpuSve256ExecutionError("{} tensor descriptor has no storage".format(context))
+    if isinstance(storage, (HostTensor, FlatBuffer)):
+        values = list(storage.data)
+    elif isinstance(storage, int) and not isinstance(storage, bool):
+        if count and storage == 0:
+            raise CpuSve256ExecutionError("{} tensor address is null".format(context))
+        ctype = _CTYPE[dtype]
+        try:
+            values = list((ctype * count).from_address(storage))
+        except (TypeError, ValueError, OSError) as exc:
+            raise CpuSve256ExecutionError("{} tensor address is invalid".format(context)) from exc
+    elif hasattr(storage, "__array_interface__"):
+        interface = storage.__array_interface__
+        if interface.get("shape") is not None and tuple(interface["shape"]) != descriptor.shape:
+            raise CpuSve256ExecutionError("{} array shape does not match descriptor".format(context))
+        try:
+            values = list(storage.reshape(-1))
+        except (AttributeError, TypeError, ValueError):
+            values = list(flatten_values(storage.tolist()))
+    elif isinstance(storage, (list, tuple)):
+        values = list(flatten_values(storage))
+    elif hasattr(storage, "data") and isinstance(storage.data, (list, tuple)):
+        values = list(storage.data)
+    else:
+        try:
+            values = [storage[index] for index in range(count)]
+        except (TypeError, IndexError, KeyError, AttributeError) as exc:
+            raise CpuSve256ExecutionError("{} storage is not a flat readable buffer".format(context)) from exc
+    if len(values) != count:
+        raise CpuSve256ExecutionError(
+            "{} storage length {} does not match descriptor count {}".format(context, len(values), count)
+        )
+    try:
+        return [_cast_value(value, dtype) for value in values]
+    except Exception as exc:
+        raise CpuSve256ExecutionError("{} contains invalid {} values".format(context, dtype)) from exc
+
+
+def _write_storage(descriptor: TensorDesc, dtype: str, values: Sequence[Any], context: str) -> None:
+    if descriptor.readonly:
+        raise CpuSve256ExecutionError("{} output descriptor is read-only".format(context))
+    storage = descriptor.storage
+    if storage is None:
+        raise CpuSve256ExecutionError("{} output descriptor has no storage".format(context))
+    values = [_cast_value(value, dtype) for value in values]
+    if isinstance(storage, HostTensor):
+        storage.data[:] = values
+        return
+    if isinstance(storage, FlatBuffer):
+        storage.data[:] = values
+        return
+    if isinstance(storage, int) and not isinstance(storage, bool):
+        if descriptor.element_count and storage == 0:
+            raise CpuSve256ExecutionError("{} output address is null".format(context))
+        ctype = _CTYPE[dtype]
+        array = (ctype * len(values)).from_address(storage)
+        for index, value in enumerate(values):
+            array[index] = _bf16_bits(value) if dtype == "bf16" else float(value)
+        return
+    if hasattr(storage, "__array_interface__"):
+        flags = getattr(storage, "flags", None)
+        if flags is not None and not bool(getattr(flags, "writeable", True)):
+            raise CpuSve256ExecutionError("{} output array is read-only".format(context))
+        try:
+            flat = storage.reshape(-1)
+            for index, value in enumerate(values):
+                flat[index] = value
+            return
+        except (AttributeError, TypeError, ValueError) as exc:
+            raise CpuSve256ExecutionError("{} output array is not writable".format(context)) from exc
+    if hasattr(storage, "data") and isinstance(storage.data, list):
+        storage.data[:] = values
+        return
+    try:
+        for index, value in enumerate(values):
+            storage[index] = value
+    except (TypeError, IndexError, KeyError, AttributeError) as exc:
+        raise CpuSve256ExecutionError("{} output storage is not writable".format(context)) from exc
+
+
+def _wire_values(dtype: str, values: Sequence[Any]) -> bytes:
+    if dtype == "float32":
+        return struct.pack("<{}f".format(len(values)), *[float(value) for value in values])
+    return struct.pack("<{}H".format(len(values)), *[_bf16_bits(value) for value in values])
+
+
+def _decode_wire_values(dtype: str, payload: bytes, count: int) -> List[Any]:
+    if dtype == "float32":
+        expected = count * 4
+        if len(payload) != expected:
+            raise CpuSve256ExecutionError("SVE256 runner returned {} bytes; expected {}".format(len(payload), expected))
+        return list(struct.unpack("<{}f".format(count), payload)) if count else []
+    expected = count * 2
+    if len(payload) != expected:
+        raise CpuSve256ExecutionError("SVE256 runner returned {} bytes; expected {}".format(len(payload), expected))
+    bits = struct.unpack("<{}H".format(count), payload) if count else ()
+    return [_bf16_value(value) for value in bits]
+
+
+class Sve256Runtime:
+    """SVE256 runtime with explicit native/QEMU execution and real probe gate."""
+
+    name = SVE256_BACKEND
+
+    def __init__(
+        self,
+        available_features: Any = None,
+        capability: Optional[Sve256Capability] = None,
+        probe_directory: Optional[str] = None,
+        execution_mode: str = "auto",
+        qemu_cpu: Optional[str] = None,
+        sysroot: Optional[str] = None,
+        qemu: str = "qemu-aarch64",
+    ) -> None:
+        if capability is not None and available_features is not None:
+            raise ValueError("capability and available_features are aliases; pass only one")
+        if not isinstance(execution_mode, str) or execution_mode.strip().lower() not in ("auto", "native", "qemu"):
+            raise ValueError("execution_mode must be 'auto', 'native', or 'qemu'")
+        if execution_mode.strip().lower() == "auto":
+            execution_mode = "native" if platform.machine().lower() in ("aarch64", "arm64") else "qemu"
+        self.execution_mode = execution_mode.strip().lower()
+        self._probe_directory = probe_directory
+        self._qemu_cpu = qemu_cpu or os.environ.get("PYPTO_X_SVE_QEMU_CPU", "max,sve256=on")
+        self._sysroot = sysroot or os.environ.get("PYPTO_X_AARCH64_SYSROOT", "/usr/aarch64-linux-gnu")
+        self._qemu = qemu
+        self._injected = capability is not None or available_features is not None
+        self._real_capability = None
+        if capability is None and available_features is not None:
+            capability = Sve256Capability.injected_capability(available_features, source="injected")
+        if capability is None:
+            try:
+                capability = self._probe_real_capability()
+            except Exception as exc:
+                capability = self._probe_failure(str(exc))
+        self.capability = capability
+        if not self._injected:
+            self._real_capability = capability
+        self.available_features = CpuFeatureSet(capability.features, source=capability.source)
+        self._selected_artifact: Optional[Artifact] = None
+        if capability.available:
+            self._status = Availability.yes(self.name)
+        else:
+            self._status = Availability.no(
+                self.name,
+                capability.reason or "SVE256 capability is unavailable",
+                capability.reason_code or "missing_cpu_features",
+                capability.to_dict(),
+            )
+
+    def _probe_failure(self, reason: str) -> Sve256Capability:
+        return Sve256Capability(
+            False, (), "getauxval+prctl", "probe_failed", reason,
+            "aarch64-linux-gnu-gcc" if self.execution_mode == "qemu" else "cc",
+            "unknown", 0, 0, -1, False, False,
+            self.execution_mode == "qemu", self.execution_mode, False
+        )
+
+    def _probe_real_capability(self) -> Sve256Capability:
+        if self._real_capability is None:
+            compiler = "aarch64-linux-gnu-gcc" if self.execution_mode == "qemu" else "cc"
+            self._real_capability = _capabilities.probe_sve256_capabilities(
+                compiler=compiler,
+                directory=self._probe_directory,
+                execution_mode=self.execution_mode,
+                qemu_cpu=self._qemu_cpu,
+                sysroot=self._sysroot,
+                qemu=self._qemu,
+            )
+        return self._real_capability
+
+    def _require_real_capability(self) -> Sve256Capability:
+        try:
+            capability = self._probe_real_capability()
+        except Exception as exc:
+            raise CpuSve256UnavailableError(
+                Availability.no(self.name, str(exc), "probe_failed", {"execution_mode": self.execution_mode})
+            ) from exc
+        if not capability.available:
+            raise CpuSve256UnavailableError(
+                Availability.no(
+                    self.name,
+                    capability.reason or "SVE256 capability is unavailable",
+                    capability.reason_code or "missing_cpu_features",
+                    capability.to_dict(),
+                )
+            )
+        if capability.vl_bytes != 32 or (self.execution_mode == "qemu" and not capability.emulated) or (
+            self.execution_mode == "native" and capability.emulated
+        ):
+            raise CpuSve256UnavailableError(
+                Availability.no(
+                    self.name,
+                    "SVE256 execution mode or vector length does not match the actual probe",
+                    "execution_contract_mismatch",
+                    capability.to_dict(),
+                )
+            )
+        return capability
+
+    def availability(self) -> Availability:
+        return self._status
+
+    def is_available(self) -> bool:
+        return self._status.available
+
+    @property
+    def selected_artifact(self) -> Optional[Artifact]:
+        return self._selected_artifact
+
+    def load(self, artifact: Artifact, available_features: Any = None) -> LoadedSve256Artifact:
+        if not self.is_available():
+            raise CpuSve256UnavailableError(self._status)
+        available = self.available_features if available_features is None else CpuFeatureSet(
+            available_features, source="injected"
+        )
+        loaded = _decode_artifact(artifact, available)
+        return LoadedSve256Artifact(loaded.artifact, loaded.target_ir, loaded.feature_contract, self.execution_mode)
+
+    def workspace_size(self, request: Any) -> int:
+        if not isinstance(request, LaunchRequest):
+            raise CpuSve256ExecutionError("workspace_size requires LaunchRequest")
+        self.load(request.artifact)
+        return 0
+
+    def guarded_buffer_self_test(self, artifact: Artifact) -> bool:
+        """Run the native ELF's unaligned-buffer/canary self-test.
+
+        This is useful in QEMU mode because the normal LaunchRequest wire
+        protocol copies host buffers into the AArch64 process.
+        """
+
+        _validate_primary_artifact(artifact)
+        self._require_real_capability()
+        if not mapping_copy(artifact.metadata).get("guarded_buffer_self_test", False):
+            raise CpuSve256ArtifactError("SVE256 artifact lacks guarded-buffer self-test marker")
+        if self.execution_mode == "native":
+            command = [str(artifact.path), "--guarded-self-test"]
+        else:
+            qemu_path = shutil.which(self._qemu) or self._qemu
+            if not shutil.which(qemu_path) and not Path(qemu_path).is_file():
+                raise CpuSve256ExecutionError("qemu-aarch64 executable is unavailable")
+            command = [qemu_path, "-L", self._sysroot, "-cpu", self._qemu_cpu,
+                       str(artifact.path), "--guarded-self-test"]
+        try:
+            result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                    check=False, timeout=120)
+        except (OSError, subprocess.SubprocessError) as exc:
+            raise CpuSve256ExecutionError("SVE256 guarded self-test failed: {}".format(exc)) from exc
+        if result.returncode != 0:
+            raise CpuSve256ExecutionError(
+                "SVE256 guarded self-test returned {}: {}".format(
+                    result.returncode, result.stderr.decode("utf-8", "replace")
+                )
+            )
+        return True
+
+    def _run_runner(
+        self,
+        artifact: Artifact,
+        operation: str,
+        dtype: str,
+        values: Sequence[Sequence[Any]],
+        count: int,
+        m: int = 0,
+        k: int = 0,
+        n: int = 0,
+    ) -> List[Any]:
+        if operation not in _OP_CODES:
+            raise CpuSve256ExecutionError("unsupported SVE256 runner operation {!r}".format(operation))
+        dtype = canonical_dtype(dtype)
+        if dtype not in _DTYPE_CODES:
+            raise CpuSve256ExecutionError("SVE256 runner supports float32 and bf16 only")
+        if operation == "matmul":
+            expected_values = (m * k, k * n)
+        elif operation in ("reduce_sum", "reduce_max", "identity", "neg"):
+            expected_values = (count,)
+        else:
+            expected_values = (count, count)
+        if len(values) != len(expected_values) or any(
+            len(value) != expected for value, expected in zip(values, expected_values)
+        ):
+            raise CpuSve256ExecutionError("SVE256 runner input lengths do not match operation")
+        header = _WIRE_REQUEST.pack(
+            int.from_bytes(_WIRE_MAGIC, "little"), _WIRE_VERSION, _OP_CODES[operation],
+            _DTYPE_CODES[dtype], 0, 0, count, m, k, n,
+        )
+        payload = header + b"".join(_wire_values(dtype, value) for value in values)
+        if self.execution_mode == "native":
+            command = [str(artifact.path)]
+        else:
+            qemu_path = shutil.which(self._qemu) or self._qemu
+            if not shutil.which(qemu_path) and not Path(qemu_path).is_file():
+                raise CpuSve256ExecutionError("qemu-aarch64 executable is unavailable")
+            command = [qemu_path, "-L", self._sysroot, "-cpu", self._qemu_cpu, str(artifact.path)]
+        try:
+            result = subprocess.run(
+                command, input=payload, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                check=False, timeout=120,
+            )
+        except (OSError, subprocess.SubprocessError) as exc:
+            raise CpuSve256ExecutionError(
+                "SVE256 {} runner invocation failed: {}".format(self.execution_mode, exc)
+            ) from exc
+        if len(result.stdout) < _WIRE_RESPONSE.size:
+            raise CpuSve256ExecutionError(
+                "SVE256 runner returned no structured response (exit {}, stderr={!r})".format(
+                    result.returncode, result.stderr.decode("utf-8", "replace")
+                )
+            )
+        magic, version, status, response_dtype, response_count = _WIRE_RESPONSE.unpack(
+            result.stdout[:_WIRE_RESPONSE.size]
+        )
+        if magic != int.from_bytes(_WIRE_MAGIC, "little") or version != _WIRE_VERSION:
+            raise CpuSve256ExecutionError("SVE256 runner response header is invalid")
+        if status != 0 or result.returncode != 0:
+            raise CpuSve256ExecutionError(
+                "SVE256 runner returned status {} (exit {}, stderr={!r})".format(
+                    status, result.returncode, result.stderr.decode("utf-8", "replace")
+                )
+            )
+        expected_count = m * n if operation == "matmul" else (
+            1 if operation.startswith("reduce_") else count
+        )
+        if response_dtype != _DTYPE_CODES[dtype] or response_count != expected_count:
+            raise CpuSve256ExecutionError("SVE256 runner response shape is invalid")
+        return _decode_wire_values(dtype, result.stdout[_WIRE_RESPONSE.size:], response_count)
+
+    def launch(self, request: LaunchRequest) -> Tuple[Any, ...]:
+        if not isinstance(request, LaunchRequest):
+            raise CpuSve256ExecutionError("SVE256 launch requires LaunchRequest")
+        _validate_primary_artifact(request.artifact)
+        capability = self._require_real_capability()
+        available = CpuFeatureSet(capability.features, source=capability.source)
+        try:
+            request.validate()
+        except Exception as exc:
+            raise CpuSve256ExecutionError("invalid LaunchRequest: {}".format(exc)) from exc
+        loaded = _decode_artifact(request.artifact, available)
+        self._selected_artifact = request.artifact
+        target = loaded.target_ir.target
+        if target.kind != "cpu" or not target.triple.startswith(("aarch64", "arm64")):
+            raise CpuSve256ExecutionError("SVE256 artifact target must be AArch64 CPU")
+        for descriptor in request.inputs + request.outputs:
+            if descriptor.device != "cpu":
+                raise CpuSve256ExecutionError("SVE256 requires cpu tensor descriptors")
+            if descriptor.strides != _contiguous_strides(descriptor.shape):
+                raise CpuSve256ExecutionError("SVE256 requires contiguous tensor descriptors")
+        function = _find_function(loaded.target_ir.program, loaded.target_ir.entrypoint)
+        tensor_parameters = [ref for ref in function.parameters if _is_tensor(ref.type)]
+        tensor_returns = [ref for ref in function.returns if _is_tensor(ref.type)]
+        if len(request.inputs) != len(tensor_parameters):
+            raise CpuSve256ExecutionError("SVE256 input tensor count does not match function")
+        if len(request.outputs) != len(tensor_returns):
+            raise CpuSve256ExecutionError("SVE256 output tensor count does not match function")
+        environment: Dict[str, Tuple[CoreType, List[Any]]] = {}
+        input_index = 0
+        for parameter in function.parameters:
+            dtype = canonical_dtype(parameter.type.dtype)
+            if _is_tensor(parameter.type):
+                descriptor = request.inputs[input_index]
+                expected_shape = static_shape(parameter.type, parameter.name)
+                accepted_dtypes = (dtype, "bfloat16") if dtype == "bf16" else (dtype,)
+                if descriptor.dtype not in accepted_dtypes or descriptor.shape != expected_shape:
+                    raise CpuSve256ExecutionError(
+                        "SVE256 input {!r} descriptor does not match CoreType".format(parameter.name)
+                    )
+                environment[parameter.name] = (parameter.type, _storage_values(descriptor, dtype, parameter.name))
+                input_index += 1
+            elif _is_scalar(parameter.type):
+                if parameter.name not in request.scalars:
+                    raise CpuSve256ExecutionError("missing scalar input {!r}".format(parameter.name))
+                environment[parameter.name] = (parameter.type, [_cast_value(request.scalars[parameter.name], dtype)])
+            else:
+                raise CpuSve256ExecutionError("unsupported parameter kind {!r}".format(parameter.type.kind))
+        if len(loaded.target_ir.plans) != len(function.body.operations):
+            raise CpuSve256ArtifactError("SVE256 plan count does not match operation count")
+        for operation, plan in zip(function.body.operations, loaded.target_ir.plans):
+            self._execute_operation(operation, plan, environment, request.artifact)
+        results: List[Any] = []
+        output_index = 0
+        for result_ref in function.returns:
+            if result_ref.name not in environment:
+                raise CpuSve256ExecutionError("return value {!r} was not produced".format(result_ref.name))
+            result_type, values = environment[result_ref.name]
+            if _is_tensor(result_ref.type):
+                descriptor = request.outputs[output_index]
+                result_dtype = canonical_dtype(result_ref.type.dtype)
+                accepted_dtypes = (result_dtype, "bfloat16") if result_dtype == "bf16" else (result_dtype,)
+                if descriptor.dtype not in accepted_dtypes or descriptor.shape != static_shape(
+                    result_ref.type, result_ref.name
+                ):
+                    raise CpuSve256ExecutionError("SVE256 output descriptor does not match CoreType")
+                _write_storage(descriptor, canonical_dtype(result_type.dtype), values, result_ref.name)
+                results.append(descriptor.storage)
+                output_index += 1
+            else:
+                results.append(values[0] if values else None)
+        return tuple(results)
+
+    def _execute_operation(
+        self,
+        operation: Operation,
+        plan: Any,
+        environment: Dict[str, Tuple[CoreType, List[Any]]],
+        artifact: Artifact,
+    ) -> None:
+        name = canonical_operation_name(operation.name)
+        if plan.operation != name:
+            raise CpuSve256ArtifactError("SVE256 operation does not match vector plan")
+        inputs = []
+        for ref in operation.inputs:
+            if ref.name not in environment:
+                raise CpuSve256ExecutionError("SVE256 input {!r} is unavailable".format(ref.name))
+            inputs.append(environment[ref.name])
+        output_ref = operation.outputs[0]
+        dtype = canonical_dtype(output_ref.type.dtype)
+        if name == "constant":
+            raw = operation.attributes.get("value", operation.attributes.get("values"))
+            values = [raw] if _is_scalar(output_ref.type) else list(flatten_values(raw))
+            environment[output_ref.name] = (output_ref.type, [_cast_value(value, dtype) for value in values])
+            return
+        if name == "identity":
+            values = self._run_runner(artifact, "identity", dtype, [inputs[0][1]], len(inputs[0][1]))
+        elif name == "neg":
+            values = self._run_runner(artifact, "neg", dtype, [inputs[0][1]], plan.element_count)
+        elif name in ("add", "sub", "mul", "div"):
+            left, right = inputs
+            left_values = left[1] if len(left[1]) == plan.element_count else left[1] * plan.element_count
+            right_values = right[1] if len(right[1]) == plan.element_count else right[1] * plan.element_count
+            if name == "div" and any(value == 0 for value in right_values):
+                raise CpuSve256ExecutionError("division by zero")
+            values = self._run_runner(artifact, name, dtype, [left_values, right_values], plan.element_count)
+        elif name in ("reduce_sum", "reduce_max"):
+            values = self._execute_reduction(name, inputs[0], output_ref.type, plan, artifact)
+        elif name == "matmul":
+            matmul = plan.matmul
+            values = self._run_runner(
+                artifact, "matmul", dtype, [inputs[0][1], inputs[1][1]],
+                matmul.output_elements, matmul.m, matmul.k, matmul.n,
+            )
+        else:
+            raise CpuSve256ExecutionError("SVE256 operation {!r} is unsupported".format(operation.name))
+        environment[output_ref.name] = (output_ref.type, values)
+
+    def _execute_reduction(
+        self,
+        name: str,
+        value: Tuple[CoreType, List[Any]],
+        output_type: CoreType,
+        plan: Any,
+        artifact: Artifact,
+    ) -> List[Any]:
+        reduction = plan.reduction
+        input_shape = reduction.input_shape
+        output_shape = reduction.output_shape
+        input_values = value[1]
+        output = []
+        for output_index in range(reduction.output_elements):
+            output_coords = _unravel(output_index, output_shape)
+            candidates = []
+            for input_index in range(len(input_values)):
+                input_coords = _unravel(input_index, input_shape)
+                if reduction.keepdims:
+                    projected = tuple(
+                        0 if axis in reduction.axes else input_coords[axis]
+                        for axis in range(len(input_shape))
+                    )
+                else:
+                    projected = tuple(
+                        input_coords[axis]
+                        for axis in range(len(input_shape))
+                        if axis not in reduction.axes
+                    )
+                if projected == output_coords:
+                    candidates.append(input_values[input_index])
+            if len(candidates) != reduction.reduction_size:
+                raise CpuSve256ExecutionError("SVE256 reduction group length mismatch")
+            if not candidates:
+                if name == "reduce_sum":
+                    output.append(_cast_value(0.0, canonical_dtype(output_type.dtype)))
+                    continue
+                raise CpuSve256ExecutionError("reduce_max has an empty reduction group")
+            result = self._run_runner(artifact, name, canonical_dtype(output_type.dtype), [candidates], len(candidates))
+            output.append(result[0])
+        return output
+
+
+CpuSve256Backend = Sve256Runtime
+SVE256Runtime = Sve256Runtime
+CpuSVE256Runtime = Sve256Runtime
+
+
+def launch_sve256(request: LaunchRequest, execution_mode: str = "auto") -> Tuple[Any, ...]:
+    return Sve256Runtime(execution_mode=execution_mode).launch(request)
+
+
+__all__ = [
+    "CpuSve256ArtifactError",
+    "CpuSve256Backend",
+    "CpuSve256ExecutionError",
+    "CpuSve256FeatureMismatchError",
+    "CpuSve256RuntimeError",
+    "CpuSve256UnavailableError",
+    "CpuSVE256Runtime",
+    "LoadedSve256Artifact",
+    "SVE256Runtime",
+    "Sve256Runtime",
+    "launch_sve256",
+]
