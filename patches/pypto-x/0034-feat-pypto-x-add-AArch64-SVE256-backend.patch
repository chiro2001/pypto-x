+    _, _, reduction_artifact = _compile(reduction, tmp_path / "reduction")
+    reduction_input = HostTensor("bf16", (19,), [float(index + 1) / 7.0 for index in range(19)])
+    reduction_actual = HostTensor.zeros("bf16", ())
+    reduction_expected = HostTensor.zeros("bf16", ())
+    _run(reduction_artifact, [reduction_input], reduction_actual)
+    _scalar_run(reduction, [reduction_input], reduction_expected)
