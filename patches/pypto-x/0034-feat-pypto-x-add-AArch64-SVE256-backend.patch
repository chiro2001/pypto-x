+def test_sve_portable_only_import_and_native_mode_gate():
+    environment = dict(os.environ)
+    environment["PYPTO_X_PORTABLE_ONLY"] = "1"
+    python_root = Path(__file__).parents[3]
+    existing = environment.get("PYTHONPATH")
+    environment["PYTHONPATH"] = str(python_root) + (os.pathsep + existing if existing else "")
+    result = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            "import pypto; from pypto.backends.cpu.aarch64 import Sve256Runtime; "
+            "from pypto.compiler.targets.cpu_sve256 import Sve256Compiler; print('portable-ok')",
+        ],
+        cwd=str(python_root.parent), env=environment,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, check=True,
+    )
+    assert "portable-ok" in result.stdout
+    if platform.machine().lower() not in ("aarch64", "arm64"):
+        runtime = Sve256Runtime(execution_mode="native")
+        assert not runtime.is_available()
