From 5be412152c5124a6a4cfb5556cde731510167530 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 09:51:39 +0800
Subject: [PATCH 230/257] feat(cpu-avx2): declare alias_proof=unsupported
 instead of an implicit hard-off

The AVX2 layout plane keeps layout_view_alias_mode=disabled and now publishes
supported_view_modes=[forbid, prefer], so view_mode=require cannot silently
select AVX2: it is served only by the AVX-512 proof-gated plane.
---
 python/pypto/compiler/targets/cpu_avx2.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/python/pypto/compiler/targets/cpu_avx2.py b/python/pypto/compiler/targets/cpu_avx2.py
index f6781d9f3..038f6c2f5 100644
--- a/python/pypto/compiler/targets/cpu_avx2.py
+++ b/python/pypto/compiler/targets/cpu_avx2.py
@@ -1757,8 +1757,13 @@ def _execution_metadata(target_ir: Avx2Program) -> dict:
         "layout_view_alias_mode": "disabled",
         "layout_view_alias_reason": (
             "static-prefix check only; the SSA liveness alias proof is not wired "
-            "into the executor, so every layout output stays a real copy"
+            "into the AVX2 executor, so every layout output stays a real copy; "
+            "view_mode=require is only served by the AVX-512 proof-gated plane"
         ),
+        "layout_view_alias_stride_class": "none",
+        "layout_view_alias_contract": "may_alias",
+        "supported_view_modes": ["forbid", "prefer"],
+        "alias_proof_mode": "unsupported",
         "indexing_descriptor_wire": "host-reference:v1",
         "indexing_scalar_lane_fallback": [],
         "indexing_operations": _indexing_metadata(target_ir),
