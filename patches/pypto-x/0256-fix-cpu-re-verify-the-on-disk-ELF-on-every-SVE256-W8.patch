 python/pypto/backends/cpu/aarch64/sve256.py |  52 +++++++++++++----
 python/tests/ut/pypto_x/test_w8a8_sve256.py | 147 ++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 189 insertions(+), 10 deletions(-)

diff --git a/python/pypto/backends/cpu/aarch64/sve256.py b/python/pypto/backends/cpu/aarch64/sve256.py
index d350645af..63c66e598 100644
--- a/python/pypto/backends/cpu/aarch64/sve256.py
+++ b/python/pypto/backends/cpu/aarch64/sve256.py
@@ -2040,6 +2040,31 @@ class Sve256Runtime:
         while len(self._w8a8_loaded) > self._w8a8_loaded_limit:
             self._w8a8_loaded.pop(next(iter(self._w8a8_loaded)))
 
+    def _w8a8_memo_artifact_intact(
+        self, artifact: Artifact, loaded: LoadedSve256Artifact
+    ) -> bool:
+        """Re-check the on-disk ELF before serving a memo hit.
+
+        The memo key is the Artifact object identity, but the file behind that
+        immutable object can still be rewritten in place after the first
+        decode.  Re-read it through the same hardened reader the full decode
+        uses (``O_NOFOLLOW``, single-link regular file) and compare sha256 with
+        the digest captured when the artifact was decoded.  A model-graph ELF
+        is ~0.9 MB, so this bounded read+hash costs milliseconds per W8A8 node
+        and stays orders of magnitude below the seconds-long full decode it
+        guards.  ``False`` means fail-closed: the caller drops the memo entry
+        and lets the full decode re-validate (and raise its canonical error).
+        """
+
+        path = artifact.path
+        if path is None:
+            return False
+        try:
+            native_bytes = _read_native_bytes(path)
+        except CpuSve256ArtifactError:
+            return False
+        return hashlib.sha256(native_bytes).hexdigest() == loaded.artifact.content_digest
+
     def _load_w8a8(self, artifact: Artifact) -> Tuple[Any, LoadedSve256Artifact]:
         # The real probe decides W8A8 availability, never an injected
         # capability: an injected "available" cannot forge the native gate,
@@ -2047,16 +2072,23 @@ class Sve256Runtime:
         # passes the probe (same fail-closed rule as C3/C4).
         entry = self._w8a8_loaded.get(id(artifact)) if self._w8a8_memo_enabled else None
         if entry is not None and entry[0] is artifact:
-            declared = entry[1]
-            if declared is None:
-                capability = self._require_real_capability()
-                declared = sve256_w8a8_capabilities(capability, target=self.name)
-                self._store_w8a8_loaded(artifact, declared, entry[2])
-            # Declaration re-validation stays on every dispatch; only the
-            # whole-program decode/lower/digest work is memoized.  A new
-            # Artifact object (including any tampered variant) never hits.
-            self._require_w8a8_declaration(entry[2].artifact, declared)
-            return declared, entry[2]
+            if not self._w8a8_memo_artifact_intact(artifact, entry[2]):
+                # The on-disk ELF no longer matches the decoded artifact:
+                # forget the memo entry and fall through to the full decode,
+                # which re-reads the file and raises the canonical fail-closed
+                # error (or recovers if the original bytes were restored).
+                self._w8a8_loaded.pop(id(artifact), None)
+            else:
+                declared = entry[1]
+                if declared is None:
+                    capability = self._require_real_capability()
+                    declared = sve256_w8a8_capabilities(capability, target=self.name)
+                    self._store_w8a8_loaded(artifact, declared, entry[2])
+                # Declaration re-validation stays on every dispatch; only the
+                # whole-program decode/lower/digest work is memoized.  A new
+                # Artifact object (including any tampered variant) never hits.
+                self._require_w8a8_declaration(entry[2].artifact, declared)
+                return declared, entry[2]
         capability = self._require_real_capability()
         declared = sve256_w8a8_capabilities(capability, target=self.name)
         loaded = self._decode_for_execution(artifact, capability)
diff --git a/python/tests/ut/pypto_x/test_w8a8_sve256.py b/python/tests/ut/pypto_x/test_w8a8_sve256.py
index af4ccf203..52fd573d7 100644
--- a/python/tests/ut/pypto_x/test_w8a8_sve256.py
+++ b/python/tests/ut/pypto_x/test_w8a8_sve256.py
@@ -1030,6 +1030,153 @@ def test_sve256_w8a8_decode_memo_rejects_tampered_elf(build_root, tmp_path):
     assert declared is not None
 
 
+def test_sve256_w8a8_memo_hit_detects_same_object_in_place_rewrite(build_root):
+    """A memo hit re-reads the ELF: same-object in-place rewrite fails closed."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_inplace")
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)  # warm the memo; on-disk bytes still original
+    # The compiler publishes ELFs read/execute-only; the test needs to tamper.
+    os.chmod(path, 0o755)
+
+    tampered = bytearray(original)
+    tampered[-1] ^= 0x01
+    path.write_bytes(bytes(tampered))
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(artifact)
+
+    # Restoring the exact original bytes recovers: the stale entry was dropped
+    # and the full decode re-validated the file from scratch.
+    path.write_bytes(original)
+    declared, loaded = runtime._load_w8a8(artifact)
+    assert loaded.artifact is artifact
+    assert declared is not None
+
+
+def _unrelated_legal_aarch64_elf(tmp_path):
+    """Build a valid static AArch64 ELF that is not a PyPTO-X runner ELF."""
+
+    source = tmp_path / "unrelated.c"
+    source.write_text("int main(void) { return 0; }\n", encoding="utf-8")
+    target = tmp_path / "unrelated_legal.elf"
+    result = subprocess.run(
+        ["aarch64-linux-gnu-gcc", "-static", "-O2", str(source), "-o", str(target)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    if result.returncode != 0 or not target.is_file():
+        pytest.skip("aarch64-linux-gnu-gcc cannot build the swap ELF: {}".format(
+            result.stderr.decode("utf-8", "replace")[:200]
+        ))
+    return target.read_bytes()
+
+
+@pytest.mark.parametrize("variant", ("larger", "truncated", "legal_other_elf", "mtime_rollback"))
+def test_sve256_w8a8_memo_hit_detects_rewrite_variants(build_root, tmp_path, variant):
+    """Larger/truncated/replaced/mtime-rolled rewrites all fail closed."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_variant_{}".format(variant))
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    original_stat = path.stat()
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)
+    os.chmod(path, 0o755)  # compiler publishes ELFs read/execute-only
+
+    if variant == "larger":
+        path.write_bytes(original + b"EXTRA-BYTES")
+    elif variant == "truncated":
+        path.write_bytes(original[: len(original) - 64])
+    elif variant == "legal_other_elf":
+        # All locally compiled PyPTO-X runners are the same generic ELF, so the
+        # swap uses an unrelated but fully valid static AArch64 executable.
+        replacement = _unrelated_legal_aarch64_elf(tmp_path)
+        assert replacement != original
+        path.write_bytes(replacement)
+    elif variant == "mtime_rollback":
+        changed = bytearray(original)
+        changed[-1] ^= 0x01
+        path.write_bytes(bytes(changed))
+        os.utime(path, ns=(original_stat.st_atime_ns, original_stat.st_mtime_ns))
+        assert path.stat().st_size == original_stat.st_size
+        assert path.stat().st_mtime_ns == original_stat.st_mtime_ns
+    else:  # pragma: no cover - parametrization guard
+        raise AssertionError("unknown variant {!r}".format(variant))
+
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(artifact)
+    if variant == "legal_other_elf":
+        path.write_bytes(original)  # leave the shared tmp build tree tidy
+
+
+def test_sve256_w8a8_memo_hit_accepts_identical_inode_replacement(build_root):
+    """A same-content new inode is harmless and still served."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_inode")
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)
+
+    path.unlink()
+    path.write_bytes(original)  # new inode, byte-identical content
+    declared, loaded = runtime._load_w8a8(artifact)
+    assert loaded.artifact is artifact
+    assert declared is not None
+
+
+def test_sve256_w8a8_memo_hit_rejects_symlink_swap(build_root, tmp_path):
+    """O_NOFOLLOW means a symlink swap fails closed even with same bytes."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_symlink")
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)
+
+    target = tmp_path / "symlink_target.elf"
+    target.write_bytes(original)
+    path.unlink()
+    path.symlink_to(target)
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(artifact)
+    path.unlink()
+    path.write_bytes(original)  # leave the shared tmp build tree tidy
+
+
+def test_sve256_w8a8_memo_hit_rejects_hardlink_swap(build_root, tmp_path):
+    """The single-link contract is re-checked on every memo hit."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_hardlink")
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)
+
+    target = tmp_path / "hardlink_target.elf"
+    target.write_bytes(original)
+    path.unlink()
+    os.link(target, path)  # two links now; _read_native_bytes rejects nlink != 1
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(artifact)
+    path.unlink()
+    target.unlink()
+    path.write_bytes(original)  # leave the shared tmp build tree tidy
+
+
 def test_sve256_w8a8_dispatch_revalidates_declaration_on_memo_hit(build_root):
     """The memo only skips decode; the W8A8 gate runs on every dispatch."""
 
