From 339ec532f0c282301199f8b14dbd9f1b00ee449e Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Mon, 7 Sep 2026 02:11:27 +0800
Subject: [PATCH 014/252] fix(core-ir): allow repeated SSA operands

---
 python/pypto/core_ir/model.py           |  2 --
 python/tests/ut/pypto_x/test_core_ir.py | 13 +++++++++++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/python/pypto/core_ir/model.py b/python/pypto/core_ir/model.py
index ecb8b2d96..89c353eec 100644
--- a/python/pypto/core_ir/model.py
+++ b/python/pypto/core_ir/model.py
@@ -353,8 +353,6 @@ class Operation:
         )
 
     def _verify(self, available: Mapping[str, CoreType], context: str) -> Dict[str, CoreType]:
-        if len({ref.name for ref in self.inputs}) != len(self.inputs):
-            raise CoreIRValidationError("%s.inputs 含重复 SSA 引用" % context)
         for index, ref in enumerate(self.inputs):
             if ref.name not in available:
                 raise CoreIRValidationError("%s.inputs[%d] 引用了未定义值 %s" % (context, index, ref.name))
diff --git a/python/tests/ut/pypto_x/test_core_ir.py b/python/tests/ut/pypto_x/test_core_ir.py
index c7687449e..b34eef8b2 100644
--- a/python/tests/ut/pypto_x/test_core_ir.py
+++ b/python/tests/ut/pypto_x/test_core_ir.py
@@ -163,6 +163,19 @@ def test_ssa_reference_verification_rejects_undefined_input():
         function.verify()
 
 
+def test_same_ssa_value_can_be_used_by_multiple_operand_positions():
+    tensor = CoreType.tensor("float32", (4,))
+    x = ValueRef("x", tensor)
+    out = ValueRef("out", tensor)
+    function = CoreFunction(
+        "double",
+        parameters=(x,),
+        returns=(out,),
+        body=Region((Operation("add", inputs=(x, x), outputs=(out,)),)),
+    )
+    assert function.verify() is True
+
+
 def test_tensor_frontend_explicit_export_and_native_bridge_seam():
     tensor = CoreType.tensor("bf16", (8,))
     x = ValueRef("x", tensor)
