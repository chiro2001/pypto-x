+def _plan_for_opcode(opcode):
+    if opcode == "iota":
+        return plan_operation("iota", [], dtype="int32", output_shape=(4,)).plan
+    if opcode == "cast":
+        return plan_operation("cast", [(2, 3)], ["int32"], output_dtype="float32").plan
+    if opcode == "reshape":
+        return plan_operation("reshape", [(2, 3)], ["float32"], output_shape=(6,)).plan
+    if opcode == "where":
+        return plan_operation(
+            "where", [(2, 3), (2, 3), (1,)], ["bool", "float32", "float32"]
+        ).plan
+    if opcode == "compare":
+        return plan_operation(
+            "compare", [(2, 3), (2, 3)], ["float32", "float32"], attributes={"predicate": "eq"}
+        ).plan
+    return plan_operation(opcode, [(2, 3)], ["float32"]).plan
+
