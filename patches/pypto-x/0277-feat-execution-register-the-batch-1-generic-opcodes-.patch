+    request_dtype = str(info["request_dtype"])
+    request = {
+        "op": definition.canonical_opcode,
+        "left_shape": list(info["input_shapes"][0]) if info["input_shapes"] else [],
+        "right_shape": list(info["input_shapes"][1]) if len(info["input_shapes"]) > 1 else [],
