+# (``python/pypto/lowering/cpu`` + ``python/pypto/backends/cpu``).  The
+# contract documents are schema v3 (they add precision/semantics/attribute
+# blocks); the frozen matmul/qmatmul documents stay at schema v2 so their
+# contract digests -- and therefore every frozen plan digest -- are unchanged.
+BATCH1_CANONICAL_OPCODES = (
+    "compare",
+    "cast",
