+@pytest.mark.parametrize("opcode", BATCH1_OPS)
+def test_plan_digest_self_proof_and_tamper_rejected(opcode):
+    plan = _plan_for_opcode(opcode)
+    document = plan.to_dict()
+    reloaded = ExecutionPlan.from_dict(document)
+    assert reloaded.digest == plan.digest
+    payload = {key: value for key, value in document.items() if key != "plan_digest"}
+    # Digest mismatch is refused.
+    forged = json.loads(json.dumps(payload))
+    forged["request"]["output_shape"] = [999]
+    with pytest.raises(ArtifactMismatchError) as info:
+        ExecutionPlan.from_dict({**forged, "plan_digest": plan.digest})
+    assert info.value.reason == "plan_digest_mismatch"
+    # A v3 request whose projection disagrees with the authoritative operand
+    # list is refused even when every digest is recomputed.
+    tampered = json.loads(json.dumps(payload))
+    tampered["request"]["left_shape"] = [123]
+    with pytest.raises(ArtifactMismatchError) as info2:
+        ExecutionPlan(tampered).validate()
+    assert info2.value.reason == "plan_field_inconsistent"
+    # Unknown plan schema versions are refused.
+    other = json.loads(json.dumps(payload))
+    other["plan_schema_version"] = 99
+    with pytest.raises(ArtifactMismatchError) as info3:
+        ExecutionPlan(other).validate()
+    assert info3.value.reason == "plan_schema_version_mismatch"
+
