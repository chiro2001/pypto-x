+++ b/python/tests/ut/pypto_x/test_execution_ops_registry_batch1.py
@@ -0,0 +1,975 @@
+"""0048-B batch-1 opcode registry + generic plan/execute acceptance tests.
+
+The suite pins four things:
+
+* the eight registered contracts and their published rules (shape/dtype/
+  attribute whitelist/precision/semantics), plus the frozen matmul/qmatmul
+  contract digests;
+* a per-op contract violation matrix (dtype x rank x broadcast x attribute)
+  that must fail closed with a structured ``OpContractError``;
+* a per-op execution differential against the *portable reference helpers*
+  named by each contract (``pypto.backends.cpu.runtime._where_value`` and
+  friends), covering NaN/+-0/inf/subnormal/bf16 bit patterns, integer
+  extremes, negative-step iota, broadcast shapes and zero-length tensors;
+* plan/report self-containment (digest self-proof, tamper refusal, v4
+  cross-block reconciliation) and the default zero-change guarantees
+  (the frozen matmul/qmatmul contract and plan digests).
+
+The differential oracle is deliberately not the provider path: it calls the
+lowering/runtime helper functions directly, so a change that makes the
+provider agree with a broken helper (or vice versa) is still visible.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import struct
+
+import pytest
+
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cpu.runtime import (
+    _cast_value_for_operation,
+    _math_value,
+    _reduce_value,
+    _reshape_value,
+    _where_value,
+)
+from pypto.core_ir import CoreType
+from pypto.execution import (
+    ExecutionError,
+    ExecutionPlan,
+    ExecutionPolicy,
+    NumericGuaranteeUnmetError,
+    NumericPolicy,
+    OpContractError,
+    ReportSchemaError,
+    execute_operation,
+    get_op_definition,
+    operation_provider_capability,
+    plan_matmul,
+    plan_operation,
+    plan_qmatmul,
+    registered_opcodes,
+    validate_report_schema,
+)
+from pypto.execution.capability import CapabilitySnapshot
+from pypto.execution.errors import ArtifactMismatchError
+from pypto.lowering.cpu import OP_ALIASES, compare_values, iota_values
+
+
+BATCH1_OPS = (
+    "cast",
+    "compare",
+    "exp",
+    "iota",
+    "reduce_max",
+    "reduce_sum",
+    "reshape",
+    "where",
+)
+ALL_OPCODES = tuple(sorted(BATCH1_OPS + ("matmul", "qmatmul_s8s8_s32")))
+
+# Frozen U1/U2 contract digests (recorded from the 923a72e26 baseline tree).
+FROZEN_MATMUL_CONTRACT_DIGEST = (
+    "sha256:dbcd409d67f328633a6cd91d4ce5f467fe5b3146ab4566ef367e10fca374fe0d"
+)
+FROZEN_QMATMUL_CONTRACT_DIGEST = (
+    "sha256:6fadd1069da0df59c6d98d7326599899a3dacf0250f9757d7cbcb3ee10a300cc"
+)
+
+# Default-policy baseline recorded from the integration tree (923a72e26) on
+# the local KVM host.  The host probe digest guards the host-dependent pins.
+BASELINE_CAPABILITY_DIGEST = (
+    "sha256:e0a9dac8abc785a6a733448883cee5f1162db08e74ac5bd56cbff6f65641ad1e"
+)
+BASELINE_RECORDS = {
+    ("matmul", "float32"): {
+        "plan_digest": "sha256:e0d1287e91dee4b7c9635fb573636f7de4d0cafc2de5fe8d81035c33d29814df",
+        "artifact_digest": "sha256:9b3565a65b699c1628ee10b0fd8de0f9d142493b76e74429584eeb03707488cc",
+        "output_digest": "sha256:71b4d086c537a7485732c3542ba8485894513791d61feb83077a80ed0432ff77",
+    },
+    ("matmul", "bf16"): {
+        "plan_digest": "sha256:7e95c65c0153fbb87d4b1169ea011ff75bdb523d80270dfdeb1bd33923992087",
+        "artifact_digest": "sha256:4dffff42f69a6042fbb40c48d801dd455ce501a3c53ea04880ed8a03e90d8355",
+        "output_digest": "sha256:cf48cff99369c7161f7d34094fcf13b3a4a5831801fa683f4d46978d14c0c967",
+    },
+    ("qmatmul_s8s8_s32", "int8"): {
+        "plan_digest": "sha256:1717a8e5e4e08b138f71131ac1667720c75174c1fa7a1ae53aff3760ac815c67",
+        "artifact_digest": "sha256:4f6f40dc6546e480ea34a8d7ce569c47b0032e6304e6c5854f25c24856cef8a4",
+        "output_digest": "sha256:f434cb00c4ac85d5cd0e469e3fb02a7636a474a9215f55da3b516623ae6d6669",
+    },
+}
+FROZEN_MATMUL_PLAN_DIGEST = BASELINE_RECORDS[("matmul", "float32")]["plan_digest"]
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+def tensor(dtype, shape, values):
+    return HostTensor(dtype, shape, values)
+
+
+def flat(value):
+    """The portable reference helpers take/return flat Python lists."""
+
+    return list(value.flat()) if isinstance(value, HostTensor) else list(value)
+
+
+def digest_of_values(values):
+    payload = json.dumps(list(values), sort_keys=True, separators=(",", ":"), allow_nan=True)
+    return "sha256:" + hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def baseline_tensor(dtype, shape, seed):
+    """Reproduce the baseline recorder's deterministic input generator."""
+
+    count = 1
+    for dimension in shape:
+        count *= dimension
+    values = []
+    state = seed
+    for _ in range(count):
+        state = (1103515245 * state + 12345) % (2**31)
+        if dtype == "int8":
+            values.append((state % 255) - 127)
+        else:
+            values.append((state % 1000) / 997.0 - 0.5)
+    return HostTensor(dtype, shape, values)
+
+
+def same_value(left, right):
+    if isinstance(left, float) and isinstance(right, float):
+        if math.isnan(left) or math.isnan(right):
+            return math.isnan(left) and math.isnan(right)
+        if left == 0.0 and right == 0.0:
+            return struct.pack("<d", left) == struct.pack("<d", right)
+    return left == right
+
+
+def same_values(left, right):
+    left_values = flat(left)
+    right_values = flat(right)
+    return len(left_values) == len(right_values) and all(
+        same_value(a, b) for a, b in zip(left_values, right_values)
+    )
+
+
+def core_type(dtype, shape):
+    return CoreType.tensor(dtype, tuple(shape))
+
+
+def plan_op(opcode, shapes, dtypes=None, **kwargs):
+    """Call the generic entry with the (shapes, dtypes) spelling."""
+
+    return plan_operation(opcode, [list(shape) for shape in shapes], dtypes, **kwargs)
+
+
+def expect_contract_error(reason, call):
+    with pytest.raises(OpContractError) as info:
+        call()
+    assert info.value.reason == reason, info.value.to_dict()
+    return info.value
+
+
+def plan_generic(opcode, tensors, attributes=None, **kwargs):
+    return plan_operation(
+        opcode,
+        [list(item.shape) for item in tensors],
+        [item.dtype for item in tensors],
+        attributes=attributes or {},
+        **kwargs,
+    )
+
+
+def run_generic(opcode, tensors, attributes=None, **kwargs):
+    resolution = plan_generic(opcode, tensors, attributes, **kwargs)
+    output, report = execute_operation(resolution.plan, tensors)
+    return resolution.plan, output, report
+
+
+# ---------------------------------------------------------------------------
+# registry / contract documents
+# ---------------------------------------------------------------------------
+def test_registry_registers_exactly_the_batch1_contracts():
+    assert registered_opcodes() == ALL_OPCODES
+    for opcode in BATCH1_OPS:
+        definition = get_op_definition(opcode)
+        assert definition.canonical_opcode == opcode
+        assert definition.contract_version == "1.0"
+        assert definition.verifier == "generic"
+        assert definition.allowed_providers == ("portable",)
+        assert definition.contract_digest.startswith("sha256:")
+        assert definition.document_schema_version == 3
+        assert definition.arity == len(definition.input_roles)
+        assert definition.precision
+        assert definition.semantics
+        aliases = tuple(sorted(name for name, canonical in OP_ALIASES.items() if canonical == opcode))
+        assert definition.core_ir_opcodes == aliases
+        # The declared executor symbol exists in the portable reference.
+        reference = definition.portable_reference
+        assert reference["runtime"] == "pypto.backends.cpu.CpuScalarRuntime"
+        module_name, symbol = reference["executor_symbol"].rsplit(".", 1)
+        module = __import__(module_name, fromlist=[symbol])
+        assert callable(getattr(module, symbol))
+
+
+def test_matmul_and_qmatmul_contracts_stay_frozen():
+    matmul = get_op_definition("matmul")
+    qmatmul = get_op_definition("qmatmul_s8s8_s32")
+    assert matmul.contract_digest == FROZEN_MATMUL_CONTRACT_DIGEST
+    assert qmatmul.contract_digest == FROZEN_QMATMUL_CONTRACT_DIGEST
+    # The frozen documents keep their v2 schema; batch-1 documents use v3.
+    assert matmul.contract_document["op_registry_schema_version"] == 2
+    assert qmatmul.contract_document["op_registry_schema_version"] == 2
+    for opcode in BATCH1_OPS:
+        assert get_op_definition(opcode).contract_document["op_registry_schema_version"] == 3
+
+
+@pytest.mark.parametrize(
+    "opcode, shape_rule_id, result_kind, arity",
+    [
+        ("where", "broadcast_ternary_trailing_v1", "same_as_input", 3),
+        ("compare", "broadcast_binary_trailing_v1", "fixed", 2),
+        ("iota", "iota_axis_sequence_v1", "declared_output", 0),
+        ("exp", "unary_shape_preserving_v1", "same_as_input", 1),
+        ("reduce_sum", "reduce_axes_v1", "same_as_input", 1),
