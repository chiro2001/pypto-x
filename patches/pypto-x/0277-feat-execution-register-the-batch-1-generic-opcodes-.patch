+def _input_spec(value: str) -> tuple:
+    """Parse ``SHAPE`` or ``SHAPE:DTYPE`` into a (shape, dtype) pair."""
+
+    text = str(value).strip()
+    dtype = None
+    if ":" in text:
+        shape_text, dtype_text = text.rsplit(":", 1)
+        dtype = dtype_text.strip() or None
+    else:
+        shape_text = text
+    return (_shape(shape_text), dtype)
+
+
+def _attribute(value: str) -> tuple:
+    """Parse ``KEY=VALUE`` where VALUE is JSON when parseable, else a string."""
+
+    text = str(value)
+    if "=" not in text:
+        raise argparse.ArgumentTypeError("--attr expects KEY=VALUE")
+    key, raw = text.split("=", 1)
+    key = key.strip()
+    if not key:
+        raise argparse.ArgumentTypeError("--attr key must not be empty")
+    try:
+        parsed = json.loads(raw)
+    except ValueError:
+        parsed = raw
+    return (key, parsed)
+
+
+def _attributes(items: Optional[Sequence[Any]]) -> Optional[dict]:
+    """Reject duplicate --attr keys instead of silently keeping the last."""
+
+    if not items:
+        return None
+    document = {}
+    for key, value in items:
+        if key in document:
+            raise argparse.ArgumentTypeError("duplicate --attr key {!r}".format(key))
+        document[key] = value
+    return document
+
