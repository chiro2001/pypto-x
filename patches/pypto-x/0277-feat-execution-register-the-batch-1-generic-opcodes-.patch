+def verify_cast(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``cast``: declared-dtype conversion with the portable cast semantics."""
+
+    _check_attributes("cast", attributes, definition.attribute_names)
+    if len(input_types) != 1:
+        raise _arity_error("cast", 1, len(input_types))
+    input_dtype, input_shape = _require_tensor(input_types[0], "input", ALL_DTYPES)
+    present = [key for key in ("dtype", "to", "target_dtype", "out_dtype") if key in attributes]
+    declared = []
+    for key in present:
+        try:
+            declared.append(canonical_dtype(attributes[key]))
+        except CpuScalarUnsupportedError as exc:
+            raise OpContractError(
+                "cast attribute {}={!r} is not a portable dtype".format(key, attributes[key]),
+                field="operation.attributes." + key,
+                requested=attributes[key],
+                available=list(ALL_DTYPES),
+                reason="cast_target_dtype_invalid",
+            ) from exc
+    if declared and any(value != declared[0] for value in declared[1:]):
+        raise OpContractError(
+            "cast target dtype attributes conflict",
+            field="operation.attributes",
+            requested={key: attributes[key] for key in present},
+            reason="conflicting_attribute_aliases",
+        )
+    attribute_dtype = declared[0] if declared else None
+    if attribute_dtype is not None and declared_output_dtype is not None:
+        try:
+            explicit = canonical_dtype(declared_output_dtype)
+        except CpuScalarUnsupportedError as exc:
+            raise OpContractError(
+                "cast declared output dtype {!r} is not a portable dtype".format(
+                    declared_output_dtype
+                ),
+                field="dtype.output",
+                requested=declared_output_dtype,
+                available=list(ALL_DTYPES),
+                reason="dtype_outside_contract_domain",
+            ) from exc
+        if explicit != attribute_dtype:
+            raise OpContractError(
+                "cast target dtype attribute does not match the declared output dtype",
+                field="operation.attributes.dtype",
+                requested=attribute_dtype,
+                available=explicit,
+                reason="cast_target_dtype_mismatch",
+            )
+    expected_dtype = attribute_dtype
+    if expected_dtype is None:
+        if declared_output_dtype is None:
+            raise OpContractError(
+                "cast requires a target dtype (attribute or declared output dtype)",
+                field="request.output_dtype",
+                requested=None,
+                available=["dtype", "to", "target_dtype", "out_dtype", "output_dtype"],
+                reason="output_dtype_required",
+            )
+        try:
+            expected_dtype = canonical_dtype(declared_output_dtype)
+        except CpuScalarUnsupportedError as exc:
+            raise OpContractError(
+                "cast declared output dtype {!r} is not a portable dtype".format(
+                    declared_output_dtype
+                ),
+                field="dtype.output",
+                requested=declared_output_dtype,
+                available=list(ALL_DTYPES),
+                reason="dtype_outside_contract_domain",
+            ) from exc
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        expected_dtype,
+        input_shape,
+        "cast",
+        ALL_DTYPES,
+    )
+    for key in ("mode", "cast_mode"):
+        if key not in attributes:
+            continue
+        value = str(getattr(attributes[key], "value", attributes[key])).strip().lower()
+        if value not in ("none", "cast_none", "0"):
+            raise OpContractError(
+                "cast mode {!r} is unsupported; only CAST_NONE is portable".format(attributes[key]),
+                field="operation.attributes." + key,
+                requested=attributes[key],
+                available=["CAST_NONE", "none", "0"],
+                reason="cast_mode_not_portable",
+            )
+    for key in ("satmode", "saturation", "saturate"):
+        if key not in attributes:
+            continue
+        value = attributes[key]
+        text = str(getattr(value, "value", value)).strip().lower()
+        if value is not False and text not in ("off", "false", "0"):
+            raise OpContractError(
+                "cast saturation {!r} is unsupported in the portable subset".format(value),
+                field="operation.attributes." + key,
+                requested=value,
+                available=[False, "off", "0"],
+                reason="cast_saturation_not_portable",
+            )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(input_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": input_dtype,
+        "input_dtypes": [input_dtype],
+        "input_shapes": [list(input_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": len(input_shape),
+        "min_dimension": _min_dimension((input_shape,)),
+        "attributes": {"dtype": output_dtype},
+        "precision": precision,
+    }
+
+
+def verify_reshape(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``reshape``: element-count-preserving reinterpretation."""
+
+    _check_attributes("reshape", attributes, definition.attribute_names)
+    if len(input_types) != 1:
+        raise _arity_error("reshape", 1, len(input_types))
+    input_dtype, input_shape = _require_tensor(input_types[0], "input", ALL_DTYPES)
+    present = [key for key in ("shape", "target_shape", "out_shape") if key in attributes]
+    declared = []
+    for key in present:
+        try:
+            declared.append(_static_shape_tuple(attributes[key], "output"))
+        except OpContractError as exc:
+            raise OpContractError(
+                "reshape attribute {} must be a sequence of non-negative integers".format(key),
+                field="operation.attributes." + key,
+                requested=attributes[key],
+                reason="reshape_shape_invalid",
+            ) from exc
+    if declared and any(value != declared[0] for value in declared[1:]):
+        raise OpContractError(
+            "reshape target shape attributes conflict",
+            field="operation.attributes",
+            requested={key: attributes[key] for key in present},
+            reason="conflicting_attribute_aliases",
+        )
+    attribute_shape = declared[0] if declared else None
+    if attribute_shape is not None and declared_output_shape is not None:
+        explicit = _static_shape_tuple(declared_output_shape, "output")
+        if explicit != attribute_shape:
+            raise OpContractError(
+                "reshape target shape attribute does not match the declared output shape",
+                field="operation.attributes.shape",
+                requested=list(attribute_shape),
+                available=list(explicit),
+                reason="reshape_target_shape_mismatch",
+            )
+    expected_shape = attribute_shape
+    if expected_shape is None:
+        if declared_output_shape is None:
+            raise OpContractError(
+                "reshape requires a target shape (attribute or declared output shape)",
+                field="request.output_shape",
+                requested=None,
+                available=["shape", "target_shape", "out_shape", "output_shape"],
+                reason="reshape_target_shape_missing",
+            )
+        expected_shape = _static_shape_tuple(declared_output_shape, "output")
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        input_dtype,
+        expected_shape,
+        "reshape",
+        ALL_DTYPES,
+    )
+    if "inplace" in attributes:
+        inplace = attributes["inplace"]
+        if not isinstance(inplace, bool):
+            raise OpContractError(
+                "reshape inplace must be a bool",
+                field="operation.attributes.inplace",
+                requested=inplace,
+                reason="reshape_inplace_not_bool",
+            )
+        if inplace:
+            raise OpContractError(
+                "in-place reshape aliasing is not portable",
+                field="operation.attributes.inplace",
+                requested=True,
+                available=False,
+                reason="reshape_inplace_not_portable",
+            )
+    for key in ("valid_shape", "valid_shapes"):
+        if key not in attributes:
+            continue
+        raw = attributes[key]
+        try:
+            values = _static_shape_tuple(raw, "output")
+        except OpContractError as exc:
+            raise OpContractError(
+                "reshape {} must be a non-empty sequence of non-negative integers".format(key),
+                field="operation.attributes." + key,
+                requested=raw,
+                reason="reshape_valid_shape_invalid",
+            ) from exc
+        if not values:
+            raise OpContractError(
+                "reshape {} must be a non-empty sequence of non-negative integers".format(key),
+                field="operation.attributes." + key,
+                requested=raw,
+                reason="reshape_valid_shape_invalid",
+            )
+        if values != output_shape:
+            raise OpContractError(
+                "reshape {} is not represented by the portable tensor ABI".format(key),
+                field="operation.attributes." + key,
+                requested=list(values),
+                available=list(output_shape),
+                reason="reshape_valid_shape_not_representable",
+            )
+    if element_count(input_shape) != element_count(output_shape):
+        raise OpContractError(
+            "reshape input shape {} and output shape {} have different element counts".format(
+                input_shape, output_shape
+            ),
+            field="shape.element_count",
+            requested={"input_shape": list(input_shape), "output_shape": list(output_shape)},
+            available={"input_elements": element_count(input_shape),
+                       "output_elements": element_count(output_shape)},
+            reason="reshape_element_count_mismatch",
+        )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(input_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": input_dtype,
+        "input_dtypes": [input_dtype],
+        "input_shapes": [list(input_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": max(len(input_shape), len(output_shape)),
+        "min_dimension": _min_dimension((input_shape,)),
+        "attributes": {"shape": list(output_shape)},
+        "precision": precision,
+    }
+
+
+GENERIC_VERIFIERS = {
+    "where": verify_where,
+    "compare": verify_compare,
+    "iota": verify_iota,
+    "exp": verify_unary_math,
+    "reduce_sum": verify_reduce_sum,
+    "reduce_max": verify_reduce_max,
+    "cast": verify_cast,
+    "reshape": verify_reshape,
+}
+
+
+def verify_lowering_accepts(
+    canonical_opcode: str,
+    input_types: Sequence[CoreType],
+    output_type: CoreType,
+    attributes: Mapping[str, Any]
+) -> None:
+    """Cross-check one verified request against the portable lowering.
+
+    The contract layer is stricter than the lowering (attribute whitelist,
+    rank/dtype domain), but it must never accept a request the reference
+    executor cannot lower.  Building the one-operation Core IR program and
+    running the lowering's own validator keeps the two views coupled.
+    """
+
+    from pypto.core_ir import CoreFunction, CoreProgram, Region, ValueRef
+
+    inputs = tuple(
+        ValueRef("in{}".format(index), value_type) for index, value_type in enumerate(input_types)
+    )
+    output = ValueRef("output", output_type)
+    operation = Operation(canonical_opcode, inputs, (output,), dict(attributes))
+    program = CoreProgram(functions=(CoreFunction(canonical_opcode, inputs, (output,), Region((operation,))),))
+    try:
+        validate_program(program)
+    except (CpuScalarError, CpuScalarUnsupportedError, CpuScalarValidationError) as exc:
+        raise OpContractError(
+            "the portable lowering rejects the verified {} request: {}".format(canonical_opcode, exc),
+            field="operation",
+            requested={"opcode": canonical_opcode, "attributes": dict(attributes)},
+            available="a request accepted by pypto.lowering.cpu.validate_program",
+            reason="lowering_reference_rejected_request",
+            details={"lowering_error": type(exc).__name__, "lowering_message": str(exc)},
+        ) from exc
+
+
+__all__ = [
+    "ALL_DTYPES",
+    "BOUNDED_BOUND_KIND",
+    "CONTRACT_REFERENCE_VERSION",
+    "EXACT_BOUND_KIND",
+    "FLOAT_DTYPE_TUPLE",
+    "GENERIC_VERIFIERS",
+    "INTEGER_OR_BOOL_DTYPES",
+    "PRECISION_BOUNDED",
+    "PRECISION_EXACT",
+    "RANK_MAX",
+    "RANK_MIN",
+    "REDUCTION_DTYPES",
+    "precision_declaration",
+    "resolve_precision",
+    "verify_lowering_accepts",
+]
