+def test_report_v4_is_self_contained_and_tamper_rejected():
+    input_tensor = tensor("float32", (2, 3), [1, 2, 3, 4, 5, 6])
+    plan, _, report = run_generic("reduce_sum", [input_tensor], attributes={"axes": [1]})
+    document = report.to_dict()
+    validate_report_schema(document)
+    assert document["schema_version"] == 4
+    assert document["plan_payload"]["digest"] == plan.digest
+    preimage = json.dumps(
+        document["plan_payload"]["document"], sort_keys=True, separators=(",", ":")
+    ).encode()
+    assert "sha256:" + hashlib.sha256(preimage).hexdigest() == document["plan_payload"]["digest"]
+    from pypto.execution.decision import decision_document_from_payload
+
+    assert document["resolution_decision"]["document"] == decision_document_from_payload(
+        document["plan_payload"]["document"]
+    )
+    # Recomputing the embedded decision digest does not rescue a divergent copy.
+    forger = json.loads(json.dumps(document))
+    forger["resolution"]["plan_digest"] = "sha256:" + "0" * 64
+    with pytest.raises(ReportSchemaError) as info:
+        validate_report_schema(forger)
+    assert "plan_digest" in info.value.field
+    # A rewritten request copy is refused against the request rule echo.
+    forger2 = json.loads(json.dumps(document))
+    forger2["request"]["output_shape"] = [999]
+    with pytest.raises(ReportSchemaError):
+        validate_report_schema(forger2)
+    # A rewritten precision declaration is refused against the plan payload.
+    forger3 = json.loads(json.dumps(document))
+    forger3["guarantees"]["precision"] = {"class": "exact"}
+    with pytest.raises(ReportSchemaError):
+        validate_report_schema(forger3)
