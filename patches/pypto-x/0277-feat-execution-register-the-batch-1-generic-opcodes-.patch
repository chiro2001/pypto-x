+            if reduction_order_id is None
+            else reduction_order_id
+        ),
+        artifact_kind=PORTABLE_ARTIFACT_KIND,
+        pack={"strategy": "none", "included_in_timing": True},
+        provider_artifact_digest=None,
+        library={},
+        threads={"model": "single_thread", "max_threads": PORTABLE_PROVIDER_MAX_THREADS},
+        preconditions={
+            "min_dimension": 0,
+            "slice_step_domain": "positive",
+            "layout_descriptor_version": 1,
+        },
+    )
