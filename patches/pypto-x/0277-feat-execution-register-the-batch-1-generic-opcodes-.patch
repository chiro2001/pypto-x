+def test_vendor_candidates_are_structurally_rejected_not_misselected():
+    from pypto.execution.capability import default_providers_for_operation
+
+    snapshot = CapabilitySnapshot(
+        kind="cpu",
+        triple=None,
+        features=None,
+        providers=default_providers_for_operation("cpu", "exp"),
+    )
+    resolution = plan_op(
+        "exp", [(2, 3)], ["float32"], capability=snapshot
+    )
+    plan = resolution.plan
+    assert plan.selected_provider == "portable"
+    vendor_candidates = [item for item in plan.payload["candidates"] if item["id"].startswith("vendor:")]
+    assert vendor_candidates, "the vendor entries must be evaluated and recorded"
+    for item in vendor_candidates:
+        assert item["state"] == "rejected"
+        assert item["reason"] == "provider_not_allowed_by_contract"
+    with pytest.raises(ExecutionError) as info:
+        plan_op(
+            "exp",
+            [(2, 3)],
+            ["float32"],
+            policy=ExecutionPolicy(profile="auto_static", provider={"mode": "vendor"}),
+            capability=snapshot,
+        )
+    assert info.value.reason in (
+        "required_provider_rejected:provider_not_allowed_by_contract",
+        "no_provider_in_policy_scope",
+    )
