+"""Generic operation contracts for the batch-1 opcode registration (0048-B).
+
+This module is the per-op rule table that the execution-layer
+:class:`pypto.execution.op_registry.OpDefinition` wraps.  It is deliberately a
+*view* of the portable CPU scalar lowering: the shape/broadcast helpers
+(:func:`pypto.lowering.cpu._broadcast_shape`, ``reduced_shape``,
+``iota_spec``, ``comparison_predicate_for_operation``) are imported from the
+lowering module, so "the contract accepts X, the reference executor rejects X"
+cannot drift silently.
+
+Every verifier:
+
+* rejects unknown attributes (the Core IR container is permissive; the
+  contract is not);
+* rejects symbolic/negative/non-integer dimensions and rank outside 1..4;
+* rejects an operand dtype outside the declared domain;
+* re-derives the result shape and dtype from the contract rule;
+* returns a JSON-safe ``info`` mapping consumed by the resolver/provider.
+
+Precision is declared per dtype *path* (integer/bool versus float) and is
+resolved from the same document the operator registry publishes, so the plan
+and report carry the class the contract text declares.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.core_ir import CoreType, Operation
+from pypto.lowering.cpu import (
+    FLOAT_DTYPES,
+    INTEGER_DTYPES,
+    SUPPORTED_DTYPES,
+    CpuScalarError,
+    CpuScalarUnsupportedError,
+    CpuScalarValidationError,
+    _broadcast_shape,
+    canonical_dtype,
+    comparison_predicate_for_operation,
+    element_count,
+    iota_spec,
+    reduced_shape,
+    validate_program,
+)
+from pypto.lowering.cpu import (
+    _normalize_axes as _lowering_normalize_axes,
+)
+
+from .errors import OpContractError
+
+
+CONTRACT_REFERENCE_VERSION = "1.0"
+RANK_MIN = 1
+RANK_MAX = 4
+
+ALL_DTYPES = tuple(sorted({canonical_dtype(dtype) for dtype in SUPPORTED_DTYPES}))
+INTEGER_OR_BOOL_DTYPES = tuple(
+    sorted(set(INTEGER_DTYPES) | {"bool"})
+)
+FLOAT_DTYPE_TUPLE = tuple(sorted(FLOAT_DTYPES))
+REDUCTION_DTYPES = tuple(sorted(set(ALL_DTYPES) - {"bool"}))
+
+# Precision rule classes.  ``exact_contract_bound`` is a proven bound kind in
+# ``pypto.execution.manifest.PROVEN_DEVIATION_BOUND_KINDS``; the float class
+# deliberately uses a kind that is *not* registered as proven, so
+# ``numeric.require_proven_deviation_bound=true`` fails closed instead of
+# treating a deterministic serial order (or observations) as a bound.
+PRECISION_EXACT = "exact"
+PRECISION_BOUNDED = "deterministic_bounded"
+EXACT_BOUND_KIND = "exact_contract_bound"
+BOUNDED_BOUND_KIND = "deterministic_serial_order_no_registered_analytic_bound"
+
+_PRECISION_DECLARATION_VERSION = 1
+
+
+# ---------------------------------------------------------------------------
+# precision declaration / resolution
+# ---------------------------------------------------------------------------
+def _exact_rule(name: str, basis: str, **extra: Any) -> Mapping[str, Any]:
+    rule = {
+        "name": name,
+        "class": PRECISION_EXACT,
+        "basis": basis,
+        "deviation_bound_kind": EXACT_BOUND_KIND,
+        "deviation_bound_available": True,
+        "deviation_bound_by_operation": {"all_values": 0},
+        "measurement_policy": "exact_by_contract_no_observations_needed",
+        "upper_bound": {
+            "status": "proven",
+            "reason": basis,
+            "blocking_evidence": [],
+        },
+    }
+    rule.update(extra)
+    return rule
+
+
+def _bounded_rule(
+    name: str,
+    basis: str,
+    domain_statement: str,
+    error_statement: str,
+    **extra: Any
+) -> Mapping[str, Any]:
+    rule = {
+        "name": name,
+        "class": PRECISION_BOUNDED,
+        "basis": basis,
+        "deviation_bound_kind": BOUNDED_BOUND_KIND,
+        "deviation_bound_available": False,
+        "deviation_bound_by_operation": None,
+        "analytic_upper_bound": None,
+        "analytic_upper_bound_note": (
+            "no analytic upper bound is registered for this float path; "
+            "observations are not a bound and are never promoted to one"
+        ),
+        "domain_statement": domain_statement,
+        "error_statement": error_statement,
+        "measurement_policy": "deterministic_and_reproducible_but_ungated",
+        "upper_bound": {
+            "status": "not_published",
+            "reason": "no_registered_analytic_envelope",
+            "blocking_evidence": ["unbounded_input_magnitudes", "platform_libm_or_rounding_path"],
+        },
+    }
+    rule.update(extra)
+    return rule
+
+
+def precision_declaration(
+    *,
+    default: Mapping[str, Any],
+    rules: Sequence[Mapping[str, Any]],
+    notes: Sequence[str] = ()
+) -> Mapping[str, Any]:
+    """Assemble one contract precision declaration document."""
+
+    return {
+        "declaration_version": _PRECISION_DECLARATION_VERSION,
+        "class_vocabulary": [PRECISION_EXACT, PRECISION_BOUNDED],
+        "default": dict(default),
+        "rules": [dict(rule) for rule in rules],
+        "resolution": "first rule whose when-clause matches the request dtype path, else default",
+        "notes": list(notes),
+    }
+
+
+def _dtype_family(dtype: str) -> str:
+    canonical = canonical_dtype(dtype)
+    if canonical == "bool":
+        return "bool"
+    if canonical in FLOAT_DTYPES:
+        return "float"
+    return "integer"
+
+
+def resolve_precision(
+    declaration: Mapping[str, Any],
+    *,
+    input_dtypes: Sequence[str],
+    output_dtype: str
+) -> Mapping[str, Any]:
+    """Resolve the precision rule for one dtype path (fail closed)."""
+
+    input_families = [_dtype_family(dtype) for dtype in input_dtypes]
+    output_family = _dtype_family(output_dtype)
+
+    def matches(when: Mapping[str, Any]) -> bool:
+        allowed = when.get("input_families")
+        if allowed is not None and any(family not in allowed for family in input_families):
+            return False
+        forbidden = when.get("input_families_exclude")
+        if forbidden is not None and any(family in forbidden for family in input_families):
+            return False
+        allowed_output = when.get("output_families")
+        if allowed_output is not None and output_family not in allowed_output:
+            return False
+        return True
+
+    rule = None
+    for candidate in declaration.get("rules", ()):
+        if matches(candidate.get("when", {})):
+            rule = candidate
+            break
+    if rule is None:
+        rule = declaration["default"]
+    resolved = {
+        "declaration_version": declaration["declaration_version"],
+        "rule": strategy_name(rule),
+        "class": str(rule["class"]),
+        "basis": str(rule["basis"]),
+        "deviation_bound_kind": str(rule["deviation_bound_kind"]),
+        "deviation_bound_available": bool(rule["deviation_bound_available"]),
+        "precision_class": str(rule["class"]),
+        "reference": str(rule.get("reference", "")) or None,
+        "input_families": list(input_families),
+        "output_family": output_family,
+    }
+    for key in (
+        "domain_statement",
+        "error_statement",
+        "analytic_upper_bound",
+        "analytic_upper_bound_note",
+        "measurement_policy",
+        "exactness_reason",
+    ):
+        if key in rule:
+            resolved[key] = rule[key]
+    if rule.get("upper_bound") is not None:
+        resolved["upper_bound"] = dict(rule["upper_bound"])
+    return resolved
+
+
+def strategy_name(rule: Mapping[str, Any]) -> str:
+    return str(rule.get("name") or "unnamed")
+
+
+# ---------------------------------------------------------------------------
+# shared operand helpers
+# ---------------------------------------------------------------------------
+def _require_tensor(
+    value_type: Any,
+    label: str,
+    domain: Sequence[str],
+    *,
+    rank_min: int = RANK_MIN,
+    rank_max: int = RANK_MAX
+) -> Tuple[str, Tuple[int, ...]]:
+    if not isinstance(value_type, CoreType):
+        raise OpContractError(
+            "{} must be a CoreType".format(label),
+            field="shape." + label,
+            requested=type(value_type).__name__,
+            reason="operand_not_core_type",
+        )
+    if value_type.kind != "tensor":
+        raise OpContractError(
+            "{} must be a tensor".format(label),
+            field="kind." + label,
+            requested=value_type.kind,
+            available=["tensor"],
+            reason="operand_not_tensor",
+        )
+    try:
+        dtype = canonical_dtype(value_type.dtype)
+    except CpuScalarUnsupportedError as exc:
+        raise OpContractError(
+            "{} dtype {!r} is outside the portable dtype registry".format(label, value_type.dtype),
+            field="dtype." + label,
+            requested=value_type.dtype,
+            available=list(domain),
+            reason="dtype_outside_contract_domain",
+        ) from exc
+    if dtype not in domain:
+        raise OpContractError(
+            "{} dtype {!r} is outside the contract domain".format(label, dtype),
+            field="dtype." + label,
+            requested=dtype,
+            available=list(domain),
+            reason="dtype_outside_contract_domain",
+        )
+    shape = []
+    for index, dimension in enumerate(value_type.shape):
+        if isinstance(dimension, bool) or not isinstance(dimension, int):
+            raise OpContractError(
+                "{} shape[{}] is not a static integer dimension".format(label, index),
+                field="shape.{}.{}".format(label, index),
+                requested=dimension,
+                reason="symbolic_shape_not_supported",
+            )
+        if dimension < 0:
+            raise OpContractError(
+                "{} shape[{}] must be non-negative".format(label, index),
+                field="shape.{}.{}".format(label, index),
+                requested=dimension,
+                reason="negative_dimension",
+            )
+        shape.append(dimension)
+    rank = len(shape)
+    if rank < rank_min or rank > rank_max:
+        raise OpContractError(
+            "{} rank {} is outside the contract range [{}, {}]".format(
+                label, rank, rank_min, rank_max
+            ),
+            field="shape.rank." + label,
+            requested=rank,
+            available=[rank_min, rank_max],
+            reason="rank_out_of_range",
+        )
+    return dtype, tuple(shape)
+
+
+def _check_attributes(operation_name: str, attributes: Mapping[str, Any], allowed: Sequence[str]) -> None:
+    if not isinstance(attributes, Mapping):
+        raise OpContractError(
+            "{} attributes must be a mapping".format(operation_name),
+            field="operation.attributes",
+            requested=type(attributes).__name__,
+            reason="attributes_not_a_mapping",
+        )
+    unknown = sorted(set(attributes) - set(allowed))
+    if unknown:
+        raise OpContractError(
+            "{} does not accept unknown attributes: {}".format(operation_name, ", ".join(unknown)),
+            field="operation.attributes",
+            requested=unknown,
+            available=sorted(allowed),
+            reason="unknown_attribute",
+        )
+
+
+def _broadcast(shapes: Sequence[Tuple[int, ...]], context: str) -> Tuple[int, ...]:
+    try:
+        return tuple(_broadcast_shape(shapes, context))
+    except (CpuScalarValidationError, CpuScalarError) as exc:
+        raise OpContractError(
+            "{} shapes {} are not broadcast-compatible: {}".format(context, list(shapes), exc),
+            field="shape.broadcast",
+            requested={"shapes": [list(shape) for shape in shapes]},
+            available="trailing-axis dimensions equal, or one of them 1 (0 broadcast with 1 yields 0)",
+            reason="broadcast_shape_mismatch",
+        ) from exc
+
+
+def _shape_mismatch(context: str, expected: Sequence[int], actual: Sequence[int], field: str = "shape") -> OpContractError:
+    return OpContractError(
+        "{} output shape {} does not match the contract shape {}".format(
+            context, list(actual), list(expected)
+        ),
+        field=field,
+        requested=list(actual),
+        available=list(expected),
+        reason="shape_rule_violation",
+    )
+
+
+def _static_shape_tuple(
+    shape: Any,
+    label: str,
+    rank_min: int = RANK_MIN,
+    rank_max: int = RANK_MAX
+) -> Tuple[int, ...]:
+    # Only ordered sequences are accepted: a set/frozenset/generator would make
+    # the dimension order (and therefore the contract decision) unstable.
+    if not isinstance(shape, (list, tuple)):
+        raise OpContractError(
+            "{} must be an ordered list/tuple of non-negative integers".format(label),
+            field="shape." + label,
+            requested=type(shape).__name__,
+            reason="shape_rule_violation",
+        )
+    values = tuple(shape)
+    for index, dimension in enumerate(values):
+        if isinstance(dimension, bool) or not isinstance(dimension, int) or dimension < 0:
+            raise OpContractError(
+                "{}[{}] must be a non-negative integer".format(label, index),
+                field="shape.{}.{}".format(label, index),
+                requested=dimension,
+                reason="shape_rule_violation",
+            )
+    if len(values) < rank_min or len(values) > rank_max:
+        raise OpContractError(
+            "{} rank {} is outside [{}, {}]".format(label, len(values), rank_min, rank_max),
+            field="shape.rank." + label,
+            requested=len(values),
+            available=[rank_min, rank_max],
+            reason="rank_out_of_range",
+        )
+    return values
+
+
+def _declared_output(
+    declared_dtype: Optional[str],
+    declared_shape: Optional[Sequence[int]],
+    expected_dtype: str,
+    expected_shape: Sequence[int],
+    context: str,
+    domain: Sequence[str],
+    *,
+    rank_min: int = RANK_MIN,
+    rank_max: int = RANK_MAX
+) -> Tuple[str, Tuple[int, ...]]:
+    """Cross-check an optional declared result against the derived result.
+
+    The ask path omits both declarations and gets the contract-derived result
+    back; the plan-replay path passes the frozen declarations so a mismatch is
+    refused instead of silently re-derived.
+    """
+
+    if declared_dtype is not None:
+        try:
+            canonical = canonical_dtype(declared_dtype)
+        except CpuScalarUnsupportedError as exc:
+            raise OpContractError(
+                "{} declared output dtype {!r} is not a portable dtype".format(
+                    context, declared_dtype
+                ),
+                field="dtype.output",
+                requested=declared_dtype,
+                available=list(domain),
+                reason="dtype_outside_contract_domain",
+            ) from exc
+        if canonical not in domain:
+            raise OpContractError(
+                "{} declared output dtype {!r} is outside the contract domain".format(
+                    context, canonical
+                ),
+                field="dtype.output",
+                requested=canonical,
+                available=list(domain),
+                reason="dtype_outside_contract_domain",
+            )
+        if canonical != expected_dtype:
+            raise OpContractError(
+                "{} declared output dtype does not match the contract result".format(context),
+                field="dtype.output",
+                requested=canonical,
+                available=expected_dtype,
+                reason="dtype_mismatch",
+            )
+    if declared_shape is not None:
+        shape = _static_shape_tuple(declared_shape, "output", rank_min, rank_max)
+        if shape != tuple(expected_shape):
+            raise _shape_mismatch(context, expected_shape, shape)
+    return expected_dtype, tuple(expected_shape)
+
+
+def _arity_error(operation_name: str, expected: int, actual: int) -> OpContractError:
+    return OpContractError(
+        "{} requires exactly {} input(s)".format(operation_name, expected),
+        field="operation.arity",
+        requested={"inputs": actual},
+        available={"inputs": expected},
+        reason="arity_mismatch",
+    )
+
+
+def _min_dimension(shapes: Sequence[Sequence[int]]) -> int:
+    values = [int(dimension) for shape in shapes for dimension in shape]
+    return min(values) if values else 0
+
+
+# ---------------------------------------------------------------------------
+# per-op verifiers
+# ---------------------------------------------------------------------------
+def verify_where(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``where(condition, input, other)``: trailing-axis broadcast selection."""
+
+    _check_attributes("where", attributes, definition.attribute_names)
+    if len(input_types) != 3:
+        raise _arity_error("where", 3, len(input_types))
+    condition_dtype, condition_shape = _require_tensor(input_types[0], "condition", ("bool",))
+    true_dtype, true_shape = _require_tensor(input_types[1], "input", ALL_DTYPES)
+    false_dtype, false_shape = _require_tensor(input_types[2], "other", ALL_DTYPES)
+    if true_dtype != false_dtype:
+        raise OpContractError(
+            "where input/other must share one dtype",
+            field="dtype",
+            requested={"input": true_dtype, "other": false_dtype},
+            reason="dtype_mismatch",
+        )
+    expected = _broadcast((condition_shape, true_shape, false_shape), "where")
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        true_dtype,
+        expected,
+        "where",
+        ALL_DTYPES,
+    )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(true_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": true_dtype,
+        "input_dtypes": [condition_dtype, true_dtype, false_dtype],
+        "input_shapes": [list(condition_shape), list(true_shape), list(false_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": max(len(condition_shape), len(true_shape), len(false_shape)),
+        "min_dimension": _min_dimension((condition_shape, true_shape, false_shape)),
+        "attributes": {},
+        "precision": precision,
+    }
+
+
+def verify_compare(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``compare(left, right) -> bool`` with an explicit IEEE predicate."""
+
+    _check_attributes("compare", attributes, definition.attribute_names)
+    if len(input_types) != 2:
+        raise _arity_error("compare", 2, len(input_types))
+    try:
+        predicate = comparison_predicate_for_operation("compare", attributes, "compare")
+    except CpuScalarValidationError as exc:
+        raise OpContractError(
+            "compare requires a canonical predicate: {}".format(exc),
+            field="operation.attributes.predicate",
+            requested=dict(attributes),
+            available=["eq", "ne", "lt", "le", "gt", "ge"],
+            reason="predicate_missing_or_invalid",
+        ) from exc
+    left_dtype, left_shape = _require_tensor(input_types[0], "left", ALL_DTYPES)
+    right_dtype, right_shape = _require_tensor(input_types[1], "right", ALL_DTYPES)
+    if left_dtype != right_dtype:
+        raise OpContractError(
+            "compare inputs must share one dtype",
+            field="dtype",
+            requested={"left": left_dtype, "right": right_dtype},
+            reason="dtype_mismatch",
+        )
+    if left_dtype == "bool" and predicate not in ("eq", "ne"):
+        raise OpContractError(
+            "ordered comparison of bool values is unsupported",
+            field="operation.attributes.predicate",
+            requested=predicate,
+            available=["eq", "ne"],
+            reason="predicate_not_supported_for_bool",
+        )
+    expected = _broadcast((left_shape, right_shape), "compare")
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        "bool",
+        expected,
+        "compare",
+        ("bool",),
+    )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(left_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": left_dtype,
+        "input_dtypes": [left_dtype, right_dtype],
+        "input_shapes": [list(left_shape), list(right_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": max(len(left_shape), len(right_shape)),
+        "min_dimension": _min_dimension((left_shape, right_shape)),
+        "attributes": {"predicate": predicate},
+        "precision": precision,
+    }
+
+
+def verify_iota(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``iota``: exact signed integer sequence along one axis."""
+
+    _check_attributes("iota", attributes, definition.attribute_names)
+    if len(input_types) != 0:
+        raise _arity_error("iota", 0, len(input_types))
+    if declared_output_dtype is None or declared_output_shape is None:
+        raise OpContractError(
+            "iota requires an explicit output dtype and shape",
+            field="request.output",
+            requested={"output_dtype": declared_output_dtype, "output_shape": declared_output_shape},
+            available="dtype in {int32, int64} and a static rank 1..4 shape",
+            reason="output_required",
+        )
+    try:
+        output_dtype = canonical_dtype(str(declared_output_dtype))
+    except CpuScalarUnsupportedError as exc:
+        raise OpContractError(
+            "iota output dtype {!r} is outside the contract domain".format(declared_output_dtype),
+            field="dtype.output",
+            requested=declared_output_dtype,
+            available=["int32", "int64"],
+            reason="dtype_outside_contract_domain",
+        ) from exc
+    if output_dtype not in ("int32", "int64"):
+        raise OpContractError(
+            "iota output dtype {!r} is outside the contract domain".format(output_dtype),
+            field="dtype.output",
+            requested=output_dtype,
+            available=["int32", "int64"],
+            reason="dtype_outside_contract_domain",
+        )
+    output_shape = _static_shape_tuple(declared_output_shape, "output")
+    output_type = CoreType.tensor(output_dtype, output_shape)
+    try:
+        axis, start, step = iota_spec(output_type, attributes, "iota")
+    except CpuScalarUnsupportedError as exc:
+        raise OpContractError(
+            "iota is outside the portable contract: {}".format(exc),
+            field="iota",
+            requested=dict(attributes),
+            available={"output_dtype": ["int32", "int64"], "axis": "0<=axis<rank"},
+            reason="iota_not_portable",
+        ) from exc
+    except CpuScalarValidationError as exc:
+        raise OpContractError(
+            "iota attributes are invalid: {}".format(exc),
+            field="operation.attributes",
+            requested=dict(attributes),
+            available=["axis", "start", "step"],
+            reason="iota_attribute_invalid",
+        ) from exc
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(output_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": output_dtype,
+        "input_dtypes": [],
+        "input_shapes": [],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": len(output_shape),
+        "min_dimension": _min_dimension((output_shape,)),
+        "attributes": {"axis": axis, "start": start, "step": step},
+        "precision": precision,
+    }
+
+
+def verify_unary_math(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    """``exp``: elementwise float transcendental, shape preserving."""
+
+    _check_attributes("exp", attributes, definition.attribute_names)
+    if len(input_types) != 1:
+        raise _arity_error("exp", 1, len(input_types))
+    input_dtype, input_shape = _require_tensor(input_types[0], "input", FLOAT_DTYPE_TUPLE)
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        input_dtype,
+        input_shape,
+        "exp",
+        FLOAT_DTYPE_TUPLE,
+    )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(input_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": input_dtype,
+        "input_dtypes": [input_dtype],
+        "input_shapes": [list(input_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": len(input_shape),
+        "min_dimension": _min_dimension((input_shape,)),
+        "attributes": {},
+        "precision": precision,
+    }
+
