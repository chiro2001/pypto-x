+def test_bf16_bit_patterns_are_decoded_and_rounded_rne():
+    subnormal = struct.unpack("<f", struct.pack("<I", 0x0001 << 16))[0]
+    negative_inf = struct.unpack("<f", struct.pack("<I", 0xFF80 << 16))[0]
+    nan = struct.unpack("<f", struct.pack("<I", 0x7FC0 << 16))[0]
+    values = [subnormal, negative_inf, nan, -0.0, 1.0]
+    input_tensor = tensor("bf16", (len(values),), values)
+    _, output, _ = run_generic("exp", [input_tensor])
+    expected = _math_value("exp", flat(input_tensor), core_type("bf16", input_tensor.shape))
+    assert same_values(output, expected)
+    assert output.flat()[1] == 0.0
+    assert math.isnan(output.flat()[2])
+    # A cast to float32 preserves the exact decoded bf16 value.
+    _, cast_output, _ = run_generic("cast", [input_tensor], output_dtype="float32")
+    assert same_values(
+        cast_output,
+        _cast_value_for_operation(flat(input_tensor), core_type("float32", input_tensor.shape)),
+    )
+    # RNE boundary: 0x3F818000 rounds to 0x3F820000 (ties-to-even).
+    rne_value = struct.unpack("<f", struct.pack("<I", 0x3F818000))[0]
+    assert _cast_value_for_operation(rne_value, core_type("bf16", ())) == struct.unpack(
+        "<f", struct.pack("<I", 0x3F820000)
+    )[0]
