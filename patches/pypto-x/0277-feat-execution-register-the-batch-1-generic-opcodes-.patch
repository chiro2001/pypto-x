+def test_require_proven_deviation_bound_fails_closed_for_float_paths():
+    strict = ExecutionPolicy(numeric=NumericPolicy(require_proven_deviation_bound=True))
+    float_cases = (
+        ("exp", [tensor("float32", (2,), [1.0, 2.0])], {}, {}),
+        ("reduce_sum", [tensor("bf16", (2, 2), [1.0, 2.0, 3.0, 4.0])], {}, {}),
+        ("where", [tensor("bool", (2,), [True, False]), tensor("float32", (2,), [1.0, 2.0]), tensor("float32", (2,), [3.0, 4.0])], {}, {}),
+        ("cast", [tensor("int32", (2,), [1, 2])], {}, {"output_dtype": "float32"}),
+    )
+    for opcode, tensors, attributes, kwargs in float_cases:
+        with pytest.raises(NumericGuaranteeUnmetError) as info:
+            plan_generic(opcode, tensors, attributes, policy=strict, **kwargs)
+        assert info.value.reason == "proven_deviation_bound_unavailable"
+        assert info.value.field == "numeric.require_proven_deviation_bound"
+    exact_cases = (
+        ("iota", [], {}, {"dtype": "int32", "output_shape": (4,)}),
+        ("compare", [tensor("int16", (2,), [1, 2]), tensor("int16", (2,), [2, 1])], {"predicate": "lt"}, {}),
+        ("reduce_max", [tensor("int8", (2, 2), [1, 2, 3, 4])], {}, {}),
+        ("reshape", [tensor("float32", (2, 3), [1, 2, 3, 4, 5, 6])], {}, {"output_shape": (6,)}),
+    )
+    for opcode, tensors, attributes, kwargs in exact_cases:
+        resolution = plan_generic(opcode, tensors, attributes, policy=strict, **kwargs)
+        assert resolution.plan.numeric_guarantee["precision"]["class"] == "exact"
