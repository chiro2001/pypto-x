+def resolve_operation(
+    policy: ExecutionPolicy,
+    capability: CapabilitySnapshot,
+    opcode: str,
+    input_shapes: Sequence[Sequence[int]],
+    input_dtypes: Sequence[str],
+    output_shape: Optional[Sequence[int]] = None,
+    output_dtype: Optional[str] = None,
+    attributes: Optional[Mapping[str, Any]] = None
+) -> ResolutionResult:
+    """Resolve one 0048-B generic operation request into an immutable plan.
+
+    The request is verified against the registered ``OpDefinition`` *before*
+    any provider is evaluated (unknown opcode/dtype/rank/attribute/broadcast
+    all fail closed with a structured ``OP_CONTRACT_INVALID``).  The plan is
+    assembled by the same resolver body as matmul/qmatmul, so provider
+    selection, tie-breaks, fallback, the layout decision and the numeric
+    guarantee stay one implementation.
+
+    ``output_shape``/``output_dtype`` are optional for the ops whose result is
+    contract-derived (where/compare/exp/reduce/cast/reshape); when supplied
+    they are cross-checked against the derived result instead of overriding
+    it.  ``iota`` requires both.  ``attributes`` are normalized by the
+    contract (defaults filled in, aliases resolved) and the normalized form is
+    frozen into the plan.
+    """
+
+    _require_resolution_inputs(policy, capability)
+    definition = get_op_definition(opcode)
+    if definition.verifier != "generic":
+        raise OpContractError(
+            "opcode {!r} is not a 0048-B generic contract; use the dedicated "
+            "matmul/qmatmul entry".format(definition.canonical_opcode),
+            field="opcode",
+            requested=definition.canonical_opcode,
+            available=sorted(
+                name for name in OP_DEFINITIONS
+                if OP_DEFINITIONS[name].verifier == "generic"
+            ),
+            reason="not_a_generic_contract",
+        )
+    if not isinstance(input_shapes, (list, tuple)):
+        raise OpContractError(
+            "input_shapes must be a sequence of shapes",
+            field="request.inputs",
+            requested=type(input_shapes).__name__,
+            reason="input_shapes_invalid",
+        )
+    if not isinstance(input_dtypes, (list, tuple)):
+        raise OpContractError(
+            "input_dtypes must be a sequence of dtype strings",
+            field="request.input_dtypes",
+            requested=type(input_dtypes).__name__,
+            reason="request_dtype_invalid",
+        )
+    if attributes is not None and not isinstance(attributes, Mapping):
+        raise OpContractError(
+            "attributes must be a mapping",
+            field="request.attributes",
+            requested=type(attributes).__name__,
+            reason="attributes_not_a_mapping",
+        )
+    shapes = tuple(_operation_shape_tuple(shape, "input_shape") for shape in input_shapes)
+    expected_arity = int(definition.arity if definition.arity is not None else 0)
+    if len(shapes) != expected_arity:
+        raise OpContractError(
+            "{} requires exactly {} input shape(s)".format(
+                definition.canonical_opcode, expected_arity
+            ),
+            field="request.inputs",
+            requested=len(shapes),
+            available=expected_arity,
+            reason="arity_mismatch",
+        )
+    if len(input_dtypes) != len(shapes):
+        raise OpContractError(
+            "input_dtypes must carry one dtype per input shape",
+            field="request.input_dtypes",
+            requested=len(input_dtypes),
+            available=len(shapes),
+            reason="arity_mismatch",
+        )
+    dtype_list = [_normalize_dtype(dtype) for dtype in input_dtypes]
+    input_types = tuple(
+        CoreType.tensor(dtype, shape) for dtype, shape in zip(dtype_list, shapes)
+    )
+    declared_shape = (
+        _operation_shape_tuple(output_shape, "output_shape")
+        if output_shape is not None
+        else None
+    )
+    declared_dtype = _normalize_dtype(output_dtype) if output_dtype is not None else None
+    if definition.canonical_opcode == "iota":
+        if declared_shape is None or declared_dtype is None:
+            raise OpContractError(
+                "iota requires an explicit output_shape and dtype",
+                field="request.output",
+                requested={"output_shape": output_shape, "output_dtype": output_dtype},
+                available="a static rank 1..4 output shape and an int32/int64 dtype",
+                reason="output_required",
