+def operation_provider_capability(
+    opcode: str,
+    available: bool = True,
+    reason: Optional[str] = None,
+    version: str = PORTABLE_PROVIDER_VERSION
+) -> ProviderCapability:
+    """Build the portable manifest for one generic (batch-1) contract request.
+
+    The entry advertises every registered contract (the portable trunk can
+    execute them all) and narrows the dtype/rank preconditions to the
+    requested opcode, so provider evaluation reports an honest rejection for
+    a request outside that opcode's domain instead of a blanket manifest
+    mismatch.  The manifest is request-scoped on purpose: the default probe
+    stays frozen (see :data:`FROZEN_PORTABLE_CONTRACTS`).
+    """
+
+    definition = get_op_definition(opcode)
+    if definition.verifier != "generic":
+        raise CapabilityUnavailableError(
+            "operation_provider_capability only covers generic batch-1 contracts",
+            field="opcode",
+            requested=opcode,
+            available=(
+                "compare",
+                "cast",
+                "exp",
+                "iota",
+                "reduce_max",
+                "reduce_sum",
+                "reshape",
+                "where",
+            ),
+            reason="not_a_generic_contract",
+        )
+    contracts = {name: get_op_definition(name).contract_digest for name in registered_opcodes()}
+    domains = set()
+    for spec in definition.inputs:
+        domains.update(spec.dtypes)
+    if not domains:
+        for spec in definition.outputs:
+            domains.update(spec.dtypes)
+    rank_min = min((spec.rank_min for spec in definition.inputs), default=definition.outputs[0].rank_min)
+    rank_max = max((spec.rank_max for spec in definition.inputs), default=definition.outputs[0].rank_max)
+    return ProviderCapability(
+        provider_id=PORTABLE_PROVIDER_ID,
+        version=version,
+        available=available,
+        target_kinds=("cpu",),
+        numeric_modes=("portable_bitwise", "deterministic"),
+        deterministic=True,
+        required_features=(),
+        contracts=contracts,
+        max_threads=PORTABLE_PROVIDER_MAX_THREADS,
+        workspace_bytes=0,
+        reason=reason,
+        implementation=portable_implementation(opcode, PORTABLE_IMPLEMENTATIONS["matmul"]),
         numeric_class="portable_bitwise",
-        dtypes=definition.inputs[0].dtypes,
+        dtypes=tuple(sorted(domains)),
         stride_class="contiguous_only",
-        rank_range=(2, 4),
-        reduction_order_id=definition.numeric_contract["reduction_order_id"],
+        rank_range=(int(rank_min), int(rank_max)),
+        reduction_order_id=str(definition.numeric_contract["reduction_order_id"]),
         artifact_kind=PORTABLE_ARTIFACT_KIND,
         pack={"strategy": "none", "included_in_timing": True},
         provider_artifact_digest=None,
@@ -186,6 +286,78 @@ def default_providers(kind: str) -> Tuple[ProviderCapability, ...]:
     )
 
 
+def _requires_operation_contract_view(opcode: Optional[str]) -> bool:
+    """True when the request needs the operation-scoped portable manifest."""
+
+    if not opcode:
+        return False
+    try:
+        definition = get_op_definition(opcode)
+    except Exception:  # noqa: BLE001 - unknown opcodes fail closed elsewhere
+        return False
+    return definition.verifier == "generic"
+
+
+def default_providers_for_operation(kind: str, opcode: Optional[str]) -> Tuple[ProviderCapability, ...]:
+    """Default provider set for one request.
+
+    For the frozen matmul/qmatmul opcodes (or ``opcode=None``) this is exactly
+    :func:`default_providers`.  For a 0048-B generic opcode the portable entry
+    is replaced by the operation-scoped view so the request can select the
+    portable trunk without disturbing the frozen default manifest digest.
+    """
+
+    entries = default_providers(kind)
+    if not _requires_operation_contract_view(opcode):
+        return entries
+    portable = next(
+        (entry for entry in entries if entry.provider_id == PORTABLE_PROVIDER_ID), None
+    )
+    if portable is None:
+        return entries
+    scoped = operation_provider_capability(
+        str(opcode), available=portable.available, reason=portable.reason
+    )
+    return tuple(
+        scoped if entry.provider_id == PORTABLE_PROVIDER_ID else entry for entry in entries
+    )
+
+
+def with_operation_contracts(
+    snapshot: "CapabilitySnapshot", opcode: Optional[str]
+) -> "CapabilitySnapshot":
+    """Return ``snapshot`` with the portable entry widened for one generic op.
+
+    This is the request-scoped counterpart of
+    :func:`with_exact_blocked_provider`: unlike that 0047 helper it *replaces*
+    the portable entry (the manifest must advertise the requested contract and
+    the opcode's dtype/rank preconditions).  Non-cpu snapshots and non-generic
+    opcodes are returned unchanged, so default-resolution paths keep their
+    byte-identical snapshot digests.
+    """
+
+    if not isinstance(snapshot, CapabilitySnapshot):
+        return snapshot
+    if snapshot.kind != "cpu" or not _requires_operation_contract_view(opcode):
+        return snapshot
+    portable = snapshot.provider(PORTABLE_PROVIDER_ID)
+    if portable is None:
+        return snapshot
+    scoped = operation_provider_capability(
+        str(opcode), available=portable.available, reason=portable.reason
+    )
+    providers = tuple(
+        scoped if entry.provider_id == PORTABLE_PROVIDER_ID else entry
+        for entry in snapshot.providers
+    )
+    return CapabilitySnapshot.for_host(
+        kind=snapshot.kind,
+        triple=snapshot.triple,
+        features=snapshot.features,
+        providers=providers,
+    )
+
+
 # ---------------------------------------------------------------------------
 # 0047 opt-in exact-blocked provider admission
 # ---------------------------------------------------------------------------
