+def _verify_reduction(
+    definition: Any,
+    input_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    operation_name: str,
+    declared_output_dtype: Optional[str] = None,
+    declared_output_shape: Optional[Sequence[int]] = None
+) -> Mapping[str, Any]:
+    _check_attributes(operation_name, attributes, definition.attribute_names)
+    if len(input_types) != 1:
+        raise _arity_error(operation_name, 1, len(input_types))
+    if "axes" in attributes and not isinstance(attributes["axes"], (int, list, tuple)):
+        raise OpContractError(
+            "{} axes must be an integer or an ordered list/tuple of integers".format(operation_name),
+            field="operation.attributes.axes",
+            requested=type(attributes["axes"]).__name__,
+            reason="reduction_axis_invalid",
+        )
+    input_dtype, input_shape = _require_tensor(input_types[0], "input", REDUCTION_DTYPES)
+    try:
+        axes = _lowering_normalize_axes(attributes, len(input_shape), operation_name)
+    except CpuScalarValidationError as exc:
+        raise OpContractError(
+            "{} axes are invalid: {}".format(operation_name, exc),
+            field="operation.attributes.axes",
+            requested={key: attributes[key] for key in ("axes", "axis") if key in attributes},
+            reason="reduction_axis_invalid",
+        ) from exc
+    if "axes" in attributes and "axis" in attributes:
+        try:
+            other = _lowering_normalize_axes({"axis": attributes["axis"]}, len(input_shape), operation_name)
+        except CpuScalarValidationError as exc:
+            raise OpContractError(
+                "{} axis alias is invalid: {}".format(operation_name, exc),
+                field="operation.attributes.axis",
+                requested=attributes["axis"],
+                reason="reduction_axis_invalid",
+            ) from exc
+        if other != axes:
+            raise OpContractError(
+                "{} axes/axis spellings conflict".format(operation_name),
+                field="operation.attributes",
+                requested={"axes": attributes["axes"], "axis": attributes["axis"]},
+                available="equal normalized axes",
+                reason="conflicting_attribute_aliases",
+            )
+    if "keepdims" in attributes and not isinstance(attributes["keepdims"], bool):
+        raise OpContractError(
+            "{} keepdims must be a bool".format(operation_name),
+            field="operation.attributes.keepdims",
+            requested=attributes["keepdims"],
+            reason="keepdims_not_bool",
+        )
+    keepdims = bool(attributes.get("keepdims", False))
+    # ``reduced_shape`` is the lowering's own rule, so the contract shape and
+    # the reference executor can never disagree on non-empty reductions.
+    expected = reduced_shape(input_shape, {"axes": list(axes), "keepdims": keepdims}, operation_name)
+    output_dtype, output_shape = _declared_output(
+        declared_output_dtype,
+        declared_output_shape,
+        input_dtype,
+        expected,
+        operation_name,
+        REDUCTION_DTYPES,
+        rank_min=0,
+    )
+    if operation_name == "reduce_max" and any(input_shape[axis] == 0 for axis in axes):
+        raise OpContractError(
+            "reduce_max over an empty axis has no identity value",
+            field="shape.empty_reduction",
+            requested={"input_shape": list(input_shape), "axes": list(axes)},
+            available="all reduced axes of length >= 1, or reduce_sum for the additive identity 0",
+            reason="empty_reduction_has_no_identity",
+        )
+    precision = resolve_precision(
+        definition.precision,
+        input_dtypes=(input_dtype,),
+        output_dtype=output_dtype,
+    )
+    return {
+        "request_dtype": input_dtype,
+        "input_dtypes": [input_dtype],
+        "input_shapes": [list(input_shape)],
+        "output_dtype": output_dtype,
+        "output_shape": list(output_shape),
+        "rank": max(len(input_shape), len(output_shape)),
+        "min_dimension": _min_dimension((input_shape,)),
+        "attributes": {"axes": list(axes), "keepdims": keepdims},
+        "precision": precision,
+    }
+
+
+def verify_reduce_sum(
