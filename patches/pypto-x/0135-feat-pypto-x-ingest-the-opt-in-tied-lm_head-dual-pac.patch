+def test_w8a8_weight_quantizer_is_chunk_invariant_and_bit_exact():
+    import numpy as np
+
+    rng = np.random.default_rng(20260911)
+    shape = (37, 129)
+    values = rng.uniform(-2.0, 2.0, size=shape).astype(np.float32)
+    payload = values.tobytes()
+    whole = quantize_weight_per_output_channel(payload, dtype="float32", shape=shape, name="w")
+    for chunk_elements in (1, 17, 1024, 1 << 22):
+        part = quantize_weight_per_output_channel(
+            payload, dtype="float32", shape=shape, name="w", chunk_elements=chunk_elements
+        )
+        assert part.codes == whole.codes
+        assert part.scales == whole.scales
+        assert part.max_abs == whole.max_abs
+        assert part.scale_min == whole.scale_min and part.scale_max == whole.scale_max
+        assert part.saturation_count == whole.saturation_count
+
