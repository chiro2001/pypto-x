+def _w8a8_checkpoint(tmp_path, program, name="w8a8", extra_tensors=()):
+    path = Path(tmp_path) / "{}.safetensors".format(name)
+    write_safetensors(
+        path,
+        list(synthetic_checkpoint_tensors(program.metadata)) + list(extra_tensors),
+        payload_factory=finite_payload_for,
+    )
