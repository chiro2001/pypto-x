+def test_w8a8_real_parameter_ingestion_binds_int8_lm_head_and_fp32_scales(tmp_path):
+    """真实权重 ingestion 函数对 556 全开可执行：int8 codes + fp32 scale 都在内存中。"""
+
+    import hashlib
+
+    from pypto_x.qwen35_weighted_execution_driver import w8a8_real_parameters
+
+    program, schema = _w8a8_graph(scope="all", quantize_lm_head=True)
+    packed = build_packed_layout(schema)
+    path = _w8a8_checkpoint(tmp_path, program, "dual_bind")
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+        bindings, evidence = w8a8_real_parameters(schema, packed, mapping, reader)
+        assert len(bindings) == len(schema.parameters) + len(schema.quant_scales)
+        lm_head = bindings[LM_HEAD_PARAMETER]
+        assert lm_head.storage_id == LM_HEAD_STORAGE_ID
+        assert lm_head.dtype == "int8" and lm_head.nbytes == 32 * 8
+        scale = bindings[LM_HEAD_PARAMETER + "_scale"]
+        assert scale.storage_id == LM_HEAD_SCALE_STORAGE_ID
+        assert scale.dtype == "float32" and scale.nbytes == 32 * 4
+        assert evidence["weight_bytes_written_to_disk"] is False
+        assert evidence["quantized_parameters"] == 187
+        assert evidence["quant_scale_parameters"] == 187
+        manifest = {item["name"]: item for item in evidence["weight_scale_manifest"]}
+        view = reader.view(QWEN35_EMBED_TOKENS_TENSOR)
+        try:
+            source_bytes = view.tobytes()
+        finally:
+            view.release()
+        source_sha = hashlib.sha256(source_bytes).hexdigest()
+        # lm_head 的量化来源必须与 embedding 读到的 BF16 张量逐字节相同。
+        assert manifest[LM_HEAD_PARAMETER]["source_sha256"] == source_sha
+        expected = quantize_weight_per_output_channel(
+            source_bytes,
+            dtype="bf16",
+            shape=(32, 8),
+            name=LM_HEAD_PARAMETER,
+        )
+        assert manifest[LM_HEAD_PARAMETER]["codes_sha256"] == expected.codes_sha256
+        assert manifest[LM_HEAD_PARAMETER]["scales_sha256"] == expected.scales_sha256
+
