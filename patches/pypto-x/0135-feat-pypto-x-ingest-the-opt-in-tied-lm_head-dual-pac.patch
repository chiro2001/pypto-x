+def _w8a8_graph(scope="all", quantize_lm_head=True):
+    program = build_qwen35_text_decoder_graph(
+        1,
+        1,
+        shape_profile="synthetic_test",
+        precision="w8a8-linear",
+        quantized_linear_scope=scope,
+        quantize_lm_head=quantize_lm_head,
+    )
+    return program, build_binding_schema(program)
