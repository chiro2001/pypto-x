+def test_w8a8_dual_packing_fails_closed_on_missing_or_mismatched_shared_tensor(tmp_path):
+    program, schema = _w8a8_graph()
+    tensors = list(synthetic_checkpoint_tensors(program.metadata))
+    missing = [item for item in tensors if item[0] != QWEN35_EMBED_TOKENS_TENSOR]
+    path = Path(tmp_path) / "dual_missing.safetensors"
+    write_safetensors(path, missing)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        with pytest.raises(WeightMapMismatchError, match="missing tensor"):
+            build_weight_mapping(schema, program.metadata, reader)
+    broken = [
+        (name, dtype, (int(shape[0]) // 2, shape[1]) if name == QWEN35_EMBED_TOKENS_TENSOR else shape)
+        for name, dtype, shape in tensors
+    ]
+    path = Path(tmp_path) / "dual_broken.safetensors"
+    write_safetensors(path, broken)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        with pytest.raises(WeightMapMismatchError, match="shape"):
+            build_weight_mapping(schema, program.metadata, reader)
