+def test_w8a8_dual_packing_maps_tied_lm_head_to_shared_checkpoint_tensor(tmp_path):
+    program, schema = _w8a8_graph(scope="all", quantize_lm_head=True)
+    packed = build_packed_layout(schema)
+    assert len(packed.regions) == 556
+    path = _w8a8_checkpoint(tmp_path, program, "dual")
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+        assert mapping.parameter_count == 321
+        assert mapping.mapped_count == 321
+        assert mapping.unmapped == () and mapping.unexpected_checkpoint_tensors == ()
+        by_name = {item.parameter: item for item in mapping.mappings}
+        embedding = by_name["embedding_lm_head_shared_weight"]
+        lm_head = by_name[LM_HEAD_PARAMETER]
+        # 同一 checkpoint 张量、两个逻辑参数、两种物理 packing。
+        assert lm_head.source.official_name == QWEN35_EMBED_TOKENS_TENSOR
+        assert embedding.source.official_name == QWEN35_EMBED_TOKENS_TENSOR
+        assert lm_head.storage_id == LM_HEAD_STORAGE_ID
+        assert embedding.storage_id == "embedding_lm_head_shared_weight"
+        assert embedding.manifest_dtype == "bf16" and embedding.dtype_conforms
+        assert lm_head.manifest_dtype == "int8" and not lm_head.dtype_conforms
+        assert mapping.tied.fallback_used is True and mapping.tied.lm_head_present is False
+        assert mapping.shared_source_claims() == {
+            QWEN35_EMBED_TOKENS_TENSOR: (
+                "embedding_lm_head_shared_weight",
+                LM_HEAD_PARAMETER,
+            )
+        }
+        totals = mapping.totals
+        assert totals["text_tensor_count"] == 321
+        assert totals["distinct_text_tensor_count"] == 320
+        assert totals["shared_source_tensor_count"] == 1
+        assert totals["shared_source_overcount_bytes"] == embedding.source.nbytes
+        assert totals["conversion_tensor_count"] == 187
+        # 守恒：物理 checkpoint 字节按唯一张量计数一次。
+        assert totals["checkpoint_text_bytes"] == (
+            totals["manifest_parameter_bytes"]
+            + totals["conversion_reclaim_bytes"]
+            - totals["shared_source_overcount_bytes"]
+        )
+        assert totals["shared_source_tensors"] == [
+            {
+                "tensor": QWEN35_EMBED_TOKENS_TENSOR,
+                "parameters": ["embedding_lm_head_shared_weight", LM_HEAD_PARAMETER],
+                "nbytes": embedding.source.nbytes,
+            }
+        ]
+        layout = build_weight_layout(schema, mapping, reader)
+        payload = layout.to_dict()
+        assert payload["region_count"] == 556
+        assert payload["parameter_region_count"] == 321
+        assert payload["quantized_region_count"] == 187
+        assert payload["quant_scale_region_count"] == 187
+        assert len(layout.parameter_regions) == 321
+        assert len(layout.state_regions) == 48
+        assert layout.source_text_bytes == totals["checkpoint_text_bytes"]
+        assert payload["shared_source_tensors"] == [
+            {
+                "tensor": QWEN35_EMBED_TOKENS_TENSOR,
+                "storage_ids": ["embedding_lm_head_shared_weight", LM_HEAD_STORAGE_ID],
+                "nbytes": embedding.source.nbytes,
+            }
+        ]
+        region = layout.region_for(LM_HEAD_PARAMETER)
+        assert region.role == "quant_weight" and region.quantized is True
+        assert region.dtype == "int8" and region.nbytes * 2 == region.source_nbytes
+        assert region.source_name == QWEN35_EMBED_TOKENS_TENSOR
+        assert region.requires_dtype_conversion is False
+        scale_region = layout.region_for(LM_HEAD_PARAMETER + "_scale")
+        assert scale_region.role == "quant_scale"
+        assert scale_region.derived_from == LM_HEAD_STORAGE_ID
+        assert scale_region.source_name is None
+        assert scale_region.dtype == "float32"
+        # int8 region 不能走字节 cast；精度审计必须走 C1 量化 golden。
+        with pytest.raises(WeightLayoutError, match="W8A8 int8"):
+            convert_region_bytes(reader, region)
+        with pytest.raises(WeightLayoutError, match="W8A8 int8"):
+            audit_precision_boundary(reader, layout)
+
