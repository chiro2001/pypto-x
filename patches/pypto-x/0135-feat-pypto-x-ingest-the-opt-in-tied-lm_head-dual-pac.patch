+#: 流式量化的行块元素预算。4M 元素把 fp64 中间量峰值限制在 ~32 MiB/份，
+#: 与 K 无关；逐行语义与 C1 golden 完全一致（每行互相独立），因此分块不改变
+#: 任何 codes/scales 位模式。tied lm_head（248320×1024）不能再按整张量做
+#: fp64 中间量：那是 2 GiB/份的量级。
+_QUANTIZE_CHUNK_ELEMENTS = 1 << 22
+
+_SUPPORTED_SOURCE_DTYPES = ("bfloat16", "bf16", "float32", "f32", "float16", "f16")
+
+
+def _decode_row_block(
+    source_bytes: bytes, dtype: str, row_start: int, row_stop: int, columns: int
+) -> Any:
+    """把 ``[row_start, row_stop)`` 行解码成 float32 的 2-D 块。"""
+
+    np = _require_numpy()
+    count = (row_stop - row_start) * columns
+    if dtype in ("bfloat16", "bf16"):
+        raw = np.frombuffer(source_bytes, dtype=np.uint16, count=count, offset=row_start * columns * 2)
+        values = (raw.astype(np.uint32) << 16).view(np.float32)
+    elif dtype in ("float32", "f32"):
+        values = np.frombuffer(
+            source_bytes, dtype="<f4", count=count, offset=row_start * columns * 4
+        ).astype(np.float32, copy=False)
+    elif dtype in ("float16", "f16"):
+        values = np.frombuffer(
+            source_bytes, dtype="<f2", count=count, offset=row_start * columns * 2
+        ).astype(np.float32)
+    else:  # pragma: no cover - guarded by quantize_weight_per_output_channel
+        raise W8A8WeightQuantizationError("unsupported weight source dtype {!r}".format(dtype))
+    return values.reshape(row_stop - row_start, columns)
+
