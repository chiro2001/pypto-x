From 0de7f15d4a9b8a68804667cbafe4ae930b772dc9 Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:52:37 +0800
Subject: [PATCH 169/256] probe(axis-b-a3-runtime): add A3 read-only recon
 script

---
 scripts/a3_axis_b_runtime/00_a3_recon.sh | 78 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/scripts/a3_axis_b_runtime/00_a3_recon.sh b/scripts/a3_axis_b_runtime/00_a3_recon.sh
new file mode 100755
index 000000000..55b7a704e
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/00_a3_recon.sh
@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+# axis-b-a3-runtime 00: read-only recon on A3 (aarch64 Kunpeng 920B).
+# Discipline: host CPUs 600-639 only, chip7/NPU untouched (ASCEND_RT_VISIBLE_DEVICES
+# cleared), writes only under ~/pypto-x-a3/axis-b-a3-runtime/**.
+# NOTE: A3 wall clock is ~366 s slow (lock: a3_clock_minus_approx_366s); every
+# timestamp below is A3-source and must be labelled as such.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+LOGS="$RUN/logs"
+RAW="$RUN/raw"
+ENV_AXISB="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb"
+ENV_BASE="$HOME/pypto-x-a3/envs/pypto-x-c8"
+WHEEL="$HOME/pypto-x-a3/c8axisb/wheel/vllm_cpu-0.29.0-cp38-abi3-manylinux_2_28_aarch64.whl"
+CPUS="${AXISB_CPUS:-600-639}"
+
+mkdir -p "$LOGS" "$RAW"
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+
+echo "### 00_a3_recon A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "--- identity ---"
+hostname
+uname -a
+echo "a3_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "a3_epoch_s=$(date +%s)"
+echo "uptime_s=$(cut -d' ' -f1 /proc/uptime)"
+echo "cpus_allowed_self=$(grep Cpus_allowed_list /proc/self/status | cut -d: -f2 | tr -d ' ')"
+echo "taskset_used=$CPUS"
+echo "--- cpu topology ---"
+lscpu 2>/dev/null | grep -iE 'Architecture|Byte Order|CPU\(s\)|On-line|Model name|Thread|Core|Socket|NUMA node\(s\)|NUMA node[0-9]' | head -20
+echo "sve_default_vector_length=$(cat /proc/sys/abi/sve_default_vector_length 2>/dev/null || echo n/a)"
+echo "--- load / memory / disk ---"
+cat /proc/loadavg
+grep -E 'MemTotal|MemAvailable' /proc/meminfo
+df -h "$HOME" | tail -2
+du -sh "$HOME/pypto-x-a3" 2>/dev/null
+echo "--- top cpu consumers (do not touch) ---"
+ps -eo pid,psr,user,comm,%cpu,%mem,etime --sort=-%cpu | head -15
+echo "--- our envs ---"
+for p in "$ENV_AXISB/bin/python" "$ENV_BASE/bin/python"; do
+    if [[ -x "$p" ]]; then
+        echo "== $p"
+        "$p" -VV 2>&1
+        taskset -c "$CPUS" "$p" -c 'import torch, transformers, sys; print("sys.prefix", sys.prefix); print("torch", torch.__version__, "cuda_available", torch.cuda.is_available()); print("transformers", transformers.__version__)' 2>&1 | tail -5
+        echo "-- pip list (top 60) --"
+        "$p" -m pip list 2>/dev/null | head -60
+    else
+        echo "MISSING $p"
+    fi
+done
+echo "--- vllm wheel ---"
+ls -la "$WHEEL" 2>/dev/null || echo "wheel missing"
+if [[ -f "$WHEEL" ]]; then
+    "$ENV_BASE/bin/python" - "$WHEEL" > "$RAW/00_wheel_metadata_requires.txt" <<'PY'
+import sys, zipfile
+wheel = sys.argv[1]
+with zipfile.ZipFile(wheel) as z:
+    meta = [n for n in z.namelist() if n.endswith('.dist-info/METADATA')][0]
+    print("METADATA:", meta)
+    for line in z.read(meta).decode('utf-8', 'replace').splitlines():
+        if line.startswith(('Requires-Dist:', 'Requires-Python:', 'Name:', 'Version:', 'Provides-Extra:')):
+            print(line)
+PY
+    wc -l "$RAW/00_wheel_metadata_requires.txt"
+    grep -c '^Requires-Dist:' "$RAW/00_wheel_metadata_requires.txt" || true
+    echo "-- deps mentioning torch/pydantic/attrs/aiohttp/typing --"
+    grep -iE 'torch|pydantic|attrs|aiohttp|typing' "$RAW/00_wheel_metadata_requires.txt"
+fi
+echo "--- torch wheel availability for aarch64 (metadata only, no download) ---"
+taskset -c "$CPUS" timeout 120 "$ENV_BASE/bin/python" -m pip index versions torch \
+    --platform manylinux_2_28_aarch64 --python-version 3.12 --implementation cp --abi cp312 2>&1 | tail -4
+taskset -c "$CPUS" timeout 120 "$ENV_BASE/bin/python" -m pip index versions torch 2>&1 | tail -4
+echo "--- default index config ---"
+"$ENV_BASE/bin/python" -m pip config list 2>&1 | head -10
+echo "### done A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
