index 000000000..98b3bcc8b
--- /dev/null
+++ b/python/pypto/execution/binding_verify.py
@@ -0,0 +1,525 @@
+"""Content-local reconciliation of frozen plan/report declarations.
+
+U2a verification found that a caller willing to recompute the enclosing plan
+digest could change declaration fields (artifact kind/library/pack, numeric
+guarantee, fallback primary, policy digest, thread mode) and still execute,
+with the forged declaration either silently replaced in the report or copied
+into it.
+
+This module provides the ground-truth checks that do **not** need a live
+capability snapshot:
+
+* recompute the policy digest from the frozen ``policy.requested`` document;
+* reconcile ``selected.threads/thread_mode/scope`` with ``policy.resolved``;
+* reconcile ``numeric_guarantee.*`` with the frozen ``selected`` record;
+* reconcile ``artifact.*`` with ``selected``/``contract`` and the
+  portable/vendor family conventions;
+* reconcile ``fallback.primary`` with the frozen ``provider.select`` rule;
+* for reports, the same checks plus cross-block checks (``request.
+  policy_digest`` vs ``requested_policy``, ``artifact.*`` vs ``resolved.*``,
+  ``guarantees.numeric_class`` vs ``resolved.numeric_class``, and
+  ``fallback_used`` vs the invoked/primary providers).
+
+The execution layer additionally re-runs the resolver against the real
+capability snapshot (see :func:`pypto.execution.entry._verify_plan_binding`),
+which is the ground truth for fields only the provider manifest can settle
+(library fingerprint, pack strategy, thread default).  Fields the report
+cannot objectively validate on its own are registered as boundaries in
+``_meta/pypto-x/view-mode-require/brief.zh-CN.md``.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.compiler.targets.cpu import ARTIFACT_PAYLOAD_VERSION
+from pypto.lowering.cpu import LOWERING_VERSION
+
+from .manifest import PORTABLE_ARTIFACT_KIND
+from .policy import policy_from_dict
+from .provider_ids import KNOWN_PROVIDER_IDS, PORTABLE_PROVIDER_ID
+
+VENDOR_ARTIFACT_KIND = "vendor_library"
+PORTABLE_PACK_STRATEGY = "none"
+PORTABLE_EXACTNESS_BASIS = "contract_and_order"
+VENDOR_EXACTNESS_BASIS = "provider_version_threads_and_order"
+
+
+def _portable_provider_constants() -> Tuple[int, str]:
+    """Return the portable runner/numeric constants without an import cycle.
+
+    ``providers`` imports ``capability`` which imports ``provider_aocl`` which
+    imports ``plan``; a module-level import here would close that cycle.  The
+    constants are leaf values, so they are fetched on first use instead.
+    """
+
+    from .providers import PORTABLE_NUMERIC_CLASS, PORTABLE_RUNNER_VERSION
+
+    return PORTABLE_RUNNER_VERSION, PORTABLE_NUMERIC_CLASS
+
+
+def _error(field: str, reason: str, requested: Any = None, available: Any = None) -> Mapping[str, Any]:
+    return {"field": field, "reason": reason, "requested": requested, "available": available}
+
+
+def _policy_from_payload(document: Any, field: str) -> Tuple[Optional[Any], Sequence[Mapping[str, Any]]]:
+    if not isinstance(document, Mapping):
+        return None, (
+            _error(field, "policy_document_missing_or_not_a_mapping", requested=type(document).__name__),
+        )
+    try:
+        return policy_from_dict(document), ()
+    except Exception as exc:  # noqa: BLE001 - any policy failure is a refusal
+        return None, (
+            _error(
+                field,
+                "policy_document_invalid:{}".format(getattr(exc, "reason", None) or exc),
+            ),
+        )
+
+
+def _provider_select_rule(rules: Any) -> Optional[Mapping[str, Any]]:
+    if not isinstance(rules, list):
+        return None
+    matching = [
+        rule
+        for rule in rules
+        if isinstance(rule, Mapping) and rule.get("rule") == "provider.select"
+    ]
+    if len(matching) != 1:
+        return None
+    return matching[0]
+
+
+def _mapping_copy(value: Any) -> Mapping[str, Any]:
+    return dict(value) if isinstance(value, Mapping) else {}
+
+
+def plan_binding_errors(payload: Mapping[str, Any]) -> Tuple[Mapping[str, Any], ...]:
+    """Reconcile a frozen plan payload with its own ground-truth documents."""
+
+    errors = []
+    request = payload.get("request")
+    request = request if isinstance(request, Mapping) else {}
+    policy_document = {}
+    policy_envelope = payload.get("policy")
+    if isinstance(policy_envelope, Mapping) and isinstance(policy_envelope.get("requested"), Mapping):
+        policy_document = policy_envelope["requested"]
+
+    policy, policy_errors = _policy_from_payload(policy_document, "request.policy_digest")
+    errors.extend(policy_errors)
+    if policy is not None and request.get("policy_digest") != policy.digest:
+        errors.append(
+            _error(
+                "request.policy_digest",
+                "plan_policy_digest_mismatch",
+                requested=request.get("policy_digest"),
+                available=policy.digest,
+            )
+        )
+
+    selected = payload.get("selected")
+    selected = selected if isinstance(selected, Mapping) else {}
+    numeric = payload.get("numeric_guarantee")
+    numeric = numeric if isinstance(numeric, Mapping) else {}
+    artifact = payload.get("artifact")
+    artifact = artifact if isinstance(artifact, Mapping) else {}
+    contract = payload.get("contract")
+    contract = contract if isinstance(contract, Mapping) else {}
+    resolved_policy = policy_envelope.get("resolved") if isinstance(policy_envelope, Mapping) else None
+    resolved_policy = resolved_policy if isinstance(resolved_policy, Mapping) else {}
+
+    # selected record vs the resolved policy facts.
+    resolved_resources = resolved_policy.get("resources")
+    resolved_resources = resolved_resources if isinstance(resolved_resources, Mapping) else {}
+    if selected.get("threads") != resolved_resources.get("resolved_threads"):
+        errors.append(
+            _error(
+                "selected.threads",
+                "plan_threads_not_reconciled",
+                requested=selected.get("threads"),
+                available=resolved_resources.get("resolved_threads"),
+            )
+        )
+    if selected.get("thread_mode") != resolved_resources.get("resolved_thread_mode"):
+        errors.append(
+            _error(
+                "selected.thread_mode",
+                # The U2a runtime uses this reason for a mode inconsistent with
+                # the frozen resolved mode; keep the same machine-readable
+                # reason so the refusal surface does not fork by layer.
+                "thread_mode_runtime_mismatch",
+                requested=selected.get("thread_mode"),
+                available=resolved_resources.get("resolved_thread_mode"),
+            )
+        )
+
+    # numeric guarantee vs selected record.
+    if numeric.get("class") != selected.get("numeric_class"):
+        errors.append(
+            _error(
+                "selected.numeric_class",
+                "plan_selected_field_not_reconciled_with_provider_manifest",
+                requested=selected.get("numeric_class"),
+                available=numeric.get("class"),
+            )
+        )
+    if bool(numeric.get("deterministic")) != bool(selected.get("deterministic")):
+        errors.append(
+            _error(
+                "numeric_guarantee.deterministic",
+                "plan_numeric_guarantee_not_reconciled",
+                requested=numeric.get("deterministic"),
+                available=selected.get("deterministic"),
+            )
+        )
+    if numeric.get("reduction_order") != selected.get("reduction_order"):
+        errors.append(
+            _error(
+                "numeric_guarantee.reduction_order",
+                "plan_numeric_guarantee_not_reconciled",
+                requested=numeric.get("reduction_order"),
+                available=selected.get("reduction_order"),
+            )
+        )
+
+    # artifact vs selected/contract and provider family.
+    if artifact.get("contract_version") != contract.get("version"):
+        errors.append(
+            _error(
+                "artifact.contract_version",
+                "artifact_declaration_mismatch",
+                requested=artifact.get("contract_version"),
+                available=contract.get("version"),
+            )
+        )
+    if artifact.get("provider_version") != selected.get("provider_version"):
+        errors.append(
+            _error(
+                "selected.provider_version",
+                "plan_selected_field_not_reconciled_with_provider_manifest",
+                requested=selected.get("provider_version"),
+                available=artifact.get("provider_version"),
+            )
+        )
+    if _mapping_copy(artifact.get("library")) != _mapping_copy(selected.get("library")):
+        errors.append(
+            _error(
+                "artifact.library",
+                "plan_artifact_library_not_reconciled",
+                requested=_mapping_copy(artifact.get("library")),
+                available=_mapping_copy(selected.get("library")),
+            )
+        )
+    pack = artifact.get("pack")
+    pack = pack if isinstance(pack, Mapping) else {}
+    if not isinstance(pack.get("strategy"), str) or not pack["strategy"].strip():
+        errors.append(
+            _error("artifact.pack.strategy", "plan_artifact_pack_strategy_invalid", requested=pack.get("strategy"))
+        )
+
+    provider_is_known = selected.get("provider") in KNOWN_PROVIDER_IDS
+    if not provider_is_known:
+        # Unknown provider ids have no family ground truth here; the provider
+        # registry rejects them at execution with PROVIDER_UNAVAILABLE, so the
+        # artifact-family checks must not preempt that structured reason.
+        pass
+    elif selected.get("provider") == PORTABLE_PROVIDER_ID:
+        portable_runner_version, portable_numeric_class = _portable_provider_constants()
+        if artifact.get("kind") != PORTABLE_ARTIFACT_KIND:
+            errors.append(
+                _error(
+                    "artifact.kind",
+                    "plan_artifact_kind_not_reconciled",
+                    requested=artifact.get("kind"),
+                    available=PORTABLE_ARTIFACT_KIND,
+                )
+            )
+        if artifact.get("lowering_version") != LOWERING_VERSION:
+            errors.append(
+                _error(
+                    "artifact.lowering_version",
+                    "artifact_declaration_mismatch",
+                    requested=artifact.get("lowering_version"),
+                    available=LOWERING_VERSION,
+                )
+            )
+        if artifact.get("runner_version") != portable_runner_version:
+            errors.append(
+                _error(
+                    "artifact.runner_version",
+                    "artifact_declaration_mismatch",
+                    requested=artifact.get("runner_version"),
+                    available=portable_runner_version,
+                )
+            )
+        if artifact.get("wire_version") != ARTIFACT_PAYLOAD_VERSION:
+            errors.append(
+                _error(
+                    "artifact.wire_version",
+                    "artifact_declaration_mismatch",
+                    requested=artifact.get("wire_version"),
+                    available=ARTIFACT_PAYLOAD_VERSION,
+                )
+            )
+        if _mapping_copy(artifact.get("library")):
+            errors.append(
+                _error("artifact.library", "plan_portable_library_must_be_empty", requested=artifact.get("library"))
+            )
+        if pack.get("strategy") != PORTABLE_PACK_STRATEGY:
+            errors.append(
+                _error(
+                    "artifact.pack.strategy",
+                    "plan_portable_pack_strategy_mismatch",
+                    requested=pack.get("strategy"),
+                    available=PORTABLE_PACK_STRATEGY,
+                )
+            )
+        if numeric.get("class") != portable_numeric_class:
+            errors.append(
+                _error(
+                    "numeric_guarantee.class",
+                    "plan_portable_numeric_class_mismatch",
+                    requested=numeric.get("class"),
+                    available=portable_numeric_class,
+                )
+            )
+        if numeric.get("exactness_basis") != PORTABLE_EXACTNESS_BASIS:
+            errors.append(
+                _error(
+                    "numeric_guarantee.exactness_basis",
+                    "plan_portable_exactness_basis_mismatch",
+                    requested=numeric.get("exactness_basis"),
+                    available=PORTABLE_EXACTNESS_BASIS,
+                )
+            )
+        if selected.get("thread_mode") != "single_thread":
+            errors.append(
+                _error(
+                    "selected.thread_mode",
+                    "plan_portable_thread_mode_mismatch",
+                    requested=selected.get("thread_mode"),
+                    available="single_thread",
+                )
+            )
+    else:
+        if artifact.get("kind") != VENDOR_ARTIFACT_KIND:
+            errors.append(
+                _error(
+                    "artifact.kind",
+                    "plan_artifact_kind_not_reconciled",
+                    requested=artifact.get("kind"),
+                    available=VENDOR_ARTIFACT_KIND,
+                )
+            )
+        if numeric.get("exactness_basis") != VENDOR_EXACTNESS_BASIS:
+            errors.append(
+                _error(
+                    "numeric_guarantee.exactness_basis",
+                    "plan_vendor_exactness_basis_mismatch",
+                    requested=numeric.get("exactness_basis"),
+                    available=VENDOR_EXACTNESS_BASIS,
+                )
+            )
+        if pack.get("strategy") == PORTABLE_PACK_STRATEGY or pack.get("strategy") == "unknown":
+            errors.append(
+                _error(
+                    "artifact.pack.strategy",
+                    "plan_vendor_pack_strategy_not_declared",
+                    requested=pack.get("strategy"),
+                    available="a provider-manifest pack strategy",
+                )
+            )
+
+    # fallback.primary vs the frozen provider.select rule.
+    resolution = payload.get("resolution")
+    resolution = resolution if isinstance(resolution, Mapping) else {}
+    select_rule = _provider_select_rule(resolution.get("rules"))
+    if select_rule is None:
+        errors.append(_error("resolution.rules", "plan_provider_select_rule_missing"))
+    else:
+        details = select_rule.get("details")
+        details = details if isinstance(details, Mapping) else {}
+        fallback = payload.get("fallback")
+        fallback = fallback if isinstance(fallback, Mapping) else {}
+        if details.get("primary") != fallback.get("primary"):
+            errors.append(
+                _error(
+                    "fallback.primary",
+                    "plan_fallback_primary_mismatch",
+                    requested=fallback.get("primary"),
+                    available=details.get("primary"),
+                )
+            )
+    return tuple(errors)
+
+
+def report_binding_errors(report: Mapping[str, Any]) -> Tuple[Mapping[str, Any], ...]:
+    """Cross-block reconciliation available from the report document alone."""
+
+    errors = []
+    request = report.get("request")
+    request = request if isinstance(request, Mapping) else {}
+    requested_policy = report.get("requested_policy")
+    requested_policy = requested_policy if isinstance(requested_policy, Mapping) else {}
+    policy, policy_errors = _policy_from_payload(requested_policy, "request.policy_digest")
+    errors.extend(policy_errors)
+    if policy is not None:
+        if request.get("policy_digest") != policy.digest:
+            errors.append(
+                _error(
+                    "request.policy_digest",
+                    "report_policy_digest_mismatch",
+                    requested=request.get("policy_digest"),
+                    available=policy.digest,
+                )
+            )
+        resolution = report.get("resolution")
+        resolution = resolution if isinstance(resolution, Mapping) else {}
+        if resolution.get("policy_digest") != policy.digest:
+            errors.append(
+                _error(
+                    "resolution.policy_digest",
+                    "report_resolution_policy_digest_mismatch",
+                    requested=resolution.get("policy_digest"),
+                    available=policy.digest,
+                )
+            )
+
+    resolution = report.get("resolution")
+    resolution = resolution if isinstance(resolution, Mapping) else {}
+    select_rule = _provider_select_rule(resolution.get("rules"))
+    if select_rule is None:
+        errors.append(_error("resolution.rules", "report_provider_select_rule_missing"))
+    else:
+        details = select_rule.get("details")
+        details = details if isinstance(details, Mapping) else {}
+        if details.get("primary") != resolution.get("fallback_primary"):
+            errors.append(
+                _error(
+                    "resolution.fallback_primary",
+                    "report_fallback_primary_mismatch",
+                    requested=resolution.get("fallback_primary"),
+                    available=details.get("primary"),
+                )
+            )
+
+    dispatch = report.get("dispatch")
+    dispatch = dispatch if isinstance(dispatch, Mapping) else {}
+    invoked = dispatch.get("provider_invoked")
+    primary = resolution.get("fallback_primary")
+    if bool(resolution.get("fallback_used")) != (invoked != primary):
+        errors.append(
+            _error(
+                "resolution.fallback_used",
+                "report_fallback_used_mismatch",
+                requested=resolution.get("fallback_used"),
+                available=(invoked != primary),
+            )
+        )
+
+    resolved = report.get("resolved")
+    resolved = resolved if isinstance(resolved, Mapping) else {}
+    artifact = report.get("artifact")
+    artifact = artifact if isinstance(artifact, Mapping) else {}
+    guarantees = report.get("guarantees")
+    guarantees = guarantees if isinstance(guarantees, Mapping) else {}
+    provider = resolved.get("provider")
+
+    if artifact.get("provider_version") != resolved.get("provider_version"):
+        errors.append(
+            _error(
+                "artifact.provider_version",
+                "report_artifact_provider_version_mismatch",
+                requested=artifact.get("provider_version"),
+                available=resolved.get("provider_version"),
+            )
+        )
+    if _mapping_copy(artifact.get("library")) != _mapping_copy(resolved.get("library")):
+        errors.append(
+            _error(
+                "artifact.library",
+                "report_artifact_library_not_reconciled",
+                requested=_mapping_copy(artifact.get("library")),
+                available=_mapping_copy(resolved.get("library")),
+            )
+        )
+    if guarantees.get("numeric_class") != resolved.get("numeric_class"):
+        errors.append(
+            _error(
+                "guarantees.numeric_class",
+                "report_numeric_class_not_reconciled",
+                requested=guarantees.get("numeric_class"),
+                available=resolved.get("numeric_class"),
+            )
+        )
+    if provider == PORTABLE_PROVIDER_ID:
+        if artifact.get("kind") != PORTABLE_ARTIFACT_KIND:
+            errors.append(
+                _error(
+                    "artifact.kind",
+                    "report_artifact_kind_not_reconciled",
+                    requested=artifact.get("kind"),
+                    available=PORTABLE_ARTIFACT_KIND,
+                )
+            )
+        if _mapping_copy(resolved.get("library")):
+            errors.append(
+                _error("resolved.library", "report_portable_library_must_be_empty", requested=resolved.get("library"))
+            )
+    else:
+        if artifact.get("kind") != VENDOR_ARTIFACT_KIND:
+            errors.append(
+                _error(
+                    "artifact.kind",
+                    "report_artifact_kind_not_reconciled",
+                    requested=artifact.get("kind"),
+                    available=VENDOR_ARTIFACT_KIND,
+                )
+            )
+        pack = artifact.get("pack")
+        pack = pack if isinstance(pack, Mapping) else {}
+        if pack.get("strategy") in (None, "", PORTABLE_PACK_STRATEGY, "unknown"):
+            errors.append(
+                _error(
+                    "artifact.pack.strategy",
+                    "report_vendor_pack_strategy_not_declared",
+                    requested=pack.get("strategy"),
+                    available="a provider-manifest pack strategy",
+                )
+            )
+    return tuple(errors)
+
+
+def payload_difference(
+    expected: Any, actual: Any, path: str = ""
+) -> Optional[Tuple[str, Any, Any]]:
+    """Return ``(path, expected_value, actual_value)`` for the first difference."""
+
+    if isinstance(expected, Mapping) and isinstance(actual, Mapping):
+        for key in sorted(set(expected) | set(actual)):
+            child = "{}.{}".format(path, key) if path else str(key)
+            if key not in expected or key not in actual:
+                return (child, expected.get(key), actual.get(key))
+            difference = payload_difference(expected[key], actual[key], child)
+            if difference is not None:
+                return difference
+        return None
+    if isinstance(expected, (list, tuple)) and isinstance(actual, (list, tuple)):
+        if len(expected) != len(actual):
+            return ("{}[len]".format(path), len(expected), len(actual))
+        for index, (left, right) in enumerate(zip(expected, actual)):
+            difference = payload_difference(left, right, "{}[{}]".format(path, index))
+            if difference is not None:
+                return difference
+        return None
+    if expected != actual:
+        return (path or "<root>", expected, actual)
+    return None
+
+
+__all__ = [
+    "plan_binding_errors",
+    "report_binding_errors",
+    "payload_difference",
+]
