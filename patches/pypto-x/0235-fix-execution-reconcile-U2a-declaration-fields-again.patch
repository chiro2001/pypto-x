+def _verify_plan_binding(plan: ExecutionPlan, capability: CapabilitySnapshot) -> None:
+    """Re-derive the whole canonical plan from a real capability snapshot.
+
+    ``ExecutionPlan.validate`` already reconciles every declaration field that
+    has ground truth inside the frozen documents.  This gate re-runs the
+    deterministic resolver for the frozen policy against the capability the
+    caller supplied (which was digest-checked against the plan), and refuses
+    any payload difference.  That is the ground truth for the fields only the
+    provider manifest can settle: library fingerprint, pack strategy, thread
+    default, provider implementation/version/numeric class.
+
+    ``execute_matmul_plan`` synthesizes the snapshot from the default local
+    provider probe when the caller does not supply one; that snapshot is still
+    digest-checked against the frozen plan, so the same canonical comparison
+    applies on every execution path.
+    """
+
+    payload = plan.payload
+    from .providers import registered_providers
+
+    if plan.selected_provider not in registered_providers():
+        raise ProviderUnavailableError(
+            "plan declares an unregistered provider {!r}".format(plan.selected_provider),
+            field="plan.selected.provider",
+            requested=plan.selected_provider,
+            available=sorted(registered_providers()),
+            reason="provider_not_registered",
+        )
+    policy_envelope = payload["policy"]
+    policy_document = policy_envelope["requested"]
+    try:
+        policy = policy_from_dict(policy_document)
+    except ExecutionError as exc:
+        raise ArtifactMismatchError(
+            "plan policy document cannot be rebuilt: {}".format(exc),
+            field="plan.policy.requested",
+            requested=policy_document,
+            available=None,
+            reason="plan_policy_document_invalid",
+            details={"execution_error": exc.to_dict()},
+        ) from exc
+    if policy.digest != plan.policy_digest:
+        raise ArtifactMismatchError(
+            "plan request.policy_digest does not match the frozen policy document",
+            field="plan.request.policy_digest",
+            requested=plan.policy_digest,
+            available=policy.digest,
+            reason="plan_policy_digest_mismatch",
+        )
+    try:
+        canonical = resolve_matmul(
+            policy,
+            capability,
+            plan.left_shape,
+            plan.right_shape,
+            plan.dtype,
+        )
+    except ExecutionError as exc:
+        raise ArtifactMismatchError(
+            "plan policy is not satisfiable against the supplied capability: {}".format(exc),
+            field="plan.policy.requested",
+            requested={"policy_digest": policy.digest, "capability_digest": capability.digest},
+            available=exc.available,
+            reason="plan_policy_not_satisfiable:{}".format(exc.reason or exc.code),
+            details={"execution_error": exc.to_dict()},
+        ) from exc
+    difference = payload_difference(canonical.plan.payload, payload)
+    if difference is None:
+        return
+    path, expected_value, actual_value = difference
+    # Keep the U2a machine-readable reason for the field family that differs,
+    # so the refusal surface does not fork by validation layer.
+    if path.startswith("selected."):
+        reason = "plan_selected_field_not_reconciled_with_provider_manifest"
+    elif path.startswith("artifact."):
+        reason = "artifact_declaration_mismatch"
+    else:
+        reason = "plan_declaration_mismatch"
+    raise ArtifactMismatchError(
+        "plan declaration differs from the canonical resolution at {}".format(path),
+        field="plan." + path,
+        requested=actual_value,
+        available=expected_value,
+        reason=reason,
+    )
+
