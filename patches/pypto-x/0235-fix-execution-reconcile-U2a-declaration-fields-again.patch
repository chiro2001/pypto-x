diff --git a/python/tests/ut/pypto_x/test_execution_binding_forgery.py b/python/tests/ut/pypto_x/test_execution_binding_forgery.py
new file mode 100644
index 000000000..4387b0417
--- /dev/null
+++ b/python/tests/ut/pypto_x/test_execution_binding_forgery.py
@@ -0,0 +1,225 @@
+"""U2a declaration-binding forgery regressions (the 10 accepted probe fields).
+
+The U2a verifier's ``v3_forgery_probe.py`` showed that a caller able to
+recompute the enclosing plan digest could change declaration fields
+(``artifact.kind``/``library.sha256``/``pack.strategy``,
+``selected.library.sha256``, ``numeric_guarantee.*``, ``fallback.primary``,
+``request.policy_digest``) and still execute, with the forged declaration
+either silently replaced or copied into the report.
+
+These tests convert each accepted probe case into a "must be rejected or
+explicitly exempted" regression:
+
+* content-local cases are refused by ``ExecutionPlan.validate`` (the same
+  entry as the alias-proof checks);
+* double-forgeries that keep the frozen documents self-consistent are refused
+  by ``execute_matmul_plan`` re-resolving the frozen policy against the
+  supplied capability snapshot (``plan_declaration_mismatch``) before any
+  provider invocation, so the output stays untouched;
+* the report copy is refused by ``validate_report_schema`` for every field
+  that has ground truth in another report block.
+
+The one probe case that is a no-op (``thread_mode env->api`` when the
+canonical mode already is ``api_pinned``) is asserted to be digest-identical
+and is documented as explicitly exempted, not as a hole.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+
+import pytest
+
+from pypto.execution import (
+    AOCL_DEFAULT_LIBRARY,
+    ARTIFACT_MISMATCH,
+    CapabilitySnapshot,
+    ExecutionPolicy,
+    FallbackPolicy,
+    NumericPolicy,
+    ProviderPolicy,
+    ResourcePolicy,
+    execute_matmul,
+    execute_matmul_plan,
+    host_features,
+    plan_matmul,
+    validate_report_schema,
+)
+from pypto.backends.cpu import HostTensor
+
+AOCL_PRESENT = os.path.isfile(AOCL_DEFAULT_LIBRARY)
+pytestmark = pytest.mark.skipif(not AOCL_PRESENT, reason="Q8 AOCL artifact is not present on this host")
+
+_SHAPE_A = (4, 32)
+_SHAPE_B = (32, 8)
+
+
+def _capability():
+    return CapabilitySnapshot.for_host(features=host_features())
+
+
+def _vendor_policy(dtype="float32"):
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads="auto"),
+    )
+
+
+def _vendor_plan(dtype="float32"):
+    capability = _capability()
+    return plan_matmul(_SHAPE_A, _SHAPE_B, dtype, _vendor_policy(dtype), capability=capability).plan, capability
+
+
+def _tensors(dtype):
+    left = HostTensor(dtype, _SHAPE_A, [float((index % 7) + 1) for index in range(_SHAPE_A[0] * _SHAPE_A[1])])
+    right = HostTensor(dtype, _SHAPE_B, [0.5] * (_SHAPE_B[0] * _SHAPE_B[1]))
+    return left, right
+
+
+def _assert_rejected_or_exempted(mutate, dtype="float32", expected_reason=None):
+    """Tamper one declaration, recompute the plan digest, then try to execute."""
+
+    plan, capability = _vendor_plan(dtype)
+    payload = plan.payload
+    mutate(payload)
+    forged = type(plan)(payload)
+    output = HostTensor(dtype, (4, 8), [31.0] * 32)
+    left, right = _tensors(dtype)
+    try:
+        forged.validate()
+    except Exception as exc:
+        assert getattr(exc, "code", None) == ARTIFACT_MISMATCH
+        if expected_reason is not None:
+            assert exc.reason == expected_reason, exc.to_dict()
+        return {"layer": "plan.validate", "reason": exc.reason}
+    # The forged plan is self-consistent enough to reach execution; it must be
+    # refused before the provider runs.
+    with pytest.raises(Exception) as excinfo:
+        execute_matmul_plan(forged, left, right, capability=capability, output=output)
+    error = excinfo.value
+    assert getattr(error, "code", None) == ARTIFACT_MISMATCH, error.to_dict()
+    assert output.flat() == tuple([31.0] * 32)
+    if expected_reason is not None:
+        assert error.reason == expected_reason, error.to_dict()
+    return {"layer": "execute_matmul_plan", "reason": error.reason}
+
+
+def test_u2a_probe_accepted_fields_are_all_refused_or_exempted():
+    cases = (
+        ("artifact.kind", lambda p: p["artifact"].update(kind="core_ir_artifact"), "plan_artifact_kind_not_reconciled"),
+        (
+            "artifact.library.sha256",
+            lambda p: p["artifact"]["library"].update(sha256="deadbeef"),
+            "plan_artifact_library_not_reconciled",
+        ),
+        (
+            "artifact.pack.strategy",
+            lambda p: p["artifact"]["pack"].update(strategy="none"),
+            "plan_vendor_pack_strategy_not_declared",
+        ),
+        ("fallback.primary", lambda p: p["fallback"].update(primary="portable"), "plan_fallback_primary_mismatch"),
+        (
+            "numeric_guarantee.class",
+            lambda p: p["numeric_guarantee"].update({"class": "portable_bitwise"}),
+            "plan_selected_field_not_reconciled_with_provider_manifest",
+        ),
+        (
+            "numeric_guarantee.deterministic",
+            lambda p: p["numeric_guarantee"].update(deterministic=False),
+            "plan_numeric_guarantee_not_reconciled",
+        ),
+        (
+            "numeric_guarantee.reduction_order",
+            lambda p: p["numeric_guarantee"].update(reduction_order="forged_order_v1"),
+            "plan_numeric_guarantee_not_reconciled",
+        ),
+        (
+            "request.policy_digest",
+            lambda p: p["request"].update(policy_digest="sha256:" + "0" * 64),
+            "plan_policy_digest_mismatch",
+        ),
+        (
+            "selected.library.sha256",
+            lambda p: p["selected"]["library"].update(sha256="deadbeef"),
+            "plan_artifact_library_not_reconciled",
+        ),
+    )
+    for name, mutate, reason in cases:
+        outcome = _assert_rejected_or_exempted(mutate, expected_reason=reason)
+        assert outcome["layer"] in ("plan.validate", "execute_matmul_plan"), (name, outcome)
+
+    # 10th probe case: env->api is either a no-op (canonical mode is already
+    # api_pinned) or a real declaration change, which must be refused.
+    plan, _capability_snapshot = _vendor_plan("float32")
+    payload = plan.payload
+    payload["selected"] = dict(payload["selected"], thread_mode="api_pinned")
+    forged = type(plan)(payload)
+    if forged.digest == plan.digest:
+        # Explicit exemption: the mutation did not change the declaration.
+        assert forged.payload["selected"]["thread_mode"] == plan.payload["selected"]["thread_mode"]
+    else:
+        with pytest.raises(Exception) as excinfo:
+            forged.validate()
+        assert getattr(excinfo.value, "code", None) == ARTIFACT_MISMATCH
+        assert excinfo.value.reason == "thread_mode_runtime_mismatch"
+
+
+def test_u2a_double_forgery_library_identity_is_refused_before_provider():
+    """Forge both copies of a manifest-only fact and recompute every digest."""
+
+    plan, capability = _vendor_plan("float32")
+    payload = plan.payload
+    payload["artifact"]["library"]["sha256"] = "deadbeef"
+    payload["selected"]["library"]["sha256"] = "deadbeef"
+    forged = type(plan)(payload)
+    left, right = _tensors("float32")
+    output = HostTensor("float32", (4, 8), [31.0] * 32)
+    with pytest.raises(Exception) as excinfo:
+        execute_matmul_plan(forged, left, right, capability=capability, output=output)
+    error = excinfo.value
+    assert getattr(error, "code", None) == ARTIFACT_MISMATCH
+    # The canonical re-resolution compares the manifest library fingerprint.
+    assert error.reason == "artifact_declaration_mismatch"
+    assert output.flat() == tuple([31.0] * 32)
+
+
+def _vendor_report():
+    capability = _capability()
+    policy = _vendor_policy("float32")
+    left, right = _tensors("float32")
+    _, report = execute_matmul(left, right, policy, capability=capability)
+    return json.loads(json.dumps(report.to_dict()))
+
+
+def test_u2a_report_single_field_forgeries_are_refused():
+    document = _vendor_report()
+    cases = (
+        lambda d: d["artifact"].update(kind="core_ir_artifact"),
+        lambda d: d["artifact"]["library"].update(sha256="deadbeef"),
+        lambda d: d["artifact"]["pack"].update(strategy="none"),
+        lambda d: d["resolution"].update(fallback_primary="portable"),
+        lambda d: d["guarantees"].update(numeric_class="portable_bitwise"),
+        lambda d: d["request"].update(policy_digest="sha256:" + "0" * 64),
+    )
+    for mutate in cases:
+        broken = copy.deepcopy(document)
+        mutate(broken)
+        with pytest.raises(Exception) as excinfo:
+            validate_report_schema(broken)
+        assert getattr(excinfo.value, "code", None) == "REPORT_SCHEMA_INVALID"
+
+
+def test_u2a_report_fallback_used_relationship_is_enforced():
+    document = _vendor_report()
+    broken = copy.deepcopy(document)
+    broken["resolution"]["fallback_used"] = not document["resolution"]["fallback_used"]
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(broken)
+    assert getattr(excinfo.value, "code", None) == "REPORT_SCHEMA_INVALID"
