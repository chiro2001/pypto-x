+@pytest.mark.parametrize(
+    "operation_name",
+    ("cast", "exp", "rsqrt", "sigmoid", "silu", "softplus", "reduce_mean", "broadcast", "where"),
+)
+def test_m1a_portable_operation_effects_are_pure(operation_name):
+    tensor_type = CoreType.tensor("DT_FP32", (2,))
+    result = FakeValue(1, tensor_type)
+    body = FakeBlock(
+        id=0,
+        args=(),
+        calls=[FakeCall(result, operation_name)],
+        result=result,
+        jump="RETURN",
+    )
+    program = BRIDGE.export_pil_function(FakeFunction(operation_name, body))
+    operation = program.functions[0].body.operations[0]
+    assert operation.name == operation_name
+    assert operation.effect is Effect.PURE
+
+
+def test_expand_clone_alias_exports_as_pure_broadcast():
+    input_type = CoreType.tensor("DT_FP32", (2, 1))
+    output_type = CoreType.tensor("DT_FP32", (2, 3))
+    parameter = FakeParameter("x", input_type, id=1)
+    loaded = FakeValue(2, input_type)
+    result = FakeValue(3, output_type)
+    body = FakeBlock(
+        id=0,
+        args=(),
+        calls=[
+            FakeCall(loaded, "pil.load", ("x",)),
+            FakeCall(result, _wrapped_expand_clone, (loaded, [2, 3])),
+        ],
+        result=result,
+        jump="RETURN",
+    )
+    program = BRIDGE.export_pil_function(FakeFunction("expand", body, parameters=(parameter,)))
+    broadcast = program.functions[0].body.operations[1]
+    assert broadcast.name == "broadcast"
+    assert broadcast.effect is Effect.PURE
+    assert broadcast.attributes["callee"] == "pypto.op.mutating.expand_clone"
+
