index 61036d510..dbe814fef 100644
--- a/python/pypto/backends/cpu/runtime.py
+++ b/python/pypto/backends/cpu/runtime.py
@@ -429,10 +429,15 @@ def _math_scalar(name: str, value: Any) -> Any:
 
     value = float(value)
     if name == "exp":
-        return math.exp(value)
+        try:
+            return math.exp(value)
+        except OverflowError:
+            return float("inf")
     if name == "rsqrt":
-        if value <= 0.0:
-            raise CpuScalarExecutionError("rsqrt input must be greater than zero")
+        if math.isnan(value) or value < 0.0:
+            return float("nan")
+        if value == 0.0:
+            return float("inf")
         return 1.0 / math.sqrt(value)
     if name == "sigmoid":
         # Avoid exp(-x) overflow for large negative x.
