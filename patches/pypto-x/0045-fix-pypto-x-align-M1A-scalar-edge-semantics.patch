+def test_exp_and_rsqrt_follow_float_edge_semantics():
+    exp_type = CoreType.tensor("float32", (1,))
+    exp_source = ValueRef("exp_source", exp_type)
+    exp_result = ValueRef("exp_result", exp_type)
+    exp_program = _program(
+        "exp_edge",
+        (exp_source,),
+        (exp_result,),
+        (Operation("exp", (exp_source,), (exp_result,)),),
+    )
+    exp_output = HostTensor.zeros("float32", (1,))
+    _run(exp_program, [HostTensor("float32", (1,), [1000.0])], exp_output)
+    assert exp_output.tolist() == [float("inf")]
+
+    rsqrt_type = CoreType.tensor("float32", (4,))
+    rsqrt_source = ValueRef("rsqrt_source", rsqrt_type)
+    rsqrt_result = ValueRef("rsqrt_result", rsqrt_type)
+    rsqrt_program = _program(
+        "rsqrt_edge",
+        (rsqrt_source,),
+        (rsqrt_result,),
+        (Operation("rsqrt", (rsqrt_source,), (rsqrt_result,)),),
+    )
+    rsqrt_output = HostTensor.zeros("float32", (4,))
+    _run(
+        rsqrt_program,
+        [HostTensor("float32", (4,), [-4.0, -0.0, 0.0, float("nan")])],
+        rsqrt_output,
+    )
+    values = rsqrt_output.tolist()
+    assert math.isnan(values[0])
+    assert values[1:3] == [float("inf"), float("inf")]
+    assert math.isnan(values[3])
 
 
