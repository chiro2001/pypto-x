From 821eb8188b68bf9958fcaf36377f3cce0c20295f Mon Sep 17 00:00:00 2001
From: chiro <chiro@local>
Date: Sat, 12 Sep 2026 01:03:56 +0800
Subject: [PATCH 156/256] fix(tools): c8-l4-sve256 A3 bundle path + run gap
 probe on A3

---
 tools/c8_sve256_a3/run_a3_diagnostic.sh |  7 +++++++
 tools/c8_sve256_a3/sync_to_a3.sh        | 11 ++++++-----
 tools/c8_sve256_w8a8_gap_probe.py       | 16 +++++++++++++---
 3 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/tools/c8_sve256_a3/run_a3_diagnostic.sh b/tools/c8_sve256_a3/run_a3_diagnostic.sh
index 9f5e312bb..ea58a6fd1 100755
--- a/tools/c8_sve256_a3/run_a3_diagnostic.sh
+++ b/tools/c8_sve256_a3/run_a3_diagnostic.sh
@@ -72,6 +72,13 @@ timeout 900 taskset -c 320,322,324,326,328,330,332,334 "${PY}" "${DRIVER}" \
   > "${LOGS}/w8a8_repro.log" 2>&1
 echo "[run] W8A8 repro exit=$?"
 
+echo "[run] static gap probe on A3 (lowering only, no weights)"
+timeout 1200 taskset -c 320,322,324,326,328,330,332,334 "${PY}" \
+  "${ROOT}/tools/c8_sve256_w8a8_gap_probe.py" \
+  --output "${RAW}/gap_probe_a3.json" \
+  > "${LOGS}/gap_probe_a3.log" 2>&1
+echo "[run] gap probe exit=$?"
+
 # --- bf16 whole-net diagnostic: 3 prompts in parallel, 8 threads each ------
 # Physical-core map (Q1 measured): core c -> cpu 320 + (c/40)*80 + (c%40)*2.
 declare -A CPUS
diff --git a/tools/c8_sve256_a3/sync_to_a3.sh b/tools/c8_sve256_a3/sync_to_a3.sh
index 00f375bd3..9ce2b394d 100755
--- a/tools/c8_sve256_a3/sync_to_a3.sh
+++ b/tools/c8_sve256_a3/sync_to_a3.sh
@@ -6,13 +6,14 @@ set -euo pipefail
 EV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/c8-l4-sve256
 TAR="${EV}/a3_bundle.tar"
 A3=a3-21
-A3_ROOT='pypto-x-a3/c8-l4-sve256'
+A3_HOME=/home/l00886679
+A3_ROOT=pypto-x-a3/c8-l4-sve256
 
 [[ -f "${TAR}" ]] || { echo "missing ${TAR}; run make_bundle.sh first" >&2; exit 2; }
 
 echo "[sync] local tar bytes=$(stat -c %s "${TAR}") sha256=$(cut -d' ' -f1 "${EV}/a3_bundle.tar.sha256")"
-ssh -o BatchMode=yes "${A3}" "mkdir -p \$HOME/${A3_ROOT} && rm -rf \$HOME/${A3_ROOT}/src \$HOME/${A3_ROOT}/tools \$HOME/${A3_ROOT}/refmin \$HOME/${A3_ROOT}/rope"
-scp -q -o BatchMode=yes "${TAR}" "${A3}:\$HOME/${A3_ROOT}/a3_bundle.tar"
-ssh -o BatchMode=yes "${A3}" "cd \$HOME/${A3_ROOT} && tar -xf a3_bundle.tar && rm -rf src tools refmin rope && mv a3_bundle/src . && mv a3_bundle/tools . && mv a3_bundle/refmin . && mv a3_bundle/rope . && mv a3_bundle/MANIFEST.sha256 . && rm -rf a3_bundle && (cd . && sha256sum -c MANIFEST.sha256 >/dev/null) && echo '[sync] remote manifest OK'"
-ssh -o BatchMode=yes "${A3}" "du -sh \$HOME/${A3_ROOT}; date -u '+[sync] a3_utc=%Y-%m-%dT%H:%M:%SZ'"
+ssh -o BatchMode=yes "${A3}" "mkdir -p ${A3_HOME}/${A3_ROOT} && rm -rf ${A3_HOME}/${A3_ROOT}/src ${A3_HOME}/${A3_ROOT}/tools ${A3_HOME}/${A3_ROOT}/refmin ${A3_HOME}/${A3_ROOT}/rope"
+scp -q -o BatchMode=yes "${TAR}" "${A3}:${A3_HOME}/${A3_ROOT}/a3_bundle.tar"
+ssh -o BatchMode=yes "${A3}" "cd ${A3_HOME}/${A3_ROOT} && tar -xf a3_bundle.tar && rm -rf src tools refmin rope && mv a3_bundle/src . && mv a3_bundle/tools . && mv a3_bundle/refmin . && mv a3_bundle/rope . && mv a3_bundle/MANIFEST.sha256 . && rm -rf a3_bundle && (cd . && sha256sum -c MANIFEST.sha256 >/dev/null) && echo '[sync] remote manifest OK'"
+ssh -o BatchMode=yes "${A3}" "du -sh ${A3_HOME}/${A3_ROOT}; date -u '+[sync] a3_utc=%Y-%m-%dT%H:%M:%SZ'"
 date -u '+[sync] local_utc=%Y-%m-%dT%H:%M:%SZ'
diff --git a/tools/c8_sve256_w8a8_gap_probe.py b/tools/c8_sve256_w8a8_gap_probe.py
index 9cebde17b..577ce65fc 100755
--- a/tools/c8_sve256_w8a8_gap_probe.py
+++ b/tools/c8_sve256_w8a8_gap_probe.py
@@ -80,9 +80,19 @@ def _driver_decision():
     global _DRIVER_DECISION
     if _DRIVER_DECISION is None:
         import importlib.util
-
-        path = (Path(__file__).resolve().parents[1]
-                / "python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py")
+        import os
+
+        root = Path(__file__).resolve().parents[1]
+        candidates = [
+            Path(os.environ["PYPTO_X_DRIVER_PATH"]) if os.environ.get("PYPTO_X_DRIVER_PATH") else None,
+            root / "python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py",
+            root / "src/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py",
+        ]
+        path = next((item for item in candidates if item is not None and item.is_file()), None)
+        if path is None:
+            raise SystemExit(
+                "qwen35_weighted_execution_driver.py not found; set PYPTO_X_DRIVER_PATH"
+            )
         spec = importlib.util.spec_from_file_location("c8_q5_census_driver", str(path))
         module = importlib.util.module_from_spec(spec)
         spec.loader.exec_module(module)
