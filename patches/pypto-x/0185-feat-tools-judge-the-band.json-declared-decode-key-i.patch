+def read_key_band(band_json: dict, variant: str, prompt: str, key: str,
+                  band_path: Path, band_sha: str) -> dict:
+    """读取 band.json 的 per-key 统计（如 keys.decode_logits）并推导同一套门槛。"""
+    pointer = ["variants", variant, "per_prompt", prompt, "keys", key]
+    node = band_json
+    for step in pointer:
+        if not isinstance(node, dict) or step not in node:
+            raise SystemExit(
+                "band.json 缺少 {}/{}（variant={} prompt={}）".format(
+                    "/".join(pointer[:-1]), pointer[-1], variant, prompt)
+            )
+        node = node[step]
+    for field in ("max_abs", "cosine"):
+        if field not in node or node[field] is None:
+            raise SystemExit("band.json 的 {} 缺少字段 {}".format(".".join(pointer), field))
+    return {
+        "path": str(band_path),
+        "sha256": band_sha,
+        "json_pointer": ".".join(pointer),
+        "key": key,
+        "max_abs": float(node["max_abs"]),
+        "cosine": float(node["cosine"]),
+        "two_x_band": TWO_X * float(node["max_abs"]),
+        "near_tie_threshold": 0.5 * float(node["max_abs"]),
+        "cosine_floor": float(node["cosine"]) - COSINE_SLACK,
+    }
+
+
 def per_key_band(band_json: dict, variant: str, prompt: str) -> dict:
     node = band_json.get("variants", {}).get(variant, {}).get("per_prompt", {}).get(prompt, {})
     keys = node.get("keys", {})
@@ -483,6 +511,16 @@ def run_prompt(manifest: dict, prompt: str, gold_dir: Path, variant: str,
