diff --git a/scripts/perf/aggregate_driver_progress.py b/scripts/perf/aggregate_driver_progress.py
new file mode 100755
index 000000000..716444255
--- /dev/null
+++ b/scripts/perf/aggregate_driver_progress.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Aggregate ``qwen35_weighted_execution_driver --progress`` op records.
+
+B5 的 per-op 统计路径（``qwen35-native-reduce-broadcast/aggregate_progress.py``）
+的通用化版本：``stage-start`` 或 op-index 回绕开启一个新的 run；按 run 序号或
+"最长/最短 run" 选择要聚合的那一次 launch。
+
+用法：
+    python3 scripts/perf/aggregate_driver_progress.py <progress.log> <out.json> \
+        --run longest|shortest|first|last|<index> [--label prefill]
+"""
+
+from __future__ import annotations
+
+import argparse
+import collections
+import json
+import sys
+from pathlib import Path
+
+
+def load_runs(path: Path):
+    runs = []
+    current = None
+    previous_index = None
+    stage_starts = []
+    for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            record = json.loads(line)
+        except ValueError:
+            continue
+        kind = record.get("kind")
+        if kind == "stage-start":
+            stage_starts.append({"line": line_number, **record})
+            current = None
+            previous_index = None
+            continue
+        if kind != "op":
+            continue
+        index = record.get("index")
+        if current is None or (index is not None and previous_index is not None and index <= previous_index):
+            current = []
+            runs.append(current)
+        current.append(record)
+        previous_index = index
+    return runs, stage_starts
+
+
+def aggregate(records):
+    by_operation = {}
+    total_seconds = 0.0
+    for record in records:
+        operation = str(record.get("operation", "?"))
+        entry = by_operation.setdefault(
+            operation,
+            {"calls": 0, "total_seconds": 0.0, "max_ms": 0.0, "modes": collections.Counter(),
+             "seconds": []},
+        )
+        seconds = float(record.get("seconds", 0.0))
+        entry["calls"] += 1
+        entry["total_seconds"] += seconds
+        entry["seconds"].append(seconds)
+        entry["max_ms"] = max(entry["max_ms"], seconds * 1000.0)
+        entry["modes"][str(record.get("mode", "?"))] += 1
+        total_seconds += seconds
+    result = {}
+    for operation, entry in sorted(by_operation.items()):
+        samples = sorted(entry["seconds"])
+        median = samples[len(samples) // 2] if len(samples) % 2 else (
+            0.5 * (samples[len(samples) // 2 - 1] + samples[len(samples) // 2])
+        )
+        p95 = samples[max(0, -(-95 * len(samples) // 100) - 1)]
+        result[operation] = {
+            "calls": entry["calls"],
+            "total_seconds": round(entry["total_seconds"], 4),
+            "ms_per_call": round(entry["total_seconds"] * 1000.0 / entry["calls"], 4),
+            "median_ms": round(median * 1000.0, 4),
+            "p95_ms": round(p95 * 1000.0, 4),
+            "max_ms": round(entry["max_ms"], 4),
+            "modes": dict(sorted(entry["modes"].items())),
+        }
+    return {
+        "operation_total": len(records),
+        "op_seconds_total": round(total_seconds, 4),
+        "by_operation": result,
+    }
+
+
+def select_run(runs, selector: str):
+    if not runs:
+        raise SystemExit("no op runs found")
+    if selector == "longest":
+        return max(range(len(runs)), key=lambda index: len(runs[index]))
+    if selector == "shortest":
+        return min(range(len(runs)), key=lambda index: len(runs[index]))
+    if selector == "first":
+        return 0
+    if selector == "last":
+        return len(runs) - 1
+    try:
+        index = int(selector)
+    except ValueError:
+        raise SystemExit("--run must be longest|shortest|first|last|<index>")
+    if index < 0 or index >= len(runs):
+        raise SystemExit("run index {} out of range ({} runs)".format(index, len(runs)))
+    return index
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("progress")
+    parser.add_argument("output")
+    parser.add_argument("--run", default="longest")
+    parser.add_argument("--label", default=None)
+    args = parser.parse_args(argv)
+    path = Path(args.progress)
+    runs, stage_starts = load_runs(path)
+    chosen = select_run(runs, args.run)
+    records = runs[chosen]
+    report = {
+        "path": str(path.resolve()),
+        "label": args.label,
+        "selector": args.run,
+        "runs": len(runs),
+        "run_operation_counts": [len(run) for run in runs],
+        "chosen_run": chosen,
+        "stage_starts": stage_starts,
+    }
+    report.update(aggregate(records))
+    Path(args.output).write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=1) + "\n")
+    print(
+        "label={} selector={} run={}/{} ops={} seconds={}".format(
+            args.label, args.run, chosen, len(runs), report["operation_total"],
+            report["op_seconds_total"],
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
