+#!/usr/bin/env python3
+"""W8B B3c · L0 算子级 microbench（本机 AVX-512 / scalar）。
+
+任务：``local-perf-l0-l1``。协议：``docs/PERF_MEASUREMENT_PROTOCOL.zh-CN.md``。
+
+本驱动**直接构造 Core IR 程序 + Artifact + LaunchRequest 调用 backend runtime**
+（协议 §2 L0 的强制要求：不得通过 ``build_qwen35_text_decoder_graph`` 走图遍历）。
+每个 case 同时测两侧：
+
+* ``kernel`` 侧：单次 launch 内放 ``R_ops`` 个同类算子，整次 launch 计时 / ``R_ops``
+  （协议 §2 的 ``kernel_seconds``）；
+* ``dispatch`` 侧：``R`` 次独立 launch，每次只有 1 个同类算子，整次 launch 计时；
+* ``dispatch_seconds = median(1-op launch) - median(N-op launch)/N``
+  （协议 §2 差值法；纯派发/装载开销，kernel 工作在两侧抵消）。
+
+统计口径（协议 §3.3/§3.4 + ERR-0004）：
+``min/median/p95(nearest-rank)/max/stdev/cv``，outlier 规则
+``|x - median| > max(3*1.4826*MAD, max(1us, 0.02*median))``，``outlier_ratio > 0.10 -> UNSTABLE``；
+本机方差门：``cv <= 0.05``、``p95/median <= 1.25``。本机是 KVM guest 且无 cpufreq，
+因此所有绝对数字**永久 UNGATED**（T2/T3），本驱动不写任何阈值。
+
+用法（重任务必须经 ``scripts/resource/run_local_heavy.sh``）：
+    python3 scripts/perf/local_l0_microbench.py --round 1 --output <json> \
+        --work-dir <dir> [--backends avx512,scalar] [--cases name1,name2] \
+        [--probe]
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import platform
+import struct
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Mapping, Optional, Sequence, Tuple
+
+# ---------------------------------------------------------------------------
+# 常量与口径
+# ---------------------------------------------------------------------------
+
+TASK = "local-perf-l0-l1"
+EVIDENCE_KIND = "pypto-x.perf-evidence.local-l0"
+
+# 协议 §3.4 本机（KVM guest）方差上限。
+VARIANCE_LIMITS_LOCAL = {"cv": 0.05, "p95_over_median": 1.25}
+# 协议 §3.3 第 6 步 + ERR-0004 floor。
+OUTLIER_RATIO_MAX = 0.10
+OUTLIER_FLOOR_MIN_SECONDS = 1.0e-6
+OUTLIER_FLOOR_MEDIAN_FRACTION = 0.02
+WARMUP_ACCEPTANCE = 0.05
+WARMUP_ATTEMPTS = 3
+
+# 环境噪声门（协议 §4.1）：max(load1) < online_cpus，max(cpu_psi_avg10) < 25。
+HOST_LOAD_MAX_RATIO = 1.0
+HOST_PSI_MAX_AVG10 = 25.0
+
+AVX512_FORMAT = "pypto-x.cpu.avx512"
+
+
+# ---------------------------------------------------------------------------
+# case 定义
+#
+# 对称 case（两个后端同 shape，可做同 host 的 T2 时间比）：
+#   elementwise add/mul N=65536（协议 shape 集 {4096, 65536, 1M, 4M} 的中间值）；
+#   reduction reduce_sum / reduce_max (32,64) axis=1（scalar 的 _reduce_value 是
