 def _llvm_f32_literal(value: Any) -> str:
-    return "0x{:016X}".format(_f32_bits(value) << 32)
+    # LLVM's 16-digit hexadecimal spelling for a typed ``float`` is the
+    # exact IEEE-754 value represented in the literal's semantic format.  A
+    # previous implementation shifted raw f32 bits into the high half of a
+    # double bit pattern; LLVM 22 parses that as a different (usually tiny)
+    # double and then rounds it to float.  Round to f32 first, widen that
+    # exact value to f64, and encode the f64 bits expected by llvm-as.
+    rounded = struct.unpack("<f", struct.pack("<f", float(value)))[0]
+    double_bits = struct.unpack("<Q", struct.pack("<d", float(rounded)))[0]
+    return "0x{:016X}".format(double_bits)
 
 
