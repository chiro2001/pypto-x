+def _emit_silu_f32(builder: _IRBuilder, value: str) -> str:
+    """Emit SiLU while avoiding the IEEE ``-Inf * 0`` invalid operation."""
+
+    sigmoid = _emit_sigmoid_f32(builder, value)
+    product = builder.temp("silu_product")
+    builder.line("  {} = fmul float {}, {}".format(product, value, sigmoid))
+    silu_bits = builder.temp("silu_bits")
+    silu_sign = builder.temp("silu_sign")
+    silu_exponent = builder.temp("silu_exponent")
+    silu_mantissa = builder.temp("silu_mantissa")
+    silu_inf_class = builder.temp("silu_inf_class")
+    silu_is_neg_inf = builder.temp("silu_is_neg_inf")
+    silu_exp_full = builder.temp("silu_exp_full")
+    silu_mantissa_zero = builder.temp("silu_mantissa_zero")
+    silu_sign_set = builder.temp("silu_sign_set")
+    builder.line("  {} = bitcast float {} to i32".format(silu_bits, value))
+    builder.line("  {} = and i32 {}, -2147483648".format(silu_sign, silu_bits))
+    builder.line("  {} = and i32 {}, 2139095040".format(silu_exponent, silu_bits))
+    builder.line("  {} = and i32 {}, 8388607".format(silu_mantissa, silu_bits))
+    builder.line("  {} = icmp eq i32 {}, 2139095040".format(silu_exp_full, silu_exponent))
+    builder.line("  {} = icmp eq i32 {}, 0".format(silu_mantissa_zero, silu_mantissa))
+    builder.line("  {} = icmp ne i32 {}, 0".format(silu_sign_set, silu_sign))
+    builder.line("  {} = and i1 {}, {}".format(silu_inf_class, silu_exp_full, silu_mantissa_zero))
+    builder.line("  {} = and i1 {}, {}".format(silu_is_neg_inf, silu_inf_class, silu_sign_set))
+    result = builder.temp("silu_result")
+    builder.line("  {} = select i1 {}, float {}, float {}".format(result, silu_is_neg_inf, _llvm_f32_literal(0.0), product))
+    return result
+
