+def _float_from_bits(bits):
+    return struct.unpack("<f", struct.pack("<I", int(bits) & 0xFFFFFFFF))[0]
+
+
+def _float_bits(value):
+    value = float(value)
+    try:
+        return struct.unpack("<I", struct.pack("<f", value))[0]
+    except OverflowError:
+        return 0xFF800000 if value < 0.0 else 0x7F800000
+
+
+def _is_nan(value):
+    return math.isnan(float(value))
+
+
+def _reference_math(name, value):
+    """Independent IEEE-ish reference; it does not reuse generated formulas."""
+
+    value = float(value)
+    if _is_nan(value):
+        return float("nan")
+    if name == "exp":
+        try:
+            return math.exp(value)
+        except OverflowError:
+            return float("inf")
+    if name == "rsqrt":
+        if value == 0.0:
+            return float("inf")
+        if value < 0.0:
+            return float("nan")
+        if math.isinf(value):
+            return 0.0
+        return 1.0 / math.sqrt(value)
+    if name == "sigmoid":
+        if value >= 0.0:
+            try:
+                return 1.0 / (1.0 + math.exp(-value))
+            except OverflowError:
+                return 1.0
+        try:
+            exponential = math.exp(value)
+        except OverflowError:
+            exponential = 0.0
+        return exponential / (1.0 + exponential)
+    if name == "silu":
+        if value == float("-inf"):
+            return 0.0
+        return value * _reference_math("sigmoid", value)
+    if name == "softplus":
+        if value == float("inf"):
+            return value
+        if value == float("-inf"):
+            return 0.0
+        return max(value, 0.0) + math.log1p(math.exp(-abs(value)))
+    raise ValueError("unknown math operation {!r}".format(name))
+
+
+def _round_bf16_bits(value):
+    """Independent BF16 RNE conversion used only by the host oracle."""
+
+    bits = _float_bits(value)
+    exponent = bits & 0x7F800000
+    mantissa = bits & 0x007FFFFF
+    upper = bits >> 16
+    if exponent == 0x7F800000 and mantissa:
+        return (upper | 0x40) & 0xFFFF
+    return ((bits + 0x7FFF + (upper & 1)) >> 16) & 0xFFFF
+
+
+def _render_host_math_ir(name):
+    emitters = {
+        "exp": _emit_exp_f32,
+        "rsqrt": _emit_rsqrt_f32,
+        "sigmoid": _emit_sigmoid_f32,
+        "silu": _emit_silu_f32,
+        "softplus": _emit_softplus_f32,
+    }
+    builder = _IRBuilder()
+    builder.line('target triple = "x86_64-pc-linux-gnu"')
+    builder.line("define float @pypto_x_host_{}(float %input) {{".format(name))
+    builder.line("entry:")
+    result = emitters[name](builder, "%input")
+    builder.line("  ret float {}".format(result))
+    builder.line("}")
+    return "\n".join(builder.lines) + "\n"
+
+
+@contextmanager
+def _host_math_library():
+    """Compile the production scalar LLVM arithmetic to a host shared object."""
+
+    directory = tempfile.TemporaryDirectory(prefix="pypto-x-c3-host-math-")
+    root = Path(directory.name)
+    libraries = {}
+    try:
+        for name in ("exp", "rsqrt", "sigmoid", "silu", "softplus"):
+            ir_path = root / (name + ".ll")
+            bitcode_path = root / (name + ".bc")
+            object_path = root / (name + ".o")
+            shared_path = root / (name + ".so")
+            ir_path.write_text(_render_host_math_ir(name), encoding="utf-8")
+            subprocess.run(["llvm-as", str(ir_path), "-o", str(bitcode_path)], check=True, capture_output=True, text=True)
+            subprocess.run(
+                ["llc", "-mtriple=x86_64-pc-linux-gnu", "-filetype=obj", str(bitcode_path), "-o", str(object_path)],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+            subprocess.run(
+                ["clang", "-shared", "-fPIC", str(object_path), "-o", str(shared_path)],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+            library = ctypes.CDLL(str(shared_path))
+            function = getattr(library, "pypto_x_host_{}".format(name))
+            function.argtypes = (ctypes.c_float,)
+            function.restype = ctypes.c_float
+            libraries[name] = function
+        yield libraries
+    finally:
+        directory.cleanup()
+
+
+def _host_call(function, input_bits):
+    value = _float_from_bits(input_bits)
+    actual = function(ctypes.c_float(value))
+    return _float_bits(actual)
+
+
+def _classify_bits(bits):
+    exponent = bits & 0x7F800000
+    mantissa = bits & 0x007FFFFF
+    sign = bits >> 31
+    if exponent == 0x7F800000 and mantissa:
+        return "nan"
+    if exponent == 0x7F800000:
+        return "-inf" if sign else "+inf"
+    if (bits & 0x7FFFFFFF) == 0:
+        return "-0" if sign else "+0"
+    if exponent == 0:
+        return "subnormal"
+    return "finite"
+
+
+def _compare_float32(name, input_bits, actual_bits):
+    value = _float_from_bits(input_bits)
+    reference = _reference_math(name, value)
+    actual = _float_from_bits(actual_bits)
+    reference_class = _classify_bits(_float_bits(reference))
+    actual_class = _classify_bits(actual_bits)
+    if reference_class == "nan":
+        return actual_class == "nan", 0.0
+    if reference_class in ("+inf", "-inf"):
+        return actual_class == reference_class, 0.0
+    if reference == 0.0:
+        if actual != 0.0:
+            return False, float("inf")
+        if name == "silu":
+            return (_float_bits(actual) >> 31) == (_float_bits(reference) >> 31), 0.0
+        return True, 0.0
+    error = abs(float(actual) - float(reference))
+    scale = max(abs(float(reference)), 1.0e-30)
+    tolerance = {
+        "exp": 5.0e-6,
+        "rsqrt": 8.0e-6,
+        "sigmoid": 8.0e-6,
+        "silu": 1.2e-5,
+        "softplus": 1.2e-5,
+    }[name]
+    return error <= tolerance * scale + 2.0e-7, error / scale
+
+
+def _compare_bf16(name, input_raw, actual_bits):
+    input_bits = int(input_raw) << 16
+    reference = _reference_math(name, _float_from_bits(input_bits))
+    actual_raw = _round_bf16_bits(_float_from_bits(actual_bits))
+    reference_class = _classify_bits(_float_bits(reference))
+    actual_class = _classify_bits(int(actual_raw) << 16)
+    if reference_class == "nan":
+        return actual_class == "nan", 0
+    if reference_class in ("+inf", "-inf"):
+        return actual_raw == (0xFF80 if reference_class == "-inf" else 0x7F80), 0
+    reference_raw = _round_bf16_bits(reference)
+    if actual_class in ("nan", "+inf", "-inf"):
+        return False, 0
+    distance = abs(int(actual_raw) - int(reference_raw))
+    return distance <= 2, distance
+
+
+def _random_fp32_inputs():
+    edge_bits = [
+        0x00000000, 0x80000000, 0x00000001, 0x00000002, 0x00040000,
+        0x007FFFFF, 0x00800000, 0x7F7FFFFF, 0xFF7FFFFF,
+        0x7F800000, 0xFF800000, 0x7FC00001, 0xFFC00001,
+        _float_bits(-103.97208404541016), _float_bits(-103.27892990343185),
+        _float_bits(-103.0), _float_bits(-88.72283935546875),
+        _float_bits(88.72283935546875), _float_bits(1.0), _float_bits(-1.0),
+    ]
+    rng = random.Random(0xC3A5)
+    values = list(edge_bits)
+    for exponent in range(-149, 128, 3):
+        for sign in (0, 1):
+            mantissa = 1.0 + rng.random()
+            value = math.ldexp(mantissa, exponent)
+            if sign:
+                value = -value
+            values.append(_float_bits(value))
+    for _ in range(512):
+        values.append(_float_bits(rng.uniform(-110.0, 110.0)))
+    return values
+
+
+def _numeric_math_audit():
+    fp32_inputs = _random_fp32_inputs()
+    edge_names = {
+        "nan": 0x7FC00001,
+        "+inf": 0x7F800000,
+        "-inf": 0xFF800000,
+        "+0": 0x00000000,
+        "-0": 0x80000000,
+        "min_subnormal": 0x00000001,
+        "two_pow_minus_140": _float_bits(2.0 ** -140),
+        "max_finite": 0x7F7FFFFF,
+    }
+    result = {"fp32": {}, "bf16": {}, "exp_underflow_boundary": {}, "extremes": {}}
+    with _host_math_library() as functions:
+        for name, function in functions.items():
+            mismatches = []
+            mismatch_total = 0
+            max_relative_error = 0.0
+            for input_bits in fp32_inputs:
+                actual_bits = _host_call(function, input_bits)
+                passed, relative_error = _compare_float32(name, input_bits, actual_bits)
+                max_relative_error = max(max_relative_error, relative_error)
+                if not passed:
+                    mismatch_total += 1
+                    if len(mismatches) < 8:
+                        mismatches.append({
+                            "input_bits": "0x{:08x}".format(input_bits),
+                            "actual_bits": "0x{:08x}".format(actual_bits),
+                            "input_class": _classify_bits(input_bits),
+                            "relative_error": relative_error,
+                        })
+            bf16_mismatches = []
+            bf16_mismatch_total = 0
+            bf16_max_distance = 0
+            for input_raw in range(0x10000):
+                actual_bits = _host_call(function, input_raw << 16)
+                passed, distance = _compare_bf16(name, input_raw, actual_bits)
+                bf16_max_distance = max(bf16_max_distance, distance)
+                if not passed:
+                    bf16_mismatch_total += 1
+                    if len(bf16_mismatches) < 8:
+                        bf16_mismatches.append({
+                            "input_raw": "0x{:04x}".format(input_raw),
+                            "actual_bits": "0x{:08x}".format(actual_bits),
+                            "input_class": _classify_bits(input_raw << 16),
+                            "distance": distance,
+                        })
+            result["fp32"][name] = {
+                "cases": len(fp32_inputs),
+                "mismatch_count": mismatch_total,
+                "mismatches": mismatches,
