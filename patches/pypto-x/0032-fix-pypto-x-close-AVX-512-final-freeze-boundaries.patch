+def _validate_primary_artifact(artifact: Artifact) -> Mapping[str, Any]:
+    """Validate primary metadata before capability dispatch or fallback use."""
+
+    if not isinstance(artifact, Artifact):
+        raise CpuAvx512ArtifactError("AVX-512 runtime requires Artifact")
+    try:
+        artifact.validate()
+    except Exception as exc:
+        raise CpuAvx512ArtifactError("primary artifact validation failed: {}".format(exc)) from exc
+    if artifact.path is None:
+        raise CpuAvx512ArtifactError("primary AVX-512 artifact must reference a native shared object")
+    if artifact.format != DEFAULT_ARTIFACT_FORMAT:
+        raise CpuAvx512ArtifactError("primary artifact format is not AVX-512")
+    if artifact.abi_version != ABI_VERSION:
+        raise CpuAvx512ArtifactError("primary artifact ABI is unsupported")
+    if artifact.target.kind != "cpu" or not artifact.target.triple.startswith(("x86_64", "amd64")):
+        raise CpuAvx512ArtifactError("primary artifact target must be x86_64 CPU")
+    metadata = mapping_copy(artifact.metadata)
+    if metadata.get("backend") != AVX512_BACKEND:
+        raise CpuAvx512ArtifactError("primary artifact backend metadata is invalid")
+    if metadata.get("native_isa") != "avx512" or metadata.get("native_format") != "elf-shared-object":
+        raise CpuAvx512ArtifactError("primary artifact native format is invalid")
+    if metadata.get("entrypoint") != artifact.entrypoint:
+        raise CpuAvx512ArtifactError("primary artifact metadata entrypoint is inconsistent")
+    plan_data = metadata.get("vector_plan")
+    if not isinstance(plan_data, Mapping):
+        raise CpuAvx512ArtifactError("primary artifact vector plan metadata is invalid")
+    required_data = plan_data.get("required_features")
+    if not isinstance(required_data, Mapping):
+        raise CpuAvx512ArtifactError("primary artifact required_features metadata is invalid")
+    required = set(_string_sequence(required_data.get("features"), "primary plan required_features"))
+    _string_sequence(metadata.get("required_features"), "primary artifact required_features")
+    if not {"avx", "avx512f", "osxsave", "ymm", "opmask", "zmm"}.issubset(required):
+        raise CpuAvx512ArtifactError("primary artifact required_features omit AVX/ZMM safety fields")
+    _program_digest_from_metadata(metadata, "primary artifact")
+    return metadata
+
+
