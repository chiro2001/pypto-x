+def test_injected_capability_dependency_closure_does_not_forge_os_state():
+    for feature in ("avx512vnni", "avx512bf16"):
+        capability = Avx512Capability.injected_capability((feature,))
+        assert capability.avx512f and capability.avx
+        assert not capability.osxsave
+        assert capability.xcr0 == 0
+        assert not capability.ymm_state
+        assert not capability.zmm_state
+        assert not capability.available
+    base = Avx512Capability.injected_capability(("avx512f",))
+    assert base.avx and base.avx512f
+    assert not base.osxsave and base.xcr0 == 0
+    assert not base.available
+
