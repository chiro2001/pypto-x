+++ b/python/tests/ut/pypto_x/test_w8a8_sve256.py
@@ -861,6 +861,220 @@ def test_sve256_w8a8_artifact_metadata_tamper_fails_closed(build_root):
         runtime.load(tampered(w8a8_capability=bad_entry))
 
 
+def test_sve256_w8a8_artifact_memo_avoids_repeated_decode(build_root):
+    """Repeated W8A8 dispatch must not re-decode/lower the whole artifact."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo")
+    runtime = _runtime()
+    calls = {"decode": 0}
+    real_decode = runtime._decode_for_execution
+
+    def counted(*args, **kwargs):
+        calls["decode"] += 1
+        return real_decode(*args, **kwargs)
+
+    runtime._decode_for_execution = counted
+    declared_first, loaded_first = runtime._load_w8a8(artifact)
+    declared_second, loaded_second = runtime._load_w8a8(artifact)
+    assert calls["decode"] == 1
+    assert declared_first is declared_second
+    assert loaded_first.artifact is artifact
+    assert loaded_second.artifact is artifact
+    # A distinct Artifact object must never reuse the memo entry, even when it
+    # points at the same ELF: the memo is identity-keyed, so tampered metadata
+    # still goes through the full fail-closed decode.
+    clone = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=dict(artifact.metadata),
+    )
+    runtime._load_w8a8(clone)
+    assert calls["decode"] == 2
+
+
+def test_sve256_w8a8_launch_decodes_once_for_multiple_w8a8_nodes(build_root):
+    """One launch decodes the artifact once even with several W8A8 nodes."""
+
+    _require_sve_execution()
+    left = ValueRef("left", CoreType.tensor("int8", (1, 2)))
+    right = ValueRef("right", CoreType.tensor("int8", (2, 1)))
+    accumulator = ValueRef("accumulator", CoreType.tensor("int32", (1, 1)))
+    row_scales = ValueRef("row_scales", CoreType.tensor("float32", (1,)))
+    column_scales = ValueRef("column_scales", CoreType.tensor("float32", (1,)))
+    output = ValueRef("output", CoreType.tensor("bf16", (1, 1)))
+    program = CoreProgram(
+        functions=(
+            CoreFunction(
+                "main",
+                (left, right, row_scales, column_scales),
+                (output,),
+                Region(
+                    (
+                        Operation(
+                            W8A8_QMATMUL_OPCODE,
+                            (left, right),
+                            (accumulator,),
+                            {},
+                        ),
+                        Operation(
+                            W8A8_EPILOGUE_OPCODE,
+                            (accumulator, row_scales, column_scales),
+                            (output,),
+                            {},
+                        ),
+                    )
+                ),
+            ),
+        )
+    )
+    _, artifact = _compile(program, build_root, "qm_chain_memo")
+    assert tuple(artifact.metadata["w8a8_kernel_operations"]) == (
+        W8A8_QMATMUL_OPCODE,
+        W8A8_EPILOGUE_OPCODE,
+    )
+    runtime = _runtime()
+    calls = {"decode": 0}
+    real_decode = runtime._decode_for_execution
+
+    def counted(*args, **kwargs):
+        calls["decode"] += 1
+        return real_decode(*args, **kwargs)
+
+    runtime._decode_for_execution = counted
+    _launch(
+        artifact,
+        [
+            HostTensor("int8", (1, 2), [3, -4]),
+            HostTensor("int8", (2, 1), [5, 6]),
+            HostTensor("float32", (1,), [0.5]),
+            HostTensor("float32", (1,), [0.25]),
+        ],
+        [HostTensor("bf16", (1, 1), [0.0])],
+        runtime=runtime,
+    )
+    assert calls["decode"] == 1
+
+
+def test_sve256_w8a8_decode_memo_disable_switch(build_root, monkeypatch):
+    """The explicit env switch restores one full decode per dispatch."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_off")
+    monkeypatch.setenv("PYPTO_X_SVE_W8A8_DECODE_MEMO", "off")
+    runtime = _runtime()
+    assert runtime._w8a8_memo_enabled is False
+    calls = {"decode": 0}
+    real_decode = runtime._decode_for_execution
+
+    def counted(*args, **kwargs):
+        calls["decode"] += 1
+        return real_decode(*args, **kwargs)
+
+    runtime._decode_for_execution = counted
+    runtime._load_w8a8(artifact)
+    runtime._load_w8a8(artifact)
+    assert calls["decode"] == 2
+    assert runtime._w8a8_loaded == {}
+
+
+def test_sve256_w8a8_decode_memo_is_bounded(build_root):
+    """The memo keeps at most ``_w8a8_loaded_limit`` identity entries."""
+
+    _require_sve_execution()
+    artifacts = []
+    for width in (2, 3, 4):
+        program, _ = _qmatmul_program((1, width), (width, 1))
+        _, artifact = _compile(program, build_root, "qm_memo_b{}".format(width))
+        artifacts.append(artifact)
+    runtime = _runtime()
+    for artifact in artifacts:
+        runtime._load_w8a8(artifact)
+    assert runtime._w8a8_loaded_limit == 2
+    assert len(runtime._w8a8_loaded) == 2
+    assert id(artifacts[0]) not in runtime._w8a8_loaded
+    assert id(artifacts[1]) in runtime._w8a8_loaded
+    assert id(artifacts[2]) in runtime._w8a8_loaded
+
+
+def test_sve256_w8a8_decode_memo_rejects_tampered_elf(build_root, tmp_path):
+    """A different Artifact object never hits the memo, even for the same path."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_tamper")
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)  # warm the memo entry
+    tampered_bytes = bytearray(Path(artifact.path).read_bytes())
+    tampered_bytes[-1] ^= 0x01
+    tampered_path = tmp_path / "tampered.elf"
+    tampered_path.write_bytes(bytes(tampered_bytes))
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(tampered_path),
+        metadata=dict(artifact.metadata),
+    )
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(tampered)
+    # The warmed entry must stay untouched and still serve its own artifact.
+    declared, loaded = runtime._load_w8a8(artifact)
+    assert loaded.artifact is artifact
+    assert declared is not None
+
+
+def test_sve256_w8a8_dispatch_revalidates_declaration_on_memo_hit(build_root):
+    """The memo only skips decode; the W8A8 gate runs on every dispatch."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_gate")
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)  # memo hit on the next call
+    calls = {"declaration": 0}
+    real_declaration = runtime._require_w8a8_declaration
+
+    def counted(*args, **kwargs):
+        calls["declaration"] += 1
+        return real_declaration(*args, **kwargs)
+
+    runtime._require_w8a8_declaration = counted
+    runtime._load_w8a8(artifact)
+    assert calls["declaration"] == 1
+
+    def rejecting(*args, **kwargs):
+        raise CpuSve256ArtifactError("declaration re-check")
+
+    runtime._require_w8a8_declaration = rejecting
+    with pytest.raises(CpuSve256ArtifactError, match="declaration re-check"):
+        runtime._load_w8a8(artifact)
+
+    # A new Artifact object with a tampered declaration misses the memo and is
+    # rejected by the full decode + the per-dispatch declaration gate.
+    runtime._require_w8a8_declaration = real_declaration
+    bad_declaration = dict(artifact.metadata["w8a8_capability"])
+    bad_declaration["digest"] = "0" * 64
+    tampered_metadata = dict(artifact.metadata)
+    tampered_metadata["w8a8_capability"] = bad_declaration
+    tampered = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=tampered_metadata,
+    )
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(tampered)
+
+
 def test_sve256_w8a8_elf_wire_is_version_locked(build_root):
     _require_sve_execution()
     program, _ = _qmatmul_program((1, 2), (2, 1))
