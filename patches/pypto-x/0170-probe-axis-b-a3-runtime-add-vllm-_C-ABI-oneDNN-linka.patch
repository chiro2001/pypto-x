From ce4d1694d8603215a62cf1055670dc449ce7e4aa Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:54:15 +0800
Subject: [PATCH 170/252] probe(axis-b-a3-runtime): add vllm _C ABI / oneDNN
 linkage probe

---
 scripts/a3_axis_b_runtime/01_a3_abi_probe.sh | 81 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)

diff --git a/scripts/a3_axis_b_runtime/01_a3_abi_probe.sh b/scripts/a3_axis_b_runtime/01_a3_abi_probe.sh
new file mode 100755
index 000000000..0425a2be3
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/01_a3_abi_probe.sh
@@ -0,0 +1,81 @@
+#!/usr/bin/env bash
+# axis-b-a3-runtime 01: ABI/oneDNN linkage probe of the installed vllm-cpu wheel
+# against the inherited torch 2.14.0+cu130 on aarch64. Read-only except log files.
+# CPUs 600-639, NPU env cleared.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+LOGS="$RUN/logs"
+RAW="$RUN/raw"
+VENV="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb"
+PY="$VENV/bin/python"
+SP="$VENV/lib/python3.12/site-packages"
+CPUS="${AXISB_CPUS:-600-639}"
+
+mkdir -p "$LOGS" "$RAW"
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+
+echo "### 01_a3_abi_probe A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+echo "--- vllm._C direct (loads _C.abi3.so) ---"
+taskset -c "$CPUS" timeout 300 "$PY" -c '
+import sys
+try:
+    import vllm._C as C
+    print("IMPORT_VLLM_C_OK", C.__file__)
+except BaseException as e:
+    print("IMPORT_VLLM_C_FAIL", type(e).__name__, str(e)[:2000])
+' 2>&1 | tail -20
+
+echo "--- vllm._custom_ops ---"
+taskset -c "$CPUS" timeout 300 "$PY" -c '
+try:
+    from vllm import _custom_ops as ops
+    print("IMPORT_CUSTOM_OPS_OK")
+    print("has_dynamic_scaled_int8_quant", hasattr(ops, "dynamic_scaled_int8_quant"))
+    print("has_static_scaled_int8_quant", hasattr(ops, "static_scaled_int8_quant"))
+except BaseException as e:
+    print("IMPORT_CUSTOM_OPS_FAIL", type(e).__name__, str(e)[:2000])
+' 2>&1 | tail -20
+
+echo "--- readelf/ldd of _C.abi3.so ---"
+SO="$SP/vllm/_C.abi3.so"
+ls -la "$SO" 2>/dev/null || echo "missing $SO"
+if [[ -f "$SO" ]]; then
+    echo "-- NEEDED --"
+    readelf -d "$SO" 2>/dev/null | grep -E 'NEEDED|RPATH|RUNPATH' || true
+    echo "-- ldd --"
+    ldd "$SO" 2>&1 | head -30
+    echo "-- undefined dnnl/onednn/acl/kai symbols (top 40) --"
+    nm -D --undefined-only "$SO" 2>/dev/null | grep -iE 'dnnl|onednn|acl_|kai_|arm_' | head -40
+    echo "-- defined dnnl/onednn symbols (top 20) --"
+    nm -D --defined-only "$SO" 2>/dev/null | grep -iE 'dnnl|onednn' | head -20
+    echo "-- build-id / version strings --"
+    readelf -n "$SO" 2>/dev/null | grep -i 'build id' || true
+    strings -a "$SO" | grep -iE '^oneDNN v[0-9]|DNNL_VERSION|dnnl v[0-9]|kleidiai|kleidi' | sort -u | head -20
+fi
+
+echo "--- torch libs: dnnl / acl / kleidiai fingerprints ---"
+TORCH_LIB="$SP/torch/lib"
+ls "$TORCH_LIB" 2>/dev/null | head -20
+for lib in "$TORCH_LIB"/libtorch_cpu.so "$TORCH_LIB"/libtorch.so; do
+    [[ -f "$lib" ]] || continue
+    echo "== $lib ($(stat -c%s "$lib") bytes)"
+    echo "-- soname/needed --"
+    readelf -d "$lib" 2>/dev/null | grep -E 'NEEDED|SONAME' | head -20
+    echo "-- dnnl symbols --"
+    nm -D "$lib" 2>/dev/null | grep -ciE 'dnnl_' || true
+    echo "-- kleidiai/acl symbols --"
+    nm -D "$lib" 2>/dev/null | grep -ciE 'kai_|acl_' || true
+    strings -a "$lib" | grep -iE 'kleidiai|oneDNN v[0-9]|Arm Compute Library|arm_compute' | sort -u | head -10
+done
+echo "-- any libdnnl in env --"
+find "$SP" "$SP/torch/lib" -maxdepth 2 -name '*dnnl*' -o -maxdepth 2 -name 'libarm*' 2>/dev/null | head -20
+
+echo "--- site-packages vllm/_C linked libs present ---"
+for l in libdnnl.so.3 libdnnl.so libarm_compute.so libarm_compute_core.so libomp.so libgomp.so.1; do
+    printf '%s -> ' "$l"
+    (ldconfig -p 2>/dev/null | grep -m1 "$l") || echo "not-in-ldconfig"
+done
+echo "### done A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
