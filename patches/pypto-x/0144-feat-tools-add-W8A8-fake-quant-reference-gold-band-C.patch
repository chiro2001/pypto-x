+++ b/tools/qwen35_reference/w8a8_scope.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8A8 量化范围（契约 0002 的 D1/D4/D9）的共享名字与分类工具。
+
+本模块只做字符串判断，不导入 torch / numpy / pypto，供三处复用：
+
+* ``run_reference.py``：官方 transformers gold 的 ``w8a8`` fake-quant 变体；
+* ``audit_w8a8_scale.py``：从冻结 BF16 权重独立重算 per-channel scale（路径 b）；
+* ``packer_side_a.py``：复现我们 packer 的 int8/scale payload（路径 a）。
+
+量化范围（默认 scope ``default``，契约 0002 §2.1 / §8 决策）：
+
+* 量化：6 层 full-attention 的 q/k/v/o proj（24）、18 层 GDR 的
+  in_proj_qkv/in_proj_z/out_proj（54）、24 层 MLP 的 gate/up/down（72），
+  共 **150** 个 language-model ``nn.Linear``；
+* 保持 BF16（不量化）：GDR ``in_proj_b`` / ``in_proj_a``（36）；
+* 不量化：``lm_head``（D4）、depthwise ``conv1d``（D9）、embedding、所有 norm、
+  attention/GDR 内部 matmul、以及整个 vision tower（纯文本前向不参与）。
+
+pypto 侧参数名（artifact manifest）与 HF 官方权重名的映射也在这里，
+保持与 ``weight_scale_manifest.json`` 的 150 个名字一致。
+"""
+
+from __future__ import unicode_literals
+
+QWEN35_TEXT_PREFIX = "model.language_model."
+QWEN35_VISION_PREFIX = "model.visual."
+QWEN35_MTP_PREFIX = "mtp."
+
+#: 量化的 language-model linear 模块后缀（按 HF module 名去掉层号前缀）。
+QUANTIZED_LINEAR_SUFFIXES = (
+    "self_attn.q_proj",
+    "self_attn.k_proj",
+    "self_attn.v_proj",
+    "self_attn.o_proj",
+    "linear_attn.in_proj_qkv",
+    "linear_attn.in_proj_z",
+    "linear_attn.out_proj",
+    "mlp.gate_proj",
+    "mlp.up_proj",
+    "mlp.down_proj",
+)
+
+#: 契约 §8-D1 要求保持 BF16 的 language-model linear（36 个 16x1024）。
+BF16_LINEAR_SUFFIXES = (
+    "linear_attn.in_proj_b",
+    "linear_attn.in_proj_a",
+)
+
+EXPECTED_QUANTIZED_LINEAR_COUNT = 150
+EXPECTED_BF16_LINEAR_COUNT = 36
+
+#: pypto artifact manifest 里的量化张量名列表形状：layer_%02d_<suffix>_weight。
+_MANIFEST_SUFFIX = {
+    "self_attn.q_proj": "q_proj",
+    "self_attn.k_proj": "k_proj",
+    "self_attn.v_proj": "v_proj",
+    "self_attn.o_proj": "o_proj",
+    "linear_attn.in_proj_qkv": "in_proj_qkv",
+    "linear_attn.in_proj_z": "in_proj_z",
+    "linear_attn.out_proj": "out_proj",
+    "mlp.gate_proj": "mlp_gate_proj",
+    "mlp.up_proj": "mlp_up_proj",
+    "mlp.down_proj": "mlp_down_proj",
+}
+
+
+def language_linear_suffix(module_name):
+    """把 ``model.language_model.layers.N.<suffix>`` 解析成 ``<suffix>``。
+
+    非 language-model 层（vision/MTP/embedding/lm_head/norm/conv1d）返回 None。
+    """
+
+    prefix = QWEN35_TEXT_PREFIX + "layers."
+    if not module_name.startswith(prefix):
+        return None
+    rest = module_name[len(prefix):]
+    parts = rest.split(".")
+    if len(parts) < 3:
+        return None
+    layer_index = parts[0]
+    if not layer_index.isdigit():
+        return None
+    return ".".join(parts[1:])
+
+
+def classify_language_linear(module_name):
+    """返回 ``'quantized'`` / ``'bf16_island'`` / ``None``（不参与 W8A8 分类）。"""
+
+    suffix = language_linear_suffix(module_name)
+    if suffix is None:
+        return None
+    if suffix in QUANTIZED_LINEAR_SUFFIXES:
+        return "quantized"
+    if suffix in BF16_LINEAR_SUFFIXES:
+        return "bf16_island"
+    return None
+
+
+def manifest_parameter_name(module_name):
+    """HF language-model linear 模块名 -> pypto artifact manifest 参数名。
+
+    ``model.language_model.layers.7.self_attn.q_proj`` ->
+    ``layer_07_q_proj_weight``。非量化类返回 None。
+    """
+
+    suffix = language_linear_suffix(module_name)
+    if suffix is None:
+        return None
+    manifest_suffix = _MANIFEST_SUFFIX.get(suffix)
+    if manifest_suffix is None:
+        return None
+    parts = module_name[len(QWEN35_TEXT_PREFIX):].split(".")
+    layer_index = int(parts[1])
+    return "layer_{:02d}_{}_weight".format(layer_index, manifest_suffix)
+
+
+def official_name_for_manifest_parameter(parameter_name):
+    """pypto artifact manifest 参数名 -> HF 官方 safetensors 张量名。
+
+    ``layer_07_q_proj_weight`` -> ``model.language_model.layers.7.self_attn.q_proj.weight``。
+    """
+
+    if not parameter_name.startswith("layer_") or not parameter_name.endswith("_weight"):
+        raise ValueError("not a language-model linear parameter name: %r" % parameter_name)
+    body = parameter_name[len("layer_"):-len("_weight")]
+    parts = body.split("_", 1)
+    if len(parts) != 2 or not parts[0].isdigit():
+        raise ValueError("not a language-model linear parameter name: %r" % parameter_name)
+    layer_index = int(parts[0])
+    suffix = parts[1]
+    for module_suffix, manifest_suffix in _MANIFEST_SUFFIX.items():
+        if manifest_suffix == suffix:
+            return "{}layers.{}.{}.weight".format(QWEN35_TEXT_PREFIX, layer_index, module_suffix)
+    raise ValueError("unknown manifest suffix in %r" % parameter_name)
+
+
+def expected_quantized_manifest_names():
+    """返回 24 层 × 量化类 的 150 个 manifest 参数名（排序后）。"""
+
+    full_attention_indices = (3, 7, 11, 15, 19, 23)
+    linear_attention_indices = tuple(
+        index for index in range(24) if index not in full_attention_indices
+    )
+    names = []
+    for layer_index in linear_attention_indices:
+        for suffix in ("in_proj_qkv", "in_proj_z", "out_proj", "mlp_gate_proj",
+                       "mlp_up_proj", "mlp_down_proj"):
+            names.append("layer_{:02d}_{}_weight".format(layer_index, suffix))
+    for layer_index in full_attention_indices:
+        for suffix in ("q_proj", "k_proj", "v_proj", "o_proj",
+                       "mlp_gate_proj", "mlp_up_proj", "mlp_down_proj"):
+            names.append("layer_{:02d}_{}_weight".format(layer_index, suffix))
+    return sorted(names)
+
+
+#: 报告/审计用的精确公式伪代码（与契约 0002 §1.1 冻结表一致）。
+QUANT_FORMULA = {
+    "weight": (
+        "s_w[o] = fp32(fp64(max(|W[o,:]|)) / 127.0)   # per-output-channel absmax, fp32 scale\n"
+        "if absmax(W[o,:]) == 0: s_w[o] = 1.0, q_w[o,:] = 0   # Q1\n"
+        "ratio[o,k] = fp64(W[o,k]) / fp64(s_w[o])\n"
+        "q_w[o,k] = clip(rne(ratio[o,k]), -127, 127)  # RNE ties-to-even, code -128 rejected\n"
+        "W_fq[o,k] = fp32(fp32(q_w[o,k]) * fp32(s_w[o]))  # fake-quant dequantize"
+    ),
+    "activation": (
+        "s_a[r] = fp32(fp64(max(|A[r,:]|)) / 127.0)   # dynamic per-token absmax, fp32 scale\n"
+        "if absmax(A[r,:]) == 0: s_a[r] = 1.0, q_a[r,:] = 0   # Q1\n"
+        "ratio[r,k] = fp64(A[r,k]) / fp64(s_a[r])\n"
+        "q_a[r,k] = clip(rne(ratio[r,k]), -127, 127)\n"
+        "A_fq[r,k] = fp32(fp32(q_a[r,k]) * fp32(s_a[r]))"
+    ),
+    "linear": (
+        "y = fp32_accumulate(A_fq @ W_fq.T) + bias_fp32   # fake-quant, fp32 accumulate\n"
+        "y_out = cast_rne(y, output_dtype)  # bf16 for the deployment-faithful variant"
+    ),
+    "rejected": "NaN/Inf fail-closed (Q2); non-zero row with fp32 scale underflow fail-closed; K > 133144 fail-closed (Q5)",
+}
+
+__all__ = [
+    "QWEN35_TEXT_PREFIX",
+    "QWEN35_VISION_PREFIX",
+    "QWEN35_MTP_PREFIX",
+    "QUANTIZED_LINEAR_SUFFIXES",
+    "BF16_LINEAR_SUFFIXES",
+    "EXPECTED_QUANTIZED_LINEAR_COUNT",
+    "EXPECTED_BF16_LINEAR_COUNT",
+    "QUANT_FORMULA",
+    "classify_language_linear",
+    "language_linear_suffix",
+    "manifest_parameter_name",
+    "official_name_for_manifest_parameter",
+    "expected_quantized_manifest_names",
+]
