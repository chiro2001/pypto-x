+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""路径 (a)：复现我们 packer 的 int8 codes / fp32 scales payload。
+
+本脚本**故意导入 pypto**（我们自己的离线 ingestion 实现），是整个 Q2 任务里
+唯一这样做的进程。它通过 ``run_reference.py`` 之外的独立进程执行，因此 gold
+数据本体的产生路径仍然与 PyPTO-X 运行时完全隔离。
+
+复现口径与 ``python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py``
+的 W8A8 ingestion 完全一致：
+
+1. ``build_qwen35_text_decoder_graph(1, 5, past_length=0, precision='w8a8-linear',
+   quantized_linear_scope='default', quantize_lm_head=False)``；
+2. ``build_binding_schema`` / ``build_packed_layout``；
+3. ``SafetensorsReader`` + ``build_weight_mapping``（tied embedding 回退）；
+4. 对每个 ``entry.quant is not None`` 的 150 个参数调用
+   ``quantize_weight_from_view``；
+5. 用与 driver 完全相同的序列化方式重算
+   ``weight_scale_manifest_digest``，并与冻结 manifest 对拍。
+
+输出（供 ``audit_w8a8_scale.py`` 逐元素按位比对）：
+
+* ``--out-npz``：每个参数名 -> fp32 ``scales`` 数组；
+* ``--out-json``：per-tensor codes/scales sha256、重算 manifest digest 与
+  冻结 manifest 的匹配结果。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+
+def parse_args(argv):
+    parser = argparse.ArgumentParser(description="W8A8 side (a): reproduce our packer payload")
+    parser.add_argument("--assets-dir", required=True,
+                        help="本地冻结权重目录（含 config.json / *.safetensors）")
+    parser.add_argument("--checkpoint", required=True, help="safetensors 文件路径")
+    parser.add_argument("--manifest", required=True,
+                        help="冻结的 weight_scale_manifest.json（我们产物的 hash 记录）")
+    parser.add_argument("--out-npz", required=True)
+    parser.add_argument("--out-json", required=True)
+    return parser.parse_args(argv)
+
+
+def _manifest_digest(entries):
+    """与 driver ``build_w8a8_bindings`` 一致的 manifest digest 口径。"""
+
+    payload = json.dumps(
+        sorted(entries, key=lambda item: str(item["name"])),
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def main(argv=None):
+    args = parse_args(argv if argv is not None else sys.argv[1:])
+
+    import numpy as np
+
+    from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+    from pypto.portable.qwen35_w8a8_weight import quantize_weight_from_view
+    from pypto.portable.qwen35_weight_map import (
+        build_weight_mapping,
+        tie_word_embeddings_from_config,
+    )
+    from pypto.portable.runtime_binding import build_binding_schema, build_packed_layout
+    from pypto.portable.safetensors_reader import SafetensorsReader
+
+    program = build_qwen35_text_decoder_graph(
+        1, 5, past_length=0, shape_profile="model",
+        precision="w8a8-linear", quantized_linear_scope="default",
+        quantize_lm_head=False,
+    )
+    schema = build_binding_schema(program)
+    layout = build_packed_layout(schema)
+    print("[side-a] graph digest=%s w8a8_ops=%s regions=%d" % (
+        program.metadata.get("graph_digest"), program.metadata.get("w8a8_ops", "n/a"),
+        len(layout.regions)), flush=True)
+
+    with open(args.manifest, "r", encoding="utf-8") as handle:
+        frozen = json.load(handle)
+    frozen_by_name = dict((entry["name"], entry) for entry in frozen["tensors"])
+
+    tie = tie_word_embeddings_from_config(os.path.join(args.assets_dir, "config.json"))
+    reader = SafetensorsReader(args.checkpoint, mode="mmap")
+    manifest = []
+    scale_arrays = {}
+    per_tensor = []
+    with reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader,
+                                       tie_word_embeddings=tie)
+        by_name = dict((item.parameter, item) for item in mapping.mappings)
+        for entry in schema.parameters:
+            if entry.quant is None:
+                continue
+            item = by_name.get(entry.name)
+            if item is None:
+                raise RuntimeError("quantized parameter %r has no checkpoint mapping" % entry.name)
+            view = reader.view(item.source.official_name)
+            try:
+                quantized = quantize_weight_from_view(
+                    view, dtype=item.source.pypto_dtype, shape=entry.shape, name=entry.name
+                )
+            finally:
+                view.release()
+            manifest.append(quantized.manifest_entry())
+            scales = np.frombuffer(quantized.scales, dtype="<f4").astype(np.float32)
+            if scales.shape != (int(entry.shape[0]),):
+                raise RuntimeError("scale shape mismatch for %r" % entry.name)
+            scale_arrays[entry.name] = scales
+            frozen_entry = frozen_by_name.get(entry.name)
+            per_tensor.append({
+                "name": entry.name,
+                "official_name": item.source.official_name,
+                "shape": [int(dim) for dim in entry.shape],
+                "source_dtype": item.source.pypto_dtype,
+                "scales_sha256": quantized.scales_sha256,
+                "codes_sha256": quantized.codes_sha256,
+                "source_sha256": quantized.source_sha256,
+                "saturation_count": int(quantized.saturation_count),
+                "zero_row_count": int(quantized.zero_row_count),
+                "matches_frozen_scales_sha256": bool(
+                    frozen_entry is not None and
+                    frozen_entry["scales_sha256"] == quantized.scales_sha256
+                ),
+                "matches_frozen_codes_sha256": bool(
+                    frozen_entry is not None and
+                    frozen_entry["codes_sha256"] == quantized.codes_sha256
+                ),
+                "matches_frozen_source_sha256": bool(
+                    frozen_entry is not None and
+                    frozen_entry["source_sha256"] == quantized.source_sha256
+                ),
+            })
+
+    digest = _manifest_digest(manifest)
+    names = sorted(scale_arrays)
+    if names != sorted(frozen_by_name):
+        missing = sorted(set(frozen_by_name) - set(names))
+        extra = sorted(set(names) - set(frozen_by_name))
+        raise RuntimeError("side (a) tensor set mismatch: missing=%s extra=%s" % (missing, extra))
+
+    np.savez(args.out_npz, **dict((name, scale_arrays[name]) for name in names))
+    report = {
+        "schema": "pypto-x.c8-w8a8-scale-crosscheck.side-a.v1",
+        "role": "path (a): reproduce PyPTO-X packer payload (pypto imports live here only)",
+        "assets_dir": os.path.abspath(args.assets_dir),
+        "checkpoint": os.path.abspath(args.checkpoint),
+        "manifest_path": os.path.abspath(args.manifest),
+        "tensor_count": len(names),
+        "scale_payload_bytes": int(sum(int(scale_arrays[name].nbytes) for name in names)),
+        "recomputed_manifest_digest": digest,
+        "frozen_manifest_digest": frozen.get("weight_scale_manifest_digest"),
+        "matches_frozen_manifest_digest": bool(
+            digest == frozen.get("weight_scale_manifest_digest")
+        ),
+        "all_frozen_scales_sha256_match": all(
+            entry["matches_frozen_scales_sha256"] for entry in per_tensor
+        ),
+        "all_frozen_codes_sha256_match": all(
+            entry["matches_frozen_codes_sha256"] for entry in per_tensor
+        ),
+        "all_frozen_source_sha256_match": all(
+            entry["matches_frozen_source_sha256"] for entry in per_tensor
+        ),
+        "graph_digest": program.metadata.get("graph_digest"),
+        "packed_region_count": len(layout.regions),
+        "per_tensor": per_tensor,
+    }
+    with open(args.out_json, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, ensure_ascii=False, indent=2)
+    print("[side-a] tensors=%d digest_match=%s scales_sha256_all=%s" % (
+        len(names), report["matches_frozen_manifest_digest"],
+        report["all_frozen_scales_sha256_match"]), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
