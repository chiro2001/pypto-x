+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Q2 W8A8 fake-quant gold harness 的聚焦测试。
+
+覆盖：
+
+1. Python 3.7 AST 门槛（本目录全部 Q2 文件）；
+2. 量化公式：RNE ties-to-even、[-127,127] clamp（-128 被拒）、零行 Q1、
+   NaN/Inf fail-closed、fp32 scale；
+3. gold 侧两条独立实现（``w8a8_quant`` 的 ``np.rint`` 与
+   ``audit_w8a8_scale`` 的 floor/frac/parity）逐位一致；
+4. 与 C1 scalar golden（``pypto.portable.qwen35_w8a8_scheme``）的差分对拍
+   （只读导入 pypto，不涉及任何 runtime/后端）；
+5. 量化范围分类与 HF 名字映射（150 个量化类 / 36 个 BF16 孤岛）；
+6. ``w8a8_reference`` 的 per-token 激活量化（torch，缺 torch 时 skip）；
+7. band/margin 统计函数（torch，缺 torch 时 skip）。
+
+运行环境：base python3 可跑 1–5、7 的一部分；torch 相关项在缺少 torch 时
+显式 skip。完整运行建议用 reference venv 并安装 pytest，或由仓库 CI 环境执行。
+"""
+
+import ast
+import importlib
+import os
+import sys
+
+import numpy as np
+import pytest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO_ROOT = os.path.dirname(os.path.dirname(HERE))
+for path in (HERE, os.path.join(REPO_ROOT, "python")):
+    if path not in sys.path:
+        sys.path.insert(0, path)
+
+import audit_w8a8_scale  # noqa: E402
+import w8a8_quant  # noqa: E402
+import w8a8_scope  # noqa: E402
+
+
+PY37_FILES = (
+    "run_reference.py",
+    "w8a8_reference.py",
+    "w8a8_quant.py",
+    "w8a8_scope.py",
+    "packer_side_a.py",
+    "audit_w8a8_scale.py",
+    "test_w8a8_reference.py",
+)
+
+
+def _run_reference_module():
+    pytest.importorskip("torch")
+    pytest.importorskip("transformers")
+    return importlib.import_module("run_reference")
+
+
+def test_python37_ast_gate():
+    for name in PY37_FILES:
+        source = open(os.path.join(HERE, name), "r", encoding="utf-8").read()
+        ast.parse(source, filename=name, feature_version=(3, 7))
+
+
+def test_gold_path_has_no_pypto_imports():
+    """gold 产生路径（不含 packer_side_a 的独立进程）不得 import pypto。"""
+
+    forbidden = ("pypto", "pypto_x")
+    for name in ("run_reference.py", "w8a8_reference.py", "w8a8_quant.py", "w8a8_scope.py"):
+        tree = ast.parse(open(os.path.join(HERE, name), "r", encoding="utf-8").read())
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    assert alias.name.split(".")[0] not in forbidden, (name, alias.name)
+            elif isinstance(node, ast.ImportFrom):
+                module = node.module or ""
+                assert module.split(".")[0] not in forbidden, (name, module)
+    # packer_side_a 明确允许导入 pypto，但必须在 docstring 里声明隔离方式。
+    source = open(os.path.join(HERE, "packer_side_a.py"), "r", encoding="utf-8").read()
+    assert "故意导入 pypto" in source
+
+
+def test_scope_classification_counts():
+    names = w8a8_scope.expected_quantized_manifest_names()
+    assert len(names) == 150
+    assert len(set(names)) == 150
+    for name in (names[0], names[-1], "layer_07_q_proj_weight", "layer_00_in_proj_qkv_weight"):
+        official = w8a8_scope.official_name_for_manifest_parameter(name)
+        assert official.startswith("model.language_model.layers.")
+        module = official[:-len(".weight")]
+        assert w8a8_scope.manifest_parameter_name(module) == name
+    assert w8a8_scope.classify_language_linear(
+        "model.language_model.layers.0.linear_attn.in_proj_b"
+    ) == "bf16_island"
+    assert w8a8_scope.classify_language_linear(
+        "model.language_model.layers.3.self_attn.q_proj"
+    ) == "quantized"
+    assert w8a8_scope.classify_language_linear("model.visual.blocks.0.attn.qkv") is None
+    assert w8a8_scope.classify_language_linear("lm_head") is None
+
+
+def test_weight_formula_hand_values():
+    weight = np.asarray([
+        [1.0, -2.0, 0.0, 0.5],
+        [0.0, 0.0, 0.0, 0.0],
+        [3.0, -3.0, 1.5, 0.25],
+    ], dtype=np.float32)
+    codes, scales, stats = w8a8_quant.quantize_weight_per_output_channel(weight, name="hand")
+    assert np.array_equal(
+        scales, np.asarray([2.0 / 127.0, 1.0, 3.0 / 127.0], dtype=np.float32)
+    )
+    assert list(codes[0]) == [64, -127, 0, 32]
+    assert list(codes[1]) == [0, 0, 0, 0]
+    assert list(codes[2]) == [127, -127, 64, 11]
+    assert stats["zero_row_count"] == 1
+    assert stats["saturation_count"] == 0
+    assert int(codes.min()) >= -127 and int(codes.max()) <= 127
+
+
+def test_rne_ties_and_minus_128_rejection():
+    ratios = np.asarray([[0.5, 1.5, 2.5, -0.5, -1.5, -2.5, 127.0, -127.0, -127.6]],
+                        dtype=np.float64)
+    rounded = audit_w8a8_scale.rne_ties_to_even(ratios)
+    assert list(rounded[0][:6]) == [0.0, 2.0, 2.0, 0.0, -2.0, -2.0]
+    assert list(rounded[0][6:]) == [127.0, -127.0, -128.0]
+
+    # 直接对"ratio 已超出 -127"的输入调用 clamp：np.clip 必须落在 [-127,127]，
+    # 且 -128 永远不出现（D8）。
+    clamped = np.clip(rounded, w8a8_quant.QUANT_MIN, w8a8_quant.QUANT_MAX)
+    assert int(np.min(clamped)) == -127
+    assert -128 not in set(int(item) for item in clamped.reshape(-1))
+
+    # 人为构造 ratio = -128 的合法路径很难通过 absmax 触发（Q3 的饱和计数在
+    # scalar golden 里有独立测试），这里验证公式不会产出 -128。
+    codes, _scales, _stats = w8a8_quant.quantize_weight_per_output_channel(
+        np.asarray([[127.6, 127.4, -127.6, 0.0]], dtype=np.float32), name="clamp"
+    )
+    assert int(codes.min()) >= -127
+    assert -128 not in set(int(item) for item in codes.reshape(-1))
+
+
+def test_zero_row_and_nonfinite_fail_closed():
+    weight = np.zeros((2, 3), dtype=np.float32)
+    codes, scales, stats = w8a8_quant.quantize_weight_per_output_channel(weight, name="zero")
+    assert np.array_equal(scales, np.asarray([1.0, 1.0], dtype=np.float32))
+    assert np.count_nonzero(codes) == 0
+    assert stats["zero_row_count"] == 2
+
+    bad = weight.copy()
+    bad[0, 1] = np.nan
+    with pytest.raises(w8a8_quant.W8A8QuantError):
+        w8a8_quant.quantize_weight_per_output_channel(bad, name="nan")
+
+
+def test_gold_two_implementations_bitwise_equal():
+    rng = np.random.RandomState(20260911)
+    for shape in ((5, 7), (1, 1024), (16, 1024), (3, 3584)):
+        raw = rng.randn(*shape).astype(np.float32) * 0.37
+        raw[0] = 0.0
+        raw[-1, 0] = 0.5
+        raw[-1, 1] = -0.5
+        codes_a, scales_a, stats_a = w8a8_quant.quantize_weight_per_output_channel(raw)
+        codes_b, scales_b, stats_b = audit_w8a8_scale.independent_quantize_weight(raw, "diff")
+        assert np.array_equal(
+            np.ascontiguousarray(scales_a, dtype=np.float32).view(np.uint32),
+            np.ascontiguousarray(scales_b, dtype=np.float32).view(np.uint32),
+        )
+        assert np.array_equal(codes_a, codes_b)
+        assert stats_a["saturation_count"] == stats_b["saturation_count"]
+        assert stats_a["zero_row_count"] == stats_b["zero_row_count"]
+
+
+def test_c1_scalar_golden_differential():
+    """与 pypto C1 golden 对拍（只读量化公式，不触碰 runtime）。"""
+
+    os.environ.setdefault("PYPTO_X_PORTABLE_ONLY", "1")
+    scheme = pytest.importorskip("pypto.portable.qwen35_w8a8_scheme")
+    rng = np.random.RandomState(7)
+    for shape in ((4, 8), (16, 1024), (2, 37)):
+        raw = rng.randn(*shape).astype(np.float32) * 0.21
+        raw[0] = 0.0
+        codes, scales, stats = w8a8_quant.quantize_weight_per_output_channel(raw)
+        golden = scheme.quantize_per_token_s8(raw.reshape(-1).tolist(), shape=shape)
+        assert list(golden.codes) == [int(item) for item in codes.reshape(-1)]
+        golden_scales = np.asarray(golden.scales, dtype=np.float32)
+        assert np.array_equal(golden_scales.view(np.uint32), scales.view(np.uint32))
+        assert golden.saturation_count == stats["saturation_count"]
+
+
+def test_activation_quantization_torch():
+    torch = pytest.importorskip("torch")
+    reference = pytest.importorskip("w8a8_reference")
+    activation = torch.tensor(
+        [[1.0, -2.0, 0.0, 0.5], [0.0, 0.0, 0.0, 0.0]],
+        dtype=torch.bfloat16,
+    )
+    dequantized, stats = reference._quantize_activation(activation)
+    assert dequantized.dtype == torch.float32
+    assert stats["rows"] == 2
+    assert stats["zero_row_count"] == 1
+    expected_scale = np.float32(2.0 / 127.0)
+    plain = np.asarray([1.0, -2.0, 0.0, 0.5], dtype=np.float32)
+    expected = (np.rint(plain.astype(np.float64) / float(expected_scale))
+                .astype(np.float32) * expected_scale).astype(np.float32)
+    actual = dequantized[0].numpy().astype(np.float32)
+    assert np.array_equal(actual.view(np.uint32), expected.view(np.uint32))
+    assert np.count_nonzero(dequantized[1].numpy()) == 0
+
+
+def test_apply_fake_quant_scope_construction():
+    """用 tiny mock 模型验证 150/36 范围、孤岛保持与 hook 覆盖（不需要真实权重）。"""
+
+    torch = pytest.importorskip("torch")
+    reference = pytest.importorskip("w8a8_reference")
+    nn = torch.nn
+
+    class MockModel(nn.Module):
+        def __init__(self):
+            super(MockModel, self).__init__()
+            self.model = nn.Module()
+            self.model.language_model = nn.Module()
+            language = self.model.language_model
+            language.embed_tokens = nn.Embedding(8, 4)
+            language.layers = nn.ModuleList()
+            full_attention_indices = (3, 7, 11, 15, 19, 23)
+            for index in range(24):
+                layer = nn.Module()
+                if index in full_attention_indices:
+                    attention = nn.Module()
+                    attention.q_proj = nn.Linear(4, 4, bias=False)
+                    attention.k_proj = nn.Linear(4, 4, bias=False)
+                    attention.v_proj = nn.Linear(4, 4, bias=False)
+                    attention.o_proj = nn.Linear(4, 4, bias=False)
+                    layer.self_attn = attention
+                else:
+                    attention = nn.Module()
+                    attention.in_proj_qkv = nn.Linear(4, 4, bias=False)
+                    attention.in_proj_z = nn.Linear(4, 4, bias=False)
+                    attention.in_proj_b = nn.Linear(4, 4, bias=False)
+                    attention.in_proj_a = nn.Linear(4, 4, bias=False)
+                    attention.out_proj = nn.Linear(4, 4, bias=False)
+                    attention.conv1d = nn.Conv1d(4, 4, 1, groups=4, bias=False)
+                    layer.linear_attn = attention
+                mlp = nn.Module()
+                mlp.gate_proj = nn.Linear(4, 4, bias=False)
+                mlp.up_proj = nn.Linear(4, 4, bias=False)
+                mlp.down_proj = nn.Linear(4, 4, bias=False)
+                layer.mlp = mlp
+                language.layers.append(layer)
+            self.lm_head = nn.Linear(4, 8, bias=False)
+            self.lm_head.weight = language.embed_tokens.weight
+
+        def forward(self, hidden):
+            for layer in self.model.language_model.layers:
+                if hasattr(layer, "self_attn"):
+                    hidden = layer.self_attn.q_proj(hidden)
+                    hidden = layer.self_attn.k_proj(hidden)
+                    hidden = layer.self_attn.v_proj(hidden)
+                    hidden = layer.self_attn.o_proj(hidden)
+                else:
+                    hidden = layer.linear_attn.in_proj_qkv(hidden)
+                    hidden = layer.linear_attn.in_proj_z(hidden)
+                    hidden = layer.linear_attn.in_proj_b(hidden)
+                    hidden = layer.linear_attn.in_proj_a(hidden)
+                    hidden = layer.linear_attn.out_proj(hidden)
+                hidden = layer.mlp.gate_proj(hidden)
+                hidden = layer.mlp.up_proj(hidden)
+                hidden = layer.mlp.down_proj(hidden)
+            return hidden
+
+        def get_input_embeddings(self):
+            return self.model.language_model.embed_tokens
+
+        def get_output_embeddings(self):
+            return self.lm_head
+
+    model = MockModel().to(torch.bfloat16).eval()
+    audit = reference.apply_fake_quant(model, "w8a8")
+    assert audit["scope"]["quantized_module_count"] == 150
+    assert audit["scope"]["bf16_island_module_count"] == 36
+    assert audit["scope"]["conv1d_module_count"] == 18
+    assert audit["all_assertions_pass"] is True
+    assert audit["activation_quant_source"].startswith("activation as executed")
+
+    with torch.no_grad():
+        model(torch.zeros(1, 3, 4, dtype=torch.bfloat16))
+    reference.refresh_activation_stats(audit)
+    coverage = audit["activation_module_coverage"]
+    assert coverage["complete"] is True
+    assert coverage["expected"] == 150
+
+    # 36 个孤岛 + conv1d + lm_head 在构造上保持 bf16 且未被改指针。
+    for item in audit["island_checks"]:
+        assert item["weight_dtype"] == "bfloat16"
+        assert item["weight_unchanged"] is True
+
+
+def test_band_stats_and_margin():
+    run_reference = _run_reference_module()
+    rng = np.random.RandomState(3)
+    reference = rng.randn(6, 32).astype(np.float64)
+    candidate = reference + 0.01
+    stats = run_reference.band_stats(reference, candidate)
+    assert abs(stats["max_abs"] - 0.01) < 1e-12
+    assert stats["row_argmax_equal"] is True
+    margins = run_reference.margin_stats(reference, 0.01)
+    assert margins["rows"] == 6
+    assert len(margins["near_tie_rows"]) == margins["near_tie_count"]
+
+
+def test_band_stats_hidden_layers_per_layer():
+    run_reference = _run_reference_module()
+    rng = np.random.RandomState(4)
+    reference = rng.randn(3, 5, 8)
+    candidate = reference * 1.001
+    stats = run_reference.band_stats(reference, candidate)
+    assert len(stats["per_layer"]) == 3
+    assert stats["min_cosine_layer"]["layer"] in (0, 1, 2)
+
+
+def _write_synthetic_side_a(tmp_path, perturb_first_scale=False):
+    """构造 2 张量的合成 safetensors + manifest + side (a) payload，供 plumbing 测试。"""
+
+    import hashlib
+    import json
+
+    torch = pytest.importorskip("torch")
+    safetensors_torch = pytest.importorskip("safetensors.torch")
+
+    names = ["layer_00_in_proj_qkv_weight", "layer_03_q_proj_weight"]
+    rng = np.random.RandomState(11)
+    tensors = {}
+    values_by_name = {}
+    for name in names:
+        official = w8a8_scope.official_name_for_manifest_parameter(name)
+        values = (rng.randn(3, 4).astype(np.float32) * 0.3)
+        tensors[official] = torch.from_numpy(values).to(torch.bfloat16)
+        values_by_name[name] = values
+    checkpoint = tmp_path / "model.safetensors"
+    safetensors_torch.save_file(tensors, str(checkpoint))
+
+    manifest_entries = []
+    side_a_entries = []
+    scale_payload = {}
+    for name in names:
+        official = w8a8_scope.official_name_for_manifest_parameter(name)
+        tensor = tensors[official].contiguous()
+        raw = tensor.view(torch.uint16).numpy().tobytes()
+        values = tensor.to(torch.float32).numpy()
+        codes, scales, stats = audit_w8a8_scale.independent_quantize_weight(values, name)
+        if perturb_first_scale and name == names[0]:
+            bits = np.ascontiguousarray(scales, dtype=np.float32).view(np.uint32)
+            bits[0] += 1
+            scales = bits.view(np.float32).copy()
+        scale_payload[name] = scales
+        codes_sha = hashlib.sha256(
+            np.ascontiguousarray(codes, dtype=np.int8).tobytes()
+        ).hexdigest()
+        scales_sha = hashlib.sha256(
+            np.ascontiguousarray(scales, dtype="<f4").tobytes()
+        ).hexdigest()
+        source_sha = hashlib.sha256(raw).hexdigest()
+        manifest_entries.append({
+            "name": name,
+            "source_sha256": source_sha,
+            "scales_sha256": scales_sha,
+            "codes_sha256": codes_sha,
+            "saturation_count": stats["saturation_count"],
+            "zero_row_count": stats["zero_row_count"],
+        })
+        side_a_entries.append({
+            "name": name,
+            "scales_sha256": scales_sha,
+            "codes_sha256": codes_sha,
+            "matches_frozen_scales_sha256": True,
+        })
+
+    manifest_path = tmp_path / "manifest.json"
+    manifest_path.write_text(json.dumps({"tensors": manifest_entries}), encoding="utf-8")
+    npz_path = tmp_path / "side_a.npz"
+    np.savez(str(npz_path), **scale_payload)
+    side_a_json = tmp_path / "side_a.json"
+    side_a_json.write_text(json.dumps({
+        "recomputed_manifest_digest": "synthetic",
+        "frozen_manifest_digest": "synthetic",
+        "matches_frozen_manifest_digest": True,
+        "all_frozen_scales_sha256_match": True,
+        "all_frozen_codes_sha256_match": True,
+        "all_frozen_source_sha256_match": True,
+        "per_tensor": side_a_entries,
+    }), encoding="utf-8")
+    return checkpoint, manifest_path, npz_path, side_a_json
+
+
+def test_audit_script_plumbing_pass(tmp_path):
+    checkpoint, manifest, npz_path, side_a_json = _write_synthetic_side_a(tmp_path)
+    out = tmp_path / "crosscheck.json"
+    code = audit_w8a8_scale.main([
+        "--checkpoint", str(checkpoint),
+        "--manifest", str(manifest),
+        "--side-a-npz", str(npz_path),
+        "--side-a-json", str(side_a_json),
+        "--out", str(out),
+    ])
+    assert code == 0
+    report_json = __import__("json").loads(out.read_text(encoding="utf-8"))
+    assert report_json["summary"]["scale_all_bitwise_equal"] is True
+    assert report_json["summary"]["compared_tensor_count"] == 2
+
+
+def test_audit_script_plumbing_reports_one_ulp_diff(tmp_path):
+    checkpoint, manifest, npz_path, side_a_json = _write_synthetic_side_a(
+        tmp_path, perturb_first_scale=True
+    )
+    out = tmp_path / "crosscheck.json"
+    code = audit_w8a8_scale.main([
+        "--checkpoint", str(checkpoint),
+        "--manifest", str(manifest),
+        "--side-a-npz", str(npz_path),
+        "--side-a-json", str(side_a_json),
+        "--out", str(out),
+    ])
+    assert code == 1
+    report_json = __import__("json").loads(out.read_text(encoding="utf-8"))
+    assert report_json["summary"]["scale_all_bitwise_equal"] is False
+    assert report_json["summary"]["scale_max_ulp_distance"] == 1
+    assert report_json["summary"]["scale_tensors_with_any_diff"] == [
+        "layer_00_in_proj_qkv_weight"
+    ]
