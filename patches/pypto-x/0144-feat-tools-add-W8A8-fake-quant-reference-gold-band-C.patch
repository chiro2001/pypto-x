+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""路径 (b) + 逐元素按位比对：从冻结 BF16 权重独立重算 per-channel scale。
+
+本脚本**不导入 pypto / torch**，只使用标准库 + numpy：
+
+* 自带最小 safetensors 头部解析（只读 header + 指定 tensor 的原始字节），
+  直接从冻结的 BF16 权重解码（``uint16 << 16``），并核对 manifest 的
+  per-tensor ``source_sha256``；
+* 用与 gold 的 ``w8a8_quant.py`` **不同表达式**的 RNE 实现
+  （``floor + frac + parity``，而不是 ``np.rint``）独立重算
+  ``s_w[o] = fp32(fp64(absmax)/127.0)`` 与 codes；
+* 与路径 (a)（我们 packer 复现的 payload）逐元素按位比对 scale，
+  并对比 codes 的 sha256；
+* 额外用 gold 的 ``w8a8_quant.py`` 向量化实现复算一遍，验证 gold 自身
+  两条实现路径一致（互证，不参与"是否与 pypto 一致"的结论）。
+
+输出机器可读 JSON；任何不一致都逐张量列出（max relative diff、max ULP、
+第一个差异位置的位模式），不做静默对齐。
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import struct
+import sys
+
+import numpy as np
+
+try:
+    import w8a8_quant
+    import w8a8_scope
+except ImportError:  # pragma: no cover - 包方式导入
+    from . import w8a8_quant
+    from . import w8a8_scope
+
+
+QUANT_MIN = -127
+QUANT_MAX = 127
+SCALE_DENOMINATOR = 127.0
+
+
+def parse_args(argv):
+    parser = argparse.ArgumentParser(description="W8A8 scale path (b) + bitwise cross-check")
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--manifest", required=True)
+    parser.add_argument("--side-a-npz", required=True)
+    parser.add_argument("--side-a-json", required=True)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--max-detail", type=int, default=8,
+                        help="每个不一致张量最多报告多少个差异位置")
+    return parser.parse_args(argv)
+
+
+def read_safetensors_index(path):
+    """最小 safetensors 只读解析：返回 (header, data_base, file_size)。"""
+
+    file_size = os.path.getsize(path)
+    with open(path, "rb") as handle:
+        head = handle.read(8)
+        if len(head) != 8:
+            raise ValueError("truncated safetensors header length")
+        header_bytes = struct.unpack("<Q", head)[0]
+        if header_bytes <= 0 or header_bytes > 128 * 1024 * 1024:
+            raise ValueError("implausible safetensors header size %d" % header_bytes)
+        payload = handle.read(header_bytes)
+        if len(payload) != header_bytes:
+            raise ValueError("truncated safetensors header")
+    header = json.loads(payload.decode("utf-8"))
+    data_base = 8 + header_bytes
+    return header, data_base, file_size
+
+
+def read_tensor_bytes(path, header, data_base, name):
+    entry = header.get(name)
+    if entry is None:
+        raise KeyError("tensor %r not found in safetensors header" % name)
+    start, end = [int(value) for value in entry["data_offsets"]]
+    if start < 0 or end < start or data_base + end > os.path.getsize(path):
+        raise ValueError("tensor %r offsets [%d,%d) out of bounds" % (name, start, end))
+    with open(path, "rb") as handle:
+        handle.seek(data_base + start)
+        raw = handle.read(end - start)
+    if len(raw) != end - start:
+        raise ValueError("short read for tensor %r" % name)
+    return raw
+
+
+def decode_bf16(raw, shape):
+    elements = 1
+    for dim in shape:
+        elements *= int(dim)
+    if len(raw) != elements * 2:
+        raise ValueError("byte count does not match BF16 shape")
+    words = np.frombuffer(raw, dtype="<u2").astype(np.uint32)
+    values = (words << 16).view(np.float32).reshape(tuple(int(dim) for dim in shape))
+    return values
+
+
+def rne_ties_to_even(ratios):
+    """与 ``np.rint`` 不同的 RNE 表达式：floor + frac + parity。"""
+
+    floor = np.floor(ratios)
+    fraction = ratios - floor
+    parity_even = np.mod(floor, 2.0) == 0.0
+    rounded = np.where(
+        fraction < 0.5,
+        floor,
+        np.where(fraction > 0.5, floor + 1.0, np.where(parity_even, floor, floor + 1.0)),
+    )
+    return rounded
+
+
+def independent_quantize_weight(values_bf16, name):
+    """路径 (b)：逐行独立重算 codes/scales/统计。"""
+
+    values = np.asarray(values_bf16, dtype=np.float32)
+    if values.ndim != 2:
+        raise ValueError("weight %r must be rank 2" % name)
+    rows, columns = int(values.shape[0]), int(values.shape[1])
+    if columns > w8a8_quant.MAX_ACCUMULATOR_K:
+        raise ValueError("K exceeds INT32 accumulation limit (Q5)")
+    if not bool(np.isfinite(values).all()):
+        raise ValueError("weight %r contains NaN/Inf (Q2)" % name)
+    # 刻意走 fp64 的 abs，和 packer 的 fp32 abs 是不同表达式（BF16 值两者精确）。
+    absmax = np.max(np.abs(values.astype(np.float64)), axis=1)
+    zero_rows = absmax == 0.0
+    scales = (absmax / SCALE_DENOMINATOR).astype(np.float32)
+    if bool(np.any((scales == np.float32(0.0)) & ~zero_rows)):
+        raise ValueError("weight %r non-zero row scale underflows to 0" % name)
+    scales = scales.copy()
+    scales[zero_rows] = np.float32(1.0)
+    ratios = values.astype(np.float64) / scales.astype(np.float64)[:, None]
+    rounded = rne_ties_to_even(ratios)
+    saturation = int(np.count_nonzero((rounded < QUANT_MIN) | (rounded > QUANT_MAX)))
+    codes = np.clip(rounded, QUANT_MIN, QUANT_MAX).astype(np.int8)
+    codes[zero_rows] = np.int8(0)
+    return codes, scales, {
+        "rows": rows,
+        "columns": columns,
+        "saturation_count": saturation,
+        "zero_row_count": int(np.count_nonzero(zero_rows)),
+        "max_abs": float(absmax.max()) if rows else 0.0,
+    }
+
+
+def sha256_hex(payload):
+    return hashlib.sha256(payload).hexdigest()
+
+
+def bitwise_scale_stats(left, right):
+    left = np.ascontiguousarray(left, dtype=np.float32)
+    right = np.ascontiguousarray(right, dtype=np.float32)
+    if left.shape != right.shape:
+        return {"shape_mismatch": [list(left.shape), list(right.shape)]}
+    left_bits = left.view(np.uint32)
+    right_bits = right.view(np.uint32)
+    unequal = left_bits != right_bits
+    diff_count = int(np.count_nonzero(unequal))
+    stats = {
+        "elements": int(left.size),
+        "bitwise_equal": diff_count == 0,
+        "diff_count": diff_count,
+        "max_abs_diff": float(np.max(np.abs(left.astype(np.float64) -
+                                             right.astype(np.float64)))) if left.size else 0.0,
+        "max_rel_diff": float(np.max(
+            np.abs(left.astype(np.float64) - right.astype(np.float64)) /
+            np.maximum(np.abs(left.astype(np.float64)), 1e-45)
+        )) if left.size else 0.0,
+        "max_ulp_distance": None,
+    }
+    for sign, label in ((1, "positive"), (-1, "negative")):
+        mask = np.signbit(left) == (sign < 0)
+        mask &= np.signbit(right) == (sign < 0)
+        if not mask.any():
+            continue
+        distance = np.abs(left_bits[mask].astype(np.int64) - right_bits[mask].astype(np.int64))
+        current = stats["max_ulp_distance"]
+        candidate = int(distance.max())
+        stats["max_ulp_distance"] = candidate if current is None else max(current, candidate)
+    if diff_count:
+        positions = np.flatnonzero(unequal.reshape(-1))[:8]
+        stats["diff_positions"] = [
+            {
+                "index": int(position),
+                "left_bits": "0x%08x" % int(left_bits.reshape(-1)[position]),
+                "right_bits": "0x%08x" % int(right_bits.reshape(-1)[position]),
+                "left": float(left.reshape(-1)[position]),
+                "right": float(right.reshape(-1)[position]),
+            }
+            for position in positions
+        ]
+    return stats
+
+
+def main(argv=None):
+    args = parse_args(argv if argv is not None else sys.argv[1:])
+
+    with open(args.manifest, "r", encoding="utf-8") as handle:
+        frozen = json.load(handle)
+    frozen_by_name = dict((entry["name"], entry) for entry in frozen["tensors"])
+    with open(args.side_a_json, "r", encoding="utf-8") as handle:
+        side_a = json.load(handle)
+    side_a_by_name = dict((entry["name"], entry) for entry in side_a["per_tensor"])
+    with np.load(args.side_a_npz) as loaded:
+        side_a_scales = dict((name, np.asarray(loaded[name], dtype=np.float32))
+                             for name in loaded.files)
+
+    header, data_base, file_size = read_safetensors_index(args.checkpoint)
+
+    per_tensor = []
+    total_elements = 0
+    tensors_with_diff = []
+    max_ulp_overall = 0
+    max_rel_overall = 0.0
+    codes_hash_mismatch = []
+    source_hash_mismatch = []
+    gold_formula_mismatch = []
+    missing = []
+
+    for name in sorted(frozen_by_name):
+        official = w8a8_scope.official_name_for_manifest_parameter(name)
+        if official not in header:
+            missing.append(name)
+            continue
+        shape = header[official]["shape"]
+        raw = read_tensor_bytes(args.checkpoint, header, data_base, official)
+        source_hash = sha256_hex(raw)
+        values = decode_bf16(raw, shape)
+        codes, scales, stats = independent_quantize_weight(values, name)
+        codes_sha = sha256_hex(np.ascontiguousarray(codes, dtype=np.int8).tobytes())
+        scales_sha = sha256_hex(np.ascontiguousarray(scales, dtype="<f4").tobytes())
+
+        gold_codes, gold_scales, gold_stats = w8a8_quant.quantize_weight_per_output_channel(
+            values, name=name
+        )
+        gold_scale_bits_equal = bool(np.array_equal(
+            np.ascontiguousarray(scales, dtype=np.float32).view(np.uint32),
+            np.ascontiguousarray(gold_scales, dtype=np.float32).view(np.uint32),
+        ))
+        gold_codes_equal = bool(np.array_equal(
+            np.ascontiguousarray(codes, dtype=np.int8),
+            np.ascontiguousarray(gold_codes, dtype=np.int8),
+        ))
+        if not (gold_scale_bits_equal and gold_codes_equal):
+            gold_formula_mismatch.append(name)
+
+        side = side_a_by_name.get(name)
+        if side is None:
+            missing.append(name)
+            continue
+        scale_stats = bitwise_scale_stats(scales, side_a_scales.get(name))
+        frozen_entry = frozen_by_name[name]
+        entry = {
+            "name": name,
+            "official_name": official,
+            "shape": [int(dim) for dim in shape],
+            "elements": int(scales.size),
+            "path_b_scales_sha256": scales_sha,
+            "path_a_scales_sha256": side["scales_sha256"],
+            "manifest_scales_sha256": frozen_entry["scales_sha256"],
+            "scales_sha256_matches_manifest": bool(scales_sha == frozen_entry["scales_sha256"]),
+            "path_a_matches_manifest": bool(side["matches_frozen_scales_sha256"]),
+            "path_b_codes_sha256": codes_sha,
+            "path_a_codes_sha256": side["codes_sha256"],
+            "manifest_codes_sha256": frozen_entry["codes_sha256"],
+            "codes_sha256_matches_manifest": bool(codes_sha == frozen_entry["codes_sha256"]),
+            "source_sha256_matches_manifest": bool(source_hash == frozen_entry["source_sha256"]),
+            "gold_formula_agrees_bitwise": bool(gold_scale_bits_equal and gold_codes_equal),
+            "independent_saturation_count": int(stats["saturation_count"]),
+            "independent_zero_row_count": int(stats["zero_row_count"]),
+            "manifest_saturation_count": int(frozen_entry["saturation_count"]),
+            "manifest_zero_row_count": int(frozen_entry["zero_row_count"]),
+            "scale_comparison_a_vs_b": scale_stats,
+        }
+        per_tensor.append(entry)
+        total_elements += int(scales.size)
+        if not scale_stats.get("bitwise_equal", False):
+            tensors_with_diff.append(name)
+        if scale_stats.get("max_ulp_distance"):
+            max_ulp_overall = max(max_ulp_overall, int(scale_stats["max_ulp_distance"]))
+        max_rel_overall = max(max_rel_overall, float(scale_stats.get("max_rel_diff") or 0.0))
+        if codes_sha != frozen_entry["codes_sha256"]:
+            codes_hash_mismatch.append(name)
+        if source_hash != frozen_entry["source_sha256"]:
+            source_hash_mismatch.append(name)
+
+    report = {
+        "schema": "pypto-x.c8-w8a8-scale-crosscheck.v1",
+        "task": "c8-w8a8-reference-gold",
+        "method": {
+            "path_a": "PyPTO-X packer payload reproduced by tools/qwen35_reference/packer_side_a.py and hash-pinned to the frozen weight_scale_manifest.json",
+            "path_b": "independent numpy safetensors raw decode + floor/frac/parity RNE per-output-channel absmax formula, from the frozen BF16 checkpoint",
+            "comparison": "per-element IEEE-754 bitwise on fp32 scales; codes additionally compared by sha256",
+            "note": "path (a) is a separate process that imports pypto; run_reference.py itself never imports pypto",
+        },
+        "inputs": {
+            "checkpoint": os.path.abspath(args.checkpoint),
+            "checkpoint_bytes": int(file_size),
+            "manifest": os.path.abspath(args.manifest),
+            "side_a_npz": os.path.abspath(args.side_a_npz),
+            "side_a_json": os.path.abspath(args.side_a_json),
+        },
+        "side_a": {
+            "recomputed_manifest_digest": side_a["recomputed_manifest_digest"],
+            "frozen_manifest_digest": side_a["frozen_manifest_digest"],
+            "matches_frozen_manifest_digest": side_a["matches_frozen_manifest_digest"],
+            "all_frozen_scales_sha256_match": side_a["all_frozen_scales_sha256_match"],
+            "all_frozen_codes_sha256_match": side_a["all_frozen_codes_sha256_match"],
+            "all_frozen_source_sha256_match": side_a["all_frozen_source_sha256_match"],
+        },
+        "summary": {
+            "frozen_tensor_count": len(frozen_by_name),
+            "compared_tensor_count": len(per_tensor),
+            "missing_tensors": missing,
+            "scale_elements_compared": total_elements,
+            "scale_all_bitwise_equal": len(tensors_with_diff) == 0 and not missing,
+            "scale_tensors_with_any_diff": tensors_with_diff,
+            "scale_max_ulp_distance": max_ulp_overall,
+            "scale_max_relative_diff": max_rel_overall,
+            "codes_sha256_all_match_manifest": len(codes_hash_mismatch) == 0 and not missing,
+            "codes_sha256_mismatch_tensors": codes_hash_mismatch,
+            "source_sha256_all_match_manifest": len(source_hash_mismatch) == 0 and not missing,
+            "source_sha256_mismatch_tensors": source_hash_mismatch,
+            "gold_internal_two_implementations_bitwise_equal": len(gold_formula_mismatch) == 0,
+            "gold_internal_mismatch_tensors": gold_formula_mismatch,
+        },
+        "per_tensor": per_tensor,
+    }
+    with open(args.out, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, ensure_ascii=False, indent=2)
+
+    summary = report["summary"]
+    print("[audit] tensors=%d scale_bitwise_all=%s max_ulp=%s max_rel=%.3g codes_all=%s" % (
+        summary["compared_tensor_count"],
+        summary["scale_all_bitwise_equal"],
+        summary["scale_max_ulp_distance"],
+        summary["scale_max_relative_diff"],
+        summary["codes_sha256_all_match_manifest"],
+    ), flush=True)
+    return 0 if summary["scale_all_bitwise_equal"] else 1
