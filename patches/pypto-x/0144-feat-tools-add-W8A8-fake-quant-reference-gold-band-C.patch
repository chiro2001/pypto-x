@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8A8 fake-quant 的纯 numpy 量化公式（契约 0002 §1.1/§1.4 冻结）。
+
+本模块是 gold 生成路径的一部分，**只允许 numpy**：不导入 pypto / torch。
+它与 ``run_reference.py`` 的 fake-quant 引擎共享，保证 gold 里权重与激活的
+量化语义完全一致。
+
+冻结规则（契约 0002 §1.1 / §1.4 / D7 / D8）：
+
+* 权重：per-output-channel 对称 absmax，``s_w[o] = max(|W[o,:]|)/127``，
+  RNE ties-to-even，码值 clamp 到 ``[-127, 127]``（**拒绝 -128**），scale 为 fp32；
+* 激活：动态 per-token 对称，``s_a[r] = max(|A[r,:]|)/127``，其余同上；
+* Q1 整行全零：``s = 1.0``、``q = 0``；
+* Q2 行内 NaN/Inf：显式报错（fail-closed），不静默 clamp；
+* Q3 饱和计数上报；
+* Q5 ``K <= 133144``（INT32 累加上限），超过显式拒绝。
+
+实现的算术顺序刻意与 pypto packer 的 ``qwen35_w8a8_weight.py`` 对齐：
+absmax 在 fp32 上取（BF16 值在 fp32 中精确），scale 在 fp64 除法后单次
+round 到 fp32，ratio 在 fp64 中计算后 RNE。
+"""
+
+from __future__ import unicode_literals
+
+import numpy as np
+
+
+QUANT_BITS = 8
+QUANT_MIN = -127
+QUANT_MAX = 127
+ZERO_POINT = 0
+SCALE_DENOMINATOR = 127.0
+MAX_ACCUMULATOR_K = (2 ** 31 - 1) // (QUANT_MAX * QUANT_MAX)
+
+
+class W8A8QuantError(ValueError):
+    """量化输入违反冻结 scheme（fail-closed）。"""
+
+
+def _require_finite(array, context):
+    if not bool(np.isfinite(array).all()):
+        raise W8A8QuantError("%s contains NaN/Inf; quantize fails closed (Q2)" % context)
+
+
+def _scale_from_absmax(absmax_fp32, context):
+    """``fp32(fp64(absmax)/127)``；返回 (scales, zero_rows mask)。"""
+
+    absmax = np.asarray(absmax_fp32, dtype=np.float32)
+    zero_rows = absmax == np.float32(0.0)
+    scales = (absmax.astype(np.float64) / SCALE_DENOMINATOR).astype(np.float32)
+    if bool(np.any((scales == np.float32(0.0)) & ~zero_rows)):
+        raise W8A8QuantError(
+            "%s has a non-zero row whose float32 scale underflows to 0" % context
+        )
+    scales = scales.copy()
+    scales[zero_rows] = np.float32(1.0)
+    return scales, zero_rows
+
+
+def quantize_weight_per_output_channel(weight, name="<weight>"):
+    """量化 ``[out, in]`` 权重。
+
+    返回 ``(codes_int8, scales_fp32, stats)``；``stats`` 是 JSON 可序列化字典。
+    """
+
+    values = np.asarray(weight, dtype=np.float32)
+    if values.ndim != 2:
+        raise W8A8QuantError("weight %r must be rank 2 [out, in]" % name)
+    rows, columns = int(values.shape[0]), int(values.shape[1])
+    if rows <= 0 or columns <= 0:
+        raise W8A8QuantError("weight %r must be non-empty" % name)
+    if columns > MAX_ACCUMULATOR_K:
+        raise W8A8QuantError(
+            "weight %r K=%d exceeds the INT32 accumulation limit %d (Q5)"
+            % (name, columns, MAX_ACCUMULATOR_K)
+        )
+    _require_finite(values, "weight %r" % name)
+
+    absmax = np.max(np.abs(values), axis=1).astype(np.float32)
+    scales, zero_rows = _scale_from_absmax(absmax, "weight %r" % name)
+    ratios = values.astype(np.float64) / scales.astype(np.float64)[:, None]
+    rounded = np.rint(ratios)
+    saturation = int(np.count_nonzero((rounded < QUANT_MIN) | (rounded > QUANT_MAX)))
+    codes = np.clip(rounded, QUANT_MIN, QUANT_MAX).astype(np.int8)
+    codes[zero_rows] = np.int8(0)
+    stats = {
+        "rows": rows,
+        "columns": columns,
+        "max_abs": float(absmax.max()) if rows else 0.0,
+        "zero_row_count": int(np.count_nonzero(zero_rows)),
+        "saturation_count": saturation,
+    }
+    return codes, scales, stats
+
+
+def dequantize_weight(codes, scales):
+    """``fp32(fp32(codes) * fp32(scale))``，与 C1 ``dequantize_s8`` 的 fp32 结果一致。"""
+
+    codes_fp32 = np.asarray(codes, dtype=np.int8).astype(np.float32)
+    scales_fp32 = np.asarray(scales, dtype=np.float32)
+    return (codes_fp32 * scales_fp32[:, None]).astype(np.float32)
+
+
+def fake_quantize_weight_per_output_channel(weight, name="<weight>"):
+    """量化->反量化，返回 fp32 的 ``W_fq`` 与 stats。"""
+
+    codes, scales, stats = quantize_weight_per_output_channel(weight, name=name)
+    dequantized = dequantize_weight(codes, scales)
+    stats = dict(stats)
+    stats["codes_sha256"] = _sha256_bytes(np.ascontiguousarray(codes, dtype=np.int8).tobytes())
+    stats["scales_sha256"] = _sha256_bytes(np.ascontiguousarray(scales, dtype="<f4").tobytes())
+    residual = np.abs(dequantized.astype(np.float64) - np.asarray(weight, dtype=np.float32).astype(np.float64))
+    denom = np.maximum(np.abs(np.asarray(weight, dtype=np.float64)), 1e-12)
+    stats["dequant_max_abs_error"] = float(residual.max()) if residual.size else 0.0
+    stats["dequant_max_rel_error"] = float((residual / denom).max()) if residual.size else 0.0
+    return dequantized, codes, scales, stats
+
+
+def _sha256_bytes(payload):
+    import hashlib
+
+    return hashlib.sha256(payload).hexdigest()
+
+
+__all__ = [
+    "QUANT_BITS",
+    "QUANT_MIN",
+    "QUANT_MAX",
+    "ZERO_POINT",
+    "SCALE_DENOMINATOR",
+    "MAX_ACCUMULATOR_K",
+    "W8A8QuantError",
+    "quantize_weight_per_output_channel",
+    "dequantize_weight",
+    "fake_quantize_weight_per_output_channel",
+]
