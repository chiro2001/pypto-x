@@ -0,0 +1,411 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""W8A8 fake-quant 参照执行引擎（契约 0002 §1.1/§2.3 冻结）。
+
+把官方 transformers 前向里的 150 个 language-model ``nn.Linear`` 替换成
+"量化 -> 反量化 -> fp32 累加" 的执行：
+
+1. 权重：调用 :mod:`w8a8_quant` 的 per-output-channel 对称 absmax 量化，
+   ``W_fq = dequantize(q_w, s_w)`` 以 fp32 存回模块；
+2. 激活：forward pre-hook 对到达该 linear 的输入按**动态 per-token**量化，
+   反量化回 fp32 后替换原输入；
+3. ``F.linear`` 在 fp32 上累加；
+4. forward hook 把输出按变体要求 cast 回 bf16（部署一致变体）或保持 fp32
+   （纯 fp32 参照变体）。
+
+本模块属于 gold 生成路径：只允许 torch / numpy，不导入 pypto 或 PyPTO-X
+运行时。量化范围判定复用 :mod:`w8a8_scope` 的字符串分类。
+"""
+
+from __future__ import unicode_literals
+
+import numpy as np
+import torch
+
+try:  # 脚本方式运行（run_reference.py）时同目录 import
+    import w8a8_quant
+    import w8a8_scope
+except ImportError:  # pragma: no cover - 包方式导入
+    from . import w8a8_quant
+    from . import w8a8_scope
+
+
+#: W8A8 参照的两种变体。``w8a8`` 是主参照（部署一致：浮点孤岛 BF16）；
+#: ``w8a8_f32ref`` 是契约决策字面读法（整套方案跑在 fp32 参照实现上），
+#: 用于把 bf16 孤岛噪声从量化噪声里分解出来。
+W8A8_VARIANTS = {
+    "w8a8": {
+        "base_dtype": torch.bfloat16,
+        "output_dtype": torch.bfloat16,
+        "description": "deployment-faithful: BF16 islands (contract D1/D4/D9) + int8 fake-quant linears, fp32 accumulation",
+    },
+    "w8a8_f32ref": {
+        "base_dtype": torch.float32,
+        "output_dtype": torch.float32,
+        "description": "same scheme on the fp32 reference implementation (pure quantization noise floor, no BF16 island noise)",
+    },
+}
+
+
+class W8A8FakeQuantError(ValueError):
+    """fake-quant 构造或执行违反冻结 scheme。"""
+
+
+def _quantize_activation(activation):
+    """动态 per-token 对称量化 -> 反量化（fp32）。
+
+    输入可以是任意 rank；只在最后一维上定义 per-token。返回
+    ``(dequantized_fp32, stats)``。
+    """
+
+    if not torch.is_tensor(activation):
+        raise W8A8FakeQuantError("activation must be a torch.Tensor")
+    last_dim = int(activation.shape[-1]) if activation.dim() >= 1 else 0
+    if last_dim <= 0:
+        raise W8A8FakeQuantError("activation must have a non-empty last dimension")
+    if last_dim > w8a8_quant.MAX_ACCUMULATOR_K:
+        raise W8A8FakeQuantError(
+            "activation K=%d exceeds the INT32 accumulation limit %d (Q5)"
+            % (last_dim, w8a8_quant.MAX_ACCUMULATOR_K)
+        )
+    values = activation.detach().to(torch.float32)
+    if not bool(torch.isfinite(values).all().item()):
+        raise W8A8FakeQuantError("activation contains NaN/Inf; quantize fails closed (Q2)")
+    flat = values.reshape(-1, last_dim)
+
+    absmax = flat.abs().amax(dim=1).to(torch.float32)
+    zero_rows = absmax == 0.0
+    scales = (absmax.to(torch.float64) / 127.0).to(torch.float32)
+    if bool(((scales == 0.0) & ~zero_rows).any().item()):
+        raise W8A8FakeQuantError(
+            "activation has a non-zero row whose float32 scale underflows to 0"
+        )
+    scales = torch.where(zero_rows, torch.ones_like(scales), scales)
+
+    ratios = flat.to(torch.float64) / scales.to(torch.float64).unsqueeze(1)
+    rounded = torch.round(ratios)  # torch.round = ties-to-even for float dtypes
+    saturation = int(((rounded < w8a8_quant.QUANT_MIN) |
+                      (rounded > w8a8_quant.QUANT_MAX)).sum().item())
+    codes = torch.clamp(rounded, w8a8_quant.QUANT_MIN, w8a8_quant.QUANT_MAX)
+    dequantized = (codes.to(torch.float32) * scales.unsqueeze(1)).to(torch.float32)
+    stats = {
+        "rows": int(flat.shape[0]),
+        "k": int(last_dim),
+        "saturation_count": saturation,
+        "zero_row_count": int(zero_rows.sum().item()),
+    }
+    return dequantized.reshape(tuple(activation.shape)), stats
+
+
+class _ActivationQuantState(object):
+    """记录每次被覆盖 linear 的激活量化统计（供 artifact 审计）。"""
+
+    def __init__(self):
+        self.calls = 0
+        self.rows = 0
+        self.saturation_count = 0
+        self.zero_row_count = 0
+        self.modules = {}
+
+    def record(self, module_name, stats):
+        self.calls += 1
+        self.rows += int(stats["rows"])
+        self.saturation_count += int(stats["saturation_count"])
+        self.zero_row_count += int(stats["zero_row_count"])
+        entry = self.modules.setdefault(
+            module_name, {"calls": 0, "rows": 0, "saturation_count": 0, "zero_row_count": 0}
+        )
+        entry["calls"] += 1
+        entry["rows"] += int(stats["rows"])
+        entry["saturation_count"] += int(stats["saturation_count"])
+        entry["zero_row_count"] += int(stats["zero_row_count"])
+
+    def to_dict(self):
+        return {
+            "calls": self.calls,
+            "rows": self.rows,
+            "saturation_count": self.saturation_count,
+            "zero_row_count": self.zero_row_count,
+            "per_module": dict(self.modules),
+        }
+
+
+def _make_pre_hook(state):
+    def pre_hook(module, args, kwargs):
+        if args:
+            activation = args[0]
+        elif "input" in kwargs:
+            activation = kwargs["input"]
+        else:
+            raise W8A8FakeQuantError("linear module %r called without a positional input" % module)
+        dequantized, stats = _quantize_activation(activation)
+        state.record(getattr(module, "_w8a8_module_name", "?"), stats)
+        if args:
+            return ((dequantized,) + tuple(args[1:]), kwargs)
+        kwargs = dict(kwargs)
+        kwargs["input"] = dequantized
+        return (args, kwargs)
+
+    return pre_hook
+
+
+def _make_post_hook(output_dtype):
+    def post_hook(module, args, output):
+        if output_dtype is not None and torch.is_tensor(output) and output.dtype != output_dtype:
+            return output.to(output_dtype)
+        return output
+
+    return post_hook
+
+
+def _parameter_snapshot(model):
+    snapshot = {}
+    # remove_duplicate=False：tied lm_head / embed_tokens 是同一个 Parameter，
+    # 需要两个别名都在快照里，才能断言 lm_head 未被量化。
+    for name, parameter in model.named_parameters(remove_duplicate=False):
+        snapshot[name] = (parameter.data_ptr(), str(parameter.dtype))
+    return snapshot
+
+
+def refresh_activation_stats(audit):
+    """把 fake-quant 执行期间累积的激活量化统计刷新进 audit。"""
+
+    state = audit.get("_activation_state")
+    if state is None:
+        raise W8A8FakeQuantError("audit object has no activation state")
+    audit["activation_stats"] = state.to_dict()
+    audit["activation_module_coverage"] = audit_all_modules_called(audit)
+    return audit
+
+
+def apply_fake_quant(model, variant_name, quantized_scope="default"):
+    """就地给 ``model`` 加上 W8A8 fake-quant，返回审计结果（含内部 state）。
+
+    ``quantized_scope`` 只支持契约默认的 ``default``（in_proj_b/a 保持 BF16）；
+    ``all`` 会显式拒绝，因为首期 gold 只冻结了默认范围。
+    """
+
+    if variant_name not in W8A8_VARIANTS:
+        raise W8A8FakeQuantError("unknown W8A8 variant %r" % variant_name)
+    if quantized_scope != "default":
+        raise W8A8FakeQuantError(
+            "only the frozen default scope is supported (in_proj_b/in_proj_a stay BF16, D1)"
+        )
+    variant = W8A8_VARIANTS[variant_name]
+    output_dtype = variant["output_dtype"]
+    base_dtype_name = str(variant["base_dtype"]).replace("torch.", "")
+
+    targets = []
+    islands = []
+    unsupported_language_linears = []
+    conv1d_modules = []
+    lm_head_modules = []
+    for name, module in model.named_modules():
+        if isinstance(module, torch.nn.Conv1d) and name.startswith(w8a8_scope.QWEN35_TEXT_PREFIX):
+            conv1d_modules.append((name, module))
+        if not isinstance(module, torch.nn.Linear):
+            continue
+        if name == "lm_head":
+            lm_head_modules.append((name, module))
+            continue
+        classification = w8a8_scope.classify_language_linear(name)
+        if classification == "quantized":
+            targets.append((name, module))
+        elif classification == "bf16_island":
+            islands.append((name, module))
+        elif name.startswith(w8a8_scope.QWEN35_TEXT_PREFIX):
+            unsupported_language_linears.append(name)
+
+    if len(targets) != w8a8_scope.EXPECTED_QUANTIZED_LINEAR_COUNT:
+        raise W8A8FakeQuantError(
+            "expected %d quantized language-model linears, found %d"
+            % (w8a8_scope.EXPECTED_QUANTIZED_LINEAR_COUNT, len(targets))
+        )
+    if len(islands) != w8a8_scope.EXPECTED_BF16_LINEAR_COUNT:
+        raise W8A8FakeQuantError(
+            "expected %d BF16 island linears, found %d"
+            % (w8a8_scope.EXPECTED_BF16_LINEAR_COUNT, len(islands))
+        )
+
+    before = _parameter_snapshot(model)
+    state = _ActivationQuantState()
+    weight_audit = []
+    total_saturation = 0
+    total_zero_rows = 0
+    max_dequant_abs_error = 0.0
+    max_dequant_rel_error = 0.0
+
+    for name, module in targets:
+        if module.bias is not None:
+            raise W8A8FakeQuantError("quantized linear %r unexpectedly has a bias" % name)
+        weight = module.weight.detach().to(torch.float32).cpu().numpy()
+        dequantized, _codes, _scales, stats = w8a8_quant.fake_quantize_weight_per_output_channel(
+            weight, name=name
+        )
+        module.weight.data = torch.from_numpy(np.ascontiguousarray(dequantized, dtype=np.float32))
+        module._w8a8_module_name = name
+        module.register_forward_pre_hook(_make_pre_hook(state), with_kwargs=True)
+        module.register_forward_hook(_make_post_hook(output_dtype))
+        total_saturation += int(stats["saturation_count"])
+        total_zero_rows += int(stats["zero_row_count"])
+        max_dequant_abs_error = max(max_dequant_abs_error, float(stats["dequant_max_abs_error"]))
+        max_dequant_rel_error = max(max_dequant_rel_error, float(stats["dequant_max_rel_error"]))
+        weight_audit.append({
+            "name": name,
+            "manifest_parameter": w8a8_scope.manifest_parameter_name(name),
+            "shape": [int(dim) for dim in module.weight.shape],
+            "source_dtype": before[name + ".weight"][1].replace("torch.", ""),
+            "saturation_count": int(stats["saturation_count"]),
+            "zero_row_count": int(stats["zero_row_count"]),
+            "max_abs": float(stats["max_abs"]),
+            "codes_sha256": stats["codes_sha256"],
+            "scales_sha256": stats["scales_sha256"],
+        })
+    weight_audit.sort(key=lambda item: item["name"])
+
+    after = _parameter_snapshot(model)
+    changed = [name for name, value in before.items() if after[name] != value]
+    expected_changed = set(name + ".weight" for name, _module in targets)
+    if set(changed) != expected_changed:
+        raise W8A8FakeQuantError(
+            "parameter mutation set mismatch: unexpected=%s missing=%s"
+            % (sorted(set(changed) - expected_changed), sorted(expected_changed - set(changed)))
+        )
+
+    island_module_checks = []
+    for name, module in islands:
+        parameter_name = name + ".weight"
+        entry = {
+            "name": name,
+            "suffix": w8a8_scope.language_linear_suffix(name),
+            "role": "D1_bf16_island",
+            "weight_dtype": str(module.weight.dtype).replace("torch.", ""),
+            "weight_unchanged": before[parameter_name][0] == module.weight.data_ptr(),
+        }
+        island_module_checks.append(entry)
+        if not entry["weight_unchanged"] or entry["weight_dtype"] != base_dtype_name:
+            raise W8A8FakeQuantError(
+                "BF16 island %r changed (dtype=%s unchanged=%s)"
+                % (name, entry["weight_dtype"], entry["weight_unchanged"])
+            )
+    for name, module in conv1d_modules:
+        island_module_checks.append({
+            "name": name,
+            "suffix": "linear_attn.conv1d",
+            "role": "D9_conv1d_island",
+            "weight_dtype": str(module.weight.dtype).replace("torch.", ""),
+            "weight_unchanged": before[name + ".weight"][0] == module.weight.data_ptr(),
+        })
+    for name, module in lm_head_modules:
+        island_module_checks.append({
+            "name": name,
+            "suffix": "lm_head",
+            "role": "D4_lm_head_not_quantized",
+            "weight_dtype": str(module.weight.dtype).replace("torch.", ""),
+            "weight_unchanged": before[name + ".weight"][0] == module.weight.data_ptr(),
+        })
+
+    embedding = model.get_input_embeddings()
+    lm_head = model.get_output_embeddings()
+    lm_head_tied = bool(lm_head is not None and embedding is not None and
+                        lm_head.weight is embedding.weight)
+    assertions = [
+        {"name": "quantized_linear_count_150", "pass": len(targets) == 150},
+        {"name": "bf16_island_linear_count_36", "pass": len(islands) == 36},
+        {"name": "islands_unchanged_and_dtype_preserved",
+         "pass": all(item["weight_unchanged"] and item["weight_dtype"] == base_dtype_name
+                     for item in island_module_checks
+                     if item["role"] == "D1_bf16_island")},
+        {"name": "conv1d_stays_base_dtype",
+         "pass": all(item["weight_dtype"] == base_dtype_name
+                     for item in island_module_checks
+                     if item["role"] == "D9_conv1d_island")},
+        {"name": "lm_head_not_quantized",
+         "pass": all(item["weight_dtype"] == base_dtype_name
+                     for item in island_module_checks
+                     if item["role"] == "D4_lm_head_not_quantized")},
+        {"name": "lm_head_tied_to_embedding", "pass": lm_head_tied},
+        {"name": "no_language_linear_left_unclassified",
+         "pass": len(unsupported_language_linears) == 0},
+        {"name": "only_quantized_weights_mutated",
+         "pass": set(changed) == expected_changed},
+    ]
+
+    audit = {
+        "variant": variant_name,
+        "description": variant["description"],
+        "base_dtype": base_dtype_name,
+        "output_dtype": str(output_dtype).replace("torch.", ""),
+        "quantized_scope": quantized_scope,
+        "activation_quant_source": (
+            "activation as executed by the reference module (bf16 in 'w8a8'; fp32 in 'w8a8_f32ref')"
+        ),
+        "formula": w8a8_scope.QUANT_FORMULA,
+        "scope": {
+            "quantized_suffixes": list(w8a8_scope.QUANTIZED_LINEAR_SUFFIXES),
+            "bf16_island_suffixes": list(w8a8_scope.BF16_LINEAR_SUFFIXES),
+            "quantized_module_count": len(targets),
+            "bf16_island_module_count": len(islands),
+            "conv1d_module_count": len(conv1d_modules),
+            "lm_head_module_count": len(lm_head_modules),
+            "excluded": [
+                {"class": "lm_head (tied embedding)", "decision": "D4 not quantized"},
+                {"class": "linear_attn.conv1d", "decision": "D9 stays BF16/float"},
+                {"class": "linear_attn.in_proj_b / in_proj_a", "decision": "D1 stays BF16"},
+                {"class": "embed_tokens / norms / attention + GDR inner matmuls", "decision": "float islands"},
+                {"class": "model.visual.*", "decision": "vision tower, text-only forward does not exercise it"},
+                {"class": "mtp.*", "decision": "not part of the text decoder"},
+            ],
+            "quantized_modules": sorted(name for name, _module in targets),
+            "bf16_islands": [name for name, _module in sorted(islands)],
+        },
+        "weight_stats": {
+            "quantized_parameter_count": len(weight_audit),
+            "saturation_total": total_saturation,
+            "zero_row_total": total_zero_rows,
+            "max_dequant_abs_error": max_dequant_abs_error,
+            "max_dequant_rel_error": max_dequant_rel_error,
+            "per_module": weight_audit,
+        },
+        "activation_stats": state.to_dict(),
+        "island_checks": island_module_checks,
+        "assertions": assertions,
+        "all_assertions_pass": all(bool(item["pass"]) for item in assertions),
+        "_activation_state": state,
+    }
+    if not audit["all_assertions_pass"]:
+        raise W8A8FakeQuantError("fake-quant construction audit failed: %s" % assertions)
+    return audit
+
+
+def audit_all_modules_called(audit):
+    """检查每个量化模块都被执行过（激活量化覆盖），由 refresh 调用。"""
+
+    per_module = audit["activation_stats"]["per_module"]
+    expected = set(audit["scope"]["quantized_modules"])
+    called = set(per_module.keys())
+    return {
+        "expected": len(expected),
+        "called": len(called),
+        "uncalled": sorted(expected - called),
+        "unexpected": sorted(called - expected),
+        "complete": expected == called,
+    }
+
+
+def strip_internal_state(audit):
+    """返回可 JSON 序列化的 audit 副本（去掉内部 state 对象）。"""
+
+    public = dict(audit)
+    public.pop("_activation_state", None)
+    return public
+
+
+__all__ = [
+    "W8A8_VARIANTS",
+    "W8A8FakeQuantError",
+    "apply_fake_quant",
+    "refresh_activation_stats",
+    "audit_all_modules_called",
+    "strip_internal_state",
+]
