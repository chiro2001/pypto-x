+def test_indexing_compact_iteration_reports_logical_full_chunks_without_materializing():
+    source = ValueRef("source", CoreType.tensor("float32", (32768, 2048)))
+    indices = ValueRef("indices", CoreType.tensor("int32", (4,)))
+    output = ValueRef("output", CoreType.tensor("float32", (32768, 4)))
+    plan = lower_cpu_vector(
+        _program("gather", (source, indices), (output,), {"axis": 1}), VECTOR_TARGET
+    ).plans[0]
+    assert plan.iteration.compact
+    assert plan.iteration.chunks == ()
+    assert plan.full_chunks == plan.element_count // plan.lane_count == 32768
+
