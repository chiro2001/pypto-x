+@pytest.mark.parametrize("operation", ("split", "concat", "gather", "embedding"))
+def test_avx2_avx512_and_gpu_keep_explicit_rejection_for_indexing_operations(operation):
+    if operation == "split":
+        source = ValueRef("source", CoreType.tensor("float32", (2, 4)))
+        left = ValueRef("left", CoreType.tensor("float32", (2, 1)))
+        right = ValueRef("right", CoreType.tensor("float32", (2, 3)))
+        program = _program(operation, (source,), (left, right), {"sizes": [1, 3], "axis": -1})
+    elif operation == "concat":
+        left = ValueRef("left", CoreType.tensor("float32", (2, 1)))
+        right = ValueRef("right", CoreType.tensor("float32", (2, 3)))
+        output = ValueRef("output", CoreType.tensor("float32", (2, 4)))
+        program = _program(operation, (left, right), (output,), {"axis": -1})
+    elif operation == "gather":
+        source = ValueRef("source", CoreType.tensor("float32", (2, 3)))
+        indices = ValueRef("indices", CoreType.tensor("int32", (2,)))
+        output = ValueRef("output", CoreType.tensor("float32", (2, 2)))
+        program = _program(operation, (source, indices), (output,), {"axis": 1})
+    else:
+        source = ValueRef("source", CoreType.tensor("float32", (3, 2)))
+        indices = ValueRef("indices", CoreType.tensor("int32", (2,)))
+        output = ValueRef("output", CoreType.tensor("float32", (2, 2)))
+        program = _program(operation, (source, indices), (output,))
+    with pytest.raises(Avx2UnsupportedError, match=operation):
+        lower_avx2(program, AVX2_TARGET)
+    with pytest.raises(Avx512UnsupportedError, match=operation):
+        lower_avx512(program, AVX512_TARGET)
+    with pytest.raises(GpuUnsupportedError, match=operation):
+        lower_gpu_common(program, GPU_TARGET)
