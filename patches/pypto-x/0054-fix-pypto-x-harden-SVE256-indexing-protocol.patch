+def test_indexing_lowering_rejects_unrepresentable_strides_and_native_rank_limits():
+    source = ValueRef("source", CoreType.tensor("float32", (0, 1 << 63, 2)))
+    indices = ValueRef("indices", CoreType.tensor("int32", (1,)))
+    output = ValueRef("output", CoreType.tensor("float32", (0, 1, 2)))
+    with pytest.raises(CpuVectorValidationError, match="stride|uint64"):
+        lower_cpu_vector(_program("gather", (source, indices), (output,), {"axis": 1}), VECTOR_TARGET)
+
+    rank = 65
+    source = ValueRef("source", CoreType.tensor("float32", (1,) * rank))
+    output = ValueRef("output", CoreType.tensor("float32", (1,) * rank))
+    split = Operation("split", (source,), (output,), attributes={"sizes": [1], "axis": 0})
+    with pytest.raises(CpuVectorValidationError, match="rank"):
+        lower_cpu_vector(CoreProgram(functions=(CoreFunction("split", (source,), (output,), Region((split,))),)), VECTOR_TARGET)
+
+    source = ValueRef("source", CoreType.tensor("float32", (1, 1)))
+    indices = ValueRef("indices", CoreType.tensor("int32", (1,) * 64))
+    output = ValueRef("output", CoreType.tensor("float32", (1,) * 65))
+    with pytest.raises(CpuVectorValidationError, match="rank"):
+        lower_cpu_vector(_program("gather", (source, indices), (output,), {"axis": 1}), VECTOR_TARGET)
+
