+@pytest.mark.parametrize("index_dtype", ("int32", "int64"))
+def test_sve256_native_v4_index_wire_rejects_negative_oob_and_stale_hash(index_dtype, tmp_path):
+    qemu = shutil.which("qemu-aarch64")
+    if qemu is None:
+        pytest.skip("qemu-aarch64 is unavailable")
+    source = ValueRef("source", CoreType.tensor("float32", (2, 3, 4)))
+    indices = ValueRef("indices", CoreType.tensor(index_dtype, (2, 1)))
+    output = ValueRef("output", CoreType.tensor("float32", (2, 2, 1, 4)))
+    program = _program("gather", (source, indices), (output,), {"axis": 1})
+    target_ir, artifact = _compile_sve(program, tmp_path / index_dtype)
+    descriptor = _index_descriptor_bytes(target_ir.plans[0].indexing_plan, index_dtype)
+    index_code = 1 if index_dtype == "int32" else 2
+    index_format = "<2i" if index_dtype == "int32" else "<2q"
+
+    def invoke(index_values, checksum=None):
+        index_bytes = struct.pack(index_format, *index_values)
+        header = struct.pack(
+            "<6I4Q", 0x56535850, 4, 25, 0, index_code, len(descriptor),
+            16, 24, 2, _layout_wire_hash(descriptor) if checksum is None else checksum,
+        )
+        return subprocess.run(
+            [qemu, "-L", "/usr/aarch64-linux-gnu", "-cpu", "max,sve256=on", artifact.path],
+            input=header + struct.pack("<24f", *([1.0] * 24)) + index_bytes + descriptor,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+
+    for index_values in ((-1, 0), (3, 0)):
+        result = invoke(index_values)
+        assert result.returncode != 0 and result.returncode != -11
+        assert len(result.stdout) >= 24
+        magic, version, status, _dtype, _count = struct.unpack("<4IQ", result.stdout[:24])
+        assert magic == 0x56535850 and version == 4 and status != 0
+
+    stale = invoke((0, 1), checksum=(_layout_wire_hash(descriptor) ^ 1))
+    assert stale.returncode != 0 and stale.returncode != -11
+    assert len(stale.stdout) >= 24
+    magic, version, status, _dtype, _count = struct.unpack("<4IQ", stale.stdout[:24])
+    assert magic == 0x56535850 and version == 4 and status != 0
+
