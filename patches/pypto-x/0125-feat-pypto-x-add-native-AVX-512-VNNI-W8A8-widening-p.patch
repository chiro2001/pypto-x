+@pytest.mark.parametrize("k", (1, 2, 3, 4, 7, 8, 9, 15, 16, 17, 31, 32, 33, 64, 65))
+def test_compensation_all_negative_and_mixed_tails(k, carrier_artifact):
+    # All-negative: bias +128 on the right operand used to be the classic
+    # vpdpbusd failure mode (u8 x s8); the -128 * row_sum correction must make
+    # it exact for any K, including K not divisible by 4 or 16.
+    cases = (
+        ([[-127] * k], [[-127] for _ in range(k)]),
+        ([[-127] * k], [[127] for _ in range(k)]),
+        ([[127 if index % 2 == 0 else -127 for index in range(k)]],
+         [[-127 if index % 2 else 127] for index in range(k)]),
+        ([[-1 if index % 3 == 0 else 1 for index in range(k)]],
+         [[-3 if index % 5 == 0 else 2] for index in range(k)]),
+    )
+    for left, right in cases:
+        expected = qmatmul_s8s8_s32(left, right)
+        actual = _run_entry_point((left, right), (1, k), (k, 1), carrier_artifact)
+        assert actual == tuple(expected.values), (k, left, right)
+
+
+def test_compensation_worst_case_wraps_modulo_2_32(carrier_artifact):
+    """The biased intermediate sum exceeds INT32; only wrap + correction works.
+
+    K = 133144, a = b = 127: the frozen exact result is
+    K * 127 * 127 = 2,147,479,576 <= INT32_MAX, but the VNNI operand sees
+    (b + 128) = 255, so the raw ``vpdpbusd`` accumulation is
+    255 * 127 * K = 4,311,035,640, which is *outside* int32.  A saturating or
+    non-wrapping implementation would return a wrong value here.
+    """
+
+    k = W8A8_MAX_ACCUMULATOR_K
+    biased_intermediate = 255 * 127 * k
+    exact = 127 * 127 * k
+    assert biased_intermediate > 2**31 - 1
+    assert 0 < exact <= 2**31 - 1
+    for left_value, right_value, sign in ((127, 127, 1), (127, -127, -1), (-127, 127, -1)):
+        left = [[left_value] * k]
+        right = [[right_value] for _ in range(k)]
+        expected = qmatmul_s8s8_s32(left, right)
+        assert expected.values == (sign * exact,)
+        actual = _run_entry_point((left, right), (1, k), (k, 1), carrier_artifact)
+        assert actual == tuple(expected.values)
+
