+    def _execute_w8a8(
+        self,
+        decision: Mapping[str, Any],
+        operation: Operation,
+        plan: Any,
+        module: Any,
+    ) -> Mapping[str, _RuntimeValue]:
+        """Run one native W8A8 VNNI kernel on caller-owned buffers.
+
+        The contract comes from :func:`w8a8_kernel_contract`, the same
+        predicate that produced the artifact metadata.  Capability gating is
+        declared through :class:`CapabilitySet`; the VNNI probe already ran in
+        ``launch`` and this method refuses to call the symbol without it.
+        """
+
+        contract = decision["w8a8"]
+        if contract.get("mode") != W8A8_QMATMUL_MODE:
+            raise CpuAvx512ArtifactError(
+                "unsupported AVX-512 W8A8 mode {!r}".format(contract.get("mode"))
+            )
+        if not self.capability.available:
+            raise CpuAvx512UnavailableError(self._status)
+        if self._real_capability is not None and not (
+            self._real_capability.available and self._real_capability.avx512vnni
+        ):
+            raise CpuAvx512UnavailableError(self._status)
+        inputs = list(decision["inputs"])
+        if len(inputs) != 2:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} requires two int8 inputs".format(W8A8_QMATMUL_OPCODE)
+            )
+        output_ref = operation.outputs[0]
+        output_dtype = canonical_dtype(output_ref.type.dtype)
+        if output_dtype != "int32":
+            raise CpuAvx512ArtifactError(
+                "AVX-512 {} output must be int32, got {!r}".format(W8A8_QMATMUL_OPCODE, output_dtype)
+            )
+        m = int(contract["m"])
+        k = int(contract["k"])
+        n = int(contract["n"])
+        batch_shape = tuple(int(value) for value in contract.get("batch_shape", ()))
+        if k > W8A8_MAX_ACCUMULATOR_K:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} K={} exceeds the INT32 accumulation limit {}".format(
+                    W8A8_QMATMUL_OPCODE, k, W8A8_MAX_ACCUMULATOR_K
+                )
+            )
+        batch_count = 1
+        for dimension in batch_shape:
+            if dimension < 0:
+                raise CpuAvx512ArtifactError("AVX-512 W8A8 batch dimensions must be non-negative")
+            batch_count *= dimension
+        left = inputs[0].buffer
+        right = inputs[1].buffer
+        if left.dtype != "int8" or right.dtype != "int8":
+            raise CpuAvx512ArtifactError("AVX-512 W8A8 qmatmul requires int8 operand buffers")
+        if left.count != batch_count * m * k or right.count != batch_count * k * n:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} operand element counts do not match the plan".format(W8A8_QMATMUL_OPCODE)
+            )
+        output = _buffer_alloc("int32", batch_count * m * n, output_ref.name)
+        left_elements = m * k
+        right_elements = k * n
+        output_elements = m * n
+        for batch_index in range(batch_count):
+            _call_w8a8_qmatmul(
+                module,
+                _NativeBuffer(
+                    left.dtype,
+                    left_elements,
+                    _buffer_pointer(left, batch_index * left_elements),
+                    left.owner,
+                    left.direct,
+                ),
+                _NativeBuffer(
+                    right.dtype,
+                    right_elements,
+                    _buffer_pointer(right, batch_index * right_elements),
+                    right.owner,
+                    right.direct,
+                ),
+                _NativeBuffer(
+                    output.dtype,
+                    output_elements,
+                    _buffer_pointer(output, batch_index * output_elements),
+                    output.owner,
+                    output.direct,
+                ),
+                m,
+                k,
+                n,
+            )
+        return {output_ref.name: _RuntimeValue(output_ref.type, output)}
