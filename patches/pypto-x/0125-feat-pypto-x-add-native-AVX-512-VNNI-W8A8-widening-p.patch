+    output = ValueRef("output", CoreType.tensor("int32", output_shape))
+    operation = Operation(name, (left, right), (output,), {})
+    return CoreProgram(
+        functions=(CoreFunction("qmatmul", (left, right), (output,), Region((operation,))),)
+    )
+
+
+def _raw_qmatmul_program(
+    left_shape,
+    right_shape,
+    output_shape,
+    *,
+    left_dtype="int8",
+    right_dtype="int8",
+    output_dtype="int32",
+):
+    left = ValueRef("left", CoreType.tensor(left_dtype, left_shape))
+    right = ValueRef("right", CoreType.tensor(right_dtype, right_shape))
+    output = ValueRef("output", CoreType.tensor(output_dtype, output_shape))
+    operation = Operation(W8A8_QMATMUL_OPCODE, (left, right), (output,), {})
+    return CoreProgram(
+        functions=(CoreFunction("qmatmul", (left, right), (output,), Region((operation,))),)
+    )
+
+
+def _add_program(shape=(17,), dtype="float32"):
+    value_type = CoreType.tensor(dtype, shape)
+    left = ValueRef("left", value_type)
+    right = ValueRef("right", value_type)
+    output = ValueRef("output", value_type)
+    return CoreProgram(
+        functions=(
+            CoreFunction(
+                "add",
+                (left, right),
+                (output,),
+                Region((Operation("add", (left, right), (output,), {}),)),
+            ),
+        )
+    )
+
+
+def _compile_avx512_artifact(program, build_dir, name="w8a8", target=AVX512_VNNI_TARGET):
+    key = (name, program.canonical_json())
+    cached = _ARTIFACT_CACHE.get(key)
+    if cached is None:
+        compiler = Avx512Compiler()
+        target_ir = compiler.lower(program, target)
+        cached = compiler.compile(
+            target_ir,
+            CompileOptions(
+                artifact_format="pypto-x.cpu.avx512",
+                extra={"build_dir": str(Path(build_dir) / name)},
+            ),
+        )
+        _ARTIFACT_CACHE[key] = cached
+    return cached
+
