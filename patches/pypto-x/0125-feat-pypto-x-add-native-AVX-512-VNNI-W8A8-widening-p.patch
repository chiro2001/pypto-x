+    # ------------------------------------------------------------------
+    # W8A8 VNNI target-specific native entry points (R6 evidence surface).
+    #
+    # These require an ``avx512vnni`` artifact, so the native ABI marker,
+    # payload version and probe-gated CapabilitySet are validated before any
+    # symbol is called.  ``qmatmul_s8s8_s32`` additionally has a full Core IR
+    # path through ``launch`` above.
+    # ------------------------------------------------------------------
+
+    def _require_w8a8_declaration(self, artifact: Artifact, declared: Any) -> None:
+        metadata = mapping_copy(artifact.metadata)
+        required = tuple(metadata.get("required_features", ()))
+        if "avx512vnni" not in required:
+            raise CpuAvx512ArtifactError(
+                "AVX-512 W8A8 entry points require an avx512vnni artifact"
+            )
+        declaration = metadata.get("w8a8_capability")
+        if not isinstance(declaration, Mapping):
+            raise CpuAvx512ArtifactError("AVX-512 artifact has no W8A8 capability declaration")
+        if declaration.get("digest") != declared.fingerprint:
+            raise CpuAvx512ArtifactError("AVX-512 artifact W8A8 capability digest mismatch")
+        if tuple(declaration.get("dtypes", ())) != tuple(declared.dtypes):
+            raise CpuAvx512ArtifactError("AVX-512 artifact W8A8 dtype declaration mismatch")
+        if tuple(declaration.get("matrix_capabilities", ())) != tuple(declared.matrix_capabilities):
+            raise CpuAvx512ArtifactError(
+                "AVX-512 artifact W8A8 matrix capability declaration mismatch"
+            )
+
+    def _load_w8a8(self, artifact: Artifact) -> Tuple[Any, LoadedAvx512Artifact]:
+        capability = self._require_real_capability()
+        declared = _capabilities.avx512_w8a8_capabilities(capability, target=self.name)
+        loaded = self.load(artifact, available_features=capability.features)
+        self._require_w8a8_declaration(loaded.artifact, declared)
+        return declared, loaded
+
+    def w8a8_capability(self, artifact: Artifact) -> Any:
+        """Return the probe-gated W8A8 :class:`CapabilitySet` for an artifact."""
+
+        declared, _ = self._load_w8a8(artifact)
+        return declared
+
+    def run_w8a8_qmatmul(
+        self,
+        artifact: Artifact,
+        left: Any,
+        right: Any,
+        *,
+        left_shape: Optional[Sequence[int]] = None,
+        right_shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[int, ...]:
+        """Run the native AVX-512 VNNI s8 x s8 -> s32 kernel."""
+
+        _, loaded = self._load_w8a8(artifact)
+        left_flat, left_declared = _w8a8_declared_shape(left, left_shape, "qmatmul.left")
+        right_flat, right_declared = _w8a8_declared_shape(right, right_shape, "qmatmul.right")
+        if len(left_declared) != len(right_declared) or len(left_declared) not in (2, 3, 4):
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} operands must have equal rank 2, 3, or 4".format(W8A8_QMATMUL_OPCODE)
+            )
+        if left_declared[:-2] != right_declared[:-2]:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} operands must have identical batch prefixes".format(W8A8_QMATMUL_OPCODE)
+            )
+        if left_declared[-1] != right_declared[-2]:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} reduction dimensions do not match".format(W8A8_QMATMUL_OPCODE)
+            )
+        k = left_declared[-1]
+        if k > W8A8_MAX_ACCUMULATOR_K:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} K={} exceeds the INT32 accumulation limit {}".format(
+                    W8A8_QMATMUL_OPCODE, k, W8A8_MAX_ACCUMULATOR_K
+                )
+            )
+        left_codes = _w8a8_int_codes(left_flat, "qmatmul.left")
+        right_codes = _w8a8_int_codes(right_flat, "qmatmul.right")
+        m = left_declared[-2]
+        n = right_declared[-1]
+        batch_shape = left_declared[:-2]
+        batch_count = 1
+        for dimension in batch_shape:
+            batch_count *= dimension
+        if len(left_codes) != batch_count * m * k or len(right_codes) != batch_count * k * n:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 {} operand sizes do not match the declared shapes".format(
+                    W8A8_QMATMUL_OPCODE
+                )
+            )
+        left_buffer = _buffer_from_values("int8", left_codes, "qmatmul.left")
+        right_buffer = _buffer_from_values("int8", right_codes, "qmatmul.right")
+        output = _buffer_alloc("int32", batch_count * m * n, "qmatmul.output")
+        left_elements = m * k
+        right_elements = k * n
+        output_elements = m * n
+        for batch_index in range(batch_count):
+            _call_w8a8_qmatmul(
+                loaded.module,
+                _NativeBuffer(
+                    left_buffer.dtype,
+                    left_elements,
+                    _buffer_pointer(left_buffer, batch_index * left_elements),
+                    left_buffer.owner,
+                    left_buffer.direct,
+                ),
+                _NativeBuffer(
+                    right_buffer.dtype,
+                    right_elements,
+                    _buffer_pointer(right_buffer, batch_index * right_elements),
+                    right_buffer.owner,
+                    right_buffer.direct,
+                ),
+                _NativeBuffer(
+                    output.dtype,
+                    output_elements,
+                    _buffer_pointer(output, batch_index * output_elements),
+                    output.owner,
+                    output.direct,
+                ),
+                m,
+                k,
+                n,
+            )
+        return tuple(_buffer_values(output))
+
+    def run_w8a8_dequantize_s8(
+        self,
+        artifact: Artifact,
+        codes: Any,
+        scales: Sequence[float],
+        *,
+        shape: Optional[Sequence[int]] = None,
+    ) -> Tuple[float, ...]:
+        """Run the native AVX-512 ``dequantize_s8`` diagnostic primitive."""
+
+        _, loaded = self._load_w8a8(artifact)
+        flat, declared_shape = _w8a8_declared_shape(codes, shape, "dequantize_s8.codes")
+        if len(declared_shape) < 1:
+            raise CpuAvx512ExecutionError("AVX-512 dequantize_s8 requires at least a 1-D input")
+        k = declared_shape[-1]
+        rows = 1
+        for dimension in declared_shape[:-1]:
+            rows *= dimension
+        if k == 0 or rows == 0:
+            raise CpuAvx512ExecutionError("AVX-512 dequantize_s8 requires non-empty [rows, K]")
+        if len(scales) != rows:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 dequantize_s8 expects {} per-row scales, got {}".format(rows, len(scales))
+            )
+        code_values = _w8a8_int_codes(flat, "dequantize_s8.codes")
+        try:
+            scale_values = tuple(float(scale) for scale in scales)
+        except (TypeError, ValueError) as exc:
+            raise CpuAvx512ExecutionError(
+                "AVX-512 dequantize_s8 scales must be real numbers"
+            ) from exc
+        codes_buffer = _buffer_from_values("int8", code_values, "dequantize_s8.codes")
+        scales_buffer = _buffer_from_values("float32", scale_values, "dequantize_s8.scales")
+        output = _buffer_alloc("float32", rows * k, "dequantize_s8.output")
+        _call_w8a8_dequantize_s8(loaded.module, codes_buffer, scales_buffer, output, rows, k)
+        return tuple(_buffer_values(output))
+
+    def run_w8a8_quantize_per_token_s8(
+        self,
+        artifact: Artifact,
+        values: Any,
+        *,
+        shape: Optional[Sequence[int]] = None,
+        dtype: str = "float32",
+    ) -> Avx512QuantizePerTokenResult:
+        """Run the native AVX-512 dynamic per-token absmax quantizer (Q1-Q6).
+
+        ``dtype`` selects the logical input dtype: ``float32`` passes the
+        values through and ``bf16`` first rounds them to bfloat16 (the native
