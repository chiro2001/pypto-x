+def _call_w8a8_qmatmul(
+    module: Any,
+    left: _NativeBuffer,
+    right: _NativeBuffer,
+    destination: _NativeBuffer,
+    m: int,
+    k: int,
+    n: int,
+) -> None:
+    """Run the native AVX-512 VNNI s8 x s8 -> s32 kernel.
+
+    The kernel returns ``-1`` when either operand contains the reserved
+    ``-128`` code point; that is a fail-closed scheme violation, not a value
+    that may be clamped silently.
+    """
+
+    function = _status_symbol(
+        module,
+        "ptx_avx512_qmatmul_s8s8_s32",
+        [
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_int32),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    status = int(function(left.pointer, right.pointer, destination.pointer, m, k, n))
+    if status != 0:
+        raise CpuAvx512ExecutionError(
+            "AVX-512 {} rejected reserved int8 code -128 (status {})".format(
+                W8A8_QMATMUL_OPCODE, status
+            )
+        )
+
+
+def _call_w8a8_dequantize_s8(
+    module: Any,
+    codes: _NativeBuffer,
+    scales: _NativeBuffer,
+    destination: _NativeBuffer,
+    rows: int,
+    k: int,
+) -> None:
+    function = _status_symbol(
+        module,
+        W8A8_DEQUANTIZE_S8_KERNEL,
+        [
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    status = int(function(codes.pointer, scales.pointer, destination.pointer, rows, k))
+    if status == -3:
+        raise CpuAvx512ExecutionError(
+            "AVX-512 dequantize_s8 product overflows binary32; refusing to return inf"
+        )
+    if status != 0:
+        raise CpuAvx512ExecutionError(
+            "AVX-512 dequantize_s8 rejected reserved int8 code -128 (status {})".format(status)
+        )
+
+
+def _call_w8a8_epilogue(
+    module: Any,
+    accumulator: _NativeBuffer,
+    row_scales: _NativeBuffer,
+    column_scales: _NativeBuffer,
+    destination: _NativeBuffer,
+    rows: int,
+    columns: int,
+) -> None:
+    function = _status_symbol(
+        module,
+        W8A8_EPILOGUE_KERNEL,
+        [
+            ctypes.POINTER(ctypes.c_int32),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_uint16),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+        ],
+    )
+    status = int(
+        function(
+            accumulator.pointer,
+            row_scales.pointer,
+            column_scales.pointer,
+            destination.pointer,
+            rows,
+            columns,
+        )
+    )
+    if status != 0:
+        raise CpuAvx512ExecutionError(
+            "AVX-512 dequantize_epilogue_bf16 product overflows binary32; refusing to return inf"
+        )
+
+
+def _call_w8a8_quantize_per_token_s8(
+    module: Any,
+    values: _NativeBuffer,
+    codes: _NativeBuffer,
+    scales: _NativeBuffer,
+    rows: int,
+    k: int,
+) -> int:
+    function = _status_symbol(
+        module,
+        "ptx_avx512_quantize_per_token_s8_f32",
+        [
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.POINTER(ctypes.c_int8),
+            ctypes.POINTER(ctypes.c_float),
+            ctypes.c_size_t,
+            ctypes.c_size_t,
+            ctypes.POINTER(ctypes.c_size_t),
+        ],
+    )
+    saturation = ctypes.c_size_t(0)
+    status = int(
+        function(values.pointer, codes.pointer, scales.pointer, rows, k, ctypes.byref(saturation))
+    )
+    if status != 0:
+        raise CpuAvx512ExecutionError(
+            "AVX-512 quantize_per_token_s8 native kernel rejected the input (status {})".format(status)
+        )
+    return int(saturation.value)
+
