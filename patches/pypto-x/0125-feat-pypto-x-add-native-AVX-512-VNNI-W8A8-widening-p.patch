+# --------------------------------------------------------------------------
+# disassembly evidence: real VPDPBUSD emission (AVX-512 is EVEX by design)
+# --------------------------------------------------------------------------
+
+
+def _function_disassembly(path, symbol):
+    objdump = shutil.which("objdump")
+    if objdump is None:
+        pytest.skip("objdump is unavailable")
+    result = subprocess.run(
+        [objdump, "-d", "--no-show-raw-insn", str(path)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        universal_newlines=True,
+        check=False,
+    )
+    body = []
+    current = None
+    for line in result.stdout.splitlines():
+        if line.endswith(">:") and "<" in line:
+            current = line[line.index("<") + 1 : line.rindex(">")]
+            continue
+        if current == symbol:
+            body.append(line)
+    if not body:
+        raise AssertionError("symbol {!r} not found in objdump output".format(symbol))
+    return "\n".join(body)
+
+
+def _function_evex_instruction_count(path, symbol):
+    """Count instructions whose first opcode byte is the EVEX prefix (0x62)."""
+
+    objdump = shutil.which("objdump")
+    if objdump is None:
+        pytest.skip("objdump is unavailable")
+    result = subprocess.run(
+        [objdump, "-d", str(path)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        universal_newlines=True,
+        check=False,
+    )
+    current = None
+    count = 0
+    for line in result.stdout.splitlines():
+        if line.endswith(">:") and "<" in line:
+            current = line[line.index("<") + 1 : line.rindex(">")]
+            continue
+        if current != symbol:
+            continue
+        match = re.match(r"^\s*[0-9a-f]+:\s+((?:[0-9a-f]{2} ?)+)\s", line)
+        if match and match.group(1).split()[0].lower() == "62":
+            count += 1
+    if current is None:
+        raise AssertionError("symbol {!r} not found in objdump output".format(symbol))
+    return count
+
+
+def test_objdump_qmatmul_emits_vpdpbusd_with_sign_compensation(carrier_artifact):
+    body = _function_disassembly(carrier_artifact.path, W8A8_QMATMUL_KERNEL)
+    # The real VNNI instruction must be present exactly as declared; C4 never
+    # falls back to vpdpwssd or to a scalar widening loop.
+    assert "vpdpbusd" in body
+    assert "vpdpwssd" not in body
+    assert "vpmovsxbd" in body
+    assert "vpslld" in body and "vpord" in body
+    assert "zmm" in body
+    assert _function_evex_instruction_count(carrier_artifact.path, W8A8_QMATMUL_KERNEL) > 0
+
+
+def test_objdump_quantize_uses_zmm_double_precision(carrier_artifact):
+    body = _function_disassembly(carrier_artifact.path, W8A8_QUANTIZE_KERNEL)
+    assert "vdivpd" in body
+    assert "vcvttpd2dq" in body
+    assert "vpminsd" in body and "vpmaxsd" in body
+    assert "zmm" in body
+
+
+def test_objdump_primitives_are_native_avx512(carrier_artifact):
+    dequantize = _function_disassembly(carrier_artifact.path, W8A8_DEQUANTIZE_S8_KERNEL)
+    epilogue = _function_disassembly(carrier_artifact.path, W8A8_EPILOGUE_KERNEL)
+    assert "vpmovsxbd" in dequantize
+    assert "vmulps" in dequantize
+    assert "vcvtdq2ps" in epilogue
+    assert "vmulps" in epilogue
+    for body in (dequantize, epilogue):
+        assert "zmm" in body
