+    for (element = 0; element < k * n; ++element)
+        if (right[element] == INT8_MIN) return -1;
+    for (row = 0; row < m; ++row) {
+        const int8_t *left_row = left + row * k;
+        int32_t *output_row = output + row * n;
+        int64_t row_sum = 0;
+        uint32_t correction;
+        for (index = 0; index < k; ++index) row_sum += left_row[index];
