@@ -0,0 +1,154 @@
+"""``tools/qwen35_reference`` 全模块「按文件路径加载」守卫。
+
+背景（KF-1 事故族）：本目录下的模块一度用
+``try: import sibling / except ImportError: from . import sibling`` 做双模式导入。
+当调用方用 ``importlib.util.spec_from_file_location`` 按文件路径加载、模块没有父包
+且目录不在 ``sys.path`` 时，两条路都会失败。``run_reference.py`` 已在 ``1fac306a2``
+修复；本测试把同目录**每个** ``.py`` 模块都按该方式加载一遍，断言不再抛
+``ImportError`` / ``AttributeError``，防止同类写法与未来新模块回归。
+
+环境契约：
+
+* 有 torch：用真 torch 加载；无 torch：注入只含 import 期会读取的 dtype 属性的
+  最小 stub（与 ``test_qwen35_portability_overrides.py`` 同口径）。守卫目标是
+  **导入机制**而非 torch 语义，因此无 torch 环境下同样给出确定结论，而不是整例跳过。
+* torch 之外的顶层第三方依赖（numpy / pytest 等）缺失时**显式 skip 并给出缺失名**，
+  绝不静默通过；
+* 每个模块都在隔离的 ``sys.path`` / ``sys.modules`` 视图中加载：临时移走
+  ``tools/qwen35_reference`` 并清掉同目录兄弟模块缓存，确保「无父包且目录不在
+  sys.path」这一前提在任意测试顺序下都成立（否则先加载的模块会把目录补进
+  sys.path，掩盖后续模块的回归）。
+"""
+
+import ast
+import contextlib
+import importlib.util
+import os
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[4]
+REFERENCE_DIR = REPOSITORY_ROOT / "tools" / "qwen35_reference"
+
+#: 目录下全部模块文件（含测试模块本身）；新增文件自动纳入守卫。
+REFERENCE_MODULES = tuple(sorted(path.name for path in REFERENCE_DIR.glob("*.py")))
+#: 按路径加载时必须以顶层模块名解析的兄弟模块（不能在 sys.modules 里命中残留）。
+SIBLING_NAMES = tuple(sorted(path.stem for path in REFERENCE_DIR.glob("*.py")))
+
+#: torch 缺失时的最小占位模块，只需提供 import 期被读取的 dtype 属性。
+_TORCH_STUB_ATTRS = {
+    "bfloat16": "torch.bfloat16",
+    "float32": "torch.float32",
+}
+
+
+def _torch_available():
+    """当前环境是否有可用的真 torch（带 ``__spec__`` 的 stub 不算）。"""
+    if "torch" in sys.modules:
+        return getattr(sys.modules["torch"], "__spec__", None) is not None
+    return importlib.util.find_spec("torch") is not None
+
+
+def _torch_stub():
+    stub = types.ModuleType("torch")
+    for name, value in _TORCH_STUB_ATTRS.items():
+        setattr(stub, name, value)
+    return stub
+
+
+def _top_level_third_party_deps(path):
+    """模块顶层 import 的第三方根模块名（函数体内的 import 不计入）。"""
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    roots = set()
+    for node in tree.body:
+        if isinstance(node, ast.Import):
+            roots.update(alias.name.split(".")[0] for alias in node.names)
+        elif isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
+            roots.add(node.module.split(".")[0])
+    stdlib = getattr(sys, "stdlib_module_names", ())
+    return sorted(name for name in roots if name != "__future__" and name not in stdlib)
+
+
+@contextlib.contextmanager
+def _isolated_import_state(hidden_dirs, hidden_module_names):
+    """临时把 ``hidden_dirs`` 移出 sys.path 并清掉 ``hidden_module_names`` 缓存。"""
+    saved_path = list(sys.path)
+    saved_modules = {name: sys.modules.get(name) for name in hidden_module_names}
+    hidden = {os.path.realpath(str(path)) for path in hidden_dirs}
+    sys.path[:] = [entry for entry in sys.path
+                   if os.path.realpath(str(entry)) not in hidden]
+    for name in hidden_module_names:
+        sys.modules.pop(name, None)
+    try:
+        yield
+    finally:
+        sys.path[:] = saved_path
+        for name, module in saved_modules.items():
+            if module is None:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = module
+
+
+def _load_by_file_path(path):
+    spec = importlib.util.spec_from_file_location("_bypath_guard_" + path.stem, path)
+    assert spec is not None and spec.loader is not None, "cannot build spec for %s" % path
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize("module_name", REFERENCE_MODULES)
+def test_reference_module_loads_without_package_context(module_name):
+    """无父包、目录不在 sys.path 时按文件路径加载每个模块。"""
+    path = REFERENCE_DIR / module_name
+    # 同目录兄弟模块不算外部依赖：它们就在本守卫加载的目录里。
+    missing = [dep for dep in _top_level_third_party_deps(path)
+               if dep != "torch" and dep not in SIBLING_NAMES
+               and importlib.util.find_spec(dep) is None]
+    if missing:
+        pytest.skip(
+            "%s 的顶层依赖 %s 在当前环境缺失；按守卫契约显式 skip，不静默通过"
+            % (module_name, ", ".join(missing))
+        )
+
+    stub_inserted = False
+    if not _torch_available():
+        sys.modules["torch"] = _torch_stub()
+        stub_inserted = True
+    try:
+        with _isolated_import_state((REFERENCE_DIR,), SIBLING_NAMES):
+            module = _load_by_file_path(path)
+    finally:
+        if stub_inserted:
+            sys.modules.pop("torch", None)
+
+    assert module.__file__ == str(path)
+    assert module.__name__ == "_bypath_guard_" + path.stem
+
+
+def test_guard_detects_relative_import_without_package(tmp_path):
+    """反例证明：修复前的 ``from . import`` 回退在同样的加载方式下必然 ImportError。
+
+    用临时目录合成「绝对导入失败 + 相对导入回退」的最小 victim，验证本守卫使用的
+    ``_load_by_file_path`` / 隔离断言确实能抓住该类写法；修复前真实文件的运行结果
+    另见证据 ``raw/pristine_counterexample.out``。
+    """
+    sibling = tmp_path / "guard_probe_sibling.py"
+    sibling.write_text("VALUE = 1\n", encoding="utf-8")
+    victim = tmp_path / "guard_probe_victim.py"
+    victim.write_text(
+        "try:\n"
+        "    import guard_probe_sibling\n"
+        "except ImportError:\n"
+        "    from . import guard_probe_sibling\n",
+        encoding="utf-8",
+    )
+
+    with pytest.raises(ImportError):
+        with _isolated_import_state((tmp_path,), ("guard_probe_sibling",)):
+            _load_by_file_path(victim)
