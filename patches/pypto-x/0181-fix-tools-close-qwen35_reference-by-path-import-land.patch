@@ -28,6 +28,14 @@ import sys
 
 import numpy as np
 
+# 按文件路径加载（如 importlib.spec_from_file_location）时没有父包，``from . import``
+# 必然失败；先把本文件所在目录加入 sys.path，使下面的同目录 import 生效。
+# 脚本方式运行时该目录本来就在 sys.path，包方式导入时保留相对导入回退。
+if not __package__:
+    _HERE = os.path.dirname(os.path.abspath(__file__))
+    if _HERE not in sys.path:
+        sys.path.insert(0, _HERE)
+
 try:
     import w8a8_quant
     import w8a8_scope
