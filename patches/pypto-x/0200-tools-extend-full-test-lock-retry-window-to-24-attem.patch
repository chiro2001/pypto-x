From 4d311e6c8c0a5163e488fef1526f98fc1e6a6400 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 03:16:15 +0800
Subject: [PATCH 200/252] tools: extend full-test lock retry window to 24
 attempts

---
 tools/sve256_liveness_evidence/run_full_tests.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/sve256_liveness_evidence/run_full_tests.sh b/tools/sve256_liveness_evidence/run_full_tests.sh
index cb69c0c28..223d0c0e3 100755
--- a/tools/sve256_liveness_evidence/run_full_tests.sh
+++ b/tools/sve256_liveness_evidence/run_full_tests.sh
@@ -3,7 +3,7 @@
 set -euo pipefail
 EVID=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/sve256-liveness-release
 WT=/home/chiro/projects/pypto/worktrees/pypto-x/sve256-liveness-release
-exec "${WT}/tools/sve256_liveness_evidence/run_with_lock_retry.sh" 12 300 "${EVID}/logs/full_tests" -- \
+exec "${WT}/tools/sve256_liveness_evidence/run_with_lock_retry.sh" 24 300 "${EVID}/logs/full_tests" -- \
   --task sve256-liveness-release \
   --agent sve256-liveness-release \
   --min-available-mib 8192 \
