From f64d92f3259efac4b1839a3177e7a18e2c628b66 Mon Sep 17 00:00:00 2001
From: chiro <chiro@local>
Date: Sat, 12 Sep 2026 01:15:35 +0800
Subject: [PATCH 158/258] fix(tools): c8-l4-sve256 progress segmentation by op
 index reset

---
 tools/c8_sve256_a3/summarize_window.py | 39 ++++++++++++++++++++++++++-------------
 1 file changed, 26 insertions(+), 13 deletions(-)

diff --git a/tools/c8_sve256_a3/summarize_window.py b/tools/c8_sve256_a3/summarize_window.py
index 86e67c161..1580afa69 100644
--- a/tools/c8_sve256_a3/summarize_window.py
+++ b/tools/c8_sve256_a3/summarize_window.py
@@ -32,9 +32,17 @@ def load_json(path: Path) -> Any:
 
 
 def parse_progress(path: Path) -> Mapping[str, Any]:
-    stages: Dict[str, Dict[str, Any]] = {}
+    """Segment per-op progress into launches (the driver resets ``index``).
+
+    The driver emits one top-level ``stage-start`` per process; each internal
+    ``_run_once`` launch restarts the op index at 0, which is the reliable
+    launch boundary in the progress stream.
+    """
+
+    launches: List[Dict[str, Any]] = []
     peak_rss = 0
-    current_stage = "unknown"
+    current: Dict[str, Any] = {"ops": 0, "first_t": None, "last_t": None,
+                               "first_index": None, "last_index": None}
     for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
         line = line.strip()
         if not line.startswith("{"):
@@ -46,23 +54,28 @@ def parse_progress(path: Path) -> Mapping[str, Any]:
         rss = item.get("rss_mib")
         if isinstance(rss, (int, float)):
             peak_rss = max(peak_rss, int(rss))
-        if item.get("kind") == "stage-start":
-            current_stage = str(item.get("stage") or "unknown")
-            stages.setdefault(current_stage, {"ops": 0, "first_t": None, "last_t": None})
-            continue
         if item.get("kind") != "op":
             continue
-        entry = stages.setdefault(current_stage, {"ops": 0, "first_t": None, "last_t": None})
-        entry["ops"] += 1
+        index = int(item.get("index") or 0)
+        if current["ops"] and index == 0:
+            launches.append(current)
+            current = {"ops": 0, "first_t": None, "last_t": None,
+                       "first_index": None, "last_index": None}
+        current["ops"] += 1
+        if current["first_index"] is None:
+            current["first_index"] = index
+        current["last_index"] = index
         t = item.get("t")
         if isinstance(t, (int, float)):
-            if entry["first_t"] is None:
-                entry["first_t"] = float(t)
-            entry["last_t"] = float(t)
-    for entry in stages.values():
+            if current["first_t"] is None:
+                current["first_t"] = float(t)
+            current["last_t"] = float(t)
+    if current["ops"]:
+        launches.append(current)
+    for entry in launches:
         first, last = entry["first_t"], entry["last_t"]
         entry["wall_seconds_progress"] = round(last - first, 3) if first and last else None
-    return {"stages": stages, "peak_rss_mib": peak_rss or None}
+    return {"launches": launches, "peak_rss_mib": peak_rss or None}
 
 
 def census_fields(record: Mapping[str, Any]) -> Mapping[str, Any]:
