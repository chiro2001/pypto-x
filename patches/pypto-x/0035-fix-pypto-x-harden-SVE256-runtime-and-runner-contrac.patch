+
+static int ptx_u64_mul(uint64_t left, uint64_t right, uint64_t *result) {
+    if (left && right > UINT64_MAX / left) return PTX_STATUS_BAD_REQUEST;
+    *result = left * right;
+    return PTX_STATUS_OK;
