+def _m1b_permutation(input_shape: Sequence[int], attributes: Mapping[str, Any], context: str) -> Tuple[int, ...]:
+    rank = len(input_shape)
+    raw_permutation = _m1b_attribute(attributes, ("permutation", "perm", "dims", "axes"), context)
+    raw_dim0 = _m1b_attribute(attributes, ("dim0", "axis0"), context)
+    raw_dim1 = _m1b_attribute(attributes, ("dim1", "axis1"), context)
+    if raw_permutation is not None and (raw_dim0 is not None or raw_dim1 is not None):
+        raise CpuScalarValidationError("{} cannot combine permutation with dim0/dim1".format(context))
+    if raw_permutation is None:
+        if raw_dim0 is None and raw_dim1 is None:
+            raise CpuScalarValidationError("{} requires permutation or dim0/dim1".format(context))
+        if raw_dim0 is None or raw_dim1 is None:
+            raise CpuScalarValidationError("{} requires both dim0 and dim1".format(context))
+        dim0 = _m1b_normalize_axis(raw_dim0, rank, context + ".dim0")
+        dim1 = _m1b_normalize_axis(raw_dim1, rank, context + ".dim1")
+        permutation = list(range(rank))
+        permutation[dim0], permutation[dim1] = permutation[dim1], permutation[dim0]
+        return tuple(permutation)
+    permutation = _m1b_int_sequence(raw_permutation, context + ".permutation", allow_negative=True)
+    if len(permutation) != rank:
+        raise CpuScalarValidationError(
+            "{} permutation rank {} does not match input rank {}".format(context, len(permutation), rank)
+        )
+    normalized = tuple(_m1b_normalize_axis(axis, rank, context + ".permutation") for axis in permutation)
+    if len(set(normalized)) != rank:
+        raise CpuScalarValidationError("{} permutation must contain each axis exactly once".format(context))
+    return normalized
+
