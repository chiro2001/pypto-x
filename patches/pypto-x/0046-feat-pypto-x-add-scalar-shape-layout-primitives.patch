+def test_slice_handles_negative_bounds_positive_step_and_empty_output():
+    source_type = CoreType.tensor("int32", (2, 5))
+    output_type = CoreType.tensor("int32", (2, 2))
+    source = ValueRef("source", source_type)
+    output = ValueRef("output", output_type)
+    program = _program(
+        "slice",
+        (source,),
+        (output,),
+        (
+            Operation(
+                "slice",
+                (source,),
+                (output,),
+                attributes={"starts": [-4], "stops": [-1], "axes": [-1], "steps": [2]},
+            ),
+        ),
+    )
+    destination = HostTensor.zeros("int32", (2, 2))
+    _run(program, [HostTensor("int32", (2, 5), list(range(10)))], destination)
+    assert destination.tolist() == [[1, 3], [6, 8]]
+
+    empty_type = CoreType.tensor("int32", (2, 0))
+    empty = ValueRef("empty", empty_type)
+    empty_program = _program(
+        "slice_empty",
+        (source,),
+        (empty,),
+        (Operation("slice", (source,), (empty,), attributes={"starts": [4], "stops": [2], "axes": [1]}),),
+    )
+    empty_output = HostTensor.zeros("int32", (2, 0))
+    _run(empty_program, [HostTensor("int32", (2, 5), list(range(10)))], empty_output)
+    assert empty_output.flat() == ()
