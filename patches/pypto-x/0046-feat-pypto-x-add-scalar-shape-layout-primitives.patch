+def _m1b_slice_spec(
+    input_shape: Sequence[int], attributes: Mapping[str, Any], context: str
+) -> Tuple[Tuple[int, int, int, int], ...]:
+    starts = _m1b_attribute(attributes, ("starts", "start"), context)
+    stops = _m1b_attribute(attributes, ("stops", "stop"), context)
+    if starts is None or stops is None:
+        raise CpuScalarValidationError("{} requires starts and stops".format(context))
+    starts = _m1b_int_sequence(starts, context + ".starts", allow_scalar=True)
+    stops = _m1b_int_sequence(stops, context + ".stops", allow_scalar=True)
+    if len(starts) != len(stops):
+        raise CpuScalarValidationError("{} starts and stops must have the same length".format(context))
+    axes_raw = _m1b_attribute(attributes, ("axes", "axis"), context)
+    axes = (
+        tuple(range(len(starts)))
+        if axes_raw is None
+        else _m1b_int_sequence(axes_raw, context + ".axes", allow_scalar=True)
+    )
+    steps_raw = _m1b_attribute(attributes, ("steps", "step"), context)
+    steps = (
+        (1,) * len(starts)
+        if steps_raw is None
+        else _m1b_int_sequence(steps_raw, context + ".steps", allow_scalar=True)
+    )
+    if not (len(axes) == len(steps) == len(starts)):
+        raise CpuScalarValidationError("{} starts/stops/axes/steps lengths must match".format(context))
+    rank = len(input_shape)
+    normalized_axes = tuple(_m1b_normalize_axis(axis, rank, context + ".axes") for axis in axes)
+    if len(set(normalized_axes)) != len(normalized_axes):
+        raise CpuScalarValidationError("{} axes must not contain duplicates".format(context))
+    spec = []
+    for index, axis in enumerate(normalized_axes):
+        step = steps[index]
+        if step <= 0:
+            raise CpuScalarUnsupportedError("{} only supports positive step values".format(context))
+        dimension = input_shape[axis]
+        start = starts[index]
+        stop = stops[index]
+        if start < -dimension or start > dimension or stop < -dimension or stop > dimension:
+            raise CpuScalarValidationError(
+                "{} bound at index {} is outside dimension {}".format(context, index, dimension)
+            )
+        normalized_start = start + dimension if start < 0 else start
+        normalized_stop = stop + dimension if stop < 0 else stop
+        spec.append((axis, normalized_start, normalized_stop, step))
+    return tuple(spec)
+
