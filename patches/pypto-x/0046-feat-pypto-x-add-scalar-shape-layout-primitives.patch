+    def _portable_call_attributes(
+        self,
+        op_name: str,
+        args: tuple[Any, ...],
+        kwargs: Any,
+        call: Any,
+        path: str,
+    ) -> dict[str, Any]:
+        """Lift public shape arguments into explicit Core operation attrs.
+
+        PIL keeps positional literals in ``Call.args``.  A target-neutral
+        operation must expose those semantics in serializable attributes so a
+        scalar runtime does not need to interpret a frontend-specific call
+        signature.  Only the audited M1B fields are lifted here.
+        """
+
+        result: dict[str, Any] = {}
+        recognized = {
+            "shape",
+            "target_shape",
+            "out_shape",
+            "permutation",
+            "perm",
+            "dims",
+            "dim0",
+            "dim1",
+            "axis0",
+            "axis1",
+            "starts",
+            "start",
+            "stops",
+            "stop",
+            "axes",
+            "steps",
+            "step",
+            "sizes",
+            "split_sizes",
+            "sections",
+            "num_splits",
+            "axis",
+            "dim",
+            "offsets",
+            "offset",
+            "valid_shape",
+            "valid_shapes",
+        }
+
+        def put(key: str, value: Any, value_path: str) -> None:
+            if key in result and result[key] != value:
+                raise PilCoreBridgeError("{} contains conflicting attribute {}".format(value_path, key))
+            result[key] = value
+
+        supplied = _get(call, "attributes", "attrs", default={})
+        if isinstance(supplied, Mapping):
+            for key, value in supplied.items():
+                if key in recognized:
+                    put(key, self._encode_literal(value, path + ".attributes." + key), path + ".attributes")
+
+        def literal(value: Any, value_path: str) -> Any:
