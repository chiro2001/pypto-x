+def _m1b_gather_axis(input_shape: Sequence[int], attributes: Mapping[str, Any], context: str) -> int:
+    raw_axis = _m1b_attribute(attributes, ("axis", "dim"), context, default=0)
+    return _m1b_normalize_axis(raw_axis, len(input_shape), context)
