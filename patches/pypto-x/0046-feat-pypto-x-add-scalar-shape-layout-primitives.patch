+@pytest.mark.parametrize(
+    "attributes",
+    ({"shape": [4, 2]}, {"shape": [-1, -1]}, {"shape": [5, -1]}),
+)
+def test_reshape_rejects_element_count_or_inference_errors(attributes):
+    source_type = CoreType.tensor("float32", (2, 3))
+    output_type = CoreType.tensor("float32", (6,))
+    source = ValueRef("source", source_type)
+    output = ValueRef("output", output_type)
+    program = _program(
+        "bad_reshape",
+        (source,),
+        (output,),
+        (Operation("reshape", (source,), (output,), attributes=attributes),),
+    )
+    with pytest.raises(CpuScalarValidationError):
+        CpuScalarCompiler().lower(program, TARGET)
