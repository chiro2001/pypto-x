+def test_transpose_supports_permutation_negative_axes_and_contiguous_materializes():
+    source_type = CoreType.tensor("int32", (2, 3, 4))
+    transposed_type = CoreType.tensor("int32", (4, 2, 3))
+    source = ValueRef("source", source_type)
+    transposed = ValueRef("transposed", transposed_type)
+    program = _program(
+        "transpose",
+        (source,),
+        (transposed,),
+        (Operation("transpose", (source,), (transposed,), attributes={"permutation": [-1, 0, 1]}),),
+    )
+    values = list(range(24))
+    output = HostTensor.zeros("int32", (4, 2, 3))
+    _run(program, [HostTensor("int32", (2, 3, 4), values)], output)
+    assert output.tolist() == [
+        [[0, 4, 8], [12, 16, 20]],
+        [[1, 5, 9], [13, 17, 21]],
+        [[2, 6, 10], [14, 18, 22]],
+        [[3, 7, 11], [15, 19, 23]],
+    ]
+
+    dim0 = ValueRef("dim0", CoreType.tensor("int32", (2, 4, 3)))
+    dim_program = _program(
+        "transpose_dims",
+        (source,),
+        (dim0,),
+        (Operation("transpose", (source,), (dim0,), attributes={"dim0": -1, "dim1": -2}),),
+    )
+    dim_output = HostTensor.zeros("int32", (2, 4, 3))
+    _run(dim_program, [HostTensor("int32", (2, 3, 4), values)], dim_output)
+    assert dim_output.tolist() == [
+        [[0, 4, 8], [1, 5, 9], [2, 6, 10], [3, 7, 11]],
+        [[12, 16, 20], [13, 17, 21], [14, 18, 22], [15, 19, 23]],
+    ]
+
+    contiguous = ValueRef("contiguous", transposed_type)
+    contiguous_program = _program(
+        "contiguous",
+        (transposed,),
+        (contiguous,),
+        (Operation("contiguous", (transposed,), (contiguous,)),),
+    )
+    contiguous_output = HostTensor.zeros("int32", (4, 2, 3))
+    _run(contiguous_program, [output], contiguous_output)
+    assert contiguous_output.flat() == output.flat()
