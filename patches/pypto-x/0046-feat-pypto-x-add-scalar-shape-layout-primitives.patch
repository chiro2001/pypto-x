+def _m1b_split_sizes(
+    input_shape: Sequence[int], output_types: Sequence[CoreType], attributes: Mapping[str, Any], context: str
+) -> Tuple[int, Tuple[int, ...]]:
+    axis_raw = _m1b_attribute(attributes, ("axis", "dim"), context, default=0)
+    axis = _m1b_normalize_axis(axis_raw, len(input_shape), context)
+    sizes_raw = _m1b_attribute(attributes, ("sizes", "split_sizes", "sections"), context)
+    if sizes_raw is None:
+        count_raw = _m1b_attribute(attributes, ("num_splits",), context)
+        if count_raw is None:
+            raise CpuScalarValidationError("{} requires sizes/sections".format(context))
+        count = _m1b_int(count_raw, context + ".num_splits")
+        if count <= 0 or input_shape[axis] % count != 0:
+            raise CpuScalarValidationError("{} num_splits must divide the split dimension".format(context))
+        sizes = (input_shape[axis] // count,) * count
+    else:
+        sizes = _m1b_int_sequence(sizes_raw, context + ".sizes", allow_negative=False)
+    if not sizes:
+        raise CpuScalarValidationError("{} sizes must not be empty".format(context))
+    if sum(sizes) != input_shape[axis]:
+        raise CpuScalarValidationError(
+            "{} sizes {} do not cover axis length {}".format(context, sizes, input_shape[axis])
+        )
+    if len(output_types) != len(sizes):
+        raise CpuScalarValidationError(
+            "{} has {} outputs but sizes declares {}".format(context, len(output_types), len(sizes))
+        )
+    expected_shapes = []
+    for size in sizes:
+        shape = list(input_shape)
+        shape[axis] = size
+        expected_shapes.append(tuple(shape))
+    for index, (output_type, expected) in enumerate(zip(output_types, expected_shapes)):
+        if not _is_tensor(output_type):
+            raise CpuScalarUnsupportedError("{} output {} must be a tensor".format(context, index))
+        _validate_dtype(output_type, "{} output {}".format(context, index))
+        if static_shape(output_type, "{} output {}".format(context, index)) != expected:
+            raise CpuScalarValidationError(
+                "{} output {} shape {} does not match {}".format(context, index, output_type.shape, expected)
+            )
+    return axis, sizes
+
