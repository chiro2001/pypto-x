+def _m1b_attribute(
+    attributes: Mapping[str, Any],
+    keys: Sequence[str],
+    context: str,
+    *,
+    default: Any = None,
+) -> Any:
+    """Read one logical attribute from explicit, audited spellings.
+
+    Core IR is serialized, so accepting two spellings with different values
+    would make the same operation depend on the consumer.  Equal aliases are
+    harmless and are accepted; conflicting aliases fail during lowering.
+    """
+
+    present = [key for key in keys if key in attributes]
+    if not present:
+        return default
+    first = attributes[present[0]]
+    for key in present[1:]:
+        if attributes[key] != first:
+            raise CpuScalarValidationError(
+                "{} contains conflicting attributes {}".format(context, ", ".join(present))
+            )
+    return first
+
+
+def _m1b_int(value: Any, context: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise CpuScalarValidationError("{} must be an integer".format(context))
+    return value
+
+
+def _m1b_int_sequence(
+    value: Any,
+    context: str,
+    *,
+    allow_scalar: bool = False,
+    allow_negative: bool = True,
+) -> Tuple[int, ...]:
+    if allow_scalar and isinstance(value, int) and not isinstance(value, bool):
+        values = (value,)
+    else:
+        if isinstance(value, (str, bytes)):
+            raise CpuScalarValidationError("{} must be a sequence of integers".format(context))
+        try:
+            values = tuple(value)
+        except TypeError as exc:
+            raise CpuScalarValidationError("{} must be a sequence of integers".format(context)) from exc
+    result = []
+    for index, item in enumerate(values):
+        item = _m1b_int(item, "{}[{}]".format(context, index))
+        if not allow_negative and item < 0:
+            raise CpuScalarValidationError("{}[{}] cannot be negative".format(context, index))
+        result.append(item)
+    return tuple(result)
+
+
+def _m1b_normalize_axis(axis: Any, rank: int, context: str) -> int:
+    axis = _m1b_int(axis, context)
+    normalized = axis + rank if axis < 0 else axis
+    if normalized < 0 or normalized >= rank:
+        raise CpuScalarValidationError("{} axis {} is outside rank {}".format(context, axis, rank))
+    return normalized
+
+
+def _m1b_reshape_shape(
+    input_shape: Sequence[int],
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+    context: str,
+) -> Tuple[int, ...]:
+    raw = _m1b_attribute(attributes, ("shape", "target_shape", "out_shape"), context)
+    if raw is None:
+        # A static CoreType is authoritative when the front-end has already
+        # materialized the result type.  The element-count check below still
+        # prevents an accidental reorder or truncation.
+        requested = tuple(output_type.shape)
+    else:
+        requested_values = _m1b_int_sequence(raw, context + ".shape", allow_negative=True)
+        if any(item < -1 for item in requested_values):
+            raise CpuScalarValidationError("{} shape dimensions may only be -1 or non-negative".format(context))
+        if sum(item == -1 for item in requested_values) > 1:
+            raise CpuScalarValidationError("{} shape may contain at most one -1".format(context))
+        requested = requested_values
+    input_count = element_count(tuple(input_shape))
+    unknown = [index for index, item in enumerate(requested) if item == -1]
+    if unknown:
+        known_product = element_count(tuple(item for item in requested if item != -1))
+        if known_product == 0 or input_count % known_product != 0:
+            raise CpuScalarValidationError(
+                "{} cannot infer -1 from input element count {} and shape {}".format(
+                    context, input_count, requested
+                )
+            )
+        resolved_values = list(requested)
+        resolved_values[unknown[0]] = input_count // known_product
+        resolved = tuple(resolved_values)
+    else:
+        resolved = tuple(requested)
+    if element_count(resolved) != input_count:
+        raise CpuScalarValidationError(
+            "{} element count {} does not match input count {}".format(
+                context, element_count(resolved), input_count
+            )
+        )
+    output_shape = static_shape(output_type, context + ".output")
+    if output_shape != resolved:
+        raise CpuScalarValidationError(
+            "{} output shape {} does not match resolved shape {}".format(context, output_shape, resolved)
+        )
+    return resolved
+
