+def test_split_uses_serializable_multi_output_operation_for_non_equal_sizes_and_negative_axis():
+    source_type = CoreType.tensor("int32", (2, 6))
+    left_type = CoreType.tensor("int32", (2, 2))
+    middle_type = CoreType.tensor("int32", (2, 1))
+    right_type = CoreType.tensor("int32", (2, 3))
+    source = ValueRef("source", source_type)
+    left = ValueRef("left", left_type)
+    middle = ValueRef("middle", middle_type)
+    right = ValueRef("right", right_type)
+    split = Operation(
+        "split",
+        (source,),
+        (left, middle, right),
+        attributes={"sizes": [2, 1, 3], "axis": -1},
+    )
+    program = _program("split", (source,), (left, middle, right), (split,))
+    assert program.to_dict()["functions"][0]["body"]["operations"][0]["outputs"]
+    outputs = [HostTensor.zeros("int32", shape) for shape in ((2, 2), (2, 1), (2, 3))]
+    _run(program, [HostTensor("int32", (2, 6), list(range(12)))], outputs)
+    assert outputs[0].tolist() == [[0, 1], [6, 7]]
+    assert outputs[1].tolist() == [[2], [8]]
+    assert outputs[2].tolist() == [[3, 4, 5], [9, 10, 11]]
