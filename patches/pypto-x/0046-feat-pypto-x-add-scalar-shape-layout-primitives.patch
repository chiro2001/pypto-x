+def _reshape_value(value: Any, output_type: CoreType) -> List[Any]:
+    if not isinstance(value, list):
+        raise CpuScalarExecutionError("reshape/view requires tensor storage")
+    output_shape = static_shape(output_type, "reshape output")
+    if len(value) != element_count(output_shape):
+        raise CpuScalarExecutionError("reshape/view storage length does not match output shape")
+    # Row-major flattening is the only scalar layout.  A reshape changes the
+    # static shape while preserving this logical sequence byte-for-byte.
+    return list(value)
+
+
+def _transpose_value(
+    value: Any,
+    input_type: CoreType,
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+) -> List[Any]:
+    if not isinstance(value, list):
+        raise CpuScalarExecutionError("transpose requires tensor storage")
+    input_shape = static_shape(input_type, "transpose input")
+    output_shape = static_shape(output_type, "transpose output")
+    permutation = _m1b_permutation(input_shape, attributes, "transpose")
+    result = []
+    for output_index in range(element_count(output_shape)):
+        output_coords = _unravel(output_index, output_shape)
+        input_coords = [0] * len(input_shape)
+        for output_axis, input_axis in enumerate(permutation):
+            input_coords[input_axis] = output_coords[output_axis]
+        result.append(value[_ravel(input_coords, input_shape)])
+    return result
+
+
+def _slice_value(
+    value: Any,
+    input_type: CoreType,
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+) -> List[Any]:
+    if not isinstance(value, list):
+        raise CpuScalarExecutionError("slice requires tensor storage")
+    input_shape = static_shape(input_type, "slice input")
+    output_shape = static_shape(output_type, "slice output")
+    spec = _m1b_slice_spec(input_shape, attributes, "slice")
+    starts = {axis: (start, stop, step) for axis, start, stop, step in spec}
+    result = []
+    for output_index in range(element_count(output_shape)):
+        output_coords = _unravel(output_index, output_shape)
+        input_coords = list(output_coords)
+        for axis, (start, _stop, step) in starts.items():
+            input_coords[axis] = start + output_coords[axis] * step
+        result.append(value[_ravel(input_coords, input_shape)])
+    return result
+
+
+def _split_value(
+    value: Any,
+    input_type: CoreType,
+    output_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+) -> Tuple[List[Any], ...]:
+    if not isinstance(value, list):
+        raise CpuScalarExecutionError("split requires tensor storage")
+    input_shape = static_shape(input_type, "split input")
+    axis, sizes = _m1b_split_sizes(input_shape, output_types, attributes, "split")
+    results = []
+    offset = 0
+    for output_type, size in zip(output_types, sizes):
+        output_shape = static_shape(output_type, "split output")
+        output_values = []
+        for output_index in range(element_count(output_shape)):
+            output_coords = _unravel(output_index, output_shape)
+            input_coords = list(output_coords)
+            input_coords[axis] += offset
+            output_values.append(value[_ravel(input_coords, input_shape)])
+        results.append(output_values)
+        offset += size
+    return tuple(results)
+
+
+def _concat_value(
+    values: Sequence[Any],
+    input_types: Sequence[CoreType],
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+) -> List[Any]:
+    if not values:
+        raise CpuScalarExecutionError("concat requires at least one input")
+    input_shapes = [static_shape(value_type, "concat input") for value_type in input_types]
+    output_shape = static_shape(output_type, "concat output")
+    axis = _m1b_attribute(attributes, ("axis", "dim"), "concat", default=0)
+    axis = axis + len(output_shape) if axis < 0 else axis
+    if axis < 0 or axis >= len(output_shape):
+        raise CpuScalarExecutionError("concat axis is outside output rank")
+    boundaries = []
+    running = 0
+    for shape in input_shapes:
+        boundaries.append((running, running + shape[axis]))
+        running += shape[axis]
+    result = []
+    for output_index in range(element_count(output_shape)):
+        output_coords = _unravel(output_index, output_shape)
+        source_index = None
+        local_axis = None
+        for index, (start, stop) in enumerate(boundaries):
+            if start <= output_coords[axis] < stop:
+                source_index = index
+                local_axis = output_coords[axis] - start
+                break
+        if source_index is None:
+            # This is only reachable for an empty output axis.  There are no
+            # output indices in that case, but retain an explicit guard.
+            raise CpuScalarExecutionError("concat output coordinate is outside input segments")
+        source_coords = list(output_coords)
+        source_coords[axis] = local_axis
+        source_shape = input_shapes[source_index]
+        result.append(values[source_index][_ravel(source_coords, source_shape)])
+    return result
+
+
+def _gather_value(
+    source: Any,
+    source_type: CoreType,
+    indices: Any,
+    index_type: CoreType,
+    output_type: CoreType,
+    attributes: Mapping[str, Any],
+    *,
+    embedding: bool = False,
+) -> List[Any]:
+    if not isinstance(source, list) or not isinstance(indices, list):
+        raise CpuScalarExecutionError("gather/embedding requires tensor storage")
+    source_shape = static_shape(source_type, "gather source")
+    index_shape = static_shape(index_type, "gather indices")
+    output_shape = static_shape(output_type, "gather output")
+    axis = 0 if embedding else _m1b_gather_axis(source_shape, attributes, "gather")
+    index_rank = len(index_shape)
+    result = []
+    for output_index in range(element_count(output_shape)):
+        output_coords = _unravel(output_index, output_shape)
+        index_coords = output_coords[axis : axis + index_rank]
+        index_offset = _ravel(index_coords, index_shape) if index_shape else 0
+        selected = indices[index_offset]
+        if isinstance(selected, bool) or not isinstance(selected, int):
+            raise CpuScalarExecutionError("gather index is not an integer")
+        if selected < 0 or selected >= source_shape[axis]:
+            raise CpuScalarExecutionError(
+                "gather index {} is outside axis {} length {}".format(selected, axis, source_shape[axis])
+            )
+        source_coords = list(output_coords[:axis]) + [selected] + list(output_coords[axis + index_rank :])
+        result.append(source[_ravel(source_coords, source_shape)])
+    return result
+
+
 def _cast_value_for_operation(value: Any, output_type: CoreType) -> Any:
     """Cast a scalar or flat tensor to the already-validated output dtype."""
 
