+def test_backend_view_capabilities_are_public_and_honest():
+    from pypto.backends.cpu.x86 import (
+        AVX512_VIEW_CAPABILITY,
+        view_alias_capability as avx512_view_capability,
+    )
+    from pypto.backends.cpu.aarch64 import (
+        SVE256_VIEW_CAPABILITY,
+        view_alias_capability as sve256_view_capability,
+    )
+
+    avx512 = avx512_view_capability()
+    assert avx512 is AVX512_VIEW_CAPABILITY
+    assert avx512.alias_proof == "supported"
+    assert tuple(avx512.supported_view_modes) == ("forbid", "prefer", "require")
+    assert avx512.stride_class == "contiguous_identity"
+    assert avx512.max_rank > 0
+
+    sve256 = sve256_view_capability()
+    assert sve256 is SVE256_VIEW_CAPABILITY
+    assert sve256.alias_proof == "unsupported"
+    assert tuple(sve256.supported_view_modes) == ("forbid", "prefer")
+    assert sve256.stride_class == "none"
+    assert "TypedByteView" in sve256.reason
+
+
