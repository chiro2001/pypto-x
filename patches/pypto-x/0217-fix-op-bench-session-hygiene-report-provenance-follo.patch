+def test_artifacts_embedded_hashes_match_disk(tmp_path):
+    """Embedded artifact hashes must equal the bytes on disk.
+
+    Regression: the report JSON embedded a self-hash computed before the final
+    rewrite (stale by construction); the self entry is now excluded and the
+    true report hash lives in sha256sums.txt.
+    """
+
+    report = runner.run_and_write(_tiny_config(out_dir=str(tmp_path), tag="pytest-artifacts"))
+    assert report.get("artifacts")
+    with open(tmp_path / "op-bench-report.json", encoding="utf-8") as handle:
+        on_disk = json.load(handle)
+    embedded = on_disk["artifacts"]["sha256"]
+    assert "op-bench-report.json" not in embedded
+    assert "self_hash_note" in on_disk["artifacts"]
+    for name in ("op-bench-report.md", "op-bench-schema.json"):
+        digest = hashlib.sha256((tmp_path / name).read_bytes()).hexdigest()
+        assert embedded[name] == digest, name
+    sums = {}
+    for line in (tmp_path / "sha256sums.txt").read_text(encoding="utf-8").splitlines():
+        digest, name = line.split()
+        sums[name] = digest
+    assert sums["op-bench-report.json"] == hashlib.sha256(
+        (tmp_path / "op-bench-report.json").read_bytes()
+    ).hexdigest()
+
+
+def test_status_reason_reflects_case_filter(tiny_report):
+    assert tiny_report["status"] == "PASS"
+    reason = tiny_report["status_reason"]
+    assert "explicitly skipped by --case-filter" in reason
+    assert "measured 1/" in reason
+
+
+def test_host_fingerprint_records_interpreter(tiny_report):
+    fingerprint = tiny_report["host_fingerprint"]
+    assert fingerprint["python"]
+    assert fingerprint["python_executable"].endswith(("python3", "python"))
+    assert fingerprint["numpy"]
+
+
 def test_case_filter_marks_skipped_cases_explicitly(tiny_report):
