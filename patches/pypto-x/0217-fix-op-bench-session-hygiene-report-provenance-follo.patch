-# The canonical pypto_x pytest invocation exports PYPTO_X_PORTABLE_ONLY=1
-# before pytest (integration-health-check/raw/heavy_inner.sh:16).  When this
-# file is collected outside that harness, select the same frozen portable-only
-# mode -- but never fabricate a `pypto` module: the REAL package must stay in
-# ``sys.modules`` with ``__portable_only__`` for every later test file in the
-# session (regression: a session-scoped fake package without that attribute
-# made frontend/__init__ take the classic branch and broke 10 later tests).
-# Guarded by ``test_real_pypto_package_survives_op_bench_imports``.
-os.environ.setdefault("PYPTO_X_PORTABLE_ONLY", "1")
+# Session-hygiene contract: this file imports the REAL ``pypto`` package in
+# whatever mode the session was started with and never fabricates a module or
+# mutates ``os.environ`` (two regressions found by the canonical full suite:
+# a fake package without ``__portable_only__`` broke 10 later tests, and an
+# ``os.environ.setdefault`` would have forced portable-only mode on classic
+# sessions).  When the session cannot import pypto at all (source tree without
+# ``PYPTO_X_PORTABLE_ONLY=1`` and no installed wheel), skip this module
+# explicitly instead of pretending.
+try:
+    import pypto  # noqa: E402
+except Exception as _pypto_import_error:  # noqa: BLE001 - surface, never pollute
+    pytest.skip(
+        "real pypto package is not importable in this session ({}); set "
+        "PYPTO_X_PORTABLE_ONLY=1 or install the wheel".format(_pypto_import_error),
+        allow_module_level=True,
+    )
 
