+def test_import_does_not_mutate_portable_only_env(tmp_path):
+    """Importing this file must not change PYPTO_X_PORTABLE_ONLY (in or out).
+
+    Runs the module import in a child process with the variable removed, so
+    the assertion holds even though the parent session is portable-only.
+    """
+
+    child_env = dict(os.environ)
+    child_env.pop("PYPTO_X_PORTABLE_ONLY", None)
+    child_code = (
+        "import importlib.util, os, sys\n"
+        "path = sys.argv[1]\n"
+        "before = os.environ.get('PYPTO_X_PORTABLE_ONLY')\n"
+        "spec = importlib.util.spec_from_file_location('op_bench_import_probe', path)\n"
+        "module = importlib.util.module_from_spec(spec)\n"
+        "try:\n"
+        "    spec.loader.exec_module(module)\n"
+        "except BaseException:\n"
+        "    pass  # module-level pytest.skip in a bare import context\n"
+        "after = os.environ.get('PYPTO_X_PORTABLE_ONLY')\n"
+        "print('before=%r after=%r' % (before, after))\n"
+        "raise SystemExit(0 if before == after else 1)\n"
+    )
+    result = subprocess.run(
+        [sys.executable, "-c", child_code, str(Path(__file__))],
+        env=child_env,
+        capture_output=True,
+        text=True,
+        timeout=300,
+    )
+    assert result.returncode == 0, result.stderr
+    assert "before=None after=None" in result.stdout
 
 
 # ---------------------------------------------------------------------------
