+++ b/python/pypto/op_bench/report.py
@@ -275,12 +275,24 @@ def write_artifacts(
     with open(sums_path, "w", encoding="utf-8") as handle:
         for digest, name in entries:
             handle.write("{}  {}\n".format(digest, name))
+    # A file cannot embed its own hash without a fixed-point iteration: the
+    # embedded block therefore covers every artifact EXCEPT the report JSON,
+    # whose true hash lives in sha256sums.txt.  This keeps every embedded
+    # digest equal to the bytes on disk (regression: the old self-entry was
+    # computed before the final rewrite and shipped a stale hash).
+    embedded = {
+        name: digest
+        for digest, name in entries
+        if name != os.path.basename(json_path)
+    }
     return {
         "json": json_path,
         "markdown": md_path,
         "schema": schema_path,
         "sha256sums": sums_path,
-        "sha256": {name: digest for digest, name in entries},
+        "sha256": embedded,
+        "self_hash_note": "op-bench-report.json is excluded from its own sha256 map; "
+        "its hash is in sha256sums.txt",
     }
 
 
