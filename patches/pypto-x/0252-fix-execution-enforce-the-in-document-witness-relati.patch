@@ -342,6 +342,70 @@ class ProviderCapability:
 
 
 
+def measured_witness_shortfall(envelope: Any) -> dict:
+    """Return every K where a witness cited by *envelope* exceeds its measurement.
+
+    The exactness envelope cites its own witness observations in
+    ``measurement_scope.external[*].observed_max_by_k`` and in the historical
+    ``q8_reference_observed_by_k`` table.  ``measured_deviation_by_k`` is the
+    recorded measurement of the same quantity, so a measurement below a cited
+    witness (or a witness K missing from the measurement) is an in-document
+    contradiction and must fail closed in both plan and report validation.
+
+    *Raising* ``measured_deviation_by_k`` above every cited witness is not
+    refutable inside one document (nothing in the document bounds it from
+    above); that is a documented irreducible boundary and deliberately not
+    checked here.  Witness values that are not plain ints are ignored: they are
+    explanation-layer payloads whose type is validated where they are consumed.
+    """
+
+    if not isinstance(envelope, Mapping):
+        return {}
+    measured = envelope.get("measured_deviation_by_k")
+    if not isinstance(measured, Mapping):
+        return {}
+    shortfall: dict = {}
+
+    def check(key: Any, observed: Any, source: str) -> None:
+        if isinstance(key, bool) or not isinstance(key, str):
+            return
+        if isinstance(observed, bool) or not isinstance(observed, int):
+            return
+        recorded = measured.get(key)
+        if (
+            isinstance(recorded, bool)
+            or not isinstance(recorded, int)
+            or recorded < observed
+        ):
+            shortfall.setdefault(key, []).append(
+                {"source": source, "observed": observed, "measured": recorded}
+            )
+
+    scope = envelope.get("measurement_scope")
+    if isinstance(scope, Mapping):
+        external = scope.get("external")
+        if isinstance(external, (list, tuple)):
+            for index, entry in enumerate(external):
+                if not isinstance(entry, Mapping):
+                    continue
+                observed = entry.get("observed_max_by_k")
+                if not isinstance(observed, Mapping):
+                    continue
+                for key, value in observed.items():
+                    check(
+                        key,
+                        value,
+                        "measurement_scope.external[{}]: {}".format(
+                            index, entry.get("source", "unnamed")
+                        ),
+                    )
+    q8_reference = envelope.get("q8_reference_observed_by_k")
+    if isinstance(q8_reference, Mapping):
+        for key, value in q8_reference.items():
+            check(key, value, "q8_reference_observed_by_k")
+    return shortfall
+
+
 __all__ = [
     "MEASURED_SNAPSHOT_BOUND_KIND",
     "PORTABLE_ARTIFACT_KIND",
@@ -350,4 +414,5 @@ __all__ = [
