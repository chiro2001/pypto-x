+# ---------------------------------------------------------------------------
+# in-document witness relation: measured_deviation_by_k vs the cited witnesses
+# ---------------------------------------------------------------------------
+def _set_measured(envelope, key, value):
+    measured = dict(envelope["measured_deviation_by_k"])
+    measured[key] = value
+    envelope["measured_deviation_by_k"] = measured
+
+
+def _set_external_witness(envelope, index, key, value):
+    scope = dict(envelope["measurement_scope"])
+    external = [dict(item) for item in scope["external"]]
+    observed = dict(external[index].get("observed_max_by_k", {}))
+    observed[key] = value
+    external[index]["observed_max_by_k"] = observed
+    scope["external"] = external
+    envelope["measurement_scope"] = scope
+
+
+def _below_external_witness(envelope):
+    # The cited 648-case scan observed 1 at K=2048.
+    _set_measured(envelope, "2048", 0)
+
+
+def _below_q8_witness(envelope):
+    # q8_reference_observed_by_k[133144] is 22 and the cited scans reach 1067.
+    _set_measured(envelope, "133144", 0)
+
+
+def _witness_raised_above_measured(envelope):
+    _set_external_witness(envelope, 2, "133144", 2000)
+
+
+def _witness_key_missing_from_measured(envelope):
+    _set_external_witness(envelope, 2, "9999", 0)
+
+
+_WITNESS_MUTATIONS = (
+    _below_external_witness,
+    _below_q8_witness,
+    _witness_raised_above_measured,
+    _witness_key_missing_from_measured,
+)
+
+
+def _mutated_vendor_entries(mutator):
+    entries = []
+    for entry in aocl_int8_provider_capabilities():
+        document = dict(entry.to_dict())
+        envelope = dict(document["exactness_envelope"])
+        mutator(envelope)
+        document["exactness_envelope"] = envelope
+        entries.append(ProviderCapability.from_dict(document))
+    return entries
+
+
+def _required_vendor_policy():
+    return ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="required", required=AOCL_LPGEMM_INT8_PROVIDER_ID),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=1),
+    )
+
+
+@requires_aocl
+@requires_int8_host
+@pytest.mark.parametrize("mutator", _WITNESS_MUTATIONS)
+def test_plan_refuses_measurement_below_a_cited_witness(mutator):
+    """A measured snapshot must dominate the witnesses the plan itself cites."""
+
+    entries = _mutated_vendor_entries(mutator)
+    snapshot = _host_snapshot(providers=[portable_provider_capability()] + entries)
+    details = _assert_failure(
+        ARTIFACT_MISMATCH,
+        lambda: resolve_qmatmul(_required_vendor_policy(), snapshot, (2, 8), (8, 2)),
+    )
+    assert details["reason"] == "plan_field_inconsistent"
+    assert "witness" in str(details["message"])
+
+
+@requires_aocl
+@requires_int8_host
+@pytest.mark.parametrize("mutator", _WITNESS_MUTATIONS)
+def test_report_refuses_measurement_below_a_cited_witness(mutator):
+    """The same witness relation is enforced on both report envelope copies."""
+
+    left = _tensor((2, 16), seed=831)
+    right = _tensor((16, 2), seed=832)
+    _, report = execute_qmatmul(left, right, _vendor_policy(max_threads=1))
+    document = report.to_dict()
+    validate_report_schema(document)
+    for holder in ("guarantees", "resolved"):
+        mutator(document[holder]["exactness_envelope"])
+    with pytest.raises(ExecutionError) as excinfo:
+        validate_report_schema(document)
+    assert excinfo.value.code == "REPORT_SCHEMA_INVALID"
+    assert excinfo.value.reason == "report_field_inconsistent"
+    assert "witness" in str(excinfo.value)
+
+
+@requires_aocl
+@requires_int8_host
+def test_measured_above_every_cited_witness_is_a_documented_boundary():
+    """Nothing inside one document bounds measured_deviation_by_k from above."""
+
+    entries = _mutated_vendor_entries(lambda envelope: _set_measured(envelope, "133144", 5000))
+    snapshot = _host_snapshot(providers=[portable_provider_capability()] + entries)
+    resolution = resolve_qmatmul(_required_vendor_policy(), snapshot, (2, 8), (8, 2))
+    envelope = resolution.plan.numeric_guarantee["exactness_envelope"]
+    assert envelope["measured_deviation_by_k"]["133144"] == 5000
+    assert "deviation_bound_by_k" not in envelope
+
+    left = _tensor((2, 16), seed=841)
+    right = _tensor((16, 2), seed=842)
+    _, report = execute_qmatmul(left, right, _vendor_policy(max_threads=1))
+    document = report.to_dict()
+    for holder in ("guarantees", "resolved"):
+        _set_measured(document[holder]["exactness_envelope"], "133144", 5000)
+    validate_report_schema(document)
+
+
