+            if kind == "measured_snapshot" and envelope.get("deviation_bound_by_k"):
+                raise ReportSchemaError(
+                    "a measured-snapshot exactness envelope must not declare a deviation bound",
+                    field="report.{}.exactness_envelope.deviation_bound_by_k".format(holder_path),
+                    requested=envelope.get("deviation_bound_by_k"),
+                    reason="report_field_inconsistent",
+                )
+            for field in ("deviation_bound_by_k", "measured_deviation_by_k"):
+                values = envelope.get(field)
+                if values is None:
+                    continue
+                if not isinstance(values, Mapping):
+                    raise ReportSchemaError(
+                        "execution report field {!r} must be a mapping".format(
+                            holder_path + ".exactness_envelope." + field
+                        ),
+                        field="report.{}.exactness_envelope.{}".format(holder_path, field),
+                        requested=type(values).__name__,
+                        reason="report_field_wrong_type",
+                    )
+                for key, value in values.items():
+                    if (
+                        not isinstance(key, str)
+                        or isinstance(value, bool)
+                        or not isinstance(value, int)
+                        or value < 0
+                    ):
+                        raise ReportSchemaError(
+                            "execution report field {!r} must map K buckets to non-negative ints".format(
+                                holder_path + ".exactness_envelope." + field
+                            ),
+                            field="report.{}.exactness_envelope.{}".format(holder_path, field),
+                            requested={str(key): value},
+                            reason="report_field_wrong_type",
+                        )
 
 
