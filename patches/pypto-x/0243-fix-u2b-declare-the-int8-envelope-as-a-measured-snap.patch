+@requires_aocl
+@requires_int8_host
+@pytest.mark.parametrize("k,seed,expected_delta", ((16696, 147, 75), (133144, 115, 841)))
+def test_verifier_witnesses_reproduce_the_snapshot_refutation(k, seed, expected_delta):
+    """verify-0042-u2b's witnesses replayed through the real provider path."""
+
+    import numpy as np
+
+    a = np.random.default_rng(seed).integers(100, 128, size=(2, k), dtype=np.int16).astype(np.int8)
+    b = np.random.default_rng(seed + 7001).integers(100, 128, size=(k, 6), dtype=np.int16).astype(np.int8)
+    left = HostTensor("int8", (2, k), [int(value) for value in a.reshape(-1)])
+    right = HostTensor("int8", (k, 6), [int(value) for value in b.reshape(-1)])
+    output, report = execute_qmatmul(left, right, _vendor_policy(max_threads=1))
+    exact = a.astype(np.int64) @ b.astype(np.int64)
+    delta = max(abs(int(got) - int(expected)) for got, expected in zip(output.flat(), exact.reshape(-1)))
+    assert delta == expected_delta, (delta, expected_delta)
+    envelope = report.to_dict()["guarantees"]["exactness_envelope"]
+    assert envelope["deviation_bound_kind"] == "measured_snapshot"
+    assert "deviation_bound_by_k" not in envelope
+    assert envelope["measured_deviation_by_k"][str(k)] >= expected_delta
