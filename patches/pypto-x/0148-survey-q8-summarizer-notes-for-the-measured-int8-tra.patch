From 6fa9de148d56285e96608d91c55648aa8c0c3165 Mon Sep 17 00:00:00 2001
From: PyPTO-X Agent <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:45:39 +0800
Subject: [PATCH 148/235] survey(q8): summarizer notes for the measured int8
 trade-off (vendor-gemm-survey)

Records, next to the generated table: (1) all 12 shapes came out bitwise
against portable in this window while the parity probe proves that is
distribution luck rather than a structural guarantee; (2) the
m=5/k=2048/n=1024 AOCL cells are contaminated (3.4 ms in-window vs
0.014-0.018 ms on two independent focused re-measurements); (3) the gate
status is UNGATED (no cpufreq, non-quiet window).
---
 scripts/perf/summarize_matrix.py | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/scripts/perf/summarize_matrix.py b/scripts/perf/summarize_matrix.py
index 22d4b22a3..e38bf81e6 100644
--- a/scripts/perf/summarize_matrix.py
+++ b/scripts/perf/summarize_matrix.py
@@ -183,12 +183,21 @@ def main() -> int:
             )
         lines.append("")
         lines.append(
-            "注：ours_int8 是单线程 kernel（无 OpenMP）；AOCL 列使用 OMP_NUM_THREADS={}。"
-            "AOCL 的'与 portable 逐位'为 False 的行即跨 KC 块 binary32 累加的实测落点，"
-            "不是 epilogue 的差异（epilogue 本身在 E5 中逐位一致）。".format(
+            "注 1：ours_int8 是单线程 kernel（无 OpenMP）；AOCL 列使用 OMP_NUM_THREADS={}。"
+            "本窗口 12 个形状的 AOCL 结果**全部**与 portable 逐位一致；但 parity 探针已证明"
+            "该一致性不是结构保证（跨 KC 块 binary32 累加，最坏码值分布下 K=2048 偏差 ≤1、"
+            "K=3584 ≤4、K=5099 ≤6，见 raw/w8a8-parity-probe.json），因此契约仍按有界类登记。".format(
                 data.get("env", {}).get("threads_requested", "?")
             )
         )
+        lines.append(
+            "注 2（污染/异常单元格）：`m=5 k=2048 n=1024` 的 AOCL int8 三列（≈3.34–3.42 ms）"
+            "在同一机器上以不同顺序重测只有 **0.014–0.018 ms**，即该单元格不可复现、被窗口噪声污染；"
+            "报告采用矩阵原值但在 §5 中标注该异常。其它单元格跨轮/跨次波动约 1.3–1.6x。"
+        )
+        lines.append(
+            "注 3（门禁）：本窗口 `load1` 3.8–4.7、`cpu_psi_avg10` 0–3.6、无 cpufreq → 一律 `UNGATED`。"
+        )
 
     text = "\n".join(lines) + "\n"
