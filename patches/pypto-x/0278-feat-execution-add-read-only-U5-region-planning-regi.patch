+def _region_digest_preimage(document) -> dict:
+    return {
+        "region_schema_version": document["region_schema_version"],
+        "boundary_signature": document["boundary_signature"],
+        "operations": [
+            {
+                "index": item["index"],
+                "function": item["function"],
+                "opcode": item["opcode"],
+                "single_op_plan_digest": item["single_op_plan_digest"],
+            }
+            for item in document["operations"]
+        ],
+    }
+
+
+def _expected_error(error_type, callable_):
+    with pytest.raises(error_type) as info:
+        callable_()
+    return info.value
