+def _validate_boundary_signature(boundary: Mapping[str, Any]) -> Mapping[str, Any]:
+    unknown = sorted(
+        str(key) for key in boundary if str(key) not in ("entry_inputs", "exit_outputs")
+    )
+    if unknown:
+        raise ArtifactMismatchError(
+            "boundary_signature has unknown fields: {}".format(", ".join(unknown)),
+            field="region_plan.boundary_signature",
+            requested=unknown,
+            reason="region_boundary_unknown_field",
+        )
+    entries = boundary.get("entry_inputs")
+    exits = boundary.get("exit_outputs")
+    if not isinstance(entries, list) or not isinstance(exits, list):
+        raise ArtifactMismatchError(
+            "boundary_signature entry_inputs/exit_outputs must be arrays",
+            field="region_plan.boundary_signature",
+            requested=type(entries).__name__,
+            reason="region_boundary_invalid",
+        )
+    seen = set()
+    for role, items in (("entry_input", entries), ("exit_output", exits)):
+        for index, item in enumerate(items):
+            if not isinstance(item, Mapping):
+                raise ArtifactMismatchError(
+                    "boundary entry must be a mapping",
+                    field="region_plan.boundary_signature.{}[{}]".format(role, index),
+                    requested=type(item).__name__,
+                    reason="region_boundary_invalid",
+                )
+            unknown = sorted(str(key) for key in item if str(key) not in _BOUNDARY_ENTRY_KEYS)
+            if unknown:
+                raise ArtifactMismatchError(
+                    "boundary entry has unknown fields: {}".format(", ".join(unknown)),
+                    field="region_plan.boundary_signature.{}[{}]".format(role, index),
+                    requested=unknown,
+                    reason="region_boundary_unknown_field",
+                )
+            for key in _BOUNDARY_ENTRY_KEYS:
+                if key not in item:
+                    raise ArtifactMismatchError(
+                        "boundary entry is missing field {!r}".format(key),
+                        field="region_plan.boundary_signature.{}[{}]".format(role, index),
+                        requested=sorted(item),
+                        available=list(_BOUNDARY_ENTRY_KEYS),
+                        reason="region_boundary_field_missing",
+                    )
+            if item["role"] != role:
+                raise ArtifactMismatchError(
+                    "boundary entry role mismatch",
+                    field="region_plan.boundary_signature.{}[{}].role".format(role, index),
+                    requested=item["role"],
+                    available=role,
+                    reason="region_boundary_role_mismatch",
+                )
+            _static_shape(item["shape"], "region_plan.boundary_signature.{}[{}].shape".format(role, index))
+            if not isinstance(item["function"], str) or not isinstance(item["name"], str):
+                raise ArtifactMismatchError(
+                    "boundary entry function/name must be strings",
+                    field="region_plan.boundary_signature.{}[{}]".format(role, index),
+                    requested={"function": item["function"], "name": item["name"]},
+                    reason="region_boundary_invalid",
+                )
+            if isinstance(item["dtype"], (Mapping, list, tuple)):
+                raise ArtifactMismatchError(
+                    "boundary entry dtype must be a scalar or null",
+                    field="region_plan.boundary_signature.{}[{}].dtype".format(role, index),
+                    requested=item["dtype"],
+                    reason="region_boundary_invalid",
+                )
+            if item["kind"] != "tensor":
+                raise ArtifactMismatchError(
+                    "this slice only plans tensor boundaries",
+                    field="region_plan.boundary_signature.{}[{}].kind".format(role, index),
+                    requested=item["kind"],
+                    available="tensor",
+                    reason="region_boundary_non_tensor",
+                )
+            identity = (item["function"], item["name"])
+            identity = (identity, role)
+            if identity in seen:
+                raise ArtifactMismatchError(
+                    "duplicate boundary tensor",
+                    field="region_plan.boundary_signature.{}[{}]".format(role, index),
+                    requested={"function": item["function"], "name": item["name"]},
+                    reason="region_boundary_duplicate",
+                )
+            seen.add(identity)
+            if role == "entry_input" and item["producer_op_index"] is not None:
+                raise ArtifactMismatchError(
+                    "an entry input must not be produced inside the region",
+                    field="region_plan.boundary_signature.entry_inputs[{}].producer_op_index".format(index),
+                    requested=item["producer_op_index"],
+                    reason="region_boundary_producer_mismatch",
+                )
+            if role == "exit_output":
+                source = str(item["source"])
+                if source == "operation_result":
+                    if not isinstance(item["producer_op_index"], int):
+                        raise ArtifactMismatchError(
+                            "an operation_result exit needs a producer op index",
+                            field="region_plan.boundary_signature.exit_outputs[{}].producer_op_index".format(index),
+                            requested=item["producer_op_index"],
+                            reason="region_boundary_producer_mismatch",
+                        )
+                elif source == "entry_pass_through":
+                    if item["producer_op_index"] is not None:
+                        raise ArtifactMismatchError(
+                            "an entry_pass_through exit must not carry a producer op index",
+                            field="region_plan.boundary_signature.exit_outputs[{}].producer_op_index".format(index),
+                            requested=item["producer_op_index"],
+                            reason="region_boundary_producer_mismatch",
+                        )
+                else:
+                    raise ArtifactMismatchError(
+                        "unknown exit output source {!r}".format(source),
+                        field="region_plan.boundary_signature.exit_outputs[{}].source".format(index),
+                        requested=source,
+                        available=["operation_result", "entry_pass_through"],
+                        reason="region_boundary_invalid",
+                    )
+    return _json_clone(boundary)
+
+
+def _validate_region_spec_consistency(
+    region_spec: Mapping[str, Any],
+    boundary: Mapping[str, Any],
+    operations: Sequence[Mapping[str, Any]],
+) -> None:
+    """Cross-check region_spec against the boundary and the operation list.
+
+    ``region_spec`` is not part of the digest preimage, so the validator binds
+    it semantically instead: a rewritten spec is refused rather than silently
+    changing the meaning of a frozen plan.
+    """
+
+    try:
+        spec = RegionSpec.from_value(region_spec)
+    except OpContractError as exc:
+        raise ArtifactMismatchError(
+            "region_spec is invalid: {}".format(exc),
+            field="region_plan.region_spec",
+            requested=region_spec,
+            reason="region_spec_invalid",
+        ) from exc
+    if _json_clone(spec.to_dict()) != _json_clone(region_spec):
+        raise ArtifactMismatchError(
+            "region_spec is not in canonical form",
+            field="region_plan.region_spec",
+            requested=region_spec,
+            available=spec.to_dict(),
+            reason="region_spec_not_canonical",
+        )
+    functions = sorted({str(item["function"]) for item in operations})
+    if spec.function is not None and functions != [spec.function]:
+        raise ArtifactMismatchError(
+            "region_spec.function does not match the operation list",
+            field="region_plan.region_spec.function",
+            requested=spec.function,
+            available=functions,
+            reason="region_spec_function_mismatch",
+        )
+    if spec.kind != "boundary":
+        # A whole-program boundary cannot declare a mid-graph value as an entry;
+        # ``declared_entry`` only exists for an explicit boundary spec.
+        declared_mid_graph = sorted(
+            str(item["name"])
+            for item in boundary["entry_inputs"]
+            if str(item["source"]) == "declared_entry"
+        )
+        if declared_mid_graph:
+            raise ArtifactMismatchError(
+                "a program region_spec cannot declare mid-graph entry inputs",
+                field="region_plan.region_spec",
+                requested=region_spec,
+                available={"declared_entry_inputs": declared_mid_graph},
+                reason="region_spec_boundary_mismatch",
+            )
+        return
+    function = spec.function
+    if function is None:
+        if len(functions) != 1:
+            raise ArtifactMismatchError(
+                "a boundary region_spec needs exactly one function",
+                field="region_plan.region_spec",
+                requested=region_spec,
+                available=functions,
+                reason="region_spec_function_mismatch",
+            )
+        function = functions[0]
+    entries = sorted(
+        (str(item["function"]), str(item["name"]))
+        for item in boundary["entry_inputs"]
+    )
+    exits = sorted(
+        (str(item["function"]), str(item["name"]))
+        for item in boundary["exit_outputs"]
+    )
+    expected_entries = sorted((function, name) for name in spec.entry_inputs)
+    expected_exits = sorted((function, name) for name in spec.exit_outputs)
+    if entries != expected_entries or exits != expected_exits:
+        raise ArtifactMismatchError(
+            "region_spec boundary names do not match the boundary signature",
+            field="region_plan.region_spec",
+            requested=region_spec,
+            available={
+                "entry_inputs": [item[1] for item in entries],
+                "exit_outputs": [item[1] for item in exits],
+            },
+            reason="region_spec_boundary_mismatch",
+        )
+
+
+def _validate_operations(
+    operations: Any,
+    boundary: Mapping[str, Any],
+    region_spec: Mapping[str, Any],
+) -> List[Mapping[str, Any]]:
+    if not isinstance(operations, list):
+        raise ArtifactMismatchError(
+            "region plan operations must be an array",
+            field="region_plan.operations",
+            requested=type(operations).__name__,
+            reason="region_operations_invalid",
+        )
+    checked: List[Mapping[str, Any]] = []
+    for position, item in enumerate(operations):
+        if not isinstance(item, Mapping):
+            raise ArtifactMismatchError(
+                "region operation entry must be a mapping",
+                field="region_plan.operations[{}]".format(position),
+                requested=type(item).__name__,
+                reason="region_operations_invalid",
+            )
+        unknown = sorted(str(key) for key in item if str(key) not in _OP_KEYS)
+        missing = [key for key in _OP_KEYS if key not in item]
+        if unknown:
+            raise ArtifactMismatchError(
+                "region operation has unknown fields: {}".format(", ".join(unknown)),
+                field="region_plan.operations[{}]".format(position),
+                requested=unknown,
+                available=list(_OP_KEYS),
+                reason="region_operation_unknown_field",
+            )
+        if missing:
+            raise ArtifactMismatchError(
+                "region operation is missing fields: {}".format(", ".join(missing)),
+                field="region_plan.operations[{}]".format(position),
+                requested=missing,
+                available=list(_OP_KEYS),
+                reason="region_operation_field_missing",
+            )
+        if int(item["index"]) != position:
+            raise ArtifactMismatchError(
+                "region operation index is not the topological position",
+                field="region_plan.operations[{}].index".format(position),
+                requested=item["index"],
+                available=position,
+                reason="region_operation_index_mismatch",
+            )
+        for key in (
+            "function",
+            "path",
+            "op_name",
+            "opcode",
+            "contract_digest",
+            "single_op_plan_digest",
+            "provider_id",
+            "provider_version",
+            "implementation",
+            "numeric_class",
+            "selected_numeric_class",
+        ):
+            if not isinstance(item[key], str) or not item[key]:
+                raise ArtifactMismatchError(
+                    "region operation {!r} must be a non-empty string".format(key),
+                    field="region_plan.operations[{}].{}".format(position, key),
+                    requested=item[key],
+                    reason="region_operation_field_type",
+                )
+        for key in ("contract_digest", "single_op_plan_digest"):
+            if not item[key].startswith("sha256:"):
+                raise ArtifactMismatchError(
+                    "region operation {!r} must be a sha256 digest".format(key),
+                    field="region_plan.operations[{}].{}".format(position, key),
+                    requested=item[key],
+                    reason="region_operation_digest_invalid",
+                )
+        if item["numeric_class"] not in (
+            "exact",
+            "portable_bitwise",
+            "deterministic_bounded",
+            "best_effort",
+        ):
+            raise ArtifactMismatchError(
+                "region operation numeric_class is outside the per-operation vocabulary",
+                field="region_plan.operations[{}].numeric_class".format(position),
+                requested=item["numeric_class"],
+                reason="region_numeric_class_unknown",
+            )
+        request = _validate_request(item["request"], position)
+        view = _precision_view(
+            item["provider_id"],
+            item["selected_numeric_class"],
+            item["precision"],
+            item["envelope"],
+        )
+        expected_view = {
+            "declared_class": str(view["declared_class"]),
+            "proven": bool(view["proven"]),
+            "bound": view["bound"],
+            "bound_kind": str(view["bound_kind"]),
+            "is_upper_bound": bool(view["is_upper_bound"]),
+            "reference": view["reference"],
+            "reasons": list(view["reasons"]),
+        }
+        if _json_clone(item["bound"]) != _json_clone(expected_view):
+            raise ArtifactMismatchError(
+                "region operation bound view does not match its precision/envelope declaration",
+                field="region_plan.operations[{}].bound".format(position),
+                requested=item["bound"],
+                available=expected_view,
+                reason="region_operation_bound_mismatch",
+            )
+        if item["numeric_class"] != view["declared_class"]:
+            raise ArtifactMismatchError(
+                "region operation numeric_class does not match its declaration",
+                field="region_plan.operations[{}].numeric_class".format(position),
+                requested=item["numeric_class"],
+                available=view["declared_class"],
+                reason="region_operation_numeric_class_mismatch",
+            )
+        fallback = item["fallback"]
+        if not isinstance(fallback, Mapping) or set(fallback) != {
+            "mode", "primary", "chain", "used", "degraded", "events"
+        }:
+            raise ArtifactMismatchError(
+                "region operation fallback block is invalid",
+                field="region_plan.operations[{}].fallback".format(position),
+                requested=fallback,
+                available=["mode", "primary", "chain", "used", "degraded", "events"],
+                reason="region_operation_fallback_invalid",
+            )
+        if not isinstance(fallback["events"], list) or any(
+            not isinstance(event, Mapping) for event in fallback["events"]
+        ):
+            raise ArtifactMismatchError(
+                "region operation fallback events must be an array of mappings",
+                field="region_plan.operations[{}].fallback.events".format(position),
+                requested=fallback["events"],
+                reason="region_operation_fallback_invalid",
+            )
+        checked.append(
+            {
+                "index": position,
+                "function": str(item["function"]),
+                "path": str(item["path"]),
+                "op_name": str(item["op_name"]),
+                "opcode": str(item["opcode"]),
+                "request": request,
+                "contract_digest": str(item["contract_digest"]),
+                "contract_version": str(item["contract_version"]),
+                "single_op_plan_digest": str(item["single_op_plan_digest"]),
+                "plan_schema_version": int(item["plan_schema_version"]),
+                "provider_id": str(item["provider_id"]),
+                "provider_version": str(item["provider_version"]),
+                "implementation": str(item["implementation"]),
+                "numeric_class": str(item["numeric_class"]),
+                "selected_numeric_class": str(item["selected_numeric_class"]),
+                "precision": _json_clone(item["precision"]) if item["precision"] is not None else None,
+                "envelope": _json_clone(item["envelope"]) if item["envelope"] is not None else None,
+                "fallback": _json_clone(fallback),
+                "bound": _json_clone(item["bound"]),
+            }
+        )
+    _validate_operation_def_use(checked, boundary, region_spec)
+    return checked
+
+
+def _validate_request(request: Any, position: int) -> Mapping[str, Any]:
+    if not isinstance(request, Mapping):
+        raise ArtifactMismatchError(
+            "region operation request must be a mapping",
+            field="region_plan.operations[{}].request".format(position),
+            requested=type(request).__name__,
+            reason="region_operation_request_invalid",
+        )
+    unknown = sorted(str(key) for key in request if str(key) not in _REQUEST_KEYS)
+    missing = [key for key in _REQUEST_KEYS if key not in request]
+    if unknown:
+        raise ArtifactMismatchError(
+            "region operation request has unknown fields: {}".format(", ".join(unknown)),
+            field="region_plan.operations[{}].request".format(position),
+            requested=unknown,
+            available=list(_REQUEST_KEYS),
+            reason="region_operation_request_unknown_field",
+        )
+    if missing:
+        raise ArtifactMismatchError(
+            "region operation request is missing fields: {}".format(", ".join(missing)),
+            field="region_plan.operations[{}].request".format(position),
+            requested=missing,
+            available=list(_REQUEST_KEYS),
+            reason="region_operation_request_field_missing",
+        )
+    if not isinstance(request["op"], str) or not request["op"]:
+        raise ArtifactMismatchError(
+            "region operation request.op must be a non-empty string",
+            field="region_plan.operations[{}].request.op".format(position),
+            requested=request["op"],
+            reason="region_operation_request_invalid",
+        )
+    if not isinstance(request["input_shapes"], list) or not isinstance(request["input_dtypes"], list):
+        raise ArtifactMismatchError(
+            "request input_shapes/input_dtypes must be arrays",
+            field="region_plan.operations[{}].request".format(position),
+            requested=request["input_shapes"],
+            reason="region_operation_request_invalid",
+        )
+    if len(request["input_shapes"]) != len(request["input_dtypes"]):
+        raise ArtifactMismatchError(
+            "request input_shapes/input_dtypes length mismatch",
+            field="region_plan.operations[{}].request".format(position),
+            requested=len(request["input_shapes"]),
+            available=len(request["input_dtypes"]),
+            reason="region_operation_request_invalid",
+        )
+    for index, shape in enumerate(request["input_shapes"]):
+        _static_shape(shape, "region_plan.operations[{}].request.input_shapes[{}]".format(position, index))
+    _static_shape(request["output_shape"], "region_plan.operations[{}].request.output_shape".format(position))
+    if not isinstance(request["input_dtypes"], list) or any(
+        not isinstance(item, str) for item in request["input_dtypes"]
+    ):
+        raise ArtifactMismatchError(
+            "request input_dtypes must be strings",
+            field="region_plan.operations[{}].request.input_dtypes".format(position),
+            requested=request["input_dtypes"],
+            reason="region_operation_request_invalid",
+        )
+    if not isinstance(request["output_dtype"], str) or not request["output_dtype"]:
+        raise ArtifactMismatchError(
+            "request output_dtype must be a non-empty string",
+            field="region_plan.operations[{}].request.output_dtype".format(position),
+            requested=request["output_dtype"],
+            reason="region_operation_request_invalid",
+        )
+    if not isinstance(request["attributes"], Mapping):
+        raise ArtifactMismatchError(
+            "request attributes must be a mapping",
+            field="region_plan.operations[{}].request.attributes".format(position),
+            requested=type(request["attributes"]).__name__,
+            reason="region_operation_request_invalid",
+        )
+    for key in ("inputs", "outputs"):
+        items = request[key]
+        if not isinstance(items, list) or not items:
+            raise ArtifactMismatchError(
+                "request {} must be a non-empty array".format(key),
+                field="region_plan.operations[{}].request.{}".format(position, key),
+                requested=items,
+                reason="region_operation_request_invalid",
+            )
+        for index, item in enumerate(items):
+            if not isinstance(item, Mapping):
+                raise ArtifactMismatchError(
+                    "request {} entry must be a mapping".format(key),
+                    field="region_plan.operations[{}].request.{}[{}]".format(position, key, index),
+                    requested=type(item).__name__,
+                    reason="region_operation_request_invalid",
+                )
+            allowed = ("name", "role", "shape", "dtype") if key == "inputs" else (
+                "name", "shape", "dtype"
+            )
+            unknown_operand = sorted(str(field) for field in item if str(field) not in allowed)
+            if unknown_operand:
+                raise ArtifactMismatchError(
+                    "request {} entry has unknown fields: {}".format(key, ", ".join(unknown_operand)),
+                    field="region_plan.operations[{}].request.{}[{}]".format(position, key, index),
+                    requested=unknown_operand,
+                    available=list(allowed),
+                    reason="region_operation_request_unknown_field",
+                )
+            if any(field not in item for field in allowed):
+                raise ArtifactMismatchError(
+                    "request {} entry is missing fields".format(key),
+                    field="region_plan.operations[{}].request.{}[{}]".format(position, key, index),
+                    requested=sorted(str(field) for field in item),
+                    available=list(allowed),
+                    reason="region_operation_request_field_missing",
+                )
+            if key == "inputs" and not isinstance(item["role"], str):
+                raise ArtifactMismatchError(
+                    "request operand role must be a string",
+                    field="region_plan.operations[{}].request.inputs[{}].role".format(position, index),
+                    requested=item["role"],
+                    reason="region_operation_request_invalid",
+                )
+            if not isinstance(item["name"], str) or not item["name"]:
+                raise ArtifactMismatchError(
+                    "request operand name must be a non-empty string",
+                    field="region_plan.operations[{}].request.{}[{}].name".format(position, key, index),
+                    requested=item["name"],
+                    reason="region_operation_request_invalid",
+                )
+            _static_shape(item["shape"], "region_plan.operations[{}].request.{}[{}].shape".format(position, key, index))
+            if not isinstance(item["dtype"], str) or not item["dtype"]:
+                raise ArtifactMismatchError(
+                    "request operand dtype must be a non-empty string",
+                    field="region_plan.operations[{}].request.{}[{}].dtype".format(position, key, index),
+                    requested=item["dtype"],
+                    reason="region_operation_request_invalid",
+                )
+    if [list(item["shape"]) for item in request["inputs"]] != [
+        list(item) for item in request["input_shapes"]
+    ]:
+        raise ArtifactMismatchError(
+            "request inputs shapes do not match input_shapes",
+            field="region_plan.operations[{}].request.inputs".format(position),
+            requested=[list(item["shape"]) for item in request["inputs"]],
+            available=request["input_shapes"],
+            reason="region_operation_request_inconsistent",
+        )
+    if [str(item["dtype"]) for item in request["inputs"]] != [
+        str(item) for item in request["input_dtypes"]
+    ]:
+        raise ArtifactMismatchError(
+            "request inputs dtypes do not match input_dtypes",
+            field="region_plan.operations[{}].request.inputs".format(position),
+            requested=[item["dtype"] for item in request["inputs"]],
+            available=request["input_dtypes"],
+            reason="region_operation_request_inconsistent",
+        )
+    if [list(item["shape"]) for item in request["outputs"]] != [list(request["output_shape"])]:
+        raise ArtifactMismatchError(
+            "request outputs shapes do not match output_shape",
+            field="region_plan.operations[{}].request.outputs".format(position),
+            requested=[list(item["shape"]) for item in request["outputs"]],
+            available=request["output_shape"],
+            reason="region_operation_request_inconsistent",
+        )
+    if [str(item["dtype"]) for item in request["outputs"]] != [str(request["output_dtype"])]:
+        raise ArtifactMismatchError(
+            "request outputs dtype does not match output_dtype",
+            field="region_plan.operations[{}].request.outputs".format(position),
+            requested=[item["dtype"] for item in request["outputs"]],
+            available=request["output_dtype"],
+            reason="region_operation_request_inconsistent",
+        )
+    return _json_clone(request)
+
+
+def _validate_operation_def_use(
+    operations: Sequence[Mapping[str, Any]],
+    boundary: Mapping[str, Any],
+    region_spec: Mapping[str, Any],
+) -> None:
+    """Check document-internal def-use closure without the source program."""
+
+    operator_outputs: Dict[Tuple[str, str], int] = {}
+    for item in operations:
+        for result in item["request"]["outputs"]:
+            key = (item["function"], str(result["name"]))
+            if key in operator_outputs:
+                raise ArtifactMismatchError(
+                    "duplicate operation result in the region document",
+                    field="region_plan.operations[{}].request.outputs".format(item["index"]),
+                    requested={"function": key[0], "name": key[1]},
+                    reason="region_ssa_redefinition",
+                )
+            operator_outputs[key] = int(item["index"])
+
+    entry_entries = {
+        (str(item["function"]), str(item["name"])): item
+        for item in boundary["entry_inputs"]
+    }
+    exit_entries = {
+        (str(item["function"]), str(item["name"])): item
+        for item in boundary["exit_outputs"]
+    }
+    used_entries = set()
+    for item in operations:
+        for operand in item["request"]["inputs"]:
+            key = (item["function"], str(operand["name"]))
+            producer = operator_outputs.get(key)
+            if producer is not None:
+                if producer >= int(item["index"]):
+                    raise ArtifactMismatchError(
+                        "operation reads a value defined later or by itself",
+                        field="region_plan.operations[{}].request.inputs".format(item["index"]),
+                        requested={"function": key[0], "name": key[1], "producer": producer},
+                        reason="region_cycle_detected",
+                    )
+                continue
+            if key not in entry_entries:
+                raise ArtifactMismatchError(
+                    "operation reads an implicit value outside the declared boundary",
+                    field="region_plan.operations[{}].request.inputs".format(item["index"]),
+                    requested={"function": key[0], "name": key[1]},
+                    available=sorted(entry_entries),
+                    reason="region_boundary_undeclared_input",
+                )
+            used_entries.add(key)
+            _check_boundary_types(
+                entry_entries[key],
+                operand["shape"],
+                operand["dtype"],
+                "region_plan.boundary_signature.entry_inputs",
+                "region_boundary_type_mismatch",
+            )
+    if str(region_spec.get("kind")) == "boundary":
+        unused = sorted(set(entry_entries) - used_entries)
+        if unused:
+            raise ArtifactMismatchError(
+                "declared entry input(s) are not consumed by the region: {}".format(
+                    ", ".join("{}:{}".format(item[0], item[1]) for item in unused)
+                ),
+                field="region_plan.boundary_signature.entry_inputs",
+                requested=unused,
+                reason="region_boundary_unused",
+            )
+    for item in operations:
+        for result in item["request"]["outputs"]:
+            key = (item["function"], str(result["name"]))
+            entry = exit_entries.get(key)
+            if entry is None:
+                continue
+            if str(entry["source"]) != "operation_result":
+                raise ArtifactMismatchError(
+                    "an op result is declared as an entry_pass_through exit",
+                    field="region_plan.boundary_signature.exit_outputs",
+                    requested={"function": key[0], "name": key[1]},
+                    reason="region_boundary_producer_mismatch",
+                )
+            if int(entry["producer_op_index"]) != int(item["index"]):
+                raise ArtifactMismatchError(
+                    "exit output producer index does not match the operation list",
+                    field="region_plan.boundary_signature.exit_outputs",
+                    requested=entry["producer_op_index"],
+                    available=item["index"],
+                    reason="region_boundary_producer_mismatch",
+                )
+            _check_boundary_types(
+                entry,
+                result["shape"],
+                result["dtype"],
+                "region_plan.boundary_signature.exit_outputs",
+                "region_boundary_type_mismatch",
+            )
+    for key, entry in exit_entries.items():
+        source = str(entry["source"])
+        if source == "operation_result":
+            if key not in operator_outputs:
+                raise ArtifactMismatchError(
+                    "exit output is not produced inside the region document",
+                    field="region_plan.boundary_signature.exit_outputs",
+                    requested={"function": key[0], "name": key[1]},
+                    reason="region_boundary_producer_mismatch",
+                )
+            if int(entry["producer_op_index"]) != operator_outputs[key]:
+                raise ArtifactMismatchError(
+                    "exit output producer index does not match the operation list",
+                    field="region_plan.boundary_signature.exit_outputs",
+                    requested=entry["producer_op_index"],
+                    available=operator_outputs[key],
+                    reason="region_boundary_producer_mismatch",
+                )
+        elif source == "entry_pass_through":
+            if key not in entry_entries:
+                raise ArtifactMismatchError(
+                    "entry_pass_through exit is not an entry input",
+                    field="region_plan.boundary_signature.exit_outputs",
+                    requested={"function": key[0], "name": key[1]},
+                    reason="region_boundary_producer_mismatch",
+                )
+            if key in operator_outputs:
+                raise ArtifactMismatchError(
+                    "entry_pass_through exit is also produced inside the region",
+                    field="region_plan.boundary_signature.exit_outputs",
+                    requested={"function": key[0], "name": key[1]},
+                    reason="region_boundary_producer_mismatch",
+                )
+            _check_boundary_types(
+                exit_entries[key],
+                entry_entries[key]["shape"],
+                entry_entries[key]["dtype"],
+                "region_plan.boundary_signature.exit_outputs",
+                "region_boundary_type_mismatch",
+            )
+
+
+def _check_boundary_types(
+    entry: Mapping[str, Any],
+    shape: Any,
+    dtype: Any,
+    field: str,
+    reason: str,
+) -> None:
+    if list(entry["shape"]) != [int(item) for item in shape] or str(entry["dtype"]) != str(dtype):
+        raise ArtifactMismatchError(
+            "boundary entry does not match the operation operand/result type",
+            field=field,
+            requested={"shape": entry["shape"], "dtype": entry["dtype"]},
+            available={"shape": list(shape), "dtype": dtype},
+            reason=reason,
+        )
+
+
+def _re_resolve_document(
+    data: Mapping[str, Any],
+    policy: ExecutionPolicy,
+    capability: CapabilitySnapshot,
+    operations: Sequence[Mapping[str, Any]],
+) -> None:
+    if capability.digest != data["capability_digest"]:
+        raise ArtifactMismatchError(
+            "replay capability snapshot does not match the frozen region plan",
+            field="region_plan.capability_digest",
+            requested=data["capability_digest"],
+            available=capability.digest,
+            reason="region_capability_digest_mismatch",
+        )
+    for item in operations:
+        request = item["request"]
+        try:
+            resolution = plan_operation(
+                request["op"],
+                request["input_shapes"],
+                request["input_dtypes"],
+                output_shape=request["output_shape"],
+                output_dtype=request["output_dtype"],
+                attributes=request["attributes"],
+                policy=policy,
+                capability=capability,
+            )
+        except ExecutionError as exc:
+            raise ArtifactMismatchError(
+                "region operation replay failed: {}".format(exc),
+                field="region_plan.operations[{}]".format(item["index"]),
+                requested={"opcode": request["op"], "reason": exc.reason},
+                available=item["single_op_plan_digest"],
+                reason="region_operation_replay_failed",
+            ) from exc
+        plan = resolution.plan
+        if plan.digest != item["single_op_plan_digest"]:
+            raise ArtifactMismatchError(
+                "region operation plan digest does not match plan_operation replay",
+                field="region_plan.operations[{}].single_op_plan_digest".format(item["index"]),
+                requested=item["single_op_plan_digest"],
+                available=plan.digest,
+                reason="region_op_plan_digest_mismatch",
+            )
+        if plan.payload["contract"]["digest"] != item["contract_digest"]:
+            raise ArtifactMismatchError(
+                "region operation contract digest does not match replay",
+                field="region_plan.operations[{}].contract_digest".format(item["index"]),
+                requested=item["contract_digest"],
+                available=plan.payload["contract"]["digest"],
+                reason="region_contract_digest_mismatch",
+            )
+        if str(plan.selected_provider) != item["provider_id"]:
+            raise ArtifactMismatchError(
+                "region operation provider does not match replay",
+                field="region_plan.operations[{}].provider_id".format(item["index"]),
+                requested=item["provider_id"],
+                available=plan.selected_provider,
+                reason="region_provider_mismatch",
+            )
+
+
+# ---------------------------------------------------------------------------
+# load / explain
+# ---------------------------------------------------------------------------
+def load_region_plan(
+    path: Any,
+    *,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None,
+    re_resolve: bool = True,
+) -> RegionPlan:
+    """Load and strictly validate a region plan JSON document."""
+
+    try:
+        with open(os.fspath(path), "r", encoding="utf-8") as stream:
+            document = json.load(stream)
+    except OSError as exc:
+        raise ArtifactMismatchError(
+            "could not read region plan document {!r}: {}".format(path, exc),
+            field="region_plan",
+            requested=os.fspath(path),
+            reason="region_plan_file_unreadable",
+        ) from exc
+    except ValueError as exc:
+        raise ArtifactMismatchError(
+            "region plan document {!r} is not valid JSON: {}".format(path, exc),
+            field="region_plan",
+            requested=os.fspath(path),
+            reason="region_plan_file_invalid_json",
+        ) from exc
+    checked = validate_region_plan(
+        document, policy=policy, capability=capability, re_resolve=bool(re_resolve)
+    )
+    active_policy = policy if policy is not None else policy_from_dict(checked["policy"])
+    return RegionPlan(
+        document=checked,
+        policy=active_policy,
+        capability=capability,
+        resolutions=(),
+    )
+
+
+@dataclass(frozen=True)
+class RegionExplanation:
+    """Machine-readable region explanation plus a human summary."""
+
+    document: Mapping[str, Any]
+    summary: str
+
+    @property
+    def digest(self) -> str:
+        return str(self.document["digest"])
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return _json_clone(self.document)
+
+    def to_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+
+def explain_region(
+    program: CoreProgram,
+    region_spec: Any = None,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None,
+) -> RegionExplanation:
+    """Plan a region and explain it by reusing the U3 explain documents."""
+
+    region_plan = plan_region(program, region_spec, policy, capability)
+    return _explain_plan_object(region_plan)
+
+
+def explain_region_plan(
+    region_plan: Any,
+    *,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None,
+) -> RegionExplanation:
+    """Explain a frozen region plan (document or :class:`RegionPlan`)."""
+
+    if isinstance(region_plan, RegionPlan):
+        if region_plan.resolutions:
+            return _explain_plan_object(region_plan)
+        document = region_plan.document
+        active_policy = policy if policy is not None else region_plan.policy
+        active_capability = (
+            capability if capability is not None else region_plan.capability
+        )
+        checked = validate_region_plan(
+            document,
+            policy=active_policy,
+            capability=active_capability,
+            re_resolve=False,
+        )
+    else:
+        document = region_plan
+        active_policy = policy
+        active_capability = capability
+        checked = validate_region_plan(
+            document,
+            policy=policy,
+            capability=capability,
+            re_resolve=False,
+        )
+        if active_policy is None:
+            active_policy = policy_from_dict(checked["policy"])
+        if active_capability is None:
+            active_capability = _coerce_capability(None)
+    if active_capability is None:
+        active_capability = _coerce_capability(None)
+    operations = _validate_operations(
+        checked["operations"], checked["boundary_signature"], checked["region_spec"]
+    )
+    resolutions = _replay_resolutions(checked, active_policy, active_capability, operations)
+    return _explain_document(checked, operations, resolutions)
+
+
+def _replay_resolutions(
+    document: Mapping[str, Any],
+    policy: ExecutionPolicy,
+    capability: CapabilitySnapshot,
+    operations: Sequence[Mapping[str, Any]],
+) -> Tuple[ResolutionResult, ...]:
+    if capability.digest != document["capability_digest"]:
+        raise ArtifactMismatchError(
+            "replay capability snapshot does not match the frozen region plan",
+            field="region_plan.capability_digest",
+            requested=document["capability_digest"],
+            available=capability.digest,
+            reason="region_capability_digest_mismatch",
+        )
+    result = []
+    for item in operations:
+        request = item["request"]
+        resolution = plan_operation(
+            request["op"],
+            request["input_shapes"],
+            request["input_dtypes"],
+            output_shape=request["output_shape"],
+            output_dtype=request["output_dtype"],
+            attributes=request["attributes"],
+            policy=policy,
+            capability=capability,
+        )
+        if resolution.plan.digest != item["single_op_plan_digest"]:
+            raise ArtifactMismatchError(
+                "region operation plan digest does not match plan_operation replay",
+                field="region_plan.operations[{}].single_op_plan_digest".format(item["index"]),
+                requested=item["single_op_plan_digest"],
+                available=resolution.plan.digest,
+                reason="region_op_plan_digest_mismatch",
+            )
+        result.append(resolution)
+    return tuple(result)
+
+
+def _explain_plan_object(region_plan: RegionPlan) -> RegionExplanation:
+    document = region_plan.document
+    operations = _validate_operations(
+        document["operations"], document["boundary_signature"], document["region_spec"]
+    )
+    return _explain_document(document, operations, region_plan.resolutions)
+
+
+def _explain_document(
+    document: Mapping[str, Any],
+    operations: Sequence[Mapping[str, Any]],
+    resolutions: Sequence[ResolutionResult],
+) -> RegionExplanation:
+    from .discovery import EXPLAIN_BOUNDARIES, explain as _u3_explain
+
+    precision = document["region_precision"]
+    per_operation = []
+    for item, resolution in zip(operations, resolutions):
+        if resolution is None:
+            continue
+        # Public U3 entry: the single-operation explain document is embedded
+        # verbatim; region-specific fields are added next to it.
+        single = _u3_explain(plan=resolution.plan).to_dict()
+        single["region_op_index"] = item["index"]
+        single["region_opcode"] = item["opcode"]
+        single["bound_view"] = _json_clone(item["bound"])
+        single["region_fallback"] = _json_clone(item["fallback"])
+        per_operation.append(single)
+    plan_why = (
+        "region composed as {cls} ({rule}); providers={providers}; "
+        "bound_is_upper_bound={upper}".format(
+            cls=precision["class"],
+            rule=precision["selected_rule"],
+            providers=",".join(precision["provider_ids"]),
+            upper=precision["deviation_bound"]["is_upper_bound"],
+        )
+    )
+    explanation = {
+        "schema_version": REGION_SCHEMA_VERSION,
+        "kind": REGION_EXPLAIN_KIND,
+        "region_plan_digest": document["region_digest"],
+        "region_id": document["region_id"],
+        "region_spec": _json_clone(document["region_spec"]),
+        "boundary_signature": _json_clone(document["boundary_signature"]),
+        "region_precision": _json_clone(precision),
+        "composition": {
+            "rule_id": precision["rule_id"],
+            "rule": precision["rule"],
+            "derivation": _json_clone(precision["derivation"]),
+            "bound_contributors": [
+                {
+                    "index": term["index"],
+                    "opcode": term["opcode"],
+                    "provider_id": term["provider_id"],
+                    "bound_kind": term["bound_kind"],
+                    "bound": term["bound"],
+                    "is_upper_bound": term["is_upper_bound"],
+                    "reference": term["reference"],
+                }
+                for term in precision["terms"]
+                if term["declared_class"] in ("exact", "portable_bitwise", "deterministic_bounded")
+            ],
+            "unproven_ops": _json_clone(precision["unproven_ops"]),
+            "best_effort_ops": list(precision["best_effort_ops"]),
+            "provider_set": list(precision["provider_ids"]),
+            "deviation_bound": _json_clone(precision["deviation_bound"]),
+            "fail_closed": bool(precision["fail_closed"]),
+            "fail_closed_reasons": list(precision["fail_closed_reasons"]),
+        },
+        "operations": per_operation,
+        "why": plan_why,
+        "boundaries": [dict(item) for item in EXPLAIN_BOUNDARIES],
+    }
+    explanation["digest"] = "sha256:" + sha256_text(explanation)
+    lines = [
+        "explain region {id} ({count} ops)".format(
+            id=document["region_id"], count=len(operations)
+        ),
+        "region digest: {}".format(document["region_digest"]),
+        "class: {cls} rule={rule} providers={providers}".format(
+            cls=precision["class"],
+            rule=precision["selected_rule"],
+            providers=",".join(precision["provider_ids"]),
+        ),
+        "deviation bound: kind={kind} sum={sum} is_upper_bound={upper}".format(
+            kind=precision["deviation_bound"]["kind"],
+            sum=precision["deviation_bound"]["sum"],
+            upper=precision["deviation_bound"]["is_upper_bound"],
+        ),
+        "unproven ops: {}".format(
+            ", ".join(
+                "{}#{}".format(item["opcode"], item["index"])
+                for item in precision["unproven_ops"]
+            )
+            or "none"
+        ),
+        "per-op explanations: {} (see document.operations)".format(len(per_operation)),
+        "boundaries: {} fields are only decided at execution time".format(
+            len(EXPLAIN_BOUNDARIES)
+        ),
+    ]
+    return RegionExplanation(document=explanation, summary="\n".join(lines))
+
+
+__all__ = [
+    "REGION_CLASS_STRENGTH",
+    "REGION_EXPLAIN_KIND",
+    "REGION_KIND",
+    "REGION_NUMERIC_CLASSES",
+    "REGION_SCHEMA_VERSION",
+    "RegionExplanation",
+    "RegionPlan",
+    "RegionPrecisionTerm",
+    "RegionSpec",
+    "compose_region_precision",
+    "explain_region",
+    "explain_region_plan",
+    "load_region_plan",
+    "plan_region",
+    "validate_region_plan",
+]
