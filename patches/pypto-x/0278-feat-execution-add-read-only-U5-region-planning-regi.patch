+def test_region_marks_a_host_fallback_with_mode_and_events():
+    snapshot = _probe()
+    if not _available(snapshot, AOCL_LPGEMM_F32_PROVIDER_ID):
+        pytest.skip("the AOCL f32 vendor artifact is not available here")
+
+    program = _matmul_program()
+    base = _probe()
+    forced_unavailable = CapabilitySnapshot(
+        kind="cpu",
+        triple=base.triple,
+        features=base.features,
+        providers=tuple(
+            dataclasses.replace(
+                entry,
+                available=False,
+                reason="synthetic_test_unavailable",
+            )
+            if entry.provider_id == AOCL_LPGEMM_F32_PROVIDER_ID
+            else entry
+            for entry in base.providers
+        ),
+    )
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        provider=ProviderPolicy(
+            mode="required", required=AOCL_LPGEMM_F32_PROVIDER_ID
+        ),
+        numeric=NumericPolicy(requirement="deterministic"),
+        fallback=FallbackPolicy(mode="declared", chain=("portable",)),
+    )
+    plan = plan_region(program, policy=policy, capability=forced_unavailable)
+    operation = plan.operations[0]
+    assert operation["provider_id"] == "portable"
+    assert operation["fallback"]["used"] is True
+    assert operation["fallback"]["degraded"] is True
+    assert operation["fallback"]["mode"] == "declared"
+    assert operation["fallback"]["events"][0]["from"] == AOCL_LPGEMM_F32_PROVIDER_ID
+    assert operation["fallback"]["events"][0]["to"] == "portable"
+    precision = plan.region_precision
+    assert precision["fallback_modes"] == ["declared"]
+    assert precision["fallback_ops"] == [
+        {
+            "index": 0,
+            "opcode": "matmul",
+            "provider_id": "portable",
+            "mode": "declared",
+            "used": True,
+            "degraded": True,
+        }
+    ]
+    assert validate_region_plan(
+        plan.to_dict(), capability=forced_unavailable, re_resolve=True
+    ) == plan.to_dict()
