+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+def _ref(name: str, dtype: str, shape) -> ValueRef:
+    return ValueRef(name, CoreType.tensor(dtype, tuple(shape)))
+
+
+def _scalar(name: str, dtype: str) -> ValueRef:
+    return ValueRef(name, CoreType.scalar(dtype))
+
+
+def _op(name, inputs, outputs, attributes=None) -> Operation:
+    return Operation(
+        name,
+        inputs=tuple(inputs),
+        outputs=tuple(outputs),
+        attributes=dict(attributes or {}),
+    )
+
+
+def _program(parameters, operations, returns, name="f") -> CoreProgram:
+    return CoreProgram(
+        (
+            CoreFunction(
+                name,
+                parameters=tuple(parameters),
+                returns=tuple(returns),
+                body=Region(operations=tuple(operations)),
+            ),
+        )
+    )
+
+
+def _matmul_program():
+    a = _ref("a", "float32", (2, 3))
+    b = _ref("b", "float32", (3, 4))
+    c = _ref("c", "float32", (2, 4))
+    return _program((a, b), (_op("matmul", (a, b), (c,)),), (c,))
+
+
+def _exp_reshape_program():
+    x = _ref("x", "float32", (2, 3))
+    e = _ref("e", "float32", (2, 3))
+    y = _ref("y", "float32", (6,))
+    return _program(
+        (x,),
+        (
+            _op("exp", (x,), (e,)),
+            _op("reshape", (e,), (y,), {"shape": [6]}),
+        ),
+        (y,),
+    )
+
+
+def _probe() -> CapabilitySnapshot:
+    return CapabilitySnapshot.probe_host()
+
+
+def _assert_baseline_host() -> CapabilitySnapshot:
+    snapshot = _probe()
+    if snapshot.digest != BASELINE_CAPABILITY_DIGEST:
+        pytest.skip(
+            "the frozen single-op baseline was recorded on a different host probe"
+        )
+    return snapshot
+
+
+def _available(snapshot: CapabilitySnapshot, provider_id: str) -> bool:
+    entry = snapshot.provider(provider_id)
+    return bool(entry is not None and entry.available)
