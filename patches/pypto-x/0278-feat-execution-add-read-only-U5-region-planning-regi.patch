+def test_composition_precedence_and_preimage_recomputation():
+    proven = RegionPrecisionTerm(
+        index=0,
+        opcode="matmul",
+        provider_id="vendor:test",
+        declared_class="deterministic_bounded",
+        provider_class="deterministic_bounded",
+        proven=True,
+        bound=2,
+        bound_kind="analytic_f32_chain_upper_bound",
+        is_upper_bound=True,
+        reference="common_reference",
+    )
+    unproven = RegionPrecisionTerm(
+        index=1,
+        opcode="exp",
+        provider_id="portable",
+        declared_class="deterministic_bounded",
+        provider_class="portable_bitwise",
+        proven=False,
+        bound_kind="deterministic_serial_order_no_registered_analytic_bound",
+        reasons=("deterministic_serial_order_no_registered_analytic_bound",),
+    )
+    identity = RegionPrecisionTerm(
+        index=2,
+        opcode="matmul",
+        provider_id="portable",
+        declared_class="portable_bitwise",
+        provider_class="portable_bitwise",
+        proven=True,
+        bound=0,
+        bound_kind="portable_trunk_bitwise_identity",
+        is_upper_bound=True,
+        reference="portable_trunk",
+    )
+    mixed = compose_region_precision([proven, unproven, identity])
+    assert mixed["class"] == "deterministic_bounded_unproven"
+    assert mixed["deviation_bound"]["is_upper_bound"] is False
+    assert mixed["provider_ids"] == ["portable", "vendor:test"]
+    assert mixed["mixed_providers"] is True
+
+    proven_only = compose_region_precision([proven, identity])
+    assert proven_only["class"] == "deterministic_bounded"
+    assert proven_only["deviation_bound"]["sum"] == 2
+    assert proven_only["deviation_bound"]["is_upper_bound"] is True
+
+    cross_reference = compose_region_precision(
+        [
+            proven,
+            dataclasses.replace(
+                proven,
+                index=3,
+                provider_id="vendor:other",
+                reference="other_reference",
+            ),
+        ]
+    )
+    assert cross_reference["class"] == "deterministic_bounded"
+    assert cross_reference["deviation_bound"]["sum"] == 4
+    assert cross_reference["deviation_bound"]["is_upper_bound"] is False
+    assert "cross_reference_bounds_not_comparable" in cross_reference["deviation_bound"]["reasons"]
