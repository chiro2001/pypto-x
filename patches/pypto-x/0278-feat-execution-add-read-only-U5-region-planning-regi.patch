+    assert precision["deviation_bound"]["is_upper_bound"] is False
+    assert precision["require_proven_deviation_bound_satisfied"] is False
+    # a default policy may still plan the region (the provider class is the
+    # portable trunk); the unproven contract precision is declared honestly.
+    assert precision["numeric_requirement_satisfied"] is True
+    assert precision["fail_closed"] is False
