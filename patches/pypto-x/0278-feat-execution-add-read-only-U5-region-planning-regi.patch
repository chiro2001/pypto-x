+def test_whole_program_and_boundary_specs_select_the_expected_operations():
+    program = _exp_reshape_program()
+    whole = plan_region(program)
+    assert [item["opcode"] for item in whole.operations] == ["exp", "reshape"]
+    assert [item["name"] for item in whole.to_dict()["boundary_signature"]["entry_inputs"]] == ["x"]
+    assert [item["name"] for item in whole.to_dict()["boundary_signature"]["exit_outputs"]] == ["y"]
+
+    boundary = plan_region(program, RegionSpec.boundary(["e"], ["y"]))
+    assert [item["opcode"] for item in boundary.operations] == ["reshape"]
+    assert boundary.digest != whole.digest
+    assert boundary.to_dict()["region_spec"] == {
+        "kind": "boundary",
+        "function": None,
+        "entry_inputs": ["e"],
+        "exit_outputs": ["y"],
+    }
+
+    middle = plan_region(program, RegionSpec.boundary(["x"], ["e"]))
+    assert [item["opcode"] for item in middle.operations] == ["exp"]
+
+
+def test_region_spec_rejects_operation_index_ranges_and_unknown_fields():
+    error = _expected_error(
+        OpContractError,
+        lambda: RegionSpec.from_value({"kind": "program", "op_indices": [0, 3]}),
+    )
+    assert error.reason == "region_spec_unknown_field"
+    invalid = _expected_error(
+        OpContractError, lambda: RegionSpec.from_value({"kind": "range"})
+    )
+    assert invalid.reason == "region_spec_kind_invalid"
