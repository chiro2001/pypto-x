+"""U5 read-only region planning tests (batch 0049 slice A).
+
+Covers:
+
+* region spec resolution: whole-:class:`CoreProgram` and explicit
+  entry/exit boundary subgraphs, plus the structured boundary rejections;
+* the frozen ``REGION_SCHEMA_VERSION=1`` document, its Merkle-style
+  ``region_digest`` recomputation and the strict ``validate_region_plan`` /
+  ``load_region_plan`` replay anchor against ``plan_operation``;
+* the 0020 section 2 precision composition matrix (exact / portable_bitwise /
+  bounded-all-proven / bounded-with-unproven / mixed providers + best_effort),
+  including region-level fail-closed behaviour of
+  ``numeric.require_proven_deviation_bound``;
+* zero regression of the single-operation path (frozen digest pins) and the
+  CLI ``plan --region`` / ``explain --region`` entry points.
+
+The module-level import of :mod:`pypto.execution.region` is intentional: this
+file must fail on the parent commit (4521558e6), where the region entry point
+does not exist yet, rather than silently pass.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from pypto.core_ir import CoreProgram, CoreFunction, CoreType, Operation, Region, ValueRef
+from pypto.execution import (
+    AOCL_LPGEMM_F32_PROVIDER_ID,
+    AOCL_LPGEMM_INT8_EXACT_BLOCKED_PROVIDER_ID,
+    AOCL_LPGEMM_INT8_PROVIDER_ID,
+    ArtifactMismatchError,
+    CapabilitySnapshot,
+    ExecutionError,
+    ExecutionPolicy,
+    FallbackPolicy,
+    NumericGuaranteeUnmetError,
+    NumericPolicy,
+    OpContractError,
+    ProviderCapability,
+    ProviderPolicy,
+    RegionPlan,
+    RegionPrecisionTerm,
+    RegionSpec,
+    compose_region_precision,
+    explain_region,
+    explain_region_plan,
+    get_op_definition,
+    load_region_plan,
+    plan_matmul,
+    plan_operation,
+    plan_qmatmul,
+    plan_region,
+    validate_region_plan,
+    with_exact_blocked_provider,
+)
+from pypto.target._utils import canonical_json, sha256_text
+
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[4]
