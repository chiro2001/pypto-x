+def test_tampered_region_plan_is_refused():
+    plan = plan_region(_exp_reshape_program())
+    document = plan.to_dict()
+    capability = plan.capability
+
+    def flip_op_digest(data):
+        original = data["operations"][0]["single_op_plan_digest"]
+        data["operations"][0]["single_op_plan_digest"] = (
+            "sha256:" + ("0" if original[-1] != "0" else "1") * 64
+        )
+
+    def change_boundary_source(data):
+        data["boundary_signature"]["entry_inputs"][0]["source"] = "external_value"
+
+    def drop_operation(data):
+        del data["operations"][1]
+        data["op_count"] = 1
+
+    def rewrite_bound_view(data):
+        data["operations"][0]["bound"]["bound"] = 0
+        data["operations"][0]["bound"]["proven"] = True
+
+    def rewrite_region_class(data):
+        data["region_precision"]["class"] = "exact"
+
+    def rewrite_region_id(data):
+        data["region_id"] = "region.0000000000000000"
+
+    def rewrite_policy_digest(data):
+        data["policy_digest"] = "sha256:" + "0" * 64
+
+    def rewrite_capability_digest(data):
+        data["capability_digest"] = "sha256:" + "0" * 64
+
+    def add_unknown_field(data):
+        data["extra"] = True
+
+    cases = (
+        (flip_op_digest, "region_digest_mismatch"),
+        (change_boundary_source, "region_digest_mismatch"),
+        (drop_operation, "region_digest_mismatch"),
+        (rewrite_bound_view, "region_operation_bound_mismatch"),
+        (rewrite_region_class, "region_precision_mismatch"),
+        (rewrite_region_id, "region_id_mismatch"),
+        (rewrite_policy_digest, "region_policy_digest_mismatch"),
+        (rewrite_capability_digest, "region_capability_digest_mismatch"),
+        (add_unknown_field, "region_plan_unknown_field"),
+    )
+    for mutate, reason in cases:
+        forged = json.loads(json.dumps(document))
+        mutate(forged)
+        error = _expected_error(
+            ArtifactMismatchError,
+            lambda forged=forged: validate_region_plan(
+                forged, capability=capability, re_resolve=True
+            ),
+        )
+        assert error.reason == reason, (mutate.__name__, error.reason)
+
