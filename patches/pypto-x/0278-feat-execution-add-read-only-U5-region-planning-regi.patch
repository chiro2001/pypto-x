+def test_cli_region_plan_and_explain(tmp_path):
+    program = _exp_reshape_program()
+    program_path = tmp_path / "program.json"
+    program_path.write_text(program.canonical_json(), encoding="utf-8")
+
+    planned = _run_cli(
+        "plan", "--region", "program", "--program", str(program_path), "--json"
+    )
+    assert planned.returncode == 0, planned.stderr
+    document = json.loads(planned.stdout)
+    assert document["kind"] == "region_plan"
+    assert document["region_digest"] == plan_region(program).digest
+
+    explained = _run_cli(
+        "explain", "--region", "program", "--program", str(program_path), "--json"
+    )
+    assert explained.returncode == 0, explained.stderr
+    assert json.loads(explained.stdout)["kind"] == "region_explain"
+
+    region_path = tmp_path / "region.json"
+    region_path.write_text(canonical_json(document) + "\n", encoding="utf-8")
+    replayed = _run_cli("explain", "--region-plan", str(region_path), "--json")
+    assert replayed.returncode == 0, replayed.stderr
+    assert (
+        json.loads(replayed.stdout)["region_plan_digest"] == document["region_digest"]
+    )
+
+    boundary = _run_cli(
+        "plan",
+        "--region",
+        "boundary",
+        "--program",
+        str(program_path),
+        "--region-entry",
+        "e",
+        "--region-exit",
+        "y",
+        "--json",
+    )
+    assert boundary.returncode == 0, boundary.stderr
+    boundary_document = json.loads(boundary.stdout)
+    assert [item["opcode"] for item in boundary_document["operations"]] == ["reshape"]
+
+    dangling = _run_cli(
+        "plan",
+        "--region",
+        "boundary",
+        "--program",
+        str(program_path),
+        "--region-entry",
+        "missing",
+        "--region-exit",
+        "y",
+        "--json",
+    )
+    assert dangling.returncode == 1
+    error = json.loads(dangling.stdout)
+    assert error["code"] == "OP_CONTRACT_INVALID"
+    assert error["reason"] == "region_boundary_dangling_tensor"
+
