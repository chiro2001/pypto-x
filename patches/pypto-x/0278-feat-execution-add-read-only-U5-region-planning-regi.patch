+"""U5 read-only region planning (batch 0049 slice A).
+
+This module promotes a *statically connected subgraph* of a
+:class:`pypto.core_ir.CoreProgram` to a first-class, frozen planning artifact.
+It is deliberately read-only:
+
+* it never executes a provider and never calls a runtime;
+* it never re-implements provider selection or the numeric contract: every
+  region operation is planned by :func:`pypto.execution.entry.plan_operation`,
+  the same entry the single-operation path uses;
+* it never relaxes fail-closed semantics: an unregistered opcode, an
+  unrepresentable request (for example a scalar operand, which the batch-1
+  contracts do not cover), or a policy that cannot be met is refused with a
+  structured :class:`pypto.execution.errors.ExecutionError`.
+
+The frozen artifact is the *region plan* document (``REGION_SCHEMA_VERSION``).
+Its ``region_digest`` is a Merkle-style anchor over the ordered list of
+single-operation plan digests, the boundary signature and the schema version,
+so the digest can be recomputed from the document alone.  The region-level
+precision declaration follows the conservative composition rules of
+``docs/20-planning/0020-...`` section 2 and is recomputed by
+:func:`validate_region_plan`; a rewritten document is refused, not repaired.
+
+See ``docs/20-planning/0021-2026-09-13-u5-region-readonly.zh-CN.md`` for the
+frozen contract text (Chinese) and the explicit boundaries of this slice.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from dataclasses import dataclass
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.core_ir import CoreProgram, Operation, Region, ValueRef
+from pypto.target._utils import canonical_json, mapping_copy, sha256_text
+
+from .capability import CapabilitySnapshot
+from .entry import plan_operation
+from .errors import (
+    ArtifactMismatchError,
+    CapabilityUnavailableError,
+    ExecutionError,
+    NumericGuaranteeUnmetError,
+    OpContractError,
+    PolicyInvalidValueError,
+)
+from .manifest import PROVEN_DEVIATION_BOUND_KINDS
+from .op_registry import get_op_definition, lookup_canonical_opcode, registered_opcodes
+from .policy import ExecutionPolicy, policy_from_dict
+from .providers import PORTABLE_PROVIDER_ID
+from .resolver import ResolutionResult, RESOLVER_VERSION
+
+
+REGION_SCHEMA_VERSION = 1
+REGION_KIND = "region_plan"
+REGION_EXPLAIN_KIND = "region_explain"
+
+#: Region numeric classes.  ``deterministic_bounded_unproven`` is a region-only
+#: class: it records "at least one operation claims deterministic bounded
+#: execution but publishes no proven envelope".  It is never stronger than
+#: ``deterministic_bounded`` and never usable under
+#: ``require_proven_deviation_bound``.
+REGION_NUMERIC_CLASSES = (
+    "exact",
+    "portable_bitwise",
+    "deterministic_bounded",
+    "deterministic_bounded_unproven",
+    "best_effort",
+)
+
+#: Strength order, strongest first (mirrors ``resolver.NUMERIC_CLASS_ORDER``).
+REGION_CLASS_STRENGTH = {
+    "exact": 0,
+    "portable_bitwise": 1,
+    "deterministic_bounded": 2,
+    "deterministic_bounded_unproven": 2,
+    "best_effort": 3,
+}
+
+_REQUIREMENT_MIN_STRENGTH = {
+    "portable": 1,
+    "deterministic": 2,
+    "bounded": 2,
+}
+
+_TOP_LEVEL_KEYS = (
+    "region_schema_version",
+    "kind",
+    "region_id",
+    "region_digest",
+    "region_spec",
+    "policy",
