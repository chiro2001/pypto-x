+def test_region_plan_is_deterministic_and_digest_recomputes_from_preimage():
+    program = _matmul_program()
+    first = plan_region(program)
+    second = plan_region(program)
+    assert first.to_dict() == second.to_dict()
+    assert first.digest == second.digest
+    document = first.to_dict()
+    assert document["region_schema_version"] == 1
+    assert document["kind"] == "region_plan"
+    assert document["region_digest"] == "sha256:" + sha256_text(
+        _region_digest_preimage(document)
+    )
+    assert document["region_id"] == "region." + document["region_digest"].split(":", 1)[1][:16]
+    assert document["op_count"] == len(document["operations"]) == 1
+    assert validate_region_plan(
+        document, capability=first.capability, re_resolve=True
+    ) == document
+
