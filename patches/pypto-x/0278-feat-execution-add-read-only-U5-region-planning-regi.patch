+def test_unplannable_registered_operations_are_reported():
+    cond = _ref("cond", "bool", (2,))
+    x = _ref("x", "float32", (2,))
+    fill = _scalar("fill", "float32")
+    y = _ref("y", "float32", (2,))
+    w = _ref("w", "float32", (2,))
+    c = _ref("c", "bool", (2,))
+    program = _program(
+        (cond, x, fill, y),
+        (
+            _op("where", (cond, x, fill), (w,)),
+            _op("compare", (w, y), (c,), {"predicate": "lt", "broadcast": True}),
+        ),
+        (c,),
+    )
+    error = _expected_error(OpContractError, lambda: plan_region(program))
+    assert error.reason == "region_operations_unplannable"
+    reported = {
+        (item["opcode"], item["reason"])
+        for item in error.details["unplannable_operations"]
+    }
+    assert (
+        "where",
+        "scalar_operand_not_supported_by_execution_contract",
+    ) in reported
+    assert ("compare", "unknown_attribute") in reported
