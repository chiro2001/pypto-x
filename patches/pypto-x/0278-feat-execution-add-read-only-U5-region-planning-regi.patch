+def test_region_digest_binds_policy_through_every_single_op_plan():
+    program = _matmul_program()
+    plan = plan_region(program)
+    document = plan.to_dict()
+    assert document["policy_digest"] == plan.policy.digest
+    assert document["capability_digest"] == plan.capability.digest
+    for item in document["operations"]:
+        replay = plan_operation(
+            item["request"]["op"],
+            item["request"]["input_shapes"],
+            item["request"]["input_dtypes"],
+            output_shape=item["request"]["output_shape"],
+            output_dtype=item["request"]["output_dtype"],
+            attributes=item["request"]["attributes"],
+            policy=plan.policy,
+            capability=plan.capability,
+        )
+        assert replay.plan.digest == item["single_op_plan_digest"]
+        assert replay.plan.payload["contract"]["digest"] == item["contract_digest"]
