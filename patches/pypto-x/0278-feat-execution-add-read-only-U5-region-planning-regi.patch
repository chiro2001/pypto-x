+    plan = plan_region(program)
+    precision = plan.region_precision
+    assert precision["class"] == "deterministic_bounded_unproven"
+    assert precision["selected_rule"] == "unproven_bound_operation_present"
+    assert precision["unproven_ops"] == [
+        {
+            "index": 0,
+            "opcode": "exp",
+            "provider_id": "portable",
+            "declared_class": "deterministic_bounded",
