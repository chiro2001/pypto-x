+def test_boundary_spec_structured_rejections():
+    matmul = _matmul_program()
+    dangling = _expected_error(
+        OpContractError,
+        lambda: plan_region(matmul, RegionSpec.boundary(["missing"], ["c"])),
+    )
+    assert dangling.reason == "region_boundary_dangling_tensor"
+
+    # implicit capture: compare reads y from outside the declared boundary
+    x = _ref("x", "float32", (2, 3))
+    y = _ref("y", "float32", (2, 3))
+    e = _ref("e", "float32", (2, 3))
+    c = _ref("c", "bool", (2, 3))
+    captured = _program(
+        (x, y),
+        (
+            _op("exp", (x,), (e,)),
+            _op("compare", (e, y), (c,), {"predicate": "lt"}),
+        ),
+        (c,),
+    )
+    error = _expected_error(
+        OpContractError,
+        lambda: plan_region(captured, RegionSpec.boundary(["x"], ["c"])),
+    )
+    assert error.reason == "region_boundary_undeclared_input"
+    assert error.field == "region_spec.entry_inputs"
+
+    # unused declared entry
+    a = _ref("a", "float32", (2, 3))
+    b = _ref("b", "float32", (3, 4))
+    z = _ref("z", "float32", (2, 4))
+    out = _ref("out", "float32", (2, 4))
+    with_unused = _program(
+        (a, b, z), (_op("matmul", (a, b), (out,)),), (out,)
+    )
+    unused = _expected_error(
+        OpContractError,
+        lambda: plan_region(with_unused, RegionSpec.boundary(["a", "b", "z"], ["out"])),
+    )
+    assert unused.reason == "region_unused_entry_input"
+
+    # entry produced inside the selected region
+    exp_reshape = _exp_reshape_program()
+    inside = _expected_error(
+        OpContractError,
+        lambda: plan_region(exp_reshape, RegionSpec.boundary(["x", "e"], ["y"])),
+    )
+    assert inside.reason == "region_entry_input_defined_in_region"
+
+    # exit not produced by the selected region
+    unproduced = _expected_error(
+        OpContractError,
+        lambda: plan_region(with_unused, RegionSpec.boundary(["a", "b"], ["out", "z"])),
+    )
+    assert unproduced.reason == "region_exit_output_not_produced_by_region"
+
+    # empty region
+    empty = _expected_error(
+        OpContractError,
+        lambda: plan_region(exp_reshape, RegionSpec.boundary(["x"], ["x"])),
+    )
+    assert empty.reason == "region_empty"
+
+    # structurally invalid Core IR (forward reference) is refused up front
+    later = _ref("later", "float32", (2, 3))
+    forward = _program(
+        (),
+        (_op("reshape", (later,), (_ref("r", "float32", (6,)),), {"shape": [6]}),),
+        (),
+        name="broken",
+    )
+    broken = _expected_error(OpContractError, lambda: plan_region(forward))
+    assert broken.reason == "region_program_invalid"
+
