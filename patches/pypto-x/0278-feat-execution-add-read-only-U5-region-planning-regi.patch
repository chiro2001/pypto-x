+# ---------------------------------------------------------------------------
+# region spec
+# ---------------------------------------------------------------------------
+@dataclass(frozen=True)
+class RegionSpec:
+    """A region selection request.
+
+    Two spellings are frozen for this slice:
+
+    * ``kind="program"`` -- the degenerate whole-:class:`CoreProgram` region
+      (all functions, or one function when ``function`` is set);
+    * ``kind="boundary"`` -- the connected subgraph between explicit
+      ``entry_inputs`` and ``exit_outputs``.
+
+    An operation-index range is deliberately **not** part of the schema: a raw
+    index is not stable under graph edits and the resulting digest would
+    silently change meaning between two revisions of the same program.
+    """
+
+    kind: str
+    function: Optional[str] = None
+    entry_inputs: Tuple[str, ...] = ()
+    exit_outputs: Tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        if self.kind not in ("program", "boundary"):
+            raise OpContractError(
+                "region_spec.kind must be 'program' or 'boundary'",
+                field="region_spec.kind",
+                requested=self.kind,
+                available=["program", "boundary"],
+                reason="region_spec_kind_invalid",
+            )
+        if self.function is not None:
+            if not isinstance(self.function, str) or not self.function.strip():
+                raise OpContractError(
+                    "region_spec.function must be a non-empty string or null",
+                    field="region_spec.function",
+                    requested=self.function,
+                    reason="region_spec_function_invalid",
+                )
+            object.__setattr__(self, "function", self.function.strip())
+        entries = _name_tuple(self.entry_inputs, "region_spec.entry_inputs")
+        exits = _name_tuple(self.exit_outputs, "region_spec.exit_outputs")
+        object.__setattr__(self, "entry_inputs", entries)
+        object.__setattr__(self, "exit_outputs", exits)
+        if self.kind == "boundary":
+            if not entries or not exits:
+                raise OpContractError(
+                    "a boundary region_spec requires non-empty entry_inputs and exit_outputs",
+                    field="region_spec",
+                    requested={
+                        "entry_inputs": list(entries),
+                        "exit_outputs": list(exits),
+                    },
+                    reason="region_spec_boundary_incomplete",
+                )
+        elif entries or exits:
+            raise OpContractError(
+                "region_spec kind='program' must not carry boundary tensor names",
+                field="region_spec",
+                requested={"entry_inputs": list(entries), "exit_outputs": list(exits)},
+                reason="region_spec_boundary_not_applicable",
+            )
+
+    @classmethod
+    def whole_program(cls, function: Optional[str] = None) -> "RegionSpec":
+        return cls(kind="program", function=function)
+
+    @classmethod
+    def boundary(
+        cls,
+        entry_inputs: Sequence[str],
+        exit_outputs: Sequence[str],
+        function: Optional[str] = None,
+    ) -> "RegionSpec":
+        return cls(
+            kind="boundary",
+            function=function,
+            entry_inputs=tuple(entry_inputs),
+            exit_outputs=tuple(exit_outputs),
+        )
+
+    @classmethod
+    def from_value(cls, value: Any) -> "RegionSpec":
+        """Coerce ``None``/mapping/RegionSpec into a RegionSpec, fail closed."""
+
+        if value is None:
+            return cls(kind="program")
+        if isinstance(value, cls):
+            return value
+        if not isinstance(value, Mapping):
+            raise OpContractError(
+                "region_spec must be a RegionSpec, a mapping or null",
+                field="region_spec",
+                requested=type(value).__name__,
+                reason="region_spec_invalid",
+            )
+        unknown = sorted(str(key) for key in value if str(key) not in (
+            "kind", "function", "entry_inputs", "exit_outputs"
+        ))
+        if unknown:
+            raise OpContractError(
+                "region_spec has unknown fields: {}".format(", ".join(unknown)),
+                field="region_spec",
+                requested=unknown,
+                available=["kind", "function", "entry_inputs", "exit_outputs"],
+                reason="region_spec_unknown_field",
+            )
+        kind = value.get("kind", "program")
+        entries = value.get("entry_inputs", ())
+        exits = value.get("exit_outputs", ())
+        if not isinstance(entries, (list, tuple)) or not isinstance(exits, (list, tuple)):
+            raise OpContractError(
+                "region_spec.entry_inputs/exit_outputs must be sequences of tensor names",
+                field="region_spec",
+                requested={"entry_inputs": entries, "exit_outputs": exits},
+                reason="region_spec_boundary_invalid",
+            )
+        return cls(
+            kind=kind,
+            function=value.get("function"),
+            entry_inputs=tuple(entries),
+            exit_outputs=tuple(exits),
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        document: Dict[str, Any] = {"kind": self.kind, "function": self.function}
+        if self.kind == "boundary":
+            document["entry_inputs"] = list(self.entry_inputs)
+            document["exit_outputs"] = list(self.exit_outputs)
+        return document
+
+
+def _name_tuple(value: Any, field: str) -> Tuple[str, ...]:
+    if isinstance(value, (str, bytes)) or not isinstance(value, (list, tuple)):
+        raise OpContractError(
+            "{} must be a sequence of tensor names".format(field),
+            field=field,
+            requested=type(value).__name__,
+            reason="region_spec_name_list_invalid",
+        )
+    names: List[str] = []
+    for item in value:
+        if not isinstance(item, str) or not item.strip():
+            raise OpContractError(
+                "{} entries must be non-empty strings".format(field),
+                field=field,
+                requested=item,
+                reason="region_spec_name_invalid",
+            )
+        names.append(item.strip())
+    if len(set(names)) != len(names):
+        raise OpContractError(
+            "{} contains duplicate names".format(field),
+            field=field,
+            requested=names,
+            reason="region_spec_duplicate_name",
+        )
+    return tuple(sorted(names))
+
+
+def _json_clone(value: Any) -> Any:
+    """Return plain JSON data (lists/dicts/scalars) for a JSON-safe value."""
+
+    return json.loads(canonical_json(value))
+
+
+def _static_shape(shape: Any, field: str) -> List[int]:
+    if not isinstance(shape, (list, tuple)):
+        raise ArtifactMismatchError(
+            "{} must be a static shape list".format(field),
+            field=field,
+            requested=type(shape).__name__,
+            reason="region_shape_not_static",
+        )
+    values: List[int] = []
+    for index, item in enumerate(shape):
+        if isinstance(item, bool) or not isinstance(item, int) or item < 0:
+            raise ArtifactMismatchError(
+                "{}[{}] must be a non-negative integer".format(field, index),
+                field="{}[{}]".format(field, index),
+                requested=item,
+                reason="region_shape_not_static",
+            )
+        values.append(item)
+    return values
+
+
+# ---------------------------------------------------------------------------
+# flattening: stable topological inventory of a CoreProgram
+# ---------------------------------------------------------------------------
+@dataclass(frozen=True)
+class _ValueKey:
+    function: str
+    scope: str
+    name: str
+
+
+@dataclass(frozen=True)
+class _FlatOp:
+    function: str
+    order: int
+    scope: str
+    path: str
+    operation: Operation
+    input_keys: Tuple[_ValueKey, ...]
+    output_keys: Tuple[_ValueKey, ...]
+
+
+@dataclass(frozen=True)
+class _FlatProgram:
+    ops: Tuple[_FlatOp, ...]
+    definitions: Mapping[_ValueKey, ValueRef]
+    producers: Mapping[_ValueKey, Optional[int]]
+    root_names: Mapping[str, Mapping[str, _ValueKey]]
+    parameters: Mapping[str, Tuple[_ValueKey, ...]]
+    returns: Mapping[str, Tuple[str, ...]]
+
+
+def _flatten_program(program: CoreProgram, function: Optional[str]) -> _FlatProgram:
+    """Flatten one/ all functions in declaration order into a topo inventory.
+
+    Core IR verifies values before use inside each region, so declaration order
+    is a valid topological order.  Nested operation regions are walked before
+    their parent operation (their results are not visible to the parent by
+    construction); block operations are walked after the block arguments are
+    bound.
+    """
+
+    function_names = [item.name for item in program.functions]
+    if function is not None and function not in function_names:
+        raise OpContractError(
+            "region_spec.function {!r} does not exist in the program".format(function),
+            field="region_spec.function",
+            requested=function,
+            available=sorted(function_names),
+            reason="region_function_not_found",
+        )
+    functions = [
+        item for item in program.functions if function is None or item.name == function
+    ]
+    ops: List[_FlatOp] = []
+    definitions: Dict[_ValueKey, ValueRef] = {}
+    producers: Dict[_ValueKey, Optional[int]] = {}
+    parameters: Dict[str, Tuple[_ValueKey, ...]] = {}
+    returns: Dict[str, Tuple[str, ...]] = {}
+    root_names: Dict[str, Dict[str, _ValueKey]] = {}
+
+    def walk(region: Region, fn_name: str, scope: str, visible: Mapping[str, _ValueKey], path: str) -> None:
+        local = dict(visible)
+        for index, operation in enumerate(region.operations):
+            for region_index, child in enumerate(operation.regions):
+                walk(
+                    child,
+                    fn_name,
+                    scope + ".ops[{}].regions[{}]".format(index, region_index),
+                    dict(local),
+                    path + ".ops[{}].regions[{}]".format(index, region_index),
+                )
+            input_keys: List[_ValueKey] = []
+            for ref in operation.inputs:
+                key = local.get(ref.name)
+                if key is None:
+                    raise OpContractError(
+                        "operation {!r} reads undefined value {!r}".format(operation.name, ref.name),
+                        field="region.operations",
+                        requested={"function": fn_name, "value": ref.name},
+                        reason="region_dangling_tensor",
+                    )
+                input_keys.append(key)
+            output_keys: List[_ValueKey] = []
+            order = len(ops)
+            for ref in operation.outputs:
+                key = _ValueKey(fn_name, scope, ref.name)
+                if key in definitions:
+                    raise OpContractError(
+                        "operation {!r} redefines value {!r}".format(operation.name, ref.name),
+                        field="region.operations",
+                        requested={"function": fn_name, "value": ref.name},
+                        reason="region_ssa_redefinition",
+                    )
+                definitions[key] = ref
+                producers[key] = order
+                local[ref.name] = key
+                output_keys.append(key)
+            ops.append(
+                _FlatOp(
+                    function=fn_name,
+                    order=order,
+                    scope=scope,
+                    path=path + ".ops[{}]".format(index),
+                    operation=operation,
+                    input_keys=tuple(input_keys),
+                    output_keys=tuple(output_keys),
+                )
+            )
+        for block_index, block in enumerate(region.blocks):
+            block_scope = scope + ".blocks[{}]".format(block_index)
+            block_visible = dict(local)
+            for ref in block.arguments:
+                key = _ValueKey(fn_name, block_scope, ref.name)
+                if key in definitions:
+                    raise OpContractError(
+                        "block argument {!r} collides with an existing value".format(ref.name),
+                        field="region.blocks",
+                        requested={"function": fn_name, "value": ref.name},
+                        reason="region_ssa_redefinition",
+                    )
+                definitions[key] = ref
+                producers[key] = None
+                block_visible[ref.name] = key
+            walk(
+                Region(operations=block.operations),
+                fn_name,
+                block_scope,
+                block_visible,
+                path + ".blocks[{}]".format(block_index),
+            )
+
+    for core_function in functions:
+        fn_name = core_function.name
+        visible: Dict[str, _ValueKey] = {}
+        parameter_keys: List[_ValueKey] = []
+        for ref in core_function.parameters:
+            key = _ValueKey(fn_name, "body", ref.name)
+            if key in definitions:
+                raise OpContractError(
+                    "function {!r} declares duplicate parameter {!r}".format(fn_name, ref.name),
+                    field="region.parameters",
+                    requested={"function": fn_name, "value": ref.name},
+                    reason="region_ssa_redefinition",
+                )
+            definitions[key] = ref
+            producers[key] = None
+            visible[ref.name] = key
+            parameter_keys.append(key)
+        walk(core_function.body, fn_name, "body", visible, "body")
+        parameters[fn_name] = tuple(parameter_keys)
+        returns[fn_name] = tuple(ref.name for ref in core_function.returns)
+        root_names[fn_name] = {}
+    # Root-visible values are the parameters and the values defined directly by
+    # the function body (never nested-region or block-local values).
+    for key, ref in definitions.items():
+        if key.scope != "body":
+            continue
+        if key.function not in root_names:
+            continue
+        root_names[key.function][key.name] = key
+    return _FlatProgram(
+        ops=tuple(ops),
+        definitions=definitions,
+        producers=producers,
+        root_names=root_names,
+        parameters=parameters,
+        returns=returns,
+    )
+
+
+# ---------------------------------------------------------------------------
+# region selection and boundary signature
+# ---------------------------------------------------------------------------
+def _resolve_root_names(
+    flat: _FlatProgram, function: str, names: Sequence[str], field: str
+) -> Tuple[_ValueKey, ...]:
+    resolved: List[_ValueKey] = []
+    available = flat.root_names.get(function, {})
+    for name in names:
+        key = available.get(name)
+        if key is None:
+            raise OpContractError(
+                "boundary tensor {!r} is not a root-visible value of function {!r}".format(
+                    name, function
+                ),
+                field=field,
+                requested={"function": function, "value": name},
+                available=sorted(available),
+                reason="region_boundary_dangling_tensor",
+            )
+        resolved.append(key)
+    return tuple(resolved)
+
+
+def _select_region(
+    flat: _FlatProgram, program: CoreProgram, spec: RegionSpec
+) -> Tuple[Tuple[int, ...], Tuple[_ValueKey, ...], Tuple[_ValueKey, ...]]:
+    """Return ``(ordered_op_indices, entry_keys, exit_keys)`` fail-closed."""
+
+    functions = sorted({op.function for op in flat.ops}) or [item.name for item in program.functions]
+    if spec.kind == "boundary" and len(functions) != 1:
+        raise OpContractError(
+            "a boundary region_spec needs exactly one function; set region_spec.function",
+            field="region_spec.function",
+            requested=spec.function,
+            available=functions,
+            reason="region_function_required",
+        )
+    function = functions[0] if spec.kind == "boundary" else spec.function
+    if function is not None and flat.returns.get(function) is None:
+        raise OpContractError(
+            "region_spec.function {!r} is outside the selected program scope".format(function),
+            field="region_spec.function",
+            requested=function,
+            available=sorted(flat.returns),
+            reason="region_function_not_found",
+        )
+
+    if spec.kind == "program":
+        selected_orders = tuple(op.order for op in flat.ops)
+        selected_set = set(selected_orders)
+        entry_keys: List[_ValueKey] = []
+        seen_entry = set()
+        for op in flat.ops:
+            for key in op.input_keys:
+                producer = flat.producers.get(key)
+                if producer is None or producer not in selected_set:
+                    if key not in seen_entry:
+                        seen_entry.add(key)
+                        entry_keys.append(key)
+        # Every declared parameter is an entry input even when unused; the
+        # region plan is a whole-program boundary statement, not a liveness
+        # report.
+        for fn_name in sorted(flat.parameters):
+            if function is not None and fn_name != function:
+                continue
+            for key in flat.parameters[fn_name]:
+                if key not in seen_entry:
+                    seen_entry.add(key)
+                    entry_keys.append(key)
+        exit_keys: List[_ValueKey] = []
+        for fn_name in sorted(flat.returns):
+            if function is not None and fn_name != function:
+                continue
+            for name in flat.returns[fn_name]:
+                key = flat.root_names[fn_name].get(name)
+                if key is None:
+                    raise OpContractError(
+                        "function {!r} returns value {!r} that is not root-visible".format(
+                            fn_name, name
+                        ),
+                        field="region.returns",
+                        requested={"function": fn_name, "value": name},
+                        reason="region_return_not_visible",
+                    )
+                exit_keys.append(key)
+        _validate_program_boundary(flat, selected_set, entry_keys, exit_keys)
+        return selected_orders, tuple(sorted(entry_keys, key=_key_sort)), tuple(
+            sorted(exit_keys, key=_key_sort)
+        )
+
+    # boundary spec
+    entry_keys = _resolve_root_names(flat, function, spec.entry_inputs, "region_spec.entry_inputs")
+    exit_keys = _resolve_root_names(flat, function, spec.exit_outputs, "region_spec.exit_outputs")
+    reachable = set(entry_keys)
+    forward = set()
+    for op in flat.ops:
+        if op.function != function:
+            continue
+        if any(key in reachable for key in op.input_keys):
+            forward.add(op.order)
+            reachable.update(op.output_keys)
+    needed = set(exit_keys)
+    backward = set()
+    for op in reversed(flat.ops):
+        if op.function != function:
+            continue
+        if any(key in needed for key in op.output_keys):
+            backward.add(op.order)
+            needed.update(op.input_keys)
+    selected = tuple(sorted(forward & backward))
+    declared_entries = set(entry_keys)
+    declared_exits = set(exit_keys)
+    selected_set = set(selected)
+    if not selected:
+        raise OpContractError(
+            "the declared boundary selects no operation",
+            field="region_spec",
+            requested=spec.to_dict(),
+            available="entry_inputs and exit_outputs connected by at least one operation",
+            reason="region_empty",
+        )
+    # A declared entry must exist outside the region (parameter / previously
+    # defined value) and must be defined before the first region operation.
+    first_order = selected[0]
+    for key in sorted(declared_entries, key=_key_sort):
+        producer = flat.producers.get(key)
+        if producer is not None and producer in selected_set:
+            raise OpContractError(
+                "entry input {!r} is produced by a selected operation".format(key.name),
+                field="region_spec.entry_inputs",
+                requested={"function": key.function, "value": key.name, "producer_op_index": producer},
+                reason="region_entry_input_defined_in_region",
+            )
+        if producer is not None and producer > first_order:
+            raise OpContractError(
+                "entry input {!r} is produced after the region starts".format(key.name),
+                field="region_spec.entry_inputs",
+                requested={"function": key.function, "value": key.name, "producer_op_index": producer},
+                available={"first_region_op_index": first_order},
+                reason="region_boundary_input_defined_after_use",
+            )
+    # Every boundary input of a selected operation must be declared (no implicit
+    # capture from outside the region).
+    used_entries = set()
+    for op in flat.ops:
+        if op.order not in selected_set:
+            continue
+        for key in op.input_keys:
+            producer = flat.producers.get(key)
+            outside = producer is None or producer not in selected_set
+            if not outside:
+                if producer >= op.order:
+                    raise OpContractError(
+                        "operation at index {} reads a value produced at index {}; the declared "
+                        "boundary is cyclic or out of topological order".format(op.order, producer),
+                        field="region_spec",
+                        requested={"op_index": op.order, "value": key.name, "producer": producer},
+                        reason="region_cycle_detected",
+                    )
+                continue
+            if key not in declared_entries:
+                raise OpContractError(
+                    "region operation {!r} implicitly captures {!r}; declare it in entry_inputs".format(
+                        op.operation.name, key.name
+                    ),
+                    field="region_spec.entry_inputs",
+                    requested={"function": key.function, "value": key.name, "consumer_op_index": op.order},
+                    available=sorted(item.name for item in entry_keys),
+                    reason="region_boundary_undeclared_input",
+                )
+            used_entries.add(key)
+    unused = declared_entries - used_entries
+    if unused:
+        raise OpContractError(
+            "declared entry input(s) are not consumed by the region: {}".format(
+                ", ".join(sorted(item.name for item in unused))
+            ),
+            field="region_spec.entry_inputs",
+            requested=sorted(item.name for item in unused),
+            reason="region_unused_entry_input",
+        )
+    for key in sorted(declared_exits, key=_key_sort):
+        producer = flat.producers.get(key)
+        if producer is None or producer not in selected_set:
+            raise OpContractError(
+                "exit output {!r} is not produced by a selected operation".format(key.name),
+                field="region_spec.exit_outputs",
+                requested={"function": key.function, "value": key.name},
+                reason="region_exit_output_not_produced_by_region",
+            )
+    return selected, tuple(sorted(entry_keys, key=_key_sort)), tuple(
+        sorted(exit_keys, key=_key_sort)
+    )
+
+
+def _validate_program_boundary(
+    flat: _FlatProgram,
+    selected_set: set,
+    entry_keys: Sequence[_ValueKey],
+    exit_keys: Sequence[_ValueKey],
+) -> None:
+    """Refuse a whole-program boundary that is not def-use closed."""
+
+    declared_entries = set(entry_keys)
+    for op in flat.ops:
+        for key in op.input_keys:
+            producer = flat.producers.get(key)
+            if producer is None or producer not in selected_set:
+                if key not in declared_entries:
+                    raise OpContractError(
+                        "operation {!r} reads {!r}, which is not produced anywhere in the program".format(
+                            op.operation.name, key.name
+                        ),
+                        field="region.operations",
+                        requested={"value": key.name, "consumer_op_index": op.order},
+                        reason="region_dangling_tensor",
+                    )
+    for key in exit_keys:
+        producer = flat.producers.get(key)
+        if producer is not None and producer in selected_set and producer >= len(flat.ops):
+            raise OpContractError(
+                "exit output {!r} is produced out of order".format(key.name),
+                field="region.returns",
+                requested={"value": key.name, "producer_op_index": producer},
+                reason="region_cycle_detected",
+            )
+
+
+def _key_sort(key: _ValueKey) -> Tuple[str, str, str]:
+    return (key.function, key.name, key.scope)
+
+
+def _boundary_signature(
+    flat: _FlatProgram,
+    spec: RegionSpec,
+    entry_keys: Sequence[_ValueKey],
+    exit_keys: Sequence[_ValueKey],
+ ) -> Mapping[str, Any]:
+    entries = []
+    for key in entry_keys:
+        ref = flat.definitions[key]
+        producer = flat.producers.get(key)
+        if producer is None:
+            if key.function in flat.parameters and key in flat.parameters[key.function]:
+                source = "function_parameter"
+            elif ".blocks[" in key.scope:
+                source = "block_argument"
+            elif spec.kind == "boundary":
+                source = "declared_entry"
+            else:
+                source = "external_value"
+            producer_index = None
+        else:
+            source = "outside_region_operation"
+            producer_index = producer
+        entries.append(
+            {
+                "function": key.function,
+                "name": key.name,
+                "role": "entry_input",
+                "source": source,
+                "kind": ref.type.kind,
+                "dtype": ref.type.dtype,
+                "shape": list(ref.type.shape),
+                "producer_op_index": producer_index,
+            }
+        )
+    exits = []
+    for key in exit_keys:
+        ref = flat.definitions[key]
+        producer = flat.producers.get(key)
+        if producer is not None:
+            source = "operation_result"
+            producer_index = producer
+        elif key in set(entry_keys):
+            source = "entry_pass_through"
+            producer_index = None
+        else:
+            raise OpContractError(
+                "exit output {!r} has no producer and is not an entry input".format(key.name),
+                field="region_spec.exit_outputs",
+                requested={"function": key.function, "value": key.name},
+                reason="region_exit_output_not_produced_by_region",
+            )
+        exits.append(
+            {
+                "function": key.function,
+                "name": key.name,
+                "role": "exit_output",
+                "source": source,
+                "kind": ref.type.kind,
+                "dtype": ref.type.dtype,
+                "shape": list(ref.type.shape),
+                "producer_op_index": producer_index,
+            }
+        )
+    return {
+        "entry_inputs": entries,
+        "exit_outputs": exits,
+    }
+
+
+# ---------------------------------------------------------------------------
+# precision view (per-op) and composition (region)
+# ---------------------------------------------------------------------------
+@dataclass(frozen=True)
+class RegionPrecisionTerm:
+    """One operation's normalized contribution to the region declaration.
+
+    This is a pure data record: :func:`compose_region_precision` never touches
+    the resolver, providers or the host, so the composition rule can be
+    audited in isolation (and exercised with synthetic terms).
+    """
+
+    index: int
+    opcode: str
+    provider_id: str
+    declared_class: str
+    provider_class: str = "portable_bitwise"
+    proven: bool = False
+    bound: Any = None
+    bound_kind: str = ""
+    is_upper_bound: bool = False
+    reference: Optional[str] = None
+    fallback_used: bool = False
+    fallback_degraded: bool = False
+    fallback_mode: str = ""
+    reasons: Tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        if self.declared_class not in ("exact", "portable_bitwise", "deterministic_bounded", "best_effort"):
+            raise ValueError("unknown per-operation numeric class {!r}".format(self.declared_class))
+        if self.provider_class not in ("exact", "portable_bitwise", "deterministic_bounded", "best_effort"):
+            raise ValueError("unknown provider numeric class {!r}".format(self.provider_class))
+
+
+def _numeric_value(value: Any) -> Optional[float]:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    number = float(value)
+    if not math.isfinite(number) or number < 0.0:
+        return None
+    return number
+
+
+def _bound_from_declaration(declaration: Mapping[str, Any]) -> Any:
+    """Extract a summable bound from a precision/envelope declaration."""
+
+    for key in ("deviation_bound", "analytic_upper_bound"):
+        number = _numeric_value(declaration.get(key))
+        if number is not None:
+            return number
+    by_operation = declaration.get("deviation_bound_by_operation")
+    if isinstance(by_operation, Mapping) and by_operation:
+        values = [_numeric_value(item) for item in by_operation.values()]
+        if all(item is not None for item in values):
+            if all(item == 0.0 for item in values):
+                return 0
+            return None
+    by_k = declaration.get("deviation_bound_by_k")
+    if isinstance(by_k, Mapping) and by_k:
+        if set(by_k) == {"all_k_le_limit"}:
+            return _numeric_value(by_k["all_k_le_limit"])
+        normalized: Dict[str, Any] = {}
+        for key, value in by_k.items():
+            number = _numeric_value(value)
+            if number is None:
+                return None
+            normalized[str(key)] = number
+        return {"by_k": normalized}
+    return None
+
+
+def _precision_view(
+    provider_id: str,
+    selected_class: str,
+    precision: Optional[Mapping[str, Any]],
+    envelope: Optional[Mapping[str, Any]],
+) -> Mapping[str, Any]:
+    """Normalize ``{numeric_class, exactness_envelope}`` for one plan.
+
+    The result is a pure projection of the frozen plan payload; the region
+    composer consumes it and :func:`validate_region_plan` recomputes it.
+    """
+
+    if selected_class not in ("exact", "portable_bitwise", "deterministic_bounded", "best_effort"):
+        raise ArtifactMismatchError(
+            "plan declares an unknown provider numeric class {!r}".format(selected_class),
+            field="selected.numeric_class",
+            requested=selected_class,
+            reason="region_numeric_class_unknown",
+        )
+    if precision is not None:
+        if not isinstance(precision, Mapping):
+            raise ArtifactMismatchError(
+                "plan precision declaration must be a mapping",
+                field="numeric_guarantee.precision",
+                requested=type(precision).__name__,
+                reason="region_precision_invalid",
+            )
+        declared = str(precision.get("class") or "")
+        if declared not in ("exact", "deterministic_bounded"):
+            raise ArtifactMismatchError(
+                "plan precision class {!r} is outside the frozen vocabulary".format(declared),
+                field="numeric_guarantee.precision.class",
+                requested=declared,
+                reason="region_precision_class_invalid",
+            )
+        kind = str(precision.get("deviation_bound_kind") or "")
+        available = bool(precision.get("deviation_bound_available"))
+        upper = precision.get("upper_bound")
+        status = str(upper.get("status") or "") if isinstance(upper, Mapping) else ""
+        proven = available and kind in PROVEN_DEVIATION_BOUND_KINDS and status == "proven"
+        if declared == "exact" and not proven:
+            raise ArtifactMismatchError(
+                "an exact precision declaration must carry a proven bound",
+                field="numeric_guarantee.precision.upper_bound",
+                requested={"class": declared, "deviation_bound_kind": kind, "status": status},
+                available=list(PROVEN_DEVIATION_BOUND_KINDS),
+                reason="region_precision_inconsistent",
+            )
+        reference: Optional[str] = None
+        bound: Any = None
+        is_upper = False
+        if proven:
+            bound = _bound_from_declaration(precision)
+            is_upper = True
+            raw_reference = precision.get("reference")
+            reference = str(raw_reference) if raw_reference else (
+                "exact_contract" if declared == "exact" else None
+            )
+        return {
+            "declared_class": declared,
+            "proven": proven,
+            "bound": bound,
+            "bound_kind": kind,
+            "is_upper_bound": is_upper,
+            "reference": reference,
+            "reasons": [] if proven else [kind or "no_registered_analytic_envelope"],
+        }
+
+    if envelope is not None:
+        if not isinstance(envelope, Mapping):
+            raise ArtifactMismatchError(
+                "plan exactness envelope must be a mapping",
+                field="numeric_guarantee.exactness_envelope",
+                requested=type(envelope).__name__,
+                reason="region_envelope_invalid",
+            )
+        declared = str(envelope.get("class") or selected_class)
+        if declared not in ("exact", "portable_bitwise", "deterministic_bounded", "best_effort"):
+            raise ArtifactMismatchError(
+                "envelope declares an unknown numeric class {!r}".format(declared),
+                field="numeric_guarantee.exactness_envelope.class",
+                requested=declared,
+                reason="region_numeric_class_unknown",
+            )
+        kind = str(envelope.get("deviation_bound_kind") or "")
+        available = bool(envelope.get("deviation_bound_available"))
+        upper = envelope.get("upper_bound")
+        status = str(upper.get("status") or "") if isinstance(upper, Mapping) else ""
+        proven = available and kind in PROVEN_DEVIATION_BOUND_KINDS and status == "proven"
+        if declared == "exact" and not proven:
+            raise ArtifactMismatchError(
+                "an exact envelope must carry a proven bound",
+                field="numeric_guarantee.exactness_envelope.upper_bound",
+                requested={"class": declared, "deviation_bound_kind": kind, "status": status},
+                available=list(PROVEN_DEVIATION_BOUND_KINDS),
+                reason="region_precision_inconsistent",
+            )
+        raw_reference = envelope.get("reference") or envelope.get("deviation_metric")
+        return {
+            "declared_class": declared,
+            "proven": proven,
+            "bound": _bound_from_declaration(envelope) if proven else None,
+            "bound_kind": kind,
+            "is_upper_bound": bool(proven and status == "proven"),
+            "reference": str(raw_reference) if raw_reference else None,
+            "reasons": [] if proven else [kind or "no_registered_proven_envelope"],
+        }
+
+    if selected_class == "portable_bitwise":
+        if provider_id == PORTABLE_PROVIDER_ID:
+            return {
+                "declared_class": "portable_bitwise",
+                "proven": True,
+                "bound": 0,
+                "bound_kind": "portable_trunk_bitwise_identity",
+                "is_upper_bound": True,
+                "reference": "portable_trunk",
+                "reasons": [],
+            }
+        return {
+            "declared_class": "portable_bitwise",
+            "proven": False,
+            "bound": None,
+            "bound_kind": "non_portable_bitwise_claim_without_envelope",
+            "is_upper_bound": False,
+            "reference": None,
+            "reasons": ["non_portable_bitwise_claim_without_envelope"],
+        }
+    if selected_class == "exact":
+        return {
+            "declared_class": "exact",
+            "proven": True,
+            "bound": 0,
+            "bound_kind": "provider_declared_exact",
+            "is_upper_bound": True,
+            "reference": "provider_declared_exact",
+            "reasons": [],
+        }
+    if selected_class == "deterministic_bounded":
+        return {
+            "declared_class": "deterministic_bounded",
+            "proven": False,
+            "bound": None,
+            "bound_kind": "no_registered_proven_envelope",
+            "is_upper_bound": False,
+            "reference": None,
+            "reasons": ["no_registered_proven_envelope"],
+        }
+    return {
+        "declared_class": "best_effort",
+        "proven": False,
+        "bound": None,
+        "bound_kind": "best_effort_provider",
+        "is_upper_bound": False,
+        "reference": None,
+        "reasons": ["best_effort_provider"],
+    }
+
+
+def _term_from_record(record: Mapping[str, Any]) -> RegionPrecisionTerm:
+    bound = dict(record["bound"])
+    fallback = record.get("fallback") or {}
+    return RegionPrecisionTerm(
+        index=int(record["index"]),
+        opcode=str(record["opcode"]),
+        provider_id=str(record["provider_id"]),
+        declared_class=str(bound["declared_class"]),
+        provider_class=str(record.get("selected_numeric_class") or bound["declared_class"]),
+        proven=bool(bound["proven"]),
+        bound=bound["bound"],
+        bound_kind=str(bound["bound_kind"]),
+        is_upper_bound=bool(bound["is_upper_bound"]),
+        reference=bound["reference"],
+        fallback_used=bool(fallback.get("used", False)),
+        fallback_degraded=bool(fallback.get("degraded", False)),
+        fallback_mode=str(fallback.get("mode") or ""),
+        reasons=tuple(str(item) for item in (bound.get("reasons") or ())),
+    )
+
+
+def _term_row(term: RegionPrecisionTerm) -> Mapping[str, Any]:
+    return {
+        "index": term.index,
+        "opcode": term.opcode,
+        "provider_id": term.provider_id,
+        "provider_class": term.provider_class,
+        "declared_class": term.declared_class,
+        "proven": term.proven,
+        "bound_kind": term.bound_kind,
+        "bound": term.bound,
+        "is_upper_bound": term.is_upper_bound,
+        "reference": term.reference,
+        "fallback_used": term.fallback_used,
+        "fallback_degraded": term.fallback_degraded,
+        "fallback_mode": term.fallback_mode,
+        "reasons": list(term.reasons),
+    }
+
+
+def _bound_is_nonzero(value: Any) -> bool:
+    if value is None:
+        return True
+    if isinstance(value, Mapping) and "by_k" in value:
+        return any(_numeric_value(item) not in (None, 0.0) for item in value["by_k"].values())
+    number = _numeric_value(value)
+    return number is None or number != 0.0
+
+
+def _sum_bounds(terms: Sequence[RegionPrecisionTerm]) -> Tuple[Any, List[str]]:
+    numeric: List[Tuple[int, float]] = []
+    by_k: List[Tuple[int, Mapping[str, Any]]] = []
+    for term in terms:
+        if term.bound is None:
+            return None, ["bound_value_unavailable"]
+        if isinstance(term.bound, Mapping) and "by_k" in term.bound:
+            by_k.append((term.index, term.bound["by_k"]))
+        elif _numeric_value(term.bound) is not None:
+            numeric.append((term.index, float(term.bound)))
+        else:
+            return None, ["bound_form_not_numeric"]
+    if numeric and by_k:
+        return None, ["mixed_numeric_and_by_k_bounds"]
+    if by_k:
+        keys = set(by_k[0][1])
+        if any(set(item[1]) != keys for item in by_k):
+            return None, ["bound_by_k_keys_not_comparable"]
+        summed = {
+            str(key): sum(float(item[1][key]) for item in by_k) for key in sorted(keys)
+        }
+        return {"by_k": summed}, []
+    if numeric:
+        return sum(item[1] for item in numeric), []
+    return None, ["no_bound_terms"]
+
+
+def _compose_deviation_bound(
+    terms: Sequence[RegionPrecisionTerm], region_class: str
+) -> Mapping[str, Any]:
+    rows = [_term_row(term) for term in terms]
+    if region_class == "exact":
+        return {
+            "kind": "exact_contract_bound",
+            "sum": 0,
+            "deviation_bound_by_k": {"all_k_le_limit": 0},
+            "is_upper_bound": True,
+            "statement": (
+                "every operation is exact by contract reference; the region deviation "
+                "against that reference is exactly zero"
+            ),
+            "reasons": [],
+            "terms": rows,
+        }
+    if region_class == "portable_bitwise":
+        return {
+            "kind": "portable_bitwise_trunk_identity",
+            "sum": 0,
+            "deviation_bound_by_k": {"all_k_le_limit": 0},
+            "is_upper_bound": True,
+            "statement": (
+                "every operation selected the portable trunk; the region output is bitwise "
+                "identical to the sequential portable reference in the frozen topological order"
+            ),
+            "reasons": [],
+            "terms": rows,
+        }
+    if region_class == "deterministic_bounded":
+        total, sum_reasons = _sum_bounds(terms)
+        reasons = list(sum_reasons)
+        upper = total is not None and all(term.is_upper_bound for term in terms)
+        if total is not None and not all(term.is_upper_bound for term in terms):
+            reasons.append("some_term_is_not_a_proven_upper_bound")
+        nonzero = [term for term in terms if _bound_is_nonzero(term.bound)]
+        references = {term.reference for term in nonzero}
+        if len(references) > 1:
+            upper = False
+            reasons.append("cross_reference_bounds_not_comparable")
+        elif any(term.reference is None for term in nonzero):
+            upper = False
+            reasons.append("nonzero_bound_has_no_reference")
+        statement = (
+            "sum of the per-operation proven bounds in the frozen topological order; the sum "
+            "is an upper bound on the deviation from the common reference only when every "
+            "term is a proven upper bound for that same reference (no error cancellation is "
+            "assumed and no cross-provider compensation is applied)"
+        )
+        return {
+            "kind": "sum_of_per_operation_proven_bounds",
+            "sum": total,
+            "deviation_bound_by_k": total if isinstance(total, Mapping) else None,
+            "is_upper_bound": bool(upper),
+            "statement": statement,
+            "reasons": reasons,
+            "terms": rows,
+        }
+    return {
+        "kind": "none",
+        "sum": None,
+        "deviation_bound_by_k": None,
+        "is_upper_bound": False,
+        "statement": "no region-level deviation bound is claimed",
+        "reasons": ["unproven_or_best_effort_region"],
+        "terms": rows,
+    }
+
+
+def compose_region_precision(
+    terms: Sequence[RegionPrecisionTerm],
+    *,
+    require_proven_deviation_bound: bool = False,
+    requirement: str = "portable",
+) -> Mapping[str, Any]:
+    """Apply the 0020 section 2 conservative composition rules.
+
+    Pure function: no resolver, provider or host access.  The returned
+    document is recomputed (and byte-compared) by :func:`validate_region_plan`,
+    so a rewritten region declaration is refused.
+    """
+
+    terms = tuple(terms)
+    if not terms:
+        raise ValueError("a region precision declaration needs at least one term")
+    if requirement not in _REQUIREMENT_MIN_STRENGTH:
+        raise ValueError("unknown numeric requirement {!r}".format(requirement))
+
+    best_effort = [
+        term
+        for term in terms
+        if term.declared_class == "best_effort" or term.provider_class == "best_effort"
+    ]
+    unproven = [
+        term
+        for term in terms
+        if not term.proven
+        and term.declared_class in ("deterministic_bounded", "portable_bitwise")
+    ]
+    exact = [term for term in terms if term.declared_class == "exact" and term.proven]
+    bounded_proven = [
+        term
+        for term in terms
+        if term.declared_class == "deterministic_bounded" and term.proven
+    ]
+    portable = [term for term in terms if term.declared_class == "portable_bitwise"]
+
+    checks = [
+        {
+            "check": "best_effort_operation_present",
+            "result": bool(best_effort),
+            "evidence": [term.index for term in best_effort],
+        },
+        {
+            "check": "unproven_bound_operation_present",
+            "result": bool(unproven),
+            "evidence": [term.index for term in unproven],
+        },
+        {
+            "check": "all_operations_exact",
+            "result": len(exact) == len(terms),
+            "evidence": [term.index for term in terms if term.declared_class == "exact"],
+        },
+        {
+            "check": "proven_bounded_operation_present",
+            "result": bool(bounded_proven),
+            "evidence": [term.index for term in bounded_proven],
+        },
+        {
+            "check": "portable_bitwise_operation_present",
+            "result": bool(portable),
+            "evidence": [term.index for term in portable],
+        },
+    ]
+    if best_effort:
+        region_class = "best_effort"
+        selected_rule = "best_effort_operation_present"
+    elif unproven:
+        region_class = "deterministic_bounded_unproven"
+        selected_rule = "unproven_bound_operation_present"
+    elif len(exact) == len(terms):
+        region_class = "exact"
+        selected_rule = "all_operations_exact"
+    elif bounded_proven:
+        region_class = "deterministic_bounded"
+        selected_rule = "proven_bounded_operation_present"
+    else:
+        region_class = "portable_bitwise"
+        selected_rule = "exact_and_portable_bitwise_only"
+
+    deviation_bound = _compose_deviation_bound(terms, region_class)
+    provider_ids = sorted({term.provider_id for term in terms})
+    provider_counts = {
+        provider: sum(1 for term in terms if term.provider_id == provider)
+        for provider in provider_ids
+    }
+    fallback_terms = [
+        term for term in terms if term.fallback_used or term.fallback_degraded
+    ]
+    proven_ok = region_class in ("exact", "portable_bitwise") or (
+        region_class == "deterministic_bounded" and bool(deviation_bound["is_upper_bound"])
+    )
+    # ``numeric.requirement`` is a provider-level statement (mirrors the
+    # resolver's per-op check); the region-level check takes the weakest
+    # provider class in the region.  The contract precision class above is a
+    # stronger, contract-level statement and is deliberately kept separate.
+    weakest_provider_class = max(
+        terms, key=lambda term: REGION_CLASS_STRENGTH[term.provider_class]
+    ).provider_class
+    requirement_ok = (
+        REGION_CLASS_STRENGTH[weakest_provider_class]
+        <= _REQUIREMENT_MIN_STRENGTH[requirement]
+    )
+    all_portable_trunk = all(
+        term.provider_id == PORTABLE_PROVIDER_ID for term in terms
+    )
+    fail_reasons: List[str] = []
+    if require_proven_deviation_bound and not proven_ok:
+        fail_reasons.append("proven_deviation_bound_unavailable")
+    if not requirement_ok:
+        fail_reasons.append("numeric_requirement_unmet")
+    if region_class == "best_effort":
+        fail_reasons.append("best_effort_region_not_usable_for_require_policy")
+    return {
+        "declaration_version": 1,
+        "rule_id": "u5-region-precision-0020-v1",
+        "rule": (
+            "precision precedence: best_effort > deterministic_bounded_unproven > "
+            "deterministic_bounded(all proven) > portable_bitwise > exact"
+        ),
+        "class": region_class,
+        "selected_rule": selected_rule,
+        "provider_ids": provider_ids,
+        "provider_counts": provider_counts,
+        "mixed_providers": len(provider_ids) > 1,
+        "weakest_provider_class": weakest_provider_class,
+        "provider_classes": [
+            {
+                "index": term.index,
+                "opcode": term.opcode,
+                "provider_id": term.provider_id,
+                "provider_class": term.provider_class,
+            }
+            for term in terms
+        ],
+        "all_portable_trunk": all_portable_trunk,
+        "portable_trunk_identity_statement": (
+            "every operation selected the portable trunk, so the region output is bitwise "
+            "identical to the sequential portable reference in the frozen topological order"
+            if all_portable_trunk
+            else "not every operation selected the portable trunk"
+        ),
+        "cross_provider_policy": (
+            "provider bounds are summed independently; no cancellation, compensation or "
+            "re-ordering across providers is assumed"
+        ),
+        "exact_ops": [term.index for term in terms if term.declared_class == "exact"],
+        "portable_bitwise_ops": [term.index for term in portable],
+        "bounded_proven_ops": [term.index for term in bounded_proven],
+        "unproven_ops": [
+            {
+                "index": term.index,
+                "opcode": term.opcode,
+                "provider_id": term.provider_id,
+                "declared_class": term.declared_class,
+                "bound_kind": term.bound_kind,
+                "reasons": list(term.reasons),
+            }
+            for term in unproven
+        ],
+        "best_effort_ops": [term.index for term in best_effort],
+        "fallback_ops": [
+            {
+                "index": term.index,
+                "opcode": term.opcode,
+                "provider_id": term.provider_id,
+                "mode": term.fallback_mode,
+                "used": term.fallback_used,
+                "degraded": term.fallback_degraded,
+            }
+            for term in fallback_terms
+        ],
+        "fallback_modes": sorted(
+            {term.fallback_mode for term in fallback_terms if term.fallback_mode}
+        ),
+        "deviation_bound": deviation_bound,
+        "terms": [_term_row(term) for term in terms],
+        "derivation": {
+            "checks": checks,
+            "selected_class": region_class,
+            "selected_rule": selected_rule,
+            "no_error_cancellation": True,
+            "order_sensitive": True,
+            "topological_order_bound": True,
+        },
+        "require_proven_deviation_bound": bool(require_proven_deviation_bound),
+        "require_proven_deviation_bound_satisfied": bool(proven_ok),
+        "numeric_requirement": requirement,
+        "numeric_requirement_satisfied": bool(requirement_ok),
+        "fail_closed_reasons": fail_reasons,
+        "fail_closed": bool(fail_reasons),
+    }
+
+
+# ---------------------------------------------------------------------------
+# plan_region
+# ---------------------------------------------------------------------------
+def plan_region(
+    program: CoreProgram,
+    region_spec: Any = None,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None,
+) -> "RegionPlan":
+    """Freeze a region plan for ``program``; never executes anything."""
+
+    if not isinstance(program, CoreProgram):
+        raise OpContractError(
+            "plan_region requires a CoreProgram",
+            field="program",
+            requested=type(program).__name__,
+            reason="region_program_invalid",
+        )
+    try:
+        program.verify()
+    except Exception as exc:  # CoreIRError and friends are request-level
+        raise OpContractError(
+            "CoreProgram verification failed: {}: {}".format(type(exc).__name__, exc),
+            field="program",
+            requested=type(exc).__name__,
+            reason="region_program_invalid",
+            details={"exception": type(exc).__name__},
+        ) from exc
+    spec = RegionSpec.from_value(region_spec)
+    active_policy = policy if policy is not None else ExecutionPolicy()
+    if not isinstance(active_policy, ExecutionPolicy):
+        raise PolicyInvalidValueError(
+            "policy must be an ExecutionPolicy",
+            field="policy",
+            requested=type(active_policy).__name__,
+            reason="not_an_execution_policy",
+        )
+    active_capability = _coerce_capability(capability)
+    flat = _flatten_program(program, spec.function)
+    selected, entry_keys, exit_keys = _select_region(flat, program, spec)
+    if not selected:
+        raise OpContractError(
+            "the selected region contains no operation",
+            field="region_spec",
+            requested=spec.to_dict(),
+            reason="region_empty",
+        )
+    boundary = _boundary_signature(flat, spec, entry_keys, exit_keys)
+
+    selected_set = set(selected)
+    ordered_ops = [op for op in flat.ops if op.order in selected_set]
+    records: List[Mapping[str, Any]] = []
+    missing: List[Mapping[str, Any]] = []
+    unplannable: List[Mapping[str, Any]] = []
+    numeric_failures: List[Mapping[str, Any]] = []
+    resolutions: List[ResolutionResult] = []
+
+    for op in ordered_ops:
+        kind, payload = _plan_region_operation(op, active_policy, active_capability)
+        if kind == "planned":
+            records.append(payload)
+            resolutions.append(payload["_resolution"])
+        elif kind == "missing_contract":
+            missing.append(payload)
+        elif kind == "numeric_failure":
+            numeric_failures.append(payload)
+        else:
+            unplannable.append(payload)
+
+    if missing:
+        raise _missing_contracts_error(missing, spec, len(ordered_ops), active_capability, unplannable, numeric_failures)
+    if unplannable:
+        raise _unplannable_error(unplannable, spec, len(ordered_ops), active_capability, numeric_failures)
+    if numeric_failures:
+        raise _region_numeric_error(
+            numeric_failures,
+            spec,
+            active_capability,
+            require_proven=bool(active_policy.numeric.require_proven_deviation_bound),
+        )
+    for item in list(boundary["entry_inputs"]) + list(boundary["exit_outputs"]):
+        if str(item["kind"]) != "tensor":
+            raise OpContractError(
+                "this slice only plans tensor region boundaries; {!r} is {!r}".format(
+                    item["name"], item["kind"]
+                ),
+                field="region_spec",
+                requested={
+                    "function": item["function"],
+                    "name": item["name"],
+                    "kind": item["kind"],
+                },
+                available="tensor boundaries (scalar operands are outside the batch-1 contracts)",
+                reason="region_boundary_non_tensor",
+                capability_digest=active_capability.digest,
+            )
+
+    terms = [_term_from_record(record) for record in records]
+    region_precision = compose_region_precision(
+        terms,
+        require_proven_deviation_bound=bool(
+            active_policy.numeric.require_proven_deviation_bound
+        ),
+        requirement=active_policy.numeric.requirement,
+    )
+    if region_precision["fail_closed"]:
+        raise _region_composition_error(
+            region_precision, spec, active_capability, records
+        )
+
+    operations = [
+        {key: record[key] for key in _OP_KEYS if key in record}
+        for record in records
+    ]
+    preimage = {
+        "region_schema_version": REGION_SCHEMA_VERSION,
+        "boundary_signature": boundary,
+        "operations": [
+            {
+                "index": item["index"],
+                "function": item["function"],
+                "opcode": item["opcode"],
+                "single_op_plan_digest": item["single_op_plan_digest"],
+            }
+            for item in operations
+        ],
+    }
+    region_digest = "sha256:" + sha256_text(preimage)
+    document = {
+        "region_schema_version": REGION_SCHEMA_VERSION,
+        "kind": REGION_KIND,
+        "region_id": _region_id(region_digest),
+        "region_digest": region_digest,
+        "region_spec": spec.to_dict(),
+        "policy": active_policy.to_dict(),
+        "policy_digest": active_policy.digest,
+        "capability_digest": active_capability.digest,
+        "resolver_version": RESOLVER_VERSION,
+        "boundary_signature": boundary,
+        "operations": operations,
+        "op_count": len(operations),
+        "region_precision": region_precision,
+    }
+    return RegionPlan(
+        document=document,
+        policy=active_policy,
+        capability=active_capability,
+        resolutions=tuple(resolutions),
+    )
+
+
+def _coerce_capability(capability: Optional[CapabilitySnapshot]) -> CapabilitySnapshot:
+    if capability is None:
+        return CapabilitySnapshot.probe_host()
+    if not isinstance(capability, CapabilitySnapshot):
+        raise CapabilityUnavailableError(
+            "capability must be a CapabilitySnapshot",
+            field="capability",
+            requested=type(capability).__name__,
+            reason="not_a_capability_snapshot",
+        )
+    capability.verify_digest()
+    if not capability.matches_host_probe():
+        raise CapabilityUnavailableError(
+            "capability snapshot does not match the probed local host",
+            field="capability",
+            requested={"kind": capability.kind, "triple": capability.triple},
+            reason="capability_does_not_match_host_probe",
+            capability_digest=capability.digest,
+        )
+    return capability
+
+
+def _plan_region_operation(
+    op: _FlatOp, policy: ExecutionPolicy, capability: CapabilitySnapshot
+) -> Tuple[str, Mapping[str, Any]]:
+    operation = op.operation
+    raw_name = operation.name
+    try:
+        canonical = lookup_canonical_opcode(raw_name)
+    except OpContractError as exc:
+        return "missing_contract", {
+            "opcode": raw_name,
+            "raw_name": raw_name,
+            "canonical": None,
+            "reason": exc.reason or "opcode_not_registered",
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+        }
+    try:
+        definition = get_op_definition(canonical)
+    except OpContractError as exc:
+        return "missing_contract", {
+            "opcode": canonical,
+            "raw_name": raw_name,
+            "canonical": canonical,
+            "reason": exc.reason or "opcode_not_registered",
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+        }
+
+    for ref in operation.inputs:
+        if ref.type.kind != "tensor":
+            return "unplannable", {
+                "opcode": canonical,
+                "raw_name": raw_name,
+                "reason": "scalar_operand_not_supported_by_execution_contract",
+                "index": op.order,
+                "function": op.function,
+                "path": op.path,
+                "operand": {"name": ref.name, "kind": ref.type.kind},
+            }
+    if len(operation.outputs) != 1:
+        return "unplannable", {
+            "opcode": canonical,
+            "raw_name": raw_name,
+            "reason": (
+                "operation_has_no_result"
+                if not operation.outputs
+                else "multi_output_not_supported_by_execution_contract"
+            ),
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+            "result_count": len(operation.outputs),
+        }
+    result = operation.outputs[0]
+    if result.type.kind != "tensor":
+        return "unplannable", {
+            "opcode": canonical,
+            "raw_name": raw_name,
+            "reason": "non_tensor_result_not_supported_by_execution_contract",
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+            "result_kind": result.type.kind,
+        }
+
+    request = _request_from_operation(canonical, definition, op)
+    try:
+        resolution = plan_operation(
+            canonical,
+            request["input_shapes"],
+            request["input_dtypes"],
+            output_shape=request["output_shape"],
+            output_dtype=request["output_dtype"],
+            attributes=request["attributes"],
+            policy=policy,
+            capability=capability,
+        )
+    except NumericGuaranteeUnmetError as exc:
+        return "numeric_failure", {
+            "opcode": canonical,
+            "raw_name": raw_name,
+            "reason": exc.reason or "numeric_guarantee_unmet",
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+            "field": exc.field,
+            "error_code": exc.code,
+        }
+    except ExecutionError as exc:
+        return "unplannable", {
+            "opcode": canonical,
+            "raw_name": raw_name,
+            "reason": exc.reason or exc.code,
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+            "field": exc.field,
+            "error_code": exc.code,
+            "message": str(exc),
+        }
+
+    plan = resolution.plan
+    if tuple(plan.output_shape) != tuple(request["output_shape"]):
+        return "unplannable", {
+            "opcode": canonical,
+            "raw_name": raw_name,
+            "reason": "region_op_result_shape_mismatch",
+            "index": op.order,
+            "function": op.function,
+            "path": op.path,
+            "requested": list(request["output_shape"]),
+            "available": list(plan.output_shape),
+        }
+    if str(plan.output_dtype) != str(request["output_dtype"]):
+        # Schema-v2 plans (matmul/qmatmul) have no ``request.output_dtype``:
+        # ``ExecutionPlan.output_dtype`` falls back to ``request.dtype`` (the
+        # *input* dtype), which is wrong for qmatmul_s8s8_s32 (int8 -> int32).
+        # For those plans the authoritative result domain is the frozen
+        # OpDefinition output spec; schema-v3 plans are compared directly.
+        plan_request = plan.payload.get("request")
+        declared_output = (
+            plan_request.get("output_dtype")
+            if isinstance(plan_request, Mapping)
+            else None
+        )
+        output_spec = definition.outputs[0] if definition.outputs else None
+        contract_outputs = tuple(output_spec.dtypes) if output_spec is not None else ()
+        if declared_output is not None or str(request["output_dtype"]) not in contract_outputs:
+            return "unplannable", {
+                "opcode": canonical,
+                "raw_name": raw_name,
+                "reason": "region_op_result_dtype_mismatch",
+                "index": op.order,
+                "function": op.function,
+                "path": op.path,
+                "requested": request["output_dtype"],
+                "available": str(plan.output_dtype) if declared_output is not None else list(contract_outputs),
+            }
+
+    payload = plan.payload
+    selected = payload["selected"]
+    numeric = payload["numeric_guarantee"]
+    precision = numeric.get("precision")
+    envelope = numeric.get("exactness_envelope")
+    view = _precision_view(
+        str(selected["provider"]),
+        str(selected["numeric_class"]),
+        precision,
+        envelope,
+    )
+    fallback = payload.get("fallback") or {}
+    events = [
+        {
+            "kind": str(item.get("kind") or ""),
+            "from": str(item.get("from") or ""),
+            "to": str(item.get("to") or ""),
+            "reason": str(item.get("reason") or ""),
+            "fallback_mode": str(item.get("fallback_mode") or ""),
+        }
+        for item in (fallback.get("events") or ())
+        if isinstance(item, Mapping)
+    ]
+    record = {
+        "index": op.order,
+        "function": op.function,
+        "path": op.path,
+        "op_name": raw_name,
+        "opcode": canonical,
+        "request": request,
+        "contract_digest": str(payload["contract"]["digest"]),
+        "contract_version": str(payload["contract"]["version"]),
+        "single_op_plan_digest": plan.digest,
+        "plan_schema_version": int(payload["plan_schema_version"]),
+        "provider_id": str(selected["provider"]),
+        "provider_version": str(selected["provider_version"]),
+        "implementation": str(selected["implementation"]),
+        "numeric_class": str(view["declared_class"]),
+        "selected_numeric_class": str(selected["numeric_class"]),
+        "precision": mapping_copy(precision) if isinstance(precision, Mapping) else None,
+        "envelope": mapping_copy(envelope) if isinstance(envelope, Mapping) else None,
+        "fallback": {
+            "mode": str(fallback.get("mode") or ""),
+            "primary": str(fallback.get("primary") or ""),
+            "chain": [str(item) for item in (fallback.get("chain") or ())],
+            # The frozen plan payload records ``events``/``degraded`` but not
+            # ``used``; a fallback substitution is exactly "events is non-empty"
+            # (the resolver appends an event whenever selected != preferred).
+            "used": bool(events) or bool(fallback.get("used", False)),
+            "degraded": bool(fallback.get("degraded", False)) or bool(events),
+            "events": events,
+        },
+        "bound": {
+            "declared_class": str(view["declared_class"]),
+            "proven": bool(view["proven"]),
+            "bound": view["bound"],
+            "bound_kind": str(view["bound_kind"]),
+            "is_upper_bound": bool(view["is_upper_bound"]),
+            "reference": view["reference"],
+            "reasons": list(view["reasons"]),
+        },
+        "_resolution": resolution,
+    }
+    return "planned", record
+
+
+def _request_from_operation(
+    canonical: str, definition: Any, op: _FlatOp
+) -> Mapping[str, Any]:
+    operation = op.operation
+    inputs = []
+    roles = tuple(definition.input_roles or ())
+    for index, ref in enumerate(operation.inputs):
+        role = roles[index] if index < len(roles) else "operand{}".format(index)
+        inputs.append(
+            {
+                "name": ref.name,
+                "role": role,
+                "shape": list(ref.type.shape),
+                "dtype": ref.type.dtype,
+            }
+        )
+    outputs = [
+        {"name": ref.name, "shape": list(ref.type.shape), "dtype": ref.type.dtype}
+        for ref in operation.outputs
+    ]
+    return {
+        "op": canonical,
+        "input_shapes": [list(item["shape"]) for item in inputs],
+        "input_dtypes": [item["dtype"] for item in inputs],
+        "output_shape": list(outputs[0]["shape"]),
+        "output_dtype": outputs[0]["dtype"],
+        "attributes": mapping_copy(operation.attributes),
+        "inputs": inputs,
+        "outputs": outputs,
+    }
+
+
+def _missing_contracts_error(
+    missing: Sequence[Mapping[str, Any]],
+    spec: RegionSpec,
+    op_count: int,
+    capability: CapabilitySnapshot,
+    unplannable: Sequence[Mapping[str, Any]],
+    numeric_failures: Sequence[Mapping[str, Any]],
+) -> OpContractError:
+    aggregated: Dict[str, Dict[str, Any]] = {}
+    for item in missing:
+        name = str(item["opcode"])
+        bucket = aggregated.setdefault(
+            name,
+            {
+                "opcode": name,
+                "raw_names": set(),
+                "occurrences": 0,
+                "reason": str(item["reason"]),
+                "first_index": int(item["index"]),
+                "functions": set(),
+            },
+        )
+        bucket["raw_names"].add(str(item["raw_name"]))
+        bucket["occurrences"] += 1
+        bucket["functions"].add(str(item["function"]))
+    contracts = []
+    for name in sorted(aggregated, key=lambda key: (-aggregated[key]["occurrences"], key)):
+        bucket = aggregated[name]
+        contracts.append(
+            {
+                "opcode": name,
+                "raw_names": sorted(bucket["raw_names"]),
+                "occurrences": int(bucket["occurrences"]),
+                "reason": bucket["reason"],
+                "first_index": bucket["first_index"],
+                "functions": sorted(bucket["functions"]),
+            }
+        )
+    total = sum(item["occurrences"] for item in contracts)
+    return OpContractError(
+        "region contains {} operation(s) with no registered execution contract: {}".format(
+            total, ", ".join(item["opcode"] for item in contracts)
+        ),
+        field="region.operations",
+        requested={
+            "region_spec": spec.to_dict(),
+            "op_count": op_count,
+            "missing_contracts": [item["opcode"] for item in contracts],
+        },
+        available=sorted(registered_opcodes()),
+        reason="region_contracts_missing",
+        capability_digest=capability.digest,
+        details={
+            "scope": "region",
+            "region_spec": spec.to_dict(),
+            "op_count": op_count,
+            "missing_operation_count": total,
+            "missing_contracts": contracts,
+            "unplannable_operations": _aggregate_unplannable(unplannable),
+            "numeric_failures": [dict(item) for item in numeric_failures],
+            "next_step": (
+                "register the listed opcodes in the operation registry (batch 2/3) before a "
+                "region plan can be frozen; the region plan refuses partial declarations"
+            ),
+        },
+    )
+
+
+def _aggregate_unplannable(unplannable: Sequence[Mapping[str, Any]]) -> List[Mapping[str, Any]]:
+    aggregated: Dict[Tuple[str, str], Dict[str, Any]] = {}
+    for item in unplannable:
+        key = (str(item["opcode"]), str(item["reason"]))
+        bucket = aggregated.setdefault(
+            key,
+            {
+                "opcode": str(item["opcode"]),
+                "reason": str(item["reason"]),
+                "occurrences": 0,
+                "first_index": int(item["index"]),
+                "functions": set(),
+            },
+        )
+        bucket["occurrences"] += 1
+        bucket["functions"].add(str(item["function"]))
+    result = []
+    for key in sorted(aggregated, key=lambda item: (-aggregated[item]["occurrences"], item)):
+        bucket = aggregated[key]
+        result.append(
+            {
+                "opcode": bucket["opcode"],
+                "reason": bucket["reason"],
+                "occurrences": int(bucket["occurrences"]),
+                "first_index": bucket["first_index"],
+                "functions": sorted(bucket["functions"]),
+            }
+        )
+    return result
+
+
+def _unplannable_error(
+    unplannable: Sequence[Mapping[str, Any]],
+    spec: RegionSpec,
+    op_count: int,
+    capability: CapabilitySnapshot,
+    numeric_failures: Sequence[Mapping[str, Any]],
+) -> OpContractError:
+    aggregated = _aggregate_unplannable(unplannable)
+    return OpContractError(
+        "region contains {} operation(s) whose request cannot be represented by the "
+        "registered contracts".format(sum(item["occurrences"] for item in aggregated)),
+        field="region.operations",
+        requested={"region_spec": spec.to_dict(), "op_count": op_count},
+        available=sorted(registered_opcodes()),
+        reason="region_operations_unplannable",
+        capability_digest=capability.digest,
+        details={
+            "scope": "region",
+            "region_spec": spec.to_dict(),
+            "op_count": op_count,
+            "unplannable_operations": aggregated,
+            "numeric_failures": [dict(item) for item in numeric_failures],
+        },
+    )
+
+
+def _region_numeric_error(
+    failures: Sequence[Mapping[str, Any]],
+    spec: RegionSpec,
+    capability: CapabilitySnapshot,
+    *,
+    require_proven: bool,
+) -> NumericGuaranteeUnmetError:
+    return NumericGuaranteeUnmetError(
+        "region cannot satisfy numeric.require_proven_deviation_bound; {} operation(s) "
+        "failed closed during planning".format(len(failures)),
+        field="numeric.require_proven_deviation_bound",
+        requested={"region_spec": spec.to_dict(), "require_proven": require_proven},
+        available="a region whose every operation publishes a proven deviation bound",
+        reason="proven_deviation_bound_unavailable",
+        capability_digest=capability.digest,
+        details={
+            "scope": "region",
+            "region_spec": spec.to_dict(),
+            "require_proven_deviation_bound": True,
+            "numeric_failures": [dict(item) for item in failures],
+        },
+    )
+
+
+def _region_composition_error(
+    region_precision: Mapping[str, Any],
+    spec: RegionSpec,
+    capability: CapabilitySnapshot,
+    records: Sequence[Mapping[str, Any]],
+) -> NumericGuaranteeUnmetError:
+    reasons = list(region_precision.get("fail_closed_reasons") or ())
+    reason = (
+        "proven_deviation_bound_unavailable"
+        if "proven_deviation_bound_unavailable" in reasons
+        else "numeric_requirement_unmet"
+    )
+    return NumericGuaranteeUnmetError(
+        "region-level precision composition fails closed ({})".format(
+            ", ".join(reasons) or "unknown"
+        ),
+        field=(
+            "numeric.require_proven_deviation_bound"
+            if reason == "proven_deviation_bound_unavailable"
+            else "numeric.requirement"
+        ),
+        requested={"region_spec": spec.to_dict()},
+        available={
+            "region_class": region_precision.get("class"),
+            "deviation_bound": region_precision.get("deviation_bound"),
+        },
+        reason=reason,
+        capability_digest=capability.digest,
+        details={
+            "scope": "region",
+            "region_spec": spec.to_dict(),
+            "region_precision": dict(region_precision),
+            "operations": [
+                {
+                    "index": item["index"],
+                    "opcode": item["opcode"],
+                    "provider_id": item["provider_id"],
+                    "numeric_class": item["numeric_class"],
+                    "bound": item["bound"],
+                }
+                for item in records
+            ],
+        },
+    )
+
+
+def _region_id(region_digest: str) -> str:
+    return "region." + region_digest.split(":", 1)[-1][:16]
+
+
+# ---------------------------------------------------------------------------
+# RegionPlan + strict validation
+# ---------------------------------------------------------------------------
+class RegionPlan:
+    """Frozen region plan document plus the resolution traces used to build it."""
+
+    def __init__(
+        self,
+        document: Mapping[str, Any],
+        policy: ExecutionPolicy,
+        capability: Optional[CapabilitySnapshot],
+        resolutions: Sequence[ResolutionResult] = (),
+    ) -> None:
+        self._document = _json_clone(document)
+        self._policy = policy
+        self._capability = capability
+        self._resolutions = tuple(resolutions)
+
+    @property
+    def document(self) -> Mapping[str, Any]:
+        return _json_clone(self._document)
+
+    @property
+    def digest(self) -> str:
+        return str(self._document["region_digest"])
+
+    @property
+    def region_id(self) -> str:
+        return str(self._document["region_id"])
+
+    @property
+    def operations(self) -> Tuple[Mapping[str, Any], ...]:
+        return tuple(_json_clone(item) for item in self._document["operations"])
+
+    @property
+    def region_precision(self) -> Mapping[str, Any]:
+        return _json_clone(self._document["region_precision"])
+
+    @property
+    def policy(self) -> ExecutionPolicy:
+        return self._policy
+
+    @property
+    def capability(self) -> Optional[CapabilitySnapshot]:
+        return self._capability
+
+    @property
+    def resolutions(self) -> Tuple[ResolutionResult, ...]:
+        return self._resolutions
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return self.document
+
+    def to_json(self) -> str:
+        return canonical_json(self.document)
+
+    @classmethod
+    def from_dict(
+        cls,
+        document: Mapping[str, Any],
+        *,
+        policy: Optional[ExecutionPolicy] = None,
+        capability: Optional[CapabilitySnapshot] = None,
+        re_resolve: bool = False,
+    ) -> "RegionPlan":
+        checked = validate_region_plan(
+            document, policy=policy, capability=capability, re_resolve=re_resolve
+        )
+        active_policy = policy if policy is not None else policy_from_dict(checked["policy"])
+        return cls(
+            document=checked,
+            policy=active_policy,
+            capability=capability,
+            resolutions=(),
+        )
+
+    def validate(
+        self,
+        *,
+        policy: Optional[ExecutionPolicy] = None,
+        capability: Optional[CapabilitySnapshot] = None,
+        re_resolve: Optional[bool] = None,
+    ) -> "RegionPlan":
+        validate_region_plan(
+            self._document,
+            policy=policy if policy is not None else self._policy,
+            capability=capability if capability is not None else self._capability,
+            re_resolve=True if re_resolve is None else bool(re_resolve),
+        )
+        return self
+
+
+def _recompute_region_digest(
+    boundary: Mapping[str, Any], operations: Any
+) -> str:
+    """Recompute the Merkle-style region digest from the raw operation list."""
+
+    if not isinstance(operations, list):
+        raise ArtifactMismatchError(
+            "region plan operations must be an array",
+            field="region_plan.operations",
+            requested=type(operations).__name__,
+            reason="region_operations_invalid",
+        )
+    entries = []
+    for position, item in enumerate(operations):
+        if not isinstance(item, Mapping):
+            raise ArtifactMismatchError(
+                "region operation entry must be a mapping",
+                field="region_plan.operations[{}]".format(position),
+                requested=type(item).__name__,
+                reason="region_operations_invalid",
+            )
+        for key in ("index", "function", "opcode", "single_op_plan_digest"):
+            if key not in item:
+                raise ArtifactMismatchError(
+                    "region operation is missing field {!r}".format(key),
+                    field="region_plan.operations[{}]".format(position),
+                    requested=sorted(str(field) for field in item),
+                    available=["index", "function", "opcode", "single_op_plan_digest"],
+                    reason="region_operation_field_missing",
+                )
+        if isinstance(item["index"], bool) or not isinstance(item["index"], int):
+            raise ArtifactMismatchError(
+                "region operation index must be an integer",
+                field="region_plan.operations[{}].index".format(position),
+                requested=item["index"],
+                reason="region_operation_index_mismatch",
+            )
+        if item["index"] != position:
+            raise ArtifactMismatchError(
+                "region operation index is not the topological position",
+                field="region_plan.operations[{}].index".format(position),
+                requested=item["index"],
+                available=position,
+                reason="region_operation_index_mismatch",
+            )
+        if not isinstance(item["single_op_plan_digest"], str) or not item[
+            "single_op_plan_digest"
+        ].startswith("sha256:"):
+            raise ArtifactMismatchError(
+                "region operation single_op_plan_digest must be a sha256 digest",
+                field="region_plan.operations[{}].single_op_plan_digest".format(position),
+                requested=item["single_op_plan_digest"],
+                reason="region_operation_digest_invalid",
+            )
+        entries.append(
+            {
+                "index": item["index"],
+                "function": str(item["function"]),
+                "opcode": str(item["opcode"]),
+                "single_op_plan_digest": item["single_op_plan_digest"],
+            }
+        )
+    preimage = {
+        "region_schema_version": REGION_SCHEMA_VERSION,
+        "boundary_signature": boundary,
+        "operations": entries,
+    }
+    return "sha256:" + sha256_text(preimage)
+
+
+def validate_region_plan(
+    document: Mapping[str, Any],
+    *,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None,
+    re_resolve: bool = False,
+) -> Mapping[str, Any]:
+    """Strictly validate a frozen region plan; return a JSON-clean copy.
+
+    The validator always recomputes ``region_digest`` from the document's own
+    preimage, recomputes every per-operation precision view and the region
+    composition, and refuses any unknown/missing field.  With
+    ``re_resolve=True`` it additionally replays every operation through
+    :func:`plan_operation` (the two-way anchor between the region plan and the
+    single-operation path).
+    """
+
+    if not isinstance(document, Mapping):
+        raise ArtifactMismatchError(
+            "region plan must be a mapping",
+            field="region_plan",
+            requested=type(document).__name__,
+            reason="region_plan_not_a_mapping",
+        )
+    data = _json_clone(document)
+    unknown = sorted(str(key) for key in data if str(key) not in _TOP_LEVEL_KEYS)
+    missing = [key for key in _TOP_LEVEL_KEYS if key not in data]
+    if unknown:
+        raise ArtifactMismatchError(
+            "region plan has unknown fields: {}".format(", ".join(unknown)),
+            field="region_plan",
+            requested=unknown,
+            available=list(_TOP_LEVEL_KEYS),
+            reason="region_plan_unknown_field",
+        )
+    if missing:
+        raise ArtifactMismatchError(
+            "region plan is missing required fields: {}".format(", ".join(missing)),
+            field="region_plan",
+            requested=missing,
+            available=list(_TOP_LEVEL_KEYS),
+            reason="region_plan_field_missing",
+        )
+    if data["region_schema_version"] != REGION_SCHEMA_VERSION:
+        raise ArtifactMismatchError(
+            "unsupported region plan schema version",
+            field="region_plan.region_schema_version",
+            requested=data["region_schema_version"],
+            available=REGION_SCHEMA_VERSION,
+            reason="region_schema_version_mismatch",
+        )
+    if data["kind"] != REGION_KIND:
+        raise ArtifactMismatchError(
+            "region plan kind mismatch",
+            field="region_plan.kind",
+            requested=data["kind"],
+            available=REGION_KIND,
+            reason="region_plan_kind_mismatch",
+        )
+    if not isinstance(data["boundary_signature"], Mapping):
+        raise ArtifactMismatchError(
+            "boundary_signature must be a mapping",
+            field="region_plan.boundary_signature",
+            requested=type(data["boundary_signature"]).__name__,
+            reason="region_boundary_invalid",
+        )
+    if not isinstance(data["policy"], Mapping):
+        raise ArtifactMismatchError(
+            "region plan policy must be a mapping",
+            field="region_plan.policy",
+            requested=type(data["policy"]).__name__,
+            reason="region_policy_invalid",
+        )
+    numeric_policy = data["policy"].get("numeric")
+    if not isinstance(numeric_policy, Mapping):
+        raise ArtifactMismatchError(
+            "region plan policy.numeric must be a mapping",
+            field="region_plan.policy.numeric",
+            requested=type(numeric_policy).__name__,
+            reason="region_policy_invalid",
+        )
+    if not isinstance(data["policy_digest"], str) or not data["policy_digest"].startswith("sha256:"):
+        raise ArtifactMismatchError(
+            "region plan policy_digest must be a sha256 digest",
+            field="region_plan.policy_digest",
+            requested=data["policy_digest"],
+            reason="region_policy_digest_mismatch",
+        )
+    if not isinstance(data["capability_digest"], str) or not data["capability_digest"].startswith("sha256:"):
+        raise ArtifactMismatchError(
+            "region plan capability_digest must be a sha256 digest",
+            field="region_plan.capability_digest",
+            requested=data["capability_digest"],
+            reason="region_capability_digest_mismatch",
+        )
+    if not isinstance(data["resolver_version"], int) or isinstance(data["resolver_version"], bool):
+        raise ArtifactMismatchError(
+            "region plan resolver_version must be an integer",
+            field="region_plan.resolver_version",
+            requested=data["resolver_version"],
+            reason="region_resolver_version_invalid",
+        )
+    if data["resolver_version"] != RESOLVER_VERSION:
+        raise ArtifactMismatchError(
+            "region plan was produced by a different resolver version",
+            field="region_plan.resolver_version",
+            requested=data["resolver_version"],
+            available=RESOLVER_VERSION,
+            reason="region_resolver_version_mismatch",
+        )
+    if not isinstance(data["region_spec"], Mapping):
+        raise ArtifactMismatchError(
+            "region plan region_spec must be a mapping",
+            field="region_plan.region_spec",
+            requested=type(data["region_spec"]).__name__,
+            reason="region_spec_invalid",
+        )
+    boundary = _validate_boundary_signature(data["boundary_signature"])
+    recomputed_digest = _recompute_region_digest(boundary, data["operations"])
+    if data["region_digest"] != recomputed_digest:
+        raise ArtifactMismatchError(
+            "region_digest does not match the document preimage",
+            field="region_plan.region_digest",
+            requested=data["region_digest"],
+            available=recomputed_digest,
+            reason="region_digest_mismatch",
+        )
+    recomputed_id = _region_id(recomputed_digest)
+    if data["region_id"] != recomputed_id:
+        raise ArtifactMismatchError(
+            "region_id does not match the region digest",
+            field="region_plan.region_id",
+            requested=data["region_id"],
+            available=recomputed_id,
+            reason="region_id_mismatch",
+        )
+    operations = _validate_operations(data["operations"], boundary, data["region_spec"])
+    _validate_region_spec_consistency(data["region_spec"], boundary, operations)
+    if int(data["op_count"]) != len(operations):
+        raise ArtifactMismatchError(
+            "region plan op_count does not match the operation list",
+            field="region_plan.op_count",
+            requested=data["op_count"],
+            available=len(operations),
+            reason="region_op_count_mismatch",
+        )
+    derived_terms = [_term_from_record(item) for item in operations]
+    derived_precision = compose_region_precision(
+        derived_terms,
+        require_proven_deviation_bound=bool(
+            numeric_policy.get("require_proven_deviation_bound", False)
+        ),
+        requirement=str(numeric_policy.get("requirement", "portable")),
+    )
+    if _json_clone(data["region_precision"]) != _json_clone(derived_precision):
+        raise ArtifactMismatchError(
+            "region_precision does not match the recomputed composition of the operation list",
+            field="region_plan.region_precision",
+            requested=data["region_precision"],
+            available=derived_precision,
+            reason="region_precision_mismatch",
+        )
+    stored_policy = policy if policy is not None else policy_from_dict(data["policy"])
+    if stored_policy.digest != data["policy_digest"]:
+        raise ArtifactMismatchError(
+            "embedded policy digest does not match the policy document",
+            field="region_plan.policy_digest",
+            requested=data["policy_digest"],
+            available=stored_policy.digest,
+            reason="region_policy_digest_mismatch",
+        )
+    if re_resolve:
+        active_capability = capability
+        if active_capability is None:
+            active_capability = CapabilitySnapshot.probe_host()
+        _re_resolve_document(data, stored_policy, active_capability, operations)
+    return data
+
