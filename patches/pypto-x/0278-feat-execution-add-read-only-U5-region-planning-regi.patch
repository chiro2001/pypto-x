+def test_missing_contracts_are_aggregated_by_opcode_with_counts():
+    a = _ref("a", "float32", (2, 2))
+    b = _ref("b", "float32", (2, 2))
+    s1 = _ref("s1", "float32", (2, 2))
+    s2 = _ref("s2", "float32", (2, 2))
+    t = _ref("t", "float32", (2, 2))
+    c = _ref("c", "float32", (2, 2))
+    program = _program(
+        (a, b),
+        (
+            _op("add", (a, b), (s1,)),
+            _op("add", (s1, b), (s2,)),
+            _op("transpose", (s2,), (t,), {"permutation": [1, 0]}),
+            _op("matmul", (t, t), (c,)),
+        ),
+        (c,),
+    )
+    error = _expected_error(OpContractError, lambda: plan_region(program))
+    assert error.reason == "region_contracts_missing"
+    assert error.field == "region.operations"
+    assert error.details["op_count"] == 4
+    assert error.details["missing_operation_count"] == 3
+    missing = error.details["missing_contracts"]
+    assert [item["opcode"] for item in missing] == ["add", "transpose"]
+    assert missing[0]["occurrences"] == 2
+    assert missing[1]["occurrences"] == 1
+    assert missing[0]["raw_names"] == ["add"]
+    # the registered matmul still planned: the diagnostic is not a first-error abort
+    assert error.details["unplannable_operations"] == []
+
