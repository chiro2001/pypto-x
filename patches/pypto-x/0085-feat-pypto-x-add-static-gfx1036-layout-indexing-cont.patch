+    done = builder.label("constant_done")
+    for value_index, value in enumerate(values):
+        next_label = builder.label("constant_next")
+        match = builder.temp("constant_match")
+        builder.line("  {} = icmp eq i64 {}, {}".format(match, index, value_index))
+        builder.line("  br i1 {}, label %{}, label %{}".format(match, next_label + "_value", next_label))
+        builder.line("{}:".format(next_label + "_value"))
+        _emit_store_value(builder, output_pointer, index, dtype, _llvm_storage_literal(dtype, value))
+        builder.line("  br label %{}".format(done))
+        builder.line("{}:".format(next_label))
+    builder.line("  br label %{}".format(done))
+    builder.line("{}:".format(done))
