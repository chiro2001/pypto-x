+
+
+def _disassemble(object_bytes):
+    objdump = shutil.which("llvm-objdump")
+    if objdump is None:
+        raise RuntimeError("llvm-objdump is required for C2 static evidence")
+    with tempfile.TemporaryDirectory(prefix="pypto-x-amdgpu-c2-disasm-") as directory:
+        path = Path(directory) / "kernel.o"
+        path.write_bytes(object_bytes)
+        result = subprocess.run(
+            [objdump, "-d", str(path)],
+            check=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        return result.stdout
+
+
+def build_report():
+    compiler = AmdgpuStaticCompiler()
+    artifacts = []
+    for operation, (program, oracle) in _cases().items():
+        artifact = compiler.compile(compiler.lower(program, AMD_IGPU_GFX1036))
+        # Re-derive all canonical plans/bindings before recording evidence;
+        # this exercises the same digest/tamper fail-closed path used by the
+        # runtime loader, while still making no device call.
+        decode_amdgpu_artifact(artifact)
+        envelope = json.loads(bytes(artifact.payload).decode("utf-8"))
+        object_bytes = base64.b64decode(envelope["object_b64"].encode("ascii"), validate=True)
+        disassembly = _disassemble(object_bytes)
+        assembly_lower = envelope["assembly"].lower()
+        disassembly_lower = disassembly.lower()
