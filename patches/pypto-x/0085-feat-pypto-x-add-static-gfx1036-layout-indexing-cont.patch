+def _f32_bits(value: Any) -> int:
+    return struct.unpack("<I", struct.pack("<f", float(value)))[0]
+
+
+def _bf16_bits(value: Any) -> int:
+    bits = _f32_bits(value)
+    upper = bits >> 16
+    lsb = upper & 1
+    rounded = bits + 0x7FFF + lsb
+    return (rounded >> 16) & 0xFFFF
+
+
+def _llvm_f32_literal(value: Any) -> str:
+    return "0x{:016X}".format(_f32_bits(value) << 32)
+
+
+def _llvm_storage_literal(dtype: str, value: Any) -> str:
+    dtype = canonical_dtype(dtype)
+    if dtype == "float32":
+        return _llvm_f32_literal(value)
+    if dtype == "bf16":
+        return str(_bf16_bits(value))
+    if dtype == "bool":
+        return "1" if bool(value) else "0"
+    return str(int(value))
+
