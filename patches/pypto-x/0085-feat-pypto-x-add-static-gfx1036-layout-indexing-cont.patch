     return dtype, output_shape
 
 
+def _c2_storage_ref(ref: ValueRef, context: str, *, tensor_only: bool = False) -> Tuple[str, Tuple[int, ...]]:
+    if not (_is_tensor(ref.type) or (ref.type.kind == "scalar" and not tensor_only)):
+        raise AmdgpuUnsupportedError("{} requires tensor/scalar storage values".format(context))
+    dtype = canonical_dtype(ref.type.dtype)
+    if dtype not in _C2_STORAGE_DTYPES:
+        raise AmdgpuUnsupportedError("{} does not support dtype {!r}".format(context, dtype))
+    return dtype, _value_shape(ref.type, context)
+
+
+def _c2_one_output(operation: Operation, name: str) -> ValueRef:
+    if len(operation.outputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires exactly one output".format(name))
+    return operation.outputs[0]
+
+
+def _c2_attrs_call(fn: Any, *args: Any, context: str) -> Any:
+    try:
+        return fn(*args, context=context)
+    except AmdgpuStaticError:
+        raise
+    except Exception as exc:
+        raise _c2_error(context, exc) from exc
+
+
+def _c2_validate_copy(operation: Operation, name: str) -> None:
+    if len(operation.inputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires one input".format(name))
+    output = _c2_one_output(operation, name)
+    input_dtype, input_shape = _c2_storage_ref(operation.inputs[0], "{} input".format(name), tensor_only=True)
+    output_dtype, output_shape = _c2_storage_ref(output, "{} output".format(name), tensor_only=True)
+    if input_dtype != output_dtype or _element_count(input_shape) != _element_count(output_shape):
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU {} requires exact input/output shapes and matching dtype/element count".format(name)
+        )
+
+
+def _c2_validate_binary(operation: Operation, name: str) -> None:
+    if len(operation.inputs) != 2:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires two inputs".format(name))
+    output = _c2_one_output(operation, name)
+    if not all(_is_tensor(ref.type) or ref.type.kind == "scalar" for ref in operation.inputs):
+        raise AmdgpuUnsupportedError("static AMDGPU {} supports tensor/scalar operands only".format(name))
+    if not (_is_tensor(output.type) or output.type.kind == "scalar"):
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires tensor/scalar output".format(name))
+    dtypes = [canonical_dtype(ref.type.dtype) for ref in operation.inputs + (output,)]
+    if any(dtype not in _C2_FLOAT_DTYPES for dtype in dtypes) or len(set(dtypes)) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU {} requires matching FP32/BF16 storage".format(name))
+    input_shapes = [_value_shape(ref.type, "AMDGPU {} input".format(name)) for ref in operation.inputs]
+    output_shape = _value_shape(output.type, "AMDGPU {} output".format(name))
+    if name in ("add", "mul") and any(not _is_tensor(ref.type) for ref in operation.inputs):
+        expected = _broadcast_shape(input_shapes, "{} scalar broadcast".format(name))
+        if expected != output_shape:
+            raise AmdgpuUnsupportedError("static AMDGPU {} output shape is invalid".format(name))
+        return
+    if input_shapes[0] != input_shapes[1] or input_shapes[0] != output_shape:
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU {} requires exact input/output shapes; broadcasting is unsupported".format(name)
+        )
+
+
+def _c2_validate_cast(operation: Operation) -> None:
+    if len(operation.inputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU cast requires one input")
+    output = _c2_one_output(operation, "cast")
+    input_ref = operation.inputs[0]
+    input_dtype, input_shape = _c2_storage_ref(input_ref, "cast input")
+    output_dtype, output_shape = _c2_storage_ref(output, "cast output")
+    if input_ref.type.kind != output.type.kind or input_shape != output_shape:
+        raise AmdgpuUnsupportedError("static AMDGPU cast must preserve value kind and shape")
+    if input_dtype == output_dtype:
+        return
+    allowed = {
+        ("bf16", "float32"),
+        ("float32", "bf16"),
+        ("int32", "int64"),
+        ("int64", "int32"),
+        ("bool", "int32"),
+        ("bool", "int64"),
+        ("int32", "bool"),
+        ("int64", "bool"),
+    }
+    if (input_dtype, output_dtype) not in allowed:
+        raise AmdgpuUnsupportedError(
+            "static AMDGPU cast supports BF16/FP32 and exact integer/bool storage conversions"
+        )
+    declared = operation.attributes.get("dtype")
+    if declared is None:
+        declared = operation.attributes.get("to")
+    if declared is None:
+        declared = operation.attributes.get("target_dtype")
+    if declared is None:
+        declared = operation.attributes.get("out_dtype")
+    if declared is not None:
+        try:
+            declared_dtype = canonical_dtype(declared)
+        except Exception as exc:
+            raise _c2_error("cast target dtype", exc) from exc
+        if declared_dtype != output_dtype:
+            raise AmdgpuUnsupportedError("static AMDGPU cast target dtype does not match output")
+
+
+def _c2_validate_constant(operation: Operation) -> None:
+    if operation.inputs:
+        raise AmdgpuUnsupportedError("static AMDGPU constant must not have inputs")
+    output = _c2_one_output(operation, "constant")
+    dtype, shape = _c2_storage_ref(output, "constant output")
+    del dtype
+    raw = operation.attributes.get("values", operation.attributes.get("value", None))
+    if "values" not in operation.attributes and "value" not in operation.attributes:
+        raise AmdgpuUnsupportedError("static AMDGPU constant requires value/values")
+    try:
+        values = list(flatten_values(raw))
+    except Exception as exc:
+        raise _c2_error("constant values", exc) from exc
+    count = _element_count(shape)
+    if len(values) != count:
+        raise AmdgpuUnsupportedError("static AMDGPU constant value count does not match output shape")
+    # A non-scalar inline table is deliberately bounded.  The backend has no
+    # constant-memory ABI yet; rejecting a large table prevents a Qwen shape
+    # audit from materialising a numel-sized descriptor/code sequence.
+    if count > 64:
+        raise AmdgpuUnsupportedError("static AMDGPU constant tables over 64 elements require a buffer ABI")
+
+
+def _c2_validate_transpose(operation: Operation) -> None:
+    if len(operation.inputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU transpose requires one input")
+    output = _c2_one_output(operation, "transpose")
+    input_ref = operation.inputs[0]
+    input_dtype, input_shape = _c2_storage_ref(input_ref, "transpose input", tensor_only=True)
+    output_dtype, output_shape = _c2_storage_ref(output, "transpose output", tensor_only=True)
+    if input_dtype != output_dtype or len(input_shape) != len(output_shape) or len(input_shape) > 4:
+        raise AmdgpuUnsupportedError("static AMDGPU transpose supports equal-dtype rank <= 4 tensors")
+    permutation = _c2_attrs_call(_m1b_permutation, input_shape, operation.attributes, context="transpose")
+    if output_shape != tuple(input_shape[axis] for axis in permutation):
+        raise AmdgpuUnsupportedError("static AMDGPU transpose output shape does not match permutation")
+
+
+def _c2_validate_slice(operation: Operation) -> None:
+    if len(operation.inputs) != 1:
+        raise AmdgpuUnsupportedError("static AMDGPU slice requires one input")
+    output = _c2_one_output(operation, "slice")
+    input_dtype, input_shape = _c2_storage_ref(operation.inputs[0], "slice input", tensor_only=True)
+    output_dtype, output_shape = _c2_storage_ref(output, "slice output", tensor_only=True)
+    if input_dtype != output_dtype:
+        raise AmdgpuUnsupportedError("static AMDGPU slice requires matching storage dtypes")
+    spec = _c2_attrs_call(_m1b_slice_spec, input_shape, operation.attributes, context="slice")
+    expected = list(input_shape)
+    for axis, start, stop, step in spec:
+        expected[axis] = max(0, (stop - start + step - 1) // step)
+    if output_shape != tuple(expected):
+        raise AmdgpuUnsupportedError("static AMDGPU slice output shape does not match descriptor")
+
+
+def _c2_validate_concat(operation: Operation) -> None:
+    if len(operation.inputs) < 1:
+        raise AmdgpuUnsupportedError("static AMDGPU concat requires at least one input")
+    output = _c2_one_output(operation, "concat")
+    if not _is_tensor(output.type) or not all(_is_tensor(ref.type) for ref in operation.inputs):
+        raise AmdgpuUnsupportedError("static AMDGPU concat supports tensor values only")
+    dtype = canonical_dtype(output.type.dtype)
+    if dtype not in _C2_STORAGE_DTYPES:
+        raise AmdgpuUnsupportedError("static AMDGPU concat dtype is unsupported")
+    shapes = [static_shape(ref.type, "concat input") for ref in operation.inputs]
+    output_shape = static_shape(output.type, "concat output")
+    if any(canonical_dtype(ref.type.dtype) != dtype for ref in operation.inputs):
+        raise AmdgpuUnsupportedError("static AMDGPU concat requires one storage dtype")
+    axis_raw = operation.attributes.get("axis", operation.attributes.get("dim", 0))
+    if isinstance(axis_raw, bool) or not isinstance(axis_raw, int):
+        raise AmdgpuUnsupportedError("static AMDGPU concat axis must be an integer")
+    axis = axis_raw + len(shapes[0]) if axis_raw < 0 else axis_raw
+    if axis < 0 or axis >= len(shapes[0]) or any(len(shape) != len(shapes[0]) for shape in shapes):
+        raise AmdgpuUnsupportedError("static AMDGPU concat axis/rank is invalid")
+    expected = list(shapes[0])
+    expected[axis] = sum(shape[axis] for shape in shapes)
+    if any(shape[other] != expected[other] for shape in shapes for other in range(len(expected)) if other != axis):
+        raise AmdgpuUnsupportedError("static AMDGPU concat non-axis dimensions are incompatible")
+    if output_shape != tuple(expected):
+        raise AmdgpuUnsupportedError("static AMDGPU concat output shape is invalid")
+
+
+def _c2_validate_split(operation: Operation) -> None:
+    if len(operation.inputs) != 1 or len(operation.outputs) < 1:
+        raise AmdgpuUnsupportedError("static AMDGPU split requires one input and outputs")
+    source = operation.inputs[0]
+    if not _is_tensor(source.type) or any(not _is_tensor(ref.type) for ref in operation.outputs):
+        raise AmdgpuUnsupportedError("static AMDGPU split supports tensors only")
+    source_shape = static_shape(source.type, "split input")
+    dtype = canonical_dtype(source.type.dtype)
+    if dtype not in _C2_STORAGE_DTYPES or any(canonical_dtype(ref.type.dtype) != dtype for ref in operation.outputs):
+        raise AmdgpuUnsupportedError("static AMDGPU split requires one storage dtype")
+    _c2_attrs_call(_m1b_split_sizes, source_shape, tuple(ref.type for ref in operation.outputs), operation.attributes, context="split")
+
+
+def _c2_validate_indexing(operation: Operation, name: str) -> None:
