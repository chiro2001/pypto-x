+def _value_shape(value_type: CoreType, context: str) -> Tuple[int, ...]:
+    """Return the logical shape used by the pointer ABI.
+
+    Scalar SSA values use a one-element global storage slot in this static
+    adapter.  That keeps the per-operation kernel ABI uniform and, more
+    importantly, makes Qwen's scalar constants explicit rather than silently
+    dropping them at a kernel boundary.
+    """
+
+    if _is_tensor(value_type):
+        return static_shape(value_type, context)
+    if value_type.kind == "scalar":
+        return ()
+    raise AmdgpuUnsupportedError("{} requires tensor or scalar values".format(context))
+
+
+def _value_count(value_type: CoreType, context: str) -> int:
+    return _element_count(_value_shape(value_type, context))
+
+
+def _contiguous_strides(shape: Sequence[int]) -> Tuple[int, ...]:
+    strides = [1] * len(shape)
+    running = 1
+    for axis in range(len(shape) - 1, -1, -1):
+        strides[axis] = running
+        running *= int(shape[axis])
+    return tuple(strides)
+
+
+def _broadcast_shape(shapes: Sequence[Sequence[int]], context: str) -> Tuple[int, ...]:
+    """Validate NumPy-style right-aligned broadcast and return its shape."""
+
+    normalized = [tuple(int(dimension) for dimension in shape) for shape in shapes]
+    rank = max((len(shape) for shape in normalized), default=0)
+    result = [1] * rank
+    for shape in normalized:
+        delta = rank - len(shape)
+        for axis, dimension in enumerate(shape):
+            target_axis = axis + delta
+            if dimension not in (1, result[target_axis]) and result[target_axis] != 1:
+                raise AmdgpuUnsupportedError(
+                    "{} shapes are not broadcast-compatible: {}".format(context, normalized)
+                )
+            result[target_axis] = max(result[target_axis], dimension)
+    return tuple(result)
+
+
+def _c2_error(context: str, exc: Exception) -> AmdgpuUnsupportedError:
+    return AmdgpuUnsupportedError("static AMDGPU {} is outside the exact C2 contract: {}".format(context, exc))
+
