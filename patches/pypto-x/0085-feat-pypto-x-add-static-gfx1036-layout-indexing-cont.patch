+def test_c1_artifact_version_is_rejected_and_requires_recompile():
+    source = _tensor("source", "float32", (5,))
+    output = _tensor("output", "float32", (5,))
+    artifact = _compile(_program((source,), (output,), "identity"))
+    payload = json.loads(bytes(artifact.payload).decode("utf-8"))
+    payload["amdgpu_lowering_version"] = 1
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    metadata = dict(artifact.metadata)
+    metadata["payload_digest"] = hashlib.sha256(encoded).hexdigest()
+    old_artifact = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        payload=encoded,
+        metadata=metadata,
+    )
+    with pytest.raises(AmdgpuArtifactError, match="version field|digest|canonical"):
+        decode_amdgpu_artifact(old_artifact)
