+#!/usr/bin/env python3
+"""Static LLVM/ELF evidence and host-oracle audit for AMDGPU C2.
+
+The driver deliberately does not call a HIP runtime.  It compiles one small
+representative program for each C2 layout/indexing/control family and records
+the scalar descriptor oracle alongside the real gfx1036 LLVM/ELF evidence.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+from pypto.compiler.targets.hip import AmdgpuStaticCompiler, decode_amdgpu_artifact
