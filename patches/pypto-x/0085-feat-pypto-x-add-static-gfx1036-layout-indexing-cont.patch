+def _emit_load_raw(builder: _IRBuilder, pointer: str, index: str, dtype: str) -> str:
+    """Load one ABI storage element without changing its representation."""
+
+    dtype = canonical_dtype(dtype)
+    item_type = _item_type(dtype)
+    address = _emit_pointer(builder, pointer, index, dtype)
+    loaded = builder.temp("load")
+    alignment = {"float32": 4, "bf16": 2, "int32": 4, "int64": 8, "bool": 1}[dtype]
+    builder.line("  {} = load {}, ptr addrspace(1) {}, align {}".format(loaded, item_type, address, alignment))
+    return loaded
+
+
+def _emit_load_i64(builder: _IRBuilder, pointer: str, index: str, dtype: str) -> str:
+    """Load an index/integer value as signed i64, preserving negative indices."""
+
+    dtype = canonical_dtype(dtype)
+    raw = _emit_load_raw(builder, pointer, index, dtype)
+    if dtype == "int64":
+        return raw
+    if dtype == "int32":
+        result = builder.temp("idx64")
+        builder.line("  {} = sext i32 {} to i64".format(result, raw))
+        return result
+    if dtype == "bool":
+        result = builder.temp("idx64")
+        builder.line("  {} = zext i8 {} to i64".format(result, raw))
+        return result
+    raise AmdgpuUnsupportedError("integer load does not support dtype {!r}".format(dtype))
+
+
+def _emit_store_raw(builder: _IRBuilder, pointer: str, index: str, dtype: str, value: str) -> None:
+    """Store a value that already has the output ABI storage type."""
+
+    dtype = canonical_dtype(dtype)
+    item_type = _item_type(dtype)
+    address = _emit_pointer(builder, pointer, index, dtype)
+    alignment = {"float32": 4, "bf16": 2, "int32": 4, "int64": 8, "bool": 1}[dtype]
+    builder.line("  store {} {}, ptr addrspace(1) {}, align {}".format(item_type, value, address, alignment))
+
+
+def _emit_store_i64(builder: _IRBuilder, pointer: str, index: str, dtype: str, value: str) -> None:
+    """Store an integer expression held in i64 using the declared storage."""
+
+    dtype = canonical_dtype(dtype)
+    if dtype == "int64":
+        _emit_store_raw(builder, pointer, index, dtype, value)
+        return
+    if dtype == "int32":
+        narrowed = builder.temp("i32")
+        builder.line("  {} = trunc i64 {} to i32".format(narrowed, value))
+        _emit_store_raw(builder, pointer, index, dtype, narrowed)
+        return
+    if dtype == "bool":
+        truth = builder.temp("truth")
+        normalized = builder.temp("bool")
+        builder.line("  {} = icmp ne i64 {}, 0".format(truth, value))
+        builder.line("  {} = zext i1 {} to i8".format(normalized, truth))
+        _emit_store_raw(builder, pointer, index, dtype, normalized)
+        return
+    raise AmdgpuUnsupportedError("integer store does not support dtype {!r}".format(dtype))
+
+
+def _emit_load_f32(builder: _IRBuilder, pointer: str, index: str, dtype: str) -> str:
+    """Load FP32/BF16 storage and expose it as f32 for arithmetic."""
+
+    dtype = canonical_dtype(dtype)
+    if dtype not in _C2_FLOAT_DTYPES:
+        raise AmdgpuUnsupportedError("floating load does not support dtype {!r}".format(dtype))
+    return _emit_load(builder, pointer, index, dtype)
+
+
+def _emit_store_f32(builder: _IRBuilder, pointer: str, index: str, dtype: str, value: str) -> None:
+    dtype = canonical_dtype(dtype)
+    if dtype not in _C2_FLOAT_DTYPES:
+        raise AmdgpuUnsupportedError("floating store does not support dtype {!r}".format(dtype))
+    _emit_store(builder, pointer, index, dtype, value)
+
+
+def _emit_load_value(builder: _IRBuilder, pointer: str, index: str, dtype: str) -> str:
+    """Load one value in its ABI type (float, i16, i32, i64, or i8)."""
+
+    return _emit_load_raw(builder, pointer, index, dtype)
+
+
+def _emit_store_value(builder: _IRBuilder, pointer: str, index: str, dtype: str, value: str) -> None:
+    _emit_store_raw(builder, pointer, index, dtype, value)
+
