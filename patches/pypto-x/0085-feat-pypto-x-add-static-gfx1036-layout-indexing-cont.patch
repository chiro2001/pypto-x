+            {
+                "operation": operation,
+                "program_digest": artifact.metadata["program_digest"],
+                "plan_digest": artifact.metadata["plan_digest"],
+                "llvm_ir_digest": artifact.metadata["llvm_ir_digest"],
+                "assembly_digest": artifact.metadata["assembly_digest"],
+                "object_digest": artifact.metadata["object_digest"],
+                "object_format": envelope["object_format"],
+                "object_bytes": len(object_bytes),
+                "llvm_ir_has_load": " load " in envelope["llvm_ir"].lower(),
+                "llvm_ir_has_store": " store " in envelope["llvm_ir"].lower(),
+                "llvm_ir_has_bounds": "icmp ult i64" in envelope["llvm_ir"],
+                "assembly_has_load": any(token in assembly_lower for token in ("global_load", "flat_load", "s_load")),
+                "assembly_has_store": any(token in assembly_lower for token in ("global_store", "flat_store", "buffer_store")),
+                "assembly_has_alu": any(token in assembly_lower for token in ("v_add", "v_sub", "v_mul", "v_cmp", "v_cndmask", "s_add", "s_mul", "s_cmp")),
+                "disassembly_format": "elf64-amdgpu" in disassembly_lower,
+                "disassembly_has_load": any(token in disassembly_lower for token in ("global_load", "flat_load", "s_load")),
+                "disassembly_has_store": any(token in disassembly_lower for token in ("global_store", "flat_store", "buffer_store")),
+                "disassembly_has_alu": any(token in disassembly_lower for token in ("v_add", "v_sub", "v_mul", "v_cmp", "v_cndmask", "s_add", "s_mul", "s_cmp")),
+                "host_oracle": oracle,
+            }
+        )
+    return {
+        "target": {"name": "amd-igpu-gfx1036", "processor": AMDGCN_PROCESSOR, "triple": AMDGCN_TRIPLE},
+        "static_only": True,
+        "runtime_unverified": True,
+        "native_execution_claim": False,
+        "toolchain": {"llvm_as": shutil.which("llvm-as"), "llc": shutil.which("llc"), "llvm_objdump": shutil.which("llvm-objdump")},
+        "artifacts": artifacts,
+        "notes": [
+            "Each C2 family has a small scalar descriptor/oracle; no device runtime was called.",
+            "Indexing descriptors are compile-time O(rank+segments), never a numel-sized map.",
+            "Gather/embedding negative or out-of-range indices call llvm.trap; runtime execution remains BLOCKED_DEVICE.",
+        ],
+    }
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    report = build_report()
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print("validated {} gfx1036 C2 static LLVM artifacts".format(len(report["artifacts"])))
+
+
+if __name__ == "__main__":
+    main()
