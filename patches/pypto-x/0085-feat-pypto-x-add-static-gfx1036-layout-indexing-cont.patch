+def _emit_constant_c2(builder: _IRBuilder, operation: Operation, index: str) -> None:
+    output = operation.outputs[0]
+    dtype = canonical_dtype(output.type.dtype)
+    raw = operation.attributes.get("values", operation.attributes.get("value"))
