+        "split": (_program((_tensor("source", "float32", (2, 3)),), (_tensor("a", "float32", (2, 1)), _tensor("b", "float32", (2, 2))), "split", {"axis": 1, "sizes": [1, 2]}), {"segments": [[0, 1], [1, 2]]}),
