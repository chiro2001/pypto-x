+def _emit_copy_value_c2(builder: _IRBuilder, operation: Operation, index: str) -> None:
+    source, output = operation.inputs[0], operation.outputs[0]
+    dtype = canonical_dtype(source.type.dtype)
+    value = _emit_load_value(builder, "%arg0", index, dtype)
+    _emit_store_value(builder, "%arg{}".format(len(operation.inputs)), index, dtype, value)
+
+
+def _emit_binary_c2(builder: _IRBuilder, operation: Operation, index: str) -> None:
+    name = canonical_operation_name(operation.name)
+    dtype = canonical_dtype(operation.outputs[0].type.dtype)
+    output_shape = _value_shape(operation.outputs[0].type, "binary output")
+    left_shape = _value_shape(operation.inputs[0].type, "binary left")
+    right_shape = _value_shape(operation.inputs[1].type, "binary right")
+    left_index = _emit_broadcast_index(builder, index, left_shape, output_shape)
+    right_index = _emit_broadcast_index(builder, index, right_shape, output_shape)
+    left = _emit_load_f32(builder, "%arg0", left_index, dtype)
+    right = _emit_load_f32(builder, "%arg1", right_index, dtype)
+    result = builder.temp("result")
+    opcode = {"add": "fadd", "mul": "fmul", "sub": "fsub", "div": "fdiv"}[name]
+    builder.line("  {} = {} float {}, {}".format(result, opcode, left, right))
+    _emit_store_f32(builder, "%arg2", index, dtype, result)
+
+
+def _emit_neg_c2(builder: _IRBuilder, operation: Operation, index: str) -> None:
+    dtype = canonical_dtype(operation.outputs[0].type.dtype)
+    value = _emit_load_f32(builder, "%arg0", index, dtype)
+    result = builder.temp("neg")
+    builder.line("  {} = fneg float {}".format(result, value))
+    _emit_store_f32(builder, "%arg1", index, dtype, result)
+
+
+def _emit_cast_c2(builder: _IRBuilder, operation: Operation, index: str) -> None:
+    input_dtype = canonical_dtype(operation.inputs[0].type.dtype)
+    output_dtype = canonical_dtype(operation.outputs[0].type.dtype)
+    input_pointer = "%arg0"
+    output_pointer = "%arg1"
+    if input_dtype == output_dtype:
+        _emit_copy_value_c2(builder, operation, index)
+        return
+    if input_dtype in _C2_FLOAT_DTYPES and output_dtype in _C2_FLOAT_DTYPES:
+        value = _emit_load_f32(builder, input_pointer, index, input_dtype)
+        _emit_store_f32(builder, output_pointer, index, output_dtype, value)
