+    output_shape = static_shape(output.type, "transpose output")
+    permutation = _c2_attrs_call(_m1b_permutation, input_shape, operation.attributes, context="transpose")
+    output_coords = _emit_coords(builder, index, output_shape)
+    input_coords = tuple(output_coords[axis] for axis in permutation)
+    source_index = _emit_ravel(builder, input_coords, input_shape)
+    dtype = canonical_dtype(source.type.dtype)
+    value = _emit_load_value(builder, "%arg0", source_index, dtype)
+    _emit_store_value(builder, "%arg1", index, dtype, value)
