+def _emit_coords(builder: _IRBuilder, index: str, shape: Sequence[int]) -> Tuple[str, ...]:
+    """Unravel a row-major flat index using O(rank) arithmetic."""
+
+    shape = tuple(int(value) for value in shape)
+    coordinates = []
+    strides = _contiguous_strides(shape)
+    for axis, (dimension, stride) in enumerate(zip(shape, strides)):
+        coordinate = builder.temp("coord")
+        if dimension <= 1 or stride == 0:
+            builder.line("  {} = add i64 0, 0".format(coordinate))
+            coordinates.append(coordinate)
+            continue
+        quotient = builder.temp("quot")
+        builder.line("  {} = udiv i64 {}, {}".format(quotient, index, stride))
+        builder.line("  {} = urem i64 {}, {}".format(coordinate, quotient, dimension))
+        coordinates.append(coordinate)
+    return tuple(coordinates)
+
+
+def _emit_ravel(builder: _IRBuilder, coordinates: Sequence[str], shape: Sequence[int]) -> str:
+    """Ravel coordinates with compile-time contiguous strides."""
+
+    result = builder.temp("flat")
+    builder.line("  {} = add i64 0, 0".format(result))
+    for coordinate, stride in zip(coordinates, _contiguous_strides(tuple(shape))):
+        if stride == 0:
+            continue
+        term = builder.temp("term")
+        builder.line("  {} = mul i64 {}, {}".format(term, coordinate, stride))
+        updated = builder.temp("flat")
+        builder.line("  {} = add i64 {}, {}".format(updated, result, term))
+        result = updated
+    return result
+
+
+def _emit_broadcast_index(
+    builder: _IRBuilder,
+    output_index: str,
+    source_shape: Sequence[int],
+    output_shape: Sequence[int],
+) -> str:
+    """Map one output index to a right-aligned broadcast input index."""
+
+    source_shape = tuple(int(value) for value in source_shape)
+    output_shape = tuple(int(value) for value in output_shape)
+    if not source_shape:
+        return "0"
+    output_coords = _emit_coords(builder, output_index, output_shape)
+    delta = len(output_shape) - len(source_shape)
+    source_coords = tuple(
+        "0" if dimension == 1 else output_coords[axis + delta]
+        for axis, dimension in enumerate(source_shape)
+    )
+    return _emit_ravel(builder, source_coords, source_shape)
+
