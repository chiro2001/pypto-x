+"""C2 AMDGPU gfx1036 static layout/indexing/control contract tests.
+
+These tests deliberately stop at LLVM/ELF static evidence.  The GamePC WSL
+environment still has no Linux HIP device, so no numeric device execution is
+claimed here.
+"""
+
+from __future__ import annotations
+
+import json
+import hashlib
+
+import pytest
+
+from pypto.compiler.targets.hip import (
+    AMDGPU_LOWERING_VERSION,
+    AMDGPU_STATIC_SUPPORTED_OPERATIONS,
+    AmdgpuStaticCompiler,
+    AmdgpuArtifactError,
+    AmdgpuUnsupportedError,
+    decode_amdgpu_artifact,
+    render_amdgcn_llvm,
+)
+from pypto.compiler import Artifact
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import AMD_IGPU_GFX1036
+
+
+def _program(inputs, outputs, operation_name, attributes=None):
+    operation = Operation(operation_name, tuple(inputs), tuple(outputs), attributes=attributes or {})
+    return CoreProgram(
+        functions=(CoreFunction("main", tuple(inputs), tuple(outputs), Region((operation,))),)
+    )
+
+
+def _compile(program):
+    compiler = AmdgpuStaticCompiler()
+    return compiler.compile(compiler.lower(program, AMD_IGPU_GFX1036))
+
+
+def _tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, shape))
+
+
+def test_c2_supported_set_is_explicit_and_versioned():
+    assert AMDGPU_LOWERING_VERSION == 2
+    assert {
+        "sub", "div", "neg", "cast", "constant", "reshape", "view", "contiguous",
+        "transpose", "broadcast", "slice", "concat", "split", "gather", "embedding",
+        "compare", "iota", "where",
+    }.issubset(set(AMDGPU_STATIC_SUPPORTED_OPERATIONS))
+
+
+@pytest.mark.parametrize("name", ("sub", "div", "neg"))
+def test_c2_exact_shape_float_arithmetic_emits_real_alu(name):
+    value_type = CoreType.tensor("float32", (7,))
