+
+
+def _tensor(name, dtype, shape):
+    return ValueRef(name, CoreType.tensor(dtype, shape))
+
+
+def _program(inputs, outputs, name, attributes=None):
+    operation = Operation(name, tuple(inputs), tuple(outputs), attributes=attributes or {})
+    return CoreProgram(
+        functions=(CoreFunction("main", tuple(inputs), tuple(outputs), Region((operation,))),)
+    )
+
+
+def _cases():
+    f32_5 = lambda name: _tensor(name, "float32", (5,))
+    source = _tensor("source", "float32", (2, 3, 4))
+    return {
+        "sub": (_program((f32_5("left"), f32_5("right")), (f32_5("output"),), "sub"), {"golden": [-1.0] * 5}),
+        "div": (_program((f32_5("left"), f32_5("right")), (f32_5("output"),), "div"), {"golden": [0.5] * 5}),
+        "neg": (_program((f32_5("source"),), (f32_5("output"),), "neg"), {"golden": [-1.0, 0.0, 1.0, 2.0, 3.0]}),
+        "cast": (_program((_tensor("source", "bf16", (5,)),), (_tensor("output", "float32", (5,)),), "cast", {"dtype": "float32"}), {"bf16_rne": True}),
+        "reshape": (_program((_tensor("source", "float32", (2, 3)),), (_tensor("output", "float32", (3, 2)),), "reshape", {"shape": [3, 2]}), {"flat_map": [0, 1, 2, 3, 4, 5]}),
+        "view": (_program((_tensor("source", "float32", (2, 3)),), (_tensor("output", "float32", (3, 2)),), "view", {"shape": [3, 2]}), {"flat_map": [0, 1, 2, 3, 4, 5]}),
+        "contiguous": (_program((_tensor("source", "float32", (2, 3)),), (_tensor("output", "float32", (2, 3)),), "contiguous"), {"flat_map": [0, 1, 2, 3, 4, 5]}),
+        "transpose": (_program((source,), (_tensor("output", "float32", (4, 2, 3)),), "transpose", {"permutation": [2, 0, 1]}), {"source_flat_for_output_0": 0, "source_flat_for_output_1": 4, "source_flat_for_output_2": 8}),
+        "broadcast": (_program((_tensor("source", "float32", (2, 1)),), (_tensor("output", "float32", (2, 3)),), "broadcast", {"shape": [2, 3]}), {"source_flat_for_output": [0, 0, 0, 1, 1, 1]}),
+        "slice": (_program((_tensor("source", "float32", (2, 5)),), (_tensor("output", "float32", (2, 2)),), "slice", {"starts": [1], "stops": [5], "axes": [1], "steps": [2]}), {"source_flat_for_output": [1, 3, 6, 8]}),
