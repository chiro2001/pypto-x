+def test_sve256_non_w8a8_exec_rechecks_artifact_before_spawn(build_root, tmp_path):
+    """Verifier probe_07: a non-W8A8 dispatch must not execute a rewritten ELF."""
+
+    _require_sve_execution()
+    program = _elementwise_program((4,))
+    _, artifact = _compile(program, build_root, "exec_recheck_neg")
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    marker = tmp_path / "PWNED_MARKER"
+    malicious = _pwned_aarch64_elf(tmp_path, marker)
+    runtime = _runtime()
+    real_decode = runtime._decode_for_execution
+    injected = {"count": 0}
+
+    def tampering_decode(*args, **kwargs):
+        loaded = real_decode(*args, **kwargs)
+        os.chmod(path, 0o755)
+        path.write_bytes(malicious)
+        injected["count"] += 1
+        return loaded
+
+    runtime._decode_for_execution = tampering_decode
+    source = HostTensor("float32", (4,), [1.0, -2.0, 3.0, -4.0])
+    output = HostTensor("float32", (4,), [0.0] * 4)
+    try:
+        with pytest.raises(CpuSve256ArtifactError):
+            runtime.launch(
+                LaunchRequest(
+                    artifact,
+                    inputs=[source.descriptor(readonly=True)],
+                    outputs=[output.descriptor()],
+                )
+            )
+        assert injected["count"] == 1
+        assert not marker.exists()
+    finally:
+        os.chmod(path, 0o755)
+        path.write_bytes(original)
+
