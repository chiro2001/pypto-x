+def test_sve256_w8a8_memo_hit_sparse_append_is_bounded(tmp_path):
+    """A sparse 1 GiB append under RLIMIT_AS must still be a canonical error."""
+
+    _require_sve_execution()
+    tree = Path(__file__).resolve().parents[4]
+    assert (tree / "python" / "pypto").is_dir(), tree
+    work = tmp_path / "sparse_probe"
+    code = (
+        "import os, resource, sys\n"
+        "from pathlib import Path\n"
+        "TREE = {tree!r}\n"
+        "sys.path.insert(0, TREE + '/python')\n"
+        "sys.path.insert(0, TREE + '/python/tests/ut')\n"
+        "sys.path.insert(0, TREE + '/python/tests/ut/pypto_x')\n"
+        "os.environ.setdefault('PYPTO_X_PORTABLE_ONLY', '1')\n"
+        "os.environ.setdefault('PYPTO_X_SVE_TEST_MODE', 'qemu')\n"
+        "import test_w8a8_sve256 as helpers\n"
+        "from pypto.backends.cpu.aarch64 import CpuSve256ArtifactError\n"
+        "work = Path({work!r})\n"
+        "work.mkdir(parents=True, exist_ok=True)\n"
+        "program, _ = helpers._qmatmul_program((1, 2), (2, 1))\n"
+        "_, artifact = helpers._compile(program, work, 'sparse')\n"
+        "path = Path(artifact.path)\n"
+        "original = path.read_bytes()\n"
+        "runtime = helpers._runtime()\n"
+        "runtime._load_w8a8(artifact)\n"
+        "os.chmod(path, 0o755)\n"
+        "os.truncate(path, 1 << 30)\n"
+        "soft, hard = resource.getrlimit(resource.RLIMIT_AS)\n"
+        "resource.setrlimit(resource.RLIMIT_AS, (256 << 20, hard))\n"
+        "caught = None\n"
+        "try:\n"
+        "    runtime._load_w8a8(artifact)\n"
+        "except BaseException as exc:\n"
+        "    caught = exc\n"
+        "finally:\n"
+        "    resource.setrlimit(resource.RLIMIT_AS, (soft, hard))\n"
+        "memo_len = len(runtime._w8a8_loaded)\n"
+        "os.chmod(path, 0o644)\n"
+        "os.truncate(path, 0)\n"
+        "path.write_bytes(original)\n"
+        "ok = isinstance(caught, CpuSve256ArtifactError) and memo_len == 0\n"
+        "print('OK' if ok else 'FAIL', type(caught).__name__, memo_len, str(caught)[:200])\n"
+        "sys.exit(0 if ok else 3)\n"
+    ).format(tree=str(tree), work=str(work))
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=600,
+        check=False,
+    )
+    assert result.returncode == 0, result.stdout.decode("utf-8", "replace") + result.stderr.decode(
+        "utf-8", "replace"
+    )
+    assert "OK" in result.stdout.decode("utf-8", "replace")
+
+
+def test_sve256_w8a8_memo_hit_wraps_reader_memoryerror(build_root, monkeypatch):
+    """An injected allocation failure in the re-read is canonical, not raw."""
+
+    _require_sve_execution()
+    import pypto.backends.cpu.aarch64.sve256 as sve_module
+
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_memerror")
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)  # warm with a real read
+
+    def boom(fd, buffers):
+        raise MemoryError("injected read allocation failure")
+
+    monkeypatch.setattr(sve_module.os, "readv", boom)
+    with pytest.raises(CpuSve256ArtifactError):
+        runtime._load_w8a8(artifact)
+    assert id(artifact) not in runtime._w8a8_loaded
+
