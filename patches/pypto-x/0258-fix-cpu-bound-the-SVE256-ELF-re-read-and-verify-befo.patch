+def _pwned_aarch64_elf(tmp_path, marker):
+    """Compile a static AArch64 ELF that marks the box if it is executed."""
+
+    source = tmp_path / "pwned.c"
+    source.write_text(
+        "#include <stdio.h>\n"
+        "int main(void){\n"
+        "  FILE *f = fopen(\"@MARKER@\", \"w\");\n"
+        "  if (f) { fputs(\"PWNED\", f); fclose(f); }\n"
+        "  fputs(\"PWNED-ELF\\n\", stderr);\n"
+        "  return 0;\n"
+        "}\n".replace("@MARKER@", str(marker)),
+        encoding="utf-8",
+    )
+    target = tmp_path / "pwned.elf"
+    result = subprocess.run(
+        ["aarch64-linux-gnu-gcc", "-static", "-O2", str(source), "-o", str(target)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    if result.returncode != 0 or not target.is_file():
+        pytest.skip("cross gcc cannot build the malicious ELF")
+    return target.read_bytes()
+
+
+def test_sve256_w8a8_memo_hit_rejects_unreadable_file(build_root):
+    """EACCES on the memo re-read is canonical and drops the entry."""
+
+    _require_sve_execution()
+    if os.geteuid() == 0:
+        pytest.skip("root ignores mode 000")
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_unreadable")
+    path = Path(artifact.path)
+    original_mode = path.stat().st_mode & 0o7777
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)
+
+    os.chmod(path, 0o000)
+    try:
+        with pytest.raises(CpuSve256ArtifactError):
+            runtime._load_w8a8(artifact)
+        assert id(artifact) not in runtime._w8a8_loaded
+    finally:
+        os.chmod(path, original_mode)
+
+
+def test_sve256_w8a8_memo_hit_rejects_directory_replacement(build_root):
+    """A directory at the artifact path is not a regular ELF and fails closed."""
+
+    _require_sve_execution()
+    program, _ = _qmatmul_program((1, 2), (2, 1))
+    _, artifact = _compile(program, build_root, "qm_memo_directory")
+    path = Path(artifact.path)
+    original = path.read_bytes()
+    runtime = _runtime()
+    runtime._load_w8a8(artifact)
+
+    path.unlink()
+    path.mkdir()
+    try:
+        with pytest.raises(CpuSve256ArtifactError):
+            runtime._load_w8a8(artifact)
+        assert id(artifact) not in runtime._w8a8_loaded
+    finally:
+        path.rmdir()
+        path.write_bytes(original)
+
+
