+"""PyPTO-X vLLM CPU plugin package (W8J J2).
+
+This package is *not* installed into vLLM's site-packages.  It is delivered as
+a self-contained distribution directory (``python/pypto_x_vllm-*.dist-info``)
+so that adding the worktree ``python`` directory to ``PYTHONPATH`` is enough
+for vLLM's ``vllm.general_plugins`` entry-point discovery (vLLM 0.29.0 uses
+``importlib.metadata.entry_points(group=...)``, which scans every ``sys.path``
+entry).  Removing the directory from ``PYTHONPATH`` uninstalls the plugin with
+no side effects on the vLLM source tree or site-packages.
+
+See :mod:`pypto_x_vllm.plugin` for the registered quantization config and the
+per-shape performance gate.
+"""
+
+from __future__ import annotations
+
+__all__ = ["gate_table", "plugin"]
