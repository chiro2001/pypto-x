--- /dev/null
+++ b/python/pypto_x_vllm/plugin.py
@@ -0,0 +1,404 @@
+"""vLLM CPU general plugin: PyPTO-X packed AVX-512 dense Linear (W8J J2).
+
+Loading channel
+---------------
+``vllm.general_plugins`` entry point (``pypto_x = "pypto_x_vllm.plugin:register"``).
+vLLM 0.29.0 calls ``load_general_plugins()`` in the driver, the EngineCore
+process and every worker, so ``register()`` must be idempotent and every class
+it exposes must be defined at *module* level (J0 measured that defining the
+quantization config inside ``register()`` makes the spawned worker fail with
+``AttributeError: Can't get local object`` while unpickling ``VllmConfig``).
+
+Mechanism
+---------
+``PyPTOXQuantConfig(QuantizationConfig)`` + ``PyPTOXLinearMethod``
+(``LinearMethodBase``) intercept only ``LinearBase`` layers that pass
+``--quantization pypto_x``:
+
+* ``process_weights_after_loading``: 2-D weights are pre-packed once with
+  ``torch.ops.pypto_x.pack_weight`` (W8B 64x64 tile layout) and the handle is
+  cached on the layer.  3-D weights (GDN conv1d) are handed back to the stock
+  ``UnquantizedLinearMethod`` so vLLM's causal-conv packing is untouched.
+* ``apply``: only shapes enabled by the measured gate table are injected
+  (``torch.ops.pypto_x.linear_prepacked``); everything else -- unknown shape,
+  disabled shape, unsupported dtype/rank/device, pack failure, kernel error --
+  falls back to ``torch.nn.functional.linear`` on the still-live BF16 weight.
+* ``get_quant_method`` returns ``None`` for non-Linear layers (Attention,
+  embeddings, GDN core), matching the verified J0 injection probe.
+
+The generated table lives in :mod:`pypto_x_vllm.gate_table`.  Every decision is
+appended to ``$PYPTO_X_VLLM_LOG`` as one JSON line so the evidence driver can
+aggregate per-prefix injection/fallback coverage and reasons.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+from typing import Any, Dict, Optional
+
+import torch
+import torch.nn.functional as F
+
+from vllm.model_executor.layers.linear import LinearBase, UnquantizedLinearMethod
+from vllm.model_executor.layers.quantization import register_quantization_config
+from vllm.model_executor.layers.quantization.base_config import QuantizationConfig
+
+from . import gate_table
+
+QUANTIZATION_NAME = "pypto_x"
+_LOG_ENV = "PYPTO_X_VLLM_LOG"
+_GATE_JSON_ENV = "PYPTO_X_VLLM_GATE_JSON"
+_ENABLE_ENV = "PYPTO_X_VLLM_ENABLE"
+
+_REGISTER_LOCK = threading.RLock()
+_REGISTERED = False
+_TABLE: Optional[Dict[str, Any]] = None
+_TABLE_SOURCE = "embedded"
+_STATS_LOCK = threading.Lock()
+_STATS: Dict[str, int] = {}
+
+
+def _log_path() -> str:
+    return os.environ.get(_LOG_ENV, "")
+
+
+def _log(record: Dict[str, Any]) -> None:
+    """Append one JSON line (single O_APPEND write; safe across processes)."""
+
+    path = _log_path()
+    if not path:
+        return
+    try:
+        record = dict(record)
+        record.setdefault("pid", os.getpid())
+        record.setdefault("time", time.time())
+        line = (json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n").encode("utf-8")
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
+        try:
+            os.write(fd, line)
+        finally:
+            os.close(fd)
+    except Exception:
+        # never break the model run because of logging
+        pass
+
+
+def _count(key: str) -> None:
+    with _STATS_LOCK:
+        _STATS[key] = _STATS.get(key, 0) + 1
+
+
+def stats() -> Dict[str, int]:
+    with _STATS_LOCK:
+        return dict(_STATS)
+
+
+def _injection_enabled() -> bool:
+    value = os.environ.get(_ENABLE_ENV, "1").strip().lower()
+    return value not in ("0", "false", "no", "off")
+
+
+def _table_from_json(path: str) -> Dict[str, Any]:
+    """Load an external audit rendering of the gate table.
+
+    JSON keys are ``"<dtype>|<m>|<k>|<n>"``; values are the same row mappings
+    as the embedded table.  A malformed row is ignored (fail-open).
+    """
+
+    with open(path, "r", encoding="utf-8") as handle:
+        raw = json.load(handle)
+    rows = raw.get("gate_table", raw)
+    table: Dict[str, Any] = {}
+    for key, row in rows.items():
+        parts = str(key).split("|")
+        if len(parts) != 4:
+            continue
+        dtype, m, k, n = parts[0], parts[1], parts[2], parts[3]
+        try:
+            table.setdefault(dtype, {}).setdefault(int(m), {}).setdefault(int(k), {})[
+                int(n)
+            ] = dict(row)
+        except (TypeError, ValueError):
+            continue
+    return table
+
+
+def _gate_table() -> Dict[str, Any]:
+    global _TABLE, _TABLE_SOURCE
+    if _TABLE is None:
+        override = os.environ.get(_GATE_JSON_ENV, "").strip()
+        if override:
+            try:
+                _TABLE = _table_from_json(override)
+                _TABLE_SOURCE = "json:" + override
+            except Exception as exc:  # fail-open: an unreadable override disables injection
+                _TABLE = {}
+                _TABLE_SOURCE = "json_error:{}:{}".format(type(exc).__name__, exc)
+        else:
+            _TABLE = gate_table.GATE_TABLE
+            _TABLE_SOURCE = "embedded"
+    return _TABLE
+
+
+def _gate_row(dtype: str, m: int, k: int, n: int) -> Optional[Dict[str, Any]]:
+    if not _injection_enabled():
+        return None
+    table = _gate_table()
+    per_dtype = table.get(dtype)
+    if not per_dtype:
+        return None
+    per_k = per_dtype.get(int(m), {}).get(int(k))
+    if not per_k:
+        return None
+    return per_k.get(int(n))
+
+
+def _fallback(layer: Any, x: torch.Tensor, bias: Optional[torch.Tensor]) -> torch.Tensor:
+    return F.linear(x, layer.weight, bias)
+
+
+class _GateMiss(Exception):
+    """Internal signal: not a kernel failure, just not enabled for this shape."""
+
+
+class PyPTOXLinearMethod(UnquantizedLinearMethod):
+    """Unquantized-weight linear method whose ``apply`` is the PyPTO-X seat."""
+
+    def __init__(self, prefix: str) -> None:
+        super().__init__()
+        self.prefix = prefix
+
+    # -- weight preparation -------------------------------------------
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        weight = getattr(layer, "weight", None)
+        if weight is None:
+            return
+        if getattr(weight, "is_meta", False):
+            layer._pypto_x_packed = None
+            layer._pypto_x_pack_error = "meta_weight"
+            _log({"event": "pack_skip", "prefix": self.prefix, "reason": "meta_weight"})
+            return
+        if weight.ndim != 2:
+            # GDN conv1d (3-D) and friends keep vLLM's stock CPU packing.
+            super().process_weights_after_loading(layer)
+            _log(
+                {
+                    "event": "pack_skip",
+                    "prefix": self.prefix,
+                    "reason": "non_2d_weight",
+                    "weight_shape": list(weight.shape),
+                }
+            )
+            return
+        try:
+            if weight.dtype not in (torch.bfloat16, torch.float32):
+                raise ValueError("unsupported dtype {}".format(weight.dtype))
+            handle = torch.ops.pypto_x.pack_weight(weight.detach())
+            layer._pypto_x_packed = handle
+            layer._pypto_x_pack_error = None
+            _count("pack_ok")
+            _log(
+                {
+                    "event": "pack_ok",
+                    "prefix": self.prefix,
+                    "weight_shape": list(weight.shape),
+                    "handle_bytes": int(handle.numel()),
+                    "dtype": str(weight.dtype),
+                    "gate_table_version": gate_table.GATE_TABLE_VERSION,
+                    "gate_table_source": _TABLE_SOURCE,
+                }
+            )
+        except Exception as exc:
+            layer._pypto_x_packed = None
+            layer._pypto_x_pack_error = "{}: {}".format(type(exc).__name__, exc)
+            _count("pack_failed")
+            _log(
+                {
+                    "event": "pack_failed",
+                    "prefix": self.prefix,
+                    "reason": type(exc).__name__,
+                    "error": str(exc)[:300],
+                    "weight_shape": list(weight.shape),
+                }
+            )
+
+    # -- execution -----------------------------------------------------
+    def apply(
+        self,
+        layer: torch.nn.Module,
+        x: torch.Tensor,
+        bias: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        packed = getattr(layer, "_pypto_x_packed", None)
+        if packed is None:
+            reason = getattr(layer, "_pypto_x_pack_error", None) or "no_packed_weight"
+            _count("fallback_no_packed")
+            _log(
+                {
+                    "event": "apply_fallback",
+                    "prefix": self.prefix,
+                    "reason": "no_packed_weight",
+                    "detail": str(reason)[:200],
+                }
+            )
+            return _fallback(layer, x, bias)
+        try:
+            if x.dim() != 2:
+                raise _GateMiss("rank_{}".format(x.dim()))
+            if x.device.type != "cpu":
+                raise _GateMiss("device_{}".format(x.device.type))
+            if x.dtype not in (torch.bfloat16, torch.float32):
+                raise _GateMiss("dtype_{}".format(str(x.dtype)))
+            m, k = int(x.shape[0]), int(x.shape[1])
+            n = int(layer.weight.shape[0])
+            row = _gate_row(str(x.dtype), m, k, n)
+            if row is None:
+                raise _GateMiss("shape_not_enabled")
+            if not row.get("enabled", False):
+                raise _GateMiss("shape_disabled")
+            out = torch.ops.pypto_x.linear_prepacked(x, packed, bias)
+            _count("inject")
+            _log(
+                {
+                    "event": "apply_inject",
+                    "prefix": self.prefix,
+                    "m": m,
+                    "k": k,
+                    "n": n,
+                    "dtype": str(x.dtype),
+                    "ratio": row.get("ratio"),
+                    "gate_table_version": gate_table.GATE_TABLE_VERSION,
+                }
+            )
+            return out
+        except _GateMiss as miss:
+            _count("fallback_gate")
+            _log(
+                {
+                    "event": "apply_fallback",
+                    "prefix": self.prefix,
+                    "reason": str(miss),
+                    "m": int(x.shape[0]) if x.dim() >= 1 else None,
+                    "k": int(x.shape[-1]) if x.dim() >= 1 else None,
+                    "n": int(layer.weight.shape[0]),
+                    "dtype": str(x.dtype),
+                }
+            )
+            return _fallback(layer, x, bias)
+        except Exception as exc:
+            # Fail-open on any kernel/runtime error: the raw BF16 weight is
+            # still live, so F.linear is semantically exact.
+            _count("fallback_error")
+            _log(
+                {
+                    "event": "apply_fallback",
+                    "prefix": self.prefix,
+                    "reason": "kernel_error",
+                    "error_type": type(exc).__name__,
+                    "error": str(exc)[:300],
+                    "m": int(x.shape[0]) if x.dim() >= 1 else None,
+                    "k": int(x.shape[-1]) if x.dim() >= 1 else None,
+                    "n": int(layer.weight.shape[0]),
+                    "dtype": str(x.dtype),
+                }
+            )
+            return _fallback(layer, x, bias)
+
+
+class PyPTOXQuantConfig(QuantizationConfig):
+    """Quantization config used purely as the dense-Linear injection seat."""
+
+    def __init__(self) -> None:
+        super().__init__()
+
+    def get_name(self):
+        return QUANTIZATION_NAME
+
+    def get_supported_act_dtypes(self):
+        return [torch.bfloat16, torch.float32]
+
+    @classmethod
+    def get_min_capability(cls) -> int:
+        return 0
+
+    @staticmethod
+    def get_config_filenames():
+        return []
+
+    @classmethod
+    def from_config(cls, config):
+        return cls()
+
+    def get_quant_method(self, layer: torch.nn.Module, prefix: str):
+        if isinstance(layer, LinearBase):
+            return PyPTOXLinearMethod(prefix)
+        return None
+
+
+def _ensure_pypto_seam() -> str:
+    """Make ``pypto.framework`` importable from the worktree source tree.
+
+    The repository's ``python/pypto/__init__.py`` is the online-build bootstrap
+    (it needs installed wheel metadata); J1/J2 use the documented torch-suite
+    seam instead: a stub ``pypto`` module whose ``__path__`` points at the
+    source package, so submodules import without executing the bootstrap.
+    Returns the resolved package root for the evidence log.
+    """
+
+    import sys
+    import types
+    from pathlib import Path
+
+    root = Path(__file__).resolve().parents[1] / "pypto"
+    existing = sys.modules.get("pypto")
+    if existing is None:
+        package = types.ModuleType("pypto")
+        package.__path__ = [str(root)]
+        sys.modules["pypto"] = package
+    return str(root)
+
+
+def register() -> None:
+    """``vllm.general_plugins`` entry point; idempotent, per process."""
+
+    global _REGISTERED
+    with _REGISTER_LOCK:
+        if _REGISTERED:
+            return
+        pypto_root = _ensure_pypto_seam()
+        # The measured gate table assumes the same 6-thread packed GEMM as the
+        # vLLM CPU baseline.  ``PYPTO_X_VLLM_GEMM_THREADS`` overrides the
+        # plugin default; an explicit PYPTO_X_AVX512_GEMM_THREADS always wins.
+        os.environ.setdefault(
+            "PYPTO_X_AVX512_GEMM_THREADS",
+            os.environ.get("PYPTO_X_VLLM_GEMM_THREADS", "6"),
+        )
+        import pypto.framework as framework
+
+        framework.register_torch_ops()
+        register_quantization_config(QUANTIZATION_NAME)(PyPTOXQuantConfig)
+        _REGISTERED = True
+        table = _gate_table()
+        _log(
+            {
+                "event": "plugin_register",
+                "quantization": QUANTIZATION_NAME,
+                "torch": torch.__version__,
+                "gate_table_version": gate_table.GATE_TABLE_VERSION,
+                "gate_table_source": _TABLE_SOURCE,
+                "gate_dtypes": sorted(table),
+                "pypto_root": pypto_root,
+            }
+        )
+
+
+__all__ = [
+    "PyPTOXLinearMethod",
+    "PyPTOXQuantConfig",
+    "QUANTIZATION_NAME",
+    "register",
+    "stats",
+]
