+"""Focused tests for the W8J J2 vLLM CPU plugin (no model load).
+
+These tests exercise the injection seat itself: registration, gate routing,
+fail-open fallback and 3-D weight handover.  They run in the dedicated
+``pypto-x-w8j`` environment (vLLM CPU 0.29.0 + torch 2.13.0+cpu).
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+import types
+from unittest import mock
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+PYTHON_ROOT = Path(__file__).resolve().parents[2]
+if str(PYTHON_ROOT) not in sys.path:
+    sys.path.insert(0, str(PYTHON_ROOT))
+if "pypto" not in sys.modules:
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(PYTHON_ROOT / "pypto")]
+    sys.modules["pypto"] = package
+
+import pypto_x_vllm.plugin as plugin  # noqa: E402
+from pypto.framework import torch_ops  # noqa: E402
+from pypto.framework.linear_kernel import LinearKernelCache, reset_linear_kernel_cache  # noqa: E402
+
+
+plugin.register()
+plugin.register()
+torch_ops.register()
+
+
+@pytest.fixture()
+def fresh_caches(tmp_path, monkeypatch):
+    cache = LinearKernelCache(cache_dir=tmp_path / "kernel-cache", disk_cache=True)
+    reset_linear_kernel_cache(cache)
+    torch_ops.reset_weight_pack_cache()
+    torch_ops.reset_fallback_stats()
+    yield cache
+    reset_linear_kernel_cache(LinearKernelCache(cache_dir=tmp_path / "kernel-cache", disk_cache=True))
+    torch_ops.reset_weight_pack_cache()
+    torch_ops.reset_fallback_stats()
+
+
+class _DummyLayer(torch.nn.Module):
+    def __init__(self, weight):
+        super().__init__()
+        self.weight = torch.nn.Parameter(weight, requires_grad=False)
+
+
+def _method(prefix="language_model.model.layers.0.mlp.gate_up_proj"):
+    return plugin.PyPTOXLinearMethod(prefix)
+
+
+def test_quant_config_only_targets_linear_layers():
+    from vllm.model_executor.layers.linear import LinearBase
+
+    config = plugin.PyPTOXQuantConfig()
+    assert config.get_name() == "pypto_x"
+    assert config.get_quant_method(torch.nn.Linear(4, 4), "x") is None
+    assert config.get_quant_method(torch.nn.Embedding(4, 4), "x") is None
+    linear_like = mock.Mock(spec=LinearBase)
+    method = config.get_quant_method(linear_like, "language_model.model.layers.0.mlp.down_proj")
+    assert isinstance(method, plugin.PyPTOXLinearMethod)
+    assert method.prefix == "language_model.model.layers.0.mlp.down_proj"
+
+
+def test_process_weights_after_loading_packs_2d_weight(fresh_caches):
+    weight = torch.randn(3584, 1024, dtype=torch.bfloat16)
+    layer = _DummyLayer(weight)
+    _method().process_weights_after_loading(layer)
+    handle = layer._pypto_x_packed
+    assert isinstance(handle, torch.Tensor)
+    assert handle.dtype == torch.uint8
+    assert handle.numel() > weight.numel()
+    assert layer._pypto_x_pack_error is None
+
+
+def test_apply_injects_only_enabled_shapes(fresh_caches, monkeypatch):
+    m, k, n = 2, 64, 130
+    weight = torch.randn(n, k, dtype=torch.bfloat16)
+    x = torch.randn(m, k, dtype=torch.bfloat16)
+    layer = _DummyLayer(weight)
+    method = _method()
+    method.process_weights_after_loading(layer)
+    reference = torch.ops.pypto_x.linear(x, weight)
+
+    monkeypatch.setattr(plugin, "_TABLE", {})
+    before = plugin.stats().get("inject", 0)
+    out = method.apply(layer, x, None)
+    assert torch.equal(out, F.linear(x, weight))
+    assert plugin.stats().get("inject", 0) == before
+
+    monkeypatch.setattr(
+        plugin,
+        "_TABLE",
+        {"torch.bfloat16": {m: {k: {n: {"enabled": True, "ratio": 0.5}}}}},
+    )
+    out = method.apply(layer, x, None)
+    assert plugin.stats().get("inject", 0) == before + 1
+    assert torch.equal(out, reference)
+    # the injected output must be the packed-plane kernel, not F.linear
+    assert torch.equal(out, torch.ops.pypto_x.linear_prepacked(x, layer._pypto_x_packed))
+
+
+def test_apply_fails_open_on_a_corrupt_handle(fresh_caches, monkeypatch):
+    weight = torch.randn(16, 8, dtype=torch.bfloat16)
+    x = torch.randn(2, 8, dtype=torch.bfloat16)
+    layer = _DummyLayer(weight)
+    method = _method()
+    layer._pypto_x_packed = torch.zeros(8, dtype=torch.uint8)
+    monkeypatch.setattr(
+        plugin,
+        "_TABLE",
+        {"torch.bfloat16": {2: {8: {16: {"enabled": True, "ratio": 0.5}}}}},
+    )
+    before = plugin.stats().get("fallback_error", 0)
+    out = method.apply(layer, x, None)
+    assert torch.equal(out, F.linear(x, weight))
+    assert plugin.stats().get("fallback_error", 0) == before + 1
+
+
+def test_rank3_weight_goes_back_to_the_parent_method(fresh_caches, monkeypatch):
+    weight = torch.randn(5120, 4, 4, dtype=torch.bfloat16)
+    layer = _DummyLayer(weight)
+    called = {"parent": 0}
+
+    def fake_parent(self, target_layer):
+        called["parent"] += 1
+
+    monkeypatch.setattr(plugin.UnquantizedLinearMethod, "process_weights_after_loading", fake_parent)
+    _method().process_weights_after_loading(layer)
+    assert called["parent"] == 1
+    assert not hasattr(layer, "_pypto_x_packed")
+
+
+def test_gate_json_override_and_injection_switch(monkeypatch, tmp_path):
+    table = tmp_path / "gate.json"
+    table.write_text(
+        json.dumps({"gate_table": {"torch.bfloat16|1|8|16": {"enabled": True, "ratio": 0.9}}}),
+        encoding="utf-8",
+    )
+    monkeypatch.setenv(plugin._GATE_JSON_ENV, str(table))
+    monkeypatch.setattr(plugin, "_TABLE", None)
+    row = plugin._gate_row("torch.bfloat16", 1, 8, 16)
+    assert row == {"enabled": True, "ratio": 0.9}
+    monkeypatch.setenv(plugin._ENABLE_ENV, "0")
+    assert plugin._gate_row("torch.bfloat16", 1, 8, 16) is None
+    monkeypatch.delenv(plugin._ENABLE_ENV)
+    monkeypatch.delenv(plugin._GATE_JSON_ENV)
+    monkeypatch.setattr(plugin, "_TABLE", None)
