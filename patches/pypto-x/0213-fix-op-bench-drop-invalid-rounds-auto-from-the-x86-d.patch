From 4e713f0cc8b350cde3e6b7792d02ad789fa0b986 Mon Sep 17 00:00:00 2001
From: op-bench-framework <op-bench-framework@pypto-x.local>
Date: Sat, 12 Sep 2026 04:47:27 +0800
Subject: [PATCH 213/217] fix(op-bench): drop invalid '--rounds auto' from the
 x86 driver (auto is the default)

---
 scripts/perf/op_bench_x86_run.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/perf/op_bench_x86_run.sh b/scripts/perf/op_bench_x86_run.sh
index 6224383dc..817159286 100755
--- a/scripts/perf/op_bench_x86_run.sh
+++ b/scripts/perf/op_bench_x86_run.sh
@@ -42,7 +42,7 @@ run_phase main \
         --suite all \
         --providers portable,vendor:aocl-lpgemm-bf16,vendor:aocl-lpgemm-f32 \
         --threads "$THREADS" --bind "$BIND" \
-        --rounds auto --case-budget-seconds 20 --min-rounds 3 --iters 100 --warmup 5 \
+        --case-budget-seconds 20 --min-rounds 3 --iters 100 --warmup 5 \
         --q8-vendor-matrix "$Q8_MATRIX" --q8-ratio-table "$Q8_TABLE" \
         --integration-tip "$INTEGRATION_TIP" --lock-log "$LOCK_LOG" \
         --tag q9-x86-model-boundary \
