+#: Buffer-backed containers whose elements are C values, never Python ``bool``.
+_BUFFER_BACKED_TYPES = (bytes, bytearray, memoryview, array, ctypes.Array)
 
 
 def _check_codes(values: Sequence[Any], label: str) -> "array":
@@ -718,15 +751,29 @@ def _check_codes(values: Sequence[Any], label: str) -> "array":
     ``array('b', values)`` performs the per-element type/range work in C
     (``__index__``; ``TypeError`` for floats/strings, ``OverflowError`` outside
     [-128, 127]) and yields exactly the buffer the GEMM consumes, so callers do
-    not pay a second Python-level pass over M*K + K*N elements.  The only
+    not pay a per-element Python pass over M*K + K*N elements.  The only
     in-range contract violation left is the reserved ``-128`` code, found with
     a single ``memchr`` over the converted bytes (an ``array('b')`` can never
-    hold a value above 127).  ``bool`` is an ``int`` subclass, so ``True`` /
-    ``False`` are accepted as their numeric codes 1 / 0; non-integer container
-    elements fall back to the strict per-element validator for its structured
-    ``code_not_integer`` / ``code_out_of_range`` errors.
+    hold a value above 127).
+
+    ``bool`` is an ``int`` subclass, so ``array('b')`` would silently
+    reinterpret ``True`` / ``False`` as codes 1 / 0.  That is exactly the
+    non-integer-code class this adapter refuses (round-1 semantics), so
+    list/tuple/unknown sequences get one C-level ``set(map(type, ...))`` pass
+    (~0.05 s per 8.4M elements) and any bool element is rejected through the
+    strict validator (``code_not_integer``, same field/index).  Buffer-backed
+    containers cannot carry Python bools and skip that pass; non-integer
+    container elements still fall back to the strict validator for their
+    structured ``code_not_integer`` / ``code_out_of_range`` errors.
     """
 
+    if isinstance(values, (list, tuple)):
+        if bool in set(map(type, values)):
+            _check_codes_strict(values, label)
+    elif not isinstance(values, _BUFFER_BACKED_TYPES):
+        values = tuple(values)
+        if bool in set(map(type, values)):
+            _check_codes_strict(values, label)
     try:
         codes = array("b", values)
     except (TypeError, ValueError, OverflowError):
