+def test_check_codes_refuses_python_bools_at_any_index():
+    """A bool is not a code: it must not be silently reinterpreted as 0/1."""
+
+    for bad in ([True], [False], [1, 2, True, 4], [2, False, 3], (True,)):
+        with pytest.raises(OpContractError) as excinfo:
+            _check_codes(bad, "left")
+        assert excinfo.value.reason == "code_not_integer", excinfo.value.to_dict()
+        assert excinfo.value.field == "request.left"
+    with pytest.raises(OpContractError) as excinfo:
+        _check_codes([2, False, 3], "right")
+    assert excinfo.value.reason == "code_not_integer"
+    assert excinfo.value.requested is False
+    assert "[1]" in str(excinfo.value)
+    # The strict fallback keeps the same semantics when called directly.
+    with pytest.raises(OpContractError) as excinfo:
+        _check_codes_strict([1, True], "left")
+    assert excinfo.value.reason == "code_not_integer"
+    assert excinfo.value.requested is True
+
+
+@requires_aocl
+@requires_int8_host
+def test_vendor_execution_refuses_an_injected_bool_without_writing_output():
+    """`.data` injection is the only way a bool can reach the adapter."""
+
+    left = _tensor((2, 4), seed=801)
+    right = _tensor((4, 2), seed=802)
+    policy = _vendor_policy()
+    plan = plan_qmatmul(left.shape, right.shape, policy).plan
+    poisoned = HostTensor("int8", (2, 4), [1, 2, 3, 4, 5, 6, 7, 8])
+    poisoned.data[0] = True
+    output = HostTensor("int32", (2, 2), [9] * 4)
+    with pytest.raises(OpContractError) as excinfo:
+        execute_qmatmul(poisoned, right, policy, output=output)
+    assert excinfo.value.reason == "code_not_integer"
+    assert excinfo.value.field == "request.left"
+    assert excinfo.value.requested is True
+    assert output.flat() == (9, 9, 9, 9)
+    provider = AoclLpgemmInt8Provider()
+    capability = _host_snapshot()
+    with pytest.raises(OpContractError):
+        provider.execute(plan, poisoned, right, output, capability)
+    assert output.flat() == (9, 9, 9, 9)
+
+
+def test_report_snapshot_kind_requires_measured_observations():
+    """Report-side symmetry with the plan: a snapshot must carry observations."""
+
+    left = _tensor((2, 8), seed=811)
+    right = _tensor((8, 2), seed=812)
+    _, report = execute_qmatmul(left, right, _portable_policy())
+    document = report.to_dict()
+    validate_report_schema(document)
+    for holder in ("guarantees", "resolved"):
+        envelope = document[holder]["exactness_envelope"]
+        assert envelope["deviation_bound_kind"] == "exact_contract_bound"
+        # A snapshot with observations and no bound is valid...
+        envelope["deviation_bound_kind"] = "measured_snapshot"
+        del envelope["deviation_bound_by_k"]
+    validate_report_schema(document)
+    # ... but without the observations it must fail closed, exactly like the plan.
+    for holder in ("guarantees", "resolved"):
+        del document[holder]["exactness_envelope"]["measured_deviation_by_k"]
+    with pytest.raises(ExecutionError) as excinfo:
+        validate_report_schema(document)
+    assert excinfo.value.code == "REPORT_SCHEMA_INVALID"
+    assert excinfo.value.reason == "report_field_missing"
+
+
+@requires_aocl
+@requires_int8_host
+def test_report_snapshot_without_measured_observations_is_refused_vendor():
+    """Same symmetry on the vendor int8 snapshot report."""
+
+    left = _tensor((2, 16), seed=821)
+    right = _tensor((16, 2), seed=822)
+    _, report = execute_qmatmul(left, right, _vendor_policy(max_threads=1))
+    document = report.to_dict()
+    validate_report_schema(document)
+    for holder in ("guarantees", "resolved"):
+        envelope = document[holder]["exactness_envelope"]
+        assert envelope["deviation_bound_kind"] == "measured_snapshot"
+        del envelope["measured_deviation_by_k"]
+    with pytest.raises(ExecutionError) as excinfo:
+        validate_report_schema(document)
+    assert excinfo.value.code == "REPORT_SCHEMA_INVALID"
+    assert excinfo.value.reason == "report_field_missing"
+
