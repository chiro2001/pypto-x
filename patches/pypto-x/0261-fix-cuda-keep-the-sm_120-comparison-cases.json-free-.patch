From ac86bce53629ee7e974225593423c7d8a23de71e Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sun, 13 Sep 2026 12:24:31 +0800
Subject: [PATCH 261/269] fix(cuda): keep the sm_120 comparison cases.json free
 of 67 MiB blobs

The 4096^3 perf cases derive their all-ones expected output analytically at
run time; embedding it in cases.json made the evidence file ~90 MiB.  Only
the small correctness cases keep their expected bytes.
---
 scripts/smoke/cuda_sm120_compare.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/scripts/smoke/cuda_sm120_compare.py b/scripts/smoke/cuda_sm120_compare.py
index 1be708d06..75abe5671 100644
--- a/scripts/smoke/cuda_sm120_compare.py
+++ b/scripts/smoke/cuda_sm120_compare.py
@@ -168,7 +168,12 @@ def prepare(out_dir: Path, allow_missing_ptxas: bool = False):
         entry["packed"] = {
             "left": base64.b64encode(spec["left"]).decode() if spec["left"] else None,
             "right": base64.b64encode(spec["right"]).decode() if spec["right"] else None,
-            "expected": base64.b64encode(spec["expected"]).decode(),
+            # The 4096^3 perf cases use all-ones inputs and derive the expected
+            # output analytically at run time; embedding a 67 MiB base64 blob
+            # would make cases.json unusable as evidence.
+            "expected": (
+                base64.b64encode(spec["expected"]).decode() if not spec.get("ones") else None
+            ),
         }
         entry["left_shape"] = spec["left_shape"]
         entry["right_shape"] = spec["right_shape"]
