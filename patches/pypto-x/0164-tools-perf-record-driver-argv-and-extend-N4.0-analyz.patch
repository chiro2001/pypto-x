From acece0a9264d5b4ed1496363d93ba01222d7c7c1 Mon Sep 17 00:00:00 2001
From: n4-dispatch-residual <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 01:56:32 +0800
Subject: [PATCH 164/257] tools(perf): record driver argv and extend N4.0
 analyzer (n4-dispatch-residual)

- harness presents the driver its own argv instead of the harness argv;
- analyzer adds _decode_artifact/_validate_fallback_artifact segments, an
  unattributed-row, and per-round median shares so the tier table does not
  mix per-metric medians.
---
 scripts/perf/n4_analyze_decomposition.py | 34 +++++++++++++++++++++++++++-------
 scripts/perf/n4_dispatch_decompose.py    |  3 +++
 2 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/scripts/perf/n4_analyze_decomposition.py b/scripts/perf/n4_analyze_decomposition.py
index 41429ce8f..a33f3bbe1 100644
--- a/scripts/perf/n4_analyze_decomposition.py
+++ b/scripts/perf/n4_analyze_decomposition.py
@@ -27,6 +27,7 @@ from typing import Any, Dict, List, Optional, Sequence, Tuple
 TAGS = ("base_r1", "base_r2", "base_r3", "after_r1", "after_r2", "after_r3")
 SEGMENTS = (
     "_validate_primary_artifact",
+    "_validate_fallback_artifact",
     "_program_digest_from_metadata",
     "_validate_primary_semantics",
     "lower_avx512",
@@ -83,7 +84,8 @@ def launch_derived(launch: Dict[str, Any]) -> Dict[str, Any]:
         "decode_seconds": top.get("_decode_artifact", {}).get("seconds"),
     }
     for name in ("_program_digest_from_metadata", "_validate_primary_semantics", "lower_avx512",
-                 "_validate_primary_artifact", "_read_native_bytes", "plan_release",
+                 "_validate_primary_artifact", "_validate_fallback_artifact", "_decode_artifact",
+                 "_read_native_bytes", "plan_release",
                  "_packed_dispatch_for", "_buffer_from_descriptor", "_buffer_from_values",
                  "_find_function", "LaunchRequest.validate", "_write_descriptor", "_buffer_values"):
         matches = [event for path, event in flattened if path[-1] == name]
@@ -95,6 +97,14 @@ def launch_derived(launch: Dict[str, Any]) -> Dict[str, Any]:
                         and path[-2] == "_decode_artifact"]
     result["nested_validate_in_decode_calls"] = len(nested_in_decode)
     result["nested_validate_in_decode_seconds"] = sum(float(e["seconds"]) for e in nested_in_decode)
+    result["tree_exclusive_seconds"] = sum(float(event["exclusive_seconds"]) for _, event in flattened)
+    if launch.get("setup_seconds") is not None and launch.get("teardown_seconds") is not None:
+        result["unattributed_setup_seconds"] = (
+            float(launch["setup_seconds"]) + float(launch["teardown_seconds"])
+            - result["tree_exclusive_seconds"]
+        )
+    else:
+        result["unattributed_setup_seconds"] = None
     return result
 
 
@@ -136,29 +146,37 @@ def select(rounds: Dict[str, Any], prefix: str, label: str) -> List[Dict[str, An
 def tier_table(rounds: Dict[str, Any], prefix: str, label: str) -> List[str]:
     rows = select(rounds, prefix, label)
     lines = [
-        "| tier | median s | min–max | share of launch |",
+        "| tier | median s | min–max | median share of launch |",
         "|---|---:|---|---:|",
     ]
     if not rows:
         return lines + ["| n/a | n/a | n/a | n/a |"]
-    launch_median = median([row["launch_seconds"] for row in rows])
+
+    def median_share(key: str) -> Optional[float]:
+        shares = [
+            row[key] / row["launch_seconds"] for row in rows
+            if row.get(key) is not None and row.get("launch_seconds")
+        ]
+        return 100.0 * statistics.median(shares) if shares else None
+
     for key, name in (("setup_seconds", "setup (per launch)"),
                       ("loop_seconds", "loop (per op)"),
                       ("teardown_seconds", "teardown (per launch)"),
                       ("launch_seconds", "**launch total**")):
         value = median([row[key] for row in rows])
         band = spread([row[key] for row in rows])
-        share = "100%" if key == "launch_seconds" else (
-            "n/a" if (value is None or not launch_median) else "{:.1f}%".format(100.0 * value / launch_median)
-        )
+        share = "100%" if key == "launch_seconds" else fmt(median_share(key), 1) + "%"
         lines.append("| {} | {} | {} | {} |".format(
             name, fmt(value), "n/a" if band is None else "{}-{}".format(fmt(band[0]), fmt(band[1])), share))
+    residual = median([row["launch_seconds"] - row["op_seconds"] for row in rows])
+    lines.append("| residual vs Σop = launch − op_internal | {} | | (setup+glue+release+teardown) |".format(
+        fmt(residual)))
     for key, name in (("op_seconds", "loop: op_internal (Σ _execute_operation)"),
                       ("release_seconds", "loop: release_dead_values"),
                       ("loop_glue_seconds", "loop: glue (list comps + loop)")):
         value = median([row[key] for row in rows])
         band = spread([row[key] for row in rows])
-        share = "n/a" if (value is None or not launch_median) else "{:.1f}%".format(100.0 * value / launch_median)
+        share = fmt(median_share(key), 1) + "%"
         lines.append("| {} | {} | {} | {} |".format(
             name, fmt(value), "n/a" if band is None else "{}-{}".format(fmt(band[0]), fmt(band[1])), share))
     glue_per_op = median([row["glue_per_op_ms"] for row in rows])
@@ -193,6 +211,8 @@ def segment_table(rounds: Dict[str, Any], prefix: str, label: str) -> List[str]:
     ))
     lines.append("| nested `_validate_primary_artifact` under `_decode_artifact` (inclusive) | 1 | {} | |".format(
         fmt(median([row["nested_validate_in_decode_seconds"] for row in rows]), 4)))
+    lines.append("| unattributed setup+teardown (probe cached, target/descriptor checks, metadata thaw) | | {} | |".format(
+        fmt(median([row["unattributed_setup_seconds"] for row in rows]), 4)))
     return lines
 
 
diff --git a/scripts/perf/n4_dispatch_decompose.py b/scripts/perf/n4_dispatch_decompose.py
index 0231458b1..5c225922c 100644
--- a/scripts/perf/n4_dispatch_decompose.py
+++ b/scripts/perf/n4_dispatch_decompose.py
@@ -373,6 +373,9 @@ def main(argv: Optional[List[str]] = None) -> int:
 
     install(rt, driver)
 
+    # The driver records sys.argv[1:] in its payload; present it with its own
+    # arguments instead of the harness arguments.
+    sys.argv = [str(driver_path)] + list(driver_args)
     started = time.time()
     try:
         rc = driver.main(driver_args)
