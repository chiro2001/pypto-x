From ca1d7e783ab8c6bc0ae5a424e18cbf865fe129bb Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Tue, 8 Sep 2026 15:45:52 +0800
Subject: [PATCH 038/134] fix(pypto-x): select native SVE toolchain and sysroot

---
 python/pypto/backends/cpu/aarch64/sve256.py |  9 +++++++-
 python/pypto/compiler/targets/cpu_sve256.py | 11 ++++++++-
 python/tests/ut/pypto_x/test_cpu_sve256.py  | 59 +++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/python/pypto/backends/cpu/aarch64/sve256.py b/python/pypto/backends/cpu/aarch64/sve256.py
index 2ac522289..ffab8b4c9 100644
--- a/python/pypto/backends/cpu/aarch64/sve256.py
+++ b/python/pypto/backends/cpu/aarch64/sve256.py
@@ -587,7 +587,14 @@ class Sve256Runtime:
         self.execution_mode = execution_mode.strip().lower()
         self._probe_directory = probe_directory
         self._qemu_cpu = qemu_cpu or os.environ.get("PYPTO_X_SVE_QEMU_CPU", "max,sve256=on")
-        self._sysroot = sysroot or os.environ.get("PYPTO_X_AARCH64_SYSROOT", "/usr/aarch64-linux-gnu")
+        if sysroot is not None:
+            self._sysroot = sysroot
+        elif self.execution_mode == "qemu":
+            self._sysroot = os.environ.get("PYPTO_X_AARCH64_SYSROOT", "/usr/aarch64-linux-gnu")
+        else:
+            # A native AArch64 compiler already uses the host sysroot.  Do not
+            # inject the x86 cross sysroot into ``cc --sysroot``.
+            self._sysroot = os.environ.get("PYPTO_X_AARCH64_SYSROOT")
         self._qemu = qemu
         self._injected = capability is not None or available_features is not None
         self._real_capability = None
diff --git a/python/pypto/compiler/targets/cpu_sve256.py b/python/pypto/compiler/targets/cpu_sve256.py
index b751d9b01..0a6bec4ea 100644
--- a/python/pypto/compiler/targets/cpu_sve256.py
+++ b/python/pypto/compiler/targets/cpu_sve256.py
@@ -12,6 +12,7 @@ import hashlib
 import json
 import os
 from pathlib import Path
+import platform
 import shutil
 import stat
 import subprocess
@@ -671,9 +672,17 @@ def _compiler_info(compiler_path: str) -> tuple:
     return version, triple
 
 
+def _default_aarch64_compiler() -> str:
+    """Select host cc for native AArch64, cross-gcc on x86 hosts."""
+
+    return "cc" if platform.machine().lower() in ("aarch64", "arm64") else "aarch64-linux-gnu-gcc"
+
+
 def _compile_native(target_ir: Sve256Program, options: Optional[CompileOptions]) -> tuple:
     extra = {} if options is None else mapping_copy(options.extra)
-    compiler = str(extra.get("aarch64_compiler") or extra.get("compiler") or "aarch64-linux-gnu-gcc")
+    compiler = str(
+        extra.get("aarch64_compiler") or extra.get("compiler") or _default_aarch64_compiler()
+    )
     compiler_path = shutil.which(compiler) or compiler
     if not shutil.which(compiler_path) and not Path(compiler_path).is_file():
         raise Sve256CompileError("AArch64 compiler {!r} was not found".format(compiler))
diff --git a/python/tests/ut/pypto_x/test_cpu_sve256.py b/python/tests/ut/pypto_x/test_cpu_sve256.py
index fd82d69e5..dbd424a7f 100644
--- a/python/tests/ut/pypto_x/test_cpu_sve256.py
+++ b/python/tests/ut/pypto_x/test_cpu_sve256.py
@@ -144,6 +144,65 @@ def test_qemu_probe_uses_auxv_prctl_and_reports_emulation():
     assert capability.to_dict()["vector_length_bytes"] == 32
 
 
+def test_native_probe_and_qemu_probe_sysroot_contract(monkeypatch, tmp_path):
+    calls = []
+    monkeypatch.setattr(capabilities_module.platform, "machine", lambda: "aarch64")
+    monkeypatch.setattr(
+        capabilities_module.shutil,
+        "which",
+        lambda value: "/fake/{}".format(Path(value).name),
+    )
+
+    def fake_run(command, **kwargs):
+        calls.append(list(command))
+        if "--version" in command:
+            return types.SimpleNamespace(stdout="gcc version test\n")
+        if "-dumpmachine" in command:
+            return types.SimpleNamespace(stdout="aarch64-linux-gnu\n")
+        if "-o" in command:
+            output = Path(command[command.index("-o") + 1])
+            output.write_bytes(b"probe")
+            return types.SimpleNamespace(stdout="", stderr="", returncode=0)
+        return types.SimpleNamespace(
+            stdout='{"hwcap":8321499131,"hwcap2":211056836706303,"sve":1,"sve2":1,"vl_bytes":32}\n',
+            stderr="",
+            returncode=0,
+        )
+
+    monkeypatch.setattr(capabilities_module.subprocess, "run", fake_run)
+    capabilities_module._run_probe(
+        "cc", str(tmp_path / "native"), "native", "max,sve256=on", None, "qemu-aarch64"
+    )
+    native_compile = next(command for command in calls if "-o" in command)
+    assert not any(str(item).startswith("--sysroot=") for item in native_compile)
+
+    calls[:] = []
+    capabilities_module._run_probe(
+        "aarch64-linux-gnu-gcc", str(tmp_path / "qemu"), "qemu",
+        "max,sve256=on", "/usr/aarch64-linux-gnu", "qemu-aarch64",
+    )
+    qemu_compile = next(command for command in calls if "-o" in command)
+    assert "--sysroot=/usr/aarch64-linux-gnu" in qemu_compile
+    qemu_run = calls[-1]
+    assert qemu_run[0] == "/fake/qemu-aarch64"
+    assert "-L" in qemu_run and "/usr/aarch64-linux-gnu" in qemu_run
+
+
+def test_native_runtime_sysroot_and_compiler_defaults(monkeypatch):
+    monkeypatch.delenv("PYPTO_X_AARCH64_SYSROOT", raising=False)
+    native_capability = Sve256Capability.injected_capability(("sve", "vl256"))
+    native_runtime = Sve256Runtime(capability=native_capability, execution_mode="native")
+    qemu_runtime = Sve256Runtime(capability=native_capability, execution_mode="qemu")
+    assert native_runtime._sysroot is None
+    assert qemu_runtime._sysroot == "/usr/aarch64-linux-gnu"
+
+    import pypto.compiler.targets.cpu_sve256 as compiler_module
+    monkeypatch.setattr(compiler_module.platform, "machine", lambda: "aarch64")
+    assert compiler_module._default_aarch64_compiler() == "cc"
+    monkeypatch.setattr(compiler_module.platform, "machine", lambda: "x86_64")
+    assert compiler_module._default_aarch64_compiler() == "aarch64-linux-gnu-gcc"
+
+
 def test_qemu_non_256_vl_is_structurally_rejected():
     capabilities_module.probe_sve256_capabilities.cache_clear()
     capability = probe_sve256_capabilities(qemu_cpu="max,sve128=on", execution_mode="qemu")
