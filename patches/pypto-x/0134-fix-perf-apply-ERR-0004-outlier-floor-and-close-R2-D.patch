         "mad": mad,
+        "outlier_rule": "|x - median| > max(3 * 1.4826 * MAD, floor); floor = max(1 us, 0.02 * median)",
+        "outlier_threshold": outlier_threshold,
+        "outlier_threshold_mad_component": mad_component,
+        "outlier_floor": floor,
         "outliers_marked": outliers,
         "outlier_ratio": (outliers / len(ordered)) if ordered else 0.0,
