-    )
+    floor = max(OUTLIER_FLOOR_MIN_SECONDS, OUTLIER_FLOOR_MEDIAN_FRACTION * median)
+    mad_component = 3.0 * 1.4826 * mad
+    outlier_threshold = max(mad_component, floor)
+    outliers = sum(1 for value in ordered if abs(value - median) > outlier_threshold)
     return {
