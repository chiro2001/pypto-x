+    _target_ir, split_artifact = _compile_sve(split_program, tmp_path, "declared-split")
+    split_runtime = _WireRecordingRuntime(execution_mode=_EXECUTION_MODE)
+    split_input = _raw_array("int8", _pattern_bits("int8", 30, seed=11))
+    split_outputs = [
+        ("int8", (2, 2, 3), _raw_array("int8", [0] * 12)),
+        ("int8", (2, 3, 3), _raw_array("int8", [0] * 18)),
+        ("int8", (2, 0, 3), _raw_array("int8", [0] * 0)),
+    ]
+    _launch(split_runtime, split_artifact, [("int8", (2, 5, 3), split_input)], split_outputs)
+    assert {request["operation"] for request in split_runtime.requests} == {23}  # split
+    assert {request["wire_version"] for request in split_runtime.requests} == {_INDEXING_WIRE_VERSION}
+    assert {request["dtype"] for request in split_runtime.requests} == {2}
+    declared_kernels = {dict(entry)["kernel"] for entry in split_artifact.metadata["layout_native_operations"]}
+    assert declared_kernels == {layout_native_kernel("split", "int8")} == {"split_i8"}
