+#!/usr/bin/env bash
+# W8C Q10 A3-side native window (runs ON a3-21 as l00886679, NOT in the
+# container: the host side owns cpus 320-639 per a3_cpu_grant_2026_09_11).
+#
+# Scope: run the SVE256 int8/bf16/float32 layout matrix *natively* on the A3
+# host and re-run the W8A8 gap probe, both from the synced worktree bundle.
+# This is the native leg of the QEMU+A3 dual run; it makes no L4/performance
+# claim and never touches chip7/NPU.
+#
+# Discipline: only writes under ~/pypto-x-a3/sve256-int8-layout, only taskset
+# cpus 320-639 (here 8 physical cores 320..334), no machine config changes,
+# no model weights, no residue.
+set -u
+
+ROOT="${HOME}/pypto-x-a3/sve256-int8-layout"
+PY="${HOME}/pypto-x-a3/envs/pypto-x-c8/bin/python"
+RAW="${ROOT}/raw"
+LOGS="${ROOT}/logs"
+WORK="${ROOT}/work"
+TMP="${ROOT}/tmp"
+mkdir -p "${RAW}" "${LOGS}" "${WORK}" "${TMP}"
+
+export PYTHONPATH="${ROOT}/src/python"
+export PYPTO_X_PORTABLE_ONLY=1
+export TMPDIR="${TMP}"
+export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8
+export OMP_PROC_BIND=close OMP_PLACES=cores
+export PYPTO_X_SVE_TEST_MODE=native
+
+# 8 non-overlapping physical cores: core c -> cpu 320 + (c/40)*80 + (c%40)*2.
+CPUS="320,322,324,326,328,330,332,334"
+
+{
+  echo "== a3_q10_window =="
+  date -u '+started_utc=%Y-%m-%dT%H:%M:%SZ'
+  date '+started_local=%Y-%m-%dT%H:%M:%S%z'
+  echo "hostname=$(hostname) user=$(whoami) home=${HOME}"
+  echo "cpuset_self=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  echo "nproc=$(nproc) mem_available_kib=$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
+  echo "uname=$(uname -m) kernel=$(uname -r)"
+  echo "python=$(${PY} --version 2>&1) cc=$(cc --version | head -1)"
+  echo "env_numpy=$(${PY} -c 'import numpy; print(numpy.__version__)' 2>&1)"
+  ${PY} - <<'PY'
+from pypto.lowering.cpu.aarch64.sve import probe_sve256_capabilities
+import json
+print("sve256_capability=" + json.dumps(probe_sve256_capabilities(execution_mode="native").to_dict(), sort_keys=True))
+PY
+} > "${LOGS}/env_evidence.log" 2>&1
+
+echo "[run] native layout matrix"
+STARTS=$(date +%s)
+setsid --wait timeout 10800 taskset -c "${CPUS}" "${PY}" \
+  "${ROOT}/tools/sve256_int8_layout_matrix.py" \
+  --execution-mode native \
+  --output "${RAW}/layout_matrix_native.json" \
+  --work-dir "${WORK}/layout_matrix" \
+  --w8a8-shape > "${LOGS}/layout_matrix_native.log" 2>&1
+MATRIX_STATUS=$?
+echo "[run] layout matrix exit=${MATRIX_STATUS} elapsed_s=$(( $(date +%s) - STARTS ))"
+
+echo "[run] W8A8 gap probe (lowering only, no weights)"
+STARTS=$(date +%s)
+setsid --wait timeout 1800 taskset -c "${CPUS}" "${PY}" \
+  "${ROOT}/tools/c8_sve256_w8a8_gap_probe.py" \
+  --output "${RAW}/gap_probe_a3.json" > "${LOGS}/gap_probe_a3.log" 2>&1
+PROBE_STATUS=$?
+echo "[run] gap probe exit=${PROBE_STATUS} elapsed_s=$(( $(date +%s) - STARTS ))"
+
+# --- discipline self-check --------------------------------------------------
+{
+  echo "cpuset_self=$(awk '/Cpus_allowed_list/{print $2}' /proc/self/status)"
+  echo "written_root=${ROOT}"
+  echo "matrix_exit=${MATRIX_STATUS} probe_exit=${PROBE_STATUS}"
+  echo "residue_processes=$(pgrep -u "$(whoami)" -f 'sve256_int8_layout_matrix|c8_sve256_w8a8_gap_probe' | wc -l)"
+  echo "npu_calls=none"
+  date -u '+finished_utc=%Y-%m-%dT%H:%M:%SZ'
+} > "${LOGS}/discipline_check.txt" 2>&1
+
+{
+  echo "{"
+  echo "  \"window\": \"a3_sve256_int8_layout\","
+  echo "  \"matrix_exit\": ${MATRIX_STATUS},"
+  echo "  \"gap_probe_exit\": ${PROBE_STATUS},"
+  echo "  \"a3_utc\": \"$(date -u '+%Y-%m-%dT%H:%M:%SZ')\""
+  echo "}"
+} > "${RAW}/matrix_status.json"
+
+echo "[done] matrix=${MATRIX_STATUS} probe=${PROBE_STATUS}"
+exit $(( MATRIX_STATUS != 0 || PROBE_STATUS != 0 ))
