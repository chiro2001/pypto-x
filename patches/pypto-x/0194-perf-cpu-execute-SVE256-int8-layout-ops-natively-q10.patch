+#!/usr/bin/env python3
+"""Prove a *real* pre-Q10 SVE256 artifact is rejected fail-closed by Q10.
+
+The Q10 version chain (lowering 8->9, payload 1->2, runner v6->v7, layout wire
+v3->v4, indexing wire v4->v5) means every artifact compiled before this change
+must be rejected rather than silently reinterpreted.  This tool compiles one
+artifact from the frozen base revision (``82d0272a``), then feeds it to the
+current runtime and records the rejection.  It is read-only outside its
+temporary build directory and removes the temporary git worktree afterwards.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+BASE_REVISION = "82d0272aecdf8ad412f51e3698d9ea45830fc3f8"
+WORKTREE = Path(__file__).resolve().parents[1]
+
+_OLD_COMPILE = r'''
+import json
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+
+source = ValueRef("source", CoreType.tensor("float32", (3, 5)))
+output = ValueRef("output", CoreType.tensor("float32", (5, 3)))
+operation = Operation("transpose", (source,), (output,), {"permutation": [-1, 0]})
+program = CoreProgram(functions=(CoreFunction("transpose", (source,), (output,), Region((operation,))),))
+target = TargetSpec("cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32})
+compiler = Sve256Compiler()
+artifact = compiler.compile(
+    compiler.lower(program, target),
+    CompileOptions(
+        artifact_format="pypto-x.cpu.sve256",
+        extra={"build_dir": __import__("os").environ["Q10_OLD_BUILD_DIR"]},
+    ),
+)
+metadata = dict(artifact.metadata)
+
+
+def plain(value):
+    if hasattr(value, "items"):
+        return {str(key): plain(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [plain(item) for item in value]
+    return value
+
+
+import os
+from pathlib import Path
+
+Path(os.environ["Q10_OLD_METADATA_JSON"]).write_text(
+    json.dumps(plain(metadata), sort_keys=True), encoding="utf-8"
+)
+print(json.dumps({
+    "artifact_path": artifact.path,
+    "entrypoint": artifact.entrypoint,
+    "artifact_format": artifact.format,
+    "abi_version": artifact.abi_version,
+    "lowering_version": metadata.get("lowering_version"),
+    "artifact_payload_version": metadata.get("artifact_payload_version"),
+    "runner_protocol": metadata.get("runner_protocol"),
+    "layout_descriptor_wire": metadata.get("layout_descriptor_wire"),
+    "indexing_descriptor_wire": metadata.get("indexing_descriptor_wire"),
+}))
+'''
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", required=True, help="JSON evidence path")
+    args = parser.parse_args()
+
+    sys.path.insert(0, str(WORKTREE / "python"))
+    from pypto.backends.cpu.aarch64 import CpuSve256ArtifactError, Sve256Runtime
+    from pypto.compiler import Artifact
+    from pypto.target import TargetSpec
+
+    report = {
+        "tool": "sve256_old_artifact_rejection",
+        "base_revision": BASE_REVISION,
+        "worktree": str(WORKTREE),
+    }
+    temporary = Path(tempfile.mkdtemp(prefix="q10-old-artifact-"))
+    old_tree = temporary / "old"
+    build_dir = temporary / "build"
+    build_dir.mkdir(parents=True, exist_ok=True)
+    try:
+        subprocess.run(
+            ["git", "-C", str(WORKTREE), "worktree", "add", "--detach", str(old_tree), BASE_REVISION],
+            check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        )
+        environment = dict(os.environ)
+        environment["PYTHONPATH"] = str(old_tree / "python")
+        environment["PYPTO_X_PORTABLE_ONLY"] = "1"
+        environment["Q10_OLD_BUILD_DIR"] = str(build_dir)
+        metadata_path = temporary / "old_artifact_metadata.json"
+        environment["Q10_OLD_METADATA_JSON"] = str(metadata_path)
+        completed = subprocess.run(
+            [sys.executable, "-c", _OLD_COMPILE],
+            cwd=str(old_tree), env=environment, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE, universal_newlines=True, check=False,
+        )
+        if completed.returncode != 0:
+            raise SystemExit(
+                "base-revision compile failed (exit {}):\n{}".format(
+                    completed.returncode, completed.stderr[-2000:]
+                )
+            )
+        old = json.loads(completed.stdout.strip().splitlines()[-1])
+        report["old_artifact"] = {
+            key: old[key]
+            for key in (
+                "artifact_format", "abi_version", "lowering_version",
+                "artifact_payload_version", "runner_protocol",
+                "layout_descriptor_wire", "indexing_descriptor_wire",
+            )
+        }
+        artifact = Artifact(
+            format=old["artifact_format"],
+            entrypoint=old["entrypoint"],
+            target=TargetSpec(
+                "cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32}
+            ),
+            abi_version=old["abi_version"],
+            path=old["artifact_path"],
+            metadata=json.loads(metadata_path.read_text(encoding="utf-8")),
+        )
+        runtime = Sve256Runtime(execution_mode="qemu")
+        try:
+            runtime.load(artifact)
+        except CpuSve256ArtifactError as exc:
+            report["rejected"] = True
+            report["rejection_error"] = "{}: {}".format(type(exc).__name__, exc)
+        else:
+            report["rejected"] = False
+            report["rejection_error"] = None
+    finally:
+        subprocess.run(
+            ["git", "-C", str(WORKTREE), "worktree", "remove", "--force", str(old_tree)],
+            check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        )
+        subprocess.run(["rm", "-rf", str(temporary)], check=False)
+
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({key: report[key] for key in ("rejected", "rejection_error", "old_artifact")}, sort_keys=True))
+    return 0 if report.get("rejected") else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
