+    source = _raw_array("int8", _pattern_bits("int8", 15, seed=9))
+    output = _raw_array("int8", [0] * 15)
+    _launch(runtime, artifact, [("int8", (3, 5), source)], [("int8", (5, 3), output)])
+    assert runtime.requests[-1]["operation"] == 21  # transpose
+    assert runtime.requests[-1]["wire_version"] == _LAYOUT_WIRE_VERSION == 4
+    assert runtime.requests[-1]["dtype"] == 2  # layout-wire int8
+    assert runtime.requests[-1]["expected_dtype"] == 2
+    declared = dict(artifact.metadata["layout_native_operations"][0])
+    assert declared["kernel"] == "layout_i8"
+    assert declared["kernel"] == layout_native_kernel("transpose", "int8")
+
