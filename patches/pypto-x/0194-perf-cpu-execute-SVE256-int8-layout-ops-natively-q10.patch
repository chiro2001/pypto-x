+class _WireRecordingRuntime(Sve256Runtime):
+    """Record every runner request header, then execute normally."""
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.requests = []
+
+    def _invoke_runner_raw(self, artifact, *, header, payload, expected_dtype, expected_count, wire_version):
+        magic, version, operation, dtype, reserved, reserved2, count, m, k, n = struct.unpack(
+            "<6I4Q", header
+        )
+        self.requests.append(
+            {
+                "magic": magic,
+                "wire_version": version,
+                "operation": operation,
+                "dtype": dtype,
+                "reserved": reserved,
+                "reserved2": reserved2,
+                "count": count,
+                "m": m,
+                "k": k,
+                "n": n,
+                "expected_dtype": expected_dtype,
+            }
+        )
+        return super()._invoke_runner_raw(
+            artifact,
+            header=header,
+            payload=payload,
+            expected_dtype=expected_dtype,
+            expected_count=expected_count,
+            wire_version=wire_version,
+        )
+
