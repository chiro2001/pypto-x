+# fail-closed boundaries
+# --------------------------------------------------------------------------
+
+
+def _tampered(artifact, **updates):
+    metadata = dict(artifact.metadata)
+    metadata.update(updates)
+    return Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=artifact.path,
+        metadata=metadata,
+    )
+
+
+@pytest.mark.parametrize(
+    "updates,match",
+    (
+        ({"layout_native_dtypes": ["float32", "bf16"]}, "layout native dtype declaration"),
+        ({"layout_native_kernel_version": 2}, "layout native kernel version"),
+        ({"layout_descriptor_wire": "v3:pxld-v2+fnv1a64"}, "layout descriptor wire"),
+        ({"indexing_descriptor_wire": "v4:pxsp-pxct-pxix+fnv1a64"}, "indexing descriptor wire"),
+        ({"artifact_payload_version": 1}, "unsupported SVE256 artifact payload version"),
+        ({"lowering_version": 8}, "unsupported SVE256 lowering version"),
+        ({"runner_protocol": "pypto-x.cpu.sve256.runner.v6"}, "runner protocol is unsupported"),
+        ({"native_digest": "0" * 64}, "ELF content digest mismatch"),
+        ({"native_source_digest": "0" * 64}, "native source marker mismatch"),
+    ),
+)
+def test_artifact_metadata_tamper_fails_closed(tmp_path, updates, match):
+    program = _layout_program("transpose", (3, 5), (5, 3), {"permutation": [-1, 0]}, "int8")
+    _target_ir, artifact = _compile_sve(program, tmp_path, "tamper")
+    with pytest.raises(CpuSve256ArtifactError, match=match):
+        Sve256Runtime(execution_mode=_EXECUTION_MODE).load(_tampered(artifact, **updates))
+
+
