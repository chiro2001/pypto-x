+    if operation is None or plan is None:
+        return None
+    name = canonical_operation_name(operation.name)
+    if name != plan.operation:
+        return None
+    if name in LAYOUT_NATIVE_OPERATIONS:
+        layout = plan.layout_plan
+        if layout is None or layout.operation != name:
+            return None
+        dtype = _layout_operand_dtype(operation)
+        kernel = layout_native_kernel(name, dtype) if dtype is not None else None
+        if kernel is None:
+            return None
+        return {
+            "mode": LAYOUT_NATIVE_MODE,
+            "kernel": kernel,
+            "dtype": dtype,
+            "kind": layout.kind,
+            "descriptor_digest": layout.descriptor_digest,
+        }
+    if name == "split":
+        split = plan.split_plan
+        if split is None or len(operation.inputs) != 1:
+            return None
+        if len(operation.outputs) != len(split.sizes):
+            return None
+        dtype = _layout_operand_dtype(operation)
+        kernel = layout_native_kernel(name, dtype) if dtype is not None else None
+        if kernel is None:
+            return None
+        return {
+            "mode": LAYOUT_SPLIT_MODE,
+            "kernel": kernel,
+            "dtype": dtype,
+            "kind": "split",
+            "output_count": len(split.sizes),
+            "descriptor_digest": split.descriptor_digest,
+        }
+    if name == "concat":
+        concat = plan.concat_plan
+        if concat is None or len(operation.inputs) != len(concat.input_shapes):
+            return None
+        dtype = _layout_operand_dtype(operation)
+        kernel = layout_native_kernel(name, dtype) if dtype is not None else None
+        if kernel is None:
+            return None
+        return {
+            "mode": LAYOUT_CONCAT_MODE,
+            "kernel": kernel,
+            "dtype": dtype,
+            "kind": "concat",
+            "input_count": len(concat.input_shapes),
+            "descriptor_digest": concat.descriptor_digest,
+        }
+    return None
+
+
+def layout_native_fallback_reason(operation: Any, plan: Any) -> Optional[str]:
+    """Return why a layout/split/concat operation is not native, or None."""
+
+    if operation is None or plan is None:
+        return None
+    name = canonical_operation_name(operation.name)
+    if name != plan.operation:
+        return None
+    if name not in LAYOUT_NATIVE_OPERATIONS and name not in LAYOUT_INDEXING_OPERATIONS:
+        return None
+    if layout_native_contract(operation, plan) is not None:
+        return None
+    if name in LAYOUT_NATIVE_OPERATIONS:
+        layout = plan.layout_plan
+        if layout is None or layout.operation != name:
+            return "layout descriptor is missing or does not match the operation"
+    elif name == "split" and plan.split_plan is None:
+        return "split descriptor is missing"
+    elif name == "concat" and plan.concat_plan is None:
+        return "concat descriptor is missing"
+    dtype = _layout_operand_dtype(operation)
+    if dtype is None:
+        return "operand dtypes are missing, non-tensor, or inconsistent"
+    if dtype not in LAYOUT_NATIVE_DTYPES:
+        return "dtype {} is not in the native SVE256 layout dtype set (bf16/float32/int8)".format(dtype)
+    return "operation is not covered by the native SVE256 layout plane"
+
+
+def _layout_execution_metadata(target_ir: Sve256Program) -> tuple:
+    """Return (native entries, fallback entries) for the layout plane."""
+
+    function = next(
+        function for function in target_ir.program.functions
+        if function.name == target_ir.entrypoint
+    )
+    core_operations = list(function.body.operations)
+    native_entries = []
+    fallback_entries = []
+    for plan in target_ir.plans:
+        operation = (
+            core_operations[plan.operation_index]
+            if 0 <= plan.operation_index < len(core_operations)
+            else None
+        )
+        contract = layout_native_contract(operation, plan)
+        if contract is not None:
+            entry = {
+                "operation_index": plan.operation_index,
+                "operation": plan.operation,
+                "mode": contract["mode"],
+                "kernel": contract["kernel"],
+                "dtype": contract["dtype"],
+                "kind": contract["kind"],
+                "descriptor_digest": contract["descriptor_digest"],
+            }
+            native_entries.append(entry)
+            continue
+        reason = layout_native_fallback_reason(operation, plan)
+        if reason is not None:
+            fallback_entries.append(
+                {
+                    "operation_index": plan.operation_index,
+                    "operation": plan.operation,
+                    "reason": reason,
+                }
+            )
+    return native_entries, fallback_entries
+
