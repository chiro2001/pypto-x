+#: Native layout/split/concat plane (artifact payload version 2).
+#:
+#: ``LayoutPlan`` / ``SplitPlan`` / ``ConcatPlan`` already carry the complete
+#: rank-sized descriptor; this plane executes those descriptors in the
+#: compiled SVE256 ELF instead of walking a Python list.  The predicate below
+#: is shared by the artifact metadata and the runtime, so an artifact cannot
+#: declare a native layout kernel that the runtime would not execute.
+LAYOUT_NATIVE_KERNEL_VERSION = 1
+LAYOUT_NATIVE_MODE = "native_sve256_layout"
+LAYOUT_SPLIT_MODE = "native_sve256_split"
+LAYOUT_CONCAT_MODE = "native_sve256_concat"
+#: int8 is required for the W8A8 weight path; any other dtype stays on the
+#: explicit host_reference boundary with a reason instead of silently
+#: materializing a Python list.
+LAYOUT_NATIVE_DTYPES = ("float32", "bf16", "int8")
+LAYOUT_NATIVE_OPERATIONS = frozenset(
+    ("reshape", "view", "contiguous", "transpose", "slice")
+)
+LAYOUT_INDEXING_OPERATIONS = frozenset(("split", "concat"))
+LAYOUT_NATIVE_KERNEL_SUFFIX = {"float32": "f32", "bf16": "bf16", "int8": "i8"}
+_LAYOUT_TENSOR_KINDS = frozenset(("tensor", "view", "tile"))
+
 
 
