@@ -0,0 +1,371 @@
+#!/usr/bin/env python3
+"""W8C Q10 SVE256 int8 layout/split/concat native matrix (QEMU or A3-native).
+
+This tool is the dual-run companion of
+``python/tests/ut/pypto_x/test_cpu_sve256_int8_layout.py``.  It does not need
+pytest, so it can run on the A3 host with the Q1 conda environment (which only
+has numpy) as well as locally under QEMU.
+
+For every case it:
+
+1. lowers and compiles a native SVE256 artifact,
+2. launches it in the requested execution mode and records the wire requests
+   (version/dtype/operation) the runtime actually sent,
+3. runs the same program on the CPU scalar host reference,
+4. compares the full output buffer sha256 (raw bytes, NaN payloads included),
+5. checks that the artifact metadata declares exactly the kernel the shared
+   ``layout_native_contract`` predicate derives.
+
+It writes a single JSON file and never touches model weights or the NPU.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import hashlib
+import json
+import platform
+import struct
+import sys
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+import numpy as np
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import CpuScalarRuntime
+from pypto.backends.cpu.aarch64 import Sve256Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    LAYOUT_NATIVE_DTYPES,
+    RUNNER_PROTOCOL,
+    Sve256Compiler,
+    layout_native_contract,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import element_count
+from pypto.lowering.cpu.aarch64.sve import SVE256_LOWERING_VERSION
+from pypto.target import TargetSpec
+
+TOOL = "sve256_int8_layout_matrix"
+
+SVE256_TARGET = TargetSpec(
+    "cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32}
+)
+_CTYPES = {"float32": ctypes.c_float, "bf16": ctypes.c_uint16, "int8": ctypes.c_int8}
+_F32_SPECIAL = (
+    0x7F800001, 0xFF800001, 0x7F812345, 0xFF812345, 0x7FC00001, 0xFFC12345,
+    0x7F800000, 0xFF800000, 0x00000001, 0x80000001, 0x7F7FFFFF, 0x3F800000,
+    0xBF800000, 0x41200000, 0x00000000,
+)
+_BF16_SPECIAL = (
+    0x7F81, 0xFF81, 0x7FA1, 0xFFA1, 0x7FC1, 0xFFC1, 0x7F80, 0xFF80,
+    0x0001, 0x8001, 0x7F7F, 0x3F80, 0xBF80, 0x4120, 0x0000,
+)
+
+
+def _raw_array(dtype: str, bits: Sequence[int]):
+    array = (_CTYPES[dtype] * len(bits))()
+    for index, value in enumerate(bits):
+        if dtype == "float32":
+            ctypes.memmove(ctypes.addressof(array) + 4 * index, struct.pack("<I", int(value) & 0xFFFFFFFF), 4)
+        elif dtype == "bf16":
+            ctypes.memmove(ctypes.addressof(array) + 2 * index, struct.pack("<H", int(value) & 0xFFFF), 2)
+        else:
+            ctypes.memmove(ctypes.addressof(array) + index, struct.pack("<b", int(value)), 1)
+    return array
+
+
+def _buffer_sha256(array) -> str:
+    return hashlib.sha256(ctypes.string_at(ctypes.addressof(array), ctypes.sizeof(array))).hexdigest()
+
+
+def _pattern_bits(dtype: str, count: int, seed: int = 1) -> List[int]:
+    if dtype == "float32":
+        return [
+            _F32_SPECIAL[index] if index < len(_F32_SPECIAL)
+            else ((seed * 2654435761 + index * 2246822519) & 0xFFFFFFFF)
+            for index in range(count)
+        ]
+    if dtype == "bf16":
+        return [
+            _BF16_SPECIAL[index] if index < len(_BF16_SPECIAL)
+            else ((seed * 40503 + index * 16411) & 0xFFFF)
+            for index in range(count)
+        ]
+    return [((seed * 37 + index * 91) % 255) - 127 for index in range(count)]
+
+
+def _descriptor(dtype, shape, array, readonly=False):
+    return TensorDesc(dtype, shape, handle=array, readonly=readonly)
+
+
+class _RecordingRuntime(Sve256Runtime):
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.requests: List[Dict[str, int]] = []
+
+    def _invoke_runner_raw(self, artifact, *, header, payload, expected_dtype, expected_count, wire_version):
+        magic, version, operation, dtype, reserved, reserved2, count, m, k, n = struct.unpack("<6I4Q", header)
+        self.requests.append(
+            {
+                "wire_version": version, "operation": operation, "dtype": dtype,
+                "reserved": reserved, "reserved2": reserved2,
+                "count": count, "m": m, "k": k, "n": n, "expected_dtype": expected_dtype,
+            }
+        )
+        return super()._invoke_runner_raw(
+            artifact, header=header, payload=payload, expected_dtype=expected_dtype,
+            expected_count=expected_count, wire_version=wire_version,
+        )
+
+
+def _layout_program(name, input_shape, output_shape, attributes, dtype):
+    source = ValueRef("source", CoreType.tensor(dtype, input_shape))
+    output = ValueRef("output", CoreType.tensor(dtype, output_shape))
+    operation = Operation(name, (source,), (output,), dict(attributes))
+    return CoreProgram(functions=(CoreFunction(name, (source,), (output,), Region((operation,))),))
+
+
+def _split_program(input_shape, axis, sizes, dtype):
+    source = ValueRef("source", CoreType.tensor(dtype, input_shape))
+    outputs = []
+    for index, size in enumerate(sizes):
+        shape = list(input_shape)
+        shape[axis] = size
+        outputs.append(ValueRef("out{}".format(index), CoreType.tensor(dtype, tuple(shape))))
+    operation = Operation("split", (source,), tuple(outputs), {"axis": axis, "sizes": list(sizes)})
+    return CoreProgram(functions=(CoreFunction("split", (source,), tuple(outputs), Region((operation,))),))
+
+
+def _concat_program(input_shapes, axis, dtype):
+    references = [
+        ValueRef("in{}".format(index), CoreType.tensor(dtype, shape))
+        for index, shape in enumerate(input_shapes)
+    ]
+    output_shape = list(input_shapes[0])
+    output_shape[axis] = sum(shape[axis] for shape in input_shapes)
+    output = ValueRef("output", CoreType.tensor(dtype, tuple(output_shape)))
+    operation = Operation("concat", tuple(references), (output,), {"axis": axis})
+    return CoreProgram(
+        functions=(CoreFunction("concat", tuple(references), (output,), Region((operation,))),)
+    )
+
+
+def _cases() -> List[Mapping[str, Any]]:
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append({"name": "reshape", "dtype": dtype, "program": _layout_program("reshape", (3, 5), (5, 3), {"shape": [5, 3]}, dtype)})
+        cases.append({"name": "view", "dtype": dtype, "program": _layout_program("view", (2, 3, 4), (4, 6), {"shape": [4, 6]}, dtype)})
+        cases.append({"name": "contiguous", "dtype": dtype, "program": _layout_program("contiguous", (3, 5, 7), (3, 5, 7), {}, dtype)})
+        cases.append({"name": "reshape_empty_axis", "dtype": dtype, "program": _layout_program("reshape", (2, 0, 3), (0, 6), {"shape": [0, 6]}, dtype)})
+        cases.append({"name": "transpose_rank2", "dtype": dtype, "program": _layout_program("transpose", (5, 7), (7, 5), {"permutation": [1, 0]}, dtype)})
+        cases.append({"name": "transpose_rank3", "dtype": dtype, "program": _layout_program("transpose", (2, 3, 5), (5, 2, 3), {"permutation": [2, 0, 1]}, dtype)})
+        cases.append({"name": "transpose_rank4", "dtype": dtype, "program": _layout_program("transpose", (2, 3, 4, 5), (4, 5, 2, 3), {"permutation": [2, 3, 0, 1]}, dtype)})
+        cases.append({"name": "slice_step", "dtype": dtype, "program": _layout_program("slice", (5, 7), (3, 2), {"starts": [0, 1], "stops": [5, 7], "steps": [2, 3]}, dtype)})
+        cases.append({"name": "slice_empty", "dtype": dtype, "program": _layout_program("slice", (3, 5), (0, 5), {"starts": [2], "stops": [2], "steps": [1], "axes": [0]}, dtype)})
+        cases.append({"name": "split", "dtype": dtype, "program": _split_program((2, 5, 3), 1, [2, 3, 0], dtype)})
+        cases.append({"name": "split_empty", "dtype": dtype, "program": _split_program((3, 5), 0, [0, 3], dtype)})
+        cases.append({"name": "concat", "dtype": dtype, "program": _concat_program([(2, 2, 3), (2, 3, 3)], 1, dtype)})
+        cases.append({"name": "concat_empty_input", "dtype": dtype, "program": _concat_program([(0, 4), (2, 4)], 0, dtype)})
+    for dtype in ("float32", "bf16"):
+        cases.append({"name": "special_nan_transpose", "dtype": dtype, "program": _layout_program("transpose", (2, 3, 5), (5, 3, 2), {"permutation": [2, 1, 0]}, dtype)})
+        cases.append({"name": "special_nan_slice", "dtype": dtype, "program": _layout_program("slice", (5, 6), (4, 3), {"starts": [1, 0], "stops": [5, 6], "steps": [1, 2]}, dtype)})
+    return cases
+
+
+def _run_case(case: Mapping[str, Any], recording: "_RecordingRuntime", work: Path, seed: int) -> Mapping[str, Any]:
+    dtype = case["dtype"]
+    name = case["name"]
+    program = case["program"]
+    operation = program.functions[0].body.operations[0]
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE256_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(work / "{}-{}".format(dtype, name))},
+        ),
+    )
+    declared = [dict(entry) for entry in artifact.metadata["layout_native_operations"]]
+    contracts = [
+        layout_native_contract(operation, plan) for plan in target_ir.plans
+    ]
+    declared_matches_predicate = []
+    for plan, contract in zip(target_ir.plans, contracts):
+        entry = next(
+            (item for item in declared if item["operation_index"] == plan.operation_index), None
+        )
+        declared_matches_predicate.append(
+            contract is not None and entry is not None and entry["kernel"] == contract["kernel"]
+            and entry["dtype"] == contract["dtype"] and entry["mode"] == contract["mode"]
+            and entry["descriptor_digest"] == contract["descriptor_digest"]
+        )
+
+    if operation.name == "split":
+        input_shapes = [tuple(program.functions[0].parameters[0].type.shape)]
+    elif operation.name == "concat":
+        input_shapes = [tuple(ref.type.shape) for ref in operation.inputs]
+    else:
+        input_shapes = [tuple(operation.inputs[0].type.shape)]
+    output_shapes = [tuple(ref.type.shape) for ref in operation.outputs]
+
+    inputs = []
+    for index, shape in enumerate(input_shapes):
+        inputs.append((dtype, shape, _raw_array(dtype, _pattern_bits(dtype, element_count(shape), seed + index))))
+    native_outputs = [
+        (dtype, shape, _raw_array(dtype, [0] * element_count(shape))) for shape in output_shapes
+    ]
+    recording.requests = []
+    recording.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_descriptor(d, s, a, True) for d, s, a in inputs],
+            outputs=[_descriptor(d, s, a) for d, s, a in native_outputs],
+        )
+    )
+
+    reference_outputs = [
+        (dtype, shape, _raw_array(dtype, [0] * element_count(shape))) for shape in output_shapes
+    ]
+    reference = CpuScalarCompiler().compile(
+        CpuScalarCompiler().lower(program, TargetSpec("cpu", "x86_64-linux-gnu"))
+    )
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            reference,
+            inputs=[_descriptor(d, s, a, True) for d, s, a in inputs],
+            outputs=[_descriptor(d, s, a) for d, s, a in reference_outputs],
+        )
+    )
+    native_hashes = [_buffer_sha256(array) for _dtype, _shape, array in native_outputs]
+    reference_hashes = [_buffer_sha256(array) for _dtype, _shape, array in reference_outputs]
+    return {
+        "case": "{}-{}".format(dtype, name),
+        "operation": operation.name,
+        "dtypes": sorted({entry["dtype"] for entry in declared}),
+        "plan_count": len(target_ir.plans),
+        "declared_kernels": [entry["kernel"] for entry in declared],
+        "declared_modes": [entry["mode"] for entry in declared],
+        "declared_matches_predicate": all(declared_matches_predicate),
+        "wire_requests": recording.requests,
+        "native_sha256": native_hashes,
+        "reference_sha256": reference_hashes,
+        "match": native_hashes == reference_hashes,
+    }
+
+
+def _w8a8_shape_case(recording: "_RecordingRuntime", work: Path) -> Mapping[str, Any]:
+    input_shape, output_shape = (6144, 1024), (1024, 6144)
+    program = _layout_program("transpose", input_shape, output_shape, {"permutation": [-1, 0]}, "int8")
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE256_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(work / "w8a8-shape")},
+        ),
+    )
+    source = np.arange(element_count(input_shape), dtype=np.int32).astype(np.int8).reshape(input_shape)
+    source_array = _raw_array("int8", source.reshape(-1).tolist())
+    output = _raw_array("int8", [0] * element_count(output_shape))
+    started = time.time()
+    recording.requests = []
+    recording.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_descriptor("int8", input_shape, source_array, True)],
+            outputs=[_descriptor("int8", output_shape, output)],
+        )
+    )
+    elapsed = time.time() - started
+    expected = hashlib.sha256(source.T.tobytes()).hexdigest()
+    actual = _buffer_sha256(output)
+    contract = layout_native_contract(program.functions[0].body.operations[0], target_ir.plans[0])
+    return {
+        "case": "int8-w8a8-shape-transpose",
+        "input_shape": list(input_shape),
+        "output_shape": list(output_shape),
+        "declared_kernel": contract["kernel"] if contract else None,
+        "declared_mode": contract["mode"] if contract else None,
+        "sha256_native": actual,
+        "sha256_expected": expected,
+        "match": actual == expected,
+        "wall_seconds": round(elapsed, 3),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--execution-mode", choices=("qemu", "native"), default="qemu")
+    parser.add_argument("--output", required=True, help="JSON evidence path")
+    parser.add_argument("--work-dir", required=True, help="native build directory")
+    parser.add_argument("--w8a8-shape", action="store_true", help="also run the 6144x1024 int8 transpose")
+    args = parser.parse_args()
+
+    runtime = Sve256Runtime(execution_mode=args.execution_mode)
+    if not runtime.is_available():
+        raise SystemExit("SVE256 unavailable: {}".format(runtime.availability().to_dict()))
+    recording = _RecordingRuntime(execution_mode=args.execution_mode)
+    work = Path(args.work_dir)
+    work.mkdir(parents=True, exist_ok=True)
+
+    report: Dict[str, Any] = {
+        "tool": TOOL,
+        "execution_mode": args.execution_mode,
+        "started_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "versions": {
+            "sve256_lowering_version": SVE256_LOWERING_VERSION,
+            "artifact_payload_version": ARTIFACT_PAYLOAD_VERSION,
+            "runner_protocol": RUNNER_PROTOCOL,
+            "layout_native_dtypes": list(LAYOUT_NATIVE_DTYPES),
+        },
+        "environment": {
+            "hostname": platform.node(),
+            "machine": platform.machine(),
+            "python": sys.version.split()[0],
+            "numpy": np.__version__,
+            "capability": runtime.availability().to_dict(),
+        },
+        "cases": [],
+    }
+    failures = 0
+    started = time.time()
+    for index, case in enumerate(_cases()):
+        record = _run_case(case, recording, work, seed=3 + index)
+        report["cases"].append(record)
+        if not record["match"] or not record["declared_matches_predicate"]:
+            failures += 1
+        print(
+            "[case] {:<32} match={} declared={} kernels={}".format(
+                record["case"], record["match"], record["declared_matches_predicate"],
+                ",".join(record["declared_kernels"]),
+            ),
+            flush=True,
+        )
+    if args.w8a8_shape:
+        record = _w8a8_shape_case(recording, work)
+        report["w8a8_shape"] = record
+        if not record["match"]:
+            failures += 1
+        print("[case] {:<32} match={}".format(record["case"], record["match"]), flush=True)
+    report["summary"] = {
+        "cases": len(report["cases"]),
+        "failures": failures,
+        "wall_seconds": round(time.time() - started, 3),
+    }
+    report["finished_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.output).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print("[matrix] cases={} failures={} output={}".format(len(report["cases"]), failures, args.output))
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
