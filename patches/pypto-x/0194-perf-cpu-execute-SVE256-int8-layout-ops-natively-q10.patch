+#!/usr/bin/env bash
+# W8C Q10: ship the int8-layout worktree bundle to A3 (a3-21) and verify it by
+# sha256 manifest.  Runs on the LOCAL machine after the worktree commit.
+set -euo pipefail
+
+WT=/home/chiro/projects/pypto/worktrees/pypto-x/sve256-int8-layout
+EV=/home/chiro/projects/pypto/worktrees/_meta/pypto-x/sve256-int8-layout
+A3=a3-21
+A3_HOME=/home/l00886679
+A3_ROOT=pypto-x-a3/sve256-int8-layout
+BUNDLE="${EV}/a3_bundle"
+
+[[ -d "${WT}/python/pypto" ]] || { echo "missing worktree python/pypto" >&2; exit 2; }
+
+rm -rf "${BUNDLE}"
+mkdir -p "${BUNDLE}/src/python/tests/ut/pypto_x" "${BUNDLE}/tools/c8_sve256_a3"
+
+tar -C "${WT}" -cf - --exclude='__pycache__' --exclude='*.pyc' python/pypto \
+    | tar -C "${BUNDLE}/src" -xf -
+cp -f "${WT}/python/tests/ut/pypto_x/qwen35_weighted_execution_driver.py" \
+      "${BUNDLE}/src/python/tests/ut/pypto_x/"
+cp -f "${WT}/tools/sve256_int8_layout_matrix.py" \
+      "${WT}/tools/c8_sve256_w8a8_gap_probe.py" \
+      "${BUNDLE}/tools/"
+cp -f "${WT}/tools/c8_sve256_a3/run_a3_int8_layout.sh" \
+      "${BUNDLE}/tools/c8_sve256_a3/"
+
+(
+  cd "${BUNDLE}"
+  find . -type f ! -name 'MANIFEST.sha256' -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256
+)
+BUNDLE_BYTES=$(du -sb "${BUNDLE}" | cut -f1)
+TAR="${EV}/a3_bundle.tar"
+tar -C "${EV}" -cf "${TAR}" a3_bundle
+sha256sum "${TAR}" | tee "${EV}/a3_bundle.tar.sha256"
+echo "[bundle] dir=${BUNDLE} bytes=${BUNDLE_BYTES} tar_bytes=$(stat -c %s "${TAR}")"
+
+echo "[sync] target=${A3}:${A3_HOME}/${A3_ROOT}"
+ssh -o BatchMode=yes "${A3}" "mkdir -p ${A3_HOME}/${A3_ROOT} && rm -rf ${A3_HOME}/${A3_ROOT}/src ${A3_HOME}/${A3_ROOT}/tools"
+scp -q -o BatchMode=yes "${TAR}" "${A3}:${A3_HOME}/${A3_ROOT}/a3_bundle.tar"
+ssh -o BatchMode=yes "${A3}" "cd ${A3_HOME}/${A3_ROOT} && tar -xf a3_bundle.tar && rm -rf src tools && mv a3_bundle/src . && mv a3_bundle/tools . && mv a3_bundle/MANIFEST.sha256 . && rm -rf a3_bundle && sha256sum -c MANIFEST.sha256 >/dev/null && echo '[sync] remote manifest OK'"
+ssh -o BatchMode=yes "${A3}" "du -sh ${A3_HOME}/${A3_ROOT}; date -u '+[sync] a3_utc=%Y-%m-%dT%H:%M:%SZ'"
+date -u '+[sync] local_utc=%Y-%m-%dT%H:%M:%SZ'
