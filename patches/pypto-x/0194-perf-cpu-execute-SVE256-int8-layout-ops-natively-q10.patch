@@ -0,0 +1,637 @@
+"""W8C Q10: native SVE256 int8 layout / split / concat execution plane.
+
+Every native execution is compared *bitwise* (full output buffer sha256) against
+the same program on the CPU scalar host reference, using raw ctypes buffers so
+NaN payloads are compared too.  The declaration/execution invariant is checked
+through artifact metadata plus a wire recorder: the mode and kernel a program
+declares are derived from the same shared predicate the runtime dispatches
+with, and int8 wire requests carry the v4/v5 dtype code the kernel expects.
+
+QEMU mode is the default local leg (``PYPTO_X_SVE_QEMU_CPU``); the same file
+runs unchanged with ``PYPTO_X_SVE_TEST_MODE=native`` on an AArch64 host.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import functools
+import hashlib
+import os
+import struct
+
+import numpy as np
+import pytest
+
+from pypto.abi import LaunchRequest, TensorDesc
+from pypto.backends.cpu import CpuScalarRuntime
+from pypto.backends.cpu.aarch64 import CpuSve256ArtifactError, CpuSve256ExecutionError, Sve256Runtime
+from pypto.backends.cpu.aarch64.sve256 import (
+    _INDEXING_WIRE_VERSION,
+    _LAYOUT_WIRE_VERSION,
+    _layout_descriptor_bytes,
+)
+from pypto.compiler import Artifact, CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import (
+    ARTIFACT_PAYLOAD_VERSION,
+    LAYOUT_CONCAT_MODE,
+    LAYOUT_NATIVE_DTYPES,
+    LAYOUT_NATIVE_KERNEL_VERSION,
+    LAYOUT_NATIVE_MODE,
+    LAYOUT_SPLIT_MODE,
+    RUNNER_PROTOCOL,
+    Sve256Compiler,
+    layout_native_contract,
+    layout_native_fallback_reason,
+    layout_native_kernel,
+)
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.lowering.cpu import element_count
+from pypto.lowering.cpu.aarch64.sve import Sve256UnsupportedError
+from pypto.target import TargetSpec
+
+
+SVE256_TARGET = TargetSpec(
+    "cpu", "aarch64-linux-gnu", features=("sve", "sve2"), attributes={"vl_bytes": 32}
+)
+_EXECUTION_MODE = os.environ.get("PYPTO_X_SVE_TEST_MODE", "qemu").strip().lower()
+if _EXECUTION_MODE not in ("native", "qemu"):
+    raise RuntimeError("PYPTO_X_SVE_TEST_MODE must be 'native' or 'qemu'")
+_CTYPES = {"float32": ctypes.c_float, "bf16": ctypes.c_uint16, "int8": ctypes.c_int8}
+_F32_SPECIAL = (
+    0x7F800001,  # signaling NaN, positive payload 1
+    0xFF800001,  # signaling NaN, negative payload 1
+    0x7F812345,
+    0xFF812345,
+    0x7FC00001,  # quiet NaN with payload
+    0xFFC12345,
+    0x7F800000,  # +inf
+    0xFF800000,  # -inf
+    0x00000001,  # subnormal
+    0x80000001,
+    0x7F7FFFFF,  # max finite
+    0x3F800000,
+    0xBF800000,
+    0x41200000,
+    0x00000000,
+)
+_BF16_SPECIAL = (
+    0x7F81,  # signaling NaN
+    0xFF81,
+    0x7FA1,
+    0xFFA1,
+    0x7FC1,  # quiet NaN
+    0xFFC1,
+    0x7F80,  # +inf
+    0xFF80,
+    0x0001,  # subnormal
+    0x8001,
+    0x7F7F,
+    0x3F80,
+    0xBF80,
+    0x4120,
+    0x0000,
+)
+
+
+@functools.lru_cache(maxsize=None)
+def _runtime():
+    runtime = Sve256Runtime(execution_mode=_EXECUTION_MODE)
+    if not runtime.is_available():
+        pytest.skip("SVE256 unavailable: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _raw_array(dtype, bits):
+    array = (_CTYPES[dtype] * len(bits))()
+    if dtype == "float32":
+        for index, value in enumerate(bits):
+            ctypes.memmove(
+                ctypes.addressof(array) + 4 * index, struct.pack("<I", int(value) & 0xFFFFFFFF), 4
+            )
+    elif dtype == "bf16":
+        for index, value in enumerate(bits):
+            ctypes.memmove(
+                ctypes.addressof(array) + 2 * index, struct.pack("<H", int(value) & 0xFFFF), 2
+            )
+    else:
+        for index, value in enumerate(bits):
+            ctypes.memmove(
+                ctypes.addressof(array) + index, struct.pack("<b", int(value)), 1
+            )
+    return array
+
+
+def _buffer_sha256(array):
+    return hashlib.sha256(
+        ctypes.string_at(ctypes.addressof(array), ctypes.sizeof(array))
+    ).hexdigest()
+
+
+def _descriptor(dtype, shape, array, readonly=False):
+    return TensorDesc(dtype, shape, handle=array, readonly=readonly)
+
+
+def _launch(runtime, artifact, inputs, outputs):
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_descriptor(dtype, shape, array, True) for dtype, shape, array in inputs],
+            outputs=[_descriptor(dtype, shape, array) for dtype, shape, array in outputs],
+        )
+    )
+
+
+def _compile_sve(program, tmp_path, name):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE256_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / name)},
+        ),
+    )
+    return target_ir, artifact
+
+
+def _compile_reference(program):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+
+
+def _assert_native_matches_reference(program, artifact, inputs, output_shapes, dtypes, tmp_path):
+    native = [_raw_array(dtype, [0] * element_count(shape)) for dtype, shape in zip(dtypes, output_shapes)]
+    reference = [
+        _raw_array(dtype, [0] * element_count(shape)) for dtype, shape in zip(dtypes, output_shapes)
+    ]
+    _launch(
+        _runtime(),
+        artifact,
+        inputs,
+        [(dtype, shape, array) for dtype, shape, array in zip(dtypes, output_shapes, native)],
+    )
+    _launch(
+        CpuScalarRuntime(),
+        _compile_reference(program),
+        inputs,
+        [(dtype, shape, array) for dtype, shape, array in zip(dtypes, output_shapes, reference)],
+    )
+    for left, right in zip(native, reference):
+        assert _buffer_sha256(left) == _buffer_sha256(right)
+
+
+def _pattern_bits(dtype, count, seed=1):
+    if dtype == "float32":
+        special = _F32_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 2654435761 + index * 2246822519) & 0xFFFFFFFF)
+            for index in range(count)
+        ]
+    if dtype == "bf16":
+        special = _BF16_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 40503 + index * 16411) & 0xFFFF)
+            for index in range(count)
+        ]
+    return [((seed * 37 + index * 91) % 255) - 127 for index in range(count)]
+
+
+# --------------------------------------------------------------------------
+# layout
+# --------------------------------------------------------------------------
+
+
+def _layout_program(name, input_shape, output_shape, attributes, dtype):
+    source = ValueRef("source", CoreType.tensor(dtype, input_shape))
+    output = ValueRef("output", CoreType.tensor(dtype, output_shape))
+    operation = Operation(name, (source,), (output,), dict(attributes))
+    return CoreProgram(
+        functions=(CoreFunction(name, (source,), (output,), Region((operation,))),)
+    )
+
+
+def _layout_cases():
+    """One entry per independent native-layout case: dtype/name/shapes/attrs."""
+
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append((dtype, "reshape", (3, 5), (5, 3), {"shape": [5, 3]}))
+        cases.append((dtype, "view", (2, 3, 4), (4, 6), {"shape": [4, 6]}))
+        cases.append((dtype, "contiguous", (2, 3), (2, 3), {}))
+        # Empty axes and odd (non 8/16-multiple) sizes.
+        cases.append((dtype, "reshape", (2, 0, 3), (0, 6), {"shape": [0, 6]}))
+        cases.append((dtype, "reshape", (7,), (7,), {"shape": [7]}))
+        # A batch prefix larger than one lane.
+        cases.append((dtype, "contiguous", (3, 5, 7), (3, 5, 7), {}))
+        # Rank-2 / rank-3 / rank-4 transposes with non-trivial permutations.
+        cases.append((dtype, "transpose", (5, 7), (7, 5), {"permutation": [1, 0]}))
+        cases.append((dtype, "transpose", (2, 3, 5), (5, 2, 3), {"permutation": [2, 0, 1]}))
+        cases.append((dtype, "transpose", (2, 3, 5), (3, 2, 5), {"permutation": [1, 0, 2]}))
+        cases.append((dtype, "transpose", (2, 3, 4, 5), (4, 5, 2, 3), {"permutation": [2, 3, 0, 1]}))
+        cases.append((dtype, "transpose", (1, 3, 2, 5), (5, 2, 3, 1), {"permutation": [3, 2, 1, 0]}))
+        # Unit and non-unit step slices, negative bounds, an empty slice.
+        cases.append((dtype, "slice", (4, 7), (2, 7), {"starts": [1, 0], "stops": [4, 7], "steps": [2, 1]}))
+        cases.append((dtype, "slice", (5, 7), (3, 2), {"starts": [0, 1], "stops": [5, 7], "steps": [2, 3]}))
+        cases.append(
+            (
+                dtype,
+                "slice",
+                (2, 4, 6),
+                (2, 2, 3),
+                {"starts": [0, 1, 0], "stops": [2, 4, 6], "steps": [1, 2, 2], "axes": [0, 1, 2]},
+            )
+        )
+        cases.append((dtype, "slice", (2, 5), (2, 2), {"starts": [-4], "stops": [-1], "axes": [-1], "steps": [2]}))
+        cases.append((dtype, "slice", (3, 5), (0, 5), {"starts": [2], "stops": [2], "steps": [1], "axes": [0]}))
+    return cases
+
+
+def test_layout_native_metadata_declares_the_executed_kernel(tmp_path):
+    program = _layout_program("reshape", (2, 6), (3, 4), {"shape": [3, 4]}, "float32")
+    target_ir, artifact = _compile_sve(program, tmp_path, "declared")
+    metadata = artifact.metadata
+    assert metadata["layout_native_kernel_version"] == LAYOUT_NATIVE_KERNEL_VERSION == 1
+    assert list(metadata["layout_native_dtypes"]) == list(LAYOUT_NATIVE_DTYPES) == [
+        "float32", "bf16", "int8"
+    ]
+    assert metadata["layout_descriptor_wire"] == "v4:pxld-v2+fnv1a64"
+    assert metadata["indexing_descriptor_wire"] == "v5:pxsp-pxct-pxix+fnv1a64"
+    assert _LAYOUT_WIRE_VERSION == 4 and _INDEXING_WIRE_VERSION == 5
+    assert metadata["artifact_payload_version"] == ARTIFACT_PAYLOAD_VERSION == 2
+    assert metadata["runner_protocol"] == RUNNER_PROTOCOL == "pypto-x.cpu.sve256.runner.v7"
+    assert list(metadata["layout_native_fallbacks"]) == []
+    entry = dict(metadata["layout_native_operations"][0])
+    assert entry["mode"] == LAYOUT_NATIVE_MODE
+    assert entry["kernel"] == "layout_f32"
+    assert entry["kind"] == "logical_layout_copy"
+    assert entry["dtype"] == "float32"
+    contract = layout_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None
+    assert contract["mode"] == entry["mode"]
+    assert contract["kernel"] == entry["kernel"]
+    assert contract["dtype"] == entry["dtype"]
+    assert contract["descriptor_digest"] == entry["descriptor_digest"]
+    assert layout_native_fallback_reason(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    ) is None
