+# --------------------------------------------------------------------------
+# split / concat
+# --------------------------------------------------------------------------
+
+
+def _split_program(input_shape, axis, sizes, dtype):
+    source = ValueRef("source", CoreType.tensor(dtype, input_shape))
+    outputs = []
+    for index, size in enumerate(sizes):
+        shape = list(input_shape)
+        shape[axis] = size
+        outputs.append(ValueRef("out{}".format(index), CoreType.tensor(dtype, tuple(shape))))
+    operation = Operation("split", (source,), tuple(outputs), {"axis": axis, "sizes": list(sizes)})
+    return CoreProgram(
+        functions=(CoreFunction("split", (source,), tuple(outputs), Region((operation,))),)
+    )
+
+
+def _split_cases():
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append((dtype, (6,), 0, [1, 2, 3]))
+        cases.append((dtype, (2, 5, 3), 1, [2, 3, 0]))
+        cases.append((dtype, (3, 4), 0, [1, 2]))
+        cases.append((dtype, (2, 4, 6), 2, [1, 3, 2]))
+        cases.append((dtype, (2, 7), 1, [7]))
+        cases.append((dtype, (3, 5), 0, [0, 3]))
+    return cases
+
+
+@pytest.mark.parametrize(
+    "dtype,input_shape,axis,sizes", _split_cases(), ids=lambda value: str(value)
+)
+def test_split_native_matches_host_reference_bitwise(dtype, input_shape, axis, sizes, tmp_path):
+    program = _split_program(input_shape, axis, sizes, dtype)
+    _target_ir, artifact = _compile_sve(program, tmp_path, "split-{}-{}".format(dtype, axis))
+    entries = [dict(entry) for entry in artifact.metadata["layout_native_operations"]]
+    assert len(entries) == 1
+    assert entries[0]["mode"] == LAYOUT_SPLIT_MODE
+    assert entries[0]["kind"] == "split"
+    assert entries[0]["kernel"] == "split_{}".format(
+        {"float32": "f32", "bf16": "bf16", "int8": "i8"}[dtype]
+    )
+    output_shapes = []
+    for size in sizes:
+        shape = list(input_shape)
+        shape[axis] = size
+        output_shapes.append(tuple(shape))
+    source = _raw_array(dtype, _pattern_bits(dtype, element_count(input_shape), seed=5))
+    _assert_native_matches_reference(
+        program, artifact, [(dtype, input_shape, source)], output_shapes, [dtype] * len(sizes), tmp_path
+    )
+
+
+def _concat_program(input_shapes, axis, dtype):
+    references = [
+        ValueRef("in{}".format(index), CoreType.tensor(dtype, shape))
+        for index, shape in enumerate(input_shapes)
+    ]
+    output_shape = list(input_shapes[0])
+    output_shape[axis] = sum(shape[axis] for shape in input_shapes)
+    output = ValueRef("output", CoreType.tensor(dtype, tuple(output_shape)))
+    operation = Operation("concat", tuple(references), (output,), {"axis": axis})
+    return CoreProgram(
+        functions=(
+            CoreFunction("concat", tuple(references), (output,), Region((operation,))),
+        )
+    )
+
+
+def _concat_cases():
+    cases = []
+    for dtype in ("float32", "bf16", "int8"):
+        cases.append((dtype, [(6,)], 0))
+        cases.append((dtype, [(2, 2, 3), (2, 3, 3)], 1))
+        cases.append((dtype, [(2, 4), (3, 4)], 0))
+        cases.append((dtype, [(2, 3, 2), (2, 3, 4)], 2))
+        cases.append((dtype, [(0, 4), (2, 4)], 0))
+    return cases
+
+
+@pytest.mark.parametrize("dtype,input_shapes,axis", _concat_cases(), ids=lambda value: str(value))
+def test_concat_native_matches_host_reference_bitwise(dtype, input_shapes, axis, tmp_path):
+    program = _concat_program(input_shapes, axis, dtype)
+    _target_ir, artifact = _compile_sve(program, tmp_path, "concat-{}-{}".format(dtype, axis))
+    entry = dict(artifact.metadata["layout_native_operations"][0])
+    assert entry["mode"] == LAYOUT_CONCAT_MODE
+    assert entry["kernel"] == "concat_{}".format(
+        {"float32": "f32", "bf16": "bf16", "int8": "i8"}[dtype]
+    )
+    inputs = []
+    for index, shape in enumerate(input_shapes):
+        bits = _pattern_bits(dtype, element_count(shape), seed=7 + index)
+        inputs.append((dtype, shape, _raw_array(dtype, bits)))
+    output_shape = list(input_shapes[0])
+    output_shape[axis] = sum(shape[axis] for shape in input_shapes)
+    _assert_native_matches_reference(
+        program, artifact, inputs, [tuple(output_shape)], [dtype], tmp_path
+    )
