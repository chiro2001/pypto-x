diff --git a/python/pypto/portable/qwen35.py b/python/pypto/portable/qwen35.py
index 3a5197efa..06864148a 100644
--- a/python/pypto/portable/qwen35.py
+++ b/python/pypto/portable/qwen35.py
@@ -711,6 +711,309 @@ def build_causal_mask(
     )
 
 
+def _qwen35_kernel_size(value: Any) -> int:
+    """Validate the fixed Qwen3.5 causal-convolution kernel size."""
+
+    if isinstance(value, bool) or not isinstance(value, int) or value != 4:
+        raise ValueError("Qwen3.5 causal Conv1D only supports kernel_size=4")
+    return value
+
+
+def _append_causal_conv1d_state(
+    builder: _Builder,
+    mixed_qkv: ValueRef,
+    prior_state: ValueRef,
+    weight: ValueRef,
+    dtype: str,
+    output_dtype: str,
+    batch: int,
+    channels: int,
+    steps: int,
+    kernel_size: int,
+    prefix: str,
+) -> Tuple[ValueRef, ValueRef]:
+    """Append the Qwen causal depthwise Conv1D graph to ``builder``.
+
+    ``mixed_qkv`` is ``[B,C,T]`` and ``prior_state`` is ``[B,C,K]``.  The
+    helper intentionally keeps the state transition in the graph: ``new_state``
+    is a slice of the concatenated input and is returned alongside the activated
+    output.  The four tap windows are written in the same order as PyTorch
+    cross-correlation; no kernel reversal is hidden in the lowering.
+    """
+
+    extended_shape = (batch, channels, kernel_size + steps)
+    output_shape = (batch, channels, steps)
+    state_shape = (batch, channels, kernel_size)
+
+    extended = builder.op(
+        "concat",
+        (prior_state, mixed_qkv),
+        ((prefix + "_extended", _tensor(dtype, extended_shape)),),
+        {"axis": -1},
+    )[0]
+    new_state = builder.op(
+        "slice",
+        (extended,),
+        ((prefix + "_new_state", _tensor(dtype, state_shape)),),
+        {
+            "starts": [steps],
+            "stops": [steps + kernel_size],
+            "axes": [-1],
+            "steps": [1],
+        },
+    )[0]
+
+    extended_f32 = _as_f32(builder, extended, dtype, prefix + "_extended")
+    weight_f32 = _as_f32(builder, weight, dtype, prefix + "_weight")
+    accumulated = None
+    for tap in range(kernel_size):
+        # For output time t, tap j reads extended[..., 1+j+t].  This is the
+        # cross-correlation order used by torch.nn.functional.conv1d.
+        window = builder.op(
+            "slice",
+            (extended_f32,),
+            ((prefix + "_window_{}".format(tap), _tensor("float32", output_shape)),),
+            {
+                "starts": [1 + tap],
+                "stops": [1 + tap + steps],
+                "axes": [-1],
+                "steps": [1],
+            },
+        )[0]
+        tap_weight = builder.op(
+            "slice",
+            (weight_f32,),
+            ((prefix + "_tap_{}".format(tap), _tensor("float32", (channels, 1))),),
+            {
+                "starts": [tap],
+                "stops": [tap + 1],
+                "axes": [-1],
+                "steps": [1],
+            },
+        )[0]
+        tap_weight = builder.op(
+            "reshape",
+            (tap_weight,),
+            ((prefix + "_tap_{}_reshaped".format(tap), _tensor("float32", (1, channels, 1))),),
+            {"shape": [1, channels, 1]},
+        )[0]
+        tap_weight_full = builder.op(
+            "broadcast",
+            (tap_weight,),
+            ((prefix + "_tap_{}_full".format(tap), _tensor("float32", output_shape)),),
+            {"shape": list(output_shape)},
+        )[0]
+        product = builder.op(
+            "mul",
+            (window, tap_weight_full),
+            ((prefix + "_product_{}".format(tap), _tensor("float32", output_shape)),),
+        )[0]
+        if accumulated is None:
+            accumulated = product
+        else:
+            accumulated = builder.op(
+                "add",
+                (accumulated, product),
+                ((prefix + "_accum_{}".format(tap), _tensor("float32", output_shape)),),
+            )[0]
+
+    # kernel_size is fixed to four by the public validator, so accumulated is
+    # always defined.  Keep the guard explicit for static type checkers and to
+    # make future changes fail loudly instead of silently producing host data.
+    if accumulated is None:
+        raise ValueError("causal Conv1D requires at least one tap")
+    activated = builder.op(
+        "silu",
+        (accumulated,),
+        ((prefix + "_silu", _tensor("float32", output_shape)),),
+    )[0]
+    output = _cast_from_f32(builder, activated, output_dtype, prefix + "_output")
+    return output, new_state
+
+
+def build_causal_conv1d_state(
+    mixed_shape: Sequence[int],
+    dtype: str = "bf16",
+    output_dtype: Optional[str] = None,
+    kernel_size: int = 4,
+) -> CoreProgram:
+    """Build Qwen3.5's functional depthwise causal Conv1D/state transition.
+
+    The input projection result and runtime weight use layouts ``[B,C,T]`` and
+    ``[C,K]``.  The prior state is ``[B,C,K]``.  The returned CoreProgram has
+    two pure SSA results ``(output, new_state)`` where ``new_state`` is the
+    final K values of ``concat(prior_state, mixed_qkv, axis=-1)``.  A single
+    graph therefore covers both prefill/chunk (``T>1``) and decode (``T=1``).
+
+    Qwen's checkpoint convolution has ``bias=False``.  There is deliberately no
+    bias parameter here; adding one would change the checkpoint contract.
+    """
+
+    mixed_shape = _shape(mixed_shape, "mixed_shape", rank=3)
+    batch, channels, steps = mixed_shape
+    if channels == 0:
+        raise ValueError("mixed_shape channel dimension must be positive")
+    kernel_size = _qwen35_kernel_size(kernel_size)
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    state_shape = (batch, channels, kernel_size)
+    weight_shape = (channels, kernel_size)
+    builder = _Builder("qwen35_causal_conv1d_state", "causal_conv1d_state", mixed_shape)
+    mixed_qkv = builder.parameter("mixed_qkv", _tensor(dtype, mixed_shape))
+    prior_state = builder.parameter("prior_state", _tensor(dtype, state_shape))
+    weight = builder.parameter("weight", _tensor(dtype, weight_shape))
+    output, new_state = _append_causal_conv1d_state(
+        builder,
+        mixed_qkv,
+        prior_state,
+        weight,
+        dtype,
+        output_dtype,
+        batch,
+        channels,
+        steps,
+        kernel_size,
+        "conv",
+    )
+    return builder.finish(
+        (output, new_state),
+        {
+            "formula": "silu(sum_j(extended[...,1+j:1+j+T] * weight[:,j]))",
+            "cross_correlation": True,
+            "weight_order": "torch_conv1d_cross_correlation_tap_0_to_tap_K_minus_1",
+            "kernel_size": kernel_size,
+            "bias": False,
+            "bias_semantics": "Qwen checkpoint conv1d bias=False; no bias input",
+            "state_transition": "new_state=concat(prior_state,mixed_qkv,axis=-1)[...,-K:]",
+            "state_semantics": "functional_pure_ssa_output",
+            "state_input": "prior_state",
+            "state_output": "new_state",
+            "prefill_decode_shared_graph": True,
+            "gdr_recurrent_state": "not_closed; separate recurrent state ABI",
+            "accumulation_dtype": "float32",
+            "fallbacks": [
+                "primitive_composition_not_fused",
+                "scalar_math_lane_fallback:silu",
+                "host_broadcast_pre_expansion",
+                "bf16_layout_reorder_scalar_fallback",
+                "split_wire_staging",
+                "python_list_wire_staging",
+            ],
+        },
+    )
+
+
+def build_causal_conv1d(
+    mixed_shape: Sequence[int],
+    dtype: str = "bf16",
+    output_dtype: Optional[str] = None,
+    kernel_size: int = 4,
+) -> CoreProgram:
+    """Compatibility spelling for :func:`build_causal_conv1d_state`."""
+
+    return build_causal_conv1d_state(mixed_shape, dtype, output_dtype, kernel_size)
+
+
+def build_qwen35_gated_delta_conv_state(
+    batch: int,
+    steps: int,
+    hidden: int = 1024,
+    channels: int = 6144,
+    dtype: str = "bf16",
+    output_dtype: Optional[str] = None,
+    kernel_size: int = 4,
+) -> CoreProgram:
+    """Connect a rank-2 in-projection to the functional Conv1D/state graph.
+
+    This is a small decoder connectivity harness, not the complete Gated
+    DeltaNet block.  ``hidden_states`` is flattened to ``[B*T,H]`` for the
+    existing rank-2 matmul, reshaped/transposed to ``mixed_qkv=[B,C,T]``, and
+    then passed to the same causal Conv1D builder logic.  The recurrent GDR
+    matrix state and its update remain explicitly outside this program.
+    """
+
+    if isinstance(batch, bool) or not isinstance(batch, int) or batch < 0:
+        raise ValueError("batch must be a non-negative integer")
+    if isinstance(steps, bool) or not isinstance(steps, int) or steps < 0:
+        raise ValueError("steps must be a non-negative integer")
+    if isinstance(hidden, bool) or not isinstance(hidden, int) or hidden <= 0:
+        raise ValueError("hidden must be a positive integer")
+    if isinstance(channels, bool) or not isinstance(channels, int) or channels <= 0:
+        raise ValueError("channels must be a positive integer")
+    kernel_size = _qwen35_kernel_size(kernel_size)
+    dtype = _dtype(dtype, "dtype")
+    output_dtype = _output_dtype(dtype, output_dtype)
+    rows = batch * steps
+    input_shape = (batch, steps, hidden)
+    mixed_shape = (batch, channels, steps)
+    state_shape = (batch, channels, kernel_size)
+    builder = _Builder("qwen35_gated_delta_conv_state", "gated_delta_conv_state", input_shape)
+    hidden_states = builder.parameter("hidden_states", _tensor(dtype, input_shape))
+    projection_weight = builder.parameter("in_proj_weight", _tensor(dtype, (hidden, channels)))
+    prior_state = builder.parameter("prior_state", _tensor(dtype, state_shape))
+    conv_weight = builder.parameter("conv_weight", _tensor(dtype, (channels, kernel_size)))
+    flattened = builder.op(
+        "reshape",
+        (hidden_states,),
+        (("hidden_states_flat", _tensor(dtype, (rows, hidden))),),
+        {"shape": [rows, hidden]},
+    )[0]
+    flattened_f32 = _as_f32(builder, flattened, dtype, "in_proj_input")
+    projection_f32 = _as_f32(builder, projection_weight, dtype, "in_proj_weight")
+    projected_f32 = builder.op(
+        "matmul",
+        (flattened_f32, projection_f32),
+        (("in_proj_output_f32", _tensor("float32", (rows, channels))),),
+    )[0]
+    projected = _cast_from_f32(builder, projected_f32, dtype, "in_proj_output")
+    projected_btc = builder.op(
+        "reshape",
+        (projected,),
