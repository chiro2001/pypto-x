+"""Qwen3.5 M1E causal Conv1D and functional state closure.
+
+The tests use synthetic tensors only.  They intentionally keep the convolution
+as the public Qwen contract: ``[B,C,T]`` input, ``[B,C,4]`` state, ``[C,4]``
+cross-correlation weights, SiLU after FP32 accumulation, and ``(output,
+new_state)`` as pure SSA returns.
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Iterable, List, Sequence, Tuple
+
+import pytest
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor, Sve256Runtime
+from pypto.compiler import CompileOptions
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.compiler.targets.cpu_sve256 import Sve256Compiler
+from pypto.core_ir import CoreProgram
+from pypto.portable.qwen35 import (
+    build_causal_conv1d_state,
+    build_qwen35_gated_delta_conv_state,
+)
+from pypto.target import TargetSpec
+
+
+SCALAR_TARGET = TargetSpec("cpu", "x86_64-linux-gnu")
+SVE_TARGET = TargetSpec(
+    "cpu",
+    "aarch64-linux-gnu",
+    features=("sve", "sve2"),
+    attributes={"vl_bytes": 32},
+)
+
+
+def _count(shape: Sequence[int]) -> int:
+    result = 1
+    for dimension in shape:
+        result *= dimension
+    return result
+
+
+def _rows(values: Sequence[float], shape: Tuple[int, ...]) -> Iterable[List[float]]:
+    width = shape[-1]
+    assert len(values) == _count(shape)
+    for offset in range(0, len(values), width):
+        yield list(values[offset:offset + width])
+
+
+def _silu(value: float) -> float:
+    if value >= 0.0:
+        return value / (1.0 + math.exp(-value))
+    exp_value = math.exp(value)
+    return value * exp_value / (1.0 + exp_value)
+
+
+def _conv_golden(
+    mixed: HostTensor,
+    prior_state: HostTensor,
+    weight: HostTensor,
+) -> Tuple[List[float], List[float]]:
+    batch, channels, steps = mixed.shape
+    kernel = weight.shape[-1]
+    output: List[float] = []
+    new_state: List[float] = []
+    mixed_values = mixed.flat()
+    state_values = prior_state.flat()
+    weight_values = weight.flat()
+    for batch_index in range(batch):
+        for channel in range(channels):
+            state_base = (batch_index * channels + channel) * kernel
+            mixed_base = (batch_index * channels + channel) * steps
+            extended = list(state_values[state_base:state_base + kernel])
+            extended.extend(mixed_values[mixed_base:mixed_base + steps])
+            new_state.extend(extended[-kernel:])
+            for step in range(steps):
+                accumulated = sum(
+                    float(extended[step + 1 + tap]) * float(weight_values[channel * kernel + tap])
+                    for tap in range(kernel)
+                )
+                output.append(_silu(accumulated))
+    return output, new_state
+
+
+def _compile_scalar(program: CoreProgram):
+    compiler = CpuScalarCompiler()
+    return compiler.compile(compiler.lower(program, SCALAR_TARGET))
+
+
+def _compile_sve(program: CoreProgram, tmp_path: Path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE_TARGET)
+    return compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+
+
+def _launch(artifact, inputs, outputs, runtime):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[item.descriptor(readonly=True) for item in inputs],
+            outputs=[item.descriptor() for item in outputs],
+        )
+    )
+
+
+def _assert_values(actual, expected, tolerance=0.035):
+    assert len(actual) == len(expected)
+    for left, right in zip(actual, expected):
+        assert math.isclose(float(left), float(right), rel_tol=tolerance, abs_tol=tolerance), (left, right)
+
+
+def test_causal_conv_contract_is_functional_and_cross_correlation():
+    program = build_causal_conv1d_state((1, 2, 3), dtype="bf16")
+    function = program.functions[0]
+    assert [ref.type.shape for ref in function.returns] == [(1, 2, 3), (1, 2, 4)]
+    assert [ref.type.dtype for ref in function.returns] == ["bf16", "bf16"]
+    assert program.metadata["cross_correlation"] is True
+    assert program.metadata["bias"] is False
+    assert program.metadata["state_semantics"] == "functional_pure_ssa_output"
+    assert program.metadata["prefill_decode_shared_graph"] is True
+    assert "conv1d" not in {operation.name for operation in function.body.operations}
+
+
+def test_causal_conv_prefill_and_decode_state_carry_three_way(tmp_path):
+    mixed = HostTensor("bf16", (1, 2, 3), [0.5, -1.0, 2.0, 1.5, -2.5, 3.0])
+    prior_state = HostTensor("bf16", (1, 2, 4), [0.25, -0.5, 1.0, -1.5, 2.0, -2.5, 3.0, -3.5])
+    weight = HostTensor("bf16", (2, 4), [0.5, -1.0, 1.5, -2.0, -0.25, 0.75, -1.25, 1.75])
+    expected_output, expected_state = _conv_golden(mixed, prior_state, weight)
+
+    prefill = build_causal_conv1d_state(mixed.shape, dtype="bf16")
+    scalar_output = HostTensor.zeros("bf16", mixed.shape)
+    scalar_state = HostTensor.zeros("bf16", prior_state.shape)
+    _launch(
+        _compile_scalar(prefill),
+        [mixed, prior_state, weight],
+        [scalar_output, scalar_state],
+        CpuScalarRuntime(),
+    )
+    _assert_values(scalar_output.flat(), HostTensor("bf16", mixed.shape, expected_output).flat())
+    _assert_values(scalar_state.flat(), HostTensor("bf16", prior_state.shape, expected_state).flat())
+
+    decode_mixed = HostTensor("bf16", (1, 2, 1), [-4.0, 5.0])
+    decode_expected_output, decode_expected_state = _conv_golden(decode_mixed, scalar_state, weight)
+    decode = build_causal_conv1d_state(decode_mixed.shape, dtype="bf16")
+    decode_output = HostTensor.zeros("bf16", decode_mixed.shape)
+    decode_state = HostTensor.zeros("bf16", prior_state.shape)
+    _launch(
+        _compile_scalar(decode),
+        [decode_mixed, scalar_state, weight],
+        [decode_output, decode_state],
+        CpuScalarRuntime(),
+    )
+    _assert_values(decode_output.flat(), HostTensor("bf16", decode_mixed.shape, decode_expected_output).flat())
+    _assert_values(decode_state.flat(), HostTensor("bf16", prior_state.shape, decode_expected_state).flat())
+
+    # The same two graphs are also compiled and executed by the real SVE256
+    # runner.  This test is intentionally run under the task resource wrapper
+    # because it invokes more than one QEMU case.
+    sve_prefill = _compile_sve(prefill, tmp_path / "prefill")
+    sve_output = HostTensor.zeros("bf16", mixed.shape)
+    sve_state = HostTensor.zeros("bf16", prior_state.shape)
+    _launch(
+        sve_prefill,
+        [mixed, prior_state, weight],
+        [sve_output, sve_state],
+        Sve256Runtime(execution_mode="qemu"),
+    )
+    _assert_values(sve_output.flat(), HostTensor("bf16", mixed.shape, expected_output).flat())
+    _assert_values(sve_state.flat(), HostTensor("bf16", prior_state.shape, expected_state).flat())
+
+    sve_decode = _compile_sve(decode, tmp_path / "decode")
+    sve_decode_output = HostTensor.zeros("bf16", decode_mixed.shape)
+    sve_decode_state = HostTensor.zeros("bf16", prior_state.shape)
+    _launch(
+        sve_decode,
+        [decode_mixed, sve_state, weight],
+        [sve_decode_output, sve_decode_state],
+        Sve256Runtime(execution_mode="qemu"),
+    )
+    _assert_values(
+        sve_decode_output.flat(),
+        HostTensor("bf16", decode_mixed.shape, decode_expected_output).flat(),
+    )
+    _assert_values(
+        sve_decode_state.flat(),
+        HostTensor("bf16", prior_state.shape, decode_expected_state).flat(),
+    )
+
+
+def test_gated_delta_conv_state_chain_matches_scalar_float32():
+    batch, steps, hidden, channels = 1, 2, 3, 4
+    program = build_qwen35_gated_delta_conv_state(
+        batch,
+        steps,
+        hidden=hidden,
+        channels=channels,
+        dtype="float32",
+    )
+    hidden_states = HostTensor(
+        "float32",
+        (batch, steps, hidden),
+        [0.5, -1.0, 2.0, 1.5, 0.25, -0.75],
+    )
+    projection_weight = HostTensor(
+        "float32",
+        (hidden, channels),
+        [
+            0.5, -0.5, 1.0, 0.25,
+            -1.0, 0.75, 0.5, -0.25,
+            0.25, 0.5, -0.75, 1.25,
+        ],
+    )
+    prior_state = HostTensor(
+        "float32",
+        (batch, channels, 4),
+        [0.0, 0.5, -1.0, 1.5, 2.0, -2.5, 3.0, -3.5, 0.25, -0.5, 0.75, -1.0, 1.25, -1.5, 1.75, -2.0],
+    )
+    conv_weight = HostTensor(
+        "float32",
+        (channels, 4),
+        [0.5, -1.0, 1.5, -2.0, -0.25, 0.75, -1.25, 1.75, 1.0, 0.5, -0.5, -1.0, -0.75, 1.25, 0.25, 0.5],
+    )
+    projected = []
+    for row in _rows(hidden_states.flat(), hidden_states.shape):
+        for column in range(channels):
+            projected.append(
+                sum(float(row[inner]) * float(projection_weight.flat()[inner * channels + column]) for inner in range(hidden))
+            )
+    mixed = HostTensor("float32", (batch, channels, steps), [projected[t * channels + c] for c in range(channels) for t in range(steps)])
+    expected_output, expected_state = _conv_golden(mixed, prior_state, conv_weight)
+    output = HostTensor.zeros("float32", mixed.shape)
+    state = HostTensor.zeros("float32", prior_state.shape)
+    _launch(
+        _compile_scalar(program),
+        [hidden_states, projection_weight, prior_state, conv_weight],
+        [output, state],
+        CpuScalarRuntime(),
+    )
+    _assert_values(output.flat(), expected_output, tolerance=2.0e-5)
+    _assert_values(state.flat(), expected_state, tolerance=2.0e-5)
+    assert program.metadata["gdr_recurrent_state"] == "not_closed; separate recurrent state ABI"
+
+
+def test_causal_conv_rejects_non_qwen_kernel_and_preserves_compact_sve_plan():
+    with pytest.raises(ValueError, match="kernel_size=4"):
+        build_causal_conv1d_state((1, 2, 1), kernel_size=3)
+    program = build_causal_conv1d_state((1, 6144, 1024), dtype="bf16")
+    target_ir = Sve256Compiler().lower(program, SVE_TARGET)
+    assert all(plan.iteration.compact for plan in target_ir.plans)
+    assert all(not plan.chunks for plan in target_ir.plans)
+    assert len(target_ir.vector_program.canonical_json()) < 100000
