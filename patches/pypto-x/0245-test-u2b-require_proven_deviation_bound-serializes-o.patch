From 4094334eb06d54678dbf72dba55a624b4f6a72ac Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Sat, 12 Sep 2026 18:14:01 +0800
Subject: [PATCH 245/254] test(u2b): require_proven_deviation_bound serializes
 only when enabled

---
 python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py b/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py
index 8bdf503ec..cafc9b45a 100644
--- a/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py
+++ b/python/tests/ut/pypto_x/test_execution_qmatmul_aocl.py
@@ -1002,3 +1002,32 @@ def test_strict_proven_bound_policy_vendor_snapshot_falls_back_to_portable():
     assert document["guarantees"]["exactness_envelope"]["deviation_bound_kind"] == "exact_contract_bound"
     reference = _portable_int32_reference(left, right)
     assert output.flat() == tuple(reference)
+
+
+def test_proven_bound_policy_field_roundtrips_through_json():
+    import json
+
+    from pypto.execution import policy_from_dict
+
+    policy = ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic", require_proven_deviation_bound=True),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=1),
+    )
+    rebuilt = policy_from_dict(json.loads(json.dumps(policy.to_dict())))
+    assert rebuilt.digest == policy.digest
+    assert rebuilt.numeric.require_proven_deviation_bound is True
+    plain = ExecutionPolicy(
+        profile="auto_static",
+        target="auto",
+        provider=ProviderPolicy(mode="vendor"),
+        numeric=NumericPolicy(requirement="deterministic"),
+        deterministic=True,
+        fallback=FallbackPolicy(mode="deny"),
+        resources=ResourcePolicy(max_threads=1),
+    )
+    assert "require_proven_deviation_bound" not in plain.to_dict()["numeric"]
