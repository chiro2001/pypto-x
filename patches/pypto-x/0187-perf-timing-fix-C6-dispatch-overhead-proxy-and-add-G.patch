+# --------------------------------------------------------------------------
+# GPU environment helpers
+# --------------------------------------------------------------------------
+
+
+def _run(command, timeout=30):
+    try:
+        completed = subprocess.run(
+            command, shell=True, capture_output=True, text=True, timeout=timeout
+        )
+        return {
+            "command": command,
+            "returncode": completed.returncode,
+            "stdout": completed.stdout.strip(),
+            "stderr": completed.stderr.strip(),
+        }
+    except Exception as exc:  # pragma: no cover - environment specific
+        return {"command": command, "error": "{}: {}".format(type(exc).__name__, exc)}
+
+
+def _nvidia_smi(query):
+    return _run("nvidia-smi --query-gpu={} --format=csv,noheader,nounits".format(query))
+
+
+def _gpu_fact(query):
+    result = _nvidia_smi(query)
+    if result.get("returncode") != 0:
+        return None
+    lines = [line.strip() for line in result.get("stdout", "").splitlines() if line.strip()]
+    return lines
+
+
+def _parse_first_float(lines):
+    if not lines:
+        return None
+    token = lines[0].split(",")[0].strip()
+    try:
+        return float(token)
+    except ValueError:
+        return None
+
+
+class ClockSampler(threading.Thread):
+    """Sample nvidia-smi clocks/utilization while the GPU is under load."""
+
+    def __init__(self, interval=0.4):
+        super().__init__(daemon=True)
+        self.interval = interval
+        self._stopped = threading.Event()
+        self.samples = []
+
+    def run(self):
+        while not self._stopped.is_set():
+            lines = _gpu_fact(
+                "clocks.current.sm,clocks.max.sm,utilization.gpu,memory.used,power.draw"
+            )
+            if lines:
+                parts = [part.strip() for part in lines[0].split(",")]
+                if len(parts) >= 5:
+                    try:
+                        self.samples.append(
+                            {
+                                "clocks_sm_mhz": float(parts[0]),
+                                "clocks_max_sm_mhz": float(parts[1]),
+                                "utilization_gpu_pct": float(parts[2]),
+                                "memory_used_mib": float(parts[3]),
+                                "power_draw_w": float(parts[4]),
+                                "t": round(time.time() - self._t0, 3) if hasattr(self, "_t0") else None,
+                            }
+                        )
+                    except ValueError:
+                        pass
+            self._stopped.wait(self.interval)
+
+    def stop(self):
+        self._stopped.set()
+
+
+def _fingerprint():
+    return {
+        "name_compute_cap": _gpu_fact("name,compute_cap,driver_version"),
+        "clocks": _gpu_fact("clocks.current.sm,clocks.max.sm,clocks.current.memory,clocks.max.memory,pstate"),
+        "memory": _gpu_fact("memory.used,memory.total"),
+        "utilization": _gpu_fact("utilization.gpu,utilization.memory,power.draw,power.limit,temperature.gpu"),
+        "compute_apps": _run(
+            "nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader"
+        ),
+        "cuda_version": _run("nvidia-smi --query-gpu=driver_version --format=csv,noheader"),
+        "nvcc": _run("nvcc --version | tail -2") if _which("nvcc") else {"error": "nvcc not found"},
+        "cublas_version": _run(
+            "grep -h -a CUBLAS_VERSION_MAJOR /usr/local/cuda/include/cublas_api.h | head -1; "
+            "ls /usr/local/cuda/lib64/libcublas.so.* 2>/dev/null | head -1"
+        ),
+    }
+
+
+def _which(name):
+    from shutil import which
+
+    return which(name)
+
