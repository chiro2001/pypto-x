+        and preflight_median is not None
+        and preflight_median > args.preflight_max_utilization_pct
+    ):
+        report["status"] = "PREFLIGHT_NOISY"
+        report["finished_at_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        _write(report, args.output)
+        print(
+            "preflight: median GPU utilization {:.1f}% > {:.1f}%; not measuring".format(
+                preflight_median, args.preflight_max_utilization_pct
+            )
+        )
+        return 3
+
+    # clock warmup payload: repeat the largest qmatmul case for >= 2 s
+    started = time.time()
+    warmup_case = None
+    largest_flops = -1.0
+    for case in cases:
+        if case["opcode"] != "qmatmul_s8s8_s32":
+            continue
+        flops = 2.0 * case["m"] * case["k"] * case["n"]
+        if flops > largest_flops:
+            largest_flops = flops
+            warmup_case = case
+    report["clock_warmup"] = {"requested_seconds": args.clock_warmup_seconds}
+    if warmup_case is not None:
+        artifact, plan, _target_ir = compile_case(compiler, warmup_case)
+        warmup_case["artifact"] = artifact
+        buffers, pointers = allocate_case_buffers(driver, runtime, plan, warmup_case)
+        try:
+            kernel, grid, block, parameters, _count = launch_plan_for_case(
+                runtime, plan, warmup_case, pointers
+            )
+            loaded = runtime._load_w8a8(artifact)
+            module = driver.module_load_data(loaded.ptx)
+            function = module.get_function(kernel)
+            sampler = ClockSampler(interval=0.4)
+            sampler._t0 = time.time()
+            sampler.start()
+            launches = 0
+            payload_started = time.time()
+            while time.time() - payload_started < max(0.0, args.clock_warmup_seconds):
+                driver.launch_kernel(function, grid, block, parameters, None, 0)
+                launches += 1
+                if launches % 32 == 0:
+                    driver.context_synchronize()
+            driver.context_synchronize()
+            payload_seconds = time.time() - payload_started
+            sampler.stop()
+            sampler.join(timeout=5)
+
+            # wall-clock agreement on a workload-bearing span large enough that
