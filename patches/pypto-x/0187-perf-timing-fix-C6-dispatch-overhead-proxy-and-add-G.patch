+            )
+            report["wall_agreement"] = wall_agreement
+        finally:
+            buffers.free()
+    report["gpu_fingerprint_during"] = _fingerprint()
+
+    # in-window rate calibration: two different known gaps per window give both
+    # the platform rate and a linearity check (B3a gate: spread <= 3%,
+    # linearity <= 3%, corrected-vs-host-wall <= 5%).
+    calibration_start = {
+        "gap_a": _rate_calibration(driver, args.rate_gap, args.rate_rounds),
+        "gap_b": _rate_calibration(driver, args.rate_gap * 2.0, args.rate_rounds),
+    }
+    report["rate_calibration_start"] = calibration_start
+
+    # GPU-wide utilization/memory sampler covering the whole measurement window
+    run_sampler = ClockSampler(interval=1.0)
+    run_sampler._t0 = time.time()
+    run_sampler.start()
+
+    # compile + measure every case
+    measured_cases = []
+    for index, case in enumerate(cases, 1):
+        artifact, plan, _target_ir = compile_case(compiler, case)
+        case["artifact"] = artifact
+        buffers, pointers = allocate_case_buffers(driver, runtime, plan, case)
+        started_case = time.time()
+        try:
+            record = run_case_measurement(
+                runtime,
+                driver,
+                plan,
+                case,
+                buffers,
+                pointers,
+                args.rounds,
+                args.warmup,
+                args.batch_repeats,
+            )
+            record.update(
+                {
+                    "case_id": case["case_id"],
+                    "opcode": case["opcode"],
+                    "m": case["m"],
+                    "k": case["k"],
+                    "n": case["n"],
+                    "w8j_row_name": case["w8j_row_name"],
+                    "seconds": round_sig(time.time() - started_case),
+                }
+            )
+            measured_cases.append(record)
+            median = statistics.median(record["measured_kernel_seconds"])
+            print(
+                "[{:2d}/{:2d}] {} median={:.6g} s".format(
+                    index, len(cases), case["case_id"], median
+                ),
+                file=sys.stderr,
+            )
+        finally:
+            buffers.free()
+
+    report["cases"] = measured_cases
+
+    # representative dispatch overhead (public entry points)
+    if not args.skip_dispatch:
+        proxy = TimingProxy(driver)
+        proxy_runtime = CudaRuntime(driver=proxy, device_index=args.gpu_index)
+        # reuse the context the direct measurement already created; a second
+        # cuCtxCreate would add a context for no measurement value.
+        proxy_runtime._context = runtime._context
+        dispatch = []
+        for opcode in opcodes:
+            candidate = None
+            for item in cases:
+                if (
+                    item["opcode"] == opcode
+                    and item["m"] == 1
+                    and item["k"] == 1024
+                    and item["n"] == 32
+                ):
+                    candidate = item
+                    break
+            if candidate is None or not candidate.get("artifact"):
+                dispatch.append(
+                    {"opcode": opcode, "skipped": "representative shape not in the selected case set"}
+                )
+                continue
+            try:
+                dispatch.append(
+                    dispatch_overhead(
+                        proxy_runtime, proxy, candidate["artifact"], candidate, args.dispatch_rounds
+                    )
+                )
+            except Exception as exc:
+                dispatch.append(
+                    {
+                        "opcode": opcode,
+                        "case_id": candidate["case_id"],
+                        "error": "{}: {}".format(type(exc).__name__, exc),
+                    }
+                )
+        report["dispatch_overhead"] = dispatch
+
+    # vendor two-pass + bf16 baseline
+    if not args.skip_vendor:
+        report["vendor_two_pass"] = run_vendor_comparison(
+            driver, runtime, compiler, cases, args.rounds, args.warmup
+        )
+
+    # end-window rate calibration + long-batch wall agreement
+    calibration_end = {
+        "gap_a": _rate_calibration(driver, args.rate_gap, args.rate_rounds),
+        "gap_b": _rate_calibration(driver, args.rate_gap * 2.0, args.rate_rounds),
+    }
+    run_sampler.stop()
+    run_sampler.join(timeout=10)
+    report["gpu_samples_during_measurement"] = run_sampler.samples
+    utilizations = [
+        sample["utilization_gpu_pct"]
+        for sample in run_sampler.samples
+        if sample.get("utilization_gpu_pct") is not None
+    ]
+    memories = [
+        sample["memory_used_mib"]
+        for sample in run_sampler.samples
+        if sample.get("memory_used_mib") is not None
+    ]
+    report["window_contamination"] = {
+        "utilization_gpu_pct_samples": utilizations,
+        "utilization_gpu_pct_median": round_sig(statistics.median(utilizations))
+        if utilizations
+        else None,
+        "utilization_gpu_pct_max": max(utilizations) if utilizations else None,
+        "memory_used_mib_samples": memories,
+        "memory_used_mib_min": min(memories) if memories else None,
+        "memory_used_mib_max": max(memories) if memories else None,
+        "shared_window": bool(utilizations and statistics.median(utilizations) > 20.0),
+        "note": (
+            "GPU-wide nvidia-smi samples from inside WSL; on this shared GamePC they include "
+            "the owner's Windows graphics/VR workload, which is not attributed to a compute app"
+        ),
+    }
+    report["rate_calibration_end"] = calibration_end
+    report["gpu_fingerprint_after"] = _fingerprint()
+    report["finished_at_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    report["status"] = "OK"
+    report["load_seconds"] = round_sig(time.time() - started)
+
+    blocks = [
+        window[key]
+        for window in (calibration_start, calibration_end)
+        for key in ("gap_a", "gap_b")
+    ]
+    rates = [block["median_rate"] for block in blocks if block.get("median_rate")]
+    if rates:
+        window_rate = statistics.median(rates)
+        gaps_a = [window["gap_a"]["median_rate"] for window in (calibration_start, calibration_end)]
+        gaps_b = [window["gap_b"]["median_rate"] for window in (calibration_start, calibration_end)]
+        linearity_pct = (
+            abs(statistics.median(gaps_a) - statistics.median(gaps_b)) / window_rate * 100.0
+        )
+        batch_agreements = []
+        for case in measured_cases:
+            batch = case.get("batch") or {}
+            if batch.get("span_seconds") and batch.get("host_wall_seconds"):
+                corrected = batch["span_seconds"] * window_rate
+                batch_agreements.append(
+                    abs(corrected - batch["host_wall_seconds"]) / batch["host_wall_seconds"] * 100.0
+                )
+        report["rate_calibration_window"] = {
+            "window_rate_median": round_sig(window_rate),
+            "rate_offset_pct": round_sig((window_rate - 1.0) * 100.0),
+            "rate_spread_pct": round_sig(
+                (max(rates) - min(rates)) / window_rate * 100.0 if len(rates) > 1 else 0.0
+            ),
+            "linearity_pct": round_sig(linearity_pct),
+            "corrected_wall_agreement_pct": round_sig(
+                statistics.median(batch_agreements) if batch_agreements else None
+            ),
+            "corrected_wall_agreement_pct_max": round_sig(
+                max(batch_agreements) if batch_agreements else None
+            ),
+            "batch_agreement_samples_pct": [round_sig(value) for value in batch_agreements],
+            "note": "corrected kernel_seconds = raw x window_rate_median",
+        }
+
+    _write(report, args.output)
+    print("wrote {}".format(args.output))
+    return 0
+
+
+def _write(report, path):
+    output = Path(path)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, sort_keys=False, ensure_ascii=False)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
