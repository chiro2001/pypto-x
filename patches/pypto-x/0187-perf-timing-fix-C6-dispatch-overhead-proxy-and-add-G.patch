+            clock_values = [s["clocks_sm_mhz"] for s in sampler.samples if s.get("clocks_sm_mhz")]
+            max_values = [s["clocks_max_sm_mhz"] for s in sampler.samples if s.get("clocks_max_sm_mhz")]
+            clock_max = max(max_values) if max_values else None
+            clock_median = statistics.median(clock_values) if clock_values else None
+            clock_ratio = (clock_median / clock_max) if clock_median and clock_max else None
+            report["clock_warmup"].update(
+                {
+                    "seconds_actual": round_sig(payload_seconds),
