+# --------------------------------------------------------------------------
+# small statistics helpers (protocol 3.3 / ERR-0004)
+# --------------------------------------------------------------------------
+
+
+def percentile_nearest_rank(values, fraction):
+    ordered = sorted(values)
+    if not ordered:
+        return None
+    rank = max(1, int(math.ceil(fraction * len(ordered))))
+    return ordered[min(rank, len(ordered)) - 1]
+
+
+def mad(values):
+    if not values:
+        return None
+    centre = statistics.median(values)
+    return statistics.median([abs(value - centre) for value in values])
+
+
+def round_sig(value, digits=9):
+    if value is None:
+        return None
+    return round(float(value), digits)
+
+
+def stats_block(values):
+    """Descriptive statistics + ERR-0004 outlier marking for one sample list."""
+
+    samples = [float(value) for value in values]
+    median = statistics.median(samples)
+    dispersion = statistics.stdev(samples) if len(samples) > 1 else 0.0
+    median_mad = mad(samples)
+    floor = max(1e-6, 0.02 * median)  # protocol floor: max(1 us, 2% x median)
+    threshold = max(3.0 * 1.4826 * median_mad, floor)
+    outliers = [index for index, value in enumerate(samples) if abs(value - median) > threshold]
+    outlier_ratio = len(outliers) / len(samples) if samples else None
+    return {
+        "n": len(samples),
+        "min": round_sig(min(samples)),
+        "median": round_sig(median),
+        "p95_nearest_rank": round_sig(percentile_nearest_rank(samples, 0.95)),
+        "max": round_sig(max(samples)),
+        "stdev": round_sig(dispersion),
+        "cv": round_sig(dispersion / median if median else None),
+        "p95_over_median": round_sig(
+            percentile_nearest_rank(samples, 0.95) / median if median else None
+        ),
+        "mad": round_sig(median_mad),
+        "outlier_floor_seconds": round_sig(floor, 12),
+        "outlier_threshold_seconds": round_sig(threshold, 12),
+        "outlier_indices": outliers,
+        "outlier_ratio": round_sig(outlier_ratio),
+        "samples": [round_sig(value, 12) for value in samples],
+    }
+
+
+# --------------------------------------------------------------------------
+# W8A8 Core IR program builders (byte-for-byte the device-validation builders)
+# --------------------------------------------------------------------------
+
+
+def _program(parameters, returns, operations, name="main"):
+    from pypto.core_ir import CoreFunction, CoreProgram, Region
+
+    return CoreProgram(
+        functions=(CoreFunction(name, tuple(parameters), tuple(returns), Region(tuple(operations))),)
+    )
+
+
+def _tensor(name, dtype, shape):
+    from pypto.core_ir import CoreType, ValueRef
+
+    return ValueRef(name, CoreType.tensor(dtype, shape))
+
+
+def _qmatmul_program(left_shape, right_shape):
+    from pypto.core_ir import Operation
+
+    left = _tensor("left", "int8", left_shape)
+    right = _tensor("right", "int8", right_shape)
+    output = _tensor("output", "int32", left_shape[:-2] + (left_shape[-2], right_shape[-1]))
+    return _program((left, right), (output,), (Operation("qmatmul_s8s8_s32", (left, right), (output,)),))
+
+
+def _dequantize_program(shape, rows):
+    from pypto.core_ir import Operation
+
+    codes = _tensor("codes", "int8", shape)
+    scales = _tensor("scales", "float32", (rows,))
+    output = _tensor("output", "float32", shape)
+    return _program((codes, scales), (output,), (Operation("dequantize_s8", (codes, scales), (output,)),))
+
+
+def _epilogue_program(shape):
+    from pypto.core_ir import Operation
+
+    rows, columns = shape
+    accumulator = _tensor("accumulator", "int32", shape)
+    row_scales = _tensor("row_scales", "float32", (rows,))
+    column_scales = _tensor("column_scales", "float32", (columns,))
+    output = _tensor("output", "bf16", shape)
+    return _program(
+        (accumulator, row_scales, column_scales),
+        (output,),
+        (Operation("dequantize_epilogue_bf16", (accumulator, row_scales, column_scales), (output,)),),
+    )
+
+
+def _quantize_program(shape, dtype="float32"):
+    from pypto.core_ir import Operation
+
+    values = _tensor("values", dtype, shape)
+    codes = _tensor("codes", "int8", shape)
+    scales = _tensor("scales", "float32", (shape[0],))
+    return _program((values,), (codes, scales), (Operation("quantize_per_token_s8", (values,), (codes, scales)),))
+
+
+TARGET_SPEC = ("gpu", "gpu-neutral")
+
+
+def _target():
+    from pypto.target import TargetSpec
+
+    return TargetSpec(*TARGET_SPEC)
