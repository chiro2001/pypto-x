+                    )
+                except (ValueError, IndexError):
+                    pass
+            time.sleep(1.0)
+    preflight_utils = [sample["utilization_gpu_pct"] for sample in preflight]
+    preflight_median = statistics.median(preflight_utils) if preflight_utils else None
+    report["gpu_preflight"] = {
+        "samples": preflight,
+        "utilization_gpu_pct_median": round_sig(preflight_median),
+        "utilization_gpu_pct_max": max(preflight_utils) if preflight_utils else None,
