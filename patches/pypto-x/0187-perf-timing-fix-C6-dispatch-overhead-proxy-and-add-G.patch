+        _write(report, args.output)
+        print("build-only: {} artifacts compiled".format(len(built)))
+        return 0
+
+    if str(REPO_ROOT / "python") not in sys.path:
+        sys.path.insert(0, str(REPO_ROOT / "python"))
+
+    from pypto.backends.cuda import CudaDriver, CudaRuntime
+    from pypto.compiler.targets.cuda_w8a8 import CudaW8A8Compiler
+
+    driver = CudaDriver()
