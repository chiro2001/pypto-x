+# ---------------------------------------------------------------------------
+# round 3 (verify-0044 claim 5): report copies must equal the embedded payload
+# ---------------------------------------------------------------------------
+def _select_rule(document):
+    return next(rule for rule in document["resolution"]["rules"] if rule.get("rule") == "provider.select")
+
+
+def _mutate_numeric_class_order(document):
+    forged = ["forged_a", "forged_b"]
+    document["resolution"]["numeric_class_order"] = forged
+    _select_rule(document)["details"]["numeric_class_order"] = list(forged)
+
+
+def _mutate_tie_break(document):
+    forged = ["forged_a", "forged_b"]
+    document["resolution"]["tie_break"] = forged
+    _select_rule(document)["details"]["tie_break"] = list(forged)
+
+
+def _mutate_fallback_chain(document):
+    truth = document["plan_payload"]["document"]["fallback"]["chain"]
+    forged = list(truth) + ["vendor:forged-not-registered"]
+    document["resolution"]["fallback_chain"] = list(forged)
+    document["resolved_policy"]["fallback"]["chain"] = list(forged)
+    document["dispatch"]["chain_position"] = forged.index(document["dispatch"]["provider_invoked"])
+
+
+def _mutate_fallback_primary(document):
+    document["resolution"]["fallback_primary"] = "vendor:aocl-lpgemm-f32"
+    document["resolved_policy"]["fallback"]["primary"] = "vendor:aocl-lpgemm-f32"
+    _select_rule(document)["details"]["primary"] = "vendor:aocl-lpgemm-f32"
+    # keep the in-document fallback_used relation self-consistent so only the
+    # payload preimage can refuse the document
+    document["resolution"]["fallback_used"] = True
+    document["resolved_policy"]["fallback"]["used"] = True
+    document["dispatch"]["fallback_used"] = True
+    _select_rule(document)["details"]["fallback_used"] = True
+
+
+def _mutate_fallback_degraded(document):
+    document["resolved_policy"]["fallback"]["degraded"] = True
+    _select_rule(document)["details"]["degraded"] = True
+
+
