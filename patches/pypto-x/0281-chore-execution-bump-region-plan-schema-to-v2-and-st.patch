+# ---------------------------------------------------------------------------
+# round-3: schema version discipline and structured empty operations
+# ---------------------------------------------------------------------------
+ROUND1_LEGACY_REGION_DIGEST = (
+    "sha256:626cc90818994798451647617f6508068f426957705f80119ec51d9fd5b98b90"
+)
+
+
+def test_v1_region_plan_is_refused_with_a_named_error():
+    plan = plan_region(_exp_reshape_program())
+    genuine = plan.to_dict()
+    assert genuine["region_schema_version"] == 2
+    assert genuine["region_digest"] != ROUND1_LEGACY_REGION_DIGEST
+
+    legacy = json.loads(json.dumps(genuine))
+    legacy["region_schema_version"] = 1
+    # keep the round-1 digest so the fixture is a faithful "old document"
+    legacy["region_digest"] = ROUND1_LEGACY_REGION_DIGEST
+    legacy["region_id"] = "region." + ROUND1_LEGACY_REGION_DIGEST.split(":", 1)[1][:16]
+    for re_resolve in (False, True):
+        error = _expected_error(
+            ArtifactMismatchError,
+            lambda legacy=legacy, re_resolve=re_resolve: validate_region_plan(
+                legacy,
+                policy=plan.policy,
+                capability=plan.capability,
+                re_resolve=re_resolve,
+            ),
+        )
+        assert error.reason == "region_schema_version_legacy"
+        assert error.field == "region_plan.region_schema_version"
+        assert error.requested == 1
+        assert error.available == 2
+
+    # v2 documents are accepted (structural + replay)
+    assert validate_region_plan(
+        genuine, policy=plan.policy, capability=plan.capability, re_resolve=True
+    ) == genuine
+
+
+def test_empty_operations_document_is_refused_with_a_named_error():
+    plan = plan_region(_exp_reshape_program())
+    genuine = plan.to_dict()
+    empty = json.loads(json.dumps(genuine))
+    empty["operations"] = []
+    empty["op_count"] = 0
+    empty["boundary_signature"] = {"entry_inputs": [], "exit_outputs": []}
+    empty["region_spec"] = {"kind": "program", "function": None}
+    _resign_region_document(empty)
+
+    error = _expected_error(
+        ArtifactMismatchError,
+        lambda: validate_region_plan(
+            empty, policy=plan.policy, capability=plan.capability, re_resolve=True
+        ),
+    )
+    assert error.reason == "region_operations_empty"
+    assert error.field == "region_plan.operations"
+
+    # without re-signing the public digest the tamper is caught earlier
+    unsigned = json.loads(json.dumps(empty))
+    unsigned["region_digest"] = genuine["region_digest"]
+    unsigned["region_id"] = genuine["region_id"]
+    error = _expected_error(
+        ArtifactMismatchError,
+        lambda: validate_region_plan(
+            unsigned, policy=plan.policy, capability=plan.capability, re_resolve=True
+        ),
+    )
+    assert error.reason == "region_digest_mismatch"
+
+
