@@ -0,0 +1,198 @@
+"""W2 Ascend adapter seam tests.
+
+These tests exercise only the dependency-injected seam.  They deliberately do
+not import CANN, torch_npu or model weights, and therefore cannot be used as a
+claim of CCE/NPU compatibility.
+"""
+
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+
+def _import_contracts():
+    repository_root = Path(__file__).resolve().parents[4]
+    package_root = repository_root / "python" / "pypto"
+    saved_modules = {
+        name: module
+        for name, module in sys.modules.items()
+        if name == "pypto" or name.startswith("pypto.")
+    }
+    for name in list(saved_modules):
+        del sys.modules[name]
+    package = types.ModuleType("pypto")
+    package.__path__ = [str(package_root)]
+    package.__package__ = "pypto"
+    sys.modules["pypto"] = package
+    try:
+        from pypto.abi import Availability, LaunchRequest, TensorDesc
+        from pypto.compiler import Artifact, CompileOptions, compile_program
+        from pypto.compiler.targets.ascend import create_ascend_backend
+        from pypto.backends.ascend import (
+            AscendArtifactPayload,
+            AscendBackend,
+            AscendCompilerBackend,
+            AscendCompilerHooks,
+            AscendRuntimeHooks,
+        )
+        from pypto.target import BackendContractError, BackendUnavailableError, TargetSpec
+
+        return locals()
+    finally:
+        for name in list(sys.modules):
+            if name == "pypto" or name.startswith("pypto."):
+                del sys.modules[name]
+        sys.modules.update(saved_modules)
+
+
+_C = _import_contracts()
+Artifact = _C["Artifact"]
+AscendArtifactPayload = _C["AscendArtifactPayload"]
+AscendBackend = _C["AscendBackend"]
+AscendCompilerBackend = _C["AscendCompilerBackend"]
+AscendCompilerHooks = _C["AscendCompilerHooks"]
+AscendRuntimeHooks = _C["AscendRuntimeHooks"]
+Availability = _C["Availability"]
+BackendContractError = _C["BackendContractError"]
+BackendUnavailableError = _C["BackendUnavailableError"]
+CompileOptions = _C["CompileOptions"]
+LaunchRequest = _C["LaunchRequest"]
+TargetSpec = _C["TargetSpec"]
+TensorDesc = _C["TensorDesc"]
+compile_program = _C["compile_program"]
+create_ascend_backend = _C["create_ascend_backend"]
+
+
+def _target():
+    return TargetSpec("ascend", "aarch64-linux-gnu", features=("aiv",))
+
+
+class FakeHooks:
+    def __init__(self):
+        self.calls = []
+
+    def availability(self):
+        return Availability.yes("fake-ascend")
+
+    def lower(self, program, target):
+        self.calls.append(("lower", program, target))
+        return {"fake_ir": program}
+
+    def compile(self, target_ir, options):
+        self.calls.append(("compile", target_ir, options))
+        return AscendArtifactPayload(
+            format="fake-ascend-binary",
+            entrypoint="qwen_kernel",
+            payload=b"fake-binary",
+            metadata={"source": "fake-hook"},
+            opaque={"vendor_handle": "private"},
+        )
+
+    def load(self, artifact):
+        self.calls.append(("load", artifact))
+        assert artifact.opaque == {"vendor_handle": "private"}
+        return "loaded-handle"
+
+    def workspace_size(self, request, loaded):
+        self.calls.append(("workspace", request, loaded))
+        return 128
+
+    def launch(self, request, loaded):
+        self.calls.append(("launch", request, loaded))
+        return "launched"
+
+
+def test_fake_hook_compiler_and_runtime_order_and_artifact_conversion():
+    hooks = FakeHooks()
+    backend = AscendBackend(hooks)
+    target = _target()
+    artifact = compile_program(
+        backend,
+        "core-program",
+        target,
+        CompileOptions(artifact_format="fake-ascend-binary"),
+    )
+
+    assert isinstance(artifact, Artifact)
+    assert artifact.format == "fake-ascend-binary"
+    assert artifact.target == target
+    assert artifact.payload == b"fake-binary"
+    assert artifact.metadata["source"] == "fake-hook"
+    assert not hasattr(artifact, "ub")
+    assert not hasattr(artifact, "aic")
+    assert not hasattr(artifact, "pipe")
+
+    inputs = [TensorDesc("bf16", (2, 2), address=11, readonly=True)]
+    outputs = [TensorDesc("bf16", (2, 2), address=12)]
+    request = LaunchRequest(artifact, inputs=inputs, outputs=outputs)
+    assert backend.load(artifact) == "loaded-handle"
+    assert backend.workspace_size(request) == 128
+    assert backend.launch(request) == "launched"
+    assert [call[0] for call in hooks.calls] == [
+        "lower",
+        "compile",
+        "load",
+        "workspace",
+        "launch",
+    ]
+    assert hooks.calls[1][2].artifact_format == "fake-ascend-binary"
+    assert hooks.calls[3][2] == "loaded-handle"
+    assert hooks.calls[4][2] == "loaded-handle"
+
+
+def test_compiler_requires_its_private_lowered_wrapper():
+    hooks = FakeHooks()
+    backend = AscendCompilerBackend(hooks)
+    with pytest.raises(BackendContractError, match="AscendLoweredProgram"):
+        backend.compile("raw-ir")
+
+
+def test_runtime_requires_load_before_workspace_or_launch():
+    hooks = FakeHooks()
+    backend = AscendBackend(hooks)
+    artifact = compile_program(
+        backend,
+        "core-program",
+        _target(),
+        CompileOptions(artifact_format="fake-ascend-binary"),
+    )
+    request = LaunchRequest(
+        artifact,
+        inputs=[TensorDesc("bf16", (1,), address=1)],
+        outputs=[TensorDesc("bf16", (1,), address=2)],
+    )
+    with pytest.raises(BackendContractError, match="loaded artifact"):
+        backend.workspace_size(request)
+    with pytest.raises(BackendContractError, match="loaded artifact"):
+        backend.launch(request)
+
+
+def test_default_backend_is_structurally_unavailable_without_explicit_hook():
+    backend = create_ascend_backend()
+    status = backend.availability()
+    assert not status.available
+    assert status.reason_code in {
+        "missing_toolkit",
+        "missing_device_runtime",
+        "integration_hook_not_configured",
+    }
+    assert "integration" in status.details
+    with pytest.raises(BackendUnavailableError) as error:
+        backend.lower("program", _target())
+    assert error.value.code == status.reason_code
+
+
+def test_hook_protocols_do_not_add_vendor_fields_to_public_descriptors():
+    assert isinstance(FakeHooks(), AscendCompilerHooks)
+    assert isinstance(FakeHooks(), AscendRuntimeHooks)
+    target_fields = set(TargetSpec.__dataclass_fields__)
+    tensor_fields = set(TensorDesc.__dataclass_fields__)
+    artifact_fields = set(Artifact.__dataclass_fields__)
+    forbidden = {"ub", "l0", "aic", "aiv", "mte", "pipe", "regtensor", "vf"}
+    assert not forbidden.intersection(target_fields)
+    assert not forbidden.intersection(tensor_fields)
+    assert not forbidden.intersection(artifact_fields)
