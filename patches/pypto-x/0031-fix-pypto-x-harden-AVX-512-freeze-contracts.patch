+VNNI_INT32_MAX = (1 << 31) - 1
+VNNI_MAX_SAFE_LENGTH = VNNI_INT32_MAX // (255 * 128)
+
+
+def _strict_vnni_values(values: Sequence[int], name: str, lower: int, upper: int) -> Tuple[int, ...]:
+    if isinstance(values, (str, bytes, bytearray, Mapping)):
+        raise CpuAvx512ExecutionError("VNNI {} must be an integer sequence".format(name))
+    try:
+        result = tuple(values)
+    except TypeError as exc:
+        raise CpuAvx512ExecutionError("VNNI {} must be an integer sequence".format(name)) from exc
+    if len(result) > VNNI_MAX_SAFE_LENGTH:
+        raise CpuAvx512ExecutionError(
+            "VNNI input length {} exceeds int32-safe maximum {}".format(
+                len(result), VNNI_MAX_SAFE_LENGTH
+            )
+        )
+    for index, value in enumerate(result):
+        if isinstance(value, bool) or not isinstance(value, Integral):
+            raise CpuAvx512ExecutionError("VNNI {}[{}] must be an integer".format(name, index))
+        if int(value) < lower or int(value) > upper:
+            raise CpuAvx512ExecutionError(
+                "VNNI {}[{}] is outside [{}, {}]".format(name, index, lower, upper)
+            )
+    return tuple(int(value) for value in result)
+
 
