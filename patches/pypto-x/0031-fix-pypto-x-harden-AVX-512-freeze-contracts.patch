+def _program_digest_from_metadata(metadata: Mapping[str, Any], context: str) -> str:
+    program_data = metadata.get("program")
+    digest = metadata.get("program_digest")
+    if not isinstance(program_data, Mapping) or not isinstance(digest, str):
+        raise CpuAvx512ArtifactError("{} is missing CoreProgram digest metadata".format(context))
+    try:
+        program = CoreProgram.from_dict(program_data)
+    except Exception as exc:
+        raise CpuAvx512ArtifactError("{} CoreProgram metadata is invalid".format(context)) from exc
+    actual = hashlib.sha256(program.canonical_json().encode("utf-8")).hexdigest()
+    if actual != digest:
+        raise CpuAvx512ArtifactError("{} CoreProgram digest is inconsistent".format(context))
+    return digest
