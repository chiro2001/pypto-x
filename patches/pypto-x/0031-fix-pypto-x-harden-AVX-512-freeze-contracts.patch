+def _validate_fallback_artifact(primary: Artifact, fallback: Artifact) -> None:
+    """Validate fallback identity without mapping its native shared object."""
+
+    if not isinstance(fallback, Artifact):
+        raise CpuAvx512ArtifactError("fallback must be an Artifact")
+    try:
+        primary.validate()
+        fallback.validate()
+    except Exception as exc:
+        raise CpuAvx512ArtifactError("fallback artifact validation failed: {}".format(exc)) from exc
+    if fallback.format not in (DEFAULT_ARTIFACT_FORMAT, DEFAULT_AVX2_ARTIFACT_FORMAT):
+        raise CpuAvx512ArtifactError("unsupported fallback artifact format {!r}".format(fallback.format))
+    if fallback.entrypoint != primary.entrypoint:
+        raise CpuAvx512ArtifactError("fallback entrypoint does not match primary artifact")
+    if fallback.abi_version != primary.abi_version or fallback.abi_version != ABI_VERSION:
+        raise CpuAvx512ArtifactError("fallback ABI does not match primary artifact")
+    if fallback.target.kind != "cpu" or primary.target.kind != "cpu":
+        raise CpuAvx512ArtifactError("fallback and primary must target CPU")
+    if fallback.target.triple != primary.target.triple:
+        raise CpuAvx512ArtifactError("fallback CPU triple does not match primary artifact")
+    primary_metadata = mapping_copy(primary.metadata)
+    fallback_metadata = mapping_copy(fallback.metadata)
+    if fallback_metadata.get("entrypoint") != fallback.entrypoint:
+        raise CpuAvx512ArtifactError("fallback metadata entrypoint is inconsistent")
+    primary_digest = _program_digest_from_metadata(primary_metadata, "primary artifact")
+    fallback_digest = _program_digest_from_metadata(fallback_metadata, "fallback artifact")
+    if fallback_digest != primary_digest:
+        raise CpuAvx512ArtifactError("fallback CoreProgram digest does not match primary artifact")
+    if fallback.format == DEFAULT_ARTIFACT_FORMAT:
+        if fallback_metadata.get("backend") != AVX512_BACKEND:
+            raise CpuAvx512ArtifactError("fallback AVX-512 backend metadata is invalid")
+    elif fallback_metadata.get("backend") != "cpu.avx2":
+        raise CpuAvx512ArtifactError("fallback AVX2 backend metadata is invalid")
+
