From 46810de0b154018f568e45f841e832786cddef15 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Thu, 10 Sep 2026 23:07:51 +0800
Subject: [PATCH 108/134] fix(pypto-x): skip non-chrome JSON in W8I CSV
 extractor

---
 tools/a2_vllm_ascend_profiling/extract_csv.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tools/a2_vllm_ascend_profiling/extract_csv.py b/tools/a2_vllm_ascend_profiling/extract_csv.py
index 43e230c0e..ab928227d 100644
--- a/tools/a2_vllm_ascend_profiling/extract_csv.py
+++ b/tools/a2_vllm_ascend_profiling/extract_csv.py
@@ -189,6 +189,10 @@ def shrink_to_limit(path, max_bytes):
 def process_torch_trace(path, outdir, max_rows, max_bytes, prefix):
     with open_text(path) as handle:
         data = json.load(handle)
+    if not isinstance(data, dict) or "traceEvents" not in data:
+        # Ascend profiler 目录里还有 sample.json / info.json / trace_view.json 等
+        # 非 chrome trace 的 JSON；显式跳过而不是报错或产出 0 行。
+        return None
     events = data.get("traceEvents") or []
     aggregate, anomalies, event_count = summarize_trace_events(events)
     buckets = sorted(aggregate.values(), key=lambda item: -item["self_us"])
@@ -437,6 +441,8 @@ def process_file(path, outdir, max_rows, max_bytes, prefix):
     if lower.endswith(".json") or lower.endswith(".json.gz"):
         try:
             info = process_torch_trace(path, outdir, max_rows, max_bytes, prefix)
+            if info is None:
+                return {"kind": "skipped", "source": path, "reason": "无 traceEvents"}
             return info
         except (json.JSONDecodeError, UnicodeDecodeError):
             return {"kind": "skipped", "source": path, "reason": "json 解析失败"}
