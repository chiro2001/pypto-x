From 3f3bec2bb5747d0bc38c1e7ba6c71ea8590f43fb Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 02:23:33 +0800
Subject: [PATCH 178/235] probe(axis-b-a3-runtime): pass transposed int8 weight
 view (stride(0)==1) to onednn handler

---
 scripts/a3_axis_b_runtime/06_int8_probe.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/scripts/a3_axis_b_runtime/06_int8_probe.py b/scripts/a3_axis_b_runtime/06_int8_probe.py
index 803dab497..48ae197b7 100755
--- a/scripts/a3_axis_b_runtime/06_int8_probe.py
+++ b/scripts/a3_axis_b_runtime/06_int8_probe.py
@@ -93,10 +93,10 @@ def main():
         torch.manual_seed(7)
         M, K, N = 8, 64, 16
         a = torch.randn(M, K, dtype=torch.float32) * 0.7
-        w = torch.randint(-127, 127, (K, N), dtype=torch.int8)
+        w = torch.randint(-127, 127, (N, K), dtype=torch.int8).t()  # [K,N], stride(0)==1
         w_scales = (torch.rand(N, 1, dtype=torch.float32) + 0.5) * 0.03
         codes, y, ref, handler = _onednn_scaled_mm(w, w_scales, a)
-        report["gemm_shapes"] = {"codes": list(codes.shape), "w": list(w.shape),
+        report["gemm_shapes"] = {"codes": list(codes.shape), "w": list(w.shape), "w_stride": list(w.stride()),
                                  "w_scales": list(w_scales.shape), "out": list(y.shape)}
         return {"out_dtype": str(y.dtype),
                 "max_abs_diff_vs_dequant_int8_ref": float((y - ref).abs().max()),
@@ -108,7 +108,7 @@ def main():
         torch.manual_seed(11)
         M, K, N = 64, 256, 256
         a = torch.randn(M, K, dtype=torch.float32) * 0.5
-        w = torch.randint(-127, 127, (K, N), dtype=torch.int8)
+        w = torch.randint(-127, 127, (N, K), dtype=torch.int8).t()  # [K,N], stride(0)==1
         w_scales = (torch.rand(N, 1, dtype=torch.float32) + 0.5) * 0.02
         codes, y, ref, handler = _onednn_scaled_mm(w, w_scales, a)
         M2, K2 = a.shape
