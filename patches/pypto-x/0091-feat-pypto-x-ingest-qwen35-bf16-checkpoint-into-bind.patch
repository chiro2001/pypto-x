+    file_nbytes = checkpoint_path.stat().st_size
+    peak_rss_bytes = (vm_hwm_kib or rss_after_hash_kib) * 1024
+    hash_chunk_bytes = args.hash_chunk_mib * 1024 * 1024
+    largest_source_read = max(item.source_nbytes for item in converted)
+    reader_phase_delta_kib = max(rss_after_open_kib, rss_after_mapping_kib, rss_after_hash_kib) - rss_after_graph_kib
+    wall_seconds = time.time() - started
+    cpu_seconds = sum(resource.getrusage(resource.RUSAGE_SELF)[:2])
+    checks["peak_rss_below_half_checkpoint_file"] = peak_rss_bytes * 2 < file_nbytes
