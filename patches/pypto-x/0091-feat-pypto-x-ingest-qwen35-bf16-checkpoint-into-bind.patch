+"""无第三方依赖的 safetensors 只读读取器。
+
+该模块只做一件事：把 safetensors 的 8 字节 header 长度 + JSON header 解析成
+经过完整结构校验的 tensor 目录，并在调用方需要时给出**只读** ``memoryview``
+切片。它不导入 numpy/torch，也从不把数据段整体物化成 Python 对象或 ``bytes``：
+
+* ``mode="mmap"``（默认）用 ``mmap.ACCESS_READ`` 映射整个文件，切片是零拷贝视图；
+* ``mode="pread"`` 只预读 header，之后按需 ``os.pread`` 出请求的那一段。
+
+两份实现都只按调用方给出的范围触碰数据段，因此进程峰值 RSS 与文件大小无关。
+``sha256()`` 是例外中唯一需要顺序读完文件的接口，它使用固定大小缓冲区流式读取。
+
+校验是 fail-closed 的，异常类型分工如下：
+
+* :class:`SafetensorsFormatError`：header/JSON/dtype/shape/重复键等结构性错误；
+* :class:`SafetensorsBoundsError`：offset 越过文件或切片请求越界；
+* :class:`SafetensorsLayoutError`：数据段 offset 空洞、重叠或总长不一致。
+
+``FP8_*`` 不在本模块承诺的 dtype 集合内，遇到时按不支持 dtype 拒绝。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import mmap
+import os
+import struct
+from dataclasses import dataclass
+from typing import Any, Dict, Mapping, Optional, Tuple
+
+SAFETENSORS_HEADER_BYTES = 8
+DEFAULT_MAX_HEADER_BYTES = 128 * 1024 * 1024
+DEFAULT_HASH_CHUNK_BYTES = 8 * 1024 * 1024
+SUPPORTED_MODES = ("mmap", "pread")
+
+#: safetensors dtype -> (itemsize, PyPTO-X canonical dtype name)
+SAFETENSORS_DTYPES = {
+    "BOOL": (1, "bool"),
+    "U8": (1, "uint8"),
+    "I8": (1, "int8"),
+    "I16": (2, "int16"),
+    "U16": (2, "uint16"),
+    "F16": (2, "float16"),
+    "BF16": (2, "bf16"),
+    "I32": (4, "int32"),
+    "U32": (4, "uint32"),
+    "F32": (4, "float32"),
+    "I64": (8, "int64"),
+    "U64": (8, "uint64"),
+    "F64": (8, "float64"),
+}
+
+_METADATA_KEY = "__metadata__"
+
+
+class SafetensorsError(ValueError):
+    """safetensors 读取失败基类。"""
+
+
+class SafetensorsFormatError(SafetensorsError):
+    """header、JSON、dtype 或 shape 不符合 safetensors 契约。"""
+
+
+class SafetensorsBoundsError(SafetensorsError):
+    """offset 或切片请求越过文件边界。"""
+
+
+class SafetensorsLayoutError(SafetensorsError):
+    """数据段 offset 存在空洞、重叠或总长与文件不一致。"""
+
+
+class SafetensorsClosedError(SafetensorsError):
+    """读取器已关闭后继续使用。"""
+
+
+def _reject_duplicate_keys(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise SafetensorsFormatError(
+                "safetensors header contains duplicate key {!r}".format(key)
+            )
+        result[key] = value
+    return result
+
+
+def _checked_non_negative_int(value: Any, field_name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise SafetensorsFormatError("{} must be a non-negative integer".format(field_name))
+    return value
+
+
+def _checked_shape(value: Any, field_name: str) -> Tuple[int, ...]:
+    if isinstance(value, (str, bytes)):
+        raise SafetensorsFormatError("{} must be a sequence of non-negative integers".format(field_name))
+    try:
+        dimensions = tuple(value)
+    except TypeError as exc:
+        raise SafetensorsFormatError(
+            "{} must be a sequence of non-negative integers".format(field_name)
+        ) from exc
+    for index, dimension in enumerate(dimensions):
+        _checked_non_negative_int(dimension, "{}[{}]".format(field_name, index))
+    return dimensions
+
+
+def element_count(shape: Tuple[int, ...]) -> int:
+    """返回 shape 的元素数；空 shape（标量）为 1。"""
+
+    total = 1
+    for dimension in shape:
+        total *= dimension
+    return total
+
+
+@dataclass(frozen=True)
+class SafetensorsTensor:
+    """一个经过校验的 tensor 目录项。"""
+
+    name: str
+    dtype: str
+    pypto_dtype: str
+    shape: Tuple[int, ...]
+    elements: int
+    itemsize: int
+    data_offset: int
+    nbytes: int
+    header_nbytes: int
+
+    @property
+    def file_offset(self) -> int:
+        """该 tensor 在文件中的绝对起始字节。"""
+
+        return SAFETENSORS_HEADER_BYTES + self.header_nbytes + self.data_offset
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "name": self.name,
+            "dtype": self.dtype,
+            "pypto_dtype": self.pypto_dtype,
+            "shape": list(self.shape),
+            "elements": self.elements,
+            "itemsize": self.itemsize,
+            "data_offset": self.data_offset,
+            "file_offset": self.file_offset,
+            "nbytes": self.nbytes,
+        }
+
+
+def _parse_header(raw_header: bytes) -> Tuple[Dict[str, SafetensorsTensor], Dict[str, str], int]:
+    try:
+        text = raw_header.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise SafetensorsFormatError("safetensors header is not valid UTF-8") from exc
+    try:
+        header = json.loads(text, object_pairs_hook=_reject_duplicate_keys)
+    except SafetensorsFormatError:
+        raise
+    except ValueError as exc:
+        raise SafetensorsFormatError("safetensors header is not valid JSON") from exc
+    if not isinstance(header, dict):
+        raise SafetensorsFormatError("safetensors header must be a JSON object")
+
+    metadata: Dict[str, str] = {}
+    raw_metadata = header.pop(_METADATA_KEY, None)
+    if raw_metadata is not None:
+        if not isinstance(raw_metadata, dict):
+            raise SafetensorsFormatError("safetensors __metadata__ must be a JSON object")
+        for key, value in raw_metadata.items():
+            if not isinstance(value, str):
+                raise SafetensorsFormatError("safetensors __metadata__ values must be strings")
+            metadata[key] = value
+
+    header_nbytes = len(raw_header)
+    tensors: Dict[str, SafetensorsTensor] = {}
+    for name, entry in header.items():
+        if not isinstance(name, str) or not name:
+            raise SafetensorsFormatError("safetensors tensor names must be non-empty strings")
+        if not isinstance(entry, dict):
+            raise SafetensorsFormatError("safetensors tensor {!r} must be a JSON object".format(name))
+        unknown = set(entry) - {"dtype", "shape", "data_offsets"}
+        if unknown:
+            raise SafetensorsFormatError(
+                "safetensors tensor {!r} has unknown fields {}".format(name, sorted(unknown))
+            )
+        for field_name in ("dtype", "shape", "data_offsets"):
+            if field_name not in entry:
+                raise SafetensorsFormatError(
+                    "safetensors tensor {!r} is missing {}".format(name, field_name)
+                )
+        dtype = entry["dtype"]
+        if not isinstance(dtype, str) or dtype not in SAFETENSORS_DTYPES:
+            raise SafetensorsFormatError(
+                "safetensors tensor {!r} uses unsupported dtype {!r}".format(name, dtype)
+            )
+        itemsize, pypto_dtype = SAFETENSORS_DTYPES[dtype]
+        shape = _checked_shape(entry["shape"], "{}.shape".format(name))
+        offsets = entry["data_offsets"]
+        if isinstance(offsets, (str, bytes)):
+            raise SafetensorsFormatError("safetensors tensor {!r}.data_offsets must be a sequence".format(name))
+        try:
+            offsets = tuple(offsets)
+        except TypeError as exc:
+            raise SafetensorsFormatError(
+                "safetensors tensor {!r}.data_offsets must be a sequence".format(name)
+            ) from exc
+        if len(offsets) != 2:
+            raise SafetensorsFormatError(
+                "safetensors tensor {!r}.data_offsets must contain exactly two integers".format(name)
+            )
+        begin = _checked_non_negative_int(offsets[0], "{}.data_offsets[0]".format(name))
+        end = _checked_non_negative_int(offsets[1], "{}.data_offsets[1]".format(name))
+        if begin > end:
+            raise SafetensorsFormatError(
+                "safetensors tensor {!r} has inverted data_offsets {} > {}".format(name, begin, end)
+            )
+        elements = element_count(shape)
+        expected_nbytes = elements * itemsize
+        if end - begin != expected_nbytes:
+            raise SafetensorsFormatError(
+                "safetensors tensor {!r} dtype/shape require {} bytes but data_offsets span {}".format(
+                    name, expected_nbytes, end - begin
+                )
+            )
+        tensors[name] = SafetensorsTensor(
+            name, dtype, pypto_dtype, shape, elements, itemsize, begin, expected_nbytes, header_nbytes
+        )
+    return tensors, metadata, header_nbytes
+
+
+def _validate_data_layout(tensors: Mapping[str, SafetensorsTensor], data_nbytes: int) -> None:
+    """校验数据段被 tensor 范围**恰好**覆盖：无空洞、无重叠、总长一致。"""
+
+    ranges = sorted((tensor.data_offset, tensor.data_offset + tensor.nbytes, tensor.name) for tensor in tensors.values())
+    cursor = 0
+    for begin, end, name in ranges:
+        if end > data_nbytes:
+            raise SafetensorsBoundsError(
+                "safetensors tensor {!r} ends at {} beyond data section of {} bytes".format(name, end, data_nbytes)
+            )
+        if begin < cursor:
+            raise SafetensorsLayoutError(
+                "safetensors tensor {!r} at [{}, {}) overlaps previous range ending at {}".format(
+                    name, begin, end, cursor
+                )
+            )
+        if begin > cursor:
+            raise SafetensorsLayoutError(
+                "safetensors data section has a {} byte gap before tensor {!r}".format(begin - cursor, name)
+            )
+        cursor = end
+    if cursor != data_nbytes:
+        raise SafetensorsLayoutError(
+            "safetensors tensors cover {} bytes but data section is {} bytes".format(cursor, data_nbytes)
+        )
+
+
+class SafetensorsReader:
+    """只读 safetensors 句柄；支持上下文管理器，必须显式 ``close()``。
+
+    已返回的 ``memoryview`` 会持有底层 mmap，必须在 ``close()`` 之前释放，
+    否则 CPython 会以 ``BufferError`` 拒绝关闭映射——这是有意的 fail-closed
+    行为，避免调用方在视图仍存活时悄悄换掉 backing store。
+    """
+
+    def __init__(self, path: str, mode: str = "mmap", max_header_bytes: int = DEFAULT_MAX_HEADER_BYTES):
+        if mode not in SUPPORTED_MODES:
+            raise SafetensorsError("mode must be one of {}".format(SUPPORTED_MODES))
+        if isinstance(max_header_bytes, bool) or not isinstance(max_header_bytes, int) or max_header_bytes <= 0:
+            raise SafetensorsError("max_header_bytes must be a positive integer")
+        self._path = os.fspath(path)
+        self._mode = mode
+        self._fd = -1
+        self._mmap = None
+        self._closed = False
+        self._tensors: Dict[str, SafetensorsTensor] = {}
+        self._metadata: Dict[str, str] = {}
+        self._file_nbytes = 0
+        self._header_nbytes = 0
+        fd = os.open(self._path, os.O_RDONLY)
+        try:
+            self._load(fd, max_header_bytes)
+            if mode == "mmap":
+                self._mmap = mmap.mmap(fd, 0, access=mmap.ACCESS_READ)
+        except BaseException:
+            os.close(fd)
+            raise
+        self._fd = fd
+
+    def _load(self, fd: int, max_header_bytes: int) -> None:
+        stat = os.fstat(fd)
+        self._file_nbytes = stat.st_size
+        if self._file_nbytes < SAFETENSORS_HEADER_BYTES:
+            raise SafetensorsFormatError("safetensors file is shorter than the 8 byte length prefix")
+        prefix = os.pread(fd, SAFETENSORS_HEADER_BYTES, 0)
+        if len(prefix) != SAFETENSORS_HEADER_BYTES:
+            raise SafetensorsFormatError("safetensors file is truncated before the header length")
+        (header_nbytes,) = struct.unpack("<Q", prefix)
+        if header_nbytes < 2:
+            raise SafetensorsFormatError("safetensors header length {} is too small".format(header_nbytes))
+        if header_nbytes > max_header_bytes:
+            raise SafetensorsFormatError(
+                "safetensors header length {} exceeds limit {}".format(header_nbytes, max_header_bytes)
+            )
+        if SAFETENSORS_HEADER_BYTES + header_nbytes > self._file_nbytes:
+            raise SafetensorsBoundsError(
+                "safetensors header of {} bytes does not fit in {} byte file".format(header_nbytes, self._file_nbytes)
+            )
+        raw_header = os.pread(fd, header_nbytes, SAFETENSORS_HEADER_BYTES)
+        if len(raw_header) != header_nbytes:
+            raise SafetensorsFormatError("safetensors header is truncated")
+        tensors, metadata, header_nbytes = _parse_header(raw_header)
+        self._tensors = tensors
+        self._metadata = metadata
+        self._header_nbytes = header_nbytes
+        _validate_data_layout(tensors, self.data_nbytes)
+
+    # -- 只读属性 ---------------------------------------------------------
+
+    @property
+    def path(self) -> str:
+        return self._path
+
+    @property
+    def mode(self) -> str:
+        return self._mode
+
+    @property
+    def file_nbytes(self) -> int:
+        return self._file_nbytes
+
+    @property
+    def header_nbytes(self) -> int:
+        return self._header_nbytes
+
+    @property
+    def data_offset(self) -> int:
+        """数据段在文件中的绝对起始字节。"""
+
+        return SAFETENSORS_HEADER_BYTES + self._header_nbytes
+
+    @property
+    def data_nbytes(self) -> int:
+        return self._file_nbytes - SAFETENSORS_HEADER_BYTES - self._header_nbytes
+
+    @property
+    def header_aligned(self) -> bool:
+        """``8 + header_nbytes`` 是否为 8 的倍数（参考实现的 padding 约定）。"""
+
+        return self.data_offset % 8 == 0
+
+    @property
+    def metadata(self) -> Mapping[str, str]:
+        return dict(self._metadata)
+
+    @property
+    def names(self) -> Tuple[str, ...]:
+        return tuple(self._tensors)
+
+    def __len__(self) -> int:
+        return len(self._tensors)
+
+    def __contains__(self, name: Any) -> bool:
+        return name in self._tensors
+
+    def tensors(self) -> Mapping[str, SafetensorsTensor]:
+        """返回 name -> 目录项的浅拷贝。"""
+
+        return dict(self._tensors)
+
+    def info(self, name: str) -> SafetensorsTensor:
+        try:
+            return self._tensors[name]
+        except KeyError as exc:
+            raise SafetensorsError("safetensors file has no tensor {!r}".format(name)) from exc
+
+    def total_nbytes(self, names: Optional[Tuple[str, ...]] = None) -> int:
+        if names is None:
+            names = self.names
+        return sum(self.info(name).nbytes for name in names)
+
+    # -- 数据访问 ---------------------------------------------------------
+
+    def _require_open(self) -> None:
+        if self._closed:
+            raise SafetensorsClosedError("safetensors reader for {!r} is closed".format(self._path))
+
+    def view(self, name: str) -> memoryview:
+        """返回该 tensor 的只读 ``memoryview``；零拷贝（mmap）或单次按需读（pread）。"""
+
+        tensor = self.info(name)
+        return self.view_range(name, 0, tensor.nbytes)
+
+    def view_range(self, name: str, byte_offset: int, nbytes: int) -> memoryview:
+        """返回 tensor 内 ``[byte_offset, byte_offset + nbytes)`` 的只读视图。"""
+
+        self._require_open()
+        tensor = self.info(name)
+        _checked_non_negative_int(byte_offset, "byte_offset")
+        _checked_non_negative_int(nbytes, "nbytes")
+        if byte_offset > tensor.nbytes or nbytes > tensor.nbytes - byte_offset:
+            raise SafetensorsBoundsError(
+                "requested [{}, {}) exceeds tensor {!r} of {} bytes".format(
+                    byte_offset, byte_offset + nbytes, name, tensor.nbytes
+                )
+            )
+        start = tensor.file_offset + byte_offset
+        if self._mode == "mmap":
+            return memoryview(self._mmap)[start : start + nbytes]
+        chunk = os.pread(self._fd, nbytes, start)
+        if len(chunk) != nbytes:
+            raise SafetensorsBoundsError(
+                "short read of {} bytes for tensor {!r}".format(nbytes, name)
+            )
+        return memoryview(chunk)
+
+    def sha256(self, chunk_bytes: int = DEFAULT_HASH_CHUNK_BYTES) -> str:
+        """流式计算文件 sha256；峰值额外内存恒为 ``chunk_bytes``。"""
+
+        self._require_open()
+        if isinstance(chunk_bytes, bool) or not isinstance(chunk_bytes, int) or chunk_bytes <= 0:
+            raise SafetensorsError("chunk_bytes must be a positive integer")
+        digest = hashlib.sha256()
+        offset = 0
+        while offset < self._file_nbytes:
+            chunk = os.pread(self._fd, min(chunk_bytes, self._file_nbytes - offset), offset)
+            if not chunk:
+                raise SafetensorsBoundsError("short read while hashing {!r}".format(self._path))
+            digest.update(chunk)
+            offset += len(chunk)
+        return digest.hexdigest()
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        if self._mmap is not None:
+            self._mmap.close()
+            self._mmap = None
+        if self._fd >= 0:
+            os.close(self._fd)
+            self._fd = -1
+
+    def __enter__(self) -> "SafetensorsReader":
+        self._require_open()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "path": self._path,
+            "mode": self._mode,
+            "file_nbytes": self._file_nbytes,
+            "header_nbytes": self._header_nbytes,
+            "data_nbytes": self.data_nbytes,
+            "header_aligned": self.header_aligned,
+            "tensor_count": len(self._tensors),
+            "metadata": dict(self._metadata),
+        }
+
+
+def read_tensor_catalog(path: str, mode: str = "pread") -> Mapping[str, SafetensorsTensor]:
+    """便捷函数：只解析目录后关闭句柄，不保留任何数据视图。"""
+
+    with SafetensorsReader(path, mode=mode) as reader:
+        return reader.tensors()
diff --git a/python/tests/ut/pypto_x/qwen35_weight_fixture.py b/python/tests/ut/pypto_x/qwen35_weight_fixture.py
new file mode 100644
index 000000000..20dd9d087
--- /dev/null
+++ b/python/tests/ut/pypto_x/qwen35_weight_fixture.py
@@ -0,0 +1,173 @@
+"""权重摄取测试用的合成 safetensors fixture 与真实资源定位。
+
+本模块只被测 safetensors/layout 测试使用，不被 pytest 收集（文件名不以
+``test_`` 开头）。合成 checkpoint 的官方张量名由 **graph metadata 的
+``layers[].parameter_routes``** 独立推导，而不是复用
+:mod:`pypto.portable.qwen35_weight_map` 的展开逻辑，避免用被测模块证明它自己。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import struct
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple
+
+from pypto.portable.safetensors_reader import SAFETENSORS_DTYPES
+
+#: 固定 revision 的真实权重资产目录（只读；不进 Git）。
+REAL_ASSET_REVISION = "2fc06364715b967f1860aea9cf38778875588b17"
+REAL_ASSET_RELPATH = "worktrees/_meta/pypto-x/assets/qwen35-0.8b/" + REAL_ASSET_REVISION
+REAL_SAFETENSORS_NAME = "model.safetensors-00001-of-00001.safetensors"
+REAL_SAFETENSORS_SHA256 = "04b1c301231dd422b8860db31311ab2721511346a32cb1e079c4c4e5f1fe4696"
+REAL_SAFETENSORS_BYTES = 1746942600
+
+_ENV_ASSET_DIR = "PYPTO_X_QWEN35_ASSET_DIR"
+
+
+def real_asset_dir() -> Optional[Path]:
+    """返回真实权重目录；不存在时返回 ``None``（调用方据此 skip）。"""
+
+    override = os.environ.get(_ENV_ASSET_DIR)
+    if override:
+        candidate = Path(override)
+        return candidate if (candidate / REAL_SAFETENSORS_NAME).is_file() else None
+    current = Path(__file__).resolve()
+    for parent in current.parents:
+        candidate = parent / REAL_ASSET_RELPATH
+        if (candidate / REAL_SAFETENSORS_NAME).is_file():
+            return candidate
+    return None
+
+
+def payload_for(name: str, nbytes: int) -> bytes:
+    """确定性伪随机 payload；只用于合成小文件。"""
+
+    seed = hashlib.sha256(name.encode("utf-8")).digest()
+    return (seed * (nbytes // len(seed) + 1))[:nbytes]
+
+
+def write_safetensors(
+    path: Path,
+    tensors: Sequence[Tuple[str, str, Sequence[int]]],
+    *,
+    metadata: Optional[Mapping[str, str]] = None,
+) -> Dict[str, Any]:
+    """写入一个合法的合成 safetensors 文件，返回 name -> header 条目。
+
+    header 与真实 safetensors 一样用空格 padding 到 8 字节对齐。
+    """
+
+    header: Dict[str, Any] = {}
+    if metadata:
+        header["__metadata__"] = dict(metadata)
+    body = bytearray()
+    offset = 0
+    for name, dtype, shape in tensors:
+        if dtype not in SAFETENSORS_DTYPES:
+            raise AssertionError("unsupported fixture dtype {!r}".format(dtype))
+        itemsize = SAFETENSORS_DTYPES[dtype][0]
+        elements = 1
+        for dimension in shape:
+            elements *= int(dimension)
+        nbytes = elements * itemsize
+        header[name] = {
+            "dtype": dtype,
+            "shape": [int(dimension) for dimension in shape],
+            "data_offsets": [offset, offset + nbytes],
+        }
+        body.extend(payload_for(name, nbytes))
+        offset += nbytes
+    raw_header = json.dumps(header, sort_keys=True).encode("utf-8")
+    raw_header += b" " * ((-(8 + len(raw_header))) % 8)
+    with open(str(path), "wb") as stream:
+        stream.write(struct.pack("<Q", len(raw_header)))
+        stream.write(raw_header)
+        stream.write(bytes(body))
+    return header
+
+
+def write_raw_safetensors(path: Path, raw_header: bytes, body: bytes = b"") -> None:
+    """写入任意 header 字节，供负例测试构造非法文件。"""
+
+    with open(str(path), "wb") as stream:
+        stream.write(struct.pack("<Q", len(raw_header)))
+        stream.write(raw_header)
+        stream.write(body)
+
+
+def write_raw_header_json(path: Path, header: Any, body: bytes = b"") -> None:
+    write_raw_safetensors(path, json.dumps(header).encode("utf-8"), body)
+
+
+def official_names_for_metadata(
+    program_metadata: Mapping[str, Any],
+) -> List[Tuple[str, str, Tuple[int, ...]]]:
+    """按 graph metadata 独立推导 (official_name, manifest_pattern, shape)。
+
+    只用 ``layers[].parameter_routes`` / ``kind`` 与 metadata 的 compact
+    manifest 形状，不调用 weight-map 模块。
+    """
+
+    manifest = program_metadata["parameter_manifest"]
+    shape_by_pattern = {entry["name"]: tuple(entry["shape"]) for entry in manifest}
+    results: List[Tuple[str, str, Tuple[int, ...]]] = [
+        (
+            "model.language_model.embed_tokens.weight",
+            "embedding_lm_head_shared_weight",
+            shape_by_pattern["embedding_lm_head_shared_weight"],
+        ),
+        ("model.language_model.norm.weight", "final_norm.weight", shape_by_pattern["final_norm.weight"]),
+    ]
+    for layer in program_metadata["layers"]:
+        for route in layer["parameter_routes"]:
+            prefix, suffix = route.split(".", 1)
+            index = int(prefix.split("_")[1])
+            if suffix.startswith(("q_proj", "k_proj", "v_proj", "o_proj", "q_norm", "k_norm")):
+                category = "full_attention"
+                official = "model.language_model.layers.{}.self_attn.{}".format(index, suffix)
+            elif layer["kind"] == "gdr" and suffix.split(".")[0] in (
+                "in_proj_qkv",
+                "in_proj_z",
+                "in_proj_b",
+                "in_proj_a",
+                "conv1d",
+                "A_log",
+                "dt_bias",
+                "norm",
+                "out_proj",
+            ):
+                category = "linear_attention"
+                official = "model.language_model.layers.{}.linear_attn.{}".format(index, suffix)
+            else:
+                category = "shared"
+                official = "model.language_model.layers.{}.{}".format(index, suffix)
+            if category == "full_attention":
+                pattern = "layers.full_attention.*." + suffix
+            elif category == "linear_attention":
+                pattern = "layers.linear_attention.*." + suffix
+            else:
+                pattern = "layers.*." + suffix
+            if pattern not in shape_by_pattern:
+                raise AssertionError("fixture pattern {!r} is not in the manifest".format(pattern))
+            results.append((official, pattern, shape_by_pattern[pattern]))
+    return results
+
+
+def synthetic_checkpoint_tensors(
+    program_metadata: Mapping[str, Any],
+    *,
+    f32_patterns: Iterable[str] = (),
+    extra_tensors: Sequence[Tuple[str, str, Sequence[int]]] = (),
+) -> List[Tuple[str, str, Sequence[int]]]:
+    """构造完整合成 checkpoint 的 tensor 列表（含可选的 F32 不一致项与排除组）。"""
+
+    f32 = set(f32_patterns)
+    tensors: List[Tuple[str, str, Sequence[int]]] = []
+    for official, pattern, shape in official_names_for_metadata(program_metadata):
+        dtype = "F32" if pattern in f32 else "BF16"
+        tensors.append((official, dtype, shape))
+    tensors.extend(extra_tensors)
+    return tensors
diff --git a/python/tests/ut/pypto_x/qwen35_weight_ingestion_driver.py b/python/tests/ut/pypto_x/qwen35_weight_ingestion_driver.py
