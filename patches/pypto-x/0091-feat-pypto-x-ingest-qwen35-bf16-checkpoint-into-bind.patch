+"""Qwen3.5-0.8B 权重摄取（映射 + 真实 layout + 精度边界）单测。
+
+合成部分的 checkpoint 由 KB 级 fixture 生成，用来验证 320/320 映射、排除组、
+dtype 分解与 RNE 降精度；真实部分的测试在固定 revision 资产不存在时 skip，
+只用 header 元数据加 36 个 F32 小张量，不物化 1.7 GB 权重。
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+from pypto.portable.qwen35_weight_layout import (
+    audit_precision_boundary,
+    build_weight_layout,
+    convert_f32_view_to_bf16_rne,
+    convert_region_bytes,
+    float32_bits_to_bfloat16_bits,
+)
+from pypto.portable.qwen35_weight_map import (
+    QWEN35_EMBED_TOKENS_TENSOR,
+    WeightMapError,
+    WeightMapMismatchError,
+    build_weight_mapping,
+    manifest_profile_from_metadata,
+    assert_manifest_reproducible,
+    tie_word_embeddings_from_config,
+)
+from pypto.portable.runtime_binding import build_binding_schema, build_packed_layout
+from pypto.portable.safetensors_reader import SafetensorsReader
+from pypto_x.qwen35_weight_fixture import (
+    REAL_SAFETENSORS_BYTES,
+    real_asset_dir,
+    synthetic_checkpoint_tensors,
+    write_safetensors,
+)
+
+F32_PATTERNS = ("layers.linear_attention.*.A_log", "layers.linear_attention.*.norm.weight")
+
+
+def _synthetic(tmp_path, name, *, f32_patterns=(), extra_tensors=(), profile="synthetic_test"):
+    program = build_qwen35_text_decoder_graph(1, 1, shape_profile=profile)
+    schema = build_binding_schema(program)
+    path = Path(tmp_path) / "{}.safetensors".format(name)
+    write_safetensors(path, synthetic_checkpoint_tensors(program.metadata, f32_patterns=f32_patterns, extra_tensors=extra_tensors))
+    return program, schema, path
+
+
+def test_every_parameter_maps_to_exactly_one_official_tensor(tmp_path):
+    program, schema, path = _synthetic(tmp_path, "clean")
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+    assert mapping.parameter_count == 320
+    assert mapping.mapped_count == 320
+    assert mapping.unmapped == ()
+    assert mapping.unexpected_checkpoint_tensors == ()
+    assert len(set(item.parameter for item in mapping.mappings)) == 320
+    assert len(set(item.source.official_name for item in mapping.mappings)) == 320
+    assert set(item.ordinal for item in mapping.mappings) == set(entry.ordinal for entry in schema.parameters)
+    by_name = {item.parameter: item for item in mapping.mappings}
+    assert by_name["layer_00_in_proj_qkv_weight"].source.official_name == (
+        "model.language_model.layers.0.linear_attn.in_proj_qkv.weight"
+    )
+    assert by_name["layer_03_q_proj_weight"].source.official_name == (
+        "model.language_model.layers.3.self_attn.q_proj.weight"
+    )
+    assert by_name["layer_23_o_proj_weight"].source.official_name == (
+        "model.language_model.layers.23.self_attn.o_proj.weight"
+    )
+    assert by_name["final_norm_weight"].source.official_name == "model.language_model.norm.weight"
+    assert by_name["layer_07_input_layernorm_weight"].source.official_name == (
+        "model.language_model.layers.7.input_layernorm.weight"
+    )
+    # 合成 checkpoint 全部 bf16，因此没有任何降精度需求
+    assert mapping.dtype_discrepancies == ()
+    assert mapping.totals["conversion_tensor_count"] == 0
+    assert mapping.totals["manifest_parameter_bytes"] == mapping.totals["checkpoint_text_bytes"]
+
+
+def test_manifest_is_reproducible_from_graph_metadata(tmp_path):
+    program, _schema, _path = _synthetic(tmp_path, "repro")
+    regenerated = assert_manifest_reproducible(program.metadata)
+    assert len(regenerated) == 22
+    assert sum(entry["count"] for entry in regenerated) == 320
+    profile = manifest_profile_from_metadata(program.metadata)
+    assert profile["hidden"] == 8 and profile["conv_kernel"] == 4
+
+
+def test_vision_and_mtp_groups_are_explicitly_excluded(tmp_path):
+    extra = (
+        ("model.visual.patch_embed.proj.weight", "BF16", (4, 3, 2, 2)),
+        ("model.visual.blocks.0.norm1.weight", "BF16", (4,)),
+        ("mtp.fc.weight", "BF16", (8, 16)),
+        ("mtp.norm.weight", "BF16", (8,)),
+    )
+    program, schema, path = _synthetic(tmp_path, "excluded", extra_tensors=extra)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+    groups = {group.group: group for group in mapping.excluded}
+    assert set(groups) == {"vision_tower", "mtp"}
+    assert groups["vision_tower"].tensor_count == 2
+    assert groups["vision_tower"].names == (
+        "model.visual.blocks.0.norm1.weight",
+        "model.visual.patch_embed.proj.weight",
+    )
+    assert groups["vision_tower"].nbytes == 4 * 3 * 2 * 2 * 2 + 4 * 2
+    assert groups["mtp"].tensor_count == 2
+    assert groups["mtp"].nbytes == (8 * 16 + 8) * 2
+    assert mapping.totals["excluded_tensor_count"] == 4
+    # 未分类张量必须 fail closed
+    program2, schema2, path2 = _synthetic(tmp_path, "unexpected", extra_tensors=(("mystery.weight", "BF16", (2,)),))
+    with SafetensorsReader(str(path2), mode="pread") as reader:
+        with pytest.raises(WeightMapMismatchError, match="unclassified"):
+            build_weight_mapping(schema2, program2.metadata, reader)
+
+
+def test_tied_embedding_fallback_is_explicit(tmp_path):
+    program, schema, path = _synthetic(tmp_path, "tied")
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        assert "lm_head.weight" not in reader
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+    assert mapping.tied.tie_word_embeddings is True
+    assert mapping.tied.fallback_used is True
+    assert mapping.tied.lm_head_present is False
+    assert mapping.tied.checkpoint_tensor == QWEN35_EMBED_TOKENS_TENSOR
+    shared = [item for item in mapping.mappings if item.tied]
+    assert len(shared) == 1
+    assert shared[0].parameter == "embedding_lm_head_shared_weight"
+    assert shared[0].storage_id == "embedding_lm_head_shared_weight"
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        with pytest.raises(WeightMapMismatchError, match="tie_word_embeddings=false"):
+            build_weight_mapping(schema, program.metadata, reader, tie_word_embeddings=False)
+    config = Path(tmp_path) / "config.json"
+    config.write_text('{"text_config": {"tie_word_embeddings": true}}', encoding="utf-8")
+    assert tie_word_embeddings_from_config(str(config)) is True
+    config.write_text('{"tie_word_embeddings": false}', encoding="utf-8")
+    assert tie_word_embeddings_from_config(str(config)) is False
+    config.write_text('{"model_type": "qwen3_5"}', encoding="utf-8")
+    with pytest.raises(WeightMapError, match="does not declare"):
+        tie_word_embeddings_from_config(str(config))
+
+
+def test_f32_split_is_decomposed_into_exact_byte_accounting(tmp_path):
+    program, schema, path = _synthetic(tmp_path, "f32split", f32_patterns=F32_PATTERNS)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+    assert len(mapping.dtype_discrepancies) == 36
+    assert mapping.totals["text_tensor_count_by_checkpoint_dtype"] == {"BF16": 284, "F32": 36}
+    assert mapping.totals["conforming_tensor_count"] == 284
+    assert mapping.totals["conversion_tensor_count"] == 36
+    groups = {item["manifest_pattern"]: item for item in mapping.totals["dtype_discrepancy_groups"]}
+    assert set(groups) == set(F32_PATTERNS)
+    for pattern in F32_PATTERNS:
+        assert groups[pattern]["tensor_count"] == 18
+        assert groups[pattern]["checkpoint_dtype"] == "F32"
+        assert groups[pattern]["contract_dtype"] == "bf16"
+        assert groups[pattern]["delta_bytes"] == groups[pattern]["checkpoint_bytes"] // 2
+    # 守恒：checkpoint 字节 = 契约字节 + 降精度回收字节
+    assert mapping.totals["checkpoint_text_bytes"] == (
+        mapping.totals["manifest_parameter_bytes"] + mapping.totals["conversion_reclaim_bytes"]
+    )
+    assert (
+        mapping.totals["checkpoint_text_bytes_by_dtype"]["F32"]
+        == mapping.totals["conversion_reclaim_bytes"] * 2
+    )
+
+
+def test_layout_reproduces_frozen_packed_layout_without_overlap_or_holes(tmp_path):
+    program, schema, path = _synthetic(tmp_path, "layout", f32_patterns=F32_PATTERNS)
+    packed = build_packed_layout(schema)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+        layout = build_weight_layout(schema, mapping, reader)
+    assert len(layout.regions) == 368 == len(packed.regions)
+    assert layout.total_nbytes == packed.total_nbytes
+    assert len(layout.parameter_regions) == 320
+    assert len(layout.state_regions) == 48
+    assert all(region.source_name is None for region in layout.state_regions)
+    assert all(region.source_name is not None for region in layout.parameter_regions)
+    cursor = 0
+    for region, frozen in zip(layout.regions, packed.regions):
+        assert region.storage_id == frozen.storage_id
+        assert region.offset == frozen.offset
+        assert region.nbytes == frozen.nbytes
+        assert region.offset >= cursor
+        assert region.offset % region.alignment == 0
+        cursor = region.offset + region.nbytes
+    assert layout.padding_nbytes == layout.total_nbytes - sum(region.nbytes for region in layout.regions)
+    assert layout.region_for("embedding.weight").storage_id == "embedding_lm_head_shared_weight"
+    assert layout.region_for("lm_head.weight") is layout.region_for("embedding.weight")
+    assert len(layout.dtype_conversion_storage_ids) == 36
+    # 可复现：同样输入必须给出同样 digest
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        again = build_weight_layout(schema, build_weight_mapping(schema, program.metadata, reader), reader)
+    assert again.canonical_json() == layout.canonical_json()
+    assert again.layout_digest() == layout.layout_digest()
+
+
+def test_conversion_is_round_to_nearest_even_not_truncation():
+    assert float32_bits_to_bfloat16_bits(0x3F800000) == 0x3F80  # 1.0
+    assert float32_bits_to_bfloat16_bits(0xBF800000) == 0xBF80  # -1.0
+    # 1 + 2^-9：低于半个 ULP，向下
+    assert float32_bits_to_bfloat16_bits(0x3F804000) == 0x3F80
+    # 1 + 2^-8：恰好是 tie，偶数尾数胜出 -> 1.0
+    assert float32_bits_to_bfloat16_bits(0x3F808000) == 0x3F80
+    # 1 + 3*2^-9：超过半个 ULP，进位
+    assert float32_bits_to_bfloat16_bits(0x3F80C000) == 0x3F81
+    # 1 + 2^-7：精确可表示
+    assert float32_bits_to_bfloat16_bits(0x3F810000) == 0x3F81
+    # NaN 保持 NaN，Inf 保持 Inf
+    assert float32_bits_to_bfloat16_bits(0x7FC00000) == 0x7FC0
+    assert float32_bits_to_bfloat16_bits(0x7F800000) == 0x7F80
+    assert float32_bits_to_bfloat16_bits(0xFF800000) == 0xFF80
+    with pytest.raises(ValueError):
+        float32_bits_to_bfloat16_bits(1 << 32)
+
+
+def test_convert_region_bytes_halves_f32_and_keeps_bf16_identity(tmp_path):
+    program, schema, path = _synthetic(tmp_path, "convert", f32_patterns=F32_PATTERNS)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+        layout = build_weight_layout(schema, mapping, reader)
+        converted = [region for region in layout.parameter_regions if region.requires_dtype_conversion]
+        identity = [region for region in layout.parameter_regions if not region.requires_dtype_conversion]
+        assert len(converted) == 36
+        assert len(identity) == 284
+        for region in converted:
+            payload = convert_region_bytes(reader, region)
+            assert len(payload) == region.nbytes
+            assert region.source_nbytes == region.nbytes * 2
+            assert payload == bytes(convert_f32_view_to_bf16_rne(reader.view(region.source_name)))
+        sample = identity[0]
+        view = reader.view(sample.source_name)
+        assert convert_region_bytes(reader, sample) == view.tobytes()
+        view.release()
+        # 状态 region 没有来源，必须 fail closed
+        with pytest.raises(ValueError, match="no checkpoint source"):
+            convert_region_bytes(reader, layout.state_regions[0])
+
+
+def test_precision_boundary_audit_measures_real_round_trip_error(tmp_path):
+    program, schema, path = _synthetic(tmp_path, "audit", f32_patterns=F32_PATTERNS)
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        mapping = build_weight_mapping(schema, program.metadata, reader)
+        layout = build_weight_layout(schema, mapping, reader)
+        conversions = audit_precision_boundary(reader, layout)
+    assert len(conversions) == 320
+    converted = [item for item in conversions if item.status == "converted_rne"]
+    identity = [item for item in conversions if item.status == "identity"]
+    assert len(converted) == 36 and len(identity) == 284
+    assert all(item.source_sha256 is None for item in identity)
+    for item in converted:
+        assert item.source_sha256 is not None and item.converted_sha256 is not None
+        assert item.contract_nbytes * 2 == item.source_nbytes
+        # bf16 的 ULP 是 2^-7，RNE 相对误差上界是 2^-8
+        assert item.max_relative_error is not None and item.max_relative_error <= 2 ** -8
+        assert item.max_abs_error is not None
+
