+def test_duplicate_json_keys_and_non_json_headers_are_rejected(tmp_path):
+    path = Path(tmp_path) / "dup.safetensors"
+    raw = b'{"a":{"dtype":"BF16","shape":[4],"data_offsets":[0,8]},"a":{"dtype":"BF16","shape":[4],"data_offsets":[8,16]}}'
+    write_raw_safetensors(path, raw, b"\x00" * 16)
+    with pytest.raises(SafetensorsFormatError, match="duplicate key"):
+        SafetensorsReader(str(path))
+    write_raw_safetensors(path, b"{not json", b"")
+    with pytest.raises(SafetensorsFormatError, match="not valid JSON"):
+        SafetensorsReader(str(path))
+    write_raw_safetensors(path, b"[1,2,3]", b"")
+    with pytest.raises(SafetensorsFormatError, match="JSON object"):
+        SafetensorsReader(str(path))
+    write_raw_safetensors(path, b'{"__metadata__":{"k":1}}', b"")
+    with pytest.raises(SafetensorsFormatError, match="strings"):
+        SafetensorsReader(str(path))
+
+
+def test_truncated_and_oversized_headers_are_rejected(tmp_path):
+    path = Path(tmp_path) / "truncated.safetensors"
+    write_raw_safetensors(path, b'{"a":{"dtype":"BF16","shape":[4],"data_offsets":[0,8]}}', b"")
+    with pytest.raises(SafetensorsBoundsError, match="beyond data section"):
+        SafetensorsReader(str(path))
+    # header 长度本身超出文件
+    write_raw_safetensors(path, b'{"a":{"dtype":"BF16","shape":[4],"data_offsets":[0,8]}}' * 8, b"")
+    truncated = path.read_bytes()
+    path.write_bytes(truncated[:20])
+    with pytest.raises(SafetensorsBoundsError, match="does not fit"):
+        SafetensorsReader(str(path))
+    write_raw_safetensors(path, b"")
+    with pytest.raises(SafetensorsFormatError, match="too small"):
+        SafetensorsReader(str(path))
+    Path(str(path)).write_bytes(b"\x01\x02\x03")
+    with pytest.raises(SafetensorsFormatError, match="shorter than"):
+        SafetensorsReader(str(path))
+    big = bytearray(8)
+    big[0:8] = struct.pack("<Q", 1 << 40)
+    path.write_bytes(bytes(big))
+    with pytest.raises(SafetensorsFormatError, match="exceeds limit"):
+        SafetensorsReader(str(path))
+
