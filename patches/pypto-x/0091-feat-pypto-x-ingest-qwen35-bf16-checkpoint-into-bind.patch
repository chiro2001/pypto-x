index 000000000..16821b039
--- /dev/null
+++ b/python/tests/ut/pypto_x/qwen35_weight_ingestion_driver.py
@@ -0,0 +1,334 @@
+"""Qwen3.5-0.8B 权重摄取证据 driver（M1L-style，可审计）。
+
+用法（必须经 heavy runner）：
+
+    scripts/resource/run_local_heavy.sh --task qwen35-bf16-weight-ingestion \
+      --agent qwen35-bf16-weight-ingestion -- \
+      env PYPTO_X_PORTABLE_ONLY=1 PYTHONPATH=python python3 \
+      python/tests/ut/pypto_x/qwen35_weight_ingestion_driver.py \
+      --asset-dir <revision dir> --output <validation.json>
+
+driver 只读 safetensors header 与 36 个 F32 小张量，从不物化 1.7 GB 权重；
+峰值 RSS 用 ``resource.getrusage`` 与 ``/proc/self/status`` 双重记录，并由外部
+``/usr/bin/time -v`` 复核。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import resource
+import time
+from pathlib import Path
+from typing import Dict, Optional
+
+from pypto.portable.qwen35 import QWEN35_08B_SHAPE_METADATA, build_qwen35_text_decoder_graph
+from pypto.portable.qwen35_weight_layout import audit_precision_boundary, build_weight_layout
+from pypto.portable.qwen35_weight_map import (
+    assert_manifest_reproducible,
+    build_weight_mapping,
+    tie_word_embeddings_from_config,
+)
+from pypto.portable.runtime_binding import build_binding_schema, build_packed_layout
+from pypto.portable.safetensors_reader import SafetensorsReader
+
+PARENT_BASELINE = {
+    "packed_region_count": 368,
+    "packed_total_nbytes_past_4096": 1574877952,
+    "graph_digest_past_4096": "c1a5663b644e6b6e642599689cc26c6f6b9c50f9b820743c272415b0ff0df7d5",
+    "checkpoint_text_bytes": 1504791232,
+    "manifest_parameter_bytes": 1504786048,
+    "conversion_reclaim_bytes": 5184,
+}
+
+
+def _status_kib(field: str) -> Optional[int]:
+    try:
+        with open("/proc/self/status", "r", encoding="utf-8") as stream:
+            for line in stream:
+                if line.startswith(field + ":"):
+                    return int(line.split()[1])
+    except OSError:
+        return None
+    return None
+
+
+def _maxrss_kib() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--asset-dir", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--past-length", type=int, default=4096)
+    parser.add_argument("--batch", type=int, default=1)
+    parser.add_argument("--steps", type=int, default=1)
+    parser.add_argument("--alignment", type=int, default=64)
+    parser.add_argument("--hash-chunk-mib", type=int, default=8)
+    args = parser.parse_args()
+
+    asset_dir = Path(args.asset_dir)
+    safetensors_name = "model.safetensors-00001-of-00001.safetensors"
+    checkpoint_path = asset_dir / safetensors_name
+    config_path = asset_dir / "config.json"
+    manifest_path = asset_dir / "_manifest.json"
+    if not checkpoint_path.is_file():
+        raise SystemExit("checkpoint not found: {}".format(checkpoint_path))
+
+    rss_before_kib = _maxrss_kib()
+    started = time.time()
+    tie_word_embeddings = tie_word_embeddings_from_config(str(config_path))
+    program = build_qwen35_text_decoder_graph(
+        args.batch, args.steps, past_length=args.past_length, shape_profile="model"
+    )
+    schema = build_binding_schema(program)
+    regenerated = assert_manifest_reproducible(program.metadata)
+    packed = build_packed_layout(schema, args.alignment)
+    rss_after_graph_kib = _maxrss_kib()
+
+    with SafetensorsReader(str(checkpoint_path), mode="pread") as reader:
+        header = reader.to_dict()
+        rss_after_open_kib = _maxrss_kib()
+        tensor_ranges = sorted(
+            (tensor.data_offset, tensor.data_offset + tensor.nbytes) for tensor in reader.tensors().values()
+        )
+        strict_contiguous = (
+            tensor_ranges[0][0] == 0
+            and tensor_ranges[-1][1] == reader.data_nbytes
+            and all(tensor_ranges[index][0] == tensor_ranges[index - 1][1] for index in range(1, len(tensor_ranges)))
+        )
+        mapping = build_weight_mapping(
+            schema, program.metadata, reader, tie_word_embeddings=tie_word_embeddings
+        )
+        layout = build_weight_layout(schema, mapping, reader, alignment=args.alignment)
+        conversions = audit_precision_boundary(reader, layout)
+        rss_after_mapping_kib = _maxrss_kib()
+        file_sha256 = reader.sha256(chunk_bytes=args.hash_chunk_mib * 1024 * 1024)
+        rss_after_hash_kib = _maxrss_kib()
+
+    recorded_sha256 = None
+    if manifest_path.is_file():
+        with open(str(manifest_path), "r", encoding="utf-8") as stream:
+            recorded_sha256 = json.load(stream)["files"][safetensors_name]["sha256"]
+
+    converted = [item for item in conversions if item.status == "converted_rne"]
+    identity = [item for item in conversions if item.status == "identity"]
+    pattern_by_storage = {item.storage_id: item.manifest_pattern for item in mapping.mappings}
+    pattern_groups: Dict[str, Dict[str, float]] = {}
+    for item in converted:
+        group = pattern_groups.setdefault(
+            pattern_by_storage[item.storage_id],
+            {
+                "manifest_pattern": pattern_by_storage[item.storage_id],
+                "tensor_count": 0,
+                "elements": 0,
+                "exact_elements": 0,
+                "source_bytes": 0,
+                "contract_bytes": 0,
+                "max_absolute_error": 0.0,
+                "max_relative_error": 0.0,
+            },
+        )
+        group["tensor_count"] += 1
+        group["elements"] += item.elements
+        group["exact_elements"] += item.exact_elements
+        group["source_bytes"] += item.source_nbytes
+        group["contract_bytes"] += item.contract_nbytes
+        group["max_absolute_error"] = max(group["max_absolute_error"], item.max_abs_error)
+        group["max_relative_error"] = max(group["max_relative_error"], item.max_relative_error)
+    totals = dict(mapping.totals)
+    excluded = {group.group: group for group in mapping.excluded}
+    vm_hwm_kib = _status_kib("VmHWM")
+    vm_rss_kib = _status_kib("VmRSS")
+
+    checks: Dict[str, bool] = {
+        "named_revision_matches": QWEN35_08B_SHAPE_METADATA["revision"] in str(asset_dir),
+        "safetensors_sha256_matches_checkpoint_manifest": recorded_sha256 == file_sha256,
+        "mapped_320_of_320": mapping.mapped_count == 320 and mapping.parameter_count == 320,
+        "no_unmapped_parameters": mapping.unmapped == (),
+        "no_unexpected_checkpoint_tensors": mapping.unexpected_checkpoint_tensors == (),
+        "vision_tower_excluded_153": excluded["vision_tower"].tensor_count == 153,
+        "mtp_excluded_15": excluded["mtp"].tensor_count == 15,
+        "text_bytes_match_parent_baseline": totals["checkpoint_text_bytes"]
+        == PARENT_BASELINE["checkpoint_text_bytes"],
+        "manifest_bytes_match_parent_baseline": totals["manifest_parameter_bytes"]
