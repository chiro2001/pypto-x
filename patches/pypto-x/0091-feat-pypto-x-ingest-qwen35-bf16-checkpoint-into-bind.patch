@@ -0,0 +1,685 @@
+"""Qwen3.5-0.8B 官方 checkpoint 张量名到 PyPTO-X 文本 decoder 参数的映射。
+
+映射是**程序化推导**的，不是逐张量硬编码：PyPTO-X 侧的 compact manifest
+（:func:`pypto.portable.qwen35.qwen35_text_decoder_manifest` 的
+``parameter_manifest``）已经用 ``layers.full_attention.*`` /
+``layers.linear_attention.*`` / ``layers.*`` 三类模式描述了 22 个存储类；
+本模块只把这三类模式展开成官方 HuggingFace 命名，再与 graph metadata 的
+``layers[].parameter_routes`` 和 :class:`~pypto.portable.runtime_binding.BindingSchema`
+的 320 个精确函数参数逐一对照。
+
+三类名字必须同时成立，任何一方不匹配都 fail closed：
+
+* **contract**：Core graph 的精确函数参数（顺序、dtype、shape）；
+* **manifest**：compact 存储类的 dtype/shape/count/字节数；
+* **checkpoint**：safetensors header 里的官方 dtype/shape/data_offsets。
+
+``tie_word_embeddings=true`` 时官方 checkpoint 没有 ``lm_head.weight``，映射显式
+回退到 ``model.language_model.embed_tokens.weight`` 并在结果里记录，不做静默
+猜测。vision tower（``model.visual.*``）与 MTP 层（``mtp.*``）被显式列为排除组，
+带张量数、字节数和完整名字列表，绝不进入文本图。
+
+本模块不读取权重数据，只用 header 元数据。
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from types import MappingProxyType
+from typing import Any, Dict, List, Mapping, Sequence, Tuple
+
+from .qwen35 import _decoder_parameter_manifest
+from .runtime_binding import _DTYPE_BYTES, BindingSchema, _canonical_dtype
+from .safetensors_reader import SafetensorsReader, SafetensorsTensor
+
+#: 官方 checkpoint 里文本 decoder 的根前缀。
+QWEN35_TEXT_PREFIX = "model.language_model."
+#: 官方 checkpoint 里视觉塔的根前缀（本任务显式排除）。
+QWEN35_VISION_PREFIX = "model.visual."
+#: 官方 checkpoint 里 MTP 层的根前缀（本任务显式排除）。
+QWEN35_MTP_PREFIX = "mtp."
+#: tied embedding 的官方张量名。
+QWEN35_EMBED_TOKENS_TENSOR = QWEN35_TEXT_PREFIX + "embed_tokens.weight"
+#: tied embedding 对应的 lm_head 别名（checkpoint 中可能不存在）。
+QWEN35_LM_HEAD_TENSOR = "lm_head.weight"
+
+_EXCLUSION_GROUPS = (
+    ("vision_tower", QWEN35_VISION_PREFIX),
+    ("mtp", QWEN35_MTP_PREFIX),
+)
+
+_MODULE_BY_PREFIX = {
+    "layers.full_attention.": "self_attn",
+    "layers.linear_attention.": "linear_attn",
+    "layers.": None,
+}
+
+_SHARED_OFFICIAL_NAMES = {
+    "embedding_lm_head_shared_weight": QWEN35_EMBED_TOKENS_TENSOR,
+    "final_norm.weight": QWEN35_TEXT_PREFIX + "norm.weight",
+}
+
+_SHARED_FUNCTION_PARAMETERS = {
+    "embedding_lm_head_shared_weight": "embedding_lm_head_shared_weight",
+    "final_norm.weight": "final_norm_weight",
+}
+
+
+class WeightMapError(ValueError):
+    """权重映射失败基类。"""
+
+
+class WeightMapMismatchError(WeightMapError):
+    """contract / manifest / checkpoint 三方不一致。"""
+
+
+def tie_word_embeddings_from_config(path: str) -> bool:
+    """从官方 ``config.json`` 读取 tie_word_embeddings（text_config 优先）。"""
+
+    with open(path, "r", encoding="utf-8") as stream:
+        config = json.load(stream)
+    if not isinstance(config, dict):
+        raise WeightMapError("{} must contain a JSON object".format(path))
+    text_config = config.get("text_config")
+    if isinstance(text_config, dict) and isinstance(text_config.get("tie_word_embeddings"), bool):
+        return bool(text_config["tie_word_embeddings"])
+    if isinstance(config.get("tie_word_embeddings"), bool):
+        return bool(config["tie_word_embeddings"])
+    raise WeightMapError("{} does not declare tie_word_embeddings".format(path))
+
+
+@dataclass(frozen=True)
+class TensorSource:
+    """官方 checkpoint 中一个张量的 header 元数据。"""
+
+    official_name: str
+    dtype: str
+    pypto_dtype: str
+    shape: Tuple[int, ...]
+    elements: int
+    nbytes: int
+    data_offset: int
+    file_offset: int
+
+    @classmethod
+    def from_tensor(cls, tensor: SafetensorsTensor) -> "TensorSource":
+        return cls(
+            tensor.name,
+            tensor.dtype,
+            tensor.pypto_dtype,
+            tensor.shape,
+            tensor.elements,
+            tensor.nbytes,
+            tensor.data_offset,
+            tensor.file_offset,
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "official_name": self.official_name,
+            "dtype": self.dtype,
+            "pypto_dtype": self.pypto_dtype,
+            "shape": list(self.shape),
+            "elements": self.elements,
+            "nbytes": self.nbytes,
+            "data_offset": self.data_offset,
+            "file_offset": self.file_offset,
+        }
+
+
+@dataclass(frozen=True)
+class ParameterMapping:
+    """一个 PyPTO-X 函数参数到官方张量的完整三方对照。"""
+
+    ordinal: int
+    parameter: str
+    storage_id: str
+    manifest_pattern: str
+    manifest_dtype: str
+    shape: Tuple[int, ...]
+    elements: int
+    manifest_bytes: int
+    source: TensorSource
+    dtype_conforms: bool
+    tied: bool
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "ordinal": self.ordinal,
+            "parameter": self.parameter,
+            "storage_id": self.storage_id,
+            "manifest_pattern": self.manifest_pattern,
+            "manifest_dtype": self.manifest_dtype,
+            "shape": list(self.shape),
+            "elements": self.elements,
+            "manifest_bytes": self.manifest_bytes,
+            "dtype_conforms": self.dtype_conforms,
+            "tied": self.tied,
+            "source": self.source.to_dict(),
+        }
+
+
+@dataclass(frozen=True)
+class ExcludedGroup:
+    """显式排除在文本图之外的 checkpoint 张量组。"""
+
+    group: str
+    prefix: str
+    tensor_count: int
+    nbytes: int
+    dtype_counts: Mapping[str, int]
+    names: Tuple[str, ...]
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "group": self.group,
+            "prefix": self.prefix,
+            "tensor_count": self.tensor_count,
+            "nbytes": self.nbytes,
+            "dtype_counts": dict(self.dtype_counts),
+            "names": list(self.names),
+        }
+
+
+@dataclass(frozen=True)
+class TiedEmbedding:
+    """tied embedding / lm_head 的显式回退记录。"""
+
+    tie_word_embeddings: bool
+    storage_id: str
+    function_parameter: str
+    checkpoint_tensor: str
+    lm_head_alias: str
+    lm_head_present: bool
+    fallback_used: bool
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "tie_word_embeddings": self.tie_word_embeddings,
+            "storage_id": self.storage_id,
+            "function_parameter": self.function_parameter,
+            "checkpoint_tensor": self.checkpoint_tensor,
+            "lm_head_alias": self.lm_head_alias,
+            "lm_head_present": self.lm_head_present,
+            "fallback_used": self.fallback_used,
+        }
+
+
+@dataclass(frozen=True)
+class WeightMapping:
+    """320 个文本参数到官方 checkpoint 的完整映射与排除清单。"""
+
+    graph_digest: str
+    checkpoint_path: str
+    tie_word_embeddings: bool
+    parameter_count: int
+    mapped_count: int
+    unmapped: Tuple[str, ...]
+    unexpected_checkpoint_tensors: Tuple[str, ...]
+    mappings: Tuple[ParameterMapping, ...]
+    excluded: Tuple[ExcludedGroup, ...]
+    tied: TiedEmbedding
+    totals: Mapping[str, Any]
+
+    @property
+    def dtype_discrepancies(self) -> Tuple[ParameterMapping, ...]:
+        return tuple(item for item in self.mappings if not item.dtype_conforms)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "graph_digest": self.graph_digest,
+            "checkpoint_path": self.checkpoint_path,
+            "tie_word_embeddings": self.tie_word_embeddings,
+            "parameter_count": self.parameter_count,
+            "mapped_count": self.mapped_count,
+            "unmapped": list(self.unmapped),
+            "unexpected_checkpoint_tensors": list(self.unexpected_checkpoint_tensors),
+            "tied": self.tied.to_dict(),
+            "excluded": [group.to_dict() for group in self.excluded],
+            "totals": dict(self.totals),
+            "dtype_discrepancies": [
+                {
+                    "parameter": item.parameter,
+                    "manifest_pattern": item.manifest_pattern,
+                    "manifest_dtype": item.manifest_dtype,
+                    "checkpoint_dtype": item.source.dtype,
+                    "checkpoint_name": item.source.official_name,
+                    "elements": item.elements,
+                    "manifest_bytes": item.manifest_bytes,
+                    "checkpoint_bytes": item.source.nbytes,
+                }
+                for item in self.dtype_discrepancies
+            ],
+            "mappings": [item.to_dict() for item in self.mappings],
+        }
+
+    def canonical_json(self) -> str:
+        return json.dumps(self.to_dict(), ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def _layer_route_table(program_metadata: Mapping[str, Any]) -> Dict[str, Tuple[int, str, str]]:
+    """从 graph metadata 的 ``layers[].parameter_routes`` 建立路由表。"""
+
+    layers = program_metadata.get("layers")
+    if not isinstance(layers, Sequence) or isinstance(layers, (str, bytes)) or not layers:
+        raise WeightMapMismatchError("graph metadata must declare a non-empty layers sequence")
+    table: Dict[str, Tuple[int, str, str]] = {}
+    for layer in layers:
+        if not isinstance(layer, Mapping):
+            raise WeightMapMismatchError("graph metadata layers entries must be mappings")
+        index = layer.get("index")
+        kind = layer.get("kind")
+        routes = layer.get("parameter_routes")
+        if isinstance(index, bool) or not isinstance(index, int) or index < 0:
+            raise WeightMapMismatchError("graph metadata layer index must be a non-negative integer")
+        if not isinstance(kind, str) or not kind:
+            raise WeightMapMismatchError("graph metadata layer {!r} kind must be a string".format(index))
+        if not isinstance(routes, Sequence) or isinstance(routes, (str, bytes)):
+            raise WeightMapMismatchError("graph metadata layer {!r} parameter_routes must be a sequence".format(index))
+        for route in routes:
+            if not isinstance(route, str) or "." not in route:
+                raise WeightMapMismatchError("parameter route {!r} must be 'layer_NN.<suffix>'".format(route))
+            prefix, suffix = route.split(".", 1)
+            if prefix != "layer_{:02d}".format(index):
+                raise WeightMapMismatchError(
+                    "parameter route {!r} does not belong to layer {:02d}".format(route, index)
+                )
+            function_parameter = route.replace(".", "_")
+            if function_parameter in table:
+                raise WeightMapMismatchError("duplicate parameter route {!r}".format(route))
+            table[function_parameter] = (index, kind, suffix)
+    return table
+
+
+def _expand_manifest_entry(
+    entry: Mapping[str, Any],
+    full_indices: Tuple[int, ...],
+    gdr_indices: Tuple[int, ...],
+) -> Tuple[Tuple[str, str, str], ...]:
+    """把一个 compact manifest 存储类展开成 (function_parameter, official_name, pattern) 三元组。"""
+
+    pattern = entry.get("name")
+    if not isinstance(pattern, str) or not pattern:
+        raise WeightMapMismatchError("parameter_manifest entry name must be a non-empty string")
+    count = entry.get("count")
+    if isinstance(count, bool) or not isinstance(count, int) or count <= 0:
+        raise WeightMapMismatchError("parameter_manifest {!r} count must be a positive integer".format(pattern))
+
+    if pattern in _SHARED_OFFICIAL_NAMES:
+        expanded = ((_SHARED_FUNCTION_PARAMETERS[pattern], _SHARED_OFFICIAL_NAMES[pattern], pattern),)
+    elif ".*." in pattern:
+        head, suffix = pattern.split("*.", 1)
+        if not head.endswith(".") or head not in _MODULE_BY_PREFIX:
+            raise WeightMapMismatchError("parameter_manifest pattern {!r} has an unknown prefix".format(pattern))
+        module = _MODULE_BY_PREFIX[head]
+        if module == "self_attn":
+            indices = tuple(full_indices)
+        elif module == "linear_attn":
+            indices = tuple(gdr_indices)
+        else:
+            indices = tuple(sorted(tuple(full_indices) + tuple(gdr_indices)))
+        expanded_list: List[Tuple[str, str, str]] = []
+        for index in indices:
+            function_parameter = "layer_{:02d}_{}".format(index, suffix.replace(".", "_"))
+            if module is None:
+                official_name = "{}layers.{}.{}".format(QWEN35_TEXT_PREFIX, index, suffix)
+            else:
+                official_name = "{}layers.{}.{}.{}".format(QWEN35_TEXT_PREFIX, index, module, suffix)
+            expanded_list.append((function_parameter, official_name, pattern))
+        expanded = tuple(expanded_list)
+    else:
+        raise WeightMapMismatchError("parameter_manifest has an unknown storage class {!r}".format(pattern))
+
+    if len(expanded) != count:
+        raise WeightMapMismatchError(
+            "parameter_manifest {!r} declares count {} but expands to {} tensors".format(
+                pattern, count, len(expanded)
+            )
+        )
+    return expanded
+
+
+def _dtype_counts(tensors: Sequence[SafetensorsTensor]) -> Mapping[str, int]:
+    counts: Dict[str, int] = {}
+    for tensor in tensors:
+        counts[tensor.dtype] = counts.get(tensor.dtype, 0) + 1
+    return MappingProxyType(counts)
+
+
+def build_weight_mapping(
+    schema: BindingSchema,
+    program_metadata: Mapping[str, Any],
+    checkpoint: SafetensorsReader,
+    *,
+    tie_word_embeddings: bool = True,
+) -> WeightMapping:
+    """把 320 个 Core 参数映射到官方 checkpoint 张量。
+
+    任何未映射参数、缺失张量、未预期张量或 shape/元素数不一致都会抛出
+    :class:`WeightMapMismatchError`。dtype 差异**不**抛异常，而是逐条记录在
+    :attr:`WeightMapping.dtype_discrepancies` 中，因为契约由父 agent 冻结，
+    本模块无权改写。
+    """
+
+    if not isinstance(schema, BindingSchema):
+        raise WeightMapError("schema must be a BindingSchema")
+    if not isinstance(checkpoint, SafetensorsReader):
+        raise WeightMapError("checkpoint must be a SafetensorsReader")
+
+    raw_manifest = program_metadata.get("parameter_manifest")
+    if not isinstance(raw_manifest, Sequence) or isinstance(raw_manifest, (str, bytes)) or not raw_manifest:
+        raise WeightMapMismatchError("graph metadata parameter_manifest must be a non-empty sequence")
+    full_indices = program_metadata.get("full_attention_layer_indices")
+    gdr_indices = program_metadata.get("gdr_layer_indices")
+    if not isinstance(full_indices, Sequence) or isinstance(full_indices, (str, bytes)):
+        raise WeightMapMismatchError("graph metadata full_attention_layer_indices must be a sequence")
+    if not isinstance(gdr_indices, Sequence) or isinstance(gdr_indices, (str, bytes)):
+        raise WeightMapMismatchError("graph metadata gdr_layer_indices must be a sequence")
+    full_indices = tuple(full_indices)
+    gdr_indices = tuple(gdr_indices)
+    route_table = _layer_route_table(program_metadata)
+
+    parameters = {entry.name: entry for entry in schema.parameters}
+    if len(parameters) != len(schema.parameters):
+        raise WeightMapMismatchError("binding schema contains duplicate parameter names")
+
+    tensor_catalog = checkpoint.tensors()
+    mapped_names = set()
+    mappings: List[ParameterMapping] = []
+    seen_parameters = set()
+
+    for entry in raw_manifest:
+        if not isinstance(entry, Mapping):
+            raise WeightMapMismatchError("parameter_manifest entries must be mappings")
+        manifest_dtype = _canonical_dtype(entry.get("dtype"))
+        manifest_shape = tuple(entry.get("shape") or ())
+        manifest_elements = entry.get("elements_per_tensor")
+        manifest_class_bytes = entry.get("storage_bytes")
+        count = entry.get("count")
+        for name, value in (
+            ("elements_per_tensor", manifest_elements),
+            ("storage_bytes", manifest_class_bytes),
+            ("count", count),
+        ):
+            if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+                raise WeightMapMismatchError("parameter_manifest {}.{} must be positive".format(entry.get("name"), name))
+        per_tensor_bytes = manifest_elements * _DTYPE_BYTES[manifest_dtype]
+        if per_tensor_bytes * count != manifest_class_bytes:
+            raise WeightMapMismatchError(
+                "parameter_manifest {!r} storage_bytes {} is not count {} x {} per tensor".format(
+                    entry.get("name"), manifest_class_bytes, count, per_tensor_bytes
+                )
+            )
+        for function_parameter, official_name, pattern in _expand_manifest_entry(
+            entry, full_indices, gdr_indices
+        ):
+            if function_parameter in seen_parameters:
+                raise WeightMapMismatchError("manifest expands duplicate parameter {!r}".format(function_parameter))
+            seen_parameters.add(function_parameter)
+            exact = parameters.get(function_parameter)
+            if exact is None:
+                raise WeightMapMismatchError(
+                    "manifest parameter {!r} is not an exact Core function parameter".format(function_parameter)
+                )
+            if exact.dtype != manifest_dtype:
+                raise WeightMapMismatchError(
+                    "parameter {!r} dtype {} does not match manifest dtype {}".format(
+                        function_parameter, exact.dtype, manifest_dtype
+                    )
+                )
+            if tuple(exact.shape) != manifest_shape:
+                raise WeightMapMismatchError(
+                    "parameter {!r} shape {} does not match manifest shape {}".format(
+                        function_parameter, list(exact.shape), list(manifest_shape)
+                    )
+                )
+            if _shape_elements(manifest_shape) != manifest_elements:
+                raise WeightMapMismatchError(
+                    "parameter {!r} elements_per_tensor is inconsistent with shape".format(function_parameter)
+                )
+            if ".*." in pattern and function_parameter not in route_table:
+                raise WeightMapMismatchError(
+                    "parameter {!r} is absent from graph layer parameter_routes".format(function_parameter)
+                )
+            tensor = tensor_catalog.get(official_name)
+            if tensor is None:
+                raise WeightMapMismatchError(
+                    "checkpoint is missing tensor {!r} for parameter {!r}".format(official_name, function_parameter)
+                )
+            if tensor.name in mapped_names:
+                raise WeightMapMismatchError(
+                    "checkpoint tensor {!r} is claimed by more than one parameter".format(official_name)
+                )
+            mapped_names.add(tensor.name)
+            if tuple(tensor.shape) != manifest_shape:
+                raise WeightMapMismatchError(
+                    "checkpoint tensor {!r} shape {} does not match contract shape {}".format(
+                        official_name, list(tensor.shape), list(manifest_shape)
+                    )
+                )
+            if tensor.elements != manifest_elements:
+                raise WeightMapMismatchError(
+                    "checkpoint tensor {!r} element count {} does not match contract {}".format(
+                        official_name, tensor.elements, manifest_elements
+                    )
+                )
+            if tensor.nbytes % tensor.itemsize:
+                raise WeightMapMismatchError(
+                    "checkpoint tensor {!r} byte count is not a multiple of its itemsize".format(official_name)
+                )
+            source = TensorSource.from_tensor(tensor)
+            mappings.append(
+                ParameterMapping(
+                    exact.ordinal,
+                    function_parameter,
+                    exact.storage_id,
+                    pattern,
+                    manifest_dtype,
+                    manifest_shape,
+                    manifest_elements,
+                    per_tensor_bytes,
+                    source,
+                    tensor.pypto_dtype == manifest_dtype,
+                    pattern == "embedding_lm_head_shared_weight",
+                )
+            )
+
+    unmapped = tuple(sorted(set(parameters) - seen_parameters))
+    if unmapped:
+        raise WeightMapMismatchError("{} Core parameters are unmapped: {}".format(len(unmapped), list(unmapped[:8])))
+    mapped_layer_parameters = set(
+        item.parameter for item in mappings if ".*." in item.manifest_pattern
+    )
+    if mapped_layer_parameters != set(route_table):
+        missing_routes = set(route_table) - mapped_layer_parameters
+        extra_routes = mapped_layer_parameters - set(route_table)
+        raise WeightMapMismatchError(
+            "manifest expansion does not match graph parameter_routes: missing {}, extra {}".format(
+                sorted(missing_routes)[:4], sorted(extra_routes)[:4]
+            )
+        )
+
+    # tied embedding / lm_head 显式决策
+    lm_head_present = QWEN35_LM_HEAD_TENSOR in tensor_catalog
+    if not tie_word_embeddings:
+        raise WeightMapMismatchError(
+            "PyPTO-X contract declares one shared embedding/lm_head storage; "
+            "tie_word_embeddings=false is not representable by this ingestion path"
+        )
+    if QWEN35_EMBED_TOKENS_TENSOR not in mapped_names:
+        raise WeightMapMismatchError(
+            "tied checkpoint must map {!r} to the shared embedding parameter".format(QWEN35_EMBED_TOKENS_TENSOR)
+        )
+    tied = TiedEmbedding(
+        bool(tie_word_embeddings),
+        "embedding_lm_head_shared_weight",
+        "embedding_lm_head_shared_weight",
+        QWEN35_EMBED_TOKENS_TENSOR,
+        QWEN35_LM_HEAD_TENSOR,
+        lm_head_present,
+        bool(tie_word_embeddings),
+    )
+
+    excluded: List[ExcludedGroup] = []
+    excluded_names = set()
+    for group, prefix in _EXCLUSION_GROUPS:
+        members = tuple(sorted(name for name in tensor_catalog if name.startswith(prefix)))
+        for name in members:
+            if name in mapped_names:
+                raise WeightMapMismatchError(
+                    "excluded tensor {!r} is also mapped into the text graph".format(name)
+                )
+        excluded_names.update(members)
+        excluded.append(
+            ExcludedGroup(
+                group,
+                prefix,
+                len(members),
+                sum(tensor_catalog[name].nbytes for name in members),
+                _dtype_counts([tensor_catalog[name] for name in members]),
+                members,
+            )
+        )
+
+    unexpected = tuple(sorted(set(tensor_catalog) - mapped_names - excluded_names))
+    if unexpected:
+        raise WeightMapMismatchError(
+            "checkpoint contains {} unclassified tensors: {}".format(len(unexpected), list(unexpected[:8]))
+        )
+
+    text_tensors = [tensor_catalog[item.source.official_name] for item in mappings]
+    text_bytes_by_dtype: Dict[str, int] = {}
+    for tensor in text_tensors:
+        text_bytes_by_dtype[tensor.dtype] = text_bytes_by_dtype.get(tensor.dtype, 0) + tensor.nbytes
+    discrepancies = tuple(item for item in mappings if not item.dtype_conforms)
+    element_total = sum(item.elements for item in mappings)
+    manifest_total = sum(item.manifest_bytes for item in mappings)
+    declared_elements = program_metadata.get("parameter_element_count")
+    declared_bytes = program_metadata.get("parameter_byte_count")
+    if element_total != declared_elements or manifest_total != declared_bytes:
+        raise WeightMapMismatchError(
+            "mapped totals ({}, {}) do not match graph metadata ({}, {})".format(
+                element_total, manifest_total, declared_elements, declared_bytes
+            )
+        )
+    tensor_count_by_dtype: Dict[str, int] = {}
+    for item in mappings:
+        key = item.source.dtype
+        tensor_count_by_dtype[key] = tensor_count_by_dtype.get(key, 0) + 1
+    discrepancy_groups: List[Mapping[str, Any]] = []
+    for pattern in sorted(set(item.manifest_pattern for item in discrepancies)):
+        members = [item for item in discrepancies if item.manifest_pattern == pattern]
+        checkpoint_bytes = sum(item.source.nbytes for item in members)
+        contract_bytes = sum(item.manifest_bytes for item in members)
+        discrepancy_groups.append(
+            {
+                "manifest_pattern": pattern,
+                "checkpoint_dtype": members[0].source.dtype,
+                "contract_dtype": members[0].manifest_dtype,
+                "tensor_count": len(members),
+                "elements_per_tensor": members[0].elements,
+                "checkpoint_bytes": checkpoint_bytes,
+                "contract_bytes": contract_bytes,
+                "delta_bytes": checkpoint_bytes - contract_bytes,
+            }
+        )
+    totals = MappingProxyType(
+        {
+            "checkpoint_tensor_total": len(tensor_catalog),
+            "text_tensor_count": len(mappings),
+            "text_element_count": element_total,
+            "text_tensor_count_by_checkpoint_dtype": dict(sorted(tensor_count_by_dtype.items())),
+            "conforming_tensor_count": len(mappings) - len(discrepancies),
+            "conversion_tensor_count": len(discrepancies),
+            "manifest_parameter_bytes": manifest_total,
+            "checkpoint_text_bytes": sum(text_bytes_by_dtype.values()),
+            "checkpoint_text_bytes_by_dtype": dict(sorted(text_bytes_by_dtype.items())),
+            "conversion_reclaim_bytes": sum(item.source.nbytes - item.manifest_bytes for item in discrepancies),
+            "excluded_tensor_count": sum(group.tensor_count for group in excluded),
+            "excluded_bytes": sum(group.nbytes for group in excluded),
+            "dtype_discrepancy_count": len(discrepancies),
+            "dtype_discrepancy_bytes": sum(
+                item.source.nbytes - item.manifest_bytes for item in discrepancies
+            ),
+            "dtype_discrepancy_groups": discrepancy_groups,
+        }
+    )
+
+    return WeightMapping(
+        schema.graph_digest,
+        checkpoint.path,
+        bool(tie_word_embeddings),
+        len(parameters),
+        len(mappings),
+        unmapped,
+        unexpected,
+        tuple(mappings),
+        tuple(excluded),
+        tied,
+        totals,
+    )
+
+
+def _shape_elements(shape: Sequence[int]) -> int:
+    total = 1
+    for dimension in shape:
+        total *= int(dimension)
+    return total
+
+
+def manifest_profile_from_metadata(program_metadata: Mapping[str, Any]) -> Mapping[str, int]:
+    """从 graph metadata 反推出 :func:`_decoder_parameter_manifest` 的 profile。
+
+    仅用于交叉审计：把 metadata 的 attention/gdr 维度还原成 profile，再与
+    compact manifest 重新生成结果逐字段比较。
+    """
+
+    attention = program_metadata.get("attention")
+    gdr = program_metadata.get("gdr")
+    hidden_input_shape = program_metadata.get("hidden_input_shape")
+    if not isinstance(attention, Mapping) or not isinstance(gdr, Mapping):
+        raise WeightMapMismatchError("graph metadata must declare attention and gdr profiles")
+    if not isinstance(hidden_input_shape, Sequence) or len(hidden_input_shape) != 3:
+        raise WeightMapMismatchError("graph metadata hidden_input_shape must be rank 3")
+    parameters = program_metadata.get("parameter_manifest")
+    if not isinstance(parameters, Sequence) or not parameters:
+        raise WeightMapMismatchError("graph metadata must declare a parameter_manifest")
+    by_pattern = {entry["name"]: entry for entry in parameters}
+    return {
+        "hidden": int(hidden_input_shape[-1]),
+        "intermediate": int(by_pattern["layers.*.mlp.gate_proj.weight"]["shape"][0]),
+        "vocab": int(by_pattern["embedding_lm_head_shared_weight"]["shape"][0]),
+        "query_heads": int(attention["query_heads"]),
+        "kv_heads": int(attention["kv_heads"]),
+        "head_dim": int(attention["head_dim"]),
+        "rotary_dim": int(attention["rotary_dim"]),
+        "linear_key_heads": int(gdr["key_heads"]),
+        "linear_value_heads": int(gdr["value_heads"]),
+        "linear_key_dim": int(gdr["key_dim"]),
+        "linear_value_dim": int(gdr["value_dim"]),
+        "conv_kernel": int(gdr["conv_kernel"]),
+    }
+
+
+def assert_manifest_reproducible(program_metadata: Mapping[str, Any], dtype: str = "bf16") -> Tuple[Mapping[str, Any], ...]:
+    """用反推 profile 重新生成 compact manifest 并逐字段比对，返回重生成结果。"""
+
+    profile = manifest_profile_from_metadata(program_metadata)
+    regenerated = tuple(_decoder_parameter_manifest(profile, dtype))
+    declared = tuple(program_metadata["parameter_manifest"])
+    if len(regenerated) != len(declared):
+        raise WeightMapMismatchError("regenerated manifest length differs from declared manifest")
+    for index, (actual, expected) in enumerate(zip(declared, regenerated)):
+        for field in ("name", "storage_id", "dtype", "count", "elements_per_tensor", "parameter_elements", "storage_bytes"):
+            if actual.get(field) != expected.get(field):
+                raise WeightMapMismatchError(
+                    "manifest[{}].{} declared {!r} but regenerated {!r}".format(
+                        index, field, actual.get(field), expected.get(field)
+                    )
+                )
+        if tuple(actual.get("shape") or ()) != tuple(expected.get("shape") or ()):
+            raise WeightMapMismatchError("manifest[{}].shape is not reproducible".format(index))
+        if tuple(actual.get("aliases") or ()) != tuple(expected.get("aliases") or ()):
+            raise WeightMapMismatchError("manifest[{}].aliases is not reproducible".format(index))
+    return regenerated
