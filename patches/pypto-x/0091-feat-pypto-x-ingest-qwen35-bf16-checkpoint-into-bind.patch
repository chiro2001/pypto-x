+"""无第三方依赖 safetensors 只读读取器的单测。
+
+覆盖：13 种 dtype 的正常解析、mmap/pread 两种视图模式、只读语义、header
+负例（截断/非 JSON/未知字段/重复键/不支持的 dtype）与数据段负例（越界、
+重叠、空洞、shape 与 nbytes 不一致）。所有 fixture 都是 KB 级合成文件。
+"""
+
+from __future__ import annotations
+
+import mmap
+import struct
+from pathlib import Path
+
+import pytest
+
+from pypto.portable.safetensors_reader import (
+    SAFETENSORS_DTYPES,
+    SafetensorsBoundsError,
+    SafetensorsClosedError,
+    SafetensorsError,
+    SafetensorsFormatError,
+    SafetensorsLayoutError,
+    SafetensorsReader,
+    read_tensor_catalog,
+)
+from pypto_x.qwen35_weight_fixture import payload_for, write_raw_header_json, write_raw_safetensors, write_safetensors
+
+
+ALL_DTYPES = (
+    ("u8", "U8", (5,)),
+    ("i8", "I8", (5,)),
+    ("i16", "I16", (3, 2)),
+    ("u16", "U16", (3, 2)),
+    ("f16", "F16", (4,)),
+    ("bf16", "BF16", (4, 3)),
+    ("i32", "I32", (2, 2)),
+    ("u32", "U32", (2, 2)),
+    ("f32", "F32", (7,)),
+    ("i64", "I64", (3,)),
+    ("u64", "U64", (3,)),
+    ("f64", "F64", (2, 2)),
+    ("bool", "BOOL", (9,)),
+)
+
+
+def _all_dtype_file(tmp_path, mode):
+    path = Path(tmp_path) / "all-{}.safetensors".format(mode)
+    header = write_safetensors(path, [(name, dtype, shape) for name, dtype, shape in ALL_DTYPES])
+    return path, header
+
+
+@pytest.mark.parametrize("mode", ("mmap", "pread"))
+def test_reader_parses_every_supported_dtype(tmp_path, mode):
+    path, header = _all_dtype_file(tmp_path, mode)
+    with SafetensorsReader(str(path), mode=mode) as reader:
+        assert len(reader) == len(ALL_DTYPES)
+        assert sorted(reader.names) == sorted(name for name, _, _ in ALL_DTYPES)
+        assert reader.data_offset == 8 + reader.header_nbytes
+        assert reader.data_nbytes == sum(
+            entry["data_offsets"][1] - entry["data_offsets"][0] for entry in header.values()
+        )
+        for name, dtype, shape in ALL_DTYPES:
+            tensor = reader.info(name)
+            itemsize, pypto_dtype = SAFETENSORS_DTYPES[dtype]
+            assert tensor.dtype == dtype
+            assert tensor.pypto_dtype == pypto_dtype
+            assert tensor.shape == shape
+            assert tensor.itemsize == itemsize
+            assert tensor.nbytes == tensor.elements * itemsize
+            assert tensor.data_offset == header[name]["data_offsets"][0]
+            assert tensor.file_offset == 8 + reader.header_nbytes + tensor.data_offset
+            view = reader.view(name)
+            assert isinstance(view, memoryview)
+            assert view.readonly is True
+            assert view.nbytes == tensor.nbytes
+            assert view.tobytes() == payload_for(name, tensor.nbytes)
+            view.release()
+        # 负例：不存在的名字与越界切片
+        with pytest.raises(SafetensorsError, match="no tensor"):
+            reader.info("missing")
+        with pytest.raises(SafetensorsBoundsError):
+            reader.view_range("f32", 1, reader.info("f32").nbytes)
+
+
+def test_mmap_view_is_zero_copy_and_pread_view_is_owned(tmp_path):
+    path = Path(tmp_path) / "zero-copy.safetensors"
+    write_safetensors(path, [("a", "BF16", (8,)), ("b", "F32", (3,))])
+    with SafetensorsReader(str(path), mode="mmap") as reader:
+        view = reader.view("a")
+        assert isinstance(view.obj, mmap.mmap)
+        assert view.tobytes() == payload_for("a", 16)
+        view.release()
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        view = reader.view("a")
+        assert isinstance(view.obj, bytes)
+        assert view.tobytes() == payload_for("a", 16)
+        view.release()
+
+
+def test_reader_fails_closed_after_close(tmp_path):
+    path = Path(tmp_path) / "closed.safetensors"
+    write_safetensors(path, [("a", "BF16", (4,))])
+    reader = SafetensorsReader(str(path), mode="pread")
+    reader.close()
+    reader.close()
+    with pytest.raises(SafetensorsClosedError):
+        reader.view("a")
+    with pytest.raises(SafetensorsClosedError):
+        reader.sha256()
+    with pytest.raises(SafetensorsClosedError):
+        with reader:
+            pass
+
+
+def test_sha256_is_streaming_and_matches_file_digest(tmp_path):
+    import hashlib
+
+    path = Path(tmp_path) / "hash.safetensors"
+    write_safetensors(path, [("a", "I32", (64,)), ("b", "BOOL", (7,))])
+    expected = hashlib.sha256(path.read_bytes()).hexdigest()
+    with SafetensorsReader(str(path), mode="pread") as reader:
+        assert reader.sha256(chunk_bytes=17) == expected
+        assert reader.sha256() == expected
+
+
+def test_read_tensor_catalog_returns_metadata_without_open_handle(tmp_path):
+    path = Path(tmp_path) / "catalog.safetensors"
+    write_safetensors(path, [("a", "BF16", (4,))], metadata={"format": "pt"})
+    catalog = read_tensor_catalog(str(path))
+    assert tuple(catalog) == ("a",)
+    assert catalog["a"].nbytes == 8
+    with SafetensorsReader(str(path)) as reader:
+        assert reader.metadata == {"format": "pt"}
+        assert reader.to_dict()["tensor_count"] == 1
+
