@@ -0,0 +1,634 @@
+"""Qwen3.5-0.8B 真实权重的 storage-relative packed layout。
+
+该模块把 :func:`pypto.portable.runtime_binding.build_packed_layout` 冻结的
+368 个 region（320 文本参数 + 48 状态）与 :mod:`pypto.portable.qwen35_weight_map`
+得到的官方 checkpoint file offset 合并成一份可复现、无重叠、无歧义空洞的
+JSON 描述。
+
+region 的 ``offset`` 是 **storage-relative** packed 偏移（M1J 冻结契约，64 字节
+对齐）；``source.file_offset`` 是该参数在 safetensors 文件中的真实绝对偏移。
+两者是不同的坐标系，绝不混用。状态 region 没有 checkpoint 来源，显式标记为
+``source: null``。
+
+布局校验：
+
+* 相邻 region 的 ``offset`` 必须恰好等于 ``align_up(previous_end, alignment)``，
+  因此既无重叠，也不存在未被记录的 padding；
+* 所有 parameter region 必须各自绑定唯一一个官方张量，且官方 file 区间两两不重叠；
+* dtype 与契约不一致的 region 会被标记 ``requires_dtype_conversion=true``，
+  由调用方决定是否转换，本模块不静默改写契约 dtype。
+
+**精度边界**：Qwen3.5-0.8B checkpoint 的 ``linear_attn.A_log`` 与
+``linear_attn.norm.weight`` 是 F32，而冻结契约要求全部 320 个参数为 bf16。
+:func:`convert_region_bytes` 按 IEEE-754 round-to-nearest-even 把它们降为
+BF16（不是截断），:func:`audit_precision_boundary` 用真实权重测出逐张量误差，
+把这一步量化成可复核的数字，而不是一句"有损"。
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import struct
+from dataclasses import dataclass
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
+
+from .qwen35 import build_qwen35_text_decoder_graph
+from .qwen35_weight_map import (
+    WeightMapping,
+    build_weight_mapping,
+    tie_word_embeddings_from_config,
+)
+from .runtime_binding import (
+    DEFAULT_PACK_ALIGNMENT,
+    BindingSchema,
+    PackedRegion,
+    build_binding_schema,
+    build_packed_layout,
+)
+from .safetensors_reader import SafetensorsReader
+
+
+class WeightLayoutError(ValueError):
+    """真实权重 layout 构造失败。"""
+
+
+@dataclass(frozen=True)
+class WeightLayoutRegion:
+    """packed region 与其官方 checkpoint 来源的合并描述。"""
+
+    storage_id: str
+    role: str
+    dtype: str
+    shape: Tuple[int, ...]
+    nbytes: int
+    offset: int
+    alignment: int
+    logical_names: Tuple[str, ...]
+    source_name: Optional[str]
+    source_file_offset: Optional[int]
+    source_data_offset: Optional[int]
+    source_dtype: Optional[str]
+    source_nbytes: Optional[int]
+    source_elements: Optional[int]
+    requires_dtype_conversion: bool
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "storage_id": self.storage_id,
+            "role": self.role,
+            "dtype": self.dtype,
+            "shape": list(self.shape),
+            "nbytes": self.nbytes,
+            "offset": self.offset,
+            "alignment": self.alignment,
+            "logical_names": list(self.logical_names),
+            "requires_dtype_conversion": self.requires_dtype_conversion,
+            "source": None
+            if self.source_name is None
+            else {
+                "tensor": self.source_name,
+                "file_offset": self.source_file_offset,
+                "data_offset": self.source_data_offset,
+                "dtype": self.source_dtype,
+                "nbytes": self.source_nbytes,
+                "elements": self.source_elements,
+            },
+        }
+
+
+@dataclass(frozen=True)
+class WeightLayout:
+    """完整的 368-region 真实权重 layout。"""
+
+    schema_digest: str
+    checkpoint_path: str
+    alignment: int
+    regions: Tuple[WeightLayoutRegion, ...]
+    total_nbytes: int
+    dtype_conversion_storage_ids: Tuple[str, ...]
+    source_text_bytes: int
+    source_file_nbytes: int
+
+    @property
+    def parameter_regions(self) -> Tuple[WeightLayoutRegion, ...]:
+        return tuple(region for region in self.regions if region.role == "parameter")
+
+    @property
+    def state_regions(self) -> Tuple[WeightLayoutRegion, ...]:
+        return tuple(region for region in self.regions if region.role == "state")
+
+    @property
+    def padding_nbytes(self) -> int:
+        return self.total_nbytes - sum(region.nbytes for region in self.regions)
+
+    def region_for(self, logical_name: str) -> WeightLayoutRegion:
+        for region in self.regions:
+            if logical_name in region.logical_names:
+                return region
+        raise WeightLayoutError("weight layout has no logical name {!r}".format(logical_name))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "layout_kind": "qwen35_text_decoder_weight_layout",
+            "layout_version": 1,
+            "schema_digest": self.schema_digest,
+            "checkpoint_path": self.checkpoint_path,
+            "alignment": self.alignment,
+            "region_count": len(self.regions),
+            "parameter_region_count": len(self.parameter_regions),
+            "state_region_count": len(self.state_regions),
+            "total_nbytes": self.total_nbytes,
+            "parameter_nbytes": sum(region.nbytes for region in self.parameter_regions),
+            "state_nbytes": sum(region.nbytes for region in self.state_regions),
+            "padding_nbytes": self.padding_nbytes,
+            "source_file_nbytes": self.source_file_nbytes,
+            "source_text_bytes": self.source_text_bytes,
+            "dtype_conversion_region_count": len(self.dtype_conversion_storage_ids),
+            "dtype_conversion_storage_ids": list(self.dtype_conversion_storage_ids),
+            "state_regions_without_source": [region.storage_id for region in self.state_regions],
+            "regions": [region.to_dict() for region in self.regions],
+        }
+
+    def canonical_json(self) -> str:
+        return json.dumps(self.to_dict(), ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+    def layout_digest(self) -> str:
+        return hashlib.sha256(self.canonical_json().encode("utf-8")).hexdigest()
+
+
+def _align_up(value: int, alignment: int) -> int:
+    remainder = value % alignment
+    return value if not remainder else value + alignment - remainder
+
+
+def _source_by_storage(weight_mapping: WeightMapping) -> Mapping[str, Any]:
+    table: Dict[str, Any] = {}
+    for item in weight_mapping.mappings:
+        existing = table.get(item.storage_id)
+        if existing is not None and existing.source.official_name != item.source.official_name:
+            raise WeightLayoutError(
+                "storage {!r} is shared by {} and {}".format(
+                    item.storage_id, existing.source.official_name, item.source.official_name
+                )
+            )
+        table[item.storage_id] = item
+    return table
+
+
+def _verify_region_chain(regions: Sequence[PackedRegion], alignment: int) -> None:
+    cursor = 0
+    for region in regions:
+        if region.offset != _align_up(cursor, alignment):
+            raise WeightLayoutError(
+                "region {!r} offset {} is not align_up({}, {})".format(
+                    region.storage_id, region.offset, cursor, alignment
+                )
+            )
+        if region.alignment != alignment:
+            raise WeightLayoutError(
+                "region {!r} alignment {} differs from layout alignment {}".format(
+                    region.storage_id, region.alignment, alignment
+                )
+            )
+        cursor = region.offset + region.nbytes
+
+
+def _verify_source_disjoint(regions: Sequence[WeightLayoutRegion]) -> None:
+    spans = sorted(
+        (region.source_file_offset, region.source_file_offset + region.source_nbytes, region.storage_id)
+        for region in regions
+        if region.source_file_offset is not None
+    )
+    cursor = -1
+    for begin, end, storage_id in spans:
+        if begin < cursor:
+            raise WeightLayoutError(
+                "checkpoint range [{}, {}) for {!r} overlaps a previous tensor".format(begin, end, storage_id)
+            )
+        cursor = end
+
+
+def build_weight_layout(
+    schema: BindingSchema,
+    weight_mapping: WeightMapping,
+    checkpoint: SafetensorsReader,
+    *,
+    alignment: int = DEFAULT_PACK_ALIGNMENT,
+) -> WeightLayout:
+    """把冻结的 packed layout 与真实 checkpoint offset 合并成可审计 layout。"""
+
+    if not isinstance(schema, BindingSchema):
+        raise WeightLayoutError("schema must be a BindingSchema")
+    if not isinstance(weight_mapping, WeightMapping):
+        raise WeightLayoutError("weight_mapping must be a WeightMapping")
+    if weight_mapping.graph_digest != schema.graph_digest:
+        raise WeightLayoutError("weight mapping was built for a different graph digest")
+    packed = build_packed_layout(schema, alignment)
+    _verify_region_chain(packed.regions, packed.alignment)
+
+    source_by_storage = _source_by_storage(weight_mapping)
+    regions: List[WeightLayoutRegion] = []
+    for region in packed.regions:
+        if region.role == "parameter":
+            item = source_by_storage.get(region.storage_id)
+            if item is None:
+                raise WeightLayoutError(
+                    "parameter region {!r} has no checkpoint source".format(region.storage_id)
+                )
+            source = item.source
+            if item.dtype_conforms:
+                if source.nbytes != region.nbytes:
+                    raise WeightLayoutError(
+                        "parameter region {!r} nbytes {} differs from conforming source {}".format(
+                            region.storage_id, region.nbytes, source.nbytes
+                        )
+                    )
+            elif source.nbytes != region.nbytes * 2:
+                raise WeightLayoutError(
+                    "non-conforming region {!r} must halve source bytes ({} -> {})".format(
+                        region.storage_id, source.nbytes, region.nbytes
+                    )
+                )
+            regions.append(
+                WeightLayoutRegion(
+                    region.storage_id,
+                    region.role,
+                    region.dtype,
+                    region.shape,
+                    region.nbytes,
+                    region.offset,
+                    region.alignment,
+                    region.logical_names,
+                    source.official_name,
+                    source.file_offset,
+                    source.data_offset,
+                    source.dtype,
+                    source.nbytes,
+                    source.elements,
+                    not item.dtype_conforms,
+                )
+            )
+        elif region.role == "state":
+            regions.append(
+                WeightLayoutRegion(
+                    region.storage_id,
+                    region.role,
+                    region.dtype,
+                    region.shape,
+                    region.nbytes,
+                    region.offset,
+                    region.alignment,
+                    region.logical_names,
+                    None,
+                    None,
+                    None,
+                    None,
+                    None,
+                    None,
+                    False,
+                )
+            )
+        else:
+            raise WeightLayoutError("unexpected packed region role {!r}".format(region.role))
+
+    _verify_source_disjoint(regions)
+    parameter_regions = tuple(region for region in regions if region.role == "parameter")
+    if len(parameter_regions) != weight_mapping.mapped_count:
+        raise WeightLayoutError(
+            "layout has {} parameter regions but mapping has {} parameters".format(
+                len(parameter_regions), weight_mapping.mapped_count
+            )
+        )
+    used_storage = set(region.storage_id for region in parameter_regions)
+    missing = set(item.storage_id for item in weight_mapping.mappings) - used_storage
+    if missing:
+        raise WeightLayoutError("{} mapped storages are absent from the layout".format(len(missing)))
+
+    return WeightLayout(
+        schema.graph_digest,
+        checkpoint.path,
+        packed.alignment,
+        tuple(regions),
+        packed.total_nbytes,
+        tuple(sorted(region.storage_id for region in regions if region.requires_dtype_conversion)),
+        sum(region.source_nbytes for region in parameter_regions),
+        checkpoint.file_nbytes,
+    )
+
+
+BF16_EXPONENT_MASK = 0x7F800000
+BF16_DEFAULT_CHUNK_ELEMENTS = 1 << 16
+
+
+def float32_bits_to_bfloat16_bits(value: int) -> int:
+    """IEEE-754 binary32 位模式按 RNE 舍入到 binary16(bfloat16) 位模式。
+
+    规则与 TensorFlow/PyTorch 的 ``float_to_bfloat16`` 一致：加上
+    ``0x7FFF + lsb`` 后右移 16 位，因此是 round-to-nearest-even，不是截断。
+    NaN/Inf（指数全 1）单独处理，避免把 NaN 静默变成 Inf。
+    """
+
+    if value < 0 or value > 0xFFFFFFFF:
+        raise WeightLayoutError("float32 bit pattern out of range")
+    if (value & BF16_EXPONENT_MASK) == BF16_EXPONENT_MASK:
+        high = value >> 16
+        if value & 0x007FFFFF:
+            return high | 0x0040
+        return high
+    rounding_bias = 0x7FFF + ((value >> 16) & 1)
+    return ((value + rounding_bias) >> 16) & 0xFFFF
+
+
+def convert_f32_view_to_bf16_rne(view: memoryview, chunk_elements: int = BF16_DEFAULT_CHUNK_ELEMENTS) -> bytearray:
+    """把 F32 只读视图按 RNE 转成 BF16 字节序列。
+
+    按 chunk 处理，峰值内存是 ``chunk_elements * 8`` 字节量级，与输入长度无关。
+    """
+
+    if view.itemsize != 1 or view.nbytes % 4:
+        raise WeightLayoutError("float32 source view must be a byte view of length divisible by 4")
+    if isinstance(chunk_elements, bool) or not isinstance(chunk_elements, int) or chunk_elements <= 0:
+        raise WeightLayoutError("chunk_elements must be a positive integer")
+    elements = view.nbytes // 4
+    output = bytearray(elements * 2)
+    position = 0
+    while position < elements:
+        count = min(chunk_elements, elements - position)
+        values = struct.unpack_from("<{}I".format(count), view, position * 4)
+        packed = [float32_bits_to_bfloat16_bits(value) for value in values]
+        struct.pack_into("<{}H".format(count), output, position * 2, *packed)
+        position += count
+    return output
+
+
+def float32_view_to_float_list(view: memoryview) -> List[float]:
+    """把 F32 视图解成 Python float 列表（只用于小张量误差审计）。"""
+
+    elements = view.nbytes // 4
+    return list(struct.unpack_from("<{}f".format(elements), view, 0))
+
+
+def bfloat16_bytes_to_float_list(data: bytes) -> List[float]:
+    elements = len(data) // 2
+    bits = struct.unpack_from("<{}H".format(elements), data, 0)
+    return list(struct.unpack_from("<{}f".format(elements), struct.pack("<{}I".format(elements), *[value << 16 for value in bits]), 0))
+
+
+@dataclass(frozen=True)
+class RegionConversion:
+    """一个 parameter region 的存储字节来源与（必要时）降精度证据。"""
+
+    storage_id: str
+    source_name: str
+    source_dtype: str
+    contract_dtype: str
+    source_nbytes: int
+    contract_nbytes: int
+    elements: int
+    status: str
+    source_sha256: Optional[str]
+    converted_sha256: Optional[str]
+    max_abs_error: Optional[float]
+    max_relative_error: Optional[float]
+    exact_elements: Optional[int]
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "storage_id": self.storage_id,
+            "source_name": self.source_name,
+            "source_dtype": self.source_dtype,
+            "contract_dtype": self.contract_dtype,
+            "source_nbytes": self.source_nbytes,
+            "contract_nbytes": self.contract_nbytes,
+            "elements": self.elements,
+            "status": self.status,
+            "source_sha256": self.source_sha256,
+            "converted_sha256": self.converted_sha256,
+            "max_abs_error": self.max_abs_error,
+            "max_relative_error": self.max_relative_error,
+            "exact_elements": self.exact_elements,
+        }
+
+
+def convert_region_bytes(reader: SafetensorsReader, region: WeightLayoutRegion) -> bytes:
+    """返回一个 parameter region 存入 packed storage 时应有的**契约 dtype** 字节。
+
+    dtype 一致的 region 直接返回源字节；F32 源按 RNE 降为 BF16，字节数减半。
+    状态 region 与缺失来源都会 fail closed。
+    """
+
+    if region.source_name is None:
+        raise WeightLayoutError("region {!r} has no checkpoint source".format(region.storage_id))
+    view = reader.view(region.source_name)
+    try:
+        if not region.requires_dtype_conversion:
+            if view.nbytes != region.nbytes:
+                raise WeightLayoutError(
+                    "region {!r} source bytes {} differ from contract {}".format(
+                        region.storage_id, view.nbytes, region.nbytes
+                    )
+                )
+            return view.tobytes()
+        if region.source_dtype != "F32" or region.dtype != "bf16":
+            raise WeightLayoutError(
+                "region {!r} conversion {} -> {} is not supported".format(
+                    region.storage_id, region.source_dtype, region.dtype
+                )
+            )
+        if view.nbytes != region.nbytes * 2:
+            raise WeightLayoutError(
+                "region {!r} expects {} F32 bytes for {} BF16 bytes but source has {}".format(
+                    region.storage_id, region.nbytes * 2, region.nbytes, view.nbytes
+                )
+            )
+        return bytes(convert_f32_view_to_bf16_rne(view))
+    finally:
+        view.release()
+
+
+def audit_precision_boundary(
+    reader: SafetensorsReader,
+    layout: WeightLayout,
+) -> Tuple[RegionConversion, ...]:
+    """逐 region 记录存储来源；只对需要降精度的 region 读取真实权重并测误差。
+
+    dtype 一致的 region 不做任何数据读取（因此 1.5 GB 的 BF16 参数不会被触碰），
+    只有几百字节到几十 KB 的 F32 异常张量被读入并量化误差。
+    """
+
+    results: List[RegionConversion] = []
+    for region in layout.parameter_regions:
+        if not region.requires_dtype_conversion:
+            results.append(
+                RegionConversion(
+                    region.storage_id,
+                    region.source_name,
+                    region.source_dtype,
+                    region.dtype,
+                    region.source_nbytes,
+                    region.nbytes,
+                    region.source_elements,
+                    "identity",
+                    None,
+                    None,
+                    None,
+                    None,
+                    None,
+                )
+            )
+            continue
+        if region.source_nbytes != region.nbytes * 2:
+            raise WeightLayoutError(
+                "region {!r} conversion must halve bytes ({} -> {})".format(
+                    region.storage_id, region.source_nbytes, region.nbytes
+                )
+            )
+        view = reader.view(region.source_name)
+        try:
+            source_bytes = view.tobytes()
+            converted = convert_region_bytes(reader, region)
+        finally:
+            view.release()
+        if len(converted) != region.nbytes:
+            raise WeightLayoutError(
+                "region {!r} converted to {} bytes, contract requires {}".format(
+                    region.storage_id, len(converted), region.nbytes
+                )
+            )
+        originals = float32_view_to_float_list(memoryview(source_bytes))
+        restored = bfloat16_bytes_to_float_list(converted)
+        if len(originals) != len(restored):
+            raise WeightLayoutError("region {!r} round-trip length mismatch".format(region.storage_id))
+        max_abs = 0.0
+        max_rel = 0.0
+        exact = 0
+        for original, rounded in zip(originals, restored):
+            if original == rounded:
+                exact += 1
+            delta = abs(rounded - original)
+            if delta > max_abs:
+                max_abs = delta
+            if original != 0.0:
+                relative = delta / abs(original)
+                if relative > max_rel:
+                    max_rel = relative
+        results.append(
+            RegionConversion(
+                region.storage_id,
+                region.source_name,
+                region.source_dtype,
+                region.dtype,
+                region.source_nbytes,
+                region.nbytes,
+                region.source_elements,
+                "converted_rne",
+                hashlib.sha256(source_bytes).hexdigest(),
+                hashlib.sha256(converted).hexdigest(),
+                max_abs,
+                max_rel,
+                exact,
+            )
+        )
+    return tuple(results)
+
+
+def _positive_alignment(value: str) -> int:
+    try:
+        alignment = int(value, 10)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("alignment must be an integer") from exc
+    if alignment <= 0 or alignment & (alignment - 1):
+        raise argparse.ArgumentTypeError("alignment must be a positive power of two")
+    return alignment
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    """CLI：产出真实权重 layout JSON（只读 header，不物化权重）。"""
+
+    parser = argparse.ArgumentParser(description="Emit the Qwen3.5-0.8B text decoder weight layout")
+    parser.add_argument("--checkpoint", required=True, help="safetensors file path")
+    parser.add_argument("--output", required=True, help="layout JSON output path")
+    parser.add_argument("--config", default=None, help="optional official config.json for tie_word_embeddings")
+    parser.add_argument("--alignment", type=_positive_alignment, default=DEFAULT_PACK_ALIGNMENT)
+    parser.add_argument("--batch", type=int, default=1)
+    parser.add_argument("--steps", type=int, default=1)
+    parser.add_argument("--past-length", type=int, default=0)
+    args = parser.parse_args(argv)
+
+    tie_word_embeddings = True
+    if args.config:
+        tie_word_embeddings = tie_word_embeddings_from_config(args.config)
+    program = build_qwen35_text_decoder_graph(
+        args.batch, args.steps, past_length=args.past_length, shape_profile="model"
+    )
+    schema = build_binding_schema(program)
+    with SafetensorsReader(args.checkpoint, mode="pread") as checkpoint:
+        mapping = build_weight_mapping(
+            schema, program.metadata, checkpoint, tie_word_embeddings=tie_word_embeddings
+        )
+        layout = build_weight_layout(schema, mapping, checkpoint, alignment=args.alignment)
+        conversions = audit_precision_boundary(checkpoint, layout)
+        payload = {
+            "status": "PASS",
+            "schema_digest": schema.graph_digest,
+            "layout_digest": layout.layout_digest(),
+            "mapping": {
+                "parameter_count": mapping.parameter_count,
+                "mapped_count": mapping.mapped_count,
+                "dtype_discrepancies": len(mapping.dtype_discrepancies),
+                "excluded": [
+                    {"group": group.group, "tensor_count": group.tensor_count, "nbytes": group.nbytes}
+                    for group in mapping.excluded
+                ],
+                "tied": mapping.tied.to_dict(),
+                "totals": dict(mapping.totals),
+            },
+            "conversion": {
+                "region_count": len(conversions),
+                "converted_region_count": sum(1 for item in conversions if item.status == "converted_rne"),
+                "converted_source_bytes": sum(
+                    item.source_nbytes for item in conversions if item.status == "converted_rne"
+                ),
+                "converted_contract_bytes": sum(
+                    item.contract_nbytes for item in conversions if item.status == "converted_rne"
+                ),
+                "max_relative_error": max(
+                    [item.max_relative_error for item in conversions if item.max_relative_error is not None]
+                    or [0.0]
+                ),
+                "regions": [
+                    item.to_dict() for item in conversions if item.status == "converted_rne"
+                ],
+            },
+            "layout": layout.to_dict(),
+        }
+        output = args.output
+        with open(output, "w", encoding="utf-8") as stream:
+            json.dump(payload, stream, ensure_ascii=False, sort_keys=True, indent=2)
+            stream.write("\n")
+    summary = {
+        "status": "PASS",
+        "output": args.output,
+        "region_count": len(layout.regions),
+        "total_nbytes": layout.total_nbytes,
+        "mapped_count": mapping.mapped_count,
+        "dtype_conversion_region_count": len(layout.dtype_conversion_storage_ids),
+        "layout_digest": layout.layout_digest(),
+    }
+    print(json.dumps(summary, ensure_ascii=False, sort_keys=True))
+    return 0
+
+
+__all__ = [
+    "WeightLayout",
+    "WeightLayoutError",
+    "WeightLayoutRegion",
+    "build_weight_layout",
+    "main",
+]
+
+
+if __name__ == "__main__":  # pragma: no cover - CLI 入口
+    raise SystemExit(main())
