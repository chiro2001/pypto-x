+@pytest.mark.parametrize(
+    "header, body_nbytes, error, match",
+    (
+        ({}, 8, SafetensorsLayoutError, "cover"),
+        ({"a": {"dtype": "BF16", "shape": [4], "data_offsets": [0, 2]}}, 8, SafetensorsFormatError, "require"),
+        ({"a": {"dtype": "BF16", "shape": [3, 3], "data_offsets": [0, 8]}}, 8, SafetensorsFormatError, "require"),
+        ({"a": {"dtype": "F8_E4M3", "shape": [4], "data_offsets": [0, 4]}}, 4, SafetensorsFormatError, "unsupported dtype"),
+        (
+            {"a": {"dtype": "BF16", "shape": [4], "data_offsets": [0, 8], "extra": 1}},
+            8,
+            SafetensorsFormatError,
+            "unknown fields",
+        ),
+        ({"a": {"dtype": "BF16", "data_offsets": [0, 8]}}, 8, SafetensorsFormatError, "missing shape"),
+        (
+            {"a": {"dtype": "BF16", "shape": [4000], "data_offsets": [8, 8008]}},
+            8,
+            SafetensorsBoundsError,
+            "beyond data section",
+        ),
+        (
+            {
+                "a": {"dtype": "BF16", "shape": [4], "data_offsets": [0, 8]},
+                "b": {"dtype": "BF16", "shape": [4], "data_offsets": [4, 12]},
+            },
+            12,
+            SafetensorsLayoutError,
+            "overlaps",
+        ),
+        (
+            {
+                "a": {"dtype": "BF16", "shape": [4], "data_offsets": [0, 8]},
+                "b": {"dtype": "BF16", "shape": [4], "data_offsets": [12, 20]},
+            },
+            20,
+            SafetensorsLayoutError,
+            "gap",
+        ),
+    ),
+)
+def test_header_negative_cases_fail_closed(tmp_path, header, body_nbytes, error, match):
+    path = Path(tmp_path) / "negative.safetensors"
+    write_raw_header_json(path, header, b"\x00" * body_nbytes)
+    with pytest.raises(error, match=match):
+        SafetensorsReader(str(path))
