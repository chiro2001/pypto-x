+def test_overlapping_and_gapped_offsets_are_rejected(tmp_path):
+    path = Path(tmp_path) / "overlap.safetensors"
+    write_raw_header_json(
+        path,
+        {
+            "a": {"dtype": "BF16", "shape": [4], "data_offsets": [0, 8]},
+            "b": {"dtype": "BF16", "shape": [4], "data_offsets": [4, 12]},
+        },
+        b"\x00" * 12,
+    )
+    with pytest.raises(SafetensorsLayoutError, match="overlaps"):
+        SafetensorsReader(str(path))
+    write_raw_header_json(
+        path,
+        {
+            "a": {"dtype": "BF16", "shape": [4], "data_offsets": [0, 8]},
+            "b": {"dtype": "BF16", "shape": [4], "data_offsets": [12, 20]},
