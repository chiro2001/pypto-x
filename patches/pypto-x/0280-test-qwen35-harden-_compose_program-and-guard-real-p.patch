+# ---------------------------------------------------------------------------
+# Composition primitive robustness (round-2)
+# ---------------------------------------------------------------------------
+
+
+def _probe_parent(name: str = "probe_parent"):
+    return qwen35._Builder(name, "probe", (2,))
+
+
+def _float2(parent, name: str) -> ValueRef:
+    return parent.parameter(name, CoreType.tensor("float32", (2,)))
+
+
+def _scalar(parent, name: str) -> ValueRef:
+    return parent.parameter(name, CoreType.scalar("float32"))
+
+
+def test_compose_rejects_unknown_bindings():
+    parent = _probe_parent()
+    child = build_rms_norm((2,), "float32")
+    bindings = {
+        "x": _float2(parent, "x_in"),
+        "weight": _float2(parent, "w_in"),
+        "epsilon": _scalar(parent, "eps_in"),
+        "bogus": _float2(parent, "bogus_in"),
+    }
+    with pytest.raises(ValueError, match="unknown parameters: bogus"):
+        qwen35._compose_program(parent, child, bindings)
+
+
+def test_compose_rejects_foreign_binding():
+    other = _probe_parent("other_parent")
+    foreign = _float2(other, "foreign")
+    parent = _probe_parent()
+    bindings = {
+        "x": foreign,
+        "weight": _float2(parent, "w_in"),
+        "epsilon": _scalar(parent, "eps_in"),
+    }
+    with pytest.raises(ValueError, match="not a value of parent builder"):
+        qwen35._compose_program(parent, build_rms_norm((2,), "float32"), bindings)
+
+
+def test_compose_rejects_parameter_output_shadowing():
+    parameter = ValueRef("v", CoreType.tensor("float32", (2,)))
+    shadow = ValueRef("v", CoreType.tensor("float32", (2,)))
+    operation = Operation("identity", (parameter,), (shadow,))
+    function = CoreFunction(
+        "shadowed", (parameter,), (shadow,), Region((operation,))
+    )
+    program = CoreProgram(functions=(function,), metadata={})
+    parent = _probe_parent()
+    bound = _float2(parent, "v_in")
+    with pytest.raises(ValueError, match="reuses parameter names as operation outputs: v"):
+        qwen35._compose_program(parent, program, {"v": bound})
+
+
+def test_compose_rejects_bare_string_returns():
+    parent = _probe_parent()
+    bindings = {
+        "x": _float2(parent, "x_in"),
+        "weight": _float2(parent, "w_in"),
+        "epsilon": _scalar(parent, "eps_in"),
+    }
+    with pytest.raises(ValueError, match="sequence of SSA names"):
+        qwen35._compose_program(
+            parent, build_rms_norm((2,), "float32"), bindings, "rms_scaled"
+        )
+
+
+def test_compose_rejects_empty_rename_key():
+    parent = _probe_parent()
+    bindings = {
+        "x": _float2(parent, "x_in"),
+        "weight": _float2(parent, "w_in"),
+        "epsilon": _scalar(parent, "eps_in"),
+    }
+    with pytest.raises(ValueError, match="rename keys must be non-empty strings"):
+        qwen35._compose_program(
+            parent, build_rms_norm((2,), "float32"), bindings, None, {"": "probe_"}
+        )
+
