+# ---------------------------------------------------------------------------
+# "Parent really calls the child composite" call-graph guard (round-2)
+# ---------------------------------------------------------------------------
+
+
+def _install_compose_spy(monkeypatch, calls: List[Tuple[str, str, Tuple[str, ...]]]):
+    """Record every composition edge and fail red when composition is reverted.
+
+    The spy is installed with ``raising=False`` on purpose: on a tree where
+    ``_compose_program`` does not exist (all composites inlined again) the spy
+    is still installed but never called, so the call-count assertions below
+    fail with a clear message instead of a collection error.
+    """
+
+    real = getattr(qwen35, "_compose_program", None)
+
+    def spy(builder, program, bindings, returns=None, rename=None):
+        child = program.functions[0]
+        calls.append(
+            (
+                builder.function_name,
+                child.name,
+                tuple(sorted(bindings)),
+            )
+        )
+        assert real is not None, (
+            "qwen35._compose_program is missing: the parent is inlined again"
+        )
+        assert tuple(sorted(bindings)) == tuple(
+            sorted(ref.name for ref in child.parameters)
+        ), "binding keys must cover exactly the child parameters"
+        return real(builder, program, bindings, returns, rename)
+
+    monkeypatch.setattr(qwen35, "_compose_program", spy, raising=False)
+
+
+def test_parent_builders_actually_call_compose(monkeypatch):
+    calls: List[Tuple[str, str, Tuple[str, ...]]] = []
+    _install_compose_spy(monkeypatch, calls)
+
+    build_qwen35_attention_kv_cache(
+        (1, 8, 1, 256),
+        (1, 2, 5, 256),
+        (1, 2, 5, 256),
+        (1, 2, 1, 256),
+        (1, 2, 1, 256),
+    )
+    assert len(calls) == 6, calls
+    assert Counter(child for _, child, _ in calls) == {
+        "qwen35_gqa_repeat_kv": 2,
+        "qwen35_batched_matmul": 2,
+        "qwen35_causal_mask": 1,
+        "qwen35_stable_softmax": 1,
+    }
+
+    calls.clear()
+    build_attention_subgraph(
+        (1, 2, 3, 8), (1, 4, 3, 3), (1, 2, 3, 8), query_heads=4, rotary_dim=4
+    )
+    assert Counter(child for _, child, _ in calls) == {
+        "qwen35_rope_rotate_half": 1,
+        "qwen35_causal_mask": 1,
+        "qwen35_stable_softmax": 1,
+        "qwen35_gqa_repeat_kv": 1,
+    }
+
+    calls.clear()
+    build_decoder_subgraph(2, hidden=8, intermediate=10)
+    assert Counter(child for _, child, _ in calls) == {
+        "qwen35_rms_norm": 1,
+        "qwen35_swiglu": 1,
+    }
+
+    calls.clear()
+    build_qwen35_gated_delta_conv_state(1, 5, hidden=8, channels=12)
+    assert Counter(child for _, child, _ in calls) == {"qwen35_causal_conv1d_state": 1}
+
+    calls.clear()
+    build_qwen35_position_control(2, 3, past_length=7, index_dtype="int32")
+    assert Counter(child for _, child, _ in calls) == {
+        "qwen35_position_ids": 1,
+        "qwen35_causal_mask_from_positions": 1,
+    }
+
+    calls.clear()
+    build_qwen35_text_decoder_graph(2, 3, shape_profile="synthetic_test")
+    assert len(calls) == 105, calls
+    assert Counter(child for _, child, _ in calls) == {
+        "qwen35_position_control": 1,
+        "qwen35_position_ids": 1,
+        "qwen35_causal_mask_from_positions": 1,
+        "qwen35_rms_norm": 12,
+        "qwen35_rope_rotate_half": 12,
+        "qwen35_batched_matmul": 12,
+        "qwen35_causal_mask": 6,
+        "qwen35_stable_softmax": 6,
+        "qwen35_causal_conv1d_state": 18,
+        "qwen35_l2_norm": 36,
+    }
+    graph_parent_calls = [edge for edge in calls if edge[0] == "qwen35_text_decoder"]
+    assert len(graph_parent_calls) == 103
+    assert Counter(child for _, child, _ in graph_parent_calls) == {
+        "qwen35_position_control": 1,
+        "qwen35_rms_norm": 12,
+        "qwen35_rope_rotate_half": 12,
+        "qwen35_batched_matmul": 12,
+        "qwen35_causal_mask": 6,
+        "qwen35_stable_softmax": 6,
+        "qwen35_causal_conv1d_state": 18,
+        "qwen35_l2_norm": 36,
+    }
+    assert Counter(builder_name for builder_name, _, _ in calls) == {
+        "qwen35_text_decoder": 103,
+        "qwen35_position_control": 2,
+    }
