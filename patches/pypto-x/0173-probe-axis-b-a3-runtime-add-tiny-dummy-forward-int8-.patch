@@ -0,0 +1,57 @@
+"""axis-b-a3-runtime 04: create a tiny random-weight LlamaForCausalLM on A3.
+
+No model weights are downloaded: config + random init + safetensors only.
+Usage: python 04_make_tiny_dummy.py <out_dir>
+"""
+import json
+import os
+import sys
+
+import torch
+from tokenizers import Tokenizer, models, pre_tokenizers
+from transformers import LlamaConfig, LlamaForCausalLM, PreTrainedTokenizerFast
+
+out = sys.argv[1]
+os.makedirs(out, exist_ok=True)
+
+vocab_size = 512
+cfg = LlamaConfig(
+    vocab_size=vocab_size,
+    hidden_size=128,
+    intermediate_size=256,
+    num_hidden_layers=2,
+    num_attention_heads=4,
+    num_key_value_heads=2,
+    head_dim=32,
+    max_position_embeddings=128,
+    rms_norm_eps=1e-5,
+    tie_word_embeddings=False,
+    torch_dtype="float32",
+    use_cache=True,
+)
+torch.manual_seed(20260911)
+model = LlamaForCausalLM(cfg).to(torch.float32)
+model.save_pretrained(out, safe_serialization=True)
+
+special = {"<unk>": 0, "<s>": 1, "</s>": 2, "<pad>": 3}
+vocab = {**special, **{f"tok{i}": i for i in range(4, vocab_size)}}
+tok = Tokenizer(models.WordLevel(vocab=vocab, unk_token="<unk>"))
+tok.pre_tokenizer = pre_tokenizers.Whitespace()
+fast = PreTrainedTokenizerFast(
+    tokenizer_object=tok,
+    unk_token="<unk>",
+    bos_token="<s>",
+    eos_token="</s>",
+    pad_token="<pad>",
+)
+fast.save_pretrained(out)
+
+with open(os.path.join(out, "README.md"), "w") as fh:
+    fh.write("pypto-x axis-b-a3-runtime tiny dummy model; random weights; no download\n")
+
+n_params = sum(p.numel() for p in model.parameters())
+print("dummy_dir", out)
+print("n_params", n_params)
+print("torch", torch.__version__)
+print("files", sorted(os.listdir(out)))
+print("config_arch", json.load(open(os.path.join(out, "config.json")))["architectures"])
diff --git a/scripts/a3_axis_b_runtime/05_minimal_forward.py b/scripts/a3_axis_b_runtime/05_minimal_forward.py
new file mode 100755
index 000000000..587db7647
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/05_minimal_forward.py
@@ -0,0 +1,138 @@
+"""axis-b-a3-runtime 05: construct a vLLM LLM on the A3 aarch64 CPU platform and
+run a minimal prefill+decode forward on the tiny random-weight Llama (no downloads).
+
+Usage: python 05_minimal_forward.py <out_json> <dummy_model_dir>
+"""
+import json
+import os
+import platform
+import sys
+import time
+import traceback
+
+os.environ.setdefault("VLLM_CPU_KVCACHE_SPACE", "1")
+os.environ.setdefault("OMP_NUM_THREADS", "8")
+os.environ.setdefault("HF_HUB_OFFLINE", "1")
+os.environ.setdefault("TRANSFORMERS_OFFLINE", "1")
+
+out_json, dummy = sys.argv[1], sys.argv[2]
+
+report = {
+    "schema": "pypto-x.axis-b-a3-runtime.forward.v1",
+    "machine": platform.machine(),
+    "platform_system": platform.platform(),
+    "dummy_model": dummy,
+    "steps": {},
+}
+
+
+def step(name, fn):
+    entry = {}
+    t0 = time.time()
+    try:
+        entry["result"] = fn()
+        entry["ok"] = True
+    except BaseException as exc:  # noqa: BLE001
+        entry["ok"] = False
+        entry["error_type"] = type(exc).__name__
+        entry["error"] = str(exc)
+        entry["traceback"] = traceback.format_exc()
+    entry["elapsed_s"] = round(time.time() - t0, 3)
+    report["steps"][name] = entry
+    return entry
+
+
+def s_import():
+    import torch
+    import vllm
+    from vllm import LLM, SamplingParams
+    from vllm.platforms import current_platform
+
+    return {
+        "torch": torch.__version__,
+        "vllm": vllm.__version__,
+        "cuda_available": torch.cuda.is_available(),
+        "platform_class": type(current_platform).__name__,
+        "platform_str": str(current_platform),
+        "LLM": f"{LLM.__module__}.{LLM.__name__}",
+        "SamplingParams": f"{SamplingParams.__module__}.{SamplingParams.__name__}",
+    }
+
+
+def s_construct():
+    from vllm import LLM
+
+    llm = LLM(
+        model=dummy,
+        dtype="float32",
+        enforce_eager=True,
+        max_model_len=64,
+        max_num_seqs=1,
+        disable_log_stats=True,
+        seed=0,
+    )
+    report["_llm"] = llm
+    info = {}
+    try:
+        eng = llm.llm_engine
+        info["engine_type"] = type(eng).__name__
+        cfg = getattr(eng, "vllm_config", None)
+        if cfg is not None:
+            info["model"] = cfg.model_config.model
+            info["dtype"] = str(cfg.model_config.dtype)
+            info["max_model_len"] = cfg.model_config.max_model_len
+            info["architectures"] = list(cfg.model_config.architectures or [])
+            info["quantization"] = cfg.model_config.quantization
+            info["device"] = str(getattr(cfg, "device_config", None))
+        info["engine_attrs"] = [a for a in dir(eng) if not a.startswith("_")][:60]
+    except BaseException as exc:  # noqa: BLE001
+        info["introspection_error"] = f"{type(exc).__name__}: {exc}"
+    return info
+
+
+def s_generate():
+    from vllm import SamplingParams
+
+    llm = report["_llm"]
+    sp = SamplingParams(max_tokens=8, temperature=0.0, top_p=1.0)
+    prompts = ["tok10 tok11 tok12", "tok20 tok21 tok22 tok23"]
+    t0 = time.time()
+    outs = llm.generate(prompts, sp)
+    t1 = time.time()
+    rec = []
+    for out in outs:
+        rec.append({
+            "prompt": out.prompt,
+            "prompt_token_ids": list(out.prompt_token_ids or []),
+            "output_token_ids": [list(o.token_ids) for o in out.outputs],
+            "output_text": [o.text for o in out.outputs],
+        })
+    return {"generations": rec, "wall_s": round(t1 - t0, 3)}
+
+
+def s_generate_again():
+    from vllm import SamplingParams
+
+    llm = report["_llm"]
+    sp = SamplingParams(max_tokens=8, temperature=0.0, top_p=1.0)
+    prompts = ["tok10 tok11 tok12", "tok20 tok21 tok22 tok23"]
+    outs = llm.generate(prompts, sp)
+    return [[list(o.token_ids) for o in out.outputs] for out in outs]
+
+
+step("import", s_import)
+if report["steps"]["import"]["ok"]:
+    step("construct", s_construct)
+if report["steps"].get("construct", {}).get("ok"):
+    step("generate", s_generate)
+    step("generate_again", s_generate_again)
+    a = report["steps"].get("generate", {}).get("result", {}).get("generations", [])
+    b = report["steps"].get("generate_again", {}).get("result", [])
+    report["deterministic_greedy"] = bool(a) and [g["output_token_ids"][0] for g in a] == b
+
+report.pop("_llm", None)
+with open(out_json, "w", encoding="utf-8") as fh:
+    json.dump(report, fh, indent=1, sort_keys=True, default=str)
+print(json.dumps({k: (v.get("ok"), v.get("error_type")) for k, v in report["steps"].items()}, indent=1))
+print("deterministic_greedy", report.get("deterministic_greedy"))
+print("wrote", out_json)
