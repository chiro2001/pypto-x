+#!/usr/bin/env bash
+# axis-b-a3-runtime 07: boundary recon — which of the excluded/optional wheel
+# deps exist for aarch64 cp312, and what the pytorch cpu index offers for the
+# torch-family pins. Metadata only (curl grep), nothing installed.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+RAW="$RUN/raw"
+CPUS="${AXISB_CPUS:-600-639}"
+MIRROR="https://mirror.nju.edu.cn/pypi/web/simple"
+PT_CPU="https://download.pytorch.org/whl/cpu"
+
+mkdir -p "$RAW"
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+
+echo "### 07_boundary_recon A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+OUT="$RAW/07_boundary_recon.txt"
+{
+    echo "# sources: $MIRROR and $PT_CPU ; fetched $(date -u +%Y-%m-%dT%H:%M:%SZ) (A3 clock)"
+    for pkg in torchvision torchaudio torchcodec; do
+        echo "== PT cpu index: $pkg aarch64 cp312 =="
+        curl -s --max-time 60 "$PT_CPU/$pkg/" | grep -oE "${pkg}-[^\"<>]*cp312[^\"<>]*aarch64[^\"<>]*\.whl" | sort -u | tail -6
+    done
+    echo "== PT cpu index: torch free-threaded/cp312 +cpu files (sanity) =="
+    curl -s --max-time 60 "$PT_CPU/torch/" | grep -oE "torch-2\.13\.0[+%]2Bcpu-cp312[^\"<>]*aarch64[^\"<>]*\.whl" | sort -u
+    for pkg in xgrammar llguidance numba llvmlite opencv-python-headless aiohttp attrs jsonschema mcp model-hosting-container-standards openai-harmony compressed-tensors depyf; do
+        echo "== NJU mirror: $pkg cp312 aarch64 wheels =="
+        curl -s --max-time 60 "$MIRROR/$pkg/" | grep -oE "${pkg//-/_}-[^\"<>]*cp312[^\"<>]*aarch64[^\"<>]*\.whl" | sort -u | tail -4
+    done
+} > "$OUT" 2>&1
+cat "$OUT"
+echo "### done 07 A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
