@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# axis-b-a3-runtime 05 driver: tiny dummy weights (04) + minimal vLLM forward (05).
+# CPUs 600-639, NPU env cleared, offline HF. Safe to run under setsid nohup.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+VENV="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb-t213"
+PY="$VENV/bin/python"
+SCRIPTS="$RUN/scripts"
+DUMMY="$RUN/artifact/tiny-llama-dummy"
+CPUS="${AXISB_CPUS:-600-639}"
+
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+export OMP_NUM_THREADS=8
+export VLLM_CPU_KVCACHE_SPACE=1
+
+mkdir -p "$RUN/logs" "$RUN/raw" "$RUN/artifact"
+echo "### 05_run_forward A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ) cpus=$CPUS"
+
+if [[ ! -f "$DUMMY/config.json" ]]; then
+    echo "--- build tiny dummy model (random weights, no download) ---"
+    taskset -c "$CPUS" timeout 600 "$PY" "$SCRIPTS/04_make_tiny_dummy.py" "$DUMMY" \
+        > "$RUN/raw/05_dummy_build.log" 2>&1
+    echo "dummy_build_rc=$?"
+    tail -6 "$RUN/raw/05_dummy_build.log"
+else
+    echo "dummy model already present: $DUMMY"
+fi
+
+echo "--- minimal LLM construct + forward ---"
+t0=$(date +%s)
+taskset -c "$CPUS" timeout 2400 "$PY" "$SCRIPTS/05_minimal_forward.py" \
+    "$RUN/raw/05_forward.json" "$DUMMY" > "$RUN/raw/05_forward.log" 2>&1
+rc=$?
+t1=$(date +%s)
+echo "forward_rc=$rc elapsed_s=$((t1-t0))"
+tail -25 "$RUN/raw/05_forward.log"
+echo "### done 05 A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
diff --git a/scripts/a3_axis_b_runtime/06_int8_probe.py b/scripts/a3_axis_b_runtime/06_int8_probe.py
new file mode 100755
index 000000000..6a745e42e
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/06_int8_probe.py
@@ -0,0 +1,193 @@
+"""axis-b-a3-runtime 06: can vLLM on aarch64 consume a native CPU int8 GEMM?
+
+Runs vllm's own op wrappers (torch.ops._C / vllm._custom_ops) — i.e. the exact
+path CPUInt8ScaledMMLinearKernel uses — plus oneDNN/ACL/KleidiAI fingerprints.
+
+Usage: python 06_int8_probe.py <out_json>
+"""
+import ctypes
+import inspect
+import json
+import platform
+import sys
+import time
+import traceback
+
+import torch
+
+out_json = sys.argv[1]
+report = {
+    "schema": "pypto-x.axis-b-a3-runtime.int8.v1",
+    "machine": platform.machine(),
+    "torch": torch.__version__,
+    "schemas": {},
+    "wrappers": {},
+    "checks": {},
+}
+
+
+def rec(name, fn):
+    t0 = time.time()
+    try:
+        val = fn()
+        report["checks"][name] = {"ok": True, "result": val, "elapsed_s": round(time.time() - t0, 3)}
+    except BaseException as exc:  # noqa: BLE001
+        report["checks"][name] = {
+            "ok": False,
+            "error_type": type(exc).__name__,
+            "error": str(exc)[:2000],
+            "traceback": traceback.format_exc(),
+            "elapsed_s": round(time.time() - t0, 3),
+        }
+
+
+def main():
+    import vllm
+    from vllm import _custom_ops as ops
+
+    report["vllm"] = vllm.__version__
+
+    for name in ("dynamic_scaled_int8_quant", "static_scaled_int8_quant",
+                 "onednn_scaled_mm", "onednn_scaled_int8_quant"):
+        try:
+            fn = getattr(torch.ops._C, name)
+            report["schemas"][name] = str(fn.default._schema)
+        except BaseException as exc:  # noqa: BLE001
+            report["schemas"][name] = f"UNAVAILABLE {type(exc).__name__}: {exc}"
+        try:
+            f = getattr(ops, name)
+            src = None
+            try:
+                src = inspect.getsource(f)
+            except BaseException:  # noqa: BLE001
+                pass
+            report["wrappers"][name] = {"signature": str(inspect.signature(f)), "source": src}
+        except BaseException as exc:  # noqa: BLE001
+            report["wrappers"][name] = f"UNAVAILABLE {type(exc).__name__}: {exc}"
+
+    def s_quant():
+        x = torch.randn(8, 64, dtype=torch.float32)
+        res = ops.onednn_scaled_int8_quant(x, None, None, True)
+        first = res[0]
+        report["quant_shapes"] = [tuple(t.shape) for t in res if torch.is_tensor(t)]
+        report["quant_dtypes"] = [str(t.dtype) for t in res if torch.is_tensor(t)]
+        return {"n_returns": len(res), "codes_dtype": str(first.dtype),
+                "codes_shape": list(first.shape),
+                "sat": int((first == 127).sum() + (first == -128).sum())}
+
+    rec("dynamic_scaled_int8_quant", s_quant)
+
+    def s_gemm():
+        torch.manual_seed(7)
+        M, K, N = 8, 64, 16
+        a = torch.randn(M, K, dtype=torch.float32) * 0.7
+        codes, a_scales, azp = ops.onednn_scaled_int8_quant(a, None, None, True)[:3]
+        w = torch.randint(-127, 127, (N, K), dtype=torch.int8)
+        w_scales = (torch.rand(N, 1, dtype=torch.float32) + 0.5) * 0.03
+        schema = torch.ops._C.onednn_scaled_mm.default._schema
+        kwargs = {}
+        for arg in schema.arguments:
+            n, ln = arg.name, arg.name.lower()
+            if ln in ("a", "x", "input", "activation", "a_input", "input_a"):
+                kwargs[n] = codes
+            elif ln in ("b", "weight", "w", "b_weight", "weight_b"):
+                kwargs[n] = w
+            elif "scale" in ln and ("b" in ln or "weight" in ln or ln.startswith("w")):
+                kwargs[n] = w_scales
+            elif "scale" in ln:
+                kwargs[n] = a_scales
+            elif ln in ("bias", "output", "out", "azp", "a_zp", "b_zp"):
+                kwargs[n] = None
+            elif "dtype" in ln:
+                kwargs[n] = torch.float32
+            else:
+                kwargs[n] = None
+        report["gemm_kwargs_names"] = list(kwargs)
+        y = torch.ops._C.onednn_scaled_mm(**kwargs)
+        if isinstance(y, (tuple, list)):
+            y = y[0]
+        a_deq = codes.float() * a_scales
+        b_deq = w.float() * w_scales
+        ref = a_deq @ b_deq.t()
+        diff = (y.float() - ref).abs()
+        report["gemm_shapes"] = {"codes": list(codes.shape), "a_scales": list(a_scales.shape),
+                                 "w": list(w.shape), "w_scales": list(w_scales.shape),
+                                 "out": list(y.shape)}
+        return {"out_dtype": str(y.dtype), "max_abs_diff_vs_dequant_ref": float(diff.max()),
+                "ref_max_abs": float(ref.abs().max())}
+
+    rec("onednn_scaled_mm_M8_K64_N16", s_gemm)
+
+    def s_gemm_bigger():
+        torch.manual_seed(11)
+        M, K, N = 64, 256, 256
+        a = torch.randn(M, K, dtype=torch.float32) * 0.5
+        codes, a_scales, azp = ops.onednn_scaled_int8_quant(a, None, None, True)[:3]
+        w = torch.randint(-127, 127, (N, K), dtype=torch.int8)
+        w_scales = (torch.rand(N, 1, dtype=torch.float32) + 0.5) * 0.02
+        y = torch.ops._C.onednn_scaled_mm(codes, w, a_scales, w_scales, None, None, torch.float32)
+        if isinstance(y, (tuple, list)):
+            y = y[0]
+        ref = (codes.float() * a_scales) @ (w.float() * w_scales).t()
+        t0 = time.time()
+        for _ in range(3):
+            torch.ops._C.onednn_scaled_mm(codes, w, a_scales, w_scales, None, None, torch.float32)
+        dt = (time.time() - t0) / 3
+        return {"out_shape": list(y.shape), "out_dtype": str(y.dtype),
+                "max_abs_diff_vs_dequant_ref": float((y.float() - ref).abs().max()),
+                "warm_ms": round(dt * 1e3, 3)}
+
+    rec("onednn_scaled_mm_M64_K256_N256", s_gemm_bigger)
+
+    def s_acl():
+        out = {}
+        try:
+            out["torch_op_is_onednn_acl_supported"] = bool(torch.ops._C.is_onednn_acl_supported())
+        except BaseException as exc:  # noqa: BLE001
+            out["torch_op_is_onednn_acl_supported"] = f"UNAVAILABLE {type(exc).__name__}: {exc}"
+        so = None
+        try:
+            import vllm._C as C
+            so = C.__file__
+        except BaseException:  # noqa: BLE001
+            pass
+        if so:
+            lib = ctypes.CDLL(so, mode=ctypes.RTLD_GLOBAL)
+            try:
+                fn = getattr(lib, "_Z23is_onednn_acl_supportedv")
+                fn.restype = ctypes.c_bool
+                out["ctypes_is_onednn_acl_supported"] = bool(fn())
+            except BaseException as exc:  # noqa: BLE001
+                out["ctypes_is_onednn_acl_supported"] = f"{type(exc).__name__}: {exc}"
+            try:
+                class DnnlVersion(ctypes.Structure):
+                    _fields_ = [("major", ctypes.c_int), ("minor", ctypes.c_int),
+                                ("patch", ctypes.c_int), ("hash", ctypes.c_char_p),
+                                ("commit", ctypes.c_uint)]
+                ver = DnnlVersion()
+                lib.dnnl_version(ctypes.byref(ver))
+                out["oneDNN_version"] = [ver.major, ver.minor, ver.patch,
+                                         ver.hash.decode() if ver.hash else None]
+            except BaseException as exc:  # noqa: BLE001
+                out["oneDNN_version"] = f"{type(exc).__name__}: {exc}"
+        return out
+
+    rec("acl_onednn_version", s_acl)
+
+    rec("fp32_onednn_mm_control", lambda: (
+        lambda a, b: {
+            "out_shape": list(torch.ops._C.onednn_mm(a, b, None, None).shape),
+            "max_abs_diff": float((torch.ops._C.onednn_mm(a, b, None, None) - a @ b.t()).abs().max()),
+        })(torch.randn(16, 64), torch.randn(16, 64))
+    )
+
+
+try:
+    main()
+except BaseException as exc:  # noqa: BLE001
+    report["fatal"] = {"type": type(exc).__name__, "error": str(exc), "traceback": traceback.format_exc()}
+
+with open(out_json, "w", encoding="utf-8") as fh:
+    json.dump(report, fh, indent=1, sort_keys=True, default=str)
+print(json.dumps({k: v.get("ok") for k, v in report.get("checks", {}).items()}, indent=1))
+print("wrote", out_json)
diff --git a/scripts/a3_axis_b_runtime/06_run_int8.sh b/scripts/a3_axis_b_runtime/06_run_int8.sh
new file mode 100755
index 000000000..1264e83e6
--- /dev/null
+++ b/scripts/a3_axis_b_runtime/06_run_int8.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# axis-b-a3-runtime 06 driver: aarch64 native int8 GEMM consumption via vLLM ops.
+# CPUs 600-639, NPU env cleared.
+set -uo pipefail
+
+RUN="$HOME/pypto-x-a3/axis-b-a3-runtime"
+VENV="$HOME/pypto-x-a3/envs/pypto-x-c8-axisb-t213"
+PY="$VENV/bin/python"
+SO="$VENV/lib/python3.12/site-packages/vllm/_C.abi3.so"
+SCRIPTS="$RUN/scripts"
+CPUS="${AXISB_CPUS:-600-639}"
+
+export ASCEND_RT_VISIBLE_DEVICES=
+export CUDA_VISIBLE_DEVICES=
+export OMP_NUM_THREADS=8
+
+mkdir -p "$RUN/logs" "$RUN/raw"
+echo "### 06_run_int8 A3-side $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+
+echo "--- linkage: NEEDED + undefined oneDNN (static means 0 undefined dnnl) ---"
+{
+    echo "== readelf -d NEEDED =="
+    readelf -d "$SO" 2>/dev/null | grep -E 'NEEDED|RPATH|RUNPATH'
+    echo "== defined onednn/dnnl symbols =="
+    nm -D --defined-only "$SO" 2>/dev/null | grep -E 'onednn|dnnl' | wc -l
+    nm -D --defined-only "$SO" 2>/dev/null | grep -E 'onednn|dnnl' | head -40
+    echo "== undefined dnnl symbols =="
+    nm -D --undefined-only "$SO" 2>/dev/null | grep -cE 'dnnl_' || true
+} > "$RUN/raw/06_symbols_onednn.txt" 2>&1
+tail -12 "$RUN/raw/06_symbols_onednn.txt"
+
+echo "--- KleidiAI / ACL fingerprints in _C.abi3.so ---"
+{
+    echo "== nm defined kai_/kleidi =="
+    nm -D --defined-only "$SO" 2>/dev/null | grep -iE 'kai_|kleidi' | head -40
+    nm -D --defined-only "$SO" 2>/dev/null | grep -icE 'kai_|kleidi' || true
+    echo "== strings =="
+    strings -a "$SO" 2>/dev/null | grep -iE 'kleidiai|arm_compute|libarm|acl_' | sort -u | head -30
+    echo "== strings oneDNN version =="
+    strings -a "$SO" 2>/dev/null | grep -iE 'onednn v[0-9]|dnnl v[0-9]|Arm Compute Library' | sort -u | head -10
+} > "$RUN/raw/06_symbols_kleidiai_acl.txt" 2>&1
+cat "$RUN/raw/06_symbols_kleidiai_acl.txt"
+
+echo "--- run vLLM int8 ops ---"
