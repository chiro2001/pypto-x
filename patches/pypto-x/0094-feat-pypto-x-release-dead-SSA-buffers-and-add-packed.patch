+# --------------------------------------------------------------------------
+# liveness
+# --------------------------------------------------------------------------
+
+
+def _chain_program():
+    """a,b,c,d -> t0 -> (t1, t2) -> out, plus one value that dies immediately."""
+
+    value_type = CoreType.tensor("float32", (4,))
+    a = ValueRef("a", value_type)
+    b = ValueRef("b", value_type)
+    c = ValueRef("c", value_type)
+    d = ValueRef("d", value_type)
+    t0 = ValueRef("t0", value_type)
+    t1 = ValueRef("t1", value_type)
+    t2 = ValueRef("t2", value_type)
+    dead = ValueRef("dead", value_type)
+    out = ValueRef("out", value_type)
+    operations = (
+        Operation("add", (a, b), (t0,)),
+        Operation("mul", (t0, c), (t1,)),
+        Operation("add", (t0, d), (t2,)),
+        Operation("neg", (c,), (dead,)),
+        Operation("add", (t1, t2), (out,)),
+    )
+    return _program("chain", (a, b, c, d), (out,), operations)
+
+
+def test_liveness_releases_values_after_their_last_use():
+    program = _chain_program()
+    function = program.functions[0]
+    last_use, pinned = plan_release(function)
+    assert last_use == {"a": 0, "b": 0, "c": 3, "t0": 2, "d": 2, "t1": 4, "t2": 4}
+    assert pinned == frozenset(("a", "b", "c", "d", "out"))
+
+    environment = {"a": 1, "b": 2, "c": 3, "d": 4}
+    released = []
+    for index, operation in enumerate(function.body.operations):
+        for ref in operation.outputs:
+            environment[ref.name] = "value:{}".format(ref.name)
+        released.append(
+            release_dead_values(
+                environment,
+                last_use,
+                pinned,
+                index,
+                [ref.name for ref in operation.inputs],
+                [ref.name for ref in operation.outputs],
+            )
+        )
+    # t0 dies at its last consumer (op 2); ``dead`` is never consumed; t1/t2 die
+    # at the final add; every parameter stays alive for the whole launch.
+    assert released == [(), (), ("t0",), ("dead",), ("t1", "t2")]
+    assert set(environment) == {"a", "b", "c", "d", "out"}
+
+
+def test_liveness_keeps_parameters_and_returns_alive():
+    program = _chain_program()
+    function = program.functions[0]
+    last_use, pinned = plan_release(function)
+    environment = {"a": 1, "b": 2, "c": 3, "d": 4, "t0": 5, "dead": 6}
+    assert release_dead_values(environment, last_use, pinned, 0, ["a", "b"], ["t0"]) == ()
+    assert "a" in environment and "b" in environment
+    # ``dead`` was never consumed and is not returned: it is released at once.
+    assert release_dead_values(environment, last_use, pinned, 3, ["c"], ["dead"]) == ("dead",)
+    assert "dead" not in environment
+
+
+def test_liveness_launch_matches_the_scalar_reference(tmp_path):
+    program = _chain_program()
+    _, artifact = _compile_avx512(program, tmp_path, name="chain")
+    inputs = [
+        HostTensor("float32", (4,), [float(index + 1) for index in range(4)]),
+        HostTensor("float32", (4,), [0.5] * 4),
+        HostTensor("float32", (4,), [2.0] * 4),
+        HostTensor("float32", (4,), [1.25] * 4),
+    ]
+    actual = HostTensor.zeros("float32", (4,))
+    recorder = _RecordingRuntime()
+    expected = _scalar_reference(program, inputs, [actual])
+    _launch(artifact, inputs, [actual], runtime=recorder)
+    assert actual.data == expected[0].data
+    live = recorder.live_before
+    assert live[0] == frozenset(("a", "b", "c", "d"))
+    assert live[1] == frozenset(("a", "b", "c", "d", "t0"))
+    assert "t0" in live[2]
+    assert "t0" not in live[4]
+    assert "t1" in live[4] and "t2" in live[4]
+    assert "dead" not in live[4]
+
+
+def test_liveness_analysis_is_deterministic_and_read_only():
+    program = _chain_program()
+    function = program.functions[0]
+    assert last_use_map(function) == last_use_map(function)
+    assert pinned_names(function) == frozenset(("a", "b", "c", "d", "out"))
+    environment = {"x": 1}
+    assert release_dead_values(environment, {"x": 0}, frozenset(), 0, ["x"], []) == ("x",)
+    assert environment == {}
+
+
+def test_liveness_of_a_wrong_plan_does_not_release_the_return(tmp_path):
+    """A returned parameter must survive even when it is never consumed."""
+
+    value_type = CoreType.tensor("float32", (4,))
