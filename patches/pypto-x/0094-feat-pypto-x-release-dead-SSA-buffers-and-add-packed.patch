+def test_packed_metadata_records_the_exact_kernel_plane(tmp_path):
+    program = _cast_program("bf16", "float32", (10,))
+    _, artifact = _compile_avx512(program, tmp_path, name="plane")
+    metadata = artifact.metadata
+    assert metadata["packed_kernel_version"] == 1
+    assert metadata["packed_kernel_operations"] == ("cast",)
+    entry = dict(metadata["packed_operations"][0])
+    assert entry == {
+        "operation_index": 0,
+        "operation": "cast",
+        "mode": PACKED_CAST_MODE,
+        "kernel": "cast_bf16_f32",
+        "source_dtype": "bf16",
+        "target_dtype": "float32",
+    }
+    assert metadata["host_reference_operations"] == ()
+
+
+def test_plan_execution_reports_list_materialization(tmp_path):
+    program = _transpose_program("float32", (2, 3, 4), permutation=(0, 2, 1))
+    _, artifact = _compile_avx512(program, tmp_path, name="plan-mode")
+    recorder = _RecordingRuntime()
+    source = HostTensor("float32", (2, 3, 4), [float(index) for index in range(24)])
+    output = HostTensor.zeros("float32", (2, 4, 3))
+    _launch(artifact, [source], [output], runtime=recorder)
+    assert recorder.modes == ["host_reference"]
+    assert recorder.list_elements == [24 + 24]
+
