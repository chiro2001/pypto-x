+def test_packed_transpose_rejects_a_mismatched_descriptor(tmp_path):
+    program = _transpose_program("float32", (4, 4))
+    target_ir, artifact = _compile_avx512(program, tmp_path, name="bad-descriptor")
+    runtime = _runtime()
+    loaded = runtime.load(artifact)
+    operation = program.functions[0].body.operations[0]
+    buffer = avx2_runtime._buffer_from_values("float32", [1.0] * 16, "source")
+    value = avx2_runtime._RuntimeValue(CoreType.tensor("float32", (4, 4)), buffer)
+    with pytest.raises(CpuAvx512ArtifactError, match="descriptor is invalid"):
+        runtime._execute_packed(
+            {
+                "packed": {
+                    "mode": PACKED_TRANSPOSE_MODE,
+                    "kernel": "transpose_f32",
+                    "rows": 3,
+                    "columns": 5,
+                },
+                "inputs": (value,),
+            },
+            operation,
+            target_ir.plans[0],
+            loaded.module,
+        )
+
