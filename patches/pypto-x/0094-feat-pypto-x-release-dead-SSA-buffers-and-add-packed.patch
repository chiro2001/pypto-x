+# --------------------------------------------------------------------------
+# packed transpose
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "shape",
+    ((5, 7), (7, 5), (1, 9), (9, 1), (16, 16), (17, 19), (40, 37), (64, 64), (65, 33)),
+)
+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_packed_rank2_transpose_matches_scalar_reference(dtype, shape, tmp_path):
+    program = _transpose_program(dtype, shape)
+    _, artifact = _compile_avx512(program, tmp_path, name="transpose-{}-{}".format(dtype, shape[0]))
+    assert artifact.metadata["packed_kernel_operations"] == ("transpose",)
+    assert artifact.metadata["packed_operations"][0]["mode"] == PACKED_TRANSPOSE_MODE
+    count = shape[0] * shape[1]
+    values = [((index % 23) - 11) * 0.25 for index in range(count)]
+    source = HostTensor(dtype, shape, values)
+    output_shape = (shape[1], shape[0])
+    actual = HostTensor.zeros(dtype, output_shape)
+    expected = _scalar_reference(program, [source], [actual])
+    _launch(artifact, [source], [actual], runtime=_runtime())
+    assert actual.data == expected[0].data
+
+
+def test_rank3_transpose_stays_on_the_host_reference(tmp_path):
+    program = _transpose_program("float32", (2, 3, 4), permutation=(0, 2, 1))
+    target_ir, artifact = _compile_avx512(program, tmp_path, name="rank3")
+    assert artifact.metadata["packed_kernel_operations"] == ()
+    assert artifact.metadata["host_reference_operations"] == ("transpose",)
+    contract = packed_kernel_contract(program.functions[0].body.operations[0], target_ir.plans[0])
+    assert contract is None
+    values = [float(index) for index in range(24)]
+    source = HostTensor("float32", (2, 3, 4), values)
+    actual = HostTensor.zeros("float32", (2, 4, 3))
+    expected = _scalar_reference(program, [source], [actual])
+    _launch(artifact, [source], [actual], runtime=_runtime())
+    assert actual.data == expected[0].data
+
