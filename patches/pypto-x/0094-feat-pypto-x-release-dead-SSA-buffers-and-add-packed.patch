+    program = _embedding_program(dtype, table_shape, (4,))
+    _, artifact = _compile_avx512(program, tmp_path, name="embedding-{}".format(dtype))
+    assert artifact.metadata["packed_kernel_operations"] == ("embedding",)
+    assert artifact.metadata["packed_operations"][0]["mode"] == PACKED_EMBEDDING_MODE
