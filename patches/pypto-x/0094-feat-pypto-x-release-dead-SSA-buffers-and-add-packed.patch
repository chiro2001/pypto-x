     return _NativeBuffer(dtype, len(values), ctypes.cast(array, _pointer(dtype)), array, False)
 
 
+def _buffer_alloc(dtype: str, count: int, context: str) -> _NativeBuffer:
+    """Allocate a zero-filled native buffer without a Python element list.
+
+    ``_buffer_from_values(dtype, [0] * count, ...)`` builds a ``count``-element
+    Python list first, which costs ~8 bytes per element and is unusable for the
+    parameter-scale tensors of a real model.  ctypes zero-fills the array
+    itself, so this path never materializes per-element Python objects.
+    """
+
+    dtype = canonical_dtype(dtype)
+    if isinstance(count, bool) or not isinstance(count, int) or count < 0:
+        raise CpuAvx2ExecutionError("{} allocation count must be a non-negative integer".format(context))
+    ctype = _ctype(dtype)
+    array = (ctype * count)()
+    if count == 0:
+        pointer = ctypes.cast(0, _pointer(dtype))
+    else:
+        pointer = ctypes.cast(array, _pointer(dtype))
+    return _NativeBuffer(dtype, count, pointer, array, False)
+
+
 def _buffer_from_raw(dtype: str, values: Sequence[Any], context: str) -> _NativeBuffer:
     dtype = canonical_dtype(dtype)
     if dtype == "bf16":
