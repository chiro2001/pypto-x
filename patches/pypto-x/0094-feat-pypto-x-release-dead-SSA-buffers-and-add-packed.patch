+        (a,),
+        (out,),
+        (Operation("identity", (a,), (out,)),),
+    )
+    _, artifact = _compile_avx512(program, tmp_path, name="passthrough")
+    source = HostTensor("float32", (4,), [1.5, -2.5, 3.5, -4.5])
+    actual = HostTensor.zeros("float32", (4,))
+    _launch(artifact, [source], [actual], runtime=_runtime())
+    assert actual.data == source.data
+
