+def test_bf16_signature_helper_matches_the_reference_rounding():
+    # Guard the test oracle itself against a silent change of rounding mode.
+    assert _bf16_bits(1.0) == 0x3F80
+    assert _bf16_bits(float("nan")) == 0x7FC0
+    assert _bf16_bits(float("inf")) == 0x7F80
+    assert math.isinf(struct.unpack("<f", struct.pack("<I", _bf16_bits(3.4028234663852886e38) << 16))[0])
