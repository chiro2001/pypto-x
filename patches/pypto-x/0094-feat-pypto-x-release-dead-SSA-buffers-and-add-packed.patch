+        __m512i widened = _mm512_cvtepu16_epi32(packed);
+        _mm512_storeu_ps(output + i, _mm512_castsi512_ps(_mm512_slli_epi32(widened, 16)));
+    }
+    for (; i < n; ++i) output[i] = ptx_bf16_to_f32(input[i]);
