diff --git a/python/pypto/backends/cpu/ssa_liveness.py b/python/pypto/backends/cpu/ssa_liveness.py
new file mode 100644
index 000000000..8a615a529
--- /dev/null
+++ b/python/pypto/backends/cpu/ssa_liveness.py
@@ -0,0 +1,97 @@
+"""SSA last-use analysis and buffer release for CPU runtime launch loops.
+
+The CPU vector, AVX2 and AVX-512 runtimes keep every SSA value alive in one
+``environment`` mapping until the launch returns.  For a real Qwen3.5-0.8B
+graph that pins ~6.5 GB of dead intermediate buffers and dominates the peak
+RSS.  This module computes, from the immutable operation list only, the last
+operation that consumes each SSA name, and releases a value's buffer exactly
+after that operation.
+
+The analysis is deliberately conservative:
+
+* function parameters (including scalars) are never released;
+* function returns are never released;
+* a value is only released after the operation that consumed it last;
+* values that are never consumed and are not returned are released right
+  after they are produced.
+
+Nothing here changes operation semantics: the release point is always strictly
+after the consuming operation has returned.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, Iterable, Mapping, Sequence, Tuple
+
+
+class SsaLivenessError(RuntimeError):
+    """The launch function does not expose a usable SSA operation list."""
+
+
+def _operations(function: Any) -> Sequence[Any]:
+    body = getattr(function, "body", None)
+    operations = getattr(body, "operations", None)
+    if operations is None:
+        raise SsaLivenessError("launch function body has no operation list")
+    return operations
+
+
+def last_use_map(function: Any) -> Dict[str, int]:
+    """Map every consumed SSA name to the index of its last consuming op."""
+
+    last_use: Dict[str, int] = {}
+    for index, operation in enumerate(_operations(function)):
+        for ref in operation.inputs:
+            last_use[ref.name] = index
+    return last_use
+
+
+def pinned_names(function: Any) -> frozenset:
+    """Names that must survive the complete launch (parameters and returns)."""
+
+    pinned = set()
+    for ref in tuple(function.parameters) + tuple(function.returns):
+        pinned.add(ref.name)
+    return frozenset(pinned)
+
+
+def plan_release(function: Any) -> Tuple[Dict[str, int], frozenset]:
+    """Return ``(last_use, pinned)`` for one validated launch function."""
+
+    return last_use_map(function), pinned_names(function)
+
+
+def release_dead_values(
+    environment: Dict[str, Any],
+    last_use: Mapping[str, int],
+    pinned: Iterable[str],
+    index: int,
+    used_names: Sequence[str],
+    produced_names: Sequence[str],
+) -> Tuple[str, ...]:
+    """Release values that became dead at operation ``index``.
+
+    ``used_names`` are the inputs of the operation that just executed;
+    ``produced_names`` are its outputs.  Returns the released names in a
+    deterministic order so callers can report/verify the release set.
+    """
+
+    released = []
+    for name in used_names:
+        if name in environment and name not in pinned and last_use.get(name) == index:
+            del environment[name]
+            released.append(name)
+    for name in produced_names:
+        if name in environment and name not in pinned and name not in last_use:
+            del environment[name]
+            released.append(name)
+    return tuple(released)
+
+
+def live_bytes(environment: Mapping[str, Any], sizer: Any) -> int:
+    """Sum the byte size of every live value (diagnostics and tests only)."""
+
+    total = 0
+    for value in environment.values():
+        total += int(sizer(value))
+    return total
