+
+
+def test_non_int64_embedding_indices_stay_on_the_host_reference(tmp_path):
+    table = ValueRef("table", CoreType.tensor("bf16", (7, 5)))
+    indices = ValueRef("indices", CoreType.tensor("int32", (2,)))
+    output = ValueRef("output", CoreType.tensor("bf16", (2, 5)))
+    program = _program(
+        "embedding",
+        (table, indices),
+        (output,),
+        (Operation("embedding", (table, indices), (output,), {"axis": 0}),),
+    )
+    target_ir, artifact = _compile_avx512(program, tmp_path, name="embedding-int32")
+    assert artifact.metadata["packed_kernel_operations"] == ()
+    assert artifact.metadata["host_reference_operations"] == ("embedding",)
+    contract = packed_kernel_contract(program.functions[0].body.operations[0], target_ir.plans[0])
+    assert contract is None
