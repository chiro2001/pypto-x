+__attribute__((visibility("default")))
+void ptx_avx512_cast_f32_bf16(const float *input, uint16_t *output, size_t n) {
+    size_t i = 0;
+    const __m512i bias = _mm512_set1_epi32(0x7fff);
+    const __m512i low_bit = _mm512_set1_epi32(1);
+    const __m512i exponent_mask = _mm512_set1_epi32(0x7f800000);
+    const __m512i exponent_full = _mm512_set1_epi32(0x7f800000);
+    for (; i + 16 <= n; i += 16) {
+        __m512i bits = _mm512_castps_si512(_mm512_loadu_ps(input + i));
+        __mmask16 special = _mm512_cmpeq_epi32_mask(
+            _mm512_and_si512(bits, exponent_mask), exponent_full);
+        __m512i rounding = _mm512_add_epi32(
+            bias, _mm512_and_si512(_mm512_srli_epi32(bits, 16), low_bit));
+        __m512i rounded = _mm512_srli_epi32(_mm512_add_epi32(bits, rounding), 16);
+        __m512i truncated = _mm512_srli_epi32(bits, 16);
+        __m512i selected = _mm512_mask_blend_epi32(special, rounded, truncated);
+        _mm256_storeu_si256((__m256i *)(output + i), _mm512_cvtepi32_epi16(selected));
+    }
+    for (; i < n; ++i) output[i] = ptx_f32_to_bf16(input[i]);
+}
