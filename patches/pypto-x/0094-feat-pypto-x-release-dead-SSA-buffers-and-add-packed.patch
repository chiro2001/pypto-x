+# packed bookkeeping / fail-closed
+# --------------------------------------------------------------------------
+
+
+def test_buffer_alloc_has_no_python_element_list():
+    buffer = avx2_runtime._buffer_alloc("float32", 4096, "test")
+    assert buffer.count == 4096
+    assert buffer.dtype == "float32"
+    assert buffer.pointer[0] == 0.0 and buffer.pointer[4095] == 0.0
+    empty = avx2_runtime._buffer_alloc("bf16", 0, "test")
+    assert empty.count == 0
+    with pytest.raises(Exception, match="non-negative integer"):
+        avx2_runtime._buffer_alloc("float32", -1, "test")
+
+
+def test_payload_one_metadata_fails_closed(tmp_path):
+    program = _cast_program("bf16", "float32", (10,))
+    _, artifact = _compile_avx512(program, tmp_path, name="payload")
+    runtime = _runtime()
+    original = dict(artifact.metadata)
+
+    def _tampered(**updates):
+        metadata = dict(original)
+        for key, value in updates.items():
+            if value is None:
+                metadata.pop(key, None)
+            else:
+                metadata[key] = value
+        return metadata
+
+    object.__setattr__(artifact, "metadata", _tampered(artifact_payload_version=1))
+    with pytest.raises(CpuAvx512ArtifactError, match="payload version"):
+        runtime.load(artifact)
+
+    object.__setattr__(artifact, "metadata", _tampered(lowering_version=1))
+    with pytest.raises(CpuAvx512ArtifactError, match="lowering version"):
+        runtime.load(artifact)
+
+    object.__setattr__(artifact, "metadata", _tampered(packed_kernel_version=None))
+    with pytest.raises(CpuAvx512ArtifactError, match="packed_kernel_version"):
+        runtime.load(artifact)
+
+    object.__setattr__(artifact, "metadata", _tampered(packed_operations=[]))
+    with pytest.raises(CpuAvx512ArtifactError, match="packed_operations"):
+        runtime.load(artifact)
+
+    object.__setattr__(artifact, "metadata", _tampered(host_reference_operations=["cast"]))
+    with pytest.raises(CpuAvx512ArtifactError, match="host_reference_operations"):
+        runtime.load(artifact)
+
+    object.__setattr__(artifact, "metadata", original)
+
