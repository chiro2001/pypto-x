+
+@pytest.mark.parametrize("index", (-1, 7, 1 << 20))
+def test_packed_embedding_rejects_out_of_range_indices(index, tmp_path):
+    program = _embedding_program("bf16", (7, 5), (2,))
+    _, artifact = _compile_avx512(program, tmp_path, name="embedding-bad-{}".format(index))
