diff --git a/python/pypto/alias/proof.py b/python/pypto/alias/proof.py
index c11697b20..e47411dca 100644
--- a/python/pypto/alias/proof.py
+++ b/python/pypto/alias/proof.py
@@ -427,13 +427,21 @@ class ProofCondition:
 
 @dataclass(frozen=True)
 class AliasProof:
-    """The complete, digestible alias-proof result."""
+    """The complete, digestible alias-proof result.
+
+    ``facts`` carries the canonical contract/capability/geometry/lifetime/
+    overlap facts the proof was computed from.  Together with ``status``,
+    ``reason`` and the per-condition records it is the exact digest payload,
+    so :func:`recompute_alias_proof_digest` can recompute the digest from the
+    serialized proof alone.
+    """
 
     opcode: str
     status: str
     conditions: Tuple[ProofCondition, ...]
     reason: str
     digest: str
+    facts: Mapping[str, Any] = field(default_factory=dict)
     schema_version: int = ALIAS_PROOF_SCHEMA_VERSION
 
     @property
@@ -458,10 +466,39 @@ class AliasProof:
             "reason": self.reason,
             "failed_conditions": list(self.failed_conditions),
             "conditions": [item.to_dict() for item in self.conditions],
+            "facts": mapping_copy(self.facts),
             "digest": self.digest,
         }
 
 
+def alias_proof_digest_payload(document: Mapping[str, Any]) -> Mapping[str, Any]:
+    """Return the exact canonical payload hashed into ``AliasProof.digest``."""
+
+    return {
+        "schema_version": document.get("schema_version", ALIAS_PROOF_SCHEMA_VERSION),
+        "opcode": document.get("opcode"),
+        "status": document.get("status"),
+        "reason": document.get("reason"),
+        "conditions": [
+            {
+                "name": item.get("name"),
+                "status": item.get("status"),
+                "code": item.get("code"),
+                "reason": item.get("reason"),
+                "evidence": mapping_copy(item.get("evidence", {})),
+            }
+            for item in document.get("conditions", [])
+        ],
+        "facts": mapping_copy(document.get("facts", {})),
+    }
+
+
+def recompute_alias_proof_digest(document: Mapping[str, Any]) -> str:
+    """Recompute the proof digest from ``AliasProof.to_dict()`` output."""
+
+    return "sha256:" + sha256_text(alias_proof_digest_payload(document))
+
+
