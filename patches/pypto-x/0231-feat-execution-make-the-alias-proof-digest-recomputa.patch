 )
 from pypto.execution import (
     ALIAS_PROOF_UNAVAILABLE,
+    ARTIFACT_MISMATCH,
     OP_CONTRACT_INVALID,
     POLICY_CONFLICT,
     POLICY_INVALID_VALUE,
+    REPORT_SCHEMA_INVALID,
     AliasProofUnavailableError,
     CapabilitySnapshot,
+    ExecutionPlan,
     ExecutionPolicy,
     LayoutPolicy,
     execute_matmul,
@@ -167,6 +173,10 @@ def test_proven_proof_records_all_five_conditions_and_is_deterministic():
     assert first.failed_conditions == ()
     assert first.digest == second.digest
     assert first.digest.startswith("sha256:")
+    # The digest is recomputable from the serialized proof alone (the facts
+    # block carries contract/capability/geometry/lifetime/overlap).
+    assert first.to_dict()["facts"]["contract"]["view_obligation"] == "may_alias"
+    assert recompute_alias_proof_digest(first.to_dict()) == first.digest
 
 
 def test_contract_condition_must_not_alias_is_not_a_view_candidate():
@@ -599,6 +609,40 @@ def test_u1_report_carries_the_recomputable_alias_decision():
     assert plan_matmul((2, 4), (4, 4), "float32", policy=requested).plan.digest == report.plan_digest
 
 
+def test_alias_decision_tampering_fails_closed_in_plan_and_report():
+    # A plan is frozen: changing the alias decision (or its proof status)
+    # without rebuilding the digest must be rejected.
+    result = _plan("prefer")
+    for path, value in (
+        (("layout_decision", "view_obligation"), "may_alias"),
+        (("layout_decision", "alias_proof", "status"), "proven"),
+        (("layout_decision", "requested_view_mode"), "require"),
+        (("layout_decision", "layout_copy_bytes"), 64),
+    ):
+        broken = json.loads(json.dumps(result.plan.to_dict()))
+        cursor = broken
+        for part in path[:-1]:
+            cursor = cursor[part]
+        cursor[path[-1]] = value
+        with pytest.raises(Exception) as excinfo:
+            ExecutionPlan.from_dict(broken)
+        assert getattr(excinfo.value, "code", None) == ARTIFACT_MISMATCH
+
+    # A report can never claim require was satisfied by a materialized copy.
+    left = HostTensor("float32", (2, 4), [float(index + 1) for index in range(8)])
+    right = HostTensor("float32", (4, 4), [0.5] * 16)
+    _, report = execute_matmul(left, right, policy=ExecutionPolicy())
+    broken = json.loads(json.dumps(report.to_dict()))
+    broken["layout_decision"]["requested_view_mode"] = "require"
+    broken["layout_decision"]["resolved_view_mode"] = "materialized"
+    broken["layout_decision"]["alias_proof"]["status"] = "proven"
+    from pypto.execution import validate_report_schema
+
+    with pytest.raises(Exception) as excinfo:
+        validate_report_schema(broken)
+    assert getattr(excinfo.value, "code", None) == REPORT_SCHEMA_INVALID
+
