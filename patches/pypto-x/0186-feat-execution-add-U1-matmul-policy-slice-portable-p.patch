diff --git a/python/pypto/execution/capability.py b/python/pypto/execution/capability.py
new file mode 100644
index 000000000..73273d0db
--- /dev/null
+++ b/python/pypto/execution/capability.py
@@ -0,0 +1,417 @@
+"""Capability snapshot consumed by the U1 resolver.
+
+The snapshot is the serializable, evidence-visible view of platform facts:
+
+* target kind and triple;
+* target feature bits;
+* provider availability, versions and the contract digests each provider
+  claims to implement;
+* a digest over the canonicalized fields.
+
+The snapshot does not create a second target registry.  It is a small,
+dependency-free view over the existing ``pypto.target`` facts; the caller may
+inject a ``TargetSpec``-derived triple/features or let the default host
+detection fill them in.  Provider manifests reference the ``OpDefinition``
+registry for their contract digests, so capability and contract cannot drift
+apart silently.
+"""
+
+from __future__ import annotations
+
+import platform
+import sys
+from dataclasses import dataclass
+from typing import Any, Iterable, Mapping, Optional, Sequence, Tuple
+
+from pypto.target._utils import frozen_mapping, mapping_copy, normalize_names, sha256_text
+
+from .errors import ArtifactMismatchError, CapabilityUnavailableError
+from .op_registry import get_op_definition, registered_opcodes
+
+
+CAPABILITY_SCHEMA_VERSION = 1
+PORTABLE_PROVIDER_ID = "portable"
+PORTABLE_PROVIDER_VERSION = "portable.cpu.scalar.v1"
+PORTABLE_PROVIDER_MAX_THREADS = 1
+
+
+def host_triple() -> str:
+    """Return a stable local target triple without importing native modules."""
+
+    machine = (platform.machine() or "unknown").strip().lower()
+    if machine in ("amd64", "x86_64"):
+        arch = "x86_64"
+    elif machine in ("aarch64", "arm64"):
+        arch = "aarch64"
+    else:
+        arch = machine or "unknown"
+    if sys.platform.startswith("linux"):
+        os_part = "linux-gnu"
+    elif sys.platform == "darwin":
+        os_part = "darwin"
+    elif sys.platform.startswith("win"):
+        os_part = "windows-msvc"
+    else:
+        os_part = str(sys.platform)
+    return "{}-{}".format(arch, os_part)
+
+
+def _normalize_features(features: Any) -> Tuple[str, ...]:
+    try:
+        names = normalize_names(features)
+    except (TypeError, ValueError) as exc:
+        raise CapabilityUnavailableError(
+            "capability features must be a sequence of names",
+            field="capability.features",
+            requested=features,
+            reason="invalid_features",
+        ) from exc
+    return tuple(sorted(names))
+
+
+@dataclass(frozen=True, init=False)
+class ProviderCapability:
+    """One provider's declared availability and contract coverage."""
+
+    provider_id: str
+    version: str
+    available: bool
+    target_kinds: Tuple[str, ...]
+    numeric_modes: Tuple[str, ...]
+    deterministic: bool
+    required_features: Tuple[str, ...]
+    contracts: Mapping[str, str]
+    max_threads: int
+    workspace_bytes: int
+    reason: Optional[str]
+
+    def __init__(
+        self,
+        provider_id: str,
+        version: str,
+        available: bool = True,
+        target_kinds: Sequence[str] = ("cpu",),
+        numeric_modes: Sequence[str] = ("portable_bitwise", "deterministic"),
+        deterministic: bool = True,
+        required_features: Sequence[str] = (),
+        contracts: Optional[Mapping[str, str]] = None,
+        max_threads: int = PORTABLE_PROVIDER_MAX_THREADS,
+        workspace_bytes: int = 0,
+        reason: Optional[str] = None
+    ) -> None:
+        if not isinstance(provider_id, str) or not provider_id.strip():
+            raise CapabilityUnavailableError(
+                "provider capability id must be a non-empty string",
+                field="capability.provider.id",
+                requested=provider_id,
+                reason="invalid_provider_id",
+            )
+        if not isinstance(version, str) or not version.strip():
+            raise CapabilityUnavailableError(
+                "provider capability version must be a non-empty string",
+                field="capability.provider.version",
+                requested=version,
+                reason="invalid_provider_version",
+            )
+        if not isinstance(available, bool):
+            raise CapabilityUnavailableError(
+                "provider capability available must be a bool",
+                field="capability.provider.available",
+                requested=available,
+                reason="invalid_availability",
+            )
+        if not available and not reason:
+            raise CapabilityUnavailableError(
+                "an unavailable provider must carry a reason",
+                field="capability.provider.reason",
+                requested=None,
+                reason="missing_unavailable_reason",
+            )
+        if isinstance(max_threads, bool) or not isinstance(max_threads, int) or max_threads <= 0:
+            raise CapabilityUnavailableError(
+                "provider max_threads must be a positive integer",
+                field="capability.provider.max_threads",
+                requested=max_threads,
+                reason="invalid_max_threads",
+            )
+        if isinstance(workspace_bytes, bool) or not isinstance(workspace_bytes, int) or workspace_bytes < 0:
+            raise CapabilityUnavailableError(
+                "provider workspace_bytes must be a non-negative integer",
+                field="capability.provider.workspace_bytes",
+                requested=workspace_bytes,
+                reason="invalid_workspace_bytes",
+            )
+        normalized_contracts = {}
+        if contracts:
+            for key, digest in contracts.items():
+                if not isinstance(key, str) or not key.strip():
+                    raise CapabilityUnavailableError(
+                        "provider contract keys must be opcodes",
+                        field="capability.provider.contracts",
+                        requested=key,
+                        reason="invalid_contract_key",
+                    )
+                if not isinstance(digest, str) or not digest.startswith("sha256:"):
+                    raise CapabilityUnavailableError(
+                        "provider contract digests must be 'sha256:' strings",
+                        field="capability.provider.contracts." + key,
+                        requested=digest,
+                        reason="invalid_contract_digest",
+                    )
+                normalized_contracts[key.strip()] = digest
+        object.__setattr__(self, "provider_id", provider_id.strip())
+        object.__setattr__(self, "version", version.strip())
+        object.__setattr__(self, "available", available)
+        object.__setattr__(self, "target_kinds", tuple(sorted(str(item).strip().lower() for item in target_kinds)))
+        object.__setattr__(self, "numeric_modes", tuple(sorted(str(item).strip() for item in numeric_modes)))
+        object.__setattr__(self, "deterministic", bool(deterministic))
+        object.__setattr__(self, "required_features", _normalize_features(required_features))
+        object.__setattr__(self, "contracts", frozen_mapping(normalized_contracts))
+        object.__setattr__(self, "max_threads", max_threads)
+        object.__setattr__(self, "workspace_bytes", workspace_bytes)
+        object.__setattr__(self, "reason", reason)
+
+    def supports_kind(self, kind: str) -> bool:
+        return kind in self.target_kinds
+
+    def contract_digest(self, opcode: str) -> Optional[str]:
+        return self.contracts.get(opcode)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "provider_id": self.provider_id,
+            "version": self.version,
+            "available": self.available,
+            "target_kinds": list(self.target_kinds),
+            "numeric_modes": list(self.numeric_modes),
+            "deterministic": self.deterministic,
+            "required_features": list(self.required_features),
+            "contracts": mapping_copy(self.contracts),
+            "max_threads": self.max_threads,
+            "workspace_bytes": self.workspace_bytes,
+            "reason": self.reason,
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "ProviderCapability":
+        if not isinstance(value, Mapping):
+            raise CapabilityUnavailableError(
+                "provider capability entry must be a mapping",
+                field="capability.providers",
+                requested=value,
+                reason="invalid_provider_entry",
+            )
+        return cls(
+            provider_id=value.get("provider_id"),
+            version=value.get("version"),
+            available=value.get("available", True),
+            target_kinds=value.get("target_kinds", ("cpu",)),
+            numeric_modes=value.get("numeric_modes", ("portable_bitwise", "deterministic")),
+            deterministic=value.get("deterministic", True),
+            required_features=value.get("required_features", ()),
+            contracts=value.get("contracts"),
+            max_threads=value.get("max_threads", PORTABLE_PROVIDER_MAX_THREADS),
+            workspace_bytes=value.get("workspace_bytes", 0),
+            reason=value.get("reason"),
+        )
+
+
+def portable_provider_capability(
+    available: bool = True,
+    reason: Optional[str] = None,
+    version: str = PORTABLE_PROVIDER_VERSION,
+    target_kinds: Sequence[str] = ("cpu",)
+) -> ProviderCapability:
+    """Build the portable provider manifest from the OpDefinition registry."""
+
+    contracts = {opcode: get_op_definition(opcode).contract_digest for opcode in registered_opcodes()}
+    return ProviderCapability(
+        provider_id=PORTABLE_PROVIDER_ID,
+        version=version,
+        available=available,
+        target_kinds=target_kinds,
+        numeric_modes=("portable_bitwise", "deterministic"),
+        deterministic=True,
+        required_features=(),
+        contracts=contracts,
+        max_threads=PORTABLE_PROVIDER_MAX_THREADS,
+        workspace_bytes=0,
+        reason=reason,
+    )
+
+
+def default_providers(kind: str) -> Tuple[ProviderCapability, ...]:
+    if kind == "cpu":
+        return (portable_provider_capability(),)
+    return (
+        portable_provider_capability(
+            available=False,
+            reason="portable_provider_requires_cpu_target",
+        ),
+    )
+
+
+@dataclass(frozen=True, init=False)
+class CapabilitySnapshot:
+    """Immutable, digestible platform capability facts for one resolution."""
+
+    schema_version: int
+    kind: str
+    triple: str
+    features: Tuple[str, ...]
+    providers: Tuple[ProviderCapability, ...]
+    digest: str
+
+    def __init__(
+        self,
+        kind: str = "cpu",
+        triple: Optional[str] = None,
+        features: Iterable[str] = (),
+        providers: Optional[Sequence[ProviderCapability]] = None
+    ) -> None:
+        if not isinstance(kind, str) or not kind.strip():
+            raise CapabilityUnavailableError(
+                "capability kind must be a non-empty string",
+                field="capability.kind",
+                requested=kind,
+                reason="invalid_kind",
+            )
+        normalized_kind = kind.strip().lower()
+        if triple is None:
+            triple = host_triple() if normalized_kind == "cpu" else "{}-unknown".format(normalized_kind)
+        if not isinstance(triple, str) or not triple.strip():
+            raise CapabilityUnavailableError(
+                "capability triple must be a non-empty string",
+                field="capability.triple",
+                requested=triple,
+                reason="invalid_triple",
+            )
+        entries = tuple(providers) if providers is not None else default_providers(normalized_kind)
+        for entry in entries:
+            if not isinstance(entry, ProviderCapability):
+                raise CapabilityUnavailableError(
+                    "capability providers must be ProviderCapability objects",
+                    field="capability.providers",
+                    requested=type(entry).__name__,
+                    reason="invalid_provider_entry",
+                )
+        normalized_features = _normalize_features(features)
+        sorted_providers = tuple(sorted(entries, key=lambda item: item.provider_id))
+        document = {
+            "capability_schema_version": CAPABILITY_SCHEMA_VERSION,
+            "kind": normalized_kind,
+            "triple": triple.strip().lower(),
+            "features": list(normalized_features),
+            "providers": [item.to_dict() for item in sorted_providers],
+        }
+        object.__setattr__(self, "schema_version", CAPABILITY_SCHEMA_VERSION)
+        object.__setattr__(self, "kind", normalized_kind)
+        object.__setattr__(self, "triple", document["triple"])
+        object.__setattr__(self, "features", normalized_features)
+        object.__setattr__(self, "providers", sorted_providers)
+        object.__setattr__(self, "digest", "sha256:" + sha256_text(document))
+
+    @classmethod
+    def for_host(
+        cls,
+        kind: str = "cpu",
+        triple: Optional[str] = None,
+        features: Iterable[str] = (),
+        providers: Optional[Sequence[ProviderCapability]] = None
+    ) -> "CapabilitySnapshot":
+        return cls(kind=kind, triple=triple, features=features, providers=providers)
+
+    def provider(self, provider_id: str) -> Optional[ProviderCapability]:
+        for entry in self.providers:
+            if entry.provider_id == provider_id:
+                return entry
+        return None
+
+    def provider_ids(self) -> Tuple[str, ...]:
+        return tuple(sorted(entry.provider_id for entry in self.providers))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "schema_version": self.schema_version,
+            "kind": self.kind,
+            "triple": self.triple,
+            "features": list(self.features),
+            "providers": [entry.to_dict() for entry in self.providers],
+            "digest": self.digest,
+        }
+
+    def canonical_document(self) -> Mapping[str, Any]:
+        return {
+            "capability_schema_version": self.schema_version,
+            "kind": self.kind,
+            "triple": self.triple,
+            "features": list(self.features),
+            "providers": [entry.to_dict() for entry in self.providers],
+        }
+
+    def verify_digest(self) -> None:
+        expected = "sha256:" + sha256_text(self.canonical_document())
+        if expected != self.digest:
+            raise ArtifactMismatchError(
+                "capability snapshot digest does not match its content",
+                field="capability.digest",
+                requested=self.digest,
+                available=expected,
+                reason="capability_digest_mismatch",
+            )
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "CapabilitySnapshot":
+        if not isinstance(value, Mapping):
+            raise CapabilityUnavailableError(
+                "capability snapshot must be a mapping",
+                field="capability",
+                requested=type(value).__name__,
+                reason="not_a_mapping",
+            )
+        schema_version = value.get("schema_version", CAPABILITY_SCHEMA_VERSION)
+        if schema_version != CAPABILITY_SCHEMA_VERSION:
+            raise ArtifactMismatchError(
+                "unsupported capability schema version",
+                field="capability.schema_version",
+                requested=schema_version,
+                available=CAPABILITY_SCHEMA_VERSION,
+                reason="capability_schema_version_mismatch",
+            )
+        providers = value.get("providers", ())
+        if not isinstance(providers, (list, tuple)):
+            raise CapabilityUnavailableError(
+                "capability providers must be a list",
+                field="capability.providers",
+                requested=type(providers).__name__,
+                reason="invalid_provider_entry",
+            )
+        snapshot = cls(
+            kind=value.get("kind", "cpu"),
+            triple=value.get("triple"),
+            features=value.get("features", ()),
+            providers=tuple(ProviderCapability.from_dict(item) for item in providers),
+        )
+        expected = value.get("digest")
+        if expected is not None and expected != snapshot.digest:
+            raise ArtifactMismatchError(
+                "capability snapshot digest mismatch",
+                field="capability.digest",
+                requested=expected,
+                available=snapshot.digest,
+                reason="capability_digest_mismatch",
+            )
+        return snapshot
+
+
+__all__ = [
+    "CAPABILITY_SCHEMA_VERSION",
+    "PORTABLE_PROVIDER_ID",
+    "PORTABLE_PROVIDER_MAX_THREADS",
+    "PORTABLE_PROVIDER_VERSION",
+    "CapabilitySnapshot",
+    "ProviderCapability",
+    "default_providers",
+    "host_triple",
+    "portable_provider_capability",
+]
diff --git a/python/pypto/execution/entry.py b/python/pypto/execution/entry.py
new file mode 100644
index 000000000..65f6eb507
--- /dev/null
+++ b/python/pypto/execution/entry.py
@@ -0,0 +1,442 @@
+"""Thin policy-driven matmul entry for the U1 slice.
+
+Usage::
+
+    from pypto.execution import ExecutionPolicy, execute_matmul
+
+    result, report = execute_matmul(left, right, policy=ExecutionPolicy.portable())
+
+``result`` is the output :class:`pypto.backends.cpu.HostTensor`; ``report`` is
+a schema-validated :class:`pypto.execution.report.ExecutionReport`.  With an
+already resolved plan (for example reloaded from JSON) use
+:func:`execute_matmul_plan`; the runtime then only validates the frozen plan
+and never re-resolves, which is the "declaration equals execution" contract.
+"""
+
+from __future__ import annotations
+
+import time
+from typing import Any, Optional, Tuple
+
+from pypto.backends.cpu import HostTensor
+from pypto.target._utils import mapping_copy
+
+from .capability import CapabilitySnapshot
+from .errors import ArtifactMismatchError, OpContractError, ProviderUnavailableError
+from .op_registry import get_op_definition
+from .plan import ExecutionPlan
+from .policy import KNOWN_TARGET_KINDS, ExecutionPolicy
+from .providers import PORTABLE_RUNNER_VERSION, ProviderOutcome, get_provider
+from .report import ExecutionReport
+from .resolver import ResolutionResult, resolve_matmul
+
+
+GATE_REASON = "host_kvm_no_cpufreq_non_quiet_window"
+GUARANTEE_BASIS = "portable_provider_trunk_identity_not_a_cross_provider_promise"
+
+
+def capability_for_policy(
+    policy: ExecutionPolicy,
+    capability: Optional[CapabilitySnapshot]
+) -> CapabilitySnapshot:
+    """Return the capability snapshot to resolve against."""
+
+    if capability is not None:
+        if not isinstance(capability, CapabilitySnapshot):
+            raise ProviderUnavailableError(
+                "capability must be a CapabilitySnapshot",
+                field="capability",
+                requested=type(capability).__name__,
+                reason="not_a_capability_snapshot",
+            )
+        capability.verify_digest()
+        return capability
+    if policy.target == "auto" or policy.target == "cpu":
+        return CapabilitySnapshot.for_host(kind="cpu")
+    if policy.target in KNOWN_TARGET_KINDS:
+        return CapabilitySnapshot.for_host(
+            kind=policy.target,
+            triple="{}-unknown".format(policy.target),
+        )
+    return CapabilitySnapshot.for_host(kind="cpu", triple=policy.target)
+
+
+def plan_matmul(
+    left_shape: Any,
+    right_shape: Any,
+    dtype: str,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None
+) -> ResolutionResult:
+    """Resolve one matmul request without executing it."""
+
+    active_policy = policy if policy is not None else ExecutionPolicy()
+    if not isinstance(active_policy, ExecutionPolicy):
+        raise OpContractError(
+            "policy must be an ExecutionPolicy",
+            field="policy",
+            requested=type(active_policy).__name__,
+            reason="not_an_execution_policy",
+        )
+    active_capability = capability_for_policy(active_policy, capability)
+    return resolve_matmul(active_policy, active_capability, left_shape, right_shape, dtype)
+
+
+def execute_matmul(
+    left: HostTensor,
+    right: HostTensor,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Optional[CapabilitySnapshot] = None,
+    output: Optional[HostTensor] = None
+) -> Tuple[HostTensor, ExecutionReport]:
+    """Resolve, execute and report one portable matmul."""
+
+    _require_host_tensors(left, right)
+    if left.dtype != right.dtype:
+        raise OpContractError(
+            "matmul requires dtype(left) == dtype(right)",
+            field="dtype",
+            requested={"left": left.dtype, "right": right.dtype},
+            reason="dtype_mismatch",
+        )
+    active_policy = policy if policy is not None else ExecutionPolicy()
+    active_capability = capability_for_policy(active_policy, capability)
+    resolution = resolve_matmul(active_policy, active_capability, left.shape, right.shape, left.dtype)
+    return _execute(plan=resolution.plan, left=left, right=right, capability=active_capability, output=output)
+
+
+def execute_matmul_plan(
+    plan: ExecutionPlan,
+    left: HostTensor,
+    right: HostTensor,
+    capability: Optional[CapabilitySnapshot] = None,
+    output: Optional[HostTensor] = None
+) -> Tuple[HostTensor, ExecutionReport]:
+    """Execute a frozen plan; validate it, never re-resolve it."""
+
+    if not isinstance(plan, ExecutionPlan):
+        raise ArtifactMismatchError(
+            "execute_matmul_plan requires an ExecutionPlan",
+            field="plan",
+            requested=type(plan).__name__,
+            reason="not_an_execution_plan",
+        )
+    _require_host_tensors(left, right)
+    plan.validate()
+    definition = get_op_definition(plan.opcode)
+    if plan.contract_digest != definition.contract_digest:
+        raise ArtifactMismatchError(
+            "plan contract digest does not match the registered OpDefinition",
+            field="plan.contract.digest",
+            requested=plan.contract_digest,
+            available=definition.contract_digest,
+            reason="contract_digest_mismatch",
+        )
+    if capability is None:
+        capability = CapabilitySnapshot.for_host(
+            kind=str(plan.payload["target"]["kind"]),
+            triple=str(plan.payload["target"]["triple"]),
+            features=plan.payload["target"].get("features", ()),
+        )
+    elif not isinstance(capability, CapabilitySnapshot):
+        raise ArtifactMismatchError(
+            "capability must be a CapabilitySnapshot",
+            field="capability",
+            requested=type(capability).__name__,
+            reason="not_a_capability_snapshot",
+        )
+    if capability.digest != plan.capability_digest:
+        raise ArtifactMismatchError(
+            "capability snapshot does not match the frozen plan",
+            field="plan.target.capability_digest",
+            requested=capability.digest,
+            available=plan.capability_digest,
+            reason="capability_digest_mismatch",
+        )
+    return _execute(plan=plan, left=left, right=right, capability=capability, output=output)
+
+
+def _execute(
+    *,
+    plan: ExecutionPlan,
+    left: HostTensor,
+    right: HostTensor,
+    capability: CapabilitySnapshot,
+    output: Optional[HostTensor]
+) -> Tuple[HostTensor, ExecutionReport]:
+    plan.validate()
+    definition = get_op_definition(plan.opcode)
+    if output is None:
+        output = HostTensor.zeros(plan.dtype, plan.output_shape)
+    if not isinstance(output, HostTensor):
+        raise OpContractError(
+            "output must be a HostTensor",
+            field="output",
+            requested=type(output).__name__,
+            reason="unsupported_output_handle",
+        )
+    declared_provider = plan.selected_provider
+    provider = get_provider(declared_provider)
+    if provider.provider_id != declared_provider:
+        raise ArtifactMismatchError(
+            "executor provider does not match the declared plan provider",
+            field="plan.selected.provider",
+            requested=declared_provider,
+            available=provider.provider_id,
+            reason="declared_provider_does_not_match_executor",
+        )
+    started = time.perf_counter()
+    outcome = provider.execute(plan, left, right, output, capability)
+    wall_seconds = time.perf_counter() - started
+    op_seconds = float(outcome.op_seconds)
+    if wall_seconds < op_seconds:
+        wall_seconds = op_seconds
+    dispatch_seconds = wall_seconds - op_seconds
+    _verify_artifact_declaration(plan, outcome, definition)
+    report = ExecutionReport(
+        _build_report_payload(
+            plan=plan,
+            outcome=outcome,
+            provider=provider,
+            dispatch_seconds=dispatch_seconds,
+            op_seconds=op_seconds,
+            wall_seconds=wall_seconds,
+            capability=capability,
+        )
+    )
+    return outcome.output, report
+
+
+def _verify_artifact_declaration(plan: ExecutionPlan, outcome: ProviderOutcome, definition: Any) -> None:
+    declared = plan.artifact_versions
+    actual = {
+        "contract_version": definition.contract_version,
+        "lowering_version": outcome.lowering_version,
+        "runner_version": PORTABLE_RUNNER_VERSION,
+        "wire_version": outcome.wire_version,
+        "provider_version": outcome.provider_version,
+    }
+    for name, value in actual.items():
+        if declared.get(name) != value:
+            raise ArtifactMismatchError(
+                "executed artifact {} does not match the frozen plan declaration".format(name),
+                field="plan.artifact." + name,
+                requested=value,
+                available=declared.get(name),
+                reason="artifact_declaration_mismatch",
+            )
+
+
+def _build_report_payload(
+    *,
+    plan: ExecutionPlan,
+    outcome: ProviderOutcome,
+    provider: Any,
+    dispatch_seconds: float,
+    op_seconds: float,
+    wall_seconds: float,
+    capability: CapabilitySnapshot
+) -> Any:
+    definition = get_op_definition(plan.opcode)
+    payload = plan.payload
+    selected = plan.selected
+    request = plan.request
+    numeric = plan.numeric_guarantee
+    return {
+        "schema_version": 1,
+        "request": {
+            "op": request["op"],
+            "left_shape": list(request["left_shape"]),
+            "right_shape": list(request["right_shape"]),
+            "output_shape": list(request["output_shape"]),
+            "dtype": request["dtype"],
+            "policy_digest": request["policy_digest"],
+        },
+        "requested_policy": mapping_copy(payload["policy"]["requested"]),
+        "resolved_policy": mapping_copy(payload["policy"]["resolved"]),
+        "policy_applicability": mapping_copy(payload["policy_applicability"]),
+        "layout_decision": mapping_copy(payload["layout_decision"]),
+        "resolved": {
+            "target": {
+                "kind": capability.kind,
+                "triple": capability.triple,
+                "features": list(capability.features),
+            },
+            "provider": selected["provider"],
+            "provider_version": selected["provider_version"],
+            "implementation": selected["implementation"],
+            "profile": payload["policy"]["resolved"]["profile"],
+            "contract": {
+                "opcode": definition.canonical_opcode,
+                "version": definition.contract_version,
+                "digest": definition.contract_digest,
+            },
+            "numeric_class": selected["numeric_class"],
+        },
+        "guarantees": {
+            "numeric_class": numeric["class"],
+            "precision_class": numeric["class"],
+            "scope": numeric["scope"],
+            "basis": GUARANTEE_BASIS,
+            "deterministic": numeric["deterministic"],
+            "accumulation": numeric["accumulation"],
+            "rounding": numeric["rounding"],
+            "reduction_order": numeric["reduction_order"],
+            "reduction_order_id": numeric["reduction_order_id"],
+            "exactness_basis": numeric["exactness_basis"],
+            "error_budget": numeric.get("error_budget"),
+            "reference": numeric["reference"],
+        },
+        "resolution": {
+            "plan_digest": plan.digest,
+            "policy_digest": plan.policy_digest,
+            "capability_digest": plan.capability_digest,
+            "contract_digest": plan.contract_digest,
+            "candidates": [mapping_copy(item) for item in payload["candidates"]],
+            "fallback_chain": list(payload["fallback"]["chain"]),
+            "fallback_events": [mapping_copy(item) for item in payload["fallback"]["events"]],
+            "degraded": bool(payload["fallback"]["degraded"]),
+            "rules": [mapping_copy(item) for item in payload["resolution"]["rules"]],
+            "tie_break": list(payload["resolution"]["tie_break"]),
+            "why": _explain(plan),
+        },
+        "artifact": {
+            "format": outcome.artifact_format,
+            "content_digest": outcome.artifact_content_digest,
+            "contract_version": definition.contract_version,
+            "lowering_version": outcome.lowering_version,
+            "runner_version": PORTABLE_RUNNER_VERSION,
+            "wire_version": outcome.wire_version,
+            "provider_version": outcome.provider_version,
+            "abi_version": outcome.abi_version,
+        },
+        "timing": {
+            "dispatch_seconds": dispatch_seconds,
+            "op_seconds": op_seconds,
+            "transfer_seconds": 0.0,
+            "wall_seconds": wall_seconds,
+            "kernel_seconds": None,
+            "timing_basis": {
+                "op_seconds": "wall clock around CpuScalarRuntime.launch (existing runtime entry)",
+                "dispatch_seconds": "entry wall clock minus op_seconds (plan validation, compile, request build)",
+                "transfer_seconds": "0.0: host-side HostTensor buffers, no device transfer",
+                "kernel_seconds": "null: no device kernel timer on the portable CPU path",
+                "gate": "not a performance claim; report is UNGATED",
+            },
+        },
+        "gates": {
+            "performance_gated": False,
+            "status": "UNGATED",
+            "reason": GATE_REASON,
+            "note": "12 vCPU KVM without cpufreq on a non-quiet window; "
+            "numbers are raw single-call observations only",
+        },
+        "capability": {
+            "snapshot_digest": capability.digest,
+            "kind": capability.kind,
+            "triple": capability.triple,
+            "features": list(capability.features),
+        },
+        "dispatch": {
+            "provider_declared": plan.selected_provider,
+            "provider_invoked": provider.provider_id,
+            "declaration_match": provider.provider_id == plan.selected_provider,
+            "threads_used": outcome.threads_used,
+        },
+        "resources": {
+            "parallelism": {
+                "worker_count": 1,
+                "worker_index": 0,
+                "intra_op_threads": outcome.threads_used,
+                "oversubscription_policy": "reject",
+                "cpu_affinity": None,
+            },
+        },
+        "coverage": {
+            "logical_operation_counts": [
+                {
+                    "opcode": definition.canonical_opcode,
+                    "count": 1,
+                    "included_in_graph_total": True,
+                    "parent_opcode": None,
+                }
+            ],
+            "provider_invocation_counts": [
+                {
+                    "provider": selected["provider"],
+                    "opcode": definition.canonical_opcode,
+                    "count": 1,
+                    "included_in_graph_total": False,
+                    "parent_opcode": None,
+                }
+            ],
+            "artifact_preparation_counts": [
+                {
+                    "artifact_format": outcome.artifact_format,
+                    "count": 1,
+                    "included_in_graph_total": False,
+                    "parent_opcode": None,
+                }
+            ],
+            "epilogue_counts": [],
+        },
+    }
+
+
+def _explain(plan: ExecutionPlan) -> str:
+    payload = plan.payload
+    selected = plan.selected
+    numeric = plan.numeric_guarantee
+    candidates = payload["candidates"]
+    ordered = ", ".join(
+        "{}:{}".format(item["id"], item["state"]) for item in candidates
+    )
+    return (
+        "selected provider {provider!r} for {op} {dtype} {left}x{right}->{out}; "
+        "contract {contract}@{version} digest {digest}; "
+        "reason: satisfies policy profile={profile}, provider.mode={mode}, "
+        "numeric.requirement={requirement} with class {numeric_class} "
+        "(deterministic={deterministic}); "
+        "candidate states [{ordered}]; fixed tie-break {tie_break}; "
+        "fallback chain {chain}; numeric downgrade: none"
+    ).format(
+        provider=selected["provider"],
+        op=plan.opcode,
+        dtype=plan.dtype,
+        left=list(plan.left_shape),
+        right=list(plan.right_shape),
+        out=list(plan.output_shape),
+        contract=payload["contract"]["opcode"],
+        version=payload["contract"]["version"],
+        digest=payload["contract"]["digest"],
+        profile=payload["policy"]["resolved"]["profile"],
+        mode=payload["policy"]["resolved"]["provider"]["requested_mode"],
+        requirement=payload["policy"]["resolved"]["numeric"]["requested_requirement"],
+        numeric_class=numeric["class"],
+        deterministic=str(numeric["deterministic"]).lower(),
+        ordered=ordered,
+        tie_break=list(payload["resolution"]["tie_break"]),
+        chain=list(payload["fallback"]["chain"]),
+    )
+
+
+def _require_host_tensors(left: Any, right: Any) -> None:
+    for label, value in (("left", left), ("right", right)):
+        if not isinstance(value, HostTensor):
+            raise OpContractError(
+                "portable matmul requires HostTensor operands",
+                field="operand." + label,
+                requested=type(value).__name__,
+                available=["HostTensor"],
+                reason="unsupported_operand_handle",
+            )
+
+
+__all__ = [
+    "GATE_REASON",
+    "GUARANTEE_BASIS",
+    "capability_for_policy",
+    "execute_matmul",
+    "execute_matmul_plan",
+    "plan_matmul",
+]
diff --git a/python/pypto/execution/errors.py b/python/pypto/execution/errors.py
new file mode 100644
index 000000000..b736c0476
--- /dev/null
+++ b/python/pypto/execution/errors.py
@@ -0,0 +1,189 @@
+"""Structured, fail-closed errors for the PyPTO-X execution layer (U1).
+
+Every error carries the fields required by the interface guidance
+(``docs/10-architecture/0006-...`` section 5.1): ``field``, ``requested``,
+``available``, ``reason``, ``suggested_policy`` and ``capability_digest``.
+The machine-readable ``code`` values extend the fixed table in 0006 with
+``POLICY_UNKNOWN_FIELD`` and ``REPORT_SCHEMA_INVALID`` only; everything else
+reuses the frozen codes from that table.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+
+# Error codes from 0006 section 5.1 (plus the two extensions above).
+OP_CONTRACT_INVALID = "OP_CONTRACT_INVALID"
+POLICY_CONFLICT = "POLICY_CONFLICT"
+CAPABILITY_UNAVAILABLE = "CAPABILITY_UNAVAILABLE"
+PROVIDER_UNAVAILABLE = "PROVIDER_UNAVAILABLE"
+NUMERIC_GUARANTEE_UNMET = "NUMERIC_GUARANTEE_UNMET"
+RESOURCE_BUDGET_EXCEEDED = "RESOURCE_BUDGET_EXCEEDED"
+ARTIFACT_MISMATCH = "ARTIFACT_MISMATCH"
+FALLBACK_DISALLOWED = "FALLBACK_DISALLOWED"
+POLICY_UNKNOWN_FIELD = "POLICY_UNKNOWN_FIELD"
+POLICY_FIELD_NOT_APPLICABLE = "POLICY_FIELD_NOT_APPLICABLE"
+POLICY_INVALID_VALUE = "POLICY_INVALID_VALUE"
+REPORT_SCHEMA_INVALID = "REPORT_SCHEMA_INVALID"
+
+
+class ExecutionError(RuntimeError):
+    """Base class for every structured execution-layer failure.
+
+    The object is deliberately dependency-free so ``pypto.execution`` can be
+    imported in portable-only mode.  ``reason_code`` mirrors the convention
+    of :class:`pypto.framework.errors.PyPTOXBridgeError`; callers that need
+    the framework exception hierarchy can use :meth:`to_framework_error`.
+    """
+
+    code = "EXECUTION_ERROR"
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        field: Optional[str] = None,
+        requested: Any = None,
+        available: Any = None,
+        reason: Optional[str] = None,
+        suggested_policy: Any = None,
+        capability_digest: Optional[str] = None,
+        details: Optional[Mapping[str, Any]] = None
+    ) -> None:
+        if not isinstance(message, str) or not message.strip():
+            raise ValueError("execution error message must be a non-empty string")
+        super().__init__(message)
+        self.field = field
+        self.requested = requested
+        self.available = available
+        self.reason = reason
+        self.suggested_policy = suggested_policy
+        self.capability_digest = capability_digest
+        self.details = dict(details) if details else {}
+        self.reason_code = self.code
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "error": self.__class__.__name__,
+            "code": self.code,
+            "reason_code": self.reason_code,
+            "message": str(self),
+            "field": self.field,
+            "requested": self.requested,
+            "available": self.available,
+            "reason": self.reason,
+            "suggested_policy": self.suggested_policy,
+            "capability_digest": self.capability_digest,
+            "details": dict(self.details),
+        }
+
+    def to_framework_error(self) -> Any:
+        """Map onto the existing framework error hierarchy (0006 section 5.1).
+
+        The import stays lazy so the execution layer keeps working in
+        portable-only mode where the framework bridge is not required.
+        """
+
+        from pypto.framework.errors import PyPTOXBuildError, PyPTOXBridgeError, PyPTOXUnsupportedError
+
+        details = {"execution_error": self.to_dict()}
+        if self.code in _UNSUPPORTED_CODES:
+            return PyPTOXUnsupportedError(str(self), reason_code=self.code.lower(), details=details)
+        if self.code in _BUILD_CODES:
+            return PyPTOXBuildError(str(self), reason_code=self.code.lower(), details=details)
+        return PyPTOXBridgeError(str(self), reason_code=self.code.lower(), details=details)
+
+
+class OpContractError(ExecutionError):
+    code = OP_CONTRACT_INVALID
+
+
+class PolicyUnknownFieldError(ExecutionError):
+    code = POLICY_UNKNOWN_FIELD
+
+
+class PolicyFieldNotApplicableError(ExecutionError):
+    code = POLICY_FIELD_NOT_APPLICABLE
+
+
+class PolicyInvalidValueError(ExecutionError):
+    code = POLICY_INVALID_VALUE
+
+
+class PolicyConflictError(ExecutionError):
+    code = POLICY_CONFLICT
+
+
+class CapabilityUnavailableError(ExecutionError):
+    code = CAPABILITY_UNAVAILABLE
+
+
+class ProviderUnavailableError(ExecutionError):
+    code = PROVIDER_UNAVAILABLE
+
+
+class NumericGuaranteeUnmetError(ExecutionError):
+    code = NUMERIC_GUARANTEE_UNMET
+
+
+class ResourceBudgetExceededError(ExecutionError):
+    code = RESOURCE_BUDGET_EXCEEDED
+
+
+class ArtifactMismatchError(ExecutionError):
+    code = ARTIFACT_MISMATCH
+
+
+class FallbackDisallowedError(ExecutionError):
+    code = FALLBACK_DISALLOWED
+
+
+class ReportSchemaError(ExecutionError):
+    code = REPORT_SCHEMA_INVALID
+
+
+_UNSUPPORTED_CODES = frozenset(
+    (
+        OP_CONTRACT_INVALID,
+        POLICY_CONFLICT,
+        CAPABILITY_UNAVAILABLE,
+        PROVIDER_UNAVAILABLE,
+        NUMERIC_GUARANTEE_UNMET,
+        RESOURCE_BUDGET_EXCEEDED,
+        FALLBACK_DISALLOWED,
+        POLICY_UNKNOWN_FIELD,
+        POLICY_FIELD_NOT_APPLICABLE,
+        POLICY_INVALID_VALUE,
+    )
+)
+_BUILD_CODES = frozenset((ARTIFACT_MISMATCH, REPORT_SCHEMA_INVALID))
+
+
+__all__ = [
+    "ARTIFACT_MISMATCH",
+    "CAPABILITY_UNAVAILABLE",
+    "FALLBACK_DISALLOWED",
+    "NUMERIC_GUARANTEE_UNMET",
+    "OP_CONTRACT_INVALID",
+    "POLICY_CONFLICT",
+    "POLICY_FIELD_NOT_APPLICABLE",
+    "POLICY_INVALID_VALUE",
+    "POLICY_UNKNOWN_FIELD",
+    "PROVIDER_UNAVAILABLE",
+    "REPORT_SCHEMA_INVALID",
+    "RESOURCE_BUDGET_EXCEEDED",
+    "ArtifactMismatchError",
+    "CapabilityUnavailableError",
+    "ExecutionError",
+    "FallbackDisallowedError",
+    "NumericGuaranteeUnmetError",
+    "OpContractError",
+    "PolicyConflictError",
+    "PolicyFieldNotApplicableError",
+    "PolicyInvalidValueError",
+    "PolicyUnknownFieldError",
+    "ProviderUnavailableError",
+    "ReportSchemaError",
+    "ResourceBudgetExceededError",
+]
diff --git a/python/pypto/execution/op_registry.py b/python/pypto/execution/op_registry.py
new file mode 100644
index 000000000..1f6afbb16
--- /dev/null
+++ b/python/pypto/execution/op_registry.py
@@ -0,0 +1,528 @@
+"""Canonical ``OpDefinition`` registry for the execution layer (U1).
+
+The registry is the single semantic source of truth for the operations the
+execution layer knows about.  It is deliberately a *view* of the existing
+Core IR/lowering surface rather than a second type system:
+
+* the accepted Core IR opcode spellings are derived at import time from
+  :data:`pypto.lowering.cpu.OP_ALIASES`, so "Core IR accepts A, the contract
+  says B" drift is impossible for the opcode set;
+* the dtype domain is derived from
+  :data:`pypto.lowering.cpu.SUPPORTED_DTYPES` (bool excluded, as the scalar
+  matmul lowering explicitly rejects bool);
+* the rank/shape rules are the frozen matmul contract from
+  ``docs/10-architecture/0006-...`` section 13.2 (P3), verified against the
+  existing lowerer by the focused test suite.
+
+Only ``matmul`` is registered in this slice.  Unknown public opcodes and
+unknown contract versions/digests fail closed (0006 section 13.5).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Sequence, Tuple
+
+from pypto.core_ir import CoreType, Effect, Operation
+from pypto.lowering.cpu import (
+    OP_ALIASES,
+    SUPPORTED_DTYPES,
+    CpuScalarUnsupportedError,
+    canonical_dtype,
+    canonical_operation_name,
+)
+from pypto.target._utils import frozen_mapping, mapping_copy, sha256_text
+
+from .errors import OpContractError
+
+
+OP_REGISTRY_SCHEMA_VERSION = 1
+MATMUL_CANONICAL_OPCODE = "matmul"
+MATMUL_CONTRACT_VERSION = "1.0"
+PORTABLE_REFERENCE_ID = "portable.cpu.scalar.matmul.v1"
+
+# Only these attributes may appear on a U1 matmul operation.  Unknown
+# attributes fail closed instead of being silently ignored by the permissive
+# Core IR container.
+_MATMUL_ATTRIBUTE_NAMES = ("transpose_a", "transpose_b")
+_MATMUL_RANK_MIN = 2
+_MATMUL_RANK_MAX = 4
+
+_NUMERIC_CONTRACT = {
+    "reference": "portable_reference_v1",
+    "numeric_classes": {
+        "portable": "portable_bitwise",
+        "deterministic": True,
+    },
+    "accumulation": {
+        "float16": "float64_accumulate_single_cast_to_float16",
+        "float32": "float32_step_cast",
+        "float64": "float64",
+        "bf16": "float32_step_cast",
+        "integer": "exact_python_integer_single_range_checked_cast",
+    },
+    "accumulation_rounding": "rne_ieee754_binary_cast",
+    "integer_overflow": "range_checked_and_rejected_no_saturation",
+    "reduction_order": "k_ascending_serial_per_output_element",
+    "reduction_order_id": "portable_serial_k_ascending_v1",
+    "exactness_basis": "contract_and_order",
+    "batch_order": "row_major_batch_row_column",
+    "multiply_add": "python_double_multiply_then_contract_defined_cast",
+    "nan_inf": "ieee754_propagation; float16_output_overflow_is_rejected_not_saturated",
+    "k_tail": "serial_tail_no_special_case",
+    "empty": "k_zero_or_empty_axis_yields_additive_identity_then_output_cast",
+    "bias_epilogue": "none_in_u1",
+    "aliasing": "inputs_readonly_outputs_distinct",
+    "effects": "pure",
+    "quantization": None,
+}
+
+_PORTABLE_REFERENCE = {
+    "id": PORTABLE_REFERENCE_ID,
+    "lowering_backend": "cpu.scalar",
+    "lowering_entry": "pypto.lowering.cpu.lower_cpu_scalar",
+    "executor_symbol": "pypto.backends.cpu.runtime._matmul_value",
+    "runtime": "pypto.backends.cpu.CpuScalarRuntime",
+}
+
+
+@dataclass(frozen=True)
+class OperandSpec:
+    """One operand/result predicate of an :class:`OpDefinition`."""
+
+    name: str
+    role: str
+    dtypes: Tuple[str, ...]
+    rank_min: int
+    rank_max: int
+    layout: str = "declared"
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "name": self.name,
+            "role": self.role,
+            "dtypes": list(self.dtypes),
+            "rank": [self.rank_min, self.rank_max],
+            "layout": self.layout,
+        }
+
+
+@dataclass(frozen=True, init=False)
+class OpDefinition:
+    """Canonical definition of one portable operator contract."""
+
+    canonical_opcode: str
+    contract_version: str
+    core_ir_opcodes: Tuple[str, ...]
+    inputs: Tuple[OperandSpec, ...]
+    outputs: Tuple[OperandSpec, ...]
+    numeric_contract: Mapping[str, Any]
+    portable_reference: Mapping[str, Any]
+    allowed_providers: Tuple[str, ...]
+    attribute_names: Tuple[str, ...]
+    contract_document: Mapping[str, Any]
+    contract_digest: str
+
+    def __init__(
+        self,
+        canonical_opcode: str,
+        contract_version: str,
+        core_ir_opcodes: Sequence[str],
+        inputs: Sequence[OperandSpec],
+        outputs: Sequence[OperandSpec],
+        numeric_contract: Mapping[str, Any],
+        portable_reference: Mapping[str, Any],
+        allowed_providers: Sequence[str],
+        attribute_names: Sequence[str]
+    ) -> None:
+        if not isinstance(canonical_opcode, str) or not canonical_opcode.strip():
+            raise OpContractError("OpDefinition canonical opcode must be a non-empty string")
+        if not isinstance(contract_version, str) or not contract_version.strip():
+            raise OpContractError("OpDefinition contract version must be a non-empty string")
+        normalized_aliases = tuple(sorted(set(str(name).strip().lower() for name in core_ir_opcodes)))
+        if canonical_opcode.strip().lower() not in normalized_aliases:
+            raise OpContractError(
+                "OpDefinition alias set must contain the canonical opcode",
+                field="core_ir_opcodes",
+                requested=list(normalized_aliases),
+                available=[canonical_opcode],
+            )
+        document = {
+            "op_registry_schema_version": OP_REGISTRY_SCHEMA_VERSION,
+            "canonical_opcode": canonical_opcode.strip().lower(),
+            "contract_version": contract_version.strip(),
+            "core_ir_opcodes": list(normalized_aliases),
+            "inputs": [item.to_dict() for item in inputs],
+            "outputs": [item.to_dict() for item in outputs],
+            "numeric": dict(numeric_contract),
+            "portable_reference": dict(portable_reference),
+            "allowed_providers": sorted(str(item) for item in allowed_providers),
+            "attributes": list(attribute_names),
+            "shape_rules": [
+                "rank(a) == rank(b) == rank(c)",
+                "2 <= rank <= 4",
+                "batch(a) == batch(b)",
+                "k(a) == k(b)",
+                "shape(c) == batch + (m(a), n(b))",
+            ],
+            "dtype_rules": [
+                "dtype(a) == dtype(b) == dtype(c)",
+                "dtype != bool",
+                "dtype in matmul dtype domain",
+            ],
+            "effects": "pure",
+            "quantization": "none; qmatmul_s8s8_s32 is a separate P3 contract (not in U1)",
+        }
+        digest = "sha256:" + sha256_text(document)
+        object.__setattr__(self, "canonical_opcode", document["canonical_opcode"])
+        object.__setattr__(self, "contract_version", document["contract_version"])
+        object.__setattr__(self, "core_ir_opcodes", normalized_aliases)
+        object.__setattr__(self, "inputs", tuple(inputs))
+        object.__setattr__(self, "outputs", tuple(outputs))
+        object.__setattr__(self, "numeric_contract", frozen_mapping(numeric_contract))
+        object.__setattr__(self, "portable_reference", frozen_mapping(portable_reference))
+        object.__setattr__(self, "allowed_providers", tuple(sorted(str(item) for item in allowed_providers)))
+        object.__setattr__(self, "attribute_names", tuple(attribute_names))
+        object.__setattr__(self, "contract_document", frozen_mapping(document))
+        object.__setattr__(self, "contract_digest", digest)
+
+    @property
+    def contract_identity(self) -> Mapping[str, Any]:
+        """The ``opcode + contract_version + contract_digest`` triple."""
+
+        return {
+            "opcode": self.canonical_opcode,
+            "version": self.contract_version,
+            "digest": self.contract_digest,
+        }
+
+    def accepts_opcode(self, name: str) -> bool:
+        return name.strip().lower() in self.core_ir_opcodes
+
+    def verify_signature(
+        self,
+        left_type: CoreType,
+        right_type: CoreType,
+        output_type: CoreType
+    ) -> Mapping[str, Any]:
+        """Verify the matmul operand/result predicates.
+
+        Returns a JSON-safe description of the accepted shapes/dtype.  Any
+        violation raises :class:`OpContractError` with a structured field.
+        """
+
+        dtype, left_shape = self._tensor_info(left_type, "left")
+        right_dtype, right_shape = self._tensor_info(right_type, "right")
+        output_dtype, output_shape = self._tensor_info(output_type, "output")
+        domain = set(self.inputs[0].dtypes)
+        for label, value in (("left", dtype), ("right", right_dtype), ("output", output_dtype)):
+            if value not in domain:
+                raise OpContractError(
+                    "matmul dtype {!r} is outside the contract domain".format(value),
+                    field="dtype",
+                    requested=value,
+                    available=sorted(domain),
+                    reason="dtype_outside_contract_domain",
+                )
+        if dtype != right_dtype or dtype != output_dtype:
+            raise OpContractError(
+                "matmul requires dtype(left) == dtype(right) == dtype(output)",
+                field="dtype",
+                requested={"left": dtype, "right": right_dtype, "output": output_dtype},
+                reason="dtype_mismatch",
+            )
+        if len(left_shape) != len(right_shape) or len(left_shape) != len(output_shape):
+            raise OpContractError(
+                "matmul requires equal input/output ranks",
+                field="shape.rank",
+                requested={
+                    "left": len(left_shape),
+                    "right": len(right_shape),
+                    "output": len(output_shape),
+                },
+                reason="rank_mismatch",
+            )
+        rank = len(left_shape)
+        if rank < _MATMUL_RANK_MIN or rank > _MATMUL_RANK_MAX:
+            raise OpContractError(
+                "matmul supports rank 2 through 4",
+                field="shape.rank",
+                requested=rank,
+                available=[_MATMUL_RANK_MIN, _MATMUL_RANK_MAX],
+                reason="rank_out_of_range",
+            )
+        if left_shape[:-2] != right_shape[:-2]:
+            raise OpContractError(
+                "matmul requires identical batch prefixes",
+                field="shape.batch",
+                requested={"left": list(left_shape[:-2]), "right": list(right_shape[:-2])},
+                reason="batch_prefix_mismatch",
+            )
+        batch = left_shape[:-2]
+        m, k = left_shape[-2:]
+        right_k, n = right_shape[-2:]
+        expected = batch + (m, n)
+        if right_k != k or output_shape != expected:
+            raise OpContractError(
+                "matmul shapes {} x {} cannot produce {}".format(left_shape, right_shape, output_shape),
+                field="shape",
+                requested={
+                    "left": list(left_shape),
+                    "right": list(right_shape),
+                    "output": list(output_shape),
+                },
+                available={"k(a)": k, "k(b)": right_k, "expected_output": list(expected)},
+                reason="shape_rule_violation",
+            )
+        return {
+            "dtype": dtype,
+            "left_shape": list(left_shape),
+            "right_shape": list(right_shape),
+            "output_shape": list(output_shape),
+            "batch_shape": list(batch),
+            "m": m,
+            "k": k,
+            "n": n,
+        }
+
+    def verify_operation(self, operation: Operation) -> Mapping[str, Any]:
+        """Verify one Core IR ``matmul`` operation against this definition."""
+
+        if not isinstance(operation, Operation):
+            raise OpContractError(
+                "OpDefinition.verify_operation requires a Core IR Operation",
+                field="operation",
+                requested=type(operation).__name__,
+            )
+        try:
+            canonical = canonical_operation_name(operation.name)
+        except CpuScalarUnsupportedError as exc:
+            raise OpContractError(
+                "unknown or unregistered Core IR opcode {!r}".format(operation.name),
+                field="operation.name",
+                requested=operation.name,
+                available=sorted(self.core_ir_opcodes),
+                reason="opcode_not_registered",
+            ) from exc
+        if canonical != self.canonical_opcode:
+            raise OpContractError(
+                "Core IR opcode {!r} is not the {} contract".format(operation.name, self.canonical_opcode),
+                field="operation.name",
+                requested=operation.name,
+                available=sorted(self.core_ir_opcodes),
+                reason="opcode_not_registered",
+            )
+        if operation.effect is not Effect.PURE:
+            raise OpContractError(
+                "matmul contract requires a pure effect",
+                field="operation.effect",
+                requested=operation.effect.value,
+                available=[Effect.PURE.value],
+                reason="effect_not_pure",
+            )
+        if operation.regions:
+            raise OpContractError(
+                "matmul contract does not allow child regions",
+                field="operation.regions",
+                requested=len(operation.regions),
+                available=0,
+                reason="regions_not_allowed",
+            )
+        if len(operation.inputs) != 2 or len(operation.outputs) != 1:
+            raise OpContractError(
+                "matmul requires exactly 2 inputs and 1 output",
+                field="operation.arity",
+                requested={"inputs": len(operation.inputs), "outputs": len(operation.outputs)},
+                available={"inputs": 2, "outputs": 1},
+                reason="arity_mismatch",
+            )
+        unknown = sorted(set(operation.attributes) - set(self.attribute_names))
+        if unknown:
+            raise OpContractError(
+                "matmul does not accept unknown attributes: {}".format(", ".join(unknown)),
+                field="operation.attributes",
+                requested=unknown,
+                available=sorted(self.attribute_names),
+                reason="unknown_attribute",
+            )
+        for name in self.attribute_names:
+            value = operation.attributes.get(name)
+            if value is not None and value is not False:
+                raise OpContractError(
+                    "matmul attribute {}={!r} is outside the U1 contract".format(name, value),
+                    field="operation.attributes." + name,
+                    requested=value,
+                    available=[False, None],
+                    reason="attribute_not_supported",
+                )
+        return self.verify_signature(
+            operation.inputs[0].type,
+            operation.inputs[1].type,
+            operation.outputs[0].type,
+        )
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "registry_schema_version": OP_REGISTRY_SCHEMA_VERSION,
+            "canonical_opcode": self.canonical_opcode,
+            "contract_version": self.contract_version,
+            "contract_digest": self.contract_digest,
+            "core_ir_opcodes": list(self.core_ir_opcodes),
+            "inputs": [item.to_dict() for item in self.inputs],
+            "outputs": [item.to_dict() for item in self.outputs],
+            "numeric_contract": mapping_copy(self.numeric_contract),
+            "portable_reference": mapping_copy(self.portable_reference),
+            "allowed_providers": list(self.allowed_providers),
+            "attributes": list(self.attribute_names),
+        }
+
+    # -- helpers ---------------------------------------------------------
+    def _tensor_info(self, value_type: CoreType, label: str) -> Tuple[str, Tuple[int, ...]]:
+        if not isinstance(value_type, CoreType):
+            raise OpContractError(
+                "matmul {} must be a CoreType".format(label),
+                field="shape." + label,
+                requested=type(value_type).__name__,
+                reason="operand_not_core_type",
+            )
+        if value_type.kind != "tensor":
+            raise OpContractError(
+                "matmul {} must be a tensor".format(label),
+                field="kind." + label,
+                requested=value_type.kind,
+                available=["tensor"],
+                reason="operand_not_tensor",
+            )
+        dtype = canonical_dtype(value_type.dtype)
+        dims = []
+        for index, dimension in enumerate(value_type.shape):
+            if isinstance(dimension, bool) or not isinstance(dimension, int):
+                raise OpContractError(
+                    "matmul {} shape[{}] is not a static integer dimension".format(label, index),
+                    field="shape.{}.{}".format(label, index),
+                    requested=dimension,
+                    reason="symbolic_shape_not_supported_by_u1_contract",
+                )
+            if dimension < 0:
+                raise OpContractError(
+                    "matmul {} shape[{}] must be non-negative".format(label, index),
+                    field="shape.{}.{}".format(label, index),
+                    requested=dimension,
+                    reason="negative_dimension",
+                )
+            dims.append(dimension)
+        return dtype, tuple(dims)
+
+
+def _matmul_dtype_domain() -> Tuple[str, ...]:
+    names = set()
+    for dtype in SUPPORTED_DTYPES:
+        canonical = canonical_dtype(dtype)
+        if canonical != "bool":
+            names.add(canonical)
+    return tuple(sorted(names))
+
+
+def _matmul_core_ir_opcodes() -> Tuple[str, ...]:
+    names = [name for name, canonical in OP_ALIASES.items() if canonical == MATMUL_CANONICAL_OPCODE]
+    if MATMUL_CANONICAL_OPCODE not in names:
+        raise OpContractError(
+            "Core IR alias table does not contain the canonical matmul opcode",
+            field="core_ir_opcodes",
+            reason="core_ir_registry_drift",
+        )
+    return tuple(sorted(names))
+
+
+def _build_matmul_definition() -> OpDefinition:
+    dtypes = _matmul_dtype_domain()
+    inputs = (
+        OperandSpec("a", "input", dtypes, _MATMUL_RANK_MIN, _MATMUL_RANK_MAX),
+        OperandSpec("b", "input", dtypes, _MATMUL_RANK_MIN, _MATMUL_RANK_MAX),
+    )
+    outputs = (
+        OperandSpec("c", "output", dtypes, _MATMUL_RANK_MIN, _MATMUL_RANK_MAX),
+    )
+    return OpDefinition(
+        canonical_opcode=MATMUL_CANONICAL_OPCODE,
+        contract_version=MATMUL_CONTRACT_VERSION,
+        core_ir_opcodes=_matmul_core_ir_opcodes(),
+        inputs=inputs,
+        outputs=outputs,
+        numeric_contract=_NUMERIC_CONTRACT,
+        portable_reference=_PORTABLE_REFERENCE,
+        allowed_providers=("portable",),
+        attribute_names=_MATMUL_ATTRIBUTE_NAMES,
+    )
+
+
+OP_DEFINITIONS = {MATMUL_CANONICAL_OPCODE: _build_matmul_definition()}
+
+
+def lookup_canonical_opcode(name: str) -> str:
+    """Map a Core IR opcode spelling onto its canonical registration."""
+
+    if not isinstance(name, str) or not name.strip():
+        raise OpContractError(
+            "opcode must be a non-empty string",
+            field="opcode",
+            requested=name,
+            reason="invalid_opcode",
+        )
+    try:
+        canonical = canonical_operation_name(name)
+    except CpuScalarUnsupportedError as exc:
+        raise OpContractError(
+            "unknown Core IR opcode {!r}".format(name),
+            field="opcode",
+            requested=name,
+            available=sorted(_registered_alias_union()),
+            reason="opcode_not_registered",
+        ) from exc
+    return canonical
+
+
+def get_op_definition(name: str) -> OpDefinition:
+    """Return the definition for an opcode spelling or fail closed."""
+
+    canonical = lookup_canonical_opcode(name)
+    definition = OP_DEFINITIONS.get(canonical)
+    if definition is None:
+        raise OpContractError(
+            "opcode {!r} has no registered OpDefinition in the U1 registry".format(canonical),
+            field="opcode",
+            requested=canonical,
+            available=sorted(OP_DEFINITIONS),
+            reason="opcode_not_registered",
+        )
+    return definition
+
+
+def registered_opcodes() -> Tuple[str, ...]:
+    return tuple(sorted(OP_DEFINITIONS))
+
+
+def all_definition_aliases() -> Mapping[str, Tuple[str, ...]]:
+    return {opcode: definition.core_ir_opcodes for opcode, definition in sorted(OP_DEFINITIONS.items())}
+
+
+def _registered_alias_union() -> Tuple[str, ...]:
+    names = set()
+    for definition in OP_DEFINITIONS.values():
+        names.update(definition.core_ir_opcodes)
+    return tuple(sorted(names))
+
+
+__all__ = [
+    "MATMUL_CANONICAL_OPCODE",
+    "MATMUL_CONTRACT_VERSION",
+    "OP_DEFINITIONS",
+    "OP_REGISTRY_SCHEMA_VERSION",
+    "PORTABLE_REFERENCE_ID",
+    "OpDefinition",
+    "OperandSpec",
+    "all_definition_aliases",
+    "get_op_definition",
+    "lookup_canonical_opcode",
+    "registered_opcodes",
+]
