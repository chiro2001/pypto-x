+def test_report_schema_rejects_missing_fields():
+    left = _tensor("float32", (2, 3), seed=1)
+    right = _tensor("float32", (3, 4), seed=2)
+    _, report = execute_matmul(left, right)
+    document = report.to_dict()
+    assert validate_report_schema(document) is document
+    assert report.to_dict()["schema_version"] == 1
+
+    for path in (
+        "request",
+        "resolved",
+        "guarantees",
+        "resolution",
+        "artifact",
+        "timing",
+        "gates",
+        "capability",
+        "dispatch",
+        "policy_applicability",
+        "layout_decision",
+        "resources",
+        "coverage",
+        "timing.op_seconds",
+        "resolved.provider",
+        "guarantees.numeric_class",
+        "resolution.plan_digest",
+        "policy_applicability.status",
+        "layout_decision.resolved_view_mode",
+        "resources.parallelism.worker_count",
+        "coverage.logical_operation_counts",
+    ):
+        broken = json.loads(json.dumps(document))
+        cursor = broken
+        parts = path.split(".")
+        for part in parts[:-1]:
+            cursor = cursor[part]
+        del cursor[parts[-1]]
+        _assert_failure(REPORT_SCHEMA_INVALID, lambda broken=broken: validate_report_schema(broken))
+        with pytest.raises(ExecutionError) as excinfo:
+            ExecutionReport(broken)
+        assert excinfo.value.code == REPORT_SCHEMA_INVALID
