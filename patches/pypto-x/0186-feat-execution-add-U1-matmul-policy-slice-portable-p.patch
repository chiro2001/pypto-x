@@ -0,0 +1,304 @@
+"""Immutable, digestible ``ExecutionPlan`` for the U1 matmul slice.
+
+A plan is the compiler-time decision record.  Once produced by the resolver it
+is frozen: execution validates and obeys it, and never re-selects a provider.
+The digest covers every field that influences execution (contract digest,
+policy digest, capability digest, target, request shape/dtype, selected
+provider and numeric guarantee, fallback chain, artifact version triple), so
+tampering with a plan -- including the selected provider -- is detected
+before anything runs.
+
+The schema is versioned with ``plan_schema_version``; ``to_dict`` emits the
+digest under ``plan_digest`` and :meth:`ExecutionPlan.from_dict` verifies it.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Tuple
+
+from pypto.target._utils import canonical_json, frozen_mapping, mapping_copy, sha256_text
+
+from .errors import ArtifactMismatchError
+
+
+PLAN_SCHEMA_VERSION = 1
+
+# Fixed, explainable tie-break for the rule-based resolver (no cost model):
+# stronger numeric guarantee wins, then determinism, then the trunk-oriented
+# provider rank, then provider id lexical order.
+PLAN_TIE_BREAK = (
+    "numeric_guarantee_strength_desc",
+    "deterministic_desc",
+    "provider_rank_asc",
+    "provider_id_lexicographic",
+)
+
+_REQUIRED_PATHS = (
+    "plan_schema_version",
+    "contract.opcode",
+    "contract.version",
+    "contract.digest",
+    "request.op",
+    "request.left_shape",
+    "request.right_shape",
+    "request.output_shape",
+    "request.dtype",
+    "request.policy_digest",
+    "target.kind",
+    "target.triple",
+    "target.capability_digest",
+    "policy.requested",
+    "policy.resolved",
+    "policy_applicability.status",
+    "policy_applicability.rejected_fields",
+    "layout_decision.requested_view_mode",
+    "layout_decision.resolved_view_mode",
+    "layout_decision.alias_proof_digest",
+    "layout_decision.layout_copy_bytes",
+    "layout_decision.transfer_bytes",
+    "selected.provider",
+    "selected.provider_version",
+    "selected.implementation",
+    "selected.numeric_class",
+    "selected.deterministic",
+    "numeric_guarantee.class",
+    "numeric_guarantee.deterministic",
+    "numeric_guarantee.reduction_order_id",
+    "numeric_guarantee.exactness_basis",
+    "artifact.contract_version",
+    "artifact.lowering_version",
+    "artifact.runner_version",
+    "artifact.wire_version",
+    "artifact.provider_version",
+    "candidates",
+    "fallback.mode",
+    "fallback.chain",
+    "fallback.events",
+    "fallback.degraded",
+    "resolution.rules",
+    "resolution.tie_break",
+)
+
+
+def _walk(data: Mapping[str, Any], path: str) -> Any:
+    current = data
+    for part in path.split("."):
+        try:
+            current = current[part]
+        except (KeyError, TypeError):
+            raise ArtifactMismatchError(
+                "execution plan is missing required field {!r}".format(path),
+                field="plan." + path,
+                requested=None,
+                reason="plan_field_missing",
+            )
+    return current
+
+
+@dataclass(frozen=True, init=False)
+class ExecutionPlan:
+    """Frozen resolution result; runtime only validates, never re-selects."""
+
+    _payload: Mapping[str, Any]
+    digest: str
+
+    def __init__(self, payload: Mapping[str, Any]) -> None:
+        if not isinstance(payload, Mapping):
+            raise ArtifactMismatchError(
+                "execution plan payload must be a mapping",
+                field="plan",
+                requested=type(payload).__name__,
+                reason="plan_payload_not_a_mapping",
+            )
+        try:
+            canonical_json(payload)
+        except (TypeError, ValueError) as exc:
+            raise ArtifactMismatchError(
+                "execution plan payload is not canonical JSON data: {}".format(exc),
+                field="plan",
+                requested=None,
+                reason="plan_payload_not_serializable",
+            ) from exc
+        digest = "sha256:" + sha256_text(payload)
+        object.__setattr__(self, "_payload", frozen_mapping(payload))
+        object.__setattr__(self, "digest", digest)
+
+    # -- schema / tamper validation -------------------------------------
+    def validate(self) -> "ExecutionPlan":
+        recomputed = "sha256:" + sha256_text(mapping_copy(self._payload))
+        if recomputed != self.digest:
+            raise ArtifactMismatchError(
+                "execution plan digest does not match its content",
+                field="plan.plan_digest",
+                requested=self.digest,
+                available=recomputed,
+                reason="plan_tampered_or_corrupted",
+            )
+        data = mapping_copy(self._payload)
+        schema_version = _walk(data, "plan_schema_version")
+        if schema_version != PLAN_SCHEMA_VERSION:
+            raise ArtifactMismatchError(
+                "unsupported execution plan schema version",
+                field="plan.plan_schema_version",
+                requested=schema_version,
+                available=PLAN_SCHEMA_VERSION,
+                reason="plan_schema_version_mismatch",
+            )
+        for path in _REQUIRED_PATHS:
+            _walk(data, path)
+        if not isinstance(data["candidates"], list) or not data["candidates"]:
+            raise ArtifactMismatchError(
+                "execution plan must carry at least one candidate",
+                field="plan.candidates",
+                requested=data.get("candidates"),
+                reason="plan_candidates_missing",
+            )
+        if not isinstance(data["fallback"]["chain"], list) or not data["fallback"]["chain"]:
+            raise ArtifactMismatchError(
+                "execution plan fallback chain must not be empty",
+                field="plan.fallback.chain",
+                requested=data["fallback"].get("chain"),
+                reason="plan_fallback_chain_missing",
+            )
+        return self
+
+    # -- accessors ------------------------------------------------------
+    @property
+    def payload(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload)
+
+    @property
+    def selected(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload["selected"])
+
+    @property
+    def selected_provider(self) -> str:
+        return str(self._payload["selected"]["provider"])
+
+    @property
+    def request(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload["request"])
+
+    @property
+    def opcode(self) -> str:
+        return str(self._payload["request"]["op"])
+
+    @property
+    def left_shape(self) -> Tuple[int, ...]:
+        return tuple(self._payload["request"]["left_shape"])
+
+    @property
+    def right_shape(self) -> Tuple[int, ...]:
+        return tuple(self._payload["request"]["right_shape"])
+
+    @property
+    def output_shape(self) -> Tuple[int, ...]:
+        return tuple(self._payload["request"]["output_shape"])
+
+    @property
+    def dtype(self) -> str:
+        return str(self._payload["request"]["dtype"])
+
+    @property
+    def policy_digest(self) -> str:
+        return str(self._payload["request"]["policy_digest"])
+
+    @property
+    def capability_digest(self) -> str:
+        return str(self._payload["target"]["capability_digest"])
+
+    @property
+    def contract_digest(self) -> str:
+        return str(self._payload["contract"]["digest"])
+
+    @property
+    def numeric_guarantee(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload["numeric_guarantee"])
+
+    @property
+    def artifact_versions(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload["artifact"])
+
+    # -- serialization --------------------------------------------------
+    def to_dict(self) -> Mapping[str, Any]:
+        self.validate()
+        document = mapping_copy(self._payload)
+        document["plan_digest"] = self.digest
+        return document
+
+    def to_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "ExecutionPlan":
+        if not isinstance(value, Mapping):
+            raise ArtifactMismatchError(
+                "execution plan document must be a mapping",
+                field="plan",
+                requested=type(value).__name__,
+                reason="plan_payload_not_a_mapping",
+            )
+        payload = dict(value)
+        digest = payload.pop("plan_digest", None)
+        plan = cls(payload)
+        if digest is None:
+            raise ArtifactMismatchError(
+                "execution plan document is missing plan_digest",
+                field="plan.plan_digest",
+                requested=None,
+                available=plan.digest,
+                reason="plan_digest_missing",
+            )
+        if digest != plan.digest:
+            raise ArtifactMismatchError(
+                "execution plan digest mismatch (tampered or stale plan)",
+                field="plan.plan_digest",
+                requested=digest,
+                available=plan.digest,
+                reason="plan_digest_mismatch",
+            )
+        plan.validate()
+        return plan
+
+
+def build_plan_payload(
+    *,
+    contract: Mapping[str, Any],
+    request: Mapping[str, Any],
+    target: Mapping[str, Any],
+    policy: Mapping[str, Any],
+    policy_applicability: Mapping[str, Any],
+    layout_decision: Mapping[str, Any],
+    selected: Mapping[str, Any],
+    numeric_guarantee: Mapping[str, Any],
+    artifact: Mapping[str, Any],
+    candidates: Any,
+    fallback: Mapping[str, Any],
+    resolution: Mapping[str, Any]
+) -> Mapping[str, Any]:
+    """Assemble the canonical plan document (without the digest field)."""
+
+    return {
+        "plan_schema_version": PLAN_SCHEMA_VERSION,
+        "contract": dict(contract),
+        "request": dict(request),
+        "target": dict(target),
+        "policy": dict(policy),
+        "policy_applicability": dict(policy_applicability),
+        "layout_decision": dict(layout_decision),
+        "selected": dict(selected),
+        "numeric_guarantee": dict(numeric_guarantee),
+        "artifact": dict(artifact),
+        "candidates": list(candidates),
+        "fallback": dict(fallback),
+        "resolution": dict(resolution),
+    }
+
+
+__all__ = [
+    "PLAN_SCHEMA_VERSION",
+    "PLAN_TIE_BREAK",
+    "ExecutionPlan",
+    "build_plan_payload",
+]
diff --git a/python/pypto/execution/policy.py b/python/pypto/execution/policy.py
new file mode 100644
index 000000000..6b2c072dd
--- /dev/null
+++ b/python/pypto/execution/policy.py
@@ -0,0 +1,445 @@
+"""Versioned ``ExecutionPolicy`` for the U1 matmul slice.
+
+The frozen minimal field set from the kickoff document
+(``docs/20-planning/0008-...`` section 3) is::
+
+    profile, target, provider.mode, numeric.requirement,
+    deterministic, fallback.mode, resources.max_threads
+
+``provider.required`` is additionally required to express
+``provider.mode=required`` (the unknown-provider acceptance case).
+
+Every field that exists in the wider 0006 schema but is *not* applicable to
+this slice (tuning profile, error budget, provider allow/deny, placement,
+layout, optimization, observability, ...) is rejected with
+``POLICY_FIELD_NOT_APPLICABLE``; truly unknown keywords are rejected with
+``POLICY_UNKNOWN_FIELD``.  Nothing is silently ignored.
+
+``deterministic`` is canonical at the top level; ``NumericPolicy`` also
+accepts it as an input alias for the 0006 section 4.1 example style.  The
+canonical digest only ever contains the top-level field.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Tuple
+
+from pypto.target._utils import sha256_text
+
+from .errors import (
+    PolicyConflictError,
+    PolicyFieldNotApplicableError,
+    PolicyInvalidValueError,
+    PolicyUnknownFieldError,
+)
+
+
+POLICY_SCHEMA_VERSION = 1
+
+PROFILES = ("portable", "auto_static", "frozen_tuning")
+PROVIDER_MODES = ("portable", "vendor", "auto", "required")
+NUMERIC_REQUIREMENTS = ("portable", "deterministic", "bounded")
+FALLBACK_MODES = ("deny", "portable_only", "declared")
+KNOWN_TARGET_KINDS = ("cpu", "cuda", "hip", "ascend", "gpu")
+
+_AUTO = "auto"
+_MAX_THREADS = "auto"
+
+
+def _reject_extra(policy_name: str, prefix: str, extra: Mapping[str, Any], not_applicable: Tuple[str, ...]) -> None:
+    for name in sorted(extra):
+        field = "{}.{}".format(prefix, name) if prefix else name
+        if name in not_applicable:
+            raise PolicyFieldNotApplicableError(
+                "{} field {!r} is not applicable to the U1 matmul slice".format(policy_name, field),
+                field=field,
+                requested=extra[name],
+                available=[],
+                reason="field_not_applicable_in_u1_slice",
+                suggested_policy="remove the field; the U1 policy schema has no such knob",
+            )
+        raise PolicyUnknownFieldError(
+            "{} has no field {!r}".format(policy_name, field),
+            field=field,
+            requested=extra[name],
+            available=_field_names(policy_name),
+            reason="unknown_policy_field",
+        )
+
+
+def _field_names(policy_name: str) -> Tuple[str, ...]:
+    return {
+        "ExecutionPolicy": (
+            "profile",
+            "target",
+            "provider",
+            "numeric",
+            "deterministic",
+            "fallback",
+            "resources",
+        ),
+        "ProviderPolicy": ("mode", "required"),
+        "NumericPolicy": ("requirement",),
+        "FallbackPolicy": ("mode",),
+        "ResourcePolicy": ("max_threads",),
+    }.get(policy_name, ())
+
+
+def _require_string(value: Any, field: str, allowed: Tuple[str, ...]) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise PolicyInvalidValueError(
+            "{} must be a non-empty string".format(field),
+            field=field,
+            requested=value,
+            available=list(allowed),
+            reason="not_a_string",
+        )
+    normalized = value.strip().lower()
+    if normalized not in allowed:
+        raise PolicyInvalidValueError(
+            "{}={!r} is not a recognized value".format(field, value),
+            field=field,
+            requested=value,
+            available=list(allowed),
+            reason="value_out_of_domain",
+        )
+    return normalized
+
+
+def _normalize_target(value: Any) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise PolicyInvalidValueError(
+            "target must be a non-empty string",
+            field="target",
+            requested=value,
+            available=["auto"] + list(KNOWN_TARGET_KINDS) + ["<arch>-<vendor>-<os>"],
+            reason="not_a_string",
+        )
+    normalized = value.strip().lower()
+    if normalized in ("auto", "host"):
+        return "auto"
+    if normalized in KNOWN_TARGET_KINDS:
+        return normalized
+    parts = normalized.split("-")
+    if len(parts) >= 2 and all(part and all(ch.isalnum() or ch in "._" for ch in part) for part in parts):
+        return normalized
+    raise PolicyInvalidValueError(
+        "target={!r} is neither auto, a known kind, nor a target triple".format(value),
+        field="target",
+        requested=value,
+        available=["auto"] + list(KNOWN_TARGET_KINDS) + ["<arch>-<vendor>-<os>"],
+        reason="value_out_of_domain",
+    )
+
+
+@dataclass(frozen=True, init=False)
+class ProviderPolicy:
+    """Provider intent; only ``mode`` and the ``required`` pin are in U1."""
+
+    mode: str
+    required: Optional[str]
+
+    def __init__(self, mode: str = "portable", required: Optional[str] = None, **extra: Any) -> None:
+        _reject_extra(
+            "ProviderPolicy",
+            "provider",
+            extra,
+            ("version", "allow", "deny"),
+        )
+        normalized_mode = _require_string(mode, "provider.mode", PROVIDER_MODES)
+        if required is not None:
+            if not isinstance(required, str) or not required.strip():
+                raise PolicyInvalidValueError(
+                    "provider.required must be a non-empty string or None",
+                    field="provider.required",
+                    requested=required,
+                    reason="not_a_string",
+                )
+            required = required.strip()
+        if normalized_mode == "required" and required is None:
+            raise PolicyInvalidValueError(
+                "provider.mode=required needs provider.required",
+                field="provider.required",
+                requested=None,
+                available=["provider id"],
+                reason="missing_required_provider",
+            )
+        if normalized_mode != "required" and required is not None:
+            raise PolicyConflictError(
+                "provider.required is only valid with provider.mode=required",
+                field="provider.required",
+                requested=required,
+                available={"mode": "required"},
+                reason="required_without_required_mode",
+            )
+        object.__setattr__(self, "mode", normalized_mode)
+        object.__setattr__(self, "required", required)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"mode": self.mode, "required": self.required}
+
+
+@dataclass(frozen=True, init=False)
+class NumericPolicy:
+    """Numeric intent; only ``requirement`` is applicable in U1."""
+
+    requirement: str
+    deterministic: Optional[bool]
+
+    def __init__(
+        self,
+        requirement: str = "portable",
+        deterministic: Optional[bool] = None,
+        **extra: Any
+    ) -> None:
+        _reject_extra(
+            "NumericPolicy",
+            "numeric",
+            extra,
+            ("error_budget",),
+        )
+        normalized = _require_string(requirement, "numeric.requirement", NUMERIC_REQUIREMENTS)
+        if deterministic is not None and not isinstance(deterministic, bool):
+            raise PolicyInvalidValueError(
+                "numeric.deterministic must be a bool",
+                field="numeric.deterministic",
+                requested=deterministic,
+                reason="not_a_bool",
+            )
+        object.__setattr__(self, "requirement", normalized)
+        object.__setattr__(self, "deterministic", deterministic)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"requirement": self.requirement}
+
+
+@dataclass(frozen=True, init=False)
+class FallbackPolicy:
+    """Fallback intent; U1 only supports deny / portable_only."""
+
+    mode: str
+
+    def __init__(self, mode: str = "deny", **extra: Any) -> None:
+        _reject_extra(
+            "FallbackPolicy",
+            "fallback",
+            extra,
+            ("max_steps", "allow_numeric_downgrade"),
+        )
+        object.__setattr__(self, "mode", _require_string(mode, "fallback.mode", FALLBACK_MODES))
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"mode": self.mode}
+
+
+@dataclass(frozen=True, init=False)
+class ResourcePolicy:
+    """Resource ceiling; U1 only implements ``max_threads``."""
+
+    max_threads: Any
+
+    def __init__(self, max_threads: Any = _MAX_THREADS, **extra: Any) -> None:
+        _reject_extra(
+            "ResourcePolicy",
+            "resources",
+            extra,
+            (
+                "max_workspace_bytes",
+                "max_memory_bytes",
+                "compile_time_budget_ms",
+                "power_cap_watts",
+                "frequency_policy",
+                "thermal_policy",
+            ),
+        )
+        if isinstance(max_threads, str):
+            if max_threads.strip().lower() != _MAX_THREADS:
+                raise PolicyInvalidValueError(
+                    "resources.max_threads must be 'auto' or a positive integer",
+                    field="resources.max_threads",
+                    requested=max_threads,
+                    available=[_MAX_THREADS, "positive integer"],
+                    reason="value_out_of_domain",
+                )
+            normalized = _MAX_THREADS
+        elif isinstance(max_threads, bool) or not isinstance(max_threads, int) or max_threads <= 0:
+            raise PolicyInvalidValueError(
+                "resources.max_threads must be 'auto' or a positive integer",
+                field="resources.max_threads",
+                requested=max_threads,
+                available=[_MAX_THREADS, "positive integer"],
+                reason="value_out_of_domain",
+            )
+        else:
+            normalized = max_threads
+        object.__setattr__(self, "max_threads", normalized)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {"max_threads": self.max_threads}
+
+
+@dataclass(frozen=True, init=False)
+class ExecutionPolicy:
+    """Immutable, digestible user intent for one execution request."""
+
+    profile: str
+    target: str
+    provider: ProviderPolicy
+    numeric: NumericPolicy
+    deterministic: bool
+    fallback: FallbackPolicy
+    resources: ResourcePolicy
+    schema_version: int
+    digest: str
+
+    def __init__(
+        self,
+        profile: str = "portable",
+        target: str = "auto",
+        provider: Any = None,
+        numeric: Any = None,
+        deterministic: Optional[bool] = None,
+        fallback: Any = None,
+        resources: Any = None,
+        schema_version: Any = POLICY_SCHEMA_VERSION,
+        **extra: Any
+    ) -> None:
+        _reject_extra(
+            "ExecutionPolicy",
+            "",
+            extra,
+            (
+                "tuning_profile",
+                "placement",
+                "layout",
+                "optimization",
+                "observability",
+                "view_mode",
+                "error_budget",
+                "graph_policy",
+                "region_policy",
+                "policy_schema_version",
+            ),
+        )
+        if isinstance(schema_version, bool) or schema_version != POLICY_SCHEMA_VERSION:
+            raise PolicyInvalidValueError(
+                "unsupported policy schema version",
+                field="schema_version",
+                requested=schema_version,
+                available=POLICY_SCHEMA_VERSION,
+                reason="policy_schema_version_mismatch",
+            )
+        provider_policy = _coerce_policy(ProviderPolicy, provider, "provider")
+        numeric_policy = _coerce_policy(NumericPolicy, numeric, "numeric")
+        fallback_policy = _coerce_policy(FallbackPolicy, fallback, "fallback")
+        resource_policy = _coerce_policy(ResourcePolicy, resources, "resources")
+
+        if deterministic is None:
+            resolved_deterministic = True if numeric_policy.deterministic is None else numeric_policy.deterministic
+        else:
+            if not isinstance(deterministic, bool):
+                raise PolicyInvalidValueError(
+                    "deterministic must be a bool",
+                    field="deterministic",
+                    requested=deterministic,
+                    reason="not_a_bool",
+                )
+            if numeric_policy.deterministic is not None and numeric_policy.deterministic != deterministic:
+                raise PolicyConflictError(
+                    "deterministic was given twice with different values",
+                    field="deterministic",
+                    requested=deterministic,
+                    available=numeric_policy.deterministic,
+                    reason="duplicate_field_conflict",
+                )
+            resolved_deterministic = deterministic
+
+        normalized_profile = _require_string(profile, "profile", PROFILES)
+        normalized_target = _normalize_target(target)
+        object.__setattr__(self, "profile", normalized_profile)
+        object.__setattr__(self, "target", normalized_target)
+        object.__setattr__(self, "provider", provider_policy)
+        object.__setattr__(self, "numeric", numeric_policy)
+        object.__setattr__(self, "deterministic", resolved_deterministic)
+        object.__setattr__(self, "fallback", fallback_policy)
+        object.__setattr__(self, "resources", resource_policy)
+        object.__setattr__(self, "schema_version", POLICY_SCHEMA_VERSION)
+        object.__setattr__(self, "digest", "sha256:" + sha256_text(self._digest_document()))
+
+    @classmethod
+    def portable(cls, **overrides: Any) -> "ExecutionPolicy":
+        """Convenience constructor for the cross-platform reference policy."""
+
+        base = {
+            "profile": "portable",
+            "target": "auto",
+            "provider": ProviderPolicy(mode="portable"),
+            "numeric": NumericPolicy(requirement="portable"),
+            "deterministic": True,
+            "fallback": FallbackPolicy(mode="deny"),
+            "resources": ResourcePolicy(max_threads="auto"),
+        }
+        base.update(overrides)
+        return cls(**base)
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "schema_version": self.schema_version,
+            "profile": self.profile,
+            "target": self.target,
+            "provider": self.provider.to_dict(),
+            "numeric": self.numeric.to_dict(),
+            "deterministic": self.deterministic,
+            "fallback": self.fallback.to_dict(),
+            "resources": self.resources.to_dict(),
+        }
+
+    def _digest_document(self) -> Mapping[str, Any]:
+        return self.to_dict()
+
+
+def _coerce_policy(policy_type: Any, value: Any, field: str) -> Any:
+    if value is None:
+        return policy_type()
+    if isinstance(value, policy_type):
+        return value
+    if isinstance(value, Mapping):
+        return policy_type(**{str(key): item for key, item in value.items()})
+    raise PolicyInvalidValueError(
+        "{} must be a {} or a mapping".format(field, policy_type.__name__),
+        field=field,
+        requested=type(value).__name__,
+        reason="not_a_policy_object",
+    )
+
+
+def policy_from_dict(data: Mapping[str, Any]) -> ExecutionPolicy:
+    """Rebuild a policy from its JSON form (fail-closed on unknown fields)."""
+
+    if not isinstance(data, Mapping):
+        raise PolicyInvalidValueError(
+            "policy document must be a mapping",
+            field="policy",
+            requested=type(data).__name__,
+            reason="not_a_mapping",
+        )
+    payload = dict(data)
+    payload.pop("schema_version", None)
+    return ExecutionPolicy(**payload)
+
+
+__all__ = [
+    "FALLBACK_MODES",
+    "KNOWN_TARGET_KINDS",
+    "NUMERIC_REQUIREMENTS",
+    "POLICY_SCHEMA_VERSION",
+    "PROFILES",
+    "PROVIDER_MODES",
+    "ExecutionPolicy",
+    "FallbackPolicy",
+    "NumericPolicy",
+    "ProviderPolicy",
+    "ResourcePolicy",
+    "policy_from_dict",
+]
diff --git a/python/pypto/execution/providers.py b/python/pypto/execution/providers.py
new file mode 100644
index 000000000..be1af6897
--- /dev/null
+++ b/python/pypto/execution/providers.py
@@ -0,0 +1,229 @@
+"""Portable provider binding for the U1 matmul slice.
+
+Only one provider exists in this slice: ``portable``.  It binds the
+``OpDefinition`` contract to the *existing* portable trunk
+(:class:`pypto.compiler.targets.cpu.CpuScalarCompiler` +
+:class:`pypto.backends.cpu.CpuScalarRuntime`) through the frozen
+``CompilerBackend`` / ``Artifact`` / ``LaunchRequest`` / ``RuntimeBackend``
+ABI.  Nothing here re-implements arithmetic or changes the trunk.
+
+Provider facts recorded in the plan (lowering/runner/wire versions) come from
+the existing lowering/artifact code; only ``runner_version`` is a new
+execution-layer binding version, and it is reported explicitly as such.
+"""
+
+from __future__ import annotations
+
+import time
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+from pypto.abi import LaunchRequest
+from pypto.backends.cpu import CpuScalarRuntime, HostTensor
+from pypto.compiler.targets.cpu import CpuScalarCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.target import TargetSpec
+
+from .capability import (
+    PORTABLE_PROVIDER_ID,
+    PORTABLE_PROVIDER_VERSION,
+    ProviderCapability,
+    portable_provider_capability,
+)
+from .errors import ArtifactMismatchError, OpContractError, ProviderUnavailableError
+from .op_registry import get_op_definition
+from .plan import ExecutionPlan
+
+
+PORTABLE_RUNNER_VERSION = 1
+PORTABLE_IMPLEMENTATION = "portable.cpu.scalar.matmul"
+
+
+@dataclass(frozen=True)
+class ProviderOutcome:
+    """Facts observed while executing one declared plan."""
+
+    output: Any
+    artifact_format: str
+    artifact_content_digest: str
+    abi_version: str
+    lowering_version: int
+    wire_version: int
+    op_seconds: float
+    threads_used: int
+    provider_version: str
+    implementation: str
+
+
+def build_matmul_program(
+    left_type: CoreType,
+    right_type: CoreType,
+    output_type: CoreType,
+    entrypoint: str = "matmul"
+) -> Any:
+    """Build the minimal Core IR program for one matmul."""
+
+    left = ValueRef("left", left_type)
+    right = ValueRef("right", right_type)
+    output = ValueRef("output", output_type)
+    operation = Operation("matmul", (left, right), (output,))
+    return CoreProgram(functions=(CoreFunction(entrypoint, (left, right), (output,), Region((operation,))),)), operation
+
+
+class PortableProvider:
+    """Bind a declared plan to the existing portable CPU scalar trunk."""
+
+    provider_id = PORTABLE_PROVIDER_ID
+    version = PORTABLE_PROVIDER_VERSION
+    implementation = PORTABLE_IMPLEMENTATION
+    runner_version = PORTABLE_RUNNER_VERSION
+
+    def capability(
+        self,
+        available: bool = True,
+        reason: Optional[str] = None
+    ) -> ProviderCapability:
+        return portable_provider_capability(available=available, reason=reason, version=self.version)
+
+    def verify_plan_binding(self, plan: ExecutionPlan) -> None:
+        """Enforce declaration-equals-execution before anything runs."""
+
+        plan.validate()
+        declared = plan.selected_provider
+        if declared != self.provider_id:
+            raise ArtifactMismatchError(
+                "plan declares provider {!r} but the executor invoked {!r}".format(declared, self.provider_id),
+                field="plan.selected.provider",
+                requested=declared,
+                available=self.provider_id,
+                reason="declared_provider_does_not_match_executor",
+            )
+
+    def execute(
+        self,
+        plan: ExecutionPlan,
+        left: HostTensor,
+        right: HostTensor,
+        output: HostTensor,
+        capability: Any
+    ) -> ProviderOutcome:
+        self.verify_plan_binding(plan)
+        definition = get_op_definition(plan.opcode)
+        _check_host_tensor(left, "left")
+        _check_host_tensor(right, "right")
+        _check_host_tensor(output, "output")
+        _check_plan_request(plan, left, right, output)
+        target = TargetSpec("cpu", capability.triple, features=capability.features)
+        program, operation = build_matmul_program(
+            CoreType.tensor(left.dtype, left.shape),
+            CoreType.tensor(right.dtype, right.shape),
+            CoreType.tensor(output.dtype, output.shape),
+        )
+        definition.verify_operation(operation)
+        compiler = CpuScalarCompiler()
+        artifact = compiler.compile(compiler.lower(program, target))
+        request = LaunchRequest(
+            artifact,
+            inputs=[left.descriptor(readonly=True), right.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+        started = time.perf_counter()
+        CpuScalarRuntime().launch(request)
+        op_seconds = time.perf_counter() - started
+        metadata = artifact.metadata
+        return ProviderOutcome(
+            output=output,
+            artifact_format=artifact.format,
+            artifact_content_digest="sha256:" + artifact.content_digest,
+            abi_version=artifact.abi_version,
+            lowering_version=int(metadata["lowering_version"]),
+            wire_version=int(metadata["artifact_payload_version"]),
+            op_seconds=op_seconds,
+            threads_used=1,
+            provider_version=self.version,
+            implementation=self.implementation,
+        )
+
+
+def _check_host_tensor(value: Any, label: str) -> None:
+    if not isinstance(value, HostTensor):
+        raise OpContractError(
+            "portable provider requires HostTensor {} operands".format(label),
+            field="operand." + label,
+            requested=type(value).__name__,
+            available=["HostTensor"],
+            reason="unsupported_operand_handle",
+        )
+
+
+def _check_plan_request(
+    plan: ExecutionPlan,
+    left: HostTensor,
+    right: HostTensor,
+    output: HostTensor
+) -> None:
+    mismatches = {}
+    if plan.opcode != "matmul":
+        mismatches["op"] = plan.opcode
+    if tuple(left.shape) != plan.left_shape:
+        mismatches["left_shape"] = list(left.shape)
+    if tuple(right.shape) != plan.right_shape:
+        mismatches["right_shape"] = list(right.shape)
+    if tuple(output.shape) != plan.output_shape:
+        mismatches["output_shape"] = list(output.shape)
+    if left.dtype != plan.dtype or right.dtype != plan.dtype or output.dtype != plan.dtype:
+        mismatches["dtype"] = {"left": left.dtype, "right": right.dtype, "output": output.dtype}
+    if mismatches:
+        raise ArtifactMismatchError(
+            "execution request does not match the frozen plan",
+            field="plan.request",
+            requested=mismatches,
+            available=plan.request,
+            reason="plan_request_mismatch",
+        )
+
+
+PROVIDERS = {
+    PORTABLE_PROVIDER_ID: PortableProvider(),
+}
+
+
+def get_provider(provider_id: str) -> PortableProvider:
+    """Look up a provider by the id declared in the plan; fail closed."""
+
+    if not isinstance(provider_id, str) or not provider_id.strip():
+        raise ProviderUnavailableError(
+            "provider id must be a non-empty string",
+            field="plan.selected.provider",
+            requested=provider_id,
+            available=sorted(PROVIDERS),
+            reason="invalid_provider_id",
+        )
+    provider = PROVIDERS.get(provider_id.strip())
+    if provider is None:
+        raise ProviderUnavailableError(
+            "provider {!r} is not registered in the U1 slice".format(provider_id),
+            field="plan.selected.provider",
+            requested=provider_id,
+            available=sorted(PROVIDERS),
+            reason="provider_not_registered",
+        )
+    return provider
+
+
+def registered_providers() -> Mapping[str, str]:
+    return {key: value.version for key, value in sorted(PROVIDERS.items())}
+
+
+__all__ = [
+    "PORTABLE_IMPLEMENTATION",
+    "PORTABLE_PROVIDER_ID",
+    "PORTABLE_PROVIDER_VERSION",
+    "PORTABLE_RUNNER_VERSION",
+    "PROVIDERS",
+    "PortableProvider",
+    "ProviderOutcome",
+    "build_matmul_program",
+    "get_provider",
+    "registered_providers",
+]
diff --git a/python/pypto/execution/report.py b/python/pypto/execution/report.py
new file mode 100644
index 000000000..c119a991b
--- /dev/null
+++ b/python/pypto/execution/report.py
@@ -0,0 +1,449 @@
+"""Versioned ``ExecutionReport`` and its fail-closed schema validator (U1).
+
+The report is JSON and must answer "what ran, why, and can it be
+reproduced": it carries the requested and resolved policy, the plan digest,
+the candidate/rule trace, provider and artifact fingerprints, the numeric
+guarantee, and a timing decomposition whose gate status is always
+``UNGATED`` on this host.
+
+:func:`validate_report_schema` is the single schema gate.  A report with a
+missing or malformed field is rejected (never silently completed), and any
+performance-claim key (speedup / acceleration / GFLOPS / ...) is rejected by
+the anti-claim check.  Schema is versioned by ``REPORT_SCHEMA_VERSION``.
+"""
+
+from __future__ import annotations
+
+import math
+import re
+from dataclasses import dataclass
+from typing import Any, Mapping, Tuple
+
+from pypto.target._utils import canonical_json, frozen_mapping, mapping_copy
+
+from .errors import ReportSchemaError
+
+
+REPORT_SCHEMA_VERSION = 1
+
+_CLAIM_KEY_PATTERN = re.compile(r"speedup|accelerat|gflops|tflops|perf_ratio|speed_up", re.IGNORECASE)
+
+_REQUIRED_FIELDS = (
+    ("schema_version", (int,)),
+    ("request", (Mapping,)),
+    ("request.op", (str,)),
+    ("request.left_shape", (list,)),
+    ("request.right_shape", (list,)),
+    ("request.output_shape", (list,)),
+    ("request.dtype", (str,)),
+    ("request.policy_digest", (str,)),
+    ("requested_policy", (Mapping,)),
+    ("resolved_policy", (Mapping,)),
+    ("policy_applicability", (Mapping,)),
+    ("policy_applicability.status", (str,)),
+    ("policy_applicability.rejected_fields", (list,)),
+    ("layout_decision", (Mapping,)),
+    ("layout_decision.requested_view_mode", (str,)),
+    ("layout_decision.resolved_view_mode", (str,)),
+    ("layout_decision.layout_copy_bytes", (int,)),
+    ("layout_decision.transfer_bytes", (int,)),
+    ("resolved", (Mapping,)),
+    ("resolved.target", (Mapping,)),
+    ("resolved.target.kind", (str,)),
+    ("resolved.target.triple", (str,)),
+    ("resolved.provider", (str,)),
+    ("resolved.provider_version", (str,)),
+    ("resolved.implementation", (str,)),
+    ("resolved.profile", (str,)),
+    ("resolved.contract", (Mapping,)),
+    ("resolved.contract.opcode", (str,)),
+    ("resolved.contract.version", (str,)),
+    ("resolved.contract.digest", (str,)),
+    ("guarantees", (Mapping,)),
+    ("guarantees.numeric_class", (str,)),
+    ("guarantees.precision_class", (str,)),
+    ("guarantees.scope", (str,)),
+    ("guarantees.basis", (str,)),
+    ("guarantees.deterministic", (bool,)),
+    ("guarantees.accumulation", (str,)),
+    ("guarantees.rounding", (str,)),
+    ("guarantees.reduction_order", (str,)),
+    ("guarantees.reduction_order_id", (str,)),
+    ("guarantees.exactness_basis", (str,)),
+    ("guarantees.reference", (str,)),
+    ("resolution", (Mapping,)),
+    ("resolution.plan_digest", (str,)),
+    ("resolution.policy_digest", (str,)),
+    ("resolution.capability_digest", (str,)),
+    ("resolution.contract_digest", (str,)),
+    ("resolution.candidates", (list,)),
+    ("resolution.fallback_chain", (list,)),
+    ("resolution.fallback_events", (list,)),
+    ("resolution.degraded", (bool,)),
+    ("resolution.rules", (list,)),
+    ("resolution.tie_break", (list,)),
+    ("resolution.why", (str,)),
+    ("artifact", (Mapping,)),
+    ("artifact.format", (str,)),
+    ("artifact.content_digest", (str,)),
+    ("artifact.contract_version", (str,)),
+    ("artifact.lowering_version", (int,)),
+    ("artifact.runner_version", (int,)),
+    ("artifact.wire_version", (int,)),
+    ("artifact.provider_version", (str,)),
+    ("artifact.abi_version", (str,)),
+    ("timing", (Mapping,)),
+    ("timing.dispatch_seconds", (int, float)),
+    ("timing.op_seconds", (int, float)),
+    ("timing.transfer_seconds", (int, float)),
+    ("timing.wall_seconds", (int, float)),
+    ("timing.timing_basis", (Mapping,)),
+    ("gates", (Mapping,)),
+    ("gates.performance_gated", (bool,)),
+    ("gates.status", (str,)),
+    ("gates.reason", (str,)),
+    ("capability", (Mapping,)),
+    ("capability.snapshot_digest", (str,)),
+    ("capability.kind", (str,)),
+    ("capability.triple", (str,)),
+    ("capability.features", (list,)),
+    ("dispatch", (Mapping,)),
+    ("dispatch.provider_declared", (str,)),
+    ("dispatch.provider_invoked", (str,)),
+    ("dispatch.declaration_match", (bool,)),
+    ("dispatch.threads_used", (int,)),
+    ("resources", (Mapping,)),
+    ("resources.parallelism", (Mapping,)),
+    ("resources.parallelism.worker_count", (int,)),
+    ("resources.parallelism.worker_index", (int,)),
+    ("resources.parallelism.intra_op_threads", (int,)),
+    ("resources.parallelism.oversubscription_policy", (str,)),
+    ("coverage", (Mapping,)),
+    ("coverage.logical_operation_counts", (list,)),
+    ("coverage.provider_invocation_counts", (list,)),
+    ("coverage.artifact_preparation_counts", (list,)),
+    ("coverage.epilogue_counts", (list,)),
+)
+
+_OPTIONAL_NULL_FIELDS = (
+    "guarantees.error_budget",
+    "timing.kernel_seconds",
+    "layout_decision.alias_proof_digest",
+    "resources.parallelism.cpu_affinity",
+)
+
+_COVERAGE_FIELDS = (
+    "coverage.logical_operation_counts",
+    "coverage.provider_invocation_counts",
+    "coverage.artifact_preparation_counts",
+    "coverage.epilogue_counts",
+)
+
+
+def _walk(data: Any, path: str) -> Any:
+    current = data
+    for part in path.split("."):
+        if not isinstance(current, Mapping) or part not in current:
+            raise ReportSchemaError(
+                "execution report is missing required field {!r}".format(path),
+                field="report." + path,
+                requested=None,
+                reason="report_field_missing",
+            )
+        current = current[part]
+    return current
+
+
+def _require(data: Mapping[str, Any], path: str, types: Tuple[Any, ...]) -> Any:
+    value = _walk(data, path)
+    if isinstance(value, bool) and bool not in types:
+        raise ReportSchemaError(
+            "execution report field {!r} has the wrong type".format(path),
+            field="report." + path,
+            requested=type(value).__name__,
+            available=[item.__name__ if hasattr(item, "__name__") else str(item) for item in types],
+            reason="report_field_wrong_type",
+        )
+    if not isinstance(value, types):
+        raise ReportSchemaError(
+            "execution report field {!r} has the wrong type".format(path),
+            field="report." + path,
+            requested=type(value).__name__,
+            available=[item.__name__ if hasattr(item, "__name__") else str(item) for item in types],
+            reason="report_field_wrong_type",
+        )
+    return value
+
+
+def _check_no_claim_keys(value: Any, path: str) -> None:
+    if isinstance(value, Mapping):
+        for key, item in value.items():
+            if _CLAIM_KEY_PATTERN.search(str(key)):
+                raise ReportSchemaError(
+                    "execution report must not contain performance-claim key {!r}".format(str(key)),
+                    field="report." + (path + "." + str(key) if path else str(key)),
+                    requested=key,
+                    reason="report_performance_claim_forbidden",
+                )
+            _check_no_claim_keys(item, path + "." + str(key) if path else str(key))
+    elif isinstance(value, (list, tuple)):
+        for index, item in enumerate(value):
+            _check_no_claim_keys(item, "{}[{}]".format(path, index))
+
+
+def validate_report_schema(report: Mapping[str, Any]) -> Mapping[str, Any]:
+    """Validate one report document; raise ``ReportSchemaError`` on any gap."""
+
+    if not isinstance(report, Mapping):
+        raise ReportSchemaError(
+            "execution report must be a mapping",
+            field="report",
+            requested=type(report).__name__,
+            reason="report_not_a_mapping",
+        )
+    for path, types in _REQUIRED_FIELDS:
+        _require(report, path, types)
+    for path in _OPTIONAL_NULL_FIELDS:
+        if "." in path:
+            parent_path, leaf = path.rsplit(".", 1)
+            parent = _walk(report, parent_path)
+            if not isinstance(parent, Mapping) or leaf not in parent:
+                raise ReportSchemaError(
+                    "execution report is missing required field {!r}".format(path),
+                    field="report." + path,
+                    requested=None,
+                    reason="report_field_missing",
+                )
+        else:
+            _walk(report, path)
+
+    if report["schema_version"] != REPORT_SCHEMA_VERSION:
+        raise ReportSchemaError(
+            "unsupported execution report schema version",
+            field="report.schema_version",
+            requested=report["schema_version"],
+            available=REPORT_SCHEMA_VERSION,
+            reason="report_schema_version_mismatch",
+        )
+    if report["resolved"]["provider"] != report["dispatch"]["provider_invoked"]:
+        raise ReportSchemaError(
+            "declared provider and invoked provider differ in the report",
+            field="report.dispatch.provider_invoked",
+            requested=report["dispatch"]["provider_invoked"],
+            available=report["resolved"]["provider"],
+            reason="declaration_execution_mismatch",
+        )
+    if report["dispatch"]["declaration_match"] is not True:
+        raise ReportSchemaError(
+            "report must record declaration_match=true",
+            field="report.dispatch.declaration_match",
+            requested=report["dispatch"]["declaration_match"],
+            reason="declaration_execution_mismatch",
+        )
+    applicability = report["policy_applicability"]
+    if applicability["status"] != "validated" or applicability["rejected_fields"]:
+        raise ReportSchemaError(
+            "a report can only carry a validated policy applicability block",
+            field="report.policy_applicability",
+            requested={
+                "status": applicability["status"],
+                "rejected_fields": applicability["rejected_fields"],
+            },
+            available={"status": "validated", "rejected_fields": []},
+            reason="policy_applicability_not_validated",
+        )
+    layout = report["layout_decision"]
+    if layout["requested_view_mode"] != "not_applicable" or layout["resolved_view_mode"] != "not_applicable":
+        raise ReportSchemaError(
+            "matmul does not make a view/materialization decision; view modes must be not_applicable",
+            field="report.layout_decision",
+            requested={
+                "requested_view_mode": layout["requested_view_mode"],
+                "resolved_view_mode": layout["resolved_view_mode"],
+            },
+            available={"requested_view_mode": "not_applicable", "resolved_view_mode": "not_applicable"},
+            reason="layout_decision_not_applicable_expected",
+        )
+    if layout["layout_copy_bytes"] < 0 or layout["transfer_bytes"] < 0:
+        raise ReportSchemaError(
+            "layout/transfer byte counts must be non-negative",
+            field="report.layout_decision",
+            requested={
+                "layout_copy_bytes": layout["layout_copy_bytes"],
+                "transfer_bytes": layout["transfer_bytes"],
+            },
+            reason="negative_layout_bytes",
+        )
+    parallelism = report["resources"]["parallelism"]
+    if parallelism["worker_count"] < 1 or parallelism["intra_op_threads"] < 1:
+        raise ReportSchemaError(
+            "parallelism counts must be positive",
+            field="report.resources.parallelism",
+            requested=parallelism,
+            reason="invalid_parallelism_counts",
+        )
+    if not 0 <= parallelism["worker_index"] < parallelism["worker_count"]:
+        raise ReportSchemaError(
+            "worker_index must be within worker_count",
+            field="report.resources.parallelism.worker_index",
+            requested={
+                "worker_index": parallelism["worker_index"],
+                "worker_count": parallelism["worker_count"],
+            },
+            reason="worker_index_out_of_range",
+        )
+    for path in _COVERAGE_FIELDS:
+        parent_path, leaf = path.rsplit(".", 1)
+        entries = _walk(report, parent_path)[leaf]
+        for index, entry in enumerate(entries):
+            if not isinstance(entry, Mapping):
+                raise ReportSchemaError(
+                    "coverage entries must be mappings",
+                    field="{}.{}[{}]".format("report." + parent_path, leaf, index),
+                    requested=type(entry).__name__,
+                    reason="coverage_entry_not_a_mapping",
+                )
+            if not isinstance(entry.get("count"), int) or entry.get("count") < 0:
+                raise ReportSchemaError(
+                    "coverage entries must carry a non-negative integer count",
+                    field="{}.{}[{}].count".format("report." + parent_path, leaf, index),
+                    requested=entry.get("count"),
+                    reason="coverage_count_invalid",
+                )
+            if not isinstance(entry.get("included_in_graph_total"), bool):
+                raise ReportSchemaError(
+                    "coverage entries must carry included_in_graph_total",
+                    field="{}.{}[{}].included_in_graph_total".format("report." + parent_path, leaf, index),
+                    requested=entry.get("included_in_graph_total"),
+                    reason="coverage_domain_flag_missing",
+                )
+            if "parent_opcode" not in entry:
+                raise ReportSchemaError(
+                    "coverage entries must carry parent_opcode (may be null)",
+                    field="{}.{}[{}].parent_opcode".format("report." + parent_path, leaf, index),
+                    requested=None,
+                    reason="coverage_parent_opcode_missing",
+                )
+    if not report["resolution"]["candidates"]:
+        raise ReportSchemaError(
+            "report must record the resolved candidate set",
+            field="report.resolution.candidates",
+            requested=report["resolution"]["candidates"],
+            reason="report_candidates_missing",
+        )
+    if not str(report["resolution"]["why"]).strip():
+        raise ReportSchemaError(
+            "report must explain why the provider was selected",
+            field="report.resolution.why",
+            requested=report["resolution"]["why"],
+            reason="report_why_missing",
+        )
+    if report["request"]["policy_digest"] != report["resolution"]["policy_digest"]:
+        raise ReportSchemaError(
+            "request policy digest and resolution policy digest differ",
+            field="report.resolution.policy_digest",
+            requested=report["resolution"]["policy_digest"],
+            available=report["request"]["policy_digest"],
+            reason="policy_digest_mismatch",
+        )
+    if not str(report["resolution"]["plan_digest"]).startswith("sha256:"):
+        raise ReportSchemaError(
+            "plan digest must be a sha256: string",
+            field="report.resolution.plan_digest",
+            requested=report["resolution"]["plan_digest"],
+            reason="plan_digest_not_sha256",
+        )
+    if not str(report["artifact"]["content_digest"]).startswith("sha256:"):
+        raise ReportSchemaError(
+            "artifact content digest must be a sha256: string",
+            field="report.artifact.content_digest",
+            requested=report["artifact"]["content_digest"],
+            reason="artifact_digest_not_sha256",
+        )
+    timing = report["timing"]
+    for name in ("dispatch_seconds", "op_seconds", "transfer_seconds", "wall_seconds"):
+        value = timing[name]
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(float(value)) or value < 0:
+            raise ReportSchemaError(
+                "timing field {!r} must be a finite non-negative number".format(name),
+                field="report.timing." + name,
+                requested=value,
+                reason="timing_not_finite",
+            )
+    if timing.get("kernel_seconds") is not None:
+        raise ReportSchemaError(
+            "kernel_seconds must be null on the portable CPU path",
+            field="report.timing.kernel_seconds",
+            requested=timing.get("kernel_seconds"),
+            reason="kernel_seconds_not_available",
+        )
+    if abs(float(timing["wall_seconds"]) - (float(timing["op_seconds"]) + float(timing["dispatch_seconds"]))) > 1e-6:
+        raise ReportSchemaError(
+            "timing decomposition must satisfy wall = op + dispatch",
+            field="report.timing",
+            requested={
+                "wall_seconds": timing["wall_seconds"],
+                "op_seconds": timing["op_seconds"],
+                "dispatch_seconds": timing["dispatch_seconds"],
+            },
+            reason="timing_decomposition_inconsistent",
+        )
+    gates = report["gates"]
+    if gates["performance_gated"] is not False or gates["status"] != "UNGATED":
+        raise ReportSchemaError(
+            "the local host report must stay UNGATED",
+            field="report.gates.status",
+            requested={"performance_gated": gates["performance_gated"], "status": gates["status"]},
+            available={"performance_gated": False, "status": "UNGATED"},
+            reason="ungated_violation",
+        )
+    if report["guarantees"]["numeric_class"] != report["guarantees"]["precision_class"]:
+        raise ReportSchemaError(
+            "precision_class must mirror numeric_class in the portable slice",
+            field="report.guarantees.precision_class",
+            requested=report["guarantees"]["precision_class"],
+            available=report["guarantees"]["numeric_class"],
+            reason="precision_class_mismatch",
+        )
+    _check_no_claim_keys(report, "")
+    return report
+
+
+@dataclass(frozen=True, init=False)
+class ExecutionReport:
+    """Immutable, schema-validated execution report."""
+
+    _payload: Mapping[str, Any]
+
+    def __init__(self, payload: Mapping[str, Any]) -> None:
+        validate_report_schema(payload)
+        object.__setattr__(self, "_payload", frozen_mapping(payload))
+
+    @property
+    def payload(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload)
+
+    @property
+    def plan_digest(self) -> str:
+        return str(self._payload["resolution"]["plan_digest"])
+
+    @property
+    def provider_invoked(self) -> str:
+        return str(self._payload["dispatch"]["provider_invoked"])
+
+    @property
+    def numeric_class(self) -> str:
+        return str(self._payload["guarantees"]["numeric_class"])
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return mapping_copy(self._payload)
+
+    def to_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+
+__all__ = [
+    "REPORT_SCHEMA_VERSION",
+    "ExecutionReport",
+    "validate_report_schema",
+]
diff --git a/python/pypto/execution/resolver.py b/python/pypto/execution/resolver.py
new file mode 100644
index 000000000..dc3658ffe
--- /dev/null
+++ b/python/pypto/execution/resolver.py
@@ -0,0 +1,708 @@
+"""Rule-based resolver for the U1 matmul slice (no cost model).
+
+Resolution is a deterministic intersection of:
+
+1. the ``OpDefinition`` contract predicates (opcode, rank/dtype/shape rules);
+2. the user ``ExecutionPolicy`` intent (profile, provider.mode,
+   numeric.requirement, deterministic, fallback.mode, max_threads);
+3. the ``CapabilitySnapshot`` facts (target kind/triple/features, provider
+   availability, provider contract digests).
+
+Candidates that survive all filters are ordered by the fixed tie-break in
+:data:`pypto.execution.plan.PLAN_TIE_BREAK`.  Every filter decision and the
+final ordering are recorded in the plan, so "why this provider" is
+explainable without a cost model.  Same ``(policy, capability digest, shape,
+dtype)`` therefore produces the same plan digest.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Sequence, Tuple
+
+from pypto.compiler.targets.cpu import ARTIFACT_PAYLOAD_VERSION
+from pypto.core_ir import CoreType
+from pypto.lowering.cpu import LOWERING_VERSION, canonical_dtype, CpuScalarValidationError
+from pypto.target._utils import mapping_copy
+
+from .capability import CapabilitySnapshot, ProviderCapability
+from .errors import (
+    ArtifactMismatchError,
+    CapabilityUnavailableError,
+    NumericGuaranteeUnmetError,
+    OpContractError,
+    PolicyConflictError,
+    PolicyFieldNotApplicableError,
+    PolicyInvalidValueError,
+    ProviderUnavailableError,
+    ResourceBudgetExceededError,
+)
+from .op_registry import MATMUL_CANONICAL_OPCODE, OpDefinition, get_op_definition
+from .plan import PLAN_TIE_BREAK, ExecutionPlan, build_plan_payload
+from .policy import KNOWN_TARGET_KINDS, ExecutionPolicy
+from .providers import (
+    PORTABLE_IMPLEMENTATION,
+    PORTABLE_PROVIDER_ID,
+    PORTABLE_RUNNER_VERSION,
+)
+
+
+RESOLVER_VERSION = 1
+
+_NUMERIC_STRENGTH = {
+    "portable_bitwise": 0,
+    "deterministic_bounded": 1,
+    "best_effort": 2,
+}
+
+_PROVIDER_RANK = {
+    PORTABLE_PROVIDER_ID: 0,
+}
+
+
+@dataclass(frozen=True)
+class Candidate:
+    """One provider evaluation recorded in the plan."""
+
+    provider_id: str
+    provider_version: str
+    state: str
+    reason: str
+    tie_break_key: Tuple[Any, ...]
+    numeric_class: Optional[str]
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "id": self.provider_id,
+            "provider_version": self.provider_version,
+            "state": self.state,
+            "reason": self.reason,
+            "tie_break_key": list(self.tie_break_key),
+            "numeric_class": self.numeric_class,
+        }
+
+
+@dataclass(frozen=True)
+class ResolutionResult:
+    """Plan plus the human/machine-readable explanation of the decision."""
+
+    plan: ExecutionPlan
+    candidates: Tuple[Candidate, ...]
+    rules: Tuple[Mapping[str, Any], ...]
+    fallback_events: Tuple[Mapping[str, Any], ...]
+    degraded: bool
+    resolved_policy: Mapping[str, Any]
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return {
+            "plan": self.plan.to_dict(),
+            "candidates": [item.to_dict() for item in self.candidates],
+            "rules": [dict(item) for item in self.rules],
+            "fallback_events": [dict(item) for item in self.fallback_events],
+            "degraded": self.degraded,
+            "resolved_policy": mapping_copy(self.resolved_policy),
+        }
+
+
+def _rule(name: str, outcome: str, **details: Any) -> Mapping[str, Any]:
+    return {"rule": name, "outcome": outcome, "details": details}
+
+
+def _shape_tuple(shape: Any, label: str) -> Tuple[int, ...]:
+    if isinstance(shape, (str, bytes)):
+        raise CapabilityUnavailableError(
+            "{} must be a sequence of non-negative integers".format(label),
+            field="request." + label,
+            requested=shape,
+            reason="static_shape_required_by_portable_provider",
+        )
+    try:
+        values = tuple(shape)
+    except TypeError as exc:
+        raise CapabilityUnavailableError(
+            "{} must be a sequence of non-negative integers".format(label),
+            field="request." + label,
+            requested=shape,
+            reason="static_shape_required_by_portable_provider",
+        ) from exc
+    for index, value in enumerate(values):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise CapabilityUnavailableError(
+                "{}[{}] must be a static integer dimension".format(label, index),
+                field="request.{}.{}".format(label, index),
+                requested=value,
+                reason="static_shape_required_by_portable_provider",
+            )
+        if value < 0:
+            raise OpContractError(
+                "{}[{}] must be non-negative".format(label, index),
+                field="request.{}.{}".format(label, index),
+                requested=value,
+                reason="negative_dimension",
+            )
+    if len(values) < 2:
+        raise OpContractError(
+            "{} rank must be at least 2".format(label),
+            field="request." + label,
+            requested=list(values),
+            reason="rank_out_of_range",
+        )
+    return values
+
+
+def _normalize_dtype(dtype: Any) -> str:
+    try:
+        return canonical_dtype(dtype)
+    except CpuScalarValidationError as exc:
+        raise OpContractError(
+            "matmul request dtype is invalid",
+            field="request.dtype",
+            requested=dtype,
+            reason="invalid_dtype",
+        ) from exc
+
+
+def _numeric_class(entry: ProviderCapability) -> str:
+    if "portable_bitwise" in entry.numeric_modes:
+        return "portable_bitwise"
+    if "deterministic_bounded" in entry.numeric_modes:
+        return "deterministic_bounded"
+    return "best_effort"
+
+
+def _satisfies_numeric(entry: ProviderCapability, requirement: str) -> bool:
+    if requirement == "portable":
+        return "portable_bitwise" in entry.numeric_modes
+    if requirement == "deterministic":
+        return entry.deterministic
+    return False
+
+
+def _tie_break_key(entry: ProviderCapability) -> Tuple[Any, ...]:
+    numeric_class = _numeric_class(entry)
+    return (
+        _NUMERIC_STRENGTH.get(numeric_class, 9),
+        0 if entry.deterministic else 1,
+        _PROVIDER_RANK.get(entry.provider_id, 1),
+        entry.provider_id,
+    )
+
+
+def _accumulation_for(definition: OpDefinition, dtype: str) -> str:
+    table = definition.numeric_contract["accumulation"]
+    if dtype in ("float32", "bf16"):
+        return table["float32"]
+    if dtype == "float64":
+        return table["float64"]
+    if dtype == "float16":
+        return table["float16"]
+    return table["integer"]
+
+
+def _check_policy_applicability(policy: ExecutionPolicy, capability: CapabilitySnapshot) -> None:
+    if policy.profile != "portable":
+        raise PolicyFieldNotApplicableError(
+            "profile={!r} is not applicable to the U1 slice".format(policy.profile),
+            field="profile",
+            requested=policy.profile,
+            available=["portable"],
+            reason="profile_not_implemented_in_u1_slice",
+            suggested_policy={"profile": "portable", "provider": {"mode": "portable"}},
+            capability_digest=capability.digest,
+        )
+    if policy.numeric.requirement == "bounded":
+        raise NumericGuaranteeUnmetError(
+            "numeric.requirement=bounded needs an ErrorBudget, which U1 does not implement",
+            field="numeric.requirement",
+            requested="bounded",
+            available=["portable", "deterministic"],
+            reason="error_budget_not_implemented_in_u1_slice",
+            suggested_policy={"numeric": {"requirement": "portable"}, "deterministic": True},
+            capability_digest=capability.digest,
+        )
+    if policy.fallback.mode == "declared":
+        raise PolicyFieldNotApplicableError(
+            "fallback.mode=declared needs an explicit fallback chain, which U1 does not implement",
+            field="fallback.mode",
+            requested="declared",
+            available=["deny", "portable_only"],
+            reason="declared_fallback_chain_not_implemented_in_u1_slice",
+            suggested_policy={"fallback": {"mode": "portable_only"}},
+            capability_digest=capability.digest,
+        )
+    if policy.provider.mode == "vendor":
+        raise ProviderUnavailableError(
+            "provider.mode=vendor has no registered vendor provider in the U1 slice",
+            field="provider.mode",
+            requested="vendor",
+            available=[PORTABLE_PROVIDER_ID],
+            reason="no_vendor_provider_registered_in_u1_slice",
+            suggested_policy={"provider": {"mode": "portable"}},
+            capability_digest=capability.digest,
+        )
+    if policy.provider.mode == "required":
+        required = policy.provider.required
+        known = set(capability.provider_ids())
+        known.add(PORTABLE_PROVIDER_ID)
+        if required not in known:
+            raise ProviderUnavailableError(
+                "required provider {!r} is not registered".format(required),
+                field="provider.required",
+                requested=required,
+                available=sorted(known),
+                reason="provider_not_registered",
+                suggested_policy={"provider": {"mode": "portable"}},
+                capability_digest=capability.digest,
+            )
+        entry = capability.provider(required)
+        if entry is not None and not entry.available:
+            raise ProviderUnavailableError(
+                "required provider {!r} is unavailable".format(required),
+                field="provider.required",
+                requested=required,
+                available=[item.provider_id for item in capability.providers if item.available],
+                reason="provider_capability_unavailable:" + str(entry.reason or "unknown"),
+                suggested_policy={"provider": {"mode": "portable"}},
+                capability_digest=capability.digest,
+            )
+
+
+def _check_target(policy: ExecutionPolicy, capability: CapabilitySnapshot) -> None:
+    target = policy.target
+    if target == "auto":
+        if capability.kind != "cpu":
+            raise CapabilityUnavailableError(
+                "the portable provider only supports cpu targets",
+                field="target",
+                requested="auto",
+                available={"kind": capability.kind, "provider": PORTABLE_PROVIDER_ID},
+                reason="portable_provider_requires_cpu_target",
+                suggested_policy={"target": "cpu"},
+                capability_digest=capability.digest,
+            )
+        return
+    if target in KNOWN_TARGET_KINDS:
+        if target != "cpu":
+            raise CapabilityUnavailableError(
+                "target kind {!r} has no provider in the U1 slice".format(target),
+                field="target",
+                requested=target,
+                available=["cpu"],
+                reason="no_provider_for_target_kind_in_u1_slice",
+                suggested_policy={"target": "cpu"},
+                capability_digest=capability.digest,
+            )
+        if capability.kind != "cpu":
+            raise CapabilityUnavailableError(
+                "target=cpu does not match the capability snapshot kind",
+                field="target",
+                requested="cpu",
+                available=capability.kind,
+                reason="target_kind_mismatch",
+                capability_digest=capability.digest,
+            )
+        return
+    if target != capability.triple:
+        raise PolicyConflictError(
+            "explicit target triple does not match the capability snapshot",
+            field="target",
+            requested=target,
+            available=capability.triple,
+            reason="explicit_target_does_not_match_capability_snapshot",
+            capability_digest=capability.digest,
+        )
+
+
+def resolve_matmul(
+    policy: ExecutionPolicy,
+    capability: CapabilitySnapshot,
+    left_shape: Sequence[int],
+    right_shape: Sequence[int],
+    dtype: str
+) -> ResolutionResult:
+    """Resolve one matmul request into an immutable, digestible plan."""
+
+    if not isinstance(policy, ExecutionPolicy):
+        raise PolicyInvalidValueError(
+            "policy must be an ExecutionPolicy",
+            field="policy",
+            requested=type(policy).__name__,
+            reason="not_an_execution_policy",
+        )
+    if not isinstance(capability, CapabilitySnapshot):
+        raise CapabilityUnavailableError(
+            "capability must be a CapabilitySnapshot",
+            field="capability",
+            requested=type(capability).__name__,
+            reason="not_a_capability_snapshot",
+        )
+    capability.verify_digest()
+
+    rules = []
+    definition = get_op_definition(MATMUL_CANONICAL_OPCODE)
+    rules.append(
+        _rule(
+            "op_contract.lookup",
+            "ok",
+            opcode=definition.canonical_opcode,
+            contract_version=definition.contract_version,
+            contract_digest=definition.contract_digest,
+        )
+    )
+
+    _check_policy_applicability(policy, capability)
+    policy_applicability = {"status": "validated", "rejected_fields": []}
+    rules.append(
+        _rule(
+            "policy.applicability",
+            "ok",
+            status=policy_applicability["status"],
+            rejected_fields=policy_applicability["rejected_fields"],
+            profile=policy.profile,
+            provider_mode=policy.provider.mode,
+            numeric_requirement=policy.numeric.requirement,
+            deterministic=policy.deterministic,
+            fallback_mode=policy.fallback.mode,
+            max_threads=policy.resources.max_threads,
+        )
+    )
+    _check_target(policy, capability)
+    rules.append(
+        _rule(
+            "target.match",
+            "ok",
+            requested=policy.target,
+            resolved_kind=capability.kind,
+            resolved_triple=capability.triple,
+            capability_digest=capability.digest,
+        )
+    )
+
+    normalized_left = _shape_tuple(left_shape, "left_shape")
+    normalized_right = _shape_tuple(right_shape, "right_shape")
+    normalized_dtype = _normalize_dtype(dtype)
+    left_type = CoreType.tensor(normalized_dtype, normalized_left)
+    right_type = CoreType.tensor(normalized_dtype, normalized_right)
+    if len(normalized_left) == len(normalized_right):
+        expected_output = normalized_left[:-2] + (normalized_left[-2], normalized_right[-1])
+    else:
+        expected_output = normalized_left
+    output_type = CoreType.tensor(normalized_dtype, expected_output)
+    info = definition.verify_signature(left_type, right_type, output_type)
+    rules.append(
+        _rule(
+            "op_contract.verify",
+            "ok",
+            dtype=normalized_dtype,
+            left_shape=list(normalized_left),
+            right_shape=list(normalized_right),
+            output_shape=list(info["output_shape"]),
+        )
+    )
+
+    evaluations = []
+    for entry in capability.providers:
+        state = "rejected"
+        reason = ""
+        numeric_class = _numeric_class(entry)
+        if entry.provider_id not in definition.allowed_providers:
+            reason = "provider_not_allowed_by_contract"
+        elif entry.contract_digest(definition.canonical_opcode) != definition.contract_digest:
+            state = "rejected"
+            reason = "contract_digest_mismatch"
+        elif not entry.supports_kind(capability.kind):
+            reason = "provider_target_kind_mismatch"
+        elif not entry.available:
+            reason = "provider_capability_unavailable:" + str(entry.reason or "unknown")
+        elif policy.provider.mode == "required" and entry.provider_id != policy.provider.required:
+            reason = "provider_not_required_pin"
+        elif policy.provider.mode == "portable" and entry.provider_id != PORTABLE_PROVIDER_ID:
+            reason = "provider_not_portable_mode"
+        elif policy.profile == "portable" and entry.provider_id != PORTABLE_PROVIDER_ID:
+            reason = "provider_not_portable_trunk"
+        elif not _satisfies_numeric(entry, policy.numeric.requirement):
+            reason = "numeric_requirement_unmet"
+        elif policy.deterministic and not entry.deterministic:
+            reason = "deterministic_requirement_unmet"
+        elif (
+            isinstance(policy.resources.max_threads, int)
+            and entry.max_threads > policy.resources.max_threads
+        ):
+            reason = "resource_budget_exceeded"
+        else:
+            state = "candidate"
+        evaluations.append(
+            {
+                "entry": entry,
+                "state": state,
+                "reason": reason,
+                "numeric_class": numeric_class,
+                "tie_break_key": _tie_break_key(entry),
+            }
+        )
+        rules.append(
+            _rule(
+                "provider.filter",
+                state,
+                provider=entry.provider_id,
+                provider_version=entry.version,
+                reason=reason or "satisfies_policy_and_contract",
+                numeric_class=numeric_class,
+                deterministic=entry.deterministic,
+            )
+        )
+
+    candidates = [item for item in evaluations if item["state"] == "candidate"]
+    if not candidates:
+        _raise_no_candidate(policy, capability, definition, evaluations)
+
+    candidates.sort(key=lambda item: item["tie_break_key"])
+    selected = candidates[0]
+    for index, item in enumerate(candidates):
+        if index == 0:
+            item["state"] = "selected"
+            item["reason"] = "satisfies_policy_and_contract"
+        elif policy.fallback.mode == "portable_only" and item["entry"].provider_id == PORTABLE_PROVIDER_ID:
+            item["state"] = "declared_fallback"
+            item["reason"] = "portable_trunk_declared_fallback"
+        else:
+            item["state"] = "rejected"
+            item["reason"] = "tie_break_lost"
+
+    rules.append(
+        _rule(
+            "provider.select",
+            "ok",
+            selected=selected["entry"].provider_id,
+            tie_break=list(PLAN_TIE_BREAK),
+            ordered=[
+                {"provider": item["entry"].provider_id, "key": list(item["tie_break_key"])}
+                for item in candidates
+            ],
+        )
+    )
+
+    fallback_chain = [selected["entry"].provider_id]
+    if policy.fallback.mode == "portable_only" and PORTABLE_PROVIDER_ID not in fallback_chain:
+        portable_entry = capability.provider(PORTABLE_PROVIDER_ID)
+        if portable_entry is not None and portable_entry.available:
+            fallback_chain.append(PORTABLE_PROVIDER_ID)
+
+    contract = dict(definition.contract_identity)
+    contract["core_ir_opcodes"] = list(definition.core_ir_opcodes)
+    contract["portable_reference"] = mapping_copy(definition.portable_reference)
+
+    request = {
+        "op": definition.canonical_opcode,
+        "left_shape": list(info["left_shape"]),
+        "right_shape": list(info["right_shape"]),
+        "output_shape": list(info["output_shape"]),
+        "dtype": info["dtype"],
+        "policy_digest": policy.digest,
+    }
+    target = {
+        "kind": capability.kind,
+        "triple": capability.triple,
+        "features": list(capability.features),
+        "capability_digest": capability.digest,
+    }
+    selected_entry = selected["entry"]
+    resolved_threads = min(
+        selected_entry.max_threads,
+        policy.resources.max_threads if isinstance(policy.resources.max_threads, int) else selected_entry.max_threads,
+    )
+    numeric_guarantee = {
+        "class": selected["numeric_class"],
+        "reference": definition.numeric_contract["reference"],
+        "scope": "op",
+        "accumulation": _accumulation_for(definition, info["dtype"]),
+        "rounding": definition.numeric_contract["accumulation_rounding"],
+        "reduction_order": definition.numeric_contract["reduction_order"],
+        "reduction_order_id": definition.numeric_contract["reduction_order_id"],
+        "exactness_basis": definition.numeric_contract["exactness_basis"],
+        "deterministic": bool(selected_entry.deterministic),
+        "error_budget": None,
+    }
+    layout_decision = {
+        "requested_view_mode": "not_applicable",
+        "resolved_view_mode": "not_applicable",
+        "alias_proof_digest": None,
+        "layout_copy_bytes": 0,
+        "transfer_bytes": 0,
+    }
+    selected_record = {
+        "provider": selected_entry.provider_id,
+        "provider_version": selected_entry.version,
+        "implementation": PORTABLE_IMPLEMENTATION
+        if selected_entry.provider_id == PORTABLE_PROVIDER_ID
+        else selected_entry.provider_id + ".matmul",
+        "numeric_class": selected["numeric_class"],
+        "deterministic": bool(selected_entry.deterministic),
+        "accumulation": numeric_guarantee["accumulation"],
+        "rounding": numeric_guarantee["rounding"],
+        "reduction_order": numeric_guarantee["reduction_order"],
+        "threads": resolved_threads,
+        "scope": "op",
+    }
+    artifact = {
+        "contract_version": definition.contract_version,
+        "lowering_version": LOWERING_VERSION,
+        "runner_version": PORTABLE_RUNNER_VERSION,
+        "wire_version": ARTIFACT_PAYLOAD_VERSION,
+        "provider_version": selected_entry.version,
+    }
+    resolved_policy = {
+        "profile": policy.profile,
+        "target": {
+            "requested": policy.target,
+            "resolved_kind": capability.kind,
+            "resolved_triple": capability.triple,
+        },
+        "provider": {
+            "requested_mode": policy.provider.mode,
+            "requested_required": policy.provider.required,
+            "resolved": selected_entry.provider_id,
+        },
+        "numeric": {
+            "requested_requirement": policy.numeric.requirement,
+            "resolved_class": selected["numeric_class"],
+            "deterministic": bool(selected_entry.deterministic),
+        },
+        "fallback": {"mode": policy.fallback.mode, "chain": list(fallback_chain)},
+        "resources": {
+            "requested_max_threads": policy.resources.max_threads,
+            "resolved_threads": resolved_threads,
+        },
+    }
+    candidate_records = [
+        Candidate(
+            provider_id=item["entry"].provider_id,
+            provider_version=item["entry"].version,
+            state=item["state"],
+            reason=item["reason"],
+            tie_break_key=item["tie_break_key"],
+            numeric_class=item["numeric_class"],
+        )
+        for item in evaluations
+    ]
+    resolution_record = {
+        "resolver_version": RESOLVER_VERSION,
+        "policy_digest": policy.digest,
+        "capability_digest": capability.digest,
+        "contract_digest": definition.contract_digest,
+        "tie_break": list(PLAN_TIE_BREAK),
+        "rules": [dict(item) for item in rules],
+    }
+    payload = build_plan_payload(
+        contract=contract,
+        request=request,
+        target=target,
+        policy={"requested": policy.to_dict(), "resolved": resolved_policy},
+        policy_applicability=policy_applicability,
+        layout_decision=layout_decision,
+        selected=selected_record,
+        numeric_guarantee=numeric_guarantee,
+        artifact=artifact,
+        candidates=[item.to_dict() for item in candidate_records],
+        fallback={"mode": policy.fallback.mode, "chain": list(fallback_chain), "events": [], "degraded": False},
+        resolution=resolution_record,
+    )
+    plan = ExecutionPlan(payload)
+    plan.validate()
+    return ResolutionResult(
+        plan=plan,
+        candidates=tuple(candidate_records),
+        rules=tuple(dict(item) for item in rules),
+        fallback_events=(),
+        degraded=False,
+        resolved_policy=resolved_policy,
+    )
+
+
+def _raise_no_candidate(
+    policy: ExecutionPolicy,
+    capability: CapabilitySnapshot,
+    definition: OpDefinition,
+    evaluations: Sequence[Mapping[str, Any]]
+) -> None:
+    reasons = {item["reason"].split(":")[0]: item["entry"].provider_id for item in evaluations}
+    available = sorted(item["entry"].provider_id for item in evaluations)
+    if policy.provider.mode == "required":
+        raise ProviderUnavailableError(
+            "required provider did not satisfy the contract/policy",
+            field="provider.required",
+            requested=policy.provider.required,
+            available=available,
+            reason="required_provider_rejected",
+            capability_digest=capability.digest,
+        )
+    if "numeric_requirement_unmet" in reasons:
+        raise NumericGuaranteeUnmetError(
+            "no provider satisfies numeric.requirement={!r}".format(policy.numeric.requirement),
+            field="numeric.requirement",
+            requested=policy.numeric.requirement,
+            available=[item["entry"].numeric_modes for item in evaluations],
+            reason="numeric_requirement_unmet",
+            suggested_policy={"numeric": {"requirement": "portable"}, "deterministic": True},
+            capability_digest=capability.digest,
+        )
+    if "resource_budget_exceeded" in reasons:
+        raise ResourceBudgetExceededError(
+            "no provider fits resources.max_threads",
+            field="resources.max_threads",
+            requested=policy.resources.max_threads,
+            available=[item["entry"].max_threads for item in evaluations],
+            reason="resource_budget_exceeded",
+            capability_digest=capability.digest,
+        )
+    if "contract_digest_mismatch" in reasons:
+        raise ArtifactMismatchError(
+            "no provider advertises the registered {} contract digest".format(definition.canonical_opcode),
+            field="capability.providers",
+            requested=definition.contract_digest,
+            available=[item["entry"].contract_digest(definition.canonical_opcode) for item in evaluations],
+            reason="provider_contract_digest_mismatch",
+            capability_digest=capability.digest,
+        )
+    if "provider_capability_unavailable" in reasons:
+        raise ProviderUnavailableError(
+            "all candidate providers are unavailable",
+            field="capability.providers",
+            requested=[item["entry"].provider_id for item in evaluations],
+            available=[],
+            reason="provider_capability_unavailable",
+            capability_digest=capability.digest,
+        )
+    raise CapabilityUnavailableError(
+        "no candidate satisfies the policy and contract",
+        field="provider",
+        requested={
+            "mode": policy.provider.mode,
+            "numeric_requirement": policy.numeric.requirement,
+            "profile": policy.profile,
+        },
+        available=available,
+        reason="no_candidate_satisfies_policy",
+        capability_digest=capability.digest,
+    )
+
+
+def resolve_plan(
+    policy: ExecutionPolicy,
+    capability: CapabilitySnapshot,
+    left_shape: Sequence[int],
+    right_shape: Sequence[int],
+    dtype: str
+) -> ExecutionPlan:
+    """Convenience wrapper returning only the immutable plan."""
+
+    return resolve_matmul(policy, capability, left_shape, right_shape, dtype).plan
+
+
+__all__ = [
+    "RESOLVER_VERSION",
+    "Candidate",
+    "ResolutionResult",
+    "resolve_matmul",
+    "resolve_plan",
+]
