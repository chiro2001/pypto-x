+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+def _values(count, dtype, seed):
+    if dtype in ("float32", "float64"):
+        return [float((index * 37 + seed) % 101 - 50) / 8.0 for index in range(count)]
+    if dtype in ("float16", "bf16"):
+        return [float((index * 37 + seed) % 101 - 50) / 4.0 for index in range(count)]
+    if dtype.startswith("int") or dtype.startswith("uint"):
+        return [int((index * 37 + seed) % 41 - 20) for index in range(count)]
+    raise AssertionError("unsupported test dtype {!r}".format(dtype))
+
+
+def _tensor(dtype, shape, seed=0):
+    count = 1
+    for dimension in shape:
+        count *= dimension
+    return HostTensor(dtype, shape, _values(count, dtype, seed))
+
+
+def _buffer_bytes(tensor):
+    """Faithful little-endian raw encoding of one HostTensor buffer."""
+
+    dtype = tensor.dtype
+    payload = bytearray()
+    for value in tensor.flat():
+        if dtype == "float32":
+            payload += struct.pack("<f", float(value))
+        elif dtype == "float64":
+            payload += struct.pack("<d", float(value))
+        elif dtype == "float16":
+            payload += struct.pack("<e", float(value))
+        elif dtype == "bf16":
+            bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+            payload += struct.pack("<H", (bits >> 16) & 0xFFFF)
+        elif dtype.startswith("int") or dtype.startswith("uint"):
+            width = int(dtype[3:] if dtype.startswith("int") else dtype[4:]) // 8
+            payload += int(value).to_bytes(width, "little", signed=dtype.startswith("int"))
+        else:
+            raise AssertionError("unsupported buffer dtype {!r}".format(dtype))
+    return bytes(payload)
+
+
+def _buffer_sha256(tensor):
+    return hashlib.sha256(_buffer_bytes(tensor)).hexdigest()
+
+
+def _existing_trunk_run(left, right, output):
+    """The pre-U1 way to run this Core IR matmul (same compiler + runtime)."""
+
+    left_type = CoreType.tensor(left.dtype, left.shape)
+    right_type = CoreType.tensor(right.dtype, right.shape)
+    output_type = CoreType.tensor(output.dtype, output.shape)
+    left_ref = ValueRef("left", left_type)
+    right_ref = ValueRef("right", right_type)
+    output_ref = ValueRef("output", output_type)
+    operation = Operation("matmul", (left_ref, right_ref), (output_ref,))
+    program = CoreProgram(
+        functions=(CoreFunction("matmul", (left_ref, right_ref), (output_ref,), Region((operation,))),)
+    )
+    compiler = CpuScalarCompiler()
+    artifact = compiler.compile(compiler.lower(program, TargetSpec("cpu", "x86_64-linux-gnu")))
+    CpuScalarRuntime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[left.descriptor(readonly=True), right.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+    )
+    return output
+
