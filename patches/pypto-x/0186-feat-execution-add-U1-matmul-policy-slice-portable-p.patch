+def test_report_is_traceable_reproducible_and_ungated():
+    left = _tensor("float32", (2, 3, 5), seed=4)
+    right = _tensor("float32", (2, 5, 4), seed=5)
+    output, report = execute_matmul(left, right, ExecutionPolicy.portable())
+    document = report.to_dict()
+
+    assert json.loads(report.to_json()) == document
+    assert document["requested_policy"]["profile"] == "portable"
+    assert document["resolved_policy"]["provider"]["resolved"] == PORTABLE_PROVIDER_ID
+    assert document["resolution"]["why"].startswith("selected provider 'portable'")
+    assert document["resolution"]["rules"]
+    assert document["resolution"]["tie_break"]
+    assert document["resolved"]["contract"]["digest"] == get_op_definition("matmul").contract_digest
+
+    assert document["timing"]["kernel_seconds"] is None
+    assert document["timing"]["transfer_seconds"] == 0.0
+    assert document["gates"]["status"] == "UNGATED"
+    assert document["gates"]["performance_gated"] is False
+
+    # 0006/e1cb7e6 machine-comparable applicability, layout and coverage blocks.
+    assert document["policy_applicability"] == {"status": "validated", "rejected_fields": []}
+    assert document["layout_decision"]["requested_view_mode"] == "not_applicable"
+    assert document["layout_decision"]["resolved_view_mode"] == "not_applicable"
+    assert document["layout_decision"]["alias_proof_digest"] is None
+    assert document["layout_decision"]["layout_copy_bytes"] == 0
+    assert document["layout_decision"]["transfer_bytes"] == 0
+    assert document["guarantees"]["reduction_order_id"] == "portable_serial_k_ascending_v1"
+    assert document["guarantees"]["exactness_basis"] == "contract_and_order"
+    assert document["resources"]["parallelism"]["worker_count"] == 1
+    assert document["resources"]["parallelism"]["worker_index"] == 0
+    assert document["resources"]["parallelism"]["oversubscription_policy"] == "reject"
+    assert document["resources"]["parallelism"]["cpu_affinity"] is None
+    assert document["coverage"]["logical_operation_counts"][0]["opcode"] == "matmul"
+    assert document["coverage"]["logical_operation_counts"][0]["count"] == 1
+    assert document["coverage"]["logical_operation_counts"][0]["included_in_graph_total"] is True
+    assert document["coverage"]["logical_operation_counts"][0]["parent_opcode"] is None
+    assert document["coverage"]["provider_invocation_counts"][0]["provider"] == PORTABLE_PROVIDER_ID
+    assert document["coverage"]["epilogue_counts"] == []
+
+    # Reproduce the same plan digest from the report's own policy document.
+    requested = policy_from_dict(document["requested_policy"])
+    capability = CapabilitySnapshot.for_host(
+        kind=document["capability"]["kind"],
+        triple=document["capability"]["triple"],
+        features=document["capability"]["features"],
+    )
+    replayed = resolve_matmul(
+        requested,
+        capability,
+        document["request"]["left_shape"],
+        document["request"]["right_shape"],
+        document["request"]["dtype"],
+    )
+    assert replayed.plan.digest == document["resolution"]["plan_digest"]
+
+    replayed_output, replayed_report = execute_matmul_plan(replayed.plan, left, right)
+    assert _buffer_sha256(replayed_output) == _buffer_sha256(output)
+    assert replayed_report.to_dict()["resolution"]["plan_digest"] == report.plan_digest
