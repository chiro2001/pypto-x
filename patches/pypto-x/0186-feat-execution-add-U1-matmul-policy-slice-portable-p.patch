+# ---------------------------------------------------------------------------
+# acceptance 3: deterministic resolution
+# ---------------------------------------------------------------------------
+def test_plan_digest_is_deterministic_for_policy_capability_shape_dtype():
+    capability_a = CapabilitySnapshot.for_host(features=("avx512f", "fma"))
+    capability_b = CapabilitySnapshot.for_host(features=("fma", "avx512f"))
+    assert capability_a.digest == capability_b.digest
+    policy_a = ExecutionPolicy.portable()
+    policy_b = ExecutionPolicy(profile="portable", target="auto", provider=ProviderPolicy(mode="portable"))
+    digests = []
+    for _ in range(2):
