+def test_registry_is_a_view_of_the_core_ir_alias_table():
+    definition = get_op_definition("matmul")
+    expected_aliases = tuple(
+        sorted(name for name, canonical in lowering_cpu.OP_ALIASES.items() if canonical == "matmul")
+    )
+    assert definition.core_ir_opcodes == expected_aliases
+    assert lookup_canonical_opcode("tensor.matmul") == "matmul"
+    assert lookup_canonical_opcode("linalg.matmul") == "matmul"
+    assert registered_opcodes() == ("matmul",)
+
+    expected_dtypes = set()
+    for dtype in lowering_cpu.SUPPORTED_DTYPES:
+        canonical = lowering_cpu.canonical_dtype(dtype)
+        if canonical != "bool":
+            expected_dtypes.add(canonical)
+    assert set(definition.inputs[0].dtypes) == expected_dtypes
+    assert definition.numeric_contract["reduction_order"] == "k_ascending_serial_per_output_element"
