+    baseline = digests[0]
+    other_shape = resolve_matmul(policy_a, capability_a, (2, 3), (3, 5), "float32").plan.digest
+    other_dtype = resolve_matmul(policy_a, capability_a, (2, 3), (3, 4), "bf16").plan.digest
+    assert other_shape != baseline
