+def test_declared_provider_is_the_invoked_provider():
+    left = _tensor("float32", (2, 3), seed=1)
+    right = _tensor("float32", (3, 4), seed=2)
+    calls = []
+
+    class SpyProvider(providers_module.PortableProvider):
+        def execute(self, plan, left, right, output, capability):
+            calls.append(
+                {
+                    "provider": plan.selected_provider,
+                    "plan_digest": plan.digest,
+                    "capability_digest": capability.digest,
+                }
+            )
+            return super(SpyProvider, self).execute(plan, left, right, output, capability)
+
+    original = providers_module.PROVIDERS[PORTABLE_PROVIDER_ID]
+    providers_module.PROVIDERS[PORTABLE_PROVIDER_ID] = SpyProvider()
+    try:
+        resolution = plan_matmul((2, 3), (3, 4), "float32")
+        result, report = execute_matmul_plan(resolution.plan, left, right)
+    finally:
+        providers_module.PROVIDERS[PORTABLE_PROVIDER_ID] = original
+
+    assert calls and calls[0]["provider"] == PORTABLE_PROVIDER_ID
+    assert calls[0]["plan_digest"] == resolution.plan.digest
+    assert report.provider_invoked == PORTABLE_PROVIDER_ID
+    payload = report.to_dict()
+    assert payload["dispatch"]["provider_declared"] == PORTABLE_PROVIDER_ID
+    assert payload["dispatch"]["provider_invoked"] == PORTABLE_PROVIDER_ID
+    assert payload["dispatch"]["declaration_match"] is True
+    assert payload["resolved"]["provider"] == payload["dispatch"]["provider_invoked"]
+
