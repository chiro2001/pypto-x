+# ---------------------------------------------------------------------------
+# acceptance 1: portable policy is bitwise identical to the existing trunk
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "dtype, left_shape, right_shape",
+    (
+        ("float32", (2, 3), (3, 4)),
+        ("float32", (2, 3, 5), (2, 5, 4)),
+        ("bf16", (3, 4), (4, 6)),
+        ("float16", (2, 3), (3, 4)),
+        ("int32", (2, 5), (5, 3)),
+        ("float64", (2, 2), (2, 2)),
+    ),
+)
+def test_portable_bitwise_parity_with_existing_trunk(dtype, left_shape, right_shape):
+    left = _tensor(dtype, left_shape, seed=3)
+    right = _tensor(dtype, right_shape, seed=7)
+    left_before = _buffer_sha256(left)
+    right_before = _buffer_sha256(right)
+    output_shape = left_shape[:-2] + (left_shape[-2], right_shape[-1])
+    existing_output = _existing_trunk_run(left, right, HostTensor.zeros(dtype, output_shape))
+    policy_output = HostTensor.zeros(dtype, output_shape)
+    result, report = execute_matmul(left, right, ExecutionPolicy.portable(), output=policy_output)
+
+    assert _buffer_sha256(existing_output) == _buffer_sha256(result)
+    assert _buffer_sha256(existing_output) == _buffer_sha256(policy_output)
+    assert _buffer_sha256(left) == left_before
+    assert _buffer_sha256(right) == right_before
+    assert result.flat() == existing_output.flat()
+    assert report.provider_invoked == PORTABLE_PROVIDER_ID
+    assert report.numeric_class == "portable_bitwise"
+
