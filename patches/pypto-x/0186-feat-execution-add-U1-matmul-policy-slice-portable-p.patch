+    result = resolve_matmul(auto, capability, (2, 3), (3, 4), "float32")
+    assert result.plan.selected_provider == PORTABLE_PROVIDER_ID
+    assert result.resolved_policy["provider"]["requested_mode"] == "auto"
+    assert result.resolved_policy["resources"]["resolved_threads"] == 1
+    # deterministic is a weaker/equal numeric requirement for the portable
+    # trunk; the resolved class stays portable_bitwise and must be reported.
+    deterministic = ExecutionPolicy(numeric=NumericPolicy(requirement="deterministic"))
+    result = resolve_matmul(deterministic, capability, (2, 3), (3, 4), "float32")
+    assert result.plan.numeric_guarantee["class"] == "portable_bitwise"
+    assert result.plan.numeric_guarantee["deterministic"] is True
