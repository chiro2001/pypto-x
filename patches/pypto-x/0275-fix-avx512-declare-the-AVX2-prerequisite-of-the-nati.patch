+def test_missing_avx2_host_feature_is_rejected(tmp_path):
+    """An AVX-512F host without the AVX2 CPUID/YMM contract must fail closed."""
+
+    runtime = _runtime()
+    output = ValueRef("out", CoreType.tensor("int32", (4,)))
+    program = _program(
+        "iota",
+        (),
+        (output,),
+        (Operation("iota", (), (output,), {"axis": 0}),),
+    )
+    artifact = _compile_avx512(program, tmp_path / "missing_avx2")
+    capability = avx512_runtime.Avx512Capability.injected_capability(
+        ("avx", "avx512f", "osxsave", "ymm", "opmask", "zmm")
+    )
+    assert capability.available
+    assert "avx2" not in tuple(capability.features)
+    with pytest.raises(avx512_runtime.CpuAvx512FeatureMismatchError) as error:
+        avx512_runtime.Avx512Runtime(capability=capability).load(artifact)
+    assert "avx2" in str(error.value.status.details)
+
