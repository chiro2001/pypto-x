+        decoder = HostTensor.zeros("bf16", (2, 4))
+        _run(compiler, runtime, build_decoder_subgraph(2, hidden=4, intermediate=4), [HostTensor("bf16", (2, 4), [1, 2, 3, 4, 5, 6, 7, 8]), HostTensor("bf16", (4,), [1] * 4), HostTensor("bf16", (4, 8), [.1] * 32)], [decoder], {"epsilon": 1e-5})
