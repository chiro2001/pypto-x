+    def _emit_coords(self, flat_register: int, shape: Sequence[int], base: int = 30) -> Tuple[int, ...]:
+        """Unravel one row-major flat index into 64-bit coordinate registers."""
+
+        shape = tuple(int(value) for value in shape)
+        coordinates = []
+        strides = _strides(shape)
+        for axis, (dimension, stride) in enumerate(zip(shape, strides)):
+            coordinate = base + axis
+            divisor = base + len(shape) + axis
+            self.line("    mov.u64 %rd{}, {};".format(divisor, stride))
+            self.line("    div.u64 %rd{}, %rd{}, %rd{};".format(coordinate, flat_register, divisor))
+            self.line("    mov.u64 %rd{}, {};".format(divisor, dimension))
+            self.line("    rem.u64 %rd{}, %rd{}, %rd{};".format(coordinate, coordinate, divisor))
+            coordinates.append(coordinate)
+        return tuple(coordinates)
+
+    def _emit_ravel(self, coordinates: Sequence[int], shape: Sequence[int], destination: int = 50) -> int:
+        self.line("    mov.u64 %rd{}, 0;".format(destination))
+        for coordinate, stride in zip(coordinates, _strides(tuple(shape))):
+            if coordinate == 0:
+                continue
+            self.line("    mul.lo.u64 %rd62, %rd{}, {};".format(coordinate, stride))
+            self.line("    add.u64 %rd{}, %rd{}, %rd62;".format(destination, destination))
+        return destination
+
+    def _emit_broadcast_index(self, source_shape: Sequence[int], output_shape: Sequence[int], destination: int = 50) -> int:
+        source_shape = tuple(int(value) for value in source_shape)
+        output_shape = tuple(int(value) for value in output_shape)
+        if not source_shape:
+            self.line("    mov.u64 %rd{}, 0;".format(destination))
+            return destination
+        output_coords = self._emit_coords(0, output_shape, 30)
+        delta = len(output_shape) - len(source_shape)
+        source_coords = tuple(0 if dimension == 1 else output_coords[axis + delta] for axis, dimension in enumerate(source_shape))
+        return self._emit_ravel(source_coords, source_shape, destination)
+
