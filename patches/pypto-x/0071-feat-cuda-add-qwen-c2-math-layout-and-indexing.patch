+"""Weight-free CUDA C2 device validation driver (no pytest/model weights)."""
+
+from __future__ import annotations
+
+import math
+
+from pypto.abi import GpuLaunchRequest, TensorDesc
+from pypto.backends.cpu import HostTensor
+from pypto.backends.cuda import CudaDriver, CudaRuntime
+from pypto.compiler.targets.cuda import CudaPtxCompiler
+from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+from pypto.portable.qwen35 import (
+    build_causal_mask,
+    build_decoder_subgraph,
+    build_gqa_repeat_kv,
+    build_rope_rotate_half,
+    build_rms_norm,
+    build_stable_softmax,
+)
+from pypto.target import TargetSpec
+
+
+TARGET = TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)})
+
+
+def _program(parameters, returns, operation):
+    return CoreProgram(
+        functions=(CoreFunction("main", tuple(parameters), tuple(returns), Region((operation,))),)
+    )
+
+
+def _run(compiler, runtime, program, inputs, outputs, scalars=None):
+    target_ir = compiler.lower(program, TARGET)
+    artifact = compiler.compile(target_ir)
+    runtime.launch(
+        GpuLaunchRequest(
+            artifact,
+            geometries=tuple(plan.geometry for plan in target_ir.gpu_program.plans),
+            inputs=tuple(TensorDesc(x.dtype, x.shape, device="gpu", handle=x, readonly=True) for x in inputs),
+            outputs=tuple(TensorDesc(x.dtype, x.shape, device="gpu", handle=x) for x in outputs),
+            scalars=scalars or {},
+        )
+    )
+
+
+def _close(actual, expected, rel=3e-3, absolute=3e-4):
+    for left, right in zip(actual, expected):
+        if math.isnan(right):
+            assert math.isnan(left), (left, right)
+        elif math.isinf(right):
+            assert math.isinf(left) and (left > 0) == (right > 0), (left, right)
+        else:
+            assert math.isclose(left, right, rel_tol=rel, abs_tol=absolute), (left, right)
+
+
+def main():
+    driver = CudaDriver()
+    compiler = CudaPtxCompiler(driver=driver, probe_jit=True)
+    runtime = CudaRuntime(driver=driver)
+    try:
+        print("device={}".format(driver.device_info().to_dict()))
+        values = [-float("inf"), -3.0, -0.0, 0.0, 3.0, float("inf"), float("nan")]
+        for name in ("exp", "rsqrt", "sigmoid", "silu", "softplus"):
+            dtype = CoreType.tensor("float32", (7,))
+            x, z = ValueRef("x", dtype), ValueRef("z", dtype)
+            actual = HostTensor.zeros("float32", (7,))
+            _run(compiler, runtime, _program((x,), (z,), Operation(name, (x,), (z,))), [HostTensor("float32", (7,), values)], [actual])
+            expected = []
+            for value in values:
+                if name == "exp":
+                    expected.append(math.exp(value))
+                elif name == "rsqrt":
+                    expected.append(float("nan") if value < 0 else (float("inf") if value == 0 else 1.0 / math.sqrt(value)))
+                elif name == "sigmoid":
+                    expected.append(1.0 / (1.0 + math.exp(-value)) if value >= 0 else math.exp(value) / (1.0 + math.exp(value)))
+                elif name == "silu":
+                    if value == -float("inf"):
+                        expected.append(0.0)
+                    elif value == float("inf"):
+                        expected.append(float("inf"))
+                    else:
+                        sigmoid = 1.0 / (1.0 + math.exp(-value)) if value >= 0 else math.exp(value) / (1.0 + math.exp(value))
+                        expected.append(value * sigmoid)
+                else:
+                    expected.append(math.log1p(math.exp(-abs(value))) + max(value, 0.0))
+            print("math_name={} actual={} expected={}".format(name, actual.flat(), expected))
+            _close(actual.flat(), expected)
+        print("math_edge=PASS")
+
+        btype = CoreType.tensor("bf16", (5,))
+        left, right, bout = ValueRef("left", btype), ValueRef("right", btype), ValueRef("bout", btype)
+        bf = HostTensor.zeros("bf16", (5,))
+        _run(compiler, runtime, _program((left, right), (bout,), Operation("add", (left, right), (bout,))), [HostTensor("bf16", (5,), [1] * 5), HostTensor("bf16", (5,), [.5] * 5)], [bf])
+        assert bf.flat() == (1.5,) * 5
+        itype, otype = CoreType.tensor("float32", (2, 3)), CoreType.tensor("float32", (2, 1))
+        ix, oz = ValueRef("ix", itype), ValueRef("oz", otype)
+        mean = HostTensor.zeros("float32", (2, 1))
+        _run(compiler, runtime, _program((ix,), (oz,), Operation("reduce_mean", (ix,), (oz,), attributes={"axis": 1, "keepdims": True})), [HostTensor("float32", (2, 3), [1, 2, 3, 4, 5, 6])], [mean])
+        assert mean.flat() == (2.0, 5.0)
+        maxtype, maxouttype = CoreType.tensor("float32", (1, 3)), CoreType.tensor("float32", (1,))
+        mx, mo = ValueRef("mx", maxtype), ValueRef("mo", maxouttype)
+        maximum = HostTensor.zeros("float32", (1,))
+        _run(compiler, runtime, _program((mx,), (mo,), Operation("reduce_max", (mx,), (mo,), attributes={"axis": 1})), [HostTensor("float32", (1, 3), [-9, -4, -7])], [maximum])
+        assert maximum.flat() == (-4.0,)
+        et, eo = CoreType.tensor("float32", (0, 3)), CoreType.tensor("float32", (3,))
+        ex, ez = ValueRef("ex", et), ValueRef("ez", eo)
+        empty = HostTensor.zeros("float32", (3,))
+        _run(compiler, runtime, _program((ex,), (ez,), Operation("reduce_sum", (ex,), (ez,), attributes={"axis": 0})), [HostTensor("float32", (0, 3))], [empty])
+        assert empty.flat() == (0.0, 0.0, 0.0)
+        print("bf16_reduction_edges=PASS")
+
+        iota_ref = ValueRef("iota", CoreType.tensor("int64", (2, 5)))
+        iota = HostTensor.zeros("int64", (2, 5))
+        _run(compiler, runtime, _program((), (iota_ref,), Operation("iota", (), (iota_ref,), attributes={"axis": 1, "start": 7, "step": 2})), [], [iota])
+        assert iota.flat() == (7, 9, 11, 13, 15) * 2
+        ctype, ztype = CoreType.tensor("int32", (5,)), CoreType.tensor("bool", (5,))
+        cx, cy, cz = ValueRef("cx", ctype), ValueRef("cy", ctype), ValueRef("cz", ztype)
+        comparison = HostTensor.zeros("bool", (5,))
+        _run(compiler, runtime, _program((cx, cy), (cz,), Operation("compare", (cx, cy), (cz,), attributes={"predicate": "le"})), [HostTensor("int32", (5,), [1, 3, 2, 4, 5]), HostTensor("int32", (5,), [2, 2, 2, 3, 5])], [comparison])
+        assert comparison.flat() == (True, False, True, False, True)
+        bsource, btarget = ValueRef("bs", CoreType.tensor("float32", (2, 1))), ValueRef("bt", CoreType.tensor("float32", (2, 3)))
+        broadcast = HostTensor.zeros("float32", (2, 3))
+        _run(compiler, runtime, _program((bsource,), (btarget,), Operation("broadcast", (bsource,), (btarget,), attributes={"shape": [2, 3]})), [HostTensor("float32", (2, 1), [2, 5])], [broadcast])
+        assert broadcast.flat() == (2.0, 2.0, 2.0, 5.0, 5.0, 5.0)
+        print("position_broadcast=PASS")
+
+        source, indices, gathered = ValueRef("source", CoreType.tensor("float32", (3, 4))), ValueRef("indices", CoreType.tensor("int64", (2,))), ValueRef("gathered", CoreType.tensor("float32", (2, 4)))
+        gather = HostTensor.zeros("float32", (2, 4))
+        _run(compiler, runtime, _program((source, indices), (gathered,), Operation("gather", (source, indices), (gathered,), attributes={"axis": 0})), [HostTensor("float32", (3, 4), list(range(12))), HostTensor("int64", (2,), [2, 0])], [gather])
+        assert gather.flat() == (8.0, 9.0, 10.0, 11.0, 0.0, 1.0, 2.0, 3.0)
+        sx, sa, sb = ValueRef("sx", CoreType.tensor("float32", (2, 6))), ValueRef("sa", CoreType.tensor("float32", (2, 2))), ValueRef("sb", CoreType.tensor("float32", (2, 4)))
+        split_a, split_b = HostTensor.zeros("float32", (2, 2)), HostTensor.zeros("float32", (2, 4))
+        _run(compiler, runtime, _program((sx,), (sa, sb), Operation("split", (sx,), (sa, sb), attributes={"axis": 1, "sizes": [2, 4]})), [HostTensor("float32", (2, 6), list(range(12)))], [split_a, split_b])
+        assert split_a.flat() == (0.0, 1.0, 6.0, 7.0)
+        assert split_b.flat() == (2.0, 3.0, 4.0, 5.0, 8.0, 9.0, 10.0, 11.0)
+        print("layout_indexing_split=PASS")
+
+        softmax = HostTensor.zeros("bf16", (2, 4))
+        _run(compiler, runtime, build_stable_softmax((2, 4)), [HostTensor("bf16", (2, 4), [1, 2, 3, 4, 4, 3, 2, 1])], [softmax])
+        assert abs(sum(softmax.flat()[:4]) - 1.0) < .02
+        rms = HostTensor.zeros("bf16", (2, 4))
+        _run(compiler, runtime, build_rms_norm((2, 4)), [HostTensor("bf16", (2, 4), [1, 2, 3, 4, 5, 6, 7, 8]), HostTensor("bf16", (4,), [1] * 4)], [rms], {"epsilon": 1e-5})
+        causal = HostTensor.zeros("bf16", (2, 3))
+        _run(compiler, runtime, build_causal_mask((2, 3), dtype="bf16"), [HostTensor("bf16", (2, 3), [1, 2, 3, 4, 5, 6]), HostTensor("bool", (2, 3), [True, False, True, False, True, False])], [causal], {"fill_value": -100.0})
+        assert causal.flat() == (1.0, -100.0, 3.0, -100.0, 5.0, -100.0)
+        rope = HostTensor.zeros("bf16", (1, 2, 3, 8))
+        _run(compiler, runtime, build_rope_rotate_half((1, 2, 3, 8), rotary_dim=4), [HostTensor("bf16", (1, 2, 3, 8), list(range(48))), HostTensor("bf16", (1, 2, 3, 4), [1] * 24), HostTensor("bf16", (1, 2, 3, 4), [0] * 24)], [rope])
