+        gqa = HostTensor.zeros("bf16", (3, 4))
+        _run(compiler, runtime, build_gqa_repeat_kv((3, 2), 4), [HostTensor("bf16", (3, 2), list(range(6))), HostTensor("int64", (4,), [0, 1, 0, 1])], [gqa])
