+    source_coordinates[descriptor->axis] = selected;
+    for (axis = descriptor->axis + 1; axis < descriptor->source_rank; ++axis)
+        source_coordinates[axis] = coordinates[axis + descriptor->index_rank - 1];
+    for (axis = 0; axis < descriptor->source_rank; ++axis) {
+        if (ptx_u64_mul(source_coordinates[axis], descriptor->source_strides[axis], &value) != PTX_STATUS_OK ||
+            ptx_u64_add(offset, value, &offset) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    }
+    if (offset >= descriptor->source_elements) return PTX_STATUS_BAD_REQUEST;
+    *source_index = offset;
+    return PTX_STATUS_OK;
+}
