+static int ptx_read_index(const unsigned char *indices, uint64_t index,
+                          uint32_t index_dtype, uint64_t axis_length, uint64_t *value) {
+    if (index_dtype == PTX_INDEX_DTYPE_I32) {
+        int32_t selected;
+        memcpy(&selected, indices + index * sizeof(selected), sizeof(selected));
+        if (selected < 0 || (uint64_t)selected >= axis_length) return PTX_STATUS_BAD_REQUEST;
+        *value = (uint64_t)selected;
+    } else if (index_dtype == PTX_INDEX_DTYPE_I64) {
+        int64_t selected;
