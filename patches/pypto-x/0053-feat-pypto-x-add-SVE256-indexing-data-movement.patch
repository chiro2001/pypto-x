+    input_shapes = [static_shape(value_type, context + ".input") for value_type in input_types]
+    output_shape = static_shape(output_type, context + ".output")
+    axis = attributes.get("axis", attributes.get("dim", 0))
+    if not isinstance(axis, int) or isinstance(axis, bool):
+        raise CpuVectorExecutionError("{} concat axis must be an integer".format(context))
