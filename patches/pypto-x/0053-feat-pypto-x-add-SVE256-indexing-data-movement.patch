+def _split_descriptor_bytes(split: Any, output_index: int) -> bytes:
+    output_index = _u32_descriptor(output_index, "split.output_index")
+    if output_index >= len(split.output_shapes):
+        raise CpuSve256ExecutionError("split output index is outside output count")
+    rank = _u32_descriptor(len(split.input_shape), "split.input_rank")
+    output_count = _u32_descriptor(len(split.sizes), "split.output_count")
+    descriptor = _SPLIT_DESC_HEADER.pack(
+        b"PXSP", 1, _u32_descriptor(split.axis, "split.axis"), output_index,
+        rank, output_count, _u64_descriptor(split.source_elements, "split.source_elements"),
+        _u64_descriptor(element_count(split.output_shapes[output_index]), "split.output_elements"),
+    )
+    return descriptor + _pack_u64_values(split.input_shape, "split.input_shape") + _pack_u64_values(split.sizes, "split.sizes")
+
+
+def _concat_descriptor_bytes(concat: Any) -> bytes:
+    rank = _u32_descriptor(len(concat.output_shape), "concat.rank")
+    input_count = _u32_descriptor(len(concat.input_shapes), "concat.input_count")
+    descriptor = _CONCAT_DESC_HEADER.pack(
+        b"PXCT", 1, _u32_descriptor(concat.axis, "concat.axis"), rank, input_count,
+        _u64_descriptor(concat.output_elements, "concat.output_elements"),
+        _u64_descriptor(concat.input_elements, "concat.input_elements"),
+    )
+    return descriptor + _pack_u64_values(concat.output_shape, "concat.output_shape") + _pack_u64_values(concat.sizes, "concat.sizes")
+
+
+def _index_descriptor_bytes(indexing: Any, index_dtype: str) -> bytes:
+    code = _INDEX_DTYPE_CODES.get(canonical_dtype(index_dtype))
+    if code is None:
+        raise CpuSve256ExecutionError("SVE256 indexing requires int32 or int64 indices")
+    descriptor = _INDEX_DESC_HEADER.pack(
+        b"PXIX", _INDEX_DESC_VERSION, _u32_descriptor(indexing.axis, "indexing.axis"),
+        _u32_descriptor(len(indexing.source_shape), "indexing.source_rank"),
+        _u32_descriptor(len(indexing.index_shape), "indexing.index_rank"),
+        _u32_descriptor(len(indexing.output_shape), "indexing.output_rank"), code, 0,
+        _u64_descriptor(indexing.source_elements, "indexing.source_elements"),
+        _u64_descriptor(indexing.index_elements, "indexing.index_elements"),
+        _u64_descriptor(indexing.output_elements, "indexing.output_elements"),
+    )
+    return descriptor + b"".join(
+        _pack_u64_values(values, label)
+        for values, label in (
+            (indexing.source_shape, "indexing.source_shape"),
+            (indexing.index_shape, "indexing.index_shape"),
+            (indexing.output_shape, "indexing.output_shape"),
+            (indexing.source_strides, "indexing.source_strides"),
+        )
+    )
