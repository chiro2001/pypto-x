+    descriptor->source_rank = source_rank;
+    descriptor->index_rank = index_rank;
+    descriptor->output_rank = output_rank;
+    descriptor->index_dtype = ptx_read_u32(bytes + 24);
+    descriptor->source_elements = ptx_read_u64(bytes + 32);
+    descriptor->index_elements = ptx_read_u64(bytes + 40);
+    descriptor->output_elements = ptx_read_u64(bytes + 48);
+    descriptor->storage = (uint64_t *)calloc(1, storage_bytes ? storage_bytes : sizeof(uint64_t));
+    if (!descriptor->storage) return PTX_STATUS_RUNTIME;
+    descriptor->source_shape = descriptor->storage;
+    descriptor->index_shape = descriptor->source_shape + source_rank;
+    descriptor->output_shape = descriptor->index_shape + index_rank;
+    descriptor->source_strides = descriptor->output_shape + output_rank;
+    cursor = 56U;
+    memcpy(descriptor->source_shape, bytes + cursor, source_rank * sizeof(uint64_t));
+    cursor += source_rank * sizeof(uint64_t);
+    memcpy(descriptor->index_shape, bytes + cursor, index_rank * sizeof(uint64_t));
+    cursor += index_rank * sizeof(uint64_t);
+    memcpy(descriptor->output_shape, bytes + cursor, output_rank * sizeof(uint64_t));
+    cursor += output_rank * sizeof(uint64_t);
