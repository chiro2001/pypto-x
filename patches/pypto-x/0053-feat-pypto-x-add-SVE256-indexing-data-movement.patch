+def _split_values(
+    value: Any,
+    input_type: CoreType,
+    output_types: Sequence[CoreType],
+    attributes: Mapping[str, Any],
+    context: str,
+) -> Tuple[List[Any], ...]:
+    if not isinstance(value, list):
+        raise CpuVectorExecutionError("{} split requires tensor storage".format(context))
+    input_shape = static_shape(input_type, context + ".input")
+    axis, sizes = _m1b_split_sizes(input_shape, output_types, attributes, context + ".split")
+    result = []
+    offset = 0
+    for output_type, size in zip(output_types, sizes):
+        output_shape = static_shape(output_type, context + ".output")
+        values = []
+        for output_index in range(element_count(output_shape)):
+            coords = list(_unravel(output_index, output_shape))
+            coords[axis] += offset
+            values.append(value[_ravel(coords, input_shape)])
+        result.append(values)
+        offset += size
+    return tuple(result)
+
