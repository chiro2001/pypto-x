+def test_indexing_plans_are_compact_and_vector_reference_matches_scalar(tmp_path):
+    source = ValueRef("source", CoreType.tensor("float32", (2, 3, 4)))
+    indices = ValueRef("indices", CoreType.tensor("int64", (2, 1)))
+    output = ValueRef("output", CoreType.tensor("float32", (2, 2, 1, 4)))
+    program = _program("gather", (source, indices), (output,), {"axis": 1})
+    vector_ir = lower_cpu_vector(program, VECTOR_TARGET)
+    plan = vector_ir.plans[0]
+    serialized = json.dumps(plan.to_dict(), sort_keys=True, separators=(",", ":"))
+    assert plan.plan_kind == "indexing"
+    assert plan.iteration.compact and plan.iteration.chunks == ()
+    assert "index_map" not in serialized
+    assert len(serialized) < 4096
+
+    artifact = CpuVectorCompiler().compile(CpuVectorCompiler().lower(program, VECTOR_TARGET))
+    actual = HostTensor.zeros("float32", (2, 2, 1, 4))
+    _launch(CpuVectorRuntime(("avx2",)), artifact, [
+        HostTensor("float32", (2, 3, 4), list(range(24))),
+        HostTensor("int64", (2, 1), [[2], [0]]),
+    ], [actual])
+    assert actual.flat() == (8.0, 9.0, 10.0, 11.0, 0.0, 1.0, 2.0, 3.0,
+                             20.0, 21.0, 22.0, 23.0, 12.0, 13.0, 14.0, 15.0)
+
