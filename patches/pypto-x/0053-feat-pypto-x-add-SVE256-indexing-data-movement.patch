+static int ptx_index_source_index(const PtxIndexDescriptor *descriptor,
+                                  const unsigned char *indices, uint64_t output_index,
+                                  uint64_t *source_index) {
+    uint64_t coordinates[PTX_INDEX_MAX_RANK] = {0};
+    uint64_t source_coordinates[PTX_INDEX_MAX_RANK] = {0};
+    uint64_t remaining = output_index, index_offset = 0, selected, value, offset = 0;
+    uint32_t axis, current;
+    for (axis = descriptor->output_rank; axis > 0; --axis) {
+        current = axis - 1;
+        if (descriptor->output_shape[current]) {
+            coordinates[current] = remaining % descriptor->output_shape[current];
+            remaining /= descriptor->output_shape[current];
+        }
+    }
+    for (axis = 0; axis < descriptor->index_rank; ++axis) {
+        if (ptx_u64_mul(index_offset, descriptor->index_shape[axis], &index_offset) != PTX_STATUS_OK ||
+            ptx_u64_add(index_offset, coordinates[descriptor->axis + axis], &index_offset) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    }
+    if (ptx_read_index(indices, index_offset, descriptor->index_dtype,
+                       descriptor->source_shape[descriptor->axis], &selected) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
