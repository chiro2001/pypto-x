+def test_sve256_indexing_metadata_is_rank_and_output_count_bounded(tmp_path):
+    source = ValueRef("source", CoreType.tensor("float32", (32768, 2048)))
+    indices = ValueRef("indices", CoreType.tensor("int32", (4,)))
+    output = ValueRef("output", CoreType.tensor("float32", (32768, 4)))
+    program = _program("gather", (source, indices), (output,), {"axis": 1})
+    target_ir, artifact = _compile_sve(program, tmp_path)
+    plan_text = json.dumps(target_ir.plans[0].to_dict(), separators=(",", ":"))
+    metadata_text = json.dumps(
+        {
+            "indexing_operations": [dict(item) for item in artifact.metadata["indexing_operations"]],
+            "indexing_descriptor_wire": artifact.metadata["indexing_descriptor_wire"],
+        },
+        separators=(",", ":"),
+    )
+    assert "index_map" not in plan_text
+    assert len(plan_text) < 4096
+    assert len(metadata_text) < 8192
