+def _u32_descriptor(value: Any, context: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0 or value > 0xFFFFFFFF:
+        raise CpuSve256ExecutionError("{} does not fit uint32".format(context))
+    return value
+
+
+def _u64_descriptor(value: Any, context: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0 or value > (1 << 64) - 1:
+        raise CpuSve256ExecutionError("{} does not fit uint64".format(context))
+    return value
+
+
+def _pack_u64_values(values: Sequence[int], context: str) -> bytes:
+    normalized = [_u64_descriptor(value, "{}[{}]".format(context, index)) for index, value in enumerate(values)]
+    return struct.pack("<{}Q".format(len(normalized)), *normalized) if normalized else b""
+
