+    for (axis = 0; axis < descriptor->index_rank; ++axis)
+        if (ptx_u64_mul(output_product, descriptor->index_shape[axis], &output_product) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    if (output_product != index_elements) return PTX_STATUS_BAD_REQUEST;
+    product = 1;
+    for (dimension = 0; dimension < descriptor->output_rank; ++dimension) {
+        uint64_t expected = dimension < descriptor->axis ? descriptor->source_shape[dimension] :
+            dimension < descriptor->axis + descriptor->index_rank ? descriptor->index_shape[dimension - descriptor->axis] :
+            descriptor->source_shape[dimension - descriptor->index_rank + 1];
+        if (descriptor->output_shape[dimension] != expected ||
+            ptx_u64_mul(product, descriptor->output_shape[dimension], &product) != PTX_STATUS_OK)
+            return PTX_STATUS_BAD_REQUEST;
+    }
+    if (product != output_elements) return PTX_STATUS_BAD_REQUEST;
+    if (operation == PTX_EMBEDDING && descriptor->axis != 0) return PTX_STATUS_BAD_REQUEST;
+    return PTX_STATUS_OK;
