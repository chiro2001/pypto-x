+    uint64_t count, storage_u64;
+    size_t expected, storage_bytes, cursor;
+    if (length < 56U || memcmp(bytes, "PXIX", 4) != 0 ||
+        ptx_read_u32(bytes + 4) != PTX_INDEX_DESC_VERSION)
+        return PTX_STATUS_BAD_REQUEST;
+    source_rank = ptx_read_u32(bytes + 12);
+    index_rank = ptx_read_u32(bytes + 16);
+    output_rank = ptx_read_u32(bytes + 20);
+    if (source_rank == 0 || source_rank > PTX_INDEX_MAX_RANK || index_rank > PTX_INDEX_MAX_RANK || output_rank > PTX_INDEX_MAX_RANK)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_u64_add((uint64_t)source_rank * 2U + index_rank + output_rank, 0, &count) != PTX_STATUS_OK ||
+        ptx_u64_mul(count, sizeof(uint64_t), &count) != PTX_STATUS_OK ||
+        ptx_u64_add(56U, count, &count) != PTX_STATUS_OK ||
+        ptx_u64_to_size(count, &expected) != PTX_STATUS_OK || expected != length)
+        return PTX_STATUS_BAD_REQUEST;
+    if (ptx_u64_mul(count, sizeof(uint64_t), &storage_u64) != PTX_STATUS_OK ||
+        ptx_u64_to_size(storage_u64, &storage_bytes) != PTX_STATUS_OK)
+        return PTX_STATUS_BAD_REQUEST;
