+@pytest.mark.parametrize("dtype", ("float32", "bf16"))
+def test_sve256_indexing_split_concat_gather_embedding_differential(dtype, tmp_path):
+    qemu = shutil.which("qemu-aarch64")
+    if qemu is None:
+        pytest.skip("qemu-aarch64 is unavailable")
+    runtime = Sve256Runtime(execution_mode="qemu")
+    values = [index * 0.25 - 1.0 for index in range(12)]
+
+    source = ValueRef("source", CoreType.tensor(dtype, (2, 6)))
+    left = ValueRef("left", CoreType.tensor(dtype, (2, 2)))
+    middle = ValueRef("middle", CoreType.tensor(dtype, (2, 1)))
+    right = ValueRef("right", CoreType.tensor(dtype, (2, 3)))
+    split_program = _program("split", (source,), (left, middle, right), {"sizes": [2, 1, 3], "axis": -1})
+    _, split_artifact = _compile_sve(split_program, tmp_path / ("split-" + dtype))
+    split_inputs = [HostTensor(dtype, (2, 6), values)]
+    split_outputs = [HostTensor.zeros(dtype, shape) for shape in ((2, 2), (2, 1), (2, 3))]
+    _launch(runtime, split_artifact, split_inputs, split_outputs)
+    assert split_outputs[0].flat() == HostTensor(dtype, (2, 2), values[:2] + values[6:8]).flat()
+    assert split_outputs[1].flat() == HostTensor(dtype, (2, 1), values[2:3] + values[8:9]).flat()
+    assert split_outputs[2].flat() == HostTensor(dtype, (2, 3), values[3:6] + values[9:12]).flat()
+
+    first = ValueRef("first", CoreType.tensor(dtype, (2, 0)))
+    second = ValueRef("second", CoreType.tensor(dtype, (2, 2)))
+    third = ValueRef("third", CoreType.tensor(dtype, (2, 1)))
+    concat_output = ValueRef("output", CoreType.tensor(dtype, (2, 3)))
+    concat_program = _program(
+        "concat", (first, second, third), (concat_output,), {"axis": -1}
+    )
+    _, concat_artifact = _compile_sve(concat_program, tmp_path / ("concat-" + dtype))
+    concat = HostTensor.zeros(dtype, (2, 3))
+    _launch(runtime, concat_artifact, [
+        HostTensor.zeros(dtype, (2, 0)),
+        HostTensor(dtype, (2, 2), [[1, 2], [3, 4]]),
+        HostTensor(dtype, (2, 1), [[5], [6]]),
+    ], [concat])
+    assert concat.tolist() == [[1.0, 2.0, 5.0], [3.0, 4.0, 6.0]]
+
+    gather_source = ValueRef("source", CoreType.tensor(dtype, (2, 3, 4)))
+    gather_indices = ValueRef("indices", CoreType.tensor("int64", (2, 1)))
+    gather_output = ValueRef("output", CoreType.tensor(dtype, (2, 2, 1, 4)))
+    gather_program = _program("gather", (gather_source, gather_indices), (gather_output,), {"axis": 1})
+    _, gather_artifact = _compile_sve(gather_program, tmp_path / ("gather-" + dtype))
+    gathered = HostTensor.zeros(dtype, (2, 2, 1, 4))
+    _launch(runtime, gather_artifact, [
+        HostTensor(dtype, (2, 3, 4), [float(index) for index in range(24)]),
+        HostTensor("int64", (2, 1), [[2], [0]]),
+    ], [gathered])
+    assert gathered.flat() == HostTensor(dtype, (2, 2, 1, 4), [
+        8.0, 9.0, 10.0, 11.0, 0.0, 1.0, 2.0, 3.0,
+        20.0, 21.0, 22.0, 23.0, 12.0, 13.0, 14.0, 15.0,
+    ]).flat()
+
+    embedding_source = ValueRef("source", CoreType.tensor(dtype, (4, 2)))
+    embedding_indices = ValueRef("indices", CoreType.tensor("int32", (2,)))
+    embedding_output = ValueRef("output", CoreType.tensor(dtype, (2, 2)))
+    embedding_program = _program("embedding", (embedding_source, embedding_indices), (embedding_output,))
+    _, embedding_artifact = _compile_sve(embedding_program, tmp_path / ("embedding-" + dtype))
+    embedded = HostTensor.zeros(dtype, (2, 2))
+    _launch(runtime, embedding_artifact, [
+        HostTensor(dtype, (4, 2), list(range(8))),
+        HostTensor("int32", (2,), [3, 1]),
+    ], [embedded])
+    assert embedded.tolist() == [[6.0, 7.0], [2.0, 3.0]]
