+def test_sve256_indexing_rejects_bad_indices_and_wire_versions(tmp_path):
+    source = ValueRef("source", CoreType.tensor("float32", (2, 3, 4)))
+    indices = ValueRef("indices", CoreType.tensor("int64", (2, 1)))
+    output = ValueRef("output", CoreType.tensor("float32", (2, 2, 1, 4)))
+    program = _program("gather", (source, indices), (output,), {"axis": 1})
+    target_ir, artifact = _compile_sve(program, tmp_path)
+    runtime = Sve256Runtime(execution_mode="qemu")
+    with pytest.raises(CpuSve256ExecutionError, match="outside axis"):
+        _launch(runtime, artifact, [
+            HostTensor("float32", (2, 3, 4), list(range(24))),
+            HostTensor("int64", (2, 1), [[-1], [0]]),
+        ], [HostTensor.zeros("float32", (2, 2, 1, 4))])
+
+    descriptor = _index_descriptor_bytes(target_ir.plans[0].indexing_plan, "int64")
+    source_bytes = struct.pack("<24f", *([1.0] * 24))
+    indices_bytes = struct.pack("<2q", 0, 1)
+    header = struct.pack(
+        "<6I4Q", 0x56535850, 3, 25, 0, 2, len(descriptor), 16, 24, 2,
+        _layout_wire_hash(descriptor),
+    )
+    qemu = shutil.which("qemu-aarch64")
+    if qemu is None:
+        pytest.skip("qemu-aarch64 is unavailable")
+    result = subprocess.run(
+        [qemu, "-L", "/usr/aarch64-linux-gnu", "-cpu", "max,sve256=on", artifact.path],
+        input=header + source_bytes + indices_bytes + descriptor,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    assert result.returncode != 0 and result.returncode != -11
+    assert len(result.stdout) >= 24
+    magic, version, status, _dtype, _count = struct.unpack("<4IQ", result.stdout[:24])
+    assert magic == 0x56535850 and version == 3 and status != 0
+
