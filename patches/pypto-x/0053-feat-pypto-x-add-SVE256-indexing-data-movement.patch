+def _program(name, inputs, outputs, attributes=None):
+    operation = Operation(name, tuple(inputs), tuple(outputs), attributes=attributes or {})
+    return CoreProgram(functions=(CoreFunction(name, tuple(inputs), tuple(outputs), Region((operation,))),))
+
+
+def _compile_sve(program, tmp_path):
+    compiler = Sve256Compiler()
+    target_ir = compiler.lower(program, SVE_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.sve256",
+            extra={"build_dir": str(tmp_path / "build")},
+        ),
+    )
+    return target_ir, artifact
+
+
+def _launch(runtime, artifact, inputs, outputs):
+    return runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[tensor.descriptor(readonly=True) for tensor in inputs],
+            outputs=[tensor.descriptor() for tensor in outputs],
+        )
+    )
+
