+# ---------------------------------------------------------------------------
+# 0. session hygiene: the real pypto package must survive these imports
+# ---------------------------------------------------------------------------
+def test_real_pypto_package_survives_op_bench_imports():
+    """Guard the 2026-09-12 session-pollution regression.
+
+    A collection-time fake ``pypto`` package without ``__portable_only__``
+    stayed in ``sys.modules`` and made later test files take the classic
+    frontend branch (10 failed in the canonical full suite).  The real
+    package must remain in place, in portable-only mode, after op-bench is
+    imported and exercised.
+    """
+
+    import pypto as imported
+
+    assert sys.modules.get("pypto") is imported
+    assert getattr(imported, "__portable_only__", False) is True
+    assert imported.__file__ is not None and Path(imported.__file__).name == "__init__.py"
+    resolved = Path(imported.__file__).resolve()
+    worktree_init = (REPO_ROOT / "python" / "pypto" / "__init__.py").resolve()
+    if str(REPO_ROOT.resolve()) in str(resolved):
+        # canonical PYTHONPATH=python run: the worktree copy must win
+        assert resolved == worktree_init
+
+    # the real submodules op-bench uses must be loaded from the real package
+    import pypto.op_bench as op_bench_module
+
+    assert sys.modules.get("pypto.op_bench") is op_bench_module
+    assert Path(op_bench_module.__file__).name == "__init__.py"
+
+    # a later test file importing the frontend must take the portable-only
+    # branch (the fake package made this raise AttributeError at import time)
+    import pypto.frontend as frontend
+
+    assert getattr(frontend, "__portable_only__", False) is True
 
 
