From 4a1f21e300c04708962b7e85f5fdf2c496788d16 Mon Sep 17 00:00:00 2001
From: Chiro <chiro2001@163.com>
Date: Mon, 7 Sep 2026 01:44:58 +0800
Subject: [PATCH 007/144] chore(pypto-x): scaffold target implementation
 packages

---
 pyproject.toml                            | 4 ++++
 python/pypto/backends/__init__.py         | 7 +++++++
 python/pypto/compiler/targets/__init__.py | 3 +++
 python/pypto/lowering/__init__.py         | 3 +++
 4 files changed, 17 insertions(+)

diff --git a/pyproject.toml b/pyproject.toml
index 829454d87..e00e6a89e 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -78,12 +78,16 @@ packages.find.include = [
     "pypto",
     "pypto.abi",
     "pypto.abi.*",
+    "pypto.backends",
+    "pypto.backends.*",
     "pypto.compiler",
     "pypto.compiler.*",
     "pypto.core_ir",
     "pypto.core_ir.*",
     "pypto.frontend",
     "pypto.frontend.*",
+    "pypto.lowering",
+    "pypto.lowering.*",
     "pypto_pro",
     "pypto_pro.*",
     "pypto.op",
diff --git a/python/pypto/backends/__init__.py b/python/pypto/backends/__init__.py
new file mode 100644
index 000000000..6dd480372
--- /dev/null
+++ b/python/pypto/backends/__init__.py
@@ -0,0 +1,7 @@
+"""PyPTO-X target adapters.
+
+Vendor runtimes are intentionally not imported from this package initializer.
+Callers select a concrete backend explicitly through its target module.
+"""
+
+__all__ = []
diff --git a/python/pypto/compiler/targets/__init__.py b/python/pypto/compiler/targets/__init__.py
new file mode 100644
index 000000000..d1c57a54a
--- /dev/null
+++ b/python/pypto/compiler/targets/__init__.py
@@ -0,0 +1,3 @@
+"""Compiler backend implementations selected by a normalized TargetSpec."""
+
+__all__ = []
diff --git a/python/pypto/lowering/__init__.py b/python/pypto/lowering/__init__.py
new file mode 100644
index 000000000..b5a90074d
--- /dev/null
+++ b/python/pypto/lowering/__init__.py
@@ -0,0 +1,3 @@
+"""Target lowering packages for the portable Core IR."""
+
+__all__ = []
