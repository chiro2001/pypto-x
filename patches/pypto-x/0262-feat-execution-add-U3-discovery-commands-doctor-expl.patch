+def test_cli_fails_closed_with_structured_error(tmp_path):
+    completed = _run_cli(
+        "plan", "--op", "add", "--left", "2,3", "--right", "3,4", "--dtype", "float32",
+        "--json", cwd=tmp_path,
+    )
+    assert completed.returncode == 1
+    error = json.loads(completed.stdout)
+    assert error["code"] == OP_CONTRACT_INVALID
+    assert error["reason"] == "opcode_not_registered"
+
+    bad_snapshot = tmp_path / "snapshot.json"
+    bad_snapshot.write_text(json.dumps({"schema_version": 2}), encoding="utf-8")
+    completed = _run_cli("doctor", "--snapshot", str(bad_snapshot), "--json", cwd=tmp_path)
+    assert completed.returncode == 1
+    error = json.loads(completed.stdout)
+    assert error["code"] == ARTIFACT_MISMATCH
