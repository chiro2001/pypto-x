@@ -0,0 +1,1140 @@
+"""U3 discovery layer: ``doctor`` / ``explain`` / ``plan`` + snapshot I/O.
+
+The three commands expose the U1/U2 execution machinery without executing
+anything:
+
+* :func:`doctor` reports facts (host probe, registered contracts, provider
+  manifests, pinned-library fingerprints, policy-related environment status,
+  fail-closed checks) as a machine-readable, digest-carrying document plus a
+  human summary.  It is read-only, probes only the pinned artifacts and never
+  echoes raw environment values or any private endpoint/credential.
+* :func:`explain` is a view over the resolver trace (``resolution.rules``,
+  ``candidates`` with per-check records, ``rejections``, fallback chain and
+  events) for either a fresh request, a frozen plan document or a v4 report.
+  It does not re-run selection logic and does not execute.
+* :func:`plan_request` freezes a request into an ``ExecutionPlan`` and returns
+  the capability snapshot (with its digest) that was used, without executing.
+  Replaying the same snapshot + policy produces the same plan digest and is
+  accepted by ``execute_matmul_plan`` / ``execute_qmatmul_plan``.
+
+Capability snapshots are exported with :func:`export_capability_snapshot` and
+imported with the fail-closed :func:`import_capability_snapshot`, which
+requires the registered schema version, a ``sha256:`` digest and a canonical
+structure (unknown/missing/extra fields are refused, never guessed).
+
+Every discovery document is versioned with ``DISCOVERY_SCHEMA_VERSION`` and
+carries a canonical ``digest``.  No performance claim is made anywhere:
+runtime numbers remain ``UNGATED`` and are only copied from a validated
+report.
+"""
+
+from __future__ import annotations
+
+import os
+import platform
+import sys
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Tuple
+
+from pypto.target._utils import canonical_json, mapping_copy, sha256_text
+
+from .capability import (
+    CAPABILITY_SCHEMA_VERSION,
+    CapabilitySnapshot,
+    host_features,
+    host_triple,
+)
+from .entry import _explain as _entry_explain, capability_for_policy
+from .errors import (
+    ArtifactMismatchError,
+    CapabilityUnavailableError,
+    OpContractError,
+    PolicyInvalidValueError,
+    ReportSchemaError,
+)
+from .op_registry import (
+    OP_REGISTRY_SCHEMA_VERSION,
+    get_op_definition,
+    lookup_canonical_opcode,
+    registered_opcodes,
+)
+from .plan import PLAN_SCHEMA_VERSION, ExecutionPlan
+from .policy import POLICY_SCHEMA_VERSION, ExecutionPolicy
+from .report import REPORT_SCHEMA_VERSION, validate_report_schema
+from .resolver import resolve_matmul, resolve_qmatmul
+from .provider_identity import (
+    expected_artifact_digest,
+    library_pin_errors,
+    registered_identity,
+)
+from .provider_aocl import AOCL_BLIS_TAG, AOCL_ARCH_STRING, AOCL_SHA256_PIN
+from .provider_ids import PORTABLE_PROVIDER_ID
+
+
+DISCOVERY_SCHEMA_VERSION = 1
+
+#: Request-level opcode spellings accepted by the discovery commands.
+SUPPORTED_DISCOVERY_OPS = ("matmul", "qmatmul_s8s8_s32")
+
+#: Fields that are only decidable by an actual execution, not by resolution.
+EXPLAIN_BOUNDARIES = (
+    {
+        "field": "timing.*",
+        "layer": "execution",
+        "why": "wall-clock observations from a real launch; permanently UNGATED on this host",
+    },
+    {
+        "field": "artifact.content_digest / artifact.abi_version / artifact.format",
+        "layer": "execution",
+        "why": "observed from the compiled/loaded artifact handed to the runtime",
+    },
+    {
+        "field": "dispatch.* reconciliation flags",
+        "layer": "execution",
+        "why": "compare the runtime invocation against the frozen declaration",
+    },
+    {
+        "field": "resources.parallelism.thread_state",
+        "layer": "execution",
+        "why": "recorded after the provider library is loaded and thread mode applied",
+    },
+    {
+        "field": "coverage.* runtime counts",
+        "layer": "execution",
+        "why": "count actual provider invocations/artifacts, not plan candidates",
+    },
+    {
+        "field": "gates.*",
+        "layer": "execution",
+        "why": "gate state is attached by the runtime environment, not by the resolver",
+    },
+    {
+        "field": "provider manifest runtime facts (default_threads, loaded thread state)",
+        "layer": "execution/probe",
+        "why": "probed when the provider library is loaded; an imported snapshot reports its captured facts",
+    },
+)
+
+#: Policy-related environment variables.  Only these names are read by the
+#: doctor command; raw values are never echoed (only a typed interpretation).
+ENV_VAR_REGISTRY = (
+    {
+        "name": "PYPTO_X_PORTABLE_ONLY",
+        "class": "compat_alias",
+        "policy_field": "profile / provider.mode",
+        "consumed_by_execution": False,
+        "value_kind": "flag",
+        "source": "docs/10-architecture/0006 section 9.1",
+    },
+    {
+        "name": "OMP_NUM_THREADS",
+        "class": "provider_thread_env",
+        "policy_field": "resources.max_threads (vendor provider thread state)",
+        "consumed_by_execution": True,
+        "value_kind": "integer",
+        "source": "pinned AOCL/BLIS OpenMP thread env",
+    },
+    {
+        "name": "BLIS_NUM_THREADS",
+        "class": "provider_thread_env",
+        "policy_field": "resources.max_threads (vendor provider thread state)",
+        "consumed_by_execution": True,
+        "value_kind": "integer",
+        "source": "pinned AOCL/BLIS thread env",
+    },
+    {
+        "name": "PYPTO_X_AVX512_GEMM_THREADS",
+        "class": "legacy_not_consumed",
+        "policy_field": "resources.max_threads",
+        "consumed_by_execution": False,
+        "value_kind": "integer",
+        "source": "docs/10-architecture/0006 section 9.1 (U4 migration target)",
+    },
+    {
+        "name": "PYPTO_X_VLLM_GEMM_THREADS",
+        "class": "legacy_not_consumed",
+        "policy_field": "resources.max_threads",
+        "consumed_by_execution": False,
+        "value_kind": "integer",
+        "source": "docs/10-architecture/0006 section 9.1 (U4 migration target)",
+    },
+    {
+        "name": "PYPTO_X_ASCEND_DEVICE_ID",
+        "class": "declared_not_consumed",
+        "policy_field": "placement.device",
+        "consumed_by_execution": False,
+        "value_kind": "integer",
+        "source": "docs/10-architecture/0006 section 9.1 (no Ascend provider in this slice)",
+    },
+)
+
+_REQUIRED_SNAPSHOT_KEYS = ("schema_version", "kind", "triple", "features", "providers", "digest")
+
+
+def _digest(document: Mapping[str, Any]) -> str:
+    return "sha256:" + sha256_text(document)
+
+
+def _error_details(exc: Any) -> Mapping[str, Any]:
+    if hasattr(exc, "to_dict"):
+        return dict(exc.to_dict())
+    return {"message": str(exc)}
+
+
+def _check(name: str, ok: bool, reason: str = "", details: Optional[Mapping[str, Any]] = None) -> Mapping[str, Any]:
+    return {
+        "check": name,
+        "status": "ok" if ok else "failed",
+        "reason": "" if ok else reason,
+        "details": dict(details or {}),
+    }
+
+
+# ---------------------------------------------------------------------------
+# capability snapshot export / import
+# ---------------------------------------------------------------------------
+def export_capability_snapshot(snapshot: CapabilitySnapshot) -> Mapping[str, Any]:
+    """Return the canonical, digest-carrying document of one snapshot."""
+
+    if not isinstance(snapshot, CapabilitySnapshot):
+        raise CapabilityUnavailableError(
+            "snapshot must be a CapabilitySnapshot",
+            field="snapshot",
+            requested=type(snapshot).__name__,
+            reason="not_a_capability_snapshot",
+        )
+    snapshot.verify_digest()
+    return snapshot.to_dict()
+
+
+def import_capability_snapshot(document: Mapping[str, Any]) -> CapabilitySnapshot:
+    """Fail-closed import of an exported capability snapshot.
+
+    Unlike the permissive :meth:`CapabilitySnapshot.from_dict` (a registered
+    U1 boundary used by tests), discovery imports require the exact registered
+    schema, a ``sha256:`` digest and the canonical structure emitted by
+    :func:`export_capability_snapshot`.  Extra, missing or non-canonical
+    fields are refused, never defaulted.
+    """
+
+    if not isinstance(document, Mapping):
+        raise CapabilityUnavailableError(
+            "capability snapshot document must be a mapping",
+            field="snapshot",
+            requested=type(document).__name__,
+            reason="not_a_mapping",
+        )
+    missing = [key for key in _REQUIRED_SNAPSHOT_KEYS if key not in document]
+    if missing:
+        raise ArtifactMismatchError(
+            "capability snapshot document is missing required fields",
+            field="snapshot",
+            requested=sorted(document),
+            available=list(_REQUIRED_SNAPSHOT_KEYS),
+            reason="capability_structure_missing_fields",
+            details={"missing": missing},
+        )
+    unknown = sorted(str(key) for key in document if key not in _REQUIRED_SNAPSHOT_KEYS)
+    if unknown:
+        raise ArtifactMismatchError(
+            "capability snapshot document carries unknown top-level fields",
+            field="snapshot",
+            requested=unknown,
+            available=list(_REQUIRED_SNAPSHOT_KEYS),
+            reason="capability_structure_unknown_fields",
+        )
+    schema_version = document["schema_version"]
+    if isinstance(schema_version, bool) or not isinstance(schema_version, int):
+        raise ArtifactMismatchError(
+            "capability snapshot schema_version must be an integer",
+            field="snapshot.schema_version",
+            requested=schema_version,
+            available=CAPABILITY_SCHEMA_VERSION,
+            reason="capability_schema_version_invalid",
+        )
+    if schema_version != CAPABILITY_SCHEMA_VERSION:
+        raise ArtifactMismatchError(
+            "unsupported capability snapshot schema version",
+            field="snapshot.schema_version",
+            requested=schema_version,
+            available=CAPABILITY_SCHEMA_VERSION,
+            reason="capability_schema_version_mismatch",
+        )
+    digest = document["digest"]
+    if not isinstance(digest, str) or not digest.startswith("sha256:"):
+        raise ArtifactMismatchError(
+            "capability snapshot digest must be a sha256: string",
+            field="snapshot.digest",
+            requested=digest,
+            reason="capability_digest_invalid",
+        )
+    if not isinstance(document["kind"], str) or not document["kind"].strip():
+        raise ArtifactMismatchError(
+            "capability snapshot kind must be a non-empty string",
+            field="snapshot.kind",
+            requested=document["kind"],
+            reason="capability_structure_mismatch",
+        )
+    if not isinstance(document["triple"], str) or not document["triple"].strip():
+        raise ArtifactMismatchError(
+            "capability snapshot triple must be a non-empty string",
+            field="snapshot.triple",
+            requested=document["triple"],
+            reason="capability_structure_mismatch",
+        )
+    features = document["features"]
+    if not isinstance(features, list) or any(not isinstance(item, str) for item in features):
+        raise ArtifactMismatchError(
+            "capability snapshot features must be a list of strings",
+            field="snapshot.features",
+            requested=features,
+            reason="capability_structure_mismatch",
+        )
+    providers = document["providers"]
+    if not isinstance(providers, list) or any(not isinstance(item, Mapping) for item in providers):
+        raise ArtifactMismatchError(
+            "capability snapshot providers must be a list of mappings",
+            field="snapshot.providers",
+            requested=providers,
+            reason="capability_structure_mismatch",
+        )
+    snapshot = CapabilitySnapshot.from_dict(document)
+    snapshot.verify_digest()
+    canonical = snapshot.to_dict()
+    if dict(document) != dict(canonical):
+        raise ArtifactMismatchError(
+            "capability snapshot document is not the canonical exported structure",
+            field="snapshot",
+            reason="capability_structure_mismatch",
+            details={"expected_keys": sorted(canonical), "requested_keys": sorted(document)},
+        )
+    return snapshot
+
+
+def _coerce_snapshot(capability: Any) -> Optional[CapabilitySnapshot]:
+    if capability is None:
+        return None
+    if isinstance(capability, CapabilitySnapshot):
+        capability.verify_digest()
+        return capability
+    if isinstance(capability, Mapping):
+        return import_capability_snapshot(capability)
+    raise CapabilityUnavailableError(
+        "capability must be a CapabilitySnapshot or an exported snapshot document",
+        field="capability",
+        requested=type(capability).__name__,
+        reason="not_a_capability_snapshot",
+    )
+
+
+# ---------------------------------------------------------------------------
+# plan command
+# ---------------------------------------------------------------------------
+def _canonical_discovery_op(op: Any) -> str:
+    if not isinstance(op, str) or not op.strip():
+        raise OpContractError(
+            "op must be a non-empty string",
+            field="request.op",
+            requested=op,
+            available=list(SUPPORTED_DISCOVERY_OPS),
+            reason="invalid_op",
+        )
+    name = op.strip().lower()
+    if name == "qmatmul":
+        name = "qmatmul_s8s8_s32"
+    canonical = lookup_canonical_opcode(name)
+    if canonical not in SUPPORTED_DISCOVERY_OPS:
+        raise OpContractError(
+            "op {!r} is not covered by the discovery commands".format(op),
+            field="request.op",
+            requested=op,
+            available=list(SUPPORTED_DISCOVERY_OPS),
+            reason="opcode_not_registered",
+        )
+    return canonical
+
+
+def _resolve_request(
+    op: str,
+    left_shape: Any,
+    right_shape: Any,
+    dtype: Any,
+    policy: ExecutionPolicy,
+    capability: Optional[CapabilitySnapshot]
+) -> Any:
+    canonical = _canonical_discovery_op(op)
+    if canonical == "matmul":
+        return resolve_matmul(policy, capability, left_shape, right_shape, dtype)
+    return resolve_qmatmul(policy, capability, left_shape, right_shape)
+
+
+@dataclass(frozen=True)
+class PlanDocument:
+    """Frozen plan plus the capability snapshot it was resolved against."""
+
+    plan: ExecutionPlan
+    capability: CapabilitySnapshot
+    requested_op: str
+
+    @property
+    def plan_digest(self) -> str:
+        return self.plan.digest
+
+    @property
+    def capability_digest(self) -> str:
+        return self.capability.digest
+
+    def to_dict(self) -> Mapping[str, Any]:
+        if self.plan.capability_digest != self.capability.digest:
+            raise ArtifactMismatchError(
+                "plan capability digest does not match the returned snapshot",
+                field="plan.target.capability_digest",
+                requested=self.plan.capability_digest,
+                available=self.capability.digest,
+                reason="plan_capability_digest_mismatch",
+            )
+        return {
+            "schema_version": DISCOVERY_SCHEMA_VERSION,
+            "kind": "plan",
+            "requested_op": self.requested_op,
+            "plan": self.plan.to_dict(),
+            "plan_digest": self.plan.digest,
+            "capability_snapshot": self.capability.to_dict(),
+            "capability_digest": self.capability.digest,
+            "request": self.plan.request,
+            "resolved_policy": mapping_copy(self.plan.payload["policy"]["resolved"]),
+        }
+
+    def to_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+
+def plan_request(
+    op: str,
+    left_shape: Any,
+    right_shape: Any,
+    dtype: Any = None,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Any = None
+) -> PlanDocument:
+    """Freeze one request into a plan; never executes and never re-selects."""
+
+    active_policy = policy if policy is not None else ExecutionPolicy()
+    if not isinstance(active_policy, ExecutionPolicy):
+        raise PolicyInvalidValueError(
+            "policy must be an ExecutionPolicy",
+            field="policy",
+            requested=type(active_policy).__name__,
+            reason="not_an_execution_policy",
+        )
+    snapshot = _coerce_snapshot(capability)
+    # capability_for_policy enforces the host-probe alignment and builds the
+    # local probe snapshot when the caller did not supply one.
+    active_capability = capability_for_policy(active_policy, snapshot)
+    resolution = _resolve_request(op, left_shape, right_shape, dtype, active_policy, active_capability)
+    if resolution.plan.capability_digest != active_capability.digest:
+        raise ArtifactMismatchError(
+            "resolver returned a plan for a different capability snapshot",
+            field="plan.target.capability_digest",
+            requested=resolution.plan.capability_digest,
+            available=active_capability.digest,
+            reason="plan_capability_digest_mismatch",
+        )
+    return PlanDocument(
+        plan=resolution.plan,
+        capability=active_capability,
+        requested_op=resolution.plan.opcode,
+    )
+
+
+# ---------------------------------------------------------------------------
+# explain command
+# ---------------------------------------------------------------------------
+@dataclass(frozen=True)
+class Explanation:
+    """Machine-readable explanation plus a human summary."""
+
+    document: Mapping[str, Any]
+    summary: str
+
+    @property
+    def digest(self) -> str:
+        return str(self.document["digest"])
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return mapping_copy(self.document)
+
+    def to_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+
+def _plan_from_document(value: Any) -> ExecutionPlan:
+    if isinstance(value, ExecutionPlan):
+        plan = value
+    elif isinstance(value, Mapping) and value.get("kind") == "plan" and isinstance(value.get("plan"), Mapping):
+        # Accept the wrapper document emitted by the ``plan`` command; the
+        # nested plan still has to satisfy the full plan schema and digest.
+        plan = ExecutionPlan.from_dict(value["plan"])
+        if value.get("plan_digest") is not None and value["plan_digest"] != plan.digest:
+            raise ArtifactMismatchError(
+                "plan wrapper digest does not match the nested plan body",
+                field="plan.plan_digest",
+                requested=value.get("plan_digest"),
+                available=plan.digest,
+                reason="plan_digest_mismatch",
+            )
+    elif isinstance(value, Mapping):
+        plan = ExecutionPlan.from_dict(value)
+    else:
+        raise ArtifactMismatchError(
+            "plan must be an ExecutionPlan or a plan document",
+            field="plan",
+            requested=type(value).__name__,
+            reason="not_an_execution_plan",
+        )
+    plan.validate()
+    return plan
+
+
+def _plan_from_report_document(report: Any) -> Tuple[ExecutionPlan, Mapping[str, Any], str]:
+    if hasattr(report, "to_dict") and not isinstance(report, Mapping):
+        document = report.to_dict()
+    elif isinstance(report, Mapping):
+        document = dict(report)
+    else:
+        raise ReportSchemaError(
+            "report must be a report mapping or ExecutionReport",
+            field="report",
+            requested=type(report).__name__,
+            reason="report_not_a_mapping",
+        )
+    validate_report_schema(document)
+    plan_payload = document["plan_payload"]
+    embedded = mapping_copy(plan_payload["document"])
+    plan = ExecutionPlan(embedded)
+    plan.validate()
+    if plan.digest != plan_payload["digest"]:
+        raise ArtifactMismatchError(
+            "embedded plan payload digest does not match the plan body",
+            field="report.plan_payload.digest",
+            requested=plan_payload["digest"],
+            available=plan.digest,
+            reason="report_plan_payload_digest_mismatch",
+        )
+    if document["resolution"]["plan_digest"] != plan.digest:
+        raise ArtifactMismatchError(
+            "report resolution plan_digest does not match the embedded plan payload",
+            field="report.resolution.plan_digest",
+            requested=document["resolution"]["plan_digest"],
+            available=plan.digest,
+            reason="report_plan_digest_not_reconciled",
+        )
+    execution_facts = {
+        "report_schema_version": document["schema_version"],
+        "gates": mapping_copy(document["gates"]),
+        "timing": mapping_copy(document["timing"]),
+        "artifact": {
+            "kind": document["artifact"]["kind"],
+            "format": document["artifact"]["format"],
+            "content_digest": document["artifact"]["content_digest"],
+            "provider_artifact_digest": document["artifact"].get("provider_artifact_digest"),
+            "abi_version": document["artifact"]["abi_version"],
+        },
+        "dispatch": mapping_copy(document["dispatch"]),
+        "coverage": mapping_copy(document["coverage"]),
+        "capability": {
+            "snapshot_digest": document["capability"]["snapshot_digest"],
+            "kind": document["capability"]["kind"],
+            "triple": document["capability"]["triple"],
+        },
+    }
+    return plan, execution_facts, str(document["resolution"]["why"])
+
+
+def _explain_document(
+    plan: ExecutionPlan,
+    input_kind: str,
+    execution_facts: Optional[Mapping[str, Any]],
+    why: Optional[str]
+) -> Mapping[str, Any]:
+    payload = plan.payload
+    selected_provider = str(payload["selected"]["provider"])
+    fallback_used = bool(payload["fallback"].get("used", False))
+    if why is None:
+        why = _entry_explain(plan, selected_provider, fallback_used)
+    document = {
+        "schema_version": DISCOVERY_SCHEMA_VERSION,
+        "kind": "explain",
+        "input_kind": input_kind,
+        "request": mapping_copy(payload["request"]),
+        "policy_applicability": mapping_copy(payload["policy_applicability"]),
+        "requested_policy": mapping_copy(payload["policy"]["requested"]),
+        "resolved_policy": mapping_copy(payload["policy"]["resolved"]),
+        "selected": mapping_copy(payload["selected"]),
+        "numeric_guarantee": mapping_copy(payload["numeric_guarantee"]),
+        "layout_decision": mapping_copy(payload["layout_decision"]),
+        "candidates": [mapping_copy(item) for item in payload["candidates"]],
+        "rejections": [mapping_copy(item) for item in payload["resolution"]["rejections"]],
+        "tie_break": list(payload["resolution"]["tie_break"]),
+        "numeric_class_order": list(payload["resolution"]["numeric_class_order"]),
+        "fallback": mapping_copy(payload["fallback"]),
+        "rules": [mapping_copy(item) for item in payload["resolution"]["rules"]],
+        "why": str(why),
+        "boundaries": [dict(item) for item in EXPLAIN_BOUNDARIES],
+        "resolver_version": payload["resolution"]["resolver_version"],
+        "plan_digest": plan.digest,
+        "capability_digest": plan.capability_digest,
+        "contract_digest": plan.contract_digest,
+    }
+    if execution_facts is not None:
+        document["execution_facts"] = mapping_copy(execution_facts)
+    document["digest"] = _digest(document)
+    return document
+
+
+def _explanation_summary(plan: ExecutionPlan, document: Mapping[str, Any]) -> str:
+    payload = plan.payload
+    lines = [
+        "explain {op} {dtype} {left}x{right}->{out}".format(
+            op=plan.opcode,
+            dtype=plan.dtype,
+            left=list(plan.left_shape),
+            right=list(plan.right_shape),
+            out=list(plan.output_shape),
+        ),
+        "selected provider: {provider} ({version}, {implementation})".format(
+            provider=payload["selected"]["provider"],
+            version=payload["selected"]["provider_version"],
+            implementation=payload["selected"]["implementation"],
+        ),
+        "numeric guarantee: class={cls} deterministic={det} reduction_order_id={order}".format(
+            cls=plan.numeric_guarantee["class"],
+            det=plan.numeric_guarantee["deterministic"],
+            order=plan.numeric_guarantee["reduction_order_id"],
+        ),
+        "why: {why}".format(why=document["why"]),
+        "candidates: " + ", ".join(
+            "{}={}({})".format(item["id"], item["state"], item["reason"]) for item in payload["candidates"]
+        ),
+        "tie-break: " + " -> ".join(payload["resolution"]["tie_break"]),
+        "fallback: mode={mode} primary={primary} chain={chain} used={used}".format(
+            mode=payload["fallback"]["mode"],
+            primary=payload["fallback"]["primary"],
+            chain=list(payload["fallback"]["chain"]),
+            used=payload["fallback"].get("used", False),
+        ),
+        "boundaries: {count} fields are only decided at execution time (see document.boundaries)".format(
+            count=len(EXPLAIN_BOUNDARIES)
+        ),
+    ]
+    if "execution_facts" in document:
+        gates = document["execution_facts"]["gates"]
+        lines.append(
+            "execution facts: gates={status} (performance_gated={gated})".format(
+                status=gates["status"], gated=gates["performance_gated"]
+            )
+        )
+    return "\n".join(lines)
+
+
+def explain(
+    *,
+    op: str = "matmul",
+    left_shape: Any = None,
+    right_shape: Any = None,
+    dtype: Any = None,
+    policy: Optional[ExecutionPolicy] = None,
+    capability: Any = None,
+    plan: Any = None,
+    report: Any = None
+) -> Explanation:
+    """Explain provider selection from the resolver trace; never executes."""
+
+    if plan is not None and report is not None:
+        raise PolicyInvalidValueError(
+            "explain accepts either a plan or a report, not both",
+            field="input",
+            requested=["plan", "report"],
+            reason="explain_input_ambiguous",
+        )
+    if plan is not None:
+        plan_obj = _plan_from_document(plan)
+        document = _explain_document(plan_obj, "plan", None, None)
+        return Explanation(document=document, summary=_explanation_summary(plan_obj, document))
+    if report is not None:
+        plan_obj, execution_facts, why = _plan_from_report_document(report)
+        document = _explain_document(plan_obj, "report", execution_facts, why)
+        return Explanation(document=document, summary=_explanation_summary(plan_obj, document))
+    if left_shape is None or right_shape is None:
+        raise PolicyInvalidValueError(
+            "request explain needs left_shape and right_shape",
+            field="request",
+            requested={"left_shape": left_shape, "right_shape": right_shape},
+            available="--left/--right with --op/--dtype",
+            reason="explain_request_incomplete",
+        )
+    active_policy = policy if policy is not None else ExecutionPolicy()
+    if not isinstance(active_policy, ExecutionPolicy):
+        raise PolicyInvalidValueError(
+            "policy must be an ExecutionPolicy",
+            field="policy",
+            requested=type(active_policy).__name__,
+            reason="not_an_execution_policy",
+        )
+    snapshot = _coerce_snapshot(capability)
+    active_capability = capability_for_policy(active_policy, snapshot)
+    resolution = _resolve_request(op, left_shape, right_shape, dtype, active_policy, active_capability)
+    document = _explain_document(resolution.plan, "request", None, None)
+    return Explanation(
+        document=document,
+        summary=_explanation_summary(resolution.plan, document),
+    )
+
+
+# ---------------------------------------------------------------------------
+# doctor command
+# ---------------------------------------------------------------------------
+@dataclass(frozen=True)
+class DoctorReport:
+    """Read-only fact report plus fail-closed condition summary."""
+
+    document: Mapping[str, Any]
+    summary: str
+    fail_closed: bool
+
+    @property
+    def digest(self) -> str:
+        return str(self.document["digest"])
+
+    def to_dict(self) -> Mapping[str, Any]:
+        return mapping_copy(self.document)
+
+    def to_json(self) -> str:
+        return canonical_json(self.to_dict())
+
+
+def _environment_rows() -> Tuple[Mapping[str, Any], ...]:
+    rows = []
+    for spec in ENV_VAR_REGISTRY:
+        raw = os.environ.get(spec["name"])
+        if raw is None:
+            value_kind = None
+            interpreted = None
+        elif spec["value_kind"] == "flag":
+            value_kind = "flag"
+            interpreted = raw == "1"
+        elif spec["value_kind"] == "integer":
+            try:
+                interpreted = int(raw)
+                value_kind = "integer"
+            except (TypeError, ValueError):
+                interpreted = None
+                value_kind = "non_integer"
+        else:
+            value_kind = "opaque"
+            interpreted = None
+        row = {
+            "name": spec["name"],
+            "status": "set" if raw is not None else "unset",
+            "class": spec["class"],
+            "policy_field": spec["policy_field"],
+            "consumed_by_execution": bool(spec["consumed_by_execution"]),
+            "value_kind": value_kind,
+            "interpreted_value": interpreted,
+            "source": spec["source"],
+        }
+        rows.append(row)
+    return tuple(rows)
+
+
+def _provider_manifest_digest(entry: Any) -> str:
+    return "sha256:" + sha256_text(entry.to_dict())
+
+
+def _provider_identity_check(entry: Any) -> Mapping[str, Any]:
+    errors = []
+    declared = sorted(str(opcode) for opcode in entry.contracts)
+    for opcode in declared:
+        try:
+            definition = get_op_definition(opcode)
+        except Exception as exc:
+            errors.append({"field": opcode, "reason": "contract_opcode_not_registered", "details": _error_details(exc)})
+            continue
+        if entry.contract_digest(opcode) != definition.contract_digest:
+            errors.append(
+                {
+                    "field": opcode,
+                    "reason": "contract_digest_mismatch",
+                    "requested": entry.contract_digest(opcode),
+                    "available": definition.contract_digest,
+                }
+            )
+        try:
+            identity = registered_identity(entry.provider_id, opcode)
+        except Exception as exc:  # pragma: no cover - defensive
+            errors.append({"field": opcode, "reason": "provider_identity_lookup_failed", "details": _error_details(exc)})
+            continue
+        if identity is None:
+            errors.append({"field": opcode, "reason": "provider_identity_missing"})
+    compare_opcode = "matmul" if "matmul" in declared else (declared[0] if declared else None)
+    if compare_opcode is not None:
+        identity = registered_identity(entry.provider_id, compare_opcode) or {}
+        for field in ("version", "implementation", "numeric_class", "deterministic", "reduction_order_id", "artifact_kind"):
+            if getattr(entry, field) != identity.get(field):
+                errors.append(
+                    {
+                        "field": compare_opcode + "." + field,
+                        "reason": "provider_manifest_identity_mismatch",
+                        "requested": getattr(entry, field),
+                        "available": identity.get(field),
+                    }
+                )
+        if dict(entry.pack) != dict(identity.get("pack") or {}):
+            errors.append(
+                {
+                    "field": compare_opcode + ".pack",
+                    "reason": "provider_manifest_identity_mismatch",
+                    "requested": dict(entry.pack),
+                    "available": dict(identity.get("pack") or {}),
+                }
+            )
+    return _check(
+        "provider_identity",
+        not errors,
+        "provider manifest does not match the registered provider identity",
+        {"provider": entry.provider_id, "errors": errors},
+    )
+
+
+def _contract_registry_checks() -> Tuple[Mapping[str, Any], Mapping[str, Any]]:
+    digest_errors = []
+    coverage = []
+    for opcode in registered_opcodes():
+        definition = get_op_definition(opcode)
+        recomputed = _digest(definition.contract_document)
+        if recomputed != definition.contract_digest:
+            digest_errors.append(
+                {
+                    "opcode": opcode,
+                    "reason": "contract_digest_mismatch",
+                    "requested": definition.contract_digest,
+                    "available": recomputed,
+                }
+            )
+        coverage.append({"opcode": opcode, "contract_version": definition.contract_version, "contract_digest": definition.contract_digest})
+    digest_check = _check(
+        "contract_registry_digest",
+        not digest_errors,
+        "registered contract digest does not match its own canonical document",
+        {"opcodes": coverage, "errors": digest_errors},
+    )
+    return digest_check, coverage
+
+
+def _artifact_digest_checks(snapshot: CapabilitySnapshot) -> Mapping[str, Any]:
+    errors = []
+    for entry in snapshot.providers:
+        if entry.provider_id == PORTABLE_PROVIDER_ID:
+            if entry.provider_artifact_digest is not None or entry.artifact_kind != "core_ir_artifact":
+                errors.append(
+                    {
+                        "provider": entry.provider_id,
+                        "reason": "portable_artifact_identity_mismatch",
+                        "requested": entry.provider_artifact_digest,
+                        "available": None,
+                    }
+                )
+            continue
+        expected = expected_artifact_digest(entry.provider_id, entry.library)
+        if expected is None:
+            errors.append({"provider": entry.provider_id, "reason": "provider_artifact_digest_unregistered"})
+            continue
+        if expected != entry.provider_artifact_digest:
+            errors.append(
+                {
+                    "provider": entry.provider_id,
+                    "reason": "provider_artifact_digest_mismatch",
+                    "requested": entry.provider_artifact_digest,
+                    "available": expected,
+                }
+            )
+    return _check(
+        "provider_artifact_digest",
+        not errors,
+        "provider artifact digest does not match the recomputed registered digest",
+        {"errors": errors},
+    )
+
+
+def _library_pin_checks(snapshot: CapabilitySnapshot) -> Tuple[Mapping[str, Any], Tuple[Mapping[str, Any], ...]]:
+    errors = []
+    rows = []
+    for entry in snapshot.providers:
+        if entry.provider_id == PORTABLE_PROVIDER_ID:
+            continue
+        library = entry.library
+        rows.append(
+            {
+                "provider_id": entry.provider_id,
+                "library_name": library.get("name"),
+                "path": library.get("path"),
+                "exists": library.get("size_bytes") is not None,
+                "size_bytes": library.get("size_bytes"),
+                "sha256_expected": library.get("sha256_expected"),
+                "sha256_actual": library.get("sha256"),
+                "sha256_matches": library.get("sha256") == library.get("sha256_expected"),
+                "blis_version_pin": AOCL_BLIS_TAG,
+                "blis_version_actual": library.get("blis_version"),
+                "arch_pin": AOCL_ARCH_STRING,
+                "arch_actual": library.get("arch_string"),
+                "available": bool(entry.available),
+                "reason": entry.reason,
+            }
+        )
+        if not entry.available:
+            errors.append(
+                {
+                    "provider": entry.provider_id,
+                    "reason": "provider_capability_unavailable",
+                    "detail": entry.reason or "unknown",
+                }
+            )
+            continue
+        if library.get("sha256") != AOCL_SHA256_PIN:
+            errors.append(
+                {
+                    "provider": entry.provider_id,
+                    "reason": "library_sha256_mismatch",
+                    "requested": library.get("sha256"),
+                    "available": AOCL_SHA256_PIN,
+                }
+            )
+        pin_errors = library_pin_errors(entry.provider_id, library, "doctor.providers." + entry.provider_id)
+        if pin_errors:
+            errors.extend(dict(item) for item in pin_errors)
+    return (
+        _check(
+            "pinned_library",
+            not errors,
+            "pinned library fingerprint does not match the registered pin",
+            {"errors": errors},
+        ),
+        tuple(rows),
+    )
+
+
+def _payload_abi_checks(snapshot: CapabilitySnapshot) -> Mapping[str, Any]:
+    errors = []
+    facts = []
+    for entry in snapshot.providers:
+        for opcode in sorted(str(item) for item in entry.contracts):
+            identity = registered_identity(entry.provider_id, opcode) or {}
+            fact = {
+                "provider": entry.provider_id,
+                "opcode": opcode,
+                "lowering_version": identity.get("lowering_version"),
+                "runner_version": identity.get("runner_version"),
+                "wire_version": identity.get("wire_version"),
+                "abi_version": identity.get("abi_version"),
+            }
+            facts.append(fact)
+            for field in ("lowering_version", "runner_version", "wire_version"):
+                value = fact[field]
+                if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+                    errors.append(
+                        {
+                            "provider": entry.provider_id,
+                            "opcode": opcode,
+                            "field": field,
+                            "reason": "payload_version_unregistered",
+                            "requested": value,
+                            "available": "a positive integer",
+                        }
+                    )
+            if not isinstance(fact["abi_version"], str) or not fact["abi_version"].strip():
+                errors.append(
+                    {
+                        "provider": entry.provider_id,
+                        "opcode": opcode,
+                        "field": "abi_version",
+                        "reason": "abi_version_unregistered",
+                        "requested": fact["abi_version"],
+                        "available": "a non-empty version string",
+                    }
+                )
+    return _check(
+        "payload_abi_versions",
+        not errors,
+        "artifact payload/ABI version registration is inconsistent",
+        {"facts": facts, "errors": errors},
+    )
+
+
+def doctor(capability: Any = None) -> DoctorReport:
+    """Report host/provider/contract facts and fail-closed conditions.
+
+    Read-only: probes only the pinned artifacts embedded in the capability
+    snapshot (the real local probe by default) and never echoes raw
+    environment values.  Missing optional vendor artifacts are reported as
+    fail-closed conditions, not guessed.
+    """
+
+    imported = capability is not None
+    snapshot = _coerce_snapshot(capability)
+    if snapshot is None:
+        snapshot = CapabilitySnapshot.probe_host()
+    if not snapshot.matches_host_probe():
+        raise CapabilityUnavailableError(
+            "doctor capability snapshot does not match the probed local host",
+            field="capability",
+            requested={"kind": snapshot.kind, "triple": snapshot.triple},
+            available={"kind": "cpu", "triple": host_triple()},
+            reason="capability_does_not_match_host_probe",
+            capability_digest=snapshot.digest,
+        )
+
+    contract_check, opcode_facts = _contract_registry_checks()
+    capability_check = _check("capability_digest", True)
+    try:
+        snapshot.verify_digest()
+    except Exception as exc:
+        capability_check = _check(
+            "capability_digest",
+            False,
+            "capability snapshot digest self-check failed",
+            {"error": _error_details(exc)},
+        )
+
+    provider_rows = []
+    identity_checks = []
+    for entry in snapshot.providers:
+        row = mapping_copy(entry.to_dict())
+        row["manifest_digest"] = _provider_manifest_digest(entry)
+        provider_rows.append(row)
+        identity_checks.append(_provider_identity_check(entry))
+
+    artifact_check = _artifact_digest_checks(snapshot)
+    library_check, pinned_rows = _library_pin_checks(snapshot)
+    payload_check = _payload_abi_checks(snapshot)
+    schema_versions = {
+        "discovery_schema_version": DISCOVERY_SCHEMA_VERSION,
+        "capability_schema_version": CAPABILITY_SCHEMA_VERSION,
+        "plan_schema_version": PLAN_SCHEMA_VERSION,
+        "policy_schema_version": POLICY_SCHEMA_VERSION,
+        "report_schema_version": REPORT_SCHEMA_VERSION,
+        "op_registry_schema_version": OP_REGISTRY_SCHEMA_VERSION,
+    }
+    schema_check = _check(
+        "schema_versions_registered",
+        all(isinstance(value, int) and not isinstance(value, bool) and value > 0 for value in schema_versions.values()),
+        "one or more registered schema versions is not a positive integer",
+        {"schema_versions": schema_versions},
+    )
+
+    checks = [
+        capability_check,
+        contract_check,
+        _check(
+            "opcode_coverage",
+            bool(opcode_facts) and all(item["contract_digest"].startswith("sha256:") for item in opcode_facts),
+            "registered opcodes do not carry a canonical contract digest",
+            {"opcodes": opcode_facts},
+        ),
+        *identity_checks,
+        artifact_check,
+        library_check,
+        payload_check,
+        schema_check,
+    ]
+    fail_closed = any(item["status"] != "ok" for item in checks)
+    environment = {
+        "variables": [mapping_copy(item) for item in _environment_rows()],
+        "allowlist": [spec["name"] for spec in ENV_VAR_REGISTRY],
+        "raw_values_included": False,
+    }
+    document = {
+        "schema_version": DISCOVERY_SCHEMA_VERSION,
+        "kind": "doctor",
+        "source": "imported_snapshot" if imported else "local_probe",
+        "host": {
+            "triple": host_triple(),
+            "machine": platform.machine(),
+            "platform": platform.platform(),
+            "features": list(host_features()),
+            "python": platform.python_version(),
+            "byteorder": sys.byteorder,
+        },
+        "opcodes": opcode_facts,
+        "capability": {
+            "schema_version": snapshot.schema_version,
+            "kind": snapshot.kind,
+            "triple": snapshot.triple,
+            "features": list(snapshot.features),
+            "snapshot_digest": snapshot.digest,
+            "provider_ids": list(snapshot.provider_ids()),
+        },
+        "providers": provider_rows,
+        "pinned_libraries": [mapping_copy(item) for item in pinned_rows],
+        "environment": environment,
+        "fail_closed_checks": [dict(item) for item in checks],
+        "fail_closed": bool(fail_closed),
+        "read_only": True,
+        "probe_scope": "pinned artifacts only",
+        "digest": "",
+    }
+    document["digest"] = _digest({key: value for key, value in document.items() if key != "digest"})
+    summary_lines = [
+        "doctor source={source} fail_closed={fail}".format(
+            source=document["source"], fail=str(fail_closed).lower()
+        ),
+        "host: {triple} features={features}".format(
+            triple=document["host"]["triple"], features=list(document["host"]["features"])
+        ),
+        "opcodes: " + ", ".join(
+            "{}@{}".format(item["opcode"], item["contract_version"]) for item in opcode_facts
+        ),
+        "providers: " + ", ".join(
+            "{}({})".format(
+                item["provider_id"],
+                "available" if item["available"] else "unavailable:{}".format(item["reason"]),
+            )
+            for item in provider_rows
+        ),
+        "pinned libraries: " + ", ".join(
+            "{} sha256_match={} arch={} available={}".format(
+                item["provider_id"],
+                item["sha256_matches"],
+                item["arch_actual"],
+                item["available"],
+            )
+            for item in pinned_rows
+        ) if pinned_rows else "pinned libraries: none in this snapshot",
+        "environment: " + ", ".join(
+            "{}={}".format(item["name"], item["status"]) for item in environment["variables"]
+        ),
+        "fail-closed checks: " + ", ".join(
+            "{}({})".format(item["check"], item["status"]) for item in checks
+        ),
+        "digest: {}".format(document["digest"]),
+    ]
+    return DoctorReport(
+        document=document,
+        summary="\n".join(summary_lines),
+        fail_closed=bool(fail_closed),
+    )
+
+
+__all__ = [
+    "DISCOVERY_SCHEMA_VERSION",
+    "ENV_VAR_REGISTRY",
+    "EXPLAIN_BOUNDARIES",
+    "SUPPORTED_DISCOVERY_OPS",
+    "DoctorReport",
+    "Explanation",
+    "PlanDocument",
+    "doctor",
+    "explain",
+    "export_capability_snapshot",
+    "import_capability_snapshot",
+    "plan_request",
+]
