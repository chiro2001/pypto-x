+#!/usr/bin/env python3
+"""U3 execution discovery CLI wrapper.
+
+Sets ``PYPTO_X_PORTABLE_ONLY=1`` and puts this worktree's ``python/`` on
+``sys.path`` before importing :mod:`pypto`, then delegates to
+:func:`pypto.execution.cli.main` (the same entry point as
+``python -m pypto.execution.cli``).
+
+Examples::
+
+    python3 scripts/perf/execution_cli.py doctor
+    python3 scripts/perf/execution_cli.py doctor --json
+    python3 scripts/perf/execution_cli.py explain --op matmul \
+        --left 1,1024,7168 --right 7168,7168 --dtype bf16 --json
+    python3 scripts/perf/execution_cli.py plan --op matmul \
+        --left 2,3 --right 3,4 --dtype float32 --out /tmp/plan.json --json
+
+All commands are read-only with respect to execution state and never run a
+provider.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+WORKTREE = os.path.abspath(os.path.join(HERE, "..", ".."))
+
+os.environ.setdefault("PYPTO_X_PORTABLE_ONLY", "1")
+if os.path.join(WORKTREE, "python") not in sys.path:
+    sys.path.insert(0, os.path.join(WORKTREE, "python"))
+
+from pypto.execution.cli import main  # noqa: E402
+
+if __name__ == "__main__":
+    raise SystemExit(main())
