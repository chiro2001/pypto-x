diff --git a/python/pypto/execution/cli.py b/python/pypto/execution/cli.py
new file mode 100644
index 000000000..87697bdf5
--- /dev/null
+++ b/python/pypto/execution/cli.py
@@ -0,0 +1,235 @@
+"""Command line interface for the PyPTO-X execution discovery commands (U3).
+
+Supported entry points::
+
+    python -m pypto.execution.cli doctor [--json]
+    python -m pypto.execution.cli explain --op matmul --left 2,3 --right 3,4 \
+        --dtype float32 [--policy policy.json] [--snapshot snapshot.json] [--json]
+    python -m pypto.execution.cli explain --plan plan.json [--json]
+    python -m pypto.execution.cli explain --report report.json [--json]
+    python -m pypto.execution.cli plan --op matmul --left 2,3 --right 3,4 \
+        --dtype float32 [--policy policy.json] [--snapshot snapshot.json] \
+        [--out plan.json] [--json]
+
+``scripts/perf/execution_cli.py`` is the wrapper that sets
+``PYPTO_X_PORTABLE_ONLY=1`` and puts ``python/`` on ``sys.path`` before the
+package import, mirroring the op-bench launcher.
+
+All three commands are read-only with respect to execution state: ``doctor``
+probes only pinned artifacts, ``explain`` and ``plan`` never execute a
+provider.  Structured failures exit with status 1 and print the
+``ExecutionError.to_dict()`` payload under ``--json``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from typing import Any, Optional, Sequence
+
+from pypto.target._utils import canonical_json
+
+from .discovery import (
+    doctor,
+    explain,
+    import_capability_snapshot,
+    plan_request,
+)
+from .errors import ArtifactMismatchError, ExecutionError
+from .policy import policy_from_dict
+
+
+def _shape(value: str) -> tuple:
+    parts = [item.strip() for item in str(value).split(",") if item.strip()]
+    if not parts:
+        raise argparse.ArgumentTypeError("shape must be a comma-separated list of dimensions")
+    dimensions = []
+    for part in parts:
+        try:
+            dimension = int(part)
+        except ValueError as exc:
+            raise argparse.ArgumentTypeError("shape dimension {!r} is not an integer".format(part)) from exc
+        if dimension < 0:
+            raise argparse.ArgumentTypeError("shape dimension must be non-negative: {!r}".format(part))
+        dimensions.append(dimension)
+    return tuple(dimensions)
+
+
+def _add_common(parser: argparse.ArgumentParser) -> None:
+    parser.add_argument("--json", action="store_true", help="print the machine-readable document")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="pypto-execution",
+        description="PyPTO-X execution discovery commands (doctor / explain / plan)",
+    )
+    common = argparse.ArgumentParser(add_help=False)
+    _add_common(common)
+    sub = parser.add_subparsers(dest="command")
+
+    doctor_cmd = sub.add_parser("doctor", parents=[common], help="report host, contract, provider and pin facts")
+    doctor_cmd.add_argument("--snapshot", default=None, help="report on an imported capability snapshot instead of the local probe")
+
+    explain_cmd = sub.add_parser("explain", parents=[common], help="explain the resolver decision")
+    source = explain_cmd.add_mutually_exclusive_group()
+    source.add_argument("--plan", default=None, help="frozen plan JSON document")
+    source.add_argument("--report", default=None, help="execution report JSON document")
+    explain_cmd.add_argument("--op", default="matmul", help="matmul | qmatmul_s8s8_s32")
+    explain_cmd.add_argument("--left", type=_shape, default=None, help="left shape, e.g. 2,3")
+    explain_cmd.add_argument("--right", type=_shape, default=None, help="right shape, e.g. 3,4")
+    explain_cmd.add_argument("--dtype", default=None, help="matmul dtype (qmatmul is fixed int8)")
+    explain_cmd.add_argument("--policy", default=None, help="policy JSON document")
+    explain_cmd.add_argument("--snapshot", default=None, help="capability snapshot JSON document")
+
+    plan_cmd = sub.add_parser("plan", parents=[common], help="freeze a request into a replayable plan")
+    plan_cmd.add_argument("--op", required=True, help="matmul | qmatmul_s8s8_s32")
+    plan_cmd.add_argument("--left", type=_shape, required=True, help="left shape, e.g. 2,3")
+    plan_cmd.add_argument("--right", type=_shape, required=True, help="right shape, e.g. 3,4")
+    plan_cmd.add_argument("--dtype", default=None, help="matmul dtype (qmatmul is fixed int8)")
+    plan_cmd.add_argument("--policy", default=None, help="policy JSON document")
+    plan_cmd.add_argument("--snapshot", default=None, help="capability snapshot JSON document")
+    plan_cmd.add_argument("--out", default=None, help="write the frozen plan document to this path")
+    return parser
+
+
+def _load_json(path: str, field: str) -> Any:
+    try:
+        with open(path, "r", encoding="utf-8") as handle:
+            return json.load(handle)
+    except OSError as exc:
+        raise ArtifactMismatchError(
+            "could not read {} document {!r}: {}".format(field, path, exc),
+            field=field,
+            requested=path,
+            reason="{}_file_unreadable".format(field.replace(".", "_")),
+        ) from exc
+    except ValueError as exc:
+        raise ArtifactMismatchError(
+            "{} document {!r} is not valid JSON: {}".format(field, path, exc),
+            field=field,
+            requested=path,
+            reason="{}_file_invalid_json".format(field.replace(".", "_")),
+        ) from exc
+
+
+def _load_policy(path: Optional[str]) -> Any:
+    if not path:
+        return None
+    return policy_from_dict(_load_json(path, "policy"))
+
+
+def _load_snapshot(path: Optional[str]) -> Any:
+    if not path:
+        return None
+    return import_capability_snapshot(_load_json(path, "snapshot"))
+
+
+def _print_error(error: ExecutionError, as_json: bool) -> None:
+    if as_json:
+        print(json.dumps(error.to_dict(), ensure_ascii=False, sort_keys=True, indent=2))
+    else:
+        print("error [{}]: {} (field={}, reason={})".format(
+            error.code, error, error.field, error.reason
+        ), file=sys.stderr)
+
+
+def _print_document(document: Any, summary: str, as_json: bool) -> None:
+    if as_json:
+        print(json.dumps(document, ensure_ascii=False, sort_keys=True, indent=2))
+    else:
+        print(summary)
+
+
+def _plan_summary(plan_document: Any) -> str:
+    plan = plan_document.plan
+    selected = plan.selected
+    return "\n".join(
+        (
+            "plan digest: {}".format(plan.digest),
+            "capability digest: {}".format(plan_document.capability.digest),
+            "request: {op} {dtype} {left}x{right}->{out}".format(
+                op=plan.opcode,
+                dtype=plan.dtype,
+                left=list(plan.left_shape),
+                right=list(plan.right_shape),
+                out=list(plan.output_shape),
+            ),
+            "selected provider: {} ({})".format(selected["provider"], selected["provider_version"]),
+            "implementation: {}".format(selected["implementation"]),
+            "numeric class: {} deterministic={}".format(
+                selected["numeric_class"], selected["deterministic"]
+            ),
+            "fallback chain: {}".format(list(plan.fallback_chain)),
+        )
+    )
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(list(argv) if argv is not None else None)
+    command = args.command
+    if command is None:
+        parser.print_help()
+        return 2
+    as_json = bool(getattr(args, "json", False))
+    try:
+        if command == "doctor":
+            report = doctor(capability=_load_snapshot(getattr(args, "snapshot", None)))
+            _print_document(report.to_dict(), report.summary, as_json)
+            return 0
+        if command == "explain":
+            policy = _load_policy(getattr(args, "policy", None))
+            snapshot = _load_snapshot(getattr(args, "snapshot", None))
+            plan_path = getattr(args, "plan", None)
+            report_path = getattr(args, "report", None)
+            plan_document = _load_json(plan_path, "plan") if plan_path else None
+            report_document = _load_json(report_path, "report") if report_path else None
+            explanation = explain(
+                op=args.op,
+                left_shape=args.left,
+                right_shape=args.right,
+                dtype=args.dtype,
+                policy=policy,
+                capability=snapshot,
+                plan=plan_document,
+                report=report_document,
+            )
+            _print_document(explanation.to_dict(), explanation.summary, as_json)
+            return 0
+        if command == "plan":
+            plan_document = plan_request(
+                op=args.op,
+                left_shape=args.left,
+                right_shape=args.right,
+                dtype=args.dtype,
+                policy=_load_policy(getattr(args, "policy", None)),
+                capability=_load_snapshot(getattr(args, "snapshot", None)),
+            )
+            document = plan_document.to_dict()
+            if args.out:
+                try:
+                    with open(args.out, "w", encoding="utf-8") as handle:
+                        handle.write(canonical_json(document) + "\n")
+                except OSError as exc:
+                    raise ArtifactMismatchError(
+                        "could not write plan document {!r}: {}".format(args.out, exc),
+                        field="out",
+                        requested=args.out,
+                        reason="plan_file_unwritable",
+                    ) from exc
+            _print_document(document, _plan_summary(plan_document), as_json)
+            return 0
+        parser.print_help()
+        return 2
+    except ExecutionError as exc:
+        _print_error(exc, as_json)
+        return 1
+
+
+__all__ = ["build_parser", "main"]
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
