+def lpgemm_downscale_reference(acc_i64, col_scales, add_zero_point=True):
+    """Model LPGEMM's DOWNSCALE post-op bit-for-bit.
+
+    The kernel computes ``rne_f32(rne_f32(f32(acc) * scale)) + zero_point``
+    (``MULADD_RND_F32``), where ``zero_point`` is 0.0 when not supplied.  The
+    trailing ``+0.0`` is exact for every finite value except ``-0.0``, which it
+    normalises to ``+0.0``; ``add_zero_point=False`` reproduces instead our
+    portable epilogue (single multiply by the pre-multiplied scale, no add).
+    """
+    scheme = _portable()
+    f32 = scheme.float32_round
+    acc = np.asarray(acc_i64, dtype=np.int64)
+    rows, cols = acc.shape
+    bits = np.zeros((rows, cols), dtype=np.uint16)
+    for i in range(rows):
+        for j in range(cols):
+            product = f32(f32(float(acc[i, j])) * float(col_scales[j]))
+            if add_zero_point:
+                product = f32(product + 0.0)
+            bits[i, j] = scheme.bf16_rne_bits(product)
+    return bits
+
