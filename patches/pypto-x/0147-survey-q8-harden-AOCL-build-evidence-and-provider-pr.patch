+++ b/scripts/vendor/run_heavy_with_retry.sh
@@ -47,8 +47,13 @@ while true; do
     "${RUNNER}" --task "${TASK}" --agent "${AGENT}" -- "$@" >>"${LOG}" 2>&1
     rc=$?
     printf '=== runner_exit=%d attempt=%d utc=%s ===\n' "${rc}" "${attempt}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"${LOG}"
-    if [ "${rc}" -ne 75 ] && [ "${rc}" -ne 69 ]; then
-        exit "${rc}"
-    fi
+    # 75 BUSY / 69 admission-denied are the protocol's retry codes; 137/141/143
+    # are "killed by signal" codes we have seen when the lock tool or its
+    # guardian is reaped underneath the waiter -- also retryable, because the
+    # wrapped command never got to decide anything.
+    case "${rc}" in
+        75|69|137|141|143) ;;
+        *) exit "${rc}" ;;
+    esac
     sleep "${SLEEP}"
 done
