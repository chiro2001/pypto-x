+def e10_bitwise_envelope(lpg: Lpgemm) -> dict:
+    """Machine-checkable bitwise envelope for the int8 contract rule.
+
+    LPGEMM's S8S8S32OS32 accumulates per-``KC``-block int32 partials through
+    binary32 on this build (``KC`` = 2048 in
+    ``addon/aocl_gemm/config/lpgemm_blksz_map.h``).  The deviation from the
+    exact integer dot product therefore depends on *both* K and the magnitude
+    of the accumulated sums, so the contract cannot use a single "K < KC"
+    rule.  This probe measures the envelope directly: for a worst-case code
+    distribution (all-positive codes in [100, 127], which drive |acc| past
+    2**24 quickly) over three seeds it reports, per K, the maximum absolute
+    delta versus the exact integer product and the mismatch count.
+
+    The rule that follows is:
+
+        bitwise_vs_portable(int8) := provider in {portable, our kernels}
+            or (k <= bitwise_safe_k and observed_mismatch == 0)
+
+    with ``bitwise_safe_k`` read from this probe (not from the source).  The
+    envelope is distribution-dependent: with random +/-127 codes the same K
+    values come out exact (see ``random_codes_control``), which is exactly why
+    the rule must be empirical.
+    """
+    rng = np.random.default_rng(20260912)
+    m, n = 2, 6
+    ks = (512, 1024, 2048, 3584, 5099)
+    per_k = {}
+    for k in ks:
+        max_delta = 0
+        mismatch = 0
+        elements = 0
+        for seed in (1, 2, 3):
+            r = np.random.default_rng(seed)
+            a = r.integers(100, 128, size=(m, k), dtype=np.int16).astype(np.int8)
+            b = r.integers(100, 128, size=(k, n), dtype=np.int16).astype(np.int8)
+            out = lpg.s8s8s32os32(a, b, m, k, n).astype(np.int64)
+            exact = exact_int32_matmul(a, b)
+            delta = np.abs(out - exact)
+            max_delta = max(max_delta, int(delta.max()))
+            mismatch += int((delta > 0).sum())
+            elements += int(delta.size)
+        per_k["k{}".format(k)] = {
+            "k": k,
+            "max_abs_delta_vs_exact": max_delta,
+            "mismatch_count": mismatch,
+            "elements": elements,
+        }
+
+    control = {}
+    for k in (2048, 16696):
+        r = np.random.default_rng(9)
+        a = r.integers(-127, 128, size=(m, k), dtype=np.int16).astype(np.int8)
+        b = r.integers(-127, 128, size=(k, n), dtype=np.int16).astype(np.int8)
+        out = lpg.s8s8s32os32(a, b, m, k, n).astype(np.int64)
+        control["k{}".format(k)] = {
+            "max_abs_delta_vs_exact": int(np.abs(out - exact_int32_matmul(a, b)).max()),
+            "note": "random +/-127 codes: small |acc|, exact even above KC",
+        }
+
+    safe = [k for k in ks if per_k["k{}".format(k)]["max_abs_delta_vs_exact"] == 0]
+    return {
+        "worst_case_distribution": "codes uniform in [100,127], three seeds, m=2,n=6",
+        "per_k": per_k,
+        "random_codes_control": control,
+        "bitwise_safe_k": max(safe) if safe else None,
+        "deviation_bound_by_k": {
+            str(k): per_k["k{}".format(k)]["max_abs_delta_vs_exact"] for k in ks
+        },
+        "kc_config_value": 2048,
+        "kc_source": "addon/aocl_gemm/config/lpgemm_blksz_map.h LPGEMM_BLKSZ_MAP_ZEN4 S8S8S32OS32",
+        "rule": (
+            "bitwise_vs_portable(int8) := provider in {portable, our kernels} or "
+            "(k <= bitwise_safe_k and observed_mismatch == 0); otherwise use the "
+            "deviation_bound_by_k values as the registered tolerance bound"
+        ),
+    }
+
