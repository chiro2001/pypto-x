+            try:
+                text = open(path, "r", encoding="utf-8", errors="replace").read()
+            except OSError:
+                continue
+            bits = _active_define(text.splitlines(), "BLIS_INT_TYPE_SIZE")
+            if bits in (32, 64):
+                return (
+                    ctypes_module.c_int64 if bits == 64 else ctypes_module.c_int32,
+                    "{}:BLIS_INT_TYPE_SIZE={}".format(path, bits),
+                )
+    return None
