 #: argument list, so resolve it from the build that produced the library
 #: instead of guessing: the CMake cache ``INT_SIZE`` entry and the generated
 #: ``bli_config.h`` both record it.
+def _active_define(lines, name):
+    """Resolve the active branch of the generated #if/#elif chain for `name`."""
+    import re
+
+    defines = [
+        (index, int(match.group(1)))
+        for index, line in enumerate(lines)
+        for match in [re.match(r"#define\s+{}\s+(\d+)".format(name), line)]
+        if match
+    ]
+    if not defines:
+        return None
+    if len(defines) == 1:
+        return defines[0][1]
+    first_index, first_value = defines[0]
+    chain = [
+        (index, int(match.group(1)), int(match.group(2)))
+        for index, line in enumerate(lines)
+        for match in [re.match(r"#(?:if|elif)\s+(\d+)\s*==\s*(\d+)", line)]
+        if match and match and index < defines[-1][0] + 1
+    ]
+    for index, value in defines:
+        for cond_index, left, right in chain:
+            if cond_index < index and left == right:
+                return value
+    return first_value
+
+
+def _dim_from_config_header(evidence, ctypes_module):
+    """Read dim_t width from the classic-path generated bli_config.h."""
+    import glob
+    import os
+
+    roots = [
+        os.path.join(evidence, "src"),
+        os.path.join(evidence, "install"),
+    ]
+    for root in roots:
+        for path in glob.glob(os.path.join(root, "**", "bli_config.h"), recursive=True):
+            try:
+                text = open(path, "r", encoding="utf-8", errors="replace").read()
+            except OSError:
+                continue
+            bits = _active_define(text.splitlines(), "BLIS_INT_TYPE_SIZE")
+            if bits in (32, 64):
+                return (
+                    ctypes_module.c_int64 if bits == 64 else ctypes_module.c_int32,
+                    "{}:BLIS_INT_TYPE_SIZE={}".format(path, bits),
+                )
+    return None
+
+
