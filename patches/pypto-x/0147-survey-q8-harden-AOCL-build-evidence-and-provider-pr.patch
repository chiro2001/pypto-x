+#!/usr/bin/env bash
+# Q8 / vendor-gemm-survey: one heavy window, in priority order.
+#
+#   [0] evidence collection over the already-built AOCL install (report-only
+#       mode: seconds, no rebuild; the 16:57Z window did the compile+install).
+#       Non-fatal: the probes and the matrix must still run.
+#   [1] AOCL semantics probe E1-E10 (incl. the bitwise envelope);
+#   [2] W8A8 parity probe (Path A / Path B, hard constraints);
+#   [3] the four-way 12-shape GEMM matrix (plus a 1-thread int8 pass hint).
+set -uo pipefail
+
+WT=${PYPTO_X_VENDOR_WORKTREE:-/home/chiro/projects/pypto/worktrees/pypto-x/vendor-gemm-survey}
+EV=${PYPTO_X_VENDOR_EVIDENCE:-/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey}
+
+echo "=== [0/4] AOCL build report (light, python generator) $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
+PYPTO_X_VENDOR_EVIDENCE="${EV}" python3 "${WT}/scripts/vendor/aocl_build_report.py" \
+    || echo "WARN: report step returned non-zero; continuing to the probes"
+
+if ! find "${EV}/install/aocl-blis-5.3.2-zen4" -name 'libblis-mt.so*' -type f | head -1 | grep -q .; then
+    echo "FATAL: AOCL library missing under ${EV}/install" >&2
+    exit 66
+fi
+
+echo "=== [1-3/4] probes + matrix $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
+PYPTO_X_VENDOR_EVIDENCE="${EV}" "${WT}/scripts/vendor/q8_perf_matrix_heavy.sh" "$@"
