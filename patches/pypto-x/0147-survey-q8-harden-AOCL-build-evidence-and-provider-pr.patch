+def f32_block_model(a, b, kc=LPGEMM_KC_ZEN4):
+    """Model LPGEMM's cross-k-block accumulation.
+
+    Empirically (this probe) LPGEMM accumulates the exact per-KC-block int32
+    partials in **binary32** and finally wraps the result into int32, i.e.
+
+        acc_f32 = rne_f32(acc_f32 + rne_f32(block_partial))
+        result  = int32(acc_f32 mod 2**32)
+
+    (Verified: this model matches LPGEMM bit-for-bit for K = 3585, 5097, 5099,
+    16696, 133144 and even for the K = 133145 overflow wrap; see
+    ``model_vs_lpgemm`` in the results.)  Our portable golden and our AVX-512
+    kernel accumulate exact int32 across the whole K instead.
+    """
+    a = np.asarray(a, dtype=np.int64)
+    b = np.asarray(b, dtype=np.int64)
+    m, k = a.shape
+    n = b.shape[1]
+    acc = np.zeros((m, n), dtype=np.float32)
+    for start in range(0, k, kc):
+        stop = min(k, start + kc)
+        partial = a[:, start:stop] @ b[start:stop, :]
+        acc = (acc + partial.astype(np.float32)).astype(np.float32)
+    wide = acc.astype(np.float64).astype(np.int64)
+    wrapped = ((wide + 2 ** 31) % 2 ** 32) - 2 ** 31
+    return wrapped.astype(np.int64)
+
+
