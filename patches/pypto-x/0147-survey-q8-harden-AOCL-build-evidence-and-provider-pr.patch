+#!/usr/bin/env python3
+"""Q8 / vendor-gemm-survey: AOCL-BLIS build evidence generator.
+
+Reads the *existing* source tree + install tree and writes
+``raw/aocl-build-report.json`` with the reproducibility contract:
+
+  repo/tag/commit, full configure/make/install command lines, toolchain and host
+  facts, the build log reference, generated-header evidence for the explicit
+  Zen4 configuration and the dim_t width, per-file sha256 of the install tree,
+  the main library hash, and symbol/instruction evidence (aocl_gemm_* exports,
+  zen4-named symbols, the VNNI disassembly count, the LPGEMM kernel objects).
+
+This replaced the shell-heredoc report step inside
+``build_aocl_lpgemm_zen4.sh``, which was observed to be killed exactly at that
+point (SIGPIPE/141) leaving the build complete but the report missing.  It is
+read-only w.r.t. the source/install trees, so it is a *light* step and does not
+need the local heavy lock.
+
+Usage:
+  python3 scripts/vendor/aocl_build_report.py \
+      [--src <blis source>] [--install <install prefix>] \
+      [--log <build log>] [--output <raw/aocl-build-report.json>]
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DEFAULT_EVIDENCE = "/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey"
+
+
+def sha256_file(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def collect_artifacts(root: str) -> list:
+    out = []
+    for dirpath, _dirnames, filenames in os.walk(root):
+        for name in sorted(filenames):
+            path = os.path.join(dirpath, name)
+            rel = os.path.relpath(path, root)
+            if os.path.islink(path):
+                out.append({"path": rel, "symlink": os.readlink(path)})
+            else:
+                out.append(
+                    {"path": rel, "bytes": os.path.getsize(path), "sha256": sha256_file(path)}
+                )
+    return out
+
+
+def run(cmd: list) -> str:
+    return subprocess.run(cmd, capture_output=True, text=True, check=False).stdout
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    evidence = os.environ.get("PYPTO_X_VENDOR_EVIDENCE", DEFAULT_EVIDENCE)
+    parser.add_argument("--src", default=os.path.join(evidence, "src", "blis-5.3.2"))
+    parser.add_argument(
+        "--install", default=os.path.join(evidence, "install", "aocl-blis-5.3.2-zen4")
+    )
+    parser.add_argument("--log", default=None)
+    parser.add_argument("--output", default=os.path.join(evidence, "raw", "aocl-build-report.json"))
+    parser.add_argument("--mode", default="report-only")
+    args = parser.parse_args()
+
+    src, install = args.src, args.install
+    if not os.path.isdir(install):
+        raise SystemExit("install tree not found: {}".format(install))
+
+    logs = sorted(glob.glob(os.path.join(evidence, "logs", "aocl-build-*.log")))
+    build_log = args.log or (logs[-1] if logs else None)
+
+    def git(*cmd: str) -> str:
+        return run(["git", "-C", src, *cmd]).strip()
+
+    commit = git("rev-parse", "HEAD")
+    describe = git("describe", "--tags", "--always")
+    commit_date = git("log", "-1", "--format=%cI")
+
+    config_header = os.path.join(src, "bli_config.h")
+    addon_header = os.path.join(src, "bli_addon.h")
+    config_text = open(config_header, errors="replace").read() if os.path.exists(config_header) else ""
+    addon_text = open(addon_header, errors="replace").read() if os.path.exists(addon_header) else ""
+    int_defines = " ".join(
+        line for line in config_text.splitlines() if "BLIS_INT_TYPE_SIZE" in line or "BLIS_BLAS_INT_TYPE_SIZE" in line
+    )
+    int_guard = " ".join(
+        line
+        for line in config_text.splitlines()
+        if re.match(r"#(if|elif)\s+\d+\s+==\s+(32|64)", line)
+    )
+    # The generated header keeps both branches of the template; resolve which
+    # one is active: for each #define of interest, look back to the nearest
+    # #if/#elif whose two literals are equal.
+    lines = config_text.splitlines()
+
+    def active_define(name: str):
+        """Resolve which branch of the generated #if/#elif chain is active.
+
+        The template keeps both branches (e.g. ``#if 32 == 64`` /
+        ``#elif 32 == 32`` around two ``#define BLIS_BLAS_INT_TYPE_SIZE``
+        lines), so the value is the first condition whose two literals are
+        equal.
+        """
+        defines = [
+            (index, int(match.group(1)))
+            for index, line in enumerate(lines)
+            for match in [re.match(r"#define\s+{}\s+(\d+)".format(name), line)]
+            if match
+        ]
+        if not defines:
+            return None
+        first_index, first_value = defines[0]
+        conditions = [
+            (index, int(match.group(1)), int(match.group(2)))
+            for index, line in enumerate(lines[:first_index])
+            for match in [re.match(r"#(?:if|elif)\s+(\d+)\s*==\s*(\d+)", line)]
+            if match
+        ][-1:]
+        for index, value in defines:
+            for cond_index, left, right in conditions + [
+                (i, int(m.group(1)), int(m.group(2)))
+                for i, line in enumerate(lines)
+                for m in [re.match(r"#(?:if|elif)\s+(\d+)\s*==\s*(\d+)", line)]
+                if m and first_index < i < index + 1
+            ]:
+                if cond_index < index and left == right:
+                    return value
+        return first_value
+    libs = sorted(
+        glob.glob(os.path.join(install, "lib", "libblis-mt.so.*"))
+        or glob.glob(os.path.join(install, "**", "libblis-mt.so*"), recursive=True)
+    )
+    main_lib = libs[0] if libs else ""
+
+    nm_exports = run(["nm", "-D", "--defined-only", main_lib]) if main_lib else ""
+    aocl_symbols = sorted(
+        line.split()[-1] for line in nm_exports.splitlines() if "aocl_gemm_" in line
+    )
+    nm_all = run(["nm", "--defined-only", main_lib]) if main_lib else ""
+    zen4_symbols = [line for line in nm_all.splitlines() if "zen4" in line.lower()][:20]
+    vpdpbusd = 0
+    if main_lib:
+        disasm = run(["objdump", "-d", main_lib])
+        vpdpbusd = disasm.count("vpdpbusd")
+
+    objects = []
+    for path in sorted(glob.glob(os.path.join(src, "obj", "**", "*s8s8s32*", "*.o"), recursive=True)):
+        objects.append(path)
+    for path in sorted(glob.glob(os.path.join(src, "obj", "**", "*lpgemm*", "*.o"), recursive=True)):
+        if path not in objects:
+            objects.append(path)
+
+    cpuinfo = open("/proc/cpuinfo", errors="replace").read()
+    def first(pattern: str) -> str:
+        match = re.search(pattern, cpuinfo, re.MULTILINE)
+        return match.group(1).strip() if match else ""
+
+    report = {
+        "tag": "q8-aocl-lpgemm-zen4-build",
+        "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "mode": args.mode,
+        "note": (
+            "evidence collected from the existing source/install trees; the compile+install "
+            "itself ran in the local heavy-lock window of 2026-09-11T16:57Z "
+            "(see logs/aocl-build-20260911T165743Z.log)"
+        ),
+        "repo_url": "https://github.com/amd/blis",
+        "repo_tag": "5.3.2",
+        "blis_config": "zen4",
+        "src_commit": commit,
+        "src_describe": describe,
+        "src_commit_date": commit_date,
+        "src_path": src,
+        "install_dir": install,
+        "configure_command": (
+            "CC=gcc CXX=g++ ./configure --prefix=<install> --enable-cblas "
+            "--enable-threading=openmp --enable-addon=aocl_gemm --int-size=64 "
+            "--blas-int-size=32 --disable-blis-arch-type zen4"
+        ),
+        "build_command": "make -j6",
+        "install_command": "make install",
+        "toolchain": {
+            "gcc": run(["gcc", "--version"]).splitlines()[0] if run(["gcc", "--version"]) else "",
+            "gxx": run(["g++", "--version"]).splitlines()[0] if run(["g++", "--version"]) else "",
+            "make": run(["make", "--version"]).splitlines()[0] if run(["make", "--version"]) else "",
+        },
+        "host_cpu": {
+            "model": first(r"^model name\s*:\s*(.+)$"),
+            "family": first(r"^cpu family\s*:\s*(.+)$"),
+            "model_id": first(r"^model\s*:\s*(.+)$"),
+            "flags": first(r"^flags\s*:\s*(.+)$").split(),
+        },
+        "generated_config_evidence": {
+            "config_header": config_header,
+            "addon_header": addon_header,
+            "config_defines": " ".join(
+                line for line in config_text.splitlines() if line.startswith("#define BLIS_CONFIG_")
+                or line.startswith("#define BLIS_KERNELS_")
+            ),
+            "int_type_defines": int_defines,
+            "int_guard_lines": int_guard,
+            "dim_t_bits_active": active_define("BLIS_INT_TYPE_SIZE"),
+            "blas_int_bits_active": active_define("BLIS_BLAS_INT_TYPE_SIZE"),
+            "addon_defines": " ".join(
+                line for line in addon_text.splitlines() if "ADDONS" in line or line.startswith("#include")
+            ),
+        },
+        "main_library": {
+            "path": main_lib,
+            "sha256": sha256_file(main_lib) if main_lib else "",
+            "bytes": os.path.getsize(main_lib) if main_lib else 0,
+        },
+        "artifacts": collect_artifacts(install),
+        "aocl_gemm_export_count": len(aocl_symbols),
+        "aocl_gemm_symbols": aocl_symbols,
+        "zen4_named_symbols": zen4_symbols,
+        "vpdpbusd_disassembly_count": vpdpbusd,
+        "lpgemm_kernel_objects": objects,
+        "build_log": build_log,
+    }
+
+    os.makedirs(os.path.dirname(args.output), exist_ok=True)
+    with open(args.output, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, ensure_ascii=False)
+        handle.write("\n")
+    print(
+        "report: {out} | commit={c} | exports={n} | lib sha256={s} | vpdpbusd={v} | artifacts={a}".format(
+            out=args.output, c=commit[:12], n=len(aocl_symbols),
+            s=(report["main_library"]["sha256"] or "")[:16], v=vpdpbusd,
+            a=len(report["artifacts"]),
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
