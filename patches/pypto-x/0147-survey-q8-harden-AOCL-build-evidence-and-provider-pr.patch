+def _active_define(lines, name):
+    """Resolve the active branch of the generated #if/#elif chain for `name`."""
+    import re
+
+    defines = [
+        (index, int(match.group(1)))
+        for index, line in enumerate(lines)
+        for match in [re.match(r"#define\s+{}\s+(\d+)".format(name), line)]
+        if match
+    ]
+    if not defines:
+        return None
+    if len(defines) == 1:
+        return defines[0][1]
+    first_index, first_value = defines[0]
+    chain = [
+        (index, int(match.group(1)), int(match.group(2)))
+        for index, line in enumerate(lines)
+        for match in [re.match(r"#(?:if|elif)\s+(\d+)\s*==\s*(\d+)", line)]
+        if match and match and index < defines[-1][0] + 1
+    ]
+    for index, value in defines:
+        for cond_index, left, right in chain:
+            if cond_index < index and left == right:
+                return value
+    return first_value
+
+
