From fe26376684593ee429a373ef35c4676c4681ce19 Mon Sep 17 00:00:00 2001
From: axis-b-a3-runtime <agent@pypto-x.local>
Date: Sat, 12 Sep 2026 02:25:11 +0800
Subject: [PATCH 179/257] probe(axis-b-a3-runtime): fix int8 GEMM reference
 orientation (per-output-channel scales)

---
 scripts/a3_axis_b_runtime/06_int8_probe.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/scripts/a3_axis_b_runtime/06_int8_probe.py b/scripts/a3_axis_b_runtime/06_int8_probe.py
index 48ae197b7..6880b602d 100755
--- a/scripts/a3_axis_b_runtime/06_int8_probe.py
+++ b/scripts/a3_axis_b_runtime/06_int8_probe.py
@@ -86,7 +86,9 @@ def main():
         handler = ops.create_onednn_scaled_mm(w, w_scales, torch.float32, dynamic, False, 32)
         out = torch.empty((M, N), dtype=torch.float32)
         ops.onednn_scaled_mm(handler, codes, out, a_scales, None, None, None)
-        ref = (codes.float() * a_scales) @ (w.float() * w_scales)
+        # w is the [K,N] transposed view of the stored [N,K] int8 weight, so the
+        # logical weight is w.t() ([N,K]) and w_scales ([N,1]) scale its rows.
+        ref = (codes.float() * a_scales) @ (w.t().float() * w_scales).t()
         return codes, out, ref, handler
 
     def s_gemm():
