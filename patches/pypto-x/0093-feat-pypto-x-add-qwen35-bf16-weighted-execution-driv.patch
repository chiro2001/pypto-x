+def main(argv: Optional[List[str]] = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence-dir", required=True)
+    parser.add_argument("--commit", required=True)
+    parser.add_argument("--output", default=None)
+    args = parser.parse_args(argv)
+    evidence = Path(args.evidence_dir)
+    payload = build(evidence, args.commit)
+    output = Path(args.output) if args.output else evidence / "validation.json"
+    output.write_text(json.dumps(payload, ensure_ascii=False, sort_keys=True, indent=2) + "\n",
+                      encoding="utf-8")
+    print(json.dumps({"status": payload["status"], "output": str(output),
+                      "real_weights_executed": payload["real_weights_executed"]},
+                     ensure_ascii=False, sort_keys=True))
+    return 0
