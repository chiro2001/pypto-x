+# --------------------------------------------------------------------------
+# gold / RoPE
+# --------------------------------------------------------------------------
+
+
+def load_bundle(path: Path) -> Mapping[str, Any]:
+    """读取 bundle JSON（input_ids + bf16 位十六进制串），不需要 numpy。"""
+
+    payload = json.loads(Path(path).read_text(encoding="utf-8"))
+    cos_bits = [int(payload["cos_hex"][index:index + 4], 16) for index in range(0, len(payload["cos_hex"]), 4)]
+    sin_bits = [int(payload["sin_hex"][index:index + 4], 16) for index in range(0, len(payload["sin_hex"]), 4)]
+    return {
+        "input_ids": [int(v) for v in payload["input_ids"]],
+        "cos_bits": cos_bits,
+        "sin_bits": sin_bits,
+        "rope_source": payload.get("rope_source"),
+        "steps": payload.get("steps"),
+        "past_length": payload.get("past_length"),
+        "prompt": payload.get("prompt"),
+    }
+
+
+def write_bundle(path: Path, prompt: str, steps: int, past_length: int, input_ids: Sequence[int],
+                 cos_bits: Sequence[int], sin_bits: Sequence[int], rope_source: Any) -> None:
+    payload = {
+        "prompt": prompt,
+        "steps": steps,
+        "past_length": past_length,
+        "input_ids": [int(v) for v in input_ids],
+        "cos_hex": "".join("{:04x}".format(int(v) & 0xFFFF) for v in cos_bits),
+        "sin_hex": "".join("{:04x}".format(int(v) & 0xFFFF) for v in sin_bits),
+        "rope_source": rope_source,
+    }
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    Path(path).write_text(json.dumps(payload, sort_keys=True), encoding="utf-8")
+
+
+def _dump_outputs(dump_dir: Optional[str], tag: str, raw: Mapping[str, bytes],
+                  schema: Any) -> Optional[Mapping[str, Any]]:
+    if not dump_dir:
+        return None
+    target = Path(dump_dir) / tag
+    target.mkdir(parents=True, exist_ok=True)
+    manifest: Dict[str, Any] = {"tag": tag, "outputs": {}}
+    for entry in schema.outputs:
+        payload = raw.get(entry.name, b"")
+        name = "{}.bin".format(entry.name)
+        (target / name).write_bytes(payload)
+        manifest["outputs"][entry.name] = {
+            "dtype": entry.dtype,
+            "shape": list(entry.shape),
+            "file": name,
+            "nbytes": len(payload),
+            "sha256": hashlib.sha256(payload).hexdigest(),
+        }
+    (target / "dump.json").write_text(json.dumps(manifest, sort_keys=True, indent=2), encoding="utf-8")
+    return manifest
+
+
+def load_npz(path: Path) -> Mapping[str, Any]:
+    import numpy as np
+
+    with np.load(str(path)) as handle:
+        return {key: handle[key] for key in handle.files}
+
+
+def golden_paths(reference_dir: Path, prompt: str) -> Mapping[str, Path]:
+    return {
+        "float32": reference_dir / "float32" / "{}.npz".format(prompt),
+        "bfloat16": reference_dir / "bfloat16" / "{}.npz".format(prompt),
+    }
+
+
+def rope_tables(rope_dir: Path, positions: Sequence[int]) -> Mapping[str, Any]:
+    """用 rope_summary.json 的 inv_freq 复算任意位置的 cos/sin（fp32）。"""
+
+    summary = json.loads((rope_dir / "rope_summary.json").read_text(encoding="utf-8"))
+    inv_freq = [float(value) for value in summary["inv_freq"]]
+    if len(inv_freq) != 32:
+        raise DriverError("rope_summary inv_freq must have 32 entries")
+    cos_rows: List[List[float]] = []
+    sin_rows: List[List[float]] = []
+    for position in positions:
+        angles = [position * value for value in inv_freq]
+        half_cos = [math.cos(a) for a in angles]
+        half_sin = [math.sin(a) for a in angles]
+        cos_rows.append(half_cos + half_cos)
+        sin_rows.append(half_sin + half_sin)
+    return {
+        "inv_freq": inv_freq,
+        "rope_type": summary.get("rope_type"),
+        "attention_scaling": summary.get("attention_scaling"),
+        "mrope_section": summary.get("mrope_section"),
+        "cos_rows": cos_rows,
+        "sin_rows": sin_rows,
+    }
+
+
+def rope_bf16_bits(cos_rows: Sequence[Sequence[float]], sin_rows: Sequence[Sequence[float]],
+                   heads: int = 8) -> Tuple[List[int], List[int]]:
+    """[T,64] → [1,8,T,64] 的 bf16 原始位（RNE）。"""
+
+    cos_bits: List[int] = []
+    sin_bits: List[int] = []
+    for row in cos_rows:
+        cos_bits.extend(_bf16_bits(value) for value in (list(row) * heads))
+    for row in sin_rows:
+        sin_bits.extend(_bf16_bits(value) for value in (list(row) * heads))
+    return cos_bits, sin_bits
+
+
+def rope_bits_for_positions(
+    rope_dir: Path, prompt: str, positions: Sequence[int], heads: int = 8
+) -> Tuple[List[int], List[int], Mapping[str, Any]]:
+    """按位置取 cos/sin 的 bf16 位。
+
+    导出表覆盖的位置直接用**导出位**（与官方 harness 完全一致，含其 bf16 舍入
+    边界）；prompt 之外（decode 续接）的位置用 ``rope_summary.json`` 的
+    ``inv_freq`` 独立复算，并在证据里显式标注。
+    """
+
+    import numpy as np
+
+    loaded = load_npz(rope_dir / "{}.npz".format(prompt))
+    cos_export = np.asarray(loaded["cos_bf16"], dtype=np.float64)
+    sin_export = np.asarray(loaded["sin_bf16"], dtype=np.float64)
+    if cos_export.ndim != 4 or cos_export.shape[0] != 1 or cos_export.shape[1] != heads:
+        raise DriverError("exported cos_bf16 must be [1,{},T,64]".format(heads))
+    exported_steps = int(cos_export.shape[2])
+    table = rope_tables(rope_dir, positions)
+    cos_bits: List[int] = []
+    sin_bits: List[int] = []
+    exported_positions: List[int] = []
+    recomputed_positions: List[int] = []
+    for index, position in enumerate(positions):
+        if position < exported_steps:
+            exported_positions.append(int(position))
+            for head in range(heads):
+                for column in range(64):
+                    cos_bits.append(_bf16_bits(float(cos_export[0, head, position, column])))
+                    sin_bits.append(_bf16_bits(float(sin_export[0, head, position, column])))
+        else:
+            recomputed_positions.append(int(position))
+            for head in range(heads):
+                for column in range(64):
+                    cos_bits.append(_bf16_bits(table["cos_rows"][index][column]))
+                    sin_bits.append(_bf16_bits(table["sin_rows"][index][column]))
+    info = {
+        "exported_positions": exported_positions,
+        "recomputed_positions": recomputed_positions,
+        "source": "exported cos_bf16/sin_bf16 for in-prompt positions; inv_freq recomputation beyond prompt",
+    }
+    return cos_bits, sin_bits, info
+
+
+def verify_rope(rope_dir: Path, prompt: str, steps: int) -> Mapping[str, Any]:
+    positions = list(range(steps))
+    table = rope_tables(rope_dir, positions)
+    loaded = load_npz(rope_dir / "{}.npz".format(prompt))
+    import numpy as np
+
+    heads = 8
+    cos_all = np.asarray(loaded["cos_fp32"], dtype=np.float64).reshape(heads, steps, 64)
+    sin_all = np.asarray(loaded["sin_fp32"], dtype=np.float64).reshape(heads, steps, 64)
+    cos_bf16 = np.asarray(loaded["cos_bf16"], dtype=np.float64).reshape(heads, steps, 64)
+    cos_fp32 = cos_all[0]
+    sin_fp32 = sin_all[0]
+    max_cos = max_sin = max_bf16 = 0.0
+    half_equal = True
+    export_bf16_bits: List[int] = []
+    for index in range(steps):
+        for column in range(64):
+            max_cos = max(max_cos, abs(float(cos_fp32[index][column]) - table["cos_rows"][index][column]))
+            max_sin = max(max_sin, abs(float(sin_fp32[index][column]) - table["sin_rows"][index][column]))
+            max_bf16 = max(max_bf16, abs(float(cos_bf16[0][index][column]) - float(cos_fp32[index][column])))
+            export_bf16_bits.append(_bf16_bits(float(cos_bf16[0][index][column])))
+        for column in range(32):
+            if float(cos_fp32[index][column]) != float(cos_fp32[index][column + 32]):
+                half_equal = False
+    our_bits, _ = rope_bf16_bits(table["cos_rows"], table["sin_rows"])
+    bit_mismatch = sum(1 for left, right in zip(our_bits, export_bf16_bits) if left != right)
+    head_spread = float(np.max(np.abs(cos_all - cos_all[0])))
+    return {
+        "prompt": prompt,
+        "steps": steps,
+        "max_abs_cos_fp32_vs_independent": max_cos,
+        "max_abs_sin_fp32_vs_independent": max_sin,
+        "max_abs_cos_bf16_vs_fp32": max_bf16,
+        "text_path_half_equal": half_equal,
+        "head_axis_spread": head_spread,
+        "bf16_bit_mismatch_vs_export": bit_mismatch,
+        "inv_freq_formula": "1/theta**(arange(0,64,2)/64), theta=1e7",
+        "input_ids_exported": [int(v) for v in loaded["input_ids"]],
+    }
+
+
+# --------------------------------------------------------------------------
+# 比较
+# --------------------------------------------------------------------------
+
+
+def compare_raw(actual_raw: bytes, actual_dtype: str, gold: Any, name: str) -> Mapping[str, Any]:
+    import numpy as np
+
+    actual = _raw_to_float_array(actual_raw, actual_dtype).astype(np.float64)
+    expected = np.asarray(gold, dtype=np.float64).reshape(-1)
+    if actual.size != expected.size:
+        raise DriverError(
+            "{} size mismatch: actual {} vs gold {}".format(name, actual.size, expected.size)
+        )
+    delta = np.abs(actual - expected)
+    dot = float(np.dot(actual, expected))
+    norm = float(np.linalg.norm(actual) * np.linalg.norm(expected))
+    return {
+        "name": name,
+        "actual_dtype": actual_dtype,
+        "elements": int(actual.size),
+        "max_abs": float(np.max(delta)),
+        "mean_abs": float(np.mean(delta)),
+        "rms_abs": float(math.sqrt(float(np.mean(delta * delta)))),
+        "cosine": (dot / norm) if norm else None,
+        "actual_absmax": float(np.max(np.abs(actual))),
+        "gold_absmax": float(np.max(np.abs(expected))),
+        "rows": 1,
+    }
+
+
+def compare_rows(actual_raw: bytes, actual_dtype: str, gold: Any, rows: int, columns: int,
+                 name: str) -> Mapping[str, Any]:
+    import numpy as np
+
+    actual = _raw_to_float_array(actual_raw, actual_dtype).astype(np.float64).reshape(rows, columns)
+    expected = np.asarray(gold, dtype=np.float64).reshape(rows, columns)
+    delta = np.abs(actual - expected)
+    dot = float(np.sum(actual * expected))
+    norm = float(math.sqrt(float(np.sum(actual * actual))) * math.sqrt(float(np.sum(expected * expected))))
+    actual_argmax = np.argmax(actual, axis=1)
+    gold_argmax = np.argmax(expected, axis=1)
+    return {
+        "name": name,
+        "shape": [rows, columns],
+        "actual_dtype": actual_dtype,
+        "max_abs": float(np.max(delta)),
+        "mean_abs": float(np.mean(delta)),
+        "rms_abs": float(math.sqrt(float(np.mean(delta * delta)))),
+        "cosine": (dot / norm) if norm else None,
+        "actual_absmax": float(np.max(np.abs(actual))),
+        "gold_absmax": float(np.max(np.abs(expected))),
+        "argmax_equal": bool(np.array_equal(actual_argmax, gold_argmax)),
+        "argmax_mismatch_rows": int(np.sum(actual_argmax != gold_argmax)),
+        "argmax_actual": [int(v) for v in actual_argmax],
+        "argmax_gold": [int(v) for v in gold_argmax],
+    }
+
+
+def gold_dtype_band(reference_dir: Path, prompt: str) -> Mapping[str, Any]:
+    import numpy as np
+
+    paths = golden_paths(reference_dir, prompt)
+    high = load_npz(paths["float32"])
+    low = load_npz(paths["bfloat16"])
+    band: Dict[str, Any] = {}
+    for key in sorted(set(high) & set(low)):
+        if key in ("input_ids", "decode_token_ids", "generate_token_ids"):
+            continue
+        delta = np.abs(
+            np.asarray(high[key], dtype=np.float64).reshape(-1)
+            - np.asarray(low[key], dtype=np.float64).reshape(-1)
+        )
+        band[key] = {"max_abs": float(np.max(delta)), "mean_abs": float(np.mean(delta))}
+    return {"prompt": prompt, "definition": "官方 float32 vs 官方 bfloat16 的自身差异（dtype 误差带）", "per_key": band}
+
+
+def summarise_ops(recorder: OpRecorder) -> Mapping[str, Any]:
+    per_class: Dict[str, Dict[str, Any]] = {}
+    for record in recorder.records:
+        entry = per_class.setdefault(
+            record["operation"],
+            {"count": 0, "seconds": 0.0, "mode": record.get("mode", "native"), "max_seconds": 0.0},
+        )
+        entry["count"] += 1
+        entry["seconds"] += float(record.get("seconds", 0.0))
+        entry["max_seconds"] = max(entry["max_seconds"], float(record.get("seconds", 0.0)))
+    return {
+        "executed_operations": len(recorder.records),
+        "total_seconds": round(sum(float(r.get("seconds", 0.0)) for r in recorder.records), 3),
+        "by_operation": {
+            name: {
+                "count": entry["count"],
+                "mode": entry["mode"],
+                "seconds": round(entry["seconds"], 3),
+                "max_seconds": round(entry["max_seconds"], 4),
+            }
+            for name, entry in sorted(per_class.items(), key=lambda kv: -kv[1]["seconds"])
+        },
+        "host_reference_seconds": round(
+            sum(float(r.get("seconds", 0.0)) for r in recorder.records
+                if r.get("mode") == "host_reference"), 3
+        ),
+        "native_seconds": round(
+            sum(float(r.get("seconds", 0.0)) for r in recorder.records
+                if r.get("mode") == "native"), 3
+        ),
+    }
+
