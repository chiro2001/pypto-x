+# --------------------------------------------------------------------------
+# 基础设施
+# --------------------------------------------------------------------------
+
+
+def _maxrss_mib() -> int:
+    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) // 1024
+
+
+def _cgroup_mib(name: str) -> Optional[int]:
+    for candidate in ("/sys/fs/cgroup{}".format(name), "/sys/fs/cgroup/memory{}".format(name)):
+        try:
+            with open(candidate, "r", encoding="utf-8") as stream:
+                raw = stream.read().strip()
+        except OSError:
+            continue
+        if raw == "max":
+            return None
+        try:
+            return int(raw) // (1024 * 1024)
+        except ValueError:
+            continue
+    return None
+
+
+def _element_count(shape: Sequence[int]) -> int:
+    total = 1
+    for dimension in shape:
+        total *= int(dimension)
+    return total
+
+
+def _ref_bytes(ref: Any) -> int:
+    dtype = str(getattr(ref.type, "dtype", "")).lower()
+    shape = getattr(ref.type, "shape", None) or ()
+    if not all(isinstance(d, int) for d in shape):
+        return 0
+    return _element_count(shape) * DTYPE_BYTES.get(dtype, 0)
+
+
+def _bf16_bits(value: float) -> int:
+    bits = struct.unpack("<I", struct.pack("<f", float(value)))[0]
+    if (bits & 0x7F800000) == 0x7F800000:
+        high = bits >> 16
+        return (high | 0x0040) & 0xFFFF if bits & 0x007FFFFF else high
+    return ((bits + 0x7FFF + ((bits >> 16) & 1)) >> 16) & 0xFFFF
+
+
+def _bf16_value(bits: int) -> float:
+    return struct.unpack("<f", struct.pack("<I", (int(bits) & 0xFFFF) << 16))[0]
+
+
+def bf16_argmax(raw: bytes, count: int) -> int:
+    """纯 Python bf16 argmax（不依赖 numpy，供远端执行机使用）。"""
+
+    bits = struct.unpack_from("<{}H".format(count), raw, 0)
+    best_index = 0
+    best_value = _bf16_value(bits[0]) if count else 0.0
+    for index in range(1, count):
+        value = _bf16_value(bits[index])
+        if value > best_value:
+            best_value = value
+            best_index = index
+    return best_index
+
+
+def _sha256_file(path: Path, chunk: int = 8 << 20) -> str:
+    digest = hashlib.sha256()
+    with open(str(path), "rb") as stream:
+        while True:
+            block = stream.read(chunk)
+            if not block:
+                break
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _as_float32(raw: bytes) -> Any:
+    """把契约 dtype 的原始字节转成 float32 numpy 数组（不复制语义）。"""
+
+    import numpy as np
+
+    return np.frombuffer(raw, dtype=np.float32)
+
+
+def _raw_to_float_array(raw: bytes, dtype: str) -> Any:
+    import numpy as np
+
+    if dtype == "bf16":
+        bits = np.frombuffer(raw, dtype="<u2").astype(np.uint32)
+        return (bits << 16).view(np.float32)
+    if dtype == "float32":
+        return np.frombuffer(raw, dtype="<f4")
+    if dtype == "int64":
+        return np.frombuffer(raw, dtype="<i8").astype(np.float64)
+    if dtype == "int32":
+        return np.frombuffer(raw, dtype="<i4").astype(np.float64)
+    raise DriverError("unsupported comparison dtype {!r}".format(dtype))
+
+
+class Progress:
+    """逐行 flush 的进度日志；进程被 SIGKILL 后仍保留最后一条。"""
+
+    def __init__(self, path: Optional[str]) -> None:
+        self._path = path
+        self._stream = open(path, "a", encoding="utf-8", buffering=1) if path else None
+        self.entries: List[Mapping[str, Any]] = []
+
+    def emit(self, kind: str, **fields: Any) -> None:
+        record = {"kind": kind, "t": round(time.time(), 3)}
+        record.update(fields)
+        if kind == "op":
+            record["rss_mib"] = _maxrss_mib()
+            record["cgroup_mib"] = _cgroup_mib("/memory.current")
+        self.entries.append(record)
+        if self._stream is not None:
+            self._stream.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")
+            self._stream.flush()
+
+    def close(self) -> None:
+        if self._stream is not None:
+            self._stream.close()
+            self._stream = None
+
+
+class OpRecorder:
+    """逐算子计时 + native/host_reference 分类 + 实时预算看门狗。"""
+
+    def __init__(self, progress: Progress, budget_mib: Optional[int], watchdog: bool,
+                 abort_op_mib: Optional[int] = None) -> None:
+        self.progress = progress
+        self.budget_mib = budget_mib
+        self.watchdog = watchdog
+        self.records: List[Mapping[str, Any]] = []
+        self.stopped_reason: Optional[str] = None
+        self.abort_at_mib = int(budget_mib * 0.92) if (watchdog and budget_mib) else None
+        self.abort_op_bytes = (abort_op_mib * 1024 * 1024) if abort_op_mib else None
+        self.current_mib: Optional[int] = None
+
+    def before_op(self, index: int, name: str, input_bytes: int = 0, output_bytes: int = 0) -> None:
+        mode = "host_reference" if name in HOST_REFERENCE_OPERATIONS else "native"
+        if self.abort_op_bytes is not None and mode == "host_reference":
+            projected = (input_bytes + output_bytes) * LIST_OVERHEAD
+            if projected >= self.abort_op_bytes:
+                self.stopped_reason = (
+                    "projection guard: op #{} ({}, host_reference) 的输入 {} B + 输出 {} B "
+                    "在当前 list 物化路径下约需 {} MiB，超过 --abort-op-mib {}".format(
+                        index, name, input_bytes, output_bytes,
+                        projected // (1024 * 1024), self.abort_op_bytes // (1024 * 1024),
+                    )
+                )
+                raise BudgetExceeded(self.stopped_reason)
+        if self.abort_at_mib is None:
+            return
+        current = _cgroup_mib("/memory.current")
+        self.current_mib = current
+        if current is not None and current >= self.abort_at_mib:
+            self.stopped_reason = (
+                "watchdog: cgroup memory.current {} MiB >= {} MiB before op #{} ({})".format(
+                    current, self.abort_at_mib, index, name
+                )
+            )
+            raise BudgetExceeded(self.stopped_reason)
+
+    def record_op(
+        self, index: int, name: str, dtype: str, elapsed: float, output_bytes: int, input_bytes: int
+    ) -> None:
+        mode = "host_reference" if name in HOST_REFERENCE_OPERATIONS else (
+            "native" if name in NATIVE_OPERATIONS else "unclassified"
+        )
+        self.records.append(
+            {
+                "index": index,
+                "operation": name,
+                "dtype": dtype,
+                "mode": mode,
+                "seconds": round(elapsed, 6),
+                "output_bytes": output_bytes,
+                "input_bytes": input_bytes,
+            }
+        )
+        self.progress.emit(
+            "op", index=index, operation=name, dtype=dtype, mode=mode,
+            seconds=round(elapsed, 5), out_bytes=output_bytes,
+        )
+
+
+class InstrumentedAvx512Runtime(Avx512Runtime):
+    """AVX-512 runtime + 逐算子计时/看门狗；不改变任何算子语义。"""
+
+    def __init__(self, *args: Any, recorder: Optional[OpRecorder] = None, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self._recorder = recorder
+        self._op_index = 0
+
+    def _execute_operation(self, operation: Any, plan: Any, environment: Any, module: Any) -> None:
+        recorder = self._recorder
+        if recorder is None:
+            return super()._execute_operation(operation, plan, environment, module)
+        index = self._op_index
+        self._op_index += 1
+        name = str(getattr(plan, "operation", operation.name))
+        out_bytes = sum(_ref_bytes(ref) for ref in operation.outputs)
+        in_bytes = sum(_ref_bytes(ref) for ref in operation.inputs)
+        recorder.before_op(index, name, in_bytes, out_bytes)
+        started = time.perf_counter()
+        super()._execute_operation(operation, plan, environment, module)
+        recorder.record_op(
+            index, name, str(getattr(plan, "dtype", "")),
+            time.perf_counter() - started, out_bytes, in_bytes,
+        )
+
+
+class TimedCudaDriver:
+    """CUDA driver 代理：按 launch 顺序记录每个 kernel 的时间。"""
+
+    def __init__(self, driver: Any, recorder: OpRecorder) -> None:
+        object.__setattr__(self, "_driver", driver)
+        object.__setattr__(self, "_recorder", recorder)
+        object.__setattr__(self, "_index", 0)
+
+    def launch_kernel(self, handle: Any, grid: Any, block: Any, parameters: Any,
+                      stream: Any, dynamic: Any) -> Any:
+        recorder = object.__getattribute__(self, "_recorder")
+        index = object.__getattribute__(self, "_index")
+        object.__setattr__(self, "_index", index + 1)
+        recorder.before_op(index, "cuda_op{}".format(index))
+        started = time.perf_counter()
+        result = object.__getattribute__(self, "_driver").launch_kernel(
+            handle, grid, block, parameters, stream, dynamic
+        )
+        recorder.records.append(
+            {
+                "index": index,
+                "operation": "cuda_kernel",
+                "mode": "native",
+                "seconds": round(time.perf_counter() - started, 6),
+            }
+        )
+        return result
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(object.__getattribute__(self, "_driver"), name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        setattr(object.__getattribute__(self, "_driver"), name, value)
+
+
+# --------------------------------------------------------------------------
+# 图 / schema / layout / 内存模型
+# --------------------------------------------------------------------------
+
+
+def build_graph(steps: int, past_length: int, shape_profile: str = "model"):
+    program = build_qwen35_text_decoder_graph(
+        1, steps, past_length=past_length, shape_profile=shape_profile
+    )
+    schema = build_binding_schema(program)
+    layout = build_packed_layout(schema)
+    return program, schema, layout
+
+
+def graph_census(program: Any, schema: Any, layout: Any) -> Mapping[str, Any]:
+    function = program.functions[0]
+    per_op: Dict[str, Dict[str, Any]] = {}
+    by_dtype_out: Dict[str, int] = {}
+    total_out = 0
+    for operation in function.body.operations:
+        name = str(operation.name)
+        entry = per_op.setdefault(
+            name, {"count": 0, "input_bytes": 0, "output_bytes": 0, "max_input_bytes": 0,
+                   "max_output_bytes": 0, "largest": None}
+        )
+        entry["count"] += 1
+        in_bytes = sum(_ref_bytes(ref) for ref in operation.inputs)
+        out_bytes = sum(_ref_bytes(ref) for ref in operation.outputs)
+        entry["input_bytes"] += in_bytes
+        entry["output_bytes"] += out_bytes
+        if out_bytes > entry["max_output_bytes"]:
+            entry["max_output_bytes"] = out_bytes
+            entry["largest"] = operation.outputs[0].name if operation.outputs else None
+        entry["max_input_bytes"] = max(entry["max_input_bytes"], in_bytes)
+        total_out += out_bytes
+        for ref in operation.outputs:
+            dtype = str(getattr(ref.type, "dtype", "")).lower()
+            by_dtype_out[dtype] = by_dtype_out.get(dtype, 0) + _ref_bytes(ref)
+
+    largest = sorted(
+        (
+            {"operation": name, "max_input_bytes": entry["max_input_bytes"],
+             "max_output_bytes": entry["max_output_bytes"], "largest_output": entry["largest"]}
+            for name, entry in per_op.items()
+        ),
+        key=lambda item: -(item["max_input_bytes"] + item["max_output_bytes"]),
+    )
+    return {
+        "operation_total": len(function.body.operations),
+        "parameter_count": len(schema.parameters),
+        "state_count": len(schema.states),
+        "input_count": len(schema.inputs),
+        "output_count": len(schema.outputs),
+        "packed_layout_nbytes": layout.total_nbytes,
+        "parameter_bytes": sum(entry.nbytes for entry in schema.parameters),
+        "state_bytes": sum(entry.nbytes for entry in schema.states),
+        "intermediate_bytes_retained_by_runtime": total_out,
+        "intermediate_by_dtype": dict(sorted(by_dtype_out.items())),
+        "host_reference_count": sum(
+            entry["count"] for name, entry in per_op.items() if name in HOST_REFERENCE_OPERATIONS
+        ),
+        "largest_operations": largest[:10],
+        "per_operation": {
+            name: {
+                "count": entry["count"],
+                "input_bytes": entry["input_bytes"],
+                "output_bytes": entry["output_bytes"],
+                "boundary": "host_reference" if name in HOST_REFERENCE_OPERATIONS else (
+                    "native" if name in NATIVE_OPERATIONS else "unclassified"
+                ),
+            }
+            for name, entry in sorted(per_op.items())
+        },
+        "graph_digest": schema.graph_digest,
+        "runtime_inputs": [
+            {"name": entry.name, "dtype": entry.dtype, "shape": list(entry.shape)}
+            for entry in schema.runtime_inputs
+        ],
+        "regular_outputs": [
+            {"name": entry.name, "dtype": entry.dtype, "shape": list(entry.shape)}
+            for entry in schema.regular_outputs
+        ],
+    }
+
+
+def memory_model(census: Mapping[str, Any]) -> Mapping[str, Any]:
+    param_bytes = census["parameter_bytes"]
+    intermediate = census["intermediate_bytes_retained_by_runtime"]
+    list_extra = sum(
+        (entry["input_bytes"] + entry["output_bytes"]) * LIST_OVERHEAD
+        for entry in census["per_operation"].values()
+        if entry["boundary"] == "host_reference"
+    )
+    retained = param_bytes + intermediate
+    return {
+        "definition": (
+            "runtime（AVX-512/scalar）把每个 SSA 值的 buffer 保留到 launch 结束，"
+            "因此峰值是参数 + 全部中间值之和；host_reference 路径再把输入/输出"
+            "物化成 Python list（约 28 B/元素）"
+        ),
+        "parameter_bytes": param_bytes,
+        "intermediate_bytes": intermediate,
+        "peak_mib_if_runtime_retains_everything": retained // (1024 * 1024),
+        "host_reference_list_overhead_bytes": list_extra,
+        "peak_mib_with_current_host_reference_path": (retained + list_extra) // (1024 * 1024),
+    }
+
+
+# --------------------------------------------------------------------------
+# 绑定
+# --------------------------------------------------------------------------
+
+
+def _fill_region(storage: bytearray, offset: int, nbytes: int, dtype: str) -> None:
+    if nbytes <= 0:
+        return
+    if dtype == "bf16":
+        unit = struct.pack("<H", _bf16_bits(0.01))
+    elif dtype == "float32":
+        unit = struct.pack("<f", 0.01)
+    elif dtype in ("int64", "int32", "bool"):
+        unit = bytes(DTYPE_BYTES[dtype])
+    else:
+        raise DriverError("synthetic fill does not support dtype {!r}".format(dtype))
+    block = unit * (FILL_CHUNK // len(unit))
+    position = 0
+    while position < nbytes:
+        size = min(len(block), nbytes - position)
+        storage[offset + position:offset + position + size] = block[:size]
+        position += size
+
+
+def synthetic_bindings(schema: Any, layout: Any) -> Tuple[Dict[str, BufferBinding], Dict[str, BufferBinding]]:
+    storage = bytearray(layout.total_nbytes)
+    for entry in schema.parameters + schema.states:
+        region = layout.region_for(entry.name)
+        _fill_region(storage, region.offset, region.nbytes, entry.dtype)
+    parameters = {
+        entry.name: BufferBinding.from_buffer(
+            storage, layout.region_for(entry.name).storage_id, entry.dtype, entry.shape,
+            byte_offset=layout.region_for(entry.name).offset, readonly=True,
+        )
+        for entry in schema.parameters
+    }
+    states = {
+        entry.name: BufferBinding.from_buffer(
+            storage, layout.region_for(entry.name).storage_id, entry.dtype, entry.shape,
+            byte_offset=layout.region_for(entry.name).offset, readonly=True,
+        )
+        for entry in schema.states
+    }
+    return parameters, states
+
+
+def real_parameters(
+    schema: Any, layout: Any, reader: SafetensorsReader
+) -> Tuple[Dict[str, BufferBinding], Mapping[str, Any]]:
+    """真实权重零拷贝绑定；只有 F32→BF16 region 允许物化（模块自带 RNE）。"""
+
+    materialized: Dict[str, bytes] = {}
+    bindings: Dict[str, BufferBinding] = {}
+    zero_copy = 0
+    converted = 0
+    for entry in schema.parameters:
+        region = layout.region_for(entry.name)
+        if region.requires_dtype_conversion:
+            payload = materialized.get(region.storage_id)
+            if payload is None:
+                payload = convert_region_bytes(reader, region)
+                materialized[region.storage_id] = payload
+            bindings[entry.name] = BufferBinding.from_buffer(
+                payload, region.storage_id, entry.dtype, entry.shape, readonly=True
+            )
+            converted += 1
+        else:
+            view = reader.view(region.source_name)
+            bindings[entry.name] = BufferBinding.from_buffer(
+                view, region.storage_id, entry.dtype, entry.shape, readonly=True
+            )
+            zero_copy += 1
+    return bindings, {
+        "binding_mode": "zero_copy_mmap",
+        "zero_copy_parameters": zero_copy,
+        "converted_parameters": converted,
+        "materialized_region_count": len(materialized),
+        "materialized_bytes": sum(len(payload) for payload in materialized.values()),
+    }
+
+
+def zero_state_payloads(schema: Any, layout: Any) -> Dict[str, bytes]:
+    return {
+        entry.name: bytes(layout.region_for(entry.name).nbytes) for entry in schema.states
+    }
+
+
+def map_state_outputs_to_inputs(schema: Any, payloads: Mapping[str, bytes]) -> Dict[str, bytes]:
+    """把上一步的 state 输出按层前缀映射到下一步的 state 输入。"""
+
+    remap: Dict[str, bytes] = {}
+    consumed = set()
+    for entry in schema.states:
+        name = entry.name
+        payload = payloads.get(name)
+        if payload is None:
+            for pattern, template in STATE_PATTERNS:
+                match = pattern.match(name)
+                if not match:
+                    continue
+                group = match.group(1)
+                if template is not None:
+                    candidate = template.format(group)
+                else:
+                    prefix = "{}_recurrent_step_".format(group)
+                    matches = [key for key in payloads if key.startswith(prefix) and key.endswith("_new_state")]
+                    if len(matches) != 1:
+                        raise DriverError(
+                            "state {!r} has {} recurrent candidates".format(name, len(matches))
+                        )
+                    candidate = matches[0]
+                if candidate in payloads:
+                    payload = payloads[candidate]
+                    consumed.add(candidate)
+                    break
+        if payload is None:
+            raise DriverError("no previous-step source for state {!r}".format(name))
+        if len(payload) != entry.nbytes:
+            raise DriverError(
+                "state {!r} previous bytes {} != next bytes {}".format(
+                    name, len(payload), entry.nbytes
+                )
+            )
+        remap[name] = payload
+    return remap
+
+
+def state_bindings(
+    schema: Any, layout: Any, payloads: Optional[Mapping[str, bytes]]
+) -> Dict[str, BufferBinding]:
+    bindings: Dict[str, BufferBinding] = {}
+    for entry in schema.states:
+        region = layout.region_for(entry.name)
+        if payloads is not None and entry.name in payloads:
+            payload = payloads[entry.name]
+        else:
+            payload = bytes(region.nbytes)
+        buffer = bytearray(payload)
+        bindings[entry.name] = BufferBinding.from_buffer(
+            buffer, region.storage_id, entry.dtype, entry.shape, readonly=True
+        )
+    return bindings
+
+
+def output_bindings(schema: Any) -> Tuple[Dict[str, BufferBinding], Dict[str, bytearray]]:
+    storage: Dict[str, bytearray] = {}
+    bindings: Dict[str, BufferBinding] = {}
+    for entry in schema.outputs:
+        total = 64 + entry.nbytes + 64
+        buffer = bytearray(total if total else 64)
+        buffer[:64] = bytes([CANARY]) * 64
+        if entry.nbytes:
+            buffer[64 + entry.nbytes:] = bytes([CANARY]) * 64
+        storage[entry.name] = buffer
+        bindings[entry.name] = BufferBinding.from_buffer(
+            buffer, entry.storage_id, entry.dtype, entry.shape,
+            byte_offset=64 if entry.nbytes else 0, readonly=False,
+        )
+    return bindings, storage
+
+
+def runtime_input_bindings(
+    schema: Any,
+    input_ids: Sequence[int],
+    cos_bits: Optional[Sequence[int]],
+    sin_bits: Optional[Sequence[int]],
+) -> Dict[str, BufferBinding]:
+    payloads: Dict[str, bytes] = {
+        "input_ids": struct.pack("<{}q".format(len(input_ids)), *[int(v) for v in input_ids]),
+    }
+    if cos_bits is not None:
+        payloads["cos"] = struct.pack("<{}H".format(len(cos_bits)), *[int(v) & 0xFFFF for v in cos_bits])
+    if sin_bits is not None:
+        payloads["sin"] = struct.pack("<{}H".format(len(sin_bits)), *[int(v) & 0xFFFF for v in sin_bits])
+    bindings: Dict[str, BufferBinding] = {}
+    for entry in schema.runtime_inputs:
+        payload = payloads.get(entry.name)
+        if payload is None:
+            if entry.name in ("cos", "sin"):
+                count = _element_count(entry.shape)
+                fill = _bf16_bits(1.0 if entry.name == "cos" else 0.0)
+                payload = struct.pack("<{}H".format(count), *([fill] * count))
+            else:
+                raise DriverError("unsupported runtime input {!r}".format(entry.name))
+        if len(payload) != entry.nbytes:
+            raise DriverError(
+                "runtime input {} payload {} bytes != schema {}".format(
+                    entry.name, len(payload), entry.nbytes
+                )
+            )
+        bindings[entry.name] = BufferBinding.from_buffer(
+            bytearray(payload), entry.storage_id, entry.dtype, entry.shape, readonly=True
+        )
+    return bindings
+
