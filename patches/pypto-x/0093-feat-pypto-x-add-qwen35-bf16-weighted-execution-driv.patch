+def micro_benchmark_host_reference(
+    elements: int, build_dir: Path, recorder: OpRecorder
+) -> Mapping[str, Any]:
+    """用真实 AVX-512 artifact 量测 host_reference 路径的每元素成本。
+
+    只做 ``cast`` bf16→f32 一个算子，输入输出都是真实 ctypes buffer；量到的
+    bytes/s 用于把整网的 host_reference 字节流量外推成时间量级。
+    """
+
+    from pypto.compiler import CompileOptions
+    from pypto.core_ir import CoreFunction, CoreProgram, CoreType, Operation, Region, ValueRef
+
+    source = ValueRef("source", CoreType.tensor("bf16", (elements,)))
+    output = ValueRef("output", CoreType.tensor("float32", (elements,)))
+    program = CoreProgram(
+        functions=(
+            CoreFunction("micro_cast", (source,), (output,), Region((Operation("cast", (source,), (output,)),))),
+        )
+    )
+    target = TargetSpec("cpu", "x86_64-linux-gnu", features=("avx512f",), attributes={"lane_count": 16})
+    compiler = Avx512Compiler()
+    target_ir = compiler.lower(program, target)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(artifact_format="pypto-x.cpu.avx512", extra={"build_dir": str(build_dir / "micro")}),
+    )
+    source_buffer = bytearray(struct.pack("<H", _bf16_bits(0.5)) * elements)
+    destination = bytearray(4 * elements)
+    request = LaunchRequest(
+        artifact,
+        inputs=[TensorDesc("bf16", (elements,), handle=source_buffer, readonly=True)],
+        outputs=[TensorDesc("float32", (elements,), handle=destination)],
+    )
+    runtime = InstrumentedAvx512Runtime(recorder=recorder)
+    started = time.perf_counter()
+    runtime.launch(request)
+    elapsed = time.perf_counter() - started
+    payload_bytes = elements * (2 + 4)
+    return {
+        "elements": elements,
+        "input_bytes": elements * 2,
+        "output_bytes": elements * 4,
+        "seconds": round(elapsed, 4),
+        "bytes_per_second": (payload_bytes / elapsed) if elapsed else None,
+        "elements_per_second": (elements / elapsed) if elapsed else None,
+    }
+
