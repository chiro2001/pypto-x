+def stage_s1(args: argparse.Namespace) -> Mapping[str, Any]:
+    program, schema, layout = build_graph(args.steps, args.past_length, args.shape_profile)
+    census = graph_census(program, schema, layout)
+    budget = _cgroup_mib("/memory.max")
+    build_dir = Path(args.build_dir) if args.build_dir else Path(args.work_dir or ".") / "s1-build"
+    build_dir.mkdir(parents=True, exist_ok=True)
+    result: Dict[str, Any] = {
+        "stage": "s1",
+        "backend": args.backend,
+        "prompt": args.prompt,
+        "steps": args.steps,
+        "past_length": args.past_length,
+        "synthetic": True,
+        "shape_profile": args.shape_profile,
+        "note": "合成权重只用于真实形状下的管线预演，不作为任何正确性结论",
+        "census": census,
+        "memory_model": memory_model(census),
+        "cgroup_memory_max_mib": budget,
+    }
+    backend = make_backend(args.backend)
+    artifact, compile_info = compile_program(backend, program, build_dir)
+    result["compile"] = compile_info
+    result["rss_after_compile_mib"] = _maxrss_mib()
+
+    recorder = OpRecorder(args.progress_obj, budget, not args.no_watchdog, args.abort_op_mib)
+    if args.micro_benchmark_elements:
+        result["micro_benchmark"] = micro_benchmark_host_reference(
+            args.micro_benchmark_elements, build_dir, recorder
+        )
+        reference_bytes = memory_model(census)["host_reference_list_overhead_bytes"] // LIST_OVERHEAD
+        rate = result["micro_benchmark"]["bytes_per_second"]
+        result["micro_benchmark"]["host_reference_total_bytes"] = reference_bytes
+        result["micro_benchmark"]["projected_host_reference_seconds"] = (
+            (reference_bytes / rate) if rate else None
+        )
+        result["micro_benchmark"]["projected_host_reference_minutes"] = (
+            (reference_bytes / rate / 60.0) if rate else None
+        )
+    parameters, states = synthetic_bindings(schema, layout)
+    outputs, output_storage = output_bindings(schema)
+    runtime_inputs = runtime_input_bindings(schema, [0] * args.steps, None, None)
+    request = build_request(schema, artifact, runtime_inputs, parameters, states, outputs, backend["device"])
+    runtime = make_runtime(backend, recorder)
+    started = time.perf_counter()
+    error: Optional[str] = None
+    try:
+        runtime.launch(request)
+    except BudgetExceeded as exc:
+        error = "BudgetExceeded: {}".format(exc)
+    except Exception as exc:  # noqa: BLE001
+        error = "{}: {}".format(type(exc).__name__, exc)
+    result["launch_seconds"] = round(time.perf_counter() - started, 3)
+    result["launch_error"] = error
+    result["budget_watchdog_stop"] = recorder.stopped_reason
+    result["op_summary"] = summarise_ops(recorder)
+    result["rss_peak_mib"] = _maxrss_mib()
+    result["cgroup_memory_peak_mib"] = _cgroup_mib("/memory.peak")
+    result["output_canary_intact"] = all(
+        output_storage[entry.name][:64] == bytes([CANARY]) * 64
+        for entry in schema.outputs
+    )
+    result["status"] = "PASS" if error is None else "BLOCKED"
+    return result
+
