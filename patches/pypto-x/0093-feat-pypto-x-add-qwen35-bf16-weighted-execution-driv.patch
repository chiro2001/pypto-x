+# --------------------------------------------------------------------------
+# 编译 / 执行
+# --------------------------------------------------------------------------
+
+
+def make_backend(name: str) -> Mapping[str, Any]:
+    if name == "avx512":
+        return {
+            "compiler": Avx512Compiler(),
+            "target": TargetSpec("cpu", "x86_64-linux-gnu", features=("avx512f",),
+                                 attributes={"lane_count": 16}),
+            "device": "cpu", "format": "pypto-x.cpu.avx512", "runtime": "avx512",
+        }
+    if name == "avx2":
+        return {
+            "compiler": Avx2Compiler(),
+            "target": TargetSpec("cpu", "x86_64-linux-gnu", features=("avx2",),
+                                 attributes={"lane_count": 8}),
+            "device": "cpu", "format": "pypto-x.cpu.avx2", "runtime": "avx2",
+        }
+    if name == "scalar":
+        return {
+            "compiler": CpuScalarCompiler(),
+            "target": TargetSpec("cpu", "x86_64-linux-gnu"),
+            "device": "cpu", "format": None, "runtime": "scalar",
+        }
+    if name == "cuda":
+        from pypto.backends.cuda import CudaDriver
+        from pypto.compiler.targets.cuda import CudaPtxCompiler
+
+        driver = CudaDriver()
+        return {
+            "compiler": CudaPtxCompiler(driver=driver, probe_jit=True),
+            "target": TargetSpec("gpu", "gpu-neutral", attributes={"workgroup": (4,)}),
+            "device": "gpu", "format": None, "runtime": "cuda", "driver": driver,
+        }
+    raise DriverError("unsupported backend {!r}".format(name))
+
+
+def compile_program(backend: Mapping[str, Any], program: Any, build_dir: Path) -> Tuple[Any, Mapping[str, Any]]:
+    from pypto.compiler import CompileOptions
+
+    compiler = backend["compiler"]
+    started = time.perf_counter()
+    target_ir = compiler.lower(program, backend["target"])
+    lowered = time.perf_counter()
+    if backend["format"] is not None:
+        options = CompileOptions(artifact_format=backend["format"], extra={"build_dir": str(build_dir)})
+        artifact = compiler.compile(target_ir, options)
+    else:
+        artifact = compiler.compile(target_ir)
+    compiled = time.perf_counter()
+    metadata = dict(getattr(artifact, "metadata", {}) or {})
+    return artifact, {
+        "lower_seconds": round(lowered - started, 3),
+        "compile_seconds": round(compiled - lowered, 3),
+        "artifact_format": getattr(artifact, "format", None),
+        "artifact_path": getattr(artifact, "path", None),
+        "artifact_content_digest": getattr(artifact, "content_digest", None),
+        "artifact_nbytes": os.path.getsize(artifact.path) if getattr(artifact, "path", None) else None,
+        "plan_count": len(getattr(target_ir, "plans", ()) or ()),
+        "lowering_version": metadata.get("lowering_version"),
+        "native_operations": metadata.get("native_operations"),
+        "host_reference_operations": metadata.get("host_reference_operations"),
+    }
+
+
+def make_runtime(backend: Mapping[str, Any], recorder: Optional[OpRecorder]) -> Any:
+    name = backend["runtime"]
+    if name == "avx512":
+        return InstrumentedAvx512Runtime(recorder=recorder)
+    if name == "avx2":
+        return Avx2Runtime()
+    if name == "scalar":
+        return CpuScalarRuntime()
+    if name == "cuda":
+        from pypto.backends.cuda import CudaRuntime
+
+        driver = backend["driver"]
+        timed = TimedCudaDriver(driver, recorder) if recorder is not None else driver
+        return CudaRuntime(driver=timed)
+    raise DriverError("unsupported runtime {!r}".format(name))
+
+
+def build_request(schema: Any, artifact: Any, runtime_inputs: Mapping[str, BufferBinding],
+                  parameters: Mapping[str, BufferBinding], states: Mapping[str, BufferBinding],
+                  outputs: Mapping[str, BufferBinding], device: str) -> LaunchRequest:
+    regular = {entry.name: outputs[entry.name] for entry in schema.regular_outputs}
+    state_outputs = {entry.name: outputs[entry.name] for entry in schema.state_outputs}
+    return assemble_launch_request(
+        schema, artifact, runtime_inputs, parameters, states, regular, state_outputs, device=device
+    )
+
