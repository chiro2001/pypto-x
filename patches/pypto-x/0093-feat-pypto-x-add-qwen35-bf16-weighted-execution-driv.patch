+def liveness_peak_bytes(program: Any, schema: Any) -> Mapping[str, Any]:
+    """按 SSA 最后使用点估算"有 liveness 释放"时的峰值（不含参数）。"""
+
+    function = program.functions[0]
+    parameter_names = {entry.name for entry in schema.parameters}
+    state_names = {entry.name for entry in schema.states}
+    sizes: Dict[str, int] = {}
+    last_use: Dict[str, int] = {}
+    for index, operation in enumerate(function.body.operations):
+        for ref in operation.outputs:
+            sizes[ref.name] = _ref_bytes(ref)
+        for ref in operation.inputs:
+            if ref.name not in parameter_names:
+                last_use[ref.name] = index
+    live: Dict[str, int] = {}
+    peak = 0
+    peak_index = -1
+    for index, operation in enumerate(function.body.operations):
+        for ref in operation.outputs:
+            live[ref.name] = sizes.get(ref.name, 0)
+        for ref in operation.inputs:
+            if ref.name in live and last_use.get(ref.name) == index and ref.name not in parameter_names:
+                live.pop(ref.name, None)
+        total = sum(live.values())
+        if total > peak:
+            peak = total
+            peak_index = index
+    return {
+        "peak_bytes_with_liveness_release": peak,
+        "peak_mib_with_liveness_release": peak // (1024 * 1024),
+        "peak_at_operation_index": peak_index,
+        "peak_operation": (
+            str(function.body.operations[peak_index].name) if peak_index >= 0 else None
+        ),
+        "parameter_bytes_zero_copy": sum(entry.nbytes for entry in schema.parameters),
+        "state_bytes": sum(entry.nbytes for entry in schema.states),
+    }
+
+
+def boundary_audit(program: Any, schema: Any) -> Mapping[str, Any]:
+    """逐个列出触碰参数级张量的算子，并按算子类聚合（修复菜单的输入）。"""
+
+    function = program.functions[0]
+    parameter_names = {entry.name for entry in schema.parameters}
+    individual: List[Dict[str, Any]] = []
+    derived_individual: List[Dict[str, Any]] = []
+    derived = set()
+    aggregate: Dict[str, Dict[str, Any]] = {}
+    for index, operation in enumerate(function.body.operations):
+        name = str(operation.name)
+        input_bytes = sum(_ref_bytes(ref) for ref in operation.inputs)
+        output_bytes = sum(_ref_bytes(ref) for ref in operation.outputs)
+        touches = sorted({ref.name for ref in operation.inputs if ref.name in parameter_names})
+        boundary = "host_reference" if name in HOST_REFERENCE_OPERATIONS else (
+            "native" if name in NATIVE_OPERATIONS else "unclassified"
+        )
+        entry = aggregate.setdefault(
+            name,
+            {"count": 0, "boundary": boundary, "input_bytes": 0, "output_bytes": 0,
+             "max_input_bytes": 0, "max_output_bytes": 0, "parameter_touching_count": 0,
+             "parameter_touching_input_bytes": 0, "parameter_touching_output_bytes": 0,
+             "largest": None, "largest_index": None},
+        )
+        entry["count"] += 1
+        entry["input_bytes"] += input_bytes
+        entry["output_bytes"] += output_bytes
+        if input_bytes + output_bytes > (entry["max_input_bytes"] + entry["max_output_bytes"]):
+            entry["max_input_bytes"] = input_bytes
+            entry["max_output_bytes"] = output_bytes
+            entry["largest"] = operation.outputs[0].name if operation.outputs else None
+            entry["largest_index"] = index
+        derived_inputs = sorted(ref.name for ref in operation.inputs
+                                if ref.name in derived or ref.name in parameter_names)
+        if derived_inputs:
+            derived_individual.append(
+                {
+                    "index": index,
+                    "operation": name,
+                    "boundary": boundary,
+                    "dtype": str(getattr(operation.outputs[0].type, "dtype", "")) if operation.outputs else "",
+                    "output": operation.outputs[0].name if operation.outputs else None,
+                    "input_bytes": input_bytes,
+                    "output_bytes": output_bytes,
+                    "inputs_derived_from_parameter": derived_inputs,
+                    "direct_parameters": touches,
+                    "list_materialization_mib": (
+                        (input_bytes + output_bytes) * LIST_OVERHEAD // (1024 * 1024)
+                        if boundary == "host_reference" else 0
+                    ),
+                    "runtime_output_buffer_mib": output_bytes // (1024 * 1024),
+                }
+            )
+        for ref in operation.outputs:
+            if any(source in derived or source in parameter_names for source in
+                   [item.name for item in operation.inputs]):
+                derived.add(ref.name)
+        if touches:
+            entry["parameter_touching_count"] += 1
+            entry["parameter_touching_input_bytes"] += input_bytes
+            entry["parameter_touching_output_bytes"] += output_bytes
+            individual.append(
+                {
+                    "index": index,
+                    "operation": name,
+                    "boundary": boundary,
+                    "dtype": str(getattr(operation.outputs[0].type, "dtype", "")) if operation.outputs else "",
+                    "output": operation.outputs[0].name if operation.outputs else None,
+                    "input_bytes": input_bytes,
+                    "output_bytes": output_bytes,
+                    "parameters": touches,
+                    "list_materialization_mib": (
+                        (input_bytes + output_bytes) * LIST_OVERHEAD // (1024 * 1024)
+                        if boundary == "host_reference" else 0
+                    ),
+                    "runtime_output_buffer_mib": output_bytes // (1024 * 1024),
+                }
+            )
+    individual.sort(key=lambda item: -(item["input_bytes"] + item["output_bytes"]))
+    derived_individual.sort(key=lambda item: -(item["input_bytes"] + item["output_bytes"]))
+    parameter_touching = {name: entry for name, entry in aggregate.items()
+                          if entry["parameter_touching_count"]}
+    return {
+        "parameter_touching_operation_classes": parameter_touching,
+        "largest_parameter_touching_operations": individual[:24],
+        "largest_parameter_derived_operations": derived_individual[:24],
+        "parameter_derived_total_count": len(derived_individual),
+        "parameter_touching_total_count": len(individual),
+        "parameter_touching_host_reference_count": sum(
+            1 for item in individual if item["boundary"] == "host_reference"
+        ),
+        "parameter_touching_host_reference_bytes": sum(
+            item["input_bytes"] + item["output_bytes"] for item in individual
+            if item["boundary"] == "host_reference"
+        ),
+    }
+
+
+def repair_menu(program: Any, schema: Any, census: Mapping[str, Any]) -> Mapping[str, Any]:
+    """把能力缺口量化成可选修复路线的峰值/耗时量级。"""
+
+    model = memory_model(census)
+    liveness = liveness_peak_bytes(program, schema)
+    params = census["parameter_bytes"]
+    intermediate = census["intermediate_bytes_retained_by_runtime"]
+    host_reference_bytes = model["host_reference_list_overhead_bytes"] // LIST_OVERHEAD
+    weight_cast_bytes = sum(
+        entry["output_bytes"] for name, entry in census["per_operation"].items()
+        if name == "cast"
+    )
+    weight_transpose_bytes = sum(
+        entry["output_bytes"] for name, entry in census["per_operation"].items()
+        if name == "transpose"
+    )
+    mib = lambda value: value // (1024 * 1024)  # noqa: E731
+    return {
+        "observed_capability_gap": (
+            "AVX-512/scalar runtime 的 host_reference 路径把输入/输出全量物化成 "
+            "Python list，且 launch 期间保留全部 SSA buffer"
+        ),
+        "option_a_native_cast_transpose_embedding_only": {
+            "removes": "Python list 物化（host_reference 路径）",
+            "keeps": "launch 期间保留全部 SSA 中间值",
+            "peak_mib": model["peak_mib_if_runtime_retains_everything"],
+            "cgroup_cap_mib": 8192,
+            "fits": model["peak_mib_if_runtime_retains_everything"] < 8192 * 0.85,
+            "note": "仍然保留 f32 权重副本与转置副本，占 cgroup 上限的 "
+                    "{:.1f}%".format(100.0 * model["peak_mib_if_runtime_retains_everything"] / 8192),
+        },
+        "option_b_liveness_or_streaming_release": {
+            "removes": "已经死掉的 SSA 值持续占用",
+            "peak_mib_with_liveness": liveness["peak_mib_with_liveness_release"],
+            "peak_operation": liveness["peak_operation"],
+            "fits": liveness["peak_mib_with_liveness_release"] < 8192 * 0.85,
+            "note": "仍需 (a) 解决 host_reference list 物化，否则单算子峰值照旧",
+        },
+        "option_c_avoid_weight_f32_promotion_and_transpose": {
+            "removes": "权重整块升 f32（{:.0f} MiB）与转置副本（{:.0f} MiB）".format(
+                mib(weight_cast_bytes), mib(weight_transpose_bytes)
+            ),
+            "peak_mib_retained_everything": mib(params + intermediate - weight_cast_bytes - weight_transpose_bytes),
+            "blocked_by": "需要改 Core IR/图契约（权重 dtype 与 matmul 语义），必须单独评审",
+            "fits": (params + intermediate - weight_cast_bytes - weight_transpose_bytes) < 8192 * 0.85 * 1024 * 1024,
+        },
+        "option_d_chunked_or_per_layer_launch": {
+            "removes": "整网一次性保留",
+            "estimate": "按层 launch：每层参数约 {:.0f} MiB + 该层中间值".format(
+                mib(params) / 24.0
+            ),
+            "blocked_by": "需要 per-layer 子图构造器与 state 串联（当前仓库没有）",
+            "time_risk": "host_reference 每字节成本不变，整网仍约 {:.1f} 分钟".format(
+                (host_reference_bytes / 6581931.54) / 60.0
+            ),
+        },
+        "measured_host_reference_throughput_bytes_per_second": 6581931.54,
+        "host_reference_total_bytes": host_reference_bytes,
+        "projected_host_reference_minutes": (host_reference_bytes / 6581931.54) / 60.0,
+    }
+
