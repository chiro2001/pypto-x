+def _run_once(
+    args: argparse.Namespace,
+    stage: str,
+    steps: int,
+    past_length: int,
+    reader: SafetensorsReader,
+    previous_states: Optional[Mapping[str, bytes]],
+    input_ids: Sequence[int],
+    cos_bits: Sequence[int],
+    sin_bits: Sequence[int],
+    build_dir: Path,
+) -> Tuple[Mapping[str, Any], Dict[str, bytes], Dict[str, bytes]]:
+    program, schema, layout = build_graph(steps, past_length)
+    backend = make_backend(args.backend)
+    artifact, compile_info = compile_program(backend, program, build_dir)
+    tie = tie_word_embeddings_from_config(str(Path(args.asset_dir) / "config.json"))
+    mapping = build_weight_mapping(schema, program.metadata, reader, tie_word_embeddings=tie)
+    weight_layout = build_weight_layout(schema, mapping, reader, alignment=64)
+    parameters, binding_evidence = real_parameters(schema, weight_layout, reader)
+    binding_evidence = dict(binding_evidence)
+    binding_evidence["mapped_count"] = mapping.mapped_count
+    binding_evidence["parameter_count"] = mapping.parameter_count
+    binding_evidence["layout_digest"] = weight_layout.layout_digest()
+    binding_evidence["conversion_storage_ids"] = list(weight_layout.dtype_conversion_storage_ids)
+    mapped = (
+        map_state_outputs_to_inputs(schema, previous_states) if previous_states is not None else None
+    )
+    states = state_bindings(schema, weight_layout, mapped)
+    outputs, output_storage = output_bindings(schema)
+    runtime_inputs = runtime_input_bindings(schema, input_ids, cos_bits, sin_bits)
+    request = build_request(schema, artifact, runtime_inputs, parameters, states, outputs, backend["device"])
+    recorder = OpRecorder(
+        args.progress_obj, _cgroup_mib("/memory.max"), not args.no_watchdog, args.abort_op_mib
+    )
+    runtime = make_runtime(backend, recorder)
+    started = time.perf_counter()
+    error: Optional[str] = None
+    try:
+        runtime.launch(request)
+    except BudgetExceeded as exc:
+        error = "BudgetExceeded: {}".format(exc)
+    except Exception as exc:  # noqa: BLE001
+        error = "{}: {}".format(type(exc).__name__, exc)
+    launch_seconds = time.perf_counter() - started
+    raw_outputs: Dict[str, bytes] = {}
+    state_payloads: Dict[str, bytes] = {}
+    for entry in schema.outputs:
+        buffer = output_storage[entry.name]
+        payload = bytes(buffer[64:64 + entry.nbytes]) if entry.nbytes else b""
+        raw_outputs[entry.name] = payload
+        state_payloads[entry.name] = payload
+    record: Dict[str, Any] = {
+        "stage": stage,
+        "backend": args.backend,
+        "steps": steps,
+        "past_length": past_length,
+        "synthetic": False,
+        "graph_digest": schema.graph_digest,
+        "operation_total": len(program.functions[0].body.operations),
+        "compile": compile_info,
+        "binding": binding_evidence,
+        "launch_seconds": round(launch_seconds, 3),
+        "launch_error": error,
+        "budget_watchdog_stop": recorder.stopped_reason,
+        "op_summary": summarise_ops(recorder),
+        "rss_peak_mib": _maxrss_mib(),
+        "cgroup_memory_peak_mib": _cgroup_mib("/memory.peak"),
+        "cgroup_memory_max_mib": _cgroup_mib("/memory.max"),
+        "outputs": {
+            entry.name: {
+                "dtype": entry.dtype,
+                "shape": list(entry.shape),
+                "nbytes": entry.nbytes,
+                "raw_sha256": hashlib.sha256(raw_outputs[entry.name]).hexdigest(),
+            }
+            for entry in schema.outputs
+        },
+    }
+    record["status"] = "PASS" if error is None else "BLOCKED"
+    return record, state_payloads, raw_outputs
+
+
+def _align_prefill(record: Dict[str, Any], raw: Mapping[str, bytes], reference_dir: Path,
+                   prompt: str, steps: int) -> None:
+    comparisons: Dict[str, Any] = {}
+    for variant in ("float32", "bfloat16"):
+        path = golden_paths(reference_dir, prompt)[variant]
+        if not path.is_file():
+            continue
+        gold = load_npz(path)
+        comparisons[variant] = {
+            "logits_vs_prefill_logits": compare_rows(
+                raw["logits"], "bf16", gold["prefill_logits"], steps, 248320, "logits"
+            ),
+            "final_hidden_vs_last_hidden_state": compare_rows(
+                raw["final_hidden"], "bf16", gold["last_hidden_state"], steps, 1024, "final_hidden"
+            ),
+        }
+        if "prefill_next_logits" in gold:
+            comparisons[variant]["prefill_next_logits_argmax"] = {
+                "ours": int(
+                    _raw_to_float_array(raw["logits"], "bf16").astype("float64")[-248320:].argmax()
+                ),
+                "gold": int(gold["prefill_next_logits"].argmax()),
+            }
+    record["comparisons"] = comparisons
+    positions = _raw_to_float_array(raw["position_ids"], "int64")
+    record["position_ids"] = [int(v) for v in positions]
+    record["position_ids_expected"] = list(range(steps))
+    record["position_ids_equal"] = [int(v) for v in positions] == list(range(steps))
+    record["gold_dtype_band"] = gold_dtype_band(reference_dir, prompt)
+
+
+def stage_s2(args: argparse.Namespace) -> Mapping[str, Any]:
+    prompt = args.prompt
+    steps = args.steps
+    asset = Path(args.asset_dir)
+    checkpoint = asset / CHECKPOINT_NAME
+    reference = Path(args.reference_dir)
+    gold = load_npz(reference / "float32" / "{}.npz".format(prompt))
+    input_ids = [int(v) for v in gold["input_ids"]]
+    if len(input_ids) != steps:
+        raise DriverError("prompt {} expects {} steps, got {}".format(prompt, steps, len(input_ids)))
+    cos_bits, sin_bits, rope_source = rope_bits_for_positions(
+        Path(args.rope_dir), prompt, list(range(steps))
+    )
+    build_dir = Path(args.build_dir) if args.build_dir else Path(args.work_dir or ".") / "s2-build"
+    build_dir.mkdir(parents=True, exist_ok=True)
+    with SafetensorsReader(str(checkpoint), mode="mmap") as reader:
+        record, _states, raw = _run_once(
+            args, "s2", steps, args.past_length, reader, None, input_ids, cos_bits, sin_bits, build_dir
+        )
+    record["prompt"] = prompt
+    record["rope_source"] = rope_source
+    if record["status"] == "PASS":
+        _align_prefill(record, raw, reference, prompt, steps)
+    return record
+
+
+def stage_s3(args: argparse.Namespace) -> Mapping[str, Any]:
+    prompt = args.prompt
+    steps = args.steps
+    asset = Path(args.asset_dir)
+    checkpoint = asset / CHECKPOINT_NAME
+    reference = Path(args.reference_dir)
+    gold = load_npz(reference / "float32" / "{}.npz".format(prompt))
+    input_ids = [int(v) for v in gold["input_ids"]]
+    if len(input_ids) != steps:
+        raise DriverError("prompt {} expects {} steps".format(prompt, steps))
+    build_dir = Path(args.build_dir) if args.build_dir else Path(args.work_dir or ".") / "s3-build"
+    build_dir.mkdir(parents=True, exist_ok=True)
+    decode_records: List[Mapping[str, Any]] = []
+    with SafetensorsReader(str(checkpoint), mode="mmap") as reader:
+        cos_bits, sin_bits, rope_source = rope_bits_for_positions(
+            Path(args.rope_dir), prompt, list(range(steps))
+        )
+        record, states, raw = _run_once(
+            args, "s3-prefill", steps, 0, reader, None, input_ids, cos_bits, sin_bits, build_dir
+        )
+        record["prompt"] = prompt
+        record["rope_source"] = rope_source
+        if record["status"] == "PASS":
+            _align_prefill(record, raw, reference, prompt, steps)
+            decode_logits = gold["decode_logits"]
+            decode_tokens = [int(v) for v in gold["decode_token_ids"]]
+            current = int(
+                _raw_to_float_array(raw["logits"], "bf16").astype("float64")[-248320:].argmax()
+            )
+            if args.decode_steps:
+                for step in range(args.decode_steps):
+                    past = steps + step
+                    cos_bits, sin_bits, step_rope = rope_bits_for_positions(
+                        Path(args.rope_dir), prompt, [past]
+                    )
+                    step_record, states, raw = _run_once(
+                        args, "s3-decode", 1, past, reader, states, [current],
+                        cos_bits, sin_bits, build_dir,
+                    )
+                    step_record["prompt"] = prompt
+                    step_record["decode_step"] = step
+                    step_record["position"] = past
+                    step_record["input_token"] = current
+                    step_record["rope_source"] = step_rope
+                    if step_record["status"] == "PASS":
+                        actual = _raw_to_float_array(raw["logits"], "bf16").astype("float64")
+                        argmax = int(actual.argmax())
+                        step_record["argmax_token"] = argmax
+                        step_record["gold_decode_token_id"] = decode_tokens[step]
+                        step_record["gold_argmax_token"] = int(decode_logits[step].argmax())
+                        step_record["token_matches_gold_token_id"] = argmax == decode_tokens[step]
+                        step_record["token_matches_gold_argmax"] = argmax == int(decode_logits[step].argmax())
+                        step_record["logits_vs_decode_logits"] = compare_rows(
+                            raw["logits"], "bf16", decode_logits[step], 1, 248320, "decode_logits"
+                        )
+                        current = argmax
+                    decode_records.append(step_record)
+                    if step_record["status"] != "PASS":
+                        break
+        record["decode_steps"] = decode_records
+        record["decode_token_ids_ours"] = [item.get("argmax_token") for item in decode_records]
+        record["decode_token_ids_gold"] = [item.get("gold_decode_token_id") for item in decode_records]
+    return record
+
+
+def stage_s4(args: argparse.Namespace) -> Mapping[str, Any]:
+    prompt = args.prompt
+    steps = args.steps
+    reference = Path(args.reference_dir)
+    gold = load_npz(reference / "float32" / "{}.npz".format(prompt))
+    layers = gold["hidden_states_layers"]
+    input_ids = [int(v) for v in gold["input_ids"]]
+    build_dir = Path(args.build_dir) if args.build_dir else Path(args.work_dir or ".") / "s4-build"
+    build_dir.mkdir(parents=True, exist_ok=True)
+    cos_bits, sin_bits, rope_source = rope_bits_for_positions(
+        Path(args.rope_dir), prompt, list(range(steps))
+    )
+    with SafetensorsReader(str(Path(args.asset_dir) / CHECKPOINT_NAME), mode="mmap") as reader:
+        record, _states, raw = _run_once(
+            args, "s4", steps, args.past_length, reader, None, input_ids, cos_bits, sin_bits, build_dir
+        )
+    report: Dict[str, Any] = {
+        "stage": "s4",
+        "prompt": prompt,
+        "steps": steps,
+        "backend": args.backend,
+        "run_status": record["status"],
+        "launch_error": record.get("launch_error"),
+        "budget_watchdog_stop": record.get("budget_watchdog_stop"),
+        "executed_operations": record.get("op_summary", {}).get("executed_operations"),
+        "operation_total": record.get("operation_total"),
+        "last_executed_operation": (
+            record.get("op_summary", {}).get("by_operation", {}) and
+            list(record["op_summary"]["by_operation"])[:1]
+        ),
+        "rope_source": rope_source,
+        "gold_layer_count": int(layers.shape[0]),
+        "note": (
+            "本仓库没有 per-layer 子图构造器，无法在真实权重大小下单独执行第 N 层；"
+            "这里给出整网执行的精确阻塞点与可达边界，用于定位第一个不可执行层"
+        ),
+    }
+    if record["status"] == "PASS":
+        report["final_hidden_vs_gold_last_hidden_state"] = compare_rows(
+            raw["final_hidden"], "bf16", gold["last_hidden_state"], steps, 1024, "final_hidden"
+        )
+        report["logits_vs_prefill_logits"] = compare_rows(
+            raw["logits"], "bf16", gold["prefill_logits"], steps, 248320, "logits"
+        )
+    report["status"] = record["status"]
+    return report
+
+
+# --------------------------------------------------------------------------
+# CLI
+# --------------------------------------------------------------------------
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Qwen3.5-0.8B BF16 weighted execution driver")
+    parser.add_argument("--stage", required=True,
+                        choices=("preflight", "boundary-audit", "s1", "s2", "s3", "s4"))
+    parser.add_argument("--shape-profile", default="model", choices=("model", "synthetic_test"))
+    parser.add_argument("--backend", default="avx512", choices=("avx512", "avx2", "scalar", "cuda"))
+    parser.add_argument("--prompt", default="en_continuation", choices=PROMPTS)
+    parser.add_argument("--steps", type=int, default=None)
+    parser.add_argument("--past-length", type=int, default=0)
+    parser.add_argument("--decode-steps", type=int, default=4)
+    parser.add_argument("--asset-dir", default=None)
+    parser.add_argument("--reference-dir", default=None)
+    parser.add_argument("--rope-dir", default=None)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--progress", default=None)
+    parser.add_argument("--work-dir", default=None)
+    parser.add_argument("--build-dir", default=None)
+    parser.add_argument("--hash-checkpoint", action="store_true")
+    parser.add_argument("--no-watchdog", action="store_true")
+    parser.add_argument("--abort-op-mib", type=int, default=None,
+                        help="host_reference 单算子预估物化超过该值时确定性中止")
+    parser.add_argument("--micro-benchmark-elements", type=int, default=0,
+                        help="S1 额外量测 host_reference 每元素成本（真实 AVX-512 artifact）")
+    parser.add_argument("--verbose", action="store_true")
+    return parser
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    if args.steps is None:
+        args.steps = PROMPT_STEPS[args.prompt]
+    progress = Progress(args.progress)
+    args.progress_obj = progress
+    started = time.time()
+    payload: Dict[str, Any] = {
+        "driver": "qwen35_weighted_execution_driver",
+        "driver_version": DRIVER_VERSION,
+        "stage": args.stage,
+        "argv": list(sys.argv[1:]),
+        "python": sys.version.split()[0],
+        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(started)),
+    }
+    try:
+        progress.emit("stage-start", stage=args.stage, backend=args.backend,
+                      prompt=args.prompt, steps=args.steps, past_length=args.past_length)
+        if args.stage == "preflight":
+            payload.update(stage_preflight(args))
+        elif args.stage == "boundary-audit":
+            payload.update(stage_boundary_audit(args))
+        elif args.stage == "s1":
+            payload.update(stage_s1(args))
+        elif args.stage == "s2":
+            payload.update(stage_s2(args))
+        elif args.stage == "s3":
+            payload.update(stage_s3(args))
+        elif args.stage == "s4":
+            payload.update(stage_s4(args))
+    except BudgetExceeded as exc:
+        payload["status"] = "BLOCKED"
+        payload["error"] = "BudgetExceeded: {}".format(exc)
+    except Exception as exc:  # noqa: BLE001 - driver 必须留下失败证据
+        payload["status"] = "FAIL"
+        payload["error"] = "{}: {}".format(type(exc).__name__, exc)
+        if args.verbose:
+            import traceback
+
+            payload["traceback"] = traceback.format_exc()
+    finally:
+        payload.setdefault("status", "FAIL")
+        payload["finished_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        payload["wall_seconds"] = round(time.time() - started, 3)
+        payload["rss_peak_mib"] = _maxrss_mib()
+        payload["cgroup_memory_peak_mib"] = _cgroup_mib("/memory.peak")
+        Path(args.output).parent.mkdir(parents=True, exist_ok=True)
+        with open(args.output, "w", encoding="utf-8") as stream:
+            json.dump(payload, stream, ensure_ascii=False, sort_keys=True, indent=2)
+            stream.write("\n")
+        progress.emit("stage-end", status=payload["status"], output=args.output)
+        progress.close()
+    print(json.dumps({
+        "status": payload.get("status"),
+        "stage": args.stage,
+        "backend": args.backend,
+        "output": args.output,
+        "wall_seconds": payload.get("wall_seconds"),
+    }, ensure_ascii=False, sort_keys=True))
+    return 0 if payload.get("status") == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
