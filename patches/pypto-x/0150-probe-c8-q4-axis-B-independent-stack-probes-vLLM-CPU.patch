+#!/usr/bin/env bash
+# A3 axis-B probe driver (light): host facts + container vLLM CPU/int8 existence.
+#
+# Discipline: host-side heavy work pinned to CPUs 320-639; container is limited
+# to its own cpuset 560-639 by construction; NPU/chip7 untouched
+# (ASCEND_RT_VISIBLE_DEVICES / CUDA_VISIBLE_DEVICES cleared for every exec).
+set -uo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PYPROBE="$SCRIPT_DIR/11_a3_vllm_probe.py"
+ENV_PY="$HOME/pypto-x-a3/envs/pypto-x-c8/bin/python"
+CONTAINER="${CONTAINER:-pypto-x-a3}"
+HOST_CPUS="${HOST_CPUS:-320-639}"
+
+echo "### A3 axis-B probe $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "--- host facts ---"
+hostname
+uname -a
+nproc
+grep -E 'MemTotal|MemAvailable' /proc/meminfo
+echo "Cpus_allowed(self)=$(grep Cpus_allowed_list /proc/self/status | cut -d: -f2 | tr -d ' ')"
+echo "sve_default_vector_length=$(cat /proc/sys/abi/sve_default_vector_length 2>/dev/null || echo n/a)"
+lscpu 2>/dev/null | grep -iE 'Model name|Features|CPU\(s\)|NUMA' | head -6
+
+echo "--- host conda env $ENV_PY ---"
+if [[ -x "$ENV_PY" ]]; then
+    taskset -c "$HOST_CPUS" "$ENV_PY" -VV
+    echo "-- host env probe (vllm likely absent) --"
+    mkdir -p "$SCRIPT_DIR/../logs"
+    taskset -c "$HOST_CPUS" timeout 300 "$ENV_PY" "$PYPROBE" > "$SCRIPT_DIR/../logs/host_env_probe.json" 2>"$SCRIPT_DIR/../logs/host_env_probe.stderr.log"
+    echo "host_env_probe_rc=$?"
+else
+    echo "MISSING host env python: $ENV_PY"
+fi
+
+echo "--- aarch64 vllm-cpu wheel existence (metadata only, no download) ---"
+taskset -c "$HOST_CPUS" timeout 60 "$ENV_PY" -m pip index versions vllm-cpu 2>&1 | tail -4
+taskset -c "$HOST_CPUS" timeout 60 "$ENV_PY" -m pip index versions vllm 2>&1 | tail -4
+
+echo "--- container $CONTAINER ---"
+docker ps --format '{{.Names}} {{.Image}} {{.Status}}' | head -5
+echo "image_digest=$(docker inspect --format '{{.Image}}' "$CONTAINER" 2>/dev/null)"
+echo "cpuset=$(docker exec "$CONTAINER" grep Cpus_allowed_list /proc/self/status 2>/dev/null | cut -d: -f2 | tr -d ' ')"
+echo "-- container python/dist versions --"
+docker exec -e ASCEND_RT_VISIBLE_DEVICES= -e CUDA_VISIBLE_DEVICES= "$CONTAINER" \
+    sh -c 'for p in torch transformers vllm vllm-ascend vllm-cpu numpy compressed-tensors; do python3 -c "import importlib.metadata as md; print(\"$p\", md.version(\"$p\"))" 2>/dev/null || echo "$p ABSENT"; done' 2>&1 | tail -8
+echo "-- container probe (stdin, no file written in container) --"
+docker exec -i -e ASCEND_RT_VISIBLE_DEVICES= -e CUDA_VISIBLE_DEVICES= \
+    -e OMP_NUM_THREADS=8 -e HF_HUB_OFFLINE=1 "$CONTAINER" \
+    timeout 600 python3 - < "$PYPROBE" > "$SCRIPT_DIR/../logs/container_probe.json" 2>"$SCRIPT_DIR/../logs/container_probe.stderr.log"
+echo "container_probe_rc=$?"
+echo "### done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
diff --git a/scripts/c8_axis_b_probe/11_a3_vllm_probe.py b/scripts/c8_axis_b_probe/11_a3_vllm_probe.py
new file mode 100644
index 000000000..a9762100d
--- /dev/null
+++ b/scripts/c8_axis_b_probe/11_a3_vllm_probe.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""A3 (aarch64) axis-B probe: can vLLM run CPU-only and does an int8 CPU path exist?
+
+Runs either in the A3 container (`python3`) or in the host conda env
+(`~/pypto-x-a3/envs/pypto-x-c8/bin/python`).  Light only: imports + op presence,
+no model weights are loaded, no NPU is touched.
+
+Output: one JSON document on stdout.
+"""
+
+import glob
+import importlib.metadata as md
+import json
+import os
+import platform
+import subprocess
+import sys
+
+
+def dist_versions():
+    out = {}
+    for name in ("vllm", "vllm-ascend", "vllm-cpu", "torch", "transformers", "numpy",
+                 "compressed-tensors", "torch-npu", "oneDNN", "onednn"):
+        try:
+            out[name] = md.version(name)
+        except Exception:
+            pass
+    return out
+
+
+def so_symbol_report():
+    report = {}
+    try:
+        import vllm
+        base = os.path.dirname(vllm.__file__)
+        for so in sorted(glob.glob(os.path.join(base, "_C*.so"))):
+            entry = {"path": so, "bytes": os.path.getsize(so)}
+            strings = ""
+            for tool in (["strings", so],):
+                try:
+                    strings = subprocess.run(
+                        tool, capture_output=True, text=True, timeout=60
+                    ).stdout
+                    break
+                except Exception as exc:  # pragma: no cover
+                    entry["strings_error"] = str(exc)
+            entry["has_dynamic_scaled_int8_quant"] = "dynamic_scaled_int8_quant" in strings
+            entry["has_onednn_scaled_mm"] = "onednn_scaled_mm" in strings
+            entry["has_create_onednn_scaled_mm_handler"] = (
+                "create_onednn_scaled_mm_handler" in strings
+            )
+            entry["has_aarch64_tag"] = ("aarch64" in strings) or ("AArch64" in strings)
+            report[os.path.basename(so)] = entry
+    except Exception as exc:
+        report["error"] = "%s: %s" % (type(exc).__name__, exc)
+    return report
+
+
+def main():
+    info = {
+        "schema": "pypto-x.c8-axis-b-probe.a3-vllm-probe.v1",
+        "python": sys.version.split()[0],
+        "executable": sys.executable,
+        "machine": platform.machine(),
+        "system": platform.system(),
+        "cpus_allowed": None,
+        "cpuinfo_features": None,
+        "dist_versions": dist_versions(),
+        "imports": {},
+        "so_symbols": so_symbol_report(),
+    }
+    try:
+        with open("/proc/self/status", "r", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("Cpus_allowed_list"):
+                    info["cpus_allowed"] = line.split(":", 1)[1].strip()
+    except Exception:
+        pass
+    try:
+        with open("/proc/cpuinfo", "r", encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("Features") or line.startswith("flags"):
+                    info["cpuinfo_features"] = line.split(":", 1)[1].strip()
+                    break
+    except Exception:
+        pass
+
+    def probe(name, fn):
+        try:
+            info["imports"][name] = fn()
+        except Exception as exc:
+            info["imports"][name] = "ERROR %s: %s" % (type(exc).__name__, str(exc)[:300])
+
+    def import_torch():
+        import torch
+
+        return {
+            "version": torch.__version__,
+            "cuda_available": torch.cuda.is_available(),
+            "mkldnn_available": bool(torch.backends.mkldnn.is_available()),
+        }
+
+    def import_vllm():
+        import vllm
+
+        return {"version": vllm.__version__, "file": vllm.__file__}
+
+    def platform_info():
+        from vllm.platforms import current_platform
+
+        return {
+            "class": type(current_platform).__name__,
+            "device_type": str(getattr(current_platform, "device_type", None)),
+            "device_name": str(getattr(current_platform, "device_name", None)),
+            "supported_quantization": list(current_platform.supported_quantization),
+        }
+
+    def cpu_int8_ops():
+        import torch
+        from vllm import _custom_ops as ops
+
+        x = torch.randn(2, 8, dtype=torch.bfloat16)
+        result = {}
+        for opname in ("onednn_scaled_int8_quant", "dynamic_scaled_int8_quant"):
+            fn = getattr(ops, opname, None)
+            if fn is None:
+                result[opname] = "attribute missing"
+                continue
+            if opname == "onednn_scaled_int8_quant":
+                out = fn(x, None, None, True)
+                result[opname] = {
+                    "ok": True,
+                    "codes_dtype": str(out[0].dtype),
+                    "scale_dtype": str(out[1].dtype),
+                }
+            else:
+                out = torch.empty_like(x, dtype=torch.int8)
+                scale = torch.empty((2, 1), dtype=torch.float32)
+                fn(out, x, scale, None)
+                result[opname] = {"ok": True, "scale": scale.flatten().tolist()}
+        return result
+
+    def tp_group_probe():
+        import vllm.distributed.parallel_state as ps
+        import torch
+
+        ps.init_distributed_environment(
+            world_size=1, rank=0,
+            distributed_init_method="tcp://127.0.0.1:29547",
+            local_rank=0, backend="gloo",
+        )
+        ps._TP = ps._WORLD
+        from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (
+            CompressedTensorsConfig,
+        )
+        from vllm.model_executor.layers.linear import ReplicatedLinear
+
+        cfg = {
+            "config_groups": {"group_0": {
+                "targets": ["Linear"],
+                "weights": {"num_bits": 8, "type": "int", "symmetric": True,
+                            "strategy": "channel", "dynamic": False},
+                "input_activations": {"num_bits": 8, "type": "int", "symmetric": True,
+                                      "strategy": "token", "dynamic": True},
+            }},
+            "quant_method": "compressed-tensors",
+            "format": "int-quantized",
+            "ignore": [],
+        }
+        qc = CompressedTensorsConfig.from_config(cfg)
+        layer = ReplicatedLinear(
+            64, 128, bias=False, params_dtype=torch.bfloat16, quant_config=qc,
+            prefix="probe.layer", disable_tp=True,
+        )
+        return {
+            "quant_method": type(layer.quant_method).__name__,
+            "scheme": type(layer.scheme).__name__,
+            "kernel": type(layer.scheme.kernel).__name__,
+        }
+
+    probe("torch", import_torch)
+    probe("vllm", import_vllm)
+    probe("platform", platform_info)
+    probe("cpu_int8_ops", cpu_int8_ops)
+    probe("w8a8_layer", tp_group_probe)
+    print(json.dumps(info, indent=1, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
