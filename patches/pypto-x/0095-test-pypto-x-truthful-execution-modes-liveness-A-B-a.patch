+def rewrite_decay_gate_to_exp_a_log(program: Any) -> Tuple[Any, int]:
+    """调试副本：把 GDR decay 门从 ``-A_log`` 改成官方 ``-exp(A_log)``。
+
+    只改这一处 SSA：``neg(a_log_full)`` -> ``neg(exp(a_log_full))``，并
+    保持算子顺序与返回契约不变。用于证明数值发散的根因，不作为交付实现。
+    """
+
+    from pypto.core_ir import CoreFunction, CoreProgram, Operation, Region, ValueRef
+
+    function = program.functions[0]
+    suffix = "_negative_a_log"
+    rewritten = []
+    count = 0
+    for operation in function.body.operations:
+        names = [ref.name for ref in operation.outputs]
+        if operation.name == "neg" and len(names) == 1 and names[0].endswith(suffix):
+            source = operation.inputs[0]
+            exp_ref = ValueRef(names[0][: -len(suffix)] + "_a_log_exp", source.type)
+            rewritten.append(Operation("exp", (source,), (exp_ref,), {}))
+            rewritten.append(
+                Operation("neg", (exp_ref,), operation.outputs, dict(operation.attributes))
+            )
+            count += 1
+            continue
+        rewritten.append(operation)
+    if count == 0:
+        raise DriverError("no GDR decay gate matched for the exp(A_log) debug rewrite")
+    body = Region(tuple(rewritten))
+    rebuilt = CoreProgram(
+        functions=(CoreFunction(function.name, function.parameters, function.returns, body),),
+        metadata=program.metadata,
+    )
+    return rebuilt, count
+
+
+def debug_hidden_state_names(program: Any) -> Tuple[str, ...]:
+    """返回与 gold ``hidden_states_layers`` 一一对应的中间 SSA 名字。
+
+    索引 0 = embedding 之后的 hidden（layer_hidden_inputs[0]），索引 i+1 =
+    第 i 层输出（layer_hidden_outputs[i]）。只读图元数据，不改图。
+    """
+
+    metadata = program.metadata
+    inputs = tuple(metadata.get("layer_hidden_inputs", ()))
+    outputs = tuple(metadata.get("layer_hidden_outputs", ()))
+    if not inputs or not outputs:
+        raise DriverError("graph metadata has no layer hidden-state chain")
+    return (inputs[0],) + outputs
+
+
+def extend_returns(program: Any, names: Sequence[str]) -> Any:
+    """在**副本**上把已存在的中间 SSA 值追加为图返回值（公开 48+3 返回契约不变）。
+
+    调试专用：不改任何算子、不改参数、不改绑定 schema 的输入分组；只是让
+    launcher 能把逐层 hidden state 取出来做 bisect。
+    """
+
+    from pypto.core_ir import CoreFunction, CoreProgram
+
+    function = program.functions[0]
+    available = {ref.name: ref for ref in function.parameters}
+    for operation in function.body.operations:
+        for ref in operation.outputs:
+            available[ref.name] = ref
+    missing = [name for name in names if name not in available]
+    if missing:
+        raise DriverError("debug hidden states are not in the graph: {}".format(missing))
+    existing = set(ref.name for ref in function.returns)
+    ordered: List[str] = []
+    for name in names:
+        if name in existing or name in ordered:
+            continue
+        ordered.append(name)
+    extra = tuple(available[name] for name in ordered)
+    returns = tuple(function.returns) + extra
+    extended = CoreFunction(function.name, function.parameters, returns, function.body)
+    return CoreProgram(functions=(extended,), metadata=program.metadata)
+
+
+def build_graph(steps: int, past_length: int, shape_profile: str = "model",
+                debug_hidden_states: bool = False, debug_extra_returns: Sequence[str] = (),
+                debug_decay_exp_a_log: bool = False):
     program = build_qwen35_text_decoder_graph(
         1, steps, past_length=past_length, shape_profile=shape_profile
     )
+    if debug_decay_exp_a_log:
+        program, _rewritten = rewrite_decay_gate_to_exp_a_log(program)
+    extra_names: Tuple[str, ...] = ()
+    if debug_hidden_states:
+        extra_names += debug_hidden_state_names(program)
+    if debug_extra_returns:
+        extra_names += tuple(debug_extra_returns)
+    if extra_names:
+        program = extend_returns(program, extra_names)
     schema = build_binding_schema(program)
     layout = build_packed_layout(schema)
     return program, schema, layout
