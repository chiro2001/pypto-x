+def _disable_liveness_release() -> None:
+    """关闭三个 CPU 后端的 SSA liveness 释放（只用于语义等价性 A/B 证据）。
+
+    默认不启用：这是证据工具，不是执行开关。关闭后同一张图的全部输出摘要
+    必须与开启时逐位一致，否则说明释放点选错了。
+    """
+
+    import pypto.backends.cpu.vector.runtime as vector_runtime
+    import pypto.backends.cpu.x86.avx2 as avx2_runtime
+    import pypto.backends.cpu.x86.avx512 as avx512_runtime
+
+    def _no_release(*args: Any, **kwargs: Any) -> tuple:
+        return ()
+
+    for module in (vector_runtime, avx2_runtime, avx512_runtime):
+        module.release_dead_values = _no_release
+    avx512_runtime.CpuAvx512Runtime = avx512_runtime.Avx512Runtime
+
+
