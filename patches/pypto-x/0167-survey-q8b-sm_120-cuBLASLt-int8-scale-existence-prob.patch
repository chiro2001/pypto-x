diff --git a/scripts/vendor/q8b/nvidia_sm120_cublaslt_probe.c b/scripts/vendor/q8b/nvidia_sm120_cublaslt_probe.c
new file mode 100644
index 000000000..d2d0e9cf0
--- /dev/null
+++ b/scripts/vendor/q8b/nvidia_sm120_cublaslt_probe.c
@@ -0,0 +1,207 @@
+/* Q8b NVIDIA sm_120 leg: cuBLASLt int8 + scale-descriptor existence probe.
+ *
+ * Build (GamePC WSL2, CUDA 13.3 / cuBLAS 13.6):
+ *   nvcc -O2 -arch=sm_120 -o probe nvidia_sm120_cublaslt_probe.c -lcublasLt -lcublas
+ *
+ * Every API call is logged with its numeric status and cublasGetStatusString()
+ * text so a failure is reproducible from the transcript alone.
+ * Usage: probe [--bench]
+ */
+#include <cublasLt.h>
+#include <cublas_v2.h>
+#include <cuda_runtime.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static int g_fail_plain_int8 = 0;
+
+static const char *st(cublasStatus_t s) {
+    const char *p = cublasGetStatusString(s);
+    return p ? p : "?";
+}
+
+static void log_call(const char *what, cublasStatus_t s) {
+    printf("  [%-58s] status=%d (%s)\n", what, (int)s, st(s));
+    fflush(stdout);
+}
+
+typedef struct {
+    int m, k, n;
+    cudaDataType_t at, bt, ct;
+    cublasComputeType_t compute;
+    int use_a_scale, use_b_scale, use_d_scale, use_bias;
+    const char *name;
+} Case;
+
+static cublasStatus_t run_case(cublasLtHandle_t lt, const Case *c, int warmup, int iters,
+                               double *out_ms) {
+    size_t asz = (size_t)c->m * c->k, bsz = (size_t)c->k * c->n, csz = (size_t)c->m * c->n;
+    void *A = NULL, *B = NULL, *C = NULL, *D = NULL;
+    float *sa = NULL, *sb = NULL, *sd = NULL;
+    cudaMalloc(&A, asz); cudaMalloc(&B, bsz);
+    cudaMemset(A, 1, asz); cudaMemset(B, 1, bsz);
+    cudaMalloc(&D, csz * 4);
+    C = D;
+    if (c->use_a_scale) { cudaMalloc((void **)&sa, sizeof(float) * (size_t)c->m); cudaMemset(sa, 0, sizeof(float) * c->m); }
+    if (c->use_b_scale) { cudaMalloc((void **)&sb, sizeof(float) * (size_t)c->n); cudaMemset(sb, 0, sizeof(float) * c->n); }
+    if (c->use_d_scale) { cudaMalloc((void **)&sd, sizeof(float)); cudaMemset(sd, 0, sizeof(float)); }
+
+    cublasLtMatmulDesc_t desc = NULL;
+    cublasOperation_t opn = CUBLAS_OP_N;
+    float alpha1 = 1.0f, beta0 = 0.0f;
+    cublasStatus_t s = cublasLtMatmulDescCreate(&desc, c->compute, CUDA_R_32F);
+    log_call("cublasLtMatmulDescCreate", s);
+    if (s != CUBLAS_STATUS_SUCCESS) goto out;
+
+    s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSA, &opn, sizeof(cublasOperation_t));
+    log_call("set TRANSA=N", s);
+    s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSB, &opn, sizeof(cublasOperation_t));
+    log_call("set TRANSB=N", s);
+    if (c->use_a_scale) { s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_A_SCALE_POINTER, &sa, sizeof(sa)); log_call("set A_SCALE_POINTER", s); if (s) goto out; }
+    if (c->use_b_scale) { s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_B_SCALE_POINTER, &sb, sizeof(sb)); log_call("set B_SCALE_POINTER", s); if (s) goto out; }
+    if (c->use_d_scale) { s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_D_SCALE_POINTER, &sd, sizeof(sd)); log_call("set D_SCALE_POINTER", s); if (s) goto out; }
+    if (c->use_bias) { float *bias = NULL; cudaMalloc((void **)&bias, sizeof(float) * (size_t)c->n); cudaMemset(bias, 0, sizeof(float) * c->n);
+        s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_BIAS_POINTER, &bias, sizeof(bias)); log_call("set BIAS_POINTER", s); if (s) goto out; }
+    { cublasLtEpilogue_t epi = c->use_bias ? CUBLASLT_EPILOGUE_BIAS : CUBLASLT_EPILOGUE_DEFAULT;
+      s = cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_EPILOGUE, &epi, sizeof(epi)); log_call("set EPILOGUE", s); }
+
+    cublasLtMatrixLayout_t la = NULL, lb = NULL, ld = NULL;
+    s = cublasLtMatrixLayoutCreate(&la, c->at, c->m, c->k, c->k); log_call("layout A (row-major m x k)", s);
+    s = cublasLtMatrixLayoutCreate(&lb, c->bt, c->k, c->n, c->n); log_call("layout B (row-major k x n)", s);
+    s = cublasLtMatrixLayoutCreate(&ld, c->ct, c->m, c->n, c->n); log_call("layout D (row-major m x n)", s);
+
+    cublasLtMatmulPreference_t pref = NULL;
+    cublasLtMatmulPreferenceCreate(&pref);
+    size_t ws_bytes = 32u << 20;
+    void *ws = NULL; cudaMalloc(&ws, ws_bytes);
+    cublasLtMatmulPreferenceSetAttribute(pref, CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &ws_bytes, sizeof(ws_bytes));
+    cublasLtMatmulHeuristicResult_t heur;
+    memset(&heur, 0, sizeof(heur));
+    int returned = 0;
+    s = cublasLtMatmulAlgoGetHeuristic(lt, desc, la, lb, ld, ld, pref, 1, &heur, &returned);
+    log_call("cublasLtMatmulAlgoGetHeuristic", s);
+    int algo_ok = (s == CUBLAS_STATUS_SUCCESS && returned > 0);
+    if (algo_ok) {
+        float alpha = 1.0f, beta = 0.0f;
+        for (int i = 0; i < warmup; i++)
+            cublasLtMatmul(lt, desc, &alpha, A, la, B, lb, &beta, C, ld, D, ld, &heur.algo, ws, ws_bytes, 0);
+        cudaDeviceSynchronize();
+        struct timespec t0, t1; clock_gettime(CLOCK_MONOTONIC, &t0);
+        cublasStatus_t last = CUBLAS_STATUS_SUCCESS;
+        for (int i = 0; i < iters; i++)
+            last = cublasLtMatmul(lt, desc, &alpha, A, la, B, lb, &beta, C, ld, D, ld, &heur.algo, ws, ws_bytes, 0);
+        cudaDeviceSynchronize();
+        clock_gettime(CLOCK_MONOTONIC, &t1);
+        log_call("cublasLtMatmul (timed loop, last status)", last);
+        if (out_ms && iters > 0)
+            *out_ms = ((t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6) / iters;
+    } else {
+        s = cublasLtMatmul(lt, desc, &alpha1, A, la, B, lb, &beta0, C, ld, D, ld, NULL, ws, ws_bytes, 0);
+        log_call("cublasLtMatmul (NULL algo -> default path)", s);
+    }
+
+    if (pref) cublasLtMatmulPreferenceDestroy(pref);
+    if (la) cublasLtMatrixLayoutDestroy(la);
+    if (lb) cublasLtMatrixLayoutDestroy(lb);
+    if (ld) cublasLtMatrixLayoutDestroy(ld);
+out:
+    if (desc) cublasLtMatmulDescDestroy(desc);
+    if (ws) cudaFree(ws);
+    if (sa) cudaFree(sa); if (sb) cudaFree(sb); if (sd) cudaFree(sd);
+    if (A) cudaFree(A); if (B) cudaFree(B); if (D) cudaFree(D);
+    return s;
+}
+
+int main(int argc, char **argv) {
+    int bench = (argc > 1 && !strcmp(argv[1], "--bench"));
+    int dev = 0;
+    cudaGetDevice(&dev);
+    cudaDeviceProp prop;
+    cudaGetDeviceProperties(&prop, dev);
+    printf("== Q8b NVIDIA sm_120 cuBLASLt int8 existence probe ==\n");
+    printf("device=%s cc=%d.%d driverver=%d runtime=%d\n", prop.name, prop.major, prop.minor,
+           prop.driverVersion, CUDART_VERSION);
+    printf("cublasLtGetVersion=%zu cublasGetVersion=%zu\n", cublasLtGetVersion(),
+           (size_t)cublasGetVersion());
+    printf("int8 mma support per device query (cudaDevAttrTensorCoreSupport)=%d\n",
+           (int)prop.major >= 8);
+
+    cublasLtHandle_t lt = NULL;
+    cublasStatus_t s = cublasLtCreate(&lt);
+    log_call("cublasLtCreate", s);
+    if (s != CUBLAS_STATUS_SUCCESS) return 1;
+
+    Case cases[] = {
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_32I, CUBLAS_COMPUTE_32I, 0, 0, 0, 0,
+         "int8 x int8 -> s32, no scales"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32I, 0, 0, 0, 0,
+         "int8 x int8 -> bf16, no scales"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_32I, CUBLAS_COMPUTE_32I, 1, 1, 0, 0,
+         "int8 + A/B_SCALE_POINTER -> s32"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32I, 1, 1, 0, 0,
+         "int8 + A/B_SCALE_POINTER -> bf16"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32I, 1, 0, 0, 0,
+         "int8 + A_SCALE_POINTER only -> bf16"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32I, 0, 0, 1, 0,
+         "int8 + D_SCALE_POINTER -> bf16"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32F, 0, 0, 0, 0,
+         "int8 x int8 -> bf16, compute 32F"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32I, 0, 0, 0, 1,
+         "int8 -> bf16 + BIAS epilogue"},
+        {5, 3584, 1024, CUDA_R_8I, CUDA_R_8I, CUDA_R_16BF, CUBLAS_COMPUTE_32I, 1, 1, 0, 1,
+         "int8 + A/B scale + BIAS -> bf16"},
+        {5, 3584, 1024, CUDA_R_8F_E4M3, CUDA_R_8F_E4M3, CUDA_R_16BF, CUBLAS_COMPUTE_32F, 1, 1, 0, 0,
+         "fp8E4M3 + A/B scale -> bf16 (control: descriptors accepted)"},
+        {5, 3584, 1024, CUDA_R_16BF, CUDA_R_16BF, CUDA_R_16BF, CUBLAS_COMPUTE_32F, 0, 0, 0, 0,
+         "bf16 x bf16 -> bf16 (control)"},
+    };
+    const int ncases = (int)(sizeof(cases) / sizeof(cases[0]));
+    for (int i = 0; i < ncases; i++) {
+        printf("\n-- case %d: %s --\n", i, cases[i].name);
+        double ms = 0;
+        cublasStatus_t rc = run_case(lt, &cases[i], 2, 5, &ms);
+        printf("  RESULT case=%d ok=%d ms=%.4f\n", i, rc == CUBLAS_STATUS_SUCCESS, ms);
+        if (i == 0 && rc == CUBLAS_STATUS_SUCCESS) g_fail_plain_int8 = 0;
+        else if (i == 0) g_fail_plain_int8 = 1;
+        fflush(stdout);
+    }
+
+    /* classic cublasGemmEx control */
+    {
+        printf("\n-- classic cublasGemmEx int8 -> s32 (compute 32I) --\n");
+        int m = 5, k = 3584, n = 1024;
+        void *A = NULL, *B = NULL, *C = NULL;
+        cudaMalloc(&A, (size_t)m * k); cudaMalloc(&B, (size_t)k * n); cudaMalloc(&C, (size_t)m * n * 4);
+        cudaMemset(A, 1, (size_t)m * k); cudaMemset(B, 1, (size_t)k * n);
+        cublasHandle_t h; cublasCreate(&h);
+        cublasStatus_t rc = cublasGemmEx(h, CUBLAS_OP_N, CUBLAS_OP_N, n, m, k, &(int){1}, B, CUDA_R_8I, n,
+                                         A, CUDA_R_8I, k, &(int){0}, C, CUDA_R_32I, n,
+                                         CUBLAS_COMPUTE_32I, CUBLAS_GEMM_DEFAULT);
+        log_call("cublasGemmEx int8/s32/32I", rc);
+        cublasDestroy(h); cudaFree(A); cudaFree(B); cudaFree(C);
+    }
+
+    if (bench && !g_fail_plain_int8) {
+        printf("\n== plain int8 works; running 12-shape timing (no scales) ==\n");
+        const int shapes[][2] = {{1024, 32}, {1024, 5120}, {1024, 7168}, {1024, 8192},
+                                 {2048, 1024}, {3584, 1024}};
+        const int mvals[2] = {1, 5};
+        for (int mi = 0; mi < 2; mi++)
+            for (int si = 0; si < 6; si++) {
+                Case c = {mvals[mi], shapes[si][0], shapes[si][1], CUDA_R_8I, CUDA_R_8I,
+                          CUDA_R_32I, CUBLAS_COMPUTE_32I, 0, 0, 0, 0, "bench"};
+                double ms = 0;
+                cublasStatus_t rc = run_case(lt, &c, 3, 20, &ms);
+                double ops = 2.0 * c.m * c.k * c.n;
+                printf("bench m=%d k=%d n=%d ok=%d ms=%.5f gflops=%.2f\n", c.m, c.k, c.n,
+                       rc == CUBLAS_STATUS_SUCCESS, ms, ops / (ms * 1e-3) / 1e9);
+            }
+    }
+    cublasLtDestroy(lt);
+    printf("\nDONE\n");
+    return 0;
+}
