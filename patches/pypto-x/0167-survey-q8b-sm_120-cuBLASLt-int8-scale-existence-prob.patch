@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Q8b NVIDIA sm_120 leg: build + run the cuBLASLt int8 existence probe on GamePC.
+#
+# GPU-only probe: no `gamepc` resource lock is taken (single-file nvcc compile +
+# short GPU probes are the light-host path described in the lock README; no
+# weights are downloaded, nothing persistent is changed).
+#
+# Local driver, runs on the workstation; the remote WSL dir is deleted after the
+# transcript is copied into the _meta evidence tree.
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+HOST="${Q8B_GAMEPC_HOST:-chiro@192.168.101.5}"
+RDIR="\$HOME/q8b-sm120"
+OUT_DIR="${Q8B_NVIDIA_OUT:-/home/chiro/projects/pypto/worktrees/_meta/pypto-x/vendor-gemm-survey-2/raw}"
+mkdir -p "$OUT_DIR"
+
+wsl() { ssh -o BatchMode=yes "$HOST" "wsl.exe -e bash -lc \"$1\""; }
+
+wsl "mkdir -p ${RDIR} && rm -f ${RDIR}/*"
+ssh -o BatchMode=yes "$HOST" "wsl.exe -e bash -lc \"cat > ${RDIR}/probe.c\"" < "$HERE/nvidia_sm120_cublaslt_probe.c"
+wsl "cd ${RDIR} && nvcc -O2 -arch=sm_120 -o probe probe.c -lcublasLt -lcublas" \
+    | tee "$OUT_DIR/nvidia-sm120-build.log"
+
+{
+    echo "== GPU facts =="
+    wsl "nvidia-smi --query-gpu=name,compute_cap,driver_version,memory.total --format=csv,noheader"
+    echo "== probe transcript =="
+    wsl "cd ${RDIR} && ./probe --bench"
+} 2>&1 | tee "$OUT_DIR/nvidia-sm120-cublaslt-probe.txt"
+
+cp "$HERE/nvidia_sm120_cublaslt_probe.c" "$OUT_DIR/nvidia-sm120-cublaslt-probe.c"
+wsl "rm -rf ${RDIR}"
+echo "remote probe dir removed"
