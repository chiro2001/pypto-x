+        "storage_bytes",
+        "aliases",
+    )
+    for index, (actual, expected) in enumerate(zip(manifest, expected_manifest)):
+        context = "parameter_manifest[{}]".format(index)
+        if not isinstance(actual, Mapping):
+            raise BindingMismatchError("{} must be a mapping".format(context))
+        for field_name in required_fields:
+            if field_name not in actual:
+                raise BindingMismatchError("{}.{} is missing".format(context, field_name))
+            if _manifest_field_value(actual, field_name) != _manifest_field_value(expected, field_name):
+                raise BindingMismatchError("{}.{} does not match trusted Qwen manifest".format(context, field_name))
+
     storage_count = _metadata_uint64(metadata, "parameter_storage_count")
     if storage_count != len(manifest):
         raise BindingMismatchError(
@@ -662,7 +861,13 @@ def build_binding_schema(program: CoreProgram, entrypoint: Optional[str] = None)
     graph_kind = metadata.get("graph_kind")
     if graph_kind == "text_decoder_full_no_weight":
         exact_elements, exact_bytes = _parameter_entry_totals(entries)
-        manifest_elements, manifest_bytes = _audit_qwen_parameter_manifest(metadata)
