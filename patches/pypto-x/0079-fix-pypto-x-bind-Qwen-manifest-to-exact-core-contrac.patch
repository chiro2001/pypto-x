-def _audit_qwen_parameter_manifest(metadata: Mapping[str, Any]) -> Tuple[int, int]:
+def _qwen_entry(entries: Sequence[BindingEntry], name: str, role: str) -> BindingEntry:
+    matches = [entry for entry in entries if entry.name == name and entry.role == role]
+    if len(matches) != 1:
+        raise BindingMismatchError("exact Core contract must contain one {} {!r}".format(role, name))
+    return matches[0]
+
