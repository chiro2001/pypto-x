+def _expected_qwen_parameter_manifest(
+    parameter_entries: Sequence[BindingEntry],
+    state_entries: Sequence[BindingEntry],
+) -> Tuple[Mapping[str, Any], ...]:
+    """Build the trusted compact Qwen manifest from exact Core entries.
+
+    The compact metadata is not used to infer names or dimensions.  Profile
+    dimensions come from exact parameter/state types, while the fixed Qwen
+    24-layer 18 GDR/6 full-attention topology comes from the checked-in
+    portable builder.  The trusted builder then supplies the only accepted
+    compact names, storage IDs, counts and aliases.
+    """
+
+    from .qwen35 import QWEN35_08B_SHAPE_METADATA, _decoder_parameter_manifest
+
+    parameters = tuple(parameter_entries)
+    shared = _qwen_entry(parameters, "embedding_lm_head_shared_weight", "parameter")
+    if len(shared.shape) != 2:
+        raise BindingMismatchError("Qwen tied embedding parameter must be rank 2")
+    vocab, hidden = shared.shape
+    dtype = shared.dtype
+    if vocab <= 0 or hidden <= 0:
+        raise BindingMismatchError("Qwen tied embedding parameter must have positive dimensions")
+    if any(entry.dtype != dtype for entry in parameters):
+        raise BindingMismatchError("Qwen model parameters must use one exact dtype")
+
+    gate = _qwen_entry(parameters, "layer_00_mlp_gate_proj_weight", "parameter")
+    up = _qwen_entry(parameters, "layer_00_mlp_up_proj_weight", "parameter")
+    down = _qwen_entry(parameters, "layer_00_mlp_down_proj_weight", "parameter")
+    if gate.shape[1] != hidden or up.shape != gate.shape or down.shape != (hidden, gate.shape[0]):
+        raise BindingMismatchError("Qwen MLP parameter shapes are inconsistent with hidden size")
+    intermediate = gate.shape[0]
+    _qwen_entry(parameters, "layer_00_input_layernorm_weight", "parameter")
+    _qwen_entry(parameters, "layer_00_post_attention_layernorm_weight", "parameter")
+
+    full_indices = tuple(QWEN35_08B_SHAPE_METADATA["full_attention_indices_zero_based"])
+    if full_indices != (3, 7, 11, 15, 19, 23):
+        raise BindingMismatchError("checked-in Qwen full-attention topology changed unexpectedly")
+    full_q = _qwen_entry(parameters, "layer_03_q_proj_weight", "parameter")
+    full_k = _qwen_entry(parameters, "layer_03_k_proj_weight", "parameter")
+    full_v = _qwen_entry(parameters, "layer_03_v_proj_weight", "parameter")
+    full_o = _qwen_entry(parameters, "layer_03_o_proj_weight", "parameter")
+    q_norm = _qwen_entry(parameters, "layer_03_q_norm_weight", "parameter")
+    k_norm = _qwen_entry(parameters, "layer_03_k_norm_weight", "parameter")
+    if len(q_norm.shape) != 1 or q_norm.shape != k_norm.shape:
+        raise BindingMismatchError("Qwen full-attention norm shapes are inconsistent")
+    head_dim = q_norm.shape[0]
+    if head_dim <= 0 or full_q.shape[0] % (2 * head_dim) or full_k.shape[0] % head_dim:
+        raise BindingMismatchError("Qwen full-attention projection shapes are invalid")
+    query_heads = full_q.shape[0] // (2 * head_dim)
+    kv_heads = full_k.shape[0] // head_dim
+    if full_q.shape != (2 * query_heads * head_dim, hidden):
+        raise BindingMismatchError("Qwen q projection shape is inconsistent")
+    if full_k.shape != (kv_heads * head_dim, hidden) or full_v.shape != full_k.shape:
+        raise BindingMismatchError("Qwen k/v projection shapes are inconsistent")
+    if full_o.shape != (hidden, query_heads * head_dim):
+        raise BindingMismatchError("Qwen output projection shape is inconsistent")
+
+    gdr_qkv = _qwen_entry(parameters, "layer_00_in_proj_qkv_weight", "parameter")
+    gdr_z = _qwen_entry(parameters, "layer_00_in_proj_z_weight", "parameter")
+    gdr_b = _qwen_entry(parameters, "layer_00_in_proj_b_weight", "parameter")
+    gdr_a = _qwen_entry(parameters, "layer_00_in_proj_a_weight", "parameter")
+    conv = _qwen_entry(parameters, "layer_00_conv1d_weight", "parameter")
+    a_log = _qwen_entry(parameters, "layer_00_A_log", "parameter")
+    dt_bias = _qwen_entry(parameters, "layer_00_dt_bias", "parameter")
+    gdr_norm = _qwen_entry(parameters, "layer_00_norm_weight", "parameter")
+    gdr_out = _qwen_entry(parameters, "layer_00_out_proj_weight", "parameter")
+    if len(gdr_b.shape) != 2 or gdr_b.shape[1] != hidden or gdr_a.shape != gdr_b.shape:
+        raise BindingMismatchError("Qwen GDR gate projection shapes are inconsistent")
+    value_heads = gdr_b.shape[0]
+    if len(gdr_z.shape) != 2 or gdr_z.shape[1] != hidden:
+        raise BindingMismatchError("Qwen GDR z projection shape is invalid")
+    value_dim = gdr_z.shape[0]
+    if value_dim % value_heads:
+        raise BindingMismatchError("Qwen GDR value dimension is not divisible by value heads")
+    value_head_dim = value_dim // value_heads
+    if gdr_norm.shape != (value_head_dim,) or gdr_out.shape != (hidden, value_dim):
+        raise BindingMismatchError("Qwen GDR norm/output shapes are inconsistent")
+    if len(gdr_qkv.shape) != 2 or gdr_qkv.shape[1] != hidden:
+        raise BindingMismatchError("Qwen GDR qkv projection shape is invalid")
+    key_total = gdr_qkv.shape[0] - value_dim
+    recurrent = _qwen_entry(state_entries, "layer_00_recurrent_state_in", "state")
+    if len(recurrent.shape) != 4 or recurrent.shape[1] != value_heads or recurrent.shape[3] != value_head_dim:
+        raise BindingMismatchError("Qwen GDR recurrent state shape is inconsistent")
+    key_head_dim = recurrent.shape[2]
+    if key_total <= 0 or key_total % (2 * key_head_dim):
+        raise BindingMismatchError("Qwen GDR key projection shape is invalid")
+    key_heads = key_total // (2 * key_head_dim)
+    if gdr_qkv.shape != (2 * key_heads * key_head_dim + value_dim, hidden):
+        raise BindingMismatchError("Qwen GDR qkv shape is inconsistent")
+    if len(conv.shape) != 3 or conv.shape[0] != 2 * key_heads * key_head_dim + value_dim or conv.shape[1] != 1:
+        raise BindingMismatchError("Qwen GDR convolution shape is inconsistent")
+    conv_kernel = conv.shape[2]
+    if conv_kernel <= 0 or a_log.shape != (value_heads,) or dt_bias.shape != (value_heads,):
+        raise BindingMismatchError("Qwen GDR state-space parameter shapes are inconsistent")
+
+    profile = {
+        "hidden": hidden,
+        "intermediate": intermediate,
+        "vocab": vocab,
+        "query_heads": query_heads,
+        "kv_heads": kv_heads,
+        "head_dim": head_dim,
+        "linear_key_heads": key_heads,
+        "linear_value_heads": value_heads,
+        "linear_key_dim": key_head_dim,
+        "linear_value_dim": value_head_dim,
+        "conv_kernel": conv_kernel,
+    }
+    expected_manifest = tuple(_decoder_parameter_manifest(profile, dtype))
+    expected_exact = {}
+    for compact in expected_manifest:
+        pattern = compact["name"]
+        if pattern == "embedding_lm_head_shared_weight":
+            names = (pattern,)
+        elif pattern == "final_norm.weight":
+            names = ("final_norm_weight",)
+        elif pattern.startswith("layers.full_attention.*."):
+            suffix = pattern.split("*.", 1)[1].replace(".", "_")
+            names = tuple("layer_{:02d}_{}".format(index, suffix) for index in full_indices)
+        elif pattern.startswith("layers.linear_attention.*."):
+            suffix = pattern.split("*.", 1)[1].replace(".", "_")
+            names = tuple(
+                "layer_{:02d}_{}".format(index, suffix)
+                for index in range(24)
+                if index not in full_indices
+            )
+        elif pattern.startswith("layers.*."):
+            suffix = pattern.split("*.", 1)[1].replace(".", "_")
+            names = tuple("layer_{:02d}_{}".format(index, suffix) for index in range(24))
+        else:
+            raise BindingMismatchError("trusted Qwen manifest has an unknown compact name {!r}".format(pattern))
+        if len(names) != compact["count"]:
+            raise BindingMismatchError("trusted Qwen manifest count is inconsistent for {!r}".format(pattern))
+        for name in names:
+            if name in expected_exact:
+                raise BindingMismatchError("trusted Qwen manifest expands duplicate parameter {!r}".format(name))
+            expected_exact[name] = (dtype, tuple(compact["shape"]))
+    actual_exact = {entry.name: (entry.dtype, entry.shape) for entry in parameters}
+    if set(actual_exact) != set(expected_exact):
+        raise BindingMismatchError("exact Core parameter names do not match fixed Qwen topology")
+    for name, expected_contract in expected_exact.items():
+        if actual_exact[name] != expected_contract:
+            raise BindingMismatchError("exact Core parameter {!r} does not match trusted Qwen shape/dtype".format(name))
+    return expected_manifest
+
+
+def _manifest_field_value(entry: Mapping[str, Any], field_name: str) -> Any:
+    value = entry.get(field_name)
+    if field_name == "shape":
+        return tuple(value) if value is not None else None
+    if field_name == "aliases":
+        return tuple(value) if value is not None else None
+    return value
+
+
+def _audit_qwen_parameter_manifest(
+    metadata: Mapping[str, Any],
+    parameter_entries: Sequence[BindingEntry],
+    state_entries: Sequence[BindingEntry],
+) -> Tuple[int, int]:
     """Audit compact manifest arithmetic and return its aggregate totals.
 
     A manifest entry describes one unique storage class, with ``count``
@@ -499,6 +670,34 @@ def _audit_qwen_parameter_manifest(metadata: Mapping[str, Any]) -> Tuple[int, in
         manifest = tuple(raw_manifest)
     except TypeError as exc:
         raise BindingMismatchError("Qwen graph metadata parameter_manifest must be a sequence") from exc
+    expected_manifest = _expected_qwen_parameter_manifest(parameter_entries, state_entries)
+    if len(manifest) != len(expected_manifest):
+        raise BindingMismatchError(
+            "parameter_manifest length {} does not match trusted Qwen manifest length {}".format(
+                len(manifest), len(expected_manifest)
+            )
+        )
+    required_fields = (
