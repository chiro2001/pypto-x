+def test_wrong_dimension_and_mixed_dtype_predicates_fail_closed():
+    """The predicate itself must never claim a non-broadcastable plan."""
+
+    def fake_operation(input_kind, input_dtype, input_shape):
+        return types.SimpleNamespace(
+            name="broadcast",
+            inputs=(
+                types.SimpleNamespace(
+                    type=types.SimpleNamespace(
+                        kind=input_kind, dtype=input_dtype, shape=input_shape
+                    )
+                ),
+            ),
+        )
+
+    plan = types.SimpleNamespace(shape=(2, 4), dtype="float32", element_count=8)
+    operation = fake_operation("tensor", "float32", (2, 3))
+    assert broadcast_native_contract(operation, plan) is None
+    assert broadcast_native_fallback_reason(operation, plan) == (
+        "input dimension 3 on axis 1 is neither 1 nor equal to output dimension 4"
+    )
+
+    operation = fake_operation("tensor", "bf16", (2, 1))
+    assert broadcast_native_contract(operation, plan) is None
+    assert broadcast_native_fallback_reason(operation, plan) == (
+        "mixed input/output dtypes (bf16, float32) are not native AVX2 broadcast"
+    )
+
+    operation = fake_operation("tile", "float32", (2, 4, 4))
+    plan = types.SimpleNamespace(shape=(2, 4), dtype="float32", element_count=8)
+    assert broadcast_native_contract(operation, plan) is None
+    assert broadcast_native_fallback_reason(operation, plan) == (
+        "input rank 3 exceeds output rank 2"
+    )
+
+    # A mixed-dtype broadcast is rejected by vector-common validation before
+    # the backend predicate is ever consulted (fail-closed at compile time).
+    mixed = _broadcast_program("float32", (1, 3), (1, 3), output_dtype="bf16")
+    with pytest.raises(CpuVectorValidationError, match="dtypes must match"):
+        Avx2Compiler().lower(mixed, AVX2_TARGET)
+
+
+def test_non_contiguous_descriptor_is_rejected_before_dispatch(tmp_path):
+    program = _broadcast_program("float32", (1, 5, 1), (1, 5, 8))
+    _target_ir, artifact = _compile(program, tmp_path, "strided")
+    source = _raw_array("float32", [1.0] * 5)
+    output = _raw_array("float32", [0.0] * 40)
+    # Non-contiguous strides are rejected by the existing launch gate; the
+    # native kernel itself consumes the plan's contiguous-stride mapping.
+    strided = TensorDesc(
+        "float32", (1, 5, 1), strides=(8, 2, 1), device="cpu", address=ctypes.addressof(source)
+    )
+    with pytest.raises(CpuAvx2ExecutionError, match="contiguous"):
+        _runtime().launch(
+            LaunchRequest(
+                artifact,
+                inputs=[strided],
+                outputs=[_descriptor("float32", (1, 5, 8), output)],
+            )
+        )
+
+
+def test_qwen35_decode_and_prefill_broadcast_plans_are_all_native():
+    """Every broadcast in the Qwen3.5 AVX2 T=1/T=5 graphs must be native."""
+
+    from pypto.portable.qwen35 import build_qwen35_text_decoder_graph
+
+    for steps, past_length, expected in ((1, 5, 350), (5, 0, 494)):
+        program = build_qwen35_text_decoder_graph(
+            1, steps, past_length=past_length, shape_profile="model", precision="bf16"
+        )
+        target_ir = Avx2Compiler().lower(program, AVX2_TARGET)
+        operations = program.functions[0].body.operations
+        broadcast_count = 0
+        native_count = 0
+        for operation, plan in zip(operations, target_ir.plans):
+            if operation.name != "broadcast":
+                continue
+            broadcast_count += 1
+            if broadcast_native_contract(operation, plan) is not None:
+                native_count += 1
+            else:
+                raise AssertionError(
+                    "Qwen3.5 broadcast {} -> {} fell back: {}".format(
+                        operation.inputs[0].type.shape,
+                        operation.outputs[0].type.shape,
+                        broadcast_native_fallback_reason(operation, plan),
+                    )
+                )
+        assert broadcast_count == expected
+        assert native_count == expected
+
