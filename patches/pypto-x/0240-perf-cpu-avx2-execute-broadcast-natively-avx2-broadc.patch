+
+def _runtime():
+    runtime = Avx2Runtime()
+    if not runtime.is_available():
+        pytest.skip("host lacks AVX2/YMM capability: {}".format(runtime.availability().to_dict()))
+    return runtime
+
+
+def _compile(program, tmp_path, name):
+    compiler = Avx2Compiler()
+    target_ir = compiler.lower(program, AVX2_TARGET)
+    artifact = compiler.compile(
+        target_ir,
+        CompileOptions(
+            artifact_format="pypto-x.cpu.avx2", extra={"build_dir": str(tmp_path / name)}
+        ),
+    )
+    return target_ir, artifact
+
+
+def _broadcast_program(
+    dtype,
+    input_shape,
+    output_shape,
+    output_dtype=None,
+    scalar=False,
+):
+    if scalar:
+        input_type = CoreType.scalar(dtype)
+        input_ref = ValueRef("source", input_type)
+    else:
+        input_type = CoreType.tensor(dtype, tuple(input_shape))
+        input_ref = ValueRef("source", input_type)
+    output_type = CoreType.tensor(output_dtype or dtype, tuple(output_shape))
+    output_ref = ValueRef("output", output_type)
+    operation = Operation(
+        "broadcast", (input_ref,), (output_ref,), {"shape": list(output_shape)}
+    )
+    return CoreProgram(
+        functions=(CoreFunction("bcast", (input_ref,), (output_ref,), Region((operation,))),)
+    )
+
+
+def _raw_array(dtype, bits):
+    array = (_CTYPES[dtype] * len(bits))()
+    if dtype == "float32":
+        for index, value in enumerate(bits):
+            ctypes.memmove(
+                ctypes.addressof(array) + 4 * index,
+                struct.pack("<I", int(value) & 0xFFFFFFFF),
+                4,
+            )
+    else:
+        for index, value in enumerate(bits):
+            array[index] = value
+    return array
+
+
+def _descriptor(dtype, shape, array, readonly=False, strides=None):
+    return TensorDesc(
+        dtype,
+        shape,
+        strides=strides,
+        device="cpu",
+        address=ctypes.addressof(array),
+        readonly=readonly,
+    )
+
+
+def _launch_raw(artifact, inputs, outputs, runtime, scalars=None):
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[_descriptor(dtype, shape, array, True) for dtype, shape, array in inputs],
+            outputs=[_descriptor(dtype, shape, array) for dtype, shape, array in outputs],
+            scalars=scalars or {},
+        )
+    )
+
+
+def _native_buffer(dtype, bits):
+    array = _raw_array(dtype, bits)
+    return avx2_runtime._NativeBuffer(
+        dtype,
+        len(bits),
+        ctypes.cast(array, avx2_runtime._pointer(dtype)),
+        array,
+        True,
+    )
+
+
+def _buffer_bytes(buffer):
+    if not buffer.count:
+        return b""
+    itemsize = ctypes.sizeof(avx2_runtime._ctype(buffer.dtype))
+    return ctypes.string_at(ctypes.cast(buffer.pointer, ctypes.c_void_p), buffer.count * itemsize)
+
+
+def _buffer_sha256(array):
+    return hashlib.sha256(
+        ctypes.string_at(ctypes.addressof(array), ctypes.sizeof(array))
+    ).hexdigest()
+
+
+def _oracle_sha256(dtype, bits):
+    width = _WIDTH[dtype]
+    signed = dtype in _SIGNED
+    payload = b"".join(
+        int(bits[index]).to_bytes(width, "little", signed=signed)
+        for index in range(len(bits))
+    )
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _pattern_bits(dtype, count, seed=1):
+    if dtype == "float32":
+        special = _F32_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 2654435761 + index * 2246822519) & 0xFFFFFFFF)
+            for index in range(count)
+        ]
+    if dtype == "bf16":
+        special = _BF16_SPECIAL
+        return [
+            special[index] if index < len(special)
+            else ((seed * 40503 + index * 16411) & 0xFFFF)
+            for index in range(count)
+        ]
+    if dtype == "bool":
+        return [index % 2 for index in range(count)]
+    if dtype.startswith("uint"):
+        return [((seed * 37 + index * 91) % 31) for index in range(count)]
+    return [((seed * 37 + index * 91) % 31) - 15 for index in range(count)]
+
+
+def _unravel(index, shape):
+    coordinates = [0] * len(shape)
+    for axis in range(len(shape) - 1, -1, -1):
+        dimension = shape[axis]
+        if dimension:
+            coordinates[axis] = index % dimension
+            index //= dimension
+        else:
+            coordinates[axis] = 0
+    return tuple(coordinates)
+
+
+def _ravel(coordinates, shape):
+    index = 0
+    for coordinate, dimension in zip(coordinates, shape):
+        index = index * dimension + (coordinate if dimension else 0)
+    return index
+
+
+def _quiet_f32(bits):
+    if (
+        (bits & 0x7F800000) == 0x7F800000
+        and (bits & 0x007FFFFF) != 0
+        and (bits & 0x00400000) == 0
+    ):
+        bits |= 0x00400000
+    return bits
+
+
+def _quiet_bf16(bits):
+    if (
+        (bits & 0x7F80) == 0x7F80
+        and (bits & 0x007F) != 0
+        and (bits & 0x0040) == 0
+    ):
+        bits |= 0x0040
+    return bits
+
+
+def _oracle_broadcast(dtype, input_shape, output_shape, bits):
+    """Pure stdlib oracle for the frozen same-dtype broadcast contract."""
+
+    output_count = element_count(output_shape)
+    if not input_shape:
+        source_index = lambda _index: 0  # noqa: E731 - small local oracle
+    else:
+        rank_delta = len(output_shape) - len(input_shape)
+        input_count = element_count(input_shape)
+        assert len(bits) == input_count
+
+        def source_index(output_index):
+            coordinates = _unravel(output_index, output_shape)
+            source_coordinates = [
+                0 if dimension == 1 else coordinates[rank_delta + axis]
+                for axis, dimension in enumerate(input_shape)
+            ]
+            return _ravel(source_coordinates, input_shape)
+
+    result = []
+    for output_index in range(output_count):
+        value = int(bits[source_index(output_index)])
+        if dtype == "float32":
+            value = _quiet_f32(value)
+        elif dtype == "bf16":
+            value = _quiet_bf16(value)
+        result.append(value)
+    return result
+
+
+def _reference_bytes(program, target_ir, dtype, bits, scalar=None):
+    """Run the real vector-common host reference on exact raw bits."""
+
+    operation = program.functions[0].body.operations[0]
+    if scalar is None:
+        value = avx2_runtime._RuntimeValue(
+            program.functions[0].parameters[0].type, _native_buffer(dtype, bits)
+        )
+    else:
+        value = avx2_runtime._RuntimeValue(
+            program.functions[0].parameters[0].type,
+            _native_buffer(dtype, [scalar]),
+        )
+    result = avx2_runtime._reference_operation(
+        operation, target_ir.plans[0], [value], "AVX2 broadcast reference"
+    )
+    return _buffer_bytes(result["output"].buffer)
+
+
+def _compile_native_case(dtype, input_shape, output_shape, tmp_path, name):
+    program = _broadcast_program(dtype, input_shape, output_shape)
+    target_ir, artifact = _compile(program, tmp_path, name)
+    contract = broadcast_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None
+    metadata = artifact.metadata
+    assert metadata["native_broadcast_mode"] == BROADCAST_MODE
+    assert metadata["execution_modes"][0]["mode"] == BROADCAST_MODE
+    assert tuple(metadata["native_operations"]) == ("broadcast",)
+    assert metadata["host_reference_operations"] == ()
+    assert tuple(metadata["host_preexpanded_operations"]) == ()
+    assert tuple(metadata["native_broadcast_fallback_operations"]) == ()
+    entry = dict(metadata["native_broadcast_operations"][0])
+    assert entry["operation_index"] == 0
+    assert entry["operation"] == "broadcast"
+    assert entry["mode"] == BROADCAST_MODE
+    assert entry["kernel"] == contract["kernel"]
+    assert tuple(entry["input_shape"]) == tuple(input_shape)
+    assert tuple(entry["output_shape"]) == tuple(output_shape)
+    assert "ptx_avx2_{}".format(contract["kernel"]) in tuple(metadata["native_helper_symbols"])
+    return program, target_ir, artifact, contract
+
+
+@pytest.mark.parametrize("dtype,input_shape,output_shape", _NATIVE_CASES)
+def test_native_broadcast_is_bit_exact_against_the_stdlib_oracle(
+    dtype, input_shape, output_shape, tmp_path
+):
+    program, target_ir, artifact, contract = _compile_native_case(
+        dtype,
+        input_shape,
+        output_shape,
+        tmp_path,
+        "case-{}-{}".format(dtype, len(input_shape)),
+    )
+    input_count = element_count(input_shape)
+    bits = _pattern_bits(dtype, input_count, seed=7)
+    output_count = element_count(output_shape)
+    source = _raw_array(dtype, bits)
+    output = _raw_array(dtype, [0] * output_count)
+    _launch_raw(
+        artifact,
+        [(dtype, input_shape, source)],
+        [(dtype, output_shape, output)],
+        _runtime(),
+    )
+    expected = _oracle_broadcast(dtype, input_shape, output_shape, bits)
+    assert _buffer_sha256(output) == _oracle_sha256(dtype, expected)
+    # Secondary differential on the same raw bits: the real host reference.
+    assert _buffer_sha256(output) == hashlib.sha256(
+        _reference_bytes(program, target_ir, dtype, bits)
+    ).hexdigest()
+
+
+@pytest.mark.parametrize("dtype,input_shape,output_shape,count", _ODD_CASES)
+def test_empty_broadcast_outputs_are_native_and_safe(dtype, input_shape, output_shape, count, tmp_path):
+    program, target_ir, artifact, contract = _compile_native_case(
+        dtype, input_shape, output_shape, tmp_path, "empty-{}".format(len(output_shape))
+    )
+    source = HostTensor(dtype, input_shape, [])
+    output = HostTensor.zeros(dtype, output_shape)
+    runtime = _runtime()
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[source.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+    )
+    assert output.flat() == ()
+    assert element_count(output_shape) == count
+    assert contract["rank"] == len(output_shape)
+
