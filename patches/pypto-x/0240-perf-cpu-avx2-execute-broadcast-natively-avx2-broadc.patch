+def test_declared_kernel_is_the_dispatched_kernel_spy(tmp_path, monkeypatch):
+    runtime = _runtime()
+    calls = []
+    original = avx2_runtime._call_broadcast
+
+    def spy(module, dtype, source, destination, input_strides, output_shape, rank):
+        calls.append(
+            (dtype, tuple(input_strides), tuple(output_shape), rank, destination.count)
+        )
+        return original(module, dtype, source, destination, input_strides, output_shape, rank)
+
+    monkeypatch.setattr(avx2_runtime, "_call_broadcast", spy)
+    for dtype, input_shape, output_shape, kernel, strides in (
+        ("float32", (1, 5, 1), (1, 5, 8), "broadcast_f32", (0, 1, 0)),
+        ("bf16", (1, 3), (1, 3), "broadcast_bf16", (0, 1)),
+    ):
+        program = _broadcast_program(dtype, input_shape, output_shape)
+        target_ir, artifact = _compile(program, tmp_path, "spy-{}".format(dtype))
+        contract = broadcast_native_contract(
+            program.functions[0].body.operations[0], target_ir.plans[0]
+        )
+        assert contract is not None and contract["kernel"] == kernel
+        entry = dict(artifact.metadata["native_broadcast_operations"][0])
+        assert entry["kernel"] == kernel
+        bits = _pattern_bits(dtype, element_count(input_shape), seed=11)
+        output = _raw_array(dtype, [0] * element_count(output_shape))
+        _launch_raw(
+            artifact,
+            [(dtype, input_shape, _raw_array(dtype, bits))],
+            [(dtype, output_shape, output)],
+            runtime,
+        )
+        assert _buffer_sha256(output) == _oracle_sha256(
+            dtype, _oracle_broadcast(dtype, input_shape, output_shape, bits)
+        )
+        assert calls[-1][1] == strides
+        assert calls[-1][2] == tuple(output_shape)
+    assert [call[0] for call in calls] == ["float32", "bf16"]
+    assert [call[1] for call in calls] == [(0, 1, 0), (0, 1)]
+    assert calls[0][2:] == ((1, 5, 8), 3, 40)
+    assert calls[1][2:] == ((1, 3), 2, 3)
+
