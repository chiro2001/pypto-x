+def test_native_object_exports_both_broadcast_entrypoints(tmp_path):
+    """Static guard: the emitted object carries the declared kernel symbols."""
+
+    nm = shutil.which("nm")
+    if nm is None:
+        pytest.skip("nm is not available")
+    program = _broadcast_program("float32", (1, 5, 1), (1, 5, 8))
+    _target_ir, artifact = _compile(program, tmp_path, "symbols")
+    result = subprocess.run(
+        [nm, "-D", "--defined-only", artifact.path],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        universal_newlines=True,
+        check=False,
+    )
+    assert result.returncode == 0, result.stdout
+    assert "ptx_avx2_broadcast_f32" in result.stdout
+    assert "ptx_avx2_broadcast_bf16" in result.stdout
+    assert "ptx_avx2_abi" in result.stdout
