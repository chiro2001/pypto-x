+def test_float16_broadcast_is_rejected_before_codegen():
+    """float16 is outside the AVX2 reference dtype contract entirely."""
+
+    from pypto.lowering.cpu.x86.avx2 import Avx2UnsupportedError
+
+    program = _broadcast_program("float16", (1, 3), (1, 3))
+    with pytest.raises(Avx2UnsupportedError, match="float16"):
+        Avx2Compiler().lower(program, AVX2_TARGET)
+
