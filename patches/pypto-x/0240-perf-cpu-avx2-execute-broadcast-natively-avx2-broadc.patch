+def test_rank_above_the_native_maximum_falls_back_with_an_explicit_reason(tmp_path):
+    runtime = _runtime()
+    rank = BROADCAST_MAX_RANK + 1
+    input_shape = (1,) * (rank - 1) + (1,)
+    output_shape = (1,) * (rank - 1) + (2,)
+    program = _broadcast_program("float32", input_shape, output_shape)
+    target_ir, artifact = _compile(program, tmp_path, "rank17")
+    operation = program.functions[0].body.operations[0]
+    plan = target_ir.plans[0]
+    assert broadcast_native_contract(operation, plan) is None
+    reason = broadcast_native_fallback_reason(operation, plan)
+    assert reason == "output rank 17 exceeds the native AVX2 broadcast max rank 16"
+    assert artifact.metadata["execution_modes"][0]["mode"] == "host_reference"
+    fallback = dict(artifact.metadata["native_broadcast_fallback_operations"][0])
+    assert fallback["reason"] == reason
+    source = HostTensor("float32", input_shape, [1.0])
+    output = HostTensor.zeros("float32", output_shape)
+    runtime.launch(
+        LaunchRequest(
+            artifact,
+            inputs=[source.descriptor(readonly=True)],
+            outputs=[output.descriptor()],
+        )
+    )
+    assert output.flat() == (1.0, 1.0)
+
