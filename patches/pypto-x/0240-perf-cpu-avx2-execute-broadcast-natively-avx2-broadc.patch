+#: Native broadcast plane (artifact payload version 6).  Broadcast is
+#: standard shape expansion (input dim 1 or equal to the output dim) with one
+#: input and the same f32/bf16 output dtype; it is expressed to the kernel as
+#: per-output-axis input strides.  The runtime dispatch and the artifact
+#: metadata share the two predicates below, so a declared kernel is exactly
+#: the kernel the executor runs and every non-native plan carries an explicit
+#: host-reference reason.
+BROADCAST_MODE = "native_avx2_broadcast"
+BROADCAST_MAX_RANK = 16
+
+
+def _contiguous_element_strides(shape):
+    strides = [1] * len(shape)
+    running = 1
+    for index in range(len(shape) - 1, -1, -1):
+        strides[index] = running
+        running *= shape[index]
+    return tuple(strides)
+
+
+def _broadcast_decision(operation: Any, plan: Any):
+    """Return ``(contract, fallback_reason)`` for one broadcast plan.
+
+    Exactly one element of the pair is non-``None`` for a broadcast plan and
+    both are ``None`` for every other operation.  The reason string is the
+    artifact's explicit declaration for a plan that must keep using the
+    vector-common host reference.
+    """
+
+    if operation is None or plan is None:
+        return None, None
+    if canonical_operation_name(operation.name) != "broadcast":
+        return None, None
+    if len(operation.inputs) != 1:
+        return None, "broadcast requires exactly one input"
+    try:
+        output_shape = tuple(int(dimension) for dimension in plan.shape)
+    except (TypeError, ValueError):
+        return None, "broadcast output shape is not statically known"
+    if any(dimension < 0 for dimension in output_shape):
+        return None, "broadcast output shape contains a negative dimension"
+    if len(output_shape) > BROADCAST_MAX_RANK:
+        return None, "output rank {} exceeds the native AVX2 broadcast max rank {}".format(
+            len(output_shape), BROADCAST_MAX_RANK
+        )
+    output_dtype = canonical_dtype(plan.dtype)
+    if output_dtype not in _PACKED_DTYPES:
+        return None, "dtype {} is not in the native AVX2 broadcast dtype set (float32/bf16)".format(
+            output_dtype
+        )
+    input_type = operation.inputs[0].type
+    try:
+        input_dtype = canonical_dtype(input_type.dtype)
+    except (TypeError, ValueError):
+        return None, "broadcast input dtype is not statically known"
+    if input_dtype != output_dtype:
+        return None, "mixed input/output dtypes ({}, {}) are not native AVX2 broadcast".format(
+            input_dtype, output_dtype
+        )
+    if input_type.kind == "scalar":
+        input_shape = ()
+    elif input_type.kind in _PACKED_TENSOR_KINDS:
+        try:
+            input_shape = tuple(int(dimension) for dimension in input_type.shape)
+        except (TypeError, ValueError):
+            return None, "broadcast input shape is not statically known"
+        if any(dimension < 0 for dimension in input_shape):
+            return None, "broadcast input shape contains a negative dimension"
+    else:
+        return None, "input kind {!r} is not a native AVX2 broadcast tensor/scalar".format(
+            input_type.kind
+        )
+    rank_delta = len(output_shape) - len(input_shape)
+    if rank_delta < 0:
+        return None, "input rank {} exceeds output rank {}".format(
+            len(input_shape), len(output_shape)
+        )
+    contiguous = _contiguous_element_strides(input_shape)
+    input_strides = [0] * rank_delta
+    for axis, dimension in enumerate(input_shape):
+        output_dimension = output_shape[rank_delta + axis]
+        if dimension == 1:
+            input_strides.append(0)
+        elif dimension == output_dimension:
+            input_strides.append(contiguous[axis])
+        else:
+            return None, (
+                "input dimension {} on axis {} is neither 1 nor equal to output dimension {}".format(
+                    dimension, axis, output_dimension
+                )
+            )
+    return (
+        {
+            "mode": BROADCAST_MODE,
+            "kernel": "broadcast_{}".format(_packed_suffix(output_dtype)),
+            "input_shape": input_shape,
+            "output_shape": output_shape,
+            "input_strides": tuple(input_strides),
+            "rank": len(output_shape),
+        },
+        None,
+    )
+
+
+def broadcast_native_contract(operation: Any, plan: Any) -> Optional[dict]:
+    """Describe the native broadcast kernel for one plan, or ``None``."""
+
+    return _broadcast_decision(operation, plan)[0]
+
+
+def broadcast_native_fallback_reason(operation: Any, plan: Any) -> Optional[str]:
+    """Return why one broadcast plan stays on the host reference, or ``None``."""
+
+    return _broadcast_decision(operation, plan)[1]
+
