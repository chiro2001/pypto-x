+def test_bf16_broadcast_bit_exactness_includes_snan_quieting(tmp_path):
+    """Pin the bf16 sNaN semantics independently of the generic case table."""
+
+    dtype, input_shape, output_shape = "bf16", (1, 3, 1), (1, 3, 7)
+    program, target_ir, artifact, _contract = _compile_native_case(
+        dtype, input_shape, output_shape, tmp_path, "bf16-snan"
+    )
+    bits = [0x7F81, 0xFF81, 0x7FC1]
+    output = _raw_array(dtype, [0] * element_count(output_shape))
+    _launch_raw(
+        artifact,
+        [(dtype, input_shape, _raw_array(dtype, bits))],
+        [(dtype, output_shape, output)],
+        _runtime(),
+    )
+    expected = _oracle_broadcast(dtype, input_shape, output_shape, bits)
+    assert _buffer_sha256(output) == _oracle_sha256(dtype, expected)
+    assert tuple(expected[:7]) == (0x7FC1,) * 7
+    assert expected[7] == 0xFFC1
+    assert expected[14] == 0x7FC1
+    assert _buffer_sha256(output) == hashlib.sha256(
+        _reference_bytes(program, target_ir, dtype, bits)
+    ).hexdigest()
+
