+def test_stale_payload_and_metadata_tampering_fail_closed(tmp_path):
+    runtime = _runtime()
+    program = _broadcast_program("float32", (1, 5, 1), (1, 5, 8))
+    _target_ir, artifact = _compile(program, tmp_path, "stale")
+    original = dict(artifact.metadata)
+    for tamper in (5, 7):
+        metadata = dict(original)
+        metadata["artifact_payload_version"] = tamper
+        object.__setattr__(artifact, "metadata", metadata)
+        with pytest.raises(CpuAvx2ArtifactError, match="payload version"):
+            runtime.load(artifact)
+    for key, value in (
+        ("native_broadcast_mode", "host_reference"),
+        ("native_broadcast_operations", ()),
+        ("native_broadcast_fallback_operations", ({"operation": "broadcast"},)),
+        ("host_preexpanded_operations", ("broadcast",)),
+    ):
+        metadata = dict(original)
+        metadata[key] = value
+        object.__setattr__(artifact, "metadata", metadata)
+        with pytest.raises(CpuAvx2ArtifactError, match=key):
+            runtime.load(artifact)
+    metadata = dict(original)
+    modes = [dict(entry) for entry in metadata["execution_modes"]]
+    modes[0]["mode"] = "host_reference"
+    metadata["execution_modes"] = modes
+    object.__setattr__(artifact, "metadata", metadata)
+    with pytest.raises(CpuAvx2ArtifactError, match="execution_modes"):
+        runtime.load(artifact)
+
+
+def test_old_abi_marker_artifact_fails_closed(tmp_path):
+    program = _broadcast_program("float32", (1, 5, 1), (1, 5, 8))
+    _target_ir, artifact = _compile(program, tmp_path, "legacy-marker")
+    current_marker = b"pypto-x.cpu.avx2:7"
+    legacy_marker = b"pypto-x.cpu.avx2:6"
+    native_bytes = Path(artifact.path).read_bytes()
+    assert current_marker in native_bytes
+    legacy_bytes = native_bytes.replace(current_marker, legacy_marker)
+    assert len(legacy_bytes) == len(native_bytes)
+    legacy_dir = tmp_path / "legacy-artifacts"
+    legacy_dir.mkdir()
+    legacy_path = legacy_dir / Path(artifact.path).name
+    legacy_path.write_bytes(legacy_bytes)
+    metadata = dict(artifact.metadata)
+    metadata["native_digest"] = hashlib.sha256(legacy_bytes).hexdigest()
+    legacy_artifact = Artifact(
+        format=artifact.format,
+        entrypoint=artifact.entrypoint,
+        target=artifact.target,
+        abi_version=artifact.abi_version,
+        path=str(legacy_path),
+        metadata=metadata,
+    )
+    with pytest.raises(CpuAvx2ArtifactError, match="safety marker"):
+        _runtime().load(legacy_artifact)
