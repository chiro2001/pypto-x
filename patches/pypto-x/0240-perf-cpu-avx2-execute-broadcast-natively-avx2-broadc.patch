+@pytest.mark.parametrize("dtype", _FALLBACK_DTYPES)
+def test_non_native_dtypes_fall_back_to_the_host_reference(dtype, tmp_path):
+    runtime = _runtime()
+    input_shape = (3,)
+    output_shape = (2, 3)
+    program = _broadcast_program(dtype, input_shape, output_shape)
+    target_ir, artifact = _compile(program, tmp_path, "fallback-{}".format(dtype))
+    operation = program.functions[0].body.operations[0]
+    plan = target_ir.plans[0]
+    assert broadcast_native_contract(operation, plan) is None
+    reason = broadcast_native_fallback_reason(operation, plan)
+    assert reason == (
+        "dtype {} is not in the native AVX2 broadcast dtype set (float32/bf16)".format(dtype)
+    )
+    assert artifact.metadata["execution_modes"][0]["mode"] == "host_reference"
+    assert tuple(artifact.metadata["native_broadcast_operations"]) == ()
+    assert tuple(artifact.metadata["host_reference_operations"]) == ("broadcast",)
+    # ``host_preexpanded_operations`` only tracks the remaining pre-expansion
+    # op (where); the broadcast fallback is declared by the per-plan mode plus
+    # the explicit fallback entry below.
+    assert tuple(artifact.metadata["host_preexpanded_operations"]) == ()
+    fallback = dict(artifact.metadata["native_broadcast_fallback_operations"][0])
+    assert fallback["operation_index"] == 0
+    assert fallback["operation"] == "broadcast"
+    assert fallback["reason"] == reason
+    assert artifact.metadata["native_helper_symbols"] == ()
+    bits = _pattern_bits(dtype, element_count(input_shape), seed=5)
+    output = _raw_array(dtype, [0] * element_count(output_shape))
+    _launch_raw(
+        artifact,
+        [(dtype, input_shape, _raw_array(dtype, bits))],
+        [(dtype, output_shape, output)],
+        runtime,
+    )
+    assert _buffer_sha256(output) == _oracle_sha256(
+        dtype, _oracle_broadcast(dtype, input_shape, output_shape, bits)
+    )
+    assert _buffer_sha256(output) == hashlib.sha256(
+        _reference_bytes(program, target_ir, dtype, bits)
+    ).hexdigest()
+
