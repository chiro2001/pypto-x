 PTX_AVX2_CONCAT_ENTRY(bf16, uint16_t, ptx_avx2_layout_copy_bf16)
 PTX_AVX2_CONCAT_ENTRY(i8, int8_t, ptx_avx2_layout_copy_i8)
+
+/* -------------------------------------------------------------------------
+ * Native broadcast plane (artifact payload version 6).
+ *
+ * ``input_strides`` and ``output_shape`` are written in the *output* rank:
+ * the stride of each output axis is the element stride of the input axis it
+ * maps to, or zero when the axis is new or singleton.  The kernel walks the
+ * output in row-major order and carries the source index with an odometer, so
+ * the host never materializes a per-element Python list.  The integer-lane
+ * quieting matches the host reference, which round-trips every element
+ * through a Python float and therefore quiets a signaling NaN (finite,
+ * subnormal, infinity, zero and quiet-NaN bit patterns stay identical).
+ * ---------------------------------------------------------------------- */
+#define PTX_AVX2_BROADCAST_MAX_RANK 16U
+
+__attribute__((visibility("default")))
+void ptx_avx2_broadcast_f32(const float *input, float *output,
+                            const int64_t *input_strides,
+                            const size_t *output_shape,
+                            size_t rank, size_t output_count) {
+    size_t coords[PTX_AVX2_BROADCAST_MAX_RANK];
+    size_t axis, index;
+    int64_t source = 0;
+    uint32_t bits;
+    if (rank > PTX_AVX2_BROADCAST_MAX_RANK) return;
+    for (axis = 0; axis < rank; ++axis) coords[axis] = 0;
+    for (index = 0; index < output_count; ++index) {
+        memcpy(&bits, input + source, sizeof(bits));
+        bits = ptx_avx2_layout_quiet_nan_f32(bits);
+        memcpy(output + index, &bits, sizeof(bits));
+        for (axis = rank; axis > 0; --axis) {
+            size_t last = axis - 1;
+            coords[last] += 1;
+            source += input_strides[last];
+            if (coords[last] < output_shape[last]) break;
+            source -= (int64_t)output_shape[last] * input_strides[last];
+            coords[last] = 0;
+        }
+    }
+}
+
+__attribute__((visibility("default")))
+void ptx_avx2_broadcast_bf16(const uint16_t *input, uint16_t *output,
+                             const int64_t *input_strides,
+                             const size_t *output_shape,
+                             size_t rank, size_t output_count) {
+    size_t coords[PTX_AVX2_BROADCAST_MAX_RANK];
+    size_t axis, index;
+    int64_t source = 0;
+    uint16_t bits;
+    if (rank > PTX_AVX2_BROADCAST_MAX_RANK) return;
+    for (axis = 0; axis < rank; ++axis) coords[axis] = 0;
+    for (index = 0; index < output_count; ++index) {
+        bits = input[source];
+        output[index] = ptx_avx2_layout_quiet_nan_bf16(bits);
+        for (axis = rank; axis > 0; --axis) {
