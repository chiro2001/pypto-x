+def test_scalar_source_broadcast_is_native_and_bit_exact(tmp_path):
+    program = _broadcast_program("float32", (), (1, 5), scalar=True)
+    target_ir, artifact = _compile(program, tmp_path, "scalar")
+    contract = broadcast_native_contract(
+        program.functions[0].body.operations[0], target_ir.plans[0]
+    )
+    assert contract is not None
+    assert contract["input_shape"] == ()
+    assert contract["input_strides"] == (0, 0)
+    assert artifact.metadata["execution_modes"][0]["mode"] == BROADCAST_MODE
+    output = HostTensor.zeros("float32", (1, 5))
+    _runtime().launch(
+        LaunchRequest(
+            artifact,
+            inputs=[],
+            outputs=[output.descriptor()],
+            scalars={"source": 2.5},
+        )
+    )
+    assert output.flat() == (2.5,) * 5
