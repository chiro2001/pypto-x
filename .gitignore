# The root is a lightweight control repository.  upstream/* entries are tracked
# as gitlinks (submodules), never as copied source trees.
# Keep linked worktrees, builds, logs, and model weights out of control commits.
/worktrees/
/build/
/logs/
/artifacts/
/models/
/tmp/
**/__pycache__/
*.py[cod]
*.so
*.o
*.a
*.out
*.log
*.swp
.DS_Store

# 第三方讲稿/活动页离线副本（版权归原作者；公开镜像不分发）
references/*.pdf
references/*.html
references/*.txt
